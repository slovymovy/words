                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miał tylko <w>mgliste</w> pojęcie o tym, jak działa ten skomplikowany mechanizm.",
                            "target_lang_translations": {
                                "en": "He had only a <w>vague</w> idea of how this complex mechanism worked.",
                                "ru": "Он имел лишь <w>смутное</w> представление о том, как работает этот сложный механизм.",
                                "nl": "Hij had slechts een <w>vaag</w> idee over hoe dit ingewikkelde mechanisme werkt.",
                                "de": "Er hatte nur eine <w>vage</w> Vorstellung davon, wie dieser komplizierte Mechanismus funktioniert.",
                                "fr": "Il n'avait qu'une <w>vague</w> idée du fonctionnement de ce mécanisme complexe.",
                                "it": "Aveva solo una <w>vaga</w> idea di come funzionasse quel meccanismo complicato.",
                                "cs": "Měl jen <w>mlhavé</w> ponětí o tom, jak tento složitý mechanismus funguje.",
                                "tr": "Bu karmaşık mekanizmanın nasıl çalıştığına dair yalnızca <w>hayal meyal</w> bir fikri vardı.",
                                "es": "Solo tenía una <w>vaga</w> idea de cómo funcionaba ese complicado mecanismo.",
                                "zh": "对于这个复杂机械如何运作，他只有<w>模糊的</w>概念。"
                            }
                        },
                        {
                            "text": "Jego plany na przyszłość pozostają na razie bardzo <w>mgliste</w>.",
                            "target_lang_translations": {
                                "en": "His plans for the future remain very <w>hazy</w> for now.",
                                "ru": "Его планы на будущее пока остаются весьма <w>туманными</w>.",
                                "nl": "Zijn toekomstplannen blijven vooralsnog erg <w>vaag</w>.",
                                "de": "Seine Zukunftspläne bleiben vorerst sehr <w>vage</w>.",
                                "fr": "Ses projets d'avenir restent pour l'instant très <w>flous</w>.",
                                "it": "I suoi piani per il futuro restano per ora molto <w>nebulosi</w>.",
                                "cs": "Jeho plány do budoucna zůstávají prozatím velmi <w>mlhavé</w>.",
                                "tr": "Onun geleceğe yönelik planları şimdilik çok <w>belirsiz</w> kalıyor.",
                                "es": "Sus planes para el futuro siguen siendo muy <w>nebulosos</w> por ahora.",
                                "zh": "他对未来的计划目前仍然非常<w>渺茫</w>。"
                            }
                        }
