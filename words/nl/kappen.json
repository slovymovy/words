                {
                    "sense_id": "b2a85146-5f69-362d-b668-15dbf11fce60",
                    "sense_definition": "ophouden met iets te doen; stoppen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet nu echt <w>kappen</w> met dat vervelende lawaai.",
