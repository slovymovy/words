    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8451f0f3-d02d-3555-941c-56ab1f4615e6",
                "word": "faced",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f24723e-97d1-361c-bfd6-339601434fbf",
                        "entry_id": "8451f0f3-d02d-3555-941c-56ab1f4615e6",
                        "glosses": [
                            "Having a specified type or number of faces."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6251ad86-1109-434b-a02e-3850b3e3bb56",
                                "sense_id": "6f24723e-97d1-361c-bfd6-339601434fbf",
                                "text": "The devil damn thee black, thou cream-faced loon! / Where got'st thou that goose look?"
                            },
                            {
                                "example_id": "d7a9f776-d0c7-4aeb-90b4-6f5b5da5bc13",
                                "sense_id": "6f24723e-97d1-361c-bfd6-339601434fbf",
                                "text": "c. 1694, William Bradshaw and Robert Midgley, Letters Writ by a Turkish Spy, Volume 7, London: 1754, Letter VI, p. 148, https://books.google.ca/books?id=unlKAAAAYAAJ&printsec=frontcover#v=onepage&q&f=false\nHe either heaves out fulsome hypochondriac Sighs, with supercilious Looks, and Chaps set like the Furrows of a sour-faced Hagi; or else he is tickled into a loud ungovernable Laughter, and all his Carriage is ridiculous and wanton."
                            },
                            {
                                "example_id": "41343acc-9d60-49fb-8183-c78c833cf54f",
                                "sense_id": "6f24723e-97d1-361c-bfd6-339601434fbf",
                                "text": "O tan-faced prairie-boy, / […] / You came, taciturn, with nothing to give—we but look'd on each other, / When lo! more than all the gifts of the world you gave me."
                            },
                            {
                                "example_id": "b76b9dca-d9d5-448d-ab3a-92d38b1207b3",
                                "sense_id": "6f24723e-97d1-361c-bfd6-339601434fbf",
                                "text": "You smug-faced crowds with kindling eye / Who cheer when soldier lads march by, / Sneak home and pray you'll never know / The hell where youth and laughter go."
                            },
                            {
                                "example_id": "59e9a620-df75-4607-8003-5d783f86dc51",
                                "sense_id": "6f24723e-97d1-361c-bfd6-339601434fbf",
                                "text": "Even the streets leading up to its outer barriers were roamed by gorilla-faced guards in black uniforms, armed with jointed truncheons."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c0dbc2f-eaef-3498-979e-7d64fbb23af5",
                        "entry_id": "8451f0f3-d02d-3555-941c-56ab1f4615e6",
                        "glosses": [
                            "Having the outer surface dressed, with the front, as of a dress, covered ornamentally with another material."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
