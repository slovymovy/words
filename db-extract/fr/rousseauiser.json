                        "glosses": [
                            "Donner un caractère rousseauiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c83ff6e-7452-4125-a6d7-5c3a6907b0e3",
                                "sense_id": "dc2b41bb-b1c9-3a8b-9b55-adae05fa5e78",
                                "text": "Mais pour elle l’enjeu était bien plus grand : « rousseauiser » la Révolution – tout en déclassant Trianon."
