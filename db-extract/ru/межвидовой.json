                                        "entry_id": "81b3ac58-91a3-362a-8173-4eb512022593",
                                        "glosses": [
                                            "auf die gegenseitigen Beziehungen der Mitglieder unterschiedlicher biologischer Art bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
