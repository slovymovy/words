                                "target_senses": [
                                    {
                                        "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                        "entry_id": "6eb6f0b1-0be8-31fe-82d1-1febb4986b98",
                                        "glosses": [
                                            "die Technologie betreffend, auf die Technologie bezogen, in der Art und Weise der Technologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e042074-c92c-40d1-83d8-66c99dcd8f3b",
                                                "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                                "text": "„Hinsichtlich anderer wichtiger technologischer Daten sei auf das Schrifttum verwiesen.“"
                                            },
                                            {
                                                "example_id": "627d2e22-3091-4249-baa0-cd5616e77b97",
                                                "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                                "text": "„Von \"technologischen Predigten\" etwa darüber, ob das Netz oder der herkömmliche Arbeitsplatzcomputer die EDV bestimmen soll, hält er nichts.“"
                                            },
                                            {
                                                "example_id": "9bb3692d-8240-40c4-b21b-e2a26b897cdc",
                                                "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                                "text": "„In einer solchen Zwangslage kann ein Unternehmen versuchen, mit technologischen Mitteln den Einsatz von Rohstoffen zu vermindern. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
