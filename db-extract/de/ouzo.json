                                "target_senses": [
                                    {
                                        "sense_id": "cbe45359-1067-3fe1-acfa-264264b9d7a6",
                                        "entry_id": "371abcd4-9f23-389b-82b1-d3a9b9b96f05",
                                        "glosses": [
                                            "είδος παραδοσιακού αλκοολούχου ποτού της Τουρκίας και της Ελλάδας με μεγάλη περιεκτικότητα σε αλκοόλ"
                                        ],
                                        "tags": [
                                            "ποτό"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15efb2d3-2e91-4771-89b4-50b694ce0637",
                                                "sense_id": "cbe45359-1067-3fe1-acfa-264264b9d7a6",
                                                "text": "※ Τα υπόλοιπα γλυκά φτιάχνονταν στο σπίτι. Αν κάποια κυρία ήθελε πιοτό, τη σερβίριζαν ούζο, μπίρα, κρασί, κονιάκ ή πίπερμαν. (Μάνος Ελευθερίου, Φαρμακείον Εκστρατείας, εκδ. Μεταίχμιο, 2016)"
                                            }
                                        ]
                                    }
