                {
                    "sense_id": "0e5f05ee-a423-3727-8813-f1949e4dd180",
                    "sense_definition": "To lower someone's pride or status",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "humiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant criticism served only to <w>depress</w> her spirit.",
                            "target_lang_translations": {
                                "ru": "Его постоянная критика лишь <w>подавляла</w> её дух.",
                                "nl": "Zijn constante kritiek diende er alleen maar toe haar geest te <w>ontmoedigen</w>.",
                                "pl": "Jego ciągła krytyka jedynie <w>podłamywała</w> jej ducha.",
                                "de": "Seine ständige Kritik diente nur dazu, ihren Mut zu <w>entmutigen</w>.",
                                "fr": "Ses critiques constantes n'ont servi qu'à <w>abattre</w> son moral.",
                                "it": "Le sue continue critiche sono servite solo ad <w>abbattere</w> il suo spirito.",
                                "cs": "Jeho neustálá kritika jen <w>zlomila</w> jejího ducha.",
                                "tr": "Onun sürekli eleştirisi sadece kadının hevesini <w>kırmaya</w> yaradı.",
                                "es": "Su crítica constante solo sirvió para <w>abatir</w> su espíritu.",
                                "zh": "他不断的批评只会<w>挫伤</w>她的精神。"
                            }
                        },
                        {
                            "text": "The defeat <w>depressed</w> his confidence significantly.",
