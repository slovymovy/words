                ],
                "senses": [
                    {
                        "sense_id": "049bb8a7-7611-3a41-a4b7-fd14b73fac3f",
                        "entry_id": "1572c705-3399-342b-b76f-b128a137b8db",
                        "glosses": [
                            "A bird’s gaping mouth."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9772b7f5-854c-37eb-89d8-6379d7907f49",
                        "entry_id": "1572c705-3399-342b-b76f-b128a137b8db",
                        "glosses": [
                            "The throat of a calyx."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                        "entry_id": "1572c705-3399-342b-b76f-b128a137b8db",
                        "glosses": [
                            "Any open-mouthed expression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d619d74f-1963-466a-8add-2444cef884cd",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "His face was a rictus of sheer delight."
                            },
                            {
                                "example_id": "a611e6a8-6bcd-4a62-950f-a8140f3ecd9c",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "Amid a thick, bristling beard, a nose like an owl's beak and a mouth whose corners were drawn by a wild-beast-like rictus were just discernible."
                            },
                            {
                                "example_id": "302561f9-f671-4f8f-b03d-64d5059f54c1",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "A rictus of cruel malignity lit up greyly their old bony faces."
                            },
                            {
                                "example_id": "b47d522f-8105-4a31-8ef4-02e215520365",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "Sword and shield, bone and steel / Rictus grin / Deaf forever to the battle's din"
                            },
                            {
                                "example_id": "81a5d7f3-f8c6-4364-8120-09e61756f43b",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "Valves plugs pumps to erase/ rictus from my face."
                            },
                            {
                                "example_id": "8e0a5dc4-2e47-4aec-b15a-523155250e93",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "The absolute incarnation of evil, Adolf Hitler, lies at your feet in a pool of his own blood. His wrinkled, crimson-splattered visage still strains, a jagged-toothed rictus trying to cry out. Insane even in death. Your lips pinched in bitter victory, you kick his head off his remains and spit on his corpse."
                            },
                            {
                                "example_id": "b5409b89-fd66-4014-b451-e7c15c010f98",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "It squinted at her through the hated light, its brow a rictus of pain and fear."
                            },
                            {
                                "example_id": "d114b1fa-682b-4469-b7d4-f193cb84343e",
                                "sense_id": "47f0e552-2824-3a06-8eb1-789f4495f7fd",
                                "text": "The apprentice watched his Master, pain twisting his features into a rictus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a82e88b9-94ab-49a7-be82-048bb0d463b4",
                        "source_entry_id": "1572c705-3399-342b-b76f-b128a137b8db",
                        "source_sense_description": "Any open-mouthed expression",
                        "target_lang_word": "rictus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rictus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                        "entry_id": "04cae283-8107-32dc-bb85-8a4617c26e3b",
                                        "glosses": [
                                            "Contraction de la bouche, grimace des lèvres et des joues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43582eba-c962-45df-9a3d-29dbda6d9017",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Un pâle et froid sourire dessina ce rictus qui servait de bouche au diplomate."
                                            },
                                            {
                                                "example_id": "2b7e9db3-a546-4c0e-b20e-0b211082f386",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Rien n’est plus rare qu’un être humain dont la bouche et les muscles faciaux soient conformés de manière à produire le phénomène du rictus sardonique que la science explique par un retour atavique à une grimace primitive, alors que nos ancêtres devaient employer leurs mâchoires comme armes d’attaque ou de défense."
                                            },
                                            {
                                                "example_id": "4df86dae-6d79-47ec-90f7-38fb1d163864",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Et il fait le geste, tranquillement cynique, grinçant un : crac ! qui fait courir son rictus d’une oreille à l'autre et lui donne une physionomie d’un comique effrayant."
                                            },
                                            {
                                                "example_id": "1729d3ef-6f9c-41c7-ba26-cb022737a30d",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Ses yeux fauves lançaient des éclairs, et un rictus, semblable à celui de la face du tigre flairant sa proie, fit grimacer son visage."
                                            },
                                            {
                                                "example_id": "07b5c831-1940-4413-b868-eaa8d8770ea5",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Ce rictus faussement hilare était d’ailleurs démenti par l’inépuisable détresse qui vitrait, dilatait et humectait les yeux de la victime."
                                            },
                                            {
                                                "example_id": "a3a6403a-1c4c-4917-a381-d65a5ee602f4",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Mais, au lieu de s’effarer, de fuir comme il avait fait une première fois, il eut son habituel retroussement de lèvres, qui découvrait, à gauche, un peu de ses dents de loup, dans un rictus involontaire où il y avait comme de la goguenardise et de la cruauté."
                                            },
                                            {
                                                "example_id": "c4ccb3e6-cb3f-403a-bfa4-994751de1211",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Antoine ne put s’empêcher d’esquisser un rictus de déception qui amusa Ornella."
                                            },
                                            {
                                                "example_id": "d28d0b09-203a-4597-83d8-8bfaf1d4fcc6",
                                                "sense_id": "9d467fa2-9dce-3257-b9bb-0e744041148c",
                                                "text": "Elle me décoche un regard surpris, puis un rictus incertain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8563eff-7da9-4ba8-84a0-b70dbf00588c",
                        "source_entry_id": "1572c705-3399-342b-b76f-b128a137b8db",
                        "source_sense_description": "Any open-mouthed expression",
                        "target_lang_word": "Grimasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grimasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                        "entry_id": "9f0977f7-9d88-3130-8a30-ef34de953520",
                                        "glosses": [
                                            "absichtlich verzerrtes Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8220be-d19e-450f-b5e6-ffb916710c54",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "Zieh nicht immer eine solche Grimasse!"
                                            },
                                            {
                                                "example_id": "82b10b11-cfe6-4c1b-bd2f-c7ace53f5b86",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Niko zog eine Grimasse.“"
                                            },
                                            {
                                                "example_id": "abf6e344-7edf-4aa7-93d5-ca776bd12173",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Sein Großvatergesicht verzerrte sich zu einer Grimasse.“"
                                            },
                                            {
                                                "example_id": "baceb278-1921-49d9-8e3b-8a8736751474",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Manchmal brachte er sie mit einer Grimasse zum Lachen.“"
                                            },
                                            {
                                                "example_id": "8e80e070-10dd-4aef-98be-597266b74718",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Er hörte auf mit seinen Grimassen und beugte sich über sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
