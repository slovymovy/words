        "nl-extract.jsonl": [
            {
                "entry_id": "2770035d-08b7-3b0d-a094-74aef6eac82d",
                "word": "herrijzenis",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9d2f3655-aa04-4e5e-baab-c14639b2b446",
                        "entry_id": "2770035d-08b7-3b0d-a094-74aef6eac82d",
                        "tags": [
                            "plural"
                        ],
                        "form": "herrijzenissen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "084758fe-7b36-3661-807d-778d246dd5b6",
                        "entry_id": "2770035d-08b7-3b0d-a094-74aef6eac82d",
                        "glosses": [
                            "terugkeer na verdwenen te zijn; weer aan de top terugkeren na een periode van neergang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8884d958-412b-48da-a87e-209f135c4e55",
                                "sense_id": "084758fe-7b36-3661-807d-778d246dd5b6",
                                "text": "Wat het jaar zou worden van de tweekamp tussen Andy Murray en Novak Djokovic, werd het jaar van de herrijzenis van Roger Federer en Rafael Nadal."
                            },
                            {
                                "example_id": "26a0af12-56ac-4626-a00e-5ef595765d78",
                                "sense_id": "084758fe-7b36-3661-807d-778d246dd5b6",
                                "text": "Deze week zette Stallone de fimposter van Rambo 5 op Instagram. De Vietnam-veteraan op een knie, voorover buigend, leunend op zijn gigantische mes, alsof er een ongekende herrijzenis aan zit te komen. Stallone heeft zelf nog amper wat gezegd over deel 5 maar het lijkt erop dat hij Mexicaanse misdadigers te lijf gaat."
                            },
                            {
                                "example_id": "9fd53a56-e394-42bb-89a6-d7304e1dcbac",
                                "sense_id": "084758fe-7b36-3661-807d-778d246dd5b6",
                                "text": "Waar Chris Froome in de vorige bergritten deze Giro nog rond plaats 20 eindigde, stak hij vandaag zijn handen in de lucht op misschien wel de meest gevreesde berg van Europa. De ongekende herrijzenis van Froome leek de hoofdrolspeler zelf nog het minst te verbazen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0f3662b-15ce-374a-bcc4-c43393079921",
                        "entry_id": "2770035d-08b7-3b0d-a094-74aef6eac82d",
                        "glosses": [
                            "weer levend worden na gestorven te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d535e19d-4541-4acc-9bdb-2d9e9a1608fa",
                                "sense_id": "f0f3662b-15ce-374a-bcc4-c43393079921",
                                "text": "Het beeld van Maria met Jezus straalt je tegemoet. Beeldhouwer Karoly Szekeres en zijn stagiaire Mayke Fritsma hebben weken werk gestoken in de herrijzenis van Maria."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd2ba905-8dfe-4b7d-99db-f2e246e1bfef",
                        "source_entry_id": "2770035d-08b7-3b0d-a094-74aef6eac82d",
                        "source_sense_id": "084758fe-7b36-3661-807d-778d246dd5b6",
                        "target_lang_word": "resurrection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resurrection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30538927-eeec-31c0-80b1-db03fbe8b096",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The act of arising from the dead and becoming alive again."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b14f9e0-7265-3f01-b3bf-7b04a941d06d",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The general resurrection."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accfbeeb-32c4-4b82-aec1-87c9e8d08b2d",
                                                "sense_id": "2b14f9e0-7265-3f01-b3bf-7b04a941d06d",
                                                "text": "But the rest of the dead lived not again until the thousand years were finished. This is the first resurrection.\nBlessed and holy is he that hath part in the first resurrection: on such the second death hath no power, but they shall be priests of God and of Christ, and shall reign with him a thousand years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00426ea-c98f-34d6-8fb0-76d17f950352",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "A miraculous comeback or revival (e.g., of a TV series); recovery from a dire predicament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4785a6e-6cc1-3373-a7fa-2723b308aeae",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The act of bodysnatching (illicitly exhuming a cadaver)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
