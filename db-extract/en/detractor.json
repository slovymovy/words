                                        "entry_id": "34dadc9b-b671-3949-8cba-64b294e97582",
                                        "glosses": [
                                            "Person, die jemanden oder etwas ins Lächerliche zieht oder beleidigt/über jemanden oder etwas lästert"
                                        ],
                                        "tags": [],
