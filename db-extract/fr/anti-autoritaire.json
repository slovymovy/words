                    {
                        "sense_id": "df993865-ba60-3ffd-981d-c824ba51d5e0",
                        "entry_id": "3f557d5a-5627-323c-a175-038f1642f123",
                        "glosses": [
                            "Hostile à l'autorité politique, royale, religieuse, etc… Qui rejette la domination, l’autorité d’une personne investie du pouvoir de commander."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71035cb2-81e2-457b-a501-1ce45c8b0b71",
                                "sense_id": "df993865-ba60-3ffd-981d-c824ba51d5e0",
                                "text": "La monarchie anglaise a combattu la tendance ascétique anti-autoritaire des puritains."
                            }
                        ]
                    },
                    {
                        "sense_id": "66df0fad-307f-3e84-a08f-18961a6af5c6",
                        "entry_id": "3f557d5a-5627-323c-a175-038f1642f123",
                        "glosses": [
                            "(Sens moderne) Hostile à toute forme de soumission au pouvoir d'un éducateur, des parents, des maîtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd32d42-e9ed-4b0c-9fbc-a3d1c5d52d7b",
                                "sense_id": "66df0fad-307f-3e84-a08f-18961a6af5c6",
                                "text": "Les anarchistes sont anti-autoritaires."
                            },
                            {
                                "example_id": "c52feea4-ae2e-456f-bcb1-996a06bd587b",
                                "sense_id": "66df0fad-307f-3e84-a08f-18961a6af5c6",
                                "text": "On raconte souvent la blague sur l'éducation anti-autoritaire et le yaourt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e82cd985-170d-4e08-859b-7aa4ec1d4cb4",
