                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d98d9d15-70bd-3b07-80ce-9eda42c97e6c",
                                        "entry_id": "d5593719-a8f8-3805-935c-2ffeb1425623",
                                        "glosses": [
                                            "rzymski niższy funkcjonariusz państwowy, stanowiący ochronę urzędników"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56d773f-d35e-48e9-b9d7-b5b80fd4addf",
                                                "sense_id": "d98d9d15-70bd-3b07-80ce-9eda42c97e6c",
                                                "text": "Na lewym ramieniu liktorzy nosili wiązki rózg z wetkniętymi w nie toporami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbf313ad-b125-46b6-ac67-9c384d011f0b",
                        "source_entry_id": "74644816-df66-35c5-b375-c32e930addea",
