                        "glosses": [
                            "amtliche Bezeichnung einer Staatsbürgerin von Nordmazedonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a28418-0806-453b-bfc0-017b09a8b87c",
                                "sense_id": "ecfd7dbe-7f37-3565-a96f-4b66945be4b2",
                                "text": "Die Mazedonierin, die im Nachbarhaus wohnt, wird seit drei Tagen vermisst."
