                "senses": [
                    {
                        "sense_id": "b2be5c87-8a6b-3e2f-9af0-f5016c09216f",
                        "entry_id": "e4951bce-1289-307c-9174-9c137d223721",
                        "glosses": [
                            "Mauvais œil, qui est jeté par le jettatore, le jeteur de sort en Italie du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6e9d4d-896b-4627-bfb8-5ab12a070139",
                                "sense_id": "b2be5c87-8a6b-3e2f-9af0-f5016c09216f",
                                "text": "La main est destinée à conjurer le mauvais œil, la jettatura, comme les petites mains de corail que l’on porte à Naples en épingle ou en breloque pour se garantir des regards obliques."
                            },
                            {
                                "example_id": "cdfba425-33d3-4796-9797-08faeeb5470e",
                                "sense_id": "b2be5c87-8a6b-3e2f-9af0-f5016c09216f",
                                "text": "Outre la comédie , il y a une autre manie à Castellamare et dans tout le royaume de Naples, c’est la jettatura."
                            },
                            {
                                "example_id": "85097877-4638-4460-81bf-cacfd3083ca4",
                                "sense_id": "b2be5c87-8a6b-3e2f-9af0-f5016c09216f",
                                "text": "Le masque noir rit, le tronçon de queue propage jusqu’à la nuque son frétillement, et les oreilles conjurent, tendues en cornes vers le ciel, une éventuelle jettatura."
                            },
                            {
                                "example_id": "6f410ca9-7e19-4365-afa5-614f7c9c08f5",
                                "sense_id": "b2be5c87-8a6b-3e2f-9af0-f5016c09216f",
                                "text": "Car enfin, M. Yves Florenne en était encore à fignoler des romans paysans, des « drames de la terre », des histoires de mauvais œil, quand, l’œil autrement mauvais qu’un agreste héros de jettatura, Hitler énonçait […]"
                            }
                        ]
                    }
                ],
