                ],
                "senses": [
                    {
                        "sense_id": "856f9c55-11a8-380e-81a4-1d9c59c0999b",
                        "entry_id": "f2345c65-10d7-3f53-9151-9badcf143de8",
                        "glosses": [
                            "staatliche Eisenbahngesellschaft"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2a47bba4-5c76-3ecd-b8cd-99f28dcac70a",
                        "entry_id": "f2345c65-10d7-3f53-9151-9badcf143de8",
                        "glosses": [
                            "staatliche Eisenbahngesellschaft",
                            "in Gesamtdeutschland von 1924 bis 1949"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e15769-ab46-48e4-b0ea-54aa11baa146",
                                "sense_id": "2a47bba4-5c76-3ecd-b8cd-99f28dcac70a",
                                "text": "Die Weltwirtschaftskrise im Jahre 1929 und die Reparationen des ersten Weltkrieges belastete die Reichsbahn erheblich."
                            },
                            {
                                "example_id": "41eb760e-7bd0-4854-bf99-a08938a5a8a6",
                                "sense_id": "2a47bba4-5c76-3ecd-b8cd-99f28dcac70a",
                                "text": "„Ein Mann steigt heraus – nein, ein Beamter, ein Schaffner der Reichsbahn, wie er im Buche steht: ordentliche Uniform, seine Dienstmütze sehr korrekt auf dem Kopf und die Diensttasche umgehängt, saubere Stiefel.“"
                            },
                            {
                                "example_id": "12b0187a-0c7d-4861-920f-a5c19f794bb4",
                                "sense_id": "2a47bba4-5c76-3ecd-b8cd-99f28dcac70a",
                                "text": "„An diesem Tag fuhr der erste Zug der Reichsbahn in Richtung Osten zum Vernichtungslager Auschwitz.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "8ae41503-2842-3ed9-9d42-b2dd992107af",
                        "entry_id": "f2345c65-10d7-3f53-9151-9badcf143de8",
                        "glosses": [
                            "staatliche Eisenbahngesellschaft",
                            "im Gebiet der DDR und Westberlins beziehungsweise der neuen Bundesländer und Berlins von 1949 bis 1993"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a51ef40-8141-4b1c-9eef-d4b77de411ff",
                                "sense_id": "8ae41503-2842-3ed9-9d42-b2dd992107af",
                                "text": "Nach der Teilung Deutschlands hieß die Eisenbahngesellschaft in der BRD „Deutsche Bundesbahn“ und in der DDR „Deutsche Reichsbahn“."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
