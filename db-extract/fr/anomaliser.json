                ],
                "senses": [
                    {
                        "sense_id": "2ab7bc0d-621f-3461-bc93-00c66877c101",
                        "entry_id": "f4902679-1412-3d78-a01a-d5eb616848ee",
                        "glosses": [
                            "Donner un caractère anomal à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "065c1c34-0760-4f42-9df6-bfa285379229",
                                "sense_id": "2ab7bc0d-621f-3461-bc93-00c66877c101",
                                "text": "La connerie humaine sortie de la bouche de docteurs en théologie, disciples ou disciplinaires d’on ne sait quel Dieu, si ce n’est celui auquel nous nous accrochons, autodidactes ou théologiens à la petite semaine, qui pour satisfaire leurs ambitions prônent le qu’en dira-t-on, les préjugés et les mauvaises façons qui risquent « d’anomaliser » la terre entière."
                            },
                            {
                                "example_id": "14550a8c-3e3f-4440-9a88-d55b37415122",
                                "sense_id": "2ab7bc0d-621f-3461-bc93-00c66877c101",
                                "text": "Pour vivre sa vie d’être vivant, l’être humain dut s’anomaliser."
                            },
                            {
                                "example_id": "fe4f759e-ab2f-425c-8ad2-f3b6a9528391",
                                "sense_id": "2ab7bc0d-621f-3461-bc93-00c66877c101",
                                "text": "Elle repose en effet sur deux principes essentiels : — recours à une clientèle motorisée permettant d’élargir les besoins de chalandise et donc d’anomaliser les achats courants, d’accéder à la vente de masse et au groupement des achats ;"
                            }
                        ]
                    }
                ],
