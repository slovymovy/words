                                        "glosses": [
                                            "ústav shromažďující a vystavující sbírky předmětů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df8a594-615e-4284-a419-dcbd03ca8a9f",
                                                "sense_id": "99e95124-51b3-371d-ac28-0c9c16a100b0",
                                                "text": "V muzeu jsme viděli kostry pravěkých lidí."
                                            },
                                            {
                                                "example_id": "30b99397-66af-4ec0-b3c0-fb1d3feb2dea",
                                                "sense_id": "99e95124-51b3-371d-ac28-0c9c16a100b0",
                                                "text": "Vzhledem k tomu, že z Muzea na Můstek je to jen jednu stanici, nemá cenu jet (to) metrem."
                                            },
                                            {
                                                "example_id": "cd27f4fb-a395-4bf9-8f5f-381c6325735f",
                                                "sense_id": "99e95124-51b3-371d-ac28-0c9c16a100b0",
                                                "text": "A v Praze kalamita jak na Sibiři - tři centimetry sněhu! A u Muzea čtyři..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56db2489-0ad1-4ed3-88fa-77914b709622",
                        "source_entry_id": "8c8d32ad-0eb4-3065-8928-452200e7d65c",
                        "source_sense_id": "318a1fb5-7a66-383f-8330-3ee9a5574898",
