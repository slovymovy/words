                    },
                    {
                        "translation_id": "b7d7992f-85bb-4137-84b7-effb77353394",
                        "source_entry_id": "6d91e135-1fe4-3053-a2b7-01a2d0cd5e55",
                        "source_sense_id": "f2711a40-b9d2-375a-9375-e72abfe9fdd4",
                        "target_lang_word": "двугорбый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "двугорбый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "579aa4c7-a876-3569-a922-4533bead9ee8",
                                        "entry_id": "ec4d1916-dd7b-3a9d-b346-c1c259060a02",
                                        "glosses": [
                                            "имеющий два горба"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a957c10-c65a-4e64-9f59-a0efe07cf797",
                                                "sense_id": "579aa4c7-a876-3569-a922-4533bead9ee8",
                                                "text": "Персия богата одногорбыми верблюдами (дромадерами), но двугорбых видел я тут всего два раза; цена тем и другим от 40 до 100 рублей."
                                            },
                                            {
                                                "example_id": "8c0f02d4-2772-4f2f-be26-45d228916076",
                                                "sense_id": "579aa4c7-a876-3569-a922-4533bead9ee8",
                                                "text": "Утром с поразительной быстротой и сноровкой они погрузят тюки на двугорбые спины и поведут свои караваны дальше, к следующему привалу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d017fd-771a-37a9-8bf9-50adb8813130",
                                        "entry_id": "ec4d1916-dd7b-3a9d-b346-c1c259060a02",
                                        "glosses": [
                                            "имеющий два возвышения, два пика"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015b8ecf-a8d9-441f-bfcf-ed49bf944f9c",
                                                "sense_id": "64d017fd-771a-37a9-8bf9-50adb8813130",
                                                "text": "Километрах в пяти от сопки он поворачивает к востоку, образуя двугорбую сопку, названную нами Верблюдом (1100 м)."
                                            },
                                            {
                                                "example_id": "fb7e78b6-eca7-40ca-9370-578a77d1f624",
                                                "sense_id": "64d017fd-771a-37a9-8bf9-50adb8813130",
                                                "text": "Плывём к нему ― это огромная, по очертаниям похожая на верблюда, массивная двугорбая глыба, одиноко стоящая на дне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
