                        "examples": [
                            {
                                "example_id": "37df9e82-450b-4a0d-9ef1-d7f6280e54cc",
                                "sense_id": "833067b4-eadb-3b6e-979e-5522883b0a76",
                                "text": "\"Maar het is belangrijk dat we beseffen dat er ook in Europa een probleem is rondom het ongecontroleerd en onnodig voorschrijven van opioïden\", zegt Markus Hollmann. De hoogleraar anesthesiologie aan het UMC heeft de artikelenreeks op verzoek van het blad gereviewd en een commentaarstuk geschreven."
                            },
                            {
                                "example_id": "64011e0a-87dc-415b-9337-722cb9cd36ef",
                                "sense_id": "833067b4-eadb-3b6e-979e-5522883b0a76",
                                "text": "Onder druk van het Engels corruptieschandaal legt Jimmy Houtput het voorzitterschap van de Belgische tweedeklasser Oud-Heverlee Leuven neer. De naam van Houtput dook op in de geruchtmakende artikelenreeks van The Telegraph over fraude en corruptie in het voetbal."
                            },
                            {
                                "example_id": "e2fab8a6-e8b4-4850-8a2c-945e38ad7727",
                                "sense_id": "833067b4-eadb-3b6e-979e-5522883b0a76",
                                "text": "De krant besloot het journalistenduo anderhalf jaar lang onderzoek te laten doen in Limburg en in Nederland. De artikelenreeks verscheen ook in boekversie."
                            }
                        ]
                    }
