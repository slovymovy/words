                                "example_id": "203ba338-1985-4da4-83dc-0ae604e153c0",
                                "sense_id": "e2926638-12f6-39ab-8d92-eb3ec9809d5f",
                                "text": "Czytałam artykuł naukowy na temat ablatywu w języku tatarskim."
                            }
                        ],
