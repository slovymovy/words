                "senses": [
                    {
                        "sense_id": "210eb9ec-2de3-3428-bfdc-16724f3b2d28",
                        "entry_id": "3f4f1e47-f1dc-38f5-bd3d-f6cd16671f13",
                        "glosses": [
                            "свойство по значению прилагательного добропорядочный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15217d8b-405f-4571-aa3d-e153f298a2af",
                                "sense_id": "210eb9ec-2de3-3428-bfdc-16724f3b2d28",
                                "text": "Нужно лишь иметь добрую волю, и из самой парадоксальной и подозрительной предпосылки можно извлечь выводы, вполне согласные и со здравым смыслом, и с правилами добропорядочности."
                            },
                            {
                                "example_id": "6eddafe3-80f6-4543-b297-9f0ab9c5435a",
                                "sense_id": "210eb9ec-2de3-3428-bfdc-16724f3b2d28",
                                "text": "Что это, уверенность порядочного человека, что никто, никогда не будет вести себя с ним непорядочно, или наивность простофили, уравнивающего порядок с добропорядочностью?"
                            }
                        ]
                    }
