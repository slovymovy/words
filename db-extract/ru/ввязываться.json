                                "target_senses": [
                                    {
                                        "sense_id": "d245fb95-e4ac-355f-a245-679646d6e6f9",
                                        "entry_id": "399719c3-cb7e-33f5-aa65-f8843db186dd",
                                        "glosses": [
                                            "Devenir moins pur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db8d6c2-cd8f-4666-8a79-bd0107d2edd6",
                                                "sense_id": "d245fb95-e4ac-355f-a245-679646d6e6f9",
                                                "text": "Cette race s’était mêlée et avait perdu beaucoup de sa pureté."
                                            },
                                            {
                                                "example_id": "b9472e33-2299-47d8-8578-93ff4c2e84fa",
                                                "sense_id": "d245fb95-e4ac-355f-a245-679646d6e6f9",
                                                "text": "Les étrangers envahissaient le Sénat ; le sang romain se mêlait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10566951-bfc6-3d9a-bf3b-8535bd8bfb2b",
                                        "entry_id": "399719c3-cb7e-33f5-aa65-f8843db186dd",
                                        "glosses": [
                                            "Participer à une chose, intervenir dans une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0f63b7-eaa0-45f2-919f-024f06a79a4d",
                                                "sense_id": "10566951-bfc6-3d9a-bf3b-8535bd8bfb2b",
                                                "text": "Il a réussi dans toutes les choses dont il s’est mêlé."
                                            },
                                            {
                                                "example_id": "96a98250-8641-43bc-ace2-f80547b530c3",
                                                "sense_id": "10566951-bfc6-3d9a-bf3b-8535bd8bfb2b",
                                                "text": "Mais comment dire à qui vient de vous sauver la vie qu’il se veuille mêler de ce qui le regarde ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc16af89-cce0-30f0-a015-f2a05e8c3261",
