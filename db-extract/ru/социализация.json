                "senses": [
                    {
                        "sense_id": "c89b731b-30d3-3c0f-a615-db25e35cc266",
                        "entry_id": "27a2df24-642f-34d3-bb57-845d9450bad6",
                        "glosses": [
                            "процесс усвоения человеческим индивидом образцов поведения, психологических установок, социальных норм и ценностей, знаний, навыков, позволяющих ему успешно функционировать в обществе"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f8d4b2a3-9878-30bb-8345-f26680e4b4ea",
                        "entry_id": "27a2df24-642f-34d3-bb57-845d9450bad6",
                        "glosses": [
                            "приведение информации в соответствии с образцами поведения, психологическими установоками, социальными нормами и ценностями, знаниями, навыками, позволяющих получателями информации успешно функционировать в обществе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bd9e4b-8615-4a37-94e3-619df2f1b3ff",
                                "sense_id": "f8d4b2a3-9878-30bb-8345-f26680e4b4ea",
                                "text": "Это не плагиат, это обычная социализация песни!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "641736d7-fa6c-477e-919f-64f4ce51624a",
                        "source_entry_id": "27a2df24-642f-34d3-bb57-845d9450bad6",
                        "target_lang_word": "socialization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "socialization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7175252-0bb7-3fda-a872-37e7a337d6a3",
                                        "entry_id": "b0029e10-2e60-325b-a8c7-d03cf036459a",
                                        "glosses": [
                                            "The process of learning how to live in a way acceptable to one's own society, said especially about children."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "121aa4bc-2cb1-46a0-bda3-39c4ca14f194",
                                                "sense_id": "e7175252-0bb7-3fda-a872-37e7a337d6a3",
                                                "text": "Socialization skills are important things to learn in kindergarten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a181ac-d9dd-3eed-9e70-18ddbf5bc8d4",
                                        "entry_id": "b0029e10-2e60-325b-a8c7-d03cf036459a",
                                        "glosses": [
                                            "The act of interacting with others, of being social."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bde5690-6b33-419d-959e-393adc816d6b",
                                                "sense_id": "c7a181ac-d9dd-3eed-9e70-18ddbf5bc8d4",
                                                "text": "Forced socialization rarely creates strong friendships, but there are exceptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5648422-3e76-3080-81bc-2a0873cbf19f",
                                        "entry_id": "b0029e10-2e60-325b-a8c7-d03cf036459a",
                                        "glosses": [
                                            "Taking under government control as implementing socialism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d572f401-77de-429a-9f01-d81c54f33820",
                                                "sense_id": "d5648422-3e76-3080-81bc-2a0873cbf19f",
                                                "text": "socialization of the means of production"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e507042-93ed-47f5-b6c3-8dc527c1b8ef",
                        "source_entry_id": "27a2df24-642f-34d3-bb57-845d9450bad6",
                        "target_lang_word": "socialisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "socialisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2973e2d8-bb58-3bfb-ace0-814067e870e4",
                                        "entry_id": "819d59b6-e753-325c-a1d9-2124950dfa90",
                                        "glosses": [
                                            "Processus d’apprentissage qui permet à un individu d’acquérir les modèles culturels de la culture dans laquelle il vit et agit, et la vie en société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df607aa-5890-4240-b027-2c9493b43ab9",
                                                "sense_id": "2973e2d8-bb58-3bfb-ace0-814067e870e4",
                                                "text": "Surtout, ils se sont tous rencontrés dans le cadre du scoutisme traditionnel catholique, instance de socialisation dont la mention revient dans l’ensemble de leurs discours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f7b7ca2-aa32-3e83-b9c4-080b440e24b8",
                                        "entry_id": "819d59b6-e753-325c-a1d9-2124950dfa90",
                                        "glosses": [
                                            "Transfert de la propriété privée au profit de la propriété collective."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87871f50-5f2f-469c-90d2-5f6eb2f915a3",
                                                "sense_id": "4f7b7ca2-aa32-3e83-b9c4-080b440e24b8",
                                                "text": "L’économie mouride doit encore se déféodaliser pour que s’annonce un processus authentique de socialisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d379bf9-5894-3c57-980a-466ad9db150e",
                                        "entry_id": "819d59b6-e753-325c-a1d9-2124950dfa90",
                                        "glosses": [
                                            "Action de socialiser quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a697d8-9c3a-4442-8e9b-65e84354ba14",
                                                "sense_id": "9d379bf9-5894-3c57-980a-466ad9db150e",
                                                "text": "Au fil des décennies, 700 sites miniers contaminés ont été abandonnés. Les coûts associés à cet héritage toxique sont estimés à 1,2 milliard de dollars. Voilà un bel exemple de privatisation des profits et de socialisation des coûts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
