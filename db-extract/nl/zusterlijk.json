                "senses": [
                    {
                        "sense_id": "25bb85c1-772b-3426-bd6a-12d09d8324dd",
                        "entry_id": "d9927956-0685-34c6-a743-df7c34c153e1",
                        "glosses": [
                            "zoals hoort bij zussen, gelijkwaardig en nauw verwant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "823edffc-c5dd-45a8-85cb-d8661bc1763b",
                                "sense_id": "25bb85c1-772b-3426-bd6a-12d09d8324dd",
                                "text": "Ook kreeg Samantha veel media-aandacht door haar voornemen een boek te schrijven waarin ze in de titel naar Meghan verwijst met Princess Pushy. Al met al niet echt brandstof voor het inblazen van nieuw leven van de zusterlijke relatie."
                            },
                            {
                                "example_id": "e59049ed-9f99-4aec-9cbf-579d765e9005",
                                "sense_id": "25bb85c1-772b-3426-bd6a-12d09d8324dd",
                                "text": "In het woonhuis van de Amsterdamse koopman Isaac Rooleeuw op de Nieuwendijk hingen ze eind zeventiende eeuw zusterlijk naast elkaar, De melkmeid en De dame met de weegschaal, beide geschilderd door Johannes Vermeer (1632-1675). Twee jonge meisjes, allebei getooid met een wit kapje, allebei geconcentreerd in de weer met hun dagelijkse bezigheden."
                            }
                        ]
                    }
                ],
