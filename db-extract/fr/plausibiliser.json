                "senses": [
                    {
                        "sense_id": "4e3451a8-6b19-3434-b9d3-ea93084d405d",
                        "entry_id": "cf5f596c-bb40-3d6c-9118-f0284e139d17",
                        "glosses": [
                            "Faire en sorte que quelque chose soit plausible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0c6bba-ce93-414f-952b-55c2e15c2d28",
                                "sense_id": "4e3451a8-6b19-3434-b9d3-ea93084d405d",
                                "text": "Plausibiliser des données, les transformer et les traiter."
                            },
                            {
                                "example_id": "4f6d20f2-b17e-42cc-bd55-52e00b3f3758",
                                "sense_id": "4e3451a8-6b19-3434-b9d3-ea93084d405d",
                                "text": "De plus, elles sont essentielles pour plausibiliser les données des assureurs."
                            },
                            {
                                "example_id": "101e895a-9865-438a-ae49-c9cebcfbc3e2",
                                "sense_id": "4e3451a8-6b19-3434-b9d3-ea93084d405d",
                                "text": "La présente concerne différents procédés pour plausibiliser des signaux de positions GNSS, entre autres un procédé pour plausibiliser des signaux de position (112, 14f) d'un système global de navigation par satellite (100) dans un véhicule (1) comprenant au moins un système de détection (2) pour détecter des objets (64, 66, 70, 72, 67) dans l'environnement périphérique du véhicule (1) et un dispositif de réception (10) pour recevoir les signaux de position (112, 14f), le procédé comprenant les étapes consistant : à recevoir des signaux de position (112, 14f) au moyen du dispositif de réception (10) et à déterminer la position propre du véhicule (1) grâce aux signaux de position (112, 14f); à détecter au moins un objet (64, 66, 70, 72, 67) dans l'environnement périphérique au moyen du système de détection (2) et à déterminer la position de l'objet (64, 66, 70, 72, 67); à plausibiliser les signaux de position (112, 14f) en faisant coïncider au moins une position d'un objet (64, 66, 70, 72, 67) avec la position propre du véhicule (1)."
                            }
                        ]
                    }
