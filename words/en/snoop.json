                            },
                            {
                                "target_lang_word": "karıştırma",
                                "target_lang_sense_clarification": "birinin özel eşyalarını izinsiz inceleme"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "węszenie",
                                "target_lang_sense_clarification": "próba odkrycia tajemnic lub ukrytych spraw"
                            },
                            {
                                "target_lang_word": "myszkowanie",
                                "target_lang_sense_clarification": "zaglądanie w cudze zakamarki lub rzeczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c32845d-6806-3b8d-970d-b5a76074ebf8",
                    "sense_definition": "A private detective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hired a <w>snoop</w> to find out if her husband was having an affair.",
                            "target_lang_translations": {
                                "ru": "Она наняла <w>сыщика</w>, чтобы узнать, нет ли у её мужа романа на стороне.",
                                "tr": "Kocasının bir ilişkisi olup olmadığını öğrenmek için bir <w>hafiye</w> tuttu.",
                                "pl": "Wynajęła <w>prywatnego detektywa</w>, aby dowiedzieć się, czy mąż ją zdradza."
                            }
                        },
                        {
                            "text": "The professional <w>snoop</w> followed the suspect for three days without being noticed.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>детектив</w> следил за подозреваемым три дня, оставаясь незамеченным.",
                                "tr": "Profesyonel <w>dedektif</w>, şüpheliyi üç gün boyunca fark edilmeden takip etti.",
                                "pl": "Zawodowy <w>detektyw</w> śledził podejrzanego przez trzy dni, pozostając niezauważonym."
                            }
                        }
                    ],
                    "synonyms": [
