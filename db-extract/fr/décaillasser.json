                "senses": [
                    {
                        "sense_id": "7416abe2-13ee-349e-b1a5-41e8b04307a2",
                        "entry_id": "59a63f3e-99c1-3020-b36f-6c270b88629f",
                        "glosses": [
                            "Débarrasser de la caillasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1509376-27da-487c-bb70-fff409ce3158",
                                "sense_id": "7416abe2-13ee-349e-b1a5-41e8b04307a2",
                                "text": "À dix-neuf ans, Adrien était déjà un homme. Grand, fort, élevé exclusivement par son père, bardeleur, il avait grandi dans la culture de la force, aidant à dessoucher, décaillasser, désembouer."
                            },
                            {
                                "example_id": "1a2df534-b1c0-4798-a2d4-7d8e0d2b84b4",
                                "sense_id": "7416abe2-13ee-349e-b1a5-41e8b04307a2",
                                "text": "Ils y avaient conçu leur nid, fécondé leur couche, défriché un brûlot hostile, décaillassé d’impossibles parcelles, dressé des terrasses, inventé des règles de survie…"
                            }
                        ]
                    }
                ],
