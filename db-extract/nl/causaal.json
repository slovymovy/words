                                    },
                                    {
                                        "sense_id": "2730806b-a7d6-3bdb-b7f6-f5eed78e83e4",
                                        "entry_id": "94764c0d-81ad-3ac8-9c3f-37e392fa3ab4",
                                        "glosses": [
                                            "die Ursache (als grammatische oder semantische Kategorie) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37fb9375-a3e9-448b-9237-9f1d4f3b0329",
                                                "sense_id": "2730806b-a7d6-3bdb-b7f6-f5eed78e83e4",
                                                "text": "Die Wörter „da“ und „weil“ sind kausale Subjunktionen im Deutschen."
