                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb7e21d-a816-47ab-9ea0-5871dd9adef8",
                                "sense_id": "a6c79cfc-838f-3acc-bdb8-7a0b57ce69d1",
                                "text": "„In den fünfziger und sechziger Jahren war die Steinfischerei eine lukrative Einkommensquelle.“"
                            },
                            {
                                "example_id": "47f77ebc-10b9-401a-b283-ad79e292ec7c",
                                "sense_id": "a6c79cfc-838f-3acc-bdb8-7a0b57ce69d1",
                                "text": "„Die Steinfischerei nahm jedoch derartige Ausmaße an, daß Veränderungen am Küstenprofil nicht ausblieben und die Regierung gezwungen war, gewisse Einschränkungen vorzunehmen.“"
                            }
                        ],
