                                    {
                                        "sense_id": "aefd9ac6-f026-38e9-95f7-ed4a936e88a8",
                                        "entry_id": "cec83384-c022-3cfc-8499-3c0d17ca412a",
                                        "glosses": [
                                            "Eigenschaft, wenig begütert/ärmlich zu sein"
                                        ],
                                        "tags": [],
