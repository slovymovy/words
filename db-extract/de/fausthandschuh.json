                "senses": [
                    {
                        "sense_id": "c2829954-7a39-35c1-85a5-49e780acadab",
                        "entry_id": "0bdd71e1-239c-3031-ad6f-17c917c7ebe6",
                        "glosses": [
                            "Handschuh mit einem Fach für den Daumen und einem weiteren für alle vier weiteren Finger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea30e7b2-41b7-45c0-bcea-26dda77d5cee",
                                "sense_id": "c2829954-7a39-35c1-85a5-49e780acadab",
                                "text": "„Ich zog meine Fausthandschuhe aus und grüßte, und er sagte bitteschön und forderte mich auf, einzutreten.“"
                            },
                            {
                                "example_id": "98ba90b2-9ffd-4a46-b1eb-46093a59cbd1",
                                "sense_id": "c2829954-7a39-35c1-85a5-49e780acadab",
                                "text": "„Er richtete sich auf der Bank neben dem Kutscher ein, angetan mit seinem ältesten Überrock, bewaffnet mit einem Halstuch, Fausthandschuhen und seinem Fußsack aus dem Büro, und so verließ er am 20. März bei Tagesanbruch die Hauptstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
