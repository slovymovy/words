                        "glosses": [
                            "Ancienne coiffure de femme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683e709c-ff59-41e8-bf1e-f2f6c53c200d",
                                "sense_id": "4a496776-28bf-36e7-adb9-c9fbdfe471cc",
                                "text": "Elle arrangeait quelques boucles de sa belle chevelure noire, afin d’en marier les touffes avec un nouvel escoffion de velours, et se regardait attentivement dans son miroir."
                            },
                            {
                                "example_id": "328ce5fa-c02e-472d-9ac6-d4df632f8ca1",
                                "sense_id": "4a496776-28bf-36e7-adb9-c9fbdfe471cc",
                                "text": "Lʼescoffion devenait tantôt une résille de soie de laquelle sʼéchappaient les cheveux en boucles ondoyantes, ou bien il dressait deux cornes triomphantes, en forme de croissant, et maintenues par un petit voile qui se nouait sous le menton."
                            }
                        ]
