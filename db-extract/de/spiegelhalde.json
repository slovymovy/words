                ],
                "senses": [
                    {
                        "sense_id": "ed7c8f75-d6af-3658-9352-79bb3f056524",
                        "entry_id": "e0cdd542-1a7c-3e71-a598-0ceab05eee76",
                        "glosses": [
                            "die Sonnenseite eines Tales, ein nach Süden geneigter Hang, der die Sonne spiegelt oder reflektiert"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "226c3e84-d87a-41c8-ac1c-95d71c8a9e43",
                                "sense_id": "ed7c8f75-d6af-3658-9352-79bb3f056524",
                                "text": "„Die Sonnenseite des Tales ist im Sprachgebrauch des Schwarzwälders die Spiegelhalde, die Sonnenhalde; die Schattenseite heißt die Winterhalde.“"
                            },
                            {
                                "example_id": "65cb6dad-2228-4215-917e-17d2d4404d33",
                                "sense_id": "ed7c8f75-d6af-3658-9352-79bb3f056524",
                                "text": "„In der Regel liegt der Hof nicht allzu hoch über Tal und Bach, meist in Südlage (Spiegelhalde), je nach Boden, Wasser und Wind aber auch am Schattenhang (Winterhalde); […]“"
                            },
                            {
                                "example_id": "52238ed8-d865-4ea5-b461-5ed6287c7f2f",
                                "sense_id": "ed7c8f75-d6af-3658-9352-79bb3f056524",
                                "text": "„Ein anderer Familiennamen-Typ entstand daraus, dass man die Personen nach der Stätte, an der sie wohnten, zu benannt hat: Der am Bächle Wohnende war der Bächle(r), der an der im Schatten liegenden und daher spät abtauenden Winterhalde eines Tales Wohnende der Winterhalder, der an der die Sonne spiegelnden Spiegelhalde der Spiegelhalder, und da der hiesige Dialekt d und t nicht unterscheidet, werden sie meist falsch Winterhalter und Spiegelhalter geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1c2091bb-b7ab-352a-824a-5e97f9419fc8",
                        "entry_id": "e0cdd542-1a7c-3e71-a598-0ceab05eee76",
                        "glosses": [
                            "Flurname nach [1]"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "1bd8f490-168b-42f2-9108-10e4929332b7",
                                "sense_id": "1c2091bb-b7ab-352a-824a-5e97f9419fc8",
                                "text": "„Meistens wurde bei Michel Bergner in der Spiegelhalde gespeist.“"
                            },
                            {
                                "example_id": "aa620788-5167-42e9-b607-c92c2c89c619",
                                "sense_id": "1c2091bb-b7ab-352a-824a-5e97f9419fc8",
                                "text": "„Weiter wurde in den Protokollen zur Ortbereisung aufgenommen, daß sich die Arrestzelle im Nebenhaus des Wirtshauses Zur Spiegelhalde befindet.“"
                            },
                            {
                                "example_id": "17fe4c06-f74b-4383-90f9-b3153fa3f6b8",
                                "sense_id": "1c2091bb-b7ab-352a-824a-5e97f9419fc8",
                                "text": "Diese Flur setzt sich „aus folgenden Gewannen zusammen: Randen Zelg: Rüthilihalde, In der alten Rüthi, Spiegelhalde, […]“ zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
