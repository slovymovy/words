{
    "word_family": [
        "featureless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd0971cc-21d5-3380-85a4-4804eb2999ce",
                    "sense_definition": "A typical quality or an important part of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "characteristic_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teamwork is a key <w>feature</w> of the training program.",
                            "target_lang_translations": {
                                "ru": "Командная работа — ключевая <w>особенность</w> программы обучения.",
                                "zh": "团队合作是该培训项目的核心<w>特征</w>。"
                            }
                        },
                        {
                            "text": "The car has excellent safety <w>features</w>.",
                            "target_lang_translations": {
                                "ru": "У автомобиля отличные <w>особенности</w> безопасности.",
                                "zh": "这款车具备出色的安全<w>功能</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "characteristic",
                        "trait",
                        "attribute",
                        "quality",
                        "property",
                        "aspect",
                        "element"
                    ],
                    "common_phrases": [
                        "key feature",
                        "main feature",
                        "distinctive feature",
                        "safety feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Типичное качество или важная часть чего-либо.",
                        "zh": "事物的典型品质或重要组成部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осо́бенность",
                                "target_lang_sense_clarification": "отличительное свойство"
                            },
                            {
                                "target_lang_word": "черта́",
                                "target_lang_sense_clarification": "характерный признак"
                            },
                            {
                                "target_lang_word": "сво́йство",
                                "target_lang_sense_clarification": "качество"
                            },
                            {
                                "target_lang_word": "при́знак",
                                "target_lang_sense_clarification": "показатель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特征",
                                "target_lang_sense_clarification": "事物的显著特点"
                            },
                            {
                                "target_lang_word": "特色",
                                "target_lang_sense_clarification": "事物所表现出的独特色彩或风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81ea3aa4-ff91-33dc-bd61-705e32467640",
                    "sense_definition": "A special function or capability of a software or product.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "characteristic_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest update includes a useful new <w>feature</w>.",
                            "target_lang_translations": {
                                "ru": "Последнее обновление включает полезную новую <w>функцию</w>.",
                                "zh": "最新更新包含一项实用的新<w>功能</w>。"
                            }
                        },
                        {
                            "text": "One cool <w>feature</w> of this app is the dark mode.",
                            "target_lang_translations": {
                                "ru": "Одна классная <w>функция</w> этого приложения — темный режим.",
                                "zh": "这款应用的一个酷炫<w>功能</w>是深色模式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "new feature",
                        "security feature",
                        "standard feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальная функция или возможность программного обеспечения или продукта.",
                        "zh": "软件或产品的一种特殊功能或能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу́нкция",
                                "target_lang_sense_clarification": "опция программы или устройства"
                            },
                            {
                                "target_lang_word": "возмо́жность",
                                "target_lang_sense_clarification": "способность выполнять действие"
                            },
                            {
                                "target_lang_word": "фи́ча",
                                "target_lang_sense_clarification": "сленг, компьютерное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "功能",
                                "target_lang_sense_clarification": "软件或设备所具备的效能"
                            },
                            {
                                "target_lang_word": "特性",
                                "target_lang_sense_clarification": "产品所具备的特定属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d1fa628-a1fc-331c-84ea-dd478114e91f",
                    "sense_definition": "A part of the face, such as the eyes, nose, or mouth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her eyes are her most striking <w>feature</w>.",
                            "target_lang_translations": {
                                "ru": "Ее глаза — самая поразительная <w>черта</w> ее лица.",
                                "zh": "她的眼睛是她最引人注目的<w>五官</w>。"
                            }
                        },
                        {
                            "text": "He has strong, regular <w>features</w>.",
                            "target_lang_translations": {
                                "ru": "У него строгие, правильные <w>черты лица</w>.",
                                "zh": "他有着轮廓分明且端正的<w>五官</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "facial features",
                        "sharp features",
                        "delicate features"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть лица, например, глаза, нос или рот.",
                        "zh": "面部的组成部分，如眼睛、鼻子或嘴巴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черта́ лица́",
                                "target_lang_sense_clarification": "часть внешности"
                            },
                            {
                                "target_lang_word": "черта́",
                                "target_lang_sense_clarification": "линия, контур"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五官",
                                "target_lang_sense_clarification": "指人的面部特征"
                            },
                            {
                                "target_lang_word": "面容",
                                "target_lang_sense_clarification": "指人的长相特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1741b902-b855-3b8e-ae18-0b375f11fea8",
                    "sense_definition": "A special article in a newspaper or magazine, or a special report on television.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine published a <w>feature</w> on healthy eating.",
                            "target_lang_translations": {
                                "ru": "Журнал опубликовал специальную <w>статью</w> о здоровом питании.",
                                "zh": "该杂志刊登了一篇关于健康饮食的<w>专题文章</w>。"
                            }
                        },
                        {
                            "text": "Tonight's news includes a special <w>feature</w> on local history.",
                            "target_lang_translations": {
                                "ru": "В сегодняшних новостях будет специальный <w>репортаж</w> о местной истории.",
                                "zh": "今晚的新闻包含一个关于当地历史的特别<w>特写</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "feature article",
                        "special feature",
                        "feature story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальная статья в газете или журнале, или специальный репортаж на телевидении.",
                        "zh": "报纸或杂志中的专题文章，或电视上的特别报道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статья́",
                                "target_lang_sense_clarification": "публикация"
                            },
                            {
                                "target_lang_word": "о́черк",
                                "target_lang_sense_clarification": "художественно-публицистический жанр"
                            },
                            {
                                "target_lang_word": "спецрепорта́ж",
                                "target_lang_sense_clarification": "на телевидении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "专题文章",
                                "target_lang_sense_clarification": "报刊中的深度报道"
                            },
                            {
                                "target_lang_word": "特写",
                                "target_lang_sense_clarification": "新闻或影视中的专题报道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd3f936-77b5-3b3d-8d3d-02ff0943b269",
                    "sense_definition": "A full-length film intended as the main item in a cinema programme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cartoon is now a full-length <w>feature</w>.",
                            "target_lang_translations": {
                                "ru": "Мультфильм теперь стал полнометражным <w>фильмом</w>.",
                                "zh": "这部动画片现在是一部完整的<w>剧情长片</w>。"
                            }
                        },
                        {
                            "text": "They are watching a <w>feature</w> at the cinema.",
                            "target_lang_translations": {
                                "ru": "Они смотрят <w>художественный фильм</w> в кинотеатре.",
                                "zh": "他们正在电影院看一部<w>正片</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "feature film",
                        "double feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полнометражный фильм, показываемый как основной в программе кинотеатра.",
                        "zh": "作为电影院节目主要内容的剧情长片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "худо́жественный фильм",
                                "target_lang_sense_clarification": "игровое кино"
                            },
                            {
                                "target_lang_word": "полнометра́жный фильм",
                                "target_lang_sense_clarification": "по длительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剧情长片",
                                "target_lang_sense_clarification": "正式的电影作品"
                            },
                            {
                                "target_lang_word": "正片",
                                "target_lang_sense_clarification": "电影院放映的主要影片"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd030e46-335e-3f37-8891-57d7e8874316",
                    "sense_definition": "To include someone or something as a special or important part.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhibition <w>features</w> paintings by local artists.",
                            "target_lang_translations": {
                                "ru": "На выставке <w>представлены</w> картины местных художников.",
                                "zh": "此次展览<w>以</w>当地艺术家的画作为<w>特色</w>。"
                            }
                        },
                        {
                            "text": "The new album <w>features</w> several guest singers.",
                            "target_lang_translations": {
                                "ru": "Новый альбом <w>включает</w> несколько приглашенных певцов.",
                                "zh": "这张新专辑<w>主打</w>了几位客座歌手的演唱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "feature prominently",
                        "feature a guest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать кого-либо или что-либо в качестве специальной или важной части.",
                        "zh": "将某人或某物作为特殊或重要的部分包含在内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включа́ть",
                                "target_lang_sense_clarification": "содержать в себе"
                            },
                            {
                                "target_lang_word": "представля́ть",
                                "target_lang_sense_clarification": "показывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以……为特色",
                                "target_lang_sense_clarification": "突出某事物作为重点"
                            },
                            {
                                "target_lang_word": "主打",
                                "target_lang_sense_clarification": "作为主要内容呈现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0954b43-ec37-3655-9183-c229bb97170e",
                    "sense_definition": "To play a major part or have an important position in something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vegetables <w>feature</w> heavily in their diet.",
                            "target_lang_translations": {
                                "ru": "Овощи <w>занимают важное место</w> в их рационе.",
                                "zh": "蔬菜在他们的饮食中<w>占重要地位</w>。"
                            }
                        },
                        {
                            "text": "She <w>featured</w> in the news yesterday.",
                            "target_lang_translations": {
                                "ru": "Она <w>фигурировала</w> во вчерашних новостях.",
                                "zh": "她昨天在新闻中<w>出现</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "feature in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть главную роль или занимать важное положение в чем-либо.",
                        "zh": "在某事中起主要作用或占据重要地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фигури́ровать",
                                "target_lang_sense_clarification": "присутствовать, упоминаться"
                            },
                            {
                                "target_lang_word": "занима́ть ва́жное ме́сто",
                                "target_lang_sense_clarification": "быть значимым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占重要地位",
                                "target_lang_sense_clarification": "在某领域中很重要"
                            },
                            {
                                "target_lang_word": "出现",
                                "target_lang_sense_clarification": "在媒体或事件中被提及"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}