                "senses": [
                    {
                        "sense_id": "ca41946f-327a-3cbc-afa4-4cd454f9e0b9",
                        "entry_id": "c2be6fc0-b535-33a1-98f3-d68bc5c328cb",
                        "glosses": [
                            "Ehefrau eines Präsidenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf759ea-50d3-4557-96e6-44c3a8d18586",
                                "sense_id": "ca41946f-327a-3cbc-afa4-4cd454f9e0b9",
                                "text": "„Als Ehefrau des allmächtigen Robert Mugabe war sie für ihre Gegner nicht angreifbar, weshalb sich ehrgeizige jüngere Politiker, die mit der Präsidentengattin nur die gemeinsame Furcht vor Mnangagwa teilten, mit ihr verbündeten, um zunächst zahlreiche Anhänger Mnangagwas aus staatlichen Ämtern und Parteiposten zu entfernen.“"
                            },
                            {
                                "example_id": "5c04ba76-7a45-41cc-af90-9ccb29faa6b7",
                                "sense_id": "ca41946f-327a-3cbc-afa4-4cd454f9e0b9",
                                "text": "„So weit hergeholt war diese Befürchtung nicht, war doch zum Beispiel Lee Hanyoung, ein Neffe der Präsidentengattin, im Flur von seinem Apartment von Killern der Operationsabteilung erschossen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
