                        "sense_id": "02b6582d-551f-3022-bba1-74e32634c3ff",
                        "entry_id": "a56af8f4-576e-3f9b-a6d0-87e817b7781e",
                        "glosses": [
                            "Combinaison, vêtement d’une seule pièce habillant le corps."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f825f38d-4642-46dc-a5cd-adc29d8cd52f",
                                "sense_id": "02b6582d-551f-3022-bba1-74e32634c3ff",
                                "text": "Enfile ta combi et rejoins-nous dans l’eau."
                            },
                            {
                                "example_id": "98aa3373-db35-4eb1-b361-5fc9ca2fa694",
                                "sense_id": "02b6582d-551f-3022-bba1-74e32634c3ff",
                                "text": "En rangées cadencées, quatre par quatre, battant solennellement la mesure, les numéros défilaient — des centaines, des milliers de numéros, en combis [Abréviation du mot ancien « combinaison » : uniforme de travail. Note du narrateur.] bleutées, plaque dorée sur la poitrine […]."
                            }
                        ]
                    }
                ],
