                                    {
                                        "sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                                        "entry_id": "fd4621d0-7ce3-36f0-8d11-22d16806ea7c",
                                        "glosses": [
                                            "Robe très courte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc70009e-8c70-4a81-b137-ce1b55c91eda",
                                                "sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                                                "text": "Qualifiée par la presse de « révolutionnaire », la minirobe présentée par André Courrèges lors desa collection été de 1965 fut le symbole ultime de la libération de la femme."
                                            },
                                            {
                                                "example_id": "eae2af23-a32a-432b-afdc-f4f0d2a56857",
                                                "sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                                                "text": "Dans sa minirobe mi-broderie mi-paillettes, elle se sentait mal. Elle était en avance. Esseulée, perchée contre sa table, elle polarisait les regards. Pire, elle en était consciente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c65c82f-b1bd-42a1-b756-709f3a604851",
