                                "target_lang_sense_clarification": "Designed to be easily transported or moved."
                            },
                            {
                                "target_lang_word": "portable",
                                "target_lang_sense_clarification": "Easily carried or moved."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cb91393-cc71-361d-a2f0-db12c1d2ea3e",
