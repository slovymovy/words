                "senses": [
                    {
                        "sense_id": "8fc27f24-9040-3f7b-88ea-2d655ffd5352",
                        "entry_id": "235a4218-5ced-35e7-bbaf-5a7cefc99a9e",
                        "glosses": [
                            "Juive ; femme de confession ou de culture israélite."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "3f3bff5e-1f46-462e-97b0-8331d55e42ff",
                                "sense_id": "8fc27f24-9040-3f7b-88ea-2d655ffd5352",
                                "text": "Il y avait tout de même une différence entre une association de youpines et le gouvernement de Sa Majesté britannique ! »"
                            },
                            {
                                "example_id": "5329fd1f-732a-404f-aead-34ded58fe4d3",
                                "sense_id": "8fc27f24-9040-3f7b-88ea-2d655ffd5352",
                                "text": "— T'es pincé, hein ? Moi, à ta place, je ne bougerais pas le petit doigt pour une youpine.\n— Sois pas vache, insista Jacquot, c'est pas à la youpine que je veux écrire, c'est à la fille. Et d'abord, qu'est-ce qui prouve qu'elle est juive ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05b4a44e-95dd-4961-b6fb-78942eb3f97d",
                        "source_entry_id": "235a4218-5ced-35e7-bbaf-5a7cefc99a9e",
                        "source_sense_id": "8fc27f24-9040-3f7b-88ea-2d655ffd5352",
                        "target_lang_word": "жидовка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жидовка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d23ac857-8ccb-37a9-9cd3-aa20729328ec",
                                        "entry_id": "da83c700-6349-34dc-8a86-b42f04384e20",
                                        "glosses": [
                                            "устар. женск. к жид; еврейка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d1674d-9a7b-46dc-a24d-b982a16b9fa1",
                                                "sense_id": "d23ac857-8ccb-37a9-9cd3-aa20729328ec",
                                                "text": "Жидовка оборотилась ко мне, окинула быстро глазами и подошла так близко, что дыхание её разливалось теплотою по лицу моему."
                                            },
                                            {
                                                "example_id": "1a0fcf55-1f7f-4f32-b4bf-f5f2727e2ec9",
                                                "sense_id": "d23ac857-8ccb-37a9-9cd3-aa20729328ec",
                                                "text": "Все это очень по-любительски, слабо и безвкусно, но люди всё же не бездарные, в особенности две жидовки: Опалова-Авербах и Магприл, третья, поразившая меня два года назад в разговоре двух, была Манасейне Ратнер, оказалась дамой за тридцать лет, щекастой и вообще очень некрасивой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b386be-d06e-3459-a2e9-cf613daa5c63",
                                        "entry_id": "da83c700-6349-34dc-8a86-b42f04384e20",
                                        "glosses": [
                                            "груб. еврейка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c8ff526-bdd2-47be-bc48-b75450079ce0",
                                                "sense_id": "66b386be-d06e-3459-a2e9-cf613daa5c63",
                                                "text": "Классе во втором было, какая-то сволочь во дворе обозвала её жидовкой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
