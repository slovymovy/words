    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d159afbc-2f2e-3c41-af6a-701436de023f",
                    "sense_definition": "A miserly person who hates spending money or resources.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "miser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>scrooge</w> and leave a generous tip for the waiter."
                        },
                        {
                            "text": "The company owner was known as a total <w>scrooge</w> who refused to heat the office properly."
                        }
                    ],
                    "synonyms": [
                        "miser",
                        "cheapskate",
                        "skinflint",
                        "tightwad"
                    ],
                    "antonyms": [
                        "spendthrift"
                    ],
                    "common_phrases": [
                        "total scrooge",
                        "real scrooge"
                    ]
                },
                {
                    "sense_id": "7a197ea4-ba44-33ab-ade4-54ed3b3b1ec6",
                    "sense_definition": "A person who dislikes Christmas or behaves grumpily during the holiday season.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "miser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to put up a tree, earning a reputation as the neighborhood <w>scrooge</w>."
                        },
                        {
                            "text": "Try not to be such a <w>scrooge</w> this holiday season and join the party."
                        }
                    ],
                    "common_phrases": [
                        "holiday scrooge",
                        "Christmas scrooge"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "73146e80-4b8d-328d-801a-719d0478c0be",
                    "sense_definition": "A fictional character from Charles Dickens' novella 'A Christmas Carol' who is transformed from a bitter miser into a kind man.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fictional_character",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "Every December, the local theater performs a classic adaptation of <w>Scrooge</w>."
                        },
                        {
                            "text": "Charles Dickens created <w>Scrooge</w> to critique Victorian greed and poverty."
                        }
                    ],
                    "synonyms": [
                        "Ebenezer Scrooge"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                    "sense_definition": "To behave in a greedy, selfish, or miserly manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behave_miserly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The executives were accused of <w>scrooging</w> their employees out of earned bonuses."
                        },
                        {
                            "text": "Instead of sharing the profits, he <w>scrooged</w> every penny for himself."
                        }
                    ],
                    "synonyms": [
                        "skimp",
                        "scrimp"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage derived from the character's name"
                        }
                    ]
                },
                {
                    "sense_id": "d94771af-9e61-37fb-a879-d17fe27c4b8b",
                    "sense_definition": "To squeeze, press, or crush together, or to squeeze past someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "squeeze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We managed to <w>scrooge</w> through the crowded corridor just before the doors closed."
                        },
                        {
                            "text": "All five passengers had to <w>scrooge</w> into the tiny back seat of the car."
                        }
                    ],
                    "synonyms": [
                        "squeeze",
                        "cram"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic variant of scrouge"
                        }
                    ]
                }
            ]
        }
    ]
