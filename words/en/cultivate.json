        "uncultivated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd286f24-659b-377a-ba5f-366f9a4eb5f7",
                    "sense_definition": "To prepare and use land for crops or gardening, or to grow plants and crops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most farmers in this region <w>cultivate</w> maize because the soil is very rich.",
                            "target_lang_translations": {
                                "ru": "Большинство фермеров в этом регионе <w>выращивают</w> кукурузу, так как почва здесь очень плодородная.",
                                "tr": "Bu bölgedeki çiftçilerin çoğu, toprak çok verimli olduğu için mısır <w>yetiştiriyor</w>.",
                                "nl": "De meeste boeren in deze regio <w>verbouwen</w> maïs omdat de grond erg vruchtbaar is."
                            }
                        },
                        {
                            "text": "It is difficult to <w>cultivate</w> crops in such a dry and rocky environment.",
                            "target_lang_translations": {
                                "ru": "В такой сухой и каменистой среде трудно <w>возделывать</w> сельскохозяйственные культуры.",
                                "tr": "Böylesine kuru ve kayalık bir ortamda ürün <w>yetiştirmek</w> zordur.",
                                "nl": "Het is moeilijk om gewassen te <w>telen</w> in zo'n droge en rotsachtige omgeving."
                            }
                        }
                    ],
                    "synonyms": [
                        "farm",
                        "grow"
                    ],
                    "common_phrases": [
                        "cultivate the land",
                        "cultivate crops",
                        "cultivate vegetables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготавливать и использовать землю для посева или садоводства, либо выращивать растения и сельскохозяйственные культуры.",
                        "tr": "Toprağı ekim veya bahçecilik için hazırlamak ve kullanmak ya da bitki ve ürün yetiştirmek.",
                        "nl": "Grond bewerken en gebruiken voor gewassen of tuinieren, of planten en gewassen verbouwen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выращивать",
                                "target_lang_sense_clarification": "растения или культуры"
                            },
                            {
                                "target_lang_word": "возделывать",
                                "target_lang_sense_clarification": "землю или культуры"
                            },
                            {
                                "target_lang_word": "культивировать",
                                "target_lang_sense_clarification": "разводить определенные виды"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yetiştirmek",
                                "target_lang_sense_clarification": "bitki veya ürün büyütmek"
                            },
                            {
                                "target_lang_word": "işlemek",
                                "target_lang_sense_clarification": "toprağı tarım için hazırlamak"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verbouwen",
                                "target_lang_sense_clarification": "van gewassen of groenten"
                            },
                            {
                                "target_lang_word": "telen",
                                "target_lang_sense_clarification": "van planten of gewassen"
                            },
                            {
                                "target_lang_word": "kweken",
                                "target_lang_sense_clarification": "van planten of bloemen"
                            },
                            {
                                "target_lang_word": "bewerken",
                                "target_lang_sense_clarification": "van land of grond"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "049ea093-2d07-321e-9cba-8401ad229673",
                    "sense_definition": "To try to acquire or develop a quality, sentiment, or skill; to foster or nurture a relationship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They tried to <w>cultivate</w> an interest in learning among their students through creative projects.",
                            "target_lang_translations": {
                                "ru": "Они старались <w>развить</w> интерес к учебе у своих студентов с помощью творческих проектов.",
                                "tr": "Yaratıcı projeler aracılığıyla öğrencilerinde öğrenmeye karşı bir ilgi <w>geliştirmeye</w> çalıştılar.",
                                "nl": "Ze probeerden door middel van creatieve projecten een interesse in leren te <w>ontwikkelen</w> bij hun studenten."
                            }
                        },
                        {
                            "text": "The diplomat worked hard to <w>cultivate</w> relationships with local leaders during his stay.",
                            "target_lang_translations": {
                                "ru": "Дипломат усердно работал над тем, чтобы <w>наладить</w> отношения с местными лидерами во время своего пребывания.",
                                "tr": "Diplomat, kaldığı süre boyunca yerel liderlerle ilişkiler <w>kurmak</w> için çok çalıştı.",
                                "nl": "De diplomaat werkte hard om tijdens zijn verblijf relaties met lokale leiders <w>op te bouwen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foster",
                        "nurture",
                        "develop",
                        "encourage"
                    ],
                    "antonyms": [
                        "neglect",
                        "stifle",
                        "abandon"
                    ],
                    "common_phrases": [
                        "cultivate an interest",
                        "cultivate a relationship",
                        "cultivate a habit",
                        "cultivate a reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться приобрести или развить качество, чувство или навык; развивать или поддерживать отношения.",
                        "tr": "Bir niteliği, duyguyu veya beceriyi edinmeye veya geliştirmeye çalışmak; bir ilişkiyi beslemek veya güçlendirmek.",
                        "nl": "Proberen een eigenschap, gevoel of vaardigheid te verwerven of ontwikkelen; relaties opbouwen of onderhouden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "навык или интерес"
                            },
                            {
                                "target_lang_word": "культивировать",
                                "target_lang_sense_clarification": "привычку или качество"
                            },
                            {
                                "target_lang_word": "налаживать",
                                "target_lang_sense_clarification": "связи или отношения"
                            },
                            {
                                "target_lang_word": "взращивать",
                                "target_lang_sense_clarification": "чувство или интерес"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geliştirmek",
                                "target_lang_sense_clarification": "beceri, ilgi veya nitelik"
                            },
                            {
                                "target_lang_word": "kurmak",
                                "target_lang_sense_clarification": "ilişki veya bağ oluşturmak"
                            },
                            {
                                "target_lang_word": "pekiştirmek",
                                "target_lang_sense_clarification": "ilişkiyi güçlendirmek"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontwikkelen",
                                "target_lang_sense_clarification": "van een vaardigheid, belangstelling of gewoonte"
                            },
                            {
                                "target_lang_word": "cultiveren",
                                "target_lang_sense_clarification": "formeel: van imago, gewoonte of relaties"
                            },
                            {
                                "target_lang_word": "opbouwen",
                                "target_lang_sense_clarification": "van relaties of contacten"
                            },
                            {
                                "target_lang_word": "onderhouden",
                                "target_lang_sense_clarification": "van relaties of vriendschappen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfa4e04e-1276-3a52-86ae-fa72f9ea4705",
                    "sense_definition": "To break up or stir the soil around growing plants to kill weeds and aerate the earth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>cultivate</w> the soil regularly to prevent weeds from taking over the garden.",
                            "target_lang_translations": {
                                "ru": "Вам следует регулярно <w>рыхлить</w> почву, чтобы сорняки не захватили сад.",
                                "tr": "Yabani otların bahçeyi ele geçirmesini önlemek için toprağı düzenli olarak <w>çapalamalısınız</w>.",
                                "nl": "Je moet de grond regelmatig <w>bewerken</w> om te voorkomen dat onkruid de tuin overwoekert."
                            }
                        },
                        {
                            "text": "The machine is designed to <w>cultivate</w> the soil between the rows of corn.",
                            "target_lang_translations": {
                                "ru": "Машина предназначена для того, чтобы <w>культивировать</w> почву между рядами кукурузы.",
                                "tr": "Makine, mısır sıraları arasındaki toprağı <w>kabartmak</w> için tasarlanmıştır.",
                                "nl": "De machine is ontworpen om de grond tussen de rijen maïs te <w>cultiveren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "till",
                        "harrow",
                        "plow"
                    ],
                    "common_phrases": [
                        "cultivate the soil"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical agricultural usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыхлить или перемешивать почву вокруг растущих растений для уничтожения сорняков и аэрации земли.",
                        "tr": "Yabani otları yok etmek ve toprağı havalandırmak için büyüyen bitkilerin etrafındaki toprağı kabartmak veya karıştırmak.",
                        "nl": "De grond rond groeiende planten losmaken of omwoelen om onkruid te verwijderen en de aarde te beluchten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "культивировать",
                                "target_lang_sense_clarification": "обрабатывать культиватором"
                            },
