                "senses": [
                    {
                        "sense_id": "0ba2a598-ce54-345a-94ff-8375f8d69ba4",
                        "entry_id": "3988be54-e84f-3adf-9c5f-c082d43c19dd",
                        "glosses": [
                            "Enlever les mucilages de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7115247a-7b55-482b-b0c3-9d5182ac60e9",
                                "sense_id": "0ba2a598-ce54-345a-94ff-8375f8d69ba4",
                                "text": "Plusieurs produits chimiques ont été expérimentés pour démucilaginer le café, notamment la chaux, qui précipite les pectines sous forme de pectates insolubles, facilement éliminés par un lavage."
                            },
                            {
                                "example_id": "f172e0ed-56c6-4822-88ea-820cce86470c",
                                "sense_id": "0ba2a598-ce54-345a-94ff-8375f8d69ba4",
                                "text": "Si l'on ne peut remettre ces semences à des centres Agronomiques que très tard, il convient de dépulper, de laver à la cendre de bois pour démucilaginer la parche, faire ressuyer si possible à l'ombre quelques heures et conserver en poudre de charbon de bois."
                            }
                        ]
                    }
