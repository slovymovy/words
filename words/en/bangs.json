                    "sense_definition": "Hair hanging over the forehead",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to cut her <w>bangs</w> shorter before the summer started.",
