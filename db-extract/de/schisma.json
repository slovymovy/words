                                "target_senses": [
                                    {
                                        "sense_id": "7d7a4cfa-e499-306d-bd7a-579042550ce3",
                                        "entry_id": "37222bc1-106f-3d0f-a577-62d78d587ae2",
                                        "glosses": [
                                            "ο διαχωρισμός μιας ενιαίας Εκκλησίας σε δύο τμήματα που δεν κοινωνούν εκκλησιαστικά μεταξύ τους"
                                        ],
                                        "tags": [
                                            "θρησκεία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "213790d8-ef74-418f-84cc-e5908a41b5ba",
                                                "sense_id": "7d7a4cfa-e499-306d-bd7a-579042550ce3",
                                                "text": "το σχίσμα του 1054 είχε βαρύτατες μακροπρόθεσμες συνέπειες για το Βυζάντιο"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad2f1b1-cf87-37e4-8dae-6a2976abc1d9",
                                        "entry_id": "37222bc1-106f-3d0f-a577-62d78d587ae2",
                                        "glosses": [
                                            "η διάσπαση ενός οργανωμένου συνόλου"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2595e31f-8daa-42d8-8652-83a755e1614d",
                                                "sense_id": "cad2f1b1-cf87-37e4-8dae-6a2976abc1d9",
                                                "text": "η διάσπαση του ενιαίου ΚΚΕ το 1968 προκάλεσε ένα βαθύ σχίσμα στους κόλπους της ελληνικής Αριστεράς"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fddbacab-1a8f-4e3f-83eb-01ee72ee56de",
                        "source_entry_id": "57fb8f78-4c4c-34a8-83e7-cd584c82773b",
                        "source_sense_id": "c5dd3dc6-7e90-3abc-a806-1403245f9db6",
                        "source_sense_description": "Religion: Spaltung von Religionsgemeinschaften",
                        "target_lang_word": "раскол",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "раскол",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ca712fb5-c93a-3d74-899c-6d7c3bd2d3a7",
                                        "entry_id": "dd35f02f-6d33-3c80-a17d-901a3fc492ec",
                                        "glosses": [
                                            "действие по значению гл. расколоть, раскалывать, расколоться, раскалываться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5483621-fbe0-4bf3-a9cc-c8233b9bdb04",
                                                "sense_id": "ca712fb5-c93a-3d74-899c-6d7c3bd2d3a7",
                                                "text": "В искусстве произошел решительный раскол: искусство фигуративное и искусство абстрактное, причем, с годами, новая форма стала занимать все более господствующее положение в глазах ценителей искусства, а также ― его историков, теоретиков и музейных деятелей"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a2e7b6-114b-3a8e-bacd-84a501d5e1db",
                                        "entry_id": "dd35f02f-6d33-3c80-a17d-901a3fc492ec",
                                        "glosses": [
                                            "место, по которому что-либо расколото"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f69f7b9-5242-4f3c-8753-f2371ad0c707",
                                                "sense_id": "38a2e7b6-114b-3a8e-bacd-84a501d5e1db",
                                                "text": "Её руки, пальцы стали нечувствительны, а перед глазами ― серый раскол льда"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf77ceec-a15f-3b2d-a241-64246e6d35ab",
                                        "entry_id": "dd35f02f-6d33-3c80-a17d-901a3fc492ec",
                                        "glosses": [
                                            "церк. отпадение от Церкви группы верующих ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c28cab1-55c1-4005-85cf-0ccf3ff74005",
                                                "sense_id": "bf77ceec-a15f-3b2d-a241-64246e6d35ab",
                                                "text": "Кто следует за вводящим раскол, тот не наследует Царствия Божьего»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc283c4c-cc41-3481-90bd-cdb689c3ac37",
                                        "entry_id": "dd35f02f-6d33-3c80-a17d-901a3fc492ec",
                                        "glosses": [
                                            "истор. религиозно-общественное движение в России, возникшее в середине XVII века, направленное против официальной церкви и закончившееся образованием старообрядчества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a753ed-e163-4c09-86b1-993eea605a11",
                                                "sense_id": "cc283c4c-cc41-3481-90bd-cdb689c3ac37",
                                                "text": "Раскол XVII века имел для всей русской истории гораздо большее значение, чем принято думать"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d569f5-74e2-3dac-b99d-cd921c0c9c04",
                                        "entry_id": "dd35f02f-6d33-3c80-a17d-901a3fc492ec",
                                        "glosses": [
                                            "устар. старообрядчество"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec6f71f-840a-4155-a1cf-f727367a2215",
                                                "sense_id": "26d569f5-74e2-3dac-b99d-cd921c0c9c04",
                                                "text": "Сестра моя знаменитая была женщина по божественной части, из православия в раскол ушла, а из раскола её — вышибли"
                                            },
                                            {
                                                "example_id": "35e1ce02-d124-4c27-b3a1-e6939bf8c027",
                                                "sense_id": "26d569f5-74e2-3dac-b99d-cd921c0c9c04",
                                                "text": "На тебя жалуется духовенство: ты перетянул в раскол почти всю деревню"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82d300b0-6e25-44d2-b742-589a4d5dc558",
                        "source_entry_id": "57fb8f78-4c4c-34a8-83e7-cd584c82773b",
                        "source_sense_id": "c5dd3dc6-7e90-3abc-a806-1403245f9db6",
                        "source_sense_description": "Religion: Spaltung von Religionsgemeinschaften",
                        "target_lang_word": "схизма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "схизма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f3c1e08-5e0c-3872-b314-21829e246bfb",
                                        "entry_id": "e50ae1ea-c64b-33f6-9a38-e858cad7eabe",
                                        "glosses": [
                                            "церк. раскол, отделение от ранее единой церкви какой-либо её части"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f38084-684e-4cd4-9da9-f33849d79866",
                                                "sense_id": "6f3c1e08-5e0c-3872-b314-21829e246bfb",
                                                "text": "Мне кажется, что здесь, несмотря на схизму, народ так же, как и в православной России, не очень набожен."
                                            },
                                            {
                                                "example_id": "3cbbc343-7048-4b24-b324-c6379bea3873",
                                                "sense_id": "6f3c1e08-5e0c-3872-b314-21829e246bfb",
                                                "text": "Потом началась великая схизма, давшая новые средства светской власти против духовной."
                                            },
                                            {
                                                "example_id": "d8a34280-387e-4d21-b6aa-1012060e9587",
                                                "sense_id": "6f3c1e08-5e0c-3872-b314-21829e246bfb",
                                                "text": "Он стремится показать или обнажить сам корень схизмы, показать эту основную отделяющую силу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b0d30d6-77bf-3adb-b25e-4956224347ff",
                                        "entry_id": "e50ae1ea-c64b-33f6-9a38-e858cad7eabe",
                                        "glosses": [
                                            "муз. микроинтервал, примерно равный двум центам, определяемый как разница между пифагорейской и синтонической коммами, близкая по величине разнице между натуральной и равномерно темперированной чистыми квинтами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74f46df-9807-470a-b9cd-b47ab7109e06",
                                                "sense_id": "7b0d30d6-77bf-3adb-b25e-4956224347ff",
                                                "text": "Разница между ПК (пифагорейской коммой) и СК (синтонической коммой) есть схизма… Схизматическая квинта даёт примерно одно биение а середине клавиатуры и эквивалентна нашей современной темперированной квинте, что лишь случайное совпадение."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
