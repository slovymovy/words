                ],
                "senses": [
                    {
                        "sense_id": "205e41e9-c2e7-347e-ab16-48b4de9f7645",
                        "entry_id": "d7f23e02-9fc4-3767-aceb-61748153c223",
                        "glosses": [
                            "ein christlicher Autor der ersten acht Jahrhunderte, der entscheidend zur Lehre und zum Selbstverständnis des Christentums beigetragen hat; der Ehrentitel Kirchenvater kam im vierten Jahrhundert auf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b35686d-4f83-437d-b16d-43d17e5f287b",
                                "sense_id": "205e41e9-c2e7-347e-ab16-48b4de9f7645",
                                "text": "\"Die altchristlichen Bischöfe sind über ihre persönlich literarische und historische Bedeutung hinaus als Kirchenvater die Übermittler und Zeugen der kirchlichen Lehre, insbesondere weil sie zu ihrer Zeit meistens auch die maßgeblichen Leiter und Lehrer der Kirche waren.\""
                            },
                            {
                                "example_id": "a539e2c5-5911-4c90-8c6e-b465a9836249",
                                "sense_id": "205e41e9-c2e7-347e-ab16-48b4de9f7645",
                                "text": "„Nach der Begegnung mit José begriff ich vollends, wie trostlos sie war, diese Vorstellung der Kirchenväter und der Blumenkinder gleichermaßen, die Liebe mit Lust verwechselten.“"
                            },
                            {
                                "example_id": "6422b04d-347b-45ee-8e1a-b6598a1d7123",
                                "sense_id": "205e41e9-c2e7-347e-ab16-48b4de9f7645",
                                "text": "„Die Kirchenväter sind ihm bekannt, und selbstverständlich die Geschichte der Inquisition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
