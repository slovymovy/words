                        "entry_id": "d6499f8e-f827-3433-9ca6-79d6e8180954",
                        "glosses": [
                            "Magnétron, dispositif de génération de micro-ondes."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "84c188f9-0e15-43d6-8216-93f6c8ab38f4",
                                "sense_id": "4ae2c78f-5094-3024-b3f0-705777c24d9d",
                                "text": "The magnetron finds wide application in microwave ovens.",
                                "translation": "Le magnétron trouve une large utilisation dans les fours à micro-ondes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0962d3e2-56b3-322e-8a8e-c412b9b13a60",
                        "entry_id": "d6499f8e-f827-3433-9ca6-79d6e8180954",
                        "glosses": [
                            "Magnétron, dispositif de déposition de couches minces par pulvérisation cathodique."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "713933c4-24be-40c5-b9d0-9992c02d128a",
                                "sense_id": "0962d3e2-56b3-322e-8a8e-c412b9b13a60",
                                "text": "Appeared in the 1970s, the magnetron allowed the wide-scale industrialisation of thin-film sputtering.",
                                "translation": "Apparu dans les années 1970, le magnétron a permis l’industrialisation à large échelle de la pulvérisation cathodique."
                            },
                            {
                                "example_id": "69233fb8-24f2-4603-94bd-fd964b24ba9c",
                                "sense_id": "0962d3e2-56b3-322e-8a8e-c412b9b13a60",
                                "text": "One recognises immediately a functioning magnetron by the characteristic ring-shaped plasma that forms on the target.",
                                "translation": "On reconnaît tout de suite un magnétron en fonctionnement à l’anneau caractéristique que forme le plasma sur la cible."
                            }
                        ]
                    }
