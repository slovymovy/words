                    {
                        "sense_id": "bceea2a4-0a20-3fa3-8e7c-870ebf5d9747",
                        "entry_id": "e7d09cca-f79d-3be9-8170-f9bbade3bc67",
                        "glosses": [
                            "Contraction of is not (negative auxiliary)"
