                                    {
                                        "sense_id": "7edad8d1-0a0c-342d-ac7c-625956bafc9a",
                                        "entry_id": "e1ec14c9-da11-3964-a35d-3a86cfdc5723",
                                        "glosses": [
                                            "A form of government, or the government in power, particularly an authoritarian or totalitarian one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa12c15f-f7a3-4263-a57e-dfc5943b0b82",
                                                "sense_id": "7edad8d1-0a0c-342d-ac7c-625956bafc9a",
                                                "text": "the dictator's regime"
                                            },
                                            {
                                                "example_id": "65620bd6-2862-4540-b817-ac785bee2c25",
                                                "sense_id": "7edad8d1-0a0c-342d-ac7c-625956bafc9a",
                                                "text": "Heaven will eliminate the tyrannical regimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da96a8b0-7a21-3126-b42b-8a01c86241b1",
                                        "entry_id": "e1ec14c9-da11-3964-a35d-3a86cfdc5723",
