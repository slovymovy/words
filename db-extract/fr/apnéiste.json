        "fr-extract.jsonl": [
            {
                "entry_id": "e4087300-9d18-3028-a08a-78e5f4d9eb16",
                "word": "apnéiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90ffdcf6-d872-422f-954d-2821d53116b8",
                        "entry_id": "e4087300-9d18-3028-a08a-78e5f4d9eb16",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "apnéistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "215bf6ac-3bf7-3ddf-b033-e67e3a984b59",
                        "entry_id": "e4087300-9d18-3028-a08a-78e5f4d9eb16",
                        "glosses": [
                            "Plongeur ou plongeuse en apnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef251eb-0eaf-4747-ac09-f5ecd44c0cad",
                                "sense_id": "215bf6ac-3bf7-3ddf-b033-e67e3a984b59",
                                "text": "Un apnéiste, âgé d’une quarantaine d’années, venait d’être victime d’un malaise alors qu’il se trouvait dans l’eau, au large."
                            },
                            {
                                "example_id": "4f81eb58-4a4c-47ef-ab6e-40ca48b7916c",
                                "sense_id": "215bf6ac-3bf7-3ddf-b033-e67e3a984b59",
                                "text": "Fabriquées à l’unité ou en toute petite série, elles équipent plusieurs apnéistes de renommée mondiale, des équipes nationales de hockey subaquatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c0f34ed-f1c6-48e4-8400-5f729b8e2ab4",
                        "source_entry_id": "e4087300-9d18-3028-a08a-78e5f4d9eb16",
                        "source_sense_id": "215bf6ac-3bf7-3ddf-b033-e67e3a984b59",
                        "target_lang_word": "Apnoetaucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apnoetaucher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7178149-e740-320a-82b5-6c0eac49ce96",
                                        "entry_id": "4d0b3fff-9ae5-3efd-9815-4f373278870e",
                                        "glosses": [
                                            "Taucher, der für einen Tauchgang nur einen Atemzug und kein Atemgerät benötigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad21379-843d-4a6c-a3f4-ad66296d1739",
                                                "sense_id": "c7178149-e740-320a-82b5-6c0eac49ce96",
                                                "text": "Während für Sporttaucher mit Pressluftflaschen 40 Meter Tiefe die empfohlene Grenze sind, ließ sich der Apnoetaucher Herbert Nitsch aus Österreich an einem Schlitten auf 214 Meter Tiefe reißen und stieg an einem luftgefüllten Ballon wieder auf. Mit einem Atemzug."
                                            },
                                            {
                                                "example_id": "6d8d9141-1888-4f1a-8ba8-870f4613470b",
                                                "sense_id": "c7178149-e740-320a-82b5-6c0eac49ce96",
                                                "text": "Ein Apnoetaucher macht sich auf den Weg nach unten - er soll Loïc in 20 Meter Tiefe in Empfang nehmen. Er kann ihn nicht finden."
                                            },
                                            {
                                                "example_id": "f5e4640a-0692-4521-99e8-6cfe13688e12",
                                                "sense_id": "c7178149-e740-320a-82b5-6c0eac49ce96",
                                                "text": "Bei diesem Wettkampf stellte sich heraus: Ich war der weltweit jüngste Apnoetaucher. Ich war damals 13."
                                            },
                                            {
                                                "example_id": "a39e61b2-7afa-4149-90f6-0c41dd93710c",
                                                "sense_id": "c7178149-e740-320a-82b5-6c0eac49ce96",
                                                "text": "„Archäologische Funde beweisen, dass schon 4500 vor Christus Apnoetaucher in Ostasien, Indien und im Arabischen Meer nach Perlen, Perlmutt, Schwämmen und Korallen tauchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f7df2a4-e546-4148-abf6-c438236b0081",
                        "source_entry_id": "e4087300-9d18-3028-a08a-78e5f4d9eb16",
                        "source_sense_id": "215bf6ac-3bf7-3ddf-b033-e67e3a984b59",
                        "target_lang_word": "Apnoetaucherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apnoetaucherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f74a6a-8e00-3a87-931c-1a4e38bd5b7f",
                                        "entry_id": "24ea1fb4-f3d4-3fdf-8137-2759e0887a18",
                                        "glosses": [
                                            "Taucherin, die für einen Tauchgang nur einen Atemzug und kein Atemgerät benötigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615aeaeb-3a9c-4cd4-a6d1-391600510af1",
                                                "sense_id": "d7f74a6a-8e00-3a87-931c-1a4e38bd5b7f",
                                                "text": "„Apnoetaucherin Anna von Boetticher ist aufgebrochen, um im Eismeer von Grönland zur Ruhe zu kommen.“"
                                            },
                                            {
                                                "example_id": "e2094f41-1887-4d90-9b13-2b5d13cdb88a",
                                                "sense_id": "d7f74a6a-8e00-3a87-931c-1a4e38bd5b7f",
                                                "text": "„41 Meter Wassertiefe hat die in Darmstadt lebende Apnoetaucherin bisher erreicht.“"
                                            },
                                            {
                                                "example_id": "8a8a33d3-ef44-4855-b3e0-09123e4cd3fb",
                                                "sense_id": "d7f74a6a-8e00-3a87-931c-1a4e38bd5b7f",
                                                "text": "„Jennifer Wendland aus Essen ist die beste deutsche Apnoetaucherin.“"
                                            },
                                            {
                                                "example_id": "2f4c8515-ef17-4cca-81f1-853586f59b30",
                                                "sense_id": "d7f74a6a-8e00-3a87-931c-1a4e38bd5b7f",
                                                "text": "„Deutschlands beste Apnoetaucherin hat einfach keine Angst – da unten im Meer, ohne Luft.“"
                                            },
                                            {
                                                "example_id": "72f721e9-7121-48c3-ba97-d242b3b999f2",
                                                "sense_id": "d7f74a6a-8e00-3a87-931c-1a4e38bd5b7f",
                                                "text": "„In Ägypten hat die Apnoetaucherin die vergangenen drei Monate trainiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "303085cf-0089-4fe2-a34c-f3c150ad80f7",
