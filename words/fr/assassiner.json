{
    "word_family": [
        "assassin",
        "assassinat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "660b0610-31d4-31e0-a4d8-635d20d1b4f2",
                    "sense_definition": "Tuer une personne avec préméditation ou guet-apens.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "homicide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le diplomate a été lâchement <w>assassiné</w> dans sa voiture en pleine rue."
                        },
                        {
                            "text": "La police cherche à comprendre qui a pu vouloir <w>assassiner</w> cet homme d'affaires."
                        }
                    ],
                    "synonyms": [
                        "tuer"
                    ],
                    "common_phrases": [
                        "assassiner de sang-froid",
                        "faire assassiner"
                    ]
                },
                {
                    "sense_id": "8aba5199-82f2-3d8e-a2ac-78cb44cd8a80",
                    "sense_definition": "Fatiguer ou importuner excessivement quelqu'un par des discours, des plaintes ou des manières pesantes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nuisance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin m'<w>assassine</w> avec ses longues histoires sans intérêt chaque fois que je le croise."
                        },
                        {
                            "text": "Arrête de nous <w>assassiner</w> de compliments, cela devient embarrassant pour tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "assassiner de compliments"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré pour insister sur l'ennui causé"
                        }
                    ]
                },
                {
                    "sense_id": "8ce50931-7bef-39fe-96b1-6ee107c83170",
                    "sense_definition": "Porter un préjudice moral très grave à autrui, détruire une carrière ou une réputation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuisance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Répandre ces calomnies dans la presse revient à l'<w>assassiner</w> professionnellement."
                        },
                        {
                            "text": "Un article particulièrement hostile a suffi pour <w>assassiner</w> la réputation du jeune dramaturge."
                        }
                    ],
                    "common_phrases": [
                        "assassiner une réputation"
                    ]
                },
                {
                    "sense_id": "8cc87936-aadd-323f-ac32-d37721ef2686",
                    "sense_definition": "Dissiper ou faire passer le temps en attendant quelque chose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il me reste une bonne heure à <w>assassiner</w> avant l'arrivée du train."
                        },
                        {
                            "text": "Pour <w>assassiner</w> le temps dans cette salle d'attente déserte, nous avons commencé une partie de cartes."
                        }
                    ],
                    "common_phrases": [
                        "assassiner le temps"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou littéraire pour désigner le fait de tromper l'ennui"
                        }
                    ]
                }
            ]
        }
    ]
}