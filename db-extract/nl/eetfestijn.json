                        "examples": [
                            {
                                "example_id": "c11e5659-3923-419b-8c6a-ddc80b916dac",
                                "sense_id": "1447189b-1a8a-3a95-891d-ae54678333ef",
                                "text": "In Limburg komt vooral het Rijnlands carnaval voor en in Brabant het Bourgondisch carnaval. Hierbij was de insteek vooral een eetfestijn waarbij je elkaar belachelijk maakte."
                            },
                            {
                                "example_id": "b3c08321-ad8b-4d1c-90b0-6cc6ebf5fe25",
                                "sense_id": "1447189b-1a8a-3a95-891d-ae54678333ef",
                                "text": "Het 'eetfestijn' in Yulin begint morgen en duurt zo'n tien dagen. Naar schatting worden in die tijd tussen de 10.000 en 20.000 honden gedood. Vandaag is al begonnen met de verkoop van de honden en katten."
                            }
