                ],
                "senses": [
                    {
                        "sense_id": "75954b41-e7fd-38c1-a6d3-6e7e2711432b",
                        "entry_id": "e3fa07b5-d551-3909-a6a6-143c56932875",
                        "glosses": [
                            "Se conditionner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05409e4e-dc93-472b-9c2e-67b540700dec",
                                "sense_id": "75954b41-e7fd-38c1-a6d3-6e7e2711432b",
                                "text": "Enfin, il est bon de visualiser sa victoire au dépens de son adversaire pour s'autoconditionner."
                            },
                            {
                                "example_id": "747ef4f8-1e0c-4e61-a9c2-6870db19bcd4",
                                "sense_id": "75954b41-e7fd-38c1-a6d3-6e7e2711432b",
                                "text": "Cela fait des années que j'essaie de m'autoconditionner aussi, de retrouver mes motivations…"
                            },
                            {
                                "example_id": "4ea82b35-8464-43a4-becb-9ff19379afb2",
                                "sense_id": "75954b41-e7fd-38c1-a6d3-6e7e2711432b",
                                "text": "Le but de la méthode Coué n'est pas de permettre aux gens de réaliser des choses impossibles, mais de s'autoconditionner de façon positive."
                            }
                        ]
                    }
