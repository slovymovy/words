                    {
                        "sense_id": "77ccdef3-3696-3a99-a4c0-52353ffa2188",
                        "entry_id": "a31cad31-784c-3f7a-b705-8abecc60c5e3",
                        "glosses": [
                            "The act or process of making something more basic; raising the pH of something."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0a1fe890-bd4e-427e-87b3-d8cc8b4b61a2",
                                "sense_id": "77ccdef3-3696-3a99-a4c0-52353ffa2188",
                                "text": "In the process of basification, the top layer of the crust becomes basic, while the lower becomes ultrabasic acquiring the density of the mantle or an even greater density"
                            },
                            {
                                "example_id": "2d91d3cd-e8d6-4897-8555-aa79fd3ad7d3",
                                "sense_id": "77ccdef3-3696-3a99-a4c0-52353ffa2188",
                                "text": "Thereafter, the pH is increased in two stages (basification and then neutralization) to facilitate aluminum complexation and fixation."
                            },
                            {
                                "example_id": "90c49f05-30d0-460d-853f-457ed4d79a3a",
                                "sense_id": "77ccdef3-3696-3a99-a4c0-52353ffa2188",
                                "text": "Early basification applies when the tannage is basified right at the start of the process: the solution of the basifying agent is added immediately after adding the chrome in solution."
                            }
                        ]
                    }
                ],
