                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc749bd0-2952-41b0-b811-9845cb34a9c4",
                                                "sense_id": "a63470f0-689a-3380-9e0d-07631faf7580",
                                                "text": "A Navy fighter was on the tail of a Jap dive bomber that was headed for the ships in the bay, and he nailed him at about 5,000 feet and made a flamer of him."
                                            },
                                            {
                                                "example_id": "153b0c24-4b83-4995-b714-42c6f89971ab",
                                                "sense_id": "a63470f0-689a-3380-9e0d-07631faf7580",
                                                "text": "Fellows who didn't enjoy their breakfast unless they'd crept up behind some foolish Hun, put twenty rounds in his petrol tank and made a flamer of him."
                                            }
                                        ]
                                    }
