                ],
                "senses": [
                    {
                        "sense_id": "0ed3c961-bded-3225-9a4f-f04d6e4a076f",
                        "entry_id": "1f4ebc13-881a-3c37-a6c1-92d539d2aca6",
                        "glosses": [
                            "S’investir soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba6a540-19cc-43ec-b21a-789cf20f2387",
                                "sense_id": "0ed3c961-bded-3225-9a4f-f04d6e4a076f",
                                "text": "Vendredi 23 décembre, Étienne Tshisekedi n'a finalement pas réussi à s'auto-investir président de la RD-Congo."
                            },
                            {
                                "example_id": "2239a39e-8ecf-4ab6-89d3-c298cfcc9779",
                                "sense_id": "0ed3c961-bded-3225-9a4f-f04d6e4a076f",
                                "text": "Ce n'est pas bien difficile pour ces autorités de s'auto-investir de nouvelles missions en lien avec leur objet."
                            },
                            {
                                "example_id": "a024d15d-9c85-479f-9d23-e2f6b00e02f0",
                                "sense_id": "0ed3c961-bded-3225-9a4f-f04d6e4a076f",
                                "text": "Ce moment transitionnel amène à penser comment un sujet peut s’auto-investir ou s’auto-informer du mouvement pulsionnel qui l’anime tout en investissant l'objet, ou encore comment il peut être capable de s’investir lui-même à travers l’objet, ce qui revient à l’investir comme double."
                            }
                        ]
                    },
                    {
                        "sense_id": "66530da1-6ccc-3415-b6f5-c6bde16d02b8",
                        "entry_id": "1f4ebc13-881a-3c37-a6c1-92d539d2aca6",
                        "glosses": [
                            "Investir en utilisant son propre argent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
