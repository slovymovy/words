                "senses": [
                    {
                        "sense_id": "7903c7c9-0186-38fe-bc56-cb871c498ff2",
                        "entry_id": "bfe57de7-e6f0-3795-a3b6-a80a903bf5bb",
                        "glosses": [
                            "Discipline sportive de moto tout-terrain ou de quad qui se compose de parcours à réaliser dans un temps imparti (généralement sur des chemins ouverts à la circulation appelés liaisons) ou chronométré (appelés spéciales)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860f643e-eff3-4482-ab8f-d676340b03c6",
                                "sense_id": "7903c7c9-0186-38fe-bc56-cb871c498ff2",
                                "text": "Organisée par le Moto-Club Saint-Paulois, cette 11ᵉ édition de l’enduro se déroule ce samedi 17 juin sur deux boucles de 70 km à parcourir alternativement le matin et l’après-midi."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a707c52-9fba-3f0d-af8c-d4151e2430aa",
                        "entry_id": "bfe57de7-e6f0-3795-a3b6-a80a903bf5bb",
                        "glosses": [
                            "Moto destinée à la pratique de cette discipline."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6deeb6aa-e425-4c02-934c-1c14482a3624",
                                "sense_id": "8a707c52-9fba-3f0d-af8c-d4151e2430aa",
                                "text": "Une moto chinoise coûte sept fois moins cher qu’une enduro japonaise."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b0115b6-985a-3873-ac85-e08df8c00be7",
                        "entry_id": "bfe57de7-e6f0-3795-a3b6-a80a903bf5bb",
                        "glosses": [
                            "Sport qui mêle des éléments du VTT de descente et du cross-country."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb81e501-ce72-4bcb-897b-55dbc9ca7106",
                                "sense_id": "1b0115b6-985a-3873-ac85-e08df8c00be7",
                                "text": "Les enduristes de Vélo 2000 Onet étaient dimanche à l’enduro de Calmont Sport Nature, 5ᵉ manche du Challenge Enduro Tour 2023."
                            }
                        ]
                    },
                    {
                        "sense_id": "25995bfe-5f73-3ef1-9007-f3b26e966e76",
                        "entry_id": "bfe57de7-e6f0-3795-a3b6-a80a903bf5bb",
                        "glosses": [
                            "Sport qui mêle des éléments du VTT de descente et du cross-country.",
                            "Vélo adapté à la pratique de l’enduro."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6e92090e-61a3-4fce-8cd9-c7a5192638c8",
                                "sense_id": "25995bfe-5f73-3ef1-9007-f3b26e966e76",
                                "text": "Contrairement à un DH, un enduro est capable de grimper et de descendre et de s’adapter à tous les types de terrains."
                            }
                        ]
                    }
