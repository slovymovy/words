                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca819db-89a0-4493-9e24-b516bc6257ef",
                                "sense_id": "a7bd3c00-822c-3380-a5be-4278984d4d67",
                                "text": "вскочи́ть на́ ноги",
                                "translation": "to leap / spring to one's feet",
                                "english": "to leap / spring to one's feet"
                            },
                            {
                                "example_id": "36ed2497-de84-4d21-a491-cf4f548afb93",
                                "sense_id": "a7bd3c00-822c-3380-a5be-4278984d4d67",
                                "text": "вскочи́ть с посте́ли",
                                "translation": "to jump out of bed",
                                "english": "to jump out of bed"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a922a15-fdab-3332-836d-bf3bd8522633",
                        "entry_id": "c214f196-f119-3883-8f14-5cff05c8ffd2",
                        "glosses": [
                            "to rise, to swell (up), to come up (e.g. a pimple on the face, a bump on the head)"
                        ],
