                "senses": [
                    {
                        "sense_id": "2be018ab-02b4-33b2-9617-d900ac63789a",
                        "entry_id": "8bbad361-ab7b-3c89-91d8-c2898bf10c79",
                        "glosses": [
                            "einen Berg hinauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "153bd606-1b3f-437b-a880-2b598b73a7dd",
                                "sense_id": "2be018ab-02b4-33b2-9617-d900ac63789a",
                                "text": "Der Weg zur Hütte führt bergauf."
                            },
                            {
                                "example_id": "05842252-a21d-461b-b5e7-e5279b37ad2f",
                                "sense_id": "2be018ab-02b4-33b2-9617-d900ac63789a",
                                "text": "„Im Bild des seinen Felsbrocken vergeblich bergauf wälzenden Sisyphos schließlich ist die Plage des mühsamen, der Schwerkraft unterworfenen Berganstiegs als eine von den Göttern mit Bedacht über die Sterblichen verhängte Strafe gedeutet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d0f26b1-f013-40f3-8978-2abe7ca96704",
                        "source_entry_id": "8bbad361-ab7b-3c89-91d8-c2898bf10c79",
                        "source_sense_id": "2be018ab-02b4-33b2-9617-d900ac63789a",
