                                        "sense_id": "623ea018-eb06-35b6-a703-8a7dfe08297e",
                                        "entry_id": "ac815106-b99e-309f-a8b2-3141d00700a8",
                                        "glosses": [
                                            "To extend and retract (the zoom lens); to use it too enthusiastically."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494b934d-63a8-4292-a964-b3f76337cd4a",
                                                "sense_id": "623ea018-eb06-35b6-a703-8a7dfe08297e",
                                                "text": "[…] do things wrong (like rotating the lens turret while shooting or backwinding and doing multiple passes on the same strip of film or doing in-camera fades with the variable shutter or tromboning a zoom lens like a teenager on acid, etc., etc., etc.) […]"
                                            },
                                            {
                                                "example_id": "24204978-dd23-4c8f-be5f-07ab26f5d223",
                                                "sense_id": "623ea018-eb06-35b6-a703-8a7dfe08297e",
                                                "text": "He recalls (email to editor, 2 December 2012) that Durgnat 'shouted out' in response to his 'tromboning' the zoom-lens at the film's 1967 London Film Festival screening: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3f720dd-a092-43a3-afe6-a1936767f677",
                        "source_entry_id": "d718192b-d17e-3626-a235-7fdf361787eb",
                        "source_sense_id": "f5be29ff-56bd-3595-981f-74adca44612a",
                        "source_sense_description": "een koperen blaasinstrument",
