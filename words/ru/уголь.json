                                "target_lang_sense_clarification": "pieza o residuo quemado"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "braise",
                                "target_lang_sense_clarification": "morceau de bois ardent"
                            },
                            {
                                "target_lang_word": "charbon",
                                "target_lang_sense_clarification": "morceau de bois brûlé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2629814d-9b23-38cc-9241-e66a233540f7",
                    "sense_definition": "Материал для рисования в виде тонких обожжённых палочек.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Художник взял <w>уголь</w> и начал делать быстрый набросок.",
                            "target_lang_translations": {
                                "en": "The artist took a piece of <w>charcoal</w> and started making a quick sketch.",
                                "es": "El artista tomó el <w>carboncillo</w> y empezó a hacer un boceto rápido.",
                                "fr": "L'artiste a pris un <w>fusain</w> et a commencé à faire une esquisse rapide."
                            }
                        },
                        {
                            "text": "Этот портрет нарисован мягким <w>углём</w> на плотной бумаге.",
                            "target_lang_translations": {
                                "en": "This portrait is drawn with soft <w>charcoal</w> on thick paper.",
                                "es": "Este retrato está dibujado con <w>carboncillo</w> blando sobre papel grueso.",
                                "fr": "Ce portrait est dessiné au <w>fusain</w> tendre sur du papier épais."
                            }
                        }
                    ],
                    "common_phrases": [
                        "рисовать углём",
                        "портрет углём"
                    ],
                    "target_lang_definitions": {
                        "en": "Material for drawing in the form of thin burnt sticks.",
                        "es": "Material para dibujar en forma de finas barritas de madera carbonizada.",
                        "fr": "Matériau pour le dessin sous forme de petits bâtonnets de bois calciné."
                    },
                    "translations": {
                        "en": [
