                                "target_senses": [
                                    {
                                        "sense_id": "c4077e38-c363-32dd-9bae-54819a44c4eb",
                                        "entry_id": "7b6b282f-1895-30da-b74a-e30555eb3f0f",
                                        "glosses": [
                                            "A normal temperature of a room in which people live; typically 20 to 23°C (68 to 73°F); neither heated nor cooled."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513a38d8-d8b7-491d-95f8-60f5f3eecde2",
                                                "sense_id": "c4077e38-c363-32dd-9bae-54819a44c4eb",
                                                "text": "Water freezes at 0°C, which is below typical room temperature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aedaa416-c701-486f-88d4-a3a9e4a23a1a",
                        "source_entry_id": "e51dd9da-e5ae-3196-aa62-bdd55044feb0",
                        "source_sense_id": "c190c012-518f-376a-a130-6f8dd374ecfa",
                        "source_sense_description": "der Wärmegrad der Luft in einem bestimmten Wohnraum",
                        "target_lang_word": "température de la pièce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "température de la pièce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a335552-6541-3dc8-85b8-a7de8a58f64c",
                                        "entry_id": "3e56756c-6e1a-3631-942c-c8bbec0160f9",
                                        "glosses": [
                                            "Température de l’intérieur d'une pièce, qui est généralement de 20°C."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7419b2f5-b4c2-4c3f-814f-e178576ca251",
                                                "sense_id": "0a335552-6541-3dc8-85b8-a7de8a58f64c",
                                                "text": "Pangborn et Bertolero ont montré, en se servant d'eau distillée, de solutions de sels minéraux dans de l'eau distillée et d'échantillons d'eau potable, que c'est à la température de la pièce que l'eau affiche le goût le plus prononcé et que ce goût s'atténue considérablement lorsque l'eau est refroidie ou réchauffée."
                                            },
                                            {
                                                "example_id": "9c431cea-c35c-4ece-95df-d5700aa3b72c",
                                                "sense_id": "0a335552-6541-3dc8-85b8-a7de8a58f64c",
                                                "text": "J'aimerais savoir pourquoi on doit toujours utiliser des oeufs à la température de la pièce en pâtisserie. J'avoue être parfois pressée et les sortir du frigo au moment de cuisiner, et mes gâteaux sont quand même moelleux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64634fb3-7c09-4941-af98-6c6a6fe2a931",
                        "source_entry_id": "e51dd9da-e5ae-3196-aa62-bdd55044feb0",
                        "source_sense_id": "c190c012-518f-376a-a130-6f8dd374ecfa",
                        "source_sense_description": "der Wärmegrad der Luft in einem bestimmten Wohnraum",
                        "target_lang_word": "température ambiante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "température ambiante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48c64346-8227-3161-92e6-2af829708f61",
                                        "entry_id": "6d9a67af-410d-3b0e-b93b-ae1edd139a18",
                                        "glosses": [
                                            "Température de l’intérieur du laboratoire assez stable mais pas forcément contrôlée, qui est généralement de 20°C mais qui peut être située entre 15°C et 27°C."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45f1ed1e-05a2-41ea-b982-eddc765a0bbe",
                                                "sense_id": "48c64346-8227-3161-92e6-2af829708f61",
                                                "text": "Pour une température ambiante de 27°C (T = 300 K) on trouve un potentiel de 0,026 V et si l’on chauffe un métal à 927°C, le potentiel monte à 0,1 V."
                                            },
                                            {
                                                "example_id": "01b4e524-5cf8-4456-92ad-841455ea8e95",
                                                "sense_id": "48c64346-8227-3161-92e6-2af829708f61",
                                                "text": "Les piles et batteries à éprouver sont stockées pendant au moins six heures à une pression de 11,6 kPa ou moins, à la température ambiante (20 ± 5°C)."
                                            },
                                            {
                                                "example_id": "46f0b61e-51e4-4a55-94ff-a2f793e49ce8",
                                                "sense_id": "48c64346-8227-3161-92e6-2af829708f61",
                                                "text": "[…], je sus que je ne pourrais en avaler une bouchée, car j'en étais à expliquer pourquoi l’Orval est la seule trappiste à boire à température ambiante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d99c73-ffaa-3dab-92db-b39998a684f7",
                                        "entry_id": "6d9a67af-410d-3b0e-b93b-ae1edd139a18",
                                        "glosses": [
                                            "Température de l’environnement."
                                        ],
                                        "tags": [
                                            "Littéralement"
                                        ],
                                        "examples": []
                                    }
