{
    "word_family": [
        "possible",
        "possibility",
        "impossible",
        "impossibly"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                    "sense_definition": "Used to state that something might be true or might happen, but is not certain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>possibly</w> the best movie I have ever seen.",
                            "target_lang_translations": {
                                "ru": "Это, <w>возможно</w>, лучший фильм, который я когда-либо видел.",
                                "tr": "Bu <w>belki de</w> şimdiye kadar izlediğim en iyi film.",
                                "zh": "这<w>可能</w>是我看过最好的电影。"
                            }
                        },
                        {
                            "text": "<w>Possibly</w>, we will go to the beach tomorrow if the weather is nice.",
                            "target_lang_translations": {
                                "ru": "<w>Возможно</w>, завтра мы пойдем на пляж, если погода будет хорошей.",
                                "tr": "Hava güzel olursa yarın <w>muhtemelen</w> plaja gideceğiz.",
                                "zh": "<w>也许</w>明天天气好的话，我们会去海滩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "potentially",
                        "maybe",
                        "perhaps"
                    ],
                    "antonyms": [
                        "certainly",
                        "inevitably",
                        "undoubtedly",
                        "no doubt"
                    ],
                    "common_phrases": [
                        "quite possibly",
                        "very possibly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы заявить, что что-то может быть правдой или может случиться, но полной уверенности в этом нет.",
                        "tr": "Bir şeyin doğru olabileceğini veya gerçekleşebileceğini, ancak kesin olmadığını belirtmek için kullanılır.",
                        "zh": "用于表示某事可能是真的或可能发生，但不确定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "вероятность"
                            },
                            {
                                "target_lang_word": "может быть",
                                "target_lang_sense_clarification": "неуверенность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "belki",
                                "target_lang_sense_clarification": "ihtimal"
                            },
                            {
                                "target_lang_word": "muhtemelen",
                                "target_lang_sense_clarification": "olası"
                            },
                            {
                                "target_lang_word": "belki de",
                                "target_lang_sense_clarification": "ihtimal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "表示不确定性"
                            },
                            {
                                "target_lang_word": "也许",
                                "target_lang_sense_clarification": "表示推测"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                    "sense_definition": "Used with 'can' or 'could' to emphasize that something is achievable, or in negative sentences to say something cannot happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot <w>possibly</w> finish all this work by noon.",
                            "target_lang_translations": {
                                "ru": "Я <w>никак</w> не могу закончить всю эту работу к полудню.",
                                "tr": "Tüm bu işi öğleye kadar bitirmemin <w>imkanı yok</w>.",
                                "zh": "我<w>根本</w>不可能在中午前完成所有这些工作。"
                            }
                        },
                        {
                            "text": "How could he <w>possibly</w> know the answer to that question?",
                            "target_lang_translations": {
                                "ru": "Откуда он <w>вообще</w> мог знать ответ на этот вопрос?",
                                "tr": "Bu sorunun cevabını <w>nasıl olup da</w> bilebilir ki?",
                                "zh": "他<w>怎么可能</w>知道那个问题的答案？"
                            }
                        }
                    ],
                    "antonyms": [
                        "impossibly"
                    ],
                    "common_phrases": [
                        "could possibly",
                        "cannot possibly",
                        "could not possibly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется с модальными глаголами для усиления утверждения о возможности чего-либо или для подчеркивания невозможности в отрицательных предложениях.",
                        "tr": "Bir şeyin yapılabilirliğini vurgulamak için 'can' veya 'could' ile ya da imkansızlığı belirtmek için olumsuz cümlelerde kullanılır.",
                        "zh": "与“能”或“能够”连用，用于强调某事的可行性，或在否定句中强调某事绝无可能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "теоретически"
                            },
                            {
                                "target_lang_word": "никак",
                                "target_lang_sense_clarification": "усиление в отрицаниях"
                            },
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "усиление в вопросах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hiçbir şekilde",
                                "target_lang_sense_clarification": "olumsuz cümlelerde vurgu"
                            },
                            {
                                "target_lang_word": "imkanı yok",
                                "target_lang_sense_clarification": "imkansızlık vurgusu"
                            },
                            {
                                "target_lang_word": "nasıl olup da",
                                "target_lang_sense_clarification": "sorularda şaşkınlık/vurgu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怎么可能",
                                "target_lang_sense_clarification": "用于疑问句中表示惊讶或怀疑"
                            },
                            {
                                "target_lang_word": "根本",
                                "target_lang_sense_clarification": "用于否定句中加强语气"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}