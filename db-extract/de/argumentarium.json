                            {
                                "example_id": "682399e8-acb3-44c8-bc3b-9ba4d88389d2",
                                "sense_id": "cb8e3744-45dc-33a6-b008-4fc499ee0673",
                                "text": "Unser Abteilungsleiter hat mich mit der Zusammenstellung eines Argumentariums beauftragt."
                            },
                            {
                                "example_id": "f501b2c7-7de2-4a9b-ba22-2fe73701ccce",
                                "sense_id": "cb8e3744-45dc-33a6-b008-4fc499ee0673",
                                "text": "„Auf den ersten Blick mutet das Argumentarium der Befürworter einleuchtend an.“"
