                                        "entry_id": "bb48116d-cc80-35e1-b4ca-2cf34cbb9508",
                                        "glosses": [
                                            "An electrical switch capable of opening and closing an electrical circuit in all operating conditions, including fault situations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd728921-959b-496f-8e82-2b3a72a42747",
                                                "sense_id": "0c0bd106-353f-3166-8d23-3b194272e063",
                                                "text": "From the evidence of witnesses and of the recorded passing times, including the time at which the circuit breakers were tripped when the wires were brought down, the train was travelling at a speed of not less than 70 m.p.h."
                                            },
                                            {
                                                "example_id": "3bba2cd2-a6a3-411a-8a89-d6d8c7a19972",
                                                "sense_id": "0c0bd106-353f-3166-8d23-3b194272e063",
                                                "text": "Typically traction packages monitor the supply frequency and if it strays outside pre-set limits open the circuit breaker between the pantograph and the transformer to shut off the power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40aa4740-40fa-37ba-b66d-ba2e45b6bb1d",
                                        "entry_id": "bb48116d-cc80-35e1-b4ca-2cf34cbb9508",
                                        "glosses": [
                                            "More specifically, a circuit breaker that automatically breaks overcurrent conditions; a type of overcurrent protective device."
                                        ],
