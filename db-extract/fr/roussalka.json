                ],
                "senses": [
                    {
                        "sense_id": "04f7c13b-4cbc-39dd-b945-8ecf7aa5ad41",
                        "entry_id": "99cd2dba-bb1d-34fc-886a-f157f0c1050c",
                        "glosses": [
                            "Esprit féminin des eaux qui emmène à la mort les hommes dans son habitat."
                        ],
                        "tags": [
                            "Mythologie slave"
                        ],
                        "examples": [
                            {
                                "example_id": "25ac43d9-394a-4a89-835f-439299fa08a5",
                                "sense_id": "04f7c13b-4cbc-39dd-b945-8ecf7aa5ad41",
                                "text": "- Une roussalka est une nymphe des eaux. Il y en a une dans toutes ces mares pleines d'eau noire qui embellissent nos forêts. Ne vous en approchez pas ! La roussalka sort, encore plus jolie que moi, si c'est possible ; elle vous emporte au fond où, selon toute apparence, elle vous croque…"
                            },
                            {
                                "example_id": "c14726cc-510a-436e-84ee-b9dbe101a982",
                                "sense_id": "04f7c13b-4cbc-39dd-b945-8ecf7aa5ad41",
                                "text": "Les roussalki, une explication des rites de conjuration du mois de mai."
                            },
                            {
                                "example_id": "96214577-f745-4675-8e6c-6edd51463532",
                                "sense_id": "04f7c13b-4cbc-39dd-b945-8ecf7aa5ad41",
                                "text": "Les roussalkas dorment dans la journée."
                            },
                            {
                                "example_id": "74ec8fd4-9918-42b9-a626-f21ba1e8c358",
                                "sense_id": "04f7c13b-4cbc-39dd-b945-8ecf7aa5ad41",
                                "text": "Au clair de lune, les fées des eaux, les roussalkas, y rondent et s’y ébattent sur le flot argenté, dans lequel plus loin se mirent les châteaux revêches, contemporains de la vieille gloire et des vertus guerrières."
                            }
                        ]
                    }
                ],
