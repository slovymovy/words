                        "glosses": [
                            "Qui fond ou devient fluide sous l’effet de la chaleur en parlant d’une substance, d’un matériau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4dfdb2-1ebf-42ed-aea0-d0a48770e4a4",
                                "sense_id": "d566141d-9e2b-37d5-ab94-77518ff9e22d",
                                "text": "Les mastics bitumineux sont des mélanges de fines et de bitume. Leur principal intérêt est d’être thermofusibles, étanches ne comportant pas de vide, et adhérant à leur support."
                            }
                        ]
                    }
