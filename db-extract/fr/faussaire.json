        "fr-extract.jsonl": [
            {
                "entry_id": "b91020b4-fa18-3d97-a99d-bedb2c08dc08",
                "word": "faussaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "edaa8bf5-a5f2-48d6-9794-71eaeede75ee",
                        "entry_id": "b91020b4-fa18-3d97-a99d-bedb2c08dc08",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "faussaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02958982-26b6-358b-975f-9d6b2387a01e",
                        "entry_id": "b91020b4-fa18-3d97-a99d-bedb2c08dc08",
                        "glosses": [
                            "Celui, celle qui fait un faux acte, une fausse signature, un objet faux, une œuvre d’art fausse, un faux-billet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cedd191-c81d-4a20-b019-bbb3ee53ca2e",
                                "sense_id": "02958982-26b6-358b-975f-9d6b2387a01e",
                                "text": "Dupe d’un misérable dont il avait reçu en paiement une traite fausse, il risquait d’être regardé comme complice du faussaire."
                            },
                            {
                                "example_id": "8d17e222-c98e-4006-a247-220dcaf4c93f",
                                "sense_id": "02958982-26b6-358b-975f-9d6b2387a01e",
                                "text": "Puis la gravure de cette dalle, l’inscription, sont tracées par un faussaire ignorant et inhabile."
                            },
                            {
                                "example_id": "e0aa8050-f2f3-49c7-b6b7-26a7c42829c4",
                                "sense_id": "02958982-26b6-358b-975f-9d6b2387a01e",
                                "text": "Ils admirent d'autant plus les faussaires qu'ils méprisent les artistes."
                            },
                            {
                                "example_id": "8f901d00-7667-4e7e-aa68-dfe13ce78018",
                                "sense_id": "02958982-26b6-358b-975f-9d6b2387a01e",
                                "text": "L’enquête sur cette activité typiquement camorriste, et liée à un réseau transnational de faux-monnayeurs, se poursuit et pourrait mener à l’arrestation de complices du faussaire dont l’identité n’a pas été révélée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e7fff16-04b6-4af0-bc3e-e0ae2f8bcc14",
                        "source_entry_id": "b91020b4-fa18-3d97-a99d-bedb2c08dc08",
                        "source_sense_id": "02958982-26b6-358b-975f-9d6b2387a01e",
                        "source_sense_description": "Celui, celle qui fait un faux",
                        "target_lang_word": "Fälscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fälscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05af9f56-bba0-3fca-bf00-b836069ad037",
                                        "entry_id": "23c0263c-4b29-3c61-9cf0-858a23b8df9c",
                                        "glosses": [
                                            "jemand, der eine Fälschung herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43d5e13-1212-47fd-878f-964dfb8b618c",
                                                "sense_id": "05af9f56-bba0-3fca-bf00-b836069ad037",
                                                "text": "Der Fälscher konnte von der Polizei ausfindig gemacht und verhaftet werden."
                                            },
                                            {
                                                "example_id": "648c3f6a-7072-4efd-818b-b36ae8440d85",
                                                "sense_id": "05af9f56-bba0-3fca-bf00-b836069ad037",
                                                "text": "„Goldner war einer der größten Briefmarkenhändler und Fälscher seiner Zeit.“"
                                            },
                                            {
                                                "example_id": "53d33eed-c0d8-40c9-b5f7-8c729cd1527d",
                                                "sense_id": "05af9f56-bba0-3fca-bf00-b836069ad037",
                                                "text": "„Jetzt wurde Martins von findigen Nutzern als Fälscher entlarvt.“"
                                            },
                                            {
                                                "example_id": "12da57f0-5d54-4def-a6ca-d0485bb59875",
                                                "sense_id": "05af9f56-bba0-3fca-bf00-b836069ad037",
                                                "text": "„Weinhändler, Fälscher, Schmuggler, Emigranten und Schieber saßen im »Brûleur de Loup«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
