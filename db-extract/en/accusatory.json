                                            {
                                                "example_id": "5eca08c5-2376-4a53-ac03-43b5fc2cba91",
                                                "sense_id": "56776de7-dcca-3642-ab43-5a84b41b0a55",
                                                "text": "Se rendre accusateur."
                                            },
                                            {
                                                "example_id": "72e08796-0ae0-4f29-95d7-c629c33938c1",
                                                "sense_id": "56776de7-dcca-3642-ab43-5a84b41b0a55",
                                                "text": "Se porter, se constituer accusateur."
                                            },
                                            {
                                                "example_id": "5fff4891-d288-4dcf-855e-9943925e6f72",
                                                "sense_id": "56776de7-dcca-3642-ab43-5a84b41b0a55",
                                                "text": "Elle s’est rendue accusatrice."
                                            },
                                            {
                                                "example_id": "97a497f5-5bb9-4d94-ba96-8746fe082621",
                                                "sense_id": "56776de7-dcca-3642-ab43-5a84b41b0a55",
                                                "text": "Si l'acquittement était prononcé, l'accusateur pouvait encourir une peine."
                                            }
