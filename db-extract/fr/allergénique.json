                        "entry_id": "9ec2d591-c3d7-3e24-abf1-a24712c26e26",
                        "glosses": [
                            "Qui peut déclencher une réaction allergique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0463897e-f0d0-43d1-bf8f-988224ee8cdf",
                                "sense_id": "ca03b64c-9380-3caf-82d2-102c1747bc28",
                                "text": "Toutefois, d’autres études sont nécessaires pour déterminer l’intérêt que peut représenter cet extrait allergénique sur le plan thérapeutique."
                            },
                            {
                                "example_id": "dd2d02cc-e8e5-4c42-aff2-6806554d8dd5",
                                "sense_id": "ca03b64c-9380-3caf-82d2-102c1747bc28",
                                "text": "L’exposition allergénique naturelle pendant la saison des pollens entraîne une augmentation de la réactivité bronchique des sujets ayant une rhinite pollinique sans asthme […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d9cf5069-3554-3560-b562-8176f522f2b6",
                        "entry_id": "9ec2d591-c3d7-3e24-abf1-a24712c26e26",
                        "glosses": [
                            "Allergique, lié à l’allergie."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "beb3b844-b31d-4c49-b46a-f1810b40a3bb",
                                "sense_id": "d9cf5069-3554-3560-b562-8176f522f2b6",
                                "text": "Les méthodes d’évaluation du risque allergénique doivent se développer et se perfectionner pour apporter davantage de garanties […]"
                            },
                            {
                                "example_id": "1380a07a-5554-4ee4-8555-4cf59daddc97",
                                "sense_id": "d9cf5069-3554-3560-b562-8176f522f2b6",
                                "text": "Certaines fractions ont provoqué des réponses allergéniques chez des patients sensibilisés à Ambrosia elatior."
                            },
                            {
                                "example_id": "bca06630-06a9-4a95-beb0-fd93e262c080",
                                "sense_id": "d9cf5069-3554-3560-b562-8176f522f2b6",
                                "text": "Existe-t-il une relation causale entre exposition allergénique [sens 1] et apparition de la maladie allergénique [sens 2] ?"
                            }
                        ]
                    }
