                    {
                        "sense_id": "08fddb7b-fd41-3d19-ac33-193a25b7ecb4",
                        "entry_id": "27c2b95e-0897-3b2c-9582-5cbc2ebc0f95",
                        "glosses": [
                            "Relatif aux exercices pédagogiques sur un didacticiel ou sur internet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aea5dab-5eda-42f2-809d-94fb224ca851",
                                "sense_id": "08fddb7b-fd41-3d19-ac33-193a25b7ecb4",
                                "text": "[…], en plus des exercices sur papier, les élèves utilisent des logiciels exerciseurs. On se procurera sur le site Educnet la liste des logiciels reconnus d'intérêt pédagogique (RIP)."
                            },
                            {
                                "example_id": "de35b21b-0c98-43f1-a80d-1f32a88f365e",
                                "sense_id": "08fddb7b-fd41-3d19-ac33-193a25b7ecb4",
                                "text": "C'est un logiciel exerciseur qui offre toute une série d'activités, essentiellement en lecture :\n• des jeux de discrimination visuelle ou auditive;\n• des activités de dénombrement et de codage numérique ; […]."
                            }
                        ]
                    }
