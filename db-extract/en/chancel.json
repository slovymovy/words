                    {
                        "translation_id": "c8180033-c494-4e1e-ab47-ff53ccc56e72",
                        "source_entry_id": "e9331206-c094-31f4-bc95-db94555cf615",
                        "source_sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                        "source_sense_description": "space around the altar in a church",
