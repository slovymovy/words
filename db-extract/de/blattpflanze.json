                                "target_senses": [
                                    {
                                        "sense_id": "422c8182-b859-316d-b9c7-d00f7fdb1833",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Taxon d’eucaryotes (Eukaryota), qui comprend les végétaux pluricellulaires vivants, comme par exemple les Chlorophyta (algues vertes) ou les Streptophyta (streptophytes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Plante herbacée cultivée pour son feuillage, généralement abondant, et dont la floraison n’est pas souhaitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6d178a-6d85-47ef-84f6-88d382a7f7e1",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "La porte s'ouvrit sur un corridor qui sentait le linoléum, avec un portemanteau en bambou à droite, des plantes vertes, dans des cache-pot de faïence."
                                            },
                                            {
                                                "example_id": "380dacf0-50c5-4503-8691-17e8a9bfce58",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "Le puits débouchait sur un vaste hall, peuplé des universelles plantes vertes qui contribuaient à régénérer l’atmosphère."
                                            },
                                            {
                                                "example_id": "7b5fb246-1204-439f-9f5c-c98e5dcffaa5",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "Des grosses plantes vertes dans des gros pots verts, très chic. Sur le comptoir, un vase avec des fleurs. Je sais que les plantes sont vertes parce que les plantes, on sait que c’est vert. En vrai, elles sont violet-vinasse, à cause de la lumière rose. Il y a une lampe avec un abat-jour rose et des perles en bois, ça donne pas beaucoup de lumière, une lumière rose. Tout est rose, sauf les plantes vertes, tellement vertes que ça fait comme je disais un mélange dégueulasse, mais je regarde pas spécialement les plantes vertes."
                                            },
                                            {
                                                "example_id": "eaa0cae0-9d5d-4cfa-9fa6-25bace6dffef",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "Elle partait pour un mois en Belgique voir sa mère et me demandait comme un service de bien vouloir occuper son appartement en son absence, afin d'arroser les plantes vertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421878a9-0289-3a87-a9f7-21c5fc20e9fa",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Personne réduite à un état végétatif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b5885f-4572-44e9-b637-111dea65b6f0",
                                                "sense_id": "421878a9-0289-3a87-a9f7-21c5fc20e9fa",
                                                "text": "Depuis son accident, ton malheureux oncle n’est plus qu’une plante verte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9263be61-e764-326d-b44c-260e1f2cda5b",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Personne peu bavarde, inactive."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5584bbf8-7ec2-497e-a9ec-80cf791c07f0",
                                                "sense_id": "9263be61-e764-326d-b44c-260e1f2cda5b",
                                                "text": "Il n’a rien dit lors de la dernière soirée. C’est une vraie plante verte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
