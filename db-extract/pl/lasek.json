                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "Er lebt in seinem Landhaus neben einem Wäldchen."
                                            },
                                            {
                                                "example_id": "153baa88-e5eb-4246-9931-ff2d9a932c56",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Der Fußgängerweg vorm Wäldchen führte zu einem Spielplatz, der für Babys war.“"
                                            },
                                            {
                                                "example_id": "452dc002-ee5e-4224-9cc1-d9478f596ce9",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Sie führte mich nach einer Premierenfeier in das Wäldchen, das neben ihrem (unbetretbaren) Studentenheim lag.“"
                                            },
                                            {
                                                "example_id": "c6b4bcec-24e7-4862-8354-5bd711e91d85",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Martin kümmerte sich um die Zugpferde, die sie weiter hinten in einem Wäldchen angepflockt hatten.“"
                                            },
                                            {
                                                "example_id": "b1e14731-7acb-4e8d-85dd-4cbaaee5e7e0",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Vor dem Mietshaus führt ein Feldweg in Richtung eines kleinen Wäldchens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bd7e759-0900-4d93-80ad-11a1a029c3eb",
                        "source_entry_id": "de9d69c4-5fb4-3545-83d7-be51e6e3c9bf",
                        "source_sense_id": "d26fee3d-efd1-389c-a2ff-62877411ea68",
                        "target_lang_word": "лесо́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лесо́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                        "entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                                        "glosses": [
                                            "уменьш.-ласк. к лес"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cede3c2-468e-4974-8f2b-903b4e05323f",
                                                "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                                "text": "Ты знаешь тот лесок, что за нашею левадою, и, верно, знаешь за тем же лесом широкий луг: в нём двадцать без малого десятин; а травы столько, что можно каждый год продавать больше, чем на сто рублей, особенно, если, как говорят, в Гадяче будет конный полк."
                                            },
                                            {
                                                "example_id": "6057802c-68cd-481c-87fd-7e894e159a3a",
                                                "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                                "text": "Анна Васильевна, дай бог ей здоровья, леску мне на домишко изволили пожаловать, да в контору приказ отдать позабыли-с…"
                                            },
                                            {
                                                "example_id": "ce07601c-b746-412f-b524-079ac54f986a",
                                                "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                                "text": "За Облепихиным двором, в сторону Земляного вала ― лесок, а в леску хатка Облепихиной сестры, колдовки Фимки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
