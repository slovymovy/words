                ],
                "senses": [
                    {
                        "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                        "entry_id": "3be69490-baef-36b4-abe4-d83d5429ff5e",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2315f31-bddb-4b3d-a5c1-e7ff5e1d43b3",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Frau Hämäläinen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b0e793d3-da61-4cb4-87d6-0057b68c3fe6",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Herr Hämäläinen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "48388439-aa87-4abe-b694-0847863e5998",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Die Hämäläinens fahren heute ins Saaletal."
                            },
                            {
                                "example_id": "8c599eb8-49df-4ef6-807b-ba7a735a20de",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Der Hämäläinen trägt nie die Schals, die die Hämäläinen ihm strickt."
                            },
                            {
                                "example_id": "89bc6769-5057-4ceb-9638-a380498484ca",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hämäläinen kommt, geht der Herr Hämäläinen.“"
                            },
                            {
                                "example_id": "4c2f58c1-c8f1-4cff-961f-db57aa0a42b3",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Hämäläinen kommt und geht."
                            },
                            {
                                "example_id": "e2a9c1c6-c9fe-4f48-9786-be932618b447",
                                "sense_id": "bfd53cf5-358b-32e0-9f68-cec8ba0a46e1",
                                "text": "Hämäläinens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
