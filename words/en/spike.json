                                "target_lang_word": "Спайк",
                                "target_lang_sense_clarification": "имя или кличка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb889d4d-03d7-3458-b6fc-7382b63e424f",
                    "sense_definition": "An English family name derived from a nickname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The family name <w>Spikes</w> has been recorded in this region for generations.",
                            "target_lang_translations": {
                                "ru": "Фамилия <w>Спайкс</w> фиксировалась в этом регионе на протяжении поколений."
                            }
