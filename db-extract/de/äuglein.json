                ],
                "senses": [
                    {
                        "sense_id": "425b4cb8-9c36-3b24-b02e-aec9140b885b",
                        "entry_id": "2987ef73-ae79-30b6-96db-a2cdac07ce60",
                        "glosses": [
                            "kleines Auge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664d308a-2e7e-49de-81fe-bc5b7be3849c",
                                "sense_id": "425b4cb8-9c36-3b24-b02e-aec9140b885b",
                                "text": "„Seine Äuglein blitzten angriffslustig im blassen Vollmondgesicht, in dem die Hakennase wie ein Fremdkörper hervorstach.“"
                            },
                            {
                                "example_id": "3249625c-6059-41ba-b235-81973ce2f77a",
                                "sense_id": "425b4cb8-9c36-3b24-b02e-aec9140b885b",
                                "text": "„Angsterfüllt kniff das Kind die Äuglein zu und wagte eine Weile kaum zu atmen.“"
                            },
                            {
                                "example_id": "f954836a-73dd-40e6-9bca-824045ca683e",
                                "sense_id": "425b4cb8-9c36-3b24-b02e-aec9140b885b",
                                "text": "„Immer blieben seine kleinen Äuglein, klug wie die eines Elefanten, auf einen unsichtbaren Punkt in der Ferne gerichtet.“"
                            },
                            {
                                "example_id": "5b6102b1-9be2-491b-8c1b-796d41bc6664",
                                "sense_id": "425b4cb8-9c36-3b24-b02e-aec9140b885b",
                                "text": "„Nach dem stummen Gebet glitten die Äuglein des Menschenfreundes Rebhahn flink um den Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
