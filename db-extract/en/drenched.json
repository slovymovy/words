            {
                "entry_id": "d3301711-02dd-302f-94e2-a5cbc5761a60",
                "word": "drenched",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9a4eec10-beb9-41f5-b23b-3a009b1a10c9",
                        "entry_id": "d3301711-02dd-302f-94e2-a5cbc5761a60",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more drenched"
                    },
                    {
                        "form_id": "663ed856-c438-47e0-9f12-9207bec8f07d",
                        "entry_id": "d3301711-02dd-302f-94e2-a5cbc5761a60",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most drenched"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9efe94e6-3161-3e4e-908d-f39f50fc29e4",
                        "entry_id": "d3301711-02dd-302f-94e2-a5cbc5761a60",
                        "glosses": [
                            "Completely wet; sodden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea2ebd6-9f62-40ac-97c1-c0ac57a0bc21",
                                "sense_id": "9efe94e6-3161-3e4e-908d-f39f50fc29e4",
                                "text": "The storm's so bad that if you step outside for 20 seconds, you get drenched."
                            },
                            {
                                "example_id": "07d094c5-e70c-4406-993d-6f7da57a8145",
                                "sense_id": "9efe94e6-3161-3e4e-908d-f39f50fc29e4",
                                "text": "Back home the buses went up in flashes / The Irish tomb was drenched in blood"
                            },
                            {
                                "example_id": "4d2100af-2723-4ccc-8e19-c7509df781fb",
                                "sense_id": "9efe94e6-3161-3e4e-908d-f39f50fc29e4",
                                "text": "Well I'm grinding my life out, steady and sure / Nothing more wretched than what I must endure / I'm drenched in the light that shines from the sun"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1198cacf-4c32-4faa-ae8b-1dd889b8d042",
                        "source_entry_id": "d3301711-02dd-302f-94e2-a5cbc5761a60",
                        "source_sense_id": "9efe94e6-3161-3e4e-908d-f39f50fc29e4",
                        "source_sense_description": "completely wet; sodden",
                        "target_lang_word": "trempé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trempé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36036996-d614-315b-b7c4-300f7bfda338",
                                        "entry_id": "ad43801a-4b46-3ad9-a14a-7e4a312ec602",
                                        "glosses": [
                                            "Fortement mouillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e95df5bf-c2c7-4ef0-bc3b-3515e617583e",
                                                "sense_id": "36036996-d614-315b-b7c4-300f7bfda338",
                                                "text": "Décidément, un jean, un slack ou un legging trempé dont il n’est pas question de retrousser le bas, c’est très inconfortable."
                                            },
                                            {
                                                "example_id": "0175df08-9a95-4ae4-9543-a8e8852af7ab",
                                                "sense_id": "36036996-d614-315b-b7c4-300f7bfda338",
                                                "text": "La couche du bébé est trempée, il faut le changer."
                                            },
                                            {
                                                "example_id": "3fe7a622-535b-4202-8380-40be45a23912",
                                                "sense_id": "36036996-d614-315b-b7c4-300f7bfda338",
                                                "text": "Il est tout trempé de sueur se dit d’un homme qui a beaucoup transpiré, qui est couvert de sueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beadcedb-80d4-35ea-adfe-1a4fac11bdb3",
                                        "entry_id": "ad43801a-4b46-3ad9-a14a-7e4a312ec602",
                                        "glosses": [
                                            "Qui a subi la trempe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcedf521-bfb0-4043-9997-8ca19f3f8fb1",
                                                "sense_id": "beadcedb-80d4-35ea-adfe-1a4fac11bdb3",
                                                "text": "La fragilité des aciers carburés trempés, comparable à celle du verre, semble, elle aussi, une propriété caractéristique du carbure trempant du fer β plutôt que du fer β lui—même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce3e3929-63e9-3243-9a46-8f7027cfecad",
                                        "entry_id": "ad43801a-4b46-3ad9-a14a-7e4a312ec602",
                                        "glosses": [
                                            "Qui est d’une qualité vigoureuse, en parlant de l’âme humaine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d95ed04-0f85-46a3-ac64-dbea3c2b6fdd",
                                                "sense_id": "ce3e3929-63e9-3243-9a46-8f7027cfecad",
                                                "text": "Il faut avoir un caractère bien trempé pour tenir tête aux personnes malintentionnées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trempé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efbe4c2a-035c-3bb9-81c9-c065c214c5e8",
                                        "entry_id": "b8cfab82-2e87-3541-b503-ce97b8ca7510",
                                        "glosses": [
                                            "Participe passé masculin singulier de tremper."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b10586-fa32-434b-b3b2-b8d7fd063daa",
                                                "sense_id": "efbe4c2a-035c-3bb9-81c9-c065c214c5e8",
                                                "text": "Et le pain, même s’il date de plusieurs jours, et que la lame du couteau plie devant lui, une fois cassé et trempé dans le bol, il s’avale facilement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
