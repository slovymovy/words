                    {
                        "translation_id": "71543b73-f19c-4a39-b2ab-ea917e302eca",
                        "source_entry_id": "26b08a6f-beb3-3a6f-8fd6-e5bef0af2bde",
                        "source_sense_id": "90579945-2aeb-3b37-96ac-dddb1215acc3",
                        "target_lang_word": "Wiederaufrüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7e8a3d03-66a4-4b8e-9465-6db6de54f17e",
                        "source_entry_id": "26b08a6f-beb3-3a6f-8fd6-e5bef0af2bde",
                        "source_sense_id": "90579945-2aeb-3b37-96ac-dddb1215acc3",
                        "target_lang_word": "Wiederbewaffnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederbewaffnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "733692ae-7aad-3a6f-8ecb-75b2708ad244",
                                        "entry_id": "3b7720c3-2685-3ac5-a3a2-e45eecd46c96",
                                        "glosses": [
                                            "erneute Errichtung des Militärs in den 1950er Jahren in der Bundesrepublik und in der DDR"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06e92ae-89b6-4a43-9623-519abe8b1ae3",
                                                "sense_id": "733692ae-7aad-3a6f-8ecb-75b2708ad244",
                                                "text": "„So ergab sich die widersinnige Situation, dass die Westalliierten Deutschland schon zur Wiederbewaffnung drängten, als in der inzwischen ins Leben getretenen Bundesrepublik noch immer Fabriken abgebaut wurden.“"
                                            },
                                            {
                                                "example_id": "9a109b81-96e6-40dd-b6bb-a2e70fc5f1d2",
                                                "sense_id": "733692ae-7aad-3a6f-8ecb-75b2708ad244",
                                                "text": "„Und Honecker war es auch, der 1952 die Einführung des Schießunterrichts, des Fallschirmspringens und des Motorfliegens bei der FDJ verkündete; der Popularisierung der Wiederbewaffnung bei der Jugend widmete er danach seine ganze Energie.“"
                                            },
                                            {
                                                "example_id": "dfdb93d2-6085-4deb-88e0-3632019b534e",
                                                "sense_id": "733692ae-7aad-3a6f-8ecb-75b2708ad244",
                                                "text": "„Die Wiederbewaffnung war ein großes Thema, Bundesverteidigungsminister Franz Josef Strauß eine Reiz- und Hassfigur, die Angst vor einem Atomkrieg durchaus präsent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "093a69fc-8fde-404a-b2e0-e046779c0beb",
                        "source_entry_id": "26b08a6f-beb3-3a6f-8fd6-e5bef0af2bde",
                        "source_sense_id": "90579945-2aeb-3b37-96ac-dddb1215acc3",
