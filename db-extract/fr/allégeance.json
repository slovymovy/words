        "fr-extract.jsonl": [
            {
                "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                "word": "allégeance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e11a215d-a9d8-4fe1-888d-14fdef457456",
                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                        "tags": [
                            "plural"
                        ],
                        "form": "allégeances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                        "glosses": [
                            "Obligation de fidélité et d'obéissance envers une nation, une entité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebf6bf02-5b0a-4457-b2d4-603cf81d9e88",
                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                "text": "Enfin mon père est mort, j'en demande vengeance,\nPlus pour votre intérêt que pour mon allégeance."
                            },
                            {
                                "example_id": "9385fb2d-a9e5-4126-a5d6-c25e411b9208",
                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                "text": "Personne ne passe sur le chemin qui mène aux vignes et aux chênaies sans lui adresser un petit signe d’allégeance."
                            },
                            {
                                "example_id": "7ef8c12b-3496-4bd4-9c7c-e0d73a08abf4",
                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                "text": "Lʼallégeance a longtemps été lʼéconomie de la citoyenneté politique dans lʼÉtat-nation moderne."
                            },
                            {
                                "example_id": "c7497d91-2a98-45b3-9d81-6c3a05661016",
                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                "text": "Puisque l’école m’avait fait naître, je lui devais allégeance et je me conformai donc aux intentions de mes éducateurs en devenant avec docilité un être civilisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "23911a71-9c67-31cf-b2aa-75fc2d5dd292",
                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                        "glosses": [
                            "Fait d’être un homme lige d’un suzerain."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9ebfeb69-1884-32a3-9950-612e31452a5e",
                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                        "glosses": [
                            "Soulagement, adoucissement."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fe9becfb-29df-40e5-bdfd-eefce1561ab0",
                                "sense_id": "9ebfeb69-1884-32a3-9950-612e31452a5e",
                                "text": "Elle goûte, ce soir, la même allégeance qu’à ses réveils d’alors : à peine un peu de trouble parce que le non-lieu n’était pas encore officiel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "201a8900-8ba1-40e7-97fb-41848ea0e428",
                        "source_entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                        "source_sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                        "source_sense_description": "Obligation de fidélité et d’obéissance",
                        "target_lang_word": "Treueeid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treueeid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd53129c-2c89-3ab9-a48d-babd195257e2",
                                        "entry_id": "62fcc802-81ac-3a80-9daa-51c5a5556eeb",
                                        "glosses": [
                                            "Eid einer Person oder Organisation gegenüber, durch den die Treue ihr gegenüber geschworen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a294d3-7d24-497e-b827-3804613a3d75",
                                                "sense_id": "cd53129c-2c89-3ab9-a48d-babd195257e2",
                                                "text": "„Dann nahm er die Kapitulation aller pompeianischen Legionen in Messina entgegen, ließ die Soldaten einen Treueeid auf seine eigene Person schwören und fügte die Legionen jenen hinzu, die er bereits befehligte.“"
                                            },
                                            {
                                                "example_id": "c2f7ca4c-caf0-44e9-a1d9-06e250073be0",
                                                "sense_id": "cd53129c-2c89-3ab9-a48d-babd195257e2",
                                                "text": "„›Ihr werdet in aller Form ersucht, Euch in Osaka einzufinden, um Euren Treueeid zu erneuern.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
