                                        "sense_id": "59dd97a4-76e9-3d67-8684-397bc7e96049",
                                        "entry_id": "e0b08743-f505-3285-8c54-8abd59dff72e",
                                        "glosses": [
                                            "am gleichnamigen Fluss gelegene Stadt im Westen Russlands"
                                        ],
