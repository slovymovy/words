{
    "word_family": [
        "abyss",
        "abysmally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74070dd7-04db-3ae7-b8eb-b2ae7f2e90b8",
                    "sense_definition": "Extremely bad; terrible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "terrible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's performance was <w>abysmal</w>, leading to a devastating loss.",
                            "target_lang_translations": {
                                "ru": "Игра команды была <w>ужасной</w>, что привело к сокрушительному поражению."
                            }
                        },
                        {
                            "text": "I had to leave the restaurant because of the <w>abysmal</w> service.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось уйти из ресторана из-за <w>отвратительного</w> обслуживания."
                            }
                        }
                    ],
                    "antonyms": [
                        "excellent",
                        "superb",
                        "outstanding"
                    ],
                    "common_phrases": [
                        "abysmal performance",
                        "abysmal service",
                        "abysmal conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой; ужасный, отвратительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "очень плохой по качеству"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "крайне неудовлетворительный"
                            },
                            {
                                "target_lang_word": "худший",
                                "target_lang_sense_clarification": "очень низкого уровня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b4008d4-038d-31f6-87d4-84489d478af1",
                    "sense_definition": "Pertaining to, or resembling an abyss; immeasurably deep.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deep_abyss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine descended into the <w>abysmal</w> depths of the ocean where no light could reach.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка спустилась в <w>бездонные</w> глубины океана, куда не проникал свет."
                            }
                        },
                        {
                            "text": "She stared into the <w>abysmal</w> darkness of the canyon, feeling a sudden sense of vertigo.",
                            "target_lang_translations": {
                                "ru": "Она всматривалась в <w>бездонную</w> темноту каньона, чувствуя внезапное головокружение."
                            }
                        }
                    ],
                    "synonyms": [
                        "fathomless",
                        "immeasurable",
                        "profound",
                        "unending"
                    ],
                    "antonyms": [
                        "shallow"
                    ],
                    "common_phrases": [
                        "abysmal depths"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к бездне или напоминающий её; бездонный, неизмеримо глубокий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездонный",
                                "target_lang_sense_clarification": "о глубине или темноте"
                            },
                            {
                                "target_lang_word": "глубочайший",
                                "target_lang_sense_clarification": "неизмеримо глубокий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}