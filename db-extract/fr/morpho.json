                        "sense_id": "eedae7a6-b16f-3665-8c64-28a25d5c69ba",
                        "entry_id": "4f356b56-50bd-3826-8497-8ba08e6b7f1f",
                        "glosses": [
                            "Papillon d’Amérique caractérisé par la couleur bleue intense de ses ailes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "397cb444-3457-47b5-8de3-d2e8d517f994",
                                "sense_id": "eedae7a6-b16f-3665-8c64-28a25d5c69ba",
                                "text": "Certains papillons azurés et nacrés comme des morphos."
                            },
                            {
                                "example_id": "43ef3216-215f-4039-9249-6c5b6f21059d",
                                "sense_id": "eedae7a6-b16f-3665-8c64-28a25d5c69ba",
                                "text": "Bientôt nous atteindrons « la cascade », trouée de lumière où chante une rivière. Un papillon bleu, le morpho, montre le chemin."
                            },
                            {
                                "example_id": "976ee4f6-b4a4-463b-a74f-5c3fed48d6e4",
                                "sense_id": "eedae7a6-b16f-3665-8c64-28a25d5c69ba",
                                "text": "Le morpho est l’acteur le plus exubérant de ce monde microscopique. Il est reconnaissable entre mille : ses ailes arborent un bleu métallique, comme s’il les avait trempées dans un pot de peinture destiné à quelque carrosserie féérique."
                            }
                        ]
                    }
