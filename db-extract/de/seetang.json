                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                        "entry_id": "85c01957-8f26-3779-a2c6-2acf80fbf712",
                        "glosses": [
                            "im Meer wachsende, makroskopische Alge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1027121-b156-41a0-9402-a57b27d78588",
                                "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                "text": "Am Strand ist durch den Sturm viel Seetang angespült worden."
                            },
                            {
                                "example_id": "7a01fae9-c31a-44ad-a0d2-b79e67f0be5f",
                                "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                "text": "„Kapitän Crozier ließ niemanden im Stich; er hielt das Winterlager und zwang die Männer durch strengen Befehl, den eklen Seetang zu kauen, auch wenn der Magen sich umkehrte.“"
                            },
                            {
                                "example_id": "338ed522-cc0f-4b4b-b414-8ebfc6bf22f2",
                                "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                "text": "„Der Ingenieur setzte sich auf einen Stein und aß Muscheln mit Seetang, die ihm Harbert angeboten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c5c7516-d978-4e76-bfaf-e75da72605b8",
                        "source_entry_id": "85c01957-8f26-3779-a2c6-2acf80fbf712",
                        "source_sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                        "source_sense_description": "im Meer wachsende, makroskopische Alge",
                        "target_lang_word": "seaweed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaweed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                        "entry_id": "3dbf5a23-1631-3adb-b23d-addcda3c0d0c",
                                        "glosses": [
                                            "Any of numerous marine algae, such as a kelp."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "044ea1fe-2292-490a-b7cc-7d8838db85fb",
                                                "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                                "text": "We have lingered in the chambers of the sea / By sea-girls wreathed with seaweed red and brown / Till human voices wake us, and we drown."
                                            },
                                            {
                                                "example_id": "8e0a2fe6-bf3d-4f2f-a468-9fa0c806c308",
                                                "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            },
                                            {
                                                "example_id": "7aa4c786-3ebd-48f0-b7a9-0a62ff3ee65e",
                                                "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                                "text": "There has been some investigation into the potential of seaweeds as a carbon store, and although more is needed, one study says that seaweed habitats are believed to be the most productive of all coastal vegetated ecosystems, and suggested that the world’s seaweed sequesters as much carbon as all the planet’s seagrass meadows, saltmarshes and mangroves combined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "345730c1-9f87-3c99-af42-5dd0a0fd8d21",
                                        "entry_id": "3dbf5a23-1631-3adb-b23d-addcda3c0d0c",
                                        "glosses": [
                                            "Any of various fresh water plants and algae."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24cdb8c9-e5c3-4ccd-8790-82983dfe94f1",
                                                "sense_id": "345730c1-9f87-3c99-af42-5dd0a0fd8d21",
                                                "text": "With light penetrating to the lake bottom, beds of seaweed flourished where little had grown before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa0c95a7-46a9-4404-8be4-32692350b531",
                        "source_entry_id": "85c01957-8f26-3779-a2c6-2acf80fbf712",
                        "source_sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                        "source_sense_description": "im Meer wachsende, makroskopische Alge",
                        "target_lang_word": "algue marine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4126f1dc-6990-41d5-9dcd-298f6aaca99d",
                        "source_entry_id": "85c01957-8f26-3779-a2c6-2acf80fbf712",
                        "source_sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                        "source_sense_description": "im Meer wachsende, makroskopische Alge",
                        "target_lang_word": "fucus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fucus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb9a8a9-33cc-3c87-8ae5-21287619d6e4",
                                        "entry_id": "9f1a1233-3512-3a6e-84d9-0e52488ff67a",
                                        "glosses": [
                                            "Nom scientifique du varech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "381a7178-bc80-449e-807c-723d3c1f9177",
                                                "sense_id": "ddb9a8a9-33cc-3c87-8ae5-21287619d6e4",
                                                "text": "Thunherg présume que cette dernière en tire les matériaux d'espèces de fucus, notamment du fucus bursa, qui, suivant lui, est aussi gélatineux que la substance même des nids d'hirondelle."
                                            },
                                            {
                                                "example_id": "f1173add-4b15-495c-8332-295e16a58eae",
                                                "sense_id": "ddb9a8a9-33cc-3c87-8ae5-21287619d6e4",
                                                "text": "Les îles grandissent peu à peu et s'entourent d'une large ceinture de roches tapissées de mousses noirâtres ou de longs fucus bruns qui pendent à leurs flancs."
                                            },
                                            {
                                                "example_id": "e6e2bb4c-3616-462b-ac39-f2648ca26b17",
                                                "sense_id": "ddb9a8a9-33cc-3c87-8ae5-21287619d6e4",
                                                "text": "On récolte et met en produit entre sept et huit types d’algues (aonori, wakamé, fucus…) et, pour nous, l’algue, c’est réellement un aliment santé, c’est très bon pour tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
