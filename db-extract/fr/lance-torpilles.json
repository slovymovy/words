                        "glosses": [
                            "Canon de tranchée lançant des torpilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4486ba2-7795-4eb9-b33d-42f2e545819b",
                                "sense_id": "3dca37d4-7119-325e-90ff-04c971658d33",
                                "text": "Quelques vedettes ultra-rapides, à moteur silencieux, pourvues d’un dispositif de lance-torpilles, devaient, en cas de débarquement, attaquer de nuit les vaisseaux de guerre au mouillage, non loin de là, et les faire sauter sans grande peine, puisque les Alliés ne pouvaient pas connaître l’existence de cette cale de départ, adroitement camouflée."
                            }
                        ]
                    }
