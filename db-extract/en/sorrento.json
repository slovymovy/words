                        ]
                    },
                    {
                        "translation_id": "67cb9dac-01da-41a1-9adc-381fc0891e49",
                        "source_entry_id": "f2cffdae-87c5-3db2-916a-24273f0f9535",
                        "source_sense_id": "4446c8b1-b18a-30eb-9730-74cd9b11f851",
