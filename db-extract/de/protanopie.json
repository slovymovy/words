                "senses": [
                    {
                        "sense_id": "7f555e51-6d50-3461-846e-b840302f79a8",
                        "entry_id": "b5f1835d-9968-32eb-9bb7-c94b30bbad60",
                        "glosses": [
                            "Unfähigkeit, die Farbe Rot wahrzunehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da218acd-71dd-4fcb-8a76-8d36474933de",
                                "sense_id": "7f555e51-6d50-3461-846e-b840302f79a8",
                                "text": "„Oder ob die Wahrnehmung von Farben gestört ist, was man Protanopie und Protanomalie nennt.“"
                            },
                            {
                                "example_id": "e95091e5-72bc-4c53-a045-f20027d01b3f",
                                "sense_id": "7f555e51-6d50-3461-846e-b840302f79a8",
                                "text": "„Bei der Deuteranopie (Grünblindheit) fehlen die Grünzapfen, bei Protanopie (Rotblindheit) die Rotzapfen.“"
                            },
                            {
                                "example_id": "0a871816-9752-4101-9546-837b7140cb73",
                                "sense_id": "7f555e51-6d50-3461-846e-b840302f79a8",
                                "text": "„Es gibt drei Arten von Farbenblindheit: Protanopie (Rotblindheit), Deuteranopie (Grünblindheit) und Tritanopie (Blaublindheit).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
