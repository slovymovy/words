                "senses": [
                    {
                        "sense_id": "be1cfd6c-e9ad-3939-9d7d-b9f44ddfb433",
                        "entry_id": "ebead82b-6bac-3604-9545-5a1932ced2cd",
                        "glosses": [
                            "so, wie es der Brauch ist, wie es üblich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e307f169-d77d-480e-84b6-e215d3da5c48",
                                "sense_id": "be1cfd6c-e9ad-3939-9d7d-b9f44ddfb433",
                                "text": "„Wir erkundigten uns ungesäumt hergebrachterweise, was für Quartier, Tisch, Wein, Frühstück und sonstiges Bestimmbare zu bezahlen sei.“"
                            },
                            {
                                "example_id": "0c20777e-e0cb-4e70-81b0-67439d4b8753",
                                "sense_id": "be1cfd6c-e9ad-3939-9d7d-b9f44ddfb433",
                                "text": "„Die Volkswirtschaft läßt hergebrachterweise die Kultur mit dem Urjäger oder Urfischer beginnen […]“"
                            },
                            {
                                "example_id": "b4c67650-7453-455d-a4bf-4d6ce0414480",
                                "sense_id": "be1cfd6c-e9ad-3939-9d7d-b9f44ddfb433",
                                "text": "„Er schlägt ihr die Hände auf die Brüste, atmet sie tierisch an, sie aber bändigt ihn, wie hergebrachterweise Heilige die Tiere bändigen, mit ihrer Sanftmut“."
                            },
                            {
                                "example_id": "9b309352-17a5-496f-980b-4266c86f08f8",
                                "sense_id": "be1cfd6c-e9ad-3939-9d7d-b9f44ddfb433",
                                "text": "„Wenn man unter einer Verfassung das versteht, was darunter hergebrachterweise verstanden wird, dann ist die Antwort auf diese Frage ein klares Nein. Der Konvent wird keine echte Verfassung zustande bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
