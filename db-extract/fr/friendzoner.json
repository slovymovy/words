                "senses": [
                    {
                        "sense_id": "5f8cec45-3894-37eb-9f32-daf62da8f49c",
                        "entry_id": "cb871c3f-9f0a-3e1d-afd0-3889745bd946",
                        "glosses": [
                            "Placer dans sa friendzone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda5bcf7-f662-465c-b53d-af16137c80f9",
                                "sense_id": "5f8cec45-3894-37eb-9f32-daf62da8f49c",
                                "text": "Voici quelques conseils pour le « friendzoner » en douceur et éviter de lui briser le cœur."
                            },
                            {
                                "example_id": "65e5240a-7c0b-4d34-9e7f-75960b4076e1",
                                "sense_id": "5f8cec45-3894-37eb-9f32-daf62da8f49c",
                                "text": "Je me suis fait friendzoner par les 3/4 de mes rencontres."
                            },
                            {
                                "example_id": "16f9e4f8-0ce9-4a82-9e99-0dd440118beb",
                                "sense_id": "5f8cec45-3894-37eb-9f32-daf62da8f49c",
                                "text": "Friendzoner quelqu'un ce n'est pas toujours évident et surtout quand on apprécie vraiment la personne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86ad9b64-acc8-4a52-97c1-841e4085c4ae",
                        "source_entry_id": "cb871c3f-9f0a-3e1d-afd0-3889745bd946",
                        "source_sense_id": "5f8cec45-3894-37eb-9f32-daf62da8f49c",
                        "target_lang_word": "friendzone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friendzone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c8a892-78b4-31e0-86b3-0935b49d8bcd",
                                        "entry_id": "82ef2aaf-b7a8-384c-bcd3-75ac01b9c094",
                                        "glosses": [
                                            "Alternative spelling of friend zone."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996a32db-9504-4e52-9d41-f9baf3d45b7d",
                                                "sense_id": "d8c8a892-78b4-31e0-86b3-0935b49d8bcd",
                                                "text": "Overall, relationships became more strained after attempts to convert to romance, regardless of whether they gave it a shot or went straight to the friendzone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "friendzone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a97db030-199b-391f-be37-98e60bf0d807",
                                        "entry_id": "b577789b-62e8-33e7-b316-c292ba19fd25",
                                        "glosses": [
                                            "Alternative spelling of friend zone."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb90cb37-6ac2-4285-9b3a-9219e2f00bb3",
                                                "sense_id": "a97db030-199b-391f-be37-98e60bf0d807",
                                                "text": "The bloke tries to get her attention back, but I've friendzoned him. Poor guy. I do feel bad for the ones who have to try so hard."
                                            },
                                            {
                                                "example_id": "23cc55c3-b84b-45f5-a40a-c842e2ae9c24",
                                                "sense_id": "a97db030-199b-391f-be37-98e60bf0d807",
                                                "text": "While being friendzoned is not a problem, what can be a problem is if it's not clear to both people that ONLY friendship and nothing more is on offer."
                                            },
                                            {
                                                "example_id": "fa9bb944-0175-40d2-a798-97a9461fb5bc",
                                                "sense_id": "a97db030-199b-391f-be37-98e60bf0d807",
                                                "text": "Whether friendzoning outcomes would be different depending on if the initiation took place in the context of an established \"strong\" friendship or a newer, more tenuous one is a question for further research."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c41efd2-bcd3-41fd-a60c-f03893dcd76c",
                        "source_entry_id": "cb871c3f-9f0a-3e1d-afd0-3889745bd946",
                        "source_sense_id": "5f8cec45-3894-37eb-9f32-daf62da8f49c",
                        "target_lang_word": "friendzonare",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friendzonare",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "baf24821-f1c6-35bd-91b8-01ca1b318088",
                                        "entry_id": "5b3f3661-81a1-3195-a0c4-5c253bdfd133",
                                        "glosses": [
                                            "Detto di una dinamica sociale che si verifica quando, in un rapporto tra due persone, una vorrebbe mantenere un rapporto di amicizia con l'altra, la quale aspira invece ad una relazione sentimentale o sessuale."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca7ca5a-b633-434f-89d2-00f2cfb966d8",
                                                "sense_id": "baf24821-f1c6-35bd-91b8-01ca1b318088",
                                                "text": "Sperava in qualcosa di più, invece è stata friendzonata."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
