                        "sense_id": "b918ae8b-ddf7-3b5b-96ec-800221ce833d",
                        "entry_id": "20b77621-8446-3f87-9327-845b79f330fd",
                        "glosses": [
                            "einfacher Strohhut bäuerlicher Frauentrachten"
                        ],
                        "tags": [
                            "outdated",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "b3772aa3-7ed2-4b75-b9b9-201a1abb2026",
                                "sense_id": "b918ae8b-ddf7-3b5b-96ec-800221ce833d",
                                "text": "In den 1850er Jahren gehörte die Kiepe kurz zur städtischen Mode."
                            }
                        ],
                        "sense_index_json": "\"2\""
