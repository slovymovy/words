                        "cross_references": [
                            {
                                "target_word": "Schuppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                        "entry_id": "9dfb8d44-7e2b-3c06-943f-4baa91dfd68e",
                                        "glosses": [
                                            "Hütte, Lagerraum für Gerätschaften oder Vorräte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcff3c56-e6a5-4ee5-a73e-067ac4003efd",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "Der Traktor steht im Schuppen."
                                            },
                                            {
                                                "example_id": "10d34e21-b432-43dd-89ed-943363a9f924",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Die Beiboote liegen regengeschützt in Schuppen am Ufer, sodass die Männer sie schnell ins Wasser wuchten können.“"
                                            },
                                            {
                                                "example_id": "6ec2bef9-51e1-47a0-a968-f38bed207d4a",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Auf der anderen Seite der Gleise stehen Schuppen voller Fahrräder.“"
                                            },
                                            {
                                                "example_id": "59349ae5-46b2-4902-b248-e6704785b7df",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Die Frau erlaubte uns, einen Schuppen zu nutzen, und willigte ein, den Proviant zu kaufen.“"
                                            },
                                            {
                                                "example_id": "92001537-0e79-4506-bbb4-d5699286b12b",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Vor dem Haus standen Schuppen und ein riesiger Haufen Schrott, hinter dem Hexenhaus führte ein Weg zu einem größeren, schwarzen Holzhaus, das weit unten im Gelände stand und das alle nur »das kleine Haus« nannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "516e7ab8-8b00-3bd8-91a4-6df8a1ebab7d",
                                        "entry_id": "9dfb8d44-7e2b-3c06-943f-4baa91dfd68e",
                                        "glosses": [
                                            "Diskothek oder Kneipe"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b33508-a599-4812-872f-5c7eda207f4e",
                                                "sense_id": "516e7ab8-8b00-3bd8-91a4-6df8a1ebab7d",
                                                "text": "Wo ist denn der Schuppen in dem man sich vergnügen kann?"
                                            },
                                            {
                                                "example_id": "cbcb2a44-7d8e-4b40-aa0f-8dc75fed0806",
                                                "sense_id": "516e7ab8-8b00-3bd8-91a4-6df8a1ebab7d",
                                                "text": "„Das Tram 83 war einer der Schuppen mit dem größten Angebot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "17306613-a886-38c6-a22b-f9cef2926d63",
                                        "entry_id": "9dfb8d44-7e2b-3c06-943f-4baa91dfd68e",
                                        "glosses": [
                                            "Schuppenfell, Fell des Waschbären"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9073c5db-b2e2-4edf-a45a-ef926b3d0e32",
                                                "sense_id": "17306613-a886-38c6-a22b-f9cef2926d63",
                                                "text": "Sie verarbeitete dazu Schuppen und Nutria."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
