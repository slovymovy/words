                        "overblijven"
                    ],
                    "antonyms": [
                        "tekortkomen"
                    ],
                    "common_phrases": [
                        "geld overhouden",
                        "tijd overhouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to have something remaining after everything necessary has been distributed or used"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to have left",
                                "target_lang_sense_clarification": "remaining quantity"
                            },
                            {
