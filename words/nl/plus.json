            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "57563cd0-c393-3447-b2bd-73c02a6a235e",
                    "sense_definition": "gebruikt om aan te geven dat twee getallen bij elkaar worden opgeteld",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rekenkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twee <w>plus</w> twee is vier.",
                            "target_lang_translations": {
                                "en": "Two <w>plus</w> two is four."
                            }
                        },
                        {
                            "text": "In deze som moet je vijf <w>plus</w> drie uitrekenen.",
                            "target_lang_translations": {
                                "en": "In this sum, you have to calculate five <w>plus</w> three."
                            }
                        }
                    ],
                    "synonyms": [
                        "en"
                    ],
                    "antonyms": [
                        "min",
                        "minus"
                    ],
                    "common_phrases": [
                        "twee plus twee"
                    ],
                    "target_lang_definitions": {
                        "en": "used to indicate that two numbers are being added together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plus",
                                "target_lang_sense_clarification": "mathematical addition"
                            },
                            {
                                "target_lang_word": "and",
                                "target_lang_sense_clarification": "informal addition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42dc1000-fd0d-3c20-97f0-437c3eb6fbc2",
                    "sense_definition": "met toevoeging van iets anders",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toevoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijs is honderd euro <w>plus</w> de verzendkosten.",
                            "target_lang_translations": {
                                "en": "The price is one hundred euros <w>plus</w> shipping costs."
                            }
                        },
                        {
                            "text": "Je krijgt een basissalaris <w>plus</w> een maandelijkse bonus.",
                            "target_lang_translations": {
                                "en": "You receive a base salary <w>plus</w> a monthly bonus."
                            }
                        }
                    ],
                    "synonyms": [
                        "en"
                    ],
                    "antonyms": [
                        "minus"
                    ],
                    "common_phrases": [
                        "plus de kosten"
                    ],
                    "target_lang_definitions": {
                        "en": "with the addition of something else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plus",
                                "target_lang_sense_clarification": "having in addition"
                            },
                            {
                                "target_lang_word": "with",
                                "target_lang_sense_clarification": "including"
                            }
                        ]
                    }
                }
            ]
        },
        {
