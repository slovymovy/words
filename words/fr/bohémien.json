                {
                    "sense_id": "c77a4466-5722-3315-aa1a-db884c1964fc",
                    "sense_definition": "Personne, souvent un artiste ou un écrivain, qui mène une existence vagabonde ou insouciante au jour le jour, en dehors des conventions sociales.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mode_de_vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune poète refuse d'avoir un emploi stable et mène une véritable vie de <w>bohémien</w>."
                        },
                        {
                            "text": "Plusieurs peintres vivaient comme des <w>bohémiens</w> dans des ateliers froids de la capitale."
                        }
                    ],
                    "synonyms": [
                        "bohème"
                    ],
                    "antonyms": [
                        "bourgeois"
                    ],
                    "common_phrases": [
