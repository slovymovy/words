                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701a4b51-32e0-4dfa-af4e-ceed28d6c9ca",
                                "sense_id": "74812416-e8dc-3866-bc7f-793cc6b5899c",
                                "text": "Vroeger was een vliegreis alleen voor de rijken, die dan ook de jetset werden genoemd."
                            },
                            {
                                "example_id": "86cc1d8f-05d7-48a9-aa4b-b21de34c54dd",
                                "sense_id": "74812416-e8dc-3866-bc7f-793cc6b5899c",
                                "text": "Soms is een vliegreis nog goedkoper dan een treinreis."
                            },
                            {
                                "example_id": "09516a2f-d820-4fd6-8792-3601381e8f07",
                                "sense_id": "74812416-e8dc-3866-bc7f-793cc6b5899c",
                                "text": "Den Haag is de eerste stad in Nederland die zo'n verbod invoerde. Sinds 1 januari zijn er geen fossiele reclames in bushokjes of op straat meer te zien. Het gaat bijvoorbeeld om reclames voor vliegreizen en cruisevakanties. De reisbranche was het niet eens met het verbod en spande een kort geding aan, schrijft Omroep West."
                            }
                        ]
