                        "sense_id": "3bc56fcd-4422-310f-9492-15b6836429fc",
                        "entry_id": "d37ad852-429b-3a23-a507-fcf88027fc9d",
                        "glosses": [
                            "Fille ou femme qui n’est pas tsigane."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb0c15f-03f6-47e6-86c9-d1ac6a630b5f",
                                "sense_id": "3bc56fcd-4422-310f-9492-15b6836429fc",
                                "text": "La première femme de Papa était une gadji – une Slovaque. Elle provenait d'une famille extrêmement pauvre qui comptait quatre sœurs et un frère."
                            },
                            {
                                "example_id": "8cadfb7f-263c-4909-ba9c-4aa7daed7461",
                                "sense_id": "3bc56fcd-4422-310f-9492-15b6836429fc",
                                "text": "Je suis comme toi, une gadji, devant mon ordinateur."
                            },
                            {
                                "example_id": "8d885f6e-8c9b-4617-9bd0-6ae05a00edf7",
                                "sense_id": "3bc56fcd-4422-310f-9492-15b6836429fc",
                                "text": "— La gadji lui menait la vie dure. Et les petites gadjis aussi. C'est ce qui arrive quand tu te laisses mener par le bout du nez, je le lui ai dit cent fois."
                            }
                        ]
                    }
                ],
