                "senses": [
                    {
                        "sense_id": "ca0de30d-cdb6-3b2f-91b8-0e913029008d",
                        "entry_id": "f005e6ba-fc47-380d-bf04-6d50d1331a33",
                        "glosses": [
                            "Bombe, die durch ihre aerodynamische Konstruktion aus einer horizontalen Distanz zum Ziel eingesetzt werden kann"
                        ],
                        "tags": [
                            "Waffe"
                        ],
                        "examples": [
                            {
                                "example_id": "93e5fecd-4e99-49cd-9bfb-881c56ff237a",
                                "sense_id": "ca0de30d-cdb6-3b2f-91b8-0e913029008d",
                                "text": "„Auch die in Büchel stationierten Tornado-Jagdbomber sollen die neue B61-12 nutzen, allerdings nur als analoge ballistische Gleitbombe (\"System 1\").“"
                            },
                            {
                                "example_id": "b44bface-4a70-46c9-b2bb-16c4273b6d95",
                                "sense_id": "ca0de30d-cdb6-3b2f-91b8-0e913029008d",
                                "text": "„Eine deutsche FX-1400-Gleitbombe traf am 11. September 1943 den Kreuzer „USS Savannah“ im Mittelmeer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
