                        "examples": [
                            {
                                "example_id": "dcf456a3-c515-44ac-b0bf-aa4b161de080",
                                "sense_id": "6128d3ab-2afb-3999-9d18-6c0f8720f2f1",
                                "text": "Ik besluit tot het maken van een serie stillevens. Ga naar Jan Sikkes om een paar mooie stoffen uit te zoeken, geniet bovenmate van de spiedende blikken van de vrouwen, ik zie ze denken: Wat doet die kerel in onze stoffenzaak? De stoffen gebruik ik uiteindelijk niet."
                            }
                        ]
                    }
                ],
