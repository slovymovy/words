                "senses": [
                    {
                        "sense_id": "8da4c2cf-f24e-314b-ac4b-1d834c44d8d4",
                        "entry_id": "19ba5e3e-fa14-3122-9e0b-30256bb3cbeb",
                        "glosses": [
                            "Hypothetically, to undo the execution of (a person) by hanging."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d7adafff-727e-4349-be56-87b0f057f525",
                                "sense_id": "8da4c2cf-f24e-314b-ac4b-1d834c44d8d4",
                                "text": "There is a clear line of distinction in this matter. An equity judge could not unhang a man who had been wrongfully hanged; but he could set aside a precedent which was manifestly contrary to law and justice."
                            },
                            {
                                "example_id": "ba19c394-a56d-4c4e-a47c-062831690737",
                                "sense_id": "8da4c2cf-f24e-314b-ac4b-1d834c44d8d4",
                                "text": "But, having hung him, you cannot unhang him. With all your liability to err, you dare to take a step, which, if wrong at all, is infinitely so, because irretrievable."
                            }
                        ]
                    }
                ],
