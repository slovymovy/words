{
    "word_family": [
        "extraneously",
        "extraneousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06ab9beb-ec96-331e-a9c2-890f088447a8",
                    "sense_definition": "Not essential, relevant, or intrinsic to the matter at hand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please remove any <w>extraneous</w> details from your report to make it more concise.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, удалите все <w>лишние</w> детали из вашего отчета, чтобы сделать его более кратким."
                            }
                        },
                        {
                            "text": "The judge told the witness to avoid <w>extraneous</w> information that did not relate to the case.",
                            "target_lang_translations": {
                                "ru": "Судья велел свидетелю избегать <w>посторонней</w> информации, не относящейся к делу."
                            }
                        }
                    ],
                    "synonyms": [
                        "superfluous",
                        "extra",
                        "additional"
                    ],
                    "common_phrases": [
                        "extraneous-information",
                        "extraneous-details",
                        "extraneous-concerns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся существенным, уместным или внутренне присущим рассматриваемому вопросу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишний",
                                "target_lang_sense_clarification": "избыточный, ненужный в данном контексте"
                            },
                            {
                                "target_lang_word": "посторонний",
                                "target_lang_sense_clarification": "не относящийся к делу"
                            },
                            {
                                "target_lang_word": "несущественный",
                                "target_lang_sense_clarification": "не имеющий важного значения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48834c37-f0e1-354b-9140-a5c36c8f59e9",
                    "sense_definition": "Coming from the outside; not belonging to or dependent upon a thing; foreign.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist worked hard to separate the pure gold from all <w>extraneous</w> matter.",
                            "target_lang_translations": {
                                "ru": "Химик усердно работал, чтобы отделить чистое золото от всех <w>инородных</w> примесей."
                            }
                        },
                        {
                            "text": "Several <w>extraneous</w> substances were found in the water sample during the laboratory test.",
                            "target_lang_translations": {
                                "ru": "В ходе лабораторного анализа в пробе воды было обнаружено несколько <w>посторонних</w> веществ."
                            }
                        }
                    ],
                    "synonyms": [
                        "foreign",
                        "alien",
                        "intrusive"
                    ],
                    "antonyms": [
                        "intraneous"
                    ],
                    "common_phrases": [
                        "extraneous-matter",
                        "extraneous-substances",
                        "extraneous-material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий извне; не принадлежащий или не зависящий от предмета; инородный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посторонний",
                                "target_lang_sense_clarification": "внешний, не принадлежащий объекту"
                            },
                            {
                                "target_lang_word": "инородный",
                                "target_lang_sense_clarification": "чуждый по составу или происхождению"
                            },
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "приходящий извне"
                            },
                            {
                                "target_lang_word": "чуждый",
                                "target_lang_sense_clarification": "не свойственный чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}