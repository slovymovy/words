                            {
                                "target_word": "NPC",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd57e692-bf48-3726-a592-f82536a250af",
                                        "entry_id": "45586cf7-92c3-3377-94ab-bfdf6b88e6e4",
                                        "glosses": [
                                            "To act as an NPC (“non-player character”) in a game."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "859365e3-3266-46e0-9975-cea485e9fd3b",
                                                "sense_id": "fd57e692-bf48-3726-a592-f82536a250af",
                                                "text": "All characters wish to submit to the game must be either netural or good even though the group will have to interact with evil beings as well. To preserve the group from being totally dark and paranoid, I will NPC the evil characters."
                                            },
                                            {
                                                "example_id": "b9eca4d6-0bb3-4d0f-a817-32ffd4335c1a",
                                                "sense_id": "fd57e692-bf48-3726-a592-f82536a250af",
                                                "text": "[in a deleted scene, one of the signs used by the homeless Q*bert gang reads as follows]\n\"will npc in fps 4 food!\""
                                            }
                                        ]
                                    }
                                ]
                            }
