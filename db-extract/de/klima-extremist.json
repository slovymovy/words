                ],
                "senses": [
                    {
                        "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                        "entry_id": "9954b31f-8eaa-3c77-af9f-398f36208eb2",
                        "glosses": [
                            "Klimaaktivist, der auf extreme Art und Weise Maßnahmen gegen die Klimakrise erzwingen möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dcd9639-f0dd-4ac1-ba7c-68da3d179e72",
                                "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                                "text": "„Sie beschmieren Kunstwerke, blockieren Straßen und sogar Flughäfen. Die selbsternannten Klimaaktivisten sind für viele nur noch Klima-Extremisten und spalten die Gemüter.“"
                            },
                            {
                                "example_id": "3cf7ba1a-0b24-414f-ac27-cd7b8abc57ae",
                                "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                                "text": "„Dann beklagten die Klima-Extremisten, sie seien Opfer: ‚Ein ganzes Mediensystem‘ würde sich gegen sie wenden, ‚Unwahrheiten‘ verbreiten und den Unfall ‚instrumentalisieren‘.“"
                            },
                            {
                                "example_id": "5a9f5039-5bcd-4adb-923f-6a5f215a2a28",
                                "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                                "text": "„Klima-Extremisten haben am Freitag wieder den Verkehr am Straßburger Platz blockiert. Zwischen 8 und 9 Uhr mussten sich die Autofahrer auf Sperrungen gefasst machen.“"
                            },
                            {
                                "example_id": "685bb29f-b0ab-425d-aed6-4fce87c9e9cd",
                                "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                                "text": "„Friedlicher Protest und Demonstration gehören zur Demokratie und dürfen auch laut und schrill ausfallen. Den Klima-Extremisten muss jedoch das Handwerk gelegt werden.““"
                            },
                            {
                                "example_id": "6afcc9b6-d060-4cb7-b322-c93bceae4552",
                                "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                                "text": "„Der Klima-Extremist Tadzio Müller, bis 2021 Referent der Rosa-Luxemburg-Stiftung, hatte den Vorfall am Montag auf Twitter heruntergespielt: ‚Scheiße, aber: nicht einschüchtern lassen. Es ist Klimakampf, nicht Klimakuscheln, & shit happens.‘“"
                            },
                            {
                                "example_id": "d100e3d6-d5dc-43a8-a27e-5c16bcfd8a44",
                                "sense_id": "7f3268a8-6ab3-38fb-a91e-5c7fa365acb9",
                                "text": "„Die Meldung, dass zwei Anhänger der ‚Letzten Generation‘ nicht zu einem Gerichtstermin erschienen sind, weil sie nach Thailand geflogen waren, hatte diese Woche für eine Debatte über eine mögliche Doppelmoral der Klima-Extremisten gesorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
