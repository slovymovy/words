        "fr-extract.jsonl": [
            {
                "entry_id": "02ab6c50-a583-39fd-86d2-75267fa84427",
                "word": "exclamation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0cd3ef62-ee9d-421a-9ec1-53cfd6048e76",
                        "entry_id": "02ab6c50-a583-39fd-86d2-75267fa84427",
                        "tags": [
                            "plural"
                        ],
                        "form": "exclamations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72bd2e74-7d3a-337b-b4e7-12d7bb3be6c1",
                        "entry_id": "02ab6c50-a583-39fd-86d2-75267fa84427",
                        "glosses": [
                            "Cri de joie, d’admiration, de surprise, d’indignation, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7736f6b3-b303-42ef-bafc-4dd06fb9a589",
                                "sense_id": "72bd2e74-7d3a-337b-b4e7-12d7bb3be6c1",
                                "text": "Ce discours, dans sa partie pathétique, déborde, du reste, de majesté, de douleurs, d’exclamations, d’éplorations sublimes."
                            },
                            {
                                "example_id": "6cdc7c95-26b8-4731-8ed5-e984d6ac8f0d",
                                "sense_id": "72bd2e74-7d3a-337b-b4e7-12d7bb3be6c1",
                                "text": "Tout à coup Julie rougit, et jeta une exclamation dont le sens ne fut compris ni par les sentinelles, ni par le vieillard. A ce cri, un officier qui s’élançait de la cour vers l’escalier se retourna vivement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28cd6007-c42f-4f3c-b119-0065f7c4888a",
                        "source_entry_id": "02ab6c50-a583-39fd-86d2-75267fa84427",
                        "source_sense_id": "72bd2e74-7d3a-337b-b4e7-12d7bb3be6c1",
                        "target_lang_word": "Ausruf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausruf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9063e153-408c-3fc5-af97-42596fbf187d",
                                        "entry_id": "d86ef981-dbcc-30f4-acc2-bacf17dff7e1",
                                        "glosses": [
                                            "meist unwillkürliche, kurze, emotionsbetonte Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52151a71-c029-4f87-895a-f7e18deabf47",
                                                "sense_id": "9063e153-408c-3fc5-af97-42596fbf187d",
                                                "text": "Äußerungen wie \"Feuer!\", \"Aua!\", \"Sehr gut!\" sind Ausrufe."
                                            },
                                            {
                                                "example_id": "85db4770-54eb-4b82-8855-415084594737",
                                                "sense_id": "9063e153-408c-3fc5-af97-42596fbf187d",
                                                "text": "\"„Mann, ey! – der Ausruf von Hansi Flick hallte gestern Abend durch die gesamte Geister-Arena, die Unzufriedenheit des Bayern-Coaches war in dieser ersten Halbzeit des letzten Heimspiels 2020 nicht nur zu sehen, sondern auch zu hören.\""
                                            },
                                            {
                                                "example_id": "016aadea-faaa-4693-9b79-4e6505128dc0",
                                                "sense_id": "9063e153-408c-3fc5-af97-42596fbf187d",
                                                "text": "„Ausrufe wie „Potz Blut!“, „Potz Strahl!“, „Potz Hundert Gift!“ oder auch „Potz Fickerment!“ waren keine Seltenheit in seinem Munde, und dieses letzte rief regelmäßig Beifallsgetrampel hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de9c38eb-ca6d-34c2-9b9b-a2a33f662d35",
                                        "entry_id": "d86ef981-dbcc-30f4-acc2-bacf17dff7e1",
                                        "glosses": [
                                            "öffentliche Bekanntgabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef63c381-f549-449d-bd1f-2530907219c1",
                                                "sense_id": "de9c38eb-ca6d-34c2-9b9b-a2a33f662d35",
                                                "text": "Ausrufe waren früher gang und gäbe und wurden von Ausrufern durchgeführt, die mit einer Glocke durch einen Ort zogen, in gewissen Abständen läuteten und dann eine Bekanntmachung, einen Ausruf, vortrugen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe3168e3-17ef-4db4-b759-0c2e073d5352",
                        "source_entry_id": "02ab6c50-a583-39fd-86d2-75267fa84427",
                        "source_sense_id": "72bd2e74-7d3a-337b-b4e7-12d7bb3be6c1",
