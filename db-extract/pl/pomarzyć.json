                ],
                "senses": [
                    {
                        "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                        "entry_id": "0a4ee511-2bda-3c0e-921c-3c26ab73f322",
                        "glosses": [
                            "marzyć przez jakiś czas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91066063-18fc-4e1d-80c2-e61271dd91c6",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "[…], przenosiła się do ciemnego pokoju, aby w lubym mroku—pomarzyć, powzdychać"
                            },
                            {
                                "example_id": "ad4dd568-5943-44e5-8a5b-8764b1b5cf49",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Że chłopak w jego wieku pomarzy trochę i powzdycha, to w naturze rzeczy"
                            },
                            {
                                "example_id": "a70e79cd-e006-4509-a353-5894b2e08145",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Lecz czasem—dobrze pomarzyć błękitnie ¶ I tak—w objęciach cichych zapomnienia—– ¶ Jak złotoskrzydłe, wiosenne motyle, ¶ Z upojeń czary pić—choć krótką chwilę"
                            },
                            {
                                "example_id": "cb3faf11-a860-494b-b5d7-33ff890d4bd1",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Czasem ogarnia mnie potrzeba samotności… pragnę podumać, pomarzyć"
                            },
                            {
                                "example_id": "92249845-09be-4774-a659-5ae58a6ec004",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Że czasem pomarzę o niej jak o poczciwej i zacnej kobiecie, to nie dowodzi, żebym się w niej kochał"
                            },
                            {
                                "example_id": "b1fe057e-b6f2-4705-abd6-6214353bf402",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Najchętniej słucha utworów przyjemnych dla ucha, takich, stwarzających wspaniały nastrój, pozwalających wypoczywać, pomarzyć"
                            },
                            {
                                "example_id": "d8b5bec8-6fb7-4c2f-8de9-b7dcbf4107db",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Pomyślałem sobie, że nawet biznesmeni lubią czasem pomarzyć i powędrować w wyobraźni poza procenty przyrostu kapitału, papiery wartościowe, obligacje i ucisk człowieka przez człowieka, […]"
                            },
                            {
                                "example_id": "39cc6a43-6c3b-491c-9c16-8079c4b56d32",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "I choć dobra praca, mieszkanie i zdrowie to podstawa udanego życia, pomarzmy też czasem o czymś bardziej romantycznym, atrakcyjnym, niecodziennym, twórczym"
                            },
                            {
                                "example_id": "bbfb1a50-c03d-4934-bc83-025870d88dc9",
                                "sense_id": "1f6d3d4c-41b9-3c48-a5eb-e23e15195b3f",
                                "text": "Chociaż pooglądam i pomarzę, że kiedyś będzie mnie na to stać"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
