                        "glosses": [
                            "Any species of the shore fly family Ephydridae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348bf0e8-799c-47dd-a267-4c87ffc65270",
                                "sense_id": "f1c34c9a-a7e0-3c95-9462-1353304a95e0",
                                "text": "The ephydrids are especially prominent around inland salt and alkaline ponds and marshes and thermal and mineral springs."
                            },
                            {
                                "example_id": "a602900f-06b9-4f20-9dcb-4d883009aef0",
                                "sense_id": "f1c34c9a-a7e0-3c95-9462-1353304a95e0",
                                "text": "A number of studies have been conducted on the abundance and distribution of numerous ephydrids, including Parydra in various habitats or on various substrates."
                            },
                            {
                                "example_id": "fffbcff4-1e9c-4713-93d1-81c3ba7f0061",
                                "sense_id": "f1c34c9a-a7e0-3c95-9462-1353304a95e0",
                                "text": "Another interesting example is ephydrids that colonize wood that has been heavily contaminated with human urine in ancient European buildings."
                            }
                        ]
                    }
                ],
