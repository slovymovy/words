                        "sense_id": "c5989023-7125-3e5d-a2f6-5978824ec6f5",
                        "entry_id": "dba96238-b306-3eea-9f50-376840ea7dab",
                        "glosses": [
                            "The range between 90 and 99."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "5570a60d-fc38-4b1a-b4d1-3e01ef913ecc",
                                "sense_id": "c5989023-7125-3e5d-a2f6-5978824ec6f5",
                                "text": "My ideal bracket of temperature ranges from the sixties up to the nineties."
                            }
                        ]
