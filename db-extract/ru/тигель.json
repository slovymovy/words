                                    },
                                    {
                                        "sense_id": "7203876b-d298-3e02-adf8-9fe4e0308a46",
                                        "entry_id": "2e013276-9888-3725-99cb-06134b9837ec",
                                        "glosses": [
                                            "Figuradamente, situación de extrema dificultad o penuria que templa el ánimo."
                                        ],
                                        "tags": [],
