        "fr-extract.jsonl": [
            {
                "entry_id": "0895456c-5333-3d6a-aca4-68a2a9630e22",
                "word": "Méhari",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "789357b2-5240-3db1-a908-7f74ea83813a",
                        "entry_id": "0895456c-5333-3d6a-aca4-68a2a9630e22",
                        "glosses": [
                            "Nom donné par la marque automobile Citroën à un véhicule léger tout chemin, produit de 1968 à 1987."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "6564f26b-7dcc-45ca-a426-419df0cbe5fc",
                                "sense_id": "789357b2-5240-3db1-a908-7f74ea83813a",
                                "text": "À mes petits-fils, j’apprends à conduire la vieille Méhari de 35 ans dans les petits chemins derrière les dunes."
                            },
                            {
                                "example_id": "5dff6bf4-a944-4143-8862-221e1dd94e63",
                                "sense_id": "789357b2-5240-3db1-a908-7f74ea83813a",
                                "text": "Au total, quelque 140 000 Méhari ont été produites en France et à l’étranger, entre 1968 et 1987. Une carrière plus qu’honorable pour un véhicule que personne n’attendait."
                            },
                            {
                                "example_id": "2ccbae52-d6d1-4c8d-9271-e9c7408e95c2",
                                "sense_id": "789357b2-5240-3db1-a908-7f74ea83813a",
                                "text": "Lancée en pleine tourmente « soixante-huitarde », lа Méhari de Citroën a débarqué sur la pointe des roues le 16 mai 1968."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "55d440cb-054d-333e-942d-459db16d7514",
                "word": "méhari",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "025ea14d-aa67-4aef-88ec-ebfc4ba6c48b",
                        "entry_id": "55d440cb-054d-333e-942d-459db16d7514",
                        "tags": [
