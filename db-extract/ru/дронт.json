                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a270eb03-aabf-30dc-83bf-768b8111ecae",
                                        "entry_id": "d337f6f7-1b09-3ef5-9d0d-d95f95a7623a",
                                        "glosses": [
                                            "ein im 17. Jahrhundert von Seefahrern ausgerotteter, flugunfähiger Vogel, der auf Inseln östlich von Madagaskar gelebt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b1d439-f317-4064-bb0d-448e5658fbef",
                                                "sense_id": "a270eb03-aabf-30dc-83bf-768b8111ecae",
                                                "text": "Seit 1681 hat kein Mensch mehr eine Dronte gesehen."
                                            },
                                            {
                                                "example_id": "3814dae4-5557-4a37-b98a-648ec4aad3a3",
                                                "sense_id": "a270eb03-aabf-30dc-83bf-768b8111ecae",
                                                "text": "Im Frankfurter Senckenberg Museum steht die Rekonstruktion einer Dronte."
                                            },
                                            {
                                                "example_id": "dae7abbd-e053-4f0e-9ebd-8207b51244c1",
                                                "sense_id": "a270eb03-aabf-30dc-83bf-768b8111ecae",
                                                "text": "„Die großen Füße, die stummelartigen Flügel, der kurze Hals und der unglaublich dicke, gebogene schwarze Schnabel gaben der Dronte ein recht komisches Aussehen[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b19983c7-f4e9-43a2-991a-53a5d7fba806",
                        "source_entry_id": "4ebe0909-b115-35db-aba1-a74b8d8ae36a",
                        "source_sense_id": "051f85ca-f098-3890-8b2a-17422f4807af",
                        "target_lang_word": "Ekelvogel",
