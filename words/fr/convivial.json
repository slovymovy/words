    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
                    "sense_definition": "Qui favorise des relations chaleureuses, agréables et bienveillantes entre les personnes.",
