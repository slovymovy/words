                        "examples": [
                            {
                                "example_id": "72d2cad5-e08a-4104-8093-169e8a520a7d",
                                "sense_id": "8c3111a3-3996-3587-8e37-9c6b657318f3",
                                "text": "Et Philibert, le jeune, tendre, zézéyant et crapuleux Philibert, au gentil profil de petit sémite, le Joas d'Athalie, doué d'une frimousse qui faisait se pâmer les filles."
                            },
                            {
                                "example_id": "5eb9a30e-6dab-4a45-a01e-997416b93181",
                                "sense_id": "8c3111a3-3996-3587-8e37-9c6b657318f3",
                                "text": "Lorsque la conscience me revint tout à fait et que je pus enfin articuler, en zézéyant affreusement, je cherchai à savoir combien de temps il me fallait avant de pouvoir retourner aux opérations."
                            }
                        ]
