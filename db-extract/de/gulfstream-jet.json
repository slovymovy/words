                ],
                "senses": [
                    {
                        "sense_id": "3a22249c-bb38-3f4c-a219-03e6e2cb93b8",
                        "entry_id": "d6e25d9b-63f5-3092-a5db-e611281702e3",
                        "glosses": [
                            "Düsenflugzeug des Herstellers Gulfstream"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3a8ea6-d652-4a24-b492-2be1e265b150",
                                "sense_id": "3a22249c-bb38-3f4c-a219-03e6e2cb93b8",
                                "text": "„Ein paar Tage später traf Ed Hoffman in einem weißen Gulfstream-Jet, dessen einziges Kennzeichen eine Nummer hinten am Leitwerk war, in Jordanien ein.“"
                            },
                            {
                                "example_id": "8133aef8-4ee9-4660-a64b-733a3740bb5b",
                                "sense_id": "3a22249c-bb38-3f4c-a219-03e6e2cb93b8",
                                "text": "„Die Leuten wurden animiert, sich Gulfstream-Jets anzusehen und Immobilienmakler zu kontaktieren, um sich durch Villen mit Golfplätzen und Privatstränden führen zu lassen.“"
                            },
                            {
                                "example_id": "4c431b97-28dd-4e79-bd51-68c6ba7e3c47",
                                "sense_id": "3a22249c-bb38-3f4c-a219-03e6e2cb93b8",
                                "text": "„An Bord des Gulfstream-Jets fand Penny eine kleine Schachtel mit einer Geschenkschleife auf dem einzigen Sitz, der nicht mit schweren Koffern und Kleidersäcken bepackt war.“"
                            },
                            {
                                "example_id": "1cb02709-f3e0-4c9d-8514-cc171d98b02d",
                                "sense_id": "3a22249c-bb38-3f4c-a219-03e6e2cb93b8",
                                "text": "„Die Zeitschrift brachte ein Foto von ihr, wie sie am roten Oscar-Teppich ankam, zusammen mit meinem Dad in einem schicken Elektroauto, während sie in Wirklichkeit, wenn keiner hinsieht, nur mit einem gecharterten Gulfstream-Jet unterwegs sind, auch wenn sie bloß ihre Sachen von der Reinigung abholen, wobei sie die allerdings in Frankreich reinigen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
