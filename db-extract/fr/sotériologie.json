        "fr-extract.jsonl": [
            {
                "entry_id": "7458a577-d0bd-3016-8a25-f1b7f9113ede",
                "word": "sotériologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "42625d88-6316-466f-bdcf-e14045fa79d9",
                        "entry_id": "7458a577-d0bd-3016-8a25-f1b7f9113ede",
                        "tags": [
                            "plural"
                        ],
                        "form": "sotériologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fdec477-324c-32d1-a22c-d641f7fff822",
                        "entry_id": "7458a577-d0bd-3016-8a25-f1b7f9113ede",
                        "glosses": [
                            "Étude des différentes doctrines du salut de l’âme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879e9b34-adea-4053-b082-eef8888cf15d",
                                "sense_id": "5fdec477-324c-32d1-a22c-d641f7fff822",
                                "text": "Mais il est difficile de croire que l’alchimie soit sortie des expériences entreprises pour valider ce dogme, et démontrer expérimentalement l’unité de la matière. On voit mal une technique spirituelle et une sotériologie prenant leur source dans une théorie philosophique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53e61cd6-0964-43d1-b0a0-26d167b13eba",
                        "source_entry_id": "7458a577-d0bd-3016-8a25-f1b7f9113ede",
                        "source_sense_id": "5fdec477-324c-32d1-a22c-d641f7fff822",
                        "target_lang_word": "Soteriologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soteriologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2572a78e-4438-386e-b0fd-5c43d3684b4f",
                                        "entry_id": "8f77e341-a5f5-3452-9188-825f3ee71ac3",
                                        "glosses": [
                                            "Teilgebiet der theologischen Dogmatik, das sich speziell mit dem Thema der Erlösung des Menschen durch Jesus Christus auseinandersetzt"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f949b76-f159-4c00-b6eb-9761d59726e2",
                                                "sense_id": "2572a78e-4438-386e-b0fd-5c43d3684b4f",
                                                "text": "„Kein anderes Problemfeld christlicher Lehre ist so umstritten wie die Soteriologie, die begrifflich voraussetzungsreiche Lehre von der Heilsbedeutung Jesu Christi und seines Kreuzestodes. …“"
                                            },
                                            {
                                                "example_id": "ace936e1-0153-4971-b2e2-c94f4328782d",
                                                "sense_id": "2572a78e-4438-386e-b0fd-5c43d3684b4f",
                                                "text": "„Eine wissenschaftstheoretisch Reflexion auf den theologischen Ort der Soteriologie im Ganzen der Glaubenslehre und auf ihre innere (seinsvollendende) Struktur muß zunächst auf die Einheit von Soteriologie und Christologie reflektieren. …\""
                                            },
                                            {
                                                "example_id": "b5fb8d12-e088-40e5-ab4c-23294706aeaa",
                                                "sense_id": "2572a78e-4438-386e-b0fd-5c43d3684b4f",
                                                "text": "„Im Unterschied zur christlichen Füllung des Begriffs als methodischer Entfaltung und Verantwortung des in der Person Jesu Christi erschienenen Heils gibt es einen Gebrauch, der die konstitutive Bindung von Soteriologie an diese Person vernachlässigt und jedes religiöse und säkulare Reden von einem dem Menschen zu eröffnenden oder bestimmten Heil … als Soteriologie bezeichnet.“"
                                            },
                                            {
                                                "example_id": "d370b9db-4adb-494c-ac4d-7668942512e0",
                                                "sense_id": "2572a78e-4438-386e-b0fd-5c43d3684b4f",
                                                "text": "„Die innerweltlichen Soteriologien von politischen Religionen setzen auf den Primat der Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91493d91-2571-4467-83e8-a7b1084eaf99",
                        "source_entry_id": "7458a577-d0bd-3016-8a25-f1b7f9113ede",
                        "source_sense_id": "5fdec477-324c-32d1-a22c-d641f7fff822",
                        "target_lang_word": "soteriology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soteriology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4525157-0342-350f-816e-609d30e6ef3b",
                                        "entry_id": "7eee9ec1-705f-3e81-b370-5e4cd5890415",
                                        "glosses": [
                                            "The study or doctrine of salvation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204f5a11-6411-416b-bd80-ae35c5417c4a",
                                                "sense_id": "b4525157-0342-350f-816e-609d30e6ef3b",
                                                "text": "BY the Soteriology of the Bible we mean the Doctrine of the Messiah's mediatorial work for man's salvation, as gradually revealed in Holy Scripture."
                                            },
                                            {
                                                "example_id": "e96a33da-1e6f-4d6c-835e-6799ec740734",
                                                "sense_id": "b4525157-0342-350f-816e-609d30e6ef3b",
                                                "text": "All our theology, all our Christology, all our soteriology, all our doctrine of sin and salvation, of sacrifice, of atonement, of priesthood, of prayer, of worship, of world redemption, are colored through and through with Jewish concepts and bear upon them the inextinguishable evidence of their debt to those whose genius for religion justifies their title to be in a very real sense the chosen people of God."
                                            },
                                            {
                                                "example_id": "4bd3b59e-bcb9-4865-aba7-b464219ac37f",
                                                "sense_id": "b4525157-0342-350f-816e-609d30e6ef3b",
                                                "text": "1998 [Mohr Siebeck], Timo Eskola, Theodicy and Predestination in Pauline Soteriology, 2018, Wipf and Stock, page 302,\nAs we have seen during this study, most interpreters of Paul's theology have concluded that his soteriology is of a mystical nature."
                                            },
                                            {
                                                "example_id": "1fe94090-5d59-4159-b5a1-36a705481853",
                                                "sense_id": "b4525157-0342-350f-816e-609d30e6ef3b",
                                                "text": "2012, Richard Lints, 11: Soteriology, Kelly M. Kapic, Bruce L. McCormack (editors), Mapping Modern Theology, Baker Publishing Group (Baker Academic), page 264,\nTransformationist soteriologies in the nineteenth century supposed that the transformation of individuals by the gospel surely impacted their relation to God while relational soteriologies of the same period inevitably discussed the implications of Christianity upon the character of those who believed it."
                                            },
                                            {
                                                "example_id": "61774737-7c03-4af9-ae53-15ee5f908c19",
                                                "sense_id": "b4525157-0342-350f-816e-609d30e6ef3b",
                                                "text": "The issue of soteriology in the fourth gospel remains vexed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
