                ],
                "senses": [
                    {
                        "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                        "entry_id": "5b548215-ac79-3a33-9a7e-d4c8c8349dae",
                        "glosses": [
                            "Realität des Verkehrslebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2978c39-71c4-4ba3-9ee6-7928e9723a9a",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Gleichzeitig werden sie angeregt, das theoretische Wissen mit ihren Kindern in der Verkehrswirklichkeit zu erproben.“"
                            },
                            {
                                "example_id": "5843e757-7aba-4bfd-973e-03b24b750651",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Das Kind muss im Sinne der kategorialen Bildung von Klafki (psychologisch und pädagogisch) für die Verkehrswirklichkeit aufgeschlossen, und die Verkehrswirklichkeit muss ihrerseits (didaktisch und methodisch) für das Kind aufgearbeitet werden.“"
                            },
                            {
                                "example_id": "2df4229c-03c5-4d71-8630-bf9bc3506d89",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Das Üben im Schonraum sollte allmählich in die Verkehrswirklichkeit übertragen werden. Sinnvoll und effektiv ist es, eine Kombination von Übungen im Schonraum und in der Verkehrswirklichkeit durchzuführen.“"
                            },
                            {
                                "example_id": "d2d3a543-643a-46eb-be63-fbcf2eb2bb04",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Diese Simulation der Verkehrswirklichkeit kann also graduell gesteigert werden, sie bleibt aber immer auch eine simulierte Wirklichkeit mit erheblichen Abstrichen gegenüber der tatsächlichen.“"
                            },
                            {
                                "example_id": "0d703dff-33fd-4b91-84f9-ac9404b38527",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Mehrere Straßen führen hügelauf, hügelab; es gibt Kreuzungen, Sackgassen, Vorfahrtsstraßen – kurz: die ganze Verkehrswirklichkeit miniature.“"
                            },
                            {
                                "example_id": "3db3559a-070b-4f05-926b-8d371a284147",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Neben dem Theorieunterricht in der Schule, drei praktischen Übungseinheiten auf dem Verkehrsübungsplatz in Kelheim, sollten die Kinder ihr Radfahrkönnen in einer praktischen Prüfung und abschließend in der Verkehrswirklichkeit unter Beweis stellen.“"
                            },
                            {
                                "example_id": "376c88dc-bead-47df-a31c-71e65ef04ca1",
                                "sense_id": "e841692c-9954-39eb-8505-98aeef9911f1",
                                "text": "„Als Anregung für Schonraumübungen für die Jahrgangsstufen 2 und 3 können die Handreichung ‚Rad fahren in der Verkehrswirklichkeit’ (ISB) und das Praxisprogramm der Landesverkehrswacht Bayern ‚Rad fahren lernen’ herangezogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
