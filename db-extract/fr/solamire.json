                        "glosses": [
                            "Étoffe à claire-voie dont on garnit les tamis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5056c3c1-7dca-406b-9f51-13735e9fc03d",
                                "sense_id": "f2f699aa-7d43-34c7-866f-18a8521d6708",
                                "text": "Les tamis sont faits avec une cerche de chêne ou de hêtre, roulée comme un corps de boisseau. On la prend plus ou moins large, selon que le tamis doit avoir plus ou moins de profondeur, puis on ajuste la solamire."
                            },
                            {
                                "example_id": "18e3d9b8-fd3a-4c0d-8518-72fe30f4c40d",
                                "sense_id": "f2f699aa-7d43-34c7-866f-18a8521d6708",
                                "text": "Quand la solamire est prête, on prépare un cercle solidement fixé, qui doit servir à la tendre."
                            }
                        ]
                    }
