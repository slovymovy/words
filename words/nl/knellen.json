{
    "word_family": [
        "knelling",
        "knel",
        "knelkoppeling",
        "knelpunt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b730871c-1a86-3210-8fc2-f78e0a9ee744",
                    "sense_definition": "pijnlijk drukken of knijpen, vaak door te strakke kleding of schoenen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_druk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet deze nieuwe schoenen inlopen, want ze <w>knellen</w> nogal aan mijn hielen.",
                            "target_lang_translations": {
                                "en": "I need to break in these new shoes because they <w>pinch</w> my heels quite a bit."
                            }
                        },
                        {
                            "text": "Zijn te strakke broek begon behoorlijk te <w>knellen</w> na de grote maaltijd.",
                            "target_lang_translations": {
                                "en": "His overly tight trousers started to <w>squeeze</w> quite a bit after the large meal."
                            }
                        }
                    ],
                    "synonyms": [
                        "prangen"
                    ],
                    "common_phrases": [
                        "te strak knellen",
                        "aan de voeten knellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to press or squeeze painfully, often due to tight clothing or shoes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "of shoes or clothing, to be painfully tight"
                            },
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "to apply painful pressure from being too tight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f367a05-ca2e-39ec-8374-bc1759079914",
                    "sense_definition": "geestelijk of emotioneel onderdrukken, benauwen of beperken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_druk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De strenge regels binnen het bedrijf <w>knellen</w> de creativiteit van de werknemers.",
                            "target_lang_translations": {
                                "en": "The strict rules within the company <w>stifle</w> the employees' creativity."
                            }
                        },
                        {
                            "text": "Zij voelde zich erg ongelukkig omdat de sociale verwachtingen haar enorm <w>knelden</w>.",
                            "target_lang_translations": {
                                "en": "She felt very unhappy because social expectations <w>constrained</w> her enormously."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de creativiteit knellen",
                        "de vrijheid knellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to oppress, restrict, or constrain mentally or emotionally"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constrain",
                                "target_lang_sense_clarification": "to restrict or limit someone's freedom or creativity"
                            },
                            {
                                "target_lang_word": "stifle",
                                "target_lang_sense_clarification": "to suppress or suffocate creativity or freedom"
                            },
                            {
                                "target_lang_word": "restrict",
                                "target_lang_sense_clarification": "to limit or keep within narrow bounds"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ad5754f-af99-3d32-80bb-6d66616e854d",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>knel</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze moeilijke situaties zaten ze allemaal in de <w>knellen</w>.",
                            "target_lang_translations": {
                                "en": "In these difficult situations, they were all in <w>tight spots</w>."
                            }
                        },
                        {
                            "text": "De verschillende <w>knellen</w> waarin de organisatie zich bevond, vereisten snelle oplossingen.",
                            "target_lang_translations": {
                                "en": "The various <w>jams</w> the organization found itself in required quick solutions."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'knel' (pinch, tight spot, or jam)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tight spots",
                                "target_lang_sense_clarification": "difficult situations or predicaments"
                            },
                            {
                                "target_lang_word": "jams",
                                "target_lang_sense_clarification": "difficult or restrictive situations"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}