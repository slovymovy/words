                                "target_senses": [
                                    {
                                        "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                        "entry_id": "faf9988a-ba51-3a59-b858-dadbf54d7d74",
                                        "glosses": [
                                            "Exceedingly variable; readily assuming different shapes or forms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c038a092-465f-42ca-8a20-8e8e99cc7faf",
                                                "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                                "text": "An amoeba is a protean animalcule."
                                            },
                                            {
                                                "example_id": "31e3eba0-af5d-4fd8-b70d-e60d6e31dec6",
                                                "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                                "text": "Virus infection of the blood and bone marrow is probably responsible for all forms of the disease. The viral theory of origin accounts for the protean manifestations of the condition."
                                            },
                                            {
                                                "example_id": "f09402c6-e62d-4e2b-9e49-57ececd100f8",
                                                "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                                "text": "[…] the word's protean expressiveness has been observed in a xeroxlore item printed in Robert Anton Wilson's Playboy's Book of Forbidden Words […]"
                                            },
                                            {
                                                "example_id": "1cce79e4-ebbc-4e37-a7af-217ab66d7d3e",
                                                "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                                "text": "He loved to show off his protean talent."
                                            },
                                            {
                                                "example_id": "4488c93e-5000-4ae9-9201-6d09b881843e",
                                                "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                                "text": "In the intervening decades she has become a protean figure, an emblem of different things to different people, depending upon their viewpoint — a visionary, a victim, a martyr, a feminist icon, a schizophrenic, a virago, a prisoner of gender — or, perhaps, a genius, as both Plath and Hughes maintained during her lifetime."
                                            },
                                            {
                                                "example_id": "1e8a69da-7328-4e4a-b7a4-d00ba224b549",
                                                "sense_id": "5f823c6c-4794-33b3-b616-fd2db920dd2f",
                                                "text": "In recent years, Europe has struggled to find the right balance between freedom of expression and the protean security concerns it faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc5aff2b-3281-3def-a6e9-f8d1787c2906",
                                        "entry_id": "faf9988a-ba51-3a59-b858-dadbf54d7d74",
                                        "glosses": [
                                            "Alternative letter-case form of Protean (of or relating to Proteus)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
