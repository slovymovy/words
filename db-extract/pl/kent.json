                        "entry_id": "a5de3ed0-68c5-3579-b45e-351c71559d9d",
                        "glosses": [
                            "nazwa wielu hrabstw, miejscowości, gmin oraz innych toponimów w krajach anglojęzycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9074f1f8-1a83-4f55-86e8-82cebf3502f5",
                                "sense_id": "08626e78-693d-32da-81d3-6d7dace8d85b",
                                "text": "Leżące na wschodnim wybrzeżu Kentu miasto Dover jest jednym z największych portów pasażerskich Europy"
                            },
                            {
                                "example_id": "0f3d34fc-045e-4ac4-8478-34c8781cca96",
                                "sense_id": "08626e78-693d-32da-81d3-6d7dace8d85b",
                                "text": "Po ucieczce z Europy osiadł w Kent w amerykańskim stanie Iowa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "67303c58-0eb8-35d8-a608-463fb686d7f6",
                        "entry_id": "a5de3ed0-68c5-3579-b45e-351c71559d9d",
                        "glosses": [
                            "średniowieczne królestwo istniejące w południowo-wschodniej Anglii od V do IX wieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c74a1e-4296-42b5-bd07-186124c9b317",
                                "sense_id": "67303c58-0eb8-35d8-a608-463fb686d7f6",
                                "text": "Wybrzeże Kentu, znane jako „Saski brzeg”, strzeżone było przez serię fortec"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
