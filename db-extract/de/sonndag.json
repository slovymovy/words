                ],
                "senses": [
                    {
                        "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                        "entry_id": "1d53da85-7df4-3398-bbca-d60c271d076c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666859a5-020b-4694-8714-f67883540fa4",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Frau Sonndag ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9edc96d0-e06e-425e-bef3-c0012208e299",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Herr Sonndag wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4d7b0055-c5e7-467d-9566-742dbcd42627",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Die Sonndags fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "70ed2367-299b-44ae-93d6-56edf74e2d28",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Der Sonndag trägt nie die Schals, die die Sonndag ihm strickt."
                            },
                            {
                                "example_id": "bee5a524-7ec3-4c8c-a108-319f6dad5520",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sonndag kommt, geht der Herr Sonndag.“"
                            },
                            {
                                "example_id": "f35301a2-83e8-48fa-b9cb-82c7c6adccb9",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Sonndag kommt und geht."
                            },
                            {
                                "example_id": "fd7884da-922c-47ae-ba7d-55492affdbe9",
                                "sense_id": "ce63e6e2-4cbc-37a2-814b-7b0571bd07f2",
                                "text": "Sonndags kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
