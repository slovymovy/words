                "senses": [
                    {
                        "sense_id": "701c987a-a678-3ff2-b209-688f699f9611",
                        "entry_id": "fe3bb281-47c6-31b0-96f4-0effc201cbaf",
                        "glosses": [
                            "Enlever le blé qui est poussé sur une parcelle, le moissonner."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a2138517-5fc7-46d4-bcb1-2224cfcb8a9d",
                                "sense_id": "701c987a-a678-3ff2-b209-688f699f9611",
                                "text": "Il y a plusieurs coutumes qui portent qu’il est permis à un bourgeois de bléer ou de débléer ses terres toutes les fois qu’il veut."
                            },
                            {
                                "example_id": "27505300-c873-4690-a9b0-26f838d0507c",
                                "sense_id": "701c987a-a678-3ff2-b209-688f699f9611",
                                "text": "Vous aurez bléé votre champ, on vous aura volontiers laissé faire ; mais quand vous voudrez le débléer, quand la saison vous presse, il faut appeler le seigneur, il faut, quand ses agents sont convenus de leur part, aller la leur porter, appeler le décimateur, lui faire voir, aller lui porter sa part."
                            }
                        ]
                    }
                ],
