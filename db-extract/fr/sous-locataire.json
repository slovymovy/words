                    {
                        "sense_id": "a7a655ef-027d-3d60-a860-23221a90d268",
                        "entry_id": "8c99221f-87b7-3498-842a-a1f0fa3ad272",
                        "glosses": [
                            "Celui, celle qui loue une maison ou partie de maison, un appartement, une pièce, non pas au propriétaire de l’immeuble, mais à une tierce personne qui l’avait elle-même précédemment loué."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c719e1bf-07f5-4f02-bfc8-f0a753c64829",
                        "source_entry_id": "8c99221f-87b7-3498-842a-a1f0fa3ad272",
                        "source_sense_id": "a7a655ef-027d-3d60-a860-23221a90d268",
                        "target_lang_word": "Untermieter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untermieter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                        "entry_id": "c046ccc6-5c5a-30d9-8ef1-7a99ccdb47e4",
                                        "glosses": [
                                            "Person, die sich in Räumlichkeiten eines Mieters einmietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b8789b-aa87-421b-9190-2c0a811789de",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Was die Söhne betraf, so war es Roman und Cesar von allem Anfang an unmöglich, den Untermieter der Großmutter jemals wirklich ernst zu nehmen.“"
                                            },
                                            {
                                                "example_id": "834c3c07-ebd1-418f-a1ff-9d0ff5ea5680",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Oma und Opa hatten jetzt einen Untermieter, Herrn Wübben.“"
                                            },
                                            {
                                                "example_id": "2437cd93-5b40-4907-af70-f905d9944b63",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Rilke ist wieder Rodins Untermieter, er bewohnt zwei hohe Zimmer im Rundbau in der linken Ecke mit Zugang zur Terrasse.“"
                                            },
                                            {
                                                "example_id": "73a9d787-1a48-4737-be13-389c31db61f4",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Beim Aufstehen störte der fremde Untermieter.“"
                                            },
                                            {
                                                "example_id": "57eafc80-b666-4d06-9c34-ad99b0e8876b",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Einer der abscheulichsten Untermieter war der unausgegorene Studiosus Johann Wolfgang Goethe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ea1f3b1-a3f9-41ed-9e9c-ad36a0eb0f31",
                        "source_entry_id": "8c99221f-87b7-3498-842a-a1f0fa3ad272",
                        "source_sense_id": "a7a655ef-027d-3d60-a860-23221a90d268",
                        "target_lang_word": "Untermieterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untermieterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a44b29e1-c0f1-3db0-b72e-6fda72872c30",
                                        "entry_id": "6c8ab226-b839-3133-915a-5b1001d64025",
                                        "glosses": [
                                            "weibliche Person, die sich in Räumlichkeiten eines Mieters/einer Mieterin einmietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb0df91-1aa2-4b0d-a5d5-cde72dff2da8",
                                                "sense_id": "a44b29e1-c0f1-3db0-b72e-6fda72872c30",
                                                "text": "„Nie fand sich ein Untermieter oder eine Untermieterin für das freie Zimmer.“"
                                            }
