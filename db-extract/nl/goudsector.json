                        "glosses": [
                            "branche die zich bezighoudt met de winning, verwerking en verkoop van goud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837ed8af-fd9a-4510-9cca-42f27da76cbf",
                                "sense_id": "b8b524da-81a6-3c6c-82e2-b59caabd1487",
                                "text": "Voorzitter Dompig van het team Ordening Goudsector zei tegen Surinaamse media dat er 1500 tot 2000 illegale goudzoekers in het gebied actief zijn. De afgelopen jaren is dat aantal toegenomen, vanwege de hogere goudprijs."
                            },
                            {
                                "example_id": "a5e198f7-b24f-447f-90d3-c7ba8e4c7656",
                                "sense_id": "b8b524da-81a6-3c6c-82e2-b59caabd1487",
                                "text": "In eerste instantie doen tien juweliers mee met de verkoop van dit duurzame goud. Directeur Nico Roozen van Solidaridad verwacht echter dat binnen drie tot vijf jaar duurzaamheid in de goudsector hoog op de agenda staat."
                            }
                        ]
                    }
