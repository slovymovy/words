                    {
                        "sense_id": "63aa859d-2a18-3679-aabe-47d0227c2d5d",
                        "entry_id": "cb85b050-5a98-3e45-acc4-02119371fd13",
                        "glosses": [
                            "A Thessalian princess and huntress demigod, companion of Artemis and lover of Apollo."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
