                "senses": [
                    {
                        "sense_id": "4c798474-9f68-3e5f-9c70-b452d0e143fa",
                        "entry_id": "5cc5dec2-eb70-37e7-af2c-3739a8b09fad",
                        "glosses": [
                            "Räumlichkeit, die der Abwicklung von Postgeschäften diente, zum Beispiel dem Absenden oder Empfangen von Briefen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7d109e2b-c7a2-4955-a16e-654bbfc39cdf",
                                "sense_id": "4c798474-9f68-3e5f-9c70-b452d0e143fa",
                                "text": "Minna Hansen leitete in ihrem eigenen Haus die erste Poststelle des Dorfes."
                            },
                            {
                                "example_id": "6daa1c57-e737-4b34-aa72-5795e5055773",
                                "sense_id": "4c798474-9f68-3e5f-9c70-b452d0e143fa",
                                "text": "„Auf der Poststelle kaufte sie einen Briefumschlag und bat um die Adresse des Bischofs in Aachen.“"
                            },
                            {
                                "example_id": "9734ac1f-0c35-4a23-9e46-3cf43ac03ae6",
                                "sense_id": "4c798474-9f68-3e5f-9c70-b452d0e143fa",
                                "text": "„Die Postsendungen wurden von der Reichspost zu einer auf dem Flugplatz eingerichteten Poststelle gebracht.“"
                            },
                            {
                                "example_id": "15844d35-10b2-4198-9732-de1a18f93922",
                                "sense_id": "4c798474-9f68-3e5f-9c70-b452d0e143fa",
                                "text": "„Beim Bau der Bahnlinie wurde darauf geachtet, dass alle deutschen Poststellen, besonders die außerhalb der 50-km-Zone, in den Bahnhofsgebäuden, wenigstens aber in ihrer Nähe untergebracht wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "477d5af3-d101-3f0c-acc8-29379245ad6f",
                        "entry_id": "5cc5dec2-eb70-37e7-af2c-3739a8b09fad",
                        "glosses": [
                            "Stelle in einem Unternehmen, die der Erledigung der Post dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e85b087-5682-4497-b408-4962853159b3",
                                "sense_id": "477d5af3-d101-3f0c-acc8-29379245ad6f",
                                "text": "Gehen Sie bitte zur Poststelle und holen das Päckchen ab, das dauert sonst so lange, wenn wir erst auf die Hauspost warten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
