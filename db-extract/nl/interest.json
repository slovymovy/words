                "translations": [
                    {
                        "translation_id": "0b25a553-03d1-4233-821d-751b64753c50",
                        "source_entry_id": "5b80a09b-9a22-3222-990a-a514eae9d961",
                        "source_sense_id": "47e60cd3-7a53-30ab-acc0-9f0ff600e10f",
                        "target_lang_word": "Zins",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zins",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df31342c-325c-33d3-997a-d579ce92e6da",
                                        "entry_id": "b6a59a68-5ade-3e6c-8aee-0eb67b0f809d",
                                        "glosses": [
                                            "Entgelt für die Überlassung von Kapital"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16d1e90-77cb-4f86-9492-a29bd9d5d0d5",
                                                "sense_id": "df31342c-325c-33d3-997a-d579ce92e6da",
                                                "text": "Zinsen werden einer Spareinlage meist am 30.12. eines Jahres gutgeschrieben."
                                            },
                                            {
                                                "example_id": "48991ac8-4360-4270-a5b5-4c2455a3487e",
                                                "sense_id": "df31342c-325c-33d3-997a-d579ce92e6da",
                                                "text": "„Wegen der günstigen Zinsen für Baukredite ist die Nachfrage nach Immobilien weiter hoch, vor allem in den Großstädten.“"
                                            },
                                            {
                                                "example_id": "4bed1462-9f10-45aa-afe3-717708a66d27",
                                                "sense_id": "df31342c-325c-33d3-997a-d579ce92e6da",
                                                "text": "„Legt man sein Geld oder sein Kapital gut an, dann bekommt man Zinsen.“"
                                            },
                                            {
                                                "example_id": "ef3c0554-b372-46cd-8609-00a874fcfc0e",
                                                "sense_id": "df31342c-325c-33d3-997a-d579ce92e6da",
                                                "text": "„Steuern und Zinsen bedeuten im Zeitalter der Inflation überhaupt nichts; man zahlt sie nach einem Jahr, das heißt, so gut wie überhaupt nicht.“"
                                            },
                                            {
                                                "example_id": "8c660d34-909d-4c83-a099-0432d6e3d3f6",
                                                "sense_id": "df31342c-325c-33d3-997a-d579ce92e6da",
                                                "text": "„Seine Gläubiger waren so anständig gewesen, ihn im Besitz eines kleinen Restes seines väterlichen Vermögens zu lassen, dessen Zinsen bei äußerster Sparsamkeit zu einem sehr bescheidenen Leben hinreichten, ihm jedoch auch nicht den kleinsten Luxus gestatteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d2e65e1-33b3-3815-b22c-d642006f993b",
                                        "entry_id": "b6a59a68-5ade-3e6c-8aee-0eb67b0f809d",
                                        "glosses": [
                                            "Entgelt für die Überlassung von Wohnraum"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "936d7939-42be-4b9e-8baa-67fc270e4b6a",
                                                "sense_id": "2d2e65e1-33b3-3815-b22c-d642006f993b",
                                                "text": "„An ihre Stelle traten drei Monate später Verkaufshütten, für welche der Magistrat Zins einhob.“"
                                            },
                                            {
                                                "example_id": "c9e25ab7-61d7-4d70-a39a-cb806f826251",
                                                "sense_id": "2d2e65e1-33b3-3815-b22c-d642006f993b",
                                                "text": "„Vielmehr ist der Zins für eine zu mietende Wohnung bei Bemessung des Unterhaltsbetrages in Anschlag zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a1153d1-7c15-3ef4-a82f-21ce6d40fb46",
                                        "entry_id": "b6a59a68-5ade-3e6c-8aee-0eb67b0f809d",
                                        "glosses": [
                                            "Abgabe an den Grundherrn"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20e508c3-2aba-470e-adc8-86734f39f9df",
                                                "sense_id": "8a1153d1-7c15-3ef4-a82f-21ce6d40fb46",
                                                "text": "„Das Lokal verließen sie erst, als die Zecher das Lied von dem ‚lustigen Zigeunern‘ anstimmten, die dem Kaiser keinen Zins zu zahlen brauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19c78e3c-9437-4e7d-a72c-148f5df846f7",
                        "source_entry_id": "5b80a09b-9a22-3222-990a-a514eae9d961",
                        "source_sense_id": "47e60cd3-7a53-30ab-acc0-9f0ff600e10f",
                        "target_lang_word": "interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38fc746e-fecd-341e-9e56-f10ea14ee48a",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "The price paid for obtaining, or price received for providing, money or goods in a credit transaction, calculated as a fraction of the amount or value of what was borrowed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0649184-2933-44c8-812b-bf9d0fcaead7",
                                                "sense_id": "38fc746e-fecd-341e-9e56-f10ea14ee48a",
                                                "text": "Our bank offers borrowers an annual interest of 5%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e04711df-b664-3e50-b833-66bf6b7b0748",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "Any excess over and above an exact equivalent"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6bcb25f-d045-44ab-b145-2b28c3c273ef",
                                                "sense_id": "e04711df-b664-3e50-b833-66bf6b7b0748",
                                                "text": "You shall have your desires with interest"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60098110-e7be-36ac-8342-a93ea67480f6",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "A great attention and concern from someone or something; intellectual curiosity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33eaf72-de1b-40e7-96a7-e7bcbcfe3638",
                                                "sense_id": "60098110-e7be-36ac-8342-a93ea67480f6",
                                                "text": "He has a lot of interest in vintage cars."
                                            },
                                            {
                                                "example_id": "21e7d754-5e29-4ff3-803c-d79839035116",
                                                "sense_id": "60098110-e7be-36ac-8342-a93ea67480f6",
                                                "text": "I have a lot of interest in doing online coding."
                                            },
                                            {
                                                "example_id": "722ce45a-b76f-4b4a-816d-f1d132022b61",
                                                "sense_id": "60098110-e7be-36ac-8342-a93ea67480f6",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            },
                                            {
                                                "example_id": "1504d2a1-026d-4113-b352-bee604f88735",
                                                "sense_id": "60098110-e7be-36ac-8342-a93ea67480f6",
                                                "text": "Thinks I to myself, “Sol, you're run off your course again. This is a rich man's summer ‘cottage’ and if you don't look out there's likely to be some nice, lively dog taking an interest in your underpinning.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "964c5eb3-f26e-3bf8-ba30-40d497b813c5",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "Attention that is given to or received from someone or something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0b47ed-6b51-42e0-a328-4cfc4adfb6f2",
                                                "sense_id": "964c5eb3-f26e-3bf8-ba30-40d497b813c5",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "6e2bf143-19c4-49d7-ab37-321ff969ed86",
                                                "sense_id": "964c5eb3-f26e-3bf8-ba30-40d497b813c5",
                                                "text": "Over the past few years, however, interest has waxed again. A series of epidemiological studies, none big enough to be probative, but all pointing in the same direction, persuaded Emma Wilmot of the University of Leicester, in Britain, to carry out a meta-analysis. This is a technique that combines diverse studies in a statistically meaningful way."
                                            },
                                            {
                                                "example_id": "feed7f65-722e-48b0-b070-6cb55c01d544",
                                                "sense_id": "964c5eb3-f26e-3bf8-ba30-40d497b813c5",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861f1c13-e8ab-3bbf-a4bf-bf1821b0b09f",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "An involvement, claim, right, share, stake in or link with a financial, business, or other undertaking or endeavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accd3606-d881-4bfc-b55d-e43a089bf5ce",
                                                "sense_id": "861f1c13-e8ab-3bbf-a4bf-bf1821b0b09f",
                                                "text": "When scientists and doctors write articles and when politicians run for office, they are required in many countries to declare any existing conflicts of interest (competing interests)."
                                            },
                                            {
                                                "example_id": "d0f68960-26d9-4023-aa10-652469ab5410",
                                                "sense_id": "861f1c13-e8ab-3bbf-a4bf-bf1821b0b09f",
                                                "text": "I have business interests in South Africa."
                                            },
                                            {
                                                "example_id": "45a5ac29-95e7-41b0-b760-73773aaea056",
                                                "sense_id": "861f1c13-e8ab-3bbf-a4bf-bf1821b0b09f",
                                                "text": "She has an interest in the proceedings, and all stakeholders' interests must be protected."
                                            },
                                            {
                                                "example_id": "093d9673-e0c7-424f-a105-a6ce6dbe0b96",
                                                "sense_id": "861f1c13-e8ab-3bbf-a4bf-bf1821b0b09f",
                                                "text": "However he lost out, as other business interests whom he had alienated by his efforts to squeeze every penny of profit from the canal, supported the construction of the railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3adb51-9f25-3566-86c5-c3078c6572e8",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "Something which, or someone whom, one is interested in."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe1a49d2-16cd-4af8-b440-e3dcdb59f6fd",
                                                "sense_id": "9b3adb51-9f25-3566-86c5-c3078c6572e8",
                                                "text": "Lexicography is one of my interests."
                                            },
                                            {
                                                "example_id": "125cae53-f903-4b98-ac51-dfa546fade62",
                                                "sense_id": "9b3adb51-9f25-3566-86c5-c3078c6572e8",
                                                "text": "Victorian furniture is an interest of mine."
                                            },
                                            {
                                                "example_id": "172019cb-c622-4a36-b824-61d21c6ad393",
                                                "sense_id": "9b3adb51-9f25-3566-86c5-c3078c6572e8",
                                                "text": "The main character's romantic interest will be played by a non-professional actor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f866dc36-a472-3c73-9e9d-af94b2841300",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "Condition or quality of exciting concern or being of importance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8674ae1-21f0-4c87-abbc-6d5281230dca",
                                                "sense_id": "f866dc36-a472-3c73-9e9d-af94b2841300",
                                                "text": "The conscience, indeed, is already violated when to moral good or evil we oppose things possessing no moral interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050feb9a-4c05-38ee-9648-a34578126555",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "Injury, or compensation for injury; damages."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f99cde-d605-449d-b68e-81e47e2553ee",
                                                "sense_id": "050feb9a-4c05-38ee-9648-a34578126555",
                                                "text": "How can this infinite beauty, power and goodnes admit any correspondencie or similitude with a thing so base and abject as we are, without extreme interest and manifest derogation from his divine greatnesse?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1b9560-850e-38ea-8c73-fee21c89b1d2",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "The persons and companies interested in any particular business or measure, taken collectively."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f25248-00a5-4555-b63b-ed26a5f451ca",
                                                "sense_id": "7d1b9560-850e-38ea-8c73-fee21c89b1d2",
                                                "text": "the iron interest;  the cotton interest"
                                            },
                                            {
                                                "example_id": "d683acfd-b207-46e6-a880-af3849d337d8",
                                                "sense_id": "7d1b9560-850e-38ea-8c73-fee21c89b1d2",
                                                "text": "The ‘Railway Interest’ in Parliament constituted a very powerful lobby at this time [mid to late nineteenth century]. It was pledged to put the railway case forward in all matters involving that industry that came before Parliament. This body of MPs was composed of men who were nearly all railway directors or major shareholders. Their influence waned in the early twentieth century but earlier they formed a phalanx of robust opposition to just about every proposal for government regulation of matters pertaining to railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d8c4cb-0c18-38fd-8599-d35020dd55ff",
                                        "entry_id": "c6339617-f495-3a76-91e8-9b4c6e41b2d2",
                                        "glosses": [
                                            "A genre of factual short films, generally more amusing than informative, especially those not covered by a more specific genre label."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e1050b5-8ce6-4611-a902-8ebb897a993b",
                                                "sense_id": "e1d8c4cb-0c18-38fd-8599-d35020dd55ff",
                                                "text": "By interest films is meant a variety of subjects which cannot be classified under such recognized headings as fiction, travel, or topical. They include wonderful inventions, little known industries, applied art, feats of engineering, and other events capable of effective illustration."
                                            },
                                            {
                                                "example_id": "2a71b833-e9e6-4d16-9d52-67241ef75657",
                                                "sense_id": "e1d8c4cb-0c18-38fd-8599-d35020dd55ff",
                                                "text": "The arrangements made ensured that the total cost of censorship could be kept down to one-fifth of a penny per foot of film censored (and even one-tenth of a penny per foot in cases of Topical, Travel, Interest and Educational Films)."
                                            },
                                            {
                                                "example_id": "cbcea7fc-da8c-48c6-a5c0-bee65208de67",
                                                "sense_id": "e1d8c4cb-0c18-38fd-8599-d35020dd55ff",
                                                "text": "At the top of Charing Cross Road is the \"Tatler,\" which has specialised for a long time in a general sort of program, built up of about 15 minutes of news, a cartoon (sometimes two), an interest picture, occasionally a comedy, and nearly always a documentary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7fe700-fc2e-377e-94ca-6117c110dc9d",
                                        "entry_id": "2a8dd2a2-380b-320f-801c-5ab0d25c8845",
                                        "glosses": [
                                            "To engage the attention of; to awaken interest in; to excite emotion or passion in, in behalf of a person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceeeddc3-e05e-475b-9158-a3a678478cea",
                                                "sense_id": "4d7fe700-fc2e-377e-94ca-6117c110dc9d",
                                                "text": "It might interest you to learn that others have already tried that approach."
                                            },
                                            {
                                                "example_id": "69ae4c30-f877-4837-a22f-afd7c8bd650e",
                                                "sense_id": "4d7fe700-fc2e-377e-94ca-6117c110dc9d",
                                                "text": "Action films don't really interest me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2daf1f68-6f40-3c99-b759-cf46ff56c409",
                                        "entry_id": "2a8dd2a2-380b-320f-801c-5ab0d25c8845",
                                        "glosses": [
                                            "To be concerned with or engaged in; to affect; to concern; to excite."
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "obsolete",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39f1a71-d99c-4ebe-8fba-9ff95ec43202",
                                                "sense_id": "2daf1f68-6f40-3c99-b759-cf46ff56c409",
                                                "text": "Oh, rather, gracious sir, / Create me to this glory; since my cause / Doth interest this fair quarrel; valued least, / I am his equal."
                                            }
