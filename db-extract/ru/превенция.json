                                "target_senses": [
                                    {
                                        "sense_id": "fc178c85-d69d-3718-b9ce-3ca0d13d8433",
                                        "entry_id": "5d123e7b-00db-38c4-a19f-7b7ab7e316cd",
                                        "glosses": [
                                            "Maßnahme zur Abwendung von etwas Bevorstehendem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eaffc23-1ee6-48f6-94e9-e3b2a2316caf",
                                                "sense_id": "fc178c85-d69d-3718-b9ce-3ca0d13d8433",
                                                "text": "„»Prävention ist das beste Mittel, um das Hautkrebsrisiko zu senken. Sei es durch Sonnencreme mit hohem Lichtschutzfaktor, langärmlige Kleidung, Sonnenhüte und die Vermeidung der direkten Sonne«, sagt Birgit Dziuk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
