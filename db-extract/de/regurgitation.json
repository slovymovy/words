                                        "entry_id": "241ad3cd-826e-3ac1-b5d5-a44f072bf98c",
                                        "glosses": [
                                            "Rendre la nourriture déjà ingérée pour nourrir ses petits ou se défendre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
