                    },
                    {
                        "translation_id": "95191fe8-f775-4fb5-823d-87cef31ed5a4",
                        "source_entry_id": "11984fb0-37a7-369e-9c13-2a3c2f4d62b3",
                        "source_sense_id": "1b5b5c22-e84e-372c-b231-60a12fb8696f",
                        "target_lang_word": "agroécologique",
                        "target_lang_code": "fr",
