                                        "glosses": [
                                            "ein (größeres) Bauwerk errichten beziehungsweise errichten lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d884ec94-72c5-4de7-a461-901c891b3af6",
                                                "sense_id": "9543e6bd-cea0-3e34-b3cb-875ff63b84a0",
                                                "text": "„‚Wie kommt man dann 120 Jahre nach der Reformation auf die Idee, so etwas Prunkvolles wie diese Kanzel zu erbauen?‘“"
                                            },
                                            {
                                                "example_id": "007384be-0df4-4e87-b1b0-0d231a81d190",
                                                "sense_id": "9543e6bd-cea0-3e34-b3cb-875ff63b84a0",
                                                "text": "„Das Schloss wurde in den Jahren 1726/1727 vom Tiroler Baumeister Christian Schneller erbaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3a0411b-5816-3168-84eb-916edeea8bcf",
                                        "entry_id": "556496e5-d416-30d9-bb60-31973b84ee9f",
                                        "glosses": [
                                            "innerlich erbauen:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87cd0701-2f44-30b6-a3f3-832b973b6499",
                                        "entry_id": "556496e5-d416-30d9-bb60-31973b84ee9f",
                                        "glosses": [
                                            "sich durch etwas erfreuen oder besinnen; sich innerlich erheben lassen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cdbf61a-04bc-46db-877a-753bea8d359a",
                                                "sense_id": "87cd0701-2f44-30b6-a3f3-832b973b6499",
                                                "text": "Ist sie von etwas deprimiert, versucht sie sich durch gute Musik zu erbauen."
                                            },
                                            {
                                                "example_id": "07ef139d-aaa9-40ea-971f-2ab080aa3372",
                                                "sense_id": "87cd0701-2f44-30b6-a3f3-832b973b6499",
                                                "text": "„Die Begegnung mit Tausenden von Radfahrern, die über die Elbe schippern oder auch Touristen aus Übersee, die sich an solchen traditionsreichen Flussüberquerungen erbauen können, machen das Leben eines Fährmanns abwechslungsreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "49d34cab-7ae1-37a3-8f84-dab1e3232654",
                                        "entry_id": "556496e5-d416-30d9-bb60-31973b84ee9f",
                                        "glosses": [
                                            "in eine gute Stimmungslage versetzen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0120d100-fc83-4a8a-a602-69306dd7a2dc",
                                                "sense_id": "49d34cab-7ae1-37a3-8f84-dab1e3232654",
                                                "text": "„Die Begegnung mit Tausenden von Radfahrern, die über die Elbe schippern oder auch Touristen aus Übersee, die sich an solchen traditionsreichen Flussüberquerungen erbauen können, machen das Leben eines Fährmanns abwechslungsreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "19f0ec25-1c1f-3379-b814-c0ac95be5202",
                                        "entry_id": "556496e5-d416-30d9-bb60-31973b84ee9f",
                                        "glosses": [
                                            "besonders fromme Gedanken wecken"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbdad5d8-70ea-4ff8-a184-66a0751ab949",
                                                "sense_id": "19f0ec25-1c1f-3379-b814-c0ac95be5202",
                                                "text": "Die Predigten bauen sie auf, weshalb sie oft die hisiege Kirche besucht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1f7770a7-67bc-3aaa-aaac-4df31e00ab9d",
                                        "entry_id": "556496e5-d416-30d9-bb60-31973b84ee9f",
