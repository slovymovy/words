                "senses": [
                    {
                        "sense_id": "3803d5f2-d168-3cf2-84a7-040cb19545d3",
                        "entry_id": "104c55a1-a606-3334-bf56-83dd9c8a6cb4",
                        "glosses": [
                            "mittelgroßes Tuch, mit dem man sich zum Beispiel nach dem Duschen abtrocknet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f015daea-0b72-4621-ae7c-fd204f61ae35",
                                "sense_id": "3803d5f2-d168-3cf2-84a7-040cb19545d3",
                                "text": "„Was als Duschtuch bezeichnet wird, ist ein größeres Handtuch, das man nach dem Duschen zum Abtrocknen verwendet.“"
                            },
                            {
                                "example_id": "9c51f765-599d-4c3c-93f0-0c82fbd43ba3",
                                "sense_id": "3803d5f2-d168-3cf2-84a7-040cb19545d3",
                                "text": "„Ein Duschtuch hat meist 70 x 140 cm, ein Badetuch oder auch Strandtuch misst 100 x 180 cm, Gästetücher sind durchweg 50 x 30 cm und Gesichtstücher haben 30 x 30 cm.“"
                            },
                            {
                                "example_id": "d5adeed2-a899-4e3d-b880-52cb3ba635b5",
                                "sense_id": "3803d5f2-d168-3cf2-84a7-040cb19545d3",
                                "text": "„Ein Duschtuch aus gediegenem Material und bester Verarbeitung hält lange Zeit und verliert auch über viele Jahre seine Saugfähigkeit und Weichheit nicht.“"
                            },
                            {
                                "example_id": "8bd4a236-92b5-4aea-8444-667f5f893890",
                                "sense_id": "3803d5f2-d168-3cf2-84a7-040cb19545d3",
                                "text": "„In früheren Zeiten waren Duschtücher hart und schwer zu reinigen.“"
                            },
                            {
                                "example_id": "cf6f9d64-9bcd-4379-8bcb-8f6eca0f0032",
                                "sense_id": "3803d5f2-d168-3cf2-84a7-040cb19545d3",
                                "text": "„Die Duschtücher fühlen sich weich auf der Haut an und eignen sich optimal zum Abtrocknen nach einer erfrischenden Dusche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
