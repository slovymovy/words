                        "examples": [
                            {
                                "example_id": "17207be1-2620-43c6-a6e7-add74571d8f6",
                                "sense_id": "b4c93b31-fab7-3eed-900c-5cd1cc73ca80",
                                "text": "Un beau jour l’ex-président reçut le diplôme d’envoyé extraordinaire et de ministre plénipotentiaire au Chili, à l’effet de contracter avec cette république un traité de commerce et de navigation."
                            },
                            {
                                "example_id": "96ce3f01-b1b1-4001-98b8-39263aa2c68a",
                                "sense_id": "b4c93b31-fab7-3eed-900c-5cd1cc73ca80",
                                "text": "Après cinq ans à la tête de la Corée du Sud, l’ex-président Moon Jae-in aspirait à une retraite paisible dans un petit village, loin du tumulte de Séoul."
                            },
                            {
                                "example_id": "f743eeda-2b94-4f31-a070-3de9d04cc72e",
                                "sense_id": "b4c93b31-fab7-3eed-900c-5cd1cc73ca80",
                                "text": "L’ex-président de la confédération asiatique de football est ainsi activement recherché par le juge Serge Tournaire, avec un mandat d’arrêt délivré le 22 juin pour des faits de corruption privée en lien avec l’attribution de la Coupe du monde de football 2022."
                            }
                        ]
                    }
