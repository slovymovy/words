                ],
                "senses": [
                    {
                        "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                        "entry_id": "70ec42cf-7082-3e6e-b78b-c131f04f0034",
                        "glosses": [
                            "eine Ansammlung von Olivenbäumen, die in einem gewissen Abstand voneinander gepflanzt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470a572b-7a05-4f34-8019-2117f7b0c2b5",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„Das Tholosgrab liegt mitten in einem Olivenhain.“"
                            },
                            {
                                "example_id": "f57038fd-fb50-443b-b67a-ff4d4d69dc62",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„In den unter natürlichen Bedingungen wachsenden Olivenhainen mit oft sehr alten Bäumen wird Olivenöl höchster Qualität und Reinheit erzeugt.“"
                            },
                            {
                                "example_id": "c9aad3e1-5520-4ec5-b7e3-49f79521b8e3",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„Der von ihm gewählte Heimweg führte durch Olivenhaine und Weingärten.“"
                            },
                            {
                                "example_id": "8f92e9f7-4d99-4618-9013-23b337daff31",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„Die Landstraße führt zuerst durch Olivenhaine, gelbes Stroh liegt zwischen den Bäumen und Steinmauern, Straßenkatzen und -hunde streunen umher.“"
                            },
                            {
                                "example_id": "a6ba6581-617f-46cc-ad10-bcaacac99a97",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„Er bog von der Hauptstraße ab und fuhr an einem Olivenhain vorbei auf eine gut anderthalb Kilometer entfernte, erst halb fertiggebaute Villa zu.“"
                            },
                            {
                                "example_id": "eece2f19-59c1-44c8-aa24-f71d1cda1ce7",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„Auf einem grünenden Abhang des Berges Maenalus in Arkadien umgibt ein Olivenhain die Ruinen einer Villa.“"
                            },
                            {
                                "example_id": "be6d693c-781b-405d-8951-cf7dfb829d27",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„In ein paar Monaten wirst du dich nach Italien und seinen Olivenhainen zurücksehnen.“"
                            },
                            {
                                "example_id": "77eb66f4-d4f9-4950-9dd7-dc76288390d0",
                                "sense_id": "e3046d37-d74b-3877-91d0-4b2a05028c4a",
                                "text": "„Als sie auf die Abu-George-Straße abbogen, sahen sie die Olivenhaine, die Abed und seinen Brüdern gehörten, nun aber von Siedlern in Beschlag genommen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
