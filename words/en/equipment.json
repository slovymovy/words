{
    "word_family": [
        "equip",
        "equippable",
        "reequip"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                    "sense_definition": "The set of tools, devices, or clothes needed for a particular purpose or activity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tools_and_supplies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sports shop sells different kits of famous clubs and <w>equipment</w> for all kinds of sports.",
                            "target_lang_translations": {
                                "ru": "В спортивном магазине продается форма различных известных клубов и <w>инвентарь</w> для всех видов спорта."
                            }
                        },
                        {
                            "text": "We need more gardening <w>equipment</w> if we want to properly landscape our yard.",
                            "target_lang_translations": {
                                "ru": "Нам нужно больше садового <w>оборудования</w>, если мы хотим должным образом обустроить наш двор."
                            }
                        }
                    ],
                    "synonyms": [
                        "gear",
                        "kit",
                        "tackle"
                    ],
                    "common_phrases": [
                        "gardening equipment",
                        "sports equipment",
                        "safety equipment",
                        "office equipment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор инструментов, устройств или одежды, необходимых для определенной цели или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборудование",
                                "target_lang_sense_clarification": "технические устройства и приборы"
                            },
                            {
                                "target_lang_word": "снаряжение",
                                "target_lang_sense_clarification": "предметы для похода, спорта или армии"
                            },
                            {
                                "target_lang_word": "экипировка",
                                "target_lang_sense_clarification": "одежда и личное снаряжение"
                            },
                            {
                                "target_lang_word": "инвентарь",
                                "target_lang_sense_clarification": "совокупность предметов для работы или спорта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                    "sense_definition": "The act of providing someone or something with necessary supplies, or the state of being so provided.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process_of_equipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>equipment</w> of the fleet was hastened to ensure they were ready for the long voyage.",
                            "target_lang_translations": {
                                "ru": "<w>Оснащение</w> флота было ускорено, чтобы гарантировать его готовность к долгому плаванию."
                            }
                        },
                        {
                            "text": "Proper <w>equipment</w> of the expedition took several months of careful planning and logistics.",
                            "target_lang_translations": {
                                "ru": "Надлежащее <w>снаряжение</w> экспедиции заняло несколько месяцев тщательного планирования и логистики."
                            }
                        }
                    ],
                    "synonyms": [
                        "appurtenances"
                    ],
                    "common_phrases": [
                        "hasten the equipment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс обеспечения кого-либо или чего-либо необходимыми средствами или состояние такой обеспеченности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащение",
                                "target_lang_sense_clarification": "процесс снабжения техникой"
                            },
                            {
                                "target_lang_word": "оборудование",
                                "target_lang_sense_clarification": "процесс установки устройств"
                            },
                            {
                                "target_lang_word": "снаряжение",
                                "target_lang_sense_clarification": "процесс подготовки к походу или рейсу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                    "sense_definition": "A humorous or indirect way to refer to the male sex organs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article suggested that human owners might consider that their <w>equipment</w> is not the evolutionary ideal.",
                            "target_lang_translations": {
                                "ru": "В статье высказывалось предположение, что люди-владельцы могут посчитать свое <w>хозяйство</w> не самым идеальным с точки зрения эволюции."
                            }
                        },
                        {
                            "text": "He made a joke about his <w>equipment</w> being unsuitable for such cold weather.",
                            "target_lang_translations": {
                                "ru": "Он пошутил о том, что его <w>аппарат</w> не подходит для такой холодной погоды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a euphemism"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутливое или косвенное обозначение мужских половых органов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяйство",
                                "target_lang_sense_clarification": "эвфемизм, разговорное"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "ироничное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}