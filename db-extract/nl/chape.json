                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b51df5c-6955-3856-b448-8974e4cee5cb",
                        "entry_id": "88291132-5c17-34c8-a623-cec2fa227785",
                        "glosses": [
                            "zandcementvloer"
                        ],
                        "tags": [
