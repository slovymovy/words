                        "cross_references": []
                    },
                    {
                        "translation_id": "eef0b358-296d-4cdf-b597-5e9cc54157ce",
                        "source_entry_id": "920b5fc1-480b-3477-bf9b-a1834988b4ff",
                        "target_lang_word": "grains of paradise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grains of paradise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                        "entry_id": "89c8de7e-4a67-3ca1-b616-0830270c8a75",
                                        "glosses": [
                                            "The seeds or seed capsules of Aframomum melegueta, used as a medicine and spice, especially as a substitute for black pepper and in flavoring alcoholic beverages."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7dfd0bf-2271-44d2-b0a0-74c0ce85ef8f",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "...graynes of paradise, hoote & moyst þey be..."
                                            },
                                            {
                                                "example_id": "5dc7e0fa-b6b9-45bb-aff3-9747a53fe32d",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "When I found it [Two-Penny Drink] left a hot Tang behind it, it gave me just Reason to believe they had used Grains of Paradise, or long Pepper, both which will save Malt."
                                            },
                                            {
                                                "example_id": "542d4841-55c4-47d5-8605-98bddb41d658",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "Guinea Grains and Grains of Paradise are considered, by the Trade, as one and the same article."
                                            },
                                            {
                                                "example_id": "766152e2-cb7e-4b04-bba0-5ad32023ddbd",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "\"Gærtner has figured the fruit and seeds of a scitamineous plant under the name of Zingiber Melægueta, and which he considered to be identical with the Grains of Paradise.\""
                                            },
                                            {
                                                "example_id": "f84af48d-16a7-4fde-9989-ea3273ce6ad5",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "...beer poisoned wi' grains o' paradise, and cocculus indicus."
                                            },
                                            {
                                                "example_id": "af49008b-4d4d-42d1-93f3-a39e8bb8b330",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "\"In fact this spice was making a second appearance in Europe: it was Guinea pepper, mentioned by Pliny as 'African pepper', and also known as Malaguetta pepper or grains of Paradise. Grains of Paradise had been very popular in the thirteenth century and again in the sixteenth; its popularity may have been due to the brilliant name thought up for it by some advertising genius born before his time.\""
                                            },
                                            {
                                                "example_id": "dccc9be5-432b-46db-b1f0-4ca0f9f7fb49",
                                                "sense_id": "f35f6c5a-edd0-3f1d-8b69-05542aa6ef10",
                                                "text": "\"Also called Melegueta or Malagueta pepper, guinea grain, or guinea pepper, grains of paradise were prized as a spice and as a substitute for black pepper in Europe during the Middle Ages.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b305803c-7f48-3d58-94a6-a68a3505fc2f",
                                        "entry_id": "89c8de7e-4a67-3ca1-b616-0830270c8a75",
                                        "glosses": [
                                            "Aframomum melegueta itself, a herbaceous perennial plant native to the swamps of the West African coast."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
