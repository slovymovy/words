                "senses": [
                    {
                        "sense_id": "2f1e31cd-6f5d-3df8-acc1-11d9e86b0190",
                        "entry_id": "48b96d49-5443-3eea-a2c5-5e1b7fbeb246",
                        "glosses": [
                            "Einkommen, das jemand in einem Zeitraum von einem Monat erzielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651a201d-bf14-472e-a11b-f8c03bac0e60",
                                "sense_id": "2f1e31cd-6f5d-3df8-acc1-11d9e86b0190",
                                "text": "„Ein Haushalt mit Schulkindern gibt pro Schuljahr 1.330 Euro für Schreibwaren, Werkgeld und Schulveranstaltungen aus, also ein durchschnittliches Netto-Monatseinkommen, wobei Nachhilfekosten noch gar nicht enthalten sind.“"
                            },
                            {
                                "example_id": "58efdc2e-9d01-4180-aa19-b915cbf5293e",
                                "sense_id": "2f1e31cd-6f5d-3df8-acc1-11d9e86b0190",
                                "text": "„Das Monatseinkommen wird aus der Summe der in einem Kalenderjahr erzielten beitragspflichtigen Einkommen berechnet, dividiert durch die Zahl der Versicherungstage mal 30.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
