                        "sense_id": "0817f22a-4ca3-3cf4-a7db-d902a716a792",
                        "entry_id": "c31069f0-6b77-31f0-9d20-3b18734ce58a",
                        "glosses": [
                            "witte, lijnvormige wolk die ontstaat bij het vliegen met een straalvliegtuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b5f1d5-2d64-4de6-93f1-724d301fbdf7",
                                "sense_id": "0817f22a-4ca3-3cf4-a7db-d902a716a792",
                                "text": "... zoals ik ook vaak duizelig werd als ik zomers in het gras lag en naar de blauwe hemel staarde die doorsneden werd door witte condensstrepen die minutenlang zichtbaar bleven na elk vliegtuig dat opsteeg naar elders of juist daalde naar hier..."
                            },
                            {
                                "example_id": "9dc1b315-d57f-43de-ad80-ce9222b5db4b",
                                "sense_id": "0817f22a-4ca3-3cf4-a7db-d902a716a792",
                                "text": "Wetenschappers van het KNMI profiteren van de blauwe luchten nu er nauwelijks vliegtuigen zijn die condensstrepen en daarmee bewolking veroorzaken. Het sterk verminderde vliegverkeer is volgens het KNMI een unieke kans om onderzoek te doen naar een atmosfeer met weinig vliegtuigstrepen."
                            }
                        ]
                    }
