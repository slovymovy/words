                ],
                "senses": [
                    {
                        "sense_id": "90dcf1bb-90ee-31d4-a45f-4eb5bfc8fd95",
                        "entry_id": "06c9580d-50b3-3e7f-a4a3-c23feb203c5c",
                        "glosses": [
                            "Insel in der Baffin Bay vor der Westküste Grönlands mit einer Fläche von 8.578 Quadratkilometer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b77d899-03c3-4e9c-afd4-4cf5f150a726",
                                "sense_id": "90dcf1bb-90ee-31d4-a45f-4eb5bfc8fd95",
                                "text": "Sie gründeten hier vor 230 Jahren eine Walfangstation, hörten die Sprache und machten aus Qeqertarsuaq, dem Ort, eilig Godhavn und aus Qeqertarsuaq, dem Eiland, die Diskoinsel."
                            },
                            {
                                "example_id": "a7166cc6-fd22-4e24-ab8e-72d69cdbc5cd",
                                "sense_id": "90dcf1bb-90ee-31d4-a45f-4eb5bfc8fd95",
                                "text": "Auch der Blick entlang der Küste und zurück auf das mehr als 1.000m hohe Basaltmassiv der Diskoinsel ist einen Spaziergang zum Aussichtposten wert."
                            },
                            {
                                "example_id": "3e18bbc8-88ff-44bc-b299-a7d4919f6e7a",
                                "sense_id": "90dcf1bb-90ee-31d4-a45f-4eb5bfc8fd95",
                                "text": "Die Basaltberge entstanden vor rund 60 Millionen Jahren und fast die gesamte Diskoinsel ist aus Basalt aufgebaut."
                            },
                            {
                                "example_id": "f09385fe-c34d-4e68-a087-d293d6b98421",
                                "sense_id": "90dcf1bb-90ee-31d4-a45f-4eb5bfc8fd95",
                                "text": "Besonders beliebt aber ist die Route von Kangerlussuaq über die Diskobucht rund um die Diskoinsel mit dem Eisfjord Kangia nach Uummannaq im Norden."
                            },
                            {
                                "example_id": "81c92c80-40e3-44a6-a90e-dac68d558dce",
                                "sense_id": "90dcf1bb-90ee-31d4-a45f-4eb5bfc8fd95",
                                "text": "Cairn will zwei Quellen im sogenannten „Sigguk“-Block vor der Westküste Grönlands, 175 Kilometer von der Diskoinsel entfernt, bohren; auf der rund 8600 km2großen Insel leben rund 1100 Menschen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
