                "senses": [
                    {
                        "sense_id": "1e73a02b-f3b3-321a-8c5f-248939158bbc",
                        "entry_id": "c4b1bb23-6bea-34b6-be12-259b11ca7ae1",
                        "glosses": [
                            "Sozialwissenschaft, die den Menschen als soziales Wesen in gesellschaftlichen Zusammenhängen untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e2f093-aff1-426d-a6ad-3526d564add4",
                                "sense_id": "1e73a02b-f3b3-321a-8c5f-248939158bbc",
                                "text": "„Von 1930–69 hatte der Meinhof-Schüler N.J. van Warmelo die Stelle des Regierungsethnologen inne, und die Universitäten, an denen Sozialanthropologie gelehrt wurde, dienten sich dem Staat schon seit den frühen 1920er Jahren an.“"
                            },
                            {
                                "example_id": "61fb6899-fdf3-4f8d-9e58-f41e8807d571",
                                "sense_id": "1e73a02b-f3b3-321a-8c5f-248939158bbc",
                                "text": "„Sie war fasziniert sowohl vom Mythos als auch der Wissenschaft der Sexualität und hatte im Hauptfach von Psychologie zu Sozialanthropologie gewechselt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
