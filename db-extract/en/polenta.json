                "senses": [
                    {
                        "sense_id": "25569a12-52ea-3397-a4ce-ddfd86d56849",
                        "entry_id": "70b70aa5-64a0-3d82-9631-8354aa2d16ea",
                        "glosses": [
                            "Any of various types and consistencies of a starchy accompaniment to a meal made from coarse maize-meal porridge, sometimes fried or grilled."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "710661ab-c65b-43d5-83bb-0b87ebaf9174",
                        "source_entry_id": "70b70aa5-64a0-3d82-9631-8354aa2d16ea",
                        "source_sense_id": "25569a12-52ea-3397-a4ce-ddfd86d56849",
                        "source_sense_description": "starchy accompaniment to a meal",
                        "target_lang_word": "Polenta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polenta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e52fce2-b7fb-3909-9560-ecdf2c74d305",
                                        "entry_id": "8b2ea8ec-c219-3e74-bd67-982eab12d34d",
                                        "glosses": [
                                            "fester Brei aus gekochtem Maisgrieß, der zum Verzehr häufig in Scheiben geschnitten wird und auch angebraten werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04d1216-77e0-4e5f-b1a6-851d8df063d1",
                                                "sense_id": "4e52fce2-b7fb-3909-9560-ecdf2c74d305",
                                                "text": "Die Polenta wird zum Auskühlen auf ein Blech gestrichen und dann in Rauten geschnitten."
                                            },
                                            {
                                                "example_id": "ed141e96-0d88-446e-bbee-811556da98d9",
                                                "sense_id": "4e52fce2-b7fb-3909-9560-ecdf2c74d305",
                                                "text": "Zum Grillfest steuerte Hermann seine berühmte Polenta bei."
                                            },
                                            {
                                                "example_id": "845fedfe-31de-41d1-862c-c0ff25a2a67d",
                                                "sense_id": "4e52fce2-b7fb-3909-9560-ecdf2c74d305",
                                                "text": "„Bei Polenta und einem Glas Rotwein bewältigten sie in nur drei Tagen das, was Parlamentskommissionen oft versucht, aber nie geschafft hatten.“"
                                            },
                                            {
                                                "example_id": "7907ddcc-0847-45b2-aee8-f58f944d2d50",
                                                "sense_id": "4e52fce2-b7fb-3909-9560-ecdf2c74d305",
                                                "text": "„Erfreut über diese Ehre ging Costa gleich in die Küche, um Signora Momolo bei der Zubereitung der Polenta zu helfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c729f47b-59cb-45f3-950d-bacfa12f344b",
                        "source_entry_id": "70b70aa5-64a0-3d82-9631-8354aa2d16ea",
                        "source_sense_id": "25569a12-52ea-3397-a4ce-ddfd86d56849",
                        "source_sense_description": "starchy accompaniment to a meal",
                        "target_lang_word": "polenta",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
