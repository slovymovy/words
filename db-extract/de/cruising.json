                                            {
                                                "example_id": "ad583c19-8972-4b36-8521-c660546fa9f9",
                                                "sense_id": "a35dc7f0-e878-32c9-b92b-66a3fb7ad7bb",
                                                "text": "Cruising was a popular pasttime for teens in this area at the time."
                                            }
                                        ]
