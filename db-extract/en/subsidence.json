                    {
                        "translation_id": "10fc5242-bfe8-4f43-af68-3206dc54b854",
                        "source_entry_id": "98c0c278-2934-3fa0-b5e3-0b5903deec06",
                        "source_sense_description": "sinking of ground",
                        "target_lang_word": "Setzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Setzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db0b1dda-fdda-3df4-8596-bce4ea3730ff",
                                        "entry_id": "e68d4f73-4181-31ab-9fce-6b56d494199e",
                                        "glosses": [
                                            "allgemein: Absenkung eines Gebäudes oder Geländes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f807f45-23cc-4873-b903-90b9db6dd938",
                                                "sense_id": "db0b1dda-fdda-3df4-8596-bce4ea3730ff",
                                                "text": "Die Setzungen des Geländes haben große Setzrisse im Gebäude verursacht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1addf543-d9a6-37f8-a384-ffc8f3ecf27b",
                                        "entry_id": "e68d4f73-4181-31ab-9fce-6b56d494199e",
                                        "glosses": [
                                            "allgemein: Festlegung, Festsetzung, Verwendung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ce9afb-481d-4a0b-94ae-a3f33378916c",
                                                "sense_id": "1addf543-d9a6-37f8-a384-ffc8f3ecf27b",
                                                "text": "„Neue Spielfelder im internationalen Kräftemessen entstehen durch die Setzung von Standards und Normen.“"
                                            },
                                            {
                                                "example_id": "c550f84a-6643-4377-9d49-1ca96dbe5c90",
                                                "sense_id": "1addf543-d9a6-37f8-a384-ffc8f3ecf27b",
                                                "text": "Die Setzung des Wortakzents folgt in vielen Sprachen bestimmten Regeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "da58c34f-fd59-315e-8a7e-227159af8ea8",
                                        "entry_id": "e68d4f73-4181-31ab-9fce-6b56d494199e",
                                        "glosses": [
                                            "unvollständiger Satz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d38b83-8df6-44e7-adad-f4585505c8ee",
                                                "sense_id": "da58c34f-fd59-315e-8a7e-227159af8ea8",
                                                "text": "„Sehr charakteristisch ist in dieser Übersicht der hohe Anteil der Setzungen.“"
                                            },
                                            {
                                                "example_id": "6f3da0fb-69f4-4e71-80e1-7372738c845c",
                                                "sense_id": "da58c34f-fd59-315e-8a7e-227159af8ea8",
                                                "text": "„Mit einiger Überraschung liest man in Eggers' Statistik zum deutschen Satz die Beobachtungen und Zahlenergebnisse zum Vorkommen der Setzungen (grammatikalisch unvollständige Sätze).“"
                                            },
                                            {
                                                "example_id": "ab409abd-9ffb-4011-a439-9f73bb1ea4c8",
                                                "sense_id": "da58c34f-fd59-315e-8a7e-227159af8ea8",
                                                "text": "„Methodischer Ausgangspunkt ist dabei zunächst die Unterscheidung der vier Kategorien ‚Setzung‘, ‚Einfachsatz‘, ‚Reihe‘, ‚Gefüge‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
