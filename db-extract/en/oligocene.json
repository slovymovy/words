                    {
                        "translation_id": "e3205a21-2760-4f57-a65c-13e9dd130a32",
                        "source_entry_id": "dd55b8b1-073d-37e8-86f9-a2a4a0b8999f",
                        "source_sense_id": "ae4cb43e-1756-38a7-98f2-b9d38819f92b",
