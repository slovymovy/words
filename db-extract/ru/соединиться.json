                ],
                "senses": [
                    {
                        "sense_id": "104e23d8-474d-3bd6-9396-85b04c043dac",
                        "entry_id": "63dd348a-ffa5-3001-8fda-77f50bb94df4",
                        "glosses": [
                            "то же, что объединиться, образовать единое целое с чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "597fc313-4d6f-440a-b096-0e7d8cd2f701",
                        "source_entry_id": "63dd348a-ffa5-3001-8fda-77f50bb94df4",
                        "source_sense_id": "104e23d8-474d-3bd6-9396-85b04c043dac",
                        "target_lang_word": "join",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "join",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00efe320-850c-3099-9843-9d4f7f8ca315",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To connect or combine into one; to put together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eeb8618-74bf-42d8-bbdb-c422a0941cd1",
                                                "sense_id": "00efe320-850c-3099-9843-9d4f7f8ca315",
                                                "text": "The plumber joined the two ends of the broken pipe."
                                            },
                                            {
                                                "example_id": "a23fceff-a742-4c26-8b81-ab349feb2f93",
                                                "sense_id": "00efe320-850c-3099-9843-9d4f7f8ca315",
                                                "text": "We joined our efforts to get an even better result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e47ff32c-0037-3052-8fe7-d077616a8d2d",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To come together; to meet."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e11646-7e2b-432e-94c1-b8ec7a3451c0",
                                                "sense_id": "e47ff32c-0037-3052-8fe7-d077616a8d2d",
                                                "text": "Parallel lines never join."
                                            },
                                            {
                                                "example_id": "65fc54fa-c16d-47da-934d-d614cbcf7e0b",
                                                "sense_id": "e47ff32c-0037-3052-8fe7-d077616a8d2d",
                                                "text": "These two rivers join in about 80 miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1572f906-d8cf-3461-8c4d-5fb4c88851b9",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To enter into association or alliance, to unite in a common purpose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1adf09c1-ad1a-4c46-85bc-cd7a5d1574bb",
                                                "sense_id": "1572f906-d8cf-3461-8c4d-5fb4c88851b9",
                                                "text": "Forſake thy king and do but ioyne with me\nAnd we will triumph ouer al the world."
                                            },
                                            {
                                                "example_id": "35cbb780-deb6-4c1b-988c-7fcb4e711177",
                                                "sense_id": "1572f906-d8cf-3461-8c4d-5fb4c88851b9",
                                                "text": "[…]Nature and Fortune ioyn’d to make thee great."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7b4678-1fc0-3aeb-acf2-5d3d84fc32d7",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To come into the company of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7188892-7092-476b-9dc0-be2c9047a47a",
                                                "sense_id": "ea7b4678-1fc0-3aeb-acf2-5d3d84fc32d7",
                                                "text": "I will join you watching the football game as soon as I have finished my work."
                                            },
                                            {
                                                "example_id": "347bb637-b6bc-4123-8fde-19b83e6abb9f",
                                                "sense_id": "ea7b4678-1fc0-3aeb-acf2-5d3d84fc32d7",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67e82c6-d0dd-3119-8617-dcf53fa80156",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To become a member of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022e300c-38e1-45b1-9fc2-81c5a01217c2",
                                                "sense_id": "e67e82c6-d0dd-3119-8617-dcf53fa80156",
                                                "text": "Many children join a sports club."
                                            },
                                            {
                                                "example_id": "894fc470-19c6-4b55-a98b-f887aca27c2d",
                                                "sense_id": "e67e82c6-d0dd-3119-8617-dcf53fa80156",
                                                "text": "Most politicians have joined a party."
                                            },
                                            {
                                                "example_id": "dd10ce90-5649-4602-a010-4c1b6f18e8a2",
                                                "sense_id": "e67e82c6-d0dd-3119-8617-dcf53fa80156",
                                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84f75939-08f7-35c8-8230-627b99b21f74",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To produce an intersection of data in two or more database tables."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fccd5bb-b9df-4a64-8f78-c266f7eeb071",
                                                "sense_id": "84f75939-08f7-35c8-8230-627b99b21f74",
                                                "text": "By joining the Customer table on the Product table, we can show each customer's name alongside the products they have ordered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968295ba-6522-3d79-ac30-a897e5121b5e",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To unite in marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b75c00-27b7-49db-9f47-7ff91ad5c05b",
                                                "sense_id": "968295ba-6522-3d79-ac30-a897e5121b5e",
                                                "text": "Into the whiche holy eſtate theſe two perſones pꝛeſent: come nowe to be ioyned."
                                            },
                                            {
                                                "example_id": "a76e9e67-35b7-47b0-a6af-9251b5dadf9c",
                                                "sense_id": "968295ba-6522-3d79-ac30-a897e5121b5e",
                                                "text": "[…]this fellow wil but ioyne you together, as they ioyne\n Wainscot, then one of you wil proue a ſhrunke pannell[…]"
                                            },
                                            {
                                                "example_id": "8f82ec0f-e0b9-4d99-9886-214b7ff0df7f",
                                                "sense_id": "968295ba-6522-3d79-ac30-a897e5121b5e",
                                                "text": "What therefore God hath ioyned together, let not man put aſunder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff73d0e3-c0b6-377f-ac57-2874b9859ecc",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To enjoin upon; to command."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b909b296-4f54-4cde-a45b-9d42f54e06d0",
                                                "sense_id": "ff73d0e3-c0b6-377f-ac57-2874b9859ecc",
                                                "text": "And they ioyne them penaunce / as they call it / to faſt / to goo pylgremages ⁊ geve ſo moch to make ſatiſfaccion with all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae7b87c6-3583-3ef4-a30e-dcbe62e153bd",
                                        "entry_id": "6a0aa653-71c2-3f7a-85db-941a3c8e7251",
                                        "glosses": [
                                            "To accept, or engage in, as a contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edd7a3c9-cfcf-42fe-87a8-1a7d5138693d",
                                                "sense_id": "ae7b87c6-3583-3ef4-a30e-dcbe62e153bd",
                                                "text": "to join encounter, battle, or issue"
                                            },
                                            {
                                                "example_id": "d4583081-f18c-49ac-b7dc-ee619063809a",
                                                "sense_id": "ae7b87c6-3583-3ef4-a30e-dcbe62e153bd",
                                                "text": "Then when our powers in points of ſwords are ioin’d\nAnd cloſde in compaſſe of the killing bullet, […]"
                                            },
                                            {
                                                "example_id": "366eb0ba-45d1-4227-920e-456ea3ad41a2",
                                                "sense_id": "ae7b87c6-3583-3ef4-a30e-dcbe62e153bd",
                                                "text": "On the rough edge of battel ere it joyn'd."
                                            },
                                            {
                                                "example_id": "e46c809c-5739-4486-bb19-c904eb36fe7e",
                                                "sense_id": "ae7b87c6-3583-3ef4-a30e-dcbe62e153bd",
                                                "text": "Before joining battle, the officers and warriors gathered to make divinations \"before the spirits of the former rulers,\" as at the battle of Yen-ling between Chin and Ch'u in 575 b.c."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "join",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390d3957-3a95-381e-a826-d7d6d37fffab",
                                        "entry_id": "cb2ec129-5b94-3e41-b512-6687d1007784",
                                        "glosses": [
                                            "An act of joining or the state of being joined; a junction or joining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89505660-c856-44cb-8ec3-64b442be373d",
                                                "sense_id": "390d3957-3a95-381e-a826-d7d6d37fffab",
                                                "text": "We found 217 putative interchromosomal joins. Only one of these joins (in the paternal assembly of HG02080) was located in a euchromatic, non-acrocentric region and was manually confirmed to be a misassembly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc3e0a5-7dbc-3f09-aecc-787f06a8fc06",
                                        "entry_id": "cb2ec129-5b94-3e41-b512-6687d1007784",
                                        "glosses": [
                                            "An intersection of piping or wiring; an interconnect."
                                        ],
