                "senses": [
                    {
                        "sense_id": "02a737b1-feb5-3670-898c-a558bddea186",
                        "entry_id": "0ab3bc83-4976-3dc7-8cb1-5e3d4d1665d4",
                        "glosses": [
                            "ein Bauwerk, das speziell errichtet wurde, um darin Fußball zu spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49936cd4-277d-43af-b11e-b01b03856fff",
                                "sense_id": "02a737b1-feb5-3670-898c-a558bddea186",
                                "text": "Das Fußballstadion der Gastgeber fasst 43.000 Zuschauer."
                            },
                            {
                                "example_id": "37b6ba13-8732-4949-8f6a-f38bac6710c9",
                                "sense_id": "02a737b1-feb5-3670-898c-a558bddea186",
                                "text": "„Etwa zur gleichen Zeit endet im Fußballstadion ein Spiel.“"
                            },
                            {
                                "example_id": "330092b9-a956-424e-b5f9-98450f44660e",
                                "sense_id": "02a737b1-feb5-3670-898c-a558bddea186",
                                "text": "„Nachdem im Jahr 2000 in Tórshavn das Fußballstadion Tórsvöllur in Betrieb genommen wurde, verlor Toftir aber an Bedeutung.“"
                            },
                            {
                                "example_id": "88f2f297-38a6-4e8b-82f9-79c2f7c76152",
                                "sense_id": "02a737b1-feb5-3670-898c-a558bddea186",
                                "text": "„Wir fahren am nagelneuen Fußballstadion vorbei.“"
                            },
                            {
                                "example_id": "bcab061b-7482-4243-8a17-7ddcfafe44f4",
                                "sense_id": "02a737b1-feb5-3670-898c-a558bddea186",
                                "text": "„Bald standen ein halbes Dutzend Bildungsbürger um uns herum und schrien mich und einander in einer Tonlage an, die man sonst nur in Fußballstadien hört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
