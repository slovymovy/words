{
    "word_family": [
        "inerte",
        "inertiel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                    "sense_definition": "Manque d'activité, d'énergie ou de volonté d'agir chez une personne ou une collectivité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois de découragement, il a enfin décidé de sortir de cette profonde <w>inertie</w>."
                        },
                        {
                            "text": "L'<w>inertie</w> de l'administration ralentit considérablement la réalisation des nouveaux projets urbains."
                        }
                    ],
                    "synonyms": [
                        "apathie",
                        "léthargie",
                        "passivité"
                    ],
                    "antonyms": [
                        "activité",
                        "dynamisme",
                        "énergie"
                    ],
                    "common_phrases": [
                        "profonde inertie",
                        "complète inertie"
                    ]
                },
                {
                    "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                    "sense_definition": "Propriété des corps matériels de conserver leur état de repos ou de mouvement rectiligne uniforme en l'absence de force extérieure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors du freinage brutal du train, l'<w>inertie</w> a projeté les passagers vers l'avant du wagon."
                        },
                        {
                            "text": "La sonde spatiale poursuit son voyage à vitesse constante uniquement grâce à son <w>inertie</w>."
                        }
                    ],
                    "common_phrases": [
                        "inertie thermique",
                        "inertie mécanique"
                    ]
                },
                {
                    "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                    "sense_definition": "Résistance passive qui consiste à refuser d'agir ou à ne pas exécuter ce qui est demandé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés ont manifesté leur désaccord par une véritable force d'<w>inertie</w> face aux ordres."
                        },
                        {
                            "text": "Le directeur s'est heurté à l'<w>inertie</w> de son équipe pour appliquer le nouveau règlement."
                        }
                    ],
                    "synonyms": [
                        "résistance passive"
                    ],
                    "antonyms": [
                        "coopération",
                        "obéissance"
                    ]
                },
                {
                    "sense_id": "d09afc63-50dc-3feb-85e2-42e17707ea20",
                    "sense_definition": "Absence de réaction chimique d'un corps ou d'un élément en présence d'autres substances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>inertie</w> chimique de l'or empêche toute forme d'oxydation au contact de l'air ambiant."
                        },
                        {
                            "text": "Ces gaz rares sont principalement utilisés pour leur remarquable <w>inertie</w> dans l'industrie."
                        }
                    ],
                    "antonyms": [
                        "réactivité"
                    ],
                    "common_phrases": [
                        "inertie chimique"
                    ]
                }
            ]
        }
    ]
}