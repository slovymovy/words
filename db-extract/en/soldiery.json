                    {
                        "translation_id": "2eb7f5d2-110d-43f0-9f2a-0694c316ca87",
                        "source_entry_id": "f8b76239-b9ae-3a64-8136-52b886f59cb5",
                        "source_sense_description": "the profession or skill of being a soldier",
                        "target_lang_word": "Heeresdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heeresdienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d98dfa46-ab61-3c40-96b8-69b923a2b28b",
                                        "entry_id": "4a752908-044b-32a1-9bc2-b1628b47efb3",
                                        "glosses": [
                                            "Militär: Dienst im Heer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b30044-53f5-4967-970b-ebb50837699a",
                                                "sense_id": "d98dfa46-ab61-3c40-96b8-69b923a2b28b",
                                                "text": "„Am selben Morgen, wo der Streik beginnen sollte, hätten sie ihre Einberufung zum Heeresdienst in den Händen gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "242d71ac-b047-43a2-9baa-658ff1d48c18",
                        "source_entry_id": "f8b76239-b9ae-3a64-8136-52b886f59cb5",
                        "source_sense_description": "the profession or skill of being a soldier",
                        "target_lang_word": "Kriegsdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriegsdienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                        "entry_id": "68f54608-eb8c-3600-a970-42154f5f62b7",
                                        "glosses": [
                                            "Wahrnehmung bestimmter Aufgaben in einer kriegerischen Auseinandersetzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f1a92b-b3b3-4887-b2a4-389d0e41398e",
                                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                                "text": "„Sie besaßen keinen Stolz mehr wie die Holländer und die Norweger, sprachen viel mehr von ihren Familien und Häusern als von dem Kriegsdienst, den sie leisteten, sehnten sich ganz unverhüllt nach Hause, nur nach Hause, um jeden Preis, auch als Geschlagene, falls kein Sieg sie wieder aufrichten sollte.“"
                                            },
                                            {
                                                "example_id": "34f74c91-896e-473c-9413-17ec5ef55097",
                                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                                "text": "„Im Verlaufe des Ersten Weltkriegs stieg zwar die Zahl der Fahrgäste stark an, dafür fehlte es aber an Material und vor allem auch an Mitarbeitern, die zum Kriegsdienst einberufen waren und nicht immer durch Frauen ersetzt werden konnten.“"
                                            },
                                            {
                                                "example_id": "0e8b5a63-2589-4aba-aa7b-aa679436c6c6",
                                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                                "text": "„Seine beiden Söhne Flavus und Arminius hatten als Legionäre Kriegsdienst geleistet.“"
                                            },
                                            {
                                                "example_id": "667eb51d-a229-41fb-9af3-f5cd8eaedeb7",
                                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                                "text": "„Grundsätzlich sollte zwar jeder Mann zwischen 17 und 60 Jahren, der nicht zum Kriegsdienst eingezogen war, der Dienstpflicht unterliegen.“"
                                            },
                                            {
                                                "example_id": "1457334e-b6a9-4d02-aa5e-1955bc4408a5",
                                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                                "text": "„Die rhodesische Armee musste nun alle Männer unter 38 Jahren zum Kriegsdienst einberufen, ein klares Zeichen, wie wirkungsvoll die Offensive der ZANLA war: Die Initiative war auf die Guerillas übergegangen.“"
                                            },
                                            {
                                                "example_id": "0fcc2a6a-f867-41b6-921a-fefaef322bfd",
                                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                                "text": "Grundgesetz für die Bundesrepublik Deutschland, Art 4 (3): „Niemand darf gegen sein Gewissen zum Kriegsdienst mit der Waffe gezwungen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4da35da9-31e0-4534-a663-107b61c40520",
                        "source_entry_id": "f8b76239-b9ae-3a64-8136-52b886f59cb5",
                        "source_sense_description": "the profession or skill of being a soldier",
                        "target_lang_word": "Präsensdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7283a696-4da7-412f-902e-5a0ba1667277",
                        "source_entry_id": "f8b76239-b9ae-3a64-8136-52b886f59cb5",
                        "source_sense_description": "the profession or skill of being a soldier",
                        "target_lang_word": "Wehrdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wehrdienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc356d7-7cad-35f7-9032-2851728198df",
                                        "entry_id": "5d5f18c2-4df6-30d0-8fff-b7e83fbf7d94",
                                        "glosses": [
                                            "zeitlich begrenzter Dienst in den Streitkräften eines Landes, der aufgrund einer gesetzlichen Pflicht oder einer freiwilligen Selbstverpflichtung geleistet wird"
                                        ],
                                        "tags": [
                                            "gemeindeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9b4d7d7-0889-4689-94b1-e2ee20c2705c",
                                                "sense_id": "8dc356d7-7cad-35f7-9032-2851728198df",
                                                "text": "„Der §. 10 des Bürgerwehrgesetzentwurfs enthält mehrere Kategorien von zum Wehrdienste nicht verpflichteten Personen, unter denen sich aber befremdlicher Weise die Mediziner nicht befinden.“"
                                            },
                                            {
                                                "example_id": "d1e9763f-1ae5-426e-b6af-861839ababa0",
                                                "sense_id": "8dc356d7-7cad-35f7-9032-2851728198df",
                                                "text": "„Brinkhaus hat Wirtschaftswissenschaften studiert, machte seinen Wehrdienst bei den Panzerjägern im westfälischen Augustdorf und arbeitete als Steuerberater in Gütersloh.“"
                                            },
                                            {
                                                "example_id": "531ad1bb-e454-4f2b-84a9-63440d17a20a",
                                                "sense_id": "8dc356d7-7cad-35f7-9032-2851728198df",
                                                "text": "„Kurz vor Ende seines Wehrdienstes marschierte die Wehrmacht am 1. September 1939 in Polen ein.“"
                                            },
                                            {
                                                "example_id": "99ee5d87-e9a2-4a52-a765-68d0e5c5d0f4",
                                                "sense_id": "8dc356d7-7cad-35f7-9032-2851728198df",
                                                "text": "„Die Gegend mit Temperaturen um minus 50 Grad Celsius gilt als einer der härtesten Orte, an denen russische Rekruten ihren Wehrdienst absolvieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "5646ca96-6be7-3bd1-bda5-7ed55ce8201b",
                                        "entry_id": "5d5f18c2-4df6-30d0-8fff-b7e83fbf7d94",
                                        "glosses": [
                                            "militärische (Hilfs-)Tätigkeit, zu deren Ausübung ein Bürger durch die Herrschenden verpflichtet wird; Tätigkeit, die im Rahmen des Wehrdienstes [1a] verrichtet wird"
                                        ],
                                        "tags": [
                                            "gemeindeutsch",
                                            "vor allem historisch",
                                            "heute zumeist"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "435f7905-2e83-4ac5-9722-f419a3e5dadb",
                                                "sense_id": "5646ca96-6be7-3bd1-bda5-7ed55ce8201b",
                                                "text": "„Nothwendig also kamen die Freien mit der Zeit dadurch tief herunter, daß sie den allezeit fertigen Rittern ihre Wehrdienste mit guter Entschädigung auftrugen […]“"
                                            },
                                            {
                                                "example_id": "8e39e4bf-b34e-4bac-b5ef-ed2b13e9c925",
                                                "sense_id": "5646ca96-6be7-3bd1-bda5-7ed55ce8201b",
                                                "text": "„In der Grundherrschaft lag die Befugniß, die Unterthanen zu jeder Art von Wehrdiensten anzuhalten, sowohl zum Auszug als zu Wachen in Thürmen und Schanzen, oder zu Fuhren und Handreichungen bei Kriegsbauten […]“"
                                            },
                                            {
                                                "example_id": "f263e743-c613-4e46-9a9a-cedd22eb4152",
                                                "sense_id": "5646ca96-6be7-3bd1-bda5-7ed55ce8201b",
                                                "text": "„Einen möglichen Lösungsweg […] hatte Scheuner [1963] in seinem Gutachten beschrieben. Seiner Ansicht nach war die Betrauung mit der Verteidigungsaufgabe nur eine besondere Form, ‚geeignete und ausgebildete Kräfte zu Wehrdiensten heranzuziehen […] ohne für sie im Verteidigungsfalle notwendig den Weg über eine formelle Einberufung gehen zu müssen‘."
                                            },
                                            {
                                                "example_id": "bf4ee23d-5291-46a2-9fcd-0ba92db62bd3",
                                                "sense_id": "5646ca96-6be7-3bd1-bda5-7ed55ce8201b",
                                                "text": "„Hiergegen erhob der Kläger Klagen zum Verwaltungsgericht, mit denen er beantragte, […] die Beklagte zu verpflichten, dem Kläger für die Wehrdienste vom 20. Juli bis 21. August 2015, vom 31. August bis 2. Oktober 2015 und vom 19. Oktober bis 18. Dezember 2015 antragsgemäß Leistungen […] zu bewilligen.“"
                                            },
                                            {
                                                "example_id": "6749acea-8662-4d01-bf38-f61f0c6b51a6",
                                                "sense_id": "5646ca96-6be7-3bd1-bda5-7ed55ce8201b",
                                                "text": "„Die Klägerin bezog während der gesamten Dauer der Wehrdienste kein Kindergeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                        "entry_id": "5d5f18c2-4df6-30d0-8fff-b7e83fbf7d94",
                                        "glosses": [
                                            "Einrichtung und Mannschaft zur Brandbekämpfung, zum Katastrophenschutz und ähnlichen Tätigkeiten; eine Feuer-, Öl- oder Chemiewehr"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "plural-normally",
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d10bd784-9ad5-4430-afb3-4049d7175ca0",
                                                "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                                "text": "„Überschwemmungen und Erdrutsche hielten auch in der Zentralschweiz die Wehrdienste auf Trab.“"
                                            },
                                            {
                                                "example_id": "59f72876-22f2-48b7-bb7c-98e51ccb2368",
                                                "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                                "text": "„An verschiedenen Orten mussten im Berner Oberland am Sonntagvormittag die Wehrdienste ausrücken, um überflutete Keller auszupumpen, Sandsäcke zu positionieren und Sturmholz bei den Brücken zu entfernen […]“"
                                            },
                                            {
                                                "example_id": "0cd03eae-389d-41c5-824e-6cf24d1cedfb",
                                                "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                                "text": "„Ruth Greiner gab den Impuls für eine Übung der Wehrdienste beider Basel, bei der erstmals in der Schweiz dem neuen Konzept Bevölkerungsschutz XXI Rechnung getragen wurde.“"
                                            },
                                            {
                                                "example_id": "689d5f96-15ea-4331-937f-28e0417eb3ef",
                                                "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                                "text": "„‚Wehrdienst‘ oder ‚Ereignisdienst‘ meint die Zusammenfassung der Dienste von Feuerwehren, Ölwehren und Chemiewehren.“"
                                            },
                                            {
                                                "example_id": "5a3689de-7318-4b93-9d32-4016218fb7a6",
                                                "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                                "text": "„Weil es in einem Gebäude in Freiburg nach Gas roch, haben die Wehrdienste rund 50 Personen vorübergehend evakuiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
