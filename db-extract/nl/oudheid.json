                "senses": [
                    {
                        "sense_id": "1d43fdc8-227d-3d8a-85e7-a1b1bb09b74f",
                        "entry_id": "d09eb2ea-8cf4-364c-bfd1-48004bf376d8",
                        "glosses": [
                            "het tijdperk van de geschiedenis van de prehistorie tot de middeleeuwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a32586c-973b-4a07-b550-56604a05f324",
                                "sense_id": "1d43fdc8-227d-3d8a-85e7-a1b1bb09b74f",
                                "text": "In de oudheid was het Romeinse Rijk een bijzonder belangrijke politieke eenheid."
                            },
                            {
                                "example_id": "98962738-54bd-46dd-a6b4-9e78ab80f4cc",
                                "sense_id": "1d43fdc8-227d-3d8a-85e7-a1b1bb09b74f",
                                "text": "Het einde van de antieke sportcultuur In de late oudheid verdween de antieke sport."
                            },
                            {
                                "example_id": "e623b9db-027b-4316-b447-3bf736b271a4",
                                "sense_id": "1d43fdc8-227d-3d8a-85e7-a1b1bb09b74f",
                                "text": "De kerk bleef zich dan ook graag bedienen van de sportmetaforen die uit de oudheid waren overgeleverd: monniken werden bijvoorbeeld omschreven als Athletae Christi."
                            }
                        ]
                    },
                    {
                        "sense_id": "5db43b9b-4042-32f6-ac39-a8ed4689ed8c",
                        "entry_id": "d09eb2ea-8cf4-364c-bfd1-48004bf376d8",
                        "glosses": [
                            "een overblijfsel uit [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f09270c-7d64-4c93-a7cc-e361d2d77651",
                                "sense_id": "5db43b9b-4042-32f6-ac39-a8ed4689ed8c",
                                "text": "Hij houdt zich bezig met de studie van oudheden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa6f23a5-d1aa-4516-9186-fbd3ef6ffaf7",
                        "source_entry_id": "d09eb2ea-8cf4-364c-bfd1-48004bf376d8",
                        "source_sense_id": "1d43fdc8-227d-3d8a-85e7-a1b1bb09b74f",
                        "source_sense_description": "het tijdperk van de geschiedenis vóór de middeleeuwen",
                        "target_lang_word": "Altertum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altertum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcaaa27a-569a-3119-b48f-50a8071a852a",
                                        "entry_id": "24b837c4-96bb-34f9-a244-dab53fc5dafb",
                                        "glosses": [
                                            "Epoche der Geschichtsschreibung in Eurasien, die mit der Erfindung der Schrift einsetzt und im 1. Jahrtausend nach Christus endet"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d2ea39-99b7-4db7-b8e4-341cf638caff",
                                                "sense_id": "bcaaa27a-569a-3119-b48f-50a8071a852a",
                                                "text": "Zu Beginn des Altertums entwickelten sich die ersten Hochkulturen."
                                            },
                                            {
                                                "example_id": "6ea60173-8fa8-4b9a-bb59-0c14922e6231",
                                                "sense_id": "bcaaa27a-569a-3119-b48f-50a8071a852a",
                                                "text": "„Die Polizei des Altertums ist durch die Wachsfiguren eines Caesaren und zweier Liktoren und durch einige Fascesbündel dargestellt, was herzlich albern ist, wenn es nicht eine Huldigung für die modernen Faschisten bedeuten soll.“"
                                            },
                                            {
                                                "example_id": "47f8a346-ad65-4371-b2e3-53e4ce019eb7",
                                                "sense_id": "bcaaa27a-569a-3119-b48f-50a8071a852a",
                                                "text": "„Ein kaum zu überbietendes Gekröse aus Gerüchten und religionspolitischen Wahnsinnstaten umgibt den aus einem syrischen Geschlecht stammenden Despoten, der im 3. Jahrhundert im größten Staat des Altertums die Macht an sich riss.“"
                                            },
                                            {
                                                "example_id": "c3e70b94-b03c-4427-8993-627a489f4bca",
                                                "sense_id": "bcaaa27a-569a-3119-b48f-50a8071a852a",
                                                "text": "„Die Mohnpflanze soll bereits im 6. vorchristlichen Jahrtausend in Zentralasien bekannt gewesen sein, in Europa vom Altertum an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0fac3957-5396-33f2-adff-71a278454a09",
                                        "entry_id": "24b837c4-96bb-34f9-a244-dab53fc5dafb",
                                        "glosses": [
                                            "ein aus alten Zeiten stammender Gegenstand"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b99840bf-78f6-41e3-a5a5-7d5c11236f79",
                                                "sense_id": "0fac3957-5396-33f2-adff-71a278454a09",
                                                "text": "Ich halte nicht viel von Altertümern, ich interessiere mich eher für moderne Kunst."
                                            },
                                            {
                                                "example_id": "afee0d7b-88a3-41a8-9c53-d86ad399f10b",
                                                "sense_id": "0fac3957-5396-33f2-adff-71a278454a09",
                                                "text": "„Nachdem wir eine Viertelstunde bergauf gestiegen waren, gelangten wir in die Stadt; dort verbrachte ich zwei Stunden damit, die römischen Altertümer zu besichtigen, denn die Stadt war eine wichtige Siedlung des antiken Weltreiches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a02ad6c5-9ac7-44c3-a0ce-2dfa56296cc1",
                        "source_entry_id": "d09eb2ea-8cf4-364c-bfd1-48004bf376d8",
