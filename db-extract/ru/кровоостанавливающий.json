                            {
                                "example_id": "f3d78e51-6d79-4b33-81e3-401e0cde9418",
                                "sense_id": "7ae2f7a2-b5b3-3b00-888d-d02c225d861b",
                                "text": "Это хорошее противомикробное и кровоостанавливающее средство."
                            }
                        ]
                    }
