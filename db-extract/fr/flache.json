        "fr-extract.jsonl": [
            {
                "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                "word": "flache",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c3a80124-8008-4d4c-8804-6955a82decde",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "tags": [
                            "plural"
                        ],
                        "form": "flaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a057608-eeca-3065-921c-fb1c02db3be1",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Flaque d’eau, mare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78bbb7ba-ea9a-4c11-bc01-3f2c7c9deac7",
                                "sense_id": "0a057608-eeca-3065-921c-fb1c02db3be1",
                                "text": "Les rivières étaient au plus bas. On se lavait comme on pouvait aux flaches d’eau croupie."
                            },
                            {
                                "example_id": "0c9c8059-c3b6-4d79-8410-243bf56b656d",
                                "sense_id": "0a057608-eeca-3065-921c-fb1c02db3be1",
                                "text": "Si je désire une eau d’Europe, c’est la flache\nNoire et froide où vers le crépuscule embaumé\nUn enfant accroupi plein de tristesse, lâche\nUn bateau frêle comme un papillon de mai."
                            }
                        ]
                    },
                    {
                        "sense_id": "e258392c-dd28-3b49-a95c-98fc7bca6cb5",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Endroit humide, trou d’eau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05147bff-29ec-3710-81ee-c8dc64149d38",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Endroit d’un tronc où le bois est sans écorce."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4eb19945-c4a6-3944-a075-101fa8756818",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Marque par creusement de l’écorce, suivie souvent d’un martelage, appliquée aux arbres réservés dans une coupe."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f10c3807-2458-3df7-860b-dce933fa1cf7",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Bois manquant dans l’arête d’une pièce sciée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b082cfe7-05c5-3501-81d7-1c1aea055247",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Partie latérale d’un plateau de bois avec de l’écorce et de l’aubier, que l’on élimine par délignage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab905f5c-fabd-4c1e-b2bc-c2222879a6aa",
                                "sense_id": "b082cfe7-05c5-3501-81d7-1c1aea055247",
                                "text": "Sur un bois débité, la flache est le vestige de la surface cylindrique de la grume dont ce bois provient."
                            },
                            {
                                "example_id": "0e7539a4-81d3-4a19-9dec-588c17f47604",
                                "sense_id": "b082cfe7-05c5-3501-81d7-1c1aea055247",
                                "text": "La flache ! Il aurait pu dire la flaque, merde ! Là, il y a quelque chose non pas de poseur mais de vrai casse-couilles chez Rimbaud. Tu sors de douze minutes d’hallucinations pour arriver à « si je désire une eau d’Europe, c’est la flache »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a45acadc-fb3a-3883-ac04-7efbb3485c6f",
                        "entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "glosses": [
                            "Affaissement hors rive de forme circulaire, sur une route ; nid de poule."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "note": "À l’origine cela désignait un pavé qui s’était enfoncé ou un pavé dont une partie était cassée",
                        "examples": [
                            {
                                "example_id": "712602b6-3fe6-46cf-be22-43d379a18cb1",
                                "sense_id": "a45acadc-fb3a-3883-ac04-7efbb3485c6f",
                                "text": "Il se forme alors une flache qui s’accompagne le plus souvent d’un faïençage, de remontées de fines et pouvant évoluer très rapidement vers le départ des matériaux (nid-de-poule)."
                            },
                            {
                                "example_id": "261d413a-3c69-499e-b4d2-77eca8a2b4fa",
                                "sense_id": "a45acadc-fb3a-3883-ac04-7efbb3485c6f",
                                "text": "On recouvrira la flache d’une couche de pierres cassées, de manière à rendre à cette portion de la chaussée sa forme primitive, et l’on pilonnera."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f5fecbe-e680-4238-8807-1e9195493c4d",
                        "source_entry_id": "4250cff8-1fde-33d8-885e-b5023c061b58",
                        "source_sense_id": "4eb19945-c4a6-3944-a075-101fa8756818",
                        "source_sense_description": "Bois manquant dans l’arête d’une pièce sciée",
                        "target_lang_word": "wane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36d3e52e-04f9-32f2-ad8c-1a5654a26325",
                                        "entry_id": "d15a3a1e-78c4-3c75-948a-583da3c7ed1e",
                                        "glosses": [
                                            "A gradual diminution in power, value, intensity etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c59074f-597f-4bff-a3c4-9c414542aadf",
                                                "sense_id": "36d3e52e-04f9-32f2-ad8c-1a5654a26325",
                                                "text": "1853, Herman Melville, \"Bartleby, the Scrivener,\" in Billy Budd, Sailor and Other Stories, New York: Penguin, 1968; reprinted 1995 as Bartleby, →ISBN, p. 3,\nIn the morning, one might say, his face was of a fine florid hue, but after twelve o'clock, meridian -- his dinner hour -- it blazed like a grate full of Christmas coals; and continued blazing -- but, as it were, with a gradual wane -- till six o'clock, PM, or thereabouts; after which, I saw no more of the proprietor of the face, …."
                                            },
                                            {
                                                "example_id": "657a1bba-50af-485c-85ca-a406f61d9878",
                                                "sense_id": "36d3e52e-04f9-32f2-ad8c-1a5654a26325",
                                                "text": "1913, Michael Ott, The Catholic Encyclopedia, \"Wenzel Anton Kaunitz\",\nHis influence which was on the wane during the reign of Joseph II grew still less during the reign of Leopold II (1790-2)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd9690f-657d-3890-9c85-25714402181a",
                                        "entry_id": "d15a3a1e-78c4-3c75-948a-583da3c7ed1e",
                                        "glosses": [
                                            "The lunar phase during which the sun seems to illuminate less of the moon as its sunlit area becomes progressively smaller as visible from Earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e04008-4ea2-4417-80be-52999edba8a7",
                                                "sense_id": "8cd9690f-657d-3890-9c85-25714402181a",
                                                "text": "Some French peasants also prefer to sow in the wane."
                                            },
                                            {
                                                "example_id": "bf83f231-58f7-40c3-b4e6-ad41f14a2dce",
                                                "sense_id": "8cd9690f-657d-3890-9c85-25714402181a",
                                                "text": "It was very dark, for although the sky was clear the moon was now well in the wane, and would not rise till the small hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4883b4a7-7514-3807-934d-e632bb7cbfc1",
                                        "entry_id": "d15a3a1e-78c4-3c75-948a-583da3c7ed1e",
                                        "glosses": [
                                            "The end of a period."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddc9d1ec-ed7e-48f1-8726-53009c746159",
                                                "sense_id": "4883b4a7-7514-3807-934d-e632bb7cbfc1",
                                                "text": "The day was in its prime, the day was in its wane, and still, uneasy in mind and body, she slept on."
                                            },
                                            {
                                                "example_id": "6d2b6795-922c-496b-8093-a6a4be904a73",
                                                "sense_id": "4883b4a7-7514-3807-934d-e632bb7cbfc1",
                                                "text": "The situation of the Venetian party in the wane of the eighteenth century had become extremely critical."
                                            },
                                            {
                                                "example_id": "76643ff7-a790-4389-8887-96cdb88f7ef5",
                                                "sense_id": "4883b4a7-7514-3807-934d-e632bb7cbfc1",
                                                "text": "]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb744d7e-a117-3fad-ad7b-43cc3be16196",
                                        "entry_id": "d15a3a1e-78c4-3c75-948a-583da3c7ed1e",
                                        "glosses": [
                                            "A rounded corner caused by lack of wood, often showing bark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9117877e-2b73-4a28-a3c6-d02ff103c85b",
                                                "sense_id": "fb744d7e-a117-3fad-ad7b-43cc3be16196",
                                                "text": "2002, Peter Ross, Appraisal and Repair of Timber Structures, p. 11,\nSapwood, or even bark, may appear on the corners, or may have been cut off, resulting in wane, or missing timber."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                        "entry_id": "0f4d91d8-34a6-3e31-b152-8a53a33072ed",
                                        "glosses": [
                                            "To progressively lose its splendor, value, ardor, power, intensity etc.; to decline."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bef8f90-78b4-4140-a3a0-e30c621434a0",
                                                "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                                "text": "You saw but sorrow in its waning form."
                                            },
                                            {
                                                "example_id": "46491cab-cb2e-44c1-9e58-0328131aacb7",
                                                "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                                "text": "Land and trade ever will wax and wane together."
                                            },
                                            {
                                                "example_id": "98ea4e87-6872-49c3-bee2-01499c99766d",
                                                "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                                "text": "I have sat before the dense coal fire and watched it all aglow, full of its tormented flaming life; and I have seen it wane at last, down, down, to dumbest dust."
                                            },
                                            {
                                                "example_id": "16f71bf9-5f74-4461-b6f1-6b2f72fb869d",
                                                "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                                "text": "And in the cool twilight when the sea-winds wane[…]"
                                            },
                                            {
                                                "example_id": "7e36546f-6a1e-4732-a99c-3eaae6c01894",
                                                "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                                "text": "And so it had always pleased M. Stutz to expect great things from the dark young man whom he had first seen in his early twenties ; and his expectations had waxed rather than waned on hearing the faint bruit of the love of Ivor and Virginia—for Virginia, M. Stutz thought, would bring fineness to a point in a man like Ivor Marlay, […]."
                                            },
                                            {
                                                "example_id": "761060bf-31d2-488d-a3e9-6472229278e3",
                                                "sense_id": "20d6bbb7-74d9-39bd-9b94-cfd687a5bf98",
                                                "text": "His popularity, however, has waned, say analysts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8776a3de-97ea-3eb2-b0bf-0dc16b873d38",
                                        "entry_id": "0f4d91d8-34a6-3e31-b152-8a53a33072ed",
                                        "glosses": [
                                            "For light to dim or diminish in strength."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "364577df-9951-42ee-9b94-aed186c067ca",
                                                "sense_id": "8776a3de-97ea-3eb2-b0bf-0dc16b873d38",
                                                "text": "The skies may hold not the splendour of sundown fast; / It wanes into twilight as dawn dies down into day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "323eb846-fcca-3694-a0a4-dfd1ac4646a3",
                                        "entry_id": "0f4d91d8-34a6-3e31-b152-8a53a33072ed",
                                        "glosses": [
                                            "For the Moon to pass through the phases of its monthly cycle where its surface is less and less visible."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ef2fd4-579a-4b28-80c5-d0acc46873d7",
                                                "sense_id": "323eb846-fcca-3694-a0a4-dfd1ac4646a3",
                                                "text": "The fall of Jack, and the subsequent fall of Jill, simply represent the vanishing of one moon-spot after another, as the moon wanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6232f076-2ad4-3809-bcfc-50588ec9d320",
                                        "entry_id": "0f4d91d8-34a6-3e31-b152-8a53a33072ed",
                                        "glosses": [
                                            "Said of a time period that comes to an end."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dee56eb-621f-4ffa-823c-654480dd7346",
                                                "sense_id": "6232f076-2ad4-3809-bcfc-50588ec9d320",
                                                "text": "Fast as autumn days toward winter: yet it seems//Here that autumn wanes not, here that woods and streams"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9bb1b8-a24e-3563-a320-c0bd25f5c854",
                                        "entry_id": "0f4d91d8-34a6-3e31-b152-8a53a33072ed",
                                        "glosses": [
                                            "To decrease physically in size, amount, numbers or surface."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c763bb4-806c-486a-a831-6f4e26f9db61",
                                                "sense_id": "0c9bb1b8-a24e-3563-a320-c0bd25f5c854",
                                                "text": "The snow which had been for some time waning, had given way entirely under the fresh gale of the preceding night."
                                            },
                                            {
                                                "example_id": "190647bd-c6a3-4436-aa88-c1f8c399e794",
                                                "sense_id": "0c9bb1b8-a24e-3563-a320-c0bd25f5c854",
                                                "text": "Denisovans had little genetic diversity, suggesting that their small population waned further as populations of modern humans expanded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b40c84ca-8961-3259-8f60-ca2475079622",
                                        "entry_id": "0f4d91d8-34a6-3e31-b152-8a53a33072ed",
                                        "glosses": [
                                            "To cause to decrease."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fef7e87-9a4c-42b1-beac-e39d1b9985a1",
                                                "sense_id": "b40c84ca-8961-3259-8f60-ca2475079622",
                                                "text": "In which no lustful finger can profane him,\nNor any earth with black eclipses wane him"
                                            },
                                            {
                                                "example_id": "d363f587-885a-4604-96ad-9987a63e95b8",
                                                "sense_id": "b40c84ca-8961-3259-8f60-ca2475079622",
                                                "text": "Proud once and princely was the mansion, ere a succession of spendthrifts waned away its splendour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97a13b82-55ab-31a5-a355-8082e35eb902",
                                        "entry_id": "66b780b7-4906-3850-a211-6bee302e6503",
                                        "glosses": [
                                            "A child."
                                        ],
                                        "tags": [
                                            "Scotland",
