{
    "word_family": [
        "examine",
        "examiner",
        "examinee",
        "exam"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f845167b-2b88-3bce-aaa3-fdebfcbaa82d",
                    "sense_definition": "A formal test of a person's knowledge or proficiency in a particular subject or skill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "test_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students must pass the final <w>examination</w> to complete the course.",
                            "target_lang_translations": {
                                "ru": "Студенты должны сдать выпускной <w>экзамен</w>, чтобы завершить курс.",
                                "zh": "学生必须通过期末<w>考试</w>才能完成课程。"
                            }
                        },
                        {
                            "text": "She was very nervous before sitting for her written <w>examination</w>.",
                            "target_lang_translations": {
                                "ru": "Она очень нервничала перед письменным <w>экзаменом</w>.",
                                "zh": "她在参加笔试<w>考试</w>前非常紧张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "test",
                        "exam",
                        "assessment",
                        "evaluation",
                        "appraisal"
                    ],
                    "common_phrases": [
                        "final examination",
                        "entrance examination",
                        "written examination",
                        "pass an examination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная проверка знаний или навыков человека по определенному предмету или специальности.",
                        "zh": "对某人知识或技能水平的正式测试。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экза́мен",
                                "target_lang_sense_clarification": "итоговое испытание по учебному предмету"
                            },
                            {
                                "target_lang_word": "тест",
                                "target_lang_sense_clarification": "проверочное задание, часто в виде вопросов с вариантами ответов"
                            },
                            {
                                "target_lang_word": "зачёт",
                                "target_lang_sense_clarification": "проверка знаний с оценкой «сдано» или «не сдано»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考试",
                                "target_lang_sense_clarification": "针对学业或技能的正式测试"
                            },
                            {
                                "target_lang_word": "测验",
                                "target_lang_sense_clarification": "较小规模或阶段性的测试"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91c92ab0-f790-32c4-b00c-d609d0266bc8",
                    "sense_definition": "The act of looking at or considering something very carefully in order to discover information.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inspection_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On closer <w>examination</w>, the antique vase turned out to be a fake.",
                            "target_lang_translations": {
                                "ru": "При ближайшем <w>рассмотрении</w> античная ваза оказалась подделкой.",
                                "zh": "经过仔细<w>审视</w>，这件古董花瓶原来是赝品。"
                            }
                        },
                        {
                            "text": "The proposal requires careful <w>examination</w> before we can approve it.",
                            "target_lang_translations": {
                                "ru": "Это предложение требует тщательного <w>рассмотрения</w>, прежде чем мы сможем его утвердить.",
                                "zh": "在批准之前，该提案需要经过仔细的<w>考察</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inspection",
                        "scrutiny",
                        "analysis",
                        "review",
                        "study"
                    ],
                    "common_phrases": [
                        "under examination",
                        "close examination",
                        "careful examination",
                        "detailed examination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс внимательного изучения, наблюдения или обдумывания чего-либо с целью получения информации.",
                        "zh": "为了获取信息而对某事物进行仔细观察或考虑的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассмотре́ние",
                                "target_lang_sense_clarification": "анализ предложения, идеи или документа"
                            },
                            {
                                "target_lang_word": "осмо́тр",
                                "target_lang_sense_clarification": "визуальная проверка физического объекта"
                            },
                            {
                                "target_lang_word": "иссле́дование",
                                "target_lang_sense_clarification": "глубокое научное или систематическое изучение"
                            },
                            {
                                "target_lang_word": "прове́рка",
                                "target_lang_sense_clarification": "выяснение правильности или подлинности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "审视",
                                "target_lang_sense_clarification": "仔细地观察或审查"
                            },
                            {
                                "target_lang_word": "考察",
                                "target_lang_sense_clarification": "实地观察或深入研究"
                            },
                            {
                                "target_lang_word": "检查",
                                "target_lang_sense_clarification": "为了发现问题而进行的查看"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c5a31dd-b4f5-33b4-aa17-59385a02f053",
                    "sense_definition": "A physical inspection of a person's body by a medical professional to check for illness or injury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inspection_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor performed a thorough <w>examination</w> of the patient's injured knee.",
                            "target_lang_translations": {
                                "ru": "Врач провел тщательный <w>осмотр</w> травмированного колена пациента.",
                                "zh": "医生对病人的受伤膝盖进行了彻底的<w>检查</w>。"
                            }
                        },
                        {
                            "text": "Routine medical <w>examination</w> is important for maintaining good health.",
                            "target_lang_translations": {
                                "ru": "Регулярный медицинский <w>осмотр</w> важен для поддержания хорошего здоровья.",
                                "zh": "定期的医疗<w>体检</w>对于保持健康很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "check-up",
                        "physical"
                    ],
                    "common_phrases": [
                        "medical examination",
                        "physical examination",
                        "post-mortem examination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский осмотр тела пациента врачом для выявления болезней или травм.",
                        "zh": "医疗专业人员对人体进行的身体检查，以确定是否存在疾病或损伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмо́тр",
                                "target_lang_sense_clarification": "проверка врачом состояния пациента"
                            },
                            {
                                "target_lang_word": "медосмо́тр",
                                "target_lang_sense_clarification": "плановая медицинская проверка здоровья"
                            },
                            {
                                "target_lang_word": "обсле́дование",
                                "target_lang_sense_clarification": "комплексная медицинская диагностика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "检查",
                                "target_lang_sense_clarification": "医生对身体部位的查看"
                            },
                            {
                                "target_lang_word": "体检",
                                "target_lang_sense_clarification": "常规的身体健康检查"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47fbb52e-8123-3704-9a89-4ed793448ae4",
                    "sense_definition": "The formal questioning of a witness by a lawyer in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney began his <w>examination</w> of the key witness.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты начал <w>допрос</w> главного свидетеля.",
                                "zh": "辩护律师开始对关键证人进行<w>盘问</w>。"
                            }
                        },
                        {
                            "text": "During cross-<w>examination</w>, the suspect admitted to being at the scene.",
                            "target_lang_translations": {
                                "ru": "В ходе перекрёстного <w>допроса</w> подозреваемый признался, что был на месте преступления.",
                                "zh": "在交叉<w>盘问</w>中，嫌疑人承认他当时在现场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interrogation",
                        "questioning"
                    ],
                    "common_phrases": [
                        "cross-examination",
                        "direct examination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный опрос свидетеля юристом в суде.",
                        "zh": "律师在法庭上对证人进行的正式询问。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допро́с",
                                "target_lang_sense_clarification": "юридическая процедура опроса свидетеля или обвиняемого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘问",
                                "target_lang_sense_clarification": "法庭上律师对证人的询问"
                            },
                            {
                                "target_lang_word": "询问",
                                "target_lang_sense_clarification": "正式的问话过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}