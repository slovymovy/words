                "senses": [
                    {
                        "sense_id": "3c979d47-8be2-3867-8f6b-7579ebcbbcc3",
                        "entry_id": "781ea502-d8f3-3b76-898d-09a2418a2971",
                        "glosses": [
                            "Qui montre de l’agacement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1096e9f6-10dc-4f81-99e1-ffdd772905c9",
                                "sense_id": "3c979d47-8be2-3867-8f6b-7579ebcbbcc3",
                                "text": "Paolo m'attend déjà devant les portes tournantes pour la pause-déjeuner. Il a son regard agacé des jours où je ne suis pas parfaitement à l'heure."
                            },
                            {
                                "example_id": "c5ee473e-76ed-4c29-b8b2-1851815f7ea2",
                                "sense_id": "3c979d47-8be2-3867-8f6b-7579ebcbbcc3",
                                "text": "Bouclard entreprit donc à nouveau une réflexion tranquille, encore que ronchonnante, au coin de son poêle en fonte dont les ronronnements essoufflés répondaient en écho à ses soupirs agacés."
                            }
                        ]
                    }
