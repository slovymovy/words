            {
                "entry_id": "bc6c10bb-a493-3f50-a77f-a9842b1f2602",
                "word": "soupçonneusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5160ea1a-5ed9-37d3-97f8-4ac7d0ba6c28",
                        "entry_id": "bc6c10bb-a493-3f50-a77f-a9842b1f2602",
                        "glosses": [
                            "D’une manière soupçonneuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ce98795-76b4-40b0-a76b-42e94525d36b",
                                "sense_id": "5160ea1a-5ed9-37d3-97f8-4ac7d0ba6c28",
                                "text": "— Tu n’as pas encore la machine ? demanda le Bressan, en le regardant soupçonneusement. Tu as inventé tout cela pour ne pas me rendre mes cinq mille francs…"
                            },
                            {
                                "example_id": "f623e83b-143f-4ad1-bba7-ccfb03f6d2bf",
                                "sense_id": "5160ea1a-5ed9-37d3-97f8-4ac7d0ba6c28",
                                "text": "9 juin 1940 – Elle couve ses fils du regard et observe soupçonneusement ses trois belles-filles, des intruses à qui elle n’a même pas laissé leurs prénoms."
                            },
                            {
                                "example_id": "8c1bf79d-55cd-477b-80b6-a05abbfa13e9",
                                "sense_id": "5160ea1a-5ed9-37d3-97f8-4ac7d0ba6c28",
                                "text": "J'ai trop ragé, au temps des épluchages de M. Rezeau qui, lunettes braquées sur le bout de son grand nez de presbyte, examinait soupçonneusement tout, au départ comme à l'arrivée, et passait la lettre à Madame pour révision complémentaire."
                            }
                        ]
                    }
