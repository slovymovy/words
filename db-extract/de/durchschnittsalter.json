                "senses": [
                    {
                        "sense_id": "73f0e032-42ef-362f-8b43-0ba534a45743",
                        "entry_id": "ad2a86a2-d3a9-30bf-8965-0127b6dbb117",
                        "glosses": [
                            "Wert, der das durchschnittliche Alter einer Gruppe angibt"
                        ],
                        "tags": [
                            "Demografie"
                        ],
                        "examples": [
                            {
                                "example_id": "5afd52ca-8baf-485a-80df-78b9895d4f90",
                                "sense_id": "73f0e032-42ef-362f-8b43-0ba534a45743",
                                "text": "„Ein Kernproblem der Berliner Lehrerschaft lässt sich jedoch nicht lösen: Die Kollegien sind überaltert, das Durchschnittsalter liegt bei über 50 Jahren.“"
                            },
                            {
                                "example_id": "e0b6d56f-7eb3-4fe2-8bc0-75fbf1987d17",
                                "sense_id": "73f0e032-42ef-362f-8b43-0ba534a45743",
                                "text": "„Steckte man die Autoren dieses Buches sofort ins Altersheim, würde man das Durchschnittsalter der Heimbewohner und das Durchschnittsalter der Universität Hamburg vermindern.“"
                            },
                            {
                                "example_id": "1124889b-c5e0-4929-9f2b-3047ed139d34",
                                "sense_id": "73f0e032-42ef-362f-8b43-0ba534a45743",
                                "text": "[Deutschland:] „Das Durchschnittsalter der Bäume liegt bei 83 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
