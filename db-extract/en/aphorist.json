                    },
                    {
                        "translation_id": "9a9c46b7-c7ea-48d5-996a-bdaf89368d69",
                        "source_entry_id": "49afe978-d716-3a43-9962-f55b2161151a",
                        "source_sense_id": "05e40930-b929-3ad9-a7f1-5c6d7f8cd9f5",
                        "source_sense_description": "person who writes or recites aphorisms",
                        "target_lang_word": "Aphoristiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aphoristiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efb1c626-1087-31aa-90fd-c9acaab988bf",
                                        "entry_id": "ed55c268-ae81-316a-8621-12120235aaf0",
                                        "glosses": [
                                            "eine Person, die Aphorismen verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d661e8-1d36-48c6-a0a2-fe3e64bb0c02",
                                                "sense_id": "efb1c626-1087-31aa-90fd-c9acaab988bf",
                                                "text": "„Ein Mann, der nach einem großen Ziele strebt, muß gleichsam die Zügel aller seiner geistigen Triebe in der Hand haben. Er darf nicht wie der Lyriker oder der Aphoristiker sich jeder Aufwallung, jedem Impulse hingeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51b490c1-4850-40e3-9cda-b6fff5492571",
                        "source_entry_id": "49afe978-d716-3a43-9962-f55b2161151a",
                        "source_sense_id": "05e40930-b929-3ad9-a7f1-5c6d7f8cd9f5",
                        "source_sense_description": "person who writes or recites aphorisms",
                        "target_lang_word": "Aphoristikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aphoristikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fffaabad-6f3e-3047-a79f-7abcb10f619c",
                                        "entry_id": "5e50a515-1ede-30c9-98a5-a9bc9f9a92e3",
                                        "glosses": [
                                            "eine Frau, die Aphorismen verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a319cf8f-fc87-45e4-9758-eefeb45673db",
                                                "sense_id": "fffaabad-6f3e-3047-a79f-7abcb10f619c",
                                                "text": "„Irgendwann geht es mehr darum, ob die Sprüche gut oder schlecht sind, als darum, ob von einem Aphoristiker oder einer Aphoristikerin.“"
                                            }
                                        ],
