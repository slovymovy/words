                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b84373a-a7ad-4df0-b5e4-c5c3d5cd86bf",
                                "sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                                "text": "Travel is enlivened not only by the mixed company of French, Berbers, Arabs, and descendants of the Mediterranean-Corsairs who sit together indiscriminately, but also by itinerant vendors of macaroons, sweetmeats and the like, who, as long as they have a travel ticket, ply their wares unhindered by the [ticket] collectors."
                            },
                            {
                                "example_id": "5c77a297-7718-41f9-aaa3-c9561f5fac00",
                                "sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                                "text": "It was a very private thing, they felt, and not to be tossed indiscriminately about."
                            }
                        ]
                    }
