                "senses": [
                    {
                        "sense_id": "97d238a0-b248-3066-991d-110392e607dc",
                        "entry_id": "4687675d-fc19-3ee7-a8b1-5f4e211e2b9a",
                        "glosses": [
                            "rura odprowadzająca na zewnątrz spaliny zbierane z rur wydechowych poszczególnych cylindrów tłokowego silnika spalinowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3c6f4b-d37e-4d30-b836-9900506c94e9",
                                "sense_id": "97d238a0-b248-3066-991d-110392e607dc",
                                "text": "Kolektor zbiera gazy wydechowe do jednej rury."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b5a423cc-1dac-374b-ad0d-4d2aa25b81a3",
                        "entry_id": "4687675d-fc19-3ee7-a8b1-5f4e211e2b9a",
                        "glosses": [
                            "przewód lub kanał zbiorczy służący do przepływu cieczy albo gazów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0ac5b367-6d77-3614-bf1c-3819bb3803c4",
                        "entry_id": "4687675d-fc19-3ee7-a8b1-5f4e211e2b9a",
                        "glosses": [
                            "kolektor słoneczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb93fdc-e22d-465a-9529-8d1bb2aaea8b",
                                "sense_id": "0ac5b367-6d77-3614-bf1c-3819bb3803c4",
                                "text": "Niektórzy wykorzystują kolektory słoneczne do ogrzewania swoich domów."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "d0c47cbe-9d25-303a-b7e7-8620dd359f70",
                        "entry_id": "4687675d-fc19-3ee7-a8b1-5f4e211e2b9a",
                        "glosses": [
                            "nośnik"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "a9854a50-2d9a-3623-ba8c-7453562d0e52",
                        "entry_id": "4687675d-fc19-3ee7-a8b1-5f4e211e2b9a",
                        "glosses": [
                            "skała z pokładami ropy naftowej lub gazu ziemnego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "7886f535-c75e-3a46-bb88-3cf1e7c295b0",
