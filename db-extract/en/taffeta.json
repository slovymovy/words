                                                "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                                "text": "Sie trug ein Kleid aus schwarzem Taft."
                                            },
                                            {
                                                "example_id": "3fe9bda2-efa0-4d0a-bd1b-5e27ec3ce1af",
                                                "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                                "text": "„C. C. trug nur ein kurzes Mieder aus Taft und einen Rock aus dem gleichen Stoff; das war alles, was sie anhatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
