                                    {
                                        "sense_id": "81f28880-281c-39f1-9996-b486992c383e",
                                        "entry_id": "c481edcd-ed23-3df8-9daa-0873adb7522c",
                                        "glosses": [
                                            "To produce a beep sound."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b37d04d-b381-475a-860b-a3c914a61898",
                                                "sense_id": "81f28880-281c-39f1-9996-b486992c383e",
                                                "text": "The motorists in the traffic jam were getting more and more frustrated and started beeping their horns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef6d4fcf-9c92-3a6b-84e9-ff598f1012fe",
                                        "entry_id": "c481edcd-ed23-3df8-9daa-0873adb7522c",
                                        "glosses": [
                                            "To have sexual intercourse with (someone), referring to the bleep tone used to censor obscene words in broadcasts."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f4cacd-1b9e-400f-9846-e73a16a1f752",
                                                "sense_id": "ef6d4fcf-9c92-3a6b-84e9-ff598f1012fe",
                                                "text": "Jason beeped Sharlene after they had drunk a few beers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cfdfa23-4cb9-3c9e-8b79-475ed24c1604",
                                        "entry_id": "c481edcd-ed23-3df8-9daa-0873adb7522c",
                                        "glosses": [
                                            "To contact (someone) via a pager device."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c7a8bd-4a9d-44d4-a322-c21bca27ea49",
                                                "sense_id": "1cfdfa23-4cb9-3c9e-8b79-475ed24c1604",
                                                "text": "Burkat told him on the evening of Sunday, July 1, that Kritch “would have to terminate Mr. Waugaman on Monday when he came in, for not answering the beeper.” […] However, when considered in light of[…] Justak’s assertion in Waugaman’s termination notice that Respondent had unsuccessfully tried to “beep” him at 6 p.m.[…]"
                                            },
                                            {
                                                "example_id": "60346539-b236-4559-825d-3809fe481d83",
                                                "sense_id": "1cfdfa23-4cb9-3c9e-8b79-475ed24c1604",
                                                "text": "His first notion was to call her on her mobile phone device. After all, she had neither called nor beeped him to tell him any plans in advance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576f50b3-4083-324b-a5f1-223fcc2cb5b0",
                                        "entry_id": "c481edcd-ed23-3df8-9daa-0873adb7522c",
                                        "glosses": [
                                            "To telephone a person, only allowing the phone to ring once, in order to request a call back."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd48eb56-eb21-421b-83e6-06a531b81748",
                                                "sense_id": "576f50b3-4083-324b-a5f1-223fcc2cb5b0",
                                                "text": "Susan beeped Jessica, and then Jessica called her back, because Susan didn't have enough credit on her phone to make the call."
                                            },
                                            {
                                                "example_id": "fb08877e-b2ba-498d-a92c-b489ec86bfe3",
                                                "sense_id": "576f50b3-4083-324b-a5f1-223fcc2cb5b0",
                                                "text": "He should have been here at two-fifteen the way he drove. I beeped him, but he didn't ring back."
                                            }
                                        ]
                                    }
                                ]
                            },
