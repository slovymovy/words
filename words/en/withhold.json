{
    "word_family": [
        "withholder",
        "withholding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "081996f3-053b-3770-9813-203269f0fd71",
                    "sense_definition": "To keep information, permission, or support to oneself rather than revealing or granting it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "withhold_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness decided to <w>withhold</w> vital information from the police during the initial investigation."
                        },
                        {
                            "text": "The committee chose to <w>withhold</w> consent until they received a detailed budget proposal."
                        }
                    ],
                    "antonyms": [
                        "disclose",
                        "reveal",
                        "grant"
                    ],
                    "common_phrases": [
                        "withhold vital information",
                        "withhold consent",
                        "withhold permission"
                    ]
                },
                {
                    "sense_id": "82af514d-6bff-3e75-b3b2-ea0cd2b2a3d0",
                    "sense_definition": "To keep a physical object or money to oneself instead of giving it back or delivering it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "withhold_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank decided to <w>withhold</w> payment until the identity of the account holder could be verified."
                        },
                        {
                            "text": "The landlord cannot legally <w>withhold</w> the deposit without providing a valid reason."
                        }
                    ],
                    "synonyms": [
                        "retain"
                    ],
                    "antonyms": [
                        "release",
                        "return"
                    ],
                    "common_phrases": [
                        "withhold payment",
                        "withhold taxes"
                    ]
                },
                {
                    "sense_id": "677a8273-1fe6-316d-8614-71b811361ad0",
                    "sense_definition": "To refrain or hold oneself back from doing something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "withhold_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>withhold</w> from making any comments until I have read the full report."
                        },
                        {
                            "text": "She had to <w>withhold</w> from laughing during the serious business meeting."
                        }
                    ],
                    "synonyms": [
                        "retain"
                    ],
                    "antonyms": [
                        "indulge"
                    ],
                    "common_phrases": [
                        "withhold from comment"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6a820ad-0a1c-3091-af0d-d46ce41f1fc0",
                    "sense_definition": "An undisclosed bad deed or moral transgression that is kept secret from others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientology_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In their counseling sessions, they were encouraged to confess every <w>withhold</w> to restore trust."
                        },
                        {
                            "text": "He believed that keeping a <w>withhold</w> from his partner was damaging their relationship."
                        }
                    ],
                    "antonyms": [
                        "confession"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily within Scientology context"
                        }
                    ]
                }
            ]
        }
    ]
}