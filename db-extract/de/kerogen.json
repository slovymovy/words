                ],
                "senses": [
                    {
                        "sense_id": "5875a421-8dda-36e7-967e-34415e1ead8e",
                        "entry_id": "3e743e8d-4389-35b5-95ca-af5e163c8ed1",
                        "glosses": [
                            "unlösliche, teilweise wachsartige, in Sedimenten vorliegende organische Substanz"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "3d10c28f-39d3-476e-a2a5-f15d8ae057af",
                                "sense_id": "5875a421-8dda-36e7-967e-34415e1ead8e",
                                "text": "Kerogen ist die häufigste Form von organischen Kohlenstoffen in der Erdkruste."
                            },
                            {
                                "example_id": "c2a8746d-6acb-4a27-ae87-6fa8b21c7031",
                                "sense_id": "5875a421-8dda-36e7-967e-34415e1ead8e",
                                "text": "Gelangt das von den Bakterien allmählich gebildete Kerogen tiefer in das Erdinnere, wird zunächst das enthaltene Wasser herausgepresst."
                            },
                            {
                                "example_id": "aef19d19-3eb1-4676-bfa9-807f9dbd7d25",
                                "sense_id": "5875a421-8dda-36e7-967e-34415e1ead8e",
                                "text": "Wenn Temperaturen um 100 °C oder mehr herrschen und durch darüber liegende Sedimentschichten größerer Druck aus das Kerogen ausgeübt wird, setzen Stoffumwandlungsprozesse ein, aus denen einerseits erdöl entsteht, die andererseuts aber auch Erdgas freisetzen."
                            },
                            {
                                "example_id": "6cf8999e-191f-4699-944d-80e16f4890b7",
                                "sense_id": "5875a421-8dda-36e7-967e-34415e1ead8e",
                                "text": "Der größte Teil des Kohlenstoffs auf der Erde ist aber nicht in den fossilen Brennstoffen gebunden, sondern im Kalkstein (CaCO₃) und als Kerogen im Schiefer."
                            },
                            {
                                "example_id": "ffe5c3c9-3e44-4594-8207-2b68b2152238",
                                "sense_id": "5875a421-8dda-36e7-967e-34415e1ead8e",
                                "text": "Leider macht der Anteil des Kerogens selten mehr als ein Prozent des Sediments aus, so daß pro Tonne Kerogen 100 Tonnen Gestein abzubauen und 99 Tonnen Asche zu entsorgen wären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
