                    {
                        "sense_id": "c97e4bd0-821e-3d2b-8560-e7319a4ef43f",
                        "entry_id": "9f05b24a-bfd9-3960-98d7-5878baf97634",
                        "glosses": [
                            "Ökosystem, das zum Zweck der landwirtschaftlichen Nutzung geschaffen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eeca192-db30-48e7-b604-ca85e48d7e1f",
                                "sense_id": "c97e4bd0-821e-3d2b-8560-e7319a4ef43f",
                                "text": "„In einem Agrarökosystem wird allerdings nicht das gesamte Nitrat durch den Prozeß der Denitrifizierung in Luftstickstoff umgesetzt.“"
                            },
                            {
                                "example_id": "2c5ef50c-36c6-4895-b49b-dd707e992d1f",
                                "sense_id": "c97e4bd0-821e-3d2b-8560-e7319a4ef43f",
                                "text": "„Agrarökosysteme sind Landschaften, die vom Menschen urbar gemacht wurden, um Ackerbau und Viehzucht zu betreiben“"
                            }
                        ],
                        "sense_index_json": "\"1\""
