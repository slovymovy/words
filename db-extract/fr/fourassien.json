                        "glosses": [
                            "Relatif à Fouras (commune française de Charente-Maritime)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b28faf-df5b-4454-add2-253a5a272414",
                                "sense_id": "2e8c6ae9-48af-3b4d-884d-df0ac2885e7c",
                                "text": "Il s’était couché, fier d’avoir tenu tête aux polytechniciens sur des questions d’histoire et de géo, lui dont les seuls diplômes se résumaient au certif et au prix de solfège de l’école de musique fourassienne."
                            },
                            {
                                "example_id": "afa60c88-e2d4-4e0d-adb8-960f4a507417",
                                "sense_id": "2e8c6ae9-48af-3b4d-884d-df0ac2885e7c",
                                "text": "Gérard Allemandou a fait connaître aux Parisiens la chaudrée fourassienne, que seuls les lecteurs de Georges Simenon connaissaient."
                            },
                            {
                                "example_id": "2eac6ac2-4dcd-4875-a58c-8c2cab6c97b1",
                                "sense_id": "2e8c6ae9-48af-3b4d-884d-df0ac2885e7c",
                                "text": "Mêlée, dégagement fourassien, touche, lancer perdu et placage haut, arbitre bras levé jusqu’à l’essai 60 mètres plus loin, à la 20ème."
                            },
                            {
                                "example_id": "2dce0658-745e-43e7-a407-21cf2be1595c",
                                "sense_id": "2e8c6ae9-48af-3b4d-884d-df0ac2885e7c",
                                "text": "Week-end fourassien pour les Vieux volants."
                            }
                        ]
                    }
