                ],
                "senses": [
                    {
                        "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                        "entry_id": "1c43bcfd-e9a0-33f6-b62e-fef04a102a9b",
                        "glosses": [
                            "To announce in advance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d02b73cd-9174-465f-a623-6647d4f18834",
                                "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                                "text": "The company preannounced the impending takeover."
                            },
                            {
                                "example_id": "fd4b177e-a044-4b1a-a748-bc0b67cf615c",
                                "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                                "text": "Those responsible for preannouncing the Internet's hot new ideas are pushing Push with a ferocious unanimity."
                            },
                            {
                                "example_id": "9c38e1a4-19c9-48d4-b2da-c738368f0a7f",
                                "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                                "text": "No one can remember, for example, the last time Alcoa preannounced their earnings."
                            },
                            {
                                "example_id": "ef30a06b-90e8-494c-946f-56a580421b54",
                                "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                                "text": "The decision to preannounce an unproven technology was an uncharacteristic one for Intel, said G. Dan Hutcheson, president of VLSI Research Inc., and a longtime observer of the company."
                            },
                            {
                                "example_id": "e65601a4-8caa-44d6-8920-f7df18e90650",
                                "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                                "text": "In other words, the transaction is preferred because it is the best of bad choices. And at least one study has found that when management preannounces a deal it results in lower premiums presumably because it scares off other bidders."
                            },
                            {
                                "example_id": "db05ab2d-643b-4a13-a364-737ffb5421bd",
                                "sense_id": "d7be6e5a-16aa-3055-a1f4-5aa174f20877",
                                "text": "Some would say that Microsoft engaged in a subtle form of vaporware by preannouncing its product before it was actually ready to be delivered, then, at the last minute, announcing a short delay."
                            }
                        ]
                    }
                ],
