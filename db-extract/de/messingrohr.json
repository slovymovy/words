                        "examples": [
                            {
                                "example_id": "6828180a-0378-482a-bf1b-c970ddfef449",
                                "sense_id": "c15d2ff4-215d-39a0-8b65-ef19378305a5",
                                "text": "„Viele Tin Whistles bestehen aus einem Messingrohr und einem Kunststoffmundstück.“"
                            },
                            {
                                "example_id": "5f72cbdd-a798-40c8-8f7d-dd8ef29cf2bf",
                                "sense_id": "c15d2ff4-215d-39a0-8b65-ef19378305a5",
                                "text": "„Nun den Pluspol der LED kürzen und die zweite Litze anlöten durch das Messingrohr führen.“"
                            },
                            {
                                "example_id": "6138d84b-2970-44f9-aaba-392585167164",
                                "sense_id": "c15d2ff4-215d-39a0-8b65-ef19378305a5",
                                "text": "„Hierzu verwendete ich auch eine Pinzette, mit der ich den Draht von einer Seite fest an das Messingrohr drückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
