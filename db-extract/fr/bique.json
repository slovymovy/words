                "senses": [
                    {
                        "sense_id": "10f042b3-fa36-3651-a91c-edbf0a17ddda",
                        "entry_id": "097124ce-42c9-3501-b64b-6d1cba49f16d",
                        "glosses": [
                            "Personne d’origine maghrébine."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "8dabb0c5-b73c-4f25-9a0d-be0f06014582",
                                "sense_id": "10f042b3-fa36-3651-a91c-edbf0a17ddda",
                                "text": "– Jamais un plombier ne m’a appelé par mon nom. Quand ils parlent de moi entre eux ils disent « T’as vu la bique ? » ou « Le melon, il est en bas ? » ou encore « Va me chercher Boumédiène »."
                            }
                        ]
                    }
