                "senses": [
                    {
                        "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                        "entry_id": "abdd2801-1570-3fd1-82fd-47d7abc369f2",
                        "glosses": [
                            "time switch, timer"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "4d3edf4c-efab-4727-9abd-d1e49a1dac2d",
                                "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                                "text": "Wenn ihr in einer gewöhnlichen schlechten Wanduhr das Weiserwerk oder, wie wir es schon oft genant haben, das Vorgelege oder die Minuterie untersuchet: [...]"
                            },
                            {
                                "example_id": "ef40d684-1e44-45f8-ad93-edf5b13c5072",
                                "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                                "text": "Die Minuterie oder das Vorgelege, denn also heißt auch dieses Weiserwerk, könnte auch anders [...].",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "ef515fc1-ea6a-412a-a007-bec23276f8cf",
                                "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                                "text": "1865, Neuer Schauplatz der Künste und Handwerke, Vollständiges Handbuch der Uhrmacherkunst, volume 171, edition 4, page 466",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "ebf481a5-8a09-467d-b602-3f747b47b460",
                                "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                                "text": "Diese elektrische Wanduhr freut mich deshalb, weil sie eine der deutlichsten Wanduhren ist, der große Zeiger präzis die Minuterie mit ihrer Zahleneinteilung zeigt und der Stundenzeiger in den Raum der Stundenzahl weist."
                            },
                            {
                                "example_id": "26246262-faac-4502-9ee8-e72dadf574c1",
                                "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                                "text": "Die große Fliegeruhr existiert übrigens auch in klassischer Ausführung, sie besitzt zwar das Kontrastzifferblatt, aber den üblichen Stundenzahlenkranz und die Minuterie in Form der sogenannten Eisenbahnspur und Zeiger, [...]"
                            },
                            {
                                "example_id": "e9f73afd-cd5f-47e5-865e-e08331930f30",
                                "sense_id": "64485cb4-c0d0-3919-8c87-8b2ef5c7e6aa",
                                "text": "Schließlich werde das Design des Zifferblattes dadurch beeinträchtigt, daß der optronische Sensor innerhalb der Minuterie und damit gestalterisch recht auffällig in das Zifferblatt eingebaut werden müsse, damit er auch von Zeigern unterschiedlicher Länge überstrichen werden könne [...]"
                            }
                        ]
                    },
