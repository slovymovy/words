                        "entry_id": "8b9d030c-ed29-39c9-87b3-f6e673fbff4e",
                        "glosses": [
                            "Characterized or marked by meddling; inclined or having a tendency to meddle or interfere in other people's business."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3338e9a-d22a-4324-bee8-35580bf69c2d",
                                "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                "text": "As this was well before the meddlesome days in which we now live, can Mr. Cox explain why this plan was never carried out?"
                            },
                            {
                                "example_id": "4740df2e-43e4-4c3d-9bc5-125ee24e50df",
                                "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                "text": "The help tended to be officious, the rules, if heeded, restrictive, and the management meddlesome."
                            },
                            {
                                "example_id": "7b20dc39-5971-45d5-a33c-bcda79d54d68",
                                "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                "text": "If those meddlesome kids hadn't turned me in, I'd have gotten away with my nefarious scheme!"
                            }
                        ]
                    }
                ],
