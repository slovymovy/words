                    },
                    {
                        "sense_id": "3f215ccc-18b9-3291-b5fb-25c30dff0a6c",
                        "entry_id": "8b59db71-d9e5-3f77-9bb5-9b0d5dfa4e59",
                        "glosses": [
                            "Footsy (flirting game where two people touch their feet together)."
