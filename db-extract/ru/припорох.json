                "senses": [
                    {
                        "sense_id": "aa87cdfa-dbf0-3d28-ac48-55e039fd2ef5",
                        "entry_id": "2dc59344-2308-3961-abe0-dd665f21a4eb",
                        "glosses": [
                            "спец. у маляров и живописцев: трафарет, узор или рисунок с проколотыми контурами для перевода изображения на бумагу, полотно и т. п. путём набивания через эти проколы красящего порошка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777a4110-2716-456f-b903-256cb77984a9",
                                "sense_id": "aa87cdfa-dbf0-3d28-ac48-55e039fd2ef5",
                                "text": "На следующий же день я зашёл в Большой театр и познакомился с его [моего нового знакомого] хозяином. Расхвалил безмерно его припорохи и потолочные чертежи собственной его композиции, чем и положил прочный фундамент нашему знакомству."
                            }
                        ]
                    },
                    {
                        "sense_id": "1337ffe4-973d-3107-92d0-51f7a49ae64f",
                        "entry_id": "2dc59344-2308-3961-abe0-dd665f21a4eb",
                        "glosses": [
                            "способ такого перевода узора, рисунка"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "892ed792-f263-4a17-93d8-37afc55c9ce5",
                        "source_entry_id": "2dc59344-2308-3961-abe0-dd665f21a4eb",
                        "source_sense_description": "трафарет, узор или рисунок с проколотыми контурами",
                        "target_lang_word": "pounce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pounce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b61be41e-ee02-3f26-a1b3-5446af67f314",
                                        "entry_id": "0bf93aa2-5118-3ce4-8b8a-39089145c2f0",
                                        "glosses": [
                                            "A type of fine powder, as of sandarac, or cuttlefish bone, sprinkled over wet ink to dry the ink after writing or on rough paper to smooth the writing surface."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab31e4fd-04e1-4fa8-a344-d55c484e2a56",
                                                "sense_id": "b61be41e-ee02-3f26-a1b3-5446af67f314",
                                                "text": "At the Thorn, or at a meagre kitchen table, or even on the carpenter’s workbench, he spreads open the portfolio, lights a candle stub, slices a fresh quill, and arranges pounce pot and ink well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce6941a8-c9bb-3221-ab11-2231892e6a4e",
                                        "entry_id": "0bf93aa2-5118-3ce4-8b8a-39089145c2f0",
                                        "glosses": [
                                            "Charcoal dust, or some other coloured powder for making patterns through perforated designs, used by embroiderers, lacemakers, etc."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pounce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89dc487d-7ce0-30b1-a844-29c6edc9e13f",
                                        "entry_id": "77fa4e11-70d1-396e-aded-5dea0ded43d5",
                                        "glosses": [
                                            "To sprinkle or rub with pounce powder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5fc4130-2158-4b5b-bb61-91e63502d9b4",
                                                "sense_id": "89dc487d-7ce0-30b1-a844-29c6edc9e13f",
                                                "text": "to pounce paper, or a pattern"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pounce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82376562-3a83-390b-a5da-5d59888f4fa0",
                                        "entry_id": "f412570b-7878-341c-991c-280dc2e26a2e",
                                        "glosses": [
                                            "A sudden leaping attack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a06bb80-30e4-47ff-b5d6-543187ac2147",
                                                "sense_id": "82376562-3a83-390b-a5da-5d59888f4fa0",
                                                "text": "Again the cat jolted the bed with a pounce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "949f69c1-c811-3c73-b713-f7fbfa0bbe76",
                                        "entry_id": "f412570b-7878-341c-991c-280dc2e26a2e",
                                        "glosses": [
                                            "The claw or talon of a bird of prey."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14e76ed9-fe1e-49eb-82ce-80d854ae79a7",
                                                "sense_id": "949f69c1-c811-3c73-b713-f7fbfa0bbe76",
                                                "text": "March 22 1775, Edmund Burke, speech in the House of Commons on conciliation with America\nYou have , indeed , winged ministers of vengeance, who carry your bolts in their pounces to the remotest verge of the sea"
                                            },
                                            {
                                                "example_id": "5c728b5e-5add-4f90-9c46-184940234335",
                                                "sense_id": "949f69c1-c811-3c73-b713-f7fbfa0bbe76",
                                                "text": "And from her griping pounce the greedy prey doth quarry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e2db50-8768-3dd7-b398-60ccd2f563a9",
                                        "entry_id": "f412570b-7878-341c-991c-280dc2e26a2e",
                                        "glosses": [
                                            "A punch or stamp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fc717e-66f3-4737-8338-ee0bb3312387",
                                                "sense_id": "81e2db50-8768-3dd7-b398-60ccd2f563a9",
                                                "text": "a pounce to print money with"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542daf33-5639-37e5-b037-9b22897382c9",
                                        "entry_id": "f412570b-7878-341c-991c-280dc2e26a2e",
                                        "glosses": [
                                            "Cloth worked in eyelet holes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f994806-5221-4eef-8a41-4fab44940053",
                                                "sense_id": "542daf33-5639-37e5-b037-9b22897382c9",
                                                "text": "one spendeth his patrimony upon pounces and cuts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20cbc15c-e75e-34a3-b6fa-167c3c6e5e0b",
                                        "entry_id": "f412570b-7878-341c-991c-280dc2e26a2e",
                                        "glosses": [
                                            "Synonym of bump (“sudden movement of underground strata”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pounce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72f44920-ba3f-3cef-ab6e-602df3f3326f",
                                        "entry_id": "721b4a3f-964d-330f-ac84-dcf4a09bf645",
                                        "glosses": [
                                            "To leap into the air intending to seize someone or something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a365f08c-cf27-4456-b5fc-f63abe4e5f80",
                                                "sense_id": "72f44920-ba3f-3cef-ab6e-602df3f3326f",
                                                "text": "The kitten pounced at the ball I threw to it."
                                            },
                                            {
                                                "example_id": "43452e91-50a3-46b6-87cc-81a21c5b258e",
                                                "sense_id": "72f44920-ba3f-3cef-ab6e-602df3f3326f",
                                                "text": "She pounced on the young man, because she loved him and wanted him for herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c75ec02f-8478-39dd-841b-65f668ab11f8",
                                        "entry_id": "721b4a3f-964d-330f-ac84-dcf4a09bf645",
                                        "glosses": [
                                            "To attack suddenly by leaping."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3175804f-edc5-4263-ae3d-a25c39a7ee12",
                                                "sense_id": "c75ec02f-8478-39dd-841b-65f668ab11f8",
                                                "text": "I was awakened from a dead sleep by my child pouncing on top of me from out of nowhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "799da014-3451-318b-a02c-8124c8e7b55a",
                                        "entry_id": "721b4a3f-964d-330f-ac84-dcf4a09bf645",
                                        "glosses": [
                                            "To eagerly seize an opportunity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b272c3c-b4de-4b80-b489-4496d43370db",
                                                "sense_id": "799da014-3451-318b-a02c-8124c8e7b55a",
                                                "text": "I pounced on the chance to get promoted."
                                            },
                                            {
                                                "example_id": "7aaa9885-2b26-4fbe-8c7d-f175faa05f4b",
                                                "sense_id": "799da014-3451-318b-a02c-8124c8e7b55a",
                                                "text": "While he was out of town on vacation, I pounced, leaking the photos."
                                            },
                                            {
                                                "example_id": "70367bce-e4b4-49d5-b1ca-e298a867d575",
                                                "sense_id": "799da014-3451-318b-a02c-8124c8e7b55a",
                                                "text": "Why would I talk to the press and give them a chance to pounce on me?"
                                            },
                                            {
                                                "example_id": "e0a81faf-9a77-466d-8d73-68ed3d9f540f",
                                                "sense_id": "799da014-3451-318b-a02c-8124c8e7b55a",
                                                "text": "Irish debutant Conor Henderson - another ball-playing midfielder - probed for a gap through the back-line and the 19-year-old's deflected pass was pounced on by Tomas Rosicky, who sped to the byeline to clip a square ball through the legs of Charlie Daniels across the box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d90b0c7-f9a5-330e-9ce1-bbdf859b8c80",
                                        "entry_id": "721b4a3f-964d-330f-ac84-dcf4a09bf645",
                                        "glosses": [
                                            "To strike or seize with the talons; to pierce, as with the talons."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe22672-2b9c-4a8c-9b39-df4a1209907f",
                                                "sense_id": "9d90b0c7-f9a5-330e-9ce1-bbdf859b8c80",
                                                "text": "Stooped from his highest pitch to pounce a wren."
                                            },
                                            {
                                                "example_id": "e78c82f5-4c59-4978-bd2e-8f781e2d1b62",
                                                "sense_id": "9d90b0c7-f9a5-330e-9ce1-bbdf859b8c80",
                                                "text": "Now pounce him lightly, / And as he roars and rages, let's go deeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c98f1f-dfb7-3922-8789-a2f1fad1c365",
                                        "entry_id": "721b4a3f-964d-330f-ac84-dcf4a09bf645",
                                        "glosses": [
                                            "To stamp holes in; to perforate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
