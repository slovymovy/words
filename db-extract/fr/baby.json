                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca5b880-616b-4e62-8f93-ec3862da17f6",
                                                "sense_id": "e5541e20-54cb-3d55-9da3-b9863bb12167",
                                                "text": "Rolling up cannabis sativa, hitting the Mary Jane"
                                            },
                                            {
                                                "example_id": "ee404d9e-2f22-4711-b26e-4e197047abf0",
                                                "sense_id": "e5541e20-54cb-3d55-9da3-b9863bb12167",
                                                "text": "Mary Jane, you're always in my brain, and you help me ease the pain."
                                            },
                                            {
                                                "example_id": "fa0fc096-2d8c-46f4-a926-2f7966cb5301",
                                                "sense_id": "e5541e20-54cb-3d55-9da3-b9863bb12167",
                                                "text": "When the stress burns my brain just like acid raindrops / Mary Jane is the only thing that makes the pain stop"
                                            },
                                            {
                                                "example_id": "803b4eda-0dd6-4669-9fe2-8dd8dd94b10f",
                                                "sense_id": "e5541e20-54cb-3d55-9da3-b9863bb12167",
                                                "text": "In love with Mary Jane, she's my main thing"
                                            },
                                            {
                                                "example_id": "b12fb13b-2ddb-4dfc-ba6b-2bf6df6c18ce",
                                                "sense_id": "e5541e20-54cb-3d55-9da3-b9863bb12167",
                                                "text": "Mary Jane, since I have met you, girl, you've ruined my brain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mary Jane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07b984fb-542f-353c-b1a1-7fcba63c497f",
