                ],
                "senses": [
                    {
                        "sense_id": "285f3514-c250-3228-a618-216a2d59a322",
                        "entry_id": "12dde425-fccd-33b4-b4de-f8e6210e02e9",
                        "glosses": [
                            "Gegenstand, der beim Laufen/Joggen verwendet wird und üblicherweise nicht zur Kleidung zählt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "9a3a6f2d-9d1b-4ef0-b27f-a42f5380a904",
                                "sense_id": "285f3514-c250-3228-a618-216a2d59a322",
                                "text": "„Hier sind meine unverzichtbaren Laufaccessoires, von denen Sie nicht wussten, dass Sie sie brauchen.“"
                            },
                            {
                                "example_id": "84b2cf67-748d-456f-a83f-6f3cf8248f78",
                                "sense_id": "285f3514-c250-3228-a618-216a2d59a322",
                                "text": "„Wenn mich die Lauflust droht zu verlassen, kaufe (oder bestelle) ich mir ein neues Laufaccessoire und die Freude darauf das einzusetzen, bringt mich ganz schnell wieder in die Schuhe.;-)“"
                            },
                            {
                                "example_id": "b059886b-7fa2-4754-b246-586169be36cf",
                                "sense_id": "285f3514-c250-3228-a618-216a2d59a322",
                                "text": "„Als modische Laufaccessoires bringen die NEO4 und NEO6R farbliche Akzente in Grün, Blau, Pink oder Schwarz mit.“"
                            },
                            {
                                "example_id": "82f84446-d821-4908-ae5a-a80bf70bdccf",
                                "sense_id": "285f3514-c250-3228-a618-216a2d59a322",
                                "text": "„Klar, eigentlich brauchen wir keine Ausrede zum Shoppen, doch so ein Halbmarathon liefert die perfekte Grundlage unsere Laufaccessoires zu updaten: von der Regenjacke über die Laufschuhe bis hin zum Buff-Tuch, ein neues Teil steigert schließlich auch die Motivation!“"
                            },
                            {
                                "example_id": "c7966bf3-c004-4b3f-b1dd-006cc3991adb",
                                "sense_id": "285f3514-c250-3228-a618-216a2d59a322",
                                "text": "„Laufevents meide ich in erster Linie, weil mir viele Menschen Angst machen, daher sind für mich die kleinen Laufaccessoires die Belohnung und die Motivation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
