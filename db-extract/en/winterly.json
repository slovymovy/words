                    {
                        "sense_id": "b4598b4c-bb79-3073-b774-4e8bd026e9ab",
                        "entry_id": "ca6e7f22-8808-3663-b8f5-a885d337438b",
                        "glosses": [
                            "Happening in winter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099a91b5-d285-4768-bc13-6a2a435ecc4a",
                                "sense_id": "b4598b4c-bb79-3073-b774-4e8bd026e9ab",
                                "text": "One winterly day, about the year when you and I were concerned in being born, the engine-driver of a Scotch express received the ‘clear’ from a signal near a little Huntingdon station called Abbots Ripton. He went on and crashed into a goods train and into the thick of the smash a down express mowed its way."
                            }
                        ]
                    },
                    {
                        "sense_id": "3eb8f37a-b896-3959-9a03-3154aab16893",
                        "entry_id": "ca6e7f22-8808-3663-b8f5-a885d337438b",
                        "glosses": [
                            "Of weather, etc, characteristic of winter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c517d52-0ed0-4ce6-9e0c-1378da6a20a6",
                                "sense_id": "3eb8f37a-b896-3959-9a03-3154aab16893",
                                "text": "If it be somerly weather till the Kalends of January, it will be winterly weather to the Kalends of May."
                            }
                        ]
                    }
