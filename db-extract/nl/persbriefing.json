                        "examples": [
                            {
                                "example_id": "dd1e609f-24d9-44e7-8ee5-6bcf2c110a57",
                                "sense_id": "b1caaaab-eb37-3f47-8c04-cd9334724cfc",
                                "text": "Spicer kreeg een spervuur van vragen tijdens zijn dagelijkse persbriefing. Hij formuleerde het zo: “President Trump gelooft dat dit werkelijk zo is. Hij baseert die opvatting op studies en bewijzen die aan hem gepresenteerd zijn.”"
                            },
                            {
                                "example_id": "4e84aa6f-a11f-4500-9161-0898c7dc9657",
                                "sense_id": "b1caaaab-eb37-3f47-8c04-cd9334724cfc",
                                "text": "Verslaggevers van onder meer CNN, The New York Times en Politico waren gisteren niet welkom bij een persbriefing van woordvoerder Sean Spicer. Allemaal media die de president de afgelopen maanden heeft beticht van het brengen van nepnieuws over hem en zijn beleid."
                            }
                        ]
