                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "214f1cb6-8907-440b-a4ff-dac2aff62e44",
                                "sense_id": "6a2c69e3-435f-3438-8a98-763358320686",
                                "text": "8 April 2018 Chomp Squad, \"You Can Handel It\"\nBlaze, set the blasters to liquid nitro! We're gonna freeze this lava before it flows any further."
                            }
                        ]
                    },
                    {
                        "sense_id": "81edfe35-4b76-3baf-9575-c94a4ba7cb6f",
                        "entry_id": "f7140043-d228-3e57-b255-3645e89a3a08",
                        "glosses": [
                            "Nitrous oxide; the system that adds nitrous oxide to a car engine; by extension, a boost mechanic to speed up cars in a video game."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff51bca4-4884-46b3-8c67-cde9ed71c156",
                                "sense_id": "81edfe35-4b76-3baf-9575-c94a4ba7cb6f",
                                "text": "You need to find the smartest routes and optimize the nitro boost to win."
                            },
                            {
                                "example_id": "7513f6a8-93cf-4e4d-a1c8-b4aa2720387b",
                                "sense_id": "81edfe35-4b76-3baf-9575-c94a4ba7cb6f",
                                "text": "Reaching down to his control panel , he pushed a big red button marked “nitro” . When the nitro mixed with the gasoline in the engine of Vane's monstrous machine, a giant fireball shot out from behind, launching the machine forward and almost knocking Vane right out of his seat."
                            }
                        ]
                    }
