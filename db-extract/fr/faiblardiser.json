                "senses": [
                    {
                        "sense_id": "3d8cafcf-87db-358c-8f76-dbe1a130f707",
                        "entry_id": "51077ce4-6c65-36f2-8a1a-0c63f652912f",
                        "glosses": [
                            "Rendre faiblard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deec2084-2b7e-42b7-b0cd-331900319c6c",
                                "sense_id": "3d8cafcf-87db-358c-8f76-dbe1a130f707",
                                "text": "Après c’est vrai qu’on veut éviter de faiblardiser la pousse de la cloche."
                            },
                            {
                                "example_id": "639b4e99-f95c-42ee-833e-853d73efaaeb",
                                "sense_id": "3d8cafcf-87db-358c-8f76-dbe1a130f707",
                                "text": "Autant je suis tout à fait d’accord pour que l’on fasse, généralement, preuve de ponctualité, d’attention, de curiosité, etc… ^([sic : etc.]) envers une personne qu’on « aime » ou qu’on apprécie (normal, & même très « sain »), autant se faiblardiser en acceptant des choses que l’on réprouve au nom d’une peur incongrue de la solitude ou de l’abandon (?!) peut s’avérer dangereux."
                            },
                            {
                                "example_id": "4edc5818-c0a8-4927-a451-300f52215be2",
                                "sense_id": "3d8cafcf-87db-358c-8f76-dbe1a130f707",
                                "text": "N’est-ce pas qu’elles soient toujours réduites à n’être que des esprits « faiblardisés », partisans du moindre effort, incapables de surpassement […]"
                            }
                        ]
                    }
                ],
