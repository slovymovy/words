                            "plural"
                        ],
                        "form": "afzettinkjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddf9d63f-00c6-30d3-ba60-c5f51e7f075b",
                        "entry_id": "39fd0ad5-74cf-3a36-ae52-b34779ea61f9",
                        "glosses": [
                            "iets waarmee je mensen kunt tegen houden zoals bijvoorbeeld een hek of een link"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d60b75-bdd3-431e-85e5-ae7c0c59d6be",
                                "sense_id": "ddf9d63f-00c6-30d3-ba60-c5f51e7f075b",
                                "text": "De politie had rond de plaats van de misdaad een afzetting geplaatst."
                            },
                            {
                                "example_id": "7564faf1-646c-4dd4-9513-1c89c6f78dbf",
                                "sense_id": "ddf9d63f-00c6-30d3-ba60-c5f51e7f075b",
                                "text": "Op dit moment zorgt Wijnveld met zijn collega's voor het uitrollen van de anderhalvemetereconomie in negen steden in ons land: \"Halsema zei bij Op1 dat ze zondag toch onrustig werd, normaal ga je bij twijfel voor de zekerheid toch voorbereidingen inzetten, zorg je dat afzettingen klaar staan, of led-schermen om mensen er op te wijzen dat het vol is. Dat is niet gebeurd. Dan kun je ook niet meer ingrijpen, zonder dat het ongezellig wordt.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "062ee063-ab7c-3dc4-898e-638b37aa0efe",
                        "entry_id": "39fd0ad5-74cf-3a36-ae52-b34779ea61f9",
                        "glosses": [
                            "amputatie van een lichaamsdeel"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d9c59092-49c5-3570-bef2-431f0f3b8bcb",
                        "entry_id": "39fd0ad5-74cf-3a36-ae52-b34779ea61f9",
                        "glosses": [
                            "plek (in de bodem of een vloeistof) waarin bepaalde stoffen zijn terechtgekomen door neerslaan of bezinken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b308ce6-35bc-4b70-8639-d5cade0be9e1",
                        "source_entry_id": "39fd0ad5-74cf-3a36-ae52-b34779ea61f9",
                        "source_sense_id": "ddf9d63f-00c6-30d3-ba60-c5f51e7f075b",
                        "source_sense_description": "iets waarmee je mensen kunt tegen houden zoals bijvoorbeeld een hek of een link",
                        "target_lang_word": "Absperrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absperrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a882463-ff0e-3d8b-a004-be4a1fffc1fb",
                                        "entry_id": "3f07d701-c31f-3750-8180-3f1811a90fdb",
                                        "glosses": [
                                            "eine technische Vorrichtung, um zu verhindern, dass etwas einen bestimmten Punkt überwinden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c46297d4-69b0-46ff-b550-91c3c28e55ab",
                                                "sense_id": "1a882463-ff0e-3d8b-a004-be4a1fffc1fb",
                                                "text": "Die Absperrung diente dazu, die Arbeit der Feuerwehr abzusichern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "013ffd10-2bef-3380-9276-ae9c0c9bb0e3",
                                        "entry_id": "3f07d701-c31f-3750-8180-3f1811a90fdb",
                                        "glosses": [
                                            "das Absperren; die Maßnahme, die das Überwinden eines bestimmten Punktes verhindern soll, beziehungsweise eine Maßnahme, die mittels [1] erfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5dfb4d-ad4b-44c5-90d8-35ac9c4bb4b3",
                                                "sense_id": "013ffd10-2bef-3380-9276-ae9c0c9bb0e3",
                                                "text": "Die Absperrung des gesamten Fußgängerbereiches stieß auf viel Kritik."
                                            },
                                            {
                                                "example_id": "b1656ce4-f7b7-4af1-9e86-b5a2366a0f59",
                                                "sense_id": "013ffd10-2bef-3380-9276-ae9c0c9bb0e3",
                                                "text": "„Die nervös hin und her patrouillierenden Polizisten paßten auf, daß die Absperrung nicht durchbrochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "512e9c10-bffe-4254-9ad7-552f223bb309",
                        "source_entry_id": "39fd0ad5-74cf-3a36-ae52-b34779ea61f9",
                        "source_sense_id": "062ee063-ab7c-3dc4-898e-638b37aa0efe",
                        "source_sense_description": "amputatie van een lichaamsdeel",
                        "target_lang_word": "Abtrennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abtrennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                        "entry_id": "f2f3c3c1-c189-3555-b9b5-22e71b3c7a9f",
                                        "glosses": [
                                            "Entfernung/Absonderung eines Teils von einem Ganzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc9dfdff-3d5a-44e4-aeb4-5a8c3ec29137",
                                                "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                                "text": "„Techniken zur Abtrennung und Speicherung von CO 2, so genannte Carbon Capture and Storage-Verfahren (CCS) werden zurzeit viel diskutiert.“"
                                            },
                                            {
                                                "example_id": "ecc281db-39a4-4fef-a9c0-f400e86e6b85",
                                                "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                                "text": "„Die von den Wirten zur Abtrennung errichteten Glastüren stehen meist offen, um die Arbeit des Personals zu erleichtern, und ebenso oft sind Nichtraucher gezwungen, durch den Raucherbereich zu gehen, um etwa zu den Toiletten oder überhaupt erst zum Nichtraucherbereich zu gelangen – was der Verwaltungsgerichtshof bereits 2013 als nicht gesetzeskonform moniert hatte.“"
                                            },
                                            {
                                                "example_id": "2d51f256-c6b7-4ab3-9900-6cb1c893991b",
                                                "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                                "text": "„Seit vielen Jahrzehnten wird deshalb die Abtrennung eines gewaltigen Staatsgebiets – etwa ein Viertel des deutschen Territoriums – und das Los von mehr als zwölf Millionen Flüchtlingen und Vertriebenen, unter ihnen mindestens 600000 Todesopfer, als Randnotiz des deutschen Jahrhundertverbrechens behandelt, als Fußnote der Nationalerzählung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe9d308b-a0e5-4ff7-9095-6011bd53655f",
                        "source_entry_id": "39fd0ad5-74cf-3a36-ae52-b34779ea61f9",
                        "source_sense_id": "062ee063-ab7c-3dc4-898e-638b37aa0efe",
                        "source_sense_description": "amputatie van een lichaamsdeel",
                        "target_lang_word": "Amputation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amputation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                        "entry_id": "7531cecc-6797-3439-96a7-d254677f1530",
                                        "glosses": [
                                            "die operative Abtrennung von Körperteilen aufgrund von Verletzungen oder anderer medizinischer Indikationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f06075-9f3a-47c3-b08c-2e60df0a84ee",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "Eine Amputation ist oft das letzte Mittel, um dem Patienten das Leben zu retten."
                                            },
                                            {
                                                "example_id": "b049c37b-7813-4e19-b6fb-deed32a578bd",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "Die psychologische Betreuung ist vor und nach einer Amputation für den Patienten sehr wichtig."
                                            },
                                            {
                                                "example_id": "f92b8872-1455-4358-876f-09030c8be1e7",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "„Auch wenn sie noch etwas humpelt, sie ist froh, die Amputation abgewendet zu haben.“"
                                            },
                                            {
                                                "example_id": "8df3b505-fcbd-40c7-b2ea-0e931589a5b2",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "„Also müssen sie eine Amputation vornehmen.“"
                                            },
                                            {
                                                "example_id": "ed16dc0d-1591-488b-8e6b-f21ad7280291",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "„So hat, laut Cora, eine medizinisch einwandfrei indizierte und chirurgisch präzise durchgeführte Amputation auszusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
