                "senses": [
                    {
                        "sense_id": "165df630-12c8-327a-a27d-372dfd1dd045",
                        "entry_id": "c873f008-66d5-3472-9323-ae3c6b6ab67b",
                        "glosses": [
                            "Grand maître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3b52c9-7cb2-4d17-aa6a-6660fd3f02d5",
                                "sense_id": "165df630-12c8-327a-a27d-372dfd1dd045",
                                "text": "Der Großmeister hat mehrere Turniere gewonnen und hundertausende Dollar abgesahnt.",
                                "translation": "Le grand maître a remporté plusieurs tournois et empoché des centaines de milliers de dollars."
                            }
                        ]
                    },
                    {
                        "sense_id": "31371a33-41d2-37cd-ae70-989e5935a21d",
                        "entry_id": "c873f008-66d5-3472-9323-ae3c6b6ab67b",
                        "glosses": [
                            "Grand maître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12dcdb6a-4d8c-4945-888f-08bc794985ba",
                                "sense_id": "31371a33-41d2-37cd-ae70-989e5935a21d",
                                "text": "Der letzte Großmeister des Templerordens, war Jacques de Molay.",
                                "translation": "Le dernier Grand Maître de l'Ordre du Temple fut Jacques de Molay."
                            }
                        ]
                    }
