                                "target_senses": [
                                    {
                                        "sense_id": "f789be0b-ba09-34f1-a7ce-f78bc6449113",
                                        "entry_id": "1d26bc24-306b-305c-b6cd-36129acdbc50",
                                        "glosses": [
                                            "Variante orthographique de Suriname (pays d’Amérique du Sud)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc6dbcac-faac-4b00-99c2-9168f6eb6079",
                                                "sense_id": "f789be0b-ba09-34f1-a7ce-f78bc6449113",
                                                "text": "Il leur apprit qu’il était rentré en France, grâce aux papiers d’un pauvre diable, mort entre ses bras de la fièvre jaune, à Surinam."
                                            },
                                            {
                                                "example_id": "5ef077b3-6e83-4369-aaa6-6add8e36733c",
                                                "sense_id": "f789be0b-ba09-34f1-a7ce-f78bc6449113",
                                                "text": "Elle produit du rocou, du coton et du cacao, mais en quantités trop faibles, car les Français n’ont pas procédé aux aménagements de polders qui font la prospérité de leurs voisins hollandais du Surinam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35931b11-88ab-40f2-a270-66578529cfd7",
                        "source_entry_id": "912e5aee-0fae-3704-b3e2-5b352af43516",
