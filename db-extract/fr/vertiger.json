                "senses": [
                    {
                        "sense_id": "eab09ba0-a44f-38b4-9957-a769868cc0eb",
                        "entry_id": "4c8e94b3-6a33-3eee-8e63-a40019a1f225",
                        "glosses": [
                            "Donner le vertige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d1f377-cdbc-48fc-b925-01d24f092be0",
                                "sense_id": "eab09ba0-a44f-38b4-9957-a769868cc0eb",
                                "text": "Il publiait dans les petites revues où vertigent de grands rêves."
                            },
                            {
                                "example_id": "0862b3e7-0c41-4669-a299-c0cea9c241f0",
                                "sense_id": "eab09ba0-a44f-38b4-9957-a769868cc0eb",
                                "text": "Je suis pris dans l’encerclement de ta chair, pris dans l’engrenage de tes odeurs, qui vertigent, qui vertigent."
                            },
                            {
                                "example_id": "a17ccea9-b9d4-4eb7-b5b6-58ee9ab32e5a",
                                "sense_id": "eab09ba0-a44f-38b4-9957-a769868cc0eb",
                                "text": "Et des cerceaux tournent au plafond et des parois vertigent le lit."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bb6131f-5171-360d-90f1-8c7afd6ab683",
                        "entry_id": "4c8e94b3-6a33-3eee-8e63-a40019a1f225",
                        "glosses": [
                            "Éprouver le vertige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3953e80d-cc33-41b8-b473-ab225e1c6060",
                                "sense_id": "0bb6131f-5171-360d-90f1-8c7afd6ab683",
                                "text": "On boitait vertigeait crachait, mais enfin je crois heures trois par jour on pouvait se montrer."
                            }
                        ]
                    }
                ],
