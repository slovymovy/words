                "senses": [
                    {
                        "sense_id": "aa6597f7-c4ca-3ebb-8a71-2fb570ecc9c0",
                        "entry_id": "4868f0f7-1635-3b49-a597-8e6f6cae0609",
                        "glosses": [
                            "действие по значению гл. блевать; рвота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e22d08-532e-452e-8985-ad0dd9fdaac9",
                                "sense_id": "aa6597f7-c4ca-3ebb-8a71-2fb570ecc9c0",
                                "text": "Но во всех, кто остался мне верен, тупая Его величавость вызывала мигрень и блевоту."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d9584eb-0467-31d1-8ad3-a150276dc0a5",
                        "entry_id": "4868f0f7-1635-3b49-a597-8e6f6cae0609",
                        "glosses": [
                            "разг. масса, изверженная желудком при рвоте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe65d58-c108-4388-97ef-789bdbc5e9e6",
                                "sense_id": "8d9584eb-0467-31d1-8ad3-a150276dc0a5",
                                "text": "Медленно поднимает седую голову из тарелки; физиономия — сморщенная, в усах — лапша, под столом — лужа блевоты."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74cd851e-310d-4780-8224-5d4602bf2051",
                        "source_entry_id": "4868f0f7-1635-3b49-a597-8e6f6cae0609",
                        "target_lang_word": "sick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e251008-13d1-3f9e-8b45-3bf774361b9c",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "In poor health; ill."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5121214-790d-421e-b8fd-93e2d0b6d25a",
                                                "sense_id": "8e251008-13d1-3f9e-8b45-3bf774361b9c",
                                                "text": "She was sick all day with the flu."
                                            },
                                            {
                                                "example_id": "488f8e90-8427-435b-be12-8664481a4473",
                                                "sense_id": "8e251008-13d1-3f9e-8b45-3bf774361b9c",
                                                "text": "We have to care for the sick."
                                            },
                                            {
                                                "example_id": "952ac4f5-1c7c-4cfa-8f98-3762affcb962",
                                                "sense_id": "8e251008-13d1-3f9e-8b45-3bf774361b9c",
                                                "text": "Ne take noon hede to brynge togidere þe parties of þe boon þat is to-broken or dislocate, til viij. daies ben goon in þe wyntir, & v. in þe somer; for þanne it schal make quytture, and be sikir from swellynge; & þanne brynge togidere þe brynkis eiþer þe disiuncture after þe techynge þat schal be seid in þe chapitle of algebra."
                                            },
                                            {
                                                "example_id": "ed4fe935-ce90-45cc-bf97-b2aa35e23cae",
                                                "sense_id": "8e251008-13d1-3f9e-8b45-3bf774361b9c",
                                                "text": "‘Children crawled over each other like little grey worms in the gutters,’ he said. ‘The only red things about them were their buttocks and they were raw. Their faces looked as if snails had slimed on them and their mothers were like great sick beasts whose byres had never been cleared.[…]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d64b10-92a6-3879-a142-377b11e1f02e",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "Having an urge to vomit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd16da28-235f-48c8-a5d3-c5d3ab4a7c56",
                                                "sense_id": "e3d64b10-92a6-3879-a142-377b11e1f02e",
                                                "text": "My daughter was violently sick three times in the night."
                                            },
                                            {
                                                "example_id": "b84b4946-bd2a-417b-80e0-54fe56d7561b",
                                                "sense_id": "e3d64b10-92a6-3879-a142-377b11e1f02e",
                                                "text": "In the meantime the old man had gotten up and gone out in the yard and began to vomit. Henry said I believe I feel sick and got up and went out. He went out one door and his father went out the other one. I did not think there was anything wrong with the coffee and I asked my wife to pour this out […]"
                                            },
                                            {
                                                "example_id": "d3b170b6-ee8e-4fac-8917-eb4372aff4d6",
                                                "sense_id": "e3d64b10-92a6-3879-a142-377b11e1f02e",
                                                "text": "Q. Didn't he complain he was sick before he commenced to vomit?\nA. He did, just before he said, to me, “I feel sick,” I asked him if he wanted to throw up and he said yes."
                                            },
                                            {
                                                "example_id": "1428435d-b3b2-4e7c-b2be-0a0fe6e353fc",
                                                "sense_id": "e3d64b10-92a6-3879-a142-377b11e1f02e",
                                                "text": "[…] trying hard to cry. Crying’s good. Crying teaches him to breathe. But I wish he weren’t crying from hunger. I feel dizzy. I sit down and feel a little sick. Maybe I’ll vomit, too. No, I never vomit. I feel sick, but I won’t vomit. I never vomit."
                                            },
                                            {
                                                "example_id": "7f27e465-0c36-437a-8756-aff0ddaae7ab",
                                                "sense_id": "e3d64b10-92a6-3879-a142-377b11e1f02e",
                                                "text": "I feel sick, like I might vomit, and I'm more tired than I can ever remember feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94c74826-e70c-373d-8ec8-6f9c82ae6d5e",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "Mentally unstable, disturbed."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27c48eae-4773-426f-8fd2-0f947def645d",
                                                "sense_id": "94c74826-e70c-373d-8ec8-6f9c82ae6d5e",
                                                "text": "You sick bastard!"
                                            },
                                            {
                                                "example_id": "aae602d8-0759-4619-8391-4fa61bc7af11",
                                                "sense_id": "94c74826-e70c-373d-8ec8-6f9c82ae6d5e",
                                                "text": "What a sick, sick feeling / To let you go, my dear"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c0ae61-2f74-39d9-aca0-3d3edcda77c6",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "In bad taste."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "524d0c23-82c5-4c85-8aaa-b3c51b861cf3",
                                                "sense_id": "d4c0ae61-2f74-39d9-aca0-3d3edcda77c6",
                                                "text": "That’s a sick joke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6769055-6d1c-33c6-9bf1-a57757025b7f",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "Tired of or annoyed by something [with of]."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81cb987d-0852-4082-ac5f-acf5420f4770",
                                                "sense_id": "f6769055-6d1c-33c6-9bf1-a57757025b7f",
                                                "text": "I’ve heard that song on the radio so many times that I’m starting to get sick of it."
                                            },
                                            {
                                                "example_id": "e6982606-d8d8-4ee5-b7e3-38e02466c208",
                                                "sense_id": "f6769055-6d1c-33c6-9bf1-a57757025b7f",
                                                "text": "I’m so sick of that same old love, the kind that breaks your heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7ed8905-c0f5-306c-8853-372639a05040",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "Very good, excellent, awesome, badass."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e6d94b-b456-4adf-bb30-a93d54f490b9",
                                                "sense_id": "e7ed8905-c0f5-306c-8853-372639a05040",
                                                "text": "This tune is sick."
                                            },
                                            {
                                                "example_id": "9d6caff7-5400-4ce8-9c99-bcec0b47a647",
                                                "sense_id": "e7ed8905-c0f5-306c-8853-372639a05040",
                                                "text": "He showed off his sick surfing skills."
                                            },
                                            {
                                                "example_id": "4f59fbb2-b6a5-4c99-a1bc-a7577cb5e25f",
                                                "sense_id": "e7ed8905-c0f5-306c-8853-372639a05040",
                                                "text": "Dude, this car's got a sick subwoofer!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741bb327-20d9-3da0-b575-114fdfb40cc3",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "In poor condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377f41f0-47c0-479a-b7f0-570eb72a98df",
                                                "sense_id": "741bb327-20d9-3da0-b575-114fdfb40cc3",
                                                "text": "sick building syndrome; my car is looking pretty sick; my job prospects are pretty sick"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45a1197-79db-31d0-a788-b1a4315f8189",
                                        "entry_id": "0ad02195-c377-3a4e-ba25-b4edec88ec08",
                                        "glosses": [
                                            "Failing to sustain adequate harvests of crop, usually specified."
                                        ],
