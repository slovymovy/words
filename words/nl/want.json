                    "frequency": "Low",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De matroos klom behendig in het <w>want</w> om de zeilen te inspecteren.",
                            "target_lang_translations": {
