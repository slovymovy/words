                                                "sense_id": "ae37ab46-942c-347a-a300-0e5105a14225",
                                                "text": "La place est bonne, c'est une course au clocher pour l'obtenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8de09f9d-7ecd-3e4d-94e9-205c800fbdb5",
                                        "entry_id": "928ed82d-c8e8-3c91-b590-2c626bad2bc8",
                                        "glosses": [
                                            "Synonyme de steeple-chase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ed7f426-506b-3cf3-a3b9-9bf48304940c",
                                        "entry_id": "928ed82d-c8e8-3c91-b590-2c626bad2bc8",
                                        "glosses": [
                                            "Voyage long et mouvementé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db14ad25-28ca-4a00-84af-a9cacbb04162",
                                                "sense_id": "1ed7f426-506b-3cf3-a3b9-9bf48304940c",
                                                "text": "Après avoir avalé quelques garbanzos qui sonnaient dans nos ventres comme des grains de plomb dans des tambours de basque, nous rentrâmes dans notre boîte, et la course au clocher recommença."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
