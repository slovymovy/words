                "senses": [
                    {
                        "sense_id": "9ecb348e-ebf4-36ad-a093-92364c386a3d",
                        "entry_id": "80cfda01-5f62-373f-acb6-8ea8e0a49ff3",
                        "glosses": [
                            "Laisser échapper des effluves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "705aea24-e188-42f5-bef1-f5ad71c75eed",
                                "sense_id": "9ecb348e-ebf4-36ad-a093-92364c386a3d",
                                "text": "Mais comment donc peut-il imaginer que ce corps puisse effluer de toutes parts des rayons, s’il n’imagine en même-temps que ce globe est très-électrique de sa nature, & qu’il rayonne de toutes parts des aigrettes électriques ?"
                            },
                            {
                                "example_id": "8a403a5a-6b19-40f6-87f6-506dfe8d7d15",
                                "sense_id": "9ecb348e-ebf4-36ad-a093-92364c386a3d",
                                "text": "Arrivé dans la rue, le Fossé lui sembla effluer des miasmes prophétiques : le Fossé lui-même se tournait contre lui !"
                            }
                        ]
                    }
                ],
