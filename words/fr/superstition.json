                    "frequency": "Low",
                    "semantic_group_id": "scrupule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le respect aveugle de cette règle administrative relève presque de la <w>superstition</w>."
                        },
                        {
                            "text": "Son attachement minutieux à la ponctuation d'origine ressemble à une véritable <w>superstition</w>."
