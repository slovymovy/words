                        ],
                        "form": "blizzards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e71ddd19-f6a7-3159-aa38-9db883fd305b",
                        "entry_id": "e8497ec3-1cf7-3b3e-bf34-8b3673aa07fa",
                        "glosses": [
                            "Vent violent et glacial, chargé de neige, qui souffle dans les régions du Grand Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd66e40-c121-465d-a3f3-7a3af82f52e6",
                                "sense_id": "e71ddd19-f6a7-3159-aa38-9db883fd305b",
                                "text": "Luttant contre le vent du blizzard, je m'avançais avec difficulté, m'enfonçant dans la neige à chaque pas."
                            },
                            {
                                "example_id": "fc3166d9-3023-4ab3-b830-9853124e1835",
                                "sense_id": "e71ddd19-f6a7-3159-aa38-9db883fd305b",
                                "text": "Le très expérimenté explorateur revint sans avoir atteint son but ; il nous raconta qu’un terrible « blizzard » soufflait dans le Sud et que les glaces étaient dangereusement en mouvement."
                            },
                            {
                                "example_id": "e53c4b01-a904-4dd0-80ec-ed74811f31e8",
                                "sense_id": "e71ddd19-f6a7-3159-aa38-9db883fd305b",
                                "text": "Le blizzard est complétement déchaîné et la neige tombe si vite et si dru que les bâtiments ont l'air de fantômes. Des congères commencent déjà à se former devant les devantures des magasins de Main Street."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "869e32b0-6ee8-426b-820d-404fad2ae3e5",
                        "source_entry_id": "e8497ec3-1cf7-3b3e-bf34-8b3673aa07fa",
                        "source_sense_id": "e71ddd19-f6a7-3159-aa38-9db883fd305b",
                        "target_lang_word": "Blizzard",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
