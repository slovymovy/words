                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c0b812-3b89-46f2-a294-80fe55e8b5b8",
                        "source_entry_id": "906ed68b-9413-38e9-8338-c219f527e9bf",
                        "source_sense_id": "4f2e0349-d8a3-37ea-8fb4-d40e8c90e7d9",
                        "target_lang_word": "上海",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "上海",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                        "entry_id": "9156b220-dc2a-3990-b8b7-8c761138953f",
                                        "glosses": [
                                            "(～市) 中國最大的工商业城市，中央直辖市，世界特大城市和十大港口之一。地扼长江出海口。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df26f389-1600-4285-aa13-7d8e7f8c0f98",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "上海證券交易所"
                                            },
                                            {
                                                "example_id": "f8d1c8a8-b895-4588-8d6c-ef4c797e8a0e",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "上海证券交易所"
                                            },
                                            {
                                                "example_id": "bbff14e3-00b5-4bb4-82d7-d35092014f45",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "她最近跑到上海去了。"
                                            },
                                            {
                                                "example_id": "7a28ebed-d989-45e3-b62d-d1b53c53625c",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "在上海我還有幾件事情要安排。"
                                            },
                                            {
                                                "example_id": "aea6287d-2188-48d7-8134-2bc00f7c2f42",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "在上海我还有几件事情要安排。"
                                            },
                                            {
                                                "example_id": "1e6a1cbd-7991-42e0-84d2-69d39f1f84ce",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "儂到上海來了多少辰光了？",
                                                "translation": "你來上海多久了？"
                                            },
                                            {
                                                "example_id": "c524b708-2d0f-4898-ba74-cbcc07ad3fe5",
                                                "sense_id": "b4592c2a-9261-3578-87df-b2764728d796",
                                                "text": "侬到上海来了多少辰光了？",
                                                "translation": "你來上海多久了？"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63702d32-7103-3b20-b47d-60de10107c40",
                                        "entry_id": "9156b220-dc2a-3990-b8b7-8c761138953f",
