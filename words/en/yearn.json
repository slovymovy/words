    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "624b6c6d-2e0b-3405-aee0-05ae663085e3",
                    "sense_definition": "To have a deep, intense, or painful longing or desire for someone or something, or to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Living in a noisy city, she often <w>yearned</w> for the quiet life of the countryside."
                        },
                        {
                            "text": "After years of constant travel, he <w>yearns</w> to settle down in one place."
                        }
                    ],
                    "synonyms": [
                        "ache",
                        "craving",
                        "hunger",
                        "longing",
                        "pining",
                        "thirst"
                    ],
                    "common_phrases": [
                        "yearn for",
                        "yearn to"
                    ]
                },
                {
                    "sense_id": "f07b3081-cfa0-3833-a0ba-66874683c845",
                    "sense_definition": "To feel a strong, nostalgic desire for a past time or lost situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As he grew older, he often <w>yearned</w> after the carefree days of his early youth."
                        },
                        {
                            "text": "Many older citizens quietly <w>yearn</w> for the close-knit community life they once enjoyed."
                        }
                    ],
                    "synonyms": [
                        "pining",
                        "longing"
                    ],
                    "common_phrases": [
                        "yearn after"
                    ]
                },
                {
