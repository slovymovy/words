                        "sense_id": "0b9f29ac-4b04-3600-9929-5ae1577081a0",
                        "entry_id": "6e3b4da4-d461-3c1f-ba4e-c1e59d380dc8",
                        "glosses": [
                            "A cheerful remark."
                        ],
