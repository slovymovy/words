                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f35cac9-303b-4eba-9519-858b1937a414",
                                "sense_id": "7d98d4c8-d964-3f2d-8db8-f7db8a5faf21",
                                "text": "„Die Dichtheit von Drosselklappen bezieht sich auf ihre Eigenschaft zum Anhalten der Luft sowohl in Bezug auf die Außenumwelt als auch die Lüftungsinstallation selbst.“"
                            },
                            {
                                "example_id": "9c0b09ac-415d-4b0f-9b05-5f5c0f40c309",
                                "sense_id": "7d98d4c8-d964-3f2d-8db8-f7db8a5faf21",
                                "text": "„Ein wichtiger Aufgabenbereich bei der Lüftungsinstallation ist die Herstellung und Montage der erforderlichen Rohrleitungen und Rohrverbindungen sowie der Fördereinrichtungen (z.B. Gebläse, Pumpen), der Sicherheits- und Sperrvorrichtungen und der Regelsysteme (z.B. Thermostate, Zeitschaltuhren).“"
                            },
                            {
                                "example_id": "b8cfb8b6-1a48-4c00-85d2-51b5f72b71bb",
                                "sense_id": "7d98d4c8-d964-3f2d-8db8-f7db8a5faf21",
                                "text": "„Bei der Reinigung der Lüftungsinstallationen werden modernste und effiziente Geräte des finnischen Herstellers Lifa Air verwendet.“"
                            },
                            {
                                "example_id": "0dd8abd5-aa20-4762-8c25-583d39a582ce",
                                "sense_id": "7d98d4c8-d964-3f2d-8db8-f7db8a5faf21",
                                "text": "„Notwendige Lüftungsinstallationen wurden in den Zwischenräumen vorborgen.“"
                            }
                        ],
