                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The umpire signaled a <w>called</w> strike because the batter did not swing.",
                            "target_lang_translations": {
                                "ru": "Судья показал <w>объявленный</w> страйк, так как бьющий не сделал замах.",
