                "senses": [
                    {
                        "sense_id": "7727e3aa-fbf2-3cc8-acea-df8a01f598cd",
                        "entry_id": "3b606c68-ce92-316f-bae6-f110c0758b20",
                        "glosses": [
                            "Haushaltsgerät, meist als Teil eines Herds, zum Braten und Backen von Speisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c4c80d-815e-4e78-a195-bacbe9572d11",
                                "sense_id": "7727e3aa-fbf2-3cc8-acea-df8a01f598cd",
                                "text": "„Die Zeiten, da man tatsächlich in der Lebensmittelabteilung des KaDeWe einen für die Bratröhre vorbereiteten jungen Bären bestellen konnte (wie man in einem sehr alten Katalog des Hauses nachlesen kann), sind vorbei.“"
                            },
                            {
                                "example_id": "70aabf7c-d31c-45c5-9e58-a2c8b83478e8",
                                "sense_id": "7727e3aa-fbf2-3cc8-acea-df8a01f598cd",
                                "text": "„Er kniete vor einer geöffneten Bratröhre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
