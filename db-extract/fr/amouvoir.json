                    }
                ],
                "senses": [
                    {
                        "sense_id": "91fe1dc5-34ff-30de-8650-ae68e5733f6b",
                        "entry_id": "daafb779-eee5-3e94-9b17-7b1f1a233c6f",
                        "glosses": [
                            "Mouvoir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "182823fd-7daa-4eeb-9876-367903c2bc4a",
                                "sense_id": "91fe1dc5-34ff-30de-8650-ae68e5733f6b",
                                "text": "Comme rien de comparable n’a été fait en Europe, voire même la tranchée du canal d’Arles à Boue, on pourra peut-être s’étonner à l’idée d’amouvoir des masses s’élevant parfois à vingt mille mètres par jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ff50fbc-24d5-39f7-a67c-27700938990e",
                        "entry_id": "daafb779-eee5-3e94-9b17-7b1f1a233c6f",
                        "glosses": [
                            "Émouvoir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "32e844a5-5307-4b25-9699-8f93992be7b0",
                                "sense_id": "6ff50fbc-24d5-39f7-a67c-27700938990e",
                                "text": "Les autres font aussi trop froids : ils n’ont point mesme dans les grandes affaires de cette émotion necessaire pour ébranler l’esprit des Juges, qui ne se laissent amouvoir dans les grands sujets, que par de grands mouvemens."
                            },
                            {
                                "example_id": "200ea00a-d7e6-469e-8bfe-0a46f43fcef2",
                                "sense_id": "6ff50fbc-24d5-39f7-a67c-27700938990e",
                                "text": "Réputée pour faire les fesses roses, chantée par Pierre Perret dans de truculents couplets, elle est aussi une incontournable alliée healthy, tout comme la roquette, salade médicinale par excellence, mais également connue depuis l’Antiquité pour « amouvoir le désir amoureux »."
                            }
                        ]
                    }
                ],
