                        "glosses": [
                            "Celui qui vend à l'encan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf61652-8834-4ae5-9a60-20f3e5e9b2e3",
                                "sense_id": "c16448bb-1e45-3b6a-ab47-87b4f63c33ec",
                                "text": "Il se fit alors encanteur à la Nouvelle-Orléans, et vendit bon nombre de nègres sous l’ancien régime."
                            },
                            {
                                "example_id": "999a66e5-6221-42e3-a4f1-0b20aaa55851",
                                "sense_id": "c16448bb-1e45-3b6a-ab47-87b4f63c33ec",
                                "text": "Nous allons commencer par vendre les « cochonneries » dit l’encanteur en manière d'introduction."
                            },
                            {
                                "example_id": "b5a90145-0ded-47b6-a035-9653309bc06c",
                                "sense_id": "c16448bb-1e45-3b6a-ab47-87b4f63c33ec",
                                "text": "Sur le devant de la scène, se tient Blanche, l’encanteuse. Devant elle, une belle huche à pain et un amas de cossins de toutes sortes, dans deux caisses de carton devant la huche."
                            }
                        ]
