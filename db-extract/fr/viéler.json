                                "example_id": "51e17b0a-a548-489e-a86d-8cc2d3845131",
                                "sense_id": "9fbfffbf-1036-3537-8e29-39f5480c51bb",
                                "text": "Même en l'absence des ménestrels on entendait donc de la musique dans les châteaux du moyen âge; on chantait, on harpait, on viélait, […]."
                            },
                            {
                                "example_id": "cb35d523-ead4-4357-b796-82a1b016c687",
                                "sense_id": "9fbfffbf-1036-3537-8e29-39f5480c51bb",
                                "text": "Quelquefois aussi le trouvère chantait et viélait tout à la fois, les citations abondent qui nous montrent tour à tour les musiciens sous ces deux aspects."
                            }
                        ]
