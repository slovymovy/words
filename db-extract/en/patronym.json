                    {
                        "translation_id": "e7fa0d15-6bd1-4483-9d0a-7143ab124f6d",
                        "source_entry_id": "3c3ef20c-9e74-3907-8aff-6b03f7f67bd2",
                        "source_sense_description": "name of someone's father",
                        "target_lang_word": "Patronym",
