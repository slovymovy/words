                        ]
                    },
                    {
                        "translation_id": "3724d7c4-1c13-4e68-bcfd-f1fd88305cf4",
                        "source_entry_id": "10fba188-915b-3875-8c64-f5fd2cb2678c",
                        "source_sense_id": "c03c9511-219c-3daf-addb-d68438853218",
