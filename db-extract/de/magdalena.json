                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e0312ad2-d8a8-407a-8410-f673bbaecb8a",
                        "source_entry_id": "c6b39c36-abb5-323e-ae04-374d93edba11",
                        "source_sense_id": "400f497e-48ec-3853-9ece-986ecb571fee",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Madeleine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Madeleine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4a1356-7505-3726-929a-46e50557c508",
                                        "entry_id": "ff36590a-2124-3d7a-8b54-58b333520b5d",
                                        "glosses": [
                                            "Prénom féminin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc19f274-91a4-41f1-bd32-9ae67663d19c",
                                                "sense_id": "2a4a1356-7505-3726-929a-46e50557c508",
                                                "text": "Voici une chose convenue : toute femme qui a péché se nomme Messaline ou Madeleine. Point de milieu : la débauche ou le repentir ; tel est votre verdict."
                                            },
                                            {
                                                "example_id": "0c9704e2-4b41-4558-9156-1938ca0bf2f5",
                                                "sense_id": "2a4a1356-7505-3726-929a-46e50557c508",
                                                "text": "— Eh ! ma chère, qu’arrive-t-il donc ? lui dit-elle avec assez de sang-froid ; vous avez l’air de Madeleine, mais dans sa jeunesse, avant le repentir."
                                            },
                                            {
                                                "example_id": "748e0a6b-9dde-413a-91c7-c525998b289e",
                                                "sense_id": "2a4a1356-7505-3726-929a-46e50557c508",
                                                "text": "Elle est tellement jolie\n Elle est tellement tout ça\n Elle est toute ma vie\n Madeleine que j'attends là."
                                            },
                                            {
                                                "example_id": "f376b1ac-64b4-4f87-bb68-e54752ffec34",
                                                "sense_id": "2a4a1356-7505-3726-929a-46e50557c508",
                                                "text": "L’usage au Mont-Noir est que les deux chambrières, la Grosse Madeleine et la Petite Madeleine, montent chaque matin dans chaque chambre le charbon ou le bois qui dégourdira l’air avant le lever des « maîtres », et les fassent prendre à l’aide de liasses de vieux journaux qu’elles portent sous le bras."
                                            },
                                            {
                                                "example_id": "65709ddd-a40f-4edf-9106-1b36b3aca9b9",
                                                "sense_id": "2a4a1356-7505-3726-929a-46e50557c508",
                                                "text": "René Progin et son épouse Madeleine, aux côtés des quatre side-cars que Tinguely a, selon sa propre expression, « rapidifiés »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa13559b-cffe-3fbf-8aa8-9efc5551d008",
                                        "entry_id": "ff36590a-2124-3d7a-8b54-58b333520b5d",
                                        "glosses": [
                                            "Marie Madeleine, personnage évangélique."
                                        ],
                                        "tags": [
                                            "Précédé de l'article « la »"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d3f7f1d-4988-40c5-80dd-040e9e464d16",
                                                "sense_id": "fa13559b-cffe-3fbf-8aa8-9efc5551d008",
                                                "text": "Nous avons vu comment la Madeleine est devenue la plus grande des contemplatives …."
                                            },
                                            {
                                                "example_id": "bd550041-a680-4a0d-bd5c-a8535be61409",
                                                "sense_id": "fa13559b-cffe-3fbf-8aa8-9efc5551d008",
                                                "text": "L'église de la Madeleine, la place de la Madeleine, le quartier de la Madeleine à Paris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Madeleine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1863e77d-2567-33c5-a607-96673767adf5",
                                        "entry_id": "3afc3448-3a64-351c-9905-1828d4b3d23d",
                                        "glosses": [
                                            "Prostituée."
                                        ],
                                        "tags": [
                                            "formal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9a132d-fde5-4629-bcf6-90f849b590d3",
                                                "sense_id": "1863e77d-2567-33c5-a607-96673767adf5",
                                                "text": "— Non, mademoiselle. Continuez l’histoire de vos dévotions dans cette église de campagne. Vos cheveux noirs sont les plus longs et les plus beaux du monde. Vous avez l’air d’une Madeleine.\n— C’est la première fois que tu m’appelles putain ! » fit-elle en riant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
