    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "480ffa6d-0df7-3168-9db4-9ff2cd1ea6ea",
                "word": "Bertha",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                        "entry_id": "480ffa6d-0df7-3168-9db4-9ff2cd1ea6ea",
                        "glosses": [
                            "A female given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28d9f9c-6ec2-4628-a727-a9856d584797",
                                "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                "text": "You are the beautiful Bertha, the spinner, the queen of Helvetia; / She whose story I read at a stall in the streets of Southampton"
                            },
                            {
                                "example_id": "5ce6af66-73f7-460b-8968-01e555701252",
                                "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                "text": "Why couldn't they have called her by her first name, Bertha, which was beautiful and dignified, instead of that silly \"Rilla\"?"
                            },
                            {
                                "example_id": "406ec2b5-c8ba-4968-b076-827312f8d079",
                                "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                "text": "\"No wonder she never gets anywhere with a name like Bertha,\" Sally said, while having coffee afterwards with two of the other night-coursers. \"It goes with her outfits, though.\" ( Bertha sports the macrame look, with health-food sandals and hand-weave skirts that don't do a thing for her square figure, [...])"
                            }
                        ]
                    },
                    {
                        "sense_id": "21da75e2-bec6-3847-80e8-a4d03e647c71",
                        "entry_id": "480ffa6d-0df7-3168-9db4-9ff2cd1ea6ea",
                        "glosses": [
                            "Alternative form of Perchta (“goddess in Alpine paganism”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffadf316-f224-466b-8eb1-b7e6310ffecc",
                        "source_entry_id": "480ffa6d-0df7-3168-9db4-9ff2cd1ea6ea",
