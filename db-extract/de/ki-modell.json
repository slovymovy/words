                ],
                "senses": [
                    {
                        "sense_id": "4d94f0a2-2afe-34d7-80af-cb4dc5b2a3ae",
                        "entry_id": "034718f8-afcc-3239-8ec9-b027de89c3be",
                        "glosses": [
                            "Computerprogramm, das künstliche Intelligenz nutzt (um bestimmte Inhalte zu generieren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb30c70e-8b5e-4186-a5a6-5a0de66044ca",
                                "sense_id": "4d94f0a2-2afe-34d7-80af-cb4dc5b2a3ae",
                                "text": "„Im Rahmen des Abkommens wollen die beteiligten Firmen unter anderem ihre KI-Modelle neu bewerten, um die Risiken zu verstehen, die sie im Zusammenhang mit betrügerischen Wahlinhalten darstellen könnten.“"
                            },
                            {
                                "example_id": "0264c3ef-f5e6-4a55-95fa-c5c1ea4b7de8",
                                "sense_id": "4d94f0a2-2afe-34d7-80af-cb4dc5b2a3ae",
                                "text": "„Sprachmodelle wie jenes hinter ChatGPT und Konkurrenten wie Claude basieren auf Wahrscheinlichkeitsrechnungen, so die Leiterin des Instituts für Managementwissenschaften – die Hoffnung, dass derartige KI-Modelle noch deutlich besser werden, ist laut Köszegi eine „falsche“.“"
                            },
                            {
                                "example_id": "b1ba5368-7f62-4919-a718-721c5e46ff2c",
                                "sense_id": "4d94f0a2-2afe-34d7-80af-cb4dc5b2a3ae",
                                "text": "„Andere KI-Modelle sind bei diesen Themen deutlich auskunftsfreudiger und geben korrekte Antworten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
