                    {
                        "translation_id": "db9f9374-6107-46c2-b933-95d5d5d40508",
                        "source_entry_id": "543a27bf-aee4-3cc6-93c8-dad21b665728",
                        "source_sense_description": "showing or expressing empathy",
                        "target_lang_word": "mitfühlend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitfühlend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                        "entry_id": "d799fb4b-be61-3a22-a774-46dc6b861e2d",
                                        "glosses": [
                                            "Anteil am Unglück einer anderen Person nehmend; voller Erbarmen / Mitgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb992bb9-b58c-4d97-9ebf-fa4c38ea140a",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "Als mein Mann starb war mein Bruder mitfühlender, als meine Schwester."
                                            },
                                            {
                                                "example_id": "cfadde49-019e-42e3-a453-7010aeb8de0f",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "Seldon Solomon: „Ich glaube, die wichtigste Lektion für Kinder ist – so abgegriffen das auch klingt – respektvoll, bescheiden und mitfühlend zu sein; […]“"
                                            },
                                            {
                                                "example_id": "fad7bc05-3ae7-4ec4-a4fe-e5db4222cc4d",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "[…] Trump hätte einfach mitfühlend sein können. Er hätte einfach anständig sein können, wie es sich für den Präsidenten der Vereinigten Staaten ziemt."
                                            },
                                            {
                                                "example_id": "fcd1c7ab-90d8-4ade-ab35-2205cdfd8420",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "„Wer alt, krank oder hilflos ist, möchte nicht alleingelassen werden. Vielerorts werden Sterbende umsichtig und mitfühlend betreut, etwa in Familien und Hospizen“, so Kardinal Lehmann."
                                            },
                                            {
                                                "example_id": "38121d4c-4999-4a76-bf0c-8560f556626d",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "SRF: „Was ist für Sie ein «guter Schweizer»?“ Yvonne Brändle Amolo: „Ein guter Schweizer ist mitfühlend, solidarisch, offen und neugierig.“"
                                            },
                                            {
                                                "example_id": "b05131ab-a520-480b-adaa-36014e4333a8",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "Eindringlich und mitfühlend erzählt Alex Capus eine Dreiecksgeschichte, die teilweise mit derjenigen seines Grossvaters übereinstimmt. [Anmerkung: 'Grossvater' ist Schweizer Rechtschreibung]"
                                            },
                                            {
                                                "example_id": "3e1d295e-cbbc-45dd-a3c5-699e84229413",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "Trotz Nataschas Bemühungen kann Michael ihr nicht verzeihen. Als Xenia Michael mitfühlend tröstet, lässt dieser sich zu einem folgenreichen Schritt hinreißen."
                                            },
                                            {
                                                "example_id": "d6cc2897-d679-4038-bb78-48df3a820cc3",
                                                "sense_id": "9f114c00-1d25-35f3-8ed5-39f913a16ae9",
                                                "text": "Wenig mitfühlend wirkt hingegen das von Gandhi bekämpfte Kastensystem, das die Ungleichheit von Menschen mit unerbittlicher Vehemenz zementiert und religiös rechtfertigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
