                                                "sense_id": "e167cb97-df4a-3601-83f3-81a658997d27",
                                                "text": "Honeying and making love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9e3394-e204-313e-9e73-b8df4e0490d6",
                                        "entry_id": "2ea22b1a-58a9-38d3-9b30-e660a4765c8c",
                                        "glosses": [
                                            "To be or become obsequiously courteous or complimentary; to fawn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e2e41b1-f33b-4272-855b-cace97993eff",
                                                "sense_id": "8d9e3394-e204-313e-9e73-b8df4e0490d6",
                                                "text": "[O]ne / Discuss'd his tutor, rough to common men / But honeying at the whisper of a lord; / And one the Master, as a rogue in grain / Veneer'd with sanctimonious theory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
