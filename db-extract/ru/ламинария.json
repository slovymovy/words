                                "target_senses": [
                                    {
                                        "sense_id": "c4dc2348-240d-37e5-833d-1771fd80b82f",
                                        "entry_id": "61a23f99-8811-3cd4-bc4a-963cf9078dec",
                                        "glosses": [
                                            "Any of the genus Laminaria of brown algae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ccb2710-e770-4c46-bdbc-34a10b77cfd3",
                                                "sense_id": "c4dc2348-240d-37e5-833d-1771fd80b82f",
                                                "text": "The stands of sea tangles and long-stalked laminarias are, in their way, an Atlantic counterpart of the great submarine jungles of the Pacific, where the kelps rise like giant forest trees, 150 feet from the floor of the sea to the surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c553a9e-0726-3603-84a7-030ecd0aa21e",
                                        "entry_id": "61a23f99-8811-3cd4-bc4a-963cf9078dec",
                                        "glosses": [
                                            "A thin rod made of the dried stems of this alga, used to dilate the cervix."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
