                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new library <w>neighbors</w> the historical museum downtown.",
                            "target_lang_translations": {
                                "ru": "Новая библиотека <w>соседствует</w> с историческим музеем в центре города.",
                                "es": "La nueva biblioteca <w>colinda con</w> el museo histórico en el centro."
                            }
                        },
                        {
                            "text": "Our property <w>neighbors</w> a large forest reserve to the north.",
                            "target_lang_translations": {
                                "ru": "Наш участок <w>граничит</w> с большим лесным заповедником на севере.",
                                "es": "Nuestra propiedad <w>limita con</w> una gran reserva forestal al norte."
                            }
