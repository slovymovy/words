                "senses": [
                    {
                        "sense_id": "81164445-5ff3-360b-b645-ddceb66784a2",
                        "entry_id": "d0dc42d4-bd32-3e1c-8569-8374f37f04c5",
                        "glosses": [
                            "полностью исчезнуть, умереть поголовно, не оставив потомства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87280b69-1b9f-476b-8cb4-65bff3a2923f",
                                "sense_id": "81164445-5ff3-360b-b645-ddceb66784a2",
                                "text": "По данным палеонтологии, динозавры вымерли в конце мелового периода, около 65 миллионов лет назад."
                            }
                        ]
                    },
                    {
                        "sense_id": "59820be0-13f4-3677-9d50-fb517f5fa94c",
                        "entry_id": "d0dc42d4-bd32-3e1c-8569-8374f37f04c5",
                        "glosses": [
                            "опустеть, лишиться обитателей вследствие их смерти"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfe0db1f-7c31-44f8-a906-d39ee7b7a812",
                        "source_entry_id": "d0dc42d4-bd32-3e1c-8569-8374f37f04c5",
                        "source_sense_description": "исчезнуть, умереть поголовно",
                        "target_lang_word": "die out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "die out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                        "entry_id": "940f2481-f726-3daf-bc1a-03922e120e5f",
                                        "glosses": [
                                            "To become extinct."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8379c0c-d42c-4486-bb90-52dcc28092fc",
                                                "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                                "text": "The dinosaurs died out a long time ago."
                                            },
                                            {
                                                "example_id": "f3f3f360-d6c7-4bbc-b522-94accfdd2ff2",
                                                "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway,[…]."
                                            },
                                            {
                                                "example_id": "92908128-2af9-4859-bc56-955b960ce7ca",
                                                "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                                "text": "Shepard: I thought you always needed another species to serve as one of the parents.\nLiara: Think about it, Shepard. If we were not able to mate with our own species, we would have died out long before we ever mastered space flight and left our homeworld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9314969d-44f8-3ac7-a054-4effb129b6bd",
                                        "entry_id": "940f2481-f726-3daf-bc1a-03922e120e5f",
                                        "glosses": [
                                            "To cease gradually."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a33931a-1a2e-4ae8-b102-93ed540e59c6",
                                                "sense_id": "9314969d-44f8-3ac7-a054-4effb129b6bd",
                                                "text": "The prejudice has died out."
                                            },
                                            {
                                                "example_id": "f762d12c-ce5c-4673-95e7-b362c7a747dd",
                                                "sense_id": "9314969d-44f8-3ac7-a054-4effb129b6bd",
                                                "text": "However, apart from all this, the Chief was a grand old man, belonging to a class of individualists which seems to be dying out in these days, when standard behaviour seems to be as prevalent as standard designs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
