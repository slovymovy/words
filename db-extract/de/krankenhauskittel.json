                "senses": [
                    {
                        "sense_id": "f8db31f6-2da3-3862-8043-7131e3625edf",
                        "entry_id": "3ece39aa-408b-350f-8d62-8945e66de2c7",
                        "glosses": [
                            "Kittel, der von Krankenhauspatienten getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed2ad5e-b8b2-4fab-9cf2-0875a7ec0231",
                                "sense_id": "f8db31f6-2da3-3862-8043-7131e3625edf",
                                "text": "„Der Junge schlug die Augen auf und sah ein Gespenst in einem Krankenhauskittel vor sich, mit blinden und zugeschwollenen Augen, den Kopf rasiert und mit frischen Operationsnarben überzogen.“"
                            },
                            {
                                "example_id": "858ba113-4ce7-4537-89e7-7d19e6d1b6c5",
                                "sense_id": "f8db31f6-2da3-3862-8043-7131e3625edf",
                                "text": "„In der Ecke der Zelle sank er zu Boden, und dort ließen sie ihn im durchnässten Krankenhauskittel zurück, während sich das Metallgitter klirrend schloss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
