                "translations": [
                    {
                        "translation_id": "fa040077-db84-49a8-a159-9e3bdfe992aa",
                        "source_entry_id": "a01379fa-e388-36f0-9d29-a02288ad86c6",
                        "source_sense_description": "a sea nymph",
                        "target_lang_word": "Calypso",
