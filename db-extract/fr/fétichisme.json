                ],
                "senses": [
                    {
                        "sense_id": "51f9ad51-92fe-3333-8083-c39de71766c0",
                        "entry_id": "77851de8-416a-39ab-b5b5-5a30196dea3a",
                        "glosses": [
                            "fetishism"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "3df669bc-f927-4b1c-bc2b-1f8b35f76d52",
                                "sense_id": "51f9ad51-92fe-3333-8083-c39de71766c0",
                                "text": "Le fétichisme est le culte des idoles, objets auxquels on attribue un pouvoir magique.",
                                "translation": "Fetishism is the worship of idols, objects to which magic powers are attributed.",
                                "english": "Fetishism is the worship of idols, objects to which magic powers are attributed."
                            }
                        ]
                    },
                    {
                        "sense_id": "576529d0-a202-3b18-b206-2acc907e2b5e",
                        "entry_id": "77851de8-416a-39ab-b5b5-5a30196dea3a",
                        "glosses": [
                            "adoration of a false god"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4925f1bb-6ed3-40cf-8c3f-514d39e57ab7",
                                "sense_id": "576529d0-a202-3b18-b206-2acc907e2b5e",
                                "text": "le fétichisme de l'argent",
                                "translation": "the cult of money",
                                "english": "the cult of money"
                            }
                        ]
                    },
                    {
                        "sense_id": "5855e50b-f26f-3ca7-a832-8d94d380f43f",
                        "entry_id": "77851de8-416a-39ab-b5b5-5a30196dea3a",
                        "glosses": [
                            "fetishism; fetish"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "10d4792d-9395-44bb-8e28-34a869031833",
                                "sense_id": "5855e50b-f26f-3ca7-a832-8d94d380f43f",
                                "text": "Si les fétichismes du pied ou de la chevelure, pour ne retenir que les deux extrêmes de notre géographie physique, semblent présenter des accointances moins directes avec la sexualité que l'attention portée aux orifices, ils attestent que les conséquences érotiques des fixations secondaires sont souvent, dans la littérature, provocatrices d'un imaginaire plus distrayant que celui qu'inspirent les sempiternelles pénétrations."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
