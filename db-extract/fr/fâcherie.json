                        "sense_id": "2dd24cd9-4872-3417-b90e-db58c222deb0",
                        "entry_id": "3c9f1538-1a9f-3317-bdf5-387855186107",
                        "glosses": [
                            "État de celui qui est fâché plus ou moins fortement contre quelqu’un."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "55afbce3-3666-4979-90da-1da450a6d8c3",
                                "sense_id": "2dd24cd9-4872-3417-b90e-db58c222deb0",
                                "text": "Sa fâcherie ne durera pas."
                            },
                            {
                                "example_id": "7f7c2392-1c64-4da7-bb73-aa52d4fa0a1a",
                                "sense_id": "2dd24cd9-4872-3417-b90e-db58c222deb0",
                                "text": "Il y a un peu de fâcherie entre eux."
                            },
                            {
                                "example_id": "b22bf286-1f41-4063-95d7-92078bee22c7",
                                "sense_id": "2dd24cd9-4872-3417-b90e-db58c222deb0",
                                "text": "Pascal, au fond, était heureux de cette fâcherie avec sa mère, qui le délivrait de la continuelle inquiétude de sa présence."
                            },
                            {
                                "example_id": "cc7df9c2-f936-4b1e-a3e1-640033a0937d",
                                "sense_id": "2dd24cd9-4872-3417-b90e-db58c222deb0",
                                "text": "Emmedée a pu aussi éprouver de la fâcherie à mon égard."
                            }
                        ]
                    }
                ],
