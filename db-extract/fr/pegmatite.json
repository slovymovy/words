                "senses": [
                    {
                        "sense_id": "b72fe54f-7440-38b0-9c6f-1a609677bb2c",
                        "entry_id": "2eea36b7-6321-353a-93b3-4862c6fb83f4",
                        "glosses": [
                            "Roche le plus souvent filonienne, à cristaux de grande taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa70ce9-40f7-4b79-9387-af091c5504eb",
                                "sense_id": "b72fe54f-7440-38b0-9c6f-1a609677bb2c",
                                "text": "Quelques filons de pegmatite, roche dont la décomposition fournit le kaolin, employé dans la fabrication des porcelaines, sillonnent çà et là ces masses granitiques, parsemées en outre de quelques rognons de quarz et de veines de mica."
                            },
                            {
                                "example_id": "fe81bfe9-07b5-45df-b265-e219ae640449",
                                "sense_id": "b72fe54f-7440-38b0-9c6f-1a609677bb2c",
                                "text": "La triplite a été décelée dans les pegmatites et filons de quartz stannifères des régions de Kaïlo et de Kisanda. Macroscopiquement, la triplite de couleur rose (Kaïlo) à brun clair (Kisanda) possède des clivages nets."
                            }
                        ]
                    }
                ],
