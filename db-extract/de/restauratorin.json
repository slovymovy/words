                "senses": [
                    {
                        "sense_id": "3b31ca37-bfb4-3e49-b6b3-0e434f56ae45",
                        "entry_id": "2be5ba96-aa9f-3ec5-bb9a-f9f88d344bf9",
                        "glosses": [
                            "weibliche Person, die aufgrund ihrer Ausbildung dazu in der Lage ist, Restaurierungsarbeiten fachgerecht durchzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d16b7e7-5c57-4d68-8681-8a1e4c15777f",
                                "sense_id": "3b31ca37-bfb4-3e49-b6b3-0e434f56ae45",
                                "text": "„Die Restauratorin und Fotohistorikerin Mila Moschik zeigt im Wiener Photoinstitut Bonartes ihre Rahmensammlung, die einen spannenden Streifzug durch die Zeiten bietet.“"
                            },
                            {
                                "example_id": "e52f6c70-edb4-4316-8550-700010a6ed86",
                                "sense_id": "3b31ca37-bfb4-3e49-b6b3-0e434f56ae45",
                                "text": "„Immerhin bin ich keine Abenteuerreisende oder Forscherin, sondern Restauratorin, und meine Toleranz gegenüber Aufregung und Überraschung ist auch nicht gerade die größte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
