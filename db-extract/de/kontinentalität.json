                ],
                "senses": [
                    {
                        "sense_id": "0fafc212-56e8-3bfe-a0fb-18fb6e7f2dc9",
                        "entry_id": "9efa980a-80c7-34a0-bacf-54549fbeccba",
                        "glosses": [
                            "Eigenschaft eines Klimas, von einer Landmasse (Kontinent) geprägt zu sein; Grad, in dem das Klima nicht maritim ist (sondern kontinental)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c83e23-f817-4cbe-bb33-fd22ab26afe1",
                                "sense_id": "0fafc212-56e8-3bfe-a0fb-18fb6e7f2dc9",
                                "text": "„Die Kontinentalität des Klimas ist also in Nordeurasien insgesamt angestiegen. Die Erklärung dieses Vorganges liegt zum Teil in der Entstehungsgeschichte Nordeurasiens begründet.“"
                            },
                            {
                                "example_id": "0426c884-a1d4-4173-aa71-f53b51858782",
                                "sense_id": "0fafc212-56e8-3bfe-a0fb-18fb6e7f2dc9",
                                "text": "„In ähnlicher Weise kann man auch von der Niederschlagsverteilung her zu einer Kennzeichnung der Kontinentalität kommen (hygrische Kontinentalität).“"
                            },
                            {
                                "example_id": "d8e6ee0e-45d2-4f7a-8e38-afc1777ff914",
                                "sense_id": "0fafc212-56e8-3bfe-a0fb-18fb6e7f2dc9",
                                "text": "„Die randlichen und die zentralen Gebiete der Kontinente unterscheiden sich dadurch, daß der Einfluß des Meeres mit wachsender Entfernung von der Küste immer geringer wird und daher die Maritimität (Beeinflussung durch das Meer) zunehmend durch kontinentale Klimazüge (Kontinentalität) ersetzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
