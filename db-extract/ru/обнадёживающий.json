                ],
                "senses": [
                    {
                        "sense_id": "d48e4f3a-e394-3a9d-a446-7ea2e8000330",
                        "entry_id": "b2debeae-9cc1-3529-812b-cecda449e543",
                        "glosses": [
                            "действ. прич. наст. вр. от обнадёживать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "4a0320cb-6120-4585-9a70-fe42fedb3c77",
                                "sense_id": "d48e4f3a-e394-3a9d-a446-7ea2e8000330",
                                "text": "Несмотря на небольшой опыт наблюдения, результаты использования преортодонтических трейнеров при лечении детей с аномалиями прикуса весьма обнадеживающие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01393d1b-53ee-4678-a231-d1332967409a",
                        "source_entry_id": "b2debeae-9cc1-3529-812b-cecda449e543",
                        "source_sense_id": "d48e4f3a-e394-3a9d-a446-7ea2e8000330",
                        "target_lang_word": "reassuring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reassuring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2958d45-9e95-36f6-b602-1f76fa5064e4",
                                        "entry_id": "cdc654b3-cb39-3fe8-a498-07dac121141c",
                                        "glosses": [
                                            "present participle and gerund of reassure"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "reassuring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fea1ba5f-41b3-3056-9cc3-a1b46886a1f4",
                                        "entry_id": "c145fcfb-3554-3145-a1f6-4cc12c697106",
                                        "glosses": [
                                            "That reassures; causing or restoring comfort or confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b81f047-8d81-4c36-8214-a024cf435e37",
                                                "sense_id": "fea1ba5f-41b3-3056-9cc3-a1b46886a1f4",
                                                "text": "The face which emerged was not reassuring. It was blunt and grey, the nose springing thick and flat from high on the frontal bone of the forehead, whilst his eyes were narrow slits of dark in a tight bandage of tissue. […]."
                                            },
                                            {
                                                "example_id": "cb2ad96c-1713-4e5f-a3d1-441861a09a16",
                                                "sense_id": "fea1ba5f-41b3-3056-9cc3-a1b46886a1f4",
                                                "text": "It was reassuring to be back in the regent's warm embrace."
                                            },
                                            {
                                                "example_id": "ed0056aa-19c3-4a38-a9fa-cc86aaaf091d",
                                                "sense_id": "fea1ba5f-41b3-3056-9cc3-a1b46886a1f4",
                                                "text": "The manifesto talks of safeguards to ensure that freight operators receive fair access to the network. These may be reassuring words for the likes of DB Cargo, but the devil will be in the detail and freight operators will no doubt be pressing for that detail to include cheaper electricity and access charges."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reassuring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0480a6c0-e7f9-3b7f-ad06-9eaceb7605df",
                                        "entry_id": "3f39f6f3-04b1-3beb-b842-774c0e162ac8",
                                        "glosses": [
                                            "reassurance"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b2542b-9cf1-4b19-b47a-29fc8f1ebbb7",
                                                "sense_id": "0480a6c0-e7f9-3b7f-ad06-9eaceb7605df",
                                                "text": "Alfred trembled, and felt a great sinking inside, but he did what he could to conceal his misery, and to respond with some show of heart to the Major's kindly pettings and reassurings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e01cf8f-65c0-41b8-84d9-d6560ee3551d",
                        "source_entry_id": "b2debeae-9cc1-3529-812b-cecda449e543",
