    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9698ae6c-ece4-3905-9418-7607622eee27",
                    "sense_definition": "Door de wind ergens naartoe gevoerd worden of komen aandrijven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "windbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>waaien</w> in de herfst ontzettend veel dorre bladeren <w>aan</w> in onze achtertuin.",
                            "target_lang_translations": {
                                "de": "Im Herbst <w>wehen</w> unglaublich viele dürre Blätter in unseren Garten <w>an</w>."
                            }
                        },
                        {
                            "text": "Ze rook plotseling een frisse zeelucht die over de duinen kwam <w>aanwaaien</w>.",
                            "target_lang_translations": {
                                "de": "Sie roch plötzlich eine frische Meeresbrise, die über die Dünen <w>herangeweht kam</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "komen aanwaaien"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch den Wind irgendwohin getragen oder herbeigeweht werden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anwehen",
                                "target_lang_sense_clarification": "vom Wind herbeigeweht werden"
                            },
                            {
                                "target_lang_word": "herwehen",
                                "target_lang_sense_clarification": "durch Wind herantransportiert werden"
                            },
                            {
                                "target_lang_word": "herangeweht werden",
                                "target_lang_sense_clarification": "vom Wind herangetragen werden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa292d7e-bed7-33f8-b50f-7073ebf4ab28",
                    "sense_definition": "Zonder enige moeite of inspanning verkregen worden of lukken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_krijgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet hard studeren voor dit examen, want succes komt je echt niet <w>aanwaaien</w>.",
                            "target_lang_translations": {
                                "de": "Du musst fleißig für diese Prüfung lernen, denn der Erfolg <w>fliegt</w> einem wirklich nicht <w>zu</w>."
                            }
                        },
                        {
                            "text": "Hij dacht dat die promotie hem zomaar zou <w>aanwaaien</w>, maar hij vergiste zich.",
                            "target_lang_translations": {
                                "de": "Er dachte, dass ihm diese Beförderung einfach so <w>in den Schoß fallen</w> würde, aber er irrte sich."
                            }
                        }
                    ],
                    "synonyms": [
                        "toevallen"
                    ],
                    "common_phrases": [
                        "iemand komt aanwaaien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in de constructie 'iemand komt iets aanwaaien'."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem ohne jegliche Mühe oder Anstrengung zufallen oder gelingen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zufliegen",
                                "target_lang_sense_clarification": "mühelos zufallen oder gelingen (z. B. Erfolg)"
                            },
                            {
                                "target_lang_word": "zufallen",
                                "target_lang_sense_clarification": "ohne Mühe zuteilwerden"
                            },
                            {
                                "target_lang_word": "in den Schoß fallen",
                                "target_lang_sense_clarification": "ohne eigene Anstrengung geschenkt werden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}