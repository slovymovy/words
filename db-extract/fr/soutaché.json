                ],
                "senses": [
                    {
                        "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                        "entry_id": "e2e64412-7727-31ad-9a10-49f42fba898d",
                        "glosses": [
                            "Qui est garni d’une soutache."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f79b9147-b268-4852-b702-519ce890716a",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "Toutes me parurent un peu surannées dans leurs strictes toilettes de visite, robes ou tailleurs soutachés et cols de dentelle."
                            },
                            {
                                "example_id": "ceff75ed-c409-4c8e-abdb-c47c311a9372",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "C’était une très belle et très forte fille dotée d’une poitrine merveilleuse qu’un caraco cintré et soutaché mettait bigrement bien en valeur."
                            },
                            {
                                "example_id": "f31f385a-28d6-4fd8-b141-b02dda847f78",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "Elle se réjouissait d’apercevoir de jolies Bretonnes, en costume soutaché et brodé, comme au théâtre, de boire du lait, dans des fermes !"
                            },
                            {
                                "example_id": "cac7d201-b42c-449a-acce-4b8164759441",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "À l’intérieur de ce wagon je remarque quelques Sarthes de grande et fière mine, drapés de leurs longues robes à couleurs voyantes, sous lesquelles passent les bottes en cuir soutaché."
                            },
                            {
                                "example_id": "8a18b25a-a367-4708-9452-f8bd48357ec4",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "Il était très joliment mis, en veste et en culotte de velours noir, soutachées de ganse d’or."
                            },
                            {
                                "example_id": "1eb3416a-35e9-4436-a11e-4132fa948117",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "Elle était vêtue d'une tunique ponceau, soutachée de broderies géorgiennes."
                            },
                            {
                                "example_id": "e5049ea4-8a2a-4834-b98e-9caa33e746f1",
                                "sense_id": "30361fdb-da46-32ab-9f4b-deff4c821cf2",
                                "text": "Elle remit d’un geste docile son collet marron, soutaché. Le col médicis encadrait bizarrement sa figure flasque où le nez en l’air, un nez « fripon », pouvait seul éveiller le souvenir de son passé."
                            }
                        ]
                    }
