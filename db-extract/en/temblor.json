                        "sense_id": "d1b3aea3-5bb7-3e96-8055-174fb16605ae",
                        "entry_id": "05d78102-7f3f-3ef7-8dea-44fac02031fc",
                        "glosses": [
                            "An earthquake."
                        ],
                        "tags": [
                            "Philippines",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "0e494a72-6ffe-46d3-b8f9-b70f8217b802",
                                "sense_id": "d1b3aea3-5bb7-3e96-8055-174fb16605ae",
                                "text": "Ever since the San Francisco earthquake of April 18, 1906, scientists have been warning that it is just a matter of time before another major temblor strikes the Bay Area."
                            },
                            {
                                "example_id": "fd3b1e11-cd8c-4a3b-aec8-0ec7eaaf99fd",
                                "sense_id": "d1b3aea3-5bb7-3e96-8055-174fb16605ae",
                                "text": "The earthquake's intensity, which gauges the actual effect of a temblor, was measured 4 on Taiwan's 7-tiered intensity scale in Yichu, 3 in Chiayi City and Tainan City's Chiali, as well as 2 in Yunlin County's Touliu City and Shuilin."
                            },
                            {
                                "example_id": "5682dd73-8d14-4de4-a51a-9f49704e5c43",
                                "sense_id": "d1b3aea3-5bb7-3e96-8055-174fb16605ae",
                                "text": "PNR trips were suspended at past 1 p.m. after the temblor struck Camarines Norte, but was felt in the city of Manila at Intensity 3."
                            },
                            {
                                "example_id": "c6957fd9-ac7d-4437-85f9-6a811bbfea0e",
                                "sense_id": "d1b3aea3-5bb7-3e96-8055-174fb16605ae",
                                "text": "Ukraine was already dealing with the temblors in the U.S. government."
                            }
                        ]
                    }
