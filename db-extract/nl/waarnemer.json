                            {
                                "example_id": "bd4e6da6-1229-42c9-817c-065b1befa93e",
                                "sense_id": "1b4e93e8-85b2-330a-bf43-7c15850760c0",
                                "text": "Een waarnemer die op de andere heuvel stond had de vogel wel kunnen zien."
