        "fr-extract.jsonl": [
            {
                "entry_id": "56ba524a-85c6-3296-ae2c-d6c6ab747adb",
                "word": "matras",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ccc11985-5cd1-3048-afb0-7dc7a233428f",
                        "entry_id": "56ba524a-85c6-3296-ae2c-d6c6ab747adb",
                        "glosses": [
                            "Récipient au col étroit et long utilisé en alchimie, puis en chimie et pharmacie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "676acd8c-af63-4e9b-a454-c5384ebec66e",
                                "sense_id": "ccc11985-5cd1-3048-afb0-7dc7a233428f",
                                "text": "Sur le fourneau étaient accumulés en désordre toutes sortes de vases, des fioles de grès, des cornues de verre, des matras de charbon."
                            },
                            {
                                "example_id": "46ed3ecd-2ad0-4c7d-9bbc-03a717b03251",
                                "sense_id": "ccc11985-5cd1-3048-afb0-7dc7a233428f",
                                "text": "Remplissez à moitié d'eau de vie un grand matras a long col & y ayant adapté un chapiteau & un recipient, lutez exactement les jointures."
                            },
                            {
                                "example_id": "2b1e2a26-45c3-4950-a649-6ddf400ad011",
                                "sense_id": "ccc11985-5cd1-3048-afb0-7dc7a233428f",
                                "text": "Le cerveau est le matras où l'animal transporte ce que, suivant la force de cet appareil, chacune de ses organisations peut absorber de cette substance, et d'où elle sort transformée en volonté"
                            },
                            {
                                "example_id": "895b1f3b-089a-4488-a102-bfd0cc220713",
                                "sense_id": "ccc11985-5cd1-3048-afb0-7dc7a233428f",
                                "text": "Ce cabinet était un réduit obscur, encombré d’alambics, de cornues et de matras."
                            },
                            {
                                "example_id": "aa704cae-1f28-4003-9882-f3bb034c0ed2",
                                "sense_id": "ccc11985-5cd1-3048-afb0-7dc7a233428f",
                                "text": "Au passage, il lança un coup d’œil au sol jonché de paille ayant servi à des emballages, puis aux tables chargées de matras, de fioles, de tubes, et de bien d'autres objets en verre utilisés pour les expériences."
                            }
                        ]
                    }
                ],
