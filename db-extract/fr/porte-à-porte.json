                                        "entry_id": "3a841729-ce99-32b6-9ec0-082d73dda627",
                                        "glosses": [
                                            "Going from house to house, when selling, delivering or asking for something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1469a897-66cf-3a4c-9e9b-79bbe4093c9e",
                                        "entry_id": "3a841729-ce99-32b6-9ec0-082d73dda627",
                                        "glosses": [
                                            "Sent or delivered from a store or factory directly to a house."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92031e71-0c02-4bac-8a4b-eb9be060a7e1",
                                                "sense_id": "1469a897-66cf-3a4c-9e9b-79bbe4093c9e",
                                                "text": "They must secure a higher share of the consumer goods which require transport not from siding-to-siding, but door-to-door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e941579c-8b87-4c1f-93ad-106248e78521",
                        "source_entry_id": "ae5cd6a7-5365-385e-b226-a1a7b509804f",
