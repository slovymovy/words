                "senses": [
                    {
                        "sense_id": "0880d7f6-0253-3e23-9c93-aa94d3ab7561",
                        "entry_id": "4eaf0328-89c0-31ff-8480-cb7d8ad8cbb2",
                        "glosses": [
                            "hearsay; report; that which one has heard from others"
                        ],
                        "tags": [
                            "neuter",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "6a756a59-efbf-4bbd-b6df-88ac18c98b49",
                                "sense_id": "0880d7f6-0253-3e23-9c93-aa94d3ab7561",
                                "text": "Ich kenne den Film vom Hörensagen.",
                                "translation": "I know the film by hearsay.",
                                "english": "I know the film by hearsay."
                            },
                            {
                                "example_id": "2890108e-45b9-4cfe-b292-16c90a5f5c6c",
                                "sense_id": "0880d7f6-0253-3e23-9c93-aa94d3ab7561",
                                "text": "Das ist doch reines Hörensagen!",
                                "translation": "That is nothing but hearsay!",
                                "english": "That is nothing but hearsay!"
                            },
                            {
                                "example_id": "97e768d4-b739-4740-b130-8b6383cfc342",
                                "sense_id": "0880d7f6-0253-3e23-9c93-aa94d3ab7561",
                                "text": "Ich kann mich in dieser Sache nicht aufs Hörensagen verlassen.",
                                "translation": "I can't rely on hearsay in this matter.",
                                "english": "I can't rely on hearsay in this matter."
                            },
                            {
                                "example_id": "43434846-e3d2-4b40-88ab-0d9ffc045c3b",
                                "sense_id": "0880d7f6-0253-3e23-9c93-aa94d3ab7561",
                                "text": "Du hast nicht die leiseste Ahnung / Kennst das alles nur vom Hörensagen"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
