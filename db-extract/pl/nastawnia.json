                "translations": [
                    {
                        "translation_id": "b9aec53b-6798-4042-8a1b-b7881620dcdd",
                        "source_entry_id": "02d3b052-6353-3ed1-91c3-ae6ac4158555",
                        "source_sense_id": "ba164338-b68c-3545-885d-bb5226e69449",
                        "target_lang_word": "signal box",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signal box",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8db08613-3b7a-3d32-9e9f-85f0307c6583",
                                        "entry_id": "09090647-3a8a-35d6-96ca-b686e3d877b0",
                                        "glosses": [
                                            "A building, typically adjacent to or spanning a railway line, from where signals, points and (sometimes) level crossings are controlled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4018a70-26fb-4267-b6fb-5a513f82db4a",
                                                "sense_id": "8db08613-3b7a-3d32-9e9f-85f0307c6583",
                                                "text": "This includes plans to run earlier [Sunday] services on the Derby to Crewe and Skegness routes, which will require Network Rail to open signal boxes on these lines earlier than at present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978878a8-34b3-35a4-9485-f86909237eec",
                                        "entry_id": "09090647-3a8a-35d6-96ca-b686e3d877b0",
                                        "glosses": [
                                            "The alarm-box of a police or fire alarm system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fbcc67c-68c3-44fd-896f-4e541e95c186",
                        "source_entry_id": "02d3b052-6353-3ed1-91c3-ae6ac4158555",
                        "source_sense_id": "ba164338-b68c-3545-885d-bb5226e69449",
                        "target_lang_word": "stavědlo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "54a9f918-c62e-48fa-ac87-37c4f2c0630b",
                        "source_entry_id": "02d3b052-6353-3ed1-91c3-ae6ac4158555",
                        "source_sense_id": "ba164338-b68c-3545-885d-bb5226e69449",
                        "target_lang_word": "Stellwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stellwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                        "entry_id": "c28064b5-4acf-3999-9728-eded15a2c85c",
                                        "glosses": [
                                            "„[…] eine Bahnanlage der Eisenbahn, von der aus Einrichtungen im und am Schienenfahrweg, wie Weichen und Signale, zur Durchführung von Zugfahrten und beim Rangieren zentral gestellt werden“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a408baa7-4b02-4209-aa02-1472a43ddb45",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "Stellwerke dürfen nur von speziell dafür ausgebildeten Personen bedient werden."
                                            },
                                            {
                                                "example_id": "3899f838-5af0-4f51-b9a2-99a532af00c4",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "„15.000 Fahrgäste waren laut ÖBB am Freitag von den Zugverspätungen durch den Kabelbrand im Stellwerk betroffen.“"
                                            },
                                            {
                                                "example_id": "be5c66be-162f-4c48-a402-9d3e9d9c95d0",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "„In einigen Stellwerken müssen Signale noch über mechanische Hebel gestellt werden, das ist nicht unbedingt ein moderner Arbeitsplatz.“"
                                            },
                                            {
                                                "example_id": "1f1c3e47-d1d4-43b3-af15-d6d48bd113f9",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "„Die Modernisierung der Stellwerke gehe langsamer voran als gedacht, und »Arbeitsplätze mit veralteter technischer Ausstattung« seien für viele junge Leute »nicht hinreichend attraktiv«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
