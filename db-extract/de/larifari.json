                        "examples": [
                            {
                                "example_id": "e5cc2be8-fd2e-4885-bf33-022c44f71c92",
                                "sense_id": "fd53af10-9ecc-304d-bb33-cd921d4af273",
                                "text": "Was soll dieses Larifari? Sag doch endlich, worum es Dir wirklich geht!"
                            },
                            {
                                "example_id": "ab4e8e7b-683c-48ee-85dc-c19d15a7a9f6",
                                "sense_id": "fd53af10-9ecc-304d-bb33-cd921d4af273",
                                "text": "„Den Mann kenne ich, und deshalb müssen wir auch nicht viel Larifari am Telefon machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c032262-7f3e-3928-831c-7b0571a59a07",
                        "entry_id": "f97aa384-8c68-39f3-8bd8-d94f231ed0a5",
