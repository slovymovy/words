                        "translation_id": "1b29ff79-9fad-48f5-b6f6-8714df677993",
                        "source_entry_id": "222179fd-de5b-3609-83b7-6e4179fc74ed",
                        "source_sense_id": "1b03b86c-d44b-395c-9c7c-f47534510c57",
                        "source_sense_description": "Eigenschaft/Haltung/Handlungsweise, die Verhalten frei von Bedenken und Rücksicht zeigt",
                        "target_lang_word": "recklessness",
                        "target_lang_code": "en",
