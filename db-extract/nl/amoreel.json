                "senses": [
                    {
                        "sense_id": "3666a75f-8e5e-3526-8c4b-3f304e297a99",
                        "entry_id": "79058650-7ec5-39eb-bc20-0b275726da8c",
                        "glosses": [
                            "zonder ethisch besef, maar het hoeft niet per se tegen het ethisch gevoel in te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b66708e-c3ae-4e10-934b-5bc26d9e3a8a",
                                "sense_id": "3666a75f-8e5e-3526-8c4b-3f304e297a99",
                                "text": "Oscar was totaal amoreel wat dit allemaal betrof."
                            },
                            {
                                "example_id": "1fd2ccb6-f639-404e-aaca-dabe9f77c15e",
                                "sense_id": "3666a75f-8e5e-3526-8c4b-3f304e297a99",
                                "text": "Net als George A. Romero in zijn zombiecyclus Night of the Living Dead (1968), die de status van klassieker heeft, gebruikt regisseur-scenarist Yeon Sang-ho het zombiegenre vooral om milde maatschappijkritiek te geven. Zo wordt hoofdpersoon Seok-woo, een amorele, gevoelsarme fondsenbeheerder die zijn van hem vervreemde dochter naar haar moeder brengt, expliciet gelijkgesteld aan een bloedzuiger. Hij aast immers op het kapitaal van de hardwerkende Koreaan."
                            }
                        ]
                    }
                ],
