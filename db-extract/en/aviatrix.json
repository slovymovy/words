                ],
                "senses": [
                    {
                        "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                        "entry_id": "97c74446-72f7-3145-89c4-3245f0daaa01",
                        "glosses": [
                            "A female aviator."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0f18633d-6fd6-422c-bfcb-2d8059202526",
                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                "text": "“... — Did you know that she was an aviatrix?” he interjected."
                            },
                            {
                                "example_id": "ac518582-2c02-4b2c-8681-047cbed814b4",
                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                "text": "The Women Flyers: From Aviatrix to Astronaut"
                            },
                            {
                                "example_id": "6cb8d664-08d6-4115-9a16-97ca4aa0b009",
                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                "text": "Hariet Quimby, a writer for Leslie's Weekly, in 1911 became the first American aviatrix and won international accalim in 1912 as the first woman to pilot a plan across the English Channel."
                            },
                            {
                                "example_id": "384c5335-7334-4452-ae80-6434ce2446dc",
                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                "text": "In 1929 she turned an ide that she ‘stole’ from her son into a screenplay, Wings in the Dark, featuring a protagonist based on Ameria Earhart, the famous aviatrix with whom Shipman was acquainted..."
                            },
                            {
                                "example_id": "9ba20480-5564-44ab-b7fa-a82f72c4190a",
                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                "text": "2018 summary of 2009 film Amelia\nFrom the time she first sits in the pilot's seat, aviatrix Amelia Earhart (Hilary Swank) feels destined to achieve great things."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffc439fd-8bb6-429f-a4ad-b3550eb6cb62",
                        "source_entry_id": "97c74446-72f7-3145-89c4-3245f0daaa01",
                        "source_sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                        "source_sense_description": "Translations",
                        "target_lang_word": "aviatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aviatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "295c3ab7-410f-3bab-9ecf-ed662b290fd6",
                                        "entry_id": "9b5ff325-592b-3b24-864d-786735738a10",
                                        "glosses": [
                                            "Pilote d’aéronef, en particulier d’avion."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "275a26e4-e18e-4bfc-b84c-82abb5cf5feb",
                                                "sense_id": "295c3ab7-410f-3bab-9ecf-ed662b290fd6",
                                                "text": "Elle était coiffée d’un casque d’aviatrice d’où dépassait une mèche blonde. Marignan m’expliqua qu’elle avait jadis battu des records du monde dans de « vieux coucous impossibles »."
                                            },
                                            {
                                                "example_id": "7274385d-a20d-41ec-ba51-15bfe474e8b9",
                                                "sense_id": "295c3ab7-410f-3bab-9ecf-ed662b290fd6",
                                                "text": "L’ancienne championne dans le domaine du cyclisme démontrant ainsi de grandes capacités en matière de locomotion aérienne, ce sera d’ailleurs la première aviatrice en Belgique à décrocher son brevet de pilote quelques mois plus tard, le 25 novembre 1910."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea5aac0-08fc-34c7-acfe-13567df6c6be",
                                        "entry_id": "9b5ff325-592b-3b24-864d-786735738a10",
                                        "glosses": [
                                            "Grade des Forces armées canadiennes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
