                                                "example_id": "4a4e06ae-a9fa-4fdd-ba7b-1f54eb0a2498",
                                                "sense_id": "a422a2a9-20d2-34e7-86ae-31fa1cc3bf5c",
                                                "text": "Après avoir appris les détails de cette folle nuit calaisienne, le DG de la police, furibard, a appelé le big boss des Compagnies républicaines de sécurité, lequel s’était bien garder de lui raconter l’histoire."
                                            },
                                            {
                                                "example_id": "b42d5c03-1a6e-4c09-b042-31ed489653ad",
                                                "sense_id": "a422a2a9-20d2-34e7-86ae-31fa1cc3bf5c",
                                                "text": "Il s’agirait d'un psychiatre calaisien de 45 ans."
                                            }
