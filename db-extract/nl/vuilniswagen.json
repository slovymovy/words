                        "source_sense_id": "79299440-13aa-306e-bdad-51b5779b367e",
                        "source_sense_description": "een auto van de vuilophaaldienst",
                        "target_lang_word": "benne à ordures",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benne à ordures",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb321bd-14cc-3e92-825b-97750991e210",
                                        "entry_id": "0a6a3fc3-f3b5-3258-a76a-a77c3ef25865",
                                        "glosses": [
                                            "Benne où l’on place les ordures, avant que cette benne soit transportée et vidée à la décharge."
                                        ],
                                        "tags": [
                                            "Déchets"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79cf661f-d8be-4bf8-8f01-761fa5d59786",
                                                "sense_id": "8eb321bd-14cc-3e92-825b-97750991e210",
                                                "text": "Geneviève Wiss-Vrignaud … a fait installer une benne à ordures sur le terrain pour éviter l’éparpillement des poubelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e0dbf5-0315-392c-8a83-a2527414eb99",
                                        "entry_id": "0a6a3fc3-f3b5-3258-a76a-a77c3ef25865",
                                        "glosses": [
                                            "Camion poubelle, camion à ordures, qui ramasse les déchets et les emmène à la décharge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8ce0ac-846e-4cdb-8f05-d0aa1d247f10",
                                                "sense_id": "31e0dbf5-0315-392c-8a83-a2527414eb99",
                                                "text": "Ses dirigeants ont développé un concept novateur de benne à ordures en aluminium de forme cylindrique à chargement latéral, munie d’un bras automatisé nommé Détritube."
                                            },
                                            {
                                                "example_id": "5b770029-2056-4fbf-b8a0-3834426fa5f4",
                                                "sense_id": "31e0dbf5-0315-392c-8a83-a2527414eb99",
                                                "text": "On l'a tuée d'un coup de couteau en plein cœur, sans doute un couteau de cuisine, avant de la jeter dans la benne à ordures. Heureusement, c'était une benne tasseuse... Si elle avait été broyeuse, on n'aurait pas retrouvé grand-chose !"
                                            },
                                            {
                                                "example_id": "f4ee1cc6-eca1-4caf-9502-63bc7c619052",
                                                "sense_id": "31e0dbf5-0315-392c-8a83-a2527414eb99",
                                                "text": "Un matin, je vidai ma boîte à lettres de toutes ses cartes postales et flanquai le lot entier dans une benne à ordures qui passait par là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
