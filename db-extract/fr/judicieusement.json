                                            {
                                                "example_id": "7bd888fc-4b58-4ebd-8be9-f9c64c536b35",
                                                "sense_id": "56d82f34-ee39-3d10-bec8-77249774e656",
                                                "text": "Bevor du nicht gescheit Rad fährst, können die Stützräder nicht ab."
