                "senses": [
                    {
                        "sense_id": "47fd6094-e253-32ae-a39e-cddcb5bfb0b1",
                        "entry_id": "49902f82-b4e2-347c-b043-2bd4049751b0",
                        "glosses": [
                            "действие по значению гл. раздробить"
                        ],
                        "tags": [],
