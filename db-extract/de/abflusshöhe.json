                "senses": [
                    {
                        "sense_id": "a18886a9-a641-3f60-a1d4-b0f3758a918d",
                        "entry_id": "f8c939ad-ebb8-3ae8-86c0-0ac5c8667320",
                        "glosses": [
                            "Höhe des Abflusses (eines Einzugsgebiets in einem bestimmten Zeitraum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754a3564-c7f2-4f88-9dd3-662a3fef7ccd",
                                "sense_id": "a18886a9-a641-3f60-a1d4-b0f3758a918d",
                                "text": "„Die Abflusshöhe berechnet sich aus dem Quotienten von Durchflussvolumen pro Zeiteinheit und der Fläche des Einzugsgebietes.“"
                            },
                            {
                                "example_id": "b46d8136-dabc-4292-ae4e-1fcbfbf8009e",
                                "sense_id": "a18886a9-a641-3f60-a1d4-b0f3758a918d",
                                "text": "„Die Abflusshöhe bezieht den Abfluss auf das zugehörige Einzugsgebiet.“"
                            },
                            {
                                "example_id": "8e5eeb1c-a798-4b7f-8f15-5cbceaab01f8",
                                "sense_id": "a18886a9-a641-3f60-a1d4-b0f3758a918d",
                                "text": "„Ob Hochwasser durch Schneeschmelze verursacht werden, kann man am Verhältnis von Abflusshöhe zum Gebietsniederschlag erkennen.“"
                            },
                            {
                                "example_id": "77f309d6-0154-4aa7-a080-589e803d2b4e",
                                "sense_id": "a18886a9-a641-3f60-a1d4-b0f3758a918d",
                                "text": "„Wenn die Schneeschmelze ein Hochwasser bedingt, dann ist die Abflusshöhe gleich dem Gebietsniederschlag oder sogar größer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
