                        "examples": [
                            {
                                "example_id": "09c5b23e-cf30-4132-9206-042acb7350a8",
                                "sense_id": "38275fd7-753f-3ee2-b26c-e8ad74656a3d",
                                "text": "Verslag van het Nationaal Jeugddebat. Scholieren uit het voortgezet onderweijs debattteren met ministers en staatssecretarissen over onder meer cyberpesten en milieu en gezondheid."
                            },
                            {
                                "example_id": "955a0816-aacc-4cbe-a63a-8417fb2c899f",
                                "sense_id": "38275fd7-753f-3ee2-b26c-e8ad74656a3d",
                                "text": "In Den Haag wordt het Nationale Jeugddebat gehouden, georganiseerd door de Nationale Jeugdraad. Normaal gesproken wordt het debat in de Tweede Kamer gehouden, maar dit jaar is gekozen voor een verkiezingsdebat. 130 Jongeren discussiëren met Tofik Dibi (GroenLinks), Rita Verdonk (TON), Marianne Thieme (PvdD), Boris van der Ham (D66), Ronald Plasterk (PvdA) en Renske Leijten (SP)."
                            }
                        ]
