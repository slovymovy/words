                        "examples": [
                            {
                                "example_id": "90038fd9-6a7c-4f91-a419-4b5562c896d1",
                                "sense_id": "1f6ff0a7-87f3-3289-a22e-03bccc035071",
                                "text": "Die Biogenese der Lebewesen erscheint uns manchmal wie ein Wunder."
