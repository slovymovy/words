                "senses": [
                    {
                        "sense_id": "1f2f6ff3-d526-3bef-8b90-7776fd781cbf",
                        "entry_id": "918c4f4b-6097-3453-aedc-3633b72b3b98",
                        "glosses": [
                            "Définir l’origine de."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "279db7aa-5114-4451-87a1-2c4d876a6e6f",
                                "sense_id": "1f2f6ff3-d526-3bef-8b90-7776fd781cbf",
                                "text": "Originer l’humain. Pour comprendre donc la spécificité de l’humain, il faudra, dès lors, interroger les mécanismes et la complexité du vivant."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bab92b0-1681-32ed-9c40-2619b4708d26",
                        "entry_id": "918c4f4b-6097-3453-aedc-3633b72b3b98",
                        "glosses": [
                            "Avoir son origine."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0f89bc9f-ebaf-4f40-a58d-78c5af2ec8f1",
                                "sense_id": "3bab92b0-1681-32ed-9c40-2619b4708d26",
                                "text": "En ce sens toute religion est révélée, la religion biblique méritant cependant le nom spécifique de religion révélée en tant qu’elle affirme s’originer dans une révélation particulière qui a eu lieu dans le temps historique."
                            }
                        ]
                    }
