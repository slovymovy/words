                        "entry_id": "52ff8ddd-7f62-3ba5-86d1-c88fc0e7f4c9",
                        "glosses": [
                            "Actinote, silicate ferro-magnésien du groupe des amphiboles calciques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8adf5d-d571-4ad1-a70e-320b34a0ade3",
                                "sense_id": "9fd69655-a547-37b3-a61a-fb47052cb637",
                                "text": "Elle apparaît sous forme massive en remplissage de petites diaclases, mais aussi en cristaux, associée à l’amiante (ferro-actinolite et actinolite) fibreuse verte ou blanche."
                            },
                            {
                                "example_id": "095c3afb-a59b-44de-87da-4bf4f6645c8e",
                                "sense_id": "9fd69655-a547-37b3-a61a-fb47052cb637",
                                "text": "Le physico-chimiste et toxicologue Henri Pézerat confirme que les cas locaux de fibrose sont dus à « une surexposition aux poussières d’actinolite »."
                            }
                        ]
                    }
