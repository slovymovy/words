                        "entry_id": "614b388e-e1f9-3a58-9d84-fbef5e3ce748",
                        "glosses": [
                            "Finir par convaincre par ses paroles, amadouer."
                        ],
                        "tags": [
                            "Régional"
                        ],
                        "examples": [
                            {
                                "example_id": "b6ac0c33-b5d3-4f2c-bac1-87417ac59fc0",
                                "sense_id": "59440d64-b110-3625-852b-847c3faf6031",
                                "text": "Mais ce n'était pas un gars à savoir les amiauler."
                            },
                            {
                                "example_id": "ab17b8e8-bbc4-4681-8242-75aaeec9a41a",
                                "sense_id": "59440d64-b110-3625-852b-847c3faf6031",
                                "text": "Y me semblait, par-dessus tout, que si j'arais eu le front, j'm'arais pas laissé amiauler par Florent jusqu'à lâcher l'amarre malgré l'apercevance de mauvais temps."
                            }
                        ]
                    }
