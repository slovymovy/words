                        "examples": [
                            {
                                "example_id": "a2261fc0-b474-4f81-a382-7613ded83b34",
                                "sense_id": "837f3374-1f45-3174-9a0c-0108d977e1a5",
                                "text": "Un coup chez les épiciers, une autre fois chez les marchands de trottins ; un dégringolage par ci, un tapage par là ; je fais la manche dans les grands cafés ; je leur apporte du perlot, quand ils sont au jetard et qu’ils n'ont pas de quoi fumer …."
                            },
                            {
                                "example_id": "060e7912-28ee-459e-bfff-0b2e091425f6",
                                "sense_id": "837f3374-1f45-3174-9a0c-0108d977e1a5",
                                "text": "Vous parlez d’or, Réséda !... tenez ces écrivains de génie, M. M... M. C... M. L... Mme G... qu’ont sûrement pas été au jetard, qu’ont toujours été fonctionnaires, du double, triple, et quadruple jeu..."
                            }
