                        "examples": [
                            {
                                "example_id": "1df3d351-76d0-49ab-a53c-6657bee6cd46",
                                "sense_id": "d35bcded-5484-3890-8bef-6ac090060ee8",
                                "text": "Luisteraars van 3FM konden tentjes aandragen voor de test; van die suggesties werden er vier meest genoemde testexemplaren uitgekozen. De ANWB droeg zelf het vijfde proefexemplaar aan."
                            },
                            {
                                "example_id": "977de70e-4081-4ddf-b09e-38d6122f3ae3",
                                "sense_id": "d35bcded-5484-3890-8bef-6ac090060ee8",
                                "text": "Het was de eerste keer dat mensen een proefexemplaar van een zwart gat konden bestuderen onder laboratoriumomstandigheden en er werden veel ontdekkingen gedaan die goed waren voor de ontwikkeling van theoretische natuurkunde en elementaire kosmologie, maar met geen van deze resultaten kwam men verder met de taak om de snelheid van licht in een vacuüm te verlagen."
                            }
                        ]
