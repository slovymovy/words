                                "pl": "Grzecznie <w>uśmiecham się</w> do klienta.",
                                "de": "Ich <w>lächle</w> dem Kunden höflich zu.",
                                "fr": "Je <w>souris</w> poliment au client.",
                                "it": "Io <w>sorrido</w> educatamente al cliente.",
                                "cs": "Zdvořile se na zákazníka <w>usmívám</w>.",
                                "tr": "Müşteriye kibarca <w>gülümsüyorum</w>.",
                                "es": "Le <w>sonrío</w> cortésmente al cliente."
                            }
