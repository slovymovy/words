    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b6cde5c8-3065-3ac5-83b1-6ca6911db751",
                "word": "nitwit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "03ba7b70-1cb1-43c5-9561-cac5b0b890d3",
                        "entry_id": "b6cde5c8-3065-3ac5-83b1-6ca6911db751",
                        "tags": [
                            "plural"
                        ],
                        "form": "nitwits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                        "entry_id": "b6cde5c8-3065-3ac5-83b1-6ca6911db751",
                        "glosses": [
                            "A scatterbrained or stupid person."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "392e9479-7982-4c3d-a9fb-614ffe8636df",
                                "sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                                "text": "If you don't remember you are a nitwit. If you do answer, well, you know what the penalty is for perjury."
                            },
                            {
                                "example_id": "6b6446b2-d2b4-45e3-9ec3-c1c3f90e3106",
                                "sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                                "text": "\"Don't be a nitwit, honey!\" says Adele. \"Here, let me open the door! Ma be I did leave them lights on, though it ain't ike me!\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40118d89-9ddf-4d50-8671-09a7543d2564",
                        "source_entry_id": "b6cde5c8-3065-3ac5-83b1-6ca6911db751",
                        "source_sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                        "source_sense_description": "scatterbrained or stupid person",
                        "target_lang_word": "Schwachkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwachkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                        "entry_id": "b1503b93-8814-3d97-ac89-aa2dc89ef814",
                                        "glosses": [
                                            "Person, die man für geistig minderbemittelt hält; jemand, der nichts begreift"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc823dd6-7694-4ea9-9efd-7d93cecd2262",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "Man hat noch selten einen Schwachkopf wie dich erlebt."
                                            },
                                            {
                                                "example_id": "b517b2fe-0057-4f58-ab91-e5b86c73b5f6",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "Er versteht gar nichts, er ist ein richtiger Schwachkopf."
                                            },
                                            {
                                                "example_id": "3b3353a4-e562-4971-b30a-5ca645b408d9",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Dass ein Schwachkopf weniger fähig sein mag, die Schönheit einer Symphonie oder eines subtilen Gedankengangs zu genießen, glaubt man ohne Weiteres, im Hinblick auf beispielsweise eine Fellatio hingegen überrascht es; die Erfahrung bestätigt es dennoch.“"
                                            },
                                            {
                                                "example_id": "3b862ffc-9ccb-48b4-8d7a-434c4d216b44",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Ich war sehr besorgt, denn wenn der Geistliche kein Schwachkopf war, konnte ihm nicht verborgen bleiben, daß die Verblichene an Gift gestorben war.“"
                                            },
                                            {
                                                "example_id": "3019a9d8-ba2e-4d3c-b9a4-2e5b02b62372",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Sie schienen nicht zu merken, was für ein Schwachkopf ich geworden war.“"
                                            },
                                            {
                                                "example_id": "1d4d6de9-fddd-4a8c-abbd-e3c7dec50def",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Einmal, vor etwa achtzehn Monaten, habe ich über einhundert Stiche gebraucht, bis dieser Schwachkopf damals endlich tot war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd58c904-936d-4262-b2bb-aaaf4d48bd28",
                        "source_entry_id": "b6cde5c8-3065-3ac5-83b1-6ca6911db751",
                        "source_sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                        "source_sense_description": "scatterbrained or stupid person",
                        "target_lang_word": "Dummkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dummkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                        "entry_id": "b5ab529b-6045-333b-aa6e-fa5857841d8c",
                                        "glosses": [
                                            "dummer Mensch"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d766c218-9b4a-4a95-853b-f7216bb29309",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "Ich Dummkopf, dass ich die Schule abgebrochen habe!"
                                            },
                                            {
                                                "example_id": "cb12cc2a-833e-42e8-a38d-781479c290dd",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Nur Dummköpfe verlangen von euch, dass ihr eure Herkunft, eure Sprache und euren Glauben verleugnet.“"
                                            },
                                            {
                                                "example_id": "b0e128b8-38e9-4cbc-a6e9-ae178e29b143",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Heinrich Cuno ist ein unwissender Dummkopf, der sich vor Eitelkeit aufbläht.“"
                                            },
                                            {
                                                "example_id": "e24fcf47-41f7-4619-b127-a7ab3bd367c5",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Er war ein Dummkopf mit dem Verstand eines Hanswurstes und hielt alle, sie ihm zuhörten, für noch einfältiger.“"
                                            },
                                            {
                                                "example_id": "eb90df82-e3cd-4b6f-acf7-0cc6367134f7",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Ich muß an jener Frau wohl doch leidenschaftlicher gehangen haben, als ich selber wußte; sonst würde es mir nicht so schwerfallen, zuzugeben, daß jener Dummkopf sie geliebt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
