                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fcd00db-3f7f-4ffa-9624-65dd5e979951",
                                                "sense_id": "7046d1c9-d961-38e3-bcc5-ab9b2037b237",
                                                "text": "De Indiase regering krijgt het verwijt dat ze de persvrijheid inperkt."
                                            }
                                        ]
