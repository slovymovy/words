                        "source_entry_id": "29e04b9a-3af1-3aee-a3fe-0a37ad8f2439",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным безличие",
                        "target_lang_word": "impersonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impersonal",
