                                                "sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                                                "text": "Меня зовут Нина."
                                            },
                                            {
                                                "example_id": "c5a4e5a1-85c9-470c-a0af-6f8d23f1f645",
                                                "sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                                                "text": "И точно хороша // Была не в шутку маленькая Нина."
                                            },
