                                            {
                                                "example_id": "2d232a7f-4189-47a2-815d-945aefe48034",
                                                "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                                "text": "Quand on se rapproche des commerçants de Camden, on comprend que la réalité est peut-être plutôt dans le quotidien des travailleurs que dans les convictions antimonarchiques."
                                            },
                                            {
                                                "example_id": "0d29f8df-5661-4490-bfc3-ffc21f8659ac",
                                                "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                                "text": "Arnhem est une très jolie ville d’environ soixante mille habitants, […]. C'était là que se retiraient avant la guerre et depuis longtemps les commerçants hollandais qui avaient fait fortune aux Indes."
                                            },
                                            {
                                                "example_id": "468ea57b-cd84-4bc9-8bf3-c5ca556b4426",
                                                "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                                "text": "Sont commerçants ceux qui exercent des actes de commerce et en font leur profession habituelle."
                                            }
                                        ]
