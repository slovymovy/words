                                    {
                                        "sense_id": "adecd387-d99e-3967-a94f-e3beb92b1099",
                                        "entry_id": "0de519d9-87a6-3fb1-ba73-9c31b31bd33a",
                                        "glosses": [
                                            "That which is recollected; something called to mind; a reminiscence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d35242d-dc0e-494b-9181-493d091e07a8",
                                                "sense_id": "adecd387-d99e-3967-a94f-e3beb92b1099",
                                                "text": "One of his earliest recollections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf9b523-6643-3158-97ee-5d49cf4b3074",
                                        "entry_id": "0de519d9-87a6-3fb1-ba73-9c31b31bd33a",
                                        "glosses": [
                                            "The act or practice of collecting or concentrating the mind; concentration; self-control."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35725def-8107-4bae-8809-fbbcd1ae3ef9",
                                                "sense_id": "fcf9b523-6643-3158-97ee-5d49cf4b3074",
                                                "text": "From such an education Charles contracted habits of gravity and recollection."
                                            },
                                            {
                                                "example_id": "a8c66f93-242e-481b-86e8-8251cc064dff",
                                                "sense_id": "fcf9b523-6643-3158-97ee-5d49cf4b3074",
                                                "text": "In a world filled with media and electronic devices, recollection can be difficult."
                                            }
                                        ]
                                    },
