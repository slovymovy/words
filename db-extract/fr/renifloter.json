                "senses": [
                    {
                        "sense_id": "511ea34e-a4f9-3d9d-9e19-c3f7fa32251a",
                        "entry_id": "d8f1e720-c3c6-3cd3-87f4-8901663f68fd",
                        "glosses": [
                            "Renifler plus ou moins, avoir tendance à renifler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621ef4ea-75a4-4788-9ea6-a6dbcb2de849",
                                "sense_id": "511ea34e-a4f9-3d9d-9e19-c3f7fa32251a",
                                "text": "Mais bon, ma chienne aime tellement renifloter car dans les rues, il y a toujours plus de bonnes odeurs."
                            },
                            {
                                "example_id": "18c36764-7bf5-4852-aacc-72896ef371ec",
                                "sense_id": "511ea34e-a4f9-3d9d-9e19-c3f7fa32251a",
                                "text": "Personnellement je suis très résistante à la maladie (mauvaise herbe croît toujours) mais bon, il m'arrive de renifloter, de ci de là."
                            },
                            {
                                "example_id": "31cf363f-ecf3-43de-9a20-fd2840bb67ac",
                                "sense_id": "511ea34e-a4f9-3d9d-9e19-c3f7fa32251a",
                                "text": "Juliette reniflotait et tamponnait sans arrêt son petit nez rond tout luisant."
                            }
                        ]
                    }
