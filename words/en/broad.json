    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e2034b7-679a-3672-8450-6b437f605b2e",
                    "sense_definition": "Having a large distance from side to side; wide.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_width",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is very <w>broad</w> at this point, making it difficult to swim across.",
                            "target_lang_translations": {
                                "ru": "Река в этом месте очень <w>широкая</w>, поэтому её трудно переплыть."
                            }
                        },
                        {
                            "text": "He has <w>broad</w> shoulders from years of swimming and heavy lifting.",
                            "target_lang_translations": {
                                "ru": "У него <w>широкие</w> плечи после многих лет занятий плаванием и тяжелой атлетикой."
                            }
                        }
                    ],
                    "synonyms": [
                        "wide"
                    ],
                    "antonyms": [
                        "narrow",
                        "thin"
                    ],
                    "common_phrases": [
                        "broad shoulders",
                        "broad expanse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий большое расстояние от края до края; широкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "о физическом расстоянии"
                            },
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "о пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64cadea5-ff11-386a-86cb-8d15303c9219",
                    "sense_definition": "Covering a wide range of things; general rather than specific.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two parties are in <w>broad</w> agreement on the main goals of the project.",
                            "target_lang_translations": {
                                "ru": "Стороны достигли <w>общего</w> согласия по основным целям проекта."
                            }
                        },
                        {
                            "text": "She gave a <w>broad</w> outline of the plan without going into too much detail.",
                            "target_lang_translations": {
                                "ru": "Она изложила план в <w>общих</w> чертах, не вдаваясь в подробности."
                            }
                        }
                    ],
                    "synonyms": [
                        "general",
                        "wide-ranging"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "broad agreement",
                        "broad outline",
                        "broad range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охватывающий широкий круг вещей; общий, а не конкретный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "не детализированный"
                            },
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "о круге вопросов или согласии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a35f3ea-dabc-3737-8ecf-b719907207fb",
                    "sense_definition": "Comprehensive or inclusive in scope or content.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university offers a <w>broad</w> curriculum that includes both arts and sciences.",
                            "target_lang_translations": {
                                "ru": "Университет предлагает <w>широкую</w> учебную программу, включающую как гуманитарные, так и естественные науки."
                            }
                        },
                        {
                            "text": "We need to take a <w>broad</w> view of the situation to understand all the factors.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>шире</w> взглянуть на ситуацию, чтобы понять все факторы."
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehensive",
                        "all-encompassing",
                        "inclusive"
                    ],
                    "antonyms": [
                        "narrow",
                        "comprehensive"
                    ],
                    "common_phrases": [
                        "broad curriculum",
                        "broad view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всеобъемлющий или инклюзивный по охвату или содержанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "разносторонний"
                            },
                            {
                                "target_lang_word": "всесторонний",
                                "target_lang_sense_clarification": "охватывающий всё"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "644b88e8-0432-3c76-af04-15a3044c4034",
                    "sense_definition": "Relating to a strong or very noticeable regional accent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even after living in London for years, he still speaks with a <w>broad</w> Yorkshire accent.",
                            "target_lang_translations": {
                                "ru": "Даже прожив в Лондоне много лет, он всё ещё говорит с <w>сильным</w> йоркширским акцентом."
                            }
                        },
                        {
                            "text": "It was hard to understand his <w>broad</w> Scottish dialect at first.",
                            "target_lang_translations": {
                                "ru": "Поначалу было трудно понять его <w>грубый</w> шотландский диалект."
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "thick"
                    ],
                    "common_phrases": [
                        "broad accent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к сильному или очень заметному региональному акценту."
                    },
                    "translations": {
                        "ru": [
