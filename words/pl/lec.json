                            },
                            {
                                "target_lang_word": "полечь",
                                "target_lang_sense_clarification": "погибнуть в сражении"
                            },
                            {
                                "target_lang_word": "погибнуть",
                                "target_lang_sense_clarification": "в бою"
                            }
                        ]
                    }
