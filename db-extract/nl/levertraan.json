                        "glosses": [
                            "een dierlijke olie, gewonnen uit de lever van kabeljauw, schelvis en andere vissen uit de familie van schelvissen, de Gadidae; vooral vroeger wel gebruikt als voedingssupplement"
                        ],
                        "tags": [],
