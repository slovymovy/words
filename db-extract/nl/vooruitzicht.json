                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec767936-63f1-40ff-8eda-75e9b74c173d",
                                "sense_id": "a5b3ec38-a500-32fd-90ca-6c5d78f1a4bb",
                                "text": "De economische vooruitzichten zijn een stuk zonniger dan voorheen."
                            },
                            {
                                "example_id": "52fa3f2e-807b-4238-b747-a955c2cef1ba",
                                "sense_id": "a5b3ec38-a500-32fd-90ca-6c5d78f1a4bb",
                                "text": "Toen de wapenstilstand ten slotte een aannemelijk vooruitzicht werd, begon de hoop het er levend af te brengen zelfs bij de grootste pessimisten post te vatten."
                            },
                            {
                                "example_id": "0e40f398-56d2-46cc-a749-84256bea6cf8",
                                "sense_id": "a5b3ec38-a500-32fd-90ca-6c5d78f1a4bb",
                                "text": "Maar het vooruitzicht om helemaal alleen daar boven te slapen joeg mij angst aan."
                            },
                            {
                                "example_id": "0c6b9195-d8b2-4130-8cef-a5fbb6f5d1ca",
                                "sense_id": "a5b3ec38-a500-32fd-90ca-6c5d78f1a4bb",
                                "text": "Ook als ik na vier jaar nog niet bij de Ring in onze stad ben geweest, dan heb ik in ieder geval de keuze gehad om te gaan. En die vrijheid, dat vooruitzicht, is me eerlijk gezegd net zo veel waard als het schouwburgbezoek zelf."
                            }
                        ]
                    }
