                                "target_senses": [
                                    {
                                        "sense_id": "15f8bc20-6666-3da0-b4e5-e7d362af29ce",
                                        "entry_id": "1c457171-ab1e-31b4-af4d-baa49311ba1d",
                                        "glosses": [
                                            "D’une manière normale, régulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e3a2f5b-41a8-4511-ad36-1097c8547ddc",
                                                "sense_id": "15f8bc20-6666-3da0-b4e5-e7d362af29ce",
                                                "text": "Par « sentiment de soi sain », j’entends la totale certitude que les sentiments et les désirs éprouvés appartiennent à son propre Soi. Ce n’est pas une certitude raisonnée – elle est là, comme notre pouls, auquel nous ne prêtons aucune attention tant qu’il bat normalement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                                        "entry_id": "1c457171-ab1e-31b4-af4d-baa49311ba1d",
                                        "glosses": [
                                            "Dans un cas normal ou courant ; sauf circonstance particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a2a3c2a-7712-4bbd-9255-d0f904c50ca1",
                                                "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                                                "text": "Le revêtement en place, souvent recouvert de gravillons, n’est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d’interventions de maintenance."
                                            },
                                            {
                                                "example_id": "09185bf4-0d36-4f43-a7f5-8f25b96ccbc2",
                                                "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                                                "text": "Ainsi chez le Flet, poisson normalement droitier, les individus dits inversés « gauchers » représentent près d'un tiers dans certaines populations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
