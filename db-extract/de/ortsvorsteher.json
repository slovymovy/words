                "senses": [
                    {
                        "sense_id": "a5fa0e0a-e9d7-3f19-906f-0f88d37ee128",
                        "entry_id": "30d72984-fe69-32ec-b74d-9e89e5e8f2af",
                        "glosses": [
                            "Person, die einem Ort vorsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19d581e-1507-4712-9d72-0918d25f5ded",
                                "sense_id": "a5fa0e0a-e9d7-3f19-906f-0f88d37ee128",
                                "text": "„Als die Einwohner Wüstheuterodes den heute Siebzigjährigen bei den ersten freien Wahlen nach der Wende mit großer Mehrheit zum Ortsvorsteher wählten, geschah dies auch in der Hoffnung, dass er in die Fußstapfen seines erfolgreichen gleichnamigen Großvaters treten würde.“"
                            },
                            {
                                "example_id": "399d92cc-5d32-4651-ba18-44cf7efc2917",
                                "sense_id": "a5fa0e0a-e9d7-3f19-906f-0f88d37ee128",
                                "text": "„Um die Unterstützung der Gäste in ordentliche Bahnen zu leiten, beschloss unser Ortsvorsteher, ein Hilfskomitee zu gründen, dem alle, die helfen wollten, beitreten konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
