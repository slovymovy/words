                    "sense_id": "50a07c5a-0e22-39cf-9066-d099ef14910d",
                    "sense_definition": "osoba, która dopuszcza się czynów niemoralnych, haniebnych lub przestępczych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przestępca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja w końcu dorwała tego <w>łotra</w> i postawiła go przed sądem za jego liczne kradzieże.",
                            "target_lang_translations": {
                                "ru": "Полиция наконец поймала этого <w>злодея</w> и отдала его под суд за многочисленные кражи."
                            }
                        },
                        {
                            "text": "W dawnych opowieściach ten podły <w>łotr</w> zawsze próbował oszukać niewinnych mieszkańców wioski.",
                            "target_lang_translations": {
                                "ru": "В старинных сказаниях этот подлый <w>негодяй</w> всегда пытался обмануть невинных жителей деревни."
                            }
                        }
                    ],
                    "synonyms": [
