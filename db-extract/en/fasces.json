                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ee3a2dd-f6fd-34c5-b44d-9ac7f63122db",
                        "entry_id": "6b5d8d36-a5ee-3442-bbab-1f32c89276b9",
                        "glosses": [
                            "A Roman symbol of judicial authority consisting of a bundle of wooden sticks, with an axe blade embedded in the centre; used also as a symbol of fascism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ee01e7b-a13a-4432-8a77-e57ea3173c2a",
                        "source_entry_id": "6b5d8d36-a5ee-3442-bbab-1f32c89276b9",
                        "source_sense_id": "7ee3a2dd-f6fd-34c5-b44d-9ac7f63122db",
                        "source_sense_description": "bundle",
                        "target_lang_word": "faisceau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faisceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1b7d87-f6db-3647-a591-cddc16f618d1",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Assemblage de certaines choses de même nature et de forme allongée liées ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c22a671-41c1-4b09-a723-02b4077b41e4",
                                                "sense_id": "ab1b7d87-f6db-3647-a591-cddc16f618d1",
                                                "text": "Jetés sur une chaise, un pare-poussière, un faisceau de cannes et de parapluies, révèlent un retour de voyage, […]."
                                            },
                                            {
                                                "example_id": "dc539a68-a9f2-47d4-b403-968495347adb",
                                                "sense_id": "ab1b7d87-f6db-3647-a591-cddc16f618d1",
                                                "text": "Faisceau de muscles, de nerfs. Faisceau musculaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fe6d55e-1a5f-3f3d-9ab2-6f36d958e579",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Câble formé de l’assemblage de nombreux circuits."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38284223-2d5f-4e0d-83a3-c1f65ccf70bb",
                                                "sense_id": "4fe6d55e-1a5f-3f3d-9ab2-6f36d958e579",
                                                "text": "Faisceau' de fibres optiques"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f642987a-0576-3170-a7df-1bca102733bd",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Canal de communications multiplexées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad3e553-25be-4bae-94f5-b18fcadd3ef7",
                                                "sense_id": "f642987a-0576-3170-a7df-1bca102733bd",
                                                "text": "Flûte, le faisceau T2 est encore en carafe !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbf455f-71dc-3a03-8991-698319efbb84",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Assemblage de verges, avec une hache au milieu, qui étaient, chez les anciens Romains, le symbole de la puissance des consuls et des dictateurs."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9f8c94-21a8-4dc5-9541-649df76b687c",
                                                "sense_id": "bcbf455f-71dc-3a03-8991-698319efbb84",
                                                "text": "Malheureuse famille, qui ne s’apercevait pas que le siècle s’avançait comme le dictateur romain précédé de ses faisceaux de commandement !!!"
                                            },
                                            {
                                                "example_id": "0ee954c4-0f9c-45f1-bea7-97c84cc89f7d",
                                                "sense_id": "bcbf455f-71dc-3a03-8991-698319efbb84",
                                                "text": "Ils plantèrent contre la porte leurs douze faisceaux, des baguettes reliées par une courroie avec une hache dans le milieu. Alors, tous frémirent devant la majesté du peuple romain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Assemblage d’au moins trois fusils qu’on forme en engageant les baïonnettes les unes dans les autres, de manière qu’ils soutiennent ceux qu’on appuie sur eux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9149afc1-94a4-4f97-b123-d061b6e48aaf",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "Mettre les fusils en faisceau. Former les faisceaux."
                                            },
                                            {
                                                "example_id": "11b4d010-d9f4-45be-a0bc-6fd206524613",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "Plusieurs d’entre nous murmurèrent, prononcèrent à haute voix des paroles de menace et de révolte ; mais les officiers qui se promenaient, mornes aussi, devant la ligne des faisceaux, ne semblèrent pas y faire attention."
                                            },
                                            {
                                                "example_id": "92284cbd-baf7-4c9c-8818-85d1bfb40a2a",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "Et, lorsque, deux heures plus tard, son régiment eut formé les faisceaux, à une lieue de la ville, du côté de Courcelles, dans la vaste plaine qui s’étend le long du canal de l’Aisne à la Marne, son étonnement grandit encore, en apprenant que toute l’armée de Châlons se repliait depuis le matin et venait bivouaquer en cet endroit."
                                            },
                                            {
                                                "example_id": "b060fdd4-088d-46d0-ac38-3483b53d38d0",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "faisceaux. — À former, est le comble de la difficulté dans la garde nationale."
                                            },
                                            {
                                                "example_id": "5a872557-0935-412f-a69c-ea4760bc47de",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "Au-dehors, on rompait les faisceaux. Les canons des fusils dans l’ombre avaient des reflets bleuâtres. Des fourreaux de baïonnettes, des chaînettes de gamelles tintaient."
                                            },
                                            {
                                                "example_id": "70da7054-2c7e-4c1c-bd77-583028490cbb",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "Elle avait auprès d’elle une petite guerba suspendue entre trois piquets formant faisceau."
                                            },
                                            {
                                                "example_id": "2ee4f028-559f-40c7-8327-c8406e30e7e9",
                                                "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                                                "text": "Au centre, un grand chaudron est suspendu à trois troncs d’arbres disposés en faisceau ; tout autour, les malheureux Européens sont attachés à des poteaux […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Rayonnement – onde électromagnétique ou particules – émis et se propageant dans une direction donnée."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dceedaa-a3e2-4aef-b74c-00c607d97384",
                                                "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                                                "text": "Pour le tango, la salle était plongée dans l'obscurité, et deux petits projecteurs dirigeaient leurs faisceaux sur la boule à facettes qui tournait lentement."
                                            },
                                            {
                                                "example_id": "dc68daf9-3612-4d89-8478-75000482ab99",
                                                "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                                                "text": "Les sonars à faisceaux lumineux, communément appelés flashers, sont très populaires auprès des amateurs de pêche blanche pour l’instantanéité de la transmission de ce qui se passe sous la croûte gelée."
                                            },
                                            {
                                                "example_id": "0a102e0e-2c88-4f4b-a497-1b722f6ab86e",
                                                "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                                                "text": "Faisceau' de rayons lumineux."
                                            },
                                            {
                                                "example_id": "6cf8dc6b-257f-4d9d-9423-b56fa7a16f73",
                                                "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                                                "text": "Un microscope électronique (ME) est un type de microscope qui utilise un faisceau d’électrons pour illuminer un échantillon et en créer une image très agrandie."
                                            },
                                            {
                                                "example_id": "653a85d0-f7aa-4051-b66e-5369a9535dae",
                                                "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                                                "text": "La protonthérapie est une technique de radiothérapie visant à détruire les cellules cancéreuses en les irradiant avec un faisceau de particules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c0619f2-4d58-3bdf-9c01-eed094ec30d9",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Disposition d’aimants pour générer un champ magnétique de forme contrôlée."
                                        ],
                                        "tags": [
                                            "Magnétisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f362a807-4a0f-4d41-86f9-eb68253dd110",
                                                "sense_id": "7c0619f2-4d58-3bdf-9c01-eed094ec30d9",
                                                "text": "Faisceau aimanté ou '''faisceau magnétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19fdd0a5-d07b-30c4-8849-f1c7987c4ecb",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Méthode d’optimisation permettant de minimiser une fonction convexe non-différentiable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a1f1d54-04bb-321c-93ca-ec587bd00e6b",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Ensemble de choses concordantes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9358f65-68ce-4774-88f4-143e38ea7b6a",
                                                "sense_id": "3a1f1d54-04bb-321c-93ca-ec587bd00e6b",
                                                "text": "Faisceau de présomptions."
                                            },
                                            {
                                                "example_id": "45a7b5d6-7ec9-49e1-93bd-db4c5b70d07f",
                                                "sense_id": "3a1f1d54-04bb-321c-93ca-ec587bd00e6b",
                                                "text": "Faute de pouvoir faire toute la lumière désirable sur ce fait énigmatique, nous réunirons ici le faisceau de vraisemblances et de témoignages qui peuvent seuls nous éclairer pour le moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30915afb-85ed-30bd-96ca-5f312a0f90e6",
                                        "entry_id": "568def49-3cd8-3f9e-b086-5fcc0743e139",
                                        "glosses": [
                                            "Meuble représentant dans les armoiries un ensemble d’objets longs (lances, flèches, épées…) rassemblés par un lien. Les objets sont généralement attachés par leur milieu et posés en éventail. On le dit lié quand le lien est d’un émail différent. Le nombre d’objets doit être blasonné. À rapprocher de faisceau de licteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84c85c20-f0fd-49e3-a611-8fbff56e339c",
                                                "sense_id": "30915afb-85ed-30bd-96ca-5f312a0f90e6",
                                                "text": "De gueules, au lion d’or couronné du même, tenant dans sa patte dextre un faisceau de sept flèches d’argent, pointées et empennées d’or, et dans sa patte sénestre, une épée d’argent, garnie d’or, qui est de Guillaume V d’Orange-Nassau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
