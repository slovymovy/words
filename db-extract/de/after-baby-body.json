                "senses": [
                    {
                        "sense_id": "5590fe31-3d81-3e31-81c8-439c48ca0fbc",
                        "entry_id": "1fb6ecd3-fa46-3013-8d00-7c76eb0be531",
                        "glosses": [
                            "der Körper einer Frau in der Zeit nach der Geburt eines Kindes, besonders in Hinblick auf die Optik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa275144-afdb-4597-b738-ac615310f706",
                                "sense_id": "5590fe31-3d81-3e31-81c8-439c48ca0fbc",
                                "text": "Nun zeigte sich die Monegassen-Beauty endlich mal wieder bei einem Termin – und überraschte in New York mit ihrem perfekten After-Baby-Body!"
                            },
                            {
                                "example_id": "23fcf920-e4f4-44f0-a94a-6487f81a6790",
                                "sense_id": "5590fe31-3d81-3e31-81c8-439c48ca0fbc",
                                "text": "Wir zeigen euch hier die krassen Abnahmestrategien und After-Baby-Bodys der Models."
                            },
                            {
                                "example_id": "9b278bf7-f684-452b-8c96-008ef48e183c",
                                "sense_id": "5590fe31-3d81-3e31-81c8-439c48ca0fbc",
                                "text": "Warum Kate Middleton jetzt noch einen extrem großen Bauch hat und wie Mütter einen schlanken After-Baby-Body bekommen können."
                            },
                            {
                                "example_id": "4958f58c-bd39-44ea-a9a5-2e0777f516ca",
                                "sense_id": "5590fe31-3d81-3e31-81c8-439c48ca0fbc",
                                "text": "Doch sie hat es nicht eilig, ihre Pfunde loszuwerden und so wurde öffentlich über ihren noch immer kurvigen After-Baby-Body gelästert."
                            },
                            {
                                "example_id": "482b1c80-799b-45df-8001-819e5caabdd0",
                                "sense_id": "5590fe31-3d81-3e31-81c8-439c48ca0fbc",
                                "text": "Wie lange sich Fans von Kim noch auf erste After-Baby-Body-Fotos gedulden müssen, ist schwer abzuschätzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
