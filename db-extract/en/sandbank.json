                                    {
                                        "sense_id": "e9b51f50-c7ea-3df4-89ac-97514e8ed506",
                                        "entry_id": "cd11755b-ec04-3115-a9a8-52392a408a54",
                                        "glosses": [
                                            "płytkie miejsce w morzu, jeziorze lub rzece"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a4d4d5-4bd1-4102-a658-d2508776b15a",
                                                "sense_id": "e9b51f50-c7ea-3df4-89ac-97514e8ed506",
                                                "text": "Koryto Wisły jest pełne mielizn."
                                            },
                                            {
                                                "example_id": "9698c474-9c7f-46ba-a228-5ac5705aa28d",
                                                "sense_id": "e9b51f50-c7ea-3df4-89ac-97514e8ed506",
                                                "text": "Argentyński statek z 122 osobami na pokładzie zaczął nabierać wody, po tym jak osiadł na mieliźnie w rejonie Antarktydy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f216d088-afba-3b5d-8893-7d8abb51ccf9",
                                        "entry_id": "cd11755b-ec04-3115-a9a8-52392a408a54",
