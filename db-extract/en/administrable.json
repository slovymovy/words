                            {
                                "example_id": "d27c3aa2-7fed-4da2-86d0-249bdffaf7a2",
                                "sense_id": "d84a4ffd-680b-3db6-bfc1-e0a76c68280d",
                                "text": "Ideally such legislation should ensure horizontal equity between taxpayers and should provide clear and easily administrable rules."
                            },
                            {
                                "example_id": "b5f51f20-8833-49f3-9ad4-2853344f21fb",
                                "sense_id": "d84a4ffd-680b-3db6-bfc1-e0a76c68280d",
                                "text": "It is very difficult to state a sensible and administrable principle of compensation - but then, it is always difficult to state sensible and administrable principles."
                            },
                            {
                                "example_id": "41674aed-1d57-4d02-8fa5-c9f035b0d2a3",
                                "sense_id": "d84a4ffd-680b-3db6-bfc1-e0a76c68280d",
                                "text": "Active and open NGOs, operating in conjunction with the government under clear and easily administrable laws, are a vital component of a free and functional civil society."
                            }
                        ]
                    }
