                "senses": [
                    {
                        "sense_id": "6c51590a-2f79-314f-b8f5-6b25fbb136ce",
                        "entry_id": "1f4d0176-c231-370c-819b-b97a5d1b409f",
                        "glosses": [
                            "Stoff, der süchtig macht/eine Sucht (vorübergehend) befriedigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "579d0557-c97e-4898-b242-0d66a8a9450a",
                                "sense_id": "6c51590a-2f79-314f-b8f5-6b25fbb136ce",
                                "text": "„Leicht irritiert blickte ich auf, nur widerstrebend lässt sich ein notorischer Leser sein Suchtmittel entziehen.“"
                            },
                            {
                                "example_id": "aa1031f9-ffa0-4205-aa5d-2f5e76b2abce",
                                "sense_id": "6c51590a-2f79-314f-b8f5-6b25fbb136ce",
                                "text": "„Am Donnerstag wurde nach Polizeiangaben eine 27 Jahre alte Konsumentin chemischer Suchtmittel leblos in ihrer Wohnung in Haidhausen entdeckt, die junge Frau starb kurz darauf im Krankenhaus.“"
                            },
                            {
                                "example_id": "eac148b0-acf6-4e2f-948c-227978ee5e2c",
                                "sense_id": "6c51590a-2f79-314f-b8f5-6b25fbb136ce",
                                "text": "„Schließlich ist Geld ja auch ein starkes Suchtmittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
