                                "sense_id": "9bd26961-c166-32b1-9e9c-637d9d44c099",
                                "text": "He's a lamb indeed, that baes like a bear."
                            },
                            {
                                "example_id": "d897c398-9491-44c8-a95f-d43e6b2045fc",
                                "sense_id": "9bd26961-c166-32b1-9e9c-637d9d44c099",
