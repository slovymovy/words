                "senses": [
                    {
                        "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                        "entry_id": "8229b935-ae14-3f0a-ae14-2dbb547c129f",
                        "glosses": [
                            "Wohnsitz des Staatsoberhauptes, eines Fürsten, eines hohen Geistlichen, eines Diplomaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b781dd8d-b9e4-4670-9c7b-800712f1fafc",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "Die Abgeordneten tagen heute in der Residenz."
                            },
                            {
                                "example_id": "88668c48-69ff-4f0d-b214-f6bf769050b9",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "„Die Würzburger Residenz ist ab dem heutigen Montag Drehort für den Hollywoodstreifen ``Die drei Musketiere``.“"
                            },
                            {
                                "example_id": "c11984ad-9e3e-437b-8ffd-34eed30e3f0f",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "In einer Alten-Residenz wohnen Senioren."
                            },
                            {
                                "example_id": "a50f4e54-696d-4d9a-9e49-a49aa88cc629",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "In einer Monarchie ist die Residenz des Monarchen in der Residenzstadt, die damit Hauptstadt ist."
                            },
                            {
                                "example_id": "f983495d-32d5-4cde-8594-745ffb146032",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "„Solchen Dünkel hegte auch Patriarch Calixtus, der im Jahr 737 seine Residenz von Cormòns nach Forum Iulii verlegte.“"
                            },
                            {
                                "example_id": "2e91415d-7afa-4ab5-b459-cc4e2358440d",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "„Wir fuhren vor einem imposanten steinernen Gebäude vor, von dem ich annahm, daß es die Residenz des Gouverneurs sei.“"
                            },
                            {
                                "example_id": "8d10bd40-55a0-4b18-be47-791dbfa4cf40",
                                "sense_id": "2f4fe289-1e62-37da-b0fd-73cfbd8e7c0f",
                                "text": "„Und kein anderes Land der Erde hätte so viele Orte zu bieten, in denen man schöne Säle findet, lebendige Bibliotheken, heimelige Buchhandlungen, kleine Theaterchen - alles die schönste Folge von Zeiten, als Deutschland aus unzähligen Residenzen bestand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfce60cf-9282-3519-97c2-34703a30eaa0",
                        "entry_id": "8229b935-ae14-3f0a-ae14-2dbb547c129f",
                        "glosses": [
                            "Hauptstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780da112-38ab-442f-8d8f-6fbf464e9b71",
                                "sense_id": "cfce60cf-9282-3519-97c2-34703a30eaa0",
                                "text": "Paris war Residenz des Frankenreichs."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
