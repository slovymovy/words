                "senses": [
                    {
                        "sense_id": "b17ec826-1d37-3106-ae5d-1d245b0c600c",
                        "entry_id": "762e8467-2d2e-34c0-889d-897b191e015c",
                        "glosses": [
                            "Donner un caractère lingala à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d465bb-cf76-499a-b31a-ab8bfe0b9316",
                                "sense_id": "b17ec826-1d37-3106-ae5d-1d245b0c600c",
                                "text": "Cette image suggère l’ambition du narrateur, et en filigrane celle de l’auteur, de faire chanter le français comme le lingala, et donc, de le « lingaliser »."
                            },
                            {
                                "example_id": "e7444dcf-569f-4410-a7d0-3b89b34d3ca3",
                                "sense_id": "b17ec826-1d37-3106-ae5d-1d245b0c600c",
                                "text": "Une autre variante, moins codée sera de remplacer « bord » par « affaire » : toujours du français lingalisé !"
                            },
                            {
                                "example_id": "7f49ddfc-2776-48c6-941d-ce94981e3a57",
                                "sense_id": "b17ec826-1d37-3106-ae5d-1d245b0c600c",
                                "text": "Allez à Makanza écouter parler le Lingala Pur ^([sic : lingala pur]) et vous verrez que ce qu’on parle à Kinshasa n’est que le Kikongo ^([sic : kikongo]) falsifié et lingalisé."
                            }
                        ]
                    }
