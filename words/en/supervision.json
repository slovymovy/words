{
    "word_family": [
        "supervise",
        "supervisor",
        "supervisory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d874d8d4-2322-3f92-9f07-9928fa4283f9",
                    "sense_definition": "The act of watching over someone or something to ensure that everything is done correctly and safely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oversight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children should not be allowed to use the swimming pool without adult <w>supervision</w>.",
                            "target_lang_translations": {
                                "ru": "Детям не следует разрешать пользоваться бассейном без <w>присмотра</w> взрослых."
                            }
                        },
                        {
                            "text": "The project requires constant <w>supervision</w> to ensure that all safety protocols are followed strictly.",
                            "target_lang_translations": {
                                "ru": "Проект требует постоянного <w>надзора</w> для обеспечения строгого соблюдения всех протоколов безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversight",
                        "management",
                        "direction"
                    ],
                    "common_phrases": [
                        "adult supervision",
                        "constant supervision",
                        "direct supervision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по наблюдению за кем-либо или чем-либо для обеспечения правильности и безопасности выполнения работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присмотр",
                                "target_lang_sense_clarification": "за детьми или объектами"
                            },
                            {
                                "target_lang_word": "надзор",
                                "target_lang_sense_clarification": "официальное наблюдение"
                            },
                            {
                                "target_lang_word": "контроль",
                                "target_lang_sense_clarification": "проверка соблюдения правил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93581c79-6218-37eb-b309-249549d03e0c",
                    "sense_definition": "The action or process of supervising a person or an activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oversight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under his parents' <w>supervision</w> he drilled the holes in the wood for the birdhouse.",
                            "target_lang_translations": {
                                "ru": "Под <w>наблюдением</w> родителей он просверлил отверстия в дереве для скворечника."
                            }
                        },
                        {
                            "text": "The intern performed the medical procedure under the close <w>supervision</w> of a senior doctor.",
                            "target_lang_translations": {
                                "ru": "Интерн провел медицинскую процедуру под пристальным <w>руководством</w> старшего врача."
                            }
                        }
                    ],
                    "synonyms": [
                        "superintending",
                        "monitoring"
                    ],
                    "common_phrases": [
                        "close supervision",
                        "under the supervision of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс руководства человеком или деятельностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "наставничество или управление"
                            },
                            {
                                "target_lang_word": "наблюдение",
                                "target_lang_sense_clarification": "мониторинг процесса"
                            },
                            {
                                "target_lang_word": "кураторство",
                                "target_lang_sense_clarification": "профессиональное сопровождение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e6cbec8-f3f1-327e-9684-4baab83e5f9e",
                    "sense_definition": "A tutorial session for an individual student or a very small group, typically at a university.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a weekly <w>supervision</w> to discuss my latest essay with my professor.",
                            "target_lang_translations": {
                                "ru": "У меня еженедельная <w>консультация</w>, чтобы обсудить мое последнее эссе с профессором."
                            }
                        },
                        {
                            "text": "The students prepared several questions for their next <w>supervision</w> session on Thursday.",
                            "target_lang_translations": {
                                "ru": "Студенты подготовили несколько вопросов для следующего <w>тьюториала</w> в четверг."
                            }
                        }
                    ],
                    "synonyms": [
                        "tutorial"
                    ],
                    "common_phrases": [
                        "weekly supervision",
                        "supervision session"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in UK academic contexts like Cambridge"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Индивидуальное или групповое учебное занятие с преподавателем, характерное для британских университетов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тьюториал",
                                "target_lang_sense_clarification": "учебная консультация"
                            },
                            {
                                "target_lang_word": "консультация",
                                "target_lang_sense_clarification": "встреча с профессором"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}