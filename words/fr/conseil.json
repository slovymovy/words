{
    "word_family": [
        "conseiller",
        "déconseiller"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "657716f1-1dc5-34d2-ab34-3e17a35f46a8",
                    "sense_definition": "Avis, recommandation ou indication donnée à quelqu'un sur ce qu'il convient de faire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "avis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon ami m'a donné un très bon <w>conseil</w> pour préparer cet examen."
                        },
                        {
                            "text": "Si vous avez un doute, vous devriez demander <w>conseil</w> à votre médecin."
                        }
                    ],
                    "synonyms": [
                        "avis",
                        "recommandation",
                        "suggestion"
                    ],
                    "common_phrases": [
                        "demander conseil",
                        "donner un conseil",
                        "suivre un conseil",
                        "bon conseil"
                    ]
                },
                {
                    "sense_id": "ddb6f73b-5f1a-3cec-a68b-79a07fb56533",
                    "sense_definition": "Assemblée ou groupe de personnes réunies pour délibérer, administrer ou donner un avis officiel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>conseil</w> municipal se réunit chaque mois pour voter le budget de la commune."
                        },
                        {
                            "text": "Elle a été élue membre du <w>conseil</w> d'administration de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "assemblée",
                        "comité"
                    ],
                    "common_phrases": [
                        "conseil municipal",
                        "conseil d'administration",
                        "conseil de classe"
                    ]
                },
                {
                    "sense_id": "d027369a-8944-3956-9118-faa9a20ab733",
                    "sense_definition": "Séance ou réunion tenue par une assemblée délibérante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur doit présider le <w>conseil</w> qui commence à quatorze heures."
                        },
                        {
                            "text": "Plusieurs décisions importantes ont été prises au cours du <w>conseil</w> de ce matin."
                        }
                    ],
                    "synonyms": [
                        "séance",
                        "réunion"
                    ],
                    "common_phrases": [
                        "assister au conseil",
                        "tenir conseil"
                    ]
                },
                {
                    "sense_id": "cfe5b855-4dcc-3e3b-9c0b-b80d3775be76",
                    "sense_definition": "Personne dont la profession est d'assister, de guider ou de défendre un client, particulièrement en justice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a demandé à s'entretenir immédiatement avec son <w>conseil</w> avant l'audience."
                        },
                        {
                            "text": "Cette entreprise fait appel à un <w>conseil</w> juridique pour rédiger ses contrats."
                        }
                    ],
                    "synonyms": [
                        "avocat",
                        "défenseur"
                    ],
                    "common_phrases": [
                        "conseil juridique"
                    ]
                },
                {
                    "sense_id": "2ec54525-40c0-3a08-9f08-34352617728a",
                    "sense_definition": "Impulsion intérieure, sentiment ou circonstance qui détermine ou incite à agir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans un moment de panique, il a écouté les mauvais <w>conseils</w> de la peur."
                        },
                        {
                            "text": "Ne prends pas <w>conseil</w> de ta seule colère avant de répondre à cette lettre."
                        }
                    ],
                    "synonyms": [
                        "inspiration",
                        "suggestion"
                    ],
                    "common_phrases": [
                        "prendre conseil de"
                    ]
                }
            ]
        }
    ]
}