                "senses": [
                    {
                        "sense_id": "2799b979-087d-3c65-8d1c-6992858eff05",
                        "entry_id": "91f05970-3312-31c1-b657-ee3096829626",
                        "glosses": [
                            "geographisches Gebiet, das gekennzeichnet ist durch Gemeinsamkeiten / Verflechtungen / Abkommen auf dem Gebiet der Wirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d52682-baef-4578-93b9-3b8106803de5",
                                "sense_id": "2799b979-087d-3c65-8d1c-6992858eff05",
                                "text": "„Es gibt viele Abkommen im Zuge des Berliner Prozesses. Beispielsweise die Schaffung eines gemeinsamen Wirtschaftsraums oder einer Businessplattform.“"
                            },
                            {
                                "example_id": "b5c5b2e8-41cc-4d2b-927f-959a948612fb",
                                "sense_id": "2799b979-087d-3c65-8d1c-6992858eff05",
                                "text": "„Europa ist mehr als eine landesübergreifende Währung, es ist mehr als ein Wirtschaftsraum. Europa ist ein Kulturraum und Notre-Dame eines seiner zentralen Symbole.“"
                            },
                            {
                                "example_id": "caef6435-868e-4854-961f-e09e569adf7a",
                                "sense_id": "2799b979-087d-3c65-8d1c-6992858eff05",
                                "text": "„Der Aachener Vertrag soll einen deutsch-französischen Wirtschaftsraum schaffen und für einen Abbau bürokratischer Hürden sorgen.“"
                            },
                            {
                                "example_id": "c6cd32af-d237-4bba-8a05-e519e57f8483",
                                "sense_id": "2799b979-087d-3c65-8d1c-6992858eff05",
                                "text": "„Ab den 1970er-Jahren schlitterte der Wirtschaftsraum in eine tiefe Krise.“"
                            },
                            {
                                "example_id": "67553383-8368-4a2c-9be9-7479d03aaf19",
                                "sense_id": "2799b979-087d-3c65-8d1c-6992858eff05",
                                "text": "„Schon früher hatte er auf die Verluste im Wirtschaftsraum Rendsburg durch die Sanierung [Anmerkung: des Rendsburger Kanaltunnels] aufmerksam gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5b2557e1-b9e2-377a-b361-966364c9c6de",
                        "entry_id": "91f05970-3312-31c1-b657-ee3096829626",
                        "glosses": [
