                        "entry_id": "71532971-ce16-30ba-9a24-e01c79e89919",
                        "glosses": [
                            "To grasp, insnare, ensnare, catch, to trap suddenly, to grab suddenly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8582bba0-a6d1-4e59-864e-fe5346a55183",
                                "sense_id": "63a970b0-f9c5-396b-9a33-e8f0eb8aefd9",
                                "text": "He so besmouched her, and she so beclapped him, and there tumbling together, as merrie as they would wish, I sighed to thinke, what a supper they would haue after break-fast."
                            }
                        ]
                    }
