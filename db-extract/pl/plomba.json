                                            {
                                                "example_id": "c9d4f52e-ffbf-4291-ba8f-a109e06a3a40",
                                                "sense_id": "5af6eb39-fa36-3ff3-82b1-ef8d021eb9cc",
                                                "text": "Der Zöllner überprüfte die Unversehrtheit der Plomben."
                                            }
