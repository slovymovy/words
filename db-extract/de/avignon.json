                        "target_lang_word": "Avignon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Avignon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc291fe-0d83-3e0c-a602-51f42ef1a711",
                                        "entry_id": "6ca19251-1cd7-3564-aafd-483b7f93e3e3",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département du Vaucluse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b227d4f-01e6-4666-a8b7-d326abf0e4dd",
                                                "sense_id": "8fc291fe-0d83-3e0c-a602-51f42ef1a711",
                                                "text": "Sur le pont d’Avignon,\nOn y danse, on y danse;\nSur le pont d’Avignon,\nOn y danse tout en rond."
                                            },
                                            {
                                                "example_id": "50ecb9f2-919d-42c8-aef8-626a698723a5",
                                                "sense_id": "8fc291fe-0d83-3e0c-a602-51f42ef1a711",
                                                "text": "Sur le pont d’Avignon, qui est une moitié de pont, l’autre étant tombée, nous avons dansé une ronde d’adultes en face du château des Papes."
                                            },
                                            {
                                                "example_id": "33d53f49-cca7-4cae-a563-69c14b824808",
                                                "sense_id": "8fc291fe-0d83-3e0c-a602-51f42ef1a711",
                                                "text": "Sur les deux mâles, l’un rempilait comme adjudant au 55ᵉ de ligne, en Avignon, cité des Papes et des punaises, et cueillait une flamboyante vérole parmi les nymphes de la rue des Grottes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3546fcd-3459-3ff6-974b-c3137f9ef9ea",
                                        "entry_id": "6ca19251-1cd7-3564-aafd-483b7f93e3e3",
                                        "glosses": [
                                            "Ancien nom de la commune française d’Avignon-lès-Saint-Claude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eddeac7f-f5f7-3330-bc55-06f9a2ef632d",
                                        "entry_id": "6ca19251-1cd7-3564-aafd-483b7f93e3e3",
                                        "glosses": [
                                            "Territoire papal dont la cité principale était Avignon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7afd5449-92f4-4d23-ad04-f0c66a1f906d",
                                                "sense_id": "eddeac7f-f5f7-3330-bc55-06f9a2ef632d",
                                                "text": "Les tiares de Rome et d’Avignon s’entrechoquent et l’Église, qui subsiste seule debout sur ces décombres, vacille à son tour, car le grand Schisme de l’Occident l’ébranle."
                                            },
                                            {
                                                "example_id": "34d00baf-a9dd-4ec2-b885-095ae10d78ed",
                                                "sense_id": "eddeac7f-f5f7-3330-bc55-06f9a2ef632d",
                                                "text": "Quant à Giraud, il entra à l’évêché où il commença une belle carrière. Finirait-il pape en Avignon ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bdafad1-06bd-325e-b1ae-c88e794d784f",
                                        "entry_id": "6ca19251-1cd7-3564-aafd-483b7f93e3e3",
                                        "glosses": [
                                            "Municipalité régionale de comté (MRC) québécoise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
