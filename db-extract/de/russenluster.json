                "senses": [
                    {
                        "sense_id": "901fc956-ce28-30b0-99f1-51d6fdfd06fd",
                        "entry_id": "7e0f6989-5e07-369c-8500-ba23c16a75d3",
                        "glosses": [
                            "von der Zimmerdecke hängende Glühlampe zur Raumbeleuchtung, die in einer einfachen Fassung ohne Lampenschirm angebracht ist"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "2f191e48-aae4-48d5-aed2-1bd2b0152a69",
                                "sense_id": "901fc956-ce28-30b0-99f1-51d6fdfd06fd",
                                "text": "„Von der miserablen, an russische Schlösser der Nachkriegszeit gemahnende Ästhetik ganz abgesehen. Russenluster, sagte man oft.“"
                            },
                            {
                                "example_id": "91f923f8-d082-451f-a0b1-b2ca92786036",
                                "sense_id": "901fc956-ce28-30b0-99f1-51d6fdfd06fd",
                                "text": "„Relikte aus der Besatzungszeit finden sich immer noch in Wiener Gesprächskultur, so wird eine unübliche, schlampige, explizit schlechte Methode als \"russisch\" bezeichnet. Als Beispiel sei der \"Russenluster\" angeführt:“"
                            },
                            {
                                "example_id": "f809ac0e-1650-458e-8179-f088744ff599",
                                "sense_id": "901fc956-ce28-30b0-99f1-51d6fdfd06fd",
                                "text": "„Der Russenluster bezieht seinen Witz daraus, dass das Wort „Luster“ gemeinhin Assoziationen von Prunk, Luxus und Glitzerpracht hervorruft, hier aber für eine Beleuchtungseinrichtung verwendet wird, die sich just durch die gegenteiligen Eigenschaften auszeichnet, nämlich Nüchternheit und Schmucklosigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
