                    },
                    {
                        "translation_id": "34f6a17a-0f0e-4632-b7f1-c2e2c5ffd286",
                        "source_entry_id": "93cc5632-531c-3e6c-9f73-3fcbdccfa9b0",
                        "source_sense_id": "0b9ce796-faf0-3abb-8950-e16c20e29346",
                        "source_sense_description": "country in Oceania",
                        "target_lang_word": "Tuvalu",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tuvalu",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                                        "entry_id": "95ce865d-2f69-3083-9ea9-ae8e86a48c10",
                                        "glosses": [
                                            "een land in Oceanië"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d44dc827-111c-4a94-ad4e-050f0545bf0f",
                                                "sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                                                "text": "Tuvalu is niet zo'n bekend land."
                                            },
                                            {
                                                "example_id": "3b01378d-6f7a-4262-bc78-0fe19e40050d",
                                                "sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                                                "text": "Donkere wolken pakken zich samen boven het eilandstaatje Tuvalu, als je het nieuws geloven mag. In 2050 is Tuvalu misschien volledig door de oceaan opgeslokt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a1db469-59ec-462a-a263-39b5d5afceab",
                        "source_entry_id": "93cc5632-531c-3e6c-9f73-3fcbdccfa9b0",
                        "source_sense_id": "0b9ce796-faf0-3abb-8950-e16c20e29346",
                        "source_sense_description": "country in Oceania",
                        "target_lang_word": "Tuvalu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tuvalu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                        "entry_id": "f0ce5174-be25-3662-8475-54046f8d380a",
                                        "glosses": [
                                            "Petit pays polynésien, au centre de l’océan Pacifique, au sud de l’équateur et proche des Kiribati (ex-îles Gilbert, avec lesquelles ils formaient auparavant le protectorat britannique des îles-Gilbert-et-Ellice). La capitale est Vaiaku, sur l’atoll de Funafuti."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf98b59b-4585-43fd-9769-85c2fc62da16",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "Les Tuvalu (ex groupe des Ellice) sont constituées de 3 îles […]"
                                            },
                                            {
                                                "example_id": "65e21afa-f40a-4298-9c82-f6f6e1390ebc",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "La frontière nord-ouest entre l’aire de la filariose subpériodique et celle de la filariose périodique nocturne suit la ligne de BUXTON (1928) qui sépare les îles de la Loyauté, les Fiji [sic] et les Tuvalu des Nouvelles Hébrides [sic], des îles Santa Cruz et des Gilbert (Fig. 6)."
                                            },
                                            {
                                                "example_id": "cd2273f9-33c6-4579-a0c5-a6e974322d0c",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "Cinq États de cette région ne constitutionnalisent pas le droit à la réparation : ce sont la Micronésie, les îles Marshall, Nauru, les îles Tonga et le Tuvalu."
                                            },
                                            {
                                                "example_id": "3234a185-9605-4723-bb38-c53549973b31",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "Une recherche rapide permet de trouver 14 nations quasi indépendantes, de Belize à l'état des Tuvalu, où l'on retrouve un représentant de la reine Élisabeth, comme chef d'État."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2b4b19f-9e69-4471-a59e-b8c0ebbd3054",
                        "source_entry_id": "93cc5632-531c-3e6c-9f73-3fcbdccfa9b0",
                        "source_sense_id": "0b9ce796-faf0-3abb-8950-e16c20e29346",
                        "source_sense_description": "country in Oceania",
                        "target_lang_word": "Tuvalu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tuvalu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                        "entry_id": "bb5c0a69-a2e4-3f78-8cfd-e55f88442b2f",
                                        "glosses": [
                                            "Inselstaat in Ozeanien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e21cd50b-8733-45ad-99f6-8f3ed7b92268",
                                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                                "text": "Der Verkauf von Tuvalus Internetadressendung „.tv“ hat der dem kleinen Staat bereits über 50 Millionen Dollar eingebracht."
                                            },
                                            {
                                                "example_id": "242418ca-3751-4b7a-818a-03bed5524bc9",
                                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                                "text": "Das Tuvalu der Zukunft wird vielleicht eine Unterwasserlandschaft sein."
                                            },
                                            {
                                                "example_id": "9c00f9e0-5dcb-4d8a-b9fc-a5e0f1d03066",
                                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                                "text": "Funafuti ist die Hauptstadt von Tuvalu."
                                            },
                                            {
                                                "example_id": "f8a554bb-efbd-4a26-bd84-d2ba9ab2e518",
                                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                                "text": "Der reiselustige Theo will sich demnächst endlich ein Bild von Tuvalus Schönheit machen."
                                            },
                                            {
                                                "example_id": "660b85a4-c876-41ff-82c8-b378c3050be6",
                                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                                "text": "„Um 500 n. Chr. kamen polynesische Einwanderer von Samoa und Tonga nach Tuvalu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
