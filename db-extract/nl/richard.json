                                            {
                                                "example_id": "e963b610-b5f0-42ee-8832-f83a791a7a0b",
                                                "sense_id": "9f40b040-95fc-3264-9add-5e287a8b57f4",
                                                "text": "„König Richard III. starb als letzter englischer Monarch auf dem Schlachtfeld – in der Schlacht von Bosworth, in der sein Heer auf das des späteren englischen Herrschers Heinrich VII. traf.“"
