                        "form_id": "90a455f0-01bc-4056-a482-cea8ace6fd6d",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "печа́тны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18615874-324d-3363-86b3-715285d21abe",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "относящийся к печати (предмет с нарезными знаками); связанный с приложением печати"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0a6d8b9b-01a1-35ff-a6a6-ba74446e3b4e",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "относящийся к печати (нанесение текста, изображения на бумагу или иной носитель), служащий для неё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52bb89bd-eaf9-48dd-bd0d-1024b350db70",
                                "sense_id": "0a6d8b9b-01a1-35ff-a6a6-ba74446e3b4e",
                                "text": "Печатное дело."
                            },
                            {
                                "example_id": "df81788f-3aa6-453c-802f-a5818c5c5b72",
                                "sense_id": "0a6d8b9b-01a1-35ff-a6a6-ba74446e3b4e",
                                "text": "Печатный цех."
                            },
                            {
                                "example_id": "cf30b57c-0b1d-49a9-b8e0-bf83a6b88996",
                                "sense_id": "0a6d8b9b-01a1-35ff-a6a6-ba74446e3b4e",
                                "text": "Печатный станок."
                            },
                            {
                                "example_id": "fa7cc469-5b34-46c6-addb-da4a0794c61e",
                                "sense_id": "0a6d8b9b-01a1-35ff-a6a6-ba74446e3b4e",
                                "text": "Печатная краска."
                            },
                            {
                                "example_id": "52b15c2f-9dac-401a-bdfd-03f5a4018c34",
                                "sense_id": "0a6d8b9b-01a1-35ff-a6a6-ba74446e3b4e",
                                "text": "Типография ютилась рядом, за стеной. День и ночь там стучала печатная машина."
                            }
                        ]
                    },
                    {
                        "sense_id": "0667e1ff-ddab-35a5-88e5-3f19ec0eb84e",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "изготовленный способом печати"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6602f5f-9898-4f31-9e66-69292b0ce597",
                                "sense_id": "0667e1ff-ddab-35a5-88e5-3f19ec0eb84e",
                                "text": "Печатная книга."
                            },
                            {
                                "example_id": "87743a3d-9531-47bd-96aa-171432d08c36",
                                "sense_id": "0667e1ff-ddab-35a5-88e5-3f19ec0eb84e",
                                "text": "Печатная продукция."
                            },
                            {
                                "example_id": "e7470052-73d7-4a43-8e82-9d86956308a8",
                                "sense_id": "0667e1ff-ddab-35a5-88e5-3f19ec0eb84e",
                                "text": "Печатные бланки."
                            },
                            {
                                "example_id": "bf837643-ecce-43ca-b386-eb39b50a61e0",
                                "sense_id": "0667e1ff-ddab-35a5-88e5-3f19ec0eb84e",
                                "text": "Это была крохотная, меньше ладони, тетрадочка, с печатными графами."
                            }
                        ]
                    },
                    {
                        "sense_id": "82d874f4-de9d-3e11-adbb-7cc4069c847a",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "имеющий вид знаков, принятых при печатании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f1d0a11-1802-43ae-9418-eb6f02bf7ec6",
                                "sense_id": "82d874f4-de9d-3e11-adbb-7cc4069c847a",
                                "text": "[Николай] сочинял прокламации, потом читал товарищам, их тут же переписывали печатными буквами."
                            }
                        ]
                    },
                    {
                        "sense_id": "a111eea1-5703-3d53-b8f1-d6058a75f449",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "такой, на котором выдавлены, вытиснены узоры, знаки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3950a3dc-7970-46fa-a327-a6d7b317e075",
                                "sense_id": "a111eea1-5703-3d53-b8f1-d6058a75f449",
                                "text": "Жена его только и делала, что с утра до вечера ела печатные пряники."
                            },
                            {
                                "example_id": "3f23ec9e-315d-4917-a6cc-95a112ba4348",
                                "sense_id": "a111eea1-5703-3d53-b8f1-d6058a75f449",
                                "text": "[Гаврик] мать помнил, но еле-еле: --- красные руки, киевское печатное кольцо на скользком, разбухшем пальце."
                            }
                        ]
                    },
                    {
                        "sense_id": "47e25b7e-5d65-3029-b676-101d793c23a6",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "напечатанный, опубликованный в печати"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1eceef-aa13-4a6b-933c-ed9275d82c02",
                                "sense_id": "47e25b7e-5d65-3029-b676-101d793c23a6",
                                "text": "Печатные варианты драмы."
                            },
                            {
                                "example_id": "f58be9d1-4abd-4f49-9936-950f7c710284",
                                "sense_id": "47e25b7e-5d65-3029-b676-101d793c23a6",
                                "text": "Я вообще избегаю разговоров о своей личности, и тем более разговоров печатных, которые имеют свойство привлекать, в качестве невольного посредствующего лица, публику."
                            },
                            {
                                "example_id": "845cc7f6-8523-4e1e-bc32-f0956b98b302",
                                "sense_id": "47e25b7e-5d65-3029-b676-101d793c23a6",
                                "text": "Федотова хвалили в газетах не раз, но к печатным похвалам он был равнодушен."
                            }
                        ]
                    },
                    {
                        "sense_id": "9816cec3-0b90-3a8f-bff4-a9739886f5d8",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "проф. связанный с сотами, ячейки которых закрыты печатками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78da9992-c6f4-4d10-bed6-f8abce51d56c",
                                "sense_id": "9816cec3-0b90-3a8f-bff4-a9739886f5d8",
                                "text": "Печатные соты, наглухо заделанные вощиной."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbccf2b1-6e23-3378-8591-2fb5236be63c",
                        "entry_id": "a09c70e5-b07a-38bf-83c9-aa0d42aff1aa",
                        "glosses": [
                            "устар. свойственный книжной речи"
                        ],
                        "tags": [],
                        "examples": []
                    }
