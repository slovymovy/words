{
    "word_family": [
        "Propaganda",
        "Propagandist",
        "Propagandistin",
        "propagandistisch",
        "Propagation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61524a39-b144-30a3-ba19-0fc311521500",
                    "sense_definition": "Eine Idee, Lehre oder Weltanschauung öffentlich verbreiten und aktiv dafür werben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ideen_verbreiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Umweltschützer <w>propagieren</w> seit Jahren einen bewussteren Verzicht auf Plastik."
                        },
                        {
                            "text": "In seinem Manifest <w>propagierte</w> der Philosoph völlig neue Ideen für die Gesellschaft."
                        }
                    ],
                    "synonyms": [
                        "befürworten",
                        "verbreiten",
                        "verfechten"
                    ],
                    "antonyms": [
                        "ablehnen",
                        "bekämpfen"
                    ],
                    "common_phrases": [
                        "eine Idee propagieren",
                        "einen Lebensstil propagieren"
                    ]
                },
                {
                    "sense_id": "9eaf8e9b-fb17-39e1-8577-f6b4a3e43a5d",
                    "sense_definition": "Ein Produkt werbend anpreisen, um dessen Verkauf gezielt zu fördern",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werbung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der Messe <w>propagierten</w> geschulte Verkäufer die Vorzüge der neuen Küchengeräte."
                        },
                        {
                            "text": "Der Berater <w>propagiert</w> ein spezielles Finanzprodukt zur langfristigen Absicherung der Familie."
                        }
                    ],
                    "synonyms": [
                        "anpreisen",
                        "bewerben"
                    ],
                    "common_phrases": [
                        "ein Produkt propagieren"
                    ]
                },
                {
                    "sense_id": "29410c03-d84d-365c-818b-b6b874573188",
                    "sense_definition": "Sich im Raum oder in einem Trägermedium ausbreiten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ausbreitung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Vakuum <w>propagieren</w> elektromagnetische Wellen mit konstanter Lichtgeschwindigkeit ungehindert."
                        },
                        {
                            "text": "Wenn das Signal durch festes Material <w>propagiert</w>, verringert sich seine Amplitude spürbar."
                        }
                    ],
                    "synonyms": [
                        "ausbreiten",
                        "fortpflanzen"
                    ],
                    "common_phrases": [
                        "durch ein Medium propagieren"
                    ]
                }
            ]
        }
    ]
}