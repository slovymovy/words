                "entry_id": "8280837b-dede-355a-b947-31592d014532",
                "word": "undelight",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c00a2fd5-3ee2-4b1e-b203-44e936de50e3",
                        "entry_id": "8280837b-dede-355a-b947-31592d014532",
                        "tags": [
                            "plural"
                        ],
                        "form": "undelights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd44ed7e-8061-3d8e-9519-64913cf1da29",
                        "entry_id": "8280837b-dede-355a-b947-31592d014532",
                        "glosses": [
                            "The condition or feeling of lacking delight; unhappiness or displeasure."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dda32d42-ba8f-4990-8556-d034085c74ee",
                                "sense_id": "cd44ed7e-8061-3d8e-9519-64913cf1da29",
                                "text": "Loud rise the sounds of sorrow, day and night,\nWhere friends, clasped close in lingering undelight,\nWeep at the thought of parting. Matrons, ay,"
                            }
                        ]
                    },
                    {
                        "sense_id": "b6145c07-e71d-30f2-bf64-870d938c1ad0",
                        "entry_id": "8280837b-dede-355a-b947-31592d014532",
                        "glosses": [
                            "Something unpleasant or displeasing."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca7fb172-be97-47fd-8991-e42b905c3e84",
                                "sense_id": "b6145c07-e71d-30f2-bf64-870d938c1ad0",
                                "text": "Along with the jollity of the trip from Tsing Hua into Peking are many undelights."
                            }
                        ]
                    }
                ],
