                "senses": [
                    {
                        "sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                        "entry_id": "54e82cd5-ca86-3894-8bc6-6fca120f94b3",
                        "glosses": [
                            "Relating to the science or research of archaeology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0303a8-b56a-41c9-9cfb-fb890223a6fb",
                                "sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                                "text": "A living floor is, in archaeological terms, the floor of a cave upon which people lived and which retains evidence of their activities."
                            },
                            {
                                "example_id": "8e392ef6-0ad7-4d7d-8c4d-3c6b4847d9af",
                                "sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                                "text": "The remains of 62 people were dug up at the previously unknown archaeological site near Garforth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22de5c5b-5f5e-4ed1-829f-2453952eb1e5",
                        "source_entry_id": "54e82cd5-ca86-3894-8bc6-6fca120f94b3",
                        "source_sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                        "source_sense_description": "relating to the science or research of archaeology",
                        "target_lang_word": "archeologisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archeologisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "099fea19-6c0f-3dc7-929f-5941a69374f2",
                                        "entry_id": "c70c3cd7-8ee5-361d-bda7-1dbc6dacd92a",
                                        "glosses": [
                                            "oudheidkundig, de archeologie betreffende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f95251-113f-4f90-a079-9d3be4572083",
                                                "sense_id": "099fea19-6c0f-3dc7-929f-5941a69374f2",
                                                "text": "Als het bodemarchief door toekomstige graafwerkzaamheden dieper dan 30 cm verstoord zal worden, is archeologisch onderzoek volgens de – Wet op de Archeologische Monumentenzorg – verplicht."
                                            },
                                            {
                                                "example_id": "a189bea3-edf7-404a-a8ff-42c04ad4ff47",
                                                "sense_id": "099fea19-6c0f-3dc7-929f-5941a69374f2",
                                                "text": "Archeologisch onderzoek op die plek heeft verstevigde kuilen uit die tijd blootgelegd waarin palen hebben gestaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4e83c13-06cf-404d-954d-335d1e1a0b20",
                        "source_entry_id": "54e82cd5-ca86-3894-8bc6-6fca120f94b3",
                        "source_sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                        "source_sense_description": "relating to the science or research of archaeology",
                        "target_lang_word": "oudheidkundig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oudheidkundig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "100b364c-c3d7-3853-9a2d-62e7f38cf58c",
                                        "entry_id": "153b217a-ac2a-3e59-9d9e-7bd7f6e4c634",
                                        "glosses": [
                                            "betrekking hebbend op de oudheid of de geschiedenis meer in het algemeen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d298e84-4a2d-4706-8248-23137ff14e4b",
                                                "sense_id": "100b364c-c3d7-3853-9a2d-62e7f38cf58c",
                                                "text": "Oude stadsfoto's, ter beschikking gesteld door het stadsarchief en de Koninklijke Oudheidkundige Kring, worden gebruikt als illustratie bij een aantal woorden."
                                            },
                                            {
                                                "example_id": "ce4e8b03-3413-45fd-9b17-d4a6c589c857",
                                                "sense_id": "100b364c-c3d7-3853-9a2d-62e7f38cf58c",
                                                "text": "De Pelmolen, het Parkgebouw, de Rijssense musea, het Leemspoor, Kulturhus, de Oudheidkundige kamer en ander cultuurhistorische bezienswaardigheden in Rijssen-Holten zijn voor toeristen niet goed te vinden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a6513b-5b42-4280-ba21-4ac919657ed7",
                        "source_entry_id": "54e82cd5-ca86-3894-8bc6-6fca120f94b3",
                        "source_sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                        "source_sense_description": "relating to the science or research of archaeology",
                        "target_lang_word": "archéologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archéologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af16743e-917d-3134-bd0b-b146e1a6a755",
                                        "entry_id": "ebacb93c-20da-3d22-b38b-ad54625dd235",
                                        "glosses": [
                                            "Relatif à l’archéologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ccf9a12-0562-4f53-b908-7491109a258f",
                                                "sense_id": "af16743e-917d-3134-bd0b-b146e1a6a755",
                                                "text": "Au début du printemps 1978, M. Destenay entreprit des travaux dans sa propriété proche de l'école et de l'église de Chéhéry. Il découvrit un sarcophage de pierre. Aussitôt il prévint les autorités archéologiques qui entreprirent une fouille de sauvetage."
                                            },
                                            {
                                                "example_id": "ca4930ec-f3ca-4bb7-8d2c-2780448753cd",
                                                "sense_id": "af16743e-917d-3134-bd0b-b146e1a6a755",
                                                "text": "L'utilisation du pois dans le Croissant fertile est attestée par des données archéologiques datant de 8000 av. J.-C."
                                            },
                                            {
                                                "example_id": "f0211b9d-c1c4-4e21-aafc-a1d3d27d6d75",
                                                "sense_id": "af16743e-917d-3134-bd0b-b146e1a6a755",
                                                "text": "Des fouilles archéologiques réalisées en 1874 ont permis de découvrir des ossements d’animaux datant de l’époque préhistorique, qui laissent penser que Chevroches était peut-être à cette époque un rendez-vous de chasse, […]."
                                            },
                                            {
                                                "example_id": "d788244b-f2b8-41b1-b594-f14dbb1fe831",
                                                "sense_id": "af16743e-917d-3134-bd0b-b146e1a6a755",
                                                "text": "La documentation archéologique y est malheureusement très rare pour le Haut Moyen Age, le site de Larina à Hières-sur-Amby (Isère) constituant une heureuse exception. Situé au confluent du Rhône et de l'Ain, ce promontoire escarpé a été occupé de la Préhistoire au IXᵉ siècle de notre ère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa265ead-b4d9-4055-bb30-4b372a12ba39",
                        "source_entry_id": "54e82cd5-ca86-3894-8bc6-6fca120f94b3",
                        "source_sense_id": "f6814670-3393-3e36-a54b-bb3f25c0d213",
                        "source_sense_description": "relating to the science or research of archaeology",
                        "target_lang_word": "archäologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archäologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe574d0-2dac-3567-82c1-0805fc611ba2",
                                        "entry_id": "4fe9ec81-e24a-37f6-8fd3-f53666f79531",
                                        "glosses": [
                                            "die Archäologie betreffend, nach Art der Archäologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83246f7c-5404-42d3-bfd8-958d43db7c6a",
                                                "sense_id": "ffe574d0-2dac-3567-82c1-0805fc611ba2",
                                                "text": "„Aufgrund archäologischer Funde sind zwar Anlagen wie Fürstensitze und Oppida bekannt, doch sie sind nicht typisch für die Siedlungs- und Lebensweise der einfachen keltischen Bevölkerung.“"
                                            },
                                            {
                                                "example_id": "c4ad9bea-acfc-4959-8a82-87fd51ba163d",
                                                "sense_id": "ffe574d0-2dac-3567-82c1-0805fc611ba2",
                                                "text": "„Dass es in all den Jahrhunderten weiträumige Handelsverbindungen gab, ist archäologisch belegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
