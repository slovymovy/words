                },
                {
                    "sense_id": "2814b102-3b78-36ae-8643-39787412546e",
                    "sense_definition": "Caractère de ce qui n'offre aucune garantie de durée, de solidité ou de certitude.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les philosophes rappellent souvent la <w>précarité</w> de l'existence humaine face au temps qui passe."
                        },
                        {
                            "text": "La <w>précarité</w> des accords diplomatiques rend la paix particulièrement instable dans cette région."
                        }
                    ],
                    "synonyms": [
                        "fragilité",
                        "incertitude"
                    ],
                    "antonyms": [
                        "durabilité",
                        "pérennité"
                    ],
                    "common_phrases": [
                        "précarité de l'existence",
                        "précarité de la vie"
                    ]
                },
                {
                    "sense_id": "78dfdde0-e51d-330b-b2c5-cf3c3b427f95",
                    "sense_definition": "Caractère d'une possession ou d'une jouissance d'un bien qui peut être révoquée à tout moment par son propriétaire légitime.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat stipule la <w>précarité</w> du droit d'occupation accordé au locataire de cet immeuble."
                        },
                        {
                            "text": "En droit civil, la <w>précarité</w> de la détention empêche formellement l'usucapion de la chose."
