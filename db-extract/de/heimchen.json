                        "source_sense_description": "Zoologie, Entomologie: Acheta domesticus, ein Vertreter der echten Grillen",
                        "target_lang_word": "grillon domestique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grillon domestique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3beb1f4c-0145-36d4-ac42-2933c3504e2e",
                                        "entry_id": "5fce3dce-f986-3d73-b6c4-620e6df5817d",
                                        "glosses": [
                                            "Espèce de grillon qui, en Europe et en Amérique du Nord, trouve la chaleur nécessaire à sa vie dans les habitations humaines et les stations de métro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ddcc72f-79b5-4f76-a703-0de85734a880",
                                                "sense_id": "3beb1f4c-0145-36d4-ac42-2933c3504e2e",
                                                "text": "Le grillon domestique, dont le bruit est si bien connu derrière le feu dans les soirées d’hiver, ressemble à la sauterelle par sa forme, son cri et sa manière de sauter, etc."
                                            },
                                            {
                                                "example_id": "1c7a101e-32b2-4f39-982f-b64e1f3f21ce",
                                                "sense_id": "3beb1f4c-0145-36d4-ac42-2933c3504e2e",
                                                "text": "On distingue le grillon champêtre, qui loge en terre dans des trous obliques, et le grillon domestique."
                                            },
                                            {
                                                "example_id": "4106afae-afa9-4d4a-bef7-0be3ffc0089e",
                                                "sense_id": "3beb1f4c-0145-36d4-ac42-2933c3504e2e",
                                                "text": "Le grillon domestique est une espèce introduite d’Europe. On le trouve aussi en Asie et dans le nord de l’Afrique. Il a fait son entrée au Canada et aux États-Unis au 18ᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
