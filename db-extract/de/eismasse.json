                ],
                "senses": [
                    {
                        "sense_id": "f7a03007-6dc4-3d69-b874-3512fb059098",
                        "entry_id": "696a4b6b-4b24-3e31-9039-a46acca0ecbc",
                        "glosses": [
                            "ein großer Körper, bestehend aus festen Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4195546b-24c0-40b9-a408-ae979ed6fc6d",
                                "sense_id": "f7a03007-6dc4-3d69-b874-3512fb059098",
                                "text": "„Reichen Gletscherzungen bis ins Meer, entstehen durch Loslösen („Kalbung“) von Eismassen Eisberge [sic!].“"
                            },
                            {
                                "example_id": "2eb0c6d8-6ebb-4c4e-9282-74a714b4bec2",
                                "sense_id": "f7a03007-6dc4-3d69-b874-3512fb059098",
                                "text": "„Als das Gewicht der Eismassen verschwand, hob sich die Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed57cc4b-6613-37e0-852c-a105f0f78ff7",
                        "entry_id": "696a4b6b-4b24-3e31-9039-a46acca0ecbc",
                        "glosses": [
                            "breiige Masse aus Speiseeis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b107f40a-9f64-4380-8023-262370c9d6ba",
                                "sense_id": "ed57cc4b-6613-37e0-852c-a105f0f78ff7",
                                "text": "„Zur Erzielung der typischen kremigen Konsistenz muss die Eismasse schnell in speziellen Kühlanlagen heruntergekühlt werden. Zusätzlich werden zahlreiche Zusatzstoffe, wie Stabilisatoren, Emulgatoren und Dickungsmittel zur Stabilisierung zugesetzt.“"
                            },
                            {
                                "example_id": "1284b6af-ed9b-459a-b073-cd63e531adf0",
                                "sense_id": "ed57cc4b-6613-37e0-852c-a105f0f78ff7",
                                "text": "„Da Speiseeis im Wesentlichen aus rohen und teilweise pürierten Zutaten besteht sowie durch das Aufschlagen eine große Oberfläche besitzt, stellt es einen guten Nährboden für Bakterien dar, die möglicherweise schon in den Zutaten vorhanden waren oder bei der Herstellung in die Eismasse gelangt sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
