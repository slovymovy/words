                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aface0c0-feb5-3892-8153-420c32a74fdf",
                                        "entry_id": "e93318df-cd44-3df1-b614-aa1377bd0cc7",
                                        "glosses": [
                                            "Resembling or characteristic of a geek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aceab0f5-d68f-4986-9663-1e2036592642",
                                                "sense_id": "aface0c0-feb5-3892-8153-420c32a74fdf",
                                                "text": "Buddy Holly is a slightly more contentious inclusion, even if he did live fast, die young and leave a geeky-looking corpse."
                                            },
                                            {
                                                "example_id": "6423e72d-d8b8-405f-b36f-1d2e4599f67d",
                                                "sense_id": "aface0c0-feb5-3892-8153-420c32a74fdf",
                                                "text": "In America, where classics like Monopoly dominate, Eurogames still have an avidly geeky following."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
