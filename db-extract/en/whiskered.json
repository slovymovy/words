                                "target_senses": [
                                    {
                                        "sense_id": "23d4e89d-e0ef-3615-b2a7-2a5c60d766d3",
                                        "entry_id": "ed12276f-0009-3aba-a8d8-c8ec8a94cc7f",
                                        "glosses": [
                                            "Qui a de la barbe, qui porte une barbe."
                                        ],
                                        "tags": [
                                            "Barbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5815d5ce-d61c-4125-89b5-0105ee83194d",
                                                "sense_id": "23d4e89d-e0ef-3615-b2a7-2a5c60d766d3",
                                                "text": "Il y avait là Legray, le photographe, Lockroy, le dessinateur, etc., enfin, une quatorzaine de troupiers finis, plus ou moins moustachus, plus ou moins barbus, le sac au dos, le fusil à deux coups sur l'épaule, et chacun avec un râtelier varié à sa ceinture."
                                            },
                                            {
                                                "example_id": "99f277f2-fbb7-468f-bcce-5585d40d4eff",
                                                "sense_id": "23d4e89d-e0ef-3615-b2a7-2a5c60d766d3",
                                                "text": "D’un étage à l’autre, c’était un remue-ménage incessant de paras, qui montaient et descendaient, chassant devant eux des Musulmans, prisonniers déguenillés, barbus de plusieurs jours."
                                            },
                                            {
                                                "example_id": "6d768e80-6267-493d-a985-b6e0de9b1429",
                                                "sense_id": "23d4e89d-e0ef-3615-b2a7-2a5c60d766d3",
                                                "text": "La chèvre est un animal barbu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788bcdcf-68fb-3e23-990d-91b6c2848337",
                                        "entry_id": "ed12276f-0009-3aba-a8d8-c8ec8a94cc7f",
                                        "glosses": [
                                            "Qualifie les parties d’un végétal qui ont des touffes de poils, de barbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a491d92b-7f3e-4d77-b1fd-e8f9c64e35c1",
                                                "sense_id": "788bcdcf-68fb-3e23-990d-91b6c2848337",
                                                "text": "Les anthères du charme sont barbues."
                                            },
                                            {
                                                "example_id": "f7c2e68d-9183-4cf5-92ab-a5a70a5abfb0",
                                                "sense_id": "788bcdcf-68fb-3e23-990d-91b6c2848337",
                                                "text": "La feuille du tilleul est barbue à l’angle des nervures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barbu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1dbbe47-b519-37a4-9e0e-c11eb23cbf77",
                                        "entry_id": "609be531-ab90-34fc-b6cf-ce487dad8c5b",
                                        "glosses": [
                                            "Personne qui porte une barbe."
                                        ],
                                        "tags": [
                                            "Barbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce76315-45a9-41dd-84da-077a05da7005",
                                                "sense_id": "d1dbbe47-b519-37a4-9e0e-c11eb23cbf77",
                                                "text": "Le feuilleton radiophonique « Malheur aux barbus » raconte le mystérieux enlèvement, par l’aventurier Edmond Furax, de tous les hommes portant une barbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4fb06a6-b5c5-3d21-b564-ef8de621db5b",
                                        "entry_id": "609be531-ab90-34fc-b6cf-ce487dad8c5b",
                                        "glosses": [
                                            "Intégriste musulman."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27205f6-8795-4e6f-8601-378e663eb693",
                                                "sense_id": "b4fb06a6-b5c5-3d21-b564-ef8de621db5b",
                                                "text": "Souffrant lui, le modéré, de l’amalgame que les Occidentaux font encore entre terrorisme et islam et dont les véritables déclencheurs sont,selon lui, les barbus et autres porteuses de voile, il n’hésite pourtant pas à monter au créneau pour défendre d’autres faiseurs d’amalgames dans le genre, de l’obscurantisme aveugle des islamistes…"
                                            },
                                            {
                                                "example_id": "979deebf-c0b0-4275-af9a-870aa443e446",
                                                "sense_id": "b4fb06a6-b5c5-3d21-b564-ef8de621db5b",
                                                "text": "« Par exemple, je n’oublierai jamais quand tante Gertrude m’a qualifié d’idiot utile des barbus, et que j’ai répliqué en imitant des bruits d’épouvantail islamiste. Ooouuuhhhh, les méchants terroristes s’en viennent, tante Gertrude, oouuuhhh! Ils vont te forcer à mettre le voile ! »"
                                            },
                                            {
                                                "example_id": "8776039a-7f5f-4aa6-b486-f827a2878568",
                                                "sense_id": "b4fb06a6-b5c5-3d21-b564-ef8de621db5b",
                                                "text": "Pour « L’Échelle de Jacob », ce mythe évoqué par les trois religions, un barbu est venu spécialement d'Anvers pour me dire que Jacob n'est pas cité dans le Coran. Il n'était pas menaçant, mais inquiétant."
                                            },
                                            {
                                                "example_id": "b3f5867a-d399-4d73-95fe-3f2b16ef916a",
                                                "sense_id": "b4fb06a6-b5c5-3d21-b564-ef8de621db5b",
                                                "text": "— Ah, l’agneau ! soupira Farid en savourant ce mot. Les seules personnes à Kaboul qui en mangent encore aujourd’hui sont les talibans. (Un véhicule s’approcha et il me tira par la manche.) Quand on parle du loup… Voilà la patrouille des barbus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7bbc405-b194-3124-a506-10c2b25f963e",
                                        "entry_id": "609be531-ab90-34fc-b6cf-ce487dad8c5b",
                                        "glosses": [
                                            "Personne qui porte malheur pour les ventes, la superstition des camelots étant que les personnes barbues nuisent à la démonstration."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb187c1-6c7d-4b67-8b4e-982644824ede",
                                                "sense_id": "f7bbc405-b194-3124-a506-10c2b25f963e",
                                                "text": "Le questionnant sur les raisons de cette interruption, il m’avait fait une curieuse réponse : « Je refuse de faire une dem devant un barbu. […] Par la suite, j’ai donc pu préciser quels barbus étaient particulièrement visés : ceux qui portent des mocassins en cuir et qui ont une petite sacoche à l’épaule (« baise-en-ville »). Surtout, j’ai compris le problème associé aux barbus. […] Le problème associé aux barbus est qu’ils manifesteraient plus que les autres leur scepticisme et que, surtout, ils poseraient continuellement des questions et insisteraient pour que les démonstrateurs y répondent point par point. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barbu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43c71d18-f304-3c71-b69f-39091774a7db",
                                        "entry_id": "d7a8f540-01e9-3443-9cfe-4e532a7c5380",
                                        "glosses": [
                                            "Jeu de cartes dans lequel le roi de cœur est appelé par ce nom."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dde39a4-c5a9-31b9-b537-88e6f2b67f18",
                                        "entry_id": "d7a8f540-01e9-3443-9cfe-4e532a7c5380",
                                        "glosses": [
                                            "Barbeau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67620a8f-af8a-3ca6-ba1e-eadc34b1d54e",
                                        "entry_id": "d7a8f540-01e9-3443-9cfe-4e532a7c5380",
                                        "glosses": [
                                            "Nom normalisé donné à deux genres d'oiseaux grimpeurs et frugivores de la famille des mégalaimidés (ordre des piciformes) comprenant 35 espèces à bec conique et allongé entouré de longs poils raides ou vibrisses, dont le plumage, et en particulier la gorge, est souvent remarquable par la beauté et la richesse des couleurs, de silhouette trapue et à tête surdimensionnée, que l'on retrouve dans les forêts tropicales et subtropicales de l'écozone indomalaise (genres Psilopogon et Caloramphus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7086a5-94bb-449d-b681-fb3970b84617",
                                                "sense_id": "67620a8f-af8a-3ca6-ba1e-eadc34b1d54e",
                                                "text": "Un barbu de la Malaisie (Bucco pyrolophus Temm.), devenu le type d'un genre dans les classifications modernes (Pyrolophus Mùll.), et dont M. Eyton nous a fait connaître l'ostéologie, a encore un sternum très semblable à celui des Mégalèmes, l'apophyse antérieure paraît toutefois être un peu moins mince."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0660528f-529b-36c5-ab61-fb490ce3dea3",
                                        "entry_id": "d7a8f540-01e9-3443-9cfe-4e532a7c5380",
                                        "glosses": [
                                            "Nom que l'on donnait indifféremment aux XVIIIe et XIXe siècles à de nombreux petits oiseaux grimpeurs de l'ordre des piciformes tant de l'Ancien que du Nouveau Monde, qui étaient réunis artificiellement dans une ou deux familles qui ont été graduellement scindées et dont les genres vernaculaires ont été rebaptisés de manière à les départager selon les connaissances de la systématique, ne laissant de \\\"vrais\\\" barbus que ceux de la famille des mégalaimidés de la région indomalaise."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9a7eed-28ef-4267-aae1-ff67e52be118",
                                                "sense_id": "0660528f-529b-36c5-ab61-fb490ce3dea3",
                                                "text": "Les barbus de l'époque de Brisson, Buffon, et Cuvier ont reçu de nouveaux noms par la suite pour les distinguer taxinomiquement selon les différentes familles auxquelles ils appartenaient, ce qui nous a donné les barbicans, barbions, barbacous, cabézons et tamatias d'aujourd'hui."
                                            },
                                            {
                                                "example_id": "d0e4311c-790b-4889-8f90-eb8018811502",
                                                "sense_id": "0660528f-529b-36c5-ab61-fb490ce3dea3",
                                                "text": "Dans les oiseaux, si l’on recherche cette physionomie, on s’apercevra aisément que tous ceux qui, relativement à la grosseur de leur corps, ont une tête légère avec un bec court et fin, ont en même temps la physionomie fine, agréable et presque spirituelle ; tandis que ceux au contraire qui, comme les barbus, ont une trop grosse tête, ou qui, comme les toucans, ont un bec aussi gros que la tête, se présentent avec un air stupide, rarement démenti par leurs habitudes naturelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
