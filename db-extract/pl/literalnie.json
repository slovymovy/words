        "pl-extract.jsonl": [
            {
                "entry_id": "1b05dc05-506a-319d-bfe1-dbf83bef58dd",
                "word": "literalnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c497cfa1-e470-3e4d-ab4c-3bbb6b289d2b",
                        "entry_id": "1b05dc05-506a-319d-bfe1-dbf83bef58dd",
                        "glosses": [
                            "w sposób literalny, w sposób dosłowny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22bf51df-f086-47a5-99f5-ac1bb7676132",
                                "sense_id": "c497cfa1-e470-3e4d-ab4c-3bbb6b289d2b",
                                "text": "Standardowa formuła podziękowania współmałżonkowi wypowiadana przez jubilatów nawiązywała literalnie do tej, którą wygłaszano w czasie ślubu cywilnego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bce9ed1c-f26b-417f-b59f-cdc1847d236a",
                        "source_entry_id": "1b05dc05-506a-319d-bfe1-dbf83bef58dd",
                        "source_sense_id": "c497cfa1-e470-3e4d-ab4c-3bbb6b289d2b",
                        "target_lang_word": "literally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "literally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30d4f33d-21b6-3ac6-97e7-83fb0ffd9039",
                                        "entry_id": "81399630-c58b-3fa9-bf4a-632f3ed796d5",
                                        "glosses": [
                                            "Word for word, exactly as stated.",
                                            "Without overstatement or understatement, or false or misleading words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90dc4955-c470-4bc5-a4db-ae2c45dedd8f",
                                                "sense_id": "30d4f33d-21b6-3ac6-97e7-83fb0ffd9039",
                                                "text": "He's prone to exaggeration, so don't take what he says literally."
                                            },
                                            {
                                                "example_id": "5b63e270-0817-46f4-b71a-64ae464ffed3",
                                                "sense_id": "30d4f33d-21b6-3ac6-97e7-83fb0ffd9039",
                                                "text": "There are literally millions of individual pieces of space debris orbiting Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                        "entry_id": "81399630-c58b-3fa9-bf4a-632f3ed796d5",
                                        "glosses": [
                                            "Word for word, exactly as stated.",
                                            "With phrasings that might normally be used or understood as figurative: truly; not figuratively; not as an idiom or metaphor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bb9da0b-466b-40dd-83b3-2fe5ec202ff2",
                                                "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                                "text": "When I saw on the news that there would be no school tomorrow because of the snowstorm, I literally jumped for joy, and hit my head on the ceiling fan."
                                            },
                                            {
                                                "example_id": "3f16d68c-2539-4f21-ba6b-59318a6c2c93",
                                                "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                                "text": "I didn't have time to repair the wall, so I literally just papered over the cracks."
                                            },
                                            {
                                                "example_id": "99a3357f-4439-4f40-8537-9d8d9f155881",
                                                "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                                "text": "Lights were going out. A raid! A raid! It was a panic, literally, in a whorehouse!"
                                            },
                                            {
                                                "example_id": "b1a35754-67be-4ccb-a2bd-802229475efc",
                                                "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                                "text": "All events became omens; I lost the ability to take anything literally."
                                            },
                                            {
                                                "example_id": "42845980-f7be-4386-b1ec-f5289e953896",
                                                "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                                "text": "[…] Men In Black 3 finagles its way out of this predicament by literally resetting the clock with a time-travel premise that makes Will Smith both a contemporary intergalactic cop in the late 1960s and a stranger to Josh Brolin, who plays the younger version of Smith’s stone-faced future partner, Tommy Lee Jones."
                                            },
                                            {
                                                "example_id": "7c0b3b62-fcda-4d71-96e3-a87a7056696e",
                                                "sense_id": "10a9f47b-5492-30bb-a799-5366ede1d289",
                                                "text": "As lawmakers and staff rushed out, aides snatched the boxes containing the Electoral College certificates, making sure that the vandals could not literally steal the results of the election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8c783b3-6a28-39f5-aeca-971632d8d36a",
                                        "entry_id": "81399630-c58b-3fa9-bf4a-632f3ed796d5",
                                        "glosses": [
                                            "Word for word, exactly as stated.",
                                            "Draws attention to a pun or other wordplay involving an idiom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202e64ef-18f0-4d9d-b21d-bab0b9f4bf40",
                                                "sense_id": "f8c783b3-6a28-39f5-aeca-971632d8d36a",
                                                "text": "My daughter's pet rabbit had babies, and now we've literally got rabbits coming out of our ears."
                                            },
                                            {
                                                "example_id": "bc7a4682-9666-484e-83de-bb870d774fac",
                                                "sense_id": "f8c783b3-6a28-39f5-aeca-971632d8d36a",
                                                "text": "What literally broke the ice that first night was when a 98-year-old retired professor spoke up. “Well, I have a choice of what to think about when I have insomnia at night. Being a lover of mathematics, last night when I couldn't sleep, I decided to calculate the tonnage of ice I delivered as a boy.”"
                                            },
                                            {
                                                "example_id": "4fe649a1-498a-4bf2-b468-1a1a94364fc3",
                                                "sense_id": "f8c783b3-6a28-39f5-aeca-971632d8d36a",
                                                "text": "Outside of all the learned institutions of his country, and while employed with his chisel and hammer, as a stone mason, this man literally killed two birds with one stone; for he earned his daily bread and at the same time made himself an eminent geologist, and gave to the world books which are found in all public libraries and which are full of inspiration to the truth seeker."
                                            },
                                            {
                                                "example_id": "b08a7d6a-83a4-49ef-8e77-f3ec94cc4c4b",
                                                "sense_id": "f8c783b3-6a28-39f5-aeca-971632d8d36a",
                                                "text": "Profit and corporate giving are, quite literally, two sides of the same coin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1252c7-3d23-399d-bdb9-1d4bff641871",
                                        "entry_id": "81399630-c58b-3fa9-bf4a-632f3ed796d5",
                                        "glosses": [
                                            "As an intensifier.",
                                            "Used as a general intensifier or dramatiser, sometimes tending towards a meaningless filler."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20472e58-6df5-475b-8b4b-a9ae9e528e66",
                                                "sense_id": "ad1252c7-3d23-399d-bdb9-1d4bff641871",
                                                "text": "I had no idea, so I was literally guessing."
                                            },
                                            {
                                                "example_id": "f0379272-93d2-4b25-8244-cedf724ec118",
                                                "sense_id": "ad1252c7-3d23-399d-bdb9-1d4bff641871",
                                                "text": "I was literally having breakfast when she arrived."
                                            },
                                            {
                                                "example_id": "57edf766-01cc-48df-a7d5-e1c927e4dd8d",
                                                "sense_id": "ad1252c7-3d23-399d-bdb9-1d4bff641871",
                                                "text": "She was literally like, \"What?\", and I was literally like, \"Yeah\"."
                                            },
                                            {
                                                "example_id": "044676bc-fb6f-4c2d-840d-c525f335d758",
                                                "sense_id": "ad1252c7-3d23-399d-bdb9-1d4bff641871",
                                                "text": "Literally who is this?"
                                            },
                                            {
                                                "example_id": "996a6a9b-59c7-407a-a62f-b61fbe858e2f",
                                                "sense_id": "ad1252c7-3d23-399d-bdb9-1d4bff641871",
                                                "text": "Pearl: Steven, we are not like the No Home Boys. We are literally standing in your home right now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                        "entry_id": "81399630-c58b-3fa9-bf4a-632f3ed796d5",
                                        "glosses": [
                                            "As an intensifier.",
                                            "Used as an intensifier with statements or terms that are in fact meant figuratively and not word for word as stated: virtually, so to speak."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a434d0a1-5677-474e-9e48-802687ef798f",
                                                "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                                "text": "He was so surprised, he literally jumped twenty feet in the air."
                                            },
                                            {
                                                "example_id": "b17a3c65-4a78-4dd0-9fe0-401eca435047",
                                                "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                                "text": "On 9/11 people were literally glued to their TV sets."
                                            },
                                            {
                                                "example_id": "2d9381f2-424d-4da2-b7e3-fda2650075b8",
                                                "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                                "text": "People can't even express their opinions freely in this country any more. Literally 1984!"
                                            },
                                            {
                                                "example_id": "12ee1c36-dbf5-467d-9bf6-3c34da86a753",
                                                "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                                "text": "The house was literally electrified; and it was only from witnessing the effects of her genius that he could guess to what a pitch theatrical excellence could be carried."
                                            },
                                            {
                                                "example_id": "19523fd4-378d-4f2b-b1b1-108e3201eeda",
                                                "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                                "text": "You literally become the ball in a tennis match, you become the report that you are working on […]"
                                            },
                                            {
                                                "example_id": "3064d535-c657-4911-970d-d951afae9b34",
                                                "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                                                "text": "[O]ne can assume that the millions or billions of ringgit spent on the war against drugs have gone down the drain, literally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89b68ca-f825-3253-b0f4-6456fcc0f37c",
                                        "entry_id": "81399630-c58b-3fa9-bf4a-632f3ed796d5",
                                        "glosses": [
                                            "Used as a generic downtoner: just, merely."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425af302-ba9f-4879-9ba3-8db6fd64c542",
                                                "sense_id": "a89b68ca-f825-3253-b0f4-6456fcc0f37c",
                                                "text": "It's not even hard⁠ to make—you literally just put it in the microwave for five minutes and it's done."
                                            },
                                            {
                                                "example_id": "a6c210a6-0162-4b03-9191-22631f2d847b",
                                                "sense_id": "a89b68ca-f825-3253-b0f4-6456fcc0f37c",
                                                "text": "It won't take me long to get back, 'cause the store's literally two blocks away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
