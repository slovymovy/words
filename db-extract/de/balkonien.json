                ],
                "senses": [
                    {
                        "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                        "entry_id": "d86a032d-5121-3f57-bb6e-af37d85b9898",
                        "glosses": [
                            "jemandes eigener (blumengeschmückter) Balkon (der als fiktives Urlaubsland den Ort der Erholung und Entspannung bezeichnet)"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb8183c-6184-4aba-ab9e-c16b9c115c47",
                                "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                                "text": "Dieses Jahr reicht das Geld nur zum Urlaub auf Balkonien."
                            },
                            {
                                "example_id": "dfef68a2-d784-4188-a927-6e90f99b5f39",
                                "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                                "text": "„Balkonien ist ein merkwürdiges Land. Es liegt über der Straße, manchmal so niedrig, daß die oberen Stockwerke der Autobusse es fast streifen;[…].“"
                            },
                            {
                                "example_id": "1a61f22d-57ca-4c3e-836d-10ee7bff3694",
                                "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                                "text": "„Die Zahlen des Emrid-Instituts belegen, daß angesichts des Jahrhun[d]ertsommers vielen Balkonien als geeigneter Platz zum Ausspannen vom Arbeitsstreß erschien.“"
                            },
                            {
                                "example_id": "5f5749e7-8c5d-49fc-aed5-8ff706781398",
                                "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                                "text": "„Die Offerten sind verlockend: Anzeigen auf den Reiseseiten, Preistafeln an Reisebüros in Flughäfen sollen auch den letzten Zweifler überzeugen, der eigentlich Ferien in Balkonien und am heimischen Baggersee geplant hatte.“"
                            },
                            {
                                "example_id": "2c1e20a8-07a1-4d9c-a477-5a3205334149",
                                "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                                "text": "„Anwohner der Crellestraße erwarten die geselligen Abendstunden auf Balkonien ([…]).“"
                            },
                            {
                                "example_id": "53332526-77cc-4419-892f-d58e360d60da",
                                "sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                                "text": "„Da helfen hell violett blühende Herbstzeitlose oder hellblaue Herbstkrokusse. Letztere sollten jetzt in die Erde, dann bleibt es bis in den Oktober blau auf Balkonien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b70a07ac-cb3f-4562-9c52-1e1f8be360ea",
                        "source_entry_id": "d86a032d-5121-3f57-bb6e-af37d85b9898",
                        "source_sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                        "source_sense_description": "scherzhaft: jemandes eigener Balkon",
                        "target_lang_word": "balcony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balcony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3e4bfe-c180-36fa-8625-7ec146e4b543",
                                        "entry_id": "4a7f9f20-c95b-3cb7-ad1e-663d58dd4a77",
                                        "glosses": [
                                            "An accessible structure extending from a building, especially outside a window."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4127001e-4f8d-4d0b-8a0f-26f0f748aa98",
                                                "sense_id": "7e3e4bfe-c180-36fa-8625-7ec146e4b543",
                                                "text": "I sprang a step forward; when two shadows were distinctly traced on the moonlit myrtle! Then two figures stood upon the balcony. A young cavalier jumped from the balustrade, and hurried down the path that led to the garden, where I well remember a gate opened on an unfrequented lane."
                                            },
                                            {
                                                "example_id": "c0e3782a-db62-4fb9-ac0d-00ce8b18043a",
                                                "sense_id": "7e3e4bfe-c180-36fa-8625-7ec146e4b543",
                                                "text": "The next day as the three travelers were approaching the town, Peter went out on the balcony to pray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6febfc5c-8c47-3c34-8d6a-b91dd77b8522",
                                        "entry_id": "4a7f9f20-c95b-3cb7-ad1e-663d58dd4a77",
                                        "glosses": [
                                            "An accessible structure overlooking a stage or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e81eab6-0dc4-40bd-8a5b-de26a7847782",
                                                "sense_id": "6febfc5c-8c47-3c34-8d6a-b91dd77b8522",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "838bc2a4-5b24-43c1-a624-e455aaef298c",
                        "source_entry_id": "d86a032d-5121-3f57-bb6e-af37d85b9898",
                        "source_sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                        "source_sense_description": "scherzhaft: jemandes eigener Balkon",
                        "target_lang_word": "staycation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staycation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0935f9c7-2c54-3559-966d-02032b801966",
                                        "entry_id": "19fd6ed8-e9b4-3c07-a021-f61fe541238a",
                                        "glosses": [
                                            "A vacation spent at or close to home."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0c96c6-4212-4f9c-9497-f538d4a66bb7",
                                                "sense_id": "0935f9c7-2c54-3559-966d-02032b801966",
                                                "text": "Increasing product lifespans and decreased energy use may also enable both efficiency and sufficiency [...]. This includes means by which materials are used more productively (i.e. the same quantity providing a longer service) and throughput is slowed (i.e. products are replaced less frequently, plus, in the case of tourism, distance of travel is less – the so-called ‘staycation’ approach)."
                                            },
                                            {
                                                "example_id": "4666483a-107e-4b75-8aea-d6e2c1ae2f85",
                                                "sense_id": "0935f9c7-2c54-3559-966d-02032b801966",
                                                "text": "This extreme \"no\" discretionary spending plan does not have to eliminate fun from your life. It actually challenges you to find creative sources of entertainment and \"staycations\" (vacations at home or near your home town)."
                                            },
                                            {
                                                "example_id": "0e34d242-dbcd-4464-b430-910e873b01bd",
                                                "sense_id": "0935f9c7-2c54-3559-966d-02032b801966",
                                                "text": "We need to encourage stay-close-to-home vacations, or \"stay-cations,\" and check out nature's splendor, recreational opportunities and entertainment attractions nearby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                        "entry_id": "19fd6ed8-e9b4-3c07-a021-f61fe541238a",
                                        "glosses": [
                                            "A vacation spent at or close to home.",
                                            "A vacation spent at one's own home without other overnight accommodation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b25e861-37dc-45fe-a1bc-a459dadc5428",
                                                "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                                "text": "If you're feeling the pinch of high gas prices and job woes, try a \"Staycation\", the new industry term for staying at home and enjoying yourself."
                                            },
                                            {
                                                "example_id": "a8c738a2-6ee7-4611-9652-dd5f62a81fb5",
                                                "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                                "text": "Instead of going away for a vacation, consider a staycation. That's when you stay home and explore your hometown—try a new restaurant, hike a local park, or visit that museum you've been meaning to check out."
                                            },
                                            {
                                                "example_id": "36881086-d62a-47aa-8ca6-386477c6d61c",
                                                "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                                "text": "[O]ne family I know realized they didn't have the money available for their usual summer camping trip. So instead of going on a vacation they decided to have a \"staycation.\" They parked their pop-up camper in their driveway at home, set up some tents on the lawn, and slept in them every night. They cooked out every day with the grill and found free concerts, museums, and events in their own city."
                                            },
                                            {
                                                "example_id": "d24d87c2-b6ae-4b27-8dd6-35f512308e38",
                                                "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                                "text": "For me, whether I'm on a visit to a monastery in Greece or an elaborately planned staycation (that involves disengaging from all my devices, going on long hikes or walks, yoga classes and unhurried meditations, sleeping in with no alarms, and reading actual books you can underline that have nothing to do with work), the essential element is to regain that sense of wonder."
                                            },
                                            {
                                                "example_id": "9bcec744-cff8-4eb9-992f-58f7db306328",
                                                "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                                "text": "I could stop this right now, I thought. We could unpack the car and go back to our lives—a staycation in our own home."
                                            },
                                            {
                                                "example_id": "6958c8b2-6726-4d80-9adf-7148d5169436",
                                                "sense_id": "ba3d0c67-d0f1-30c3-a52b-401f22f32fd3",
                                                "text": "[...] Melissa uses some of her annual leave to add two days to a three-day weekend, and these five spontaneous days off became not only a Greenwich Village stay-cation but also something of the honeymoon we were too busy to take together in our hectic \"uni-moon\" days. But what to do on our stay-cation? Ten thousand Big Apple activities beckon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e92082-f0b4-356a-a98a-431fd0d57a80",
                                        "entry_id": "19fd6ed8-e9b4-3c07-a021-f61fe541238a",
                                        "glosses": [
                                            "A vacation spent at or close to home.",
                                            "A holiday spent in one's own country without travelling abroad."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fd97b9-1511-4d70-bdab-e89e6964553e",
                                                "sense_id": "a6e92082-f0b4-356a-a98a-431fd0d57a80",
                                                "text": "It's holiday time again. Having invented the staycation – no, I don't like the word either – four years ago when we ran out of money and out of patience with French traffic, we are sticking to principle and, as we did four months ago, hanging out at Tom Hodgkinson's gaff in north Devon."
                                            },
                                            {
                                                "example_id": "3000a20a-aac2-4d3f-9f48-1a2d6549188f",
                                                "sense_id": "a6e92082-f0b4-356a-a98a-431fd0d57a80",
                                                "text": "Somewhere in the last few decades the stacation was substituted for the prestige and glamour of the trip abroad, and the recent flurry of low cost airlines all but cemented that as the new tradition for those that can afford it."
                                            },
                                            {
                                                "example_id": "8ed3f7d9-598e-4927-a06c-3abad5dd43a8",
                                                "sense_id": "a6e92082-f0b4-356a-a98a-431fd0d57a80",
                                                "text": "The rise in patronage partly reflects the growing trend for ‘staycations’ in the UK, in addition to Pitlochry’s status as the southern gateway to the world-famous Cairngorms National Park."
                                            },
                                            {
                                                "example_id": "32fac021-2525-471d-aa82-8bb4adca04c0",
                                                "sense_id": "a6e92082-f0b4-356a-a98a-431fd0d57a80",
                                                "text": "Many families who had planned to go away for the easter holidays are now deciding to grab a tent and go on an isolated family camping stacations to ensure the kids are still entertained as many holiday resorts go on possible lockdown."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staycation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "641a08e9-9988-38ef-86e0-315b2c729d1d",
                                        "entry_id": "abebee5f-6bd4-31be-a2b8-ab92998cacc8",
                                        "glosses": [
                                            "To spend a vacation at or close to home."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bac82db-9e69-4182-aa5b-3283c0f00800",
                                                "sense_id": "641a08e9-9988-38ef-86e0-315b2c729d1d",
                                                "text": "They may fill some of the airline seats and hotel rooms left vacant by staycationing locals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                        "entry_id": "abebee5f-6bd4-31be-a2b8-ab92998cacc8",
                                        "glosses": [
                                            "To spend a vacation at or close to home.",
                                            "To take a holiday in one's own country as opposed to travelling abroad."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "661f4ab8-1fd8-419c-b591-a5aabc919389",
                                                "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                                "text": "[...] I staycationed there this summer, enjoying the ancient town of Sandbach with Saxon crosses in its cobbled square; [...]"
                                            },
                                            {
                                                "example_id": "9f46a84d-b787-4fa7-be22-95901c49f6a5",
                                                "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                                "text": "Having ‘staycationed’ with her sister in Kinnity, Co Offaly for the past four years, and with a budget of around €350, Bronwyn O’Brien says she’d just be happy to see the inside of a plane. “Although I didn’t mind holidaying at home, there’s nothing like getting on an airplane and feeling the heat hit your face the minute you arrive,” she tells."
                                            },
                                            {
                                                "example_id": "ff29fcde-9428-4859-a595-17b2bdd3aa62",
                                                "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                                "text": "It's that time of the year when deleting Instagram seems like a sensible mode of self-preservation for people staycationing, or quite simply stuck on home soil, while others are hashtagging #HotGirlSummer all over the continent."
                                            },
                                            {
                                                "example_id": "c5ff570c-e440-49e7-b845-6cb0017fc5e1",
                                                "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                                "text": "Baz [Ashmawy] and his family are staycationing in Ireland this summer due to the Covid-19 pandemic"
                                            },
                                            {
                                                "example_id": "abc251c6-0e41-44b8-8fef-200200e5b03d",
                                                "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                                "text": "Over the last few weekends traffic is back with a vengeance, with families breaking out of lockdown to staycation in the UK and visit the coast, countryside and shops."
                                            },
                                            {
                                                "example_id": "c5509429-6cd6-461f-bdf2-1ae74a110cd9",
                                                "sense_id": "3b2f6de8-b576-3b90-a015-4a0a81b444e8",
                                                "text": "RTE star Mary Kennedy has said that it is \"so nice to explore our lovely country\" as she staycations on Inis Oirr with her friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96cedd1c-8fba-3e2c-85d1-b0f11d282158",
                                        "entry_id": "abebee5f-6bd4-31be-a2b8-ab92998cacc8",
                                        "glosses": [
                                            "To spend a vacation at or close to home.",
                                            "To spend a vacation at one's own home without other overnight accommodation."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c26ea095-aa33-4640-a6df-f5de929b2583",
                                                "sense_id": "96cedd1c-8fba-3e2c-85d1-b0f11d282158",
                                                "text": "Plan a staycation: Enjoy your own house, your own backyard, your own town. [...] This was the third summer the Wyatts and their two children have staycationed in Virginia Beach."
                                            },
                                            {
                                                "example_id": "bea82089-95f5-4d90-b311-ca1431ec4d6a",
                                                "sense_id": "96cedd1c-8fba-3e2c-85d1-b0f11d282158",
                                                "text": "If you're heading for the water today, or staycationing by the pool, you'll need something to read, right?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea4ccac8-f837-40f8-81b2-12340b54cc8e",
                        "source_entry_id": "d86a032d-5121-3f57-bb6e-af37d85b9898",
                        "source_sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                        "source_sense_description": "scherzhaft: jemandes eigener Balkon",
                        "target_lang_word": "have a staycation, go on staycation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2f226ba7-69d4-45a7-b150-b989813dcbba",
                        "source_entry_id": "d86a032d-5121-3f57-bb6e-af37d85b9898",
                        "source_sense_id": "b05f4cc2-9d7d-3912-a2f8-00d41f99f6d8",
                        "source_sense_description": "scherzhaft: jemandes eigener Balkon",
                        "target_lang_word": "balcon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balcon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6607c809-1f71-3d67-8065-db2b923c18a3",
                                        "entry_id": "f2d458cf-017e-3aaf-a4b1-f97fb2cdb16c",
                                        "glosses": [
                                            "Plate-forme en saillie sur la façade d'un bâtiment, entourée d’une balustrade et soutenue ordinairement par des colonnes ou des consoles, qui communique avec les appartements par une ou plusieurs ouvertures, baies ou fenêtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfeb5ce1-2e95-4396-989e-6af637cd3eef",
                                                "sense_id": "6607c809-1f71-3d67-8065-db2b923c18a3",
                                                "text": "Combien de balcons en ferronnerie, de mascarons, de pilastres nous restituent l'image de ce que fut cette cité au XVIᵉ, au XVIIᵉ, au XVIIIᵉ siècle."
                                            },
                                            {
                                                "example_id": "22eb3da1-0890-444d-8e49-05a8969f8f40",
                                                "sense_id": "6607c809-1f71-3d67-8065-db2b923c18a3",
                                                "text": "Cheikh Gaafar possédait une maison, toute neuve, en bordure des champs, à l’écart du village. C’était une maison en briques, entourée d’un jardin, avec de grandes fenêtres et des balcons. Une vraie maison d’homme riche."
                                            },
                                            {
                                                "example_id": "b4188399-3ce4-4170-8b33-b6e7bffe3700",
                                                "sense_id": "6607c809-1f71-3d67-8065-db2b923c18a3",
                                                "text": "La pierre claire, les très petits balcons en demi-cercle, avec les balustres joufflus, ombrés de suie, paraissaient recouvrir une ancienne façade comme un papier peint neuf collé par-dessus le vieux."
                                            },
                                            {
                                                "example_id": "a26a848c-793b-4994-936f-02875dcbac13",
                                                "sense_id": "6607c809-1f71-3d67-8065-db2b923c18a3",
                                                "text": "Victor prit son téléphone, shoota quelques objets, son canapé, sa psyché, son tapis de course et, depuis son balcon en saillie, il immortalisa la ville repoussant la lumière qui l’orangeait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a80e9d87-506d-3f7d-bc8b-e384dbefd076",
                                        "entry_id": "f2d458cf-017e-3aaf-a4b1-f97fb2cdb16c",
                                        "glosses": [
                                            "Galerie d'une salle de spectacle s’étendant d'une avant-scène à l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "316eec7b-058a-4bf5-bd6e-f36e652aeb95",
                                                "sense_id": "a80e9d87-506d-3f7d-bc8b-e384dbefd076",
                                                "text": "Des hommes qui étaient jadis moins empressés autour d’elle vinrent au balcon, dérangeant tout le monde, se suspendre à sa main pour approcher le cercle imposant dont elle était environnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79315d50-2d1b-31c8-bc4a-1f40d607369b",
                                        "entry_id": "f2d458cf-017e-3aaf-a4b1-f97fb2cdb16c",
                                        "glosses": [
                                            "Balustrade située à l’avant et l'arrière d’un voilier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4a9ea3-e04e-41f1-9b8d-097c79e74bbd",
                                                "sense_id": "79315d50-2d1b-31c8-bc4a-1f40d607369b",
                                                "text": "Lors de la manœuvre, l’équipier s’accroche au balcon avant."
                                            },
                                            {
                                                "example_id": "a184eb42-2f52-4c94-9700-fe9678853595",
                                                "sense_id": "79315d50-2d1b-31c8-bc4a-1f40d607369b",
                                                "text": "Lone retira ses ballerines sur le ponton et, d'une ample enjambée, franchit le balcon avant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d02757e4-87c2-375d-9907-c76835b93d58",
                                        "entry_id": "f2d458cf-017e-3aaf-a4b1-f97fb2cdb16c",
                                        "glosses": [
                                            "Poitrine de femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0719f3a2-6ca0-449a-bf2e-a02630c9d625",
                                                "sense_id": "d02757e4-87c2-375d-9907-c76835b93d58",
                                                "text": "Elle a du monde au balcon."
                                            },
                                            {
                                                "example_id": "5535f5e2-2d98-45a8-b914-173c8c035e16",
                                                "sense_id": "d02757e4-87c2-375d-9907-c76835b93d58",
                                                "text": "Il ajouta que d’ailleurs, « l’intelligence, ce n’était pas tout », et qu’elle « avait un drôle de balcon », et qu’il fallait le voir pour le croire !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
