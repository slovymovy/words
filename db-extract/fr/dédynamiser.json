                "senses": [
                    {
                        "sense_id": "9d007da2-cf4d-3d07-81cf-fffadddce0f4",
                        "entry_id": "fa09be1a-0219-37da-ab98-c1c2aa4bb230",
                        "glosses": [
                            "Enlever son caractère dynamique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa600cca-1c1f-4fea-9b4d-5ae059bfa752",
                                "sense_id": "9d007da2-cf4d-3d07-81cf-fffadddce0f4",
                                "text": "Dans certains cas, après une expression directe de la pulsion, l'angoisse liée à cette émergence pulsionnelle conduit l'adolescent à \"dédynamiser\" progressivement la réponse initiale."
                            },
                            {
                                "example_id": "de5a412d-8024-4887-a5f3-8d8462bf9210",
                                "sense_id": "9d007da2-cf4d-3d07-81cf-fffadddce0f4",
                                "text": "Il n'y aura plus que 4 partitions, c'est ce qu'on veut dans un premier temps pour \"dédynamiser\" le disque avec easeus."
                            },
                            {
                                "example_id": "5ef71378-959a-4947-b756-034898fa2946",
                                "sense_id": "9d007da2-cf4d-3d07-81cf-fffadddce0f4",
                                "text": "En bref, pas de quoi dédynamiser le marché de l'occasion je pense."
                            },
                            {
                                "example_id": "43e62072-2f2e-4de0-91a2-e56a19cd7a49",
                                "sense_id": "9d007da2-cf4d-3d07-81cf-fffadddce0f4",
                                "text": "Vive Hollande qui a su dédynamiser et diviser ce parti..."
                            }
                        ]
                    }
