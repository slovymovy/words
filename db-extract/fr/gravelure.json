                "entry_id": "8ed74380-149b-3aa9-bfcc-f6b0bdb3224f",
                "word": "gravelure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb63d935-1d37-4549-93a3-e65ada26888f",
                        "entry_id": "8ed74380-149b-3aa9-bfcc-f6b0bdb3224f",
                        "tags": [
