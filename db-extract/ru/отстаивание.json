                ],
                "translations": [
                    {
                        "translation_id": "657c26a0-41a8-4c3f-871c-ed5f7c767c9a",
                        "source_entry_id": "b1671671-53e0-32e4-a559-138adda71a7b",
                        "target_lang_word": "défense",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défense",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52309ef1-54e8-30f5-b7c5-6bb16f6b5936",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Action de défendre, de se défendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e43c591-20a0-4db5-a199-6f3be38ddf8b",
                                                "sense_id": "52309ef1-54e8-30f5-b7c5-6bb16f6b5936",
                                                "text": "Pourquoi porter des chapeaux et des vêtements, quand la pigmentation de la peau est la meilleure défense contre le soleil des tropiques […]?"
                                            },
                                            {
                                                "example_id": "2558ba92-e96a-4832-a471-86238dc92be1",
                                                "sense_id": "52309ef1-54e8-30f5-b7c5-6bb16f6b5936",
                                                "text": "Et l’avarice, considérée comme un péché par l’Église catholique, est devenue le signe d’une défense intelligente contre la surconsommation."
                                            },
                                            {
                                                "example_id": "2abfca27-8cc5-42bb-93d8-6e7c29e9aaa4",
                                                "sense_id": "52309ef1-54e8-30f5-b7c5-6bb16f6b5936",
                                                "text": "S’armer pour la commune défense, pour sa propre défense."
                                            },
                                            {
                                                "example_id": "20a09f58-6acc-4a0e-a4fc-69d0b2ebde00",
                                                "sense_id": "52309ef1-54e8-30f5-b7c5-6bb16f6b5936",
                                                "text": "Être dans le cas de légitime défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Action ou manière de défendre une place, un poste, etc., de s’y défendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bddd930-5abb-463b-9660-a78d9269a9c9",
                                                "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                                "text": "Belgrade est une ville ouverte, car son ancienne forteresse turque ne peut pas être considérée comme un ouvrage de défense moderne."
                                            },
                                            {
                                                "example_id": "80011870-ffa6-4ecf-9abd-734df63d29ff",
                                                "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                                "text": "La ville avait la réputation d’être imprenable ; son château s’élevait à l’est et la ceinture de murailles qui entourait la cité venait s’y attacher; des portes, des bastions, des fossés formaient un respectable appareil de défense."
                                            },
                                            {
                                                "example_id": "a20ab497-53d4-4090-95ed-358f11b7c543",
                                                "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                                "text": "Nos grandes places de guerre, Strasbourg et Metz, les véritables boulevards de notre défense, n'avaient été ni armées, ni approvisionnées."
                                            },
                                            {
                                                "example_id": "7496c1f4-8c75-44bb-a2b7-165e85a1956c",
                                                "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                                "text": "Après le « mur murant » de 1786, les fortifications de 1840 ont été démolies pierre par pierre, et la terre de leurs glacis à servi à combler les fossés de défense dont on l'avait tirée."
                                            },
                                            {
                                                "example_id": "1fde1ca9-b8e6-4a47-a6eb-71ebb9cae7a6",
                                                "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                                "text": "Faire une belle défense, résister longtemps à quelque proposition, à quelque sollicitation, etc."
                                            },
                                            {
                                                "example_id": "eec23de7-7134-4d8c-92e5-2189cabb8ac0",
                                                "sense_id": "cd680782-673d-395d-a489-11007e7581fb",
                                                "text": "Dans son nouveau bulletin, elle a souligné que le conflit créait le risque de voir « des avions civils pris pour cible de manière non intentionnelle en raison de possibles carences dans la coordination entre autorités civiles et militaires » lors de l'entrée en action de la défense aérienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a514b8e2-31ac-309a-b238-47848af8d76f",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Gestion de l’armée et de la marine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f1a42a-6100-4e47-a44e-7051ddeb5e6c",
                                                "sense_id": "a514b8e2-31ac-309a-b238-47848af8d76f",
                                                "text": "Le ministère de la Défense."
                                            },
                                            {
                                                "example_id": "606bd1b6-5537-46e4-a5a2-bf0b38713158",
                                                "sense_id": "a514b8e2-31ac-309a-b238-47848af8d76f",
                                                "text": "Dépenses de défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d34c7ab-a3fe-3069-a18e-1bb750bf774a",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Fortifications, ce qui sert à garantir, à couvrir une place."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa3565b-93d0-4b21-a192-e3abceaf28c8",
                                                "sense_id": "6d34c7ab-a3fe-3069-a18e-1bb750bf774a",
                                                "text": "Les bases des tours visigothes sont carrées ou ont été grossièrement arrondies pour recevoir les défenses du Vᵉ siècle."
                                            },
                                            {
                                                "example_id": "aa2552e9-fcaa-4332-93b9-ef1c7064f087",
                                                "sense_id": "6d34c7ab-a3fe-3069-a18e-1bb750bf774a",
                                                "text": "Démolir les défenses d’une place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cfb011a-588c-318b-91b9-e3b08d9351de",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Ce bois est en défense: Il est en tel état de force qu’on n’a plus besoin d’empêcher les bestiaux d’y aller."
                                        ],
                                        "tags": [
                                            "Eaux et forêts"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4161a280-4193-3211-b633-64819b8daedd",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Action de défendre quelqu’un contre une accusation soit en justice, soit dans les rapports sociaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1ff337-83e0-45b8-8e12-44c55b2a4745",
                                                "sense_id": "4161a280-4193-3211-b633-64819b8daedd",
                                                "text": "La défense de sa cause."
                                            },
                                            {
                                                "example_id": "17e4e84c-614e-4d08-a997-4d47722f240a",
                                                "sense_id": "4161a280-4193-3211-b633-64819b8daedd",
                                                "text": "Prendre la défense de l’accusé."
                                            },
                                            {
                                                "example_id": "cb52f5fd-4354-415e-b437-e23a3e9ccba9",
                                                "sense_id": "4161a280-4193-3211-b633-64819b8daedd",
                                                "text": "Qu’avez-vous à dire pour votre défense ?"
                                            },
                                            {
                                                "example_id": "3b39580e-436c-413c-bcca-b3267f799964",
                                                "sense_id": "4161a280-4193-3211-b633-64819b8daedd",
                                                "text": "On ne voulut point écouter ma défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec9ddffe-a797-3045-a04f-0b6f719f801e",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Action de défendre quelqu’un contre une accusation soit en justice, soit dans les rapports sociaux.",
                                            "Ce qu’on répond, par écrit et par ministère d’avoué, à la demande de sa partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99b2d7be-0b72-4ae4-98e8-33ef99fdaf41",
                                                "sense_id": "ec9ddffe-a797-3045-a04f-0b6f719f801e",
                                                "text": "Donner, fournir, faire signifier ses défenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c792bb55-883e-3137-9c72-eed462e7a56e",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Chacune des deux longues dents, canines ou incisives, qui sortent de la bouche de certains mammifères et dont ils se servent pour se défendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c440a6d-3941-4794-bd6a-dc1446b9af98",
                                                "sense_id": "c792bb55-883e-3137-9c72-eed462e7a56e",
                                                "text": "Les défenses du sanglier, de l’éléphant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8756303-1f1c-352b-ba66-80a2ae509d13",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Corde de sûreté, utilisée par les couvreurs pour s'attacher."
                                        ],
                                        "tags": [
                                            "Couvreur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a731758-ad3f-3be8-8636-812bb7e97737",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Prohibition, interdiction. Il est défendu de, il est interdit de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63664f25-da6f-41fe-903b-92b44ca19d15",
                                                "sense_id": "8a731758-ad3f-3be8-8636-812bb7e97737",
                                                "text": "M. le représentant diplomatique de France en Chine a obtenu du taotaï la défense d'exporter de Chine des cartons de graines de vers à soie qui ne porteraient pas le sceau consulaire."
                                            },
                                            {
                                                "example_id": "9e0a1eec-c098-4905-a143-242a457026a7",
                                                "sense_id": "8a731758-ad3f-3be8-8636-812bb7e97737",
                                                "text": "Défenses sont faites à tous cantiniers de recevoir et de garder dans leur maison aucune guildive, sans la permission du juge de police."
                                            },
                                            {
                                                "example_id": "bd3251f9-5568-4916-a78f-87f1db75a01d",
                                                "sense_id": "8a731758-ad3f-3be8-8636-812bb7e97737",
                                                "text": "Défense de fumer, défense d’uriner, défense de marcher dans la pelouse, défense de parler au conducteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e4d8cc-1025-3e26-acdd-aef0f4c2e3c0",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Interdiction de procéder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5af3414-625b-49a3-966b-cc599c7c96e1",
                                                "sense_id": "f0e4d8cc-1025-3e26-acdd-aef0f4c2e3c0",
                                                "text": "Jugement, arrêt de défense, de défenses, ou simplement Défenses, jugement qui défend de procéder, de passer outre à l’exécution de quelque chose."
                                            },
                                            {
                                                "example_id": "49a8665e-ea13-4bc2-8efc-37ae1a346ee6",
                                                "sense_id": "f0e4d8cc-1025-3e26-acdd-aef0f4c2e3c0",
                                                "text": "Obtenir des défenses."
                                            },
                                            {
                                                "example_id": "5b474700-181f-4f51-acd9-3f5aa7a71060",
                                                "sense_id": "f0e4d8cc-1025-3e26-acdd-aef0f4c2e3c0",
                                                "text": "Faire lever des défenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "076227b5-4553-32b3-9531-34c9f0e3264f",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "À l’origine sac tressé rempli de vieux cordages, qui placé entre un navire et le quai, ou entre deux navires, avait pour but de protéger la coque contre les chocs, de nos jours elles sont en plastique ou en caoutchouc, parfois on utilise de vieux pneus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6624a2ab-8079-35e5-98b2-0e39e78089c4",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Ensemble des défenseurs d’une équipe dans un sport collectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6cdcc14-da0e-4c22-8622-84fcd816e7ae",
                                                "sense_id": "6624a2ab-8079-35e5-98b2-0e39e78089c4",
                                                "text": "Et pour bien comprendre l’impact de Rudy Gobert dans le paysage NBA, sur les résultats de son équipe et sur les attaques (et les défenses) adverses, préparez-vous à une avalanche de chiffres aussi imposante qu’une moisson de rebonds de Gobzilla !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acdf5d91-bf52-387a-80be-840ecc05d8e2",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Meuble représentant la défense (cf. définition (7)) d’un animal dans les armoiries. Elle est représentée détachée du corps de l’animal. Il est généralement nécessaire de blasonner le nom de l’animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f5e4ff4-abb5-45bf-adfc-02e03e3b0f57",
                                                "sense_id": "acdf5d91-bf52-387a-80be-840ecc05d8e2",
                                                "text": "Écartelé au 1 et au 4 d’azur, à la bande d’argent, chargée de trois défenses de sanglier de sable, accompagnée de deux roues à quatre rais du second émail; au 2 et au 3, coupé d’or et d’argent, à l’aigle de sable languée, membrée et couronnée de gueules, brochante, qui est de la famille Friches-Doria → voir illustration « armoiries avec des défenses »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feaaa2d1-d654-336d-9122-0a2757016a17",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Début d’une partie d’échecs, vu du camp des noirs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c693c8fb-6129-3c12-9eb2-f1bd4172e916",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Début d’une partie d’échecs, vu du camp des noirs.",
                                            "Type de début de partie, dont le coup caractéristique est joué par les noirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630c1c0a-63bc-49b3-a7fa-8737c5f75995",
                                                "sense_id": "c693c8fb-6129-3c12-9eb2-f1bd4172e916",
                                                "text": "Défense française, sicilienne. Défense Philidor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8528c9a0-24b9-3fdc-9b97-cc786322bc06",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Barre de métal ou de bois, grille ou fer forgé que l'on dispose dans la partie inférieure de l'ouverture d'une fenêtre pour éviter que l'on ne tombe en se penchant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c062e015-b9cd-4cd9-bbbc-d84a31ba2bf9",
                                                "sense_id": "8528c9a0-24b9-3fdc-9b97-cc786322bc06",
                                                "text": "Dans celui du recteur , on procède à des réparations de serrures ou à la pose d'une défense de fenêtre, sécurité oblige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b57883-05ab-3869-bf13-d5a2f75701ce",
                                        "entry_id": "19fe94bd-f45f-3999-b0de-35e52358053d",
                                        "glosses": [
                                            "Moyen de gagner de l’argent, en particulier dans la prostitution (voir se défendre)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12132449-cd60-4ce8-b58f-3b78dd5c31bb",
                                                "sense_id": "b5b57883-05ab-3869-bf13-d5a2f75701ce",
                                                "text": "Certes, elle n’a pas dû à l’origine pratiquer la pipe à une thune dans les coins ombreux des portes cochères, actuellement son unique défense."
                                            },
                                            {
                                                "example_id": "3a079d39-5cb1-4b69-a159-c6634225f729",
                                                "sense_id": "b5b57883-05ab-3869-bf13-d5a2f75701ce",
                                                "text": "Pour sa petite défense de rabatteur indépendant,, l’indulgence de Jaspin peut lui être précieuse, comme son hostilité peut devenir infernale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ec6313e-5ec0-414a-a1dd-d70c0b492889",
