                "senses": [
                    {
                        "sense_id": "a56d05c9-bdf0-350b-b62e-391ef1118b6e",
                        "entry_id": "858cd534-048f-32bc-ae95-59d4152398eb",
                        "glosses": [
                            "bolle wang met een gezonde rode kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c155784d-c7e2-455d-b1c1-a09dbb843995",
                                "sense_id": "a56d05c9-bdf0-350b-b62e-391ef1118b6e",
                                "text": "Ik zou mijn jaren zo verruilen voor jouw appelwangen, denkt Elza, en die stevige jonge benen lijken haar ook wel wat."
                            },
                            {
                                "example_id": "62beaacd-594c-4ae0-88cc-0e2568ddce6e",
                                "sense_id": "a56d05c9-bdf0-350b-b62e-391ef1118b6e",
                                "text": "Het grootste deel van het boek is praktisch en concreet, zoals over Annejet, „een eigenwijze gans met geestige appelwangen”, die weigert om een nest te maken in de stal."
                            },
                            {
                                "example_id": "6b37c401-1680-459f-9763-32ca95af2efe",
                                "sense_id": "a56d05c9-bdf0-350b-b62e-391ef1118b6e",
                                "text": "De antimonarchistische publieke opinie vond het destijds te protserig. De „pompeuze entourage” zou niet van die tijd zijn. De vorstin zou bovendien „onherkenbaar” afgebeeld zijn met „appelwangetjes.” In een raadsvergadering stemde de gemeenteraad het staatsieportret met twaalf tegen zes weg."
                            }
                        ]
                    }
                ],
