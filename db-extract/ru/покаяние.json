                        "target_lang_word": "repentance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repentance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a0d973-6b97-3ee1-a9d3-cf2480e5b3a9",
                                        "entry_id": "16ef1bac-a5a2-3c04-9697-dd98732c4eac",
                                        "glosses": [
                                            "The condition of being repentant, penitent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89775ded-8b5e-4c5c-9326-b1b858e12449",
                                                "sense_id": "81a0d973-6b97-3ee1-a9d3-cf2480e5b3a9",
                                                "text": "1678, Bunyan, The Pilgrim's Progress, second period\nGod hath denied me repentance. His words gives me no encouragement to believe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521ebf6d-3993-3c95-8c26-243eac9b8320",
                                        "entry_id": "16ef1bac-a5a2-3c04-9697-dd98732c4eac",
                                        "glosses": [
                                            "A feeling of regret or remorse for doing wrong or sinning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c9c09e-93ac-4a54-b6e1-825f7e274d68",
                                                "sense_id": "521ebf6d-3993-3c95-8c26-243eac9b8320",
                                                "text": "And here, shipmates, is true and faithful repentance; not clamorous for pardon, but grateful for punishment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16341dd7-b376-4f62-a2d7-1c3ed8ff146e",
                        "source_entry_id": "3bca3ac7-8a6b-3179-9b90-b7e35decd427",
                        "target_lang_word": "penance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34286ff9-9000-37f8-93f2-85cc806d2c3c",
                                        "entry_id": "cefd2195-c298-30f4-a289-0084d0a92382",
                                        "glosses": [
                                            "A voluntary self-imposed punishment for a sinful act or wrongdoing. It may be intended to serve as reparation for the act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c0c3c0-170e-4d40-964e-7b4600bb0daa",
                                                "sense_id": "34286ff9-9000-37f8-93f2-85cc806d2c3c",
                                                "text": "Quoth he, \"The man hath penance done, / And penance more will do.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72979504-0651-3dd4-bb35-27f5d15a72da",
                                        "entry_id": "cefd2195-c298-30f4-a289-0084d0a92382",
                                        "glosses": [
                                            "A sacrament in some Christian churches that involves penitence (remorse plus restitution via prayer)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
