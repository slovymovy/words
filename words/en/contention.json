{
    "word_family": [
        "contend",
        "contender",
        "contentious",
        "contentiously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4089ab8-e983-356f-9cef-31c024e7cc78",
                    "sense_definition": "Angry disagreement between people or groups.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new pay structure caused a great deal of <w>contention</w> among the employees.",
                            "target_lang_translations": {
                                "ru": "Новая структура оплаты труда вызвала много <w>споров</w> среди сотрудников.",
                                "cs": "Nová struktura odměňování vyvolala mezi zaměstnanci mnoho <w>sporů</w>."
                            }
                        },
                        {
                            "text": "This issue has been a bone of <w>contention</w> between the two countries for years.",
                            "target_lang_translations": {
                                "ru": "Этот вопрос годами был яблоком <w>раздора</w> между двумя странами.",
                                "cs": "Tato otázka byla mezi oběma zeměmi po léta jablkem <w>sváru</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrangling"
                    ],
                    "common_phrases": [
                        "bone of contention",
                        "source of contention",
                        "area of contention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожесточённый спор или несогласие между людьми или группами.",
                        "cs": "Ostrý spor, neshoda nebo svár mezi lidmi či skupinami."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "словесное состязание, обсуждение"
                            },
                            {
                                "target_lang_word": "раздор",
                                "target_lang_sense_clarification": "вражда, ссора"
                            },
                            {
                                "target_lang_word": "разногласие",
                                "target_lang_sense_clarification": "отсутствие согласия"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "spor",
                                "target_lang_sense_clarification": "neshoda, konflikt"
                            },
                            {
                                "target_lang_word": "svár",
                                "target_lang_sense_clarification": "rozepře, nepřátelství"
                            },
                            {
                                "target_lang_word": "rozepře",
                                "target_lang_sense_clarification": "hádka, neshoda"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a82bea2-5435-3b84-894e-b37995b38343",
                    "sense_definition": "An opinion or claim that someone expresses and argues is true.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is her <w>contention</w> that the school needs more funding immediately.",
                            "target_lang_translations": {
                                "ru": "Её <w>позиция</w> заключается в том, что школе немедленно требуется дополнительное финансирование.",
                                "cs": "Jejím <w>tvrzením</w> je, že škola okamžitě potřebuje více finančních prostředků."
                            }
                        },
                        {
                            "text": "The evidence supports the <w>contention</w> that the fire was accidental.",
                            "target_lang_translations": {
                                "ru": "Улики подтверждают <w>утверждение</w>, что пожар был случайным.",
                                "cs": "Důkazy podporují <w>tvrzení</w>, že požár byl neúmyslný."
                            }
                        }
                    ],
                    "common_phrases": [
                        "my contention is",
                        "support the contention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мнение или утверждение, которое кто-либо высказывает и пытается обосновать.",
                        "cs": "Názor nebo tvrzení, které někdo zastává a obhajuje v argumentaci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "заявление, тезис"
                            },
                            {
                                "target_lang_word": "позиция",
                                "target_lang_sense_clarification": "точка зрения"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tvrzení",
                                "target_lang_sense_clarification": "výrok, obhajovaný názor"
                            },
                            {
                                "target_lang_word": "názor",
                                "target_lang_sense_clarification": "stanovisko"
                            },
                            {
                                "target_lang_word": "přesvědčení",
                                "target_lang_sense_clarification": "pevné stanovisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3212d842-c211-3477-ba0a-10461160e2f7",
                    "sense_definition": "The act of competing for a prize, position, or limited resource.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three different teams are still in <w>contention</w> for the championship title.",
                            "target_lang_translations": {
                                "ru": "Три разные команды всё ещё ведут <w>борьбу</w> за чемпионский титул.",
                                "cs": "Tři různé týmy jsou stále ve <w>hře</w> o mistrovský titul."
                            }
                        },
                        {
                            "text": "After losing the match, the player is out of <w>contention</w> for the medal.",
                            "target_lang_translations": {
                                "ru": "Проиграв матч, игрок выбыл из <w>борьбы</w> за медаль.",
                                "cs": "Po prohře v zápase je hráč mimo <w>boj</w> o medaili."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in contention",
                        "out of contention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Борьба или соревнование за приз, должность или ограниченный ресурс.",
                        "cs": "Soupeření nebo boj o cenu, pozici či omezené zdroje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "состязание за первенство"
                            },
                            {
                                "target_lang_word": "состязание",
                                "target_lang_sense_clarification": "соревнование"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "boj",
                                "target_lang_sense_clarification": "soupeření o zisk něčeho"
                            },
                            {
                                "target_lang_word": "soupeření",
                                "target_lang_sense_clarification": "vzájemná konkurence"
                            },
                            {
                                "target_lang_word": "soutěž",
                                "target_lang_sense_clarification": "zápolení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
