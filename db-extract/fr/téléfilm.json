                                                "sense_id": "9d17d4a7-f8e8-38c8-9ad3-83869272a0d0",
                                                "text": "Für diesen Fernsehfilm haben zwei der Autoren des Traumschiffes das Drehbuch geliefert."
                                            },
                                            {
                                                "example_id": "ca4e0dec-b614-451e-bb6b-9f656689d3f1",
                                                "sense_id": "9d17d4a7-f8e8-38c8-9ad3-83869272a0d0",
                                                "text": "„Das ZDF produzierte 1970 einen Fernsehfilm, der im April 1971 ausgestrahlt wurde.“"
                                            }
