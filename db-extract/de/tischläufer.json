                "senses": [
                    {
                        "sense_id": "71ea2ef3-036e-31b3-ad06-de97b72cd4f4",
                        "entry_id": "b979ae48-0cab-3498-b884-52009bd5c1aa",
                        "glosses": [
                            "längliche Textilie, die als Schutz oder Zierde zum Beispiel auf einen Tisch gelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5250d8e-38c1-4897-a442-cf55a4e93716",
                                "sense_id": "71ea2ef3-036e-31b3-ad06-de97b72cd4f4",
                                "text": "„Um eine Käseglocke schöner auf dem Tisch zu präsentieren, empfehlen wir einen Tischläufer.“"
                            },
                            {
                                "example_id": "73f12db1-2c39-4135-95b5-c0277b9b7839",
                                "sense_id": "71ea2ef3-036e-31b3-ad06-de97b72cd4f4",
                                "text": "„Auf dem Tisch sehen wir wieder das vertraute Bild: einen Tischläufer aus weißem Leinen, darauf Platzteller, Unterteller und Suppenteller, alle im rustikaleren Design (Hütte!).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
