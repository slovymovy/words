                    },
                    {
                        "translation_id": "5c8db307-1c44-479f-842f-5ac7408c4336",
                        "source_entry_id": "d8e0d622-c1bf-32d2-b892-df317df2cb91",
                        "source_sense_id": "e31e0cfb-f2a0-367c-8ed8-6153a5698812",
                        "target_lang_word": "Tunisie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tunisie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                        "entry_id": "ababd0c7-1a74-3994-aa9e-1b6cdc6fe5fc",
                                        "glosses": [
                                            "Pays d’Afrique du Nord situé dans l'Est du Maghreb au nord-est de l'Algérie et au nord-ouest de la Libye. Sa capitale est Tunis."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c58d0c2f-f626-41ef-b2aa-4a5888d3c52a",
                                                "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                                "text": "La variante sur le Hodna, baptisée Étincelle, visait à couper l’approvisionnement des katibas de Kabylie en provenance de Tunisie par le Hodna et les Aurès."
                                            },
                                            {
                                                "example_id": "bb3b442c-71fc-4cde-a540-bc7da70aa672",
                                                "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                                "text": "La Tunisie avait un conflit de frontières avec l’Algérie, puisqu’elle contestait le tracé frontalier hérité de la colonisation, et revendiquait la zone avoisinant la célèbre « borne 233 »."
                                            },
                                            {
                                                "example_id": "c94bba52-fe78-4b4b-a8f0-17ea0e16437d",
                                                "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                                "text": "Mon père, Fernand, était un solide Bourguignon de Châtillon-sur-Seine et ma mère, Yvonne, une Française d’origine italienne dont la famille était installée en Tunisie depuis longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
