                },
                {
                    "sense_id": "d8cab317-227a-339c-82f1-a5dd3b24f983",
                    "sense_definition": "Something new; a novelty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misc_obsolete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In those days, refined sugar was considered a <w>novel</w> and a luxury.",
                            "target_lang_translations": {
                                "ru": "В те дни рафинированный сахар считался <w>диковинкой</w> и роскошью.",
                                "zh": "在那个年代，精制糖被视为一种<w>新奇事物</w>和奢侈品。"
                            }
                        },
                        {
                            "text": "Travelers brought back many a <w>novel</w> from the distant lands.",
                            "target_lang_translations": {
                                "ru": "Путешественники привозили много <w>диковинок</w> из дальних стран.",
                                "zh": "旅行者从遥远的国度带回了许多<w>稀罕物</w>。"
                            }
