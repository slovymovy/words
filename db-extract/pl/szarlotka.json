                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38b7ce4e-314d-4775-9eb7-62b8d9f19440",
                                                "sense_id": "b0456888-af0a-3ad2-b8fe-9ce1f17d7f15",
                                                "text": "Tea was served with a fragrant apple-pie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apple-pie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71c47b42-2c0d-3605-9449-ef7bb041aaa7",
                                        "entry_id": "0fd8a8b0-a1c2-3bb8-8a67-cc1e1ffa175c",
                                        "glosses": [
                                            "Alternative spelling of apple pie."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c624cdc-4d40-4d78-8427-eca105199cf0",
                                                "sense_id": "71c47b42-2c0d-3605-9449-ef7bb041aaa7",
                                                "text": "Pat was always ready for fun, especially when it came to apple-pieing beds."
                                            },
                                            {
                                                "example_id": "5e515f9e-a782-45e4-8894-8d1be3a56c56",
                                                "sense_id": "71c47b42-2c0d-3605-9449-ef7bb041aaa7",
                                                "text": "“There’s something the matter with the God[-]damned bed. I can’t get in.” He stood there, naked and cross in the candlelight. Martha turned back the covers. “They’ve apple-pied the bed.” “They’ve what?” “Apple-pied, short-sheeted. Didn’t you ever do that when you were young?” “The little brats.” “It’ll only take a minute of fix; it’s just the top sheet.”"
                                            },
                                            {
                                                "example_id": "359397e1-c46e-46ab-9ea6-a771e670b104",
                                                "sense_id": "71c47b42-2c0d-3605-9449-ef7bb041aaa7",
                                                "text": "At midnight, Elizabeth and her friends apple-pied the beds of her brother David and James, who was still being frustratingly elusive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d45c2e94-9f86-4bf4-b47d-0aa8341f42ab",
                        "source_entry_id": "b9b989e7-89f2-3989-ac09-052282d1674f",
                        "source_sense_id": "6c0f844f-9d10-3587-bc07-9da22acfa40f",
