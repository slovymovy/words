                                    },
                                    {
                                        "sense_id": "6c45fed7-8e49-313e-8422-73879f028356",
                                        "entry_id": "30f4848c-2632-316a-85e1-5574303b9e84",
                                        "glosses": [
                                            "posuvný potenciometr na zvukovém mixážním pultu, případně celý jeden jeho vstupní kanál"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "788887d7-86e5-4943-8293-bbe64c9e734a",
                                                "sense_id": "6c45fed7-8e49-313e-8422-73879f028356",
                                                "text": "Moderátor nestáhl šavli, takže posluchači mohli slyšet, jak si nalévá čaj."
                                            },
                                            {
                                                "example_id": "4c89d89c-87b8-4478-a348-b100336474ec",
                                                "sense_id": "6c45fed7-8e49-313e-8422-73879f028356",
