                        "glosses": [
                            "A material that emits an odor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac46c52e-f9bc-47f7-ab81-a3100554972a",
                                "sense_id": "7f5ceccc-e123-3520-9f45-1c84817cf9eb",
                                "text": "It is generally accepted that odorivector molecules must reach chemosensors physically; liaison by radiation through distance has never been proved and seems highly unlikely."
                            },
                            {
                                "example_id": "9a59911c-20eb-4055-b75c-5304baa6704c",
                                "sense_id": "7f5ceccc-e123-3520-9f45-1c84817cf9eb",
                                "text": "So, on the one hand, the odorivector gives the observer cues about polysensory space, that is if all the mechanical envelopes, viz., acoustic and haptic, coincide and so constitute, with the osmotic, a hermetic space; and he interprets the cues by 'associative concatenation'."
                            }
                        ]
                    }
