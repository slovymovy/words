                        "target_lang_word": "cyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                                        "entry_id": "c7301625-fd05-33f0-9735-d0e2ecc79011",
                                        "glosses": [
                                            "A person who rides a cycle, especially a bicycle, or who habitually engages in cycling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b53b58-04a3-480f-a9f8-dea89db7059c",
                                                "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                                                "text": "A solitary cyclist was coming towards us. His head was down and his shoulders rounded, as he put every ounce of energy that he possessed on to the pedals. He was flying like a racer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                                        "entry_id": "c7301625-fd05-33f0-9735-d0e2ecc79011",
                                        "glosses": [
                                            "A motorcyclist."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8382e2db-c5f5-4929-9754-a8eb64110c1e",
                                                "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                                                "text": "Most of the cyclists were members of the Pagans' Motorcycle Club of Washington."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "415d062b-de3e-444f-b332-5741e1e40a70",
                        "source_entry_id": "b0f638a9-130f-3b76-ae8e-ccb42fe60af2",
                        "source_sense_id": "988c2c41-6097-312d-9fd1-88767fdd5104",
