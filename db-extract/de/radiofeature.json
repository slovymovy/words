                "senses": [
                    {
                        "sense_id": "f5f73813-568e-3c5d-91e7-110e4a4a128a",
                        "entry_id": "29723f5a-6212-3bd4-a0be-1aa1faeffeb9",
                        "glosses": [
                            "informative journalistische Behandlung eines Themas im Radio"
                        ],
                        "tags": [
                            "Hörfunk"
                        ],
                        "examples": [
                            {
                                "example_id": "55418fb6-e227-4adf-9c0a-95513bcd9d0c",
                                "sense_id": "f5f73813-568e-3c5d-91e7-110e4a4a128a",
                                "text": "„Was mir allerdings gefiel, war, dass es keine Urlaubsreise werden würde, da Sophie an einem Radiofeature über fünfzig Jahre Unabhängigkeit des Senegals arbeitete.“"
                            },
                            {
                                "example_id": "c5219ebb-8a29-440c-b553-ed8738365c2a",
                                "sense_id": "f5f73813-568e-3c5d-91e7-110e4a4a128a",
                                "text": "„Dass dieses sehr komplexe inhaltsreiche Radiofeature nicht nur eine Vielzahl von Informationen und Rechercheergebnissen vermittelt, sondern auch zum Hörerlebnis wird, ist nicht zuletzt Verdienst von Regisseur Karl Bruckmaier sowie Susanne Herzig und Josuel Theegarten (Ton und Technik).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
