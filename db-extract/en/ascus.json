                                        "entry_id": "18cb8db0-ddeb-3c4f-b747-42c22bf679b1",
                                        "glosses": [
                                            "экон. сленг цена предложения, наинизшая цена, по которой есть ожидающая удовлетворения заявка на продажу данных акций, опционов, фьючерсов, валюты"
                                        ],
                                        "tags": [],
