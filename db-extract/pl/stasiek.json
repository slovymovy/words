                        "examples": [
                            {
                                "example_id": "e4006576-4b4f-4202-b9a7-e24498d294f4",
                                "sense_id": "285239d6-b148-3d76-9f11-2bca83ac642a",
                                "text": "Wyrwał mu czapkę z ręki i gwałtem wsadził na głowę, a następnie to samo zrobił wylęknionemu Staśkowi"
                            },
                            {
                                "example_id": "ef590899-587a-4b8b-b967-85531f6a1cf9",
                                "sense_id": "285239d6-b148-3d76-9f11-2bca83ac642a",
                                "text": "Mama znów rozpłakała się i mnie się pyta: „A ty, Staśku?”"
                            },
                            {
                                "example_id": "d08e5500-e016-4463-b881-246ca57de1ef",
                                "sense_id": "285239d6-b148-3d76-9f11-2bca83ac642a",
                                "text": "Stasiek! Milicja do ciebie!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
