                        "entry_id": "e97bd3a8-56d9-3213-9525-7a4d813c2eb3",
                        "glosses": [
                            "Homosexuel passif."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b12ab262-efe0-4ff5-8d4e-d2d64634c36f",
                                "sense_id": "8e478bb9-eadb-37c7-8c4f-e7285e019858",
                                "text": "En prison, il avait devenu un autre homme, un girond : s’pas, Toto ?"
                            }
                        ]
