                        "examples": [
                            {
                                "example_id": "5792f00c-8f0e-47e4-8885-e46813ee4362",
                                "sense_id": "064aabd6-b9c5-3f54-8dbd-26852c1341f4",
                                "text": "This is one weird tribe, who get their kicks from electrocution, poisoning and causing car crashes (and that's when they're in a good mood!). They consider a holiday in the Bermuda Triangle the ultimate and anyone who keeps floating hands as pets has to be a bit tapped."
                            },
                            {
                                "example_id": "b77dca0a-ff29-4f8d-abd2-4038d4f52cd9",
                                "sense_id": "064aabd6-b9c5-3f54-8dbd-26852c1341f4",
                                "text": "His eyes danced with delight, and he laughed and told me I was tapped in the head as he mussed up my hair, provoking me to kick him in the butt."
                            }
                        ]
                    }
