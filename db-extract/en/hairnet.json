                "translations": [
                    {
                        "translation_id": "843c309a-6ee0-4d86-a420-5dba1aa9f7a6",
                        "source_entry_id": "ae1734c4-b858-3cdb-8d17-8ec5f84d0f37",
                        "source_sense_id": "d90a0298-f707-3be1-a120-435331724cef",
                        "source_sense_description": "Haarnetz",
                        "target_lang_word": "Haarnetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarnetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42f0faea-a38e-3382-808a-f279d6b44df1",
                                        "entry_id": "4bf63f67-4529-3299-b87f-51f076dbaf40",
                                        "glosses": [
                                            "ein Netz, das als Bedeckung dient und die Kopfhaare zusammenhält oder schmückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b065ab14-792b-42aa-ad98-e18b13b10d12",
                                                "sense_id": "42f0faea-a38e-3382-808a-f279d6b44df1",
                                                "text": "Aus Gründen des Arbeitsschutzes und der Hygiene müssen alle Mitarbeiter der Tortenfabrik ein Haarnetz tragen."
                                            },
                                            {
                                                "example_id": "6c5cbb8a-d057-47a6-9b7e-5b0cda9ab552",
                                                "sense_id": "42f0faea-a38e-3382-808a-f279d6b44df1",
                                                "text": "Im Bellagio, Kinogängern aus \"Ocean's Eleven\" bekannt, stehen sie stundenlang Schlange: Zimmermädchen in Uniform, Tellerwäscher mit Haarnetz, Pagen, Putzfrauen, Portiers, Kellner, Köche, Barkeeper, Garagen-Boys, langbeinige Hostessen."
                                            },
                                            {
                                                "example_id": "48fc741f-7d1b-4e3c-beb6-3caa46730c6e",
                                                "sense_id": "42f0faea-a38e-3382-808a-f279d6b44df1",
                                                "text": "Zur Einhaltung von Sicherheitsbestimmungen und bei bestimmten Diensten - zum Beispiel Gefechtsausbildung und Teilnahme an Einsätzen - kann der Disziplinarvorgesetzte bei langen Haaren das Tragen eines Haarnetzes befehlen."
                                            },
                                            {
                                                "example_id": "2a593b52-bea7-4417-a90c-44ae85536e99",
                                                "sense_id": "42f0faea-a38e-3382-808a-f279d6b44df1",
                                                "text": "„Ihren Haarknoten hielt ein Haarnetz zusammen, aber er war spärlich wie ein Wölkchen in den Bergen von Tschu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
