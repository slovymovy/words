                "senses": [
                    {
                        "sense_id": "89634514-65ca-3f62-9129-8201050e142d",
                        "entry_id": "ea791b7e-0be3-3939-b934-09cc9730ebc9",
                        "glosses": [
                            "Fähigkeit/Maßnahmen eines Körpers zum Selbstschutz (nach dem Eindringen von Krankheitserregern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee610db4-a5e0-46e5-abda-09721ced9d21",
                                "sense_id": "89634514-65ca-3f62-9129-8201050e142d",
                                "text": "„Die Immunabwehr bezeichnet die gezielte oder spezifische Abwehr eines Krankheitserregers durch das Immunsystem. Diese wird durch Antikörper und bestimmte T-Zellen ermöglicht.“"
                            },
                            {
                                "example_id": "28d42df7-956b-43f6-9018-a083a949dfde",
                                "sense_id": "89634514-65ca-3f62-9129-8201050e142d",
                                "text": "„Zum Problem wird dieser von Mutter Natur klug eingerichtete Mechanismus erst, wenn die Immunabwehr ständig hochgefahren bleibt, obwohl gar keine antigenen Feinde im Körper sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
