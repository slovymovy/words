                    },
                    {
                        "translation_id": "0d128dbe-8bf9-4a32-9e1e-042789bb00a7",
                        "source_entry_id": "5ad415d4-06ac-3f2d-88df-2f0f1ac90ab3",
                        "source_sense_id": "5ac2b14f-d217-3a5a-903d-f68034dece5b",
                        "target_lang_word": "Acker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                        "entry_id": "04be484c-1435-344e-ba20-34ec00525433",
                                        "glosses": [
                                            "landwirtschaftlich genutzte Fläche, die regelmäßig bearbeitet wird"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49db4a06-1229-4a11-bfca-23ed29b488aa",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "In Deutschland werden auf immer mehr Äckern Solarpanels aufgestellt."
                                            },
                                            {
                                                "example_id": "cc5eb92c-8728-4372-8984-c84a033fdf4e",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Seit dem 18. Jahrhundert wurden [Anmerkung: in Niedersachsen] Moore in Äcker und Grünlandflächen umgewandelt.“"
                                            },
                                            {
                                                "example_id": "00b24cdd-d5a4-422a-91fd-94d0072b588b",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Auf dem Acker, der Straße oder sogar im Watt, ohne Trecker geht in Norddeutschland fast gar nichts.“"
                                            },
                                            {
                                                "example_id": "6b65e53f-acc6-4ed4-91be-bd4ba3b5a1a0",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Auf einem Acker stehen mehrere Traktoren, dazu türmen sich viele Planen und Strohballen.“"
                                            },
                                            {
                                                "example_id": "650b1d23-e8c6-4f5e-b77e-344a67f7fcf3",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Wenn du den Acker bebauen wirst, soll er dir hinfort seinen Ertrag nicht geben.“"
                                            },
                                            {
                                                "example_id": "4a10ea87-b7f2-4a67-ab3c-65168d6fc919",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„[… vor 55 Jahren machte man] »viele Arbeiten auf dem Acker […] nach wie vor mit den Pferden. Da war man den ganzen Tag draußen und lief hinter der Drillmaschine und den Pferden her - Acker rauf, Acker runter.«“"
                                            },
                                            {
                                                "example_id": "e280171c-c9b8-40cc-b447-9009c7439d70",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Geplant ist [Anmerkung: von der EU-Kommission] eine Halbierung beim Einsatz von Pestiziden auf dem Acker […].“"
                                            },
                                            {
                                                "example_id": "22e5a770-a40a-4f3b-8872-88cf290f10ac",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Bei einer \"weiten\" Fruchtfolge steht erst jedes siebte oder jedes zwölfte Jahr wieder Weizen auf demselben Acker.“"
                                            },
                                            {
                                                "example_id": "5b5c5d4c-e401-4054-9c92-02503f978b43",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "[Schlagzeile:] „Konventionelles Soja ist ideal für europäische Äcker“"
                                            },
                                            {
                                                "example_id": "13707c48-962a-4e95-9a3c-22ec6f8b30b8",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "[1848:] „Eine der bedeutendsten Neuerungen ist die Befreiung des bäuerlichen Bodens von Grundlasten, Frondiensten und Abgaben; viele Landwirte werden dadurch Besitzer der von ihnen bebauten Äcker.“"
                                            },
                                            {
                                                "example_id": "7324e489-b87e-433d-aacb-b014072cb4b3",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„So kamen sie zu dem Acker, der Igel wies seiner Frau ihren Platz an und ging den Acker hinauf.“"
                                            },
                                            {
                                                "example_id": "f15b064a-bf48-4e46-a8e3-4f999390ce0f",
                                                "sense_id": "26e7d896-98f0-3d4e-a0c7-c4d2651cd3cb",
                                                "text": "„Ein konventionell bewirtschafteter Acker weist eine wesentlich geringere Artenvielfalt auf als einer im Biolandbau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "147b17a0-5a07-3ba4-83c3-a17bf173e771",
                                        "entry_id": "04be484c-1435-344e-ba20-34ec00525433",
                                        "glosses": [
                                            "altes Flächenmaß für landwirtschaftliche Flächen"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b119c23-29a0-4943-87c6-53b12ffe7249",
                                                "sense_id": "147b17a0-5a07-3ba4-83c3-a17bf173e771",
                                                "text": "Sein Großvater besaß 50 Acker Land."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
