                        "examples": [
                            {
                                "example_id": "a243db24-86d5-4e78-b1e7-c804f17898de",
                                "sense_id": "2f1b15f4-da7e-3a17-b4d1-3a50ca83a7c5",
                                "text": "„Mythenforscher haben Leng in Zentralasien angesiedelt; doch das Erbgedächtnis des Menschen - oder seiner Vorläufer - reicht weit zurück, und es mag wohl sein, dass bestimmte Geschichten aus Ländern und Bergen und Tempeln des Schreckens überliefert wurden, die älter sind als Asien und älter als jede Menschenwelt, von der wir wissen.“"
                            }
                        ],
