                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e3b0c7-234d-4b0e-958d-0654682adbe8",
                                                "sense_id": "79cda5e7-2533-34ee-b835-9c3c54bcf44e",
                                                "text": "La procession va commencer ; il est d’usage que les messieurs marchent derrière le Saint-sacrement."
