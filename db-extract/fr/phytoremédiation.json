                                        "entry_id": "a169dfdf-ef9f-33bb-b4ad-1fb6c3e83b48",
                                        "glosses": [
                                            "técnica de remediação ambiental que utiliza plantas para absorver, degradar, estabilizar ou eliminar poluentes presentes no solo, na água ou no ar"
                                        ],
                                        "tags": [
                                            "ecologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43d0c08-b557-4d8d-9c0f-697591b52f73",
                                                "sense_id": "5bcfff5d-9582-364e-8cd4-29caad3a4091",
                                                "text": "A fitorremediação é considerada uma alternativa sustentável para recuperar áreas contaminadas"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a75f3f-0d5c-3296-be09-dcd61b952365",
                                        "entry_id": "a169dfdf-ef9f-33bb-b4ad-1fb6c3e83b48",
                                        "glosses": [
                                            "processo em que plantas, muitas vezes associadas a microrganismos, são empregadas para reduzir a toxicidade de metais pesados, pesticidas e outros contaminantes"
                                        ],
                                        "tags": [
                                            "ecologia"
                                        ],
                                        "examples": [
                                            {
