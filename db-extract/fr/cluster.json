                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "50dbb1a3-7933-35a1-9945-a4a91e447ebe",
                        "entry_id": "b4ba8b95-3ecf-3407-849d-2ed37c74ae8e",
                        "glosses": [
                            "Groupe d’octets."
                        ],
