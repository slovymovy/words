                                                "example_id": "369b5da9-da9a-499a-92ef-54745c9eb2af",
                                                "sense_id": "68e95d04-b7cf-3c67-a91f-ff865b4c21bc",
                                                "text": "Het zat hierin verstopt."
                                            },
                                            {
                                                "example_id": "8df60ec7-d1cc-4843-bf4d-db0b607af61e",
                                                "sense_id": "68e95d04-b7cf-3c67-a91f-ff865b4c21bc",
                                                "text": "Hier zat het in verstopt."
                                            },
                                            {
                                                "example_id": "dfe15e47-9160-4c36-b567-a52babcb219d",
                                                "sense_id": "68e95d04-b7cf-3c67-a91f-ff865b4c21bc",
                                                "text": "Ik zakte teleurgesteld neer op een houten bankje naast het raam en opende het gastenboek van het café dat als ‘trail-register’ fungeerde. Hierin stonden alle namen van de hikers die me voor waren geweest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
