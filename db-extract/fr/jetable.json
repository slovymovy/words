                                        "entry_id": "e75796f6-5fe6-31f6-8844-66ab18e105f8",
                                        "glosses": [
                                            "That is designed to be discarded rather than reused, refilled or repaired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1edfa2f2-b134-4e52-a458-462003282934",
                                                "sense_id": "074ccb86-810d-3909-892a-fad100dd598a",
                                                "text": "Rather than purchase an expensive razor he bought a packet of cheap disposable ones."
                                            },
                                            {
                                                "example_id": "486d23c2-d634-4571-a688-b8d0b3bb7692",
                                                "sense_id": "074ccb86-810d-3909-892a-fad100dd598a",
                                                "text": "A disposable cup sits in a museum gallery, fully intact even after being cast aside thousands of years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63635ea-cc88-33e4-93dd-20b76925b474",
                                        "entry_id": "e75796f6-5fe6-31f6-8844-66ab18e105f8",
                                        "glosses": [
                                            "Available to be used; at one's disposal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b07478f-992f-435f-b2bd-f9264567323b",
