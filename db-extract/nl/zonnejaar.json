                            {
                                "example_id": "16434089-f426-41d4-97fa-075e446e9ec3",
                                "sense_id": "f04981ff-cbdf-331f-905f-4c006c29cbd2",
                                "text": "Een zonnejaar is de tijd die de aarde nodig heeft om rond de zon te draaien.",
                                "translation": "A solar year is the time it takes for the Earth to orbit around the Sun.",
                                "english": "A solar year is the time it takes for the Earth to orbit around the Sun."
                            },
                            {
                                "example_id": "5e81ef27-c7a7-4b7d-a269-88acb971ff6e",
                                "sense_id": "f04981ff-cbdf-331f-905f-4c006c29cbd2",
                                "text": "Het zonnejaar is iets langer dan het kalenderjaar.",
                                "translation": "The solar year is slightly longer than the calendar year.",
                                "english": "The solar year is slightly longer than the calendar year."
                            },
                            {
                                "example_id": "ae0739f6-a0d1-4dfd-8c3b-b317b81ccee9",
                                "sense_id": "f04981ff-cbdf-331f-905f-4c006c29cbd2",
                                "text": "We meten de tijd in zonnejaren sinds het begin van de beschaving.",
                                "translation": "We have measured time in solar years since the dawn of civilization.",
                                "english": "We have measured time in solar years since the dawn of civilization."
                            }
                        ]
                    }
