                    {
                        "sense_id": "5e5d5732-c7b3-3233-ad8d-bccb464d95ce",
                        "entry_id": "1f60d6e3-ced3-30ca-a15c-704f3ea8df0c",
                        "glosses": [
                            "große Basilika im Vatikan, erbaut über dem Grab des Apostels Petrus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6c5eb2-e142-4b9f-b705-254ebf404789",
                                "sense_id": "5e5d5732-c7b3-3233-ad8d-bccb464d95ce",
                                "text": "„Die große Basilika des Petersdoms war beeindruckend.“"
                            },
                            {
                                "example_id": "45705cab-b3c3-4dae-a6a0-22ad02100814",
                                "sense_id": "5e5d5732-c7b3-3233-ad8d-bccb464d95ce",
                                "text": "„Wenn es stimmt, dass in diesem monumentalen Gebäude – wie der Petersdom in Rom durch Ablassgelder mitfinanziert – 20000 Menschen stehen können, dann hätte jeder von ihnen gewissermaßen einen eigenen Stammbaum, über viele Jahre gewachsen und über viele Kilometer herangeschwommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
