                    ]
                },
                {
                    "sense_id": "c21c9901-6d94-3fef-9f55-691720b71803",
                    "sense_definition": "Incitation au mal ou au péché, particulièrement dans un contexte religieux ou moral.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le désert, le saint ermite priait sans relâche pour repousser les <w>tentations</w> du démon."
                        },
                        {
                            "text": "Les théologiens rappellent que les âmes les plus pures ne sont pas à l'abri de la <w>tentation</w>."
