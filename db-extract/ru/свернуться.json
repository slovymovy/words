                            {
                                "example_id": "d3102636-7de4-469e-a003-7000041e9584",
                                "sense_id": "2a11ba1f-d06d-34b0-8427-e0004a29b394",
                                "text": "От сильного жара бумага свернулась."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c154d80-345e-33f9-8389-10ccfd79ce91",
                        "entry_id": "478210cd-7b4e-3cf5-b233-90a6d772db28",
                        "glosses": [
                            "загнувшись с краёв, закрыться (о листьях, лепестках цветов)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9605d13f-c5ad-4ae2-b975-c37218ef75b2",
                                "sense_id": "3c154d80-345e-33f9-8389-10ccfd79ce91",
                                "text": "Лепестки розы свернулись."
                            },
                            {
                                "example_id": "bff577b9-7ab8-42d9-ba20-c2b702b3e53e",
                                "sense_id": "3c154d80-345e-33f9-8389-10ccfd79ce91",
                                "text": "Лист свернулся и засох."
                            }
                        ]
                    },
                    {
                        "sense_id": "eadefbea-077d-35a6-bd96-a454aa2087b7",
                        "entry_id": "478210cd-7b4e-3cf5-b233-90a6d772db28",
                        "glosses": [
                            "улечься, приблизив ноги к голове, согнувшись кольцом, кружком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a24883e-4c10-4c0f-87dc-0de93640596d",
                                "sense_id": "eadefbea-077d-35a6-bd96-a454aa2087b7",
                                "text": "На завалинках кошки свернулись клубочком."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d4d51bd-5ddd-3ff9-833d-f6a12d0d9f50",
                        "entry_id": "478210cd-7b4e-3cf5-b233-90a6d772db28",
                        "glosses": [
                            "сгустившись, превратиться в комок или комки, застыть комками (о чем-либо жидком)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5829caba-646f-4434-afe0-671a8b6a41f7",
                                "sense_id": "7d4d51bd-5ddd-3ff9-833d-f6a12d0d9f50",
                                "text": "Кровь свернулась."
                            },
                            {
                                "example_id": "199e6762-26f2-4355-baf6-34399ed223fb",
                                "sense_id": "7d4d51bd-5ddd-3ff9-833d-f6a12d0d9f50",
                                "text": "Кислое молоко свернулось при кипячении."
                            }
                        ]
                    },
                    {
                        "sense_id": "10077bde-b380-35a4-8630-e47eb0e442d3",
                        "entry_id": "478210cd-7b4e-3cf5-b233-90a6d772db28",
                        "glosses": [
                            "перен., воен. разместиться более плотно, на меньшем пространстве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac757e4e-6493-4ffb-aacd-f869afa0a2f1",
                                "sense_id": "10077bde-b380-35a4-8630-e47eb0e442d3",
                                "text": "Войска свернулись в походные колонны."
                            }
                        ]
                    },
                    {
                        "sense_id": "c50b2439-802b-347a-b5e8-1b0d26e6c015",
                        "entry_id": "478210cd-7b4e-3cf5-b233-90a6d772db28",
                        "glosses": [
