                    {
                        "sense_id": "7faf49c7-a895-320c-9894-afaf3cf36814",
                        "entry_id": "f95106b3-cb03-3f6e-b43e-244491cf0552",
                        "glosses": [
                            "Espèce de lièvre des steppes et régions semi-désertiques d’Asie centrale, de la Caspienne à la Chine du Nord-est."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2f7d7e4b-7c18-497f-9c78-03f535a779ca",
                                "sense_id": "7faf49c7-a895-320c-9894-afaf3cf36814",
                                "text": "Le Tolaï, nommé par Cuvier Lapin de Sibérie, tient en quelque sorte le milieu entre la section des Lièvres et celle des Lapins."
                            },
                            {
                                "example_id": "33c17978-1cd4-446c-a1fb-da78b26270c2",
                                "sense_id": "7faf49c7-a895-320c-9894-afaf3cf36814",
                                "text": "Le Tolaï habite la Sibérie, la Mongolie, la Tartarie et même le Tibet."
                            }
                        ]
                    }
                ],
