{
    "word_family": [
        "kilogramme",
        "gram",
        "milligram",
        "kilogram-force"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "166d386a-86e2-3d8f-9a24-5a4b1435570b",
                    "sense_definition": "The base unit of mass in the International System of Units, equal to one thousand grams.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires exactly one <w>kilogram</w> of flour to make the bread.",
                            "target_lang_translations": {
                                "ru": "Для приготовления хлеба по рецепту требуется ровно один <w>килограмм</w> муки.",
                                "zh": "做面包的食谱要求正好用一<w>公斤</w>面粉。"
                            }
                        },
                        {
                            "text": "Scientists recently redefined the <w>kilogram</w> using a constant of nature rather than a physical object.",
                            "target_lang_translations": {
                                "ru": "Ученые недавно пересмотрели определение <w>килограмма</w>, используя природную константу вместо физического объекта.",
                                "zh": "科学家们最近利用自然常数而非实物重新定义了<w>千克</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kilo",
                        "kg"
                    ],
                    "common_phrases": [
                        "one kilogram",
                        "per kilogram",
                        "kilogram of sugar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная единица измерения массы в Международной системе единиц (СИ), равная одной тысяче граммов.",
                        "zh": "国际单位制中质量的基本单位，等于一千克。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "килограмм",
                                "target_lang_sense_clarification": "основная единица массы"
                            },
                            {
                                "target_lang_word": "кг",
                                "target_lang_sense_clarification": "сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "千克",
                                "target_lang_sense_clarification": "质量的基本单位"
                            },
                            {
                                "target_lang_word": "公斤",
                                "target_lang_sense_clarification": "日常生活中常用的质量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88f92e87-8e43-302d-b4b8-6a4f79e7639e",
                    "sense_definition": "A unit of weight used in commerce and daily life to measure how heavy something is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient reported an unintentional weight gain of several <w>kilograms</w> over the last month.",
                            "target_lang_translations": {
                                "ru": "Пациент сообщил о непреднамеренном увеличении веса на несколько <w>килограммов</w> за последний месяц.",
                                "zh": "病人报告说过去一个月里体重无意间增加了几<w>公斤</w>。"
                            }
                        },
                        {
                            "text": "A <w>kilogram</w> of beef costs significantly more than it did last year.",
                            "target_lang_translations": {
                                "ru": "<w>Килограмм</w> говядины стоит значительно дороже, чем в прошлом году.",
                                "zh": "一<w>公斤</w>牛肉的价格比去年贵多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kilo",
                        "kg"
                    ],
                    "common_phrases": [
                        "kilogram of beef",
                        "lose a kilogram",
                        "total weight in kilograms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица веса, используемая в торговле и повседневной жизни для измерения тяжести предметов.",
                        "zh": "商业和日常生活中用于衡量物体重量的单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "килограмм",
                                "target_lang_sense_clarification": "мера веса"
                            },
                            {
                                "target_lang_word": "кило",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公斤",
                                "target_lang_sense_clarification": "衡量重量的常用单位"
                            },
                            {
                                "target_lang_word": "千克",
                                "target_lang_sense_clarification": "正式的重量单位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}