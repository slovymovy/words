                        "entry_id": "b0d41a09-3465-3fa7-8813-0ac2c4091465",
                        "glosses": [
                            "To transliterate something into the characters of the Latin script; to Romanize"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "12331754-881b-4a5e-8f0b-b8c6baaa6fdf",
                                "sense_id": "fbb4396c-4324-3aae-9c2b-5d949006caf4",
                                "text": "The Cyrillic letter Л can be Latinized as L."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd064aa2-cac2-3df7-b4eb-b0645667b45a",
                        "entry_id": "b0d41a09-3465-3fa7-8813-0ac2c4091465",
                        "glosses": [
                            "To render or become Roman Catholic in form or style or to diffuse Roman Catholic ideas in something."
