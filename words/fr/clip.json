                    "frequency": "Low",
                    "semantic_group_id": "attache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle portait un élégant <w>clip</w> en argent fixé sur le revers de sa veste."
                        },
                        {
                            "text": "Comme elle n'a pas les oreilles percées, elle a choisi une boucle à <w>clip</w>."
