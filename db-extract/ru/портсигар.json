                                    {
                                        "sense_id": "30138cec-5f76-3085-95a5-6e0fa73466ca",
                                        "entry_id": "b72c352e-895f-3022-bcbc-ec40ce52559d",
                                        "glosses": [
                                            "A small flat case for holding cigarettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0334d3-3ee9-41b3-a18e-879bcf486254",
                                                "sense_id": "30138cec-5f76-3085-95a5-6e0fa73466ca",
                                                "text": "Of the three weapons he brought with him, two were built into cigarette cases, while the other superficially resembled an ordinary small automatic pistol."
                                            }
                                        ]
                                    }
                                ]
