                                                "example_id": "3501442d-b82c-4362-ae14-f79a9cf61d86",
                                                "sense_id": "ccb0a8e2-05e4-3c25-a798-d6b98441560c",
                                                "text": "Qua afstand is er weinig verschil tussen deze twee routes, maar qua reistijd is de eerste route aanzienlijk gunstiger."
                                            }
                                        ]
