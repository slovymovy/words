                "senses": [
                    {
                        "sense_id": "86ca9898-8067-36c5-ba3c-b61f52a87b9e",
                        "entry_id": "9628ba77-81ff-3315-a65d-618fa00d5343",
                        "glosses": [
                            "Faire la tranchefile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5078c6a5-01d5-41d2-8df3-f0fb0d3a407c",
                                "sense_id": "86ca9898-8067-36c5-ba3c-b61f52a87b9e",
                                "text": "Quand la tranche est dorée ou bien mise en couleur, Tranchefilez le livre au gré de l’amateur.... On tranchefile en fil, on tranchefile en soie.... On en fait en argent mêlé de soie et d’or."
                            },
                            {
                                "example_id": "a428a447-2c7a-493b-9a24-2bb78f45abb7",
                                "sense_id": "86ca9898-8067-36c5-ba3c-b61f52a87b9e",
                                "text": "Pour cela, on prend une feuille de carton plus ou moins épaisse, selon la grandeur des livres qu'on veut tranchefiler;"
                            },
                            {
                                "example_id": "898902a0-5d24-4634-b872-6c07248745e2",
                                "sense_id": "86ca9898-8067-36c5-ba3c-b61f52a87b9e",
                                "text": "Petite presse à tranchefiler."
                            }
                        ]
                    }
