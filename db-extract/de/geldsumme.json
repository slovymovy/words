                "senses": [
                    {
                        "sense_id": "ce6cb45a-1d14-3bf7-b0a4-ef0d2d875686",
                        "entry_id": "90ee9e12-6b52-3295-9174-54b30fa2d7f7",
                        "glosses": [
                            "Gesamtbetrag des Geldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a07ca8-7552-4e8c-9d28-35630a24fdeb",
                                "sense_id": "ce6cb45a-1d14-3bf7-b0a4-ef0d2d875686",
                                "text": "„Offroadfahren hat zudem desaströse Folgen für die Natur und wird mit hohen Geldsummen geahndet.“"
                            },
                            {
                                "example_id": "5fa71f48-50f0-4c0a-866c-064f4d141b84",
                                "sense_id": "ce6cb45a-1d14-3bf7-b0a4-ef0d2d875686",
                                "text": "„Als Einstein 1921 den Nobelpreis erhielt, überschrieb er die damit verbundene Geldsumme an Mileva.“"
                            },
                            {
                                "example_id": "03f8c2e6-91c7-4210-9630-f6d7f38b7de3",
                                "sense_id": "ce6cb45a-1d14-3bf7-b0a4-ef0d2d875686",
                                "text": "„Mit Hilfe der Mutter und des verständnisvollen Onkels brachte man den verärgerten Vater noch einmal dazu, dem Sohn eine letzte Geldsumme auszubezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
