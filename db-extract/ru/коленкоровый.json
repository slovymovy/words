                "senses": [
                    {
                        "sense_id": "e8aa4c85-3352-3b57-aec7-afdff2758882",
                        "entry_id": "1f2da09d-9f17-3623-baf4-e04cbb2bd663",
                        "glosses": [
                            "calico (rough cotton cloth)"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "fa0b2829-944f-416a-acae-87034a0e5e80",
                                "sense_id": "e8aa4c85-3352-3b57-aec7-afdff2758882",
                                "text": "Тогда́ протопо́пица, да́ма мни́тельная, поднесла́ ему́ две коленко́ровые мани́шки своего́ дре́внего рукоде́лья от тех пор, когда́ ещё протопо́п был ста́вленником, но чуда́к и э́того не взял.",
                                "translation": "Then the priest’s wife, a nervous woman, offered him two calico shirtfronts of her own making from ancient times, when the archpriest was still a layman, but the odd fellow did not take them either.",
                                "english": "Then the priest’s wife, a nervous woman, offered him two calico shirtfronts of her own making from ancient times, when the archpriest was still a layman, but the odd fellow did not take them either."
                            }
                        ]
                    }
                ],
