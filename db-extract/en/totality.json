                "translations": [
                    {
                        "translation_id": "032ecce4-beff-4725-8add-ea2f9baa4ef7",
                        "source_entry_id": "e370d248-7546-321d-b6fb-de7f8b89d715",
                        "source_sense_description": "state of being total",
                        "target_lang_word": "totalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db692d73-0ddd-3ee2-8fee-84cae9fd4619",
                                        "entry_id": "2a3b03f4-e0bd-3c50-8b15-46669ed29de4",
                                        "glosses": [
                                            "Total ; tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2c0899-cb0a-46cc-845e-3953d15a03ff",
                                                "sense_id": "db692d73-0ddd-3ee2-8fee-84cae9fd4619",
                                                "text": "Aucun dealeur local ne peut satisfaire la totalité de la nouvelle demande de cannabis et les jeunes les plus téméraires s’aventurent dans les cités des environs pour s'approvisionner, […]."
                                            },
                                            {
                                                "example_id": "03c24f92-7df6-489d-aa98-97b9595eb35a",
                                                "sense_id": "db692d73-0ddd-3ee2-8fee-84cae9fd4619",
                                                "text": "Cette fois, ce fut Damen que les soldats congratulèrent. Il revêtait désormais un prestige nouveau à leurs yeux, en tant que celui dont les réflexes affûtés avaient sauvé la moitié des hommes et la totalité du vin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43ad8bb7-7a45-46a3-8191-10066ed9703b",
                        "source_entry_id": "e370d248-7546-321d-b6fb-de7f8b89d715",
                        "source_sense_description": "state of being total",
                        "target_lang_word": "Gesamtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesamtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0fccb4-1e2f-320d-8ce8-cb9e03b6ba83",
                                        "entry_id": "10ad00ab-8a2c-3f33-a88a-28d5c94010d1",
                                        "glosses": [
                                            "das Ganze, das Gesamte, die Gemeinschaft einer Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecee9d3f-5867-4620-b24a-8240a3fb9105",
                                                "sense_id": "aa0fccb4-1e2f-320d-8ce8-cb9e03b6ba83",
                                                "text": "„Die christlich-europäischen Völker haben, insofern sie der Welt der Wissenschaft angehören, in ihrer Gesamtheit germanische Bildung; denn Italien, Spanien, Frankreich, England usw. haben durch die germanischen Nationen eine neue Gestalt erhalten.“"
                                            },
                                            {
                                                "example_id": "c066baf1-d386-42ad-94c6-043718acac46",
                                                "sense_id": "aa0fccb4-1e2f-320d-8ce8-cb9e03b6ba83",
                                                "text": "„Die Grundidee ist, daß sich statistische Begriffsbildungen auf Gesamtheiten von Dingen, Menschen oder Situationen beziehen und daß man Eigenschaften der einzelnen Mitglieder solcher Gesamtheiten durch Variablen repräsentieren kann.“"
                                            },
                                            {
                                                "example_id": "6413c055-8808-4f05-a85b-20b152d03fe0",
                                                "sense_id": "aa0fccb4-1e2f-320d-8ce8-cb9e03b6ba83",
                                                "text": "„Der kaiserliche Hof, die umfangreiche Bürokratie und das Heer verzehrten fast die Gesamtheit der in den Städten und auf dem Lande über die Subsistenz hinaus erwirtschafteten Überschüsse.“"
                                            },
                                            {
                                                "example_id": "53cf2ec9-4400-4490-9754-2ff5bd7373b2",
                                                "sense_id": "aa0fccb4-1e2f-320d-8ce8-cb9e03b6ba83",
                                                "text": "„Die Gesamtheit der Ursachen einer Erscheinung ist dem menschlichen Verstand nicht zugänglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3032d48-3ff8-4a52-b198-0fe133daeab6",
                        "source_entry_id": "e370d248-7546-321d-b6fb-de7f8b89d715",
                        "source_sense_description": "state of being total",
                        "target_lang_word": "совоку́пность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "совоку́пность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c368f3a7-8d9f-3c61-a1e5-d8b0f1610772",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "объекты, выступающие вместе, как одно целое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676e3e0e-ec5e-4b6e-874e-644640c32d2a",
                                                "sense_id": "c368f3a7-8d9f-3c61-a1e5-d8b0f1610772",
                                                "text": "Многие важнейшие открытия в науке 20-го столетия связаны с выявлением эффектов согласованного поведения (синергизмом) на макроуровне совокупностей отдельных элементов (атомов, электронов, клеток, особей), хаотически ведущих себя на микроуровне."
                                            },
                                            {
                                                "example_id": "53b3b64d-554d-4889-8d97-6e853230c569",
                                                "sense_id": "c368f3a7-8d9f-3c61-a1e5-d8b0f1610772",
                                                "text": "В 1972 году американским исследователям Роберту Муру и Виктору Эйхлеру удалось показать, что циркадным ритмом млекопитающих управляет супрахиазматическое ядро (СХЯ), расположенное в головном мозге в основании гипоталамуса. СХЯ человека представляет собой совокупность около 20 тысяч нейронов и настраивается с помощью внешних сигналов, в основном дневного света."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного совокупный; сочетание, цельность чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fd35eb-7e55-4d4c-b6bc-6ad457e39eff",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "Кто вникал в деяния природы, тот знает, что она действует всегда единовременно или вдруг, и в сложениях, ею производимых, мы не находим черты, отличающей составляющую часть от другой, но всегда совокупность."
                                            },
                                            {
                                                "example_id": "82297e88-eecc-4192-8759-1a3bf31db207",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "Впрочем, в совокупности этих пристроек, надстроек, флигелей единство есть, по крайней мере мне так кажется."
                                            },
                                            {
                                                "example_id": "2dca5392-f1ed-454c-a4f6-20494d7f7964",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "Де-Грие хотел только отвлечь её от больших кушей: он предлагал ставить на числа, поодиночке и в совокупности."
                                            },
                                            {
                                                "example_id": "3f1d6232-28f3-410c-959f-71a779840cd0",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "— Мудрость… это совокупность истин, добытых умом, наблюдением и опытом и приложимых к жизни…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87ec1c53-6088-3d3a-a8fb-9c738ab9a66c",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "общая сумма, общее количество, полное множество"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3258f69b-9990-392f-81da-e77c4020a84a",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "объединение, коллектив, группа"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3ec61a1-e70c-498f-822a-1ffcd86f18d9",
                        "source_entry_id": "e370d248-7546-321d-b6fb-de7f8b89d715",
                        "source_sense_description": "state of being total",
                        "target_lang_word": "целоку́пность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "целоку́пность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44f48503-6efe-3ca3-bbaf-150bd7213e66",
                                        "entry_id": "e1615460-22ad-3213-9ff9-ce4ed91c4235",
                                        "glosses": [
                                            "книжн. свойство по значению прилагательного целокупный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2cb4ea6-ceb7-42fc-9a62-4848282c3d1e",
                                                "sense_id": "44f48503-6efe-3ca3-bbaf-150bd7213e66",
                                                "text": "Он воспринимал явления и события жизни в их целокупности, не с одной, а одновременно со всех сторон в их противоречивом единстве."
                                            }
                                        ]
