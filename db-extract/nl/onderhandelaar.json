                                        "sense_id": "56591a3b-18a3-336c-a34d-c80ddf3f3aaf",
                                        "entry_id": "0d3dc663-7818-3b91-b9d5-2e8feb30c51c",
                                        "glosses": [
                                            "Person, die Verhandlungen führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff00ff00-ab8a-45e7-8de6-220c57e2cb79",
                                                "sense_id": "56591a3b-18a3-336c-a34d-c80ddf3f3aaf",
                                                "text": "„Sie wählte einen Offizier als Verhandlungsführer aus, der weniger Schulterblattsterne trug als die anderen, aber besseres Englisch sprach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
