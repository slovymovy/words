                ],
                "senses": [
                    {
                        "sense_id": "056130d9-9df6-3b6b-876a-ed9db7f855bd",
                        "entry_id": "4fc4aba6-344c-3ff9-b738-54ea674411c8",
                        "glosses": [
                            "Luftsportler, der mit einem Gleitsegel fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5336e867-267d-4658-9e5b-190e667a55ce",
                                "sense_id": "056130d9-9df6-3b6b-876a-ed9db7f855bd",
                                "text": "„Das ungewohnt intensive, komprimierte Erleben macht es erklärlich, dass Gleitschirmflieger im Verlust des Zeitgefühls die Erlebnisspanne länger einschätzen, als sie real war.“"
                            },
                            {
                                "example_id": "289463ca-dab2-4bbc-a008-130337f4ff2f",
                                "sense_id": "056130d9-9df6-3b6b-876a-ed9db7f855bd",
                                "text": "„Ein deutscher Rucksacktourist zeltete 1994 im Palastgarten, ein nackter Gleitschirmflieger besuchte die Königin, ein verwirrter Mann hielt sie für seine Mutter.“"
                            },
                            {
                                "example_id": "d4565936-4a0a-4887-88b3-065998c9a0a8",
                                "sense_id": "056130d9-9df6-3b6b-876a-ed9db7f855bd",
                                "text": "„Drei Gleitschirmflieger ließen sich die steilen Kalkwände der Dolomiten bis zu einer Höhe von 3 000 Metern hochschwingen.“"
                            },
                            {
                                "example_id": "01a83b1b-3653-47a9-8d94-1b14845cdaff",
                                "sense_id": "056130d9-9df6-3b6b-876a-ed9db7f855bd",
                                "text": "„Ein vermeintlich abgestürzter Gleitschirmflieger hat im Schwarzwald für einen Einsatz von Polizei und Bergwacht gesorgt.“"
                            },
                            {
                                "example_id": "fe624188-83a4-4dd0-839e-9aae99eeea2a",
                                "sense_id": "056130d9-9df6-3b6b-876a-ed9db7f855bd",
                                "text": "„Umgerechnet auf die 26.000 Gleitschirmflieger in der Bundesrepublik ist das Risiko für einen tödlichen Unfall in der Luft ähnlich hoch wie das im Straßenverkehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
