                    {
                        "sense_id": "3e680f6d-28e5-3e4a-b2a4-6e630df40458",
                        "entry_id": "28acb9f3-06b0-3889-8256-a1f896810585",
                        "glosses": [
                            "（姐妹般的）特质，姐妹情谊 （比如与另一个人的团结等）"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb588d1d-f637-3a87-a040-d2e5ad6deaf6",
                        "entry_id": "28acb9f3-06b0-3889-8256-a1f896810585",
                        "glosses": [
                            "修女会"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f5ce38-c05e-4230-9014-d1aa6cd1c4c9",
                                "sense_id": "eb588d1d-f637-3a87-a040-d2e5ad6deaf6",
                                "text": "In contrast, she said, women join sisterhoods and do volunteer work for Jewish fundraising organizations that are run and dominated by men."
                            }
                        ]
                    },
                    {
                        "sense_id": "27bfe6d0-ecb2-35bc-953f-b7d7274f0cea",
                        "entry_id": "28acb9f3-06b0-3889-8256-a1f896810585",
                        "glosses": [
                            "（妇女共有的）经验，体验，故事 （在第三波女性主义中已经废弃）"
                        ],
                        "tags": [
                            "女性主義"
                        ],
                        "examples": [
                            {
                                "example_id": "a4c7d8a5-5ccd-44e8-a5da-1dc4550a1af9",
                                "sense_id": "27bfe6d0-ecb2-35bc-953f-b7d7274f0cea",
                                "text": "What does the rallying cry of sisterhood and the concept of feminism mean when last year, the majority of white, female voters chose whiteness as a political identity over womanhood?"
                            },
                            {
                                "example_id": "f2cd1651-720f-40d5-9f58-f9a3015345c3",
                                "sense_id": "27bfe6d0-ecb2-35bc-953f-b7d7274f0cea",
                                "text": "In a terrible way, I’ve never felt more part of a sisterhood or more certain that pain is shared within that family."
                            }
                        ]
                    }
                ],
