                    },
                    {
                        "form_id": "fb35f67f-707c-4cf9-84bc-12bf8525c692",
                        "entry_id": "f9929ba1-55d6-3f6e-902b-f581664a4b5e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "archetière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                        "entry_id": "f9929ba1-55d6-3f6e-902b-f581664a4b5e",
                        "glosses": [
                            "Ouvrier ou artisan qui fabrique des archets pour instruments de musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25579d2b-36f2-4dd2-84b7-f983365b57d4",
                                "sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                                "text": "Il faut cinq ans de formation complémentaire, de perfectionnement, pour faire un bon compagnon luthier, quatre ans pour un archetier."
                            },
                            {
                                "example_id": "e7fda165-e215-410c-8b48-84b70f10b18d",
                                "sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                                "text": "A la fin de son année scolaire de 3e, elle décide de s’orienter vers l’archèterie, mais la direction de l’Ecole de Mirecourt ne lui laisse pas passer les tests d’admission de cette 2e promotion d’archetiers, sans que la raison en soit très claire."
                            },
                            {
                                "example_id": "e1afd39c-0516-4e85-8113-b67e445a5efd",
                                "sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                                "text": "Formatrice agréée et Maitre Artisan en Métier d'Art, elle transmet aussi son savoir-faire et ses connaissances à de jeunes archetiers prometteurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "559f084f-4bd1-4e8a-8dc8-17adf07de8ad",
                        "source_entry_id": "f9929ba1-55d6-3f6e-902b-f581664a4b5e",
                        "source_sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                        "target_lang_word": "Bogenbauer",
