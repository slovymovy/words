                "senses": [
                    {
                        "sense_id": "1f90567f-eba0-3b31-a409-34aa2af3becd",
                        "entry_id": "10ce9891-ac83-3cb8-a61a-302d7ac15c2f",
                        "glosses": [
                            "Luft, wie sie im Neuen Jahr empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a9bb85-f281-4936-a0cf-44e04748575e",
                                "sense_id": "1f90567f-eba0-3b31-a409-34aa2af3becd",
                                "text": "„Die Neujahrsluft roch nach Glühweingewürz und Silvesterraketen, und das Geäst der Bäume unterm Laternenlicht zeichnete feine Schattenlinien auf den Asphalt.'“"
                            },
                            {
                                "example_id": "6f8fcf19-caa5-4262-8d98-2f7a899e4bb2",
                                "sense_id": "1f90567f-eba0-3b31-a409-34aa2af3becd",
                                "text": "„Es klirrte und krachte, dann strömte fühlbar eiskalte Neujahrsluft herein.“"
                            },
                            {
                                "example_id": "dd7cf7d1-53ab-4245-8bab-ce248aece2ab",
                                "sense_id": "1f90567f-eba0-3b31-a409-34aa2af3becd",
                                "text": "„Moralisch, materiell und körperlich geknickt, jagte man uns gegen 5 Uhr an die eiskalte Neujahrsluft.“"
                            },
                            {
                                "example_id": "7fc8ac57-82a6-4444-a432-fe8684475564",
                                "sense_id": "1f90567f-eba0-3b31-a409-34aa2af3becd",
                                "text": "„Der Mondhimmel hatte die Farbe von angelaufenem Silber, und in Neujahrsluft hing eine Ahnung von Schnee, der bald kommen mochte.“"
                            },
                            {
                                "example_id": "19c79e25-6edf-4154-8241-7fbf642d588b",
                                "sense_id": "1f90567f-eba0-3b31-a409-34aa2af3becd",
                                "text": "„Von Neujahrsgedanken umschwirrt sehe ich durch die blanken Fensterscheiben hinaus in die kühle Neujahrsluft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
