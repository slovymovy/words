                "senses": [
                    {
                        "sense_id": "60edadae-c6b9-3696-9dd4-5cc313df28fa",
                        "entry_id": "da52cab2-a725-38d1-b05f-9e0d55eb5528",
                        "glosses": [
                            "Schicht, die auf die Oberfläche von etwas aufgebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff0b2b1-6bf5-4823-8cd9-4042e0184d47",
                                "sense_id": "60edadae-c6b9-3696-9dd4-5cc313df28fa",
                                "text": "Kork eignet sich auch als Belag für Fußböden."
                            },
                            {
                                "example_id": "3f472682-73dc-48bc-ac1b-08704f9475f3",
                                "sense_id": "60edadae-c6b9-3696-9dd4-5cc313df28fa",
                                "text": "„Wir fuhren auf einem anderen Belag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95d20f83-da63-34ff-91c7-834cf2d347fd",
                        "entry_id": "da52cab2-a725-38d1-b05f-9e0d55eb5528",
                        "glosses": [
                            "Schicht, die sich auf etwas gebildet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4cecae-7288-4205-8e69-1355ca4ac217",
                                "sense_id": "95d20f83-da63-34ff-91c7-834cf2d347fd",
                                "text": "Wenn man das Zähneputzen vernachlässigt, bildet sich bald ein Belag."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a24b958f-1917-3a78-8834-a6abfe846e89",
                        "entry_id": "da52cab2-a725-38d1-b05f-9e0d55eb5528",
                        "glosses": [
                            "Nahrungsmittel wie Wurst oder Käse, das auf ein Brot oder Brötchen gelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bd2f54-80f9-4039-8c84-40f4f9c176cb",
                                "sense_id": "a24b958f-1917-3a78-8834-a6abfe846e89",
                                "text": "Welchen Belag möchtest Du? Magst Du Käse?"
                            },
                            {
                                "example_id": "d553da2b-9054-4dc3-9170-54c30d7fc307",
                                "sense_id": "a24b958f-1917-3a78-8834-a6abfe846e89",
                                "text": "„Ob Brötchen, Baguette, Sandwich oder Ciabatta — in jedem Fall kommt es auf den richtigen Belag an.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
