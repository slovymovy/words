                        "translation_id": "d849dff4-30bb-4d13-bbfd-12e432e25a26",
                        "source_entry_id": "a7f0d81f-6ce2-385a-a1a4-6b6c157aae5c",
                        "source_sense_id": "e040233f-a299-3856-a6ae-a9859e7e8c19",
                        "source_sense_description": "Medizin: Abszess, Eitergeschwulst, Eitergeschwür, Geschwür",
                        "target_lang_word": "Geschwür",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
