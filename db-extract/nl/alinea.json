                "senses": [
                    {
                        "sense_id": "83101d12-0cfd-3fac-9ed2-301e58d7aa33",
                        "entry_id": "26644668-e457-3cad-a69b-1783665991aa",
                        "glosses": [
                            "een onderverdeling van een stuk geschreven tekst, gewoonlijk bestaande uit een paar zinnen en aangegeven door een inspringende regel of door een witregel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff23872f-8b60-4cc8-9bc2-2f5abfe39cb0",
                                "sense_id": "83101d12-0cfd-3fac-9ed2-301e58d7aa33",
                                "text": "In de laatste alinea staat de conclusie van het betoog."
                            },
                            {
                                "example_id": "ab48e1fa-83b9-40b5-bf90-47e757b54108",
                                "sense_id": "83101d12-0cfd-3fac-9ed2-301e58d7aa33",
                                "text": "Elke post begon met een citaat gevolgd door een korte alinea die nooit echt autobiografisch genoeg was om hem te plaatsen, zoals: 'Er komt een punt in je leven dat de schoonheid van de wereld genoeg is'."
                            },
                            {
                                "example_id": "e082b3b5-7c94-40af-b606-45c7bedf7eba",
                                "sense_id": "83101d12-0cfd-3fac-9ed2-301e58d7aa33",
                                "text": "De brief was niet lang; hij bestond uit twee genummerde alinea's en een handtekening."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "675d6d39-a0ce-453a-8874-111fb1dd86ab",
                        "source_entry_id": "26644668-e457-3cad-a69b-1783665991aa",
                        "source_sense_id": "83101d12-0cfd-3fac-9ed2-301e58d7aa33",
