                "senses": [
                    {
                        "sense_id": "01558930-fc50-3e11-9d6c-96757e95e3b8",
                        "entry_id": "84306182-1b31-33ca-bf97-2bf798f266e9",
                        "glosses": [
                            "A machine used in road maintenance, construction, and mining for leveling large surfaces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a257af94-ffc4-41c8-9254-f589e344f9a7",
                                "sense_id": "01558930-fc50-3e11-9d6c-96757e95e3b8",
                                "text": "The blade-grader is a long steel-framed carriage under which is fixed a steel blade capable of being tilted at various angles: its principal use is in trimming cutting-slopes."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a038f0a-aba1-383a-a937-ca247ff47efb",
                        "entry_id": "84306182-1b31-33ca-bf97-2bf798f266e9",
                        "glosses": [
                            "A machine used to sort food by size or quality."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6d99dc5b-5d15-31ab-9ea8-1b4dac877829",
                        "entry_id": "84306182-1b31-33ca-bf97-2bf798f266e9",
                        "glosses": [
                            "One who grades, or that by means of which grading is done or facilitated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e936bf-fc83-48f7-8d07-9156f27ae1b7",
                                "sense_id": "6d99dc5b-5d15-31ab-9ea8-1b4dac877829",
                                "text": "the graders of a school examination"
                            }
                        ]
                    },
                    {
                        "sense_id": "9c5cd9e8-51df-3e85-bae4-283c78ba020b",
                        "entry_id": "84306182-1b31-33ca-bf97-2bf798f266e9",
                        "glosses": [
                            "One who belongs to a certain grade at school."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "3ffbc93f-7d87-4abe-93f6-66a17625712d",
                                "sense_id": "9c5cd9e8-51df-3e85-bae4-283c78ba020b",
                                "text": "a first-grader"
                            },
                            {
                                "example_id": "ebf0be5a-7e7b-483f-ae02-d288be413e9f",
                                "sense_id": "9c5cd9e8-51df-3e85-bae4-283c78ba020b",
                                "text": "The episode follows two different stories: in one, the show’s resident bigot, Eric Cartman, is outraged to learn that fellow fourth grader Clyde has risen to prominence as a white nationalist podcaster who makes offensive claims about women, Jewish people, Black people and other minority groups to goad them into debating him in exploitative viral videos (“WOKE STUDENT TOTALLY PWNED”)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133a1708-14bc-40fb-9f38-cc6c15d22537",
