                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519e038c-38e9-4be2-b561-de67a966a845",
                                                "sense_id": "55f0d72d-6110-3a65-9c8f-26b8505c4e3e",
                                                "text": "Met steun uit Saoedi-Arabië werd een hele generatie in een buitenissige vorm van islam gedrenkt. Nu strijdt het rijk van Salman Al-Saud tegen zijn radicaalste discipelen: IS. Gaat hij ook hun ideologie - die van zijn geestelijkheid - bevechten?."
                                            }
