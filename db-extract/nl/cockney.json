                            {
                                "example_id": "763585f4-bea2-4ecf-9858-12747f0b266c",
                                "sense_id": "7fd233ec-e07a-3708-b016-a68982cad101",
                                "text": "Pakken die net niet goed zitten, accenten die alle kanten opvliegen (Chroesjtsjov klinkt Amerikaans, Stalin spreekt plat Cockney) en protocollen die maar half worden begrepen."
                            },
                            {
                                "example_id": "20e83bd7-e853-46f4-959a-9303aa068f1b",
                                "sense_id": "7fd233ec-e07a-3708-b016-a68982cad101",
                                "text": "Inwoners van het Londense East End spreken het Cockney. In Birmingham heb je het Brummie, in Liverpool het Scouse en in Newcastle spreken mensen het Geordie."
                            }
                        ]
                    }
