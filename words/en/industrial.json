                        "zh": [
                            {
                                "target_lang_word": "工业级的",
                                "target_lang_sense_clarification": "指设备规格达到工业标准"
                            },
                            {
                                "target_lang_word": "商用的",
                                "target_lang_sense_clarification": "指非家用、用于商业或生产环境的"
                            }
