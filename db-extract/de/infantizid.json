                "senses": [
                    {
                        "sense_id": "03f19b25-9fa1-3e29-948f-66c0ce56100a",
                        "entry_id": "c923b444-0230-345a-9bd0-dd40486cd141",
                        "glosses": [
                            "Tötung eines Kindes, insbesondere durch einen Elternteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a9854c-1c79-4945-ac2f-fe96951f56a0",
                                "sense_id": "03f19b25-9fa1-3e29-948f-66c0ce56100a",
                                "text": "Das Strafmaß für Kindsmörder im Mittelalter wirkte als abschreckende Warnung dem Infantizid nicht entgegen, da alleinig die Tat geahndet wurde, ohne auf die Begleitumstände einzugehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4cb5e6b3-a37a-364c-8e84-70c9a3ec750c",
                        "entry_id": "c923b444-0230-345a-9bd0-dd40486cd141",
                        "glosses": [
                            "„Tötung von Nachkommen der eigenen Art bei Tieren“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d732c0e-b830-45df-a71a-aef025f4d141",
                                "sense_id": "4cb5e6b3-a37a-364c-8e84-70c9a3ec750c",
                                "text": "Das Töten fremder Nachkommen, als quasi Schmarotzer, kann ausgeschlossen werden, da die Vorteilsnahme, durch Infantizid Platz für die eigene Brut zu schaffen, evolutionsbedingt wahrscheinlicher ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e3a8e0d-8cf5-497c-87fa-53c99674d26b",
                        "source_entry_id": "c923b444-0230-345a-9bd0-dd40486cd141",
                        "source_sense_id": "03f19b25-9fa1-3e29-948f-66c0ce56100a",
