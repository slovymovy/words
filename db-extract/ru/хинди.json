                "senses": [
                    {
                        "sense_id": "17e5f6c4-3981-390c-b73c-1edd45f6485e",
                        "entry_id": "3619bfaa-0f22-37c5-b417-f0c31cf2a723",
                        "glosses": [
                            "лингв. распространенный в Индии язык, на котором говорят в большинстве северных и центральных регионов страны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef33644e-0b0d-4c2c-af29-98a830c3e9fa",
                                "sense_id": "17e5f6c4-3981-390c-b73c-1edd45f6485e",
                                "text": "Целый год трудолюбивая девушка изучает песни хинди, а также бенгальские песни, слова и музыка которых принадлежат великому писателю."
                            },
                            {
                                "example_id": "2fbdf1d7-f1c4-4f92-bd35-4999c6dd268c",
                                "sense_id": "17e5f6c4-3981-390c-b73c-1edd45f6485e",
                                "text": "При вступлении в должность премьер дал клятву выучить хинди и через несколько месяцев действительно начал вполне прилично произносить на нем речи."
                            }
                        ]
                    }
                ],
                "translations": [
