                        "éponger la sueur",
                        "éponger son visage"
                    ]
                },
                {
                    "sense_id": "5acbab2d-27b8-332a-8fb0-2e6d73bf2204",
                    "sense_definition": "Rembourser, combler ou faire disparaître une dette ou un déficit financier.",
