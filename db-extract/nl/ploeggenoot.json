                "senses": [
                    {
                        "sense_id": "aaf984b7-38ac-30bb-87ab-1cb4a26b851c",
                        "entry_id": "751de6a0-9d59-3a3f-a326-9323c0d81304",
                        "glosses": [
                            "sporter die lid is van dezelfde ploeg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e8e418-e822-4e5b-b74e-a4bba2aa2498",
                                "sense_id": "aaf984b7-38ac-30bb-87ab-1cb4a26b851c",
                                "text": "Van een tweestrijd was echter geen sprake. Iserbyt kwam in de tweede ronde na het oplopen van de trappen even in de problemen, maar vond de aansluiting bij het kopgroepje waarin onder anderen Aerts en ook zijn ploeggenoot Vanthourenhout reden."
                            },
                            {
                                "example_id": "3a7fe10b-43af-4044-b54d-3c77e0210f20",
                                "sense_id": "aaf984b7-38ac-30bb-87ab-1cb4a26b851c",
                                "text": "Spitse wordt bij Ajax ploeggenoot van collega-international Stefanie van der Gragt, die afgelopen zomer al terugkeerde naar Nederland. Net als Oranje-captain Sari van Veenendaal en Mandy van den Berg (beiden PSV) en Kika van Es (FC Twente)."
                            }
                        ]
                    }
