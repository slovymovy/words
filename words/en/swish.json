                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher kept a <w>swish</w> on his desk to maintain order.",
