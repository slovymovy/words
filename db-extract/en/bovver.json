                        ],
                        "examples": [
                            {
                                "example_id": "545e19a2-d828-47c8-84e7-6d89ef570400",
                                "sense_id": "6a694ff6-1c7c-3703-bfaf-8ee45e76243a",
                                "text": "No need to tell me, I'd recognize that Cockney accent anywhere! “I'm in a bit of bovver,” he said. “Do me a favour and go to the shelter and do the necessary for Trixie.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "ab2b9177-2513-3dce-bb63-486872a9f39b",
                        "entry_id": "24154f47-ed51-32d9-9d57-9fd07dfae109",
                        "glosses": [
                            "Violence, especially that associated with youth gangs."
                        ],
                        "tags": [
                            "British",
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "51ffa5b2-bc15-4bdf-9b72-5c8bea4316f6",
                                "sense_id": "ab2b9177-2513-3dce-bb63-486872a9f39b",
                                "text": "In London there are some thirty gangs of “bovver birds,” violence-prone girls who roam the streets in packs attacking almost any vulnerable object for no apparent reason other than the sheer thrill of it."
                            }
                        ]
                    }
                ],
