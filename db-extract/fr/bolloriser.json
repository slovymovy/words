                "senses": [
                    {
                        "sense_id": "c544af74-976c-3ba3-affa-9fbc55aeafc5",
                        "entry_id": "df3b2e49-ba0e-3a70-a7cd-058cdc381a58",
                        "glosses": [
                            "Soumettre au pouvoir de l’homme d’affaires Vincent Bolloré."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bd200be-8916-41d8-81c3-a9375af66ed6",
                                "sense_id": "c544af74-976c-3ba3-affa-9fbc55aeafc5",
                                "text": "Reste à savoir si les \"talents\" de Canal accepteront tous de se faire \"bolloriser\" ainsi."
                            },
                            {
                                "example_id": "923f06da-f4bc-4aed-9ce6-af629d5b7c8b",
                                "sense_id": "c544af74-976c-3ba3-affa-9fbc55aeafc5",
                                "text": "Ceci dit le Camerounais qui s'égarera à nouveau à bolloriser ce port nous trouvera sur son chemin."
                            },
                            {
                                "example_id": "e341f3fa-a20b-4027-a838-8b6a9a309f6e",
                                "sense_id": "c544af74-976c-3ba3-affa-9fbc55aeafc5",
                                "text": "Pascal Praud, l’animateur bollorisé de « L’Heure des pros », sur CNews, n’aime pas que l’on refuse de parler sur la chaîne de son patron."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8fd58ec-f113-3425-96b3-a5c7f45f2a09",
                        "entry_id": "df3b2e49-ba0e-3a70-a7cd-058cdc381a58",
                        "glosses": [
                            "Prendre le contrôle d’une entreprise en agissant à la manière de Vincent Bolloré."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2f2971bf-1571-4373-a822-ec2e9114f4ae",
                                "sense_id": "b8fd58ec-f113-3425-96b3-a5c7f45f2a09",
                                "text": "Serait-il pour autant légitime de laisser aujourd'hui Martin Bouygues « bolloriser » Orange ? L'Etat peut-il accepter qu’une ex-entreprise publique dont il est encore le premier actionnaire puisse ainsi risquer de changer de contrôle de façon quasi rampante."
                            }
                        ]
                    },
                    {
                        "sense_id": "53c38fb5-380a-363d-872a-dab167cb75bb",
                        "entry_id": "df3b2e49-ba0e-3a70-a7cd-058cdc381a58",
                        "glosses": [
                            "Prendre modèle sur Vincent Bolloré."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "5ff810d6-0d6a-4343-b82a-4b033f527426",
                                "sense_id": "53c38fb5-380a-363d-872a-dab167cb75bb",
                                "text": "Et si Bernard Arnault était en train de se bolloriser. Après tout, Vincent Bolloré fait bien tout ce qu’il veut avec ses médias, tout le monde le craint et personne ne l’empêche de mener à bien son entreprise de propagande idéologique."
                            }
                        ]
                    }
                ],
