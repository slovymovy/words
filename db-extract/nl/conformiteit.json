                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f94a1f6-2712-379a-bf70-307849d332ca",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "A point of resemblance; a similarity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bc8b66f-3f7b-3e05-b4c0-f14a5a19e707",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "The state of being conforming, of complying with a set of rules, with a norm or standard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a94040b5-8c91-3bd3-bfff-d4961efaf4ed",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "The ideology of adhering to one standard or social uniformity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256f9ee4-e216-4321-92a3-f98904c2ac63",
                                                "sense_id": "a94040b5-8c91-3bd3-bfff-d4961efaf4ed",
                                                "text": "How far should one accept the rules of the society in which one lives? To put it another way: at what point does conformity become corruption? Only by answering such questions does the conscience truly define itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed9dc33a-6973-4a84-b0e6-e38954aa9845",
                        "source_entry_id": "915a200d-613a-338d-8711-272e0667d285",
                        "source_sense_id": "48a0bdc6-652a-3409-afcd-360730b26147",
                        "target_lang_word": "conformité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conformité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d11263a9-ff59-3e67-af41-e8ff15a260cf",
                                        "entry_id": "d33fc3ba-cfe0-3559-a0c6-8ce544561a36",
                                        "glosses": [
                                            "Qualité de ce qui est conforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b231e4-6ba7-47aa-bc59-9e078dbfdf6b",
                                                "sense_id": "d11263a9-ff59-3e67-af41-e8ff15a260cf",
                                                "text": "Conformité d’arrêts, de traités."
                                            },
                                            {
                                                "example_id": "41e2b189-59b1-46ed-a185-91765d80c0e3",
                                                "sense_id": "d11263a9-ff59-3e67-af41-e8ff15a260cf",
                                                "text": "Il y a une conformité parfaite entre ces deux choses. — Conformité d’inclinations. — Conformité de sentiments. — Il y a entre nous conformité de goûts et de principes."
                                            },
                                            {
                                                "example_id": "3c54e084-19a8-4438-9419-f68c75c1eff1",
                                                "sense_id": "d11263a9-ff59-3e67-af41-e8ff15a260cf",
                                                "text": "[…] un rapport de compatibilité, tel qu’il est notamment pratiqué en matière d’urbanisme, tolère un écart avec la norme de référence, du moment qu’elle ne s’en trouve pas remise en cause, tandis qu’un rapport de conformité exige une adéquation parfaite […]."
                                            },
                                            {
                                                "example_id": "64094fec-9bb2-420f-8397-baa0add3715a",
                                                "sense_id": "d11263a9-ff59-3e67-af41-e8ff15a260cf",
                                                "text": "L’infirmier a, par ailleurs, l’obligation de vérifier la conformité de la prescription, que les doses prescrites correspondent bien aux normes habituelles."
                                            },
                                            {
                                                "example_id": "a031ee34-f0cb-4b10-af0b-adf415f3eaa2",
                                                "sense_id": "d11263a9-ff59-3e67-af41-e8ff15a260cf",
                                                "text": "Pour être digne de la confiance des victimes qui lui confieraient leur témoignage, la CIIVISE devait avoir en toutes circonstances une parole claire et agir en conformité avec cette parole. Une parole claire parce que l’ambiguïté, l’équivoque, l’incertitude si déstabilisantes sont des armes des agresseurs. Agir en conformité avec cette parole parce que la violence sexuelle est un acte de trahison. Il fallait tenir parole, c’est-à-dire être fidèle à la parole donnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bb3befc-7960-3352-bca4-51aa4e02627a",
                                        "entry_id": "d33fc3ba-cfe0-3559-a0c6-8ce544561a36",
                                        "glosses": [
                                            "Adhésion, soumission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeae4182-54f0-4a4b-a41b-c4c5488efe11",
                                                "sense_id": "1bb3befc-7960-3352-bca4-51aa4e02627a",
                                                "text": "La conformité aux usages établis."
                                            },
                                            {
                                                "example_id": "27dabe65-f780-4fce-b71c-6f89a0d75d98",
                                                "sense_id": "1bb3befc-7960-3352-bca4-51aa4e02627a",
                                                "text": "La conformité à la religion dominante."
                                            },
                                            {
                                                "example_id": "f2d27a55-4887-4446-b614-e302dea47fb2",
                                                "sense_id": "1bb3befc-7960-3352-bca4-51aa4e02627a",
                                                "text": "La conformité à la volonté de Dieu, la soumission de sa propre volonté à celle de Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
