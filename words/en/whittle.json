    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9eb61c50-54c3-3e66-92a8-69e5c9a9cf75",
                    "sense_definition": "To cut or shape wood by carving small pieces off with a knife.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man sat on the porch to <w>whittle</w> a small wooden bird.",
                            "target_lang_translations": {
                                "nl": "De oude man zat op de veranda een kleine houten vogel te <w>snijden</w>."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>whittling</w> a stick into a simple toy.",
                            "target_lang_translations": {
                                "nl": "Hij bracht de middag door met een stok tot een eenvoudig speelgoedje te <w>bewerken</w> met een mes."
                            }
                        }
                    ],
                    "synonyms": [
                        "carve",
                        "pare"
                    ],
                    "common_phrases": [
                        "whittle wood"
                    ],
                    "target_lang_definitions": {
                        "nl": "Hout snijden of vormen door er met een mes kleine stukjes af te halen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "snijden",
                                "target_lang_sense_clarification": "hout met een mes in vorm snijden"
                            },
                            {
                                "target_lang_word": "kerven",
                                "target_lang_sense_clarification": "kleine stukjes van hout wegsnijden"
                            },
                            {
                                "target_lang_word": "aanspitsen",
                                "target_lang_sense_clarification": "een stok of tak puntig snijden"
                            },
                            {
                                "target_lang_word": "houtsnijden",
                                "target_lang_sense_clarification": "specifiek: hout met een mes bewerken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa869153-197a-33bb-ad90-d239797c6aa1",
                    "sense_definition": "To gradually reduce or diminish something, such as a debt or a lead.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>whittle</w> down its massive debt over several years.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf slaagde erin zijn enorme schuld in de loop van enkele jaren <w>te verminderen</w>."
                            }
                        },
                        {
                            "text": "They hope to <w>whittle</w> away the competition's lead before the final game.",
                            "target_lang_translations": {
                                "nl": "Ze hopen de voorsprong van de tegenstander vóór de finale <w>te verkleinen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduce",
                        "diminish",
                        "erode"
                    ],
                    "antonyms": [
                        "increase",
                        "expand"
                    ],
                    "common_phrases": [
                        "whittle down",
                        "whittle away"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets geleidelijk verminderen of terugdringen, zoals een schuld of een voorsprong."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verminderen",
                                "target_lang_sense_clarification": "geleidelijk kleiner maken"
                            },
                            {
                                "target_lang_word": "verkleinen",
                                "target_lang_sense_clarification": "stap voor stap terugbrengen"
                            },
                            {
                                "target_lang_word": "terugdringen",
                                "target_lang_sense_clarification": "langzaam terugdringen"
                            },
                            {
                                "target_lang_word": "afknagen",
                                "target_lang_sense_clarification": "beetje bij beetje afnemen"
                            }
                        ]
                    }
                },
                {
