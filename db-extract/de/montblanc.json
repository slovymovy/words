                        "glosses": [
                            "Der höchste Berg der Alpen und Europas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b7f118-649c-468a-a46f-2988d9063109",
                                "sense_id": "ad6c6ab9-abe8-3559-be8e-e35e58842d56",
                                "text": "Der Montblanc ist mit 4807 Metern Höhe der höchste Berg Europas."
                            },
                            {
                                "example_id": "f1efacd4-8427-482d-8655-684833de03a8",
                                "sense_id": "ad6c6ab9-abe8-3559-be8e-e35e58842d56",
                                "text": "\"Wenn ein Montblanc Produkt erstmals von seinem Besitzer zur Hand genommen wird, hat es bereits viel zu erzählen. Von der sorgfältigen Auswahl seiner Materialien. Von den kunstfertigen Händen, die ihm Gestalt gaben. … Sinnbild dieser Besonderheit ist der weiße Stern von Montblanc. In Referenz an den Gipfel des höchsten Bergs Europas steht er für den hohen Anspruch der Marke, aber zugleich auch für eine außergewöhnliche Lebensart und Kultur.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
