                "senses": [
                    {
                        "sense_id": "8ea79654-b582-37d7-8377-a33582ec9d37",
                        "entry_id": "a68c4b2d-ba91-3310-93aa-dc04e7167e20",
                        "glosses": [
                            "persoon die vertrouwelijke informatie vergaart in een ander land in opdracht van zijn/haar regering"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4cf307a2-454d-3d3f-aec5-fa8f43683fd2",
                        "entry_id": "a68c4b2d-ba91-3310-93aa-dc04e7167e20",
                        "glosses": [
                            "iets dat vertrouwelijke informatie vergaart in opdracht van overheden en bedrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722dfac9-1fc5-4b12-b7bb-ae2a6f6ee127",
                                "sense_id": "4cf307a2-454d-3d3f-aec5-fa8f43683fd2",
                                "text": "Je smartphone en computer zijn al oneindig veel betere persoonlijke spionnen dan waarvan de Stasi ooit had durven dromen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b605adf-354e-44b4-8a22-bdd2752dc33e",
                        "source_entry_id": "a68c4b2d-ba91-3310-93aa-dc04e7167e20",
                        "target_lang_word": "Spion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac31dfd-d81c-38f7-9e7e-2f38272989dd",
                                        "entry_id": "2146ad61-433e-37da-a3da-e1fb0e847b44",
                                        "glosses": [
                                            "ein heimlicher, unerkannter Beobachter, der die gegnerische Seite auszukunden hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e7fa563-61aa-479a-97ec-459bcd9786e5",
                                                "sense_id": "0ac31dfd-d81c-38f7-9e7e-2f38272989dd",
                                                "text": "„Kapitan Klos sollte dem Publikum die intellektuelle Überlegenheit eines polnischen Spions über die deutsche SS oder die Gestapo zeigen, was bei Zuschauern unter zwölf auch gelang.“"
                                            },
                                            {
                                                "example_id": "6d01bb4d-f724-40ae-93cb-ee1c1d1b7ed3",
                                                "sense_id": "0ac31dfd-d81c-38f7-9e7e-2f38272989dd",
                                                "text": "„Außerdem war Schefold kein Spion, sondern bloß ein vor diesem Monster geflüchteter Deutscher, der auf die verrückteste Weise seine Heimkehr vorwegnahm.“"
                                            },
                                            {
                                                "example_id": "1c60e86d-bd90-42ec-92f5-1d99dc3a4daf",
                                                "sense_id": "0ac31dfd-d81c-38f7-9e7e-2f38272989dd",
                                                "text": "„Im engeren Umkreis des Gouverneurs wimmelte es überdies von Spionen, die überall herumschnüffelten.“"
                                            },
                                            {
                                                "example_id": "1c9b66db-05f9-4e33-aa5f-b6f8e153cfb3",
                                                "sense_id": "0ac31dfd-d81c-38f7-9e7e-2f38272989dd",
                                                "text": "„Hier wurden zwischen den USA und der Sowjetunion Spione ausgetauscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "407317a7-9088-3d0e-a16c-48847f9569bc",
                                        "entry_id": "2146ad61-433e-37da-a3da-e1fb0e847b44",
                                        "glosses": [
                                            "ein in der Zugangstür zu einer Wohnung oder zu einem Haus angebrachtes Weitwinkelobjektiv, durch das man Eintritt suchende Personen sehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957ae79e-d225-4689-a5d3-b1f134ada300",
                                                "sense_id": "407317a7-9088-3d0e-a16c-48847f9569bc",
                                                "text": "„Vor meiner Zelle defilieren in großer Prozession die Polizeifunktionäre, jeden Augenblick wird die Klappe am Spion geöffnet, ein Auge glotzt.“"
                                            },
                                            {
                                                "example_id": "0da83b15-974e-46fa-bc8b-fd2c47fc0c24",
                                                "sense_id": "407317a7-9088-3d0e-a16c-48847f9569bc",
                                                "text": "„Dann schaut er durch den Spion: Der Gefangene liegt auf dem Bett und pennt.“"
                                            },
                                            {
                                                "example_id": "c84bf2b6-238f-4c07-9e89-77ee8e8df0f2",
                                                "sense_id": "407317a7-9088-3d0e-a16c-48847f9569bc",
                                                "text": "„Durch den Spion sehe ich ein feistes grinsendes Gesicht und die Mützenaufschrift: Reparaturen aller Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e80f5ef8-58e7-492e-8b08-31a1c1d05869",
                        "source_entry_id": "a68c4b2d-ba91-3310-93aa-dc04e7167e20",
                        "target_lang_word": "spy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab6cc882-784c-368d-96d9-802b49b6f213",
                                        "entry_id": "022f9240-092a-3809-b829-3585dab714de",
                                        "glosses": [
                                            "A person who secretly watches and examines the actions of other individuals or organizations and gathers information on them (usually to gain an advantage)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c952354e-5c71-4768-8e82-06b484facae2",
                                                "sense_id": "ab6cc882-784c-368d-96d9-802b49b6f213",
                                                "text": "The dead leap at the throat, destroy\nThe meaning of the day; dark forms\nHave scaled your walls, and spies betray\nOld secrets to amorphous swarms."
                                            },
                                            {
                                                "example_id": "50358222-4df6-4a9b-a688-c9c34a7f602b",
                                                "sense_id": "ab6cc882-784c-368d-96d9-802b49b6f213",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a19e36-58e0-3050-866b-e7e307c46e34",
                                        "entry_id": "022f9240-092a-3809-b829-3585dab714de",
                                        "glosses": [
                                            "A defensive player assigned to cover an offensive backfield player man-to-man when they are expected to engage in a running play, but the offensive player does not run with the ball immediately."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1088949-73e6-3785-8ba0-a20665c1f39b",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To act as a spy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f520a8-ad37-4b61-8425-48b54ca5ce12",
                                                "sense_id": "f1088949-73e6-3785-8ba0-a20665c1f39b",
                                                "text": "During the Cold War, Russia and America would each spy on each other for recon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To spot; to catch sight of; to espy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2ae498-575f-4e55-a59f-0ea219417c27",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "I think I can spy that hot guy coming over here."
                                            },
                                            {
                                                "example_id": "e52751f6-fd72-4779-af16-b1fc9e18adc9",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "VVherefore lift up your heads, brethren, and look about vvith your eyes, ſpy vvhat things are to be reformed in the Church of England."
                                            },
                                            {
                                                "example_id": "1f830553-2e5f-4d98-b97a-b7136fdb51d2",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "One in reading, skipped over all sentences where he spied a note of admiration."
                                            },
                                            {
                                                "example_id": "de63d104-f294-4727-a591-a33459de5afd",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "Child, I see thee! Child, I spy thee!"
                                            },
                                            {
                                                "example_id": "b3dffa55-6bc7-4b4a-ae24-b50011f6bafd",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "The next person they spied was a Bandicoot carrying a watermelon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067108a1-801f-3926-be3a-91d7b9e68866",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To search narrowly; to scrutinize."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57284125-cdab-4027-b177-8cd486b40dde",
                                                "sense_id": "067108a1-801f-3926-be3a-91d7b9e68866",
                                                "text": "(As I confeſſe it is my Natures plague / To ſpy into Abuſes, and of my iealouſie / Shapes faults that are not)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c411a7ae-d0b2-3b1b-bf03-993de0c2cb0c",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To explore; to see; to view; inspect and examine secretly, as a country."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffe4e4b7-6f5a-49e0-8a76-c0654031fe58",
                        "source_entry_id": "a68c4b2d-ba91-3310-93aa-dc04e7167e20",
                        "target_lang_word": "espion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc92aaab-8f92-3531-8877-41e6990b32cc",
                                        "entry_id": "445775bb-03cb-37b1-b3c1-248bb0cdaa3c",
                                        "glosses": [
                                            "Celui qui est chargé par un pays de recueillir clandestinement, dans un autre pays, des informations gardées secrètes ; celui qui espionne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb7ed12-6962-4379-a90a-923da6d47801",
                                                "sense_id": "dc92aaab-8f92-3531-8877-41e6990b32cc",
                                                "text": "Il jouait bien involontairement un rôle sinistre et mystérieux – le rôle d’espion international. Il surprenait des secrets ; il menaçait, en fait, les projets d’une puissance non moindre que l’Empire Germanique ; il se jetait étourdiment dans le foyer ardent de la WeltPolitik."
                                            },
                                            {
                                                "example_id": "f5297503-2a97-4a6e-8769-c48495836c31",
                                                "sense_id": "dc92aaab-8f92-3531-8877-41e6990b32cc",
                                                "text": "Les espions sont devenus des agents de renseignement habilités, ultraqualifiés, surcontrôlés. […]. Mister Q, le bidouilleur de Bond, est devenu expert en numérique. Il traque les logiciels espions, fait parler les données et la reconnaissance faciale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0855ee-96c1-37ac-9f66-7052ee44d057",
                                        "entry_id": "445775bb-03cb-37b1-b3c1-248bb0cdaa3c",
                                        "glosses": [
                                            "Catégorie de personnes ne bénéficiant pas du statut de combattant si elles ne font pas partie des forces armées et qui, si elles sont reconnues comme telle, perdent certains droits inscrit dans les conventions de Genève."
                                        ],
                                        "tags": [
                                            "Droit des conflits armés"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23fc6628-816d-32ca-814c-8ff8dddcc295",
                                        "entry_id": "445775bb-03cb-37b1-b3c1-248bb0cdaa3c",
                                        "glosses": [
                                            "Celui qui observe secrètement les activités d’autrui pour les rapporter à un tiers."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082bae00-2c26-4386-81a6-715bd25702b0",
                                                "sense_id": "23fc6628-816d-32ca-814c-8ff8dddcc295",
                                                "text": "Dès minuit, le père Canquoëlle pouvait ourdir toutes les trames, recevoir des espions et des ministres, des femmes et des filles, sans que qui que ce soit au monde s’en aperçût."
                                            },
                                            {
                                                "example_id": "f68c1685-02ea-4235-818e-6890a2fdb696",
                                                "sense_id": "23fc6628-816d-32ca-814c-8ff8dddcc295",
                                                "text": "Ce maquignon se trouve partout où il y a un mauvais cheval à vendre ; il opère de haut et de loin, file un cheval comme un agent filerait un malfaiteur ; il a ses dépêches, son contrôle, ses espions, […]."
                                            },
                                            {
                                                "example_id": "93e416d4-3dc4-460f-8f4e-186137059a3c",
                                                "sense_id": "23fc6628-816d-32ca-814c-8ff8dddcc295",
                                                "text": "[…] les deux capitaines avaient des égards pour moi. Peut-être me prenaient-ils pour un espion du commandant, ou, mieux encore, pour un envoyé secret du parti radical ; car ce bruit courut."
                                            },
                                            {
                                                "example_id": "67ad31ba-9016-45d2-8248-7bb85dffdc91",
                                                "sense_id": "23fc6628-816d-32ca-814c-8ff8dddcc295",
                                                "text": "Il mit également à ma disposition une escorte de deux mokhaznis, c’est-à-dire, en réalité, de deux espions chargés de le renseigner sur mes faits et gestes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c89c8ee-d508-3206-8ae5-5da2451787b3",
                                        "entry_id": "445775bb-03cb-37b1-b3c1-248bb0cdaa3c",
                                        "glosses": [
                                            "Miroir permettant d’observer sans être vu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a023c39-9221-41fd-8f1b-4249b5c1513c",
                                                "sense_id": "4c89c8ee-d508-3206-8ae5-5da2451787b3",
                                                "text": "On nomme cela un espion, et le mot est très-juste ; car ce morceau de glace, que l’œil du piéton sans méfiance aperçoit à peine, est d’une perfidie, ou plutôt d’une fidélité affreuse, pour rapporter ses moindres gestes."
                                            },
                                            {
                                                "example_id": "97d0f701-2285-4c22-b7a2-aa14a0992c2c",
                                                "sense_id": "4c89c8ee-d508-3206-8ae5-5da2451787b3",
                                                "text": "sur les balcons de serrurerie très-ouvragée, qui rappellent les miradores espagnols, nous avons remarqué des carreaux de damas rouge disposés en sofa, comme si les Bernoises passaient leur vie aux fenêtres, à la façon des Andalouses et des Maltaises. Ce détail tout méridional nous a surpris et nous semble contraire aux habitudes protestantes, qui se contentent du reflet de la rue dans ce miroir appelé espion."
                                            },
                                            {
                                                "example_id": "1002b387-c1f8-440f-b507-d9361b330673",
                                                "sense_id": "4c89c8ee-d508-3206-8ae5-5da2451787b3",
                                                "text": "En me retirant de la fenêtre, j’aperçus ma figure dans l’espion. Ma bouche était contractée, mes yeux en pleurs : je venais de revivre une des scènes douloureuses de notre misérable enfance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d9ec188-1caa-47f6-b5d8-cde74bead22c",
                        "source_entry_id": "a68c4b2d-ba91-3310-93aa-dc04e7167e20",
                        "target_lang_word": "шпион",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шпион",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88bf4729-d957-3402-9e6a-6063004a1d35",
                                        "entry_id": "667d3fc1-fc88-3553-bbb1-4b392e14972f",
                                        "glosses": [
                                            "тот, кто занимается шпионажем; тайный агент иностранного государства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265fdbd5-d480-4521-8278-a0ed86f4be50",
                                                "sense_id": "88bf4729-d957-3402-9e6a-6063004a1d35",
                                                "text": "Казаки разыскивали японского шпиона, одетого русским военным врачом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b084fa4-b6c0-386b-bd28-cf1431b8f467",
                                        "entry_id": "667d3fc1-fc88-3553-bbb1-4b392e14972f",
                                        "glosses": [
                                            "устар. полицейский агент по сыску, слежке за кем-либо; шпик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbd2ab6-90fd-4792-ae74-b5647b53d187",
