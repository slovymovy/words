                "senses": [
                    {
                        "sense_id": "f3fe713c-7dfa-334b-9489-98a728d1712b",
                        "entry_id": "6245db0a-1a75-33c3-a2ff-813b9e2fa7ed",
                        "glosses": [
                            "Produire un cyclone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bea720c-70be-43a8-b604-338a89c5c4a1",
                                "sense_id": "f3fe713c-7dfa-334b-9489-98a728d1712b",
                                "text": "La nature s’est couchée, allongée. De temps en temps, elle rugit, se met à cycloner, à tempêter, à secouer, à déborder."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dd777da-4e24-34be-98b5-026310faed64",
                        "entry_id": "6245db0a-1a75-33c3-a2ff-813b9e2fa7ed",
                        "glosses": [
                            "Couper un bananier à une certaine hauteur après un cyclone pour qu’il puisse continuer à pousser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e043edf-e0c1-461b-b875-6c329d62adb2",
                                "sense_id": "4dd777da-4e24-34be-98b5-026310faed64",
                                "text": "Une défense face aux ouragans : cycloner les bananiers."
                            }
                        ]
                    }
