                    {
                        "translation_id": "4cb3e832-7d7b-463a-aca4-d8aa977259ff",
                        "source_entry_id": "e0f2dd44-3fe4-3e28-9ec0-2bc7854a0364",
                        "source_sense_id": "00872a3e-af6b-3f1b-a5b6-b9fc212d9792",
                        "target_lang_word": "voilure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voilure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "510f1bc3-a2df-347d-969c-85213bc221c6",
                                        "entry_id": "b3f07915-13fb-3b9c-8346-69bd2b3c2768",
                                        "glosses": [
                                            "Ensemble des voiles d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d9b334-c7d4-48ed-8496-3dd15782a906",
                                                "sense_id": "510f1bc3-a2df-347d-969c-85213bc221c6",
                                                "text": "Pour lui, il n’y avait plus qu’un moyen de salut, le radeau; mais fallait-il s’y embarquer dès maintenant, y établir une voilure quelconque au moyen de draps et de couvertures, et chercher à gagner la côte la plus prochaine ?"
                                            },
                                            {
                                                "example_id": "36327bb9-cd20-489d-b08d-14f24f6acbaf",
                                                "sense_id": "510f1bc3-a2df-347d-969c-85213bc221c6",
                                                "text": "En 1937, 250 thoniers animaient le port dans un fourmillement d'activités hautes en couleurs. C'était de grands dundees à deux mâts qui portaient une superbe voilure allant du rose au brun."
                                            },
                                            {
                                                "example_id": "7c11e430-6a9c-4ccb-9d2b-47214305f068",
                                                "sense_id": "510f1bc3-a2df-347d-969c-85213bc221c6",
                                                "text": "La restauration sera terminée quelques semaines plus tard quand la voilure et les mâts seront replacés sur le Bluenose II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea4fe3fc-f2bc-33b4-8019-7dd16404da18",
                                        "entry_id": "b3f07915-13fb-3b9c-8346-69bd2b3c2768",
                                        "glosses": [
                                            "Quantité de voiles que porte un navire à un moment donné, par rapport au vent qu’il a et à la route qu’il veut faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efe7ff62-88db-4238-8ab1-f9bd89c9e5b6",
                                                "sense_id": "ea4fe3fc-f2bc-33b4-8019-7dd16404da18",
                                                "text": "Le 24, le vent tourna au Sud nous permettant d’établir la voilure, et, le lendemain la plupart de mes compagnons franchissaient pour la première fois le cercle polaire."
                                            },
                                            {
                                                "example_id": "fcfc001b-866e-4da5-8ea9-b8d477da989b",
                                                "sense_id": "ea4fe3fc-f2bc-33b4-8019-7dd16404da18",
                                                "text": "Vers 13 heures, je hisse la trinquette et le tourmentin et, comme le vent augmente, j’amène la grand’voile et laisse le Firecrest se gouverner seul sous voilure avant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7704d8c4-53b2-3b1a-b3bb-00c222c6cd04",
                                        "entry_id": "b3f07915-13fb-3b9c-8346-69bd2b3c2768",
                                        "glosses": [
                                            "Surface portante d’un aéronef."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3600c46a-e41a-4d11-b852-1bd66a6bb4be",
                                                "sense_id": "7704d8c4-53b2-3b1a-b3bb-00c222c6cd04",
                                                "text": "La voilure d’un hélicoptère est constituée par son rotor principal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
