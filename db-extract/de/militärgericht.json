                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ba5078-e77c-49dd-bd7f-a41a13411a1e",
                                "sense_id": "8ac0ad2a-21b3-3b11-ba9f-23a71f82274c",
                                "text": "„Ein britisches Militärgericht in Venedig verurteilt den ehemaligen deutschen Feldmarschall Albert Kesselring wegen Geiselerschießungen zum Tode.“"
                            },
                            {
                                "example_id": "c5779e44-aa5d-4138-88e4-ab86a365c5df",
                                "sense_id": "8ac0ad2a-21b3-3b11-ba9f-23a71f82274c",
                                "text": "„Die Militärgerichte waren zu langsam.“"
                            },
                            {
                                "example_id": "a1b9d638-cbe2-4f4a-876a-1a2945a498fa",
                                "sense_id": "8ac0ad2a-21b3-3b11-ba9f-23a71f82274c",
                                "text": "„Er wurde in Moskau vor ein Militärgericht gestellt.“"
                            }
                        ],
