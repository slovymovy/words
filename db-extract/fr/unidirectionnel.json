                        ],
                        "form": "unidirectionnelle"
                    },
                    {
                        "form_id": "0879f89d-122f-4bf5-96c4-947718a0efc8",
                        "entry_id": "89889e9f-aa1b-318e-b466-b0b849fe6b89",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "unidirectionnelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                        "entry_id": "89889e9f-aa1b-318e-b466-b0b849fe6b89",
                        "glosses": [
                            "Qui n’exerce une action que dans un sens, dans une direction."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "34d3b2cf-b638-4224-b3c0-4d2b4a12bee7",
                                "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                "text": "Les orages multicellulaires sont ainsi associés à un cisaillement de vent unidirectionnel (la force du vent varie avec l'altitude, mais pas sa direction) alors que les supercellules ne peuvent se développer qu'en présence d'un cisaillement tournant (le vent varie à la fois en direction et en intensité avec l'altitude)."
                            },
                            {
                                "example_id": "d985ea49-7da7-4695-815b-5b7d7c031d7d",
                                "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l'axone."
                            },
                            {
                                "example_id": "87396a3c-0362-41ef-95a4-32326e4d9ded",
                                "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                "text": "Cette forme de communication unidirectionnelle et peu encline à la discussion et au débat n’est pas commune au sein du gouvernement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5efd927-1b72-4cad-9201-c6a17c090cd4",
                        "source_entry_id": "89889e9f-aa1b-318e-b466-b0b849fe6b89",
                        "source_sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                        "target_lang_word": "unidirectional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unidirectional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4515b1e-3558-3a0a-aba6-9c09a741093f",
                                        "entry_id": "7edb4834-ef4d-3376-9046-270453ab97ac",
                                        "glosses": [
                                            "Pertaining to only one direction, e.g.: where all component parts are aligned in the same direction in space."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e41b070d-1d6b-4dd7-9024-f915bad4cb7e",
                                                "sense_id": "d4515b1e-3558-3a0a-aba6-9c09a741093f",
                                                "text": "[...] a reversible booster was fitted to the trailing bogie; all previous applications on the L.N.E.R. for use in main line traffic had been of unidirectional boosters, […]"
                                            },
                                            {
                                                "example_id": "090e8cf5-d29c-4ffc-a849-b369dd6e6dd0",
                                                "sense_id": "d4515b1e-3558-3a0a-aba6-9c09a741093f",
                                                "text": "Equally important is the class mailing list, which facilitates two-way communication at a distance. (By contrast, the web page is basically a unidirectional teacher-to-student communication.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c61dd6e-54d3-3e0c-b15e-588426543d58",
                                        "entry_id": "7edb4834-ef4d-3376-9046-270453ab97ac",
                                        "glosses": [
                                            "Not subject to change or reversal of direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "unidirectional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0578e5-3cb3-3110-bab0-18a77b059cf0",
                                        "entry_id": "13fa1c3c-766e-3a9e-a887-6ddf7b86a355",
                                        "glosses": [
                                            "A fabric in which the majority of fibers run in the same single direction."
