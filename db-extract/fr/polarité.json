                        "sense_id": "08c14a67-8a5e-3471-9c6a-ede5ad77ce03",
                        "entry_id": "e6180020-34a9-357e-ad25-e5c926da30ec",
                        "glosses": [
                            "État d’avoir plusieurs pôles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7205693e-a48f-3556-bbc6-372ac00c3c03",
                        "entry_id": "e6180020-34a9-357e-ad25-e5c926da30ec",
                        "glosses": [
                            "Propriété qu’a l’aimant de se diriger en chaque lieu vers un certain point fixe de l’horizon."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "8a46581d-d3c7-4d14-a4cc-fde8edbd6754",
                                "sense_id": "7205693e-a48f-3556-bbc6-372ac00c3c03",
                                "text": "La polarité de l’aimant"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8134efa-72b3-31b9-a7b4-ef42250a6650",
                        "entry_id": "e6180020-34a9-357e-ad25-e5c926da30ec",
                        "glosses": [
                            "Propriété de non-équivalence du branchement électrique d’un composant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d416f7a-c969-4528-8622-b862aaa4e74f",
                                "sense_id": "f8134efa-72b3-31b9-a7b4-ef42250a6650",
                                "text": "Une ampoule à incandescence n’a pas de polarité, mais la polarité des diodes électroluminescentes doit être respectée, sous peine de destruction."
                            },
                            {
                                "example_id": "6c591849-5cb7-485a-85d3-26d42a55e9f1",
                                "sense_id": "f8134efa-72b3-31b9-a7b4-ef42250a6650",
                                "text": "L’inversion de la polarité d’un condensateur électrolytique peut provoquer sa destruction, voire son explosion."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b505006-bc57-3f58-b01b-9a458ee1ac20",
                        "entry_id": "e6180020-34a9-357e-ad25-e5c926da30ec",
                        "glosses": [
                            "Distinction entre des propositions affirmative et négative."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd81ccdc-0a0d-4673-aa4c-ee926eda3c1e",
