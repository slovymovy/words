                "senses": [
                    {
                        "sense_id": "db2072d1-5d0e-3045-b0bb-084842d5c1a8",
                        "entry_id": "344ef1aa-38c9-390c-9c2e-1ef8213d2551",
                        "glosses": [
                            "Bremse, die auf die Vorderräder eines Fahrzeugs einwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1861015-6fb5-4946-803f-cdd55a96b273",
                                "sense_id": "db2072d1-5d0e-3045-b0bb-084842d5c1a8",
                                "text": "„Ein wenig Übung und man verzögert auf Schotter mit der Vorderradbremse, als wäre es das Normalste auf der Welt.“"
                            },
                            {
                                "example_id": "f068b2a4-f390-49b3-88cd-9fae82dd3c12",
                                "sense_id": "db2072d1-5d0e-3045-b0bb-084842d5c1a8",
                                "text": "„Das System wird aktiviert, sobald man die Vorderradbremse leicht betätigt.“"
                            },
                            {
                                "example_id": "567cab20-dfb7-44d4-bc17-29726827991b",
                                "sense_id": "db2072d1-5d0e-3045-b0bb-084842d5c1a8",
                                "text": "„Zudem lässt sich dank dieser Regelung die Vorderradbremse aktiv und effizient einsetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
