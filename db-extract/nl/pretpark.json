                            {
                                "example_id": "f30add61-d0c8-43ed-a2d8-e477576b7f0e",
                                "sense_id": "0ff5b9d9-142b-3c38-b5f1-7a324243ca4d",
                                "text": "Voor zijn verjaardag gingen we naar het pretpark.",
                                "translation": "For his birthday, we went to the amusement park.",
                                "english": "For his birthday, we went to the amusement park."
                            },
                            {
                                "example_id": "4c688dce-2117-4b66-be46-63ce7ea0f37d",
                                "sense_id": "0ff5b9d9-142b-3c38-b5f1-7a324243ca4d",
                                "text": "Het pretpark was gesloten vanwege slecht weer.",
                                "translation": "The amusement park was closed due to bad weather.",
                                "english": "The amusement park was closed due to bad weather."
                            },
                            {
                                "example_id": "3a5b7db6-88a8-40b2-8ece-95a67f8ba958",
                                "sense_id": "0ff5b9d9-142b-3c38-b5f1-7a324243ca4d",
                                "text": "Ze waren opgewonden om de achtbaan in het pretpark te proberen.",
                                "translation": "They were excited to try the roller coaster in the amusement park.",
                                "english": "They were excited to try the roller coaster in the amusement park."
                            }
                        ]
                    }
