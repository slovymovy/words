                                                "example_id": "3ee235ad-f41a-4454-ac0d-4977308fdfff",
                                                "sense_id": "12a82f21-7cb8-35a3-b52b-f158fa264d2e",
                                                "text": "Behind the Master walks, builds up the Shocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ad1dbbe-d76c-3d34-b348-6c9bdd729969",
                                        "entry_id": "e97288cc-48e9-3b5f-b8ad-835524f85622",
                                        "glosses": [
                                            "A lot consisting of sixty pieces; a term applied in some Baltic ports to loose goods."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                        "entry_id": "e97288cc-48e9-3b5f-b8ad-835524f85622",
                                        "glosses": [
                                            "A tuft or bunch of something, such as hair or grass."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c3cda2-20b9-475a-bd12-216e7b21b83b",
                                                "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                                "text": "His head boasted a shock of sandy hair."
                                            },
                                            {
                                                "example_id": "043a1332-0063-4ee4-b6f1-419b0c8c82bf",
                                                "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                                "text": "Every now and then I’m startled at how good-looking John is, but he glared at me from under the shock of hair that fell across his brow and scared me a little."
                                            },
                                            {
                                                "example_id": "dda69445-5c57-41da-aed2-0dc7337526b8",
                                                "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                                "text": "On day three I pointed at the edge of an intricate pentagram peeking above her shock of oily black hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4e62170-3b72-3cfa-adf6-b7b22988fcd3",
                                        "entry_id": "e97288cc-48e9-3b5f-b8ad-835524f85622",
                                        "glosses": [
                                            "A small dog with long shaggy hair, especially a poodle or spitz; a shaggy lapdog."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae50ffaf-04dd-43af-94ac-1da0600e435e",
                                                "sense_id": "b4e62170-3b72-3cfa-adf6-b7b22988fcd3",
                                                "text": "When I read of witty persons, I could not figure them but like the little shock. (translating the German Spitz)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0ef1be-68df-3f89-a16c-f8df89b59cb5",
                                        "entry_id": "eafae4cb-f42a-3aba-adb9-e1186647232d",
                                        "glosses": [
                                            "To collect, or make up, into a shock or shocks; to stook."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f2b533e-006d-49b3-b8c2-1d068a080797",
                                                "sense_id": "bc0ef1be-68df-3f89-a16c-f8df89b59cb5",
