                "senses": [
                    {
                        "sense_id": "d7e6c99c-0f57-3f95-9a99-0398a878bf1f",
                        "entry_id": "f7cf8e94-ba61-39bb-af96-c59ee7b9a9f5",
                        "glosses": [
                            "Ort, an dem etwas gesammelt wird oder an dem sich Personen sammeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fa48b4d-2cd0-41c5-9233-b2ed7b84891f",
                                "sense_id": "d7e6c99c-0f57-3f95-9a99-0398a878bf1f",
                                "text": "„Wenn viele Beobachter die Zeit stoppen, in welcher der Stern bedeckt ist, und diese Zeiten mit ihrer geografischen Position (zum Beispiel einfach in Google Maps ablesen) zur zentralen Sammelstelle schicken, dann können die Fachastronomen aus der Verteilung der Messwerte nicht nur die Größe des Asteroiden bestimmen, sondern sogar auf dessen Form schließen.“"
                            },
                            {
                                "example_id": "77381148-af63-40a6-8a76-6068180a5cda",
                                "sense_id": "d7e6c99c-0f57-3f95-9a99-0398a878bf1f",
                                "text": "„In der ersten Zeit war Theresienstadt die Sammelstelle für böhmische Juden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
