                        "entry_id": "2158da5f-032f-3204-b156-f4ac5a5a4387",
                        "glosses": [
                            "een tekening die met naald en inkt blijvend in de huid is aangebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "455c8290-ac8a-42ab-a3f9-ce4a945c54a2",
                                "sense_id": "e109ac0a-2a88-3ffd-8c9a-8a38288d4f6d",
                                "text": "Ze heeft een tattootje van een roos op haar schouder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4139211c-f532-4cf6-9e6b-483ef84a784d",
                        "source_entry_id": "2158da5f-032f-3204-b156-f4ac5a5a4387",
                        "source_sense_id": "e109ac0a-2a88-3ffd-8c9a-8a38288d4f6d",
                        "source_sense_description": "een tekening die met naald en inkt blijvend in de huid is aangebracht",
                        "target_lang_word": "Tätowierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tätowierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                        "entry_id": "bdd463d2-b13f-3f7d-b3a8-5d6191797c95",
                                        "glosses": [
                                            "mit Farbmitteln in die Haut eingestochenes Motiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39658d7e-707a-475c-9a80-b90a104bdea4",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "Weil sie noch minderjährig ist und ihre Mutter ihr keine Erlaubnis erteilt, darf Petra sich keine Tätowierung stechen lassen."
                                            },
                                            {
                                                "example_id": "1c90e44e-b20a-4eb9-82ac-3707af10590d",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "Nach einigen Jahren gefiel Ursula ihre Tätowierung nicht mehr und wollte sie wieder entfernen lassen."
                                            },
                                            {
                                                "example_id": "79aba160-ff34-4b48-a8ad-7efc66967db5",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "Claus ist stolz auf die vielen Tätowierungen, die seinen Körper zieren."
                                            },
                                            {
                                                "example_id": "5128e768-2056-4526-a077-9501d3e4de1e",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Sie waren nur an den Armen und Oberschenkeln tätowiert, während die Männer am ganzen Körper Tätowierungen trugen.“"
                                            },
                                            {
                                                "example_id": "61f0c17f-0c9f-4f0e-bc04-b9fffcee32a3",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Ich flaniere zwischen schlaffen Penissen auf behaarten Schenkeln, Brüsten, die sich der Sonne präsentieren, von Tätowierungen umkränzten Pobacken und strassgepiercten Bauchnabeln.“"
                                            },
                                            {
                                                "example_id": "da698139-19fd-4189-928f-ea5eb76a3962",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Mir fällt die Tätowierung aus aneinandergereihten Kreuzen, die wie ein Vollbart ihr hübsches Gesicht umrandet, auf.“"
                                            },
                                            {
                                                "example_id": "ac05e9fb-920b-4b11-88b6-d95b63afc576",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Grenfeld brauchte weder auf die Tätowierungen noch auf die bösartig grinsenden Kerle zu sehen, um zu begreifen, dass er einen Fehler begangen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf7c04f6-cc53-4857-89d7-108adb37d77c",
                        "source_entry_id": "2158da5f-032f-3204-b156-f4ac5a5a4387",
                        "source_sense_id": "e109ac0a-2a88-3ffd-8c9a-8a38288d4f6d",
                        "source_sense_description": "een tekening die met naald en inkt blijvend in de huid is aangebracht",
                        "target_lang_word": "tattoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tattoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c537e5-3923-30e1-83b9-66d510469558",
                                        "entry_id": "53faf039-7086-37a3-97f7-9c726e960f0f",
                                        "glosses": [
                                            "An image made on a body part, usually the skin with ink and a needle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98aee88-fb94-45c2-ac26-e1d7d8f82add",
                                                "sense_id": "b7c537e5-3923-30e1-83b9-66d510469558",
                                                "text": "His shirt sleeves were turned up, so upon his brawny arms his tattooes were visible."
                                            },
                                            {
                                                "example_id": "a4d1e651-dc67-4ced-978a-b268b358cb92",
                                                "sense_id": "b7c537e5-3923-30e1-83b9-66d510469558",
                                                "text": "Nothing pleases a Burman more than to be asked to show his tattooes. He is as delighted as a collector of curios in England. They consist of a series of pictures of tigers, lions, elephants, dragons, demons, and what-not, surrounded by mottoes invoking good fortune, and round waist and knees the whole is framed by a neat floral or scroll pattern."
                                            },
                                            {
                                                "example_id": "4f68e04d-c1f1-4b87-b495-c57cce26ac87",
                                                "sense_id": "b7c537e5-3923-30e1-83b9-66d510469558",
                                                "text": "Almost a century and a half after the De Soto Expedition, Joutel (Cox, 1905, II: 139–140), one of La Salle’s men, reacted to the Caddoes in much the same way as had De la Vega, finding their tattooes particularly repulsive. The Caddoes used needles or other sharp-pointed objects to prick the skin until the blood flowed, and then rubbed powdered charcoal into the wounds. When the wounds healed, the charcoal remaining under the skin made striking tattooes."
                                            },
                                            {
                                                "example_id": "a0318893-790b-4576-bbe2-63e13e9f48f8",
                                                "sense_id": "b7c537e5-3923-30e1-83b9-66d510469558",
                                                "text": "Victor was spot on, of course; in fact, I have often been tempted to seek him out when I have been plagued by diseases of the heart. He'd be able to tell me in ten seconds whether someone was worth a tattoo or not."
                                            },
                                            {
                                                "example_id": "2ffd6a26-2069-4de6-8115-abae0e55b0e0",
                                                "sense_id": "b7c537e5-3923-30e1-83b9-66d510469558",
                                                "text": "And here's a solution to an age old tattoo problem. If your girlfriend's name, say, \"Suzie,\" is tattooed on your arm, and you break up with her, don't have the tattoo removed. Just have the tattoo reworked so it says, \"Fuck Suzie.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01debbf-cc32-3b08-8b15-d6b6133c57c2",
                                        "entry_id": "53faf039-7086-37a3-97f7-9c726e960f0f",
                                        "glosses": [
                                            "A method of decorating a body part, usually the skin, by inserting colored substances under the surface with a sharp instrument (usually a solenoid-driven needle)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tattoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "902249fc-2d1f-3cbb-9a44-da69a57f5175",
                                        "entry_id": "a86feb86-65a9-355d-9050-3132e011611d",
                                        "glosses": [
                                            "To apply a tattoo to (someone or something)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed8c7556-51e5-3c54-9982-bbac9193caa4",
                                        "entry_id": "a86feb86-65a9-355d-9050-3132e011611d",
                                        "glosses": [
                                            "To hit the ball hard, as if to figuratively leave a tattoo on the ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda0c554-c514-4aea-a4fe-ed81c99152f1",
                                                "sense_id": "ed8c7556-51e5-3c54-9982-bbac9193caa4",
                                                "text": "Jones tattoos one into the gap in left; that will clear the bases."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tattoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17b1540f-a7de-322e-b09e-a032f5561c1a",
                                        "entry_id": "c59d09c9-5a57-37bf-90f4-70ff421d61c2",
                                        "glosses": [
                                            "A signal played five minutes before taps (lights out)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed23745-7565-4e9f-b02c-68ba79861011",
                                                "sense_id": "17b1540f-a7de-322e-b09e-a032f5561c1a",
                                                "text": "Study goes on until tattoo, which, when Pops was at the Point, was sounded at 9.30, followed by taps at 10."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71a27ff-986b-3083-b194-e31c6ca055e9",
                                        "entry_id": "c59d09c9-5a57-37bf-90f4-70ff421d61c2",
                                        "glosses": [
                                            "A signal by drum or bugle ordering soldiers to return to their quarters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea8d997e-4636-3106-b717-15250e31ab0f",
                                        "entry_id": "c59d09c9-5a57-37bf-90f4-70ff421d61c2",
                                        "glosses": [
                                            "A military display or pageant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tattoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a29864b5-17d6-3512-817b-2bfb96204145",
                                        "entry_id": "720a1a0a-fa72-3856-9482-b8d810da4da2",
                                        "glosses": [
                                            "To tap rhythmically on, to drum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009b139e-e22f-4833-80d5-5ba6764eda16",
                                                "sense_id": "a29864b5-17d6-3512-817b-2bfb96204145",
                                                "text": "He had looked at the clock many scores of times; and at the street, where the rain was pattering down, and the people as they clinked by in pattens, left long reflections on the shining stone: he tattooed at the table: he bit his nails most completely […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
