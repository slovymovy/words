                    {
                        "sense_id": "e94ae370-6812-325d-8e2c-5c7860374580",
                        "entry_id": "bfb71331-73ff-3fdc-8115-4c0a4199cf91",
                        "glosses": [
                            "een constructiesysteem voor internetpagina's waar, in het algemeen, iedereen alle pagina's kan wijzigen"
                        ],
                        "tags": [
                            "wikitaal"
                        ],
                        "examples": [
                            {
                                "example_id": "567efebe-5544-45b3-b1a6-31994dae4c69",
                                "sense_id": "e94ae370-6812-325d-8e2c-5c7860374580",
                                "text": "Het WikiWoordenboek is een voorbeeld van een wiki."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03727415-9638-4c04-87bb-9d4a31d97057",
                        "source_entry_id": "bfb71331-73ff-3fdc-8115-4c0a4199cf91",
                        "source_sense_id": "e94ae370-6812-325d-8e2c-5c7860374580",
                        "source_sense_description": "een constructiesysteem voor internetpagina's waar, in het algemeen, iedereen alle pagina's kan wijzigen",
                        "target_lang_word": "wiki",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wiki",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d03bf4a-9d43-365d-be42-b40891342efd",
                                        "entry_id": "df18b7a3-ae04-3ecf-a9be-cefba1ed6ff9",
                                        "glosses": [
                                            "A collaborative website which can be directly edited merely by using a web browser, often by anyone who has access to it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "793cec31-cb8c-44f8-a57c-f51779bff1f2",
                                                "sense_id": "7d03bf4a-9d43-365d-be42-b40891342efd",
                                                "text": "He spent time editing articles on the wiki."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wiki",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7af866a4-7d45-3dbf-8138-1c6de7f4a7ed",
                                        "entry_id": "e4202b89-021b-32a9-a6ba-8824838720ac",
                                        "glosses": [
                                            "To research on Wikipedia or some similar wiki."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "782416ee-cdcd-4662-b7dc-607ed65e4dbe",
                                                "sense_id": "7af866a4-7d45-3dbf-8138-1c6de7f4a7ed",
                                                "text": "To get an understanding of the topics, he quickly went online and wikied each one."
                                            },
                                            {
                                                "example_id": "c8d69b96-4256-4d5a-b3a1-668818ed5a83",
                                                "sense_id": "7af866a4-7d45-3dbf-8138-1c6de7f4a7ed",
                                                "text": "I tore through his collection wikiing any plot points that I missed learning the importance of the players of the DC universe"
                                            },
                                            {
                                                "example_id": "08c79728-d1aa-4efc-8853-03eb26aadccd",
                                                "sense_id": "7af866a4-7d45-3dbf-8138-1c6de7f4a7ed",
                                                "text": "Her English is no better than my Portuguese, but I wikied 'influenza' in Portuguese and it came up with 'gripe'"
                                            },
                                            {
                                                "example_id": "f9ccd090-3d27-448b-bcbd-0907b349bc44",
                                                "sense_id": "7af866a4-7d45-3dbf-8138-1c6de7f4a7ed",
                                                "text": "I did research on the internet and found out so. I “wikied” it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "856928b9-7f26-3fe0-89db-2a1824012e5d",
                                        "entry_id": "e4202b89-021b-32a9-a6ba-8824838720ac",
                                        "glosses": [
                                            "To contribute to a wiki."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69a9b385-3c1c-48ab-8e0b-2bf631d42b52",
                                                "sense_id": "856928b9-7f26-3fe0-89db-2a1824012e5d",
                                                "text": "Blogging, wiki-ing, coding are all activities that generate authorial product."
                                            },
                                            {
                                                "example_id": "4377b624-1664-4504-a6a3-0aa199ef924e",
                                                "sense_id": "856928b9-7f26-3fe0-89db-2a1824012e5d",
                                                "text": "The best way to start wiki-ing is to find an existing wiki (that is, a hosted wiki) and start adding to it."
                                            },
                                            {
                                                "example_id": "9859e373-a922-4616-b07a-771dd4472f83",
                                                "sense_id": "856928b9-7f26-3fe0-89db-2a1824012e5d",
                                                "text": "For example, blog and wiki software can be used to support all sorts of activities that are not commonly associated with the activities of “blogging” or “wikiing.” This includes activities like sharing syllabi, publishing announcements"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ffec79-d51b-3beb-8ca0-fc445a1ffb93",
                                        "entry_id": "e4202b89-021b-32a9-a6ba-8824838720ac",
                                        "glosses": [
                                            "To participate in the wiki-based production of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c8f2b5d-9aa7-41fc-b7a6-db86b5c64741",
                                                "sense_id": "86ffec79-d51b-3beb-8ca0-fc445a1ffb93",
                                                "text": "The history of wikied novels isn't pretty (Penguin Books never published the gobbledygook that was \"A Million Penguins\"), and no one has dared wiki a jazz song."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
