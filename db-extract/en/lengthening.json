                ],
                "senses": [
                    {
                        "sense_id": "804a54f3-2cef-36cc-b075-e9448ac1bff4",
                        "entry_id": "d530fc46-f0c1-3d88-ad42-28b70158b949",
                        "glosses": [
                            "The process of making or growing longer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596cbd4d-0c61-477f-9462-21de6389a40e",
                                "sense_id": "804a54f3-2cef-36cc-b075-e9448ac1bff4",
                                "text": "This enabled an additional 15-20 containers to be carried per train, giving a 20% productivity gain, and was partly enabled by Network Rail completing the lengthening of loops on the route northwards from Southampton via Banbury."
                            }
                        ]
                    },
                    {
                        "sense_id": "52f941a3-a6cc-3842-a1c1-7b9370bd1567",
                        "entry_id": "d530fc46-f0c1-3d88-ad42-28b70158b949",
                        "glosses": [
                            "a type of sound change when a sound (especially a vowel) lengthens"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "184ffd50-dcc8-4221-aa92-f851917edb2f",
                        "source_entry_id": "d530fc46-f0c1-3d88-ad42-28b70158b949",
                        "source_sense_description": "sound change",
                        "target_lang_word": "allongement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allongement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee52faaa-31df-3614-910d-336facda4574",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Action d’allonger, ou résultat de cette action (augmentation de la longueur, rallongement)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f73f48-c356-424d-b2a3-3dcfe695b4f7",
                                                "sense_id": "ee52faaa-31df-3614-910d-336facda4574",
                                                "text": "L’allongement d’un canal, d’un jardin, d’une allée, d’une avenue."
                                            },
                                            {
                                                "example_id": "4155a276-8eab-4b52-ab61-cd1697b10c6b",
                                                "sense_id": "ee52faaa-31df-3614-910d-336facda4574",
                                                "text": "Les colleurs d’affiches après avoir enduit de colle très liquide le panneau d’affichage appliquent leur papier en le noyant littéralement de colle pour que l’allongement soit rapide et le glissement facile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44fa6f8a-b462-39be-a79b-1ee0f8868c36",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Allongement relatif, augmentation relative de la longueur d’un matériau."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1197935f-5d25-46e2-a1dd-e675a3bf059a",
                                                "sense_id": "44fa6f8a-b462-39be-a79b-1ee0f8868c36",
                                                "text": "Un métal ayant un allongement de plus de 5 % est considéré comme ductile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9589e4b-8973-3806-b79b-36126f8b94bc",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Caractéristique géométrique de la voilure d′un aéronef. L′allongement est égal au ratio de l′envergure au carré sur la surface portante de l'aile."
                                        ],
                                        "tags": [
                                            "Aérodynamique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfefdfa7-c015-4f7e-9108-3f657131e48e",
                                                "sense_id": "d9589e4b-8973-3806-b79b-36126f8b94bc",
                                                "text": "Les planeurs les plus performants ont un grand allongement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2110a84b-7173-31db-a937-5589653b16d1",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Sensation visuelle que l'objet est plus long ou filiforme qu'il ne l'est."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f7ba7e-cfd6-4dd8-a68c-9c848d5af89b",
                                                "sense_id": "2110a84b-7173-31db-a937-5589653b16d1",
                                                "text": "La jupe est droite avec une pièce décorative sur le devant. Au dos un pli creux et un pli couché contribuent à l’allongement de la silhouette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd62bff-0b0e-3867-ba78-f3b562e52a60",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Lenteurs affectées et recherchées que certaines gens mettent dans les affaires."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d353832-a707-44f2-a25b-b99e4fa62917",
                                                "sense_id": "7bd62bff-0b0e-3867-ba78-f3b562e52a60",
                                                "text": "C’est un homme qui cherche, qui trouve toujours des allongements."
                                            },
                                            {
                                                "example_id": "6dd5acf3-a373-4914-a4db-bd14ac061742",
                                                "sense_id": "7bd62bff-0b0e-3867-ba78-f3b562e52a60",
                                                "text": "Ce ne sont qu’allongements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c6c15de-884e-4cae-b912-10cc666a4a6b",
                        "source_entry_id": "d530fc46-f0c1-3d88-ad42-28b70158b949",
                        "source_sense_description": "sound change",
                        "target_lang_word": "Längung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Längung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                        "entry_id": "57628a85-ca67-3c0e-bf68-92f352c8d88d",
                                        "glosses": [
                                            "das Längen, Verlängern, Dehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f886f5-3bc0-49f7-bc58-fa204b36c122",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Eine Kettenverschleißmessung dient zur Bestimmung des Verschleißgrades einer Antriebskette in Form ihrer Längung, meist wird der Begriff im Zusammenhang mit Fahrradketten verwendet."
                                            },
                                            {
                                                "example_id": "82da8f9a-ab84-40ff-b33f-f2ef775c3055",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Das Schließen der Silbe würde deren Längung verursachen."
                                            },
                                            {
                                                "example_id": "fcf0afa4-13e5-4364-b84e-e093da87f6d7",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Litauisches „ą“, „ę“, „į“ und „ų“ zeigt in der Standardsprache nur eine Längung des Vokals an."
                                            },
                                            {
                                                "example_id": "d8a63adc-4853-4664-b4bd-34100a83eea4",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Die Sprecherin HA09 weist hier auch die höchsten Anteile von Längungen auf, die insgesamt 31% aller von ihr realisierten vokalischen Intervalle umfassen, sodass die Längung vor allem bei ihr, aber auch bei den anderen Sprechern als gewohnheitsmäßiges und bewusstes Merkmal der Prosodie interpretiert werden kann."
                                            },
                                            {
                                                "example_id": "14bc0c31-a819-41a7-91e6-94d5e830b04e",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Das Projekt untersucht das Phänomen der präfinalen Längung (PFL), d.h. der Dehnung von Segmenten vor prosodischen Grenzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
