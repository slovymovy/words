                            }
                        ]
                    },
                    {
                        "translation_id": "bb4dcbde-8a9f-4ae6-b7cc-6221b7d6afce",
                        "source_entry_id": "bd5c20e4-cb5d-319d-926d-2f83c2ad99dd",
                        "source_sense_id": "f3100675-7fd1-3b22-855d-8fc99a68b9b6",
                        "target_lang_word": "transsexuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
