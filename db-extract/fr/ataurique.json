                                        "glosses": [
                                            "The use in art or architecture of a repeating decorative motif consisting of a vegetal or floral pattern, especially as formerly practised in Islamic Spain and North Africa."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
