                "senses": [
                    {
                        "sense_id": "070a5ec0-6b4d-3aeb-ac5c-25c4c6de3c0a",
                        "entry_id": "fc4b9719-2456-3ac6-8b75-dd81298ea8e5",
                        "glosses": [
                            "Ursprung von dem Einkommen, das jemand erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e808f38-5a2d-40e7-bc33-7ab99b0134f6",
                                "sense_id": "070a5ec0-6b4d-3aeb-ac5c-25c4c6de3c0a",
                                "text": "„Für die einen ist der Everest ein Sehnsuchtsort, für andere eine Einkommensquelle.“"
                            },
                            {
                                "example_id": "dea4667a-2949-46e2-9237-2cffd6c049bf",
                                "sense_id": "070a5ec0-6b4d-3aeb-ac5c-25c4c6de3c0a",
                                "text": "„Eine wichtige Einkommensquelle sollten die kunstvoll gestalteten Briefmarken werden, die in großen Auflagen gedruckt wurden und bei Sammlern in aller Welt begehrt waren.“"
                            },
                            {
                                "example_id": "6079cfd0-c340-4699-b21c-2d44a57dbad3",
                                "sense_id": "070a5ec0-6b4d-3aeb-ac5c-25c4c6de3c0a",
                                "text": "„In der Folgezeit eroberte er den Punjab und Kaschmir und nahm den Kabuler Herrschern ihre wichtigsten Einkommensquellen, um sich die Loyalität der vielen Potentaten und Stämme zu erkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
