                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d888960-951d-39eb-bbb9-93e54350dcc9",
                                        "entry_id": "5ded0519-1cd6-3d4f-bce5-7f7744435849",
                                        "glosses": [
                                            "vorsätzlich nicht die Wahrheit sagen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29dba803-637b-4a2d-b1ed-b24113bdd1f6",
                                                "sense_id": "0d888960-951d-39eb-bbb9-93e54350dcc9",
                                                "text": "„Ach, mitunter muß man lügen, und mitunter lügt man gern!“ (Wilhelm Busch, Aphorismen und Reime)"
                                            },
                                            {
                                                "example_id": "07f2a7ae-85d2-460e-91cf-a3841ad8c495",
                                                "sense_id": "0d888960-951d-39eb-bbb9-93e54350dcc9",
                                                "text": "Ich will ja nicht lügen, aber 200 Leute waren bestimmt da."
                                            },
                                            {
                                                "example_id": "87b8b4bc-1002-4c0f-87cc-187eabc8f54e",
                                                "sense_id": "0d888960-951d-39eb-bbb9-93e54350dcc9",
                                                "text": "„»Wenn es ernst wird, muss man lügen.« Der Satz stammt von Juncker, ausgesprochen auf einer Veranstaltung kurz vor Ostern.“"
                                            },
                                            {
                                                "example_id": "0d89a1f9-307b-4fee-8c90-c0e962cae2b5",
                                                "sense_id": "0d888960-951d-39eb-bbb9-93e54350dcc9",
                                                "text": "Ein Nutzer auf der populären Plattform Weibo brachte seinen Frust so zum Ausdruck: «Wir wissen, dass sie lügen. Sie wissen, dass sie lügen. Sie wissen, dass wir wissen, dass sie lügen, und wir wissen auch, dass sie wissen, dass wir wissen, dass sie lügen – aber sie lügen trotzdem.»[Anmerkung: Angesprochen sind chinesische Zensurbehörden]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
