                "senses": [
                    {
                        "sense_id": "c62c2f58-fba8-3815-b20d-603763c0bef6",
                        "entry_id": "1fd5acbf-9eaf-3d89-8a7f-330ae216c361",
                        "glosses": [
                            "Donner un caractère eucharistique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6373d906-2d97-4f71-bc9a-7c054141ea2f",
                                "sense_id": "c62c2f58-fba8-3815-b20d-603763c0bef6",
                                "text": "Ils entendoient premieremet expliquer le Mystere avant qu’il fust eucharistisé, c’est à dire, avant qu’il fust parfait, & avant que de recevoir l’Eucharistie."
                            }
                        ]
                    },
                    {
                        "sense_id": "867c10eb-50e0-31f8-b997-2edcea38b0da",
                        "entry_id": "1fd5acbf-9eaf-3d89-8a7f-330ae216c361",
                        "glosses": [
                            "Introduire à l’eucharistie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10cd1e49-1fa0-4ced-bbe9-8ed3115c73a6",
                                "sense_id": "867c10eb-50e0-31f8-b997-2edcea38b0da",
                                "text": "De par son statut supérieur dans l'Église, la gent sacerdotale a tendance à négliger le petit, le pécheur, le non-pratiquant, le fou du village, pour ne s'intéresser qu’aux bons chrétiens, aux pratiquants ou aux enfants à baptiser ou à «eucharistiser»."
                            }
                        ]
                    }
                ],
