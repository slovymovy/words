                                    },
                                    {
                                        "sense_id": "3af42a08-5206-3137-99b6-c8317e8d5b11",
                                        "entry_id": "fb87242c-c3b1-30d6-bd56-e9b552a49af1",
                                        "glosses": [
                                            "The product or result of being strange."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "085a91b4-90cc-328f-809f-3457b53e784d",
                                        "entry_id": "fb87242c-c3b1-30d6-bd56-e9b552a49af1",
                                        "glosses": [
                                            "One of the quantum numbers of subatomic particles, depending upon the relative number of strange quarks and anti-strange quarks."
                                        ],
                                        "tags": [
                                            "particle",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e8ce83-3d21-40a7-8fa2-8bf99264ee71",
                                                "sense_id": "085a91b4-90cc-328f-809f-3457b53e784d",
                                                "text": "Mesons which combine the charmed quark with the up or down antiquarks are denoted the D mesons. These mesons carry explicit charm (i.e. have a non-zero charm quantum number), just as the K mesons carry strangeness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cf83329-c750-4f6e-b435-edf228e205a5",
                        "source_entry_id": "d21abb94-9d08-35ac-abc3-736034779749",
                        "source_sense_id": "27f1e045-eab7-39d2-8e38-e3dfd534c9d4",
                        "source_sense_description": "iets dat vreemds is; iets dat raar is; iets dat gek is",
                        "target_lang_word": "quirk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quirk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61a79917-94e8-3297-bebf-46b8bc99594c",
                                        "entry_id": "73e41c28-6af7-3aa1-b97b-3163f2751f45",
                                        "glosses": [
                                            "An idiosyncrasy; a slight glitch, a mannerism; something unusual about the manner or style of something or someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559ee594-c91e-4b84-97cc-769430eea5e7",
                                                "sense_id": "61a79917-94e8-3297-bebf-46b8bc99594c",
                                                "text": "The car steers cleanly, but the gearshift has a few quirks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f5400c-a534-38b5-a471-e7a1a72c99cb",
                                        "entry_id": "73e41c28-6af7-3aa1-b97b-3163f2751f45",
                                        "glosses": [
                                            "An acute angle dividing a molding; a groove that runs lengthwise between the upper part of a molding and a soffit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67eac2f1-780c-37dc-a930-559c083e1ea2",
                                        "entry_id": "73e41c28-6af7-3aa1-b97b-3163f2751f45",
                                        "glosses": [
                                            "A quibble, evasion, or subterfuge."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a258fdb1-11ea-4789-b3db-f4e5e08bdfbb",
                                                "sense_id": "67eac2f1-780c-37dc-a930-559c083e1ea2",
                                                "text": "Had you no quirk / To avoid gullage, sir, by such a creature?"
                                            },
                                            {
                                                "example_id": "6b5117ae-a113-43cb-9e46-60f8d4f41df4",
                                                "sense_id": "67eac2f1-780c-37dc-a930-559c083e1ea2",
                                                "text": "Let us not be too curious in prying into Gods arke, leaſt vve ſmart like the flie fluttering about the candle, for God is a conſuming fire to thoſe that vvill be ſporting themſelves in the quirks of their vvit about his ſacred myſteries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quirk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50be1377-da11-31a2-892a-9a2bd695fab6",
                                        "entry_id": "3e207d83-d7ca-3807-b3a3-84191f5a1ed2",
                                        "glosses": [
                                            "To (cause to) move with a wry jerk."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1836fbf1-1ae1-4b4d-ac22-29fb7d57ef0b",
                                                "sense_id": "50be1377-da11-31a2-892a-9a2bd695fab6",
                                                "text": "He quirked an eyebrow."
                                            },
                                            {
                                                "example_id": "7b876765-f007-4530-9103-0dc61257a119",
                                                "sense_id": "50be1377-da11-31a2-892a-9a2bd695fab6",
                                                "text": "The corners of her mouth quirked."
                                            },
                                            {
                                                "example_id": "7af78b25-7d1f-400d-b489-0dd49de695d4",
                                                "sense_id": "50be1377-da11-31a2-892a-9a2bd695fab6",
                                                "text": "He quirked his lips playfully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546c3dd1-a8c6-37e1-97c2-4dd792f4e531",
                                        "entry_id": "3e207d83-d7ca-3807-b3a3-84191f5a1ed2",
                                        "glosses": [
                                            "To furnish with a quirk or channel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a0541b5-0c81-35db-9ef0-0986981c80f4",
                                        "entry_id": "3e207d83-d7ca-3807-b3a3-84191f5a1ed2",
                                        "glosses": [
                                            "To alter in a unique and unusual way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684c78bf-2d78-403c-8ff4-7327e248a57c",
                                                "sense_id": "8a0541b5-0c81-35db-9ef0-0986981c80f4",
                                                "text": "But in the dream the forms are quirked by the peculiar troubles of the dreamer, whereas in myth the problems and solutions shown are directly valid for all mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e151b22d-2055-3d3a-8370-1c4c461b8261",
                                        "entry_id": "3e207d83-d7ca-3807-b3a3-84191f5a1ed2",
                                        "glosses": [
                                            "To use verbal tricks or quibbles."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8be63588-a15e-4da5-80f3-7235b579a03b",
                                                "sense_id": "e151b22d-2055-3d3a-8370-1c4c461b8261",
                                                "text": "I have stung her and wrung her,\nThe venom is working;—\nAnd if you had hung her\nWith canting and quirking,\nShe could not be deader than she will be soon"
                                            }
                                        ]
                                    }
                                ]
                            },
