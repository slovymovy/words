                        "glosses": [
                            "The action of imposing judgment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "32585160-8d74-4718-8319-15d6fe16c647",
                                "sense_id": "fed32e18-3ea9-3ff7-827b-f4b79a8650fe",
                                "text": "His work included the adjudgment of the arms of Achilles to Odysseus, the madness of Aias, the bringing of Philoctetes from Lemnos and his cure, the coming to the war of Neoptolemus who slays Eurypylus, son of Telephus, the making of the wooden horse, the spying of Odysseus and his theft, along with Diomedes, of the Palladium: the analysis concludes with the admission of the wooden horse into Troy by the Trojans."
                            },
                            {
                                "example_id": "1b66f80d-6740-4d09-85a9-d9f4088b0b75",
                                "sense_id": "fed32e18-3ea9-3ff7-827b-f4b79a8650fe",
                                "text": "The life record of every man, written not with pen and ink on paper, but with the finger of God on the tablet of his memory, will be the basis of his adjudgment to hell or his acquittal to heaven."
                            },
                            {
                                "example_id": "63d42164-68b3-4733-ac50-3b30fcb61819",
                                "sense_id": "fed32e18-3ea9-3ff7-827b-f4b79a8650fe",
                                "text": "In the compartments of the shield of Achilles Homer describes the adjudgment of a fine for homicide."
                            }
                        ]
                    }
                ],
