                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                        "entry_id": "0941e43c-dc98-35e4-a80c-b78ef2ec5cc0",
                                        "glosses": [
                                            "das Grenzgebirge zwischen Frankreich und Spanien"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90552cf-71d3-40d7-aab2-2cc1d69f451a",
                                                "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                                "text": "„\"Pyrenäen\" - das war eine rostbraune Sache auf der sonst grünen und schwarzen Karte, darin ein paar Bergkleckse standen. … Dies waren die wissenschaftlichen Kenntnisse, die mir die deutsche Schule in Bezug auf die Pyrenäen mitgegeben hatte.“"
                                            },
                                            {
                                                "example_id": "1a3296e4-e9f8-46be-92f6-a1c4a7d5de20",
                                                "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                                "text": "„In den Pyrenäen war es kalt.“"
                                            },
                                            {
                                                "example_id": "468b2f92-202d-40a4-a12e-23e43fb00967",
                                                "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                                "text": "„Sowie er die Pyrenäen überschritten hat, folgt der Sieg dem Enkel Heinrichs IV. überall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
