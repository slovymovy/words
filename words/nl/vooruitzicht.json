                    "frequency": "High",
                    "semantic_group_id": "verwachting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economische <w>vooruitzichten</w> zijn een stuk zonniger dan voorheen.",
                            "target_lang_translations": {
                                "en": "The economic <w>prospects</w> are a lot brighter than before."
                            }
                        },
                        {
                            "text": "Het <w>vooruitzicht</w> op een lange vakantie geeft me veel energie.",
                            "target_lang_translations": {
                                "en": "The <w>prospect</w> of a long holiday gives me a lot of energy."
                            }
