                                        "examples": [
                                            {
                                                "example_id": "9220be96-538e-47a7-b4f3-44230d113345",
                                                "sense_id": "d2adb3f9-9cf9-356e-ab2a-831879126fb8",
                                                "text": "Es soll ein Experiment gegeben haben, bei dem Säuglinge unbeeinflusst von Kommunikation und Zuwendung eine Sprache herausbilden sollten. Sie starben jedoch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
