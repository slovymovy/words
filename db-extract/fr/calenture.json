                        "entry_id": "f3a24cd3-5e70-37e7-83dc-ef1ac5ac45ff",
                        "glosses": [
                            "Sorte de délire auquel les navigateurs sont sujets, sous la zone tropicale."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3c004131-6dad-4ad7-9905-f4179585fe37",
                                "sense_id": "c50d598d-e983-3998-bf79-e847d105bb5d",
                                "text": "Comme deux anges que torture\nUne implacable calenture,\nDans le bleu cristal du matin\nSuivons le mirage lointain !"
                            },
                            {
                                "example_id": "f82104de-14e2-4622-a5ec-85d744842c61",
                                "sense_id": "c50d598d-e983-3998-bf79-e847d105bb5d",
                                "text": "Dans cette détresse, nous eûmes, outre la terreur de la tempête, un de nos hommes mort de la calenture, et un matelot et le domestique emportés par une lame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2222448-b1ca-4dbc-ad7b-3bdcab0a763d",
                        "source_entry_id": "f3a24cd3-5e70-37e7-83dc-ef1ac5ac45ff",
                        "source_sense_id": "c50d598d-e983-3998-bf79-e847d105bb5d",
                        "target_lang_word": "calenture",
