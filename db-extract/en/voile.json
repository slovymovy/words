                        "entry_id": "ce7b463a-50d1-37fb-8567-62b1e15b27cd",
                        "glosses": [
                            "A light, translucent cotton fabric used for making curtains and dresses."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b14ce43-fa31-4e72-929d-814c4c506512",
                                "sense_id": "cc5ce216-ea4d-3aaf-a112-136b6c802f55",
                                "text": "The domestic voile made from imported gray yarns and woven in the United States is the best combination to be had."
                            },
                            {
                                "example_id": "e020f7d9-1818-4939-aa2c-e5567521c5e4",
                                "sense_id": "cc5ce216-ea4d-3aaf-a112-136b6c802f55",
                                "text": "Cheap narrow voiles.—Plain color voiles practically are off the market.[…]Better grades of voiles usually come in the 39-inch width,[…]."
                            },
                            {
                                "example_id": "cb7832cf-cfd5-4057-b4ea-b116bac38ba4",
                                "sense_id": "cc5ce216-ea4d-3aaf-a112-136b6c802f55",
                                "text": "Pull out the basting thread, gently remove the voile from the three-minute sample, and reshape the sample with a steam iron."
                            }
                        ]
                    }
                ],
