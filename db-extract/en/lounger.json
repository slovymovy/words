                    },
                    {
                        "translation_id": "c16afd4e-0896-47d7-913e-d33d50d65130",
                        "source_entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                        "source_sense_description": "chair",
                        "target_lang_word": "Liege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f51dd31-eaf4-3994-89db-965d57b8d0b6",
                                        "entry_id": "a0c35d1a-303f-35cd-b51a-31dfb7fba377",
                                        "glosses": [
                                            "flaches Möbelstück, auf dem man liegen und ruhen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d84d4c-359f-4a7d-8799-08af671c02f0",
                                                "sense_id": "1f51dd31-eaf4-3994-89db-965d57b8d0b6",
                                                "text": "Die Liege konnte sein Gewicht nicht halten und brach ein."
                                            },
                                            {
                                                "example_id": "1cb47603-b3dc-4e45-b364-b257828ae1fe",
                                                "sense_id": "1f51dd31-eaf4-3994-89db-965d57b8d0b6",
                                                "text": "„Kurzzeitig zog eine Finnin mit Liege zu mir.“"
                                            },
                                            {
                                                "example_id": "02da254d-d1e0-4d0b-b71c-c1339f178d53",
                                                "sense_id": "1f51dd31-eaf4-3994-89db-965d57b8d0b6",
                                                "text": "„Dass seine Frau ihn dabei mißtrauisch von ihrer Liege aus beäugt hatte, war ihm ebenso wie ihr tadelndes Räuspern entgangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
