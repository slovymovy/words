                    "sense_definition": "Een dringende vraag, eis of behoefte aan iets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is in de samenleving een sterke <w>roep</w> om verandering.",
                            "target_lang_translations": {
