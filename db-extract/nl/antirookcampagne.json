                            {
                                "example_id": "fde60b7e-26f2-4566-b0c0-37eb2569db1f",
                                "sense_id": "16fa0f93-b357-372e-b410-394ccbf0aeb6",
                                "text": "Antirookcampagne NIX van start: NIX heet de nieuwe landelijke campagne die jongeren moet bewegen om tot hun achttiende niet te roken en te drinken. De aftrap was vandaag in stadion De Kuip in Rotterdam."
                            },
                            {
                                "example_id": "296b518d-7440-49c0-b275-eae78a757428",
                                "sense_id": "16fa0f93-b357-372e-b410-394ccbf0aeb6",
                                "text": "FC Barcelona heeft zich opgeworpen om mensen van het roken af te krijgen. In samenwerking met de Europese commissie heeft de Spaanse topclub zaterdag de antirookcampagne 'Quit smoking with Barca' gelanceerd."
                            },
                            {
                                "example_id": "76585586-7c4d-4a0e-8234-6a31928329f3",
                                "sense_id": "16fa0f93-b357-372e-b410-394ccbf0aeb6",
                                "text": "Veel vertrouwen in het intellect van zijn achterban heeft deze islamistische politicus kennelijk niet, want hij wil met deze bizarre actie het risico uitsluiten dat zijn kiezers in de antirookcampagne een indirecte aanbeveling zien om 'nee' te stemmen in het referendum op paaszondag."
                            }
                        ]
