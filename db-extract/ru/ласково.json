                                        "examples": [
                                            {
                                                "example_id": "5f3aab22-8e8e-40d2-8f0e-a21bfa677a73",
                                                "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                                "text": "and the hour striking at which I was oblig'd to dispatch my young man, I tenderly advised him of the necessity there was for parting",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "09640a22-1427-4c1f-979f-df2b3d87fdcc",
                                                "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                                "text": "After a moment of comfortable silence, with Ben tenderly rubbing his thumb gently over the back of her hand, he asked, “So what do you want to do now that you’re all stuffed full of waffley goodness?”"
                                            },
                                            {
                                                "example_id": "6404c69f-cdc1-4dba-8647-f4d6db8a931e",
                                                "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                                "text": "Outside is getting colder\nWhy does it feel like I'm older than I asked to be?\nBut when you say my name\nIt all falls away so tenderly"
                                            }
                                        ]
