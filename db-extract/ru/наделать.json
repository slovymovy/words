                                "sense_id": "da7c2b46-9d39-38d5-b180-67c8a34dc520",
                                "text": "наде́лать беды/дел",
                                "translation": "to make a lot of trouble",
                                "english": "to make a lot of trouble"
                            },
                            {
                                "example_id": "7f0b4034-47d7-48a7-b423-f4d7f30ef349",
                                "sense_id": "da7c2b46-9d39-38d5-b180-67c8a34dc520",
                                "text": "что ты наде́лал!; что вы наде́лали!",
                                "translation": "what have you done!",
                                "english": "what have you done!"
                            },
                            {
                                "example_id": "45ad6638-0645-456c-ba7e-2ddaa75549d1",
                                "sense_id": "da7c2b46-9d39-38d5-b180-67c8a34dc520",
                                "text": "наде́лать мно́го шу́ма (произвести́ сенса́цию)",
                                "translation": "to cause a sensation/stir",
                                "english": "to cause a sensation/stir"
