                        "examples": [
                            {
                                "example_id": "556cdedf-c98c-4b64-85f8-d39780aeb27a",
                                "sense_id": "ca3956bd-7c04-37e8-992e-4eaff7dabbdf",
                                "text": "„Es sind die Augen der Krokodile, die die kühle Abendtemperatur an die Oberfläche des Wassers lockt.“"
                            },
                            {
                                "example_id": "2ec789dd-a74c-42a0-8a87-5c6ff421edb9",
                                "sense_id": "ca3956bd-7c04-37e8-992e-4eaff7dabbdf",
                                "text": "„Bei Abendtemperaturen von mehr als 30 Grad in Tiflis war die DFB-Elf in der ersten Halbzeit die überlegene Mannschaft, nutzte aber ihre Chancen nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
