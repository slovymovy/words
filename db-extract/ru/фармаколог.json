                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c5fe35-7738-4dc2-bcdc-70c05e8ea6e1",
                                                "sense_id": "0ce66076-f49e-3149-b4bd-2d82ae5d833a",
                                                "text": "Les juges étaient déjà influencés par l’opinion publique et ils voulaient un médecin ; il ne voulaient plus d’un pharmacologiste."
