                "senses": [
                    {
                        "sense_id": "031ed89a-d356-35df-b51d-827a4342d6a8",
                        "entry_id": "bc1f62d1-2b78-3d7b-9ac8-a187ad0ddbc7",
                        "glosses": [
                            "Sicherheit von Arbeitenden oder am Arbeitsplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bb6df72-b57d-4c22-9012-4180358d5d9b",
                                "sense_id": "031ed89a-d356-35df-b51d-827a4342d6a8",
                                "text": "„Investieren Sie mit unseren Seminaren im Bereich Arbeitssicherheit und Gesundheitsschutz gezielt in die Gesundheit Ihrer Mitarbeiter und steigern Sie nachhaltig die Arbeitssicherheit in Ihrem Unternehmen.“"
                            },
                            {
                                "example_id": "834b85e9-e949-4f06-aec4-2cf10539bb0f",
                                "sense_id": "031ed89a-d356-35df-b51d-827a4342d6a8",
                                "text": "„Jeder Vorgesetzte hat zur Gewährleistung der Arbeitssicherheit in seinem Bereich diese Anordnungen und Maßnahmen umzusetzen, ggf. auch durch ergänzende Festlegungen zu konkretisieren und zu überwachen.“"
                            },
                            {
                                "example_id": "0354b178-e6dc-446d-a7a0-548afaed4ba4",
                                "sense_id": "031ed89a-d356-35df-b51d-827a4342d6a8",
                                "text": "„Nach dem schwersten Bergwerksunglück in der Geschichte der Türkei mit vermutlich mehr als 300 Toten werfen Kritiker der Regierung vor, den wirtschaftlichen Aufschwung auf Kosten der Arbeitssicherheit vorangetrieben zu haben.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
