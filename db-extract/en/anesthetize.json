                                        "entry_id": "b2e1ee7f-f803-35aa-8365-cf9ad6c58b3e",
                                        "glosses": [
                                            "(für bestimmte Zeit) gegen Empfindungen, insbesondere Schmerz, teilweise oder vollständig unempfindlich machen; taub machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4531ad6b-0a49-4049-9010-d12351c8180a",
                                                "sense_id": "066a8eb8-3887-3407-b41b-2cce891f0927",
                                                "text": "Der Zahnarzt betäubt das Zahnfleisch, bevor er operiert."
                                            },
                                            {
                                                "example_id": "d77bced2-44ee-4d8d-b50b-6b2c87634030",
                                                "sense_id": "066a8eb8-3887-3407-b41b-2cce891f0927",
                                                "text": "„Er ist nicht etwa gestillt, sondern er ist betäubt, so wie bei Abmagerungskuren der physische Hunger statt mit Brot mit magenberuhigenden AntiHungerPillen betäubt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2280820-9df0-49f7-b35f-5e26592c35ec",
                        "source_entry_id": "54b21553-16fa-3a9e-98af-63a8058d6719",
