                        "entry_id": "6c5a5bb0-80da-369e-92e0-b6de633196a5",
                        "glosses": [
                            "iemand die op allerlei listige manieren zijn doel probeert te bereiken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
