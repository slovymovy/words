                    {
                        "translation_id": "548c56fe-0a7d-4aa7-92f9-550bb0c52ec9",
                        "source_entry_id": "66bb5fa6-1026-334e-9ba7-58d26278270c",
                        "source_sense_description": "city in Alberta, Canada",
                        "target_lang_word": "Edmonton",
