                        "target_lang_word": "oyat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oyat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9abe6ec-8c07-3579-aa6f-a1503b50b3b9",
                                        "entry_id": "677d1cee-624d-3a82-ba24-c7532aa52618",
                                        "glosses": [
                                            "Poacée qui croît dans les terrains sablonneux grâce à des racines très profondes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6154af14-9230-4911-8bb6-704d7a8426d6",
                                                "sense_id": "d9abe6ec-8c07-3579-aa6f-a1503b50b3b9",
                                                "text": "Les mouvements des feuilles de l’oyat pourraient être considérés comme de simples mouvements d’hydratation, à l’instar de l’ouverture mécanique des anthères ou des sporanges de fougères."
                                            },
                                            {
                                                "example_id": "ef59fd2b-2dbd-4bce-8357-6bd8157feefc",
                                                "sense_id": "d9abe6ec-8c07-3579-aa6f-a1503b50b3b9",
                                                "text": "Les premiers coups firent d’assez nombreuses victimes. Puis personne ne passa plus par là ou seulement au pas de course. Si le tir avait été moins précis, quel massacre sur notre couche de sable, parmi les oyats !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oyat",
                                "target_lang_code": "fr",
                                "target_senses": [
