    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0128ad4c-2086-3381-b883-150aefe9e6b2",
                    "sense_definition": "o pogodzie lub niebie: stać się bezchmurnym, widniejszym; rozpogodzić się",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po południu niebo wreszcie się <w>przejaśniło</w> i wyszło słońce.",
                            "target_lang_translations": {
                                "en": "In the afternoon, the sky finally <w>cleared up</w> and the sun came out."
                            }
                        },
                        {
                            "text": "Meteorolodzy zapowiadają, że jutro nad morzem ma się <w>przejaśnić</w>.",
                            "target_lang_translations": {
                                "en": "Meteorologists forecast that it is supposed to <w>brighten up</w> by the sea tomorrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozpogodzić się",
                        "wypogodzić się",
                        "rozchmurzyć się",
                        "wyklarować się"
                    ],
                    "common_phrases": [
                        "niebo się przejaśniło"
                    ],
                    "target_lang_definitions": {
                        "en": "to become clear or brighter; of weather or sky, to clear up"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear up",
                                "target_lang_sense_clarification": "weather or sky"
                            },
                            {
                                "target_lang_word": "brighten up",
                                "target_lang_sense_clarification": "weather or sky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b57ba1-a1e3-3b35-9e4b-bbcb0e9cae7d",
                    "sense_definition": "uczynić coś jaśniejszym, bardziej widnym lub o jaśniejszej barwie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jasność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malarz postanowił lekko <w>przejaśnić</w> tło obrazu, aby nadać mu więcej lekkości.",
                            "target_lang_translations": {
                                "en": "The painter decided to slightly <w>lighten</w> the background of the painting to give it more lightness."
                            }
                        },
                        {
                            "text": "Wystarczy dodać trochę bieli, żeby <w>przejaśnić</w> ten ciemny odcień farby.",
                            "target_lang_translations": {
                                "en": "It is enough to add a little white to <w>lighten</w> this dark shade of paint."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przejaśnić kolor"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something lighter, brighter, or paler in color"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lighten",
                                "target_lang_sense_clarification": "a color or shade"
                            },
                            {
                                "target_lang_word": "brighten",
                                "target_lang_sense_clarification": "make lighter or more vivid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b066dc12-979a-34ba-93d6-177a745799cd",
                    "sense_definition": "stać się jaśniejszym, nabrać więcej światła lub blasku",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jasność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej smutna twarz nagle się <w>przejaśniła</w>, gdy usłyszała dobre wieści.",
                            "target_lang_translations": {
                                "en": "Her sad face suddenly <w>lit up</w> when she heard the good news."
                            }
                        },
                        {
                            "text": "Gdy odsłonięto zasłony, w całym pokoju od razu się <w>przejaśniło</w>.",
                            "target_lang_translations": {
                                "en": "When the curtains were pulled back, the whole room immediately <w>brightened up</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozchmurzyć się"
                    ],
                    "common_phrases": [
                        "twarz się przejaśniła"
                    ],
                    "target_lang_definitions": {
                        "en": "to become brighter or lighter; of a face, to light up or cheer up"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brighten",
                                "target_lang_sense_clarification": "a room or face"
                            },
                            {
                                "target_lang_word": "light up",
                                "target_lang_sense_clarification": "a face with emotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
