                        ],
                        "examples": [
                            {
                                "example_id": "d750cef6-dd88-4134-b1a6-a8ccfc78344e",
                                "sense_id": "90f723c8-a915-365f-93f3-574167e30691",
                                "text": "Katzengold zeigt, dass nicht alles Gold ist, was glänzt."
                            },
                            {
                                "example_id": "f99b643a-9be8-4821-8716-f967bd3cb117",
                                "sense_id": "90f723c8-a915-365f-93f3-574167e30691",
                                "text": "„In der Stube stand ein Vertiko und darauf eine Jesus-Figur aus Gips mit einer Girlande aus Papierrosen und einem Heiligenschein aus Katzengold.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4030b85-f5ef-318e-9520-8039426e3138",
                        "entry_id": "61c1db22-53fa-3de9-898d-e67a3c060b12",
                        "glosses": [
                            "ein anderes, golden glänzendes, verwittertes Mineral, beispielsweise Glimmer und Biotit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39080e07-f32d-4091-bdb6-3909f0d24781",
                                "sense_id": "e4030b85-f5ef-318e-9520-8039426e3138",
