                "senses": [
                    {
                        "sense_id": "c062911e-b79d-3582-8f53-32d3b170a45a",
                        "entry_id": "40fb95ae-1215-3e47-85ea-0401b6a76bf6",
                        "glosses": [
                            "Établir un nouveau périmètre pour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34973e67-4773-4e97-badf-f4566bd61520",
                                "sense_id": "c062911e-b79d-3582-8f53-32d3b170a45a",
                                "text": "Au point que les polices publiques se trouvent obligées à devoir repérimétrer les marges de leur monopole à leur avantage."
                            },
                            {
                                "example_id": "60a2d4f6-d15a-4398-a61a-cbaaf2f2fc11",
                                "sense_id": "c062911e-b79d-3582-8f53-32d3b170a45a",
                                "text": "Au lieu de parler de dépérimétrisation, il serait toutefois peut-être plus adéquat de chercher à repérimétrer."
                            },
                            {
                                "example_id": "8bfa6fe1-2cb3-47cb-8e39-c6026564ca28",
                                "sense_id": "c062911e-b79d-3582-8f53-32d3b170a45a",
                                "text": "On ne travaille pas dessus à l'heure actuelle. Commentaire : Il y a eu un refus de la part des sections SHS de « repérimétrer » les sections dans la précipitation."
                            }
                        ]
                    }
