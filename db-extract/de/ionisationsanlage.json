                ],
                "senses": [
                    {
                        "sense_id": "fcd8f1b4-c295-3454-9e5b-95237aa48600",
                        "entry_id": "42899266-e3e3-3cc8-96d3-183ee9015558",
                        "glosses": [
                            "Einrichtung, die zur Ionisierung eines Mediums dient oder auch Gruppe von Ionisationsgeräten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8310e89d-0d54-4098-84ae-fab846e26af5",
                                "sense_id": "fcd8f1b4-c295-3454-9e5b-95237aa48600",
                                "text": "„Das Abgas wird von einem Ventilator durch einen Feststofffilter angesaugt und in die Ionisationsanlage gefördert.“"
                            },
                            {
                                "example_id": "cc89ff26-dbbf-4ec6-8b2a-84c3ee52c861",
                                "sense_id": "fcd8f1b4-c295-3454-9e5b-95237aa48600",
                                "text": "„Bei dieser Ionisationsanlage sind mehrere Vorrichtungen zur Ionisation von gasförmigem Sauerstoff, insbesondere von Sauerstoff in Raumluft, insbesondere mehrere Vorrichtungen der zuvor erläuterten Art, nebeneinander, aber mit Abstand voneinander angeordnet.“"
                            },
                            {
                                "example_id": "362685ba-1c96-4d87-9f22-c37d1f3f5e64",
                                "sense_id": "fcd8f1b4-c295-3454-9e5b-95237aa48600",
                                "text": "„PMT Partikel-Messtechnik bietet seinen Kunden einen umfassenden Beratungs- und Wartungsservice für die PMT Ionisationsanlagen an.“"
                            },
                            {
                                "example_id": "822e4962-719a-4ef0-80c2-751056eee639",
                                "sense_id": "fcd8f1b4-c295-3454-9e5b-95237aa48600",
                                "text": "„Die Ionisationsanlage wird mit Frischluft aus dem Außenbereich des Sudhauses versorgt.“"
                            },
                            {
                                "example_id": "26eead01-a194-4c35-a353-750c1b2c96dd",
                                "sense_id": "fcd8f1b4-c295-3454-9e5b-95237aa48600",
                                "text": "„Aus diesem Grund ist es notwendig dem Reinigungsvorgang eine Ionisationsanlage vorzuschalten, welche eine elektrostatisch neutrale Oberfläche gewährleistet und somit ein leichtes Lösen der Partikel ermöglicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
