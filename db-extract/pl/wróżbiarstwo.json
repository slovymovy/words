                "senses": [
                    {
                        "sense_id": "5ca36043-fcae-3852-9c73-f22027f62e3c",
                        "entry_id": "58f16288-6a42-35d7-984e-c4ee679a45a9",
                        "glosses": [
                            "próby przepowiadania przyszłości za pomocą specjalnych przedmiotów i technik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd1ed84-f3e6-4eca-975d-9e2265ccd045",
                                "sense_id": "5ca36043-fcae-3852-9c73-f22027f62e3c",
                                "text": "Tylko pokazywanie niedorzeczności związanych z wróżbiarstwem daje realne, pozytywne skutki"
                            },
                            {
                                "example_id": "2f4af73a-dbab-4d27-95eb-1859f94fe681",
                                "sense_id": "5ca36043-fcae-3852-9c73-f22027f62e3c",
                                "text": "Babka Salomea uprawiała wróżbiarstwo i miała mnóstwo materiałów na ten temat."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc5f9f6a-246f-4fb3-9ffd-38947877c3df",
                        "source_entry_id": "58f16288-6a42-35d7-984e-c4ee679a45a9",
                        "source_sense_id": "5ca36043-fcae-3852-9c73-f22027f62e3c",
                        "target_lang_word": "augury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "augury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17bb9b8d-053b-3bfe-9cab-59cc856ea2b9",
                                        "entry_id": "66e7ea95-5214-3107-8a96-cbc4c4248925",
                                        "glosses": [
                                            "A divination based on the appearance and behaviour of animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86800c1c-d4f3-344b-9239-08b66b82339b",
                                        "entry_id": "66e7ea95-5214-3107-8a96-cbc4c4248925",
                                        "glosses": [
                                            "An omen or prediction; a foreboding; a prophecy."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a7c3c0-14bc-4c90-8263-a74db7ca1955",
                                                "sense_id": "86800c1c-d4f3-344b-9239-08b66b82339b",
                                                "text": "In Wordsworth's first preludings there is but a dim foreboding of the creator of an era. From Southey's early poems, a safer augury might have been drawn."
                                            },
                                            {
                                                "example_id": "3679800a-3bf8-49c1-8d45-ffd5ce040274",
                                                "sense_id": "86800c1c-d4f3-344b-9239-08b66b82339b",
                                                "text": "No augury could be hopefuller. The Fates must indeed be hard, the Ordeal severe, the Destiny dark, that could destroy so bright a Spring!"
                                            },
                                            {
                                                "example_id": "d8eb4d7e-d9a1-49d4-8e7a-9dac4d0b916f",
                                                "sense_id": "86800c1c-d4f3-344b-9239-08b66b82339b",
                                                "text": "Fortunately many of the younger men are keen enough to make a success of their work, and this gives a better augury for the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae84b26e-6436-352c-9edf-15102c75ff65",
                                        "entry_id": "66e7ea95-5214-3107-8a96-cbc4c4248925",
                                        "glosses": [
                                            "An event that is experienced as indicating important things to come."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5debf61-fa70-4bdb-85a1-f28c4cbca3c6",
                                                "sense_id": "ae84b26e-6436-352c-9edf-15102c75ff65",
                                                "text": "Evidently he did not mean to be a mere figurehead, but to carry on the old tradition of Wilsthorpe's; and that was considered to be a good thing in itself and an augury for future prosperity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2ad1748-f337-40d3-a277-2d3a0474c797",
                        "source_entry_id": "58f16288-6a42-35d7-984e-c4ee679a45a9",
                        "source_sense_id": "5ca36043-fcae-3852-9c73-f22027f62e3c",
                        "target_lang_word": "divination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab87ff1-89cb-3e51-84e0-f23b5c9bbada",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Art de deviner, de prédire l’avenir."
                                        ],
                                        "tags": [
                                            "Pseudo-sciences"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab171a34-d062-4676-83df-126670748177",
                                                "sense_id": "0ab87ff1-89cb-3e51-84e0-f23b5c9bbada",
                                                "text": "Eh bien! c'est un homme d'Hoffmann. Toute la vie, il a cherché à appliquer les cartes et les nombres à la divination de l'avenir; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Ensemble des moyens employés pour deviner et prédire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68ad3f7-5542-477c-af68-d804bc9729c9",
                                                "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                                "text": "Précisément parce que la divination par les oiseaux était d'un usage universel et que chaque peuple la pratiquait pour son compte, l’auguration toscane n'a guère servi qu'aux Toscans eux-mêmes."
                                            },
                                            {
                                                "example_id": "def62cfd-c137-4383-a23b-a69130d87dfb",
                                                "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                                "text": "— Descartes, c'est le type qui a mis au point la divination par le tarot, non ? Je connais un gars, Jasper, qui est du genre à y croire dur comme fer mais, pour être franche, je doute un peu que le tarot permette d'accéder à la vérité éternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ffe9ee-125b-3066-ae53-0d761b06feb2",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Dans la recherche, sagacité permettant de retrouver des choses cachées pour lesquelles la logique seule ne suffit pas ; intuition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d3a91a-a51c-46e1-89ca-68536a10316b",
                                                "sense_id": "32ffe9ee-125b-3066-ae53-0d761b06feb2",
                                                "text": "C’est par une véritable divination qu’on a retrouvé le sens de plusieurs langues anciennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
