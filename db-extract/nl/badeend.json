                            {
                                "example_id": "50124f3f-7910-49f0-8dbe-c8eb610c0b4f",
                                "sense_id": "d3ffbb4b-8cee-3e5b-aa23-48d6a0521150",
                                "text": "Internetters hebben op ludieke wijze de strijd aangebonden met terreurgroep Islamitische Staat (IS). De gezichten van jihadisten op propagandafoto's worden vervangen door de koppen van rubberen badeenden."
                            },
