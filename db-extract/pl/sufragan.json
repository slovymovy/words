                "senses": [
                    {
                        "sense_id": "47e35c2c-f84a-3003-aada-f56989df366d",
                        "entry_id": "c3a9a72a-71b9-375b-b2f2-3b46192ab82e",
                        "glosses": [
                            "biskup diecezji sufragalnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283541f0-f934-448f-ab2a-dff4812eb57c",
                                "sense_id": "47e35c2c-f84a-3003-aada-f56989df366d",
                                "text": "Dodatkowych informacji dostarczyła odkryta niedawno inskrypcja poświadczająca, że kościół był poświęcony przez Jarosława sufragana działającego w imieniu biskupa krakowskiego Zbigniewa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0d1840e5-010f-371c-ab55-a4e7256423c9",
                        "entry_id": "c3a9a72a-71b9-375b-b2f2-3b46192ab82e",
                        "glosses": [
                            "biskup pomocniczy"
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [],
