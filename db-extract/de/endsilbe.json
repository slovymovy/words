                                    {
                                        "sense_id": "551ec551-d3a3-3440-ae31-b1d5a3ccdfcc",
                                        "entry_id": "fa7ca219-3e12-344f-a4f3-56caa48af967",
                                        "glosses": [
                                            "Dernière lettre d'un mot, ou dernière syllabe d'une phrase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3f91443-ef5f-3c39-836e-afa8635706e3",
                                        "entry_id": "fa7ca219-3e12-344f-a4f3-56caa48af967",
                                        "glosses": [
                                            "Dernière partie d’une période, d'une longue phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af75ef93-dce6-4e11-8de2-71c8c29828a7",
                                                "sense_id": "f3f91443-ef5f-3c39-836e-afa8635706e3",
                                                "text": "En résumé, c’est la proportion, l’équilibre, la logique qui détermineront a priori l’harmonie d’une phrase, et c’est en soignant surtout les finales qu’on obtiendra l’effet musical complet."
                                            },
                                            {
                                                "example_id": "f46cd06d-252a-495c-8b13-56894cc81d59",
                                                "sense_id": "f3f91443-ef5f-3c39-836e-afa8635706e3",
                                                "text": "— Je suis là, disait enfin Félix — et sa voix muait aux finales — pour veiller sur vous et vous montrer le chemin du devoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51fd016b-5b87-3441-b9db-5d005672e8f4",
                                        "entry_id": "fa7ca219-3e12-344f-a4f3-56caa48af967",
                                        "glosses": [
                                            "Dernière note d’un air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "finale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0478379-0a93-3761-ac54-22d5477f3616",
                                        "entry_id": "76fbf055-8e0b-3740-941b-69d6dcf3d876",
                                        "glosses": [
                                            "Morceau d’ensemble qui termine un acte d’opéra, une symphonie, une sonate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd9f8f81-660d-43d6-afc3-d6f9a49d0bcd",
                                                "sense_id": "b0478379-0a93-3761-ac54-22d5477f3616",
                                                "text": "Madame Hulot faisait remonter les premières infidélités de son Hector au grand finale de l’Empire."
                                            },
                                            {
                                                "example_id": "a63ff55f-d773-408f-b102-6bb203dcab5d",
                                                "sense_id": "b0478379-0a93-3761-ac54-22d5477f3616",
                                                "text": "La pièce est finie, mais non pas la musique. Il faut un finale : sans finale, pas d’opéra."
                                            },
                                            {
                                                "example_id": "8cd5cee8-9f4b-4479-a7a1-d4e57df3ee37",
                                                "sense_id": "b0478379-0a93-3761-ac54-22d5477f3616",
                                                "text": "Le finale se recule encore, et vous allez voir que c’est malgré moi…"
                                            },
                                            {
                                                "example_id": "47ef1846-b1f3-46a8-a490-dee49ca481fb",
                                                "sense_id": "b0478379-0a93-3761-ac54-22d5477f3616",
                                                "text": "L’épisode du cirque ambulant serait un bon finale pour ces treize années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
