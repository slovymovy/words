        "nl-extract.jsonl": [
            {
                "entry_id": "9928adb3-5b5e-388e-ae74-0d8f4f2a56fd",
                "word": "aanwoekeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb17198f-d189-3ec8-84d5-9360efb002ba",
                        "entry_id": "9928adb3-5b5e-388e-ae74-0d8f4f2a56fd",
                        "glosses": [
                            "op een te hebberige manier winst najagen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a1197362-0a87-3d7e-b3fe-86d94930aa6c",
                        "entry_id": "9928adb3-5b5e-388e-ae74-0d8f4f2a56fd",
                        "glosses": [
                            "van onkruid of iets anders dat men slecht vindt, dat het te welig groeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9598e4e-78ae-4441-afa8-57aa4b93b0b3",
                                "sense_id": "a1197362-0a87-3d7e-b3fe-86d94930aa6c",
                                "text": "Zoals u waarschijnlijk weet, zijn democraten groot voorstander van het aanwoekeren van inflatie middels het bijprinten van extra geld. Met nu bijna alleen maar Democraten aan het hoofd van de Amerikaanse centrale bank kan worden gesteld dat de komende vier jaar de bijbehorende risico’s alleen maar zullen toenemen. Wat betreft de toekomst van de Fed lijkt het dus een gelopen race voor de Republikeinen te zijn."
                            },
                            {
                                "example_id": "889d3a14-ef52-4b28-b060-8b1519594673",
                                "sense_id": "a1197362-0a87-3d7e-b3fe-86d94930aa6c",
                                "text": "“Je moet er vroeg bij zijn”, vind hij, om een vermeende rap aanwoekerende stroom arbeidsmigranten uit bijvoorbeeld Polen buiten het zorgstelsel te houden. Baanverlies na slechts een korte arbeidsperiode betekent het land uit. Amzani hoopt zo ”korte metten te maken met bijstandstoerisme”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e01de76f-632a-476a-8409-e59c5c0b583e",
                        "source_entry_id": "9928adb3-5b5e-388e-ae74-0d8f4f2a56fd",
                        "source_sense_id": "a1197362-0a87-3d7e-b3fe-86d94930aa6c",
                        "source_sense_description": "te welig groeien",
                        "target_lang_word": "overgrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overgrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b9620d-d056-310a-ba79-a618916c6c16",
                                        "entry_id": "8d501035-bd4f-3f36-9950-1b72d44eb089",
                                        "glosses": [
                                            "To grow beyond one's boundaries or containment, or beyond the proper size."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed18ec14-2bd2-3485-bdd9-1e7f3cb6ae1f",
                                        "entry_id": "8d501035-bd4f-3f36-9950-1b72d44eb089",
                                        "glosses": [
                                            "To grow over; (of one thing) to cause (a second thing) to become overgrown (with or by the first thing)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d953f6d-3267-421d-b088-80066dbe5bba",
                                                "sense_id": "ed18ec14-2bd2-3485-bdd9-1e7f3cb6ae1f",
                                                "text": "The utmost they aimed at doing was thoroughly to clear the old Church of all the corruptions and superstitions which had disfigured it in the course of ages, and which, like the flaunting ivy overgrowing some ancient building, not only concealed the Church's fair proportions, but shut out the light of heaven from its windows, and more or less dislocated its structure."
                                            },
                                            {
                                                "example_id": "cd252290-fb4c-4d88-9661-bd67615ac56f",
                                                "sense_id": "ed18ec14-2bd2-3485-bdd9-1e7f3cb6ae1f",
                                                "text": "One wall advertised a dense muddle of ivy overgrowing its prefab brick, while a miniature moat with a jerry-built bridge arcing over it snaked around one of the \"halls\" (as real universities dub their constituent structures)."
                                            },
                                            {
                                                "example_id": "4db8ec13-85a2-4fb9-aebc-d7e4462c1340",
                                                "sense_id": "ed18ec14-2bd2-3485-bdd9-1e7f3cb6ae1f",
                                                "text": "If there is ivy overgrowing things, then we shall clean it up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
