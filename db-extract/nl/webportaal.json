                        "examples": [
                            {
                                "example_id": "4b5ee8a8-fc8e-4488-a835-acb38a282723",
                                "sense_id": "896cc1a8-c84a-3d85-a825-c5b6d45feb2d",
                                "text": "Het webportaal GeoNet meldde vorige week een verhoogde activiteit van de vulkaan, maar dat zou geen onmiddellijk gevaar voor bezoekers opleveren."
                            },
                            {
                                "example_id": "cc816923-5395-4783-904b-0bdc799dfbc1",
                                "sense_id": "896cc1a8-c84a-3d85-a825-c5b6d45feb2d",
                                "text": "ZN vindt dat de overheid samen met alle betrokkenen (waaronder de zorgkantoren) op korte termijn met een webportaal moet komen zodat budgethouders veilig en eenvoudig hun administratie kunnen doen ten behoeve van hun pgb."
                            },
                            {
                                "example_id": "4b8c7735-4a0c-4fcb-9473-c8741779bf98",
                                "sense_id": "896cc1a8-c84a-3d85-a825-c5b6d45feb2d",
                                "text": "De Roemenen zijn de clichébeelden over hen in het westen zat. Een populair webportaal is een ludieke internetcampagne begonnen om duidelijk te maken dat niet iedere Roemeen op emigratie naar West-Europa zit te wachten."
                            }
                        ]
                    }
