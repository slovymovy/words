                                        "glosses": [
                                            "A junkyard, a place where scrap is stored, discarded or resold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5afb9045-e9e0-4025-bc6c-24eebfc96ff8",
                                                "sense_id": "55dc8db8-5e85-39e4-9047-ece5d2f92df5",
                                                "text": "A steady procession of new Class 421 and '423' electric multiple units to the Southern Region from Derby and York allowed the despatch of many pre-nationalisation 2-BIL and 2-HAL units to scrapyards."
                                            }
