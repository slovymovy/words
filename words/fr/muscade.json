                    "frequency": "VeryLow",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magicien a fait disparaître la <w>muscade</w> sous un gobelet en métal."
                        },
                        {
                            "text": "L'illusionniste manipule adroitement plusieurs <w>muscades</w> devant un public attentif."
                        }
                    ],
                    "common_phrases": [
                        "passez muscade"
                    ]
                }
            ]
        },
        {
