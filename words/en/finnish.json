                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "My friend wants to learn to speak <w>Finnish</w> fluently before moving there.",
                            "target_lang_translations": {
                                "ru": "Мой друг хочет научиться бегло говорить <w>по-фински</w> перед переездом туда.",
                                "zh": "我的朋友想在搬去那里之前学会流利地说<w>芬兰语</w>。"
                            }
                        },
                        {
                            "text": "The instructions on the package were written in both Swedish and <w>Finnish</w>.",
                            "target_lang_translations": {
