                        "glosses": [
                            "Violation de copyright par une publication."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d4e3efc3-26e5-4266-aa88-2d7a356bb7c9",
                                "sense_id": "591f4e7f-82b9-3b34-9ef0-316a417f7ba3",
                                "text": "La citation d’un très long extrait d’un livre, ou la citation in extenso d’un article de journal est du copyvio. De même, sur la Wikipédia en français, l’insertion d’une image en fair use du droit américain est assimilée à du copyvio."
                            }
                        ]
                    }
                ],
