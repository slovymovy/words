                                "target_senses": [
                                    {
                                        "sense_id": "92fc66f0-e6ee-3e51-832b-c3e8f3c8ef4e",
                                        "entry_id": "681f59aa-bd47-3370-8b55-7ebf5d3e7df3",
                                        "glosses": [
                                            "Instrument médical composé principalement d’un tube de fibres optiques permettant d’examiner l’intérieur du côlon, et, selon les modèles, d’agir dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d38dc1-e22e-4082-9c24-6f95989bca72",
                                                "sense_id": "92fc66f0-e6ee-3e51-832b-c3e8f3c8ef4e",
                                                "text": "Le coloscope est guidé depuis le rectum jusqu’au colon pour procéder à un examen et, si le médecin le juge utile, à un prélèvement (biopsie)."
                                            },
                                            {
                                                "example_id": "8c549a43-c6f0-462f-95d1-d76d9e28eaa2",
                                                "sense_id": "92fc66f0-e6ee-3e51-832b-c3e8f3c8ef4e",
                                                "text": "Le traitement repose sur la décompression endoscopique, généralement avec un coloscope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "623849f1-2961-4455-904f-72e5f2e9b48b",
                        "source_entry_id": "01889dd7-e24f-3d65-bd28-7a5cee6eac78",
