                                        "examples": [
                                            {
                                                "example_id": "0e6d3789-517a-4a8c-a18a-4f3f5c638b0f",
                                                "sense_id": "996add33-a95f-3247-9420-1eb4e076d8d3",
                                                "text": "How much falling will the dollar do Righturds?"
                                            },
