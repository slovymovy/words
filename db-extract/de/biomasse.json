                                        "glosses": [
                                            "organisch materiaal (gebruikt voor energieopwekking)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa32f45d-6b88-406d-99df-1e4ba54ae8db",
                                                "sense_id": "3aeed1dc-5652-3b1b-8317-32e5c23defee",
                                                "text": "Wind, water en zon zijn bekende bronnen van groene stroom, maar ruim 50 procent van de groene stroom in Nederland komt uit een andere bron: biomassa. Via verbranding, vergisting en vergassing halen we energie uit biomassa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
