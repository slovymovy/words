                "senses": [
                    {
                        "sense_id": "a862d5c4-c75e-3608-ab4c-2fc7342e4df4",
                        "entry_id": "d1d6d132-000f-302d-89e0-0f4372ea1090",
                        "glosses": [
                            "Rendre homophone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06699d58-fed6-45bc-ac8c-3b2d1c50eccd",
                                "sense_id": "a862d5c4-c75e-3608-ab4c-2fc7342e4df4",
                                "text": "Par conséquent, il homophonise par exemple la paire minimale anglaise sick/thick et l’ensemble de la série significative concernée par la distinction."
                            },
                            {
                                "example_id": "bd85f1a9-e08b-4928-a42e-6f864ded4d30",
                                "sense_id": "a862d5c4-c75e-3608-ab4c-2fc7342e4df4",
                                "text": "La non-pertinence des voyelles ne nous donne pas la liberté d’« homophoniser » vocaliquement les lexèmes, au-delà des réalisations, car cela nierait et refuserait touté évolution possible en sens inverse et toute possibilité future d’un établissement de pertinence vocalique à partir d’emprunts et de réalisations existantes."
                            }
                        ]
                    }
                ],
