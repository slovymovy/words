                        "examples": [
                            {
                                "example_id": "9a5f7954-78d2-4dc4-bddf-b699dab48b76",
                                "sense_id": "07e35d21-0cb7-3985-84dc-a8dff4d83ec8",
                                "text": "„Am auffälligsten sind endlose Tabellen mit Zahlen, die Auskunft über die Durchschnittswerte von kindlichen Körperteilen geben.“"
                            },
                            {
                                "example_id": "3f495cd5-b181-4c68-a477-aee46a4ccbfc",
                                "sense_id": "07e35d21-0cb7-3985-84dc-a8dff4d83ec8",
                                "text": "„Ihre individuellen Zukunftsperspektiven in Deutschland schätzten die Befragten mit einem Durchschnittswert von 4.44 als annähernd sehr gut ein.“"
                            }
                        ],
