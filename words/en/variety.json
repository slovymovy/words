            "senses": [
                {
                    "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                    "sense_definition": "A collection or number of different things.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop offers a wide <w>variety</w> of fresh fruits and vegetables every morning.",
                            "target_lang_translations": {
                                "ru": "Магазин каждое утро предлагает широкий <w>ассортимент</w> свежих фруктов и овощей.",
                                "de": "Das Geschäft bietet jeden Morgen eine große <w>Auswahl</w> an frischem Obst und Gemüse an."
                            }
                        },
                        {
                            "text": "Students can choose from a <w>variety</w> of sports including football, tennis, and swimming.",
                            "target_lang_translations": {
                                "ru": "Студенты могут выбирать из <w>множества</w> видов спорта, включая футбол, теннис и плавание.",
                                "de": "Schüler können aus einer <w>Vielzahl</w> von Sportarten wählen, darunter Fußball, Tennis und Schwimmen."
                            }
                        }
