                                            {
                                                "example_id": "9c7e5b45-2e86-4e0a-b818-ad27c682e51e",
                                                "sense_id": "9abcebb8-8574-39f8-aa06-850d02f0adec",
                                                "text": "In Aberdeen, a fishing village of 12,000 fishermen who live on more than 3,000 sampans, we were transported on a rickety sampan through the mazelike sea community; on these modest wooden boats, large families, dogs, the day's catch of drying fish and television antennas all co-exist."
                                            },
                                            {
                                                "example_id": "d02b99d0-25eb-4ff7-aaa3-c9ecc7a4ba9b",
                                                "sense_id": "9abcebb8-8574-39f8-aa06-850d02f0adec",
                                                "text": "Police Launch No. 32 sliced through the murky gray-green waters of Aberdeen, navigating the narrow path between fishing junks, sampan taxis and the gaudy Jumbo floating seafood restaurant."
                                            },
                                            {
                                                "example_id": "f1113842-6f89-45f6-befc-c1e684832011",
                                                "sense_id": "9abcebb8-8574-39f8-aa06-850d02f0adec",
                                                "text": "The corpse of a newborn child was found in waters off the typhoon shelter in Aberdeen on Tuesday morning."
                                            }
                                        ]
                                    }
