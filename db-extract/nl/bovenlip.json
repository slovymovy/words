                                "example_id": "4420c695-5442-4c6b-a61e-1be57b21085f",
                                "sense_id": "567e4b67-1da3-37c1-8586-f51b1c85576c",
                                "text": "Hij veegde de kruimels van zijn bovenlip na het eten van een broodje.",
                                "translation": "He wiped the crumbs off his upper lip after eating a sandwich.",
                                "english": "He wiped the crumbs off his upper lip after eating a sandwich."
                            },
                            {
                                "example_id": "684378d9-b015-49d7-8aba-ab3a20a49d0a",
                                "sense_id": "567e4b67-1da3-37c1-8586-f51b1c85576c",
                                "text": "De vrouw bracht voorzichtig lippenstift aan op haar bovenlip en onderlip.",
                                "translation": "The woman carefully applied lipstick to her upper lip and lower lip.",
                                "english": "The woman carefully applied lipstick to her upper lip and lower lip."
                            },
                            {
                                "example_id": "aa90b0e3-bc2e-4dfa-a978-8f29a2442645",
                                "sense_id": "567e4b67-1da3-37c1-8586-f51b1c85576c",
                                "text": "Het koude ijsje deed haar bovenlip trillen van de kou.",
                                "translation": "The cold ice cream made her upper lip tremble from the cold.",
                                "english": "The cold ice cream made her upper lip tremble from the cold."
                            }
                        ]
