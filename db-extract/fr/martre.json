                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e138a806-0def-338d-b92f-c3a30b807df4",
                                        "entry_id": "a983f4aa-a1c9-3ed7-b363-a76950a49734",
                                        "glosses": [
                                            "зоол. небольшое хищное млекопитающее из семейства куньих (Martes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f176cd85-6003-4146-a28e-fddd1574407d",
                                                "sense_id": "e138a806-0def-338d-b92f-c3a30b807df4",
                                                "text": "В таком чернолесье живут, более или менее постоянно, медведи, волки, зайцы, куницы и белки."
                                            },
                                            {
                                                "example_id": "f77a3d38-1e20-403e-a548-a573a1982c53",
                                                "sense_id": "e138a806-0def-338d-b92f-c3a30b807df4",
                                                "text": "Ловкая и хищная куница быстро, но осторожно обшаривает еловый лес; она знает: белок много и у неё сегодня опять должна быть вкусная, любимая еда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31d60202-d6f5-32d5-ae7e-d15516e66f21",
                                        "entry_id": "a983f4aa-a1c9-3ed7-b363-a76950a49734",
                                        "glosses": [
                                            "мех такого животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe70391e-8ef6-4d26-8c8e-805846efff1f",
                                                "sense_id": "31d60202-d6f5-32d5-ae7e-d15516e66f21",
                                                "text": "Куницы не купили, потому что была, точно, дорога; а вместо её выбрали кошку, лучшую, какая только нашлась в лавке, кошку, которую издали можно было всегда принять за куницу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
