                        "glosses": [
                            "materiaal met een naar verhouding hoog aantal beweeglijke ladingsdragers, waardoor het een elektrische stroom makkelijk doorlaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e8875ce-b856-4afe-a9ee-37f7172f14fa",
                                "sense_id": "2cf99e51-8812-3f1a-a664-4b5a7f81bad2",
                                "text": "Tantaal is ijzersterk, een goede stroomgeleider en zit in elektronica, vliegtuigen en windturbines."
                            },
                            {
                                "example_id": "c01bbeca-abc7-41d3-9be4-1c821e3d3afa",
                                "sense_id": "2cf99e51-8812-3f1a-a664-4b5a7f81bad2",
                                "text": "Koolstof nanobuisjes, opgelost in een vloeistof, zijn van stroomgeleiders te veranderen in isolatoren via oxidatie: het chemisch ‘verwijderen’ van de geleidingselektronen."
                            }
                        ]
                    }
