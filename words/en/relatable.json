{
    "word_family": [
        "relate",
        "relation",
        "relationship",
        "relative",
        "relatability",
        "unrelatable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c9389b06-f08d-39b3-8765-070eb5bb3442",
                    "sense_definition": "Enabling a person to feel that they can understand, empathize with, or identify with someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "empathy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The characters in the drama are flawed, which makes them feel very <w>relatable</w> to the audience.",
                            "target_lang_translations": {
                                "ru": "У персонажей драмы есть недостатки, что делает их очень <w>близкими и понятными</w> зрителям."
                            }
                        },
                        {
                            "text": "Her book was successful because she wrote about widely <w>relatable</w> experiences.",
                            "target_lang_translations": {
                                "ru": "Её книга была успешной, потому что она писала о <w>близком многим</w> опыте."
                            }
                        }
                    ],
                    "antonyms": [
                        "unrelatable"
                    ],
                    "common_phrases": [
                        "relatable character",
                        "relatable experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволяющий человеку сопереживать, понимать или ассоциировать себя с кем-либо или чем-либо; близкий и понятный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близкий",
                                "target_lang_sense_clarification": "вызывающий сопереживание, отклик"
                            },
                            {
                                "target_lang_word": "понятный",
                                "target_lang_sense_clarification": "легко воспринимаемый и вызывающий сочувствие"
                            },
                            {
                                "target_lang_word": "жизненный",
                                "target_lang_sense_clarification": "правдоподобный, знакомый по собственному опыту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f655483-d7d2-354d-acf4-f93f9d6dd146",
                    "sense_definition": "Able to be connected, compared, or attributed to something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp drop in sales is directly <w>relatable</w> to the recent price increase.",
                            "target_lang_translations": {
                                "ru": "Резкое падение продаж напрямую <w>связано</w> с недавним повышением цен."
                            }
                        },
                        {
                            "text": "Researchers examined whether the symptoms were <w>relatable</w> to environmental pollution.",
                            "target_lang_translations": {
                                "ru": "Исследователи проверили, <w>соотносимы</w> ли эти симптомы с загрязнением окружающей среды."
                            }
                        }
                    ],
                    "synonyms": [
                        "attributable",
                        "connectable"
                    ],
                    "common_phrases": [
                        "relatable to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Который можно связать, соотнести или приписать чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соотносимый",
                                "target_lang_sense_clarification": "поддающийся сопоставлению или связи"
                            },
                            {
                                "target_lang_word": "связанный",
                                "target_lang_sense_clarification": "имеющий отношение к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c293a6c-9d61-38c7-9155-e49c6595b123",
                    "sense_definition": "Capable of being narrated, recounted, or told aloud.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "narration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler insisted that his strange encounter was hardly <w>relatable</w> in polite company.",
                            "target_lang_translations": {
                                "ru": "Путешественник утверждал, что о его странной встрече вряд ли <w>можно рассказать</w> в приличном обществе."
                            }
                        },
                        {
                            "text": "Only parts of the historical anecdote were deemed <w>relatable</w> to a general audience.",
                            "target_lang_translations": {
                                "ru": "Лишь некоторые части исторического анекдота были сочтены <w>подходящими для пересказа</w> широкой публике."
                            }
                        }
                    ],
                    "synonyms": [
                        "tellable"
                    ],
                    "antonyms": [
                        "unrelatable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, о котором можно рассказать или поведать вслух."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пригодный для рассказа",
                                "target_lang_sense_clarification": "о котором допустимо поведать"
                            },
                            {
                                "target_lang_word": "пересказываемый",
                                "target_lang_sense_clarification": "поддающийся пересказу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}