                    {
                        "sense_id": "2dd627c9-93a8-3469-8646-5f31d842be0d",
                        "entry_id": "334865bf-9aa3-36a7-a01e-5a08f7f332d0",
                        "glosses": [
                            "seit Ende des Zweiten Weltkrieges gegründete Heimstätten zur erzieherischen und medizinischen Betreuung eltern- und heimatloser Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef12a5fd-8f2b-45f0-8880-e5ac984d012c",
                                "sense_id": "2dd627c9-93a8-3469-8646-5f31d842be0d",
                                "text": "Diese Weihnachten spenden wir für die Kinderdörfer."
                            },
                            {
                                "example_id": "3720a37c-5ed7-42ad-a6de-8173c48f9e09",
                                "sense_id": "2dd627c9-93a8-3469-8646-5f31d842be0d",
                                "text": "„Ein Revival erlebte die Ballonpost ab den 1950er Jahren durch verschiedene private Wohltätigkeitsveranstaltungen von Kinderdörfern in Deutschland, Österreich und der Schweiz.“"
                            },
                            {
                                "example_id": "c6150ad8-cf89-4482-a897-5080ba4160ba",
                                "sense_id": "2dd627c9-93a8-3469-8646-5f31d842be0d",
                                "text": "„Die elternlosen Kinder werden mit zwei Autobussen in das Kinderdorf Kyritz in Brandenburg gebracht.“"
                            }
                        ],
