                ],
                "senses": [
                    {
                        "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                        "entry_id": "8fba635f-899d-351a-a350-774050e7bc2e",
                        "glosses": [
                            "Mangel am nötigen Abstand zu (Mit-)Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0f7935-0d0d-4490-a3e8-9becfaeda226",
                                "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                                "text": "„2005 schickte ihn der Orden wegen offenkundiger Distanzlosigkeiten gegenüber Schülern in das Kloster Wechselburg in Sachsen, […]“"
                            },
                            {
                                "example_id": "24d114f6-60ac-44b2-9007-cfd80a64e984",
                                "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                                "text": "„Sehr empfindlich war ich gegenüber Distanzlosigkeiten, der Zumutung symbiotischer Nähe und falschen Solidaritätsgesten.“"
                            },
                            {
                                "example_id": "5a993854-89d9-4efa-8b0a-f5e483ba4128",
                                "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                                "text": "„Persönliche Unhöflichkeiten und Distanzlosigkeiten werden mit Unzufriedenheit und Ablehnung quittiert.“"
                            },
                            {
                                "example_id": "9f4e1443-932e-4065-993c-9b2eda9aaa93",
                                "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                                "text": "„Die Straftaten gegen die Ehre weisen insofern eine Erheblichkeitsgrenze auf, als nicht jede den Geltungsanspruch einer Person berührende Äußerung, insbesondere bloße Unhöflichkeiten oder Distanzlosigkeiten, sondern nur der Ausdruck der Missachtung oder Geringschätzung ausreicht und damit der Bereich elementarer menschlicher Unzulänglichkeiten betroffen sein muss.“"
                            },
                            {
                                "example_id": "5ac310ff-967f-46f1-84d9-ce65e6dc4306",
                                "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                                "text": "„Verstärkt wird dies durch Akte der Beschämung durch andere Menschen: Gesten der Rangverminderung, Relevanzmissachtung, Distanzlosigkeiten und Grenzüberschreitungen, deren Opfer jemand wird.“"
                            },
                            {
                                "example_id": "714bbe2e-c57e-4b35-af8f-6584a94570fd",
                                "sense_id": "3d2f63f0-9f4c-30aa-bfaf-334972a2843c",
                                "text": "„Denn rund um den Truppenübungsplatz Munster waren bereits in den Jahren vor den Eskapaden der Wanderwölfin aus Kapitel 2 immer wieder einige Tier [sic!] durch Distanzlosigkeiten aufgefallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
