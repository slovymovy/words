                ],
                "senses": [
                    {
                        "sense_id": "d6235cac-86ba-3d76-b0c7-9e4ee6b523ed",
                        "entry_id": "9942ee62-7dfb-3a1a-9f79-435284366c05",
                        "glosses": [
                            "nichts, nix"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b18bd0b5-ee80-4a6e-b14b-12346077194f",
                                "sense_id": "d6235cac-86ba-3d76-b0c7-9e4ee6b523ed",
                                "text": "« Ils exigent pour un travail […] d’être payés en dévises. Sinon oualou ! »",
                                "translation": "„Sie fordern für eine Arbeit […] in Devisen bezahlt zu werden. Wenn nicht [läuft hier] nix!“"
                            },
                            {
                                "example_id": "a3a187cf-b882-4f18-bfe5-56f5eef195ce",
                                "sense_id": "d6235cac-86ba-3d76-b0c7-9e4ee6b523ed",
                                "text": "« Mais le citoyen qui déclare ne plus l’être, qui ne reconnaît ni destour, ni oualou, lui l’informel qui fait dans l’informel, qui trabendise tout et plus, qui gruge tout le monde. »",
                                "translation": "„Doch der Bürger, der angibt keiner mehr zu sein, der weder Winkelzüge noch [sonst] nichts (er-)kennt, er, der Informelle, der in Informelles macht, der um alles und mehr feilscht und schachert, der alle Welt ausnimmt.“"
                            },
                            {
                                "example_id": "0f38d11b-54f8-4afa-b636-c9331c98f76a",
                                "sense_id": "d6235cac-86ba-3d76-b0c7-9e4ee6b523ed",
                                "text": "« Rien n’a filtré de cet entretien, oualou ! »",
                                "translation": "„Nichts ist von dieser Unterredung durchgesickert, nix – nada – niente!“"
                            },
                            {
                                "example_id": "4bd1e8c8-98b7-4e01-8380-a31e095d82d7",
                                "sense_id": "d6235cac-86ba-3d76-b0c7-9e4ee6b523ed",
                                "text": "« Le douar n’a pas beaucoup changé depuis l’ère coloniale. Exemple : téléphone connaît pas ! Infrastructure médicale, oualou ! Taux de déperdition scolaire: 60 à 80 %. »",
                                "translation": "„Der Duar hat sich seit der Kolonialzeit nicht viel verändert. Beispiel: Telefon kennt [man] nicht/[ist] unbekannt! Medizinische Versorgung, nicht mal im Ansatz [vorhanden]! Quote des Schulsterbens: 60 auf 80 %.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
