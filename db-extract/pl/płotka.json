                ],
                "senses": [
                    {
                        "sense_id": "173314d4-e1c7-3ee2-ad45-3ebfc14f7e5b",
                        "entry_id": "0c1a4ea2-e05d-3aab-8c6d-8e68fc463db4",
                        "glosses": [
                            "płoć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e08d39b-ca11-47fc-90bb-45c7963da592",
                                "sense_id": "173314d4-e1c7-3ee2-ad45-3ebfc14f7e5b",
                                "text": "Wiedział, gdzie najłatwiej poławiają się kiełby i płotki lub w największej obfitości mieszkają szczupaki, u jakich brzegów raki najgęściej obsiadują podwodne mchy i kamienie, w jakiej porze dnia i roku jakie gatunki ryb na jakie biorą się przynęty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "77a495c0-4a45-3781-9386-e5a914ba8560",
                        "entry_id": "0c1a4ea2-e05d-3aab-8c6d-8e68fc463db4",
                        "glosses": [
                            "osoba niewiele znacząca"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b6f15d5-3cd7-4e63-98a2-ef423b6a12f2",
                        "source_entry_id": "0c1a4ea2-e05d-3aab-8c6d-8e68fc463db4",
                        "source_sense_id": "77a495c0-4a45-3781-9386-e5a914ba8560",
                        "target_lang_word": "small fry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small fry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11855c5c-4470-35ce-b8a0-946fcebf3e8a",
                                        "entry_id": "71a16a07-26a4-397b-92a2-9e1b660f78aa",
                                        "glosses": [
                                            "One or more small or immature fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69ad82f0-9164-3160-95b2-04d5e1a54bba",
                                        "entry_id": "71a16a07-26a4-397b-92a2-9e1b660f78aa",
                                        "glosses": [
                                            "One or more children."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f5d319-f04e-4fb5-9d17-ae20060cc360",
                                                "sense_id": "69ad82f0-9164-3160-95b2-04d5e1a54bba",
                                                "text": "After his death in 1950, his widow and a board of trustees who were left with responsibility of running the cranberry plant decided to continue the miniature railway's services to the \"small fry\", and it opened as usual on December 6, 1951."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba392a1-44e3-34fb-bb26-83863ff1001a",
                                        "entry_id": "71a16a07-26a4-397b-92a2-9e1b660f78aa",
                                        "glosses": [
                                            "One or more relatively small and insignificant individuals or things of relatively little consequence, importance, or value."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40cc9f9-032d-4d40-9304-ea555ff23020",
                                                "sense_id": "4ba392a1-44e3-34fb-bb26-83863ff1001a",
                                                "text": "These slot machines are just the small fry. The big games are in the back room."
                                            },
                                            {
                                                "example_id": "61be0ec2-ed4a-4dda-aca2-b8ebb524860f",
                                                "sense_id": "4ba392a1-44e3-34fb-bb26-83863ff1001a",
                                                "text": "The police did not arrest the drug dealer since he was a small fry compared to his boss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3930f60b-8bc4-4202-89e0-45883b5c3dec",
                        "source_entry_id": "0c1a4ea2-e05d-3aab-8c6d-8e68fc463db4",
                        "source_sense_id": "77a495c0-4a45-3781-9386-e5a914ba8560",
                        "target_lang_word": "kleiner Fisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kleiner Fisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                        "entry_id": "f9b6db74-2434-35fe-be28-f2d25eec4073",
                                        "glosses": [
                                            "Person, Sache oder Angelegenheit von geringer Bedeutung, seltener: von geringem Wert; überwiegend abwertend, aber auch positiv gewertet"
                                        ],
                                        "tags": [
                                            "wertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b78308c-8fb5-4f27-b4cf-d416f8e077dc",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "„Allerdings dürfe man Burda keine Vorwürfe machen: Der Verlag sei ‚auf dem Weltmarkt nur ein kleiner Fisch‘ und müsse ‚aufpassen, nicht selbst zum Übernahmekandidaten zu werden‘.“"
                                            },
                                            {
                                                "example_id": "7447413e-8b46-4766-8b52-f4a3363a66a1",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "„Ein Verfassungsschützer hatte sich vorsichtiger geäußert. Schapper sagte, er habe Kurnaz schon 2002 ‚nicht für einen großen Fisch gehalten, sondern eher für einen kleinen\"‘.“"
                                            },
                                            {
                                                "example_id": "dda8aacc-adb3-4219-b83f-9a59e7a97d8d",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "Das sind kleine Fische!"
                                            },
                                            {
                                                "example_id": "4efd64b9-30c2-483f-9607-6ae966848716",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "„Hauptthema ist der Klimaschutz. Und dabei geht es nicht um so vergleichsweise kleine Fische wie das Tempolimit, sondern um die gravierenden Unterschiede bei den Zielen, wie und wann Deutschland klimaneutral wird.“"
                                            },
                                            {
                                                "example_id": "9bf0215f-d44b-4548-9fa1-9e5facfe0637",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "„Die kürzlich erfolgten Festnahmen islamistischer Aktivisten überzeugen niemanden, denn sie sollen bloss kleine Fische betreffen, die erfahrungsgemäss bald wieder auf freien Fuss gesetzt würden.“"
                                            },
                                            {
                                                "example_id": "c0c4c618-d385-445f-9c91-a74c2294ac1a",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "„Den Bau des Jugendzentrums schreibt er sich ebenso auf seine Fahne wie die kostenfreie Nutzung des Ballenhauses für Vereine […]. ‚Das sind kleine Fische, die man erkämpfen musste.‘“"
                                            },
                                            {
                                                "example_id": "713ce97a-c761-46bf-87cb-b59a4dbc15cf",
                                                "sense_id": "21f6483a-43e5-30a9-95d3-88af9a05eb05",
                                                "text": "(positiv) „Mal ein kleiner Fisch zu sein, keine Reaktionen zu bekommen, das hat mir gut getan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
