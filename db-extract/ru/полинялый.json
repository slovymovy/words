                                        "sense_id": "4cfc497a-7301-3025-bf88-bfc6fdd71b98",
                                        "entry_id": "7597f63d-f737-35a0-b2ae-449a5f86f4b3",
                                        "glosses": [
                                            "That has lost some of its former vividness and colour."
