                        "cross_references": [
                            {
                                "target_word": "biologe",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd8e6a0-de3c-347d-8878-bce07456a999",
                                        "entry_id": "95e3a4bb-e8ff-3872-a282-3082d594abe1",
                                        "glosses": [
                                            "een vrouwelijke bioloog"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64afb0d5-1cff-48f7-86d0-0fcc8ead4f15",
                                                "sense_id": "1cd8e6a0-de3c-347d-8878-bce07456a999",
                                                "text": "‘Ook de Engelse biologe Jane Goodall zei al: “Op een dag zullen we terugkijken op deze donkere bladzijde in de geschiedenis van onze landbouw en het hoofd schudden. Hoe hebben we ooit kunnen geloven dat het een goed idee was om ons voedsel te produceren met gif?”"
                                            },
                                            {
                                                "example_id": "cc898c00-2a72-4058-a712-c216c0a97a62",
                                                "sense_id": "1cd8e6a0-de3c-347d-8878-bce07456a999",
                                                "text": "De biologe hoopt nu dat de beelden kunnen bijdragen tot het onderzoek rond dit speciale gedrag bij walvissen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22969372-cfe2-47a3-a874-f1ec5dd6d4a0",
                        "source_entry_id": "ce53b8ec-d5b3-398e-992c-a5a5959b5e33",
                        "source_sense_id": "06588cf5-e0ad-31ca-a716-2500afb62425",
                        "target_lang_word": "Biologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                        "entry_id": "5bc20e27-97be-3d44-b9c3-d0029e3ab873",
                                        "glosses": [
                                            "Wissenschaftlerin, die sich mit belebter Natur (Biologie) beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27396f8f-1e8b-47b1-8a51-11561983c8cf",
                                                "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                                "text": "Zur Umweltverträglichkeitsprüfung wurde eine Biologin zu Rate gezogen."
                                            },
                                            {
                                                "example_id": "837103f2-e9c4-4d5e-a54f-a017c89b93b0",
                                                "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                                "text": "„Die beiden Biologinnen kartieren Trittspuren, nehmen Kotproben, schließlich dürfen sie einige Tiere mit Sendern ausstatten, um deren Bewegungen zu verfolgen.“"
                                            },
                                            {
                                                "example_id": "6bff3eb4-2b8a-4449-b5a6-62e9c9d8e42a",
                                                "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                                "text": "„Die Person, die so etwas behauptet, ist die Biologin Christiane Nüsslein-Volhard.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
