                "word": "Marion",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34b5b3bc-9dfc-3ad9-a1bf-d0d54901c36c",
                        "entry_id": "e67d2f8f-3b8d-3454-be7c-7ff7d502115d",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2e8e46-97de-477e-ac64-f16f0bbc2e5a",
                                "sense_id": "34b5b3bc-9dfc-3ad9-a1bf-d0d54901c36c",
                                "text": "Lorsqu'il est fatigué de rêver à Marion et au bonheur qui sera le leur, il songe à ceux qui, au cours de ces dernières années, l'ont aidé."
                            },
                            {
                                "example_id": "2648ed7d-8999-49c7-a1f0-8039792bf87d",
                                "sense_id": "34b5b3bc-9dfc-3ad9-a1bf-d0d54901c36c",
                                "text": "Je me suis entretenu avec Marion Rousse (la directrice de l’épreuve, NDLR)."
                            },
                            {
                                "example_id": "49ac309a-7053-43c2-9a2b-e42f05eebd10",
                                "sense_id": "34b5b3bc-9dfc-3ad9-a1bf-d0d54901c36c",
                                "text": "C’est volontairement que Marion Richoux et moi avons écrit une histoire en forme de conte."
                            },
                            {
                                "example_id": "f35879b3-3141-4939-a372-e628302ff7ac",
                                "sense_id": "34b5b3bc-9dfc-3ad9-a1bf-d0d54901c36c",
                                "text": "On aurait pu faire de la monnaie en achetant une bimbeloterie, a dit Marion."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
