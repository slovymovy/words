                "senses": [
                    {
                        "sense_id": "c5f35e72-ba11-3515-a762-85e9e2593bcd",
                        "entry_id": "0bd4c7f1-5452-34b9-be0c-f5fc54ab64a5",
                        "glosses": [
                            "tevredenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19391a17-c813-4e60-ab90-b918b16696ce",
                                "sense_id": "c5f35e72-ba11-3515-a762-85e9e2593bcd",
                                "text": "Liefdadigheidswerk geeft zeer veel voldoening."
                            },
                            {
                                "example_id": "ba2e31b8-cd0e-4005-91e1-0fdb4d25bce0",
                                "sense_id": "c5f35e72-ba11-3515-a762-85e9e2593bcd",
                                "text": "Hij noemt Boer \"een grootheid van wie ik het meest heb kunnen leren\". Van de Laar: \"Zijn belangrijkste kenmerk was zijn liefde voor natuur. Daar haalde hij energie en voldoening uit en dat liet hij terugzien op het bord.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bcc0707-4aae-41b7-b73b-e19e1bcfb669",
                        "source_entry_id": "0bd4c7f1-5452-34b9-be0c-f5fc54ab64a5",
                        "source_sense_id": "c5f35e72-ba11-3515-a762-85e9e2593bcd",
                        "source_sense_description": "tevredenheid",
                        "target_lang_word": "satisfaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satisfaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A fulfilment of a need or desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32d0a7f-19ee-4357-8326-5dd3b50c5f2b",
                                                "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The pleasure obtained by such fulfillment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34259c4-c60b-473a-b42b-035929ff20c6",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "November 4, 1860, Henry David Thoreau, letter to Mr. D. R.\nThis life is not for complaint, but for satisfaction."
                                            },
                                            {
                                                "example_id": "7a9e0a5b-44e7-49bf-b2ac-5f1e4220978c",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "Selwyn, sitting up rumpled and cross-legged on the floor, after having boloed Drina to everybody's exquisite satisfaction, looked around at the sudden rustle of skirts to catch a glimpse of a vanishing figure—a glimmer of ruddy hair and the white curve of a youthful face, half-buried in a muff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bff076-83ba-3c86-81dd-8118a07497aa",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The source of such gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa560a67-e08d-308f-8633-5a534f01305a",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A reparation for an injury or loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A vindication for a wrong suffered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8dc26fd-bb59-431c-b7cb-fc84dded6dc9",
                                                "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                                "text": "The count demanded satisfaction in the form of a duel at dawn."
                                            },
                                            {
                                                "example_id": "60be5258-092d-487b-97d8-22cbc0f91c48",
                                                "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70eaccc-c774-3e97-90ae-2d4d43b7a16d",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "Sexual pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f8e87f0-53e0-4937-ba26-ab7866e2060f",
                                                "sense_id": "a70eaccc-c774-3e97-90ae-2d4d43b7a16d",
                                                "text": "To young man who enjoys receiving oral satisfaction, this BiWM will give you all you want."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e392d400-7a9a-4a57-a484-3a5e30051da7",
                        "source_entry_id": "0bd4c7f1-5452-34b9-be0c-f5fc54ab64a5",
                        "source_sense_id": "c5f35e72-ba11-3515-a762-85e9e2593bcd",
                        "source_sense_description": "tevredenheid",
                        "target_lang_word": "satisfaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satisfaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Contentement, plaisir que nous éprouvons quand les choses sont telles que nous pouvons les souhaiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5e510d-8c84-4990-8521-9811874399f6",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "À plusieurs reprises, il s’était frotté joyeusement les mains, ce qui, chez lui, ne pouvait passer pour une satisfaction banale."
                                            },
                                            {
                                                "example_id": "921ff455-b957-4587-be79-0b4aed2d239f",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Et il savait que la satisfaction de ses désirs d’un moment ne méritait point qu’il s’engageât toute sa vie."
                                            },
                                            {
                                                "example_id": "8e3940a8-8e0d-409d-a389-7d1ef1914bec",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Vois-tu, dans le monde entier, question rigolade et satisfaction, il n’y a que Paris qui compte, et dans Paris, Montmartre."
                                            },
                                            {
                                                "example_id": "5f115236-b8c5-4369-b259-a112730405c9",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Ce prologue le fatiguait, mais il ne pouvait l’écourter. L’éloquence fait partie de la fonction ; et il en avait trop complaisamment composé les périodes pour se priver de la satisfaction de s’entendre les phraser et de jouir de ces cadences étudiées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Réponse à un besoin de sorte qu’il ne soit plus nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9686134b-48f0-44eb-afb9-460c22772cb2",
                                                "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                                "text": "Satisfaction des besoins naturels."
                                            },
                                            {
                                                "example_id": "53860a98-f80a-4bbf-bbd1-5dbd405b5f41",
                                                "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                                "text": "Attendu que la société Cometik fait grief à l’arrêt d’anéantir les effets du contrat, de la condamner à rembourser à Mme X... les sommes par elle versées en exécution de celui-ci et de rejeter ses demandes, alors, selon le moyen, que l’objet d’un contrat entre dans le champ de l’activité principale du professionnel lorsqu’il participe à la satisfaction des besoins de l’activité professionnelle ; que la cour d’appel a elle-même retenu que le contrat conclu le 17 juillet 2014 par Mme X... portait « notamment sur la création d’un site Internet dédié à son activité » ; qu’en retenant pourtant que ce contrat n’entre pas dans le champ de l’activité principale du professionnel, la cour d’appel n’a pas tiré les conséquences légales de ses propres constatations et a violé l’article L. 121-16-1, III, du code de la consommation, dans sa rédaction applicable en la cause ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Action de satisfaire quelqu’un en réparation de l’offense qu’on lui a faite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e652c61e-54cf-4212-8ba2-d8dbf784fca2",
                                                "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                                                "text": "Il faut que la satisfaction soit proportionnée à l’offense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Ce qu’on est obligé de faire à l’égard de Dieu, en réparation des péchés qu’on a commis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03046292-1163-4eb8-b06d-1369e6251ebf",
                                                "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                                                "text": "La satisfaction fait partie du sacrement de Pénitence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
