                "translations": [
                    {
                        "translation_id": "9afd1841-2056-4610-abea-415754098e9f",
                        "source_entry_id": "706e5c18-df26-347b-a97a-5e70cbd98cbc",
                        "source_sense_id": "f4043405-596c-33b4-af60-e6cf3300597c",
                        "target_lang_word": "гвардейский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гвардейский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c21e4d88-2c5d-37d6-a1a0-6e5387e764dc",
                                        "entry_id": "41c79a01-2a8a-3f92-acd2-6e988d615da9",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительными гвардия, гвардеец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db36ab9-ceeb-425d-bd4e-37cb87757ddd",
                                                "sense_id": "c21e4d88-2c5d-37d6-a1a0-6e5387e764dc",
                                                "text": "Спор мой с гвардейским полканом прерван был приездом его превосходительства."
                                            },
                                            {
                                                "example_id": "b1fb0f51-679b-4fe3-a5ec-28f3d90f45ac",
                                                "sense_id": "c21e4d88-2c5d-37d6-a1a0-6e5387e764dc",
                                                "text": "Он был не в состоянии думать о своих делах, хозяйственных распоряжениях, и Егоровна увидела необходимость уведомить обо всём молодого Дубровского, служившего в одном из гвардейских пехотных полков и находящегося в то время в Петербурге."
                                            },
                                            {
                                                "example_id": "7b3517ca-bc9b-4d44-a0b9-cc074b61f691",
                                                "sense_id": "c21e4d88-2c5d-37d6-a1a0-6e5387e764dc",
                                                "text": ".. кирасиры, кавалергарды, конногвардейцы и гвардейские гусары, выплывали легко в мутной пене потревоженного Города."
                                            },
                                            {
                                                "example_id": "0d4bdac6-4d9e-4638-a5f0-da38d6c37f0f",
                                                "sense_id": "c21e4d88-2c5d-37d6-a1a0-6e5387e764dc",
                                                "text": "Но Эльбинга, через нашу 5-ю гвардейскую танковую армию, немцы не достигли, ― лишь на четыре дня захватили территорию от Мюльхаузена до Либштадта."
                                            },
                                            {
                                                "example_id": "69186acc-a41c-43c5-8c56-ead12eebdc57",
                                                "sense_id": "c21e4d88-2c5d-37d6-a1a0-6e5387e764dc",
                                                "text": "Сегодня по указу Путина 64-й отдельной мотострелковой бригаде было присвоено почётное наименование «гвардейская»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963a6173-3732-31d4-8c03-3c6cb8e01511",
                                        "entry_id": "41c79a01-2a8a-3f92-acd2-6e988d615da9",
                                        "glosses": [
                                            "свойственный гвардейцам, характерный для них"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb4a8df-0f1e-43ea-a345-6220cd8b3e7b",
                                                "sense_id": "963a6173-3732-31d4-8c03-3c6cb8e01511",
                                                "text": "У одного из вагонов, — стоял немолодой красноармеец, издали обративший на себя внимание Сабурова гвардейской выправкой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
