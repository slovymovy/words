                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aee68d9-d7ed-4cd3-9d6c-81c9da240f63",
                                "sense_id": "ec76dd04-d75f-3ec6-a43a-30984c7a856f",
                                "text": "„Während Bridas Ingenieure stundenlang mit afghanischen Stammesoberhäuptern in der Wüste Tee tranken, wenn sie die Routen erkundeten, flogen die Manager von Unocal ein und aus und nahmen einfach hin, was sie von den wankelmütigen afghanischen Kriegsherren zu hören bekamen.“"
                            },
                            {
                                "example_id": "99d624dc-c035-44f4-9639-1bc7c5d63b93",
                                "sense_id": "ec76dd04-d75f-3ec6-a43a-30984c7a856f",
                                "text": "„Er war der Sohn eines Stammesoberhaupts.“"
                            }
                        ],
