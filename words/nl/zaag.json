            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43293827-216e-302a-bd5e-fe5a05765317",
                    "sense_definition": "Een stuk gereedschap met een scherp, getand metalen blad om materialen zoals hout in stukken te verdelen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman pakte zijn <w>zaag</w> om de plank in tweeën te delen.",
                            "target_lang_translations": {
                                "ru": "Плотник взял свою <w>пилу</w>, чтобы распилить доску пополам.",
                                "en": "The carpenter grabbed his <w>saw</w> to split the plank in two.",
                                "fr": "Le menuisier a pris sa <w>scie</w> pour couper la planche en deux."
                            }
                        },
                        {
                            "text": "Pas goed op je vingers als je met een scherpe <w>zaag</w> werkt.",
                            "target_lang_translations": {
                                "ru": "Береги пальцы, когда работаешь острой <w>пилой</w>.",
                                "en": "Watch your fingers carefully when working with a sharp <w>saw</w>.",
                                "fr": "Fais bien attention à tes doigts quand tu travailles avec une <w>scie</w> tranchante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scherpe zaag",
                        "met de zaag",
                        "elektrische zaag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент с острым зубчатым металлическим лезвием для разрезания материалов, например дерева.",
                        "en": "A tool with a sharp, toothed metal blade used to divide materials such as wood into pieces.",
                        "fr": "Un outil doté d'une lame métallique tranchante et dentée, utilisé pour diviser des matériaux comme le bois en plusieurs morceaux."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пила",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "ножовка",
                                "target_lang_sense_clarification": "ручная пила"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "saw",
                                "target_lang_sense_clarification": "tool"
                            },
                            {
                                "target_lang_word": "handsaw",
                                "target_lang_sense_clarification": "manual tool"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "scie",
                                "target_lang_sense_clarification": "outil de coupe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44fb5945-3e58-3fb5-a7ae-0a7ffa0763b0",
                    "sense_definition": "Een persoon, vaak een vrouw, die voortdurend zeurt of klaagt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn buurvrouw is een echte <w>zaag</w> die over alles klaagt.",
                            "target_lang_translations": {
                                "ru": "Моя соседка — настоящая <w>зануда</w>, которая жалуется на всё.",
                                "en": "My neighbor is a real <w>nag</w> who complains about everything.",
                                "fr": "Ma voisine est une vraie <w>casse-pieds</w> qui se plaint de tout."
                            }
                        },
                        {
                            "text": "Luister niet naar die oude <w>zaag</w>, ze is nooit tevreden.",
                            "target_lang_translations": {
                                "ru": "Не слушай эту старую <w>ворчунью</w>, она никогда не бывает довольна.",
                                "en": "Don't listen to that old <w>bore</w>, she is never satisfied.",
                                "fr": "N'écoute pas cette vieille <w>rabat-joie</w>, elle n'est jamais satisfaite."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeur",
                        "zanikster"
                    ],
                    "common_phrases": [
                        "oude zaag",
                        "wat een zaag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, часто женщина, который постоянно ноет или жалуется.",
                        "en": "A person, often a woman, who constantly nags or complains.",
                        "fr": "Une personne, souvent une femme, qui est constamment ennuyeuse, plaintive ou importune."
