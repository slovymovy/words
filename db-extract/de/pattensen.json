                        "sense_id": "dbb6ee39-299d-33e1-aa18-1c5554afad87",
                        "entry_id": "123322b6-3b77-35be-8b76-e0d15c2ee9ee",
                        "glosses": [
                            "(Klein-)Stadt im Süden der Region Hannover in Niedersachsen"
