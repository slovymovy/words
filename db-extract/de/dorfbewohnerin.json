                                    {
                                        "sense_id": "d464f375-093a-344b-9af9-891bbe12f1cb",
                                        "entry_id": "3e8c2b86-07b5-3d13-8dde-2b2205b5c830",
                                        "glosses": [
                                            "vrouw die in een dorp woont"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bbe72b3-272f-4eba-a24e-d991be74bddc",
                                                "sense_id": "d464f375-093a-344b-9af9-891bbe12f1cb",
                                                "text": "De vernieling van het honderd jaar oude fresco in Borja was vorig jaar wereldnieuws. De 81-jarige dorpsbewoonster Cecilia Giménez voelde zich geroepen om het fresco met een afbeelding van Jezus Christus op te knappen omdat de verf afbrokkelde."
                                            },
                                            {
                                                "example_id": "5eaa0ad7-dc0b-41d5-8195-b2c1a9ec17d3",
                                                "sense_id": "d464f375-093a-344b-9af9-891bbe12f1cb",
                                                "text": "Een team van experts is begonnen met het onderzoeken van het vernielde fresco in het Spaanse dorp Borja. Vorige week deed een dorpsbewoonster een poging om de muurschildering te restaureren, maar dat liep uit op een ramp."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
