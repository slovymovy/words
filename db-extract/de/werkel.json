                                    {
                                        "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                        "entry_id": "727d19f1-6bf5-38bc-bc11-3d1ce1408d14",
                                        "glosses": [
                                            "Appareil mécanique qui produit de la musique à partir de cartes perforées, dans des tuyaux d’orgue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b215aa4-67bf-4acb-9ca8-a8f58638ca49",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "Il signala à leur attention un orgue de Barbarie, dont il se mit, en leur honneur, à tourner la manivelle. Les sons étaient assez agréables, mais le mécanisme paraissait endommagé."
                                            },
                                            {
                                                "example_id": "935c80e6-4082-4520-90e8-6777e664dc95",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "Ces vieux sages consommés ne s’émouvaient de rien. Le monde était pour eux un orgue de Barbarie qui se répète."
                                            },
                                            {
                                                "example_id": "708f1b29-ab94-4167-a2f4-6d78083070de",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "Là-bas, dans le fond, Blagsmith tournait sa manivelle avec autant de quiétude que s’il eût joué le Yankie Doodle sur un orgue de Barbarie."
                                            },
                                            {
                                                "example_id": "54594796-4516-4774-ad0f-46a4ca6b0c84",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "On entendait les sons pleurards de l’orgue de Barbarie, arrivant par bouffées, avec le vent ; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
