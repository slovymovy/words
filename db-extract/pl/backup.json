                "translations": [
                    {
                        "translation_id": "0a3c9a30-1f32-4dbf-b6a3-6b5dd5e24b40",
                        "source_entry_id": "0bf6472d-ee74-3116-af55-97698df8a357",
                        "source_sense_id": "251d2eaf-605b-3649-9e1d-2a8d9a3e09b1",
                        "target_lang_word": "backup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e95da3a-9195-39c0-82a1-06841d3c8325",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "A reserve or substitute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5a9ac1-5ab7-4386-86d4-fc845ceccaaa",
                                                "sense_id": "7e95da3a-9195-39c0-82a1-06841d3c8325",
                                                "text": "If the goalkeeper is injured, we have a backup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90fb0247-38d5-3b3c-b012-17eb0736f5b1",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "A copy of a file or record, stored separately from the original, that can be used to recover the original if it is damaged or destroyed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc6ff81-3232-477e-bf8f-d722767a6cca",
                                                "sense_id": "90fb0247-38d5-3b3c-b012-17eb0736f5b1",
                                                "text": "After the power failure, we had to restore the database from backup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef090b3a-3fef-3519-a58c-01a836a2127e",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "An accumulation of material caused by a (partial) obstruction or (complete) blockage of the flow or movement of the material, or an accumulation of material that causes an overflow due to the flow being greater than the maximum possible flow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3640f1-7784-4714-a7dc-99c96f992ce1",
                                                "sense_id": "ef090b3a-3fef-3519-a58c-01a836a2127e",
                                                "text": "The accident caused a mile-long backup on the highway."
                                            },
                                            {
                                                "example_id": "7b8dd99d-71e1-4aef-b4ff-fc256fb5cec7",
                                                "sense_id": "ef090b3a-3fef-3519-a58c-01a836a2127e",
                                                "text": "The blockage caused a backup in the plumbing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b83121-74bb-30f0-acf6-83c0d08b8abb",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "Reinforcements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf05cdf-deb1-4803-b642-15f2be97443a",
                                                "sense_id": "f9b83121-74bb-30f0-acf6-83c0d08b8abb",
                                                "text": "He's got a gun! You'd better send for backup."
                                            },
                                            {
                                                "example_id": "ce9e307a-0dce-4ee6-b3e2-182977baa30d",
                                                "sense_id": "f9b83121-74bb-30f0-acf6-83c0d08b8abb",
                                                "text": "Shaman: My patience is tested, but Uvenk invokes correctly. Grunt, who is your krantt? Your allies willing to kill and die on your behalf?\nShepard: How is a candidate tested if he brings backup on his Rite of Passage?\nShaman: Not every krogan can be the strongest warrior, but each must inspire his peers to battle at his side.\nShaman: If the ones who know you best can find nothing worthy in you, you should wander the wastes and die alone before you weaken my clan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95b2bb2-c948-3ae3-bef1-2ac9f3d2f510",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "Any support or extra help."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18ff2d89-1374-36cb-b6af-7be0da4b6c84",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "Accompaniment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233eeaa2-450a-46ad-8205-a2a5759ed6a6",
                                                "sense_id": "18ff2d89-1374-36cb-b6af-7be0da4b6c84",
                                                "text": "Debbie Ahn, on piano, provided some mesmerizing back-up and many fiery, on-target solos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f33e0e-0f6f-3938-8ac7-568a8fecaabb",
                                        "entry_id": "97ff15b8-7584-333f-b13d-cf07041ae15d",
                                        "glosses": [
                                            "Corroboration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eee150-7971-49c4-9470-fa90bafe6710",
                                                "sense_id": "81f33e0e-0f6f-3938-8ac7-568a8fecaabb",
                                                "text": "Pg. 206 on Yudit's comments on the feminists of Tel Aviv, \"... and now they are translating Our Bodies Ourselves into Hebrew, leaving out the section on gays\" was misinformed, a statement made without authoratative ^([sic]) backup in 1979 about a book first published in 1982."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "143505e7-f309-3835-8625-313949d1a5eb",
                                        "entry_id": "4187f060-3727-3678-a5b5-9caa00e56124",
                                        "glosses": [
                                            "Standby, reserve or extra."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e546a6-5090-4ca6-ae2f-b6ac1d9f1fb6",
                                                "sense_id": "143505e7-f309-3835-8625-313949d1a5eb",
                                                "text": "I am only a backup player."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1365f2cb-a4bb-336c-9acd-39bf08a427df",
                                        "entry_id": "4187f060-3727-3678-a5b5-9caa00e56124",
                                        "glosses": [
                                            "That is intended as a backup."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c098c2-66d6-475b-a8a6-8365375317cc",
                                                "sense_id": "1365f2cb-a4bb-336c-9acd-39bf08a427df",
                                                "text": "Make a backup copy of that file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d2cfbe-54f1-3d5e-b6e6-9a1dfd4216be",
                                        "entry_id": "4187f060-3727-3678-a5b5-9caa00e56124",
                                        "glosses": [
                                            "Supporting, reinforcing; (music) of or related to accompaniment"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "backup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1534a4-e8ba-3ebb-9c03-0fc0a1adb65c",
                                        "entry_id": "2b00b60d-bc9f-3d21-8b79-846dcc903052",
                                        "glosses": [
                                            "Alternative form of back up."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b1fd7c3-3c52-49ff-87f8-565457dc80e5",
                                                "sense_id": "8f1534a4-e8ba-3ebb-9c03-0fc0a1adb65c",
                                                "text": "We have two methods for backupping: the first one is writing the contents of disks onto magnetic tapes and the other is making a copy of the contents of disks on the disk of the mainframe computers of the laboratory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f63fcc46-a02b-44c7-a307-dbacff28de49",
                        "source_entry_id": "0bf6472d-ee74-3116-af55-97698df8a357",
                        "source_sense_id": "251d2eaf-605b-3649-9e1d-2a8d9a3e09b1",
                        "target_lang_word": "Backup",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backup",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a228a047-91c4-31c3-a389-aac330f271b9",
                                        "entry_id": "b4b8729d-1890-3d3b-bce2-81b4a8bae40c",
                                        "glosses": [
                                            "Abbild eines (Daten-)Speichers mit dem Zweck, den Inhalt dessen, falls er beschädigt oder zerstört worden ist, wiederherzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6885645-a21f-4eb9-b1ba-484c14a8f6a0",
                                                "sense_id": "a228a047-91c4-31c3-a389-aac330f271b9",
                                                "text": "Ein Virus hat meinen Computer zerstört, nun muss ich meine Festplatte mithilfe des Backups wiederherstellen."
                                            },
                                            {
                                                "example_id": "37a2311d-ba75-43a2-b49f-54f3e954c853",
                                                "sense_id": "a228a047-91c4-31c3-a389-aac330f271b9",
                                                "text": "„Wir Deutsche befinden uns in der glücklichen Lage, Alltagskrempel wie Router, Backups und Smartphones aus einem unerschöpflichen Spezialwortschatz zu benennen, den Dichte nicht anrühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Backup",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                        "entry_id": "13fa0800-088c-379a-971e-bfeef8491bb7",
                                        "glosses": [
                                            "Mitglied einer Mannschaft, das im Bedarfsfall für den Stammspieler eingesetzt werden kann"
                                        ],
                                        "tags": [
                                            "Mannschaftssport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe9f326-eae1-434d-8295-bd2ec2d5fb65",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„Gleichzeitig versuchen die Patriots noch immer, Jimmy Garoppolo einsatzbereit zu bekommen, damit er als Backup fungieren kann.“"
                                            },
                                            {
                                                "example_id": "25b05098-1a2b-4c32-86a9-843c6f3b9240",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„Delaney, der zuletzt mit Lokomotiv Kuban Krasnodar ins Final Four der Euroleague stürmte und dort den dritten Rang belegte, soll bei den Atlanta Hawks als Backup für den deutschen Nationalspieler Dennis Schröder fungieren.“"
                                            },
                                            {
                                                "example_id": "a451e6af-c8e1-433b-aeaa-4837b737c2c4",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„Cassel war von 2005 bis 2008 die Nummer zwei hinter Brady und ist momentan als Backup von Marcus Mariota bei den Tennessee Titans aktiv.“"
                                            },
                                            {
                                                "example_id": "da5dc1a6-3ec4-4959-b73f-1ae0cc27c637",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„Die Pittsburgh Steelers aus der NFL haben Routinier Michael Vick als Backup für Quarterback Ben Roethlisberger verpflichtet.“"
                                            },
                                            {
                                                "example_id": "b519c777-bbc5-4064-9cfb-bc5fbcaf8867",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„Beim FC wird er die Rolle des Backups für Jonas Hector einnehmen, zu dem es bislang im Kader keinen gelernten Linksverteidiger als Alternative gab.“"
                                            },
                                            {
                                                "example_id": "573c7444-d87a-4b49-983e-4609f5e03619",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„»Natürlich kann ich Evars Klesniks in die Mitte ziehen«, stellt der HSG-Coach Gedankenspiele für die Defensive an, »aber dann fehlt mit Weber das Backup für ihn auf der Halbposition.«“"
                                            },
                                            {
                                                "example_id": "52d6471b-89d8-4c87-b6c3-4439619044d1",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„‚Sicherlich bin ich in erster Linie das Backup. […]‘“"
                                            },
                                            {
                                                "example_id": "2f81e41d-dcd8-4941-b4e0-112180246247",
                                                "sense_id": "3c5e7329-939e-3d11-9365-6dab6dae6088",
                                                "text": "„Niclas Pieczkowski (re.) ist das Backup für Rune Dahmke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
