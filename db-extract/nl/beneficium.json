                "senses": [
                    {
                        "sense_id": "9d4cd9e9-6ffd-3015-be78-5e991ad89593",
                        "entry_id": "dbc5cede-5ef7-3843-b165-a0038db6702a",
                        "glosses": [
                            "recht dat iemand ten opzichte van anderen in een voordeliger positie plaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e701481-d2fd-44ba-9208-c23aa9668e06",
                                "sense_id": "9d4cd9e9-6ffd-3015-be78-5e991ad89593",
                                "text": "Door anderen werd opgemerkt, dat een akkoord in zekeren zin altijd een beneficium voor den gefailleerde is; ware het anders, hij zou nooit een akkoord aanbieden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac8ad359-2ee3-37ae-90c7-41ead6c8251f",
                        "entry_id": "dbc5cede-5ef7-3843-b165-a0038db6702a",
                        "glosses": [
                            "opbrengst uit kerkelijke goederen als vergoeding voor een geestelijke bediening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8215da41-3604-449b-952c-02f516bfb2fc",
                                "sense_id": "ac8ad359-2ee3-37ae-90c7-41ead6c8251f",
                                "text": "De concurrentie was zwaar en veel geestelijken moesten volstaan met een eenvoudig beneficium zoals een kapellanie of levenslang genoegen nemen met de positie van deservitor of plaatsvervanger."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2603b42-9a58-36a6-8d6e-f88548cc0a54",
                        "entry_id": "dbc5cede-5ef7-3843-b165-a0038db6702a",
                        "glosses": [
                            "leengoed dat niet erfelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97acab29-3cfa-4d74-9922-b1533805cc66",
                                "sense_id": "f2603b42-9a58-36a6-8d6e-f88548cc0a54",
                                "text": "In Frankrijk was in de feodale tijd het woord 'honor' in gebruik, hetgeen verwees naar een door de koning toegekende staatsfunctie (graaf, hertog), met de daaraan verbonden rechtsbevoegdheden 'in naam van de koning'. Een rechtstreekse delegatie van bevoegdheden. Daaraan waren ook leengoederen verbonden die het mogelijk maakten de functie uit te oefenen (beneficium), maar die verbinding dateert waarschijnlijk uit de tijd waarin de koningen minder machtig werden (9de-10de eeuw)."
                            }
                        ]
                    }
