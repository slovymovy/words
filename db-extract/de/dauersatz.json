                ],
                "senses": [
                    {
                        "sense_id": "894c99da-faf0-3433-99fb-6b41ac83bb46",
                        "entry_id": "949af144-ffbd-3058-80ca-3ecf92dba458",
                        "glosses": [
                            "vielfach wiederholte Äußerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe154e9-3e8f-42d4-aa2f-53d2dc664c4d",
                                "sense_id": "894c99da-faf0-3433-99fb-6b41ac83bb46",
                                "text": "„Brüderchen und Schwesterchen sind einen Lebensbund eingegangen, ihr auf dem Motorrad herumbretterndes Reh (klar, Grimm geht anders) heißt Blochin, der unbehausbare Hauser mit den ängstlich aufgerissenen Augen und dem Dauersatz: „Ich muss noch mal weg.““"
                            },
                            {
                                "example_id": "7c70073d-bd2e-439b-ba9b-cc25e0d361e4",
                                "sense_id": "894c99da-faf0-3433-99fb-6b41ac83bb46",
                                "text": "„»Sie heiratet ja ohnedies – wozu braucht sie einen Beruf?« war damals der Dauersatz bildungsfeindlicher, weil ungebildeter Väter, und die Mütter stimmten dem zu, galt ihnen doch auch noch Ehe als einzige Daseinsberechtigung und Existenzvorsorge, wie unglücklich diese auch sein mochte.“"
                            },
                            {
                                "example_id": "39cdf51b-8c2c-41d1-860c-dfbf75a54830",
                                "sense_id": "894c99da-faf0-3433-99fb-6b41ac83bb46",
                                "text": "„Das gibt dem banalen Dauersatz des verstorbenen Gusseisenwerksbesitzers eine unerwartet anarchistische Wendung: Ende gut, alles gut.“"
                            },
                            {
                                "example_id": "3422437e-29be-4c02-9732-d4ecebc9922d",
                                "sense_id": "894c99da-faf0-3433-99fb-6b41ac83bb46",
                                "text": "„Einer ihrer Dauersätze war: Man lebt, man stirbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8e0e116-d10a-3361-af9c-f55b91316dd3",
                        "entry_id": "949af144-ffbd-3058-80ca-3ecf92dba458",
                        "glosses": [
                            "Äußerung, die auch ohne direkten, unmittelbaren Bezug zur Empirie als richtig angesehen wird"
                        ],
                        "tags": [
                            "Sprachphilosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "6d6fd1f6-6eb8-4884-b860-8576626447eb",
                                "sense_id": "c8e0e116-d10a-3361-af9c-f55b91316dd3",
                                "text": "„Um einiges problematischer für die Urübersetzung sind «standing sentences» (Dauersätze).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f0a67228-fae2-3730-b39c-31ee4db0d00e",
                        "entry_id": "949af144-ffbd-3058-80ca-3ecf92dba458",
                        "glosses": [
                            "Postwesen: Reihe thematisch und typographisch gleichartiger Briefmarken, die eine längere Zeit von der Post bereitgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227e5d7f-9a08-427b-8bd7-62c3f4de4e74",
                                "sense_id": "f0a67228-fae2-3730-b39c-31ee4db0d00e",
                                "text": "„Die 13 Marken des 1962 verausgabten Dauersatzes haben klassisch-griechische Motive, vorgriechische Motive, bzw. drei zypriotische Naturmotive, nämlich zwei Weinreben, eine Winterlandschaft des Troodosgebirges und die Abbildung eines Mufflon, des größten wildlebenden Tieres der Insel (das inzwischen wahrscheinlich ausgerottet ist).“"
                            },
                            {
                                "example_id": "a0010b4a-bad3-4ca8-aa77-774637e8c2ce",
                                "sense_id": "f0a67228-fae2-3730-b39c-31ee4db0d00e",
                                "text": "„So ist der 1947/48 in drei Besatzungszonen ausgegebene Dauersatz postfrisch nach \"Philex\" für ganze vier Mark zu haben.“"
                            },
                            {
                                "example_id": "41f9f4c0-6e7f-482b-b915-af078d1be804",
                                "sense_id": "f0a67228-fae2-3730-b39c-31ee4db0d00e",
                                "text": "„Seine teuersten Marken entstammten dem ersten Dauersatz der Bundesrepublik Deutschland, dessen Gesamtwert bei 2500 Euro liegt.“"
                            },
                            {
                                "example_id": "2a047488-db40-4c85-9adf-36181b9ddbe6",
                                "sense_id": "f0a67228-fae2-3730-b39c-31ee4db0d00e",
                                "text": "„Fünf von ihnen gehören zum Dauersatz »Deutsche Bauwerke aus zwölf Jahrhunderten«.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
