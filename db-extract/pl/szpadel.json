                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c02ff9b-831e-4c32-914f-3e52db3777c2",
                        "source_entry_id": "4f6918a9-b71c-3773-8102-74a5f6ab2e79",
                        "source_sense_id": "5d0cdc00-43c6-3fe8-9625-ff9a23d733c7",
