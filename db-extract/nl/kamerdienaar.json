                        "examples": [
                            {
                                "example_id": "c48cbe43-6ae2-4f47-a5f9-790d962eb531",
                                "sense_id": "8351b674-50ef-3eaa-a575-df3aa52ee97e",
                                "text": "MarjMarja Lvovna Karagina en haar dochter! kondigde in de deuropening van de salon de enorme kamerdienaar van de gravin met basstem aan."
                            },
                            {
                                "example_id": "eedb8356-288b-4add-9a54-2ffbdae3a2b6",
                                "sense_id": "8351b674-50ef-3eaa-a575-df3aa52ee97e",
                                "text": "Hoe kwetsbaar die suikerwerken waren, ondervond de stadhouder toen hij er eentje had meegenomen naar huis. \"Een onhandige kamerdienaar, die het op bevel van de prins was gaan halen om het ons te tonen, heeft het in duizend stukken op de grond laten vallen\", schreef zijn vrouw hun dochter later."
                            }
                        ]
                    }
