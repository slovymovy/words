                        "glosses": [
                            "langweiliger Schwätzer, oft mit frömmelndem oder sonstwie salbungsvollem Ton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fbb433-96d4-42ca-9d21-0ed981111260",
                                "sense_id": "bb06c80c-39ad-3aa5-8f5c-4d37712b13b6",
                                "text": "Das ist ja ein fürchterlicher Salbader!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "627fbcf7-0819-4636-834b-a7dc0e9ce45b",
                        "source_entry_id": "17ecc558-4b2f-3d97-bf3b-c1ed8310abfe",
                        "source_sense_id": "bb06c80c-39ad-3aa5-8f5c-4d37712b13b6",
                        "source_sense_description": "langweiliger Schwätzer, oft mit frömmelndem oder sonstwie salbungsvollem Ton",
                        "target_lang_word": "bavard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93ea6209-1921-352b-acd1-b7ffb2a67226",
                                        "entry_id": "ec5c4e7e-a3ca-35f6-9d18-11d3c89e2761",
                                        "glosses": [
                                            "Qui a l’habitude de bavarder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89ad9be-e47f-4d18-9e65-4dace2d78221",
                                                "sense_id": "93ea6209-1921-352b-acd1-b7ffb2a67226",
                                                "text": "Mettons dans la même classe les dialecticiens et les sophistes, gens qui font plus de bruit que tous les chaudrons de Dodone, et dont le moins babillard pourrait tenir tête aux vingt plus bavardes commères qu'on puisse trouver sous le ciel."
                                            },
                                            {
                                                "example_id": "29fc2fa2-92dd-4d34-97ab-bdcdcb8e6453",
                                                "sense_id": "93ea6209-1921-352b-acd1-b7ffb2a67226",
                                                "text": "Tout en procédant à sa toilette, elle parle toute seule, bavarde, gaie, animée, à cause qu’on est encore au printemps de la journée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bavard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11f8c97e-9880-345e-bcb9-841de99a4d5d",
                                        "entry_id": "af52d628-4346-3731-ad46-106ec1d56a4a",
                                        "glosses": [
                                            "Homme qui parle beaucoup"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47b11b1e-b9ff-4d2b-8120-158abc46dca9",
                                                "sense_id": "11f8c97e-9880-345e-bcb9-841de99a4d5d",
                                                "text": "Les autres s'accroupirent en cercle et quelques-uns se postèrent à mi–chemin du village pour que nul bavard indiscret ne vînt aux nouvelles avant de savoir ce qui motivait ce retour nocturne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7db6dd-7a3c-3a08-80ec-840aa073eb72",
                                        "entry_id": "af52d628-4346-3731-ad46-106ec1d56a4a",
                                        "glosses": [
                                            "Avocat."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6162d4bb-a512-40d2-978b-75d759f7f10f",
                                                "sense_id": "9b7db6dd-7a3c-3a08-80ec-840aa073eb72",
                                                "text": "Je dois aussi m'enfoncer dans la turbine les conseils de mes deux bavards – conseilleurs nabots –, qui ne sont pas du tout chaudards, du tout, pour me laisser balancer les vrais patronymes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "283780ec-79fe-3e1e-902e-06d8c43a37b3",
                                        "entry_id": "af52d628-4346-3731-ad46-106ec1d56a4a",
                                        "glosses": [
                                            "Chabot commun, poisson des rivières et lacs bien oxygénés."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f99288e-2d77-47b1-b397-e035ea78013f",
                        "source_entry_id": "17ecc558-4b2f-3d97-bf3b-c1ed8310abfe",
                        "source_sense_id": "bb06c80c-39ad-3aa5-8f5c-4d37712b13b6",
                        "source_sense_description": "langweiliger Schwätzer, oft mit frömmelndem oder sonstwie salbungsvollem Ton",
                        "target_lang_word": "raseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae2bd11e-18c1-37c8-93ef-487b1c0e0289",
                                        "entry_id": "317ff8e1-bb5d-30e6-8a5b-ea5c0a50eb06",
                                        "glosses": [
                                            "Employé dans une tannerie chargé de raser les peaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4eee780-dd24-3d2c-a67d-166097120662",
                                        "entry_id": "317ff8e1-bb5d-30e6-8a5b-ea5c0a50eb06",
                                        "glosses": [
                                            "Importun bavard."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0853d085-3c49-4956-a5a4-32e057659ef5",
                                                "sense_id": "b4eee780-dd24-3d2c-a67d-166097120662",
                                                "text": "Entre autres le doux Virgile […] lui apparaissait, ainsi que l’un des plus terribles cuistres, l’un des plus sinistres raseurs que l’antiquité ait jamais produits ."
                                            },
                                            {
                                                "example_id": "1350f1b1-1dbf-491b-a381-60ab3b2987d4",
                                                "sense_id": "b4eee780-dd24-3d2c-a67d-166097120662",
                                                "text": "Encore un raseur ! se dit Fandor, qui vient me demander une recommandation."
                                            },
                                            {
                                                "example_id": "9a6e29ad-4609-4c3d-bafb-614a171ff4d5",
                                                "sense_id": "b4eee780-dd24-3d2c-a67d-166097120662",
                                                "text": "Il songe à faire défiler sous les yeux de ses spectateurs toutes sortes de types de fâcheux, c’est-à-dire d’importuns, de gêneurs, de raseurs, de barbeurs, — le nom change, selon l’époque — mais ce genre de personnage reste toujours « fâcheux »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
