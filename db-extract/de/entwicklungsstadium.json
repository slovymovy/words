                            {
                                "example_id": "67d4b135-96af-4528-81ac-dd31bc484b6b",
                                "sense_id": "39db8c3d-2f9a-3f0f-bee5-9431848aa3b3",
                                "text": "„Spaltet sich der Embryo in einem wesentlich späteren Entwicklungsstadium, kann es zu einer unvollständigen Zerteilung der Keimscheibe und damit zu unvollständig getrennten Embryonen kommen.“"
                            },
                            {
                                "example_id": "947272f8-e059-4f1f-9077-f413c3251eec",
                                "sense_id": "39db8c3d-2f9a-3f0f-bee5-9431848aa3b3",
                                "text": "„Die Festlegung der Entwicklungsstadien von tropischen Wirbelstürmen erfolgt nach der Klassifikation von Dvorak.“"
                            }
                        ],
