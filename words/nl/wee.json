                {
                    "sense_id": "bd357b10-c794-30a7-b0e9-6af60e6f4313",
                    "sense_definition": "Een misselijkmakende of flauwe geur of smaak hebbend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geur_smaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hing een <w>weeë</w> geur in het oude gebouw.",
                            "target_lang_translations": {
                                "en": "There was a <w>sickly</w> smell hanging in the old building."
                            }
                        },
                        {
                            "text": "De <w>weeë</w> smaak van die vrucht vond ik niet lekker.",
                            "target_lang_translations": {
                                "en": "I did not like the <w>sickly</w> taste of that fruit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Having a sickly, faint, or nauseating smell or taste."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sickly",
                                "target_lang_sense_clarification": "describing a smell or taste that is unpleasant or nauseating"
                            },
                            {
                                "target_lang_word": "faint",
                                "target_lang_sense_clarification": "describing a weak or indistinct smell or taste"
                            }
                        ]
                    }
                }
            ]
        },
        {
