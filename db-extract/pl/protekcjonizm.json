                                "target_senses": [
                                    {
                                        "sense_id": "8030d7bb-18a1-36e9-9dac-29854521eab8",
                                        "entry_id": "1e499dba-e7f9-39f2-9bbf-04c188900712",
                                        "glosses": [
                                            "A system or policy of protecting the domestic producers of a product from foreign competition by imposing tariffs, quotas, duties or other barriers on importations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "094053e4-4d00-4c88-94d3-d0b51837ac8a",
                                                "sense_id": "8030d7bb-18a1-36e9-9dac-29854521eab8",
                                                "text": "Take the New Right's full-throated embrace of protectionism and industrial policy. This romance with protectionism started in the 1990s with former GOP presidential candidate Pat Buchanan, gained enormous traction under former President Donald Trump, and is still going strong today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380b0318-a6af-3656-8a68-8571e4cf5d82",
                                        "entry_id": "1e499dba-e7f9-39f2-9bbf-04c188900712",
                                        "glosses": [
                                            "Linguistic purism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2169e00-795c-4280-88f2-4de3a503c49f",
                        "source_entry_id": "a4445bce-4fe6-3268-b233-7a8ff808196d",
                        "source_sense_id": "133081b4-6a61-3e4e-b30c-4651ac4c8548",
                        "target_lang_word": "protectionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protectionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c80893e0-4fb0-3c16-b10a-042b615141a7",
                                        "entry_id": "4bd06628-6275-33e7-a034-d37efd9afc0f",
                                        "glosses": [
                                            "Système ayant pour objet de protéger le travail national et les productions nationales par des tarifs appliqués aux produits étrangers."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8315c878-1b47-435f-9811-8b8be286744d",
                                                "sense_id": "c80893e0-4fb0-3c16-b10a-042b615141a7",
                                                "text": "Le système de la réciprocité dans sa forme moderne est le fils aîné du protectionnisme ; s’il en adoucit légèrement les rigueurs, il est l’incarnation même de sa pensée."
                                            },
                                            {
                                                "example_id": "cd32afec-c070-4495-a2d2-30ef1819cd13",
                                                "sense_id": "c80893e0-4fb0-3c16-b10a-042b615141a7",
                                                "text": "Les vins étrangers l’emportent sur les vins français ; un protectionnisme outrancier oblige l’Anglais à se priver désormais des grands crus de la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7a8d37b-b61f-4205-ad97-5da930feba35",
                        "source_entry_id": "a4445bce-4fe6-3268-b233-7a8ff808196d",
