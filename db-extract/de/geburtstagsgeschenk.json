                    },
                    {
                        "form_id": "8a14e4b6-3c84-4594-8b17-ccd397f8d2f6",
                        "entry_id": "714e43d7-4274-3007-ab2b-7bef6e77d79c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Geburtstagsgeschenke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff9cb687-56fb-3064-ad11-51a95e2d0c4a",
                        "entry_id": "714e43d7-4274-3007-ab2b-7bef6e77d79c",
                        "glosses": [
                            "ein Geschenk, das traditionell zum Geburtstag einer Person überreicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633d40f9-bf7d-402a-93ff-763e6c6e4505",
                                "sense_id": "ff9cb687-56fb-3064-ad11-51a95e2d0c4a",
                                "text": "Er hat sich sehr gefreut über sein Geburtstagsgeschenk."
                            },
                            {
                                "example_id": "d3856d6c-137a-41fe-88cd-bc4b35227af1",
                                "sense_id": "ff9cb687-56fb-3064-ad11-51a95e2d0c4a",
                                "text": "„Napoleon wollte die Stadt als Geburtstagsgeschenk überreicht bekommen.“"
                            },
                            {
                                "example_id": "597bb91b-6708-4493-9a0e-d1c715e035c0",
                                "sense_id": "ff9cb687-56fb-3064-ad11-51a95e2d0c4a",
                                "text": "„Darauf bedankte sich Goldlotos für die Geburtstagsgeschenke.“"
                            },
                            {
                                "example_id": "a089d690-e922-4e25-aa04-330d6ed5b4a7",
                                "sense_id": "ff9cb687-56fb-3064-ad11-51a95e2d0c4a",
                                "text": "„Kein Mann soll sich jemals verpflichtet fühlen, einem anderen Mann ein Geburtstagsgeschenk zu kaufen, sogar sich an seinen Geburtstag zu erinnern, ist freiwillig.“"
                            },
                            {
                                "example_id": "819c7a9c-bdfd-44dc-9c0f-a5074de0ce1e",
                                "sense_id": "ff9cb687-56fb-3064-ad11-51a95e2d0c4a",
                                "text": "„Schuldbewusst wirft er erst eines seiner Geburtstagsgeschenke und dann einen Ball über den Zaun, doch da sind die Kinder schon fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
