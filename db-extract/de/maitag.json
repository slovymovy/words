                        "examples": [
                            {
                                "example_id": "692c78f2-7848-410b-b362-ff06739f7905",
                                "sense_id": "169e05ff-36f0-369b-8e9a-0e1f99b4d28f",
                                "text": "Milena kam an einem Maitag zum Kaffee vorbei."
                            },
                            {
                                "example_id": "f185576e-ee1f-4cc5-ad99-9e620a3e71b3",
                                "sense_id": "169e05ff-36f0-369b-8e9a-0e1f99b4d28f",
                                "text": "„Das war in Berlin gewesen in den ersten Maitagen des Jahres 1945.“"
                            },
                            {
                                "example_id": "d1b46d9d-b35f-4f31-a1d2-35d7f68ee528",
                                "sense_id": "169e05ff-36f0-369b-8e9a-0e1f99b4d28f",
                                "text": "„An einem der ersten warmen Maitage kam Mrs Harrison vollkommen aufgelöst in den Laden gestürzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
