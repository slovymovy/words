                            "comment": "rarely used as a noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, чему еще предстоит прибыть или случиться.",
                        "tr": "Henüz gerçekleşmemiş veya gelmemiş olan şey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грядущее",
                                "target_lang_sense_clarification": "будущие события"
                            },
                            {
                                "target_lang_word": "будущее",
                                "target_lang_sense_clarification": "то, что наступит"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelecek",
                                "target_lang_sense_clarification": "henüz yaşanmamış zaman"
                            },
                            {
                                "target_lang_word": "istikbal",
                                "target_lang_sense_clarification": "gelecek zaman dilimi"
                            }
                        ]
