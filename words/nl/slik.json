    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9865c1a9-755e-379e-a9b8-13c999c5b6ad",
                    "sense_definition": "Zachte, natte klei of modder, in het bijzonder in buitendijkse gebieden die bij vloed onderlopen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "modder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de wandeling langs de kust zat hij helemaal onder het <w>slik</w>.",
                            "target_lang_translations": {
                                "en": "After the walk along the coast, he was completely covered in <w>mud</w>."
                            }
                        },
                        {
                            "text": "De vogels zochten ijverig naar voedsel in het natte <w>slik</w> van de Waddenzee.",
                            "target_lang_translations": {
                                "en": "The birds were diligently searching for food in the wet <w>mudflats</w> of the Wadden Sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "slijk"
                    ],
                    "target_lang_definitions": {
                        "en": "Soft, wet clay or mud, especially in tidal areas that flood at high tide."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silt",
                                "target_lang_sense_clarification": "fine sand or clay carried by running water and deposited as a sediment"
                            },
                            {
                                "target_lang_word": "mud",
                                "target_lang_sense_clarification": "wet, soft earth"
                            },
                            {
                                "target_lang_word": "mudflat",
                                "target_lang_sense_clarification": "stretch of muddy land left uncovered at low tide"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34f4b7de-f314-31db-8ce5-4da24cc95e7c",
                    "sense_definition": "De handeling of beweging van het <w>slikken</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slikhandeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een moeizame <w>slik</w> kreeg hij de droge pil eindelijk door zijn keel.",
                            "target_lang_translations": {
                                "en": "With a difficult <w>swallow</w>, he finally got the dry pill down his throat."
                            }
                        },
                        {
                            "text": "Zijn keel deed zo'n pijn dat elke <w>slik</w> hem deed huiveren.",
                            "target_lang_translations": {
                                "en": "His throat hurt so much that every <w>swallow</w> made him shudder."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act or movement of swallowing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swallow",
                                "target_lang_sense_clarification": "the act of swallowing"
                            },
                            {
                                "target_lang_word": "gulp",
                                "target_lang_sense_clarification": "a large mouthful of food or drink swallowed hastily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d4d2db3-2af1-3b0f-9a52-84ad56d338de",
                    "sense_definition": "Een trekje aan een sigaret.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij nam nog snel een laatste <w>slik</w> van zijn sigaret voor hij de bus instapte.",
                            "target_lang_translations": {
                                "en": "He quickly took one last <w>puff</w> of his cigarette before boarding the bus."
                            }
                        },
                        {
                            "text": "Met een diepe <w>slik</w> blies hij de rook langzaam uit in de koude lucht.",
                            "target_lang_translations": {
                                "en": "With a deep <w>drag</w>, he slowly blew the smoke out into the cold air."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to refer to taking a puff of a cigarette."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A puff or drag of a cigarette."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "puff",
                                "target_lang_sense_clarification": "an act of inhaling smoke from a cigarette"
                            },
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "an inhalation of smoke from a cigarette"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80f07bd9-d1a1-31c4-afa0-805fdd3e5ced",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>slikken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>slik</w> elke ochtend trouw mijn vitamines met een glas water.",
                            "target_lang_translations": {
                                "en": "I faithfully <w>take</w> my vitamins every morning with a glass of water."
                            }
                        },
                        {
                            "text": "Ik <w>slik</w> deze belediging niet zomaar zonder er iets van te zeggen.",
                            "target_lang_translations": {
                                "en": "I won't just <w>stomach</w> this insult without saying something about it."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'slikken' (to swallow / to take pills / to accept/stomach something)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swallow",
                                "target_lang_sense_clarification": "first-person singular present of 'to swallow'"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "first-person singular present of 'to take' (medicine/pills)"
                            },
                            {
                                "target_lang_word": "stomach",
                                "target_lang_sense_clarification": "first-person singular present of 'to stomach' (an insult/situation)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a47dfed-ff09-3645-9c78-b887713301a3",
                    "sense_definition": "Gebiedende wijs van <w>slikken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Slik</w> die pil nu maar snel door, dan ben je er vanaf.",
                            "target_lang_translations": {
                                "en": "Just <w>swallow</w> that pill quickly, then you'll be done with it."
                            }
                        },
                        {
                            "text": "Kauw niet op die capsule, maar <w>slik</w> hem in één keer door.",
                            "target_lang_translations": {
                                "en": "Do not chew on that capsule, but <w>swallow</w> it whole."
                            }
