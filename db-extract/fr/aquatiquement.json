                        "examples": [
                            {
                                "example_id": "1d9679ea-b50c-45fe-9de2-3c4fb26684ff",
                                "sense_id": "8c035f21-b0b5-31af-99f9-12cc02ddcade",
                                "text": "Quantité d’oiseaux aquatiques\nSur ces rivages pacifiques,\nVoloient, nageoient joyeusement,\nEt chantoient aquatiquement."
                            },
                            {
                                "example_id": "155cc0c5-51e1-4d17-bc08-76ec9c7c409d",
                                "sense_id": "8c035f21-b0b5-31af-99f9-12cc02ddcade",
                                "text": "Braver, tout le jour, le froid, la grêle et la pluie, attendre aquatiquement une femme adorée qui vous dira demain : « Pauvre chéri, je n’ai pas pu sortir ! »"
                            },
                            {
                                "example_id": "9e37eca6-d62a-4df2-9b04-8842130ec5af",
                                "sense_id": "8c035f21-b0b5-31af-99f9-12cc02ddcade",
                                "text": "Mon fils Tiburce n’avait même pas quatre ans lorsque je le flanquai à l’eau pour le première fois. Ce n’était point dans le dessein criminel de me débarrasser aquatiquement de cet enfant chéri, — d’autant plus que je n’avais que celui-là, et pas de vieux."
                            }
                        ]
                    }
