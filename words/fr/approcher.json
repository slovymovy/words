{
    "word_family": [
        "approche",
        "approchable",
        "inapprochable",
        "rapprocher",
        "rapprochement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4733ef66-16c7-3526-9923-e457c951ea71",
                    "sense_definition": "Venir ou aller plus près d'un lieu ou d'une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train <w>approche</w> de la gare à vitesse réduite."
                        },
                        {
                            "text": "Ne restez pas là, <w>approchez</w> pour mieux voir le spectacle."
                        }
                    ],
                    "synonyms": [
                        "avancer"
                    ],
                    "antonyms": [
                        "reculer",
                        "s'éloigner"
                    ],
                    "common_phrases": [
                        "approcher de la fin",
                        "approcher du rivage"
                    ]
                },
                {
                    "sense_id": "63f473a1-78f0-347b-b313-5ae075a9b6dc",
                    "sense_definition": "En parlant du temps ou d'un événement, devenir proche ou être imminent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps_evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hiver <w>approche</w> et les températures commencent déjà à baisser nettement."
                        },
                        {
                            "text": "La date de l'examen <w>approche</w> à grands pas pour tous les étudiants."
                        }
                    ],
                    "synonyms": [
                        "arriver"
                    ],
                    "common_phrases": [
                        "l'heure approche",
                        "le moment approche"
                    ]
                },
                {
                    "sense_id": "56c0ab8e-aa93-37d9-85d6-84b7fc9bd305",
                    "sense_definition": "Déplacer une personne ou un objet pour le mettre plus près.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>approché</w> sa chaise de la cheminée pour se réchauffer les mains."
                        },
                        {
                            "text": "Le serveur <w>approche</w> la lampe de notre table pour nous éclairer."
                        }
                    ],
                    "synonyms": [
                        "rapprocher"
                    ],
                    "antonyms": [
                        "éloigner"
                    ],
                    "common_phrases": [
                        "approcher une chaise",
                        "approcher la table"
                    ]
                },
                {
                    "sense_id": "5df2716b-2e3c-3996-9902-e62e0057ad31",
                    "sense_definition": "Entrer en contact avec quelqu'un pour lui parler ou nouer une relation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relation_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce journaliste expérimenté sait comment <w>approcher</w> les personnalités politiques les plus réservées."
                        },
                        {
                            "text": "Le vendeur a tenté d'<w>approcher</w> le nouveau client avec beaucoup de politesse."
                        }
                    ],
                    "synonyms": [
                        "aborder",
                        "contacter"
                    ],
                    "antonyms": [
                        "fuir",
                        "éviter"
                    ],
                    "common_phrases": [
                        "approcher un client",
                        "facile à approcher"
                    ]
                },
                {
                    "sense_id": "e4dbe60e-3bc9-3741-967c-27cc0dd6af8a",
                    "sense_definition": "Être sur le point d'atteindre un but, une solution ou la vérité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objectif_verite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues recherches, les scientifiques <w>approchent</w> enfin du but souhaité."
                        },
                        {
                            "text": "Votre réponse n'est pas exacte, mais vous <w>approchez</w> de la bonne solution."
                        }
                    ],
                    "synonyms": [
                        "frôler"
                    ],
                    "common_phrases": [
                        "approcher du but",
                        "approcher de la vérité"
                    ]
                },
                {
                    "sense_id": "aed5bd02-2e20-37ea-a9ef-53403fc89175",
                    "sense_definition": "Présenter une grande ressemblance ou une équivalence avec quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comparaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette copie fidèle <w>approche</w> remarquablement de l'original conservé au musée national."
                        },
                        {
                            "text": "Sa performance vocale <w>approchait</w> de la perfection selon tous les critiques musicaux."
                        }
                    ],
                    "synonyms": [
                        "égaler",
                        "ressembler"
                    ],
                    "common_phrases": [
                        "approcher de la perfection",
                        "rien n'approche de"
                    ]
                },
                {
                    "sense_id": "7c0f4d1d-31c8-3cb4-b2aa-fe8542ff6029",
                    "sense_definition": "Déterminer ou évaluer une quantité de façon approximative.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les experts utilisent un modèle statistique afin d'<w>approcher</w> le coût total des travaux."
                        },
                        {
                            "text": "Cette méthode de calcul permet d'<w>approcher</w> la valeur réelle avec une bonne précision."
                        }
                    ],
                    "synonyms": [
                        "approximer",
                        "estimer"
                    ],
                    "common_phrases": [
                        "approcher une valeur",
                        "approcher le coût"
                    ]
                }
            ]
        }
    ]
}