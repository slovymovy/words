                    "sense_definition": "Gebiedende wijs van <w>lekkerbekken</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Lekkerbek</w> niet zo bij het zien van al die taartjes, we gaan zo avondeten!",
                            "target_lang_translations": {
                                "en": "Don't <w>drool</w> so much at the sight of all those cakes, we are having dinner soon!"
                            }
                        },
                        {
                            "text": "Kom op, <w>lekkerbek</w> gezellig met ons mee bij deze heerlijke barbecue.",
                            "target_lang_translations": {
                                "en": "Come on, <w>relish</w> along with us at this delicious barbecue."
                            }
                        }
                    ],
                    "traits": [
