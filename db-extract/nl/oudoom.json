                                        "entry_id": "5cf6c8dd-5a22-31b7-b4bc-bcc940c80aa8",
                                        "glosses": [
                                            "Frère d’un des quatre grands-parents d’une personne."
                                        ],
                                        "tags": [],
                                        "note": "On est pour son grand-oncle un petit-neveu ou une petite-nièce",
                                        "examples": [
                                            {
                                                "example_id": "2bbdcbb5-0721-4f11-bdf4-41413e7a090e",
                                                "sense_id": "23b6539d-8985-315b-9a1c-221a84aab78d",
                                                "text": "Henri IV est le grand-père de Louis XIV, Cotton, le grand-oncle du P. la Chaise : deux royautés, deux dynasties, celle des rois, celle des confesseurs jésuites."
                                            },
                                            {
                                                "example_id": "9c331c63-1693-4954-a214-6f56c575830f",
                                                "sense_id": "23b6539d-8985-315b-9a1c-221a84aab78d",
                                                "text": "D’ailleurs mon grand-oncle, le commandant Heudenert, avait épousé une de Noisel, les Noisel sont de leurs parents."
                                            },
                                            {
                                                "example_id": "254a8e0f-14ef-45f5-a882-071bcaacd269",
                                                "sense_id": "23b6539d-8985-315b-9a1c-221a84aab78d",
                                                "text": "Ils sont désormais plusieurs à imaginer Tidjane, puissant directeur du Crédit suisse, dans les pas de son grand-oncle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349c28c7-f03c-32ad-8702-c5d2e2dd87a5",
                                        "entry_id": "5cf6c8dd-5a22-31b7-b4bc-bcc940c80aa8",
                                        "glosses": [
                                            "Conjoint d’un membre de la fratrie d’un des quatre grands-parents d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
