                "senses": [
                    {
                        "sense_id": "1be033a3-036a-3ecd-9e1a-3eebe9fe8180",
                        "entry_id": "bed96444-ea86-3268-b966-8b9dc4604195",
                        "glosses": [
                            "Adoption d’un modèle de commerce consistant à mettre des ressources à disposition des clients depuis leurs téléphones intelligents, à tout moment et sans délai."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "20ae2d3e-317d-4051-930d-29a925d960cb",
                                "sense_id": "1be033a3-036a-3ecd-9e1a-3eebe9fe8180",
                                "text": "On assiste à une véritable uberification du marché de la santé. Comme pour les utilisateurs du service Uber, les patients veulent pouvoir prendre leur smartphone et appuyer sur une application pour « commander » une visite médicale ou un docteur."
                            },
                            {
                                "example_id": "da338610-86bf-4d47-a60c-7d19f59af4b0",
                                "sense_id": "1be033a3-036a-3ecd-9e1a-3eebe9fe8180",
                                "text": "L’ « uberification » de l’économie mondiale continue. La start-up chinoise Hao Chushi (le bon cuisinier) qui propose un service de « chef à la demande » vient de récolter 800 000 dollars auprès de business angels et devrait en lever 5 millions supplémentaires dans les mois à venir."
                            },
                            {
                                "example_id": "581e1c55-9d37-4242-b512-7105a80e4650",
                                "sense_id": "1be033a3-036a-3ecd-9e1a-3eebe9fe8180",
                                "text": "Bref, l’uberification c’est la transformation de votre service en app disponible sur smartphone et qui vous délivre un service tout de suite, avec en plus dans le cas d’Uber, le système de paiement pris en charge."
                            }
                        ]
                    }
