                "senses": [
                    {
                        "sense_id": "b59bbb0a-9932-3c05-9d01-9b089501c0f4",
                        "entry_id": "4e712694-8e7e-30a9-bb73-a82b9a5dee32",
                        "glosses": [
                            "das Bilden von Geruch, das Sich-Bilden; die wahrnehmbare Freisetzung/Ausgasung von Geruchsstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d71cbb76-c22a-49a6-9216-39bde9d3b8f5",
                                "sense_id": "b59bbb0a-9932-3c05-9d01-9b089501c0f4",
                                "text": "„Bei schwefelarmem Heizöl ist die Geruchsbildung deutlich geringer.“"
                            },
                            {
                                "example_id": "ac682a7b-0a0f-4b84-ab9b-0e4ba91904cf",
                                "sense_id": "b59bbb0a-9932-3c05-9d01-9b089501c0f4",
                                "text": "„Die Geruchsbildung im Umfeld des Entsorgungszentrums konnte eingedämmt werden. Präventivmaßnahmen zur Reduzierung der Geruchsentwicklung aus Kanälen der Kläranlage, wie Abdeckungen und geänderte Prozessführung, haben gegriffen.“"
                            },
                            {
                                "example_id": "28b0a069-e13a-44dc-9ec7-47294140614b",
                                "sense_id": "b59bbb0a-9932-3c05-9d01-9b089501c0f4",
                                "text": "„Verlegewerkstoffe können die Geruchsbildung und Emissionen geklebter oder fixierter Beläge verstärken oder dafür verantwortlich sein.“"
                            },
                            {
                                "example_id": "babf2b54-9937-47af-9129-c2725feef9b6",
                                "sense_id": "b59bbb0a-9932-3c05-9d01-9b089501c0f4",
                                "text": "„Das Fehlen der Schamhaare macht nicht anfälliger für Pilzinfektionen und kann eine eventuelle Geruchsbildung reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
