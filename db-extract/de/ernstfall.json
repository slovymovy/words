                ],
                "senses": [
                    {
                        "sense_id": "d141a756-4c17-3493-b6d1-74acccca1236",
                        "entry_id": "123c8d01-cf1e-3b53-9365-2c6f44f78796",
                        "glosses": [
                            "kritische Situation, in der ein als negativ eingeschätztes Ergebnis einzutreten droht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef03023e-72dd-454c-b6fe-f475f258c9f3",
                                "sense_id": "d141a756-4c17-3493-b6d1-74acccca1236",
                                "text": "„Er wusste, im Ernstfall würden sie die Stellung nicht halten können.“"
                            },
                            {
                                "example_id": "a16420cf-c651-4577-99b9-816c7a05a284",
                                "sense_id": "d141a756-4c17-3493-b6d1-74acccca1236",
                                "text": "„Von den untereinander verfeindeten, westeuropäischen Staaten war im Ernstfall wenig Hilfe zu erwarten; so kamen die Habsburger mit den Jagiellonen über einen gegenseitigen Freundschaftsvertrag überein, der nach Vorverhandlungen in Pressburg in Wien beschlossen werden sollte.“"
                            },
                            {
                                "example_id": "6b15f54f-5c66-4e1a-8167-b38873d9d2f7",
                                "sense_id": "d141a756-4c17-3493-b6d1-74acccca1236",
                                "text": "„Außerdem machte man uns klar, dass wir im Ernstfall die ersten Angriffsziele des Feindes sind, weil wir aufgrund unserer Funksignale am leichtesten ausfindig gemacht werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bb888fe-9124-4c4b-ac80-7966b3666a35",
                        "source_entry_id": "123c8d01-cf1e-3b53-9365-2c6f44f78796",
                        "source_sense_id": "d141a756-4c17-3493-b6d1-74acccca1236",
                        "source_sense_description": "kritische Situation, in der ein als negativ eingeschätztes Ergebnis einzutreten droht.",
                        "target_lang_word": "emergency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emergency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b122c7-5a13-360d-b7c7-353eeb1c8ac6",
                                        "entry_id": "51c4acff-4feb-3927-a422-a9e390dbe42a",
                                        "glosses": [
                                            "A situation which poses an immediate risk and which requires urgent attention."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9a74a3d-5777-427f-aec1-2c8fc65f635b",
                                                "sense_id": "d3b122c7-5a13-360d-b7c7-353eeb1c8ac6",
                                                "text": "Cardiac arrest is an emergency requiring medical attention."
                                            },
                                            {
                                                "example_id": "1369e699-ec29-46ac-a116-5b6b1b758315",
                                                "sense_id": "d3b122c7-5a13-360d-b7c7-353eeb1c8ac6",
                                                "text": "We also found that the only emergency egress from the tram was by smashing the front or rear windscreens, and that emergency lighting had failed when the tram overturned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1fd638-92af-3fd0-8f29-c12c58af2fa2",
                                        "entry_id": "51c4acff-4feb-3927-a422-a9e390dbe42a",
                                        "glosses": [
                                            "The department of a hospital that treats emergencies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4942ece9-8915-4b63-b524-ca1c1e4ef9e7",
                                                "sense_id": "6b1fd638-92af-3fd0-8f29-c12c58af2fa2",
                                                "text": "I've got a really bad disease\nIt's got me begging on my hands and knees\nSo take me to emergency\nCause something seems to be missing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62993f75-2bda-337a-b138-4ba0a1fa8e3b",
                                        "entry_id": "51c4acff-4feb-3927-a422-a9e390dbe42a",
                                        "glosses": [
                                            "A person brought in at short notice to replace a member of staff, a player in a sporting team, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c267198-577a-44fb-9a15-a052eeae8de5",
                                                "sense_id": "62993f75-2bda-337a-b138-4ba0a1fa8e3b",
                                                "text": "November 2 2014, Daniel Taylor, \"Sergio Agüero strike wins derby for Manchester City against 10-man United,\" guardian.co.uk\nVan Gaal responded by replacing Adnan Januzaj with Carrick and, in fairness, the emergency centre-half did exceedingly well given that he has not played since May."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21352192-b330-3253-9ef8-711b740b8805",
                                        "entry_id": "51c4acff-4feb-3927-a422-a9e390dbe42a",
                                        "glosses": [
                                            "The quality of being emergent; sudden or unexpected appearance; an unforeseen occurrence."
                                        ],
