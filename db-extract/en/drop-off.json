                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "33ce5c08-eb05-304b-84f1-c60c0f933132",
                        "entry_id": "fd576ea3-665a-33e7-be28-009649329c8b",
                        "glosses": [
                            "A decrease; especially, a sudden one."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb257ed-0a15-46fd-8ebe-619f4b252cad",
                                "sense_id": "33ce5c08-eb05-304b-84f1-c60c0f933132",
                                "text": "There has been an unexplained drop-off in sales this quarter."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3c11214-e4d6-3ed6-9b81-e966943b170c",
                        "entry_id": "fd576ea3-665a-33e7-be28-009649329c8b",
                        "glosses": [
                            "A delivery; the act of leaving a package, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f54b7e3-660b-410d-9bb0-b9e55bc63ae0",
                                "sense_id": "e3c11214-e4d6-3ed6-9b81-e966943b170c",
                                "text": "Starting tomorrow, they'd do dropoffs and pickups instead of leaving their vehicles unguarded."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8b5bf06-7334-3ab4-a852-f5b962bf236e",
                        "entry_id": "fd576ea3-665a-33e7-be28-009649329c8b",
                        "glosses": [
                            "A space reserved outside a bus or railway station for vehicles stopping to drop off passengers for onward transit."
                        ],
                        "tags": [
                            "US",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "77d03def-02f9-4617-8f79-6e5a66b27d4e",
                                "sense_id": "b8b5bf06-7334-3ab4-a852-f5b962bf236e",
                                "text": "Fifty car parking spaces, a drop-off point, five spaces for blue badge holders and lighting masts are all included in the plan, as is cycle parking on the station forecourt and ticket vending machines."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a73229f-18cd-36a5-aec5-ec88f0c69fb3",
                        "entry_id": "fd576ea3-665a-33e7-be28-009649329c8b",
                        "glosses": [
                            "A time during which passengers, such as school children, are dropped off; the event or act of dropping them off."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "455a6c88-60b0-414a-91f2-d4e1ff6fecff",
                                "sense_id": "6a73229f-18cd-36a5-aec5-ec88f0c69fb3",
                                "text": "These signs are friendly reminders for road users to slow down during drop-off and pick-up."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa77f088-9d81-3495-aaef-2e90d28dcdcd",
                        "entry_id": "fd576ea3-665a-33e7-be28-009649329c8b",
                        "glosses": [
                            "A visitor to a website who ceases to continue using and navigating around the site after reaching some specified page; or such an act of cessation."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "bf954cd4-2f8a-4825-a066-2160b9739cd1",
                                "sense_id": "aa77f088-9d81-3495-aaef-2e90d28dcdcd",
                                "text": "We're seeing a lot of drop-offs on the shop product pages; why aren't people making purchases?"
                            }
                        ]
                    }
                ],
