                        "glosses": [
                            "in the dark"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5106066-db93-463a-af45-9a3f449aff6d",
                                "sense_id": "d997c8b6-6b98-384f-8090-65226223b0eb",
                                "text": "Осторо́жно, чуть ступа́я, взошла́ она́ по ле́стнице и о́щупью отыска́ла впотьма́х две́ри, веду́щие в ко́мнаты.",
                                "translation": "Cautiously, treading very lightly, she climbed the stairs and felt her way in the dark to the door which led to his rooms.",
                                "english": "Cautiously, treading very lightly, she climbed the stairs and felt her way in the dark to the door which led to his rooms."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
