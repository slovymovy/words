                    },
                    {
                        "translation_id": "03814638-59ea-4471-bef7-318c38ba0e1a",
                        "source_entry_id": "e5969b78-31fe-3a26-a8c7-1b832cb5df16",
                        "source_sense_description": "устройство, приспособление для просушивания чего-либо, удаления влаги из чего-либо",
                        "target_lang_word": "séchoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séchoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd905db6-61cc-3512-9b7e-16643c5d2df4",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Lieu où l’on étend, où l’on suspend les toiles, les cuirs, les papiers, etc., pour les faire sécher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed730fa3-f30c-4961-b171-6c05352e0f73",
                                                "sense_id": "bd905db6-61cc-3512-9b7e-16643c5d2df4",
                                                "text": "Et ces costumes, ils se trouvaient étendus dans les séchoirs, numérotés par habilleuses, car on leur donnait aussi des serviteurs pour s'en vêtir !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Dispositif qui sert à faire sécher différentes préparations, différents objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65af3ca-bf07-4880-a0f6-61c1fbdc06b8",
                                                "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                                "text": "Comme les pluies nuisent beaucoup à la dessiccation en plein air, on vient d'inaugurer un séchoir artificiel : c'est un four à chaleur modérée, où l'on dispose les poissons sur des lattes; au bout de trois jours ils sont séchés à point."
                                            },
                                            {
                                                "example_id": "7204c869-5cc0-4987-b038-11e342d35942",
                                                "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                                "text": "On procède ensuite au séchage par les moyens ordinaires: […], ou séchoirs à tabliers mobiles avec soufflerie d'air chaud, ou enfin séchoirs à l'air libre."
                                            },
                                            {
                                                "example_id": "1313d263-3e2e-4562-b8bd-8366fcbb95a2",
                                                "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                                "text": "Pour faire plaisir au photographe, il jeta un coup d’œil sur les épreuves étalées sur des séchoirs, encore mouillées et luisantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35a7085b-834b-35d5-8e8c-49ca869a5620",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Appareil électrique servant à sécher les cheveux en soufflant de l’air chaud."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Maghreb"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9672557-e3e8-3e50-aa3d-2df6d8073ebf",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Prison."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a67e98f-4cf1-4e86-bed7-3aaaec7a4643",
                        "source_entry_id": "e5969b78-31fe-3a26-a8c7-1b832cb5df16",
                        "source_sense_description": "устройство, приспособление для просушивания чего-либо, удаления влаги из чего-либо",
                        "target_lang_word": "étendage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étendage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ac8561-c0dc-3d58-aafa-b1eaa6cc0f2a",
                                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                                        "glosses": [
                                            "Action d’étendre en vue de faire sécher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8b355a-0cfc-4075-bcf9-fa39cd141c44",
                                                "sense_id": "d9ac8561-c0dc-3d58-aafa-b1eaa6cc0f2a",
                                                "text": "Procéder à l’étendage du linge."
                                            },
                                            {
                                                "example_id": "4c071e79-169a-4496-8c6e-a1ff15365e7d",
                                                "sense_id": "d9ac8561-c0dc-3d58-aafa-b1eaa6cc0f2a",
                                                "text": "Sylvie monte avec Roberto la séquence de l’étendage du linge pendant que j’essaye de me sortir du tatouage des « indiens » et de la visite du flic au gymnase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                                        "glosses": [
                                            "Assemblage de cordes tendues horizontalement, sur lesquelles on fait sécher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92c079f-0ff2-4429-9484-dd43ad5ee8db",
                                                "sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                                                "text": "L’étendage d’une blanchisserie, d’une imprimerie."
                                            },
                                            {
                                                "example_id": "03339d52-6ee0-47ad-8590-abe90339ad98",
                                                "sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                                                "text": "Le père atteint le bord de l’allée. Pour enjamber la dalle, il se penche davantage en avant, s’assure que le corps ne risque pas de basculer et, le lâchant de la main gauche, il se cramponne à un piquet de l’étendage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764dfb3b-13d2-3fe1-a088-c15f0f168c7b",
                                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                                        "glosses": [
                                            "séchoir à linge."
