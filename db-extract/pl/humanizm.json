                "translations": [
                    {
                        "translation_id": "b1b545ee-01b6-403e-b9cd-271780141f31",
                        "source_entry_id": "f71080c8-cb81-3f1d-9028-1a1cfd1f569a",
                        "source_sense_id": "68fb6424-9461-3147-86b9-296fd86018c8",
                        "target_lang_word": "humanism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c78bf3-3c52-370d-ad02-d1d82454e8c1",
                                        "entry_id": "4e6a2175-543c-3177-ab9e-24ec565d52ad",
                                        "glosses": [
                                            "The study of the humanities or the liberal arts; literary (especially classical) scholarship."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba746557-bb6d-32c7-a86b-b1d6d6d5aa7a",
                                        "entry_id": "4e6a2175-543c-3177-ab9e-24ec565d52ad",
                                        "glosses": [
                                            "Specifically, a cultural and intellectual movement in 14th-16th century Europe characterised by attention to classical culture and a promotion of vernacular texts, notably during the Renaissance."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "historical",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39695f59-99d5-4d31-bc28-d25ca3fbfbb1",
                                                "sense_id": "ba746557-bb6d-32c7-a86b-b1d6d6d5aa7a",
                                                "text": "There were good reasons for humanism and the Renaissance to take their origins from fourteenth-century Italy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68dfade-c507-3e0a-b92c-7fb7a613345a",
                                        "entry_id": "4e6a2175-543c-3177-ab9e-24ec565d52ad",
                                        "glosses": [
                                            "An ethical system that centers on humans and their values, needs, interests, abilities, dignity and freedom; especially used for a secular one which rejects theistic religion and superstition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "517b02e4-2b28-3e93-938f-54d8d4487555",
                                        "entry_id": "4e6a2175-543c-3177-ab9e-24ec565d52ad",
                                        "glosses": [
                                            "Humanitarianism, philanthropy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7eac9ac7-68fe-3543-b103-a200bb3ffa3b",
                                        "entry_id": "4e6a2175-543c-3177-ab9e-24ec565d52ad",
                                        "glosses": [
                                            "A theology within Unitarian Christianity that denied the divine nature of Christ and the transcendental nature of God."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ad435a4-c3b7-49af-b97f-8a76ec36b293",
                        "source_entry_id": "f71080c8-cb81-3f1d-9028-1a1cfd1f569a",
                        "source_sense_id": "68fb6424-9461-3147-86b9-296fd86018c8",
                        "target_lang_word": "humanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f696b8ae-1f74-3fb9-9269-0a961f4cdc73",
                                        "entry_id": "114eb618-08aa-3791-b845-2ec6d7393e6b",
                                        "glosses": [
                                            "Mouvement intellectuel apparu au cours de la Renaissance qui puise de textes antiques des modèles de vie, d’écriture et de pensée, culture des belles-lettres, des humanités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee9817d-201a-4551-97fe-75d599ebd234",
                                                "sense_id": "f696b8ae-1f74-3fb9-9269-0a961f4cdc73",
                                                "text": "Du XVIᵉ au XVIIIᵉ siècle, elle [Raguse] vit fleurir dans ses murs toute une école de poëtes élégants qui développèrent leur génie sous la double influence de l'humanisme et de la renaissance italienne."
                                            },
                                            {
                                                "example_id": "efd79888-fb01-421c-80b5-7a7ccfb90558",
                                                "sense_id": "f696b8ae-1f74-3fb9-9269-0a961f4cdc73",
                                                "text": "L’humanisme est un terme propre à la Renaissance qui s’accompagne d’un renouveau pédagogique en réaction contre les structures figées de l’enseignement médiéval. À l’époque, on comprend par humanisme l’étude des vieux manuscrits venus de Constantinople. Le premier effort constitue à apprendre l’hébreu, le grec et le latin classique afin de découvrir les connaissances scientifiques, philosophiques, historiques révélées dans ce patrimoine redécouvert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86951d11-12d5-357e-9432-333fce667ace",
                                        "entry_id": "114eb618-08aa-3791-b845-2ec6d7393e6b",
                                        "glosses": [
                                            "Doctrine centrée sur l’intérêt des hommes et de l’humanité, qui valorise l’humain avant tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab83f53-b5db-481e-a71e-0caabdd0e2b9",
                                                "sense_id": "86951d11-12d5-357e-9432-333fce667ace",
                                                "text": "Débusquer les bases biologiques d’un comportement n’enlève rien à l’humanisme du geste ni au libre arbitre : nous demeurons toujours libres de choisir entre un geste altruiste ou égoïste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d2684af-9334-415c-9486-943e7e7c0ea8",
                        "source_entry_id": "f71080c8-cb81-3f1d-9028-1a1cfd1f569a",
                        "source_sense_id": "68fb6424-9461-3147-86b9-296fd86018c8",
                        "target_lang_word": "humanismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "de2b98c6-ac3e-3d44-9a31-84e0fdb9ae9d",
                                        "entry_id": "a5acda13-4568-39d4-966d-dbb807923f0d",
                                        "glosses": [
                                            "Cualquier sistema o modo de pensar o actuar en el cual predominan los intereses y valores humanos. y que afirma el valor y dignidad de todos los seres humanos. A menudo rechaza la importancia de creer en Dios."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c94e6abc-4795-3236-9c24-469b47fddd0a",
                                        "entry_id": "a5acda13-4568-39d4-966d-dbb807923f0d",
                                        "glosses": [
                                            "Corriente educativa, filosófica, artística e intelectual europea estrechamente ligada al Renacimiento cuyo origen se sitúa en el siglo XIV en la península Itálica, especialmente en Roma, Venecia y Florencia."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbc75db0-c392-4752-92cc-caf46686e769",
                        "source_entry_id": "f71080c8-cb81-3f1d-9028-1a1cfd1f569a",
                        "source_sense_id": "68fb6424-9461-3147-86b9-296fd86018c8",
                        "target_lang_word": "Humanismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Humanismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b4d82b0-f780-326a-a341-beffcc74bed6",
                                        "entry_id": "f47ce499-8924-3313-98f8-5b85706e395a",
                                        "glosses": [
                                            "Philosophie und Weltanschauung, die sich an den Interessen, den Werten und der Würde von Menschen orientiert"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81c10eab-ef1d-447b-a15d-991922db70d8",
                                                "sense_id": "2b4d82b0-f780-326a-a341-beffcc74bed6",
                                                "text": "„Für Foucault ist Humanismus nichts anderes als eine Säkularisierung idealistischer Gedanken. Es gebe weder ein Wesen des Menschen noch objektive und universelle Menschenrechte. Es bestehe auch keine überhistorische Norm, die das Wesen des Menschen bestimmen könne.“"
                                            },
                                            {
                                                "example_id": "b1cc96b9-4d8f-4a63-940e-0737945104b0",
                                                "sense_id": "2b4d82b0-f780-326a-a341-beffcc74bed6",
                                                "text": "„Toleranz zwischen Menschen, Gewaltfreiheit und Gewissensfreiheit gelten im Humanismus als wichtige Prinzipien menschlichen Zusammenlebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70ee0d68-e9f5-355b-937e-15f8db84459a",
                                        "entry_id": "f47ce499-8924-3313-98f8-5b85706e395a",
                                        "glosses": [
                                            "eine spezifische Auffassung oder Art von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290df3f3-43a1-448c-9f26-c34dcd5e2292",
                                                "sense_id": "70ee0d68-e9f5-355b-937e-15f8db84459a",
                                                "text": "„Es gibt vielmehr sehr viele verschiedene Humanismen und Utopien.“"
                                            },
                                            {
                                                "example_id": "881d3fcf-4a4d-4f12-8823-04a33642af07",
                                                "sense_id": "70ee0d68-e9f5-355b-937e-15f8db84459a",
                                                "text": "„Eine Abgrenzung ist weiterhin schwer, weil Humanismen zwar einen Einfluß auf die Gesinnungsbildung in verschiedenen Institutionen hatten und haben, aber selbst keine identifizierbaren Institutionen bildeten.“"
                                            },
                                            {
                                                "example_id": "e6796268-8e25-4a74-bb64-cb93a3b9e69c",
                                                "sense_id": "70ee0d68-e9f5-355b-937e-15f8db84459a",
                                                "text": "„So wird neben dem klassischen vor allem von einem christlichen, neuerdings auch von einem bürgerlichen, einem sozialistischen, einem technischen und manchen anderen Humanismen gesprochen.“"
                                            },
                                            {
                                                "example_id": "cd13c10b-4b91-4c56-81a9-682dfcb697b2",
                                                "sense_id": "70ee0d68-e9f5-355b-937e-15f8db84459a",
                                                "text": "„Nun, die ‚modernen‘ Rechtsauffassungen sind Humanismen; aber es sind, um es genauer zu sagen, vom nihilistisch-aggressiven Individualismus und Kollektivismus heimgesuchte Humanismen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
