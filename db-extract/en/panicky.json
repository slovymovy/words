                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paniqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9233f51e-7954-3d64-ab53-40c468ce8181",
                                        "entry_id": "a8e636f8-54d4-3890-a4e0-32b83b959cf9",
                                        "glosses": [
                                            "Qui est pris de panique, d'une peur extrême susceptible de lui faire perdre ses moyens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98eba7b-973c-47cc-a342-eb033ac33ede",
                                                "sense_id": "9233f51e-7954-3d64-ab53-40c468ce8181",
                                                "text": "Angelo, qui a perçu le danger, a perdu le goût de jouer et est totalement paniqué. Il tremble de tous ses membres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paniqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25452f59-1d7e-3a6e-8afa-b0c06c1f0a44",
                                        "entry_id": "9d1def5e-c368-3627-b6a0-a67f5850b2ad",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe paniquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa4adb4-3889-4dcf-9259-38c576f41fa3",
                                                "sense_id": "25452f59-1d7e-3a6e-8afa-b0c06c1f0a44",
                                                "text": "Et, même lorsque la Real Sociedad a (un poil) poussé, tout ce beau monde n’a jamais paniqué, ou un peu, quand même, après une perte de balle idiote (73ᵉ) et un tir à bout portant de Turrientes (79ᵉ)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
