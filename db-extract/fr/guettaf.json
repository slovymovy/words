                "senses": [
                    {
                        "sense_id": "4a279d81-64ef-35aa-a9d0-11c31587aab3",
                        "entry_id": "b31bbe10-59a7-338e-a965-abe8b4ceea27",
                        "glosses": [
                            "Arbrisseau halophyte comestible d’Afrique du nord et méditerranéen du genre Atriplex et en particulier Atriplex halimus."
                        ],
                        "tags": [
                            "Maroc",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "6997c4b0-a0fb-4ec4-ae1a-3ff68ee7f692",
                                "sense_id": "4a279d81-64ef-35aa-a9d0-11c31587aab3",
                                "text": "Dans les bas fonds salins, ce sont plutôt des espèces halophiles de la famille des Chénopodiacées, comme le guettaf (Atriplex), la salicorne, les salsolacées ou Suaeda."
                            },
                            {
                                "example_id": "1e2375dd-fdeb-4df8-a7e0-5b34b25a0bf1",
                                "sense_id": "4a279d81-64ef-35aa-a9d0-11c31587aab3",
                                "text": "Tel est le guettaf (Atriplex Halimus des botanistes), plante rameuse dont les feuilles charnues sont le principal aliment, et j’ajouterai presque la boisson, des animaux sahariens et particulièrement du fameux meah (Antilope)."
                            }
                        ]
                    }
