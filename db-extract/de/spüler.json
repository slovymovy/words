                        ],
                        "examples": [
                            {
                                "example_id": "0d1e748c-80c6-46b7-b9d7-28c58e20b20a",
                                "sense_id": "1c80cfeb-b821-35df-b388-a3fcdb613b5c",
                                "text": "Drück den Spüler, wenn du fertig mit Pipimachen bist."
