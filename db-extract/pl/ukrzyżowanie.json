                                        "entry_id": "803a9a39-780d-36e2-90f3-2e38286200d5",
                                        "glosses": [
                                            "Hinrichtungsart, bei der eine Person an einen aufrechten Pfahl genagelt oder gefesselt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e710b664-d4db-4273-8bba-3fde361cf045",
                                                "sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                                                "text": "Kreuzigungen waren im alten Orient und in der Antike weit verbreitet. Im römischen Reich wurden sie nur bei schweren Verbrechen oder an Nichtrömern und Sklaven angewandt."
                                            },
                                            {
                                                "example_id": "6f3c54b4-0950-4623-b709-e36e47841861",
                                                "sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                                                "text": "Der Kreuzigung Jesu wird an Karfreitag gedacht."
                                            }
