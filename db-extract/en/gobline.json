                "senses": [
                    {
                        "sense_id": "a8eca9d6-826c-316b-ac18-c5b5bda09731",
                        "entry_id": "7a3f43ef-15a1-3c17-95c6-405caea0c5b7",
                        "glosses": [
                            "One of the ropes or chains serving as stays for the dolphin striker or the bowsprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1401b6-74d5-4d14-9083-d2adc92af776",
                                "sense_id": "a8eca9d6-826c-316b-ac18-c5b5bda09731",
                                "text": "The gobline helps prevent the tug from being tripped or capsized when working on a towline especially if the tug is being towed stern first."
                            },
                            {
                                "example_id": "f30fd797-7cd1-4789-ab40-1dd2427e0d87",
                                "sense_id": "a8eca9d6-826c-316b-ac18-c5b5bda09731",
                                "text": "This is not so important if the towline is bowsed to the stern of the tug with a gobline."
                            }
                        ]
                    },
                    {
                        "sense_id": "356519b8-5903-3bd0-b0e2-da92ea7fc8a5",
                        "entry_id": "7a3f43ef-15a1-3c17-95c6-405caea0c5b7",
                        "glosses": [
                            "The outer extent of the gob (waste material) in an old mine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d12dcbc-4494-421d-b752-868f0f47850a",
                                "sense_id": "356519b8-5903-3bd0-b0e2-da92ea7fc8a5",
                                "text": "At Mine C, the future tailgate entry was 184 ft away from the longwall gobline and under a cover depth of 900 ft."
                            },
                            {
                                "example_id": "a496501a-843a-4e91-9093-c084caa94cf8",
                                "sense_id": "356519b8-5903-3bd0-b0e2-da92ea7fc8a5",
                                "text": "They serve as the gobline supports for the space between the canopy tip and faceline as shields are removed one by one from the tail end to head end."
                            }
                        ]
                    }
                ],
