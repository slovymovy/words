                ],
                "senses": [
                    {
                        "sense_id": "6db2ce4f-59c2-313a-8034-280424fb2142",
                        "entry_id": "fc03ff97-5979-350b-9942-ea5839a85cc4",
                        "glosses": [
                            "Noir, personne ayant la peau noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b887476f-da67-4e4f-9c90-242f037e538e",
                                "sense_id": "6db2ce4f-59c2-313a-8034-280424fb2142",
                                "text": "Ce groupe de la gare de Saint-Denis est essentiellement constitué d’individus d’Afrique noire et d’Antillais, et se désignent eux-mêmes par renoi, black ou keubla."
                            },
                            {
                                "example_id": "b53537e0-bfdd-460d-b209-54ec118bdd66",
                                "sense_id": "6db2ce4f-59c2-313a-8034-280424fb2142",
                                "text": "La couleur de la peau n'est pas un tabou dans ces quartiers. Loin du politiquement correct, on parle en verlan de rebeu, de renoi, de babtou pour arabe, noir ou blanc."
                            },
                            {
                                "example_id": "abf8ecaf-8b56-42cb-bf47-7dbdc5c7d253",
                                "sense_id": "6db2ce4f-59c2-313a-8034-280424fb2142",
                                "text": "Il y a tout dans ce film pour plaire au public, insiste Jean-Pascal Zadi. Y compris un renoi sexy, moi en l’occurrence."
                            }
                        ]
                    }
                ],
