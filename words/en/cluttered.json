{
    "word_family": [
        "clutter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92f3894d-f3cc-3fa2-b270-749312832c17",
                    "sense_definition": "Filled with a disorderly mixture of objects that occupies space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desk was so <w>cluttered</w> with papers that there was no room to write.",
                            "target_lang_translations": {
                                "ru": "Стол был так <w>загроможден</w> бумагами, что не было места для письма.",
                                "cs": "Stůl byl tak <w>zaneřáděný</w> papíry, že na něm nebylo místo na psaní."
                            }
                        },
                        {
                            "text": "She tried to clean her <w>cluttered</w> room before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Она попыталась убрать свою <w>захламленную</w> комнату до прихода гостей.",
                                "cs": "Před příchodem hostů se snažila uklidit svůj <w>zaneřáděný</w> pokoj."
                            }
                        }
                    ],
                    "synonyms": [
                        "messy",
                        "disordered",
                        "untidy"
                    ],
                    "antonyms": [
                        "tidy",
                        "organized"
                    ],
                    "common_phrases": [
                        "cluttered desk",
                        "cluttered room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загроможденный, заполненный беспорядочно нагроможденными предметами, которые занимают место.",
                        "cs": "Zaplněný neuspořádanou směsicí předmětů, které zabírají prostor."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загроможденный",
                                "target_lang_sense_clarification": "о пространстве, занятом лишними вещами"
                            },
                            {
                                "target_lang_word": "захламленный",
                                "target_lang_sense_clarification": "о помещении, заполненном ненужным хламом"
                            },
                            {
                                "target_lang_word": "беспорядочный",
                                "target_lang_sense_clarification": "о состоянии вещей, лежащих не на своих местах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zaneřáděný",
                                "target_lang_sense_clarification": "o prostoru plném nepořádku a zbytečných věcí"
                            },
                            {
                                "target_lang_word": "zastavěný",
                                "target_lang_sense_clarification": "o prostoru, kde věci překážejí v pohybu"
                            },
                            {
                                "target_lang_word": "nepřehledný",
                                "target_lang_sense_clarification": "o prostoru, kde je kvůli nepořádku chaos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85e81bd2-e513-341c-b120-5fb514987418",
                    "sense_definition": "Simple past and past participle of <w>clutter</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
