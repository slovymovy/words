                                "example_id": "f2035b33-9778-4be4-99e0-d170c5db886c",
                                "sense_id": "10b12f86-826a-3ebc-a90b-75486f30a932",
                                "text": "Zoals Hij hen vergaf die Hem ter dood brachten, vergeef ook jij wat je redelijkerwijze anderen moet vergeven."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0d184dc-85eb-35a0-90f3-d68ff20773b6",
