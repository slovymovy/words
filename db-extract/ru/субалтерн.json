                "senses": [
                    {
                        "sense_id": "c7fef7ea-c60a-3582-bf64-adaa030b5d76",
                        "entry_id": "81239fa0-12b2-3c09-9a59-46311226ae2d",
                        "glosses": [
                            "воен. то же, что субалтерн-офицер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e7d6ef-8c8c-4525-a5f1-26f40320875b",
                                "sense_id": "c7fef7ea-c60a-3582-bf64-adaa030b5d76",
                                "text": "Под конец сошлась она с поручиком Вишняковым, субалтерном из ихней роты."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7713008-80b9-4a68-b0a1-08f8e209d268",
                        "source_entry_id": "81239fa0-12b2-3c09-9a59-46311226ae2d",
                        "source_sense_id": "c7fef7ea-c60a-3582-bf64-adaa030b5d76",
                        "target_lang_word": "subaltern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subaltern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc996a04-a860-37bb-ba3f-634ddbc4db1e",
                                        "entry_id": "1cba63ff-ecb9-337b-82c6-4086d53a3551",
                                        "glosses": [
                                            "Of a lower rank or position; inferior or secondary; especially (military) ranking as a junior officer, below the rank of captain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341a3923-de0a-496f-8c9e-36d3dd0475f5",
                                                "sense_id": "fc996a04-a860-37bb-ba3f-634ddbc4db1e",
                                                "text": "a subaltern officer"
                                            },
                                            {
                                                "example_id": "bc55cdf0-cfa5-4037-989a-3213ed682665",
                                                "sense_id": "fc996a04-a860-37bb-ba3f-634ddbc4db1e",
                                                "text": "Two weeks after giving birth[…] she [Rachida Dati] was removed and offered no consolation prize other than the subaltern position of No 2 on the UMP's list for the next European elections."
                                            },
                                            {
                                                "example_id": "d0419fc6-bdd9-4f4b-b25a-757fdb8ea5a0",
                                                "sense_id": "fc996a04-a860-37bb-ba3f-634ddbc4db1e",
                                                "text": "Celebrating the subversive practices of subaltern groups"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5645e1a4-faf8-31e0-8aa7-461883a79c58",
                                        "entry_id": "1cba63ff-ecb9-337b-82c6-4086d53a3551",
                                        "glosses": [
                                            "Asserting only a part of what is asserted in a related proposition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "subaltern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d646ad3-a052-37e2-9fdc-d2d630802c85",
                                        "entry_id": "ddfc3859-eeb8-3d4e-869a-37875d69eb5e",
                                        "glosses": [
                                            "A subordinate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dd605b9-980b-377b-884f-5c309ca42d36",
                                        "entry_id": "ddfc3859-eeb8-3d4e-869a-37875d69eb5e",
                                        "glosses": [
                                            "A commissioned officer having a rank below that of captain; a lieutenant or second lieutenant."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f394131-249f-4ab4-9cbd-ee12894571b3",
                                                "sense_id": "7dd605b9-980b-377b-884f-5c309ca42d36",
                                                "text": "She was an extraordinarily beautiful girl, Margaret Devereux ; and made all the men frantic by running away with a penniless young fellow ; a mere nobody sir a subaltern in a foot regiment, or something of that kind."
                                            },
                                            {
                                                "example_id": "c3e3eb06-50e6-4faf-94f8-1b0e5ad24ecd",
                                                "sense_id": "7dd605b9-980b-377b-884f-5c309ca42d36",
                                                "text": "As a subaltern of 24, Neave was captured in the defence of Calais in May 1940."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71049899-5cf8-3d57-b7f7-4911d10466ba",
                                        "entry_id": "ddfc3859-eeb8-3d4e-869a-37875d69eb5e",
                                        "glosses": [
                                            "A subaltern proposition; a proposition implied by a universal proposition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df12d6be-9520-3b8e-b1fb-1a6103e90edb",
                                        "entry_id": "ddfc3859-eeb8-3d4e-869a-37875d69eb5e",
                                        "glosses": [
                                            "A member of a group that is socially, politically and geographically outside of the hegemonic power structure of the colony and of the colonial homeland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbe5486-f365-4410-a71a-a9f93274445f",
                                                "sense_id": "df12d6be-9520-3b8e-b1fb-1a6103e90edb",
                                                "text": "Young refers sardonically to the existence of reams of postcolonial \"theory\", and promises to give us \"postcolonialism from below, which is what and where it should rightly be, given that it elaborates a politics of ‘the subaltern’, that is, subordinated classes and peoples\"."
                                            },
                                            {
                                                "example_id": "c8f42bfc-8476-4534-96d9-c1028f42ed85",
                                                "sense_id": "df12d6be-9520-3b8e-b1fb-1a6103e90edb",
                                                "text": "In Ghosh's novel, a canonical western scientist is pitted against a counterscientific group of native folk-medicine practitioners led by Mangala, a subaltern in every conceivable meaning of the term."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4b94b15-49ed-45b9-b6ae-38d468bade2c",
                        "source_entry_id": "81239fa0-12b2-3c09-9a59-46311226ae2d",
                        "source_sense_id": "c7fef7ea-c60a-3582-bf64-adaa030b5d76",
                        "target_lang_word": "Subalterne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3004b876-bc1e-44ce-a502-e2a9ab7ab89a",
                        "source_entry_id": "81239fa0-12b2-3c09-9a59-46311226ae2d",
                        "source_sense_id": "c7fef7ea-c60a-3582-bf64-adaa030b5d76",
                        "target_lang_word": "subalterne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subalterne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d47b6a3b-ee02-32bd-83de-d51325f6ec23",
                                        "entry_id": "47c9ddc3-fb27-3fce-b7f0-f6c25610ee7b",
                                        "glosses": [
                                            "Qui est subordonné, inférieur, secondaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6e711b-cff7-4f5a-afb9-791a2d7d4142",
                                                "sense_id": "d47b6a3b-ee02-32bd-83de-d51325f6ec23",
                                                "text": "Le nombre des officiers subalternes est très considérable, leurs titres et leurs noms sont rapportés dans l'almanach impérial."
                                            },
                                            {
                                                "example_id": "80ecc72a-9fdb-4677-b845-7c4032a9fab5",
                                                "sense_id": "d47b6a3b-ee02-32bd-83de-d51325f6ec23",
                                                "text": "Les officiers subalternes de l’ordre portaient le même costume noir, …."
                                            },
                                            {
                                                "example_id": "9532327b-0d9b-4359-9a0e-4379aaf17bbd",
                                                "sense_id": "d47b6a3b-ee02-32bd-83de-d51325f6ec23",
                                                "text": "La sotte idée d'être regardé comme un amant subalterne, à cause de sa naissance obscure, disparut aussi."
                                            },
                                            {
                                                "example_id": "6a026c9f-9d07-49e9-9615-4a30112a5204",
                                                "sense_id": "d47b6a3b-ee02-32bd-83de-d51325f6ec23",
                                                "text": "Si le gouvernement alloue aux membres du haut clergé des traitements supérieurs à ceux du clergé subalterne, c'est qu'il le veut bien."
                                            },
                                            {
                                                "example_id": "88969693-f1fb-4b28-8b47-76296a30c237",
                                                "sense_id": "d47b6a3b-ee02-32bd-83de-d51325f6ec23",
                                                "text": "Le hasard l'avait conduit chez les faisans, lui permettant d'échapper à la condition subalterne et mouisarde de représentant en cartes postales illustrées […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa79d6ec-6230-328b-b742-e6c57ff1c9c8",
                                        "entry_id": "47c9ddc3-fb27-3fce-b7f0-f6c25610ee7b",
                                        "glosses": [
                                            "Qualifie l’esprit médiocre, borné, incapable d’initiative d’un homme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b4cfd8-2ebb-41d0-bdc6-104b9af62737",
                                                "sense_id": "aa79d6ec-6230-328b-b742-e6c57ff1c9c8",
                                                "text": "Ce serait déjà un progrès que les masses subalternes prostrées, désorientées, désagrégées sortent de cet état qui les disposent à servie^([sic]) de masses de manœuvres pour des guerres qui ne sont pas les leurs, qu'elles expriment leur colère en évitant autant que possible le piège qu'est le cycle des réciprocités négatives meurtrières, qu'elles transforment leur colère en agir politique en pariant sur le devenir civilisé de cet agir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subalterne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34f6899d-7035-360c-9a31-20c3e6d4d2a4",
                                        "entry_id": "08f44879-00f4-36ff-9a68-7ec250ead5bb",
                                        "glosses": [
                                            "Subordonné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b8e5086-273e-46bb-a164-b1662bebb277",
                                                "sense_id": "34f6899d-7035-360c-9a31-20c3e6d4d2a4",
                                                "text": "Ce n’est qu’un(e) subalterne, un(e) simple subalterne."
                                            },
                                            {
                                                "example_id": "5613c50c-b561-4a79-b107-7d3f5406cfba",
                                                "sense_id": "34f6899d-7035-360c-9a31-20c3e6d4d2a4",
                                                "text": "Alors, pour ses supérieurs, il se levait à demi ; pour ses égaux, il se renversait dans son fauteuil ; pour ses subalternes, il ne bougeait point, et pendant plusieurs minutes, quelquefois pendant un quart d’heure, il continuait d’écrire ou de lire, comme s’il était seul."
                                            },
                                            {
                                                "example_id": "4264f705-8ae4-46b7-b8de-e1bcf4703e7b",
                                                "sense_id": "34f6899d-7035-360c-9a31-20c3e6d4d2a4",
                                                "text": "Ribadier. — Et qui ? Qui ? Son cocher ! Ça serait un homme bien… encore…Non seulement on n'a aucune domination sur la nature, mais on est ses subalternes. — (Sous-titres Jurassic World Dominion, 38:45)/>Thommereux. — Oui, mais quand on lui propose un homme bien, elle n’en veut pas !\nRibadier. — Mais un cocher ! Un subalterne !\nThommereux. — Ah ! Mon pauvre ami ! ça fait mal dans ta bouche !"
                                            },
                                            {
                                                "example_id": "f44db92f-fb9e-421a-a312-20a5008165cb",
                                                "sense_id": "34f6899d-7035-360c-9a31-20c3e6d4d2a4",
                                                "text": "Je me tais. conformément aux articles 13 et 69 du règlement de la Sûreté nationale qui stipulent : « Quand un chef te savonne, subalterne indigne, tu fermes ta gueule pour ne pas mousser en dedans et faire une colique. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
