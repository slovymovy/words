                        "glosses": [
                            "Saucisson."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1995035a-fc8b-42a8-b808-ef710f4635f5",
                                "sense_id": "d358919b-b14c-3b7f-b84d-1fda0fcc6690",
                                "text": "Ma mère dit souvent : « T’as de la peau de sauss sur les yeux! » lorsqu’on ne trouve pas ce que l’on cherche. Pour le coup, elle parle de saucisson, mais en tant que divine cuisinière, elle s’amuse souvent à utiliser des aliments dans ses expressions."
                            },
                            {
                                "example_id": "b98146c3-a093-4e08-aa12-677c04387c0d",
                                "sense_id": "d358919b-b14c-3b7f-b84d-1fda0fcc6690",
                                "text": "Le vendredi soir, avant de se quitter, on faisait l’apéro avec des chips, des olives, du sauss, comme disait Brigitte."
                            },
                            {
                                "example_id": "cd37fac3-55a0-4d51-9790-5937cf44f2ab",
                                "sense_id": "d358919b-b14c-3b7f-b84d-1fda0fcc6690",
                                "text": "Nous mangeâmes un bout de sauss, une moitié de fromage, croquâmes une pomme et ce fut le retour."
                            }
                        ]
                    }
                ],
