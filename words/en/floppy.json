{
    "word_family": [
        "flop",
        "floppiness",
        "floppily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78409a1d-79e2-39c7-b052-1cd003fe0846",
                    "sense_definition": "Limp, flexible, and not firm or rigid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy has large <w>floppy</w> ears that bounce when he runs.",
                            "target_lang_translations": {
                                "ru": "У щенка большие <w>висячие</w> уши, которые подпрыгивают, когда он бежит.",
                                "cs": "Štěně má velká <w>svěšená</w> uši, která při běhu poskakují."
                            }
                        },
                        {
                            "text": "She wore a <w>floppy</w> hat to protect her face from the sun.",
                            "target_lang_translations": {
                                "ru": "На ней была шляпа с <w>мягкими</w> полями, чтобы защитить лицо от солнца.",
                                "cs": "Měla na sobě klobouk s <w>měkkou</w> krempou, aby si chránila obličej před sluncem."
                            }
                        }
                    ],
                    "synonyms": [
                        "flopsy"
                    ],
                    "antonyms": [
                        "stiff",
                        "rigid",
                        "firm"
                    ],
                    "common_phrases": [
                        "floppy hat",
                        "floppy ears",
                        "floppy disk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, свисающий или гибкий; не обладающий жесткостью или твердостью.",
                        "cs": "Ohebný, měkký, svěšený nebo nepevný; postrádající tuhost."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "висячий",
                                "target_lang_sense_clarification": "о форме ушей или полей шляпы"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "не жесткий"
                            },
                            {
                                "target_lang_word": "гибкий",
                                "target_lang_sense_clarification": "легко гнущийся"
                            },
                            {
                                "target_lang_word": "вялый",
                                "target_lang_sense_clarification": "лишенный упругости"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "svěšený",
                                "target_lang_sense_clarification": "o uších nebo okrajích klobouku"
                            },
                            {
                                "target_lang_word": "měkký",
                                "target_lang_sense_clarification": "není tuhý"
                            },
                            {
                                "target_lang_word": "ohebný",
                                "target_lang_sense_clarification": "snadno se ohýbá"
                            },
                            {
                                "target_lang_word": "povadlý",
                                "target_lang_sense_clarification": "postrádající pružnost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae9c3147-3cac-3817-9fb5-14ca3654fc53",
                    "sense_definition": "A flexible magnetic storage medium, commonly known as a <w>floppy</w> disk.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found an old <w>floppy</w> in the drawer, but I no longer have a drive to read it.",
                            "target_lang_translations": {
                                "ru": "Я нашел в ящике старую <w>дискету</w>, но у меня больше нет дисковода, чтобы ее прочитать.",
                                "cs": "V šuplíku jsem našel starou <w>disketu</w>, ale už nemám mechaniku, abych ji přečetl."
                            }
                        },
                        {
                            "text": "Before USB sticks became popular, we used a <w>floppy</w> to transfer small files.",
                            "target_lang_translations": {
                                "ru": "До того как стали популярны флешки, мы использовали <w>гибкий диск</w> для переноса небольших файлов.",
                                "cs": "Než se staly populárními USB disky, používali jsme k přenosu malých souborů <w>disketu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "old floppy",
                        "floppy drive"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to obsolete technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гибкий магнитный диск для хранения компьютерных данных.",
                        "cs": "Pružné magnetické médium pro ukládání počítačových dat, známé jako disketa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискета",
                                "target_lang_sense_clarification": "магнитный носитель"
                            },
                            {
                                "target_lang_word": "гибкий диск",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "disketa",
                                "target_lang_sense_clarification": "magnetické paměťové médium"
                            },
                            {
                                "target_lang_word": "pružný disk",
                                "target_lang_sense_clarification": "technický popis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "111f08ca-f63a-3ca9-857b-dce66681eacb",
                    "sense_definition": "A traditional thin, paper comic book, as opposed to a thick graphic novel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Collectors often prefer buying a <w>floppy</w> every month rather than waiting for the collected volume.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры часто предпочитают покупать <w>сингл</w> каждый месяц, а не ждать выхода сборника.",
                                "cs": "Sběratelé často preferují kupovat každý měsíc <w>sešit</w>, než aby čekali na vydání souborného svazku."
                            }
                        },
                        {
                            "text": "The shop specializes in rare <w>floppies</w> from the Silver Age of comics.",
                            "target_lang_translations": {
                                "ru": "Магазин специализируется на редких <w>выпусках</w> Серебряного века комиксов.",
                                "cs": "Obchod se specializuje na vzácné <w>sešitové komiksy</w> ze stříbrného věku komiksu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monthly floppy",
                        "collecting floppies"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used within the comic book community"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный тонкий комикс в мягкой обложке, выходящий ежемесячно.",
                        "cs": "Tradiční tenký sešitový komiks v měkké vazbě, obvykle vycházející měsíčně."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сингл",
                                "target_lang_sense_clarification": "отдельный выпуск комикса"
                            },
                            {
                                "target_lang_word": "флоппи",
                                "target_lang_sense_clarification": "сленг любителей комиксов"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "sešitový komiks",
                                "target_lang_sense_clarification": "jednotlivé vydání komiksu"
                            },
                            {
                                "target_lang_word": "singl",
                                "target_lang_sense_clarification": "slangové označení pro jeden sešit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78a46484-9123-3cbd-a06d-e9e65c90a018",
                    "sense_definition": "A derogatory term for an insurgent, specifically used during the Rhodesian Bush War.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "warfare_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers used the term <w>floppy</w> to refer to the enemy fighters they encountered.",
                            "target_lang_translations": {
                                "ru": "Солдаты использовали термин <w>флоппи</w> для обозначения вражеских бойцов, с которыми они сталкивались.",
                                "cs": "Vojáci používali termín <w>floppy</w> k označení nepřátelských bojovníků, se kterými se setkali."
                            }
                        },
                        {
                            "text": "Historical accounts of the conflict mention the use of the word <w>floppy</w> by local forces.",
                            "target_lang_translations": {
                                "ru": "В исторических отчетах о конфликте упоминается использование слова <w>флоппи</w> местными войсками.",
                                "cs": "Historické záznamy o konfliktu zmiňují používání slova <w>floppy</w> místními jednotkami."
                            }
                        }
                    ],
                    "synonyms": [
                        "terr",
                        "gook"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly offensive and historical"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Specific to Southern Africa/Rhodesia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное прозвище повстанцев во время войны в Родезии.",
                        "cs": "Hanlivé označení pro povstalce používané během občanské války v Rhodesii."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флоппи",
                                "target_lang_sense_clarification": "исторический сленг, пренебрежительно"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "povstalec",
                                "target_lang_sense_clarification": "historický kontext, pejorativně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}