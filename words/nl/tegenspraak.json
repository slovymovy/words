{
    "word_family": [
        "tegenspreken",
        "spraak",
        "tegenspreker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b33d3094-14f3-32b3-b27b-1f1f55b95f48",
                    "sense_definition": "Een logische inconsistentie of situatie waarin twee beweringen niet tegelijk waar kunnen zijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contradictie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een duidelijke <w>tegenspraak</w> in zijn verklaringen van gisteren en vandaag.",
                            "target_lang_translations": {
                                "en": "There is a clear <w>contradiction</w> in his statements from yesterday and today."
                            }
                        },
                        {
                            "text": "Zijn theorie is gebaseerd op een innerlijke <w>tegenspraak</w>.",
                            "target_lang_translations": {
                                "en": "His theory is based on an internal <w>contradiction</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tegenstrijdigheid",
                        "contradictie"
                    ],
                    "common_phrases": [
                        "innerlijke tegenspraak"
                    ],
                    "target_lang_definitions": {
                        "en": "A logical inconsistency or situation in which two statements cannot be true at the same time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contradiction",
                                "target_lang_sense_clarification": "logical inconsistency"
                            },
                            {
                                "target_lang_word": "inconsistency",
                                "target_lang_sense_clarification": "lack of agreement or harmony"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67a100ea-2629-343c-96c4-3169b33197f3",
                    "sense_definition": "Het uiten van een afwijkende of tegenovergestelde mening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meningsverschil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur duldde geen enkele <w>tegenspraak</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "The director tolerated no <w>contradiction</w> whatsoever during the meeting."
                            }
                        },
                        {
                            "text": "Zonder angst voor <w>tegenspraak</w> gaf zij haar duidelijke mening.",
                            "target_lang_translations": {
                                "en": "Without fear of <w>contradiction</w>, she gave her clear opinion."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geen tegenspraak dulden"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing a differing or opposing opinion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contradiction",
                                "target_lang_sense_clarification": "opposing or speaking against someone"
                            },
                            {
                                "target_lang_word": "opposition",
                                "target_lang_sense_clarification": "disagreement or resistance"
                            },
                            {
                                "target_lang_word": "objection",
                                "target_lang_sense_clarification": "expression of opposition or disapproval"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f720738c-556e-3f34-8ffc-b5e54a9e530d",
                    "sense_definition": "Brutale of opstandige reacties, vooral van kinderen tegenover volwassenen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "brutaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil nu geen <w>tegenspraak</w> meer horen, ga onmiddellijk naar je kamer.",
                            "target_lang_translations": {
                                "en": "I don't want to hear any more <w>talking back</w> now, go to your room immediately."
                            }
                        },
                        {
                            "text": "Zijn constante <w>tegenspraak</w> begon de leraar behoorlijk te irriteren.",
                            "target_lang_translations": {
                                "en": "His constant <w>backtalk</w> was starting to annoy the teacher quite a bit."
                            }
                        }
                    ],
                    "synonyms": [
                        "tegenpruttelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Insolent, defiant, or argumentative responses, especially from children towards adults."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "talking back",
                                "target_lang_sense_clarification": "answering disrespectfully"
                            },
                            {
                                "target_lang_word": "backtalk",
                                "target_lang_sense_clarification": "insolent, argumentative replies"
                            },
                            {
                                "target_lang_word": "defiance",
                                "target_lang_sense_clarification": "rebellious opposition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "565ea75e-70e7-3971-8abc-e8e92f229bc4",
                    "sense_definition": "De handeling van het <w>tegenspreken</w> of ontkennen van een bewering.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ontkenning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>tegenspraak</w> van de getuigenis leidde tot grote twijfel bij de rechter.",
                            "target_lang_translations": {
                                "en": "The <w>contradiction</w> of the testimony led to great doubt for the judge."
                            }
                        },
                        {
                            "text": "Zijn felle <w>tegenspraak</w> van de feiten overtuigde uiteindelijk niemand.",
                            "target_lang_translations": {
                                "en": "His fierce <w>denial</w> of the facts ultimately convinced no one."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act of contradicting or denying a statement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "denial",
                                "target_lang_sense_clarification": "assertion of untruth or refusal to admit"
                            },
                            {
                                "target_lang_word": "contradiction",
                                "target_lang_sense_clarification": "the act of denying or refuting a claim"
                            },
                            {
                                "target_lang_word": "refutation",
                                "target_lang_sense_clarification": "proving a statement to be false"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}