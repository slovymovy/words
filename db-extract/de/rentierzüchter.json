                "senses": [
                    {
                        "sense_id": "88105e95-3b82-3da0-b6a0-5950cfe8e264",
                        "entry_id": "d329d71a-bfdd-3222-ac1f-fb1f1ab5f38a",
                        "glosses": [
                            "Person, die eine große Anzahl Rentiere hält und diese züchtet"
                        ],
                        "tags": [
                            "Agrarwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "dd599d51-2f4a-4434-ac8b-b35c944f1a86",
                                "sense_id": "88105e95-3b82-3da0-b6a0-5950cfe8e264",
                                "text": "„Rentierzüchter in ‚Lappland‘ (richtig: Sápmi) kennzeichnen ihre Rentiere traditionell mit Kerben in den Ohren der Tiere.“"
                            },
                            {
                                "example_id": "c851aefa-1877-4f71-aa29-11bb53bf958b",
                                "sense_id": "88105e95-3b82-3da0-b6a0-5950cfe8e264",
                                "text": "„Die Rentierzüchter, die regelmäßig beim Hof vorbeikamen, um ihre Erzeugnisse zu verkaufen, stellten diese Art von Skiern selbst her und verkauften sie nur zu gerne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
