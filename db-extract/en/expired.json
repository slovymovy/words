                        "target_lang_word": "abgelaufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abgelaufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d6c335f-4b03-3d12-9be0-1f03442cffe0",
                                        "entry_id": "45ed941c-22c1-332e-ab22-321529b439ab",
                                        "glosses": [
                                            "länger gelagert, als das aufgedruckte Verfallsdatum; Verfallsdatum < aktuelles Datum, ein Gültigkeitsdatum überschritten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643bfe4d-48ba-4d21-8cfd-1cfc1045afb7",
                                                "sense_id": "8d6c335f-4b03-3d12-9be0-1f03442cffe0",
                                                "text": "„Das ist zwar abgelaufene Milch, aber mach sie doch mal auf, wenn sie schlecht ist, dann riechst du das.“"
                                            },
                                            {
                                                "example_id": "531af4f9-e337-4ec7-9ded-952f64263a56",
                                                "sense_id": "8d6c335f-4b03-3d12-9be0-1f03442cffe0",
                                                "text": "„Der Pass ist abgelaufen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9665add-801a-31e9-a9d3-a82e7c3270ed",
                                        "entry_id": "45ed941c-22c1-332e-ab22-321529b439ab",
                                        "glosses": [
                                            "Schuhe, die viel benutzt wurden, deren Absätze schief abgelaufen, bezeichnet man als abgelaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb957331-0c59-45c3-be13-ca1676036398",
                                                "sense_id": "f9665add-801a-31e9-a9d3-a82e7c3270ed",
                                                "text": "„Mit so abgelaufenen Schuhen kannst du nicht zu einem Vorstellungsgespräch gehen. Das sieht unmöglich aus!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ea9c1c1-4ca2-3f56-9b1f-829fa4107153",
                                        "entry_id": "45ed941c-22c1-332e-ab22-321529b439ab",
                                        "glosses": [
                                            "in einer Organisation, einem Unternehmen, einem Theater, einer Oper: vergangen, zu Ende gegangen, vorbei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf50169-2273-4824-b2bc-8b42a114e028",
                                                "sense_id": "4ea9c1c1-4ca2-3f56-9b1f-829fa4107153",
                                                "text": "„Unsere Firma kann im abgelaufenen Geschäftsjahr auf eine erheblichen Umsatz- und Gewinnsteigerung zurück blicken. Lassen Sie mich die Zahlen im Einzelnen und einen Ausblick auf die Zukunft darlegen: …“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "618fdb0e-1f40-3e65-9c7e-805c2be3a9e5",
                                        "entry_id": "45ed941c-22c1-332e-ab22-321529b439ab",
                                        "glosses": [
                                            "verstrichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed3fa80-dcf0-4016-97b7-a38154a9309c",
                                                "sense_id": "618fdb0e-1f40-3e65-9c7e-805c2be3a9e5",
                                                "text": "Die abgelaufene Frist zur Beantragung der Abwrackprämie wird nicht mehr verlängert. Autofahrer, die sich bis jetzt nicht entschließen konnten, haben Pech gehabt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "80c2eadc-4894-35c1-b5ad-ba2895039ae3",
                                        "entry_id": "45ed941c-22c1-332e-ab22-321529b439ab",
                                        "glosses": [
                                            "(??veraltet) Ausdruck der Verachtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b0325a-26e2-4a6c-ba8b-0821fb1d304b",
                                                "sense_id": "80c2eadc-4894-35c1-b5ad-ba2895039ae3",
                                                "text": "Und die Frau schrie: Du bist abgelaufen, du Bluffer!"
                                            },
                                            {
                                                "example_id": "128ad9b3-a459-4f46-9401-7efd8abd8d62",
                                                "sense_id": "80c2eadc-4894-35c1-b5ad-ba2895039ae3",
                                                "text": "„\"Berlusconi, du bist abgelaufen\", stand auf dem nackten Oberkörper der Frau, die in Mailand im Wahllokal auf einen Tisch geklettert war.„"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
