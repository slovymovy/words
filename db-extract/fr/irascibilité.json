                "senses": [
                    {
                        "sense_id": "d82f846d-c614-3417-bced-60d61088a71e",
                        "entry_id": "835714c4-9d4a-3445-8bb9-0a837fe266f7",
                        "glosses": [
                            "Défaut d’une personne irascible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f136654-e5a8-456d-8a8e-aac4674d3c2d",
                                "sense_id": "d82f846d-c614-3417-bced-60d61088a71e",
                                "text": "Sa maladie le rend d’une grande irascibilité."
                            },
                            {
                                "example_id": "8e8bc84b-fdb6-46f3-87b6-3254de92057f",
                                "sense_id": "d82f846d-c614-3417-bced-60d61088a71e",
                                "text": "L’irascibilité ne s’attache pas à un objet ni à une situation spécifique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cbc47d7-4c29-4c4b-8a19-b96eab5958ab",
                        "source_entry_id": "835714c4-9d4a-3445-8bb9-0a837fe266f7",
                        "source_sense_id": "d82f846d-c614-3417-bced-60d61088a71e",
                        "target_lang_word": "Jähzorn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jähzorn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35090bff-d8b1-324f-a44d-72186fb93102",
                                        "entry_id": "9702d67d-8a2f-3085-8d47-cfb7f644c7cf",
                                        "glosses": [
                                            "plötzlich aufwallender, heftiger Zorn als Reaktion auf ein bestimmtes Vorkommnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6401185-196d-4a14-a12c-8211c9043393",
                                                "sense_id": "35090bff-d8b1-324f-a44d-72186fb93102",
                                                "text": "„Sie forschte genau, ob jemals ein Streit zwischen Meister und Gesellen vorgefallen, ob vielleicht Olivier nicht ganz frei von jenem Jähzorn sei, der oft wie ein blinder Wahnsinn die gutmütigsten Menschen überfällt und zu Taten verleitet, die alle Willkür des Handelns auszuschließen scheinen.“"
                                            },
                                            {
                                                "example_id": "d8177906-3a33-4d97-8223-83bbad7fb729",
                                                "sense_id": "35090bff-d8b1-324f-a44d-72186fb93102",
                                                "text": "„Das einzige, was Nikolai bei seinem gutsherrlichen Wirken bisweilen peinlich in die Quere kam, war seine Neigung zum Jähzorn im Verein mit seiner alten Husarengewohnheit, immer gleich zuzuhauen.“"
                                            },
                                            {
                                                "example_id": "4f9cf0ee-4ee4-45de-a1ed-41243c99abca",
                                                "sense_id": "35090bff-d8b1-324f-a44d-72186fb93102",
                                                "text": "„Der Alte hat in seinem Jähzorn schon eine gehörige Menge Mist gebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66c6140f-12e3-40dd-9078-7b7019e653cd",
                        "source_entry_id": "835714c4-9d4a-3445-8bb9-0a837fe266f7",
                        "source_sense_id": "d82f846d-c614-3417-bced-60d61088a71e",
