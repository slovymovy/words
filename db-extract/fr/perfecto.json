                                                "example_id": "d80ac56f-d2fc-409b-9f42-827eb16e95ab",
                                                "sense_id": "85e07934-4309-3d61-8190-ed29a8c28c6d",
                                                "text": "Kupiłem wczoraj fajną ramoneskę."
                                            },
                                            {
                                                "example_id": "a21591df-8bbe-4e7f-923e-dac3181e5226",
                                                "sense_id": "85e07934-4309-3d61-8190-ed29a8c28c6d",
