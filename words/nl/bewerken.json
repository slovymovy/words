                    "frequency": "Middle",
                    "semantic_group_id": "verwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ruwe ijzer werd eerst in de fabriek <w>bewerkt</w> tot sterke staven.",
