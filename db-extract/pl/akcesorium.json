                    {
                        "sense_id": "befa8f39-68e9-358f-9758-b314401ee6a1",
                        "entry_id": "0442743c-0b9d-3974-a0a4-42420adf0dda",
                        "glosses": [
                            "drobny przedmiot stanowiący dodatkowe wyposażenie"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "d4a75c7e-eb17-42d4-b339-9aef75763429",
                                "sense_id": "befa8f39-68e9-358f-9758-b314401ee6a1",
                                "text": "Zauważył typowe akcesoria do golenia i mycia zębów, aspirynę i lek na zgagę oraz znacznie większy wybór szamponów, odżywek do włosów i balsamów do ciała, niż jego zdaniem mógłby potrzebować Roy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "68401495-8ebf-3cb9-b040-167fac1bb2e5",
                        "entry_id": "0442743c-0b9d-3974-a0a4-42420adf0dda",
                        "glosses": [
                            "przedmiot charakterystyczny dla jakiegoś zawodu"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3152b3b-8ea9-460b-9e4c-766a8e9a1ece",
                        "source_entry_id": "0442743c-0b9d-3974-a0a4-42420adf0dda",
                        "source_sense_id": "befa8f39-68e9-358f-9758-b314401ee6a1",
                        "target_lang_word": "accessory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accessory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Having a secondary, supplementary or subordinate function by accompanying as a subordinate; aiding in a secondary way; being additional; contributing or being contributory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1f839e-e925-4c86-b950-eb7273dfb4e2",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "accessory garments"
                                            },
                                            {
                                                "example_id": "dab61d60-8305-43a7-b73c-dce172ea510b",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "Surprise parties succeed with the help of accessory neighbors or colleagues."
                                            },
                                            {
                                                "example_id": "0d35c4b1-30c9-4ded-a242-fe7ee3408cb8",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "Amongst many secondary, and accessory causes that support Monarchy, these are not of least reckning, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21ef40c6-9c50-31f5-9e59-9b6f9a3e0ea1",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Assisting a crime without actually participating in committing the crime itself; being connected as an incident or subordinate to a principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d696f1-8780-4309-a54a-3f9c7aed4de0",
                                                "sense_id": "21ef40c6-9c50-31f5-9e59-9b6f9a3e0ea1",
                                                "text": "Her actions were clearly accessory because they helped him commit and probably also conceal the crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30dd0a98-f3bb-3a40-8c19-7c51dc73e202",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Present in a minor amount, and not essential."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c5781af-adb8-46f5-a7a6-16ee6e0ee9b2",
                                                "sense_id": "30dd0a98-f3bb-3a40-8c19-7c51dc73e202",
                                                "text": "accessory mineral"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accessory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "Something that belongs to part of another main thing; something additional and subordinate, an attachment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698af3dc-9d57-4e3e-a920-3adcf937f3c8",
                                                "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                                "text": "the accessories of a mobile phone"
                                            },
                                            {
                                                "example_id": "ba125a51-b0e4-4586-b69c-c922b241eb75",
                                                "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                                "text": "the aspect and accessories of a den of banditti"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "658bb524-9276-3bf5-a260-eaccc5e701a2",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "An article that completes one's basic outfit, such as a scarf or gloves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b902d524-a6d8-446a-921f-aebd95425b1e",
                                                "sense_id": "658bb524-9276-3bf5-a260-eaccc5e701a2",
                                                "text": "One of the first of a wave of American women contemporary designers who emerged in the 1990s, she [Kate Spade] built a brand on the appeal of clothes and accessories that made shoppers smile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "A person who is not present at a crime, but contributes to it as an assistant or instigator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ec0155-db11-46d7-bc71-61d212d30454",
                                                "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                                "text": "She was an accessory to the murder because she helped him commit and probably also conceal the crime."
                                            },
                                            {
                                                "example_id": "15044880-7a6f-495e-ba17-e3f6e3a66009",
                                                "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                                "text": "“You can be an accessory before the fact, or an accessory after the fact. It doesnʼt matter if itʼs before or after; either way youʼd be in for it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc1751cc-c7e2-35d4-9104-1ade255b7699",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "Something in a work of art without being indispensably necessary, for example solely ornamental parts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d712583c-d812-493a-ab35-a517739def88",
                        "source_entry_id": "0442743c-0b9d-3974-a0a4-42420adf0dda",
                        "source_sense_id": "befa8f39-68e9-358f-9758-b314401ee6a1",
                        "target_lang_word": "accoutrement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accoutrement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6044b9b8-ef8a-3cea-be08-c25c0fe3cbc1",
                                        "entry_id": "118f7f5a-3798-37df-b17b-0848b5a27bab",
                                        "glosses": [
                                            "Alternative form of accouterment."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c471ae7c-8a91-48a5-a972-57d05031ca02",
                                                "sense_id": "6044b9b8-ef8a-3cea-be08-c25c0fe3cbc1",
                                                "text": "Strange to relate, this ludicrous accoutrement was far from moving me to laughter."
                                            },
                                            {
                                                "example_id": "5374071a-c5bc-4a8c-befe-a14b2141366c",
                                                "sense_id": "6044b9b8-ef8a-3cea-be08-c25c0fe3cbc1",
                                                "text": "A little ship, with oars and food / and little dishes, and all accoutrements / fitting and ready for the departing soul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b299d0a-1b04-4e29-9f52-326e5138919b",
                        "source_entry_id": "0442743c-0b9d-3974-a0a4-42420adf0dda",
                        "source_sense_id": "befa8f39-68e9-358f-9758-b314401ee6a1",
                        "target_lang_word": "Accessoire",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Accessoire",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                        "entry_id": "daaee4b8-a05c-30be-bd48-405d55f3eedf",
                                        "glosses": [
                                            "modisches Zubehör, besonders zur Kleidung (Schmuck, Gürtel und so weiter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e24216-6616-4b73-932e-946f0cda781e",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "Dabei handelt es sich beim Seidentuch um ein enorm anspruchsvolles Accessoire."
                                            },
                                            {
                                                "example_id": "18143bff-eab7-4c7e-bcc5-83dbb5dd7e70",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "Alles, was Frauen so mit sich herumtragen, ist ja in erster Linie Accessoire und wird nicht an seiner Funktionalität gemessen, sondern nach modischen Kriterien beurteilt."
                                            },
                                            {
                                                "example_id": "12ffcde3-992d-4146-a48d-ae1e115e6c3d",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "„Denn für Frauen ist das Kraftfahrzeug eines von sehr vielen Accessoires und wird teilweise genau so gehandhabt wie beispielsweise die Handtasche:…“"
                                            },
                                            {
                                                "example_id": "a3564406-fdcb-4115-bbae-2336a5800319",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "„Der Garten – er ist nicht bloßes Accessoire bürgerlich etablierter Existenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5ee28c3-4af0-4ac5-8d10-906aa3c21cb4",
                        "source_entry_id": "0442743c-0b9d-3974-a0a4-42420adf0dda",
                        "source_sense_id": "befa8f39-68e9-358f-9758-b314401ee6a1",
                        "target_lang_word": "Zubehör",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zubehör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b70bc9d-6273-3dd6-b8ab-4ce6006302f5",
                                        "entry_id": "c1afbc6d-12e5-3728-bf88-1f4866718ac1",
                                        "glosses": [
                                            "Gegenstände, die eine Grundausstattung ergänzen oder erweitern oder die durch ihre Beschaffenheit einer bestimmten Tätigkeit zuzuordnen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f517712-6a5c-41f5-853a-c750ecd5e6b0",
                                                "sense_id": "3b70bc9d-6273-3dd6-b8ab-4ce6006302f5",
                                                "text": "Das Zubehör ist im Preis inbegriffen."
                                            },
                                            {
                                                "example_id": "4291bea0-fdb1-48ba-8822-003b7fe4a3b5",
                                                "sense_id": "3b70bc9d-6273-3dd6-b8ab-4ce6006302f5",
                                                "text": "Zu dieser Kamera gibt es noch allerlei Zubehör, wie Tasche, Fernauslöser und Stativ."
                                            },
                                            {
                                                "example_id": "34eb9f7b-72c3-412c-a369-fcf05599c62f",
                                                "sense_id": "3b70bc9d-6273-3dd6-b8ab-4ce6006302f5",
                                                "text": "„Sobald du dich auf einen einlässt, wirst du die Hälfte deines Monatsgehalts für Zubehör ausgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
