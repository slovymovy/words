                "senses": [
                    {
                        "sense_id": "b6a2dfc1-89e4-3894-8fde-0a51279c5684",
                        "entry_id": "22dae890-5820-353e-bae6-652d43ecf737",
                        "glosses": [
                            "энтомол. передняя, видоизменённая пара крыльев у жуков и некоторых клопов, прикрывающая сложенные на спине задние крылья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3dbb63a-bb54-41f0-bf9d-9e83500f4982",
                                "sense_id": "b6a2dfc1-89e4-3894-8fde-0a51279c5684",
                                "text": "Какая-то букашка с жирным, мягким телом и очень короткими металлически-синими круглыми надкрыльями не торопясь ползла по жёлобу листа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cb4a798-1de1-4534-aa1e-feda1493a334",
                        "source_entry_id": "22dae890-5820-353e-bae6-652d43ecf737",
                        "source_sense_id": "b6a2dfc1-89e4-3894-8fde-0a51279c5684",
                        "target_lang_word": "elytron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elytron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e76d90da-8cee-39de-a9fd-52d8e4889860",
                                        "entry_id": "a23ee384-459d-3f3b-a09a-4cd41cec0b12",
                                        "glosses": [
                                            "A sheath or outer covering, especially around the spinal cord or over the hindwings of certain insects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b22825b-8a1a-4667-bc29-d7b58e060daa",
                                                "sense_id": "e76d90da-8cee-39de-a9fd-52d8e4889860",
                                                "text": "In a corner, the Darkling Beetle rustles in its Cage, its Elytra the same unforgiving white as the great sand-waste call’d ‘Kalahari’ lying north of here […]"
                                            },
                                            {
                                                "example_id": "f6fa16f4-a94d-4aa4-8b25-a7c92646c84c",
                                                "sense_id": "e76d90da-8cee-39de-a9fd-52d8e4889860",
                                                "text": "[…] the elytra covering the hind wings of the firefly lift like a light leather, suppler than any other beetle’s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
