                "senses": [
                    {
                        "sense_id": "44d632c4-5856-306d-9bc9-5b27024a7682",
                        "entry_id": "1b355b09-c34c-3860-8f20-002b87a211ca",
                        "glosses": [
                            "long pig"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "25bf10e8-8151-445f-8e72-f4a1bd0c77e6",
                                "sense_id": "44d632c4-5856-306d-9bc9-5b27024a7682",
                                "text": "Stell dir vor, im Aldi gibt es demnächst Langschweingulasch aus den Oberschenkeln lebender Frauen, würdest du dann noch jemals wieder einen Gulaschtopf vom Pottkieker anfassen?",
                                "translation": "Imagine, in Aldi there will soon be long pig goulash made from the thighs of living women, would you then ever touch a goulash pot from Pottkieker again?",
                                "english": "Imagine, in Aldi there will soon be long pig goulash made from the thighs of living women, would you then ever touch a goulash pot from Pottkieker again?"
                            },
                            {
                                "example_id": "a6e1513f-0cfc-4d5a-beff-3604cfa61074",
                                "sense_id": "44d632c4-5856-306d-9bc9-5b27024a7682",
                                "text": "Da weibliche Langschweine überaus selten sind (99 von 100 Langschweinen sind Männer), schlachte ich jede Frau kostenlos, die sich mir anbietet.\nBei Männern schlachte ich diejenigen zuerst, die mir das meiste Geld anbieten, da es einfach zu viele männliche Langschweine gibt und ich aus Sicherheitsgründen alleine arbeite. […] Ihr müsst immer 3 Monate warten, bis ich das letzte Langschwein gegessen habe.",
                                "translation": "Since female long pigs are extremely rare (99 out of 100 long pigs are men), I butcher every woman who offers herself to me free of charge.\nIn the case of men, I first butcher those who offer me the most money, as there are simply too many male long pigs and as for safety reasons I work alone. […] You always have to wait 3 months until I've eaten the last long pig.",
                                "english": "Since female long pigs are extremely rare (99 out of 100 long pigs are men), I butcher every woman who offers herself to me free of charge.\nIn the case of men, I first butcher those who offer me the most money, as there are simply too many male long pigs and as for safety reasons I work alone. […] You always have to wait 3 months until I've eaten the last long pig."
                            },
                            {
                                "example_id": "e088c2d4-dbfc-4e7b-85c9-f7f3b49f1914",
                                "sense_id": "44d632c4-5856-306d-9bc9-5b27024a7682",
                                "text": "Hallo bin das Langschwein […] bin 56/170 mein Schlachtgewicht ist 85 kg ich habe schon seit Jahren den sehr starken Drang geschlachtet zu werden suche jemanden der den Drang hat ein reales Langschwein zu schlachten und zubereiten […]"
                            }
                        ]
                    }
