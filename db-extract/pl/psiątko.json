                                        "entry_id": "02a7e329-4c7f-30ad-85c5-a9df383fe13f",
                                        "glosses": [
                                            "To give birth to pups."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
