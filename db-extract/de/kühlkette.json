                "senses": [
                    {
                        "sense_id": "a8613c33-96de-3d21-b587-3553b0bc5d07",
                        "entry_id": "16e35886-6b8c-3083-b9ae-be9932b2a8de",
                        "glosses": [
                            "System zur Beibehaltung einer niedrigen Temperatur über verschiedene Stationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a35eafa-f32a-4e08-9308-2db6cc0df88b",
                                "sense_id": "a8613c33-96de-3d21-b587-3553b0bc5d07",
                                "text": "Durch die Kühlkette konnte der Seelachs frisch nach Kapstadt gebracht werden."
                            },
                            {
                                "example_id": "53c889d0-4803-46b4-bc9b-1e07e4fc639f",
                                "sense_id": "a8613c33-96de-3d21-b587-3553b0bc5d07",
                                "text": "„Die Lebensmittelkontrolle legte außerdem offen, dass jeder dritte Kühltransport mit Fleisch oder Fisch nicht hinreichend kalt ist, um die Kühlkette der Lebensmittel aufrechtzuerhalten.“"
                            }
                        ],
