                                    {
                                        "sense_id": "f3e9a00c-59aa-3c87-b7f9-ea3c46f81d57",
                                        "entry_id": "d5fae1ee-ffca-3090-a68a-ea2a6b71294c",
                                        "glosses": [
                                            "mit Gras bewachsenes Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2d04da-1d24-4c95-8611-f46f451c92bd",
                                                "sense_id": "f3e9a00c-59aa-3c87-b7f9-ea3c46f81d57",
                                                "text": "Im Grasland findet man meist wenig Baumbewuchs."
                                            },
                                            {
                                                "example_id": "077a0e87-78a2-47d1-8eed-4d2ae054e3b7",
                                                "sense_id": "f3e9a00c-59aa-3c87-b7f9-ea3c46f81d57",
                                                "text": "„Er rodete und besäte hektarweise Grasland und Wälder, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "068ad074-fded-4905-a885-bc35fc426923",
                        "source_entry_id": "d1a24694-4466-3d24-8ff4-2c76a6b4d40a",
                        "source_sense_id": "cdecf75e-4337-3eda-a531-dd09810ed58f",
                        "target_lang_word": "meadow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meadow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0192870e-d74b-3c03-9aba-d69ff0307c6b",
                                        "entry_id": "ab92eaec-5cf9-310d-987b-2de55bb4bec8",
                                        "glosses": [
                                            "A field or pasture; a piece of land covered or cultivated with grass, usually intended to be mown for hay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce73845-0034-47b3-bf52-0fe50d1d4da5",
                                                "sense_id": "0192870e-d74b-3c03-9aba-d69ff0307c6b",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook,[…]."
                                            },
                                            {
                                                "example_id": "7e82ec27-a1a1-43be-93a1-bb907ab42b3f",
                                                "sense_id": "0192870e-d74b-3c03-9aba-d69ff0307c6b",
                                                "text": "[…]belts of thin white mist streaked the brown plough land in the hollow where Appleby could see the pale shine of a winding river. Across that in turn, meadow and coppice rolled away past the white walls of a village bowered in orchards,[…]"
                                            },
                                            {
                                                "example_id": "e93757eb-8fc5-466d-b2f6-fb8a9585b062",
                                                "sense_id": "0192870e-d74b-3c03-9aba-d69ff0307c6b",
                                                "text": "Our part of the veranda did not hang over the gorge, but edged the meadow where half a dozen large and sleek horses had stopped grazing to join us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7603e5a-d0c5-3fce-b29f-5896606b4c2f",
                                        "entry_id": "ab92eaec-5cf9-310d-987b-2de55bb4bec8",
                                        "glosses": [
                                            "Low land covered with coarse grass or rank herbage near rivers and in marshy places by the sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "736d4053-03b5-4684-aeb1-5c59d6f80a3e",
                                                "sense_id": "a7603e5a-d0c5-3fce-b29f-5896606b4c2f",
                                                "text": "the salt meadows near Newark Bay"
                                            },
                                            {
                                                "example_id": "78c90e66-375f-4357-9c26-fbac7b6e9f3d",
                                                "sense_id": "a7603e5a-d0c5-3fce-b29f-5896606b4c2f",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meadow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7877b13e-d623-3235-912d-59e371a57e92",
                                        "entry_id": "15a85908-5fb9-355d-909d-dc6770ca19a0",
                                        "glosses": [
                                            "To cultivate with grass in order to produce hay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83ab99f-9ad4-488d-854b-ec1b4736281f",
                                                "sense_id": "7877b13e-d623-3235-912d-59e371a57e92",
                                                "text": "That there is and from time immemorial has been within that part of the parish called Mablethorpe St. Mary's a laudable custom that, if any outdweller take ancient pasture ground, he shall pay a modus of 4d. an acre, and so in proportion, on the 1st of August, in lieu of all manner of tithe; and that if any of the ancient pasture be once ploughed up or meadowed, it shall, when restored to pasture again, pay 4d. the acre in the hands of such outdweller."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20dfbc16-cd5b-411d-82ce-4ddccf5f4829",
                        "source_entry_id": "d1a24694-4466-3d24-8ff4-2c76a6b4d40a",
                        "source_sense_id": "cdecf75e-4337-3eda-a531-dd09810ed58f",
                        "target_lang_word": "prairie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prairie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "775048ca-d80f-3dc9-914b-694f4fea37b5",
                                        "entry_id": "c2d17ba3-40f7-3744-8f0d-eaf7d9046f59",
                                        "glosses": [
                                            "Pré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f835aecc-203d-49fd-a5c6-02fc13a6c6cb",
                                                "sense_id": "775048ca-d80f-3dc9-914b-694f4fea37b5",
                                                "text": "Bien que, par intervalles, de brèves et pâles soleillées courussent sur les chemins défoncés, sur les prairies semées de flaques miroitantes, on pressentait que l'accalmie serait de peu de durée, et que l'averse recommencerait avant la fin du jour."
                                            },
                                            {
                                                "example_id": "9775e42c-78ee-4336-987b-41e278749cbd",
                                                "sense_id": "775048ca-d80f-3dc9-914b-694f4fea37b5",
                                                "text": "Le jour parut, frileux et triste… De grandes brumes traînaient sur les prairies, le ciel était bas."
                                            },
                                            {
                                                "example_id": "d8def292-cef1-4032-94b1-eee6cc6eb694",
                                                "sense_id": "775048ca-d80f-3dc9-914b-694f4fea37b5",
                                                "text": "Je vais m'étendre dans la prairie, sous un pommier aux pommes vertes et dures."
                                            },
                                            {
                                                "example_id": "6f05c7ee-869f-4b07-bcbf-efc326de6dbb",
                                                "sense_id": "775048ca-d80f-3dc9-914b-694f4fea37b5",
                                                "text": "Les prairies sont assez vastes ; elles occupent le fond de la vallée et toutes les parties facilement irrigables. Elles fournissent des fourrages abondants et très réputés que l'on exporte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                        "entry_id": "c2d17ba3-40f7-3744-8f0d-eaf7d9046f59",
                                        "glosses": [
                                            "Plaine herbeuse américaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e97f609-6c1e-40c9-a797-0af02ae34e47",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "Dans les prairies de l'Amérique, dans les vastes terrains de l'Australie, dans les solitudes glacées des Pôles, l'homme ose à peine s'y aventurer, le plus hardi recule."
                                            },
                                            {
                                                "example_id": "18902dd2-abc4-4ad9-826c-df46ae870561",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "La prairie. La patrie des innombrables tribus peaux rouges et des grands troupeaux de bisons."
                                            },
                                            {
                                                "example_id": "b49afefe-a964-4c3b-af32-1f6baba63ca9",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "Dans une prairie, toutes les plantes sont herbacées et on n'y voit en général pas un arbuste ou un arbre isolé. Je parle naturellement des paysages naturels comme la Prairie ou la Pampa."
                                            },
                                            {
                                                "example_id": "6662558a-fed3-49c0-92f3-4937a5fcb97a",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "Buffalo Bill, à cheval, galopait dans la prairie, tantôt poursuivant, tantôt fuyant les Indiens."
                                            },
                                            {
                                                "example_id": "e191e616-edd5-4e02-95a4-837f3f4d191c",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "La steppe proprement dite (que les géographes comparent à la « prairie » américaine) occupe 40 % de la superficie du pays."
                                            },
                                            {
                                                "example_id": "cefaf792-509f-4124-8c9b-e5694c655a42",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "Le cœur du Canada, sur la rive nord des Grands Lacs et du Saint-Laurent, se compose des deux provinces principales de l’Ontario (Haut-Canada) et du Québec (Bas-Canada) respectivement peuplées de 12 et 7,5 millions d’habitants, soit près des deux tiers de la population, les autres étant dispersés dans les provinces de la prairie comme l’Alberta, le Saskatchewan, le Manitoba, ou des périphéries océaniques, la Colombie britannique, à l’ouest, et le Nouveau Brunswick à l’est."
                                            },
                                            {
                                                "example_id": "c100fd31-3482-4022-969a-46a6c9837d2a",
                                                "sense_id": "6aa1a52e-ead4-344b-9c3d-27cac8427665",
                                                "text": "Par-delà le lac des Bois, auquel on accède par une série de portages, s'étend un océan de hautes herbes, la « prairie », distincte de l'aire forestière des Grands Lacs. Les paysages, répétitifs, sont dénués d’arbres à cause de la sécheresse d’été, mais aussi des feux pratiqués par les Amérindiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                        "entry_id": "c2d17ba3-40f7-3744-8f0d-eaf7d9046f59",
                                        "glosses": [
                                            "Pâture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deddd8fd-fcd4-4698-a987-7de38e5ccebb",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "Les prairies, dites \"naturelles\" sont, sous nos climats, des groupements végétaux étroitement sous la dépendance de l'Homme : leur stabilité n'est maintenue que par la fauche et le pacage."
                                            },
                                            {
                                                "example_id": "0189a8a8-26f7-423f-8300-afc5e1414369",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "Prairie naturelle, celle, non ensemencée par l'homme, dont la flore variée se reproduit d'elle-même."
                                            },
                                            {
                                                "example_id": "36a7542e-f404-463b-8911-6888ad76e4e9",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "Il s'agit de prairies naturelles non retournables, mises en valeur par la fauche ou la pâture."
                                            },
                                            {
                                                "example_id": "b0c66e34-1f71-46f6-b289-ebe1434b1a8d",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "Prairie artificielle, celle dont la flore limitée à quelques espèces excellentes pour la nourriture du bétail, a été semée."
                                            },
                                            {
                                                "example_id": "1199c0b9-b86e-4b99-b9ac-f4747f3f7fc2",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "Les prairies temporaires sont généralement établies aujourd'hui, soit en associant une Graminée et une Légumineuse de variétés définies qui se complètent à divers égards."
                                            },
                                            {
                                                "example_id": "8556c2e0-7749-4994-bac0-9c9e3e385fb9",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "Dans la prairie, les vaches lentement avançaient, broutant devant elles sans hâte et sans trêve."
                                            },
                                            {
                                                "example_id": "b79715dd-7db6-492d-ac2a-c25d6fba585e",
                                                "sense_id": "eeaa6b20-7540-3e3a-9015-ae8b9d8964dc",
                                                "text": "En prairies permanentes, des modes de gestion adaptés (pâturage tournant notamment) peuvent favoriser la présence de légumineuses et leur diversité, indicateur de valeur pastorale et de qualité fourragère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prairie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a776c4a-bc4d-3299-8e40-caaac837ae96",
                                        "entry_id": "79d705e7-1e17-3b38-ab63-e238b7752027",
                                        "glosses": [
                                            "De la couleur vert herbe clair et vif. #57D53B"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a0f2c9-4ec2-44d7-a6f5-b2f21a538fc9",
                                                "sense_id": "2a776c4a-bc4d-3299-8e40-caaac837ae96",
                                                "text": "Vert prairie."
                                            },
                                            {
                                                "example_id": "e60ff87f-7e20-495f-92c6-97655f04d9b6",
                                                "sense_id": "2a776c4a-bc4d-3299-8e40-caaac837ae96",
                                                "text": "Comment marier vos vernis à ongles aux couleurs vives de l'été? Aux jaune d'or […], vert prairie, violet et indigo des cotonnades indiennes ou des robes folkloriques d'Amérique du Sud ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
