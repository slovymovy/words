                "senses": [
                    {
                        "sense_id": "38968537-2bfd-3219-9713-3bcd788bafd2",
                        "entry_id": "764f9d72-15d9-3b81-9abb-cdadbae7f9b2",
                        "glosses": [
                            "Variante orthographique, rare mais parfois rencontrée (sans doute pour insister sur la répétition), de remarier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e5bf52-b038-4032-9d95-7d5ff659b3fc",
                                "sense_id": "38968537-2bfd-3219-9713-3bcd788bafd2",
                                "text": "Grâce à ces aides magiques (qui lui assurent un transport rapide, l’invisibilité, etc.), le héros parvient enfin auprès du château où la fée est sur le point (souvent obligée par son père) de se re-marier (avec un \"prince\", ou un \"génie\", que, généralement, elle n’aime pas)."
                            },
                            {
                                "example_id": "bcd0d763-e31d-464d-b2ba-239dd2443fd1",
                                "sense_id": "38968537-2bfd-3219-9713-3bcd788bafd2",
                                "text": "Note de la rédaction : les paris sont ouverts pour les chaînes qui diffuseront « Moundir et la psychothérapie de couple » et « Moundir divorce, se re-marie et re-divorce. »"
                            }
                        ]
                    }
