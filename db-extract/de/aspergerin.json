                ],
                "senses": [
                    {
                        "sense_id": "9311ecd9-7104-39b5-97d1-56479e677349",
                        "entry_id": "ebb51113-99db-3852-825c-c92fee87aa90",
                        "glosses": [
                            "weibliche Person mit Asperger-Syndrom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70b2e89f-6fec-49b7-9853-326d33ef7f85",
                                "sense_id": "9311ecd9-7104-39b5-97d1-56479e677349",
                                "text": "„Mit dem Bereich Körperwahrnehmungen und Erfahrungen im Krankenhaus schließt das Buch. Auch hier wieder ein spannendes Fallbeispiel einer Aspergerin, die mit einer ungewöhnlichen Krankheitsgeschichte aufwarten kann.“"
                            },
                            {
                                "example_id": "30991cc3-03da-4df8-8653-1d41cbcc871b",
                                "sense_id": "9311ecd9-7104-39b5-97d1-56479e677349",
                                "text": "„Hätte Greta Thunberg es geschafft, weltweit gehört zu werden, wenn sie nicht als Aspergerin so sozial distanziert und unangepasst, so beharrlich und unbeirrt hätte agieren können?“"
                            },
                            {
                                "example_id": "8696db6d-c01d-4271-b7df-1b152064fd08",
                                "sense_id": "9311ecd9-7104-39b5-97d1-56479e677349",
                                "text": "„Dieser erfolgt nicht in Form offener Zustimmung oder stürmischer Annäherung, sondern trotz eigenen Wunsches mit den Worten ‚Na gut! Wenn’s sein muss!‘, wie die Standardantwort einer siebenjährigen Aspergerin lautet. Aber gilt das nicht in ähnlicher Form für alle unsere jugendlichen Patienten oder jede psychoanalytische Deutung?"
                            },
                            {
                                "example_id": "056f2a8d-9bb3-434a-988c-978f1095ecd4",
                                "sense_id": "9311ecd9-7104-39b5-97d1-56479e677349",
                                "text": "„›Sie ist Aspergerin. Wie ich. Wir beide würden einen NT in einem Eheversuch vermutlich in den Wahnsinn treiben.‹ ›NT?‹ ›Einen neurotypischen Menschen. […]‹“"
                            },
                            {
                                "example_id": "300afb1b-3a1f-4077-9726-22189fdd07c0",
                                "sense_id": "9311ecd9-7104-39b5-97d1-56479e677349",
                                "text": "„Warum versuchst du als Aspergerin überhaupt, so zu sein wie die anderen? Ich mag dich so, wie du bist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
