                        "glosses": [
                            "D’une manière indélébile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84057e1d-0d0f-4f49-9374-7ba56561e6ff",
                                "sense_id": "120ead43-be8b-37dd-a3ac-8caeab11306e",
                                "text": "Celui des ouvrages de Tacite où l’unité, dans ce qu’elle a de plus profond et de plus frappant, se trouve être le plus indélébilement empreinte."
                            },
                            {
                                "example_id": "3bb0597d-3a05-42af-a436-38bd4404ffb4",
                                "sense_id": "120ead43-be8b-37dd-a3ac-8caeab11306e",
                                "text": "Sans s’attacher au “catafalque” dont parle M. de Saint-Simon, avec, toujours, cette acuité d’image qui grave indélébilement ses évocations, on peut trouver que son dépassement, […]."
                            }
                        ]
                    }
