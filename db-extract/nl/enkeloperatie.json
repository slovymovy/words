                        "examples": [
                            {
                                "example_id": "67f230c5-ba5b-48c5-aa13-b01cc6a00316",
                                "sense_id": "b5b9f777-6599-373e-ad41-8a8f01af1fda",
                                "text": "Matthijs de Ligt wil ritme opdoen na zijn liesblessure. En ook Daley Blind, net terug na een enkeloperatie, lijkt niet te snakken naar een pauze. \"Ik had graag nog wat langer willen spelen, ik had niet op het bord gelet\", verklaarde Blind de teleurstelling die van zijn gezicht afdroop toen hij werd gewisseld."
                            },
                            {
                                "example_id": "a30061db-fccb-4f98-87fd-af6d61530f50",
                                "sense_id": "b5b9f777-6599-373e-ad41-8a8f01af1fda",
                                "text": "Bondscoach Frank de Boer sprak zijn waardering uit voor Blind, die de moed verzamelde om toch aan de aftrap te verschijnen. En dat nadat hij eerder ook al een race tegen de klok had gewonnen om na een enkeloperatie toch fit te zijn voor het toernooi."
                            }
                        ]
