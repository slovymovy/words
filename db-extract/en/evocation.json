                                    },
                                    {
                                        "sense_id": "b2aec026-d44d-3b8a-99ef-506657a96f4e",
                                        "entry_id": "550a67d9-567f-335a-9947-6ee5cfe8875c",
                                        "glosses": [
                                            "Beeinflussung durch magische Kräfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293f0079-1e0a-43f8-858d-f95fb01fd59a",
                                                "sense_id": "b2aec026-d44d-3b8a-99ef-506657a96f4e",
                                                "text": "„Der Schwerpunkt liegt beim Stammeskrieger auf der Beschwörung von Monstern und Tieren und dem konstanten Zufügen von Schaden aus der zweiten Reihe.“"
                                            }
