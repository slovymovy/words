                ],
                "senses": [
                    {
                        "sense_id": "6a6ce297-ce85-3a2a-ae34-347404e69d0e",
                        "entry_id": "5e670d0f-127d-30cb-8aad-c29c7dbd5fb5",
                        "glosses": [
                            "Duft (Geruch), der vom Gewürz Thymian stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb454ca2-f97b-47f2-8244-51f20f14af88",
                                "sense_id": "6a6ce297-ce85-3a2a-ae34-347404e69d0e",
                                "text": "„Die Art duftet weniger aromatisch als verwandte Vertreter, beim Zerreiben der Blätter oder Blüten entfaltet sie jedoch ebenso den typischen Thymiangeruch.“"
                            },
                            {
                                "example_id": "b04552cd-558b-4cf9-9a70-b5fad2c66fc6",
                                "sense_id": "6a6ce297-ce85-3a2a-ae34-347404e69d0e",
                                "text": "„Werden die Blätter zerrieben tritt der typische Thymiangeruch in Erscheinung.“"
                            },
                            {
                                "example_id": "b771ff3a-1b0c-40c9-bc53-55e9408a9ce6",
                                "sense_id": "6a6ce297-ce85-3a2a-ae34-347404e69d0e",
                                "text": "„Die heimischen Vertreter sind nicht so aromatisch wie der Echte Thymian, verströmen aber beim Verreiben der Blätter den typischen Thymiangeruch und bereichern den Garten mit ihren Blüten, die eine beliebte Bienenweide sind.“"
                            },
                            {
                                "example_id": "54abac0f-8de4-49c5-b04a-30723f1f86b4",
                                "sense_id": "6a6ce297-ce85-3a2a-ae34-347404e69d0e",
                                "text": "„Erst weht uns der Wind intensiven Thymiangeruch in die Nase, kurz danach nervt ein fieser Gestank.“"
                            },
                            {
                                "example_id": "01d687fd-39c0-468e-9a3f-954fd7280bbc",
                                "sense_id": "6a6ce297-ce85-3a2a-ae34-347404e69d0e",
                                "text": "„Charakteristisch ist der den lateinischen Namen gebende Thymiangeruch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
