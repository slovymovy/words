        "de-extract.jsonl": [
            {
                "entry_id": "7ba192d4-e213-3ad2-b491-f512f7ded809",
                "word": "zuzeiten",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92da0e52-5bd8-3049-9da8-faa5f9122de4",
                        "entry_id": "7ba192d4-e213-3ad2-b491-f512f7ded809",
                        "glosses": [
                            "mehr oder weniger oft, unterschiedlich häufig; in unregelmäßigen Abständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633427ec-3e99-4ced-a116-1f28a821122b",
                                "sense_id": "92da0e52-5bd8-3049-9da8-faa5f9122de4",
                                "text": "„Wenn ihn zuzeiten sein Wettglück verließ, scheint sich Durrieux auch als Carolines Zuhälter betätigt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce4fee80-4b51-4908-99cd-6cf48413ce2d",
                        "source_entry_id": "7ba192d4-e213-3ad2-b491-f512f7ded809",
                        "source_sense_id": "92da0e52-5bd8-3049-9da8-faa5f9122de4",
                        "source_sense_description": "mehr oder weniger oft, unterschiedlich häufig; in unregelmäßigen Abständen",
                        "target_lang_word": "at times",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at times",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb028a8-1233-3da5-ad21-f61c7661945a",
                                        "entry_id": "bab458c8-7e21-3441-b1bd-d26be6edf6d6",
                                        "glosses": [
                                            "On occasion, sometimes."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c36cef-8a9b-4045-b58a-ba85069dd09f",
                                                "sense_id": "cfb028a8-1233-3da5-ad21-f61c7661945a",
                                                "text": "I feel lonely at times, but then somebody phones, or calls round, and I cheer up again."
                                            },
                                            {
                                                "example_id": "91cf614b-79ed-47ae-8518-fc4711a4b6d5",
                                                "sense_id": "cfb028a8-1233-3da5-ad21-f61c7661945a",
                                                "text": "She is popular with passengers as an all-weather vessel, but rather the reverse with yachtsmen as she has at times proved somewhat unwieldy, and certainly takes up a good deal of space in the narrow channels."
                                            },
                                            {
                                                "example_id": "97b01e70-ee60-46b0-b1fd-4e7602e9f3e2",
                                                "sense_id": "cfb028a8-1233-3da5-ad21-f61c7661945a",
                                                "text": "If at times Van Gaal’s players let themselves down with careless concessions of possession, Carver knew his side had been reprieved when, back to goal, Wayne Rooney controlled the ball on his chest, swivelled and dinked a shot wide."
                                            },
                                            {
                                                "example_id": "7aff28c2-b24d-4cf9-ae73-ffd8884db229",
                                                "sense_id": "cfb028a8-1233-3da5-ad21-f61c7661945a",
                                                "text": "This means, at times, long and perhaps overly discursive discussions of other taxa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e85f830c-bdcb-4b80-890e-d2801af8664e",
                        "source_entry_id": "7ba192d4-e213-3ad2-b491-f512f7ded809",
                        "source_sense_id": "92da0e52-5bd8-3049-9da8-faa5f9122de4",
                        "source_sense_description": "mehr oder weniger oft, unterschiedlich häufig; in unregelmäßigen Abständen",
                        "target_lang_word": "occasionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occasionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                        "entry_id": "3e0a289b-2974-372c-83af-d03c55ae6573",
                                        "glosses": [
                                            "On occasion: at relatively infrequent intervals, from time to time, sometimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed73f00-8922-4017-88fc-32b4e915255b",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "God ſetteth no houres for the morning or evening ſacrifice because they may occaſionally be changed."
                                            },
                                            {
                                                "example_id": "fc991f2b-3843-4a79-a918-92fc3b31b9ad",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "Some perhaps worship only on alternate Sundays; others still more occasionally."
                                            },
                                            {
                                                "example_id": "5a09775f-ee1d-4146-858f-d9b1aac73887",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "The journal, more occasionally, has turned to what might be called \"fashionable\" themes."
                                            },
                                            {
                                                "example_id": "e8260d65-b74b-4b5d-86af-1dadde51a4e9",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "Flames could still be seen from town flaring up occasionally on a hill dotted with emergency vehicles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                        "entry_id": "3e0a289b-2974-372c-83af-d03c55ae6573",
                                        "glosses": [
                                            "On an occasion, accidentally, by chance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7623644-740c-4170-8311-83fb1dc1d47d",
                                                "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                                "text": "I had met Lord Ossory in the forenoon, who had come to town occasionally."
                                            },
                                            {
                                                "example_id": "0293cd6f-06fd-4510-a8ea-937c20b246c6",
                                                "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                                "text": "Mr Tourville occasionally told his age; just turned of thirty-one."
                                            },
                                            {
                                                "example_id": "4da95638-8879-4d05-b2fc-392fa04eb634",
                                                "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                                "text": "[N]othing gave him so much joy in conversation, as an opportunity of giving the company to understand, how well he was with persons of distinguished rank and character: he would often (for example) observe, as it were occasionally, that the duke of G— was one of the best natured men in the world […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                                        "entry_id": "3e0a289b-2974-372c-83af-d03c55ae6573",
                                        "glosses": [
                                            "On the occasion of something else happening; incidentally, by the way."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c26434-ddb6-4381-96ce-05b09c39ec68",
                                                "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                                                "text": "Were nothing els diſcourſively inſerted (as ſome little elſe occaſionally preſented it ſelfe), what paper more currently fit for the bareſt mechanicall uſes, [...]"
                                            },
                                            {
                                                "example_id": "a9c1fc6f-41d8-4873-b060-fde5d291bf8d",
                                                "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                                                "text": "I think it is plain, that Origen, whatever Character he may have occaſionally given of this Book, did not judge it any part of the Canon..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
