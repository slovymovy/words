                        "sense_id": "aefaeb9b-e595-38e1-9c22-0f4648da27ff",
                        "entry_id": "185e2b4c-81d9-3cee-b589-959d815de323",
                        "glosses": [
                            "meritorious, praiseworthy, commendable"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06dc8e80-077b-4bbd-b533-59e08da0b023",
                                "sense_id": "aefaeb9b-e595-38e1-9c22-0f4648da27ff",
                                "text": "— Monsieur Roger, lui dit-il à demi-voix, voici un élève que je vous recommande, il entre en cinquième. Si son travail et sa conduite sont méritoires, il passera dans les grands, où l’appelle son âge."
                            }
                        ]
                    }
