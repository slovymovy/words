                                        "entry_id": "192de9eb-2dfb-3b0a-973f-138a8584ae7e",
                                        "glosses": [
                                            "To lose consciousness through a lack of oxygen or nutrients to the brain, usually as a result of suddenly reduced blood flow (may be caused by emotional trauma, loss of blood or various medical conditions)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bb80774-22bd-414f-bc7b-d292e919addc",
                                                "sense_id": "956c9ada-de8e-31e0-98ee-cb6a3d571195",
                                                "text": "If I send them away fasting […] they will faint by the way."
                                            },
                                            {
                                                "example_id": "f8255845-27eb-4911-8318-43f3c8676513",
                                                "sense_id": "956c9ada-de8e-31e0-98ee-cb6a3d571195",
                                                "text": "But upon hearing the Honour which he intended her , she fainted away , and fell down as Dead at his Feet"
                                            }
