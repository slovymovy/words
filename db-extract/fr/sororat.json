                ],
                "translations": [
                    {
                        "translation_id": "1eb44a6e-845d-44b2-a1ad-05e450d2b5cb",
                        "source_entry_id": "13b4cb64-4c64-31e2-b20b-3c4de8135ce6",
                        "source_sense_id": "5eb460a9-3dd8-3c05-94b4-16d6d6b0919d",
                        "target_lang_word": "sororate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sororate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2643a040-3b99-3cb8-87dc-fa6b234b6c7b",
                                        "entry_id": "8490b1be-48e9-3e8e-98c6-b1faadd69334",
                                        "glosses": [
                                            "The custom of the marriage of a man to the sister of his wife, usually after the wife has died."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "524e1073-9980-4783-9faa-6b206e2a2965",
                                                "sense_id": "2643a040-3b99-3cb8-87dc-fa6b234b6c7b",
                                                "text": "The sororate was operative during the feudal period, at least among the feudal lords."
                                            },
                                            {
                                                "example_id": "a4d35485-5c27-4aca-aa6e-c6d9f03e7308",
                                                "sense_id": "2643a040-3b99-3cb8-87dc-fa6b234b6c7b",
                                                "text": "The sororate is frequently associated with the custom of bride price; if the husband′s kindred have “bought” a wife for him and she dies, her family or kindred are obligated to replace her. The institutions of levirate and sororate are very widespread in primitive society, and in many instances a tribe will observe both customs."
                                            },
                                            {
                                                "example_id": "4d537b91-0090-4710-bf54-5e85ee795243",
                                                "sense_id": "2643a040-3b99-3cb8-87dc-fa6b234b6c7b",
                                                "text": "A related marriage tradition is the sororate (Latin soror means “sister”), in which a man has the right to marry a (usually younger) sister of his deceased wife. In some societies, the sororate also applies to a man who has married a woman who is unable to bear children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e161bea2-bf8b-30b2-8b1f-e9c8365695b0",
                                        "entry_id": "8490b1be-48e9-3e8e-98c6-b1faadd69334",
                                        "glosses": [
                                            "A marriage according to this custom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85324295-9dda-44fa-a007-2619584c64d6",
                                                "sense_id": "e161bea2-bf8b-30b2-8b1f-e9c8365695b0",
                                                "text": "Sororates had a similar effect of providing for the survivors of a deceased."
                                            },
                                            {
                                                "example_id": "26c6c2a6-c1d1-42e2-b245-636dd188635a",
                                                "sense_id": "e161bea2-bf8b-30b2-8b1f-e9c8365695b0",
                                                "text": "Marriage within the same clan is prohibited. However, levirates and sororates are prevalent among the Kurumbas. Widow marriage is permitted."
                                            },
                                            {
                                                "example_id": "33db58f8-4426-4872-ad82-cc105c0459a6",
                                                "sense_id": "e161bea2-bf8b-30b2-8b1f-e9c8365695b0",
                                                "text": "Junior sororates are allowed. Age at marriage for males is between 20 and 22 years and for girls two to four years after puberty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
