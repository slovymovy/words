                    {
                        "translation_id": "0d04a8f4-a80c-4e3f-bae3-f73615f2ef77",
                        "source_entry_id": "cbea3802-34c5-3127-ba6a-2409d734471f",
                        "source_sense_id": "f123941b-aa6a-30d9-984b-34d28d0b0151",
                        "source_sense_description": "historische Provinz im Osten Frankreichs",
                        "target_lang_word": "Savoie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Savoie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca50655e-383e-3753-84d9-63dfd2ca6209",
                                        "entry_id": "0d8943b8-29d4-3767-a8b1-9e171033f142",
                                        "glosses": [
                                            "Région alpine délimitée par le Léman au nord, la crête des Alpes à l'est, le Dauphiné au sud et le Rhône à l'ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cec2d85e-518d-4c5a-aaf1-eb2c03ddbbb7",
                                                "sense_id": "ca50655e-383e-3753-84d9-63dfd2ca6209",
                                                "text": "Temps pluvieux sur le Jura et la Savoie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66049dba-2ca8-30c6-bb47-cc4fe9d5e343",
                                        "entry_id": "0d8943b8-29d4-3767-a8b1-9e171033f142",
                                        "glosses": [
                                            "Comté, duché puis principauté des Alpes, annexée, en 1860, à la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f19097d-f9f9-42d5-b01a-77fb506e0086",
                                                "sense_id": "66049dba-2ca8-30c6-bb47-cc4fe9d5e343",
                                                "text": "Je lui présentai le verre qu'il accepta avec ce sourire que je n'ai jamais trouvé plus cordial que sur la figure des habitans de la Savoie."
                                            },
                                            {
                                                "example_id": "57f930aa-d17d-4428-8bfb-6f2d5b4e1a36",
                                                "sense_id": "66049dba-2ca8-30c6-bb47-cc4fe9d5e343",
                                                "text": "— Sans manquer au loyalisme qui m’attache à la maison de Savoie, répondit le commandeur, je reconnais que le service militaire et l’impôt importunent assez le peuple de Naples pour lui faire regretter parfois le bon temps du roi Bomba et la douceur de vivre sans gloire sous un gouvernement léger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "432adc36-9b4f-36cc-9d8f-a7777d3799d0",
                                        "entry_id": "0d8943b8-29d4-3767-a8b1-9e171033f142",
                                        "glosses": [
                                            "Département français de la région Auvergne-Rhône-Alpes, dont le numéro de code est 73."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6694825b-48e3-4988-8368-31a7e580ae1b",
                                                "sense_id": "432adc36-9b4f-36cc-9d8f-a7777d3799d0",
                                                "text": "Le moitié Brésilien par sa mère, moitié Norvégien par son père Lucas Braathen, a clairement dominé le slalom de Val-d’Isère (Savoie)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb57481-6ae0-3bc0-8b0e-86a7f2e422be",
                                        "entry_id": "0d8943b8-29d4-3767-a8b1-9e171033f142",
                                        "glosses": [
                                            "Ce département et celui de la Haute-Savoie."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20482917-6f97-4a66-8922-ad76df385004",
                                                "sense_id": "bdb57481-6ae0-3bc0-8b0e-86a7f2e422be",
                                                "text": "Pour ou contre la réunification des Savoies ?"
                                            },
                                            {
                                                "example_id": "c413fa5d-70b2-4b9b-9241-69fa4c23db8c",
                                                "sense_id": "bdb57481-6ae0-3bc0-8b0e-86a7f2e422be",
                                                "text": "Nous terminerons ce travail en empruntant à M. Tochon quelques renseignements généraux sur les races laitières et les fromages des deux Savoies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
