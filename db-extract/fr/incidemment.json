        "fr-extract.jsonl": [
            {
                "entry_id": "8829decd-2b3b-31aa-b370-46136353affb",
                "word": "incidemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b914a3f6-99e5-32f5-a2cc-849ac61c3099",
                        "entry_id": "8829decd-2b3b-31aa-b370-46136353affb",
                        "glosses": [
                            "Par incident, d’une manière incidente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced6d58a-1820-4929-95ea-abb18f67e8cc",
                                "sense_id": "b914a3f6-99e5-32f5-a2cc-849ac61c3099",
                                "text": "M. Leibnitz, qui n'entre dans la querelle qu’à cette occasion et très incidemment."
                            }
                        ]
                    },
                    {
                        "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                        "entry_id": "8829decd-2b3b-31aa-b370-46136353affb",
                        "glosses": [
                            "Par connexité, par suite."
                        ],
                        "tags": [
                            "Pratique"
                        ],
                        "examples": [
                            {
                                "example_id": "8e534cea-638d-4440-ae9b-de5e5f44c947",
                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                "text": "Cet homme est défendeur au principal, et incidemment demandeur par ses défenses."
                            },
                            {
                                "example_id": "c5485d2c-e5ee-4c6a-badf-5fc54cd5041a",
                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                "text": "Il s’est constitué incidemment demandeur."
                            },
                            {
                                "example_id": "a0e31284-f333-4360-8b40-f0aff27cad2e",
                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                "text": "On n’a traité cette question qu’incidemment."
                            },
                            {
                                "example_id": "8b4abb65-f65b-48e3-8480-ae2b8b9345fc",
                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                "text": "Il en a parlé incidemment dans son histoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0d0a082-ab7a-451d-acd4-b62d044c9fa9",
                        "source_entry_id": "8829decd-2b3b-31aa-b370-46136353affb",
                        "source_sense_description": "par incident",
                        "target_lang_word": "incidentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incidentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                        "entry_id": "de101744-4505-3cbf-b51d-a67cd4015425",
                                        "glosses": [
                                            "In an incidental manner; not of central or critical importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b18655a-4885-4610-8372-d8101270ff84",
                                                "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                                "text": "The book discussed the subject, but only incidentally."
                                            },
                                            {
                                                "example_id": "85f78577-5969-4326-9f67-0d33d541dffe",
                                                "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                                "text": "Nor, will the tragic dramatist who would depict mortal indomitableness in its fullest sweep and direct swing, ever forget a hint, incidentally so important in his art, as the one now alluded to."
                                            },
                                            {
                                                "example_id": "d20e5e45-a0c3-4f4b-9cc5-576c62104c92",
                                                "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                                "text": "Not everybody welcomes standardisation as a principle, because it reduces variety (and, incidentally, tends to dispose of the quainter and more picturesque anomalies)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3dae669-506e-3e72-a2cf-e4166a91a1a3",
                                        "entry_id": "de101744-4505-3cbf-b51d-a67cd4015425",
                                        "glosses": [
                                            "By chance; in an unplanned way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba32c772-4122-369f-929a-1ccd8f20e5eb",
                                        "entry_id": "de101744-4505-3cbf-b51d-a67cd4015425",
                                        "glosses": [
                                            "Parenthetically, by the way."
                                        ],
                                        "tags": [
                                            "conjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc46fd99-35b8-4620-9315-1b0232d9680b",
                                                "sense_id": "ba32c772-4122-369f-929a-1ccd8f20e5eb",
                                                "text": "Incidentally, did you hear anything new from your brother yesterday?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
