{
    "word_family": [
        "praten",
        "stoel",
        "praatje",
        "praatgraag",
        "praatpaal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "378d0feb-1377-3990-bfb4-3cd0494c5f02",
                    "sense_definition": "Een verhoging of plek vanwaar men een publiek kan toespreken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spreekplaats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spreker beklom de <w>praatstoel</w> om zijn visie op de toekomst te delen.",
                            "target_lang_translations": {
                                "ru": "Оратор поднялся на <w>кафедру</w>, чтобы поделиться своим видением будущего."
                            }
                        },
                        {
                            "text": "Vanaf de houten <w>praatstoel</w> in de zaal was iedereen goed verstaanbaar.",
                            "target_lang_translations": {
                                "ru": "С деревянной <w>трибуны</w> в зале всех было хорошо слышно."
                            }
                        }
                    ],
                    "synonyms": [
                        "kansel",
                        "spreekgestoelte"
                    ],
                    "common_phrases": [
                        "op de praatstoel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвышение или место, с которого можно обращаться к аудитории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кафедра",
                                "target_lang_sense_clarification": "место для выступления перед публикой"
                            },
                            {
                                "target_lang_word": "трибуна",
                                "target_lang_sense_clarification": "возвышение для оратора"
                            },
                            {
                                "target_lang_word": "кафедра проповедника",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "798e0545-d938-3777-b219-2a5e0668791e",
                    "sense_definition": "Een comfortabele stoel die uitnodigt tot een lang en aangenaam gesprek.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meubilair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gastheer nam plaats in zijn favoriete <w>praatstoel</w> bij de open haard.",
                            "target_lang_translations": {
                                "ru": "Хозяин уселся в своё любимое <w>кресло для бесед</w> у камина."
                            }
                        },
                        {
                            "text": "In die zachte <w>praatstoel</w> vergaten we de tijd en praatten we urenlang.",
                            "target_lang_translations": {
                                "ru": "В этом мягком <w>кресле</w> мы забыли о времени и проболтали несколько часов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удобное кресло, располагающее к долгой и приятной беседе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уютное кресло",
                                "target_lang_sense_clarification": "мебель для отдыха и общения"
                            },
                            {
                                "target_lang_word": "кресло для бесед",
                                "target_lang_sense_clarification": "место для долгих разговоров"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}