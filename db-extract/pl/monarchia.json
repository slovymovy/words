                    },
                    {
                        "translation_id": "e05dc8ab-2ef1-4569-94ec-bc5a4e38ef22",
                        "source_entry_id": "2c5d9260-2d00-3d9f-9f3b-a68c5717208b",
                        "source_sense_id": "61d77d89-ccd0-321e-a9f1-2f639fb6a5b6",
                        "target_lang_word": "monarchie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarchie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bb5331-8281-3fd5-bab7-60713ca83ed1",
                                        "entry_id": "3626f5cb-6d39-3b5f-ab17-acf4f381fdda",
                                        "glosses": [
                                            "Organisation politique dans laquelle les pouvoirs législatif, exécutif et judiciaire sont concentrés entre les mains ou émanent d’un seul individu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25eaed03-9a02-426d-b3ad-5c6d90fce894",
                                                "sense_id": "f8bb5331-8281-3fd5-bab7-60713ca83ed1",
                                                "text": "Monarchie héréditaire, élective, absolue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                        "entry_id": "3626f5cb-6d39-3b5f-ab17-acf4f381fdda",
                                        "glosses": [
                                            "Système politique dans lequel le pouvoir appartient à un monarque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9f6baa-96bf-427e-a649-d4238c3e0b28",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "A l’origine des monarchies européennes, la féodalité ne donnait au pouvoir royal que deux sortes de fonctions; l’exercice de la puissance militaire, pour la défense de l’État, et l’administration de la justice, pour la protection des droits des sujets."
                                            },
                                            {
                                                "example_id": "934ac218-a531-4786-b28c-a96bfa0af14f",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "Le duché de Salzbourg, avec ses 7000 kilomètres carrés et ses 150000 habitants, est la plus petite des provinces de la monarchie austro-hongroise."
                                            },
                                            {
                                                "example_id": "802e53fd-42d1-4f57-843a-3870485f846b",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "Les Constituants de 1789 et de 1791, même les Législateurs de 1792 croyaient que la monarchie traditionnelle était l'enveloppe nécessaire de la société nouvelle."
                                            },
                                            {
                                                "example_id": "853dabc4-7818-42a7-a574-04f1f9d51f4a",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "Son père, […], est surnommé « Camélinat le Rouge » pour ses convictions républicaines. Cet austère paysan a élevé ses enfants dans l’aversion de la monarchie, puis de l’Empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69044eb6-9a4c-40e5-80ca-803c2387fb71",
                        "source_entry_id": "2c5d9260-2d00-3d9f-9f3b-a68c5717208b",
                        "source_sense_id": "61d77d89-ccd0-321e-a9f1-2f639fb6a5b6",
                        "target_lang_word": "monarquía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarquía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "96c753d4-00be-354f-ab0c-99109f3f0c02",
                                        "entry_id": "b44761c8-7d77-3146-898e-a573afa18158",
                                        "glosses": [
                                            "Sistema de gobierno en que el poder es ejercido por un único individuo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3859d2fe-c370-4d79-a3cf-4e76c46b52f3",
                                                "sense_id": "96c753d4-00be-354f-ab0c-99109f3f0c02",
                                                "text": "Y, para que no en todo nos valgamos de los testimonios y ejemplos antiguos, vuelva V.A. un poco atrás la consideración a las historias del siglo pasado y presente y verá todas las naciones que poseyeron la monarquía, ya sin ella."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4109f7a3-0696-367e-91df-36f5a703cd18",
                                        "entry_id": "b44761c8-7d77-3146-898e-a573afa18158",
                                        "glosses": [
                                            "En particular, sistema en que el gobernante o el jefe de Estado es seleccionado por herencia."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731c3713-0043-42ce-a47a-13a02aa54716",
                                                "sense_id": "4109f7a3-0696-367e-91df-36f5a703cd18",
                                                "text": "Suplicaron lo primero al Emperador, que, pues ya estaba en edad conveniente, ‘pensase en se casar y tomar mujer’, para asegurar la sucesión de la corona en su descendencia; petición que ya le hicieron las Cortes de Valladolid de 1518, y muy natural en donde quiera que se halla arraigada la monarquía fundada en el derecho hereditario."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ecb3e905-0b2d-388f-9612-1ab61768d83a",
                                        "entry_id": "b44761c8-7d77-3146-898e-a573afa18158",
                                        "glosses": [
                                            "Estado que se rige por monarquía_(1–2)."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b7547b-61c1-4cd3-b87d-9b15b19b961b",
                                                "sense_id": "ecb3e905-0b2d-388f-9612-1ab61768d83a",
                                                "text": "Gobernó por algún tiempo esta vasta monarquía Nabucodonosor, rey potentísimo y soberbio."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fb3f68c3-74f7-37e4-875e-4a27be373d48",
                                        "entry_id": "b44761c8-7d77-3146-898e-a573afa18158",
                                        "glosses": [
                                            "Período en que un estado se rige por una monarquía_(1–2)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c05cfb9-4f5e-46fc-909a-15c46af722f4",
                                                "sense_id": "fb3f68c3-74f7-37e4-875e-4a27be373d48",
                                                "text": "Los autores españoles que florecieron durante la monarquía gótica, pertenecen exclusivamente á la baja latinidad."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a01367e4-4990-4bbf-afc5-f7e22bc1fe93",
                        "source_entry_id": "2c5d9260-2d00-3d9f-9f3b-a68c5717208b",
                        "source_sense_id": "61d77d89-ccd0-321e-a9f1-2f639fb6a5b6",
                        "target_lang_word": "Monarchie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monarchie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                        "entry_id": "bd9c16f8-0c27-3614-8634-0a19f4221283",
                                        "glosses": [
                                            "Staatsform mit einem durch seine Herkunft berechtigten Herrscher an der Spitze"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34cce5f-87db-4b5b-91e9-0d0a0991df73",
                                                "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                                "text": "Die Monarchie in Großbritannien ist größtenteils repräsentativ."
                                            },
                                            {
                                                "example_id": "93cd5ddc-4f3b-4ea7-b46b-70a73c391ead",
                                                "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                                "text": "„Dass es die Oranjes mit dem Rauchverbot nicht allzu genau nahmen, machte ihm die Monarchie fast schon wieder sympathisch.“"
                                            },
                                            {
                                                "example_id": "92a16ecc-85f6-448e-b7e6-967b49961e8b",
                                                "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                                "text": "„Wenn der Kaiser abdankt, glauben sie, ist die Monarchie zu retten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0552659e-cb24-3938-b8a2-8dc947f856c8",
                                        "entry_id": "bd9c16f8-0c27-3614-8634-0a19f4221283",
                                        "glosses": [
                                            "Staat mit einer Monarchie [1] als Staatsform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195b12d1-9ca2-4499-899f-9da319fd3f1f",
                                                "sense_id": "0552659e-cb24-3938-b8a2-8dc947f856c8",
                                                "text": "Die Beneluxstaaten sind allesamt parlamentarische Monarchien."
                                            },
                                            {
                                                "example_id": "3d9a9edc-699f-4147-be74-d0a54f243a27",
                                                "sense_id": "0552659e-cb24-3938-b8a2-8dc947f856c8",
                                                "text": "„Die Monarchie brach zusammen, weil sie unfähig war, sich selbst zu reformieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
