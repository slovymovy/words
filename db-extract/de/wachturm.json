                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                        "entry_id": "75bea950-5986-392f-ba30-c91fce14e1e9",
                        "glosses": [
                            "Turm zur Überwachung eines Areals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0a0d89-ee5b-4c0a-a65f-bb0248a20f80",
                                "sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                                "text": "An diesem Wachturm dort kommt keiner vorbei ohne aufzufallen."
                            },
                            {
                                "example_id": "de3c3911-a9a9-4d94-b4bf-395cb9302162",
                                "sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                                "text": "„In Friedenszeiten waren diese mit Palisadenzäunen, Gräben, Wällen und Wachtürmen ausgestatteten Schutzanlagen des Reiches einigermaßen durchlässig.“"
                            },
                            {
                                "example_id": "2d605afa-6ee8-4e46-a49c-20a710c2c594",
                                "sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                                "text": "„Tag und Nacht patrouillieren nun Soldaten um das Gelände, durchsuchen Autos und halten von den Wachtürmen Ausschau nach Angreifern.“"
                            },
                            {
                                "example_id": "22163c82-bdd3-4933-aa71-9dfd264c94bf",
                                "sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                                "text": "„Diesen Eindruck verstärkten Wachtürme, blendende Scheinwerfer und Männer in Uniform mit schweren Gewehren über der Schulter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31d438a7-b29b-4d7a-9345-527c2ee8aa8d",
                        "source_entry_id": "75bea950-5986-392f-ba30-c91fce14e1e9",
                        "source_sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                        "source_sense_description": "Turm zur Überwachung eines Areals",
                        "target_lang_word": "watchtower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watchtower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                        "entry_id": "37aef86b-1367-30b8-9d4c-ae97b6d7ff75",
                                        "glosses": [
                                            "An observation tower in which a lookout keeps watch over prisoners, or looks out for fires, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69596e3e-9d88-4030-8361-d387a301e56f",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "A \"watchtower\" Website, keeping track of paedophile groups around the world, is expected to be up and running next year. The campaign will also liaise with law enforcement agencies around the world and share information on suspected Internet paedophiles."
                                            },
                                            {
                                                "example_id": "74f8aed0-4b5c-4601-a224-52b5d74dd5c2",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "Redcap - A malevolent goblin easily distinguishable by their namesake red cap, fiery red eyes, claws and iron boots. They often appear as little old men, but can run very fast despite the boots. They reside in castles and watchtowers along the English-Scottish border, but will move their residence to avoid detection."
                                            },
                                            {
                                                "example_id": "a651f21a-fd57-4e38-b05a-cfd1101c2e6b",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "Residents of Tungyin, a frontline islet under Taiwan’s Matsu islands cluster, said they spotted an unidentified aircraft flying overhead at 2.45pm on February 5, while video footage from the watchtower monitor showed an aircraft crossing the skies and flying out towards the east.\nThe military commanding centre of Tungyin confirmed that “a fixed-wing twin-propeller aircraft [had] briefly entered the airspace and soon left”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f463897a-406d-42de-9d4e-76e9619e9e99",
                        "source_entry_id": "75bea950-5986-392f-ba30-c91fce14e1e9",
                        "source_sense_id": "a0652060-0a86-3650-afa5-a3457ae7d6e7",
                        "source_sense_description": "Turm zur Überwachung eines Areals",
                        "target_lang_word": "mirador",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirador",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bff2639-8cff-3a48-9987-6047de308404",
                                        "entry_id": "e1e95255-47cb-3e99-8e6e-d6973c044392",
                                        "glosses": [
                                            "Tour de surveillance, poste d’observation, surtout dans un camp de prisonniers ou une prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a8f0aa-00db-4afd-b28a-7fa243d8b8bd",
                                                "sense_id": "2bff2639-8cff-3a48-9987-6047de308404",
                                                "text": "J’avais essayé, grâce à l’amitié d’un sergent téléphoniste du mirador, de lui faire parvenir à mon tour un message rassurant…"
                                            },
                                            {
                                                "example_id": "b14c289c-d3aa-427e-8c9b-e1709e5eafc2",
                                                "sense_id": "2bff2639-8cff-3a48-9987-6047de308404",
                                                "text": "Le long de cours d’eau qui creuse la région sauvage et montagneuse de la Transcarpatie, les gardes-frontières ne lésinent pas sur les moyens pour arrêter les fuyards : drones de surveillance thermiques, miradors, sentinelles postées en permanence aux affluents..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
