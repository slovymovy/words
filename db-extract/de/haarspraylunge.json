                ],
                "senses": [
                    {
                        "sense_id": "ec52ef2b-7e87-312d-bd33-4649bd503e33",
                        "entry_id": "b2df1906-beb1-35b4-853a-f528b01ed435",
                        "glosses": [
                            "Krankheitsbild der Lungenbläschen, das durch chronisches Einatmen von Haarspray hervorgerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24053ec-9336-4550-a82e-757d7928a138",
                                "sense_id": "ec52ef2b-7e87-312d-bd33-4649bd503e33",
                                "text": "„Daher treten bei der Haarspraylunge neben chronischem Husten auch Atemnot, schnelle Ermüdung und Abgeschlagenheit auf.“"
                            },
                            {
                                "example_id": "48964fc8-030c-4c68-8f88-d81f11eedb4b",
                                "sense_id": "ec52ef2b-7e87-312d-bd33-4649bd503e33",
                                "text": "„Bei der Haarspraylunge stellt die ständige massive Fremdkörperexposition einen dauernden Reiz zur Phagozytose durch Alveolarmakrophagen dar […].“"
                            },
                            {
                                "example_id": "e13f840c-1737-4d2a-a332-0a406069623d",
                                "sense_id": "ec52ef2b-7e87-312d-bd33-4649bd503e33",
                                "text": "„Besonders Filmbildner und Weichmacher wie Polyvinylpyrrolidon, kurz PVP, und modifizierte Kunststoffe befinden sich nach wie vor in so manchem Haarspray, die Auslöser der Haarspraylunge bei der jungen Coiffeurin.“"
                            },
                            {
                                "example_id": "58e9c4c8-e200-4409-8dc5-f3da0fc75269",
                                "sense_id": "ec52ef2b-7e87-312d-bd33-4649bd503e33",
                                "text": "„Haarspraylunge, Mausarm, ein Sturz vom ungesicherten Gerüst – Gefahren gibt es für Beschäftigte in allen Branchen, selbst am musterhaften ›Standort Deutschland‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
