        "nl-extract.jsonl": [
            {
                "entry_id": "84696fae-cdd0-3df5-af30-6ed543211d71",
                "word": "multitasken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "73693110-318e-3f09-9c46-59709655f5d9",
                        "entry_id": "84696fae-cdd0-3df5-af30-6ed543211d71",
                        "glosses": [
                            "twee of meer dingen tegelijk doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8746509-b8d8-413e-8a27-b0859b6fb2a9",
                                "sense_id": "73693110-318e-3f09-9c46-59709655f5d9",
                                "text": "“Mensen willen ook best in hun brein gestimuleerd worden”, stelt ze. “Je kunt je brein onder meer voeden door bewust te kiezen voor focus en multitasken te vervangen door singletasken.”"
                            },
                            {
                                "example_id": "000d23ba-075f-4c81-ad02-9b7d43d13bb3",
                                "sense_id": "73693110-318e-3f09-9c46-59709655f5d9",
                                "text": "De verplichting om enkel met havenarbeiders uit de pool te werken, de erkenning van logistieke arbeiders, de beperkte duur van contracten en ploegsamenstelling en het verbod op multitasking drempels was volgens Europa in strijd met de Europese regel over de vrijheid van vestiging."
                            },
                            {
                                "example_id": "c096b0ca-b863-4736-8cb9-3f580da6efd0",
                                "sense_id": "73693110-318e-3f09-9c46-59709655f5d9",
                                "text": "Psycholoog en coach Maaike van Dort herkent dat. „Laatkomers hebben vaak veel energie en kunnen goed multitasken, maar ze vinden het soms moeilijk om hoofd- en bijzaken te onderscheiden of op de rem te trappen."
                            }
                        ]
                    }
                ],
