                        ],
                        "examples": [
                            {
                                "example_id": "a8c64000-9c20-447c-b5d8-e5b33ccf1418",
                                "sense_id": "205d578f-08e5-3a68-b964-b1b11addb90f",
                                "text": "Ce succès sera-t-il durable ? assurément, puisque Mme Germaine Gallois, fleur de vie heureuse, épanouissement de grâce et de joie, à la voix souple et sûre, si prenante, Mᵐᵉ Germaine Gallois, chanteresse enchanteresse, est tour à tour la Fée Isotine, Biscotte, la Sorcière du Baven ;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd4959a1-1b85-439c-8a64-436755e8943e",
                        "source_entry_id": "147a089c-9ab1-3de3-aef3-b8a8e30a1d92",
                        "source_sense_id": "205d578f-08e5-3a68-b964-b1b11addb90f",
                        "target_lang_word": "chantress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chantress",
