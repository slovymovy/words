                "senses": [
                    {
                        "sense_id": "cbd97d0a-d29a-319d-918e-574ef83e3147",
                        "entry_id": "a364431f-4d75-35b2-8c76-de469b75b16b",
                        "glosses": [
                            "Fleischgericht aus dem Rückenfleisch eines Lamms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbebde2-428c-41d4-85ab-bc27103d5fba",
                                "sense_id": "cbd97d0a-d29a-319d-918e-574ef83e3147",
                                "text": "„Ganz allein hatte er einmal einen gefüllten Lammrücken, drei Portionen Rahmzwiebeln, ein Tablett mit Zimtschnecken und eine Nesselrode-Maronensahnetorte verdrückt - in einem Rutsch.“"
                            },
                            {
                                "example_id": "e344fad6-ce1b-42b2-a27f-0df6ece7ebd7",
                                "sense_id": "cbd97d0a-d29a-319d-918e-574ef83e3147",
                                "text": "„Er hatte Lammrücken im Kühlschrank, den er gebraten hätte, wenn sie nicht essen gegangen wären, aber für sich alleine wollte er keinen ganzen Lammrücken zubereiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
