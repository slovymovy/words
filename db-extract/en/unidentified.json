                                        "sense_id": "529a472f-356b-36d8-80fd-48fcfb63e501",
                                        "entry_id": "d2c720d4-7bd9-394d-adc8-2daf78549b3a",
                                        "glosses": [
                                            "von wenigen gekannt, nicht im Allgemeinwissen vorhanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb427c3-6617-4d3d-8d50-529bc325d4d2",
                                                "sense_id": "529a472f-356b-36d8-80fd-48fcfb63e501",
                                                "text": "Der Autor ist unverdientermaßen immer noch ganz unbekannt."
                                            },
                                            {
                                                "example_id": "61514880-6f11-475b-bfe1-bcec8bd608f0",
                                                "sense_id": "529a472f-356b-36d8-80fd-48fcfb63e501",
                                                "text": "„Erfahrene Paragleiter wie Jean-Pierre attestieren Jordanien zwar ideale Bedingungen für den im Haschemitischen Königreich bislang fast unbekannten Sport.“"
                                            },
                                            {
                                                "example_id": "6b82d07b-38a4-45c4-9bf8-1bcf456ebbdd",
                                                "sense_id": "529a472f-356b-36d8-80fd-48fcfb63e501",
                                                "text": "„Die in Brasilien sehr verbreitete Tradition des Candomblés ist in Europa weitgehend unbekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2248e38d-4c61-3f43-af14-70d6ae52f6f7",
                                        "entry_id": "d2c720d4-7bd9-394d-adc8-2daf78549b3a",
                                        "glosses": [
                                            "so, dass man etwas nicht weiß, kein Wissen, keine Informationen über etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9abd2b94-89c8-4c6f-afd9-ee5ff0449829",
                                                "sense_id": "2248e38d-4c61-3f43-af14-70d6ae52f6f7",
                                                "text": "„Wie viele Menschen tatsächlich Mitglied der NSDAP waren, ist weitgehend unbekannt.“"
                                            },
                                            {
                                                "example_id": "6fa0f75d-f6b5-4adf-b05c-665d87b56793",
                                                "sense_id": "2248e38d-4c61-3f43-af14-70d6ae52f6f7",
                                                "text": "„Aus Gründen, die uns unbekannt sind, hat er sich dem Ort genähert, an dem sich die Tiere aufhielten.“"
                                            },
                                            {
                                                "example_id": "49405de6-9b11-4426-9411-d1a9abfaade2",
                                                "sense_id": "2248e38d-4c61-3f43-af14-70d6ae52f6f7",
                                                "text": "„Der Fall hatte in Hamburg für viel mediales Aufsehen gesorgt, die Verdächtigen waren dabei zunächst unbekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
