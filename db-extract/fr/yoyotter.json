                "senses": [
                    {
                        "sense_id": "d88ed719-2817-3a19-af24-e7eca0fa939b",
                        "entry_id": "eca8b782-089e-327c-bedb-8bc66ec7eb59",
                        "glosses": [
                            "Avoir perdu la raison, être fou, délirer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efd05d9-c285-4802-a1fe-f6dbfd7d89f7",
                                "sense_id": "d88ed719-2817-3a19-af24-e7eca0fa939b",
                                "text": "Alors, pourquoi le Bordelais avait-il tenu à venir se planquer dans cette brousse ? Il yoyottait de la mansarde, Gus, c'était pas possible."
                            },
                            {
                                "example_id": "ab26b826-3e28-47f8-ac07-0a236cdb9c93",
                                "sense_id": "d88ed719-2817-3a19-af24-e7eca0fa939b",
                                "text": "Se rendant très bien compte qu’il peut se remettre à yoyotter du jour au lendemain, il s’empresse de nommer un nouveau Conseil d’État."
                            }
                        ]
                    }
