                                        ]
                                    },
                                    {
                                        "sense_id": "1ba6e8db-a392-3832-a161-ab6000368625",
                                        "entry_id": "697d7063-e1e2-3c08-8a66-6800add345b9",
                                        "glosses": [
                                            "The capacity or potential for achieving results."
                                        ],
                                        "tags": [
