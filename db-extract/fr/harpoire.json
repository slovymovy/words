                        "glosses": [
                            "Corde à laquelle est fixé le harpon pour la pêche à la baleine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e24dfe-afb7-40aa-87f0-6223fb4d7f32",
                                "sense_id": "0a806e74-193f-3d0e-b0a2-d1aa94fa2331",
                                "text": "À ce fer, près du manche est attachée la harpoire, qui est une corde de six à sept brasses de longueur et de un demi pouce d'épaisseur ; elle doit être faite en chanvre le plus doux, et le plus fin; et sans être goudronnée; on la roule afin qu'elle ne retienne le harpon quand on la lance."
                            }
                        ]
                    }
