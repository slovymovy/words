                "translations": [
                    {
                        "translation_id": "5fa5f224-02fa-4643-b9c1-0a07b9d0ff13",
                        "source_entry_id": "38805919-5d16-390a-a1c7-9664211d8fb9",
                        "source_sense_id": "40b85337-b158-3aeb-905a-b5a54f7a9100",
                        "target_lang_word": "subclass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subclass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf80b174-e254-3c61-bdc0-b2960915dbfc",
                                        "entry_id": "4abc76b8-7c2b-3083-a6b7-6ed10b008f55",
                                        "glosses": [
                                            "A secondary class within a main class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd48dff1-a75f-4158-bf21-51401ed939c4",
                                                "sense_id": "bf80b174-e254-3c61-bdc0-b2960915dbfc",
                                                "text": "1959, \"Steam's Finest Hour\" edited by David P. Morgan, Kalmbach Publishing Co., referring to the R-1 Mountain class loco.\nThese 4-8-2's, of which B&M eventually purchased 18 in various subclasses, could almost haul the tonnage of a T and more than made up for the slight deficiency by raising the maximum speed limit from 45 to 70 miles per hour, thanks to 73-inch drivers."
                                            },
                                            {
                                                "example_id": "53ee76ad-3464-4238-9bb5-2e8dfed6d543",
                                                "sense_id": "bf80b174-e254-3c61-bdc0-b2960915dbfc",
                                                "text": "Goffin is a prose text interspersed with short lists of typical terms exemplifying certain sub-classes of Indian English lexis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6126720-ae58-33ed-8ae3-2b38f8928caf",
                                        "entry_id": "4abc76b8-7c2b-3083-a6b7-6ed10b008f55",
                                        "glosses": [
                                            "A rank directly below class."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85a1a2c0-f75e-3d1c-9371-ae396a786dd5",
                                        "entry_id": "4abc76b8-7c2b-3083-a6b7-6ed10b008f55",
                                        "glosses": [
                                            "An object class derived from another class (its superclass) from which it inherits a base set of properties and methods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "subclass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d7b4aa0-0dc1-3cdb-9fb3-8fe1332e448e",
                                        "entry_id": "354beae0-bf12-3c58-8fb5-bbc5fbc35486",
                                        "glosses": [
                                            "(in object-oriented programming) To create a subclass of (some class)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148fe92e-968a-45b7-83fd-18e71ba56450",
                                                "sense_id": "2d7b4aa0-0dc1-3cdb-9fb3-8fe1332e448e",
                                                "text": "I subclassed the Button class to create a more specialised FancyButton class for my user interface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe662f6-15cc-3456-89f5-789573b4d69f",
                                        "entry_id": "354beae0-bf12-3c58-8fb5-bbc5fbc35486",
                                        "glosses": [
                                            "To cause (an object) to act as an instance of a subclass (by creating the desired subclass and instantiating an object of this subclass)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2374b35-9310-48bd-9143-0d3576d2b9e2",
                                                "sense_id": "3fe662f6-15cc-3456-89f5-789573b4d69f",
                                                "text": "Since Windows knows about these events, your application should be able to know about them as well. In order to accomplish this, subclass the window of a form or control, intercepting all of its events."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
