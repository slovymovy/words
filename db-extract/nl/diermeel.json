                        "glosses": [
                            "veevoer gemaakt van vermalen slachtafval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bc6773-f454-4c95-ac72-accfeb991d86",
                                "sense_id": "ab214350-a419-3cfa-9d2c-9d349310bb0c",
                                "text": "Het gebruik van diermeel bespaart veel geld, omdat nu bijvoorbeeld in plaats daarvan de dure soja moet worden ingevoerd. De import daarvan is ook nog eens schadelijker voor het milieu. Ook gaan nu waardevolle grondstoffen verloren omdat veel slachtafval, waarvan diermeel wordt gemaakt, wordt vernietigd."
                            },
                            {
                                "example_id": "aa8bcfa0-5e80-40b5-b9f9-36f6f89e3ca9",
                                "sense_id": "ab214350-a419-3cfa-9d2c-9d349310bb0c",
                                "text": "Het Platform vindt dat de EU de afhankelijkheid van de invoer van soja moet verminderen. Dat kan door diermeel (van verwerkte kadavers) weer te gebruiken als ingrediënt voor diervoer. Daar werkt de Europese Unie al aan. Ook zou de EU bedrijven kunnen verplichten voorraden aan te houden."
                            }
                        ]
                    }
