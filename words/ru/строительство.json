                    "frequency": "Low",
                    "semantic_group_id": "производство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древесину агатиса веками использовали для <w>строительства</w> кораблей.",
                            "target_lang_translations": {
