                "senses": [
                    {
                        "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                        "entry_id": "f13c7ad4-834b-35be-9086-d0a5aba13e33",
                        "glosses": [
                            "Personne qui arnaque, qui a l’habitude d’arnaquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf5594f-bc8f-4589-9e8c-db35fae395db",
                                "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                "text": "Jérôme, mon nouveau voisin, est un arnaqueur professionnel d’une trentaine d’années."
                            },
                            {
                                "example_id": "17302062-a80f-4a47-b2a7-d3a513357afb",
                                "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                "text": "Ses partisans d’aujourd’hui ne sont pas les premières victimes de cet arnaqueur professionnel qui n’a jamais eu d’autres intérêts que les siens."
                            },
                            {
                                "example_id": "b91509e6-3a3d-4bb6-89dd-692568baab85",
                                "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                "text": "Inspirée du livre-enquête du journaliste de Mediapart Fabrice Arfi, la série raconte comment deux arnaqueurs de Belleville sont parvenus à mettre au point l’arnaque du siècle avec l’aide d’un trader des beaux quartiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecf1f8f5-3301-4ce9-ad44-fe5c7ccbf733",
                        "source_entry_id": "f13c7ad4-834b-35be-9086-d0a5aba13e33",
                        "source_sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                        "target_lang_word": "swindler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swindler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                        "entry_id": "89e27509-af74-3378-9c68-a207d495798b",
                                        "glosses": [
                                            "A person who swindles, cheats or defrauds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ced64a-cc6b-42cc-8c76-a7c33a5aec03",
                                                "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                                "text": "But I got somethin’ to say bearin’ on that swindler who got what was comin’ to him."
                                            },
                                            {
                                                "example_id": "9416d523-bc56-4266-b443-b93f128a220f",
                                                "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                                "text": "There’s good reason to worry. In an earlier memoir, “Five-Finger Discount,” Stapinski recreated the terrifying world of swindlers, embezzlers, burglars and mobster wannabes who made up her extended Jersey City family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
