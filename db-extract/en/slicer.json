                    {
                        "translation_id": "65b99be8-c60b-4ec0-8fb6-442295633141",
                        "source_entry_id": "abfb5516-17a0-312c-a4a7-a803fa325706",
                        "source_sense_description": "someone or -thing that slices",
                        "target_lang_word": "Schneider",
