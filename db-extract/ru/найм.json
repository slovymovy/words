                "senses": [
                    {
                        "sense_id": "7b39d9ab-ecba-34ea-983a-060516f7fa42",
                        "entry_id": "748e8174-a013-3775-b7d6-0c3e4b1b2ae8",
                        "glosses": [
                            "разг. действие по значению гл. нанимать, устройство на оплачиваемую работу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a984e70a-ab10-46c3-8d24-4cd63d0cbdcc",
                                "sense_id": "7b39d9ab-ecba-34ea-983a-060516f7fa42",
                                "text": "На Рождество пришёл к нему из деревни Кудашева молодой парень, годов двадцати, и согласился на найм."
                            }
                        ]
                    },
                    {
                        "sense_id": "d607a14f-b229-3fe0-ae7d-2c6fe51f83c9",
                        "entry_id": "748e8174-a013-3775-b7d6-0c3e4b1b2ae8",
                        "glosses": [
                            "разг. взятие в аренду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a120992d-acae-4384-8b65-07fd847d26a4",
                                "sense_id": "d607a14f-b229-3fe0-ae7d-2c6fe51f83c9",
                                "text": "Немало удивился содержатель станции и другие ямщики и их жёны, узнав, что Дирих с латышкою покидают хорошую избу, за найм которой вперёд уплачено, и бросают целую десятину, засеянную хлебом."
                            }
                        ]
                    }
