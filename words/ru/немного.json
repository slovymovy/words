                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рядчик подумал <w>немного</w>, встряхнул головой и согласился.",
                            "target_lang_translations": {
                                "en": "The contractor thought <w>a little</w>, shook his head, and agreed.",
                                "cs": "Dodavatel <w>chvíli</w> přemýšlel, zavrtěl hlavou a souhlasil.",
                                "zh": "承包商想了<w>一会儿</w>，摇了摇头，同意了。",
                                "nl": "De aannemer dacht <w>even</w> na, schudde zijn hoofd en ging akkoord.",
                                "pl": "Wykonawca pomyślał <w>chwilę</w>, potrząsnął głową i się zgodził.",
                                "de": "Der Unternehmer überlegte <w>kurz</w>, schüttelte den Kopf und stimmte zu.",
                                "fr": "L'entrepreneur a réfléchi <w>un moment</w>, a secoué la tête et a accepté.",
                                "it": "L'appaltatore ha riflettuto <w>un po'</w>, ha scosso la testa e ha accettato.",
