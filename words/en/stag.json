                },
                {
                    "sense_id": "52613d11-3185-363d-a0c6-385925614275",
                    "sense_definition": "A young horse, such as a colt or filly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spirited <w>stag</w> galloped across the open paddock.",
                            "target_lang_translations": {
                                "ru": "Резвый <w>жеребёнок</w> скакал по открытому загону."
                            }
                        },
                        {
                            "text": "He purchased a promising young <w>stag</w> to train for riding.",
                            "target_lang_translations": {
                                "ru": "Он приобрёл многообещающего молодого <w>коня</w>, чтобы выездить его для верховой езды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая лошадь; жеребёнок (диалектное)."
