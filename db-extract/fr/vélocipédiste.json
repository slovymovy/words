                        "entry_id": "ac078792-1115-390e-9a89-c5a1398f4eeb",
                        "glosses": [
                            "Celui qui va sur un vélocipède."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e0f8c1c3-6a5c-4a19-a45a-d7a337c7932e",
                                "sense_id": "6fb899fd-c7a7-314e-9ff6-044e3e56cd97",
                                "text": "Un vélocipédiste exercé peut faire, sur une route bien entretenue et dans un pays modérément accidenté, une traite quotidienne de 80 à 100 kilomètres pendant plusieurs jours de suite."
                            },
                            {
                                "example_id": "f6527834-368d-46ee-b76f-cfe43bf0d5bc",
                                "sense_id": "6fb899fd-c7a7-314e-9ff6-044e3e56cd97",
                                "text": "Je doute fort que les vélocipédistes ou les manilleurs actuels se déterminassent aussi volontiers que leurs pères aux aventures dangereuses, aux fredaines parfois héroïques dont la guerre franco-prussienne offrit l’occasion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6171451e-7274-4dda-92be-a831616eb4c4",
                        "source_entry_id": "ac078792-1115-390e-9a89-c5a1398f4eeb",
                        "source_sense_id": "6fb899fd-c7a7-314e-9ff6-044e3e56cd97",
                        "target_lang_word": "bicyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
