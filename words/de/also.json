    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4af8159a-39e9-32be-ab17-7ee17bd2dbd3",
                    "sense_definition": "drückt eine logische Folge oder Schlussfolgerung aus; folglich",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "folgerung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es regnet stark und wir haben keinen Regenschirm dabei, <w>also</w> werden wir wohl nass."
                        },
                        {
                            "text": "Sie fühlte sich nicht wohl und hatte Fieber, <w>also</w> blieb sie heute lieber im Bett."
                        }
                    ],
                    "synonyms": [
                        "deshalb",
                        "daher",
                        "deswegen",
                        "darum",
                        "folglich"
                    ],
                    "antonyms": [
                        "dennoch",
                        "trotzdem"
                    ]
                },
                {
                    "sense_id": "d5d64991-b5b7-3144-aebe-5600d0a9691b",
                    "sense_definition": "leitet eine nähere Bestimmung, Erläuterung oder Richtigstellung ein; das heißt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "erlaeuterung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein bester Freund, <w>also</w> der Mann mit der roten Brille, kommt gleich zu uns herüber."
                        },
                        {
                            "text": "Wir treffen uns übermorgen, <w>also</w> am Freitagabend, um gemeinsam ins Konzert zu gehen."
                        }
                    ],
                    "synonyms": [
                        "das heißt",
                        "mit anderen Worten"
                    ]
                },
                {
                    "sense_id": "2364937a-2b53-301a-be35-6acceff53f5b",
                    "sense_definition": "auf ebendiese Art und Weise; so",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Also</w> sprach der erfahrene Wanderer zu den jungen Leuten, bevor sie den Berg bestiegen."
                        },
                        {
                            "text": "Niemand im Dorf hatte erwartet, dass sich die Dinge <w>also</w> entwickeln würden."
                        }
                    ],
                    "synonyms": [
                        "so"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "gehoben oder veraltet"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
