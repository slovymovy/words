                    {
                        "form_id": "5e7218e9-ca50-4273-9e36-1916aee313de",
                        "entry_id": "4e961712-0221-3e20-980c-28a4e6759d99",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "идемпоте́нтны"
