                        "examples": [
                            {
                                "example_id": "a9efbfa1-1719-4e9a-9a51-9321ab96af2f",
                                "sense_id": "9fffb776-a718-39e2-a6a9-0b588d991260",
                                "text": "De strategie van de industrie is al jaren dezelfde: het aantal probleemdrinkers in twijfel trekken, de eigen zelfregulering prijzen, de probleemdrinkers op hun eigen verantwoordelijkheid wijzen en vooral niet de gezondheidsrisico's van het eigen product benoemen."
                            },
                            {
                                "example_id": "c82bf65e-78d7-4b66-8577-a839ae97c4be",
                                "sense_id": "9fffb776-a718-39e2-a6a9-0b588d991260",
                                "text": "Naar schatting 1,1 miljoen Japanners waren vorig jaar alcoholverslaafd, terwijl dat tien jaar eerder nog om 800 duizend mensen ging. Nog eens 10 miljoen mensen zijn mogelijke probleemdrinkers, die dagelijks meer dan 60 gram alcohol drinken, ofwel meer dan drie flesjes bier. Slechts 40 duizend van hen zoeken feitelijk hulp."
                            }
                        ]
                    }
