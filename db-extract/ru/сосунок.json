                "translations": [
                    {
                        "translation_id": "527da243-b57a-43c1-9b9f-a430bff85d19",
                        "source_entry_id": "3714f304-0f6e-3ad6-b9f3-c0eefe68ac1b",
                        "source_sense_description": "детёныш",
                        "target_lang_word": "Säugling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Säugling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a8e21d3-a2e7-3cc3-b7fe-937024083f78",
                                        "entry_id": "46932f0e-aefe-3a6e-8c61-6bdccda9ba50",
                                        "glosses": [
                                            "neugeborenes Kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39469616-65ae-4a93-afce-ac9ada2ab725",
                                                "sense_id": "8a8e21d3-a2e7-3cc3-b7fe-937024083f78",
                                                "text": "Viele Säuglinge weigern sich, sich wickeln zu lassen."
                                            },
                                            {
                                                "example_id": "bc5763ff-81e1-4043-bc38-883f27a98b2b",
                                                "sense_id": "8a8e21d3-a2e7-3cc3-b7fe-937024083f78",
                                                "text": "„Ich reichte ihr den Säugling, der in der Aussicht lachte, gleichzeitig essen und trinken zu können.“"
                                            },
                                            {
                                                "example_id": "656bf363-b99e-4191-baf0-0918cd01be54",
                                                "sense_id": "8a8e21d3-a2e7-3cc3-b7fe-937024083f78",
                                                "text": "„Auch habe er als etwa Dreijähriger gerne Lämmchen mit Hafer gefüttert, allerdings auch einen halbjährigen Säugling, zu dem er sich »geschlichen« habe und dem er, als er »in der Wiege recht bauernmäßig das Maul aufsperrte«, Hafer in jenes Maul gestopft habe.“"
                                            },
                                            {
                                                "example_id": "8cfc10d7-51de-47fa-97bd-a5f73d239575",
                                                "sense_id": "8a8e21d3-a2e7-3cc3-b7fe-937024083f78",
                                                "text": "„Johann Georg Tinius roch so, wie alle Säuglinge riechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55b18ed2-1314-31f1-a15d-cb9b636a9b51",
                                        "entry_id": "46932f0e-aefe-3a6e-8c61-6bdccda9ba50",
                                        "glosses": [
                                            "Anfänger"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1ee61ce-6e2a-4ed4-a2ae-a6a2e4f05ae5",
                                                "sense_id": "55b18ed2-1314-31f1-a15d-cb9b636a9b51",
                                                "text": "Zum Glück spielte er im Dart gegen einen Säugling, sonst hätte er nicht gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
