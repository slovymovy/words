                        "target_lang_word": "discount",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discount",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88871ade-019c-301f-9bf1-98c1118a453d",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To sell at a reduced price."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878f9c24-90db-475e-ae0d-48217e87e090",
                                                "sense_id": "88871ade-019c-301f-9bf1-98c1118a453d",
                                                "text": "Sales were slow even after the shop discounted the product."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c544aa50-3be8-3a62-9c72-97033ec36c0b",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To deduct from an account, debt, charge, etc."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256ae3e7-7a79-448a-bebc-b3775e3afbaa",
                                                "sense_id": "c544aa50-3be8-3a62-9c72-97033ec36c0b",
                                                "text": "Merchants sometimes discount five or six per cent for prompt payment of bills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d2d7cd-b883-35ec-8f53-74ead2cae82f",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To disregard an account or regard as unimportant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62aca499-b295-4e18-bc39-a01f3e30523e",
                                                "sense_id": "18d2d7cd-b883-35ec-8f53-74ead2cae82f",
                                                "text": "Owing to his reputation, they discounted his comments."
                                            },
                                            {
                                                "example_id": "976695a5-4155-4aa3-95e2-b82613558685",
                                                "sense_id": "18d2d7cd-b883-35ec-8f53-74ead2cae82f",
                                                "text": "Of the three opinions, (I discount Brown's), under this head, one supposes that the law of Causality is a positive affirmation, and a primary fact of thought, incapable of all further analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbabe04f-f522-3b03-89cb-b7c251664a02",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To lend money upon, deducting the discount or allowance for interest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e570bc-4551-4ff3-ba63-31a8d1717e3a",
                                                "sense_id": "cbabe04f-f522-3b03-89cb-b7c251664a02",
                                                "text": "The banks discount notes and bills of exchange."
                                            },
                                            {
                                                "example_id": "1ab94dc3-31ef-4c39-b834-3524db9fb9b1",
                                                "sense_id": "cbabe04f-f522-3b03-89cb-b7c251664a02",
                                                "text": "Discount only unexceptionable paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa7a8b9-2b90-3ad6-b182-a2ec68c8d65e",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To take into consideration beforehand; to anticipate and form conclusions concerning (an event)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c212b2-3193-4bf9-adf5-2e948a76ccfc",
                                                "sense_id": "efa7a8b9-2b90-3ad6-b182-a2ec68c8d65e",
                                                "text": "The market has dropped, discounting changes in interest rates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "701ba9f7-fc07-3a8f-8529-4fc44299e3de",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To believe, or act as though one believes, that one's own feelings are more important than the reality of a situation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "discount",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51bb93d1-3fc1-346c-8e16-e5c790981737",
                                        "entry_id": "f122fd16-cada-3e0d-932a-aae9e516ef56",
                                        "glosses": [
                                            "A reduction in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5096f05-d032-458b-a468-d80ed27ecf22",
                                                "sense_id": "51bb93d1-3fc1-346c-8e16-e5c790981737",
                                                "text": "For the summer sale, there was 40% discount in all the stores at the mall."
                                            },
                                            {
                                                "example_id": "095bb4b7-6c7c-44a0-b9a1-fe04b914ce98",
                                                "sense_id": "51bb93d1-3fc1-346c-8e16-e5c790981737",
                                                "text": "This store offers discounts on all its wares. That store specializes in discount wares, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be205af-3f34-3358-880e-562946eb7881",
                                        "entry_id": "f122fd16-cada-3e0d-932a-aae9e516ef56",
                                        "glosses": [
                                            "A deduction made for interest, in advancing money upon, or purchasing, a bill or note not due; payment in advance of interest upon money."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "047dddc3-e522-32b1-a4ed-bc9548ab611b",
                                        "entry_id": "f122fd16-cada-3e0d-932a-aae9e516ef56",
                                        "glosses": [
                                            "The rate of interest charged in discounting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "772ea14d-01a9-3089-938b-b1c475d7e412",
                                        "entry_id": "f122fd16-cada-3e0d-932a-aae9e516ef56",
                                        "glosses": [
                                            "A lack or shortcoming."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50b2d4b-d7a0-4494-b6f2-865b8f6dcabc",
                                                "sense_id": "772ea14d-01a9-3089-938b-b1c475d7e412",
                                                "text": "On our approaching the house where the Misses Spenlow lived, I was at such a discount in respect of my personal looks and presence of mind, that Traddles proposed a gentle stimulant in the form of a glass of ale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ec00bd3-0161-3da5-9fc0-798cf613db13",
                                        "entry_id": "f122fd16-cada-3e0d-932a-aae9e516ef56",
                                        "glosses": [
                                            "The act of one who believes, or act as though they believe, that their own feelings are more important than the reality of a situation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "discount",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1c35ad-3b81-3389-bd03-93bbcea7d967",
