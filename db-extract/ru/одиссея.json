                        ]
                    },
                    {
                        "translation_id": "0861a41e-6354-4d2b-8587-5a15aaedc883",
                        "source_entry_id": "66c67919-24a5-31b1-bb3a-80d52b66f8f6",
                        "source_sense_id": "ed020871-99b3-3984-91d9-7b2afa1c5f6f",
                        "target_lang_word": "Odyssée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Odyssée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10175ecd-edd4-3534-990a-812757727ac9",
                                        "entry_id": "1e096c05-fc46-3e7f-ae6e-cd30a4303dca",
                                        "glosses": [
                                            "Poème épique d’Homère racontant les aventures vécues par Ulysse après la guerre de Troie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8c266b-38db-4dae-b265-fdb29b293fe1",
                                                "sense_id": "10175ecd-edd4-3534-990a-812757727ac9",
                                                "text": "L’Iliade et l’Odyssée sont les deux poèmes fondateurs de la civilisation européenne."
                                            },
                                            {
                                                "example_id": "bcab5a8e-a9fb-451b-bd3d-fe3288042e4f",
                                                "sense_id": "10175ecd-edd4-3534-990a-812757727ac9",
                                                "text": "« Ulysse 31 » situe l’Odyssée et divers épisodes de la mythologie grecque au XXXIᵉ siècle apr. J.-C."
                                            },
                                            {
                                                "example_id": "b900d9bd-d0e6-4b57-a554-041df8be88a6",
                                                "sense_id": "10175ecd-edd4-3534-990a-812757727ac9",
                                                "text": "Et j’ai été saisi par l’Odyssée, ce récit mystique racontant l’attachement viscéral à la mère patrie. J’étais fasciné par ce texte, sans m’interroger sur la signification qu’il revêtait à l’évidence pour moi. J’avais quitté le pays où j’étais né. Comme Ulysse, je ne savais pas si j’y retournerais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
