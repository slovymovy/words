                        "entry_id": "4a745b21-2895-3468-a64c-ee3ae9c4d107",
                        "glosses": [
                            "Qui se rapporte aux Karens, peuple de la Birmanie et de la Thaïlande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce07f61-48e5-4f42-9f99-8ad31226c10d",
                                "sense_id": "53e99f8f-1395-36bb-a82e-1ea0b468f66d",
                                "text": "En vérité, ce n’est pas vraiment une île, juste un gros rocher habité par des perroquets. Cinq mille vingt-deux, à en croire leur guide karen local."
                            }
                        ]
                    }
                ],
