                                                "example_id": "e0995bdd-b826-4f5a-af6d-a41747f77e55",
                                                "sense_id": "c8c8f0be-1247-3862-b731-c86c4f2e13f8",
                                                "text": "‘Well, if you're going to jazz about the way you do, I suppose you'll need rouge at your age.’"
                                            }
