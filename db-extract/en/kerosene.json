                        ]
                    },
                    {
                        "translation_id": "a0cbf28f-aa0e-403a-8a17-84a8ef81c960",
                        "source_entry_id": "b46c1719-24f9-3323-bbfd-5d084843bbbd",
                        "source_sense_id": "b7ad2f67-5c2f-3d55-a7a5-4fe0a9c8692b",
                        "source_sense_description": "thin, colorless fuel",
                        "target_lang_word": "kérosène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kérosène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                        "entry_id": "06b88568-ef64-30ca-adef-b4ac1fe87f1d",
                                        "glosses": [
                                            "Mélange d’hydrocarbures produit par raffinage, qui fut longtemps utilisé comme liquide d’éclairage et sert de nos jours surtout comme carburant pour les avions et comme additif dans l'essence d'automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af3620e1-2d81-416e-b4dc-d205f4e593a1",
                                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                                "text": "Je rappelle que la convention de Chicago interdit toute taxation sur le kérosène."
                                            },
                                            {
                                                "example_id": "a31545d7-2a95-40b5-a4db-899b9b2c631e",
                                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                                "text": "La température à laquelle le kérosène brûle est suffisante pour faire perdre à l’acier environ 75 % de sa force."
                                            },
                                            {
                                                "example_id": "cdd510c9-b936-476d-8bcf-db18c9ad8b51",
                                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                                "text": "Pourtant, à l'heure creuse, quand la rumeur des boulevards s'intensifie et qu'à la puanteur du kérosène s'ajoute la frénésie des klaxons..."
                                            },
                                            {
                                                "example_id": "d9cb6f70-6c27-429a-8a18-745a18897e8e",
                                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                                "text": "Le quota de rejet carbone (ou méthane) devrait lui aussi être limité : fumer tue, prévient la loi, sur chaque paquet de cigarette. Brûler du kérosène par caprice tue plus sûrement encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51dffcb4-1e69-432b-b714-5b941a4c6dbc",
                        "source_entry_id": "b46c1719-24f9-3323-bbfd-5d084843bbbd",
                        "source_sense_id": "b7ad2f67-5c2f-3d55-a7a5-4fe0a9c8692b",
                        "source_sense_description": "thin, colorless fuel",
                        "target_lang_word": "Petroleum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petroleum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6f8ca0-c68a-3382-b74b-76da203e4f50",
                                        "entry_id": "9de88a94-e893-383d-b570-b90497880fd8",
                                        "glosses": [
                                            "farblose aus Erdöl gewonnene Flüssigkeit, die zur Lichterzeugung oder Wärmegewinnung durch Verbrennen genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dfb4836-e356-413c-a3c3-c6e611366298",
                                                "sense_id": "fd6f8ca0-c68a-3382-b74b-76da203e4f50",
                                                "text": "Petroleum wird heute u. a. in Strahltriebwerken für Flugmodelle eingesetzt."
                                            },
                                            {
                                                "example_id": "aeccbb42-7aac-4fdc-b999-f836e79c4ed3",
                                                "sense_id": "fd6f8ca0-c68a-3382-b74b-76da203e4f50",
                                                "text": "„Typisch für die Gegend war der Geruch nach Petroleum, das von vielen als Waschmittel gegen Läuse verwendet wurde.“"
                                            },
                                            {
                                                "example_id": "8bf19d16-fc75-452b-b393-4fa652dea30c",
                                                "sense_id": "fd6f8ca0-c68a-3382-b74b-76da203e4f50",
                                                "text": "„Aber erst in den letzten dreißig Jahren hat man hier Petroleum daraus bereitet.“"
                                            },
                                            {
                                                "example_id": "d592fe79-b385-4d95-b9dc-b27ab3cb1b7e",
                                                "sense_id": "fd6f8ca0-c68a-3382-b74b-76da203e4f50",
                                                "text": "„Im Schutze der Dunkelheit waren die Russen bis zur Holzbrücke an der Kolotscha vorgedrungen, hatten sie mit Petroleum getränkt und angezündet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86bac34d-5da7-4b12-953d-7936b7e375ce",
                        "source_entry_id": "b46c1719-24f9-3323-bbfd-5d084843bbbd",
                        "source_sense_id": "b7ad2f67-5c2f-3d55-a7a5-4fe0a9c8692b",
                        "source_sense_description": "thin, colorless fuel",
                        "target_lang_word": "Kerosin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerosin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                        "entry_id": "9d41af7e-33cd-3f28-994d-890106de84a4",
                                        "glosses": [
                                            "Kraftstoff für Turbostrahltriebwerke und Dieselmotoren von Flugzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2278a463-3e08-4df8-920f-cd13990f7eea",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "Kerosin ist ein besonders enger Fraktionierschnitt des Erdöls, d. h. es befinden sich vergleichsweise viele Moleküle der gleichen Sorte (Dichte) in dem Kraftstoff."
                                            },
                                            {
                                                "example_id": "8f3b2819-4f43-43e4-9fbb-052a5ded0fd1",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„[…] eine luxemburgische Frachtmaschine [hat] am letzten Juliwochenende 92 Tonnen Kerosin in die Atmosphäre entlassen […]“"
                                            },
                                            {
                                                "example_id": "2b126615-4dbd-4962-b53c-d90c7a632bce",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„Eine Steuer auf Kerosin wird immer wieder diskutiert.“"
                                            },
                                            {
                                                "example_id": "fa25d7cd-fa49-4257-91a4-c0427f365ef6",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„[…] kurz vor dem Start einer mit 138 Passagieren besetzten Chartermaschine vom Flughafen Eindhoven lief Kerosin aus einem Tank aus.“"
                                            },
                                            {
                                                "example_id": "50908fe0-5a6c-4fca-9ff9-d62a9d122653",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„Deutschlands größte Fluggesellschaft muss 2017 mit härteren Bedingungen zurechtkommen. Auf den Konzern kommen deutlich höhere Ausgaben für Kerosin zu.“"
                                            },
                                            {
                                                "example_id": "a93cb479-f134-4930-8c1d-8b6bd0931ad6",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„Kerosin besteht zu 86 Prozent aus Kohlenstoff und zu 14 Prozent aus Wasserstoff.“"
                                            },
                                            {
                                                "example_id": "37a9f18f-c69d-43e1-955a-68de95f69f26",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„Der kanadische Arzt und Geologe Abraham Gesner entdeckte ein Verfahren, mit dem man aus Kohle Petroleum (auch Kerosin oder Steinöl genannt) gewinnen konnte, einen relativ sauber brennenden, preisgünstigen Lampenbrennstoff.“"
                                            },
                                            {
                                                "example_id": "4c5d9b34-0077-4a45-9f17-205b9679144f",
                                                "sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                                                "text": "„Bis zur Aufklärung bleibt das verunreinigte Kerosin zur Beweissicherung im Tank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
