        "zh-extract.jsonl": [
            {
                "entry_id": "0bc3a4c5-9c66-3c06-82f4-09853ecd3682",
                "word": "supposedly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5bca082-ab34-3cc2-9cf8-4fff37bc6a0a",
                        "entry_id": "0bc3a4c5-9c66-3c06-82f4-09853ecd3682",
                        "glosses": [
                            "根據某些人的信念或主張；應該；據說；可能；按照推測"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c090453a-6f28-40ca-bf07-94c1c5f52381",
                                "sense_id": "f5bca082-ab34-3cc2-9cf8-4fff37bc6a0a",
                                "text": "People from other planets have supposedly visited Earth in flying saucers.",
                                "translation": "据称，外星人类曾乘坐飞碟访问过地球。"
                            },
                            {
                                "example_id": "1ae00b51-69b1-491f-bef0-e02cfbec3bbd",
                                "sense_id": "f5bca082-ab34-3cc2-9cf8-4fff37bc6a0a",
                                "text": "According to your testimony, you were supposedly at home watching TV when the murder occurred.",
                                "translation": "根据您的证词，谋杀案发生时您正待在家里看电视。"
                            },
                            {
                                "example_id": "9423d622-c95e-450e-8f25-7b04f7b9a563",
                                "sense_id": "f5bca082-ab34-3cc2-9cf8-4fff37bc6a0a",
                                "text": "France were supposedly a team in pieces, beaten by Tonga just a week ago and with coach Marc Lievremont publicly berating his players, but so clear-cut was their victory that much of the atmosphere had been sucked from the contest long before the end.",
                                "translation": "法国队一周前被汤加队击败，主教练马克·里夫雷蒙公开斥责队员，按理说这应该是支有点支离破碎的队伍，但这回他们的胜利太明显了，比赛还没结束，气氛就已经消失了。"
                            },
                            {
                                "example_id": "b43885c7-6123-4518-ac00-66f6f7e91d89",
                                "sense_id": "f5bca082-ab34-3cc2-9cf8-4fff37bc6a0a",
                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                            }
                        ]
                    },
                    {
                        "sense_id": "6645c6c0-f4c1-3f65-b45c-ac5f8c414ca4",
                        "entry_id": "0bc3a4c5-9c66-3c06-82f4-09853ecd3682",
                        "glosses": [
                            "用於代替“supposed to be”，一般是用於非正式或口語場合，常是口誤"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "a54d1145-24e3-447d-9869-8a36132c3425",
                                "sense_id": "6645c6c0-f4c1-3f65-b45c-ac5f8c414ca4",
                                "text": "My parents told me I am supposedly in bed by 10 P.M.",
                                "translation": "我父母告诉我晚上10点就该睡觉了"
                            }
                        ]
                    }
                ],
