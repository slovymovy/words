                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печенье с патокой",
                                "target_lang_sense_clarification": "описательный перевод, так как прямого аналога нет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2663be33-5d04-3fa1-9a85-631c7519be96",
                    "sense_definition": "To be significantly more attractive than someone or something; to dominate in appearance",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His face <w>mogs</w> mine to hell and back.",
                            "target_lang_translations": {
                                "ru": "Его лицо <w>затмевает</w> мое в пух и прах."
                            }
                        },
                        {
                            "text": "It is funny when people misgender me because I <w>mog</w> most cis women.",
                            "target_lang_translations": {
                                "ru": "Забавно, когда люди ошибаются с моим гендером, потому что я <w>выгляжу лучше</w> большинства цисгендерных женщин."
                            }
                        }
                    ],
                    "synonyms": [
                        "outshine",
                        "overshadow"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in online subcultures."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть значительно привлекательнее кого-либо; доминировать внешностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затмевать",
                                "target_lang_sense_clarification": "выглядеть намного лучше других"
                            },
                            {
                                "target_lang_word": "переигрывать внешностью",
                                "target_lang_sense_clarification": "сленговое выражение, подчеркивающее превосходство во внешности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb7955fa-94f0-35fb-91fe-0fd17028eca1",
                    "sense_definition": "To be superior to something; to beat or outclass",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "superiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That movie <w>mogs</w> any other film in the series.",
                            "target_lang_translations": {
                                "ru": "Этот фильм <w>превосходит</w> любой другой фильм в серии."
                            }
                        },
                        {
                            "text": "The new infrastructure <w>mogs</w> the old system in every way.",
                            "target_lang_translations": {
                                "ru": "Новая инфраструктура <w>уделывает</w> старую систему во всех отношениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "outclass",
                        "surpass"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in online subcultures."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть лучше чего-либо; превосходить или побеждать в сравнении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "быть лучше по качеству или характеристикам"
                            },
                            {
                                "target_lang_word": "уделывать",
                                "target_lang_sense_clarification": "сленговое, означающее полное превосходство над кем-то или чем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e71393de-8f24-39a6-abaf-2d623f71da00",
                    "sense_definition": "To move or walk slowly; to trudge or amble",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>mogged</w> away to the wagons after the long day.",
                            "target_lang_translations": {
                                "ru": "Они <w>поплелись</w> к фургонам после долгого дня."
                            }
                        },
                        {
                            "text": "I <w>mogged</w> back and forth between the boat and the office.",
                            "target_lang_translations": {
                                "ru": "Я <w>брел</w> туда-сюда между лодкой и офисом."
                            }
                        }
                    ],
                    "synonyms": [
                        "trudge",
                        "amble",
                        "wander"
                    ],
                    "common_phrases": [
                        "mog about",
                        "mog off"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно передвигаться или идти; плестись."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "идти медленно, с трудом"
                            },
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "идти не спеша, без определенной цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe3b4a0c-6c02-37ee-a577-42e5bbb8ae48",
                    "sense_definition": "To remove a public servant from their position following a government reorganization",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "government",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many workers were <w>mogged</w> after the government abolished several departments.",
                            "target_lang_translations": {
                                "ru": "Многие работники были <w>сокращены</w> после того, как правительство упразднило несколько департаментов."
                            }
                        },
                        {
                            "text": "The team was <w>mogged</w> out from the department during the restructuring.",
                            "target_lang_translations": {
                                "ru": "Команда была <w>уволена</w> из департамента во время реструктуризации."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Australian political contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увольнять государственного служащего с должности в результате реорганизации правительства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увольнять",
                                "target_lang_sense_clarification": "общее понятие снятия с должности"
                            },
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "увольнение в связи с реорганизацией или упразднением отдела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
