                "senses": [
                    {
                        "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                        "entry_id": "ecb0ae4c-e6e4-3b1a-9f14-60fcb799bc55",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072aae2f-b970-453d-a0c9-16981477f86d",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Frau Treibel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b53a9092-b86b-4f77-a265-5a909693e0fb",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Herr Treibel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4c518493-0fa2-4ab5-97fd-0f01ec238863",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Die Treibels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8d403154-51ef-4338-bc28-c84dc6b37378",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Der Treibel trägt nie die Schals, die die Treibel ihm strickt."
                            },
                            {
                                "example_id": "c8b5a683-a9a6-4d54-92da-f2031c67354b",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Treibel kommt, geht der Herr Treibel.“"
                            },
                            {
                                "example_id": "5c2bd616-9cf3-49eb-90e3-ae713a2d13a9",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Treibel kommt und geht."
                            },
                            {
                                "example_id": "7cfbb188-8951-41ac-bb5c-39fe3279e2aa",
                                "sense_id": "596ce184-d537-329e-870c-9792a72f15ab",
                                "text": "Treibels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
