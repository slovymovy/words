                            "colloquial",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "6646a28b-40ed-4b74-8b7c-93999d648fe6",
                                "sense_id": "2ad1d049-5334-3a89-8122-cc138bc09324",
                                "text": "The food that I ate today was very yucky."
                            },
                            {
                                "example_id": "c6364505-c498-4c02-9aa8-d6c45c804586",
                                "sense_id": "2ad1d049-5334-3a89-8122-cc138bc09324",
                                "text": "\"Don't rule out desalination because it is expensive, or recycling because it sounds yucky, or building a dam,\" Mr Turnbull told Australian media.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b6ce3c1-7f6a-4e08-9e1f-e135092ed543",
                        "source_entry_id": "f314f240-8c78-3e41-876b-3453212fbac4",
                        "source_sense_id": "2ad1d049-5334-3a89-8122-cc138bc09324",
