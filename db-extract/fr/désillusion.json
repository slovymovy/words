                                                "sense_id": "cebde3a4-cc1d-305e-9d49-3782c355113d",
                                                "text": "malgrado la disillusione continuò ad essere ostinata"
                                            },
                                            {
                                                "example_id": "aff78ea2-cc9f-4137-aba7-d1abaa09525c",
                                                "sense_id": "cebde3a4-cc1d-305e-9d49-3782c355113d",
