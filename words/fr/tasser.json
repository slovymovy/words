    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2f35c52-1783-32a7-acf3-76a3cdace6f5",
                    "sense_definition": "Presser des matières ou des objets pour en réduire le volume ou les rendre plus compacts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "compression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>tasser</w> la terre autour des racines du jeune arbre."
                        },
                        {
                            "text": "Le jardinier <w>tasse</w> les feuilles mortes dans le sac pour gagner de la place."
                        }
                    ],
                    "synonyms": [
                        "compresser",
                        "comprimer"
                    ],
                    "antonyms": [
                        "détasser"
                    ],
                    "common_phrases": [
                        "tasser la terre",
                        "tasser du foin"
                    ]
                },
                {
                    "sense_id": "a792bfd5-5421-3d18-a9ae-e2546c4f5a63",
                    "sense_definition": "S'affaisser ou devenir plus dense et compact sous l'effet de son propre poids ou du temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sol meuble commence à se <w>tasser</w> après les fortes pluies d'automne."
                        },
                        {
                            "text": "Avec les années, les fondations de cette vieille maison se sont <w>tassées</w>."
                        }
                    ],
                    "common_phrases": [
                        "se tasser avec le temps"
                    ]
                },
                {
                    "sense_id": "9e411f25-c626-377c-8838-a27fd89c1cb0",
                    "sense_definition": "S'apaiser, trouver une issue favorable ou rentrer dans l'ordre avec le temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour cette dispute, les choses vont se <w>tasser</w> d'ici quelques jours."
                        },
                        {
                            "text": "Après la crise, la tension politique a fini par se <w>tasser</w> progressivement."
                        }
                    ],
                    "common_phrases": [
                        "laisser se tasser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "80f219d2-698d-357c-97ca-f5bae703b5dc",
                    "sense_definition": "Se déplacer sur le côté afin de laisser le passage ou de faire de la place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tasse</w>-toi un peu vers la droite pour que tout le monde puisse s'asseoir."
                        },
                        {
                            "text": "Le chauffeur nous a demandé de nous <w>tasser</w> vers le fond de l'autobus."
                        }
                    ],
                    "common_phrases": [
                        "se tasser un peu"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement utilisé au Québec"
                        }
                    ]
                }
            ]
        }
    ]
