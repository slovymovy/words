    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "452eea55-41de-378d-a0e2-1c272e288769",
                    "sense_definition": "Совершенно, полностью, без каких-либо ограничений.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты <w>абсолютно</w> прав в этом непростом вопросе.",
                            "target_lang_translations": {
                                "en": "You are <w>absolutely</w> right in this difficult matter.",
                                "cs": "Máš v této složité otázce <w>naprostou</w> pravdu.",
                                "zh": "在这个复杂的问题上，你是<w>绝对</w>正确的。"
                            }
                        },
                        {
                            "text": "Это решение было <w>абсолютно</w> неожиданным для нас.",
                            "target_lang_translations": {
                                "en": "This decision was <w>completely</w> unexpected for us.",
                                "cs": "Toto rozhodnutí pro nás bylo <w>naprosto</w> nečekané.",
                                "zh": "这个决定对我们来说是<w>完全</w>出乎意料的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "совершенно",
                        "совсем",
                        "полностью"
                    ],
                    "antonyms": [
                        "относительно",
                        "частично"
                    ],
                    "common_phrases": [
                        "абсолютно верно",
                        "абсолютно точно",
                        "абсолютно всё",
                        "абсолютно ничего"
                    ],
                    "target_lang_definitions": {
                        "en": "Completely, fully, without any limitations.",
                        "cs": "Zcela, úplně, bez jakýchkoliv omezení.",
                        "zh": "完全地、彻底地，没有任何限制。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absolutely",
                                "target_lang_sense_clarification": "used to emphasize that something is completely true"
                            },
                            {
                                "target_lang_word": "completely",
                                "target_lang_sense_clarification": "in every way or as much as possible"
                            },
                            {
                                "target_lang_word": "totally",
                                "target_lang_sense_clarification": "informal synonym for completely"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "naprosto",
                                "target_lang_sense_clarification": "používá se pro zdůraznění úplnosti nebo pravdivosti"
                            },
                            {
                                "target_lang_word": "úplně",
                                "target_lang_sense_clarification": "v plné míře, zcela"
                            },
                            {
                                "target_lang_word": "absolutně",
                                "target_lang_sense_clarification": "zdůraznění naprosté míry nebo souhlasu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝对",
                                "target_lang_sense_clarification": "用于强调某事完全正确或程度极高"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "在各个方面或程度上达到极限"
                            }
                        ]
                    }
                }
            ]
        },
        {
