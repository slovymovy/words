                        "source_entry_id": "e971e6cc-7094-3ace-8022-106db6e62c99",
                        "source_sense_id": "9c93321e-941f-352a-86bb-8486b708b41f",
                        "source_sense_description": "Biologie: im Wasser lebendes Tier mit zehn Armen",
