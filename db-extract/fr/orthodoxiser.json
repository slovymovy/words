                "senses": [
                    {
                        "sense_id": "21fe06a6-1b23-35a0-9e2a-39ca4dd3aa5a",
                        "entry_id": "9da215c3-bc4b-3ac7-95f8-3faf6923c38f",
                        "glosses": [
                            "Donner un caractère orthodoxe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c69e0dcb-c7a7-461a-8574-b29fc87acb31",
                                "sense_id": "21fe06a6-1b23-35a0-9e2a-39ca4dd3aa5a",
                                "text": "L’État cherche donc à « orthodoxiser » les alévis depuis cette période en envoyant des imams dans les mosquées fraîchement bâties."
                            },
                            {
                                "example_id": "d9b2efb7-7e05-44b4-81ed-85b1edc5f2b1",
                                "sense_id": "21fe06a6-1b23-35a0-9e2a-39ca4dd3aa5a",
                                "text": "Plus tard, pour « m'orthodoxiser », la sage en Dieu higoumène de Lesna Théodora m'envoya en Serbie."
                            },
                            {
                                "example_id": "ce0e3e02-23a6-4ede-9024-34cb866b4b39",
                                "sense_id": "21fe06a6-1b23-35a0-9e2a-39ca4dd3aa5a",
                                "text": "Ghazali va apporter sa caution de grand savant pour orthodoxiser le soufisme."
                            }
                        ]
                    }
