                "translations": [
                    {
                        "translation_id": "796b40c1-aa50-47b8-87b2-a7fa17f2d235",
                        "source_entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                        "source_sense_description": "pertaining to the doctrines or teachings of the Christian gospel or Christianity in general",
                        "target_lang_word": "evangelisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evangelisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75dc7148-940d-3471-9d3a-22caa34478e5",
                                        "entry_id": "6b63621f-d717-3eb3-84b2-42d054ae964a",
                                        "glosses": [
                                            "in overeenstemming met het Evangelie en minder gericht op kerkelijke dogma's en tradities"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11332887-71f2-4698-8164-ed202355d136",
                                                "sense_id": "75dc7148-940d-3471-9d3a-22caa34478e5",
                                                "text": "Zo’n 30 procent van de Duitsers is evangelisch-luthers en ongeveer even grote delen zijn katholiek en niet-gelovig. De laatste groep groeit al decennia gestaag, het aantal gelovige christenen daalt in het hele land. Zo’n 5 procent van de Duitse bevolking is moslim."
                                            },
                                            {
                                                "example_id": "e5a426e0-48b3-4644-bc55-58d82dc77670",
                                                "sense_id": "75dc7148-940d-3471-9d3a-22caa34478e5",
                                                "text": "'Het stadshuis van Rödelberg en de beide kerken. De afgebeelde bronzen zwaan op de fontein is in juli 2012 gestolen.' Je ziet nog eens wat als je de herkomst van wijn googelt. Twee kerken zijn er, evangelisch en katholiek, allebei gewijd aan sint Bartolomeus, meldt Wikipedia. En laat ik nou denken dat de evangelischen niet aan heiligenverering doen. Soit. In Rödelberg wordt wijn gemaakt, misschien word je daar heel devoot door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d725b47c-4530-477e-9256-f153f8a4b602",
                        "source_entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                        "source_sense_description": "pertaining to the doctrines or teachings of the Christian gospel or Christianity in general",
                        "target_lang_word": "évangélique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évangélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                        "entry_id": "3e169a8a-56c5-3823-8792-9c9581e3874a",
                                        "glosses": [
                                            "Qui est de l’évangile ; qui est selon l’évangile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c174ec-c3eb-41c0-a4fe-b71f4aac530c",
                                                "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                                "text": "À bon entendeur, salut ! n’est pas seulement un précepte évangélique, c’est encore une excellente spéculation ; observez-le, on vous passera tout, jusqu’à des vices."
                                            },
                                            {
                                                "example_id": "161243d2-6dd1-49f3-8684-b87b18dbb9c1",
                                                "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                                "text": "Je leur souhaite, comme vœu du Jour de l’An, de mener à bien leur entreprise et de ramener sur la terre l’âge évangélique."
                                            },
                                            {
                                                "example_id": "1fa95a06-4c72-4804-be1a-aac41b891ce7",
                                                "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                                "text": "Cette bienveillance, qui peut même parfois être vue telle une braise ardente venue du fond de ton être, est la mise en oeuvre de ce grand principe évangélique et si radicalement humain : « Aime ton prochain comme toi-même. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65085a24-d12e-3fcc-87e9-86571231d80c",
                                        "entry_id": "3e169a8a-56c5-3823-8792-9c9581e3874a",
                                        "glosses": [
                                            "Qui est adepte de l'évangélisme, branche du protestantisme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1853a7f-bb4d-4b47-bcca-05826623d184",
                                                "sense_id": "65085a24-d12e-3fcc-87e9-86571231d80c",
                                                "text": "Les protestants évangéliques revendiquent le droit de dire leur foi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1894d97b-3931-3df5-af5f-606bac4bbf0a",
                                        "entry_id": "3e169a8a-56c5-3823-8792-9c9581e3874a",
                                        "glosses": [
                                            "Qui est adepte du protestantisme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf23559-b035-4ba2-8b7c-9dbd27a9627f",
                                                "sense_id": "1894d97b-3931-3df5-af5f-606bac4bbf0a",
                                                "text": "Qu'un catholique romain qui n'a jamais vu que le clocher de son village, qui n'a lu que son catéchisme et son livre d’heures, reproche aux chrétiens évangéliques leur défaut d'unité, à la bonne heure ! […]."
                                            },
                                            {
                                                "example_id": "8429539f-2720-426c-b37a-ebc0f5ab419d",
                                                "sense_id": "1894d97b-3931-3df5-af5f-606bac4bbf0a",
                                                "text": "Vous savez que j'appartiens à la communion évangélique, de même que ma fiancée ; or, notre ministre, qui demeure à une trentaine de lieues, est perclus de la goutte, et j'ai osé espérer que vous voudriez bien officier à sa place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "évangélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fec94b1-1b05-3255-bb04-adad95988c35",
                                        "entry_id": "c3c160c6-34a4-338d-a708-331695815801",
                                        "glosses": [
                                            "Membre d'une église évangélique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34dc58b-83a8-4f21-90c7-1ec60d21d944",
                                                "sense_id": "3fec94b1-1b05-3255-bb04-adad95988c35",
                                                "text": "Les évangéliques et les catholiques, tout en étant différents, se retrouvent sur de nombreux points, comme les questions d'éthique. La principale différence est l'autorité de la Bible, les évangéliques ont un rapport très personnel aux écritures, ils s'y réfèrent, ils la lisent régulièrement, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595e2d5e-8143-3c85-931f-01b3bbe4e7ff",
                                        "entry_id": "c3c160c6-34a4-338d-a708-331695815801",
                                        "glosses": [
                                            "Membre d'une Église protestante."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
