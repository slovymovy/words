                "senses": [
                    {
                        "sense_id": "b23bd73a-7531-3085-ad94-55316c94f0fc",
                        "entry_id": "44d57de3-1bd5-3929-8e45-e72f0cf0ec06",
                        "glosses": [
                            "Rundfunksender, der ohne die nötige Lizenz sendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0182609-ef04-46cd-a3b1-13bdef8a43dc",
                                "sense_id": "b23bd73a-7531-3085-ad94-55316c94f0fc",
                                "text": "„Ein Piratensender in Hilkerode warnt vor Strahlenwaffen, die vom Harz aus die Region ins Visier nehmen.“"
                            },
                            {
                                "example_id": "149dea79-47cf-44a4-bd4e-1ef4c1e0713e",
                                "sense_id": "b23bd73a-7531-3085-ad94-55316c94f0fc",
                                "text": "„Die quasi erste offizielle Rundfunksendung Österreichs findet am 2. September 1923 anlässlich der Eröffnung der Wiener Herbstmesse mit einer Ansprache des Bundespräsidenten statt - übertragen eigentlich vom ersten Piratensender Österreichs Radio Hekaphon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
