                        "glosses": [
                            "to become mossy, to become covered or overgrown with moss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a526023e-4d7f-4070-8b98-adabff370697",
                                "sense_id": "3ec10f04-702e-3c28-9cba-fb970a1244d8",
                                "text": "Се́рые брёвна частоко́ла по́низу обмета́ла зелёная гниль, а валу́нные на́сыпи замше́ли.",
                                "translation": "The feet of the palisade's grey logs were dusted green with rot, and the mounds of boulders were overgrown with moss.",
                                "english": "The feet of the palisade's grey logs were dusted green with rot, and the mounds of boulders were overgrown with moss."
                            }
                        ]
                    }
