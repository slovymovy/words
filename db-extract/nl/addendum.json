                        "glosses": [
                            "op zichzelf staande toevoeging aan een boek of ander document"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff99900-d6bd-47cf-ab36-f3e2afd39956",
                                "sense_id": "d06545cb-02cf-3f2b-8465-288a17305b14",
                                "text": "Sommigen, onder wie partijleider Sybrand van Haersma Buma, vinden dat naar de stem van de kiezer moet worden geluisterd. Anderen, onder wie een aantal senatoren, vinden dat een pro-Europese partij als het CDA het verdrag gewoon moet ratificeren. Of in elk geval premier Mark Rutte moet steunen bij diens poging een juridisch bindend addendum aan het verdrag toe te voegen."
                            }
                        ]
                    }
                ],
