                                        "entry_id": "b6089e1d-859c-3e17-81b8-09d0d2839406",
                                        "glosses": [
                                            "Involving, or controlled by multiple factors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71d3aa59-79b0-4663-af3f-78d182dba389",
                                                "sense_id": "0239a643-d7f9-375b-ad24-73421cb6adb2",
                                                "text": "[…] a pattern in medical research on infectious and degenerative diseases in the United States. That pattern shows three main built-in biases: 1) towards a single-agent theory of disease, as opposed to a multi-factorial analysis; 2) […]"
                                            },
                                            {
                                                "example_id": "bc75ce12-78f9-4edb-890d-9f3c26e85a90",
                                                "sense_id": "0239a643-d7f9-375b-ad24-73421cb6adb2",
                                                "text": "One of the under-reported dynamics during the coronavirus pandemic has been the collapse of One Nation’s vote. The reasons for this are likely multi-factorial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8e05a4-f1b8-3e02-8334-63e88a2d89be",
                                        "entry_id": "b6089e1d-859c-3e17-81b8-09d0d2839406",
                                        "glosses": [
                                            "Involving multiple genetic or environmental factors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
