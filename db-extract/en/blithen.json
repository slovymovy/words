                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "63adeeec-be3a-4300-ad2e-fb78282cc48b",
                                "sense_id": "143d4399-385d-37b9-b4f5-3d60cdb157df",
                                "text": "When we entered the parlour, which had been so often blithened with the jocose spirit of its defunct mistress, we confess that our emotions were almost too great for our fortitude, […]"
                            },
                            {
                                "example_id": "7d0f9b1b-6cec-43c2-938d-7f95943da4e3",
                                "sense_id": "143d4399-385d-37b9-b4f5-3d60cdb157df",
                                "text": "Let every life be content with its share\nOf dew, and sunshine, and blithening air."
                            }
                        ]
                    },
