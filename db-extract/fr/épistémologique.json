        "fr-extract.jsonl": [
            {
                "entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                "word": "épistémologique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18880b5a-a6fd-49aa-af01-7c3b5871a3a4",
                        "entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "épistémologiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7604dff-4267-3b57-bdc8-fcc12720e3b1",
                        "entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                        "glosses": [
                            "Relatif à l’épistémologie en tant qu’histoire des méthodes et des principes des sciences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018e4a87-5742-44e5-9a13-4f7d96a0272e",
                                "sense_id": "d7604dff-4267-3b57-bdc8-fcc12720e3b1",
                                "text": "La science politique est l'une des sciences humaines. A ce titre elle ne saurait échapper aux embarras d'ordre épistémologique, méthodologique, zététique et autres, propres à ces disciplines, ni à leur destin."
                            },
                            {
                                "example_id": "906c25be-22ef-4c95-96f4-901214f6944e",
                                "sense_id": "d7604dff-4267-3b57-bdc8-fcc12720e3b1",
                                "text": "La débat entre les tenants de conceptions épistémologiques différentes est souvent stérile, les positions étant campées et n'évoluant que lentement, en fonction de nombreux facteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "62871d18-d5de-3fe7-9a6a-cc5c3db71c6e",
                        "entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                        "glosses": [
                            "Épistémique, relatif à la connaissance d’une chose, d’un concept."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66637e68-5681-428d-8d39-1ad60c63089f",
                                "sense_id": "62871d18-d5de-3fe7-9a6a-cc5c3db71c6e",
                                "text": "La philosophie de l'espace et du temps est une branche de la philosophie qui traite des problèmes liés aux caractères épistémologiques et ontologiques de l'espace et du temps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec77432-1a28-4595-8507-4f26e89bf797",
                        "source_entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                        "target_lang_word": "epistemologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epistemologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1985ad7e-839b-3384-a8ec-d5451d306727",
                                        "entry_id": "223663e6-6040-383d-9b71-d70a7cd286be",
                                        "glosses": [
                                            "die Erkenntnistheorie (Epistemologie) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5452da15-0c7a-4329-bac5-ae7c673eddd9",
                                                "sense_id": "1985ad7e-839b-3384-a8ec-d5451d306727",
                                                "text": "Die (oder jedenfalls einige) Radikale Konstruktivisten umgehen den Solipsismus dadurch, dass sie sagen, sie würden lediglich einen epistemologischen Solipsismus vertreten."
                                            },
                                            {
                                                "example_id": "ac30f086-4560-4f0b-a636-dae52af3b420",
                                                "sense_id": "1985ad7e-839b-3384-a8ec-d5451d306727",
                                                "text": "„Einige charakteristische epistemologische Dualismen dieser Tradition sind Subjekt/Objekt, Denken/Wirklichkeit, Vernunft/Erfahrung, Intellekt/Sinne, ideal/real, Bewußtsein/Sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "981cc496-ae6a-42c3-b03b-107d4c919f64",
                        "source_entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                        "target_lang_word": "erkenntnistheoretisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "963c5979-102b-4631-8e09-b63f6f78f431",
                        "source_entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                        "target_lang_word": "epistemological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epistemological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                        "entry_id": "36e5e18d-b021-3b12-9302-5930ad6ca707",
                                        "glosses": [
                                            "Of or pertaining to epistemology or theory of knowledge, as a field of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2fcb25-67d8-4d8a-a093-861a8b6c6111",
                                                "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                                "text": "The epistemological position of Ritschl, in our author's exposition of it, is little more than idealistic rationalism."
                                            },
                                            {
                                                "example_id": "7376f38a-e584-4e76-9671-d2637e72f22f",
                                                "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                                "text": "In the period from Spinoza to the end of the 19th century, the reading of design into nature received such devastating attacks from naturalists to non-naturalists alike that there developed an epistemological neurosis which Von Baer aptly termed “teleophobia.”"
                                            },
                                            {
                                                "example_id": "d70f9195-ba7a-426f-9392-1099b111a427",
                                                "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                                "text": "My conclusion dovetails with Fasold's conclusion, which is based on a quite different, more epistemological kind of argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684bfcd2-bea0-3e7a-ab40-743fe1d9c06d",
                                        "entry_id": "36e5e18d-b021-3b12-9302-5930ad6ca707",
                                        "glosses": [
                                            "Synonym of epistemic (“of or relating to cognition or knowledge, its scope, or how it is acquired”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07252c01-17f2-4f7e-b2a8-23371c545c74",
                                                "sense_id": "684bfcd2-bea0-3e7a-ab40-743fe1d9c06d",
                                                "text": "The reality which thus emerges is the outcome of the epistemological process in which the mind conceptually structures a given content."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1adfe7f6-3113-4504-a744-f65cc2069fae",
                        "source_entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
