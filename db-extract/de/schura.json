                "senses": [
                    {
                        "sense_id": "16f71a12-26a6-3c67-8529-56c77f53c967",
                        "entry_id": "fb22fa51-7b66-34e2-8f1f-711c1a850806",
                        "glosses": [
                            "islamisches Prinzip der Beratung; einzelne Zusammenkunft, bei der beraten wird"
                        ],
                        "tags": [
                            "Islam",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "9d6d75cc-405f-4955-a95d-eec43f5fa6e1",
                                "sense_id": "16f71a12-26a6-3c67-8529-56c77f53c967",
                                "text": "Schura wird im Koran als Mitte der Entscheidungsfindung empfohlen."
                            },
                            {
                                "example_id": "187f9733-d306-4007-9469-37a4491b9dce",
                                "sense_id": "16f71a12-26a6-3c67-8529-56c77f53c967",
                                "text": "„Mehrere islamische Nationalstaaten sehen im Prinzip der Schura, der Konsultation, eine islamische Variante der Demokratie.“"
                            },
                            {
                                "example_id": "8b71a17a-5e7e-484d-8bd5-b1787351b1e3",
                                "sense_id": "16f71a12-26a6-3c67-8529-56c77f53c967",
                                "text": "„Nach diesen Ausführungen ist festzustellen, dass al-Turabi Scharia und Schura in allen Lebensbereichen der Muslime anhand des Prinzips der „Einheit Gottes“ anwenden will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "447dab1c-3479-391a-8144-7dc48340dd70",
                        "entry_id": "fb22fa51-7b66-34e2-8f1f-711c1a850806",
                        "glosses": [
                            "islamisches Organ der Führung"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "d08d242e-231b-42c3-9678-af1b591e35a3",
                                "sense_id": "447dab1c-3479-391a-8144-7dc48340dd70",
                                "text": "„Höchste Entscheidungsinstanz der Taliban ist die Oberste Schura, mit Basis in Kandahar, der Stadt, die Mullah Omar nur einmal (1996 zu einem Besuch in Kabul) verlassen hat und die er zum neuen Machtzentrum Afghanistans machte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1be7c149-dd26-3b49-ac20-efc47328847e",
                        "entry_id": "fb22fa51-7b66-34e2-8f1f-711c1a850806",
                        "glosses": [
                            "in Deutschland tätige regionale Vertretung der Muslime"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "e3c93e46-dff8-4bdb-982c-46a2b065e250",
                                "sense_id": "1be7c149-dd26-3b49-ac20-efc47328847e",
                                "text": "„Auch wenn nicht alle Wünsche der Schura berücksichtigt wurden, sei die Schura mit den Lehrinhalten grundsätzlich zufrieden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
