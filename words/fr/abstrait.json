        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47338a21-c824-323e-82ec-ae7a60dfc43a",
                    "sense_definition": "Qui relève de la pensée pure, sans référence directe à la réalité matérielle ou sensible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "theorique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps et l'infini sont des concepts <w>abstraits</w> difficiles à imaginer."
                        },
                        {
                            "text": "Cette formule mathématique paraît très <w>abstraite</w> pour les nouveaux élèves."
                        }
                    ],
                    "antonyms": [
                        "concret"
                    ],
                    "common_phrases": [
                        "concept abstrait",
                        "idée abstraite"
                    ]
                },
                {
                    "sense_id": "1723c862-ce2f-3fb6-afbb-98a8c9d450da",
                    "sense_definition": "Qui ne cherche pas à reproduire le monde visible ou figuratif, en parlant d'une œuvre artistique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée expose principalement de l'art <w>abstrait</w> du vingtième siècle."
                        },
                        {
                            "text": "Elle a accroché une grande toile <w>abstraite</w> aux couleurs vives dans son salon."
                        }
                    ],
                    "common_phrases": [
                        "art abstrait",
                        "peinture abstraite"
                    ]
                },
                {
                    "sense_id": "0dfa79b5-757a-3b92-b1da-f33bf355b891",
                    "sense_definition": "Qui manque de clarté ou de lien avec la pratique, difficile à saisir ou trop théorique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theorique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier a tenu un discours <w>abstrait</w> qui a rapidement perdu le public."
                        },
                        {
                            "text": "Ses explications restent beaucoup trop <w>abstraites</w> pour résoudre notre problème pratique."
