                "senses": [
                    {
                        "sense_id": "5f288d34-ac06-383e-a66e-2d7f72f69bb8",
                        "entry_id": "d00f9556-48e4-3609-a80c-742449379585",
                        "glosses": [
                            "Gruppe von (Reit-)Sportlern im gemeinsamen Wettstreit"
                        ],
                        "tags": [
                            "vor allem Reitsport"
                        ],
                        "examples": [
                            {
                                "example_id": "1d115fda-a1d6-4bb6-bdb6-4a8f2d1af350",
                                "sense_id": "5f288d34-ac06-383e-a66e-2d7f72f69bb8",
                                "text": "„Die stärkste Leistung der deutsche Equipe bringt diesmal nicht der erfahrene Anführer Marcus Ehning mit Pret a Tout, sondern ein WM-Neuling: Simone Blum glänzt mit ihrer Stute Alice.“"
                            },
                            {
                                "example_id": "c0c844cd-0b69-47fc-ac34-17572fec1cad",
                                "sense_id": "5f288d34-ac06-383e-a66e-2d7f72f69bb8",
                                "text": "„Im Halbfinale setze sich die deutsche Equipe dann mit 45:41 sogar gegen die an Position 1 gesetzten Koreaner durch und zog ins Finale gegen Russland ein.“"
                            },
                            {
                                "example_id": "d81e834b-7bb2-4577-8a1f-674d196e8eb7",
                                "sense_id": "5f288d34-ac06-383e-a66e-2d7f72f69bb8",
                                "text": "„Sie kam zu einer guten Zeit und brachte ihr Bestes ein – und so gewannen deutsche Equipen unter ihrer Führung bei vier von fünf Championaten die Goldmedaille, auch bei Olympia in Rio 2016 und zuletzt bei den Europameisterschaften 2017 in Göteborg.“"
                            },
                            {
                                "example_id": "4af4b107-bfb6-4a54-9e33-8435a3affaa2",
                                "sense_id": "5f288d34-ac06-383e-a66e-2d7f72f69bb8",
                                "text": "„29 Equipes haben sich um einen der 22 Startplätze beworben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
