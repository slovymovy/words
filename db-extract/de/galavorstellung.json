                ],
                "senses": [
                    {
                        "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                        "entry_id": "dfde3f82-3951-3979-bc71-894777101abc",
                        "glosses": [
                            "besonders festliche Opern-, Theater- oder Filmaufführung, häufig unter Einladung von bekannten oder berühmten Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2375133-ae58-4e09-8ab8-f59ed7002910",
                                "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                                "text": "Überzeugt von dem großen Erfolg des Werkes [der Oper „Madame Butterfly“] planten Puccini und sein Verleger Giulio Ricordi die Premiere als Galavorstellung am 17. Februar des folgenden Jahres [1904] an der Mailänder Scala stattfinden zu lassen."
                            },
                            {
                                "example_id": "1266fb5a-a905-477e-9a77-de2de089aa1c",
                                "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                                "text": "Der Wiedereinzug [ins Gärtnerplatztheater in München nach fünf Jahren Renovierung] wird gebührend gefeiert, und wie ginge das passender als mit einer großen Galavorstellung?"
                            },
                            {
                                "example_id": "8d2ff01d-d086-485b-85c6-19679dc25e4e",
                                "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                                "text": "Zur Galavorstellung von Dvořaks tragischer Märchenoper Rusalka am 14. März 1939 hatte der tschechoslowakische Staatspräsident Emil Hacha sein Erscheinen im Prager Nationaltheater angekündigt."
                            },
                            {
                                "example_id": "319cbd16-edf0-4946-88a4-c31972101712",
                                "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                                "text": "Hugo Chavez, umstrittener Präsident von Venezuela […] ließ es sich nicht nehmen, der Galavorstellung von Oliver Stones Dokumentarfilm „South of the border“ beizuwohnen."
                            },
                            {
                                "example_id": "cbebe7c8-0c48-41b8-968f-53c4be1cd444",
                                "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                                "text": "Eine wie sonst übliche Galavorstellung zur Eröffnung des Musikzentrums unter Ausschluss der Öffentlichkeit schien angesichts des egalitären Konzepts unangebracht."
                            },
                            {
                                "example_id": "722eb425-adc0-4ad4-a24a-17d95f33d391",
                                "sense_id": "fd220231-6da4-318f-80dd-2c48eed5be9c",
                                "text": "Für die Dekoration einer Galavorstellung in Covent Garden aus Anlaß des Staatsbesuchs von Präsident Charles de Gaulle im Jahr 1960 verwendet er [Cecil Beaton] 25 000 rosa Nelken und 600 Meter Seide."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbc4c147-a3e1-3718-afcb-a96c3114553d",
                        "entry_id": "dfde3f82-3951-3979-bc71-894777101abc",
                        "glosses": [
                            "herausragende Leistung; besonders gelungenes Spiel"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d695d055-e7f0-4530-a4d4-cbc769eac1ba",
                                "sense_id": "fbc4c147-a3e1-3718-afcb-a96c3114553d",
                                "text": "Mit einer regelrechten Galavorstellung spielt sich Tennisprofi Grigor Dimitrov in die Vorschlussrunde der ATP-Finals in London."
                            },
                            {
                                "example_id": "2bb46edc-6639-40dd-9009-5851bd060045",
                                "sense_id": "fbc4c147-a3e1-3718-afcb-a96c3114553d",
                                "text": "Mit einer Galavorstellung gegen Mönchengladbach erobert der BVB die Tabellenspitze von Hoffenheim zurück."
                            },
                            {
                                "example_id": "0cc0a04b-6d6e-4f27-8505-6b123bbe9e2d",
                                "sense_id": "fbc4c147-a3e1-3718-afcb-a96c3114553d",
                                "text": "Nach der Galavorstellung gegen die sehr starke \"Equipe Tricolore\" schien ein Erfolg im Viertelfinale gegen Japan mehr oder minder nur Formsache zu sein."
                            },
                            {
                                "example_id": "150b429f-1a53-44ce-a8e3-97c31c717487",
                                "sense_id": "fbc4c147-a3e1-3718-afcb-a96c3114553d",
                                "text": "Der 2:0-Erfolg der Münchner bei AEK Athen war nach turbulenten Tagen der nächste Erfolg in Richtung Normalität. […] Allerdings war es nicht gerade eine Galavorstellung des Rekordmeisters."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
