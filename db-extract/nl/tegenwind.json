                    {
                        "sense_id": "df95dfe2-b354-3b61-a249-fd5a0ac4c2bd",
                        "entry_id": "b130d63f-f6cf-3b35-ad5d-7ad55426f0ce",
                        "glosses": [
                            "wind tegen, een wind die van voren komt en je dus remt bij het vooruitgaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842d5e23-c786-4b15-8a50-5c0e386dbfcd",
                                "sense_id": "df95dfe2-b354-3b61-a249-fd5a0ac4c2bd",
                                "text": "Ik had nog wel uren zo door kunnen lopen maar langzaam stak er een sterke tegenwind op die stof in mijn ogen blies."
                            }
                        ]
                    },
                    {
                        "sense_id": "0691946d-c8b1-355b-82b7-a4c7d211aace",
                        "entry_id": "b130d63f-f6cf-3b35-ad5d-7ad55426f0ce",
                        "glosses": [
                            "iets dat een proces remt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "398b984a-d611-45d7-a23a-197eede7742d",
                        "source_entry_id": "b130d63f-f6cf-3b35-ad5d-7ad55426f0ce",
                        "source_sense_id": "df95dfe2-b354-3b61-a249-fd5a0ac4c2bd",
                        "source_sense_description": "wind tegen",
                        "target_lang_word": "Gegenwind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenwind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dab6373a-344d-3896-a282-7896b918c9df",
                                        "entry_id": "eacc11b9-6005-39d4-bb66-28f9f406d49a",
                                        "glosses": [
                                            "Wind von vorne, Wind aus der Richtung, in die eine Bewegung erfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a3ddae-4e9d-405a-ada6-8a24f702e4c5",
                                                "sense_id": "dab6373a-344d-3896-a282-7896b918c9df",
                                                "text": "„Der Gegenwind war so stark, daß man auf den Schneeschuhen zurückgeworfen wurde; man mußte sie abschnallen, um nur vorwärtszukommen.“"
                                            },
                                            {
                                                "example_id": "34480260-828d-4a89-8659-714bf18266b8",
                                                "sense_id": "dab6373a-344d-3896-a282-7896b918c9df",
                                                "text": "„Nach mehr als zwei Wochen Fahrt ist es so weit, dass er sich über Gegenwind freut.“"
                                            },
                                            {
                                                "example_id": "901da3a8-d99f-46e7-81fc-df0c8755c77d",
                                                "sense_id": "dab6373a-344d-3896-a282-7896b918c9df",
                                                "text": "„Als der Gegenwind stärker wurde und Khalil sich mit aller Kraft gegen den Flussgrund stemmte, bat ich ihn um das Paddel, das im Heck lag.“"
                                            },
                                            {
                                                "example_id": "1551fe49-7df1-4008-b030-a983d18ab596",
                                                "sense_id": "dab6373a-344d-3896-a282-7896b918c9df",
                                                "text": "„Der Platzregen und der Gegenwind waren so stark, daß sie nichts tun konnte, als mir erbittert vorzuhalten, ich bringe sie um ihre Ehre, denn der Kutscher müsse sie doch sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a40f6cb-b92c-3da2-af05-ea8dce63cd87",
                                        "entry_id": "eacc11b9-6005-39d4-bb66-28f9f406d49a",
                                        "glosses": [
                                            "Widerstand gegen eigene Pläne"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d559b211-9243-4c79-a5c8-511728e86bd6",
                                                "sense_id": "5a40f6cb-b92c-3da2-af05-ea8dce63cd87",
                                                "text": "Es gab heftigen Gegenwind für den Parteivorsitzenden aus den eigenen Reihen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "273ae6bd-5a0e-497d-8744-4b7b411edb10",
                        "source_entry_id": "b130d63f-f6cf-3b35-ad5d-7ad55426f0ce",
                        "source_sense_id": "df95dfe2-b354-3b61-a249-fd5a0ac4c2bd",
