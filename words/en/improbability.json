                            },
                            {
                                "target_lang_word": "неправдоподобность",
                                "target_lang_sense_clarification": "сомнительность или нереалистичность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce62f19-84f1-32f5-a286-9dbd6d04f283",
                    "sense_definition": "An event, idea, or circumstance that is unlikely to happen or exist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "likelihood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His explanation was filled with such <w>improbabilities</w> that the detective refused to believe him.",
                            "target_lang_translations": {
                                "ru": "Его объяснение изобиловало такими <w>нелепостями</w>, что детектив отказался ему верить."
                            }
                        },
                        {
                            "text": "The movie plot relies on a series of wild <w>improbabilities</w> to resolve the conflict.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма опирается на череду диких <w>невероятностей</w>, чтобы разрешить конфликт."
                            }
                        }
