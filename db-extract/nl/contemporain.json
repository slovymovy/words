                "translations": [
                    {
                        "translation_id": "8ba2b2a9-f380-4e0a-91f4-6c4aa4423818",
                        "source_entry_id": "ede9ef9f-e278-3050-92f8-4bc895e12006",
                        "source_sense_id": "aab149b2-3823-33a7-9b9d-735b300e5332",
                        "target_lang_word": "contemporary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemporary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dfde312-eb8f-38da-b212-1fbf0ded7068",
                                        "entry_id": "12b60c00-4747-3362-b28f-c436a7fff3f9",
                                        "glosses": [
                                            "From the same time period, coexistent in time; contemporaneous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0db661-6933-4183-8b96-76e643cc7324",
                                                "sense_id": "9dfde312-eb8f-38da-b212-1fbf0ded7068",
                                                "text": "A neighb'ring Wood born with himself he sees, / And loves his old contemporary trees."
                                            },
                                            {
                                                "example_id": "77b047cf-6b98-4473-9235-2d4dc05a7980",
                                                "sense_id": "9dfde312-eb8f-38da-b212-1fbf0ded7068",
                                                "text": "As this King [Henry VIII] vvas contemporary vvith the greateſt Monarchs of Europe, viz. the Emperor, the Kings of Spain and France, ſo he vvas engaged in many VVars, and in divers Leagues and Pacifications vvith them or either of them; for the better conſulting the Peace of Mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0fe0e13-25d0-3e1b-a8de-9512e0a50f17",
                                        "entry_id": "12b60c00-4747-3362-b28f-c436a7fff3f9",
                                        "glosses": [
                                            "Modern, of the present age (shorthand for ‘contemporary with the present’)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ee6364-8f77-4dd2-9771-8a860c95b5b6",
                                                "sense_id": "b0fe0e13-25d0-3e1b-a8de-9512e0a50f17",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            },
                                            {
                                                "example_id": "69714a9b-52a3-410a-b048-b68ba210b621",
                                                "sense_id": "b0fe0e13-25d0-3e1b-a8de-9512e0a50f17",
                                                "text": "Men In Black 3 finagles its way out of this predicament by literally resetting the clock with a time-travel premise that makes Will Smith both a contemporary intergalactic cop in the late 1960s and a stranger to Josh Brolin, who plays the younger version of Smith’s stone-faced future partner, Tommy Lee Jones."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contemporary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bde3608-fc4c-3a3d-b634-46cb60f72b79",
                                        "entry_id": "dbaed288-ef1c-3bc4-8925-8a8832f6a329",
                                        "glosses": [
                                            "Someone or something belonging to the same time period (as someone or something else)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d09c20a8-bf66-4748-830c-0af58481f8fb",
                                                "sense_id": "5bde3608-fc4c-3a3d-b634-46cb60f72b79",
                                                "text": "Cervantes was a contemporary of Shakespeare."
                                            },
                                            {
                                                "example_id": "f7c3db48-5a0e-461f-9038-06e5a63ad2f0",
                                                "sense_id": "5bde3608-fc4c-3a3d-b634-46cb60f72b79",
                                                "text": "The early mammals inherited the earth by surviving their saurian contemporaries."
                                            },
                                            {
                                                "example_id": "90004ccd-4a46-4b80-9f4f-89f10532a35c",
                                                "sense_id": "5bde3608-fc4c-3a3d-b634-46cb60f72b79",
                                                "text": "Life is predicated by the decisions and choices we make – and, earlier this year, the personal fused with the professional again as Mata reached the landmark moment when he knew he had to try to harness football’s power for the benefit of people less fortunate than him and his contemporaries."
                                            },
                                            {
                                                "example_id": "f1541f57-09da-4dd4-a097-2e559808ccc0",
                                                "sense_id": "5bde3608-fc4c-3a3d-b634-46cb60f72b79",
                                                "text": "More than most of her contemporaries on “LeftTube,” [Contrapoints] has a style; her editorial signature is an unmistakably ornate flourish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d2779e-8053-3271-ad37-5f8836d35370",
                                        "entry_id": "dbaed288-ef1c-3bc4-8925-8a8832f6a329",
                                        "glosses": [
                                            "Something existing at the same time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f5ab1d8-e46f-3ce1-b115-1d2cb8a698d7",
                                        "entry_id": "dbaed288-ef1c-3bc4-8925-8a8832f6a329",
                                        "glosses": [
                                            "Something existing at the same time.",
                                            "A rival newspaper or magazine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e8fbb8-431a-4d7a-a3f8-972984a5b3b4",
                                                "sense_id": "7f5ab1d8-e46f-3ce1-b115-1d2cb8a698d7",
                                                "text": "Annexation therefore was inevitable; but (as I have said above) it was not necessarily of prime importance in our national policy, and there has been no need to exaggerate—as I fear many of our contemporaries have exaggerated— […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02b25a37-9ddb-4bc9-880a-ff02559bfd95",
                        "source_entry_id": "ede9ef9f-e278-3050-92f8-4bc895e12006",
                        "source_sense_id": "aab149b2-3823-33a7-9b9d-735b300e5332",
                        "target_lang_word": "contemporain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemporain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "839965e6-2c75-38d8-abb5-ea8aa442ff2e",
                                        "entry_id": "e65aff41-d9f6-3996-b798-6290dd7e3656",
                                        "glosses": [
                                            "Qui est du même temps que quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1177aa-643a-41e7-ac34-fbbb34ba72e7",
                                                "sense_id": "839965e6-2c75-38d8-abb5-ea8aa442ff2e",
                                                "text": "Pour nos idéologues contemporains, l’être humain est conçu comme un cyborg naturel, libre à lui de s’appliquer, de s’auto-greffer les dernières technologies pour évoluer vers une forme supérieure comme dans la fable de Pic de la Mirandole."
                                            },
                                            {
                                                "example_id": "5ef813c0-bb35-4973-b915-f6c48cb0f833",
                                                "sense_id": "839965e6-2c75-38d8-abb5-ea8aa442ff2e",
                                                "text": "Elle m’avait fait découvrir des romancières anglaises contemporaines que j’appréciais presque autant que Daphné Du Maurier : Penelope Lively, Rose Tremain, Joanna Trollope, A. S. Byatt."
                                            },
                                            {
                                                "example_id": "5f7ba84f-49fc-4aa2-869a-01be5886b543",
                                                "sense_id": "839965e6-2c75-38d8-abb5-ea8aa442ff2e",
                                                "text": "Pourquoi ? Parce que les technologies contemporaines, proposera ce livre, remettent en question non seulement la perception que nous avons du monde, mais bien aussi les universaux qui nous ont aidés, à travers les millénaires, à rendre ce monde cohérent et à rationaliser notre présence en celui-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31805956-0dc9-3183-aed6-c68bc62d0af2",
                                        "entry_id": "e65aff41-d9f6-3996-b798-6290dd7e3656",
                                        "glosses": [
                                            "Qualifie les historiens qui ont écrit les choses qui se sont passées dans leur temps."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "157673a2-311e-31d3-a9f2-c51e1c635d05",
                                        "entry_id": "e65aff41-d9f6-3996-b798-6290dd7e3656",
                                        "glosses": [
                                            "D’aujourd’hui, produit à l’époque actuelle, appartenant au temps présent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "contemporain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5359e3-93b3-3414-a8b2-dbbabd035a63",
                                        "entry_id": "27331f95-59a9-390c-a376-8808930b84a3",
                                        "glosses": [
                                            "Personne vivant en même temps qu'une autre personne de référence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d937306f-66aa-487a-916e-54fe27e9717f",
                                                "sense_id": "4e5359e3-93b3-3414-a8b2-dbbabd035a63",
                                                "text": "Que veux-tu faire avec des forbans de cette espèce ? Disqualifié, fichu, méprisé, il n’en continuait pas moins à rançonner ses contemporains. Il rançonna jusqu’aux Rothschild."
                                            },
                                            {
                                                "example_id": "6fa9569f-aa5a-452e-b56f-1810c0074540",
                                                "sense_id": "4e5359e3-93b3-3414-a8b2-dbbabd035a63",
                                                "text": "On dira sans doute que cela n’est pas particulier à notre ville et qu’en somme tous nos contemporains sont ainsi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37dedcc-73ba-300c-ba99-c1ac7bf24151",
                                        "entry_id": "27331f95-59a9-390c-a376-8808930b84a3",
                                        "glosses": [
                                            "Né la même année."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2bdb11c-267b-436f-a30e-70d13581107d",
                                                "sense_id": "e37dedcc-73ba-300c-ba99-c1ac7bf24151",
                                                "text": "Ce pauvre marquis d’Argenton, que vous appeliez le secrétaire d’état de la république de Platon, est donc mort? Il était mon contemporain : il faut que je fasse mon paquet."
                                            },
                                            {
                                                "example_id": "dc4cf05b-df61-486e-9682-a77ea7434d4a",
                                                "sense_id": "e37dedcc-73ba-300c-ba99-c1ac7bf24151",
                                                "text": "Mon contemporain (dans le sens qu’il est du même millésime que moi), Fabrice Luchini ne l’aime guère non plus, comme il l’explique dans un entretien accordé au Figaro Magazine il y a quelque trois ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e7dbf9-7f66-3ac9-ab3b-ad4ae9882d02",
                                        "entry_id": "27331f95-59a9-390c-a376-8808930b84a3",
                                        "glosses": [
                                            "(Précédé d'un article défini : le contemporain) Ensemble des réalités de l'époque actuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35041df8-e132-40d0-9668-25f9a2da32cb",
                                                "sense_id": "79e7dbf9-7f66-3ac9-ab3b-ad4ae9882d02",
                                                "text": "Les bibliothèques ont réagi bien avant les musées pour comprendre le rôle que pouvait jouer Wikipédia, car ce monde est sans doute plus ouvert sur le contemporain et s'oriente vers un public plus large, voire populaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
