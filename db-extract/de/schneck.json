                    {
                        "translation_id": "f2e500e2-1fd0-436f-83b3-6bc921299c12",
                        "source_entry_id": "25b25c51-3562-3180-9e19-59d25460c183",
                        "source_sense_id": "c54c23e6-bf63-3383-b9f7-07d0bf10e590",
