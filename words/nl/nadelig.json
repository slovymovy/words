{
    "word_family": [
        "nadeel",
        "benadelen",
        "benadeling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed442d5b-1e11-3a6b-ace0-6c1ea6c0abca",
                    "sense_definition": "ongunstig of schade veroorzakend; leidend tot een slechtere positie of resultaat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schadelijk_ongunstig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe belastingregels hebben een <w>nadelig</w> effect op onze winst.",
                            "target_lang_translations": {
                                "en": "The new tax rules have an <w>adverse</w> effect on our profits."
                            }
                        },
                        {
                            "text": "Het is erg <w>nadelig</w> voor de gezondheid om te weinig te slapen.",
                            "target_lang_translations": {
                                "en": "It is very <w>detrimental</w> to your health to sleep too little."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongunstig",
                        "schadelijk",
                        "verliesgevend"
                    ],
                    "antonyms": [
                        "voordelig"
                    ],
                    "common_phrases": [
                        "nadelig effect",
                        "nadelig gevolg"
                    ],
                    "target_lang_definitions": {
                        "en": "unfavorable or causing damage; leading to a worse position or result"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disadvantageous",
                                "target_lang_sense_clarification": "leading to an unfavorable position or result"
                            },
                            {
                                "target_lang_word": "adverse",
                                "target_lang_sense_clarification": "unfavorable or contrary to one's interests"
                            },
                            {
                                "target_lang_word": "harmful",
                                "target_lang_sense_clarification": "causing damage or injury"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b091b223-7768-32a4-a518-f91e7e48d0a7",
                    "sense_definition": "kwalijk of schadelijk voor de reputatie of het welzijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schadelijk_ongunstig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn constante afwezigheid was erg <w>nadelig</w> voor zijn reputatie binnen het bedrijf.",
                            "target_lang_translations": {
                                "en": "His constant absence was very <w>harmful</w> to his reputation within the company."
                            }
                        },
                        {
                            "text": "Zulke geruchten kunnen zeer <w>nadelig</w> uitpakken voor de verkoopcijfers.",
                            "target_lang_translations": {
                                "en": "Such rumors can turn out to be highly <w>disadvantageous</w> for sales figures."
                            }
                        }
                    ],
                    "synonyms": [
                        "schadelijk",
                        "kwalijk",
                        "fnuikend"
                    ],
                    "antonyms": [
                        "voordelig"
                    ],
                    "common_phrases": [
                        "nadelig voor de reputatie"
                    ],
                    "target_lang_definitions": {
                        "en": "bad or harmful to reputation or well-being"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detrimental",
                                "target_lang_sense_clarification": "causing damage or harm to reputation or well-being"
                            },
                            {
                                "target_lang_word": "harmful",
                                "target_lang_sense_clarification": "injurious to reputation or health"
                            },
                            {
                                "target_lang_word": "prejudicial",
                                "target_lang_sense_clarification": "causing harm or injury to a status or case"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5b7e344a-8ba5-3250-ab78-7126296bad34",
                    "sense_definition": "op een ongunstige of schadelijke manier",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economische crisis heeft de woningmarkt <w>nadelig</w> beïnvloed.",
                            "target_lang_translations": {
                                "en": "The economic crisis has <w>adversely</w> affected the housing market."
                            }
                        },
                        {
                            "text": "Dit besluit kan <w>nadelig</w> uitvallen voor de lagere inkomens.",
                            "target_lang_translations": {
                                "en": "This decision could turn out <w>unfavorably</w> for lower-income groups."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongunstig",
                        "schadelijk"
                    ],
                    "antonyms": [
                        "voordelig"
                    ],
                    "common_phrases": [
                        "nadelig beïnvloeden",
                        "nadelig uitvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "in an unfavorable or harmful manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adversely",
                                "target_lang_sense_clarification": "negatively or unfavorably"
                            },
                            {
                                "target_lang_word": "unfavorably",
                                "target_lang_sense_clarification": "in an unfavorable manner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}