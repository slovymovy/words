        "fr-extract.jsonl": [
            {
                "entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                "word": "férocité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e948603a-30e4-4819-9e80-48b412eac19a",
                        "entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                        "tags": [
                            "plural"
                        ],
                        "form": "férocités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                        "entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                        "glosses": [
                            "Naturel féroce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032eed56-6a1d-44c6-b5a5-bd959818b04b",
                                "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                "text": "La férocité des conventionnels s’explique facilement par l’influence des conceptions que le Tiers État avait puisées dans les pratiques détestables de l’Ancien Régime."
                            },
                            {
                                "example_id": "8996c772-1b34-4cf9-a178-935ed871b86d",
                                "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                "text": "Comme Tonsard, que son renom dispensait de toute preuve de férocité, comme tous ceux qui sont gardés par une opinion publique quelconque, Socquard ne déployait jamais sa triomphante force musculaire, à moins que des amis ne l’en priassent."
                            },
                            {
                                "example_id": "69b00d6e-2784-42d8-8444-cecccff97b75",
                                "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                "text": "La férocité est naturelle au lion, au tigre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c0965f4-b23a-35cc-8f7f-80b257e15f5f",
                        "entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                        "glosses": [
                            "Aspect féroce."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "327c936f-472c-4fdb-ac64-09ed8a80d81c",
                                "sense_id": "1c0965f4-b23a-35cc-8f7f-80b257e15f5f",
                                "text": "Les cicatrices […] ne faisaient qu’ajouter à la férocité de son visage et à la terreur que sa présence inspirait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe18085c-0750-4036-a34f-e0e598a67cf2",
                        "source_entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                        "target_lang_word": "ferocity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferocity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                                        "entry_id": "aad2dfbe-393f-36b2-b684-f7740c9e02fb",
                                        "glosses": [
                                            "The condition of being ferocious."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4dd118e-df55-4fe8-9006-a102e4722ddd",
                                                "sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                                                "text": "Near-synonyms: fierceness, furiousness, fury, vehemence, violence"
                                            },
                                            {
                                                "example_id": "b38f2749-f5d7-4208-bfa6-3f65ce2074a6",
                                                "sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                                                "text": "Nearly a year later, in the month of October, 18—, London was startled by a crime of singular ferocity and rendered all the more notable by the high position of the victim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
