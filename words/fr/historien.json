                    "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                    "sense_definition": "Spécialiste qui étudie, analyse le passé et rédige des ouvrages sur les événements historiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>historien</w> réputé a écrit plusieurs livres sur la Révolution française."
                        },
                        {
                            "text": "Le musée a invité un <w>historien</w> pour expliquer les origines de cette collection."
                        }
                    ],
                    "common_phrases": [
