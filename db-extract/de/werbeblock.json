                "senses": [
                    {
                        "sense_id": "f192f82c-705f-3a4c-a448-663ed9ff9280",
                        "entry_id": "841d78fd-026a-322b-9c31-8a8616788c69",
                        "glosses": [
                            "zusammenhängender Zeitraum, in dem kurze Werbefilme/Werbespots gezeigt werden, die vor oder während einer Sendung erscheinen"
                        ],
                        "tags": [
                            "Fernsehen"
                        ],
                        "examples": [
                            {
                                "example_id": "b34ac521-67af-4a0b-86a9-e3a2dfae5c42",
                                "sense_id": "f192f82c-705f-3a4c-a448-663ed9ff9280",
                                "text": "Die bei den öffentlichen Anbietern geschalteten Werbeblöcke dürfen nur werktags vor 20 Uhr gesendet werden."
                            },
                            {
                                "example_id": "cb700c38-a587-4401-b410-a00fd454e438",
                                "sense_id": "f192f82c-705f-3a4c-a448-663ed9ff9280",
                                "text": "Jeder längere Spielfilm versucht es mit drei oder fünf Werbeblöcken und will vor jedem Werbeblock einen sogenannten Cliffhanger haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
