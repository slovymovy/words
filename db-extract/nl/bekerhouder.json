                            {
                                "example_id": "64d048f0-fb63-4e1a-a416-5ee1c29615e9",
                                "sense_id": "785af9d3-e0f7-3a21-826c-9aba6fca9591",
                                "text": "Zonder Haar heeft Genk in ieder geval eindelijk weer eens gewonnen. De bekerwedstrijd bij amateurclub Sint-Eloois-Winkel Sport leverde een 6-0 zege op voor de bekerhouder."
                            },
                            {
                                "example_id": "2fb6e514-e8b4-4098-824e-d31fa71f5ea3",
                                "sense_id": "785af9d3-e0f7-3a21-826c-9aba6fca9591",
                                "text": "De vrouwen van FC Barcelona hebben ook de vijfde wedstrijd in de groepsfase van de Champions League gewonnen. De bekerhouder won met 4-0 bij Arsenal. Lieke Martens deed 65 minuten mee bij Barça en Vivianne Miedema kwam na een uur in de ploeg bij Arsenal."
                            }
