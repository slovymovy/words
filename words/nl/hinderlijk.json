    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "04d24551-d7d8-33a9-a572-2d59a1c63ee6",
                    "sense_definition": "iets dat overlast of belemmering veroorzaakt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overlast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lawaai van de buren is erg <w>hinderlijk</w> als ik probeer te studeren.",
                            "target_lang_translations": {
                                "en": "The noise from the neighbors is very <w>annoying</w> when I am trying to study.",
                                "it": "Il rumore dei vicini è molto <w>fastidioso</w> quando cerco di studiare."
                            }
                        },
                        {
                            "text": "Zijn constante onderbrekingen tijdens de vergadering werden als <w>hinderlijk</w> ervaren.",
                            "target_lang_translations": {
                                "en": "His constant interruptions during the meeting were perceived as <w>bothersome</w>.",
                                "it": "Le sue continue interruzioni durante la riunione sono state percepite come <w>moleste</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervelend",
                        "lastig",
                        "storend",
                        "irritant"
                    ],
                    "antonyms": [
                        "prettig",
                        "aangenaam",
                        "nuttig"
                    ],
                    "common_phrases": [
                        "hinderlijk gedrag",
                        "hinderlijk geluid",
                        "hinderlijk volgen"
                    ],
                    "target_lang_definitions": {
                        "en": "something that causes nuisance, annoyance, or a minor disturbance",
                        "it": "qualcosa che causa fastidio, disturbo o una lieve irritazione"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoying",
                                "target_lang_sense_clarification": "causing irritation or nuisance"
                            },
                            {
                                "target_lang_word": "bothersome",
                                "target_lang_sense_clarification": "causing trouble or annoyance"
                            },
                            {
                                "target_lang_word": "disturbing",
                                "target_lang_sense_clarification": "interrupting focus or peace"
                            },
                            {
                                "target_lang_word": "nuisance",
                                "target_lang_sense_clarification": "acting as a source of irritation"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "fastidioso",
                                "target_lang_sense_clarification": "che causa irritazione o disturbo"
                            },
                            {
                                "target_lang_word": "molesto",
                                "target_lang_sense_clarification": "che arreca disturbo o fastidio persistente"
                            },
                            {
                                "target_lang_word": "seccante",
                                "target_lang_sense_clarification": "che provoca una sensazione di noia o irritazione"
                            }
