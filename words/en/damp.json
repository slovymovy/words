{
    "word_family": [
        "dampen",
        "dampness",
        "damper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d57928b-939a-3cf5-828c-50cb078d0f9c",
                    "sense_definition": "In a state between dry and wet; moderately wet; moist.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawn was still <w>damp</w> so we decided not to sit down.",
                            "target_lang_translations": {
                                "ru": "Газон все еще был <w>влажным</w>, поэтому мы решили не садиться.",
                                "zh": "草坪还是<w>潮湿</w>的，所以我们决定不坐下。"
                            }
                        },
                        {
                            "text": "The paint is still <w>damp</w>, so please don't touch it.",
                            "target_lang_translations": {
                                "ru": "Краска еще <w>сырая</w>, поэтому, пожалуйста, не трогайте ее.",
                                "zh": "油漆还是<w>潮湿</w>的，请不要碰它。"
                            }
                        },
                        {
                            "text": "Be careful when walking on the <w>damp</w> grass after the rain.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, гуляя по <w>мокрой</w> траве после дождя.",
                                "zh": "雨后走在<w>湿润</w>的草地上要小心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moist",
                        "wet"
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "common_phrases": [
                        "damp grass",
                        "damp cloth",
                        "damp conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии между сухим и мокрым; умеренно влажный; сырой.",
                        "zh": "处于干和湿之间；微湿；潮湿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влажный",
                                "target_lang_sense_clarification": "содержащий влагу"
                            },
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "пропитанный влагой, не высохший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潮湿",
                                "target_lang_sense_clarification": "含有水分，不完全干燥"
                            },
                            {
                                "target_lang_word": "湿润",
                                "target_lang_sense_clarification": "略微带湿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abd2f69d-3095-3183-a191-a986605b7f44",
                    "sense_definition": "Permitting the possession of alcoholic beverages, but not their sale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol_regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The county voted to change its status from dry to <w>damp</w> in the last election.",
                            "target_lang_translations": {
                                "ru": "На последних выборах округ проголосовал за изменение своего статуса с «сухого» на <w>«влажный»</w>.",
                                "zh": "该县在上次选举中投票将其状态从禁酒改为<w>半禁酒</w>。"
                            }
                        },
                        {
                            "text": "In a <w>damp</w> county, you can drink alcohol at home but cannot buy it at local stores.",
                            "target_lang_translations": {
                                "ru": "В <w>«влажном»</w> округе вы можете пить алкоголь дома, но не можете купить его в местных магазинах.",
                                "zh": "在<w>半禁酒</w>县，你可以在家喝酒，但不能在当地商店购买。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dry",
                        "wet"
                    ],
                    "common_phrases": [
                        "damp county",
                        "damp law"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in the United States regarding local liquor laws"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрешающий хранение и употребление алкогольных напитков, но запрещающий их продажу.",
                        "zh": "指美国某些地区允许持有和饮用酒精饮料，但禁止在当地商店销售的法律状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«влажный»",
                                "target_lang_sense_clarification": "округе или законе в США с частичным запретом на алкоголь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "半禁酒",
                                "target_lang_sense_clarification": "指对酒精销售有部分限制的地区状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab9a3d7-b59a-3697-acb6-f4b04319c20a",
                    "sense_definition": "Despondent; dispirited, downcast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the bad news, there were few <w>damp</w> spirits among the team members.",
                            "target_lang_translations": {
                                "ru": "Несмотря на плохие новости, среди членов команды мало у кого было <w>унылое</w> настроение.",
                                "zh": "尽管有坏消息，团队成员中很少有人感到<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "He looked downcast and <w>damp</w> after hearing about the cancellation.",
                            "target_lang_translations": {
                                "ru": "Он выглядел подавленным и <w>унылым</w>, услышав об отмене.",
                                "zh": "听到取消的消息后，他看起来很<w>消沉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glum",
                        "melancholy",
                        "sorrowful",
                        "sad"
                    ],
                    "antonyms": [
                        "cheerful",
                        "joyful"
                    ],
                    "common_phrases": [
                        "damp spirits"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to describe mood"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Унылый, подавленный, упавший духом.",
                        "zh": "沮丧的；垂头丧气的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унылый",
                                "target_lang_sense_clarification": "о настроении или духе"
                            },
                            {
                                "target_lang_word": "подавленный",
                                "target_lang_sense_clarification": "о человеке или настроении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沮丧",
                                "target_lang_sense_clarification": "形容心情低落"
                            },
                            {
                                "target_lang_word": "消沉",
                                "target_lang_sense_clarification": "形容精神状态不振"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de3b8ff4-57e4-3814-97c9-f15a4d06257c",
                    "sense_definition": "Moisture; humidity; dampness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moisture_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold and the <w>damp</w> of the old cellar made everyone shiver.",
                            "target_lang_translations": {
                                "ru": "Холод и <w>сырость</w> старого погреба заставили всех дрожать.",
                                "zh": "旧地窖里的寒冷和<w>潮气</w>让每个人都发抖。"
                            }
                        },
                        {
                            "text": "We sometimes kept our boots on to avoid leaving trails of mud and <w>damp</w> through the rooms.",
                            "target_lang_translations": {
                                "ru": "Иногда мы не снимали сапоги, чтобы не оставлять следов грязи и <w>влаги</w в комнатах.",
                                "zh": "我们有时穿着靴子，以免在房间里留下泥土和<w>湿气</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dryness"
                    ],
                    "common_phrases": [
                        "cold and damp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влага, сырость, влажность.",
                        "zh": "水分；潮气；湿气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сырость",
                                "target_lang_sense_clarification": "влажный воздух или состояние"
                            },
                            {
                                "target_lang_word": "влага",
                                "target_lang_sense_clarification": "жидкость, содержащаяся в чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潮气",
                                "target_lang_sense_clarification": "空气中或物体表面的湿润感"
                            },
                            {
                                "target_lang_word": "湿气",
                                "target_lang_sense_clarification": "环境中的水分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aebca2ec-8264-3c69-817a-47cae99d0108",
                    "sense_definition": "Dejection or depression; something that spoils a positive emotion or a desired activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discouragement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden bad news cast a <w>damp</w> over the festive gathering.",
                            "target_lang_translations": {
                                "ru": "Внезапная плохая новость нагнала <w>уныние</w> на праздничное собрание.",
                                "zh": "突如其来的坏消息给节日聚会蒙上了一层<w>扫兴</w>的阴影。"
                            }
                        },
                        {
                            "text": "The rain threw a <w>damp</w> upon our outdoor plans, but we tried to stay cheerful.",
                            "target_lang_translations": {
                                "ru": "Дождь <w>испортил</w> наши планы на свежем воздухе, но мы старались сохранять бодрость.",
                                "zh": "雨水给我们的户外计划<w>扫了兴</w>，但我们尽量保持愉快。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast a damp",
                        "throw a damp"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in the phrase 'cast a damp' or 'throw a damp'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уныние, подавленность; то, что портит настроение или мешает планам.",
                        "zh": "扫兴；挫伤积极性的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "подавленное состояние духа"
                            },
                            {
                                "target_lang_word": "охлаждающий эффект",
                                "target_lang_sense_clarification": "то, что портит веселье или энтузиазм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扫兴",
                                "target_lang_sense_clarification": "破坏兴致"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4b62951-b643-3913-85e9-c267589d3fbe",
                    "sense_definition": "Fog; fogginess; vapor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As twilight fell, creeping <w>damps</w> rose from the hollows of the valley.",
                            "target_lang_translations": {
                                "ru": "С наступлением сумерек из лощин долины поднимались ползучие <w>испарения</w>.",
                                "zh": "暮色降临时，山谷洼地里升起了弥漫的<w>湿雾</w>。"
                            }
                        },
                        {
                            "text": "The night was accompanied by black air and cold <w>damps</w> that chilled us to the bone.",
                            "target_lang_translations": {
                                "ru": "Ночь сопровождалась черным воздухом и холодным <w>туманом</w>, который пробирал нас до костей.",
                                "zh": "夜晚伴随着漆黑的空气和寒冷的<w>湿雾</w>，冷得我们透心凉。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly found in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Туман, испарения, сырой воздух.",
                        "zh": "雾气；湿冷的空气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сырой туман",
                                "target_lang_sense_clarification": "холодные испарения"
                            },
                            {
                                "target_lang_word": "испарения",
                                "target_lang_sense_clarification": "влажный воздух, поднимающийся от земли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "湿雾",
                                "target_lang_sense_clarification": "潮湿的雾气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d98ba6e-eb5b-3cb7-990d-5bc58205de17",
                    "sense_definition": "A toxic or suffocating gaseous product formed in coal mines, old wells, or pits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining_gases",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miners must be extremely careful of the dangerous <w>damps</w> that accumulate in old shafts.",
                            "target_lang_translations": {
                                "ru": "Шахтеры должны быть крайне осторожны с опасными <w>рудничными газами</w>, которые скапливаются в старых шахтах.",
                                "zh": "矿工必须格外小心旧矿井中积聚的危险<w>矿井瓦斯</w>。"
                            }
                        },
                        {
                            "text": "The ventilation system was designed to clear out any toxic <w>damp</w> before workers entered.",
                            "target_lang_translations": {
                                "ru": "Вентиляционная система была разработана для очистки от любого токсичного <w>газа</w> перед входом рабочих.",
                                "zh": "通风系统旨在工人们进入前清除任何有毒<w>气体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "choke damp",
                        "fire damp"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in mining terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Токсичный или удушливый газ, скапливающийся в угольных шахтах или колодцах.",
                        "zh": "矿井或深井中积聚的有毒或窒息性气体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рудничный газ",
                                "target_lang_sense_clarification": "опасные газы в шахтах"
                            },
                            {
                                "target_lang_word": "удушливый газ",
                                "target_lang_sense_clarification": "газ, вызывающий удушье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿井瓦斯",
                                "target_lang_sense_clarification": "矿井中积聚的有害气体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e45808-55de-3831-ae76-0c9b6fa199f8",
                    "sense_definition": "Initialism of damage-associated molecular pattern.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology_acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The release of a <w>DAMP</w> from injured cells triggers an inflammatory response.",
                            "target_lang_translations": {
                                "ru": "Высвобождение <w>DAMP</w> из поврежденных клеток запускает воспалительную реакцию.",
                                "zh": "受损细胞释放的<w>损伤相关分子模式</w>会引发炎症反应。"
                            }
                        },
                        {
                            "text": "Researchers studied how different <w>DAMPs</w> interact with pattern recognition receptors.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили, как различные <w>DAMP</w> взаимодействуют с рецепторами распознавания паттернов.",
                                "zh": "研究人员研究了不同的<w>损伤相关分子模式</w>如何与模式识别受体相互作用。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Written as DAMP or DAMPs"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от damage-associated molecular pattern (ассоциированные с повреждением молекулярные паттерны).",
                        "zh": "损伤相关分子模式（生物学术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "DAMP",
                                "target_lang_sense_clarification": "биологический термин, молекулярный паттерн повреждения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损伤相关分子模式",
                                "target_lang_sense_clarification": "生物学专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbc0c487-9346-3d4d-bda8-4f66dd26b1e2",
                    "sense_definition": "Acronym of deficits in attention, motor control and perception.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children diagnosed with <w>DAMP</w> often require specialized educational support.",
                            "target_lang_translations": {
                                "ru": "Детям с диагнозом <w>DAMP</w> часто требуется специализированная образовательная поддержка.",
                                "zh": "被诊断患有<w>DAMP综合征</w>的儿童通常需要专门的教育支持。"
                            }
                        },
                        {
                            "text": "The study examined the overlap between ADHD and <w>DAMP</w> in young patients.",
                            "target_lang_translations": {
                                "ru": "В исследовании изучалось совпадение между СДВГ и <w>DAMP</w> у молодых пациентов.",
                                "zh": "该研究调查了年轻患者中多动症与<w>DAMP综合征</w>之间的重叠情况。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Written as DAMP"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от deficits in attention, motor control and perception (дефицит внимания, моторного контроля и восприятия).",
                        "zh": "注意力、运动控制和感知缺陷综合征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "DAMP-синдром",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "DAMP综合征",
                                "target_lang_sense_clarification": "医学诊断术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "944ddc0e-6c8e-3960-9e6d-131692d178f1",
                    "sense_definition": "To <w>dampen</w>; to make moderately wet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wetting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>damp</w> the cloth slightly before wiping the dusty table.",
                            "target_lang_translations": {
                                "ru": "Вам следует слегка <w>увлажнить</w> тряпку, прежде чем вытирать пыльный стол.",
                                "zh": "擦拭多尘的桌子前，你应该把布稍微<w>弄湿</w>。"
                            }
                        },
                        {
                            "text": "He used a spray bottle to <w>damp</w> the fabric before ironing it.",
                            "target_lang_translations": {
                                "ru": "Он использовал пульверизатор, чтобы <w>смочить</w> ткань перед глажкой.",
                                "zh": "他在熨烫前用喷雾瓶把布料<w>润湿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moisten"
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "common_phrases": [
                        "damp the cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увлажнять, делать умеренно влажным.",
