                },
                {
                    "sense_id": "58789c1c-e3b9-3fd7-8f4a-f6807afa9350",
                    "sense_definition": "To cause to flash or gleam; to reflect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The polished surface <w>glinted</w> a bright reflection into the room."
                        },
                        {
                            "text": "The mirror <w>glinted</w> the light across the wall."
                        }
                    ],
                    "synonyms": [
                        "reflect"
                    ]
                },
                {
                    "sense_id": "b4dc5419-83e2-3e6a-a6ed-51f534cd4057",
                    "sense_definition": "To glance; to peep forth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was <w>glinting</w> through the morning clouds."
                        },
                        {
                            "text": "He stopped to <w>glint</w> at the flowers in the garden."
                        }
                    ],
                    "synonyms": [
                        "glance",
                        "peep"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or older contexts."
                        }
                    ]
                },
                {
                    "sense_id": "d291893a-7fcb-39df-a2cd-2150b1638252",
                    "sense_definition": "To dry; to wither.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat began to <w>glint</w> the crops in the field."
                        },
                        {
                            "text": "The summer sun <w>glinted</w> the grass until it turned brown."
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "dry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ]
                }
            ]
        },
        {
