                                            {
                                                "example_id": "8a7c51ed-fc84-4d16-8d1b-b4471aa05753",
                                                "sense_id": "32c94a1e-27b0-302c-b4f8-6e611c0b4f0d",
                                                "text": "Çok işte ne yapıyorsak onu yapıp bunda da gerçekliği belirlemekle yetinebiliriz."
                                            },
                                            {
                                                "example_id": "a0c02971-1288-4c3e-bc0f-bc91b3a1c460",
                                                "sense_id": "32c94a1e-27b0-302c-b4f8-6e611c0b4f0d",
                                                "text": "Her hâlde o gün imparatorluğun ölümü apaçık bir gerçekti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53975160-528f-4a06-b58c-4825fd7b45d1",
                        "source_entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "source_sense_description": "the quality of being actual or factual",
                        "target_lang_word": "werkelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "werkelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac6d6c3-d333-30b6-b490-401d320b6a37",
                                        "entry_id": "04e7bb2c-92e4-33c7-b2e3-fc17e5f301b6",
                                        "glosses": [
                                            "de omstandigheden zoals deze daadwerkelijk bestaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a78fcded-6e41-4c71-bed2-a7f13a88f817",
                                                "sense_id": "0ac6d6c3-d333-30b6-b490-401d320b6a37",
                                                "text": "Ze besloten zich vanaf een plateau in een meertje te storten. In werkelijkheid kunnen ze alleen maar wadend in de troebele poel hun dood tegemoet zijn gelopen - een nabij ravijn is nergens te bekennen."
                                            },
                                            {
                                                "example_id": "4b4e6f30-9e1c-4851-a26e-93746e06299f",
                                                "sense_id": "0ac6d6c3-d333-30b6-b490-401d320b6a37",
                                                "text": "Dit keer kijken we naar twee deepfakes: bewerkte video's waarin het lijkt alsof iemand iets zegt wat die in werkelijkheid nooit gezegd heeft."
                                            },
                                            {
                                                "example_id": "34f6a47c-6cda-41c8-8b1d-6527c93c81b2",
                                                "sense_id": "0ac6d6c3-d333-30b6-b490-401d320b6a37",
                                                "text": "Niet dat The Favourite zich iets aantrekt van de werkelijkheid, of hoe die werkelijkheid er in films over die periode doorgaans uitziet. Dat komt door het smeuïge scenario van Deborah Davis en Tony McNamara, vol seks en jaloezie, verraad en vulgariteiten. Het woord ‘kutwijf’ valt verrassend vaak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c046ea6-8ae7-4e49-9cd6-a295894ac280",
                        "source_entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "source_sense_description": "the quality of being actual or factual",
                        "target_lang_word": "realiteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realiteit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0fd140-8bbb-3f10-bc3b-e6b18ec93171",
                                        "entry_id": "79c1c051-dd32-39f1-9e30-8a592b33679b",
                                        "glosses": [
                                            "werkelijkheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a310c25e-3e39-4f9f-b4d8-886c198f537f",
                                                "sense_id": "1d0fd140-8bbb-3f10-bc3b-e6b18ec93171",
                                                "text": "De bittere realiteit is dat de oorlog een grote chaos veroorzaakt heeft."
                                            },
                                            {
                                                "example_id": "25ccba66-47fb-4af4-a589-2cf7fbdb72de",
                                                "sense_id": "1d0fd140-8bbb-3f10-bc3b-e6b18ec93171",
                                                "text": "Het was te ver verwijderd van de alledaagse werkelijkheid en de realiteit van menselijke emoties, behoeftes en imperfecties."
                                            },
                                            {
                                                "example_id": "38bdb8ba-34d1-4106-ab41-cd917dee6ad6",
                                                "sense_id": "1d0fd140-8bbb-3f10-bc3b-e6b18ec93171",
                                                "text": "De VU laat aan de NOS weten te waarderen dat het werkveld erg betrokken is. \"De realiteit blijft echter dat de afdeling Aardwetenschappen langdurig te maken heeft met structurele financiële tekorten, ondanks eerdere reorganisaties en gedeeltelijk steun van andere afdelingen. Deze structurele tekorten zijn niet langer mogelijk gezien de bezuinigingsopgave waar we als faculteit, maar ook als universiteit in haar geheel, nu voor staan.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3df99926-78b8-40d4-b701-152d5baf2a19",
                        "source_entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "source_sense_description": "the quality of being actual or factual",
                        "target_lang_word": "feit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa0f7cc-e441-3829-8197-019254027aa9",
                                        "entry_id": "327aa507-f4c1-35d0-bedb-aa9c12505df0",
                                        "glosses": [
                                            "een gebeurtenis of omstandigheid die werkelijk gebeurd is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b07531-fa82-46df-83dd-2c4aba42cdf2",
                                                "sense_id": "aaa0f7cc-e441-3829-8197-019254027aa9",
                                                "text": "Het is niet mijn mening, het is een feit!"
                                            },
                                            {
                                                "example_id": "16b2f9af-2e5d-4968-8db8-b85cd7a510b5",
                                                "sense_id": "aaa0f7cc-e441-3829-8197-019254027aa9",
                                                "text": "Het is een feit dat een koe schijt"
                                            },
                                            {
                                                "example_id": "fb7d4497-bce4-44a0-b69f-f328ed2b90ca",
                                                "sense_id": "aaa0f7cc-e441-3829-8197-019254027aa9",
                                                "text": "Kinderen zijn, net als iedereen, gewoontedieren. De mijne waren inmiddels een beetje gewend aan het feit dat zowel ik als mijn vrouw af en toe een tijdje weg waren."
                                            },
                                            {
                                                "example_id": "1131c009-cc4e-4afa-8668-325309aa92dd",
                                                "sense_id": "aaa0f7cc-e441-3829-8197-019254027aa9",
                                                "text": "Waren dat dan geen kunstenaars? Werd het verschil tussen een vrouw die schilderde en een kunstenaar alleen maar veroorzaakt door het feit dat anderen in je geloofden of twee keer zoveel geld voor je op tafel legden? Ze kon haar ouders onmogelijk uitleggen waarom ze toelatingsexamen had gedaan, waarom ze een portfolio had samengesteld en een essay had geschreven over de achtergrondfiguren bij Bellini."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
