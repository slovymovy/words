                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d48eb5a-cf54-487d-b9ce-8fc238932f75",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Frau Raab ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "719efb41-ce51-4b15-aacd-cb553b512e6a",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Herr Raab wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "3b4c2e57-9a7e-48ac-90c6-1d8e96068f7d",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Die Raabs fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "ee266d8a-aa36-4d2b-a08d-bb15f0b318ad",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Der Raab trägt nie die Pullover, die die Raab ihm strickt."
                                            },
                                            {
                                                "example_id": "c1694966-0c4e-4cf6-918c-4e170ab12c3b",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Raab kommt, geht der Herr Raab.“"
                                            },
                                            {
                                                "example_id": "74837164-ee04-4a07-99c6-3f25061ec29b",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Raab kommt und geht."
                                            },
                                            {
                                                "example_id": "21a39192-188d-4ee6-b30d-dd1d48bfd5eb",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Raabs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
