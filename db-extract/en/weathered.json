                ],
                "translations": [
                    {
                        "translation_id": "cdef8a48-8823-4f8d-b3ee-f6fb064bced5",
                        "source_entry_id": "a0d0c9d5-8d6a-3083-8a1a-007a59a08722",
                        "source_sense_description": "worn by weather",
                        "target_lang_word": "verwittert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwittert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                        "entry_id": "2b4c1d46-9655-3a22-be1e-5ed482129e3b",
                                        "glosses": [
                                            "durch Wetter (beispielsweise Regen, Frost, Wind) in der Oberfläche von etwas (beispielsweise Stein, Holz) angegriffen / beschädigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2130c648-4dd3-40fd-a376-86b95d4e5926",
                                                "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                                "text": "Um dem Holz ein verwittertes Aussehen zu geben, [wird mit Färbemittel, Stahlwolle und Essig gearbeitet.]"
                                            },
                                            {
                                                "example_id": "4456df19-3843-4a16-9165-db502ed76cdd",
                                                "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                                "text": "Die Hauptstadt Bissau erinnert mit ihren buntgetünchten, verwitterten Häusern ein bisschen an Havanna."
                                            },
                                            {
                                                "example_id": "bae03400-eedd-45db-9e00-58c600f737cb",
                                                "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                                "text": "Sein Gesicht ist von Sonne, Wind und salzigem Meerwasser ebenso verwittert wie die Farbe an seinem Boot."
                                            },
                                            {
                                                "example_id": "d499ce00-c10c-4e7f-aeda-c1aac0337ceb",
                                                "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                                "text": "Viele der Altäre und Stelen sind in einem sehr stark verwitterten Zustand […]"
                                            },
                                            {
                                                "example_id": "14057ef9-83e6-4b82-9ea9-ad49ea9e69f1",
                                                "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                                "text": "Zwei Grabsteine auf dem jüdischen Friedhof in Elmshorn erinnern an [Marianne und Abraham Heilbronn]. Doch ihre Steine sind verwittert."
                                            },
                                            {
                                                "example_id": "ccaf93fc-30c2-42f4-91f0-8cfae4bdf216",
                                                "sense_id": "0b6f5d48-dfad-3981-b2b1-6379c57f98f5",
                                                "text": "Um verwitterte von der Patina angegraute Holzmöbel zu reinigen benötigen Sie gar nicht viel: Wurzelbürste, Wasser, Kernseife oder Essigreiniger, Lappen, Schwamm, Pinsel und für Möbel, die von Frühling bis Herbst draußen stehen, geeignetes Holzöl."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
