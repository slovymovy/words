                "senses": [
                    {
                        "sense_id": "610b6f18-b82b-37e0-a114-2f53a4675355",
                        "entry_id": "53378387-fe3f-39b9-9656-7aeedc4ca36e",
                        "glosses": [
                            "Indication qu’un texte est terminé, mentionnant parfois l’auteur et la date."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb99d7e8-ef89-4ce6-9c8a-503ee027e63d",
                                "sense_id": "610b6f18-b82b-37e0-a114-2f53a4675355",
                                "text": "Chaque notice d’œuvre, […], comprend le titre et ses formes variantes, un commentaire concis, les incipit et explicit (ou le texte entier s’il est très court), la liste des manuscrits […] et quatre niveaux de bibliographie."
                            }
                        ]
                    },
                    {
                        "sense_id": "673ae145-bb42-37a0-871c-c4d01e34a063",
                        "entry_id": "53378387-fe3f-39b9-9656-7aeedc4ca36e",
                        "glosses": [
                            "Fin d’un chapitre ou d’un livre (par exemple, le dernier chapitre, ou les dernières phrases, etc)."
                        ],
                        "tags": [
                            "Sens récent"
                        ],
                        "examples": [
                            {
                                "example_id": "75be0e9a-35e9-4cbf-a1dd-28fa3d084894",
                                "sense_id": "673ae145-bb42-37a0-871c-c4d01e34a063",
                                "text": "Voici enfin quelques pistes de réflexion possibles : – l’articulation narrative de l’incipit et de l’explicit, notamment dans la forme du récit herméneutique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8633eb86-a8b9-43a4-bbf4-a03a11fc6258",
