                "senses": [
                    {
                        "sense_id": "00186449-e993-31a6-b5f4-8f560191a8b9",
                        "entry_id": "5303c36b-d21f-374f-ba4e-1551b683f511",
                        "glosses": [
                            "wierzenie obecne w rozmaitych kulturach, zgodnie z którym człowiek może w określonych okolicznościach przeobrazić się w zwierzę, zwłaszcza w wilka"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c1900efa-d302-36f3-b3ec-4da80f44e030",
                        "entry_id": "5303c36b-d21f-374f-ba4e-1551b683f511",
                        "glosses": [
                            "urojenie polegające na przekonaniu, że jest się zwierzęciem, zwłaszcza wilkiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7040301e-07f5-4190-bb57-78b7f1024d4f",
                                "sense_id": "c1900efa-d302-36f3-b3ec-4da80f44e030",
                                "text": "Już od XVI wieku we Francji i w Niemczech likantropia, czyli wilkołactwo, była chorobą diagnozowaną przez ówczesnych medyków, a niewykształcony lud uważał, że wilkołakami zostają ludzie, którzy zaprzedają duszę diabłu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6f9c9d5-8504-4ce2-9a51-ef8eb53c4b10",
                        "source_entry_id": "5303c36b-d21f-374f-ba4e-1551b683f511",
                        "source_sense_id": "00186449-e993-31a6-b5f4-8f560191a8b9",
                        "target_lang_word": "lycanthropy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lycanthropy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6c40354-2dc7-3918-a463-8706459a8ad2",
                                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                                        "glosses": [
                                            "The state of being a lycanthrope (or werewolf), a person who can shapeshift between the form of a human being and a wolf, often said to happen involuntarily during a full moon; werewolfdom."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "239c21f2-49a6-347d-9c6f-b680c501a0b7",
                                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                                        "glosses": [
                                            "The state of being a person who can shapeshift between the form of a human being and an animal, whether or not it is a wolf."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e05623e6-87a9-4487-9f1b-eaa04b95b319",
                                                "sense_id": "239c21f2-49a6-347d-9c6f-b680c501a0b7",
                                                "text": "On one hand, Jacques is quite glad that he doesn’t have classic lycanthropy. Turning into a squirrel tends to cause fewer problems than turning into a wolf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6a2e33-785d-34a3-8126-32ca073cc7c4",
                                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                                        "glosses": [
                                            "A delusion in which one believes oneself to be a wolf or other wild animal."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff004349-a829-4a0b-841a-177c9ac8b2ae",
                        "source_entry_id": "5303c36b-d21f-374f-ba4e-1551b683f511",
                        "source_sense_id": "00186449-e993-31a6-b5f4-8f560191a8b9",
                        "target_lang_word": "Lykanthropie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lykanthropie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb75d88b-f2e9-347c-8b95-a4a8d67ccc04",
                                        "entry_id": "99ead324-79f3-305e-abd8-578254ce5598",
                                        "glosses": [
                                            "Verwandlung eines Menschen in einen Werwolf, wie es in vielen Märchen und Sagen beschrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5520ecb4-b3d4-4a9e-a379-2d891c35b2bb",
                                                "sense_id": "bb75d88b-f2e9-347c-8b95-a4a8d67ccc04",
                                                "text": "Ist die Lykanthropie wirklich nur ein Mythos?"
                                            },
                                            {
                                                "example_id": "61ecfccc-c2b7-46ab-a372-6bd026456921",
                                                "sense_id": "bb75d88b-f2e9-347c-8b95-a4a8d67ccc04",
                                                "text": "„Hille ist wie besessen, er ähnelt fast einem von Lykanthropie Befallenen, der seine Schlußszene spielt, während rings um ihn bereits die schäbigen Kulissen abgebaut werden, und der sich der Unglaubwürdigkeit seiner Rolle bewußt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
