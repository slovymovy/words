                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c70c90-63e5-466b-9cc7-05d52ee795f6",
                                "sense_id": "2537b58a-6d9d-377d-ae9e-58bfc441df6d",
                                "text": "Les pompiers travaillaient à décochonner la cour, à deux lances, avec tous les cantonniers du Ve, et une file de fiacres à bondon attendaient contre le trottoir."
                            },
                            {
                                "example_id": "3c1299cc-94de-460d-ba83-27ca05391b8b",
                                "sense_id": "2537b58a-6d9d-377d-ae9e-58bfc441df6d",
                                "text": "Nous nous sommes cochonnés au milieu d’un troupeau de cochons, déclara Martin. On vient pour se décochonner, si c’est possible."
                            }
                        ]
                    }
