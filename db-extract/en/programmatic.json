                                            {
                                                "example_id": "98c675e4-b267-4377-8e1b-cb23ee5735cf",
                                                "sense_id": "1ceb23bf-055b-32a5-9e60-25455c2b61d8",
                                                "text": "Die Gesetze waren alle programmatisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa927f4e-d136-3037-a189-f7b4ab56fd36",
                                        "entry_id": "5a91aa06-74da-391b-9793-f30b12469f25",
                                        "glosses": [
                                            "richtungsweisend, zielorientiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ecac08-5d6b-42d0-b4f0-bdac687aac97",
                                                "sense_id": "aa927f4e-d136-3037-a189-f7b4ab56fd36",
                                                "text": "Neue programmatische Ideen lassen aufhorchen."
                                            },
                                            {
                                                "example_id": "605bff64-f57b-4b1f-a553-b8c3aa32471e",
                                                "sense_id": "aa927f4e-d136-3037-a189-f7b4ab56fd36",
                                                "text": "„Wahlkämpfe werden mit den Images von Spitzenpolitikern statt mit Parteiprogrammen geführt, Parteitage sollen Fernsehbilder liefern statt programmatische Diskussionen ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60ddeb27-3c76-4942-9338-1b6a66178e37",
                        "source_entry_id": "63730954-c0e6-3a48-9094-6a13310674d6",
                        "source_sense_id": "261a8ed3-bb90-39ee-8828-5cba841400db",
                        "source_sense_description": "Musik: etwas bezogen auf Programmmusik (program music)",
                        "target_lang_word": "instrumental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instrumental",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9afe2b1-832d-3856-900e-b5e30fb18355",
                                        "entry_id": "b060bac5-9603-3a01-b734-c8b26cfd6f4b",
                                        "glosses": [
                                            "Musik abseits der menschlichen Stimme betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbdd9d9-8ed2-4cb0-817c-575319974865",
                                                "sense_id": "d9afe2b1-832d-3856-900e-b5e30fb18355",
                                                "text": "„Das instrumentale Stück, mit dem Keyboarderin und Schlagzeuger schließlich die Zugabe eröffnen, erinnert noch einmal daran, wie formvollendet deren Musik eigentlich schon zuvor klang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab211ffd-1436-314e-a38c-26a4c6aa1823",
                                        "entry_id": "b060bac5-9603-3a01-b734-c8b26cfd6f4b",
                                        "glosses": [
                                            "auf kausalen Zusammenhang bezogen; eines das andere bewirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1f3f41-8739-45bb-b8f2-37e49a28496d",
                                                "sense_id": "ab211ffd-1436-314e-a38c-26a4c6aa1823",
                                                "text": "„Wer sich halbwegs auskennt, wird auf Doping schließen, also auf einen instrumentalen Zusammenhang der beiden Satzgedanken.“"
                                            },
                                            {
                                                "example_id": "f0e74671-fbbb-46c3-97f6-b43901b1f713",
                                                "sense_id": "ab211ffd-1436-314e-a38c-26a4c6aa1823",
                                                "text": "„Vom Ausgangspunkt der instrumentalen Betrachtungsweise kommt eine erweiterte Haftung des Kommanditisten aufgrund seiner beherrschenden Stellung im Unternehmen nur in Ausnahmefällen in Betracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
