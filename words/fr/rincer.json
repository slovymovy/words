                {
                    "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                    "sense_definition": "Laver ou passer à l'eau claire pour éliminer le savon ou les impuretés.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nettoyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de bien <w>rincer</w> la vaisselle avant de la faire sécher.",
                            "target_lang_translations": {
                                "en": "Don't forget to thoroughly <w>rinse</w> the dishes before drying them.",
                                "ru": "Не забудь хорошо <w>сполоснуть</w> посуду, прежде чем её высушить.",
                                "de": "Vergiss nicht, das Geschirr gründlich zu <w>spülen</w>, bevor du es abtrocknest.",
                                "es": "No olvides <w>enjuagar</w> bien los platos antes de secarlos.",
                                "zh": "别忘了先把餐具好好<w>冲洗</w>一遍，再把它们晾干。"
                            }
                        },
                        {
                            "text": "Après le shampoing, elle <w>rince</w> soigneusement ses cheveux à l'eau tiède.",
                            "target_lang_translations": {
                                "en": "After shampooing, she <w>rinses</w> her hair thoroughly with lukewarm water.",
                                "ru": "После шампуня она тщательно <w>споласкивает</w> волосы тёплой водой.",
                                "de": "Nach der Haarwäsche <w>spült</w> sie ihre Haare sorgfältig mit lauwarmem Wasser <w>aus</w>.",
                                "es": "Después del champú, <w>aclara</w> su pelo cuidadosamente con agua tibia.",
                                "zh": "洗完头后，她用温水把头发仔细<w>冲洗</w>干净。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rincer la vaisselle",
                        "rincer les verres"
                    ],
                    "target_lang_definitions": {
                        "en": "To wash something with clean water to remove soap or dirt.",
                        "ru": "Промыть что-либо чистой водой, чтобы удалить мыло или грязь.",
                        "de": "Etwas mit klarem Wasser waschen, um Seife oder Schmutz zu entfernen.",
                        "es": "Lavar algo con agua limpia para quitar el jabón o la suciedad.",
                        "zh": "用清水冲洗，去除肥皂或污垢。"
                    },
