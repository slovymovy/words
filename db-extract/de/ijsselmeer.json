                                                "sense_id": "dc53288a-e751-3481-a62d-65f1bd258257",
                                                "text": "Als het harder regent in de buurlanden, stroomt meer water vanuit de grote rivieren richting IJsselmeer."
                                            },
                                            {
                                                "example_id": "d0d800c9-2195-4e27-af98-99096774c7b6",
                                                "sense_id": "dc53288a-e751-3481-a62d-65f1bd258257",
                                                "text": "’s Avonds maak ik een wandelingetje van een minuut naar het IJsselmeer waar de zon altijd rood kleurt als ie in het water zakt."
                                            }
                                        ]
                                    }
                                ]
