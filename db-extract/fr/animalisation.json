                    {
                        "sense_id": "08f25b67-48de-306b-a32f-5d6efd8be5f0",
                        "entry_id": "18fcec6b-9d37-35e5-b6dc-59d50414b9df",
                        "glosses": [
                            "Transformation des aliments en la propre substance de l’animal qui s’en nourrit."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "253a4a42-7e01-42ce-b050-30abf4a8b94a",
                                "sense_id": "08f25b67-48de-306b-a32f-5d6efd8be5f0",
                                "text": "Cette animalisation de l’aliment est, comme on voit, un travail de l’organisation dont il est difficile de nous rendre compte par nos procédés chimiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "9168cf97-cc44-3072-8fe2-58012010c69a",
                        "entry_id": "18fcec6b-9d37-35e5-b6dc-59d50414b9df",
                        "glosses": [
                            "Fait de ravaler au rang d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23164699-4442-42cb-a88f-84bf49e38cba",
                                "sense_id": "9168cf97-cc44-3072-8fe2-58012010c69a",
                                "text": "L’animalisation, par la détresse et la misère, fait de l’homme un bipède fort au-dessous de l’animal."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c5333a1-ff4b-3a43-8f47-4be23f21b56b",
                        "entry_id": "18fcec6b-9d37-35e5-b6dc-59d50414b9df",
                        "glosses": [
                            "Utilisation croissante d’animaux pour le labour, la production de fumier et d’autres fonctions agricoles."
