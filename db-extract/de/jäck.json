                ],
                "senses": [
                    {
                        "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                        "entry_id": "8d7cefb0-ec89-3438-a8f0-ffa5b99118b2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7e35b7-3506-4b76-a1c3-14c0f547f133",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Frau Jäck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "416f5cec-58d0-4d41-ba85-33cc699b3ccb",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Herr Jäck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b112a4a5-6d1d-47e7-92e2-864b1019502f",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Die Jäcks fliegen heute nach Dublin."
                            },
                            {
                                "example_id": "9d09e530-6dd5-448d-a2c7-9e919a2e911c",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Der Jäck trägt nie die Pullover, die die Jäck ihm strickt."
                            },
                            {
                                "example_id": "a4c49635-6004-4f36-aa5e-e6b861142acb",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jäck kommt, geht der Herr Jäck.“"
                            },
                            {
                                "example_id": "2ce30df6-da13-4528-8bd6-626e1e9d6679",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Jäck kommt und geht."
                            },
                            {
                                "example_id": "c205a66c-2608-4455-bcc1-5f4de0fe0c24",
                                "sense_id": "1caa449a-58f9-382c-87d5-e2c421a91622",
                                "text": "Jäcks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
