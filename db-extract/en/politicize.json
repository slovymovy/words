                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5f50516-1ac7-4d61-892c-a61b55606ffa",
                        "source_entry_id": "defdb873-6335-37b9-95c0-ad4ddf2779ab",
                        "source_sense_description": "to give something political characteristics",
                        "target_lang_word": "politisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a8ab88-0bfb-3de2-93a0-239409373b8b",
                                        "entry_id": "b49b095e-3182-321b-a29f-29f874ff54a3",
                                        "glosses": [
                                            "sich mit jemandem eher laienhaft über politische Themen auseinandersetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8e7695-8d9c-4823-8823-199aebfcf3d5",
                                                "sense_id": "f3a8ab88-0bfb-3de2-93a0-239409373b8b",
                                                "text": "„Drei Häuser weiter rasierte ein barbiere gerade einen Kunden und die beiden politisierten lautstark.“"
                                            },
                                            {
                                                "example_id": "88aa2bb5-5ffb-4e07-a3a8-54a001388513",
                                                "sense_id": "f3a8ab88-0bfb-3de2-93a0-239409373b8b",
                                                "text": "„Gott sei Dank, die beiden roten Republikaner hörten doch jetzt wenigstens auf zu politisieren!“"
                                            },
                                            {
                                                "example_id": "9dc68357-ece6-44b0-8594-93d8eb5181b0",
                                                "sense_id": "f3a8ab88-0bfb-3de2-93a0-239409373b8b",
                                                "text": "„Es stellte sich heraus, daß der Bankangestellte gern mit Alf politisierte, besser - monologisierte.“"
                                            },
                                            {
                                                "example_id": "c02b67ea-dc9f-4e60-af30-09f9554e33c7",
                                                "sense_id": "f3a8ab88-0bfb-3de2-93a0-239409373b8b",
                                                "text": "„Solange er in meinem Haushalt lebt, braucht er eine bessere Entschuldigung, als in Cafés sinnlos zu politisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbaae744-465f-39db-8da1-f320776d8ea2",
                                        "entry_id": "b49b095e-3182-321b-a29f-29f874ff54a3",
                                        "glosses": [
                                            "jemanden zu politischer Aktivität anregen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fbb69bf-9838-4814-bbdf-21acbc1fa3c3",
                                                "sense_id": "bbaae744-465f-39db-8da1-f320776d8ea2",
                                                "text": "„Ihr Ziel war es, die Massen zu politisieren und zu radikalisieren, bis sie die Revolution selbst in die Hand nähmen.“"
                                            },
                                            {
                                                "example_id": "fa768fa3-7225-4339-93d3-30d94dd278c0",
                                                "sense_id": "bbaae744-465f-39db-8da1-f320776d8ea2",
                                                "text": "Man versuchte, die Desinteressierten zu politisieren und auf diese Weise zu veranlassen, wieder an den Wahlen teilzunehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82f6029d-e1ba-3228-94cf-35d23b495cd6",
                                        "entry_id": "b49b095e-3182-321b-a29f-29f874ff54a3",
                                        "glosses": [
                                            "etwas unter politischem Aspekt betrachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe38b3ad-657f-48b2-af1d-ecec79285286",
                                                "sense_id": "82f6029d-e1ba-3228-94cf-35d23b495cd6",
                                                "text": "„Überall auf dem Globus sind in verstärktem Maße fundamentalistische Bewegungen, die als politisierte Religionen nach weltlicher Macht und Einflussnahme streben, auszumachen.“"
                                            },
                                            {
                                                "example_id": "066b82c8-4d1d-46b1-8197-4783bffd98aa",
                                                "sense_id": "82f6029d-e1ba-3228-94cf-35d23b495cd6",
                                                "text": "„Wir politisieren ja die hauptamtlichen oder beamteten Staatssekretäre mehr und mehr.“"
                                            },
                                            {
                                                "example_id": "1618a1d0-172a-48db-a7d8-37e47af50da0",
                                                "sense_id": "82f6029d-e1ba-3228-94cf-35d23b495cd6",
                                                "text": "Man muss private Dinge nicht auch noch politisieren."
                                            },
                                            {
                                                "example_id": "23961e27-5a48-4597-a10e-7e5867da1ab4",
                                                "sense_id": "82f6029d-e1ba-3228-94cf-35d23b495cd6",
                                                "text": "Während im Westen Forschungs- und Meinungsfreiheit wichtige Grundprinzipien sind, wird Bildung in China unter der Herrschaft von Staats- und Parteichef Xi Jinping stark politisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a28b3ee7-65b7-3dcf-96b7-36d1becbf1ec",
                                        "entry_id": "b49b095e-3182-321b-a29f-29f874ff54a3",
                                        "glosses": [
                                            "sich politisch betätigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25b66a5-a8e5-42a3-b856-2a9226ae0f6c",
                                                "sense_id": "a28b3ee7-65b7-3dcf-96b7-36d1becbf1ec",
                                                "text": "„Er politisiert seit neun Jahren für die SVP im St.Galler Kantonsrat.“"
                                            },
                                            {
                                                "example_id": "0876841c-6f0c-4060-aee8-772a304fc4f1",
                                                "sense_id": "a28b3ee7-65b7-3dcf-96b7-36d1becbf1ec",
                                                "text": "Er hat sich endlich entschlossen zu politisieren: Er kandidiert bei den nächsten Kommunalwahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
