                                    {
                                        "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                        "entry_id": "071d43a1-b694-3d7b-965a-7523c93fb09a",
                                        "glosses": [
                                            "The act or state of desisting; cessation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49530794-b3a9-4b06-a2ed-2871839e64bf",
                                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                                "text": "If the writings now sent be seriously perused concerning the common defence, besieging of Bantam, their desistance from the trade of Moluccas, Amboyna, and Banda, their complaints against Declell, and answers to the writings of the Dutch, are confident that the advantage will not appear so great."
                                            },
                                            {
                                                "example_id": "c7679fca-c6a2-483e-b409-5a568f07f392",
                                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                                "text": "This entire decisive desistance from the accustomed resort, has the effect in a few days, to weaken the appetite."
                                            },
                                            {
                                                "example_id": "ad2c85be-1300-47f3-aecc-c7becca38f65",
                                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                                "text": "In 1767, the crown for the first time set forward claims on the territory and revenues of India; but the Company purchased its desistance by a subsidy equivalent to ten or twelve millions of francs."
                                            },
                                            {
                                                "example_id": "eebbf07f-cac5-4764-9b9f-37113a45b29f",
                                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                                "text": "[O]n one side she was defended by the wall of the room and on the other rendered inaccessible by Miriam's mother, who clung to her with a quickly-rooted fidelity, showing no symptom of desistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857ff4bf-b5e0-4030-8225-1d3aacc39d7f",
                        "source_entry_id": "8eb638f0-4ff5-3922-bcee-85286cca0fd8",
                        "target_lang_word": "desistance from crime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aff993fd-b7eb-47c4-a5ba-1b7063c44662",
                        "source_entry_id": "8eb638f0-4ff5-3922-bcee-85286cca0fd8",
                        "target_lang_word": "desistence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desistence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb49856-2d21-3048-8d8e-2deeb85c92cf",
                                        "entry_id": "8cd28050-bf0b-3fdb-b990-2ccf0a4150d8",
                                        "glosses": [
                                            "The act of desisting, especially desisting from criminal activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f552637-7dd4-4e6d-b224-7dc07f561929",
                                                "sense_id": "4bb49856-2d21-3048-8d8e-2deeb85c92cf",
                                                "text": "But that great offensive of promises, engagement formulas, partial desistences, will not become operative, because it seems that the declarations of good will cannot be taken at 100 % of their value."
                                            },
                                            {
                                                "example_id": "329ad897-2580-43f7-968b-71dd362777ea",
                                                "sense_id": "4bb49856-2d21-3048-8d8e-2deeb85c92cf",
                                                "text": "There is little understanding of the factors that lead to desistence."
                                            },
                                            {
                                                "example_id": "2d445107-d04d-405e-a972-de4a7e7a9822",
                                                "sense_id": "4bb49856-2d21-3048-8d8e-2deeb85c92cf",
                                                "text": "Farrell and Maruna (2004) construed the concept of desistence in terms of its primary and secondary manifestations. Whereas primary desistence describes a halt in the commission of criminal behavior, secondary desistence describes a permanent leaving off criminal behavior due to dis-identification with the criminal role."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41f30db3-7e0b-459d-a514-3289888ac9b1",
                        "source_entry_id": "8eb638f0-4ff5-3922-bcee-85286cca0fd8",
