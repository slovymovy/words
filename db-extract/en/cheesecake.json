                        "entry_id": "49d2723c-9c6d-3d60-a9fc-f2f4a7b14e7e",
                        "glosses": [
                            "Imagery of scantily clad, sexually attractive young women; pin-ups."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
