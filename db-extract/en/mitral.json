                                "target_senses": [
                                    {
                                        "sense_id": "fe4fa6cb-d37b-3517-86c9-c32b94c330d6",
                                        "entry_id": "7ba91a97-9f55-325b-8bd8-ca5cc019cef0",
                                        "glosses": [
                                            "die Mitralklappe betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861b9e6a-0ed4-4c10-9fea-f5c1a393286f",
                                                "sense_id": "fe4fa6cb-d37b-3517-86c9-c32b94c330d6",
                                                "text": "Es handelt sich um einen mitralen Infarkt."
                                            },
                                            {
                                                "example_id": "95a42b22-4444-47dd-b9a3-0e2514473527",
                                                "sense_id": "fe4fa6cb-d37b-3517-86c9-c32b94c330d6",
                                                "text": "Man kann ein mitrales Strömungsgeräusch hören."
                                            },
                                            {
                                                "example_id": "abaa5d3c-f6f9-4d66-a33a-ccfb3c95083d",
                                                "sense_id": "fe4fa6cb-d37b-3517-86c9-c32b94c330d6",
                                                "text": "„Zur Herstellung einer bikuspiden Klappe werden die mitralen Anteile des vorderen und hinteren AV-Segels aneinander gelegt und miteinander vernäht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2468b71-3a18-3164-b313-09c26c177b5f",
                                        "entry_id": "7ba91a97-9f55-325b-8bd8-ca5cc019cef0",
                                        "glosses": [
                                            "mit einer runden Basis und zwei Spitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9af204-4229-48d4-8629-36cd25103a2f",
                                                "sense_id": "b2468b71-3a18-3164-b313-09c26c177b5f",
                                                "text": "„Ich muß am Ende noch drei Herzen aus dieser Gruppe besprechen, welche wie die vorigen keinen klinischen Befund hatten, aber zum Unterschied von diesen kein mitralkonfiguriertes Herz, sondern ein mitrales Herzprofil zeigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
