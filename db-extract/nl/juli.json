                                                "sense_id": "c87bf309-8bdc-3e36-8519-cb5a9bc7fe06",
                                                "text": "Le quatorze juillet, Fête nationale de la France."
                                            },
                                            {
                                                "example_id": "3743badc-f668-4575-8fac-e0edd37ebc8c",
                                                "sense_id": "c87bf309-8bdc-3e36-8519-cb5a9bc7fe06",
                                                "text": "La Révolution de juillet, Révolution qui s’accomplit au mois de juillet 1830."
                                            },
                                            {
                                                "example_id": "d4da646e-552f-4f52-816c-d2328d529413",
