                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c46111a6-53b1-4bae-9358-6dafd52cf88a",
                        "entry_id": "0edfb207-b721-3ca8-903f-47cbdc39efed",
                        "tags": [
                            "plural"
                        ],
                        "form": "spinaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0127d294-3b84-383c-a8a9-5941ee1f9cec",
                        "entry_id": "0edfb207-b721-3ca8-903f-47cbdc39efed",
                        "glosses": [
                            "ботан., кулин. шпинат (Spinacia)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611f0c91-18f2-426c-95ea-c4c57f3face5",
                                "sense_id": "0127d294-3b84-383c-a8a9-5941ee1f9cec",
                                "text": "Let cool slightly for 5-10 minutes, then place the apples and spinach in a blender and puree until smooth.",
                                "translation": "Дайте немного остыть в течение 5-10 минут, затем положите яблоки и шпинат в блендер и взбейте пюре до однородности."
                            },
                            {
                                "example_id": "44d31184-f999-45e5-a633-4fee5c1b2b00",
                                "sense_id": "0127d294-3b84-383c-a8a9-5941ee1f9cec",
                                "text": "Common species of vegetables cultivated on the plots were tomato, spinach, potato, sweet potato and chillies.",
                                "translation": "Широко распространенными овощами, выращиваемыми на участках, были томат, шпинат, картофель, батат и перец чили."
                            }
                        ]
                    },
                    {
                        "sense_id": "e412fb92-b592-3ad3-aa27-c85614ded862",
                        "entry_id": "0edfb207-b721-3ca8-903f-47cbdc39efed",
                        "glosses": [
                            "амер. разг. редк. чепуха, ерунда, вздор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb51c165-ad3a-4c8a-945b-8ba34249fad2",
                                "sense_id": "e412fb92-b592-3ad3-aa27-c85614ded862",
                                "text": "I say it's spinach and the hell with it.",
                                "translation": "Я говорю, что это мура, и не спорь со мной."
                            }
                        ]
                    },
                    {
                        "sense_id": "a75977f0-98a3-3d8f-b823-c49fb2a903bd",
                        "entry_id": "0edfb207-b721-3ca8-903f-47cbdc39efed",
                        "glosses": [
                            "разг. гадость, дрянь"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2585cc3c-d34c-3f78-afaf-62c249a62a40",
                        "entry_id": "0edfb207-b721-3ca8-903f-47cbdc39efed",
