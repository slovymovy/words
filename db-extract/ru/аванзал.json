                "senses": [
                    {
                        "sense_id": "15942a53-3b59-3b08-98cb-8336bfafab30",
                        "entry_id": "96a048b2-0c0f-3d4a-b62d-42706d8fb02b",
                        "glosses": [
                            "помещение перед входом в главный зал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824550be-8731-41ae-b914-ade62d7f1d23",
                                "sense_id": "15942a53-3b59-3b08-98cb-8336bfafab30",
                                "text": "Глубина пустынной залы и соседний аванзал оставались во мраке."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe1496a7-8198-3780-a02b-d039775d26ea",
                        "entry_id": "96a048b2-0c0f-3d4a-b62d-42706d8fb02b",
                        "glosses": [
                            "помещение для курения в котором могут находиться: диван, журнальные столики, пепельницы"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "899c9536-6dfc-46ff-949e-36c1bc45d3d9",
                        "source_entry_id": "96a048b2-0c0f-3d4a-b62d-42706d8fb02b",
                        "target_lang_word": "anteroom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anteroom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e0bff9-e7cc-3471-bc67-d72999bf898a",
                                        "entry_id": "ebf5b239-f5c3-3819-af5d-876b33a46f67",
                                        "glosses": [
                                            "A room before, or forming an entrance to, another; a waiting room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c108c55-2ba7-4156-a912-4db13b806002",
                                                "sense_id": "d2e0bff9-e7cc-3471-bc67-d72999bf898a",
                                                "text": "[T]his was one of the anterooms off the main throneroom in which the king was accustomed to hold court with his entire retinue."
                                            },
                                            {
                                                "example_id": "26a2e4f2-94d7-4f18-94c9-5d44cbac3774",
                                                "sense_id": "d2e0bff9-e7cc-3471-bc67-d72999bf898a",
                                                "text": "Several antique games, such as a skiddles table, occupy an upstairs anteroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a17a2dd5-65ce-4ab5-93ac-adb2a316e32a",
                        "source_entry_id": "96a048b2-0c0f-3d4a-b62d-42706d8fb02b",
                        "target_lang_word": "hall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c4d0110-56ad-3790-a963-2698f8b79904",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A corridor; a hallway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c47b75-622d-496d-9e14-ba33f3d92272",
                                                "sense_id": "9c4d0110-56ad-3790-a963-2698f8b79904",
                                                "text": "The drinking fountain was out in the hall."
                                            },
                                            {
                                                "example_id": "a900445f-7d8e-4520-9f63-c09a93e23c64",
                                                "sense_id": "9c4d0110-56ad-3790-a963-2698f8b79904",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c66a1f-10e7-3fc1-9bee-f18330be86d1",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A large meeting room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b54b3a7-fbd6-4664-9c4d-0b5669315017",
                                                "sense_id": "78c66a1f-10e7-3fc1-9bee-f18330be86d1",
                                                "text": "The hotel had three halls for conferences, and two were in use by the convention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f195ee-3ef2-3634-ae6a-8f06ef5655c5",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A manor house (originally because a magistrate's court was held in the hall of his mansion)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b952433b-826d-4a5e-90c8-feb64c5185ca",
                                                "sense_id": "11f195ee-3ef2-3634-ae6a-8f06ef5655c5",
                                                "text": "The duke lived in a great hall overlooking the sea."
                                            },
                                            {
                                                "example_id": "6d7e7cc7-5239-41d1-b430-1603d2235a9b",
                                                "sense_id": "11f195ee-3ef2-3634-ae6a-8f06ef5655c5",
                                                "text": "But Kate, the prettiest Kate in Christendome, Kate of Kate-hall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06431617-5bbb-3cad-8569-21b72fbfbb38",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A building providing student accommodation at a university."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d0c8cdf-4c1f-486a-939e-184759cfd70e",
                                                "sense_id": "06431617-5bbb-3cad-8569-21b72fbfbb38",
                                                "text": "The student government hosted several social events so that students from different halls would intermingle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9bbad2-3006-3ea2-9a38-7ce41b42c464",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "The principal room of a secular medieval building."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c887986-34c7-3655-9c82-4cb2b3e27bef",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "Cleared passageway through a crowd, as for dancing."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff77f5f0-476b-4273-b1e1-28a1f7ebb244",
                                                "sense_id": "3c887986-34c7-3655-9c82-4cb2b3e27bef",
                                                "text": "Then cry, a hall, a hall! Come, father Rosin, with your fiddle now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4015994b-3a30-3c38-8b3e-d61960bb88b0",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A place for special professional education, or for conferring professional degrees or licences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae520e07-ef67-4e96-aeab-d7bea85d4e0f",
                                                "sense_id": "4015994b-3a30-3c38-8b3e-d61960bb88b0",
                                                "text": "a Divinity Hall; Apothecaries' Hall"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ceaf43-5312-3fbd-8ddd-2f2d0c325ccd",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A living room."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e2490d1-f9bd-3695-86d3-ad9fe7c2c66d",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A college's canteen, which is often but not always coterminous with a traditional hall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dafa5c0b-170d-3af0-8936-d43e171eb4ff",
                                        "entry_id": "a3491252-bcf7-3e30-810f-2ba4694b5abb",
                                        "glosses": [
                                            "A meal served and eaten at a college's hall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
