                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea64e459-56d6-4fba-94e2-877c91a3cf9d",
                                                "sense_id": "ac39ebae-3dfc-3149-87a1-77941bbc8e65",
                                                "text": "mounting debts"
