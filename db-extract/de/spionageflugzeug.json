                "senses": [
                    {
                        "sense_id": "dd627f04-ff2e-3927-bdc9-148e800d08e1",
                        "entry_id": "5dbf257d-2a29-337f-99e4-10aede8f9df9",
                        "glosses": [
                            "der militärischen Aufklärung dienendes Flugzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16c5793f-c66a-4a35-ab5c-28ff820b27cc",
                                "sense_id": "dd627f04-ff2e-3927-bdc9-148e800d08e1",
                                "text": "„Ein amerikanisches Spionageflugzeug und ein Abfangjäger der russischen Luftwaffe lieferten sich eine Verfolgungsjagd. Mitten im europäischen Luftraum.“"
                            },
                            {
                                "example_id": "69988392-82b5-42a4-b471-2ef54f530d6c",
                                "sense_id": "dd627f04-ff2e-3927-bdc9-148e800d08e1",
                                "text": "„Diese Tests seien Teil eines Evaluationsprozesses des Pentagon im Bestreben, die über 50-jährige Flotte an (bemannten) Spionageflugzeugen des Typs Lockheed U-2 zu ersetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
