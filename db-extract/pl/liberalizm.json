        "pl-extract.jsonl": [
            {
                "entry_id": "14d05330-1f54-3ee2-b19f-867436be0d8e",
                "word": "liberalizm",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "322a39c6-357c-3d8d-a231-bbff56033fe1",
                        "entry_id": "14d05330-1f54-3ee2-b19f-867436be0d8e",
                        "glosses": [
                            "ideologia i kierunek polityczny, według którego wolność jest nadrzędną wartością"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2815ea91-abb9-4a3b-93cc-9f277f57125b",
                                "sense_id": "322a39c6-357c-3d8d-a231-bbff56033fe1",
                                "text": "W czasie wyborów parlamentarnych niewielką liczbę głosów otrzymały partie głoszące zasady liberalizmu w kwestiach społecznych i gospodarczych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "92f4b86b-52c3-3d2a-9e23-5a9b0a4dcb98",
                        "entry_id": "14d05330-1f54-3ee2-b19f-867436be0d8e",
                        "glosses": [
                            "tolerancyjność wobec poglądów i postaw innych ludzi"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "383b4899-44fb-4159-8e6b-c8b1a4168e42",
                        "source_entry_id": "14d05330-1f54-3ee2-b19f-867436be0d8e",
                        "source_sense_id": "322a39c6-357c-3d8d-a231-bbff56033fe1",
                        "target_lang_word": "liberalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fcca8dc-50e7-3410-8d87-dca1dd68ff55",
                                        "entry_id": "b16da90a-eb7a-3254-935d-62723b92a962",
                                        "glosses": [
                                            "The quality of being liberal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fa4f732-52a6-3be1-b7d4-eb8234d0b890",
                                        "entry_id": "b16da90a-eb7a-3254-935d-62723b92a962",
                                        "glosses": [
                                            "Any political movement founded on the autonomy and personal freedom of the individual, progress and reform, and government by law with the consent of the governed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c208b4db-ea81-4a80-86ee-7545d91b160d",
                                                "sense_id": "7fa4f732-52a6-3be1-b7d4-eb8234d0b890",
                                                "text": "Whether some distant cousin really belongs to the extended family of liberalisms is a matter of healthy dispute."
                                            },
                                            {
                                                "example_id": "705e79b3-1d75-4f3d-a54e-da74139510f5",
                                                "sense_id": "7fa4f732-52a6-3be1-b7d4-eb8234d0b890",
                                                "text": "This poses obvious problems for statistical inference in that what may appear as ‘declines’ in non-white racial liberalism may actually be due to increases in representation of non-black racial/ethnic minorities whose racial attitudes are more conservative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c61264-19b0-3f67-ab91-b06e2eb44c48",
                                        "entry_id": "b16da90a-eb7a-3254-935d-62723b92a962",
                                        "glosses": [
                                            "An economic ideology in favour of laissez faire and the free market (related to economic liberalism)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5900df9-0921-46fb-80e1-5ae4fd3b82d3",
                                                "sense_id": "f5c61264-19b0-3f67-ab91-b06e2eb44c48",
                                                "text": "But liberalism has no obvious answers to the biggest problems we face: ecological collapse and technological disruption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84f2c1b6-5684-4efa-82be-0963c4dcd746",
                        "source_entry_id": "14d05330-1f54-3ee2-b19f-867436be0d8e",
                        "source_sense_id": "322a39c6-357c-3d8d-a231-bbff56033fe1",
                        "target_lang_word": "libéralisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libéralisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb7a8cc-8534-3d31-aa5a-187cc0143bb5",
                                        "entry_id": "6e79aef2-810e-3ee0-92eb-b32bb58f02d8",
                                        "glosses": [
                                            "Doctrine morale et philosophique qui réclame pour tous la liberté des opinions et la liberté de conscience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5377483-37b3-4bdc-9be7-a24a4f41f914",
                                                "sense_id": "5cb7a8cc-8534-3d31-aa5a-187cc0143bb5",
                                                "text": "[…] : le parti clérical prétendait démontrer l’erreur fondamentale du libéralisme ; il organisait partout des sociétés de combat destinées à imposer sa direction au peuple et au gouvernement ; il se vantait de pouvoir bientôt écraser les défenseurs de la Révolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489cd9c6-72e2-3a4c-8e0e-0e9cefde1d46",
                                        "entry_id": "6e79aef2-810e-3ee0-92eb-b32bb58f02d8",
                                        "glosses": [
                                            "Doctrine civile et politique suivant laquelle il faut donner aux citoyens le plus de libertés possible et le plus de garanties possible contre l’ingérence de l’État ou l’arbitraire du gouvernement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc43aea0-2013-43b4-83f7-b057ac2106b6",
                                                "sense_id": "489cd9c6-72e2-3a4c-8e0e-0e9cefde1d46",
                                                "text": "M. Canning et M. De Metternich sont les dieux que ces opinons encensent ou maudissent. Le libéralisme loue le premier de ces hommes d’état cause de sa philanthropie ; les partisans de l’absolutisme ne voient en lui, au contraire, qu’un Procuste étendant les royautés sur le lit fabuleux."
                                            },
                                            {
                                                "example_id": "4850d266-767f-4c0b-8131-f331fc019d78",
                                                "sense_id": "489cd9c6-72e2-3a4c-8e0e-0e9cefde1d46",
                                                "text": "Il y a longtemps que je le dis : le libéralisme ne nous livrera plus de bataille rangée ; il a renoncé aux conspirations, au carbonarisme, aux prises d’armes, il mine en dessous et se prépare à un complet Ote-toi de là que je m’y mette !"
                                            },
                                            {
                                                "example_id": "2151ab9d-0443-49b1-bc69-b8cf06c68a9c",
                                                "sense_id": "489cd9c6-72e2-3a4c-8e0e-0e9cefde1d46",
                                                "text": "La fonction du libéralisme dans le passé a été de mettre une limite aux pouvoirs des rois. La fonction du libéralisme dans l’avenir sera de limiter le pouvoir de parlements soumis à la pression impatiente des masses incultes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc63d39-7716-3094-8eda-f55a5fd03ac1",
                                        "entry_id": "6e79aef2-810e-3ee0-92eb-b32bb58f02d8",
                                        "glosses": [
                                            "Doctrine économique qui s’oppose aux théories protectionnistes ou étatistes."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2e56a7-f1e9-4dc5-984f-9dca42eb513e",
                                                "sense_id": "9dc63d39-7716-3094-8eda-f55a5fd03ac1",
                                                "text": "À l’inverse, l’idéologie si moderne du libéralisme ne parvient à s’imposer qu’en s’appuyant ici et là sur des obscurantismes d’un autre temps."
                                            },
                                            {
                                                "example_id": "9c0d9285-2dc2-4be9-89be-d633e5099355",
                                                "sense_id": "9dc63d39-7716-3094-8eda-f55a5fd03ac1",
                                                "text": "La fin de la guerre froide a permis une floraison d'études sur le nouveau monde, le nouvel ordre international, l’universalisation du libéralisme ou le clash des civilisations. Les avions qui ont foncé sur les tours de New York dans le ciel bleu d'un beau matin de septembre ont jeté le doute sur tous ces exercices."
                                            },
                                            {
                                                "example_id": "85b26c6d-9d13-4e24-8308-31664f64088e",
                                                "sense_id": "9dc63d39-7716-3094-8eda-f55a5fd03ac1",
                                                "text": "Il existe un libéralisme radical, dur, intransigeant, qu’illustre de manière presque trop parfaite Hayek, comme il existe des types de libéralisme plus souples, plus ouverts à certaines questions, ou même à d’autres traditions de pensée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66790cff-9345-4080-a616-1b3169b67aa9",
                        "source_entry_id": "14d05330-1f54-3ee2-b19f-867436be0d8e",
