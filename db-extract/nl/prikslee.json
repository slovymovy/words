                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64a19380-e6ad-3827-810e-39556d76aa9c",
                                        "entry_id": "e89cf379-cd33-3550-a8a9-9d560b83528c",
                                        "glosses": [
                                            "To slide or slip down a slope."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0107cc84-2902-4e61-98e2-6235adcc9674",
                                                "sense_id": "64a19380-e6ad-3827-810e-39556d76aa9c",
                                                "text": "[Norman] Ollestad was only 11 when a small plane carrying him, his father and his father's girlfriend to a ski race slammed into the San Gabriel Mountains west of Los Angeles during a blizzard. […] After the girlfriend luged to her death halfway down the icy slope, Ollestad had to pick his way down alone, following the trail of her blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
