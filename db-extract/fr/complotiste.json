                                        "sense_id": "0273e886-8c9d-3249-bf36-be99a5d81492",
                                        "entry_id": "510c66d0-d95a-3d88-b973-5db7661a1880",
                                        "glosses": [
                                            "jemand, der versucht, Ereignisse, Zustände oder Entwicklungen durch eine geheime Verschwörung zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0f05ec-e092-4304-86c4-293575c8bbfb",
                                                "sense_id": "0273e886-8c9d-3249-bf36-be99a5d81492",
                                                "text": "Besonders nach Attentaten wird Verschwörungstheoretikern viel Platz in den Medien eingeräumt."
                                            },
                                            {
                                                "example_id": "90d25274-ba4d-4851-a265-298cf374491e",
                                                "sense_id": "0273e886-8c9d-3249-bf36-be99a5d81492",
                                                "text": "„Nach dem Spiel zwischen Kamerun und Kroatien, den Leistungen von Honduras und nach den vielen strittigen Schiedsrichterentscheidungen verwandelte sich Brasilien in ein Land der Verschwörungstheoretiker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36eceec7-33ce-43c3-8649-f8b3f2d6db91",
                        "source_entry_id": "d1ef7cde-6ae6-3d22-b0f7-9f26cf701e2e",
                        "source_sense_id": "7ee22943-9e67-3d33-8fbf-47e02e87924d",
                        "target_lang_word": "conspiracist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspiracist",
