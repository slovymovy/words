                        "source_entry_id": "20cc1fc4-3443-3da7-8d47-cb0fe0cf7acc",
                        "source_sense_id": "3ce91482-5528-32e5-b281-ff12f45cf51a",
                        "target_lang_word": "Betonung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betonung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                        "entry_id": "37ec1317-9d27-3fe8-b55e-a32d4356c31b",
                                        "glosses": [
                                            "Hervorhebung einer bestimmten Silbe durch höheren Atemdruck, deutlichere Aussprache, Langziehen der betonungstragenden Silbe oder größere Tonhöhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c4914f7-4ab9-4d44-a029-5518d2f3d311",
                                                "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                                "text": "Die Betonung des Wortes „Schreibtisch“ kann nur auf der ersten Silbe erfolgen: „Schréibtisch“."
                                            },
                                            {
                                                "example_id": "b1eae0f2-947c-4ae7-9202-60d088fefda0",
                                                "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                                "text": "Die Betonung dient in manchen Fällen der Unterscheidung von Wörtern, zum Beispiel bei dem Verb übersetzen: [ˈyːbɐˌzɛt͡sn̩] „ans andere Ufer bringen“ - [ˌyːbɐˈzɛt͡sn̩] „in eine andere Sprache übertragen“."
                                            },
                                            {
                                                "example_id": "412d1d7e-20ff-4d76-a62f-15b5cdee7859",
                                                "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                                "text": "„Als Kennzeichen des Lehnwortes gegenüber dem Fremdwort sieht man meist seine Anpassung an deutsche Sprachgewohnheiten hinsichtlich Lautgebung, Betonung und Beugung, daneben sein Eindringen in die allgemeine Umgangssprache an.“"
                                            },
                                            {
                                                "example_id": "d6e79fc6-9b65-4c3b-9656-228ac3ad62ca",
                                                "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                                "text": "„Durch die bevorzugte Betonung auf der ersten Silbe bot sich für das einprägsame und gedichtete Wort der Reim auf dem Anlaut an, der Stabreim.“"
                                            },
                                            {
                                                "example_id": "e3710c27-cf9f-4d7c-b417-5dc9361f5afd",
                                                "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                                "text": "„In Deutschland wird die Bezeichnung Pastor dagegen seit der Reformation fast ausschließlich für evangelische Geistliche verwendet. Jedoch mit einer anderen Betonung. So lautet der etymologische Bericht: \"Der Pastor, mit Betonung auf der ersten Silbe, ist eine Bezeichnung, die vor allem für die Prediger in protestantischen Gemeinden in Nord- und Mitteldeutschland verwendet wird. Der Pastor dagegen, mit Betonung auf der zweiten Silbe, ist vor allem im Rheinland, sowie am Niederrhein und im Sauerland üblich als Bezeichnung für den katholischen Priester. […]\"“"
                                            },
                                            {
                                                "example_id": "f883f116-b1c3-4019-a536-898efa066d1e",
                                                "sense_id": "2845a88b-76e8-390d-873f-cd683d79757e",
                                                "text": "„In einigen Wörtern ist die Betonung noch unbekannt, hier setzen wir ebenfalls keinen Akzent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "235b85ac-1457-3816-a290-62dd29f0ca42",
                                        "entry_id": "37ec1317-9d27-3fe8-b55e-a32d4356c31b",
                                        "glosses": [
                                            "Gesamtheit der Betonungseigenschaften, des Betonungsverhaltens einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f90403eb-617a-413f-b3da-0d278b6eec9e",
                                                "sense_id": "235b85ac-1457-3816-a290-62dd29f0ca42",
                                                "text": "Die russische Sprache hat eine freie und bewegliche Betonung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5a7f8465-12de-321e-b195-a45834772081",
                                        "entry_id": "37ec1317-9d27-3fe8-b55e-a32d4356c31b",
                                        "glosses": [
                                            "besonderes Hervorheben eines für wichtig erachteten Aspekts"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec284c1-aeba-47f8-b611-a5a9a6184247",
                                                "sense_id": "5a7f8465-12de-321e-b195-a45834772081",
                                                "text": "Ihr kommt es bei der Wahl der Frisur vor allem auf die Betonung ihres Typs an."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
