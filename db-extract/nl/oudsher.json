                            {
                                "example_id": "8e8c8566-bd51-4031-921f-37ba3ee76b7c",
                                "sense_id": "34f5b96e-6923-3aca-b8e6-69af41f2f90c",
                                "text": "De handel is in Nederland van oudsher zeer belangrijk geweest."
                            },
                            {
                                "example_id": "d54eea2f-30d9-4e4a-b587-39519a76fbe4",
                                "sense_id": "34f5b96e-6923-3aca-b8e6-69af41f2f90c",
                                "text": "De kandidatuur van Omtzigt heeft de race ook weer helemaal op z'n kop gezet, stelt Van der Wulp. \"Het CDA is van oudsher een bestuurderspartij. Omtzigt is een kandidaat die juist strijdt tegen te veel macht voor de overheid. Ook hierdoor moeten de CDA-leden scherp kiezen.\""
                            },
                            {
                                "example_id": "1139c9cc-487e-4812-b02f-ab154de43e07",
                                "sense_id": "34f5b96e-6923-3aca-b8e6-69af41f2f90c",
                                "text": "In de verte zien we de Libische Zee, met het eiland Gavdos, het meest zuidelijke punt van Europa, van oudsher een bolwerk van piraten."
                            }
                        ]
                    }
