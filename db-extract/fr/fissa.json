                                        "entry_id": "b5048cc3-ff77-3d50-b6ec-868d55f36e36",
                                        "glosses": [
                                            "Instantaneously; very quickly; in almost no time."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7c8afa-acbc-4227-a95e-200bb0c0f284",
                                                "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                                "text": "It happened so fast that it was all over in a flash."
                                            },
                                            {
                                                "example_id": "d496f1cf-7ef7-4e65-aa50-d06fb5ae9588",
                                                "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                                "text": "Therefore its completeness, though instantaneous, was total. His realisation was in a flash, but it did not vanish like a flash."
                                            },
                                            {
                                                "example_id": "f1e15062-3f54-4e76-ad46-c6137a571e59",
                                                "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                                "text": "“I bet you want to come and live here in this big house in the lap of luxury with me and Biggie, don’t you?”\n“NO,” replied the boy in a flash."
                                            }
                                        ]
                                    }
                                ]
                            }
