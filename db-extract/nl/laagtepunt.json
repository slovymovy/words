                    {
                        "sense_id": "aba340cb-f13b-3e8b-9840-a27f8e62649e",
                        "entry_id": "606bb7d9-11d7-3cb5-84f8-bf6adeda46b7",
                        "glosses": [
                            "kleinste waarde die een grootheid in een bepaalde periode bereikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ea5cd4-15c3-47a1-b055-c8381ae8fd0a",
                                "sense_id": "aba340cb-f13b-3e8b-9840-a27f8e62649e",
                                "text": "De piek van zee-ijs op Antarctica ligt tussen september en oktober, het laagste punt wordt in februari bereikt. De piek ligt meestal rond de 20 miljoen vierkante kilometer, het laagtepunt rond de 3 miljoen."
                            }
                        ]
                    },
                    {
                        "sense_id": "684feddb-35b0-3946-9300-dfe160c20e27",
                        "entry_id": "606bb7d9-11d7-3cb5-84f8-bf6adeda46b7",
                        "glosses": [
                            ") moment waarop iets het slechtst is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6adccedf-9162-4869-add7-f553ca057e44",
                                "sense_id": "684feddb-35b0-3946-9300-dfe160c20e27",
                                "text": "Naar mijn overtuiging behoort de antimilitaristische traditie niet tot de schande maar tot de glorie van de socialistische beweging. Het congres van 1921, waar Mr. Sannes zijn beroemde rede hield, die door het congres met een Internationale beantwoord werd, behoort tot de hoogtepunten van de geschiedenis van het Nederlandse socialisme. Alleen tot grote schade van de socialistische beweging kunnen socialisten het tot een laagtepunt degraderen."
                            }
                        ]
                    }
