                                        "glosses": [
                                            "häufige Male"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b73aab76-86e1-40e1-966f-ce429adadc90",
                                                "sense_id": "29f9d1c3-c530-3388-8f2a-4b8a0e218d6f",
                                                "text": "„Unsre Leute sind zehnmal besser und die Franzosen zehnmal schlechter.“"
                                            },
                                            {
                                                "example_id": "4dbbc0c9-09bb-4137-8f97-bf54f4181819",
                                                "sense_id": "29f9d1c3-c530-3388-8f2a-4b8a0e218d6f",
                                                "text": "„Kinder haben das Gefühl, sie müssten sich noch einmal die Hände waschen, obwohl sie schon wund gewaschen sind, oder sie müssten noch einmal die Tür kontrollieren, obwohl sie es schon zehnmal gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
