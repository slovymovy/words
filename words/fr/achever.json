{
    "word_family": [
        "achèvement",
        "inachevé"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aca74d70-4bd9-35f8-bfbb-85413c30a84c",
                    "sense_definition": "Mener à son terme, finir entièrement une action ou un ouvrage commencé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "terminer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain espère <w>achever</w> son travail avant la fin du mois."
                        },
                        {
                            "text": "Il j'<w>achève</w> la rédaction de mon rapport pour la réunion de demain."
                        }
                    ],
                    "synonyms": [
                        "terminer"
                    ],
                    "antonyms": [
                        "inachever"
                    ],
                    "common_phrases": [
                        "achever son travail",
                        "achever sa tâche"
                    ]
                },
                {
                    "sense_id": "deb575de-c725-3dd8-9709-24841d8f88f9",
                    "sense_definition": "Prendre fin, arriver à son terme.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "terminer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette longue journée de travail s'<w>achève</w> enfin dans le calme."
                        },
                        {
                            "text": "Le spectacle s'<w>est</w> achevé sous les applaudissements chaleureux du public."
                        }
                    ],
                    "antonyms": [
                        "s'inachever"
                    ]
                },
                {
                    "sense_id": "46a4afcf-f656-3665-8986-4855e7080d3e",
                    "sense_definition": "Donner le coup de grâce à un être blessé ou mourant pour le faire mourir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde forestier a dû <w>achever</w> l'animal blessé sur le bord de la route."
                        },
                        {
                            "text": "Les chasseurs durent <w>achever</w> un blessé pour mettre fin à ses souffrances."
                        }
                    ],
                    "common_phrases": [
                        "achever un blessé",
                        "achever un animal"
                    ]
                },
                {
                    "sense_id": "7a0b1f7c-a968-3603-a163-750993cef15b",
                    "sense_definition": "Épuiser moralement ou physiquement quelqu'un, consommer sa ruine ou sa défaite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette dernière mauvaise nouvelle a suffi pour l'<w>achever</w> moralement."
                        },
                        {
                            "text": "La fatigue accumulée durant la semaine a fini par m'<w>achever</w> complètement."
                        }
                    ],
                    "common_phrases": [
                        "achever de ruiner",
                        "achever de convaincre"
                    ]
                }
            ]
        }
    ]
