                                        "entry_id": "7aa49989-ae72-32f7-a153-e9d2fbf24b1b",
                                        "glosses": [
                                            "spadek temperatury powietrza poniżej 0°C, podczas gdy średnia dobowa temperatura powietrza jest dodatnia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf8ff26-c9ba-4881-a974-63dc6299ca04",
                                                "sense_id": "6e8c77b6-40a4-3828-b134-4cd0bba2ea78",
                                                "text": "Przymrozki ścięły kałuże na podwórku."
                                            }
