                "senses": [
                    {
                        "sense_id": "e60e179c-a22d-3f28-945d-d57cad54d0a1",
                        "entry_id": "040edb53-298e-3dbb-a3e1-7980897257ec",
                        "glosses": [
                            "mit Blut bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55830f2a-7f8d-4bed-9c3e-37029622325b",
                                "sense_id": "e60e179c-a22d-3f28-945d-d57cad54d0a1",
                                "text": "„Zombies kreischen mir von der anderen Seite der Barrikade entgegen. Ich bin mittlerweile blutbedeckt und das heizt ihre Gier an.“"
                            },
                            {
                                "example_id": "f92d72f7-dfae-454c-92ff-94ba492d98ca",
                                "sense_id": "e60e179c-a22d-3f28-945d-d57cad54d0a1",
                                "text": "„Ich stand auf, starrte benommen auf die vier Leichen und das blutbedeckte Trottoir, taumelte zum Rinnstein und erbrach mich, bis mir die Brust schmerzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
