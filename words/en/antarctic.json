{
    "word_family": [
        "Antarctica"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                    "sense_definition": "Relating to Antarctica or the regions near the South Pole.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Antarctic</w> climate is extremely cold and harsh for most of the year.",
                            "target_lang_translations": {
                                "zh": "<w>南极</w>的气候一年中大部分时间都极其寒冷恶劣。"
                            }
                        },
                        {
                            "text": "Researchers study the <w>Antarctic</w> ice sheet to understand global climate change.",
                            "target_lang_translations": {
                                "zh": "研究人员通过研究<w>南极</w>冰盖来了解全球气候变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "southern",
                        "polar"
                    ],
                    "antonyms": [
                        "Arctic"
                    ],
                    "common_phrases": [
                        "Antarctic ice",
                        "Antarctic region"
                    ],
                    "target_lang_definitions": {
                        "zh": "与南极洲或南极附近地区有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "南极的",
                                "target_lang_sense_clarification": "指地理位置或气候属于南极地区。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72790ba4-e3bd-38a4-822d-6f5c72597b03",
                    "sense_definition": "Located in or relating to the south.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition moved toward the <w>Antarctic</w> latitudes in search of new data.",
                            "target_lang_translations": {
                                "zh": "探险队向<w>南极</w>纬度地区进发以寻找新数据。"
                            }
                        },
                        {
                            "text": "Many birds migrate to <w>Antarctic</w> waters during the warmer months.",
                            "target_lang_translations": {
                                "zh": "许多鸟类在较温暖的月份迁徙到<w>南极</w>海域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "southern"
                    ],
                    "target_lang_definitions": {
                        "zh": "位于南方或与南方有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "南方的",
                                "target_lang_sense_clarification": "指代地理上的南方方位。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "616c3ffa-f385-30f5-8a84-d42e86800d6e",
                    "sense_definition": "Being the direct opposite or contradictory to something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their opinions on the matter were <w>Antarctic</w> in their total disagreement.",
                            "target_lang_translations": {
                                "zh": "他们对此事的意见<w>截然相反</w>，完全无法达成一致。"
                            }
                        },
                        {
                            "text": "The two theories are <w>Antarctic</w> and cannot be reconciled.",
                            "target_lang_translations": {
                                "zh": "这两种理论<w>截然相反</w>，无法调和。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opposite",
                        "contradictory"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is rare and largely historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与某事物完全相反或矛盾的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "截然相反的",
                                "target_lang_sense_clarification": "形容观点或理论完全对立。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d6da5ee-84a4-3cc6-b191-c65dadb2b6ae",
                    "sense_definition": "Alternative spelling of <w>Antarctic</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some older texts use the lowercase <w>antarctic</w> when referring to the region.",
                            "target_lang_translations": {
                                "zh": "一些旧文献在提及该地区时会使用小写的<w>南极的</w>。"
                            }
                        },
                        {
                            "text": "The <w>antarctic</w> expedition faced severe weather conditions throughout the journey.",
                            "target_lang_translations": {
                                "zh": "这次<w>南极</w>探险在整个旅程中都面临着恶劣的天气条件。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Lowercase variant of the proper adjective."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "Antarctic 的小写拼写变体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "南极的",
                                "target_lang_sense_clarification": "作为形容词使用时的拼写变体。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "79e39b4e-18b1-309c-beda-2199802419eb",
                    "sense_definition": "The vast continental region surrounding the South Pole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Scientists travel to the <w>Antarctic</w> to conduct research on climate change.",
                            "target_lang_translations": {
                                "zh": "科学家们前往<w>南极地区</w>进行气候变化研究。"
                            }
                        },
                        {
                            "text": "Very few people live permanently in the <w>Antarctic</w> due to the extreme cold.",
                            "target_lang_translations": {
                                "zh": "由于极度寒冷，很少有人长期居住在<w>南极地区</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Antarctic"
                    ],
                    "target_lang_definitions": {
                        "zh": "环绕南极点的广阔大陆地区。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "南极地区",
                                "target_lang_sense_clarification": "指代南极洲及其周边区域。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}