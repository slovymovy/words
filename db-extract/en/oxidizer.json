                                    {
                                        "sense_id": "ec2c7fa1-896d-35f8-ba39-3c52e272541e",
                                        "entry_id": "dafe2696-03cc-3868-a5d1-df3054e259c2",
                                        "glosses": [
                                            "Corps oxydant, nécessaire à la combustion. Il est réduit par le combustible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "719d96ab-8d5f-44f1-b0fc-ea0f2586213b",
                                                "sense_id": "ec2c7fa1-896d-35f8-ba39-3c52e272541e",
                                                "text": "Lors de la combustion du bois, le bois est le combustible et le dioxygène, contenu dans l’air, est le comburant."
                                            },
                                            {
                                                "example_id": "26afa5df-5296-4433-99f8-1ae4d0065b0c",
                                                "sense_id": "ec2c7fa1-896d-35f8-ba39-3c52e272541e",
                                                "text": "La poudre noire est stable à température ambiante, mais un petit apport d’énergie suffit à amorcer la réaction, en l’occurrence une combustion lors de laquelle le salpêtre joue le rôle de comburant en libérant de l’oxygène, celui-ci oxydant le soufre et le carbone (les combustibles)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comburant",
                                "target_lang_code": "fr",
                                "target_senses": [
