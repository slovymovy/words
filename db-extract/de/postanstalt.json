                ],
                "senses": [
                    {
                        "sense_id": "7c07e3f9-349f-3007-aa3e-dadd4feed144",
                        "entry_id": "0c7d559e-f7ad-3448-94ad-cb96e02e02d3",
                        "glosses": [
                            "Einrichtung der Post"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf8c9cf-e115-4309-8af7-0b743f1a32bb",
                                "sense_id": "7c07e3f9-349f-3007-aa3e-dadd4feed144",
                                "text": "„Am 21. November 1897 wurde von Dahlberg ein Dekret erlassen, welches die Aufhebung sämtlicher fremdstaatlicher Postanstalten im primatischen Gebiet zum 1. Dezember 1807 anordnete.“"
                            },
                            {
                                "example_id": "e0643d0f-d2c5-40a1-b89c-625b61219cb5",
                                "sense_id": "7c07e3f9-349f-3007-aa3e-dadd4feed144",
                                "text": "„Im Innern nicht an Bahnen gelegene Postanstalten werden durch regelmäßige Botenposten, in Deutsch-Südwestaftika auch durch die landesüblichen Karrenposten und durch Reitposten versorgt.“"
                            },
                            {
                                "example_id": "35b1cf4a-4181-4d49-ba3a-d8e6a1646f4c",
                                "sense_id": "7c07e3f9-349f-3007-aa3e-dadd4feed144",
                                "text": "„Die Postanstalten hatten die Pflicht, diese Flugpostsendungen mit der schnellsten Beförderungsmöglichkeit der nächsten Flugpostanstalt zuzuführen.“"
                            },
                            {
                                "example_id": "fd35d577-819b-427d-9c95-3ef39e7d8504",
                                "sense_id": "7c07e3f9-349f-3007-aa3e-dadd4feed144",
                                "text": "„Hamburg besaß Postanstalten in Harburg und Ritzebüttel, vor dem 30. Juni 1866 auch eine Postagentur auf Helgoland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
