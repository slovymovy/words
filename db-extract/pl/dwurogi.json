                "senses": [
                    {
                        "sense_id": "ac1e59bb-32ff-3dbb-82b6-a5054edd04c4",
                        "entry_id": "a682cf7a-fafe-3e73-98f3-92cac176e97f",
                        "glosses": [
                            "mający dwa rogi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2323d23d-e138-4464-8096-417f237d13ee",
                                "sense_id": "ac1e59bb-32ff-3dbb-82b6-a5054edd04c4",
                                "text": "Włożył swą dwurogą czapkę i pomaszerował dalej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f51616b2-c821-429a-87d5-6f7ff5123ec6",
                        "source_entry_id": "a682cf7a-fafe-3e73-98f3-92cac176e97f",
                        "source_sense_id": "ac1e59bb-32ff-3dbb-82b6-a5054edd04c4",
                        "target_lang_word": "двурогий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "двурогий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0f12201d-b985-3881-b916-63fc77412f7d",
                                        "entry_id": "1b454a2a-96d1-37fe-985d-1f1d8d2dcd2f",
                                        "glosses": [
                                            "имеющий два рога"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb4a7bf-290b-44ef-b452-a788f6591701",
                                                "sense_id": "0f12201d-b985-3881-b916-63fc77412f7d",
                                                "text": "Жук был двурогий, большой, как рак с клешнями, коричнево-красный, несокрушимо крепкий на вид."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb57b272-45aa-3774-b5a0-ed665b91675f",
                                        "entry_id": "1b454a2a-96d1-37fe-985d-1f1d8d2dcd2f",
                                        "glosses": [
                                            "серповидный, с двумя заострёнными краями; формой напоминающий рога буйвола"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f0a722-d7a2-4260-9311-056674469cee",
                                                "sense_id": "eb57b272-45aa-3774-b5a0-ed665b91675f",
                                                "text": "В окошечко с двумя рамами смотрел на неё новый двурогий месяц."
                                            },
                                            {
                                                "example_id": "18fc4200-0dfb-49b2-98b7-ba6d19778a77",
                                                "sense_id": "eb57b272-45aa-3774-b5a0-ed665b91675f",
                                                "text": "Здесь болгарские водолазы обнаружили римские якоря со свинцовыми штоками, множество железных двурогих якорей времен Средневековья и массу современных якорей с поворотными лапами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
