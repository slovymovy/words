                "senses": [
                    {
                        "sense_id": "8aa3a219-cd5b-3322-9233-aaf1df162c1c",
                        "entry_id": "dd3146c5-ad42-324e-b772-64846e5d0fb9",
                        "glosses": [
                            "Feeling chagrin (at something); vexed; fretful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8840c1e2-6610-44f6-b68e-c569b9668afd",
                                "sense_id": "8aa3a219-cd5b-3322-9233-aaf1df162c1c",
                                "text": "She was chagrined to note that the paint had dried into a blotchy mess."
                            },
                            {
                                "example_id": "86c3f222-1b04-4624-9f50-951529bea6da",
                                "sense_id": "8aa3a219-cd5b-3322-9233-aaf1df162c1c",
                                "text": "[…] she had nothing but paste ornaments about her; and therefore, observing her own diamonds on a celebrated courtezan, was so excessively, and indeed justly chagrined, that she left the play-house before the representation was concluded."
                            },
                            {
                                "example_id": "13e294d4-32fb-456b-ba0d-7f5fa34f85c4",
                                "sense_id": "8aa3a219-cd5b-3322-9233-aaf1df162c1c",
                                "text": "[…] I felt in both my breeches pockets, and missing therefrom a set of tablets and a tooth-pick case, I endeavored to account for their disappearance, and, not being able to do so, felt inexpressibly chagrined."
                            },
                            {
                                "example_id": "9beb106e-91a2-407d-a12d-730ce011fcc3",
                                "sense_id": "8aa3a219-cd5b-3322-9233-aaf1df162c1c",
                                "text": "1921, Harold Hunter Armstrong as Henry G. Aikman, Zell, London: Jonathan Cape, Chapter Two, p. 115,\n“She’ll pay it,” Mr. O’Dell told Mr. Jenks with the chagrined expression of a restrained bulldog."
                            },
                            {
                                "example_id": "912413bd-b6df-4edc-bbae-adb6802cd68d",
                                "sense_id": "8aa3a219-cd5b-3322-9233-aaf1df162c1c",
                                "text": "He searched his pockets for money, feeling a little foolish, a little chagrined, having made and lost sums that could colonize a planet, but the woman was moving up the street on shoes with flapping soles and there were no bills or coins in any case to find inside his pants, or documents of any kind."
                            }
                        ]
                    }
