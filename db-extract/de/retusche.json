                                        "entry_id": "eac91043-4a92-3dc4-ba6e-867fd33bb761",
                                        "glosses": [
                                            "To colour the roots of hair to match hair previously coloured."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f7833a8-3cbc-3a28-bb7d-4aaaa5c370ca",
                                        "entry_id": "eac91043-4a92-3dc4-ba6e-867fd33bb761",
                                        "glosses": [
                                            "To modify a flint tool by making secondary flaking along the cutting edge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
