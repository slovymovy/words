                "senses": [
                    {
                        "sense_id": "eae53686-8c73-3913-90e3-c3fa6e8cc5de",
                        "entry_id": "f2f56a67-53d8-37d6-96ef-438200771e4b",
                        "glosses": [
                            "полигр. порядковый номер страницы книги, журнала, газеты и т.д., помещаемый в верхней или нижней части каждой страницы, обычно в наружном углу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10693e12-6720-4fb9-9f31-16bf20099c3d",
                                "sense_id": "eae53686-8c73-3913-90e3-c3fa6e8cc5de",
                                "text": "Как уже отмечалось, нижние колонцифры в заданный формат полосы не входят, то есть кегль колонцифры и отбивку её добавляют к заданному формату полосы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46e32b97-df27-4adb-ae76-66dd577c4f64",
                        "source_entry_id": "f2f56a67-53d8-37d6-96ef-438200771e4b",
                        "source_sense_id": "eae53686-8c73-3913-90e3-c3fa6e8cc5de",
                        "target_lang_word": "folio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6383da9-bbbe-30cd-bf64-295c3482f0ac",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A leaf of a book or manuscript."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3518aa55-388b-473c-bc50-f9e9784df5f3",
                                                "sense_id": "c6383da9-bbbe-30cd-bf64-295c3482f0ac",
                                                "text": "[Thomas] Hood also presented his treatises in such a way that conveniently accessing specific lessons was difficult, if not impossible, for the reader-practitioner. For example, his book entitled The Vse of Both the Globes, Celestiall and Terrestriall... (1592) was roughly two hundred pages long but did not include such helpful tools as an index, a table of contents, or even folio numbers. In order to refer to some lesson that he might need, the reader would have to leaf through the text until the passage in question was found, or else rely upon his own marginal notes."
                                            },
                                            {
                                                "example_id": "6dc2ea80-c08d-4f78-9c8a-a1de0be087d8",
                                                "sense_id": "c6383da9-bbbe-30cd-bf64-295c3482f0ac",
                                                "text": "We saw above that the fourth quire consists of ten folios, two of which (folios 29 and 31) Richer added to a quaternion (folios 23 to 28, 30, 32). Most of the folios Richer added to his manuscript supplement, elaborate, or amend text that he had already composed in the codex. In this quire, however, Richer wrote around the added folios as if it was the quire he added to them, not the converse. Indeed, if we were to remove folios 29 and 31, there would be neither grammatical nor narrative continuity between the original folios of the quire which would face each other, that is, between folios 28^(v[erso]) and 30^(r[ecto]) on the one hand, or folios 30ᵛ and 32ʳ on the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb437da2-681b-3713-bfb4-2fa101e032fc",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A page of a book, that is, one side of a leaf of a book."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02d1fd99-54bc-46c0-bdf6-b79a39f9f91b",
                                                "sense_id": "bb437da2-681b-3713-bfb4-2fa101e032fc",
                                                "text": "Folio Page.—A page which occupies the half of a full sheet of paper, as Post-folio, Demy-folio, etc. Two pages of folio are imposed together as one form, four pages being a perfect sheet. Post-folio and Foolscap-folio, however, are more frequently imposed as four-page forms, and printed on Double-post and Double-foolscap paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010b2d86-fff6-3b13-80ac-6cd5428af27f",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A page number. The even folios are on the left-hand pages and the odd folios on the right-hand pages."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56274bc2-09b0-4274-bc50-e95b343c544d",
                                                "sense_id": "010b2d86-fff6-3b13-80ac-6cd5428af27f",
                                                "text": "Folio.—The running number of the pages of a work. When there is no running title, the folio is placed in the centre of the head-line; when there is a running title, at the outside corner—the even folio on the left, the odd on the right. The preface, contents, index, and all introductory matter, usually have separate folios inserted in Roman lower-case numerals."
                                            },
                                            {
                                                "example_id": "c0f00597-9797-4e4e-bba5-71eda8dcb89a",
                                                "sense_id": "010b2d86-fff6-3b13-80ac-6cd5428af27f",
                                                "text": "verso left-hand page of a book usually identified with even folio numbers. […] recto right-hand page of a book usually identified with odd folio numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "277c2e64-e8c2-3cfd-a2f5-ba3e09d2af4e",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A sheet of paper folded in half."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab1ae7ad-7758-4065-af4b-d8e682ca1c64",
                                                "sense_id": "277c2e64-e8c2-3cfd-a2f5-ba3e09d2af4e",
                                                "text": "This pocket copying-machine, by which letters and writings of all sizes, even folio, may be very quickly copied, consists of a press four inches long, with a small cylinder, which contains pens and ink: the whole apparatus may be conveniently carried in the pocket, and the price is very moderate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40b4498b-414b-327e-8190-d702daa55297",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A book made of sheets of paper each folded in half (two leaves or four pages to the sheet); hence, a book of the largest kind, exceeding 30 centimetres in height."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7acdab28-9ebc-42a1-91eb-44c59d27377d",
                                                "sense_id": "40b4498b-414b-327e-8190-d702daa55297",
                                                "text": "A rare copy of Shakespeare’s First Folio."
                                            },
                                            {
                                                "example_id": "669a448a-55e9-42bf-a5d8-9e6b9a12aa8a",
                                                "sense_id": "40b4498b-414b-327e-8190-d702daa55297",
                                                "text": "A treatiſe in Folio, intitled, The Magazen of Honour, or a Treatiſe concerninge the Nobillitie of England accordinge to the Lawes of England, with their Priviledges in Parliament, & in what caſes noe priviledge, together with the Etymologie, definition & antiquitie of 3 ſortes of Barons."
                                            },
                                            {
                                                "example_id": "cc353179-328a-4576-96b8-0262fc31943c",
                                                "sense_id": "40b4498b-414b-327e-8190-d702daa55297",
                                                "text": "Another, with the bump of order unnaturally developed, had his folios and quartos all reduced, in binding, to one size, so that they might look even on his bookshelves."
                                            },
                                            {
                                                "example_id": "2c0c256e-5f50-4e7f-9c22-c4e4409d1181",
                                                "sense_id": "40b4498b-414b-327e-8190-d702daa55297",
                                                "text": "He [collector Anthony Morris Storer] bequeathed part of his collection to […] Eton College, including the First Folio [of William Shakespeare], a fine copy of the Second Folio, a poor copy of the Third Folio, and the collection of Quartos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686c3bdf-5c08-3fbb-8836-33e9ebb706ef",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A wrapper for loose papers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06b18da1-7d24-370e-bba7-682d2d8fb5c4",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A page in an account book; sometimes, two opposite pages bearing the same serial number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62590d55-d4d4-4b18-ad3a-cbbc9006334d",
                                                "sense_id": "06b18da1-7d24-370e-bba7-682d2d8fb5c4",
                                                "text": "In the leger,^([sic]) articles of the ſame kind are collected together; and, for that purpoſe, it is divided into many accounts, under which the different branches of buſineſs are arranged. Each account is introduced by a proper title, to explain the nature of the articles it contains; and articles of oppoſite kinds, which belong to the ſame account, are placed on the oppoſite pages of the ſame folio: for inſtance, money received on the one ſide, and money paid on the other; or goods bought on the one ſide, and goods ſold on the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d7ca9af-2b36-391c-92c8-798da8329a45",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A protective case with a flap that folds to cover the screen of a mobile device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "210082ce-8869-32f8-a0f4-72adb4f47494",
                                        "entry_id": "e189906e-3207-3a43-9375-bf5430aecc87",
                                        "glosses": [
                                            "A leaf containing a certain number of words; hence, a certain number of words in a piece of writing, as in England, in law proceedings 72, and in chancery, 90; in New York, 100 words."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93273d81-57e8-4ea1-a583-572cf675e4c2",
                                                "sense_id": "210082ce-8869-32f8-a0f4-72adb4f47494",
                                                "text": "[page 172] When actions are brought in the Courts of King's Bench or Common Pleas, founded upon original writs issuing out of the Courts of Chancery (which writs, as stated in the Report of the 9th of April 1816, it is the duty of the Cursitors to make out) it has been the practice in certain cases for the Filacers of the Courts of King's Bench and Common Pleas respectively, to receive from the Suitors the King's fines (if any) and also the fees payable to the Cursitors in respect of such original writs, and afterwards to account to the Cursitors for the fines and fees so received. […] [page 176] The Cursitors have claimed before us a right to compute the skin in all cases, at twenty folios, each folio containing seventy-two words; and to charge 1 s. 4 d. for every folio, instead of the fees now taken per folio or per skin, where the writ in charged in that manner. In support of this claim they have contended, that twenty folios of seventy-two words each, were established by the Order of 1743, as the length of a skin; […] The writ [of Transgress' super Casum], exclusive of the part containing the matter of the declaration, contains less than two folios of seventy-two words each; common counts are stated to contain usually, from two to three folios; special counts are usually longer, and sometimes of a much greater length."
                                            },
                                            {
                                                "example_id": "7d6d17fa-8a09-40a3-a1ec-92104033da49",
                                                "sense_id": "210082ce-8869-32f8-a0f4-72adb4f47494",
                                                "text": "If the office copy of a Will or any part of a Will or other document is required to be made fac-simile, and such Will or part of a Will or other document is two folios of ninety words in length or under, in addition to the fee for the copy … … … … [£]0 1[s.] 0[d.] / If exceeding two folios of ninety words, for every additional folio or part of a folio … … [£]0 0[s.] 6[d.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "folio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44ec5690-7032-301d-91f1-04380469b382",
                                        "entry_id": "91f18a68-4914-360c-98a3-08625a6c50b2",
                                        "glosses": [
                                            "To put a serial number on (a folio or page, or on all the folios or pages of a book); to foliate, to page."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfa08626-0106-4204-b899-5ae728346d73",
                                                "sense_id": "44ec5690-7032-301d-91f1-04380469b382",
                                                "text": "And all the pleadings and other proceedings and copies thereof shall be fairly and legibly written; and if not so written, and folioed, and indorsed as aforesaid, the clerks shall not file such as may be offered to them for that purpose, nor will the court hear any motion or application founded thereon."
                                            },
                                            {
                                                "example_id": "2ae3b674-2395-4321-8c5a-b2beda4b922b",
                                                "sense_id": "44ec5690-7032-301d-91f1-04380469b382",
                                                "text": "Folioing. The rule previously stated as to affidavits and other papers in respect to folioing applies also to petitions. They must be fairly and legibly written and indorsed, and where they are of more than two folios in length must be folioed."
                                            },
                                            {
                                                "example_id": "dbb68dd1-9ba1-465f-a91a-ade97585bb7a",
                                                "sense_id": "44ec5690-7032-301d-91f1-04380469b382",
                                                "text": "Folioing is necessary as an indication how far in his work the poster has proceeded, and must be done in both books immediately after each entry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
