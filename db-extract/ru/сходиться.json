                        ],
                        "form": "сходи́вшийся"
                    },
                    {
                        "form_id": "326fabb6-1b4d-4588-ac89-2447fe671c3f",
                        "entry_id": "0e1fcf9e-a8d6-371d-a7f9-2a62529f6af6",
                        "tags": [
                            "adverbial",
                            "participle",
