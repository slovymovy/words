                "senses": [
                    {
                        "sense_id": "89993b6d-5f87-3da5-873d-b33725a29faf",
                        "entry_id": "d25abd6f-e809-3eec-88f2-54391345ef37",
                        "glosses": [
                            "A chamber where a ship's furnaces are stoked."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1fc41e-4e9e-4896-ab7e-4fae1353c741",
                                "sense_id": "89993b6d-5f87-3da5-873d-b33725a29faf",
                                "text": "Yarrow's patent water tight ash pans are fitted to each boiler, to prevent the fire being extinguished by a sudden influx of water into the stokehold."
                            },
                            {
                                "example_id": "c2cac05f-371d-45a4-b8b6-401b2a89c9cb",
                                "sense_id": "89993b6d-5f87-3da5-873d-b33725a29faf",
                                "text": "A plume of smoke went nearly straight up from the funnel, and now and then the clang of furnace-slice and shovel rose from the stokehold, for Mayne hoped to float the vessel next tide."
                            },
                            {
                                "example_id": "e46fcf86-ac2c-4c5c-89be-877c428332a6",
                                "sense_id": "89993b6d-5f87-3da5-873d-b33725a29faf",
                                "text": "The noise and roar of the engines was ever in my ears, and the peculiar ocean-like noise of the stokehold ... and the metallic clang of coal as it shot from shovels...."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad7dcce1-04f5-48e3-80cc-501a7b09a2a8",
                        "source_entry_id": "d25abd6f-e809-3eec-88f2-54391345ef37",
                        "source_sense_id": "89993b6d-5f87-3da5-873d-b33725a29faf",
                        "source_sense_description": "a chamber where a ship's furnaces are stoked",
                        "target_lang_word": "коте́льная",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коте́льная",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8d856e-1a11-33bd-b380-3beb9268d628",
                                        "entry_id": "ecff8d09-acc3-3a4a-b740-2dbf7284bc96",
                                        "glosses": [
                                            "помещение или здание, в котором установлены паровые котлы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af74e21d-d086-41d5-a50f-dde41d481488",
                                                "sense_id": "ba8d856e-1a11-33bd-b380-3beb9268d628",
                                                "text": "В чисто подметённой котельной у столика кочегара уже сидел мой напарник."
                                            },
                                            {
                                                "example_id": "b71bc292-f3a8-4bf2-9c82-b6912416c8c9",
                                                "sense_id": "ba8d856e-1a11-33bd-b380-3beb9268d628",
                                                "text": "Моя мама работает оператором в котельной гольф-клуба, а папа — механик инженерной службы."
                                            },
                                            {
                                                "example_id": "c31fb5e8-5bb3-408a-a1ae-a51bcbc13080",
                                                "sense_id": "ba8d856e-1a11-33bd-b380-3beb9268d628",
                                                "text": "А не отапливался потому, что котельная соседнего предприятия, к которой был подключён «Молот», вышла из строя."
                                            },
                                            {
                                                "example_id": "3606c5b3-d5a0-4b92-8a9a-bdc9872eae2d",
                                                "sense_id": "ba8d856e-1a11-33bd-b380-3beb9268d628",
                                                "text": "К концу 1990-х годов заказов на торф стало ещё меньше: котельные постепенно переходили на отопление мазутом."
                                            },
                                            {
                                                "example_id": "50dc0c07-0fb6-48a8-b69a-4cccc39004d3",
                                                "sense_id": "ba8d856e-1a11-33bd-b380-3beb9268d628",
                                                "text": "..при снижении выбросов парниковых газов, например при переводе электростанций и котельных с угля на газ, резко уменьшается загрязнение воздуха, что приводит к снижению заболеваемости лёгочными заболеваниями, астмой и т. п."
                                            }
                                        ]
                                    }
                                ]
