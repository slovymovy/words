                "senses": [
                    {
                        "sense_id": "dd633b7d-f4a3-341f-85d0-d2947f437d3f",
                        "entry_id": "1fcfe712-3d11-3b3f-b25f-e2eb5064b4b4",
                        "glosses": [
                            "plaats waar de as van overledenen mag worden uitgestrooid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3607b5f-d7f2-4968-82cb-179f5ade0851",
                                "sense_id": "dd633b7d-f4a3-341f-85d0-d2947f437d3f",
                                "text": "Er is een „groeiende wens van mensen om hun laatste rustplaats in de natuur te vinden”, schreef minister Gerda Verburg (Natuur, CDA) enkele maanden geleden aan de Tweede Kamer. Veel mogelijkheden zijn daarvoor nu nog niet. Er zijn strooiweiden bij crematoria en begraafplaatsen. Er is een nationaal verstrooiterrein bij Arnhem. Maar opgaan in de wilde natuur kan feitelijk alleen bij Staatsbosbeheer in de Brabantse bossen tussen Alphen en Chaam."
                            },
                            {
                                "example_id": "062593d2-330f-4fd7-8241-5cf577df354f",
                                "sense_id": "dd633b7d-f4a3-341f-85d0-d2947f437d3f",
                                "text": "Hij vergeleek het met plassen op de strooiweide van een crematorium. Ik heb stomverbaasd naar hem zitten luisteren. Het is nooit mijn bedoeling geweest om te shockeren, integendeel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e49774-c8b1-4a43-9d92-ca5315652bf9",
                        "source_entry_id": "1fcfe712-3d11-3b3f-b25f-e2eb5064b4b4",
                        "source_sense_id": "dd633b7d-f4a3-341f-85d0-d2947f437d3f",
                        "target_lang_word": "Streuwiese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streuwiese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "735c8781-ec56-3850-a719-05c30653a320",
                                        "entry_id": "23b128be-2dc7-39d4-af53-2b5725d37f48",
                                        "glosses": [
                                            "feuchte Wiese, die zur Gewinnung von Einstreu für das Vieh gemäht wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b929e946-1dcf-47ec-92ea-8daa88bcd2eb",
                                                "sense_id": "735c8781-ec56-3850-a719-05c30653a320",
                                                "text": "Streuwiesen sind artenreiche, aber gefährdete Biotope."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fdc24968-1a02-3000-84e3-6f0cc5a24578",
                                        "entry_id": "23b128be-2dc7-39d4-af53-2b5725d37f48",
                                        "glosses": [
                                            "Wiese zum Verstreuen der Asche Verstorbener"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14bd2418-f40f-4ebb-aa31-89fabe4b18e9",
                                                "sense_id": "fdc24968-1a02-3000-84e3-6f0cc5a24578",
                                                "text": "„Eine Amtsperson verstreut die Asche auf der Streuwiese.“"
                                            },
                                            {
                                                "example_id": "66c804ac-646d-4aaf-ab0a-9bdb81d5d35b",
                                                "sense_id": "fdc24968-1a02-3000-84e3-6f0cc5a24578",
                                                "text": "„In jeder Gemeinde gibt es mindestens ein Urnenfeld, eine Streuwiese und ein Kolumbarium.“"
                                            },
                                            {
                                                "example_id": "75786d6f-d276-416d-8adb-928e5949ac92",
                                                "sense_id": "fdc24968-1a02-3000-84e3-6f0cc5a24578",
                                                "text": "„Erst kürzlich hat die Stadt eine neue Streuwiese nahe des Eingangs Herbesthaler Straße gestaltet, […].“"
                                            },
                                            {
                                                "example_id": "1d26a9d1-caa8-4c4e-89b6-d51347d9c50b",
                                                "sense_id": "fdc24968-1a02-3000-84e3-6f0cc5a24578",
                                                "text": "„Deshalb gibt es in Deutschland nur die Möglichkeit, die Asche auf einer sogenannten Streuwiese eines Friedhofs zu verstreuen.“"
                                            },
                                            {
                                                "example_id": "800cabb8-0308-4b80-8f0f-813f82a8bc4e",
                                                "sense_id": "fdc24968-1a02-3000-84e3-6f0cc5a24578",
                                                "text": "„Die Beisetzung auf einer Streuwiese erfolgt in der Regel anonym, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d07bcc6-cf74-431f-98b8-e778b8bcc278",
                        "source_entry_id": "1fcfe712-3d11-3b3f-b25f-e2eb5064b4b4",
                        "source_sense_id": "dd633b7d-f4a3-341f-85d0-d2947f437d3f",
                        "target_lang_word": "pelouse de dispersion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelouse de dispersion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "381ca0e0-e4e8-3d06-aefb-070851d682d1",
                                        "entry_id": "d880ecb1-161c-3478-a0a4-5348ae6a9d4a",
                                        "glosses": [
                                            "Pelouse réservée à la dispersion des cendres des défunts ayant fait l’objet d’une crémation. Généralement située dans un cimetière ou un crématorium."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737cb7ba-53b8-4a77-bb64-54d1f188656e",
                                                "sense_id": "381ca0e0-e4e8-3d06-aefb-070851d682d1",
                                                "text": "Elle avait demandé d’épandre ses cendres sur la pelouse de dispersion du cimetière de Florenville où reposait son propre père sous une simple dalle en béton."
                                            },
                                            {
                                                "example_id": "ffa13342-5cc6-4f12-a700-2aadd52db7a7",
                                                "sense_id": "381ca0e0-e4e8-3d06-aefb-070851d682d1",
                                                "text": "Pensons aux soignants, aux médecins, aux gardiens de prison, à certains juges, enquêteurs, policiers et gendarmes, aux psychologues, à tous ceux qui œuvrent dans les rites funéraires, les cimetières et les pelouses de dispersion, sans oublier les visiteurs de malades et les personnes qui assurent l’accompagnement en fin de vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
