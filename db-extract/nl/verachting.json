                "translations": [
                    {
                        "translation_id": "e187731c-3352-4287-a199-b8c93b612556",
                        "source_entry_id": "145a479b-a364-3d4f-9d6d-f5d19ff33098",
                        "source_sense_id": "5df6c0a7-dab4-3736-a372-f516a713c3fb",
                        "target_lang_word": "Verachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                        "entry_id": "656a1801-2aca-3136-926d-aeb4b9ac2d7f",
                                        "glosses": [
                                            "ein Zustand der Missachtung, der Abscheu, der Geringschätzung, der nachdrücklichen Beurteilung jemandes oder etwas als schlecht, minderwertig oder abscheulich, der Ignoranz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfc4734-7705-4838-9d85-16f5019724c2",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "So ein Verhalten kann nur mit Verachtung gestraft werden."
                                            },
                                            {
                                                "example_id": "091ece7f-cdca-4c02-b54b-b238f3b75175",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„So stark war seine Verachtung der Journaille, so stark seine Achtung vor formaler Pressefreiheit.“"
                                            },
                                            {
                                                "example_id": "8b11891a-50a7-43e8-bcc1-04e3b4df74a1",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„Manche zeigen ihre Verachtung auch ganz offen, um vor ihren Leuten nicht den Verdacht zu erwecken, sie würden sich mit der deutschen Polizei gemein machen.“"
                                            },
                                            {
                                                "example_id": "83b5c0a5-28ef-4b5e-bffe-482dfdd83434",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„Stets hatte sie auf die Familie ihres Mannes mit Verachtung herabgesehen.“"
                                            },
                                            {
                                                "example_id": "ac3a1be5-bbee-429e-bfc3-ff0dea66d79b",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„Zugleich offenbaren sie, mit welcher Verachtung die Buren auf alle Menschen anderer Hautfarbe blicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9522e04-5b3d-41e5-ab66-b596dd8a73c6",
                        "source_entry_id": "145a479b-a364-3d4f-9d6d-f5d19ff33098",
                        "source_sense_id": "5df6c0a7-dab4-3736-a372-f516a713c3fb",
                        "target_lang_word": "contempt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contempt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "The state or act of contemning; the feeling or attitude of regarding someone or something as inferior, base, or worthless; scorn, disdain."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508c7113-2a50-47af-84d9-24237ef1585a",
                                                "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them."
                                            },
                                            {
                                                "example_id": "674737d0-5f75-4ffc-ad09-2448db4917b7",
                                                "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfe7a73-2c05-3eb9-a648-ae875f94dadb",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "The state of being despised or dishonored; disgrace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "Open disrespect or willful disobedience of the authority of a court of law or legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3711ef46-e0c9-40fe-800a-a27ae8c7ec47",
                                                "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                                "text": "The panel voted unanimously on Tuesday to recommend charging Mr. [Stephen K.] Bannon with criminal contempt of Congress for defying its subpoena, sending the issue to the House."
                                            },
                                            {
                                                "example_id": "5e01cf06-27c9-41fe-8456-9aa0b1297006",
                                                "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                                "text": "Justice Merchan has yet to issue a ruling on whether to find Mr. Trump in contempt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c713316-f579-3e52-b97f-7fa263b932bd",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "Ellipsis of contempt factor."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4983eb94-f87a-4741-8a52-4244cfb0333e",
                        "source_entry_id": "145a479b-a364-3d4f-9d6d-f5d19ff33098",
                        "source_sense_id": "5df6c0a7-dab4-3736-a372-f516a713c3fb",
                        "target_lang_word": "mépris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mépris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                        "entry_id": "48afc96a-677d-3175-8293-e09679e58db1",
                                        "glosses": [
                                            "Sentiment par lequel on juge une personne ou une chose indigne d’estime, d’égards, d’attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f81942-7132-45ea-bb58-595ad8c73191",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "— Ici, c’était le mépris tout pur. Cela m’a fait penser au mot célèbre : on avale le mépris, mais on ne le mâche pas."
                                            },
                                            {
                                                "example_id": "dc9c7b9b-a5a4-49e5-8b1e-6aab2c9fbea1",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Mes camarades commençaient à me prendre en grand mépris, comme on prend ici toute maladie, vous le savez."
                                            },
                                            {
                                                "example_id": "0814b763-c835-4abc-9529-48a28c6eac36",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "S’il ne se soumettait plus au jugement des hommes, il souffrait encore de leur haine, sinon de leur mépris."
                                            },
                                            {
                                                "example_id": "10e1db93-aa2c-4bd7-a819-172acdc7eb25",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Une longue période d’admiration pour l’art médiéval et de mépris pour les temps voltairiens sembla menacer de ruine l’idéologie nouvelle."
                                            },
                                            {
                                                "example_id": "6439de6d-50db-40a8-affc-99d372233a40",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Cette infécondité, qui, de mois en mois, lui fit verser des torrents de larmes, entretint longtemps le mépris de Brigitte, qui lui reprochait de n’être bonne à rien, pas même à faire des enfants."
                                            },
                                            {
                                                "example_id": "4cdd6f4e-e641-4eda-bd39-b973bf06467f",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Mes 30 ans de carrière à la tête de l’assureur GPM m’ont fait découvrir le mépris que l’on peut avoir pour un assuré, mais je n’ai que faire de leur mépris."
                                            },
                                            {
                                                "example_id": "cdba11cb-b377-4b5a-8376-5113b3400e53",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "J’ai dit ça ? s’étonne-t-elle, une mini-pointe de mépris dans la voix."
                                            },
                                            {
                                                "example_id": "cef4e217-8b5a-424f-8ceb-bda8a180e98f",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Alors les retournant et les soupesant : « Charcot, me dit-il, y a-t-il de l’or ou de l’argent là-dedans ? » et devant ma négation, il me les rendit avec mépris."
                                            },
                                            {
                                                "example_id": "6a14432b-f015-4113-a489-1df786d8f299",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Mais nous ne verrons rien dans une pareille phrase qu’un mélange de mépris, d’insulte, de suffisance bourgeoise."
                                            },
                                            {
                                                "example_id": "cf53e8de-361c-4e0d-99f0-9703b84a2ef0",
                                                "sense_id": "93d3216a-6d85-3d7f-a0bb-4055862237fd",
                                                "text": "Le silence, ça n’était rien d’autre que du mépris. Et même la pire des méchancetés, la plus vile saloperie, aurait été préférable à ce mépris-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57d90ba9-803e-3b8d-9584-12542ec70e2c",
                                        "entry_id": "48afc96a-677d-3175-8293-e09679e58db1",
                                        "glosses": [
                                            "Sentiment par lequel on s’élève au-dessus de l’amour de la vie, de la crainte de la mort, du danger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc0f422f-9062-4c9f-9829-9be33fdcf629",
                                                "sense_id": "57d90ba9-803e-3b8d-9584-12542ec70e2c",
                                                "text": "Le mépris de la vie."
                                            },
                                            {
                                                "example_id": "e70bd738-94c5-4925-822b-2ab3e99640c5",
                                                "sense_id": "57d90ba9-803e-3b8d-9584-12542ec70e2c",
                                                "text": "Le mépris de la mort."
                                            },
                                            {
                                                "example_id": "08910f20-1ff9-4232-8f30-cfa41fa2713b",
                                                "sense_id": "57d90ba9-803e-3b8d-9584-12542ec70e2c",
                                                "text": "Le mépris du danger."
                                            },
                                            {
                                                "example_id": "9d7f3209-264a-4647-b981-b463db666b9f",
                                                "sense_id": "57d90ba9-803e-3b8d-9584-12542ec70e2c",
                                                "text": "Le mépris des richesses, des grandeurs, des honneurs, des louanges, etc."
                                            },
                                            {
                                                "example_id": "d52418b2-a902-48c0-b0de-4f8e575593c9",
                                                "sense_id": "57d90ba9-803e-3b8d-9584-12542ec70e2c",
                                                "text": "Contrairement à toutes les idées reçues, Durtal ne pensait pas que le mépris de l’argent impliquât nécessairement la folie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "423aad55-89dc-386b-bd8f-75e8b42ed1dd",
                                        "entry_id": "48afc96a-677d-3175-8293-e09679e58db1",
                                        "glosses": [
                                            "Paroles ou actes de mépris."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c60efc4-64d8-472d-9494-b3daec087745",
                                                "sense_id": "423aad55-89dc-386b-bd8f-75e8b42ed1dd",
                                                "text": "Les mépris que j’ai essuyés de votre part."
                                            },
                                            {
                                                "example_id": "7bd3bc99-b589-407f-b194-8bed08e7bb30",
                                                "sense_id": "423aad55-89dc-386b-bd8f-75e8b42ed1dd",
                                                "text": "Prodiguer à quelqu’un ses mépris."
                                            },
                                            {
                                                "example_id": "e13694d1-76a6-464d-bdce-d9cb220b084f",
                                                "sense_id": "423aad55-89dc-386b-bd8f-75e8b42ed1dd",
                                                "text": "Un tel homme est au-dessus des mépris de la foule."
                                            }
                                        ]
                                    }
                                ]
                            },
