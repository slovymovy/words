                "senses": [
                    {
                        "sense_id": "71300627-2b0e-33e8-8bc5-fabc9c417d02",
                        "entry_id": "3dfe8821-993a-3411-b5db-6d1e31b9a746",
                        "glosses": [
                            "Danube steamship company captain"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ad577cd6-4304-46fe-8b15-ee34f4a140d1",
                                "sense_id": "71300627-2b0e-33e8-8bc5-fabc9c417d02",
                                "text": "»Wenn alle Stricke reißen, könnte er immer noch Donaudampfschifffahrtsgesellschaftskapitän werden«, fand ich, »irgendwie sieht er nach Seebär aus.«",
                                "translation": "\"If all else fails, he could still become a Danube steamship company captain\", I thought. \"He kind of looks like a seadog.\"",
                                "english": "\"If all else fails, he could still become a Danube steamship company captain\", I thought. \"He kind of looks like a seadog.\""
                            },
                            {
                                "example_id": "abbe2479-70a8-4c7b-9a03-b360a92a646f",
                                "sense_id": "71300627-2b0e-33e8-8bc5-fabc9c417d02",
                                "text": "Donaudampfschifffahrtsgesellschaftskapitäne gibt's noch.",
                                "translation": "There are also Danube steamship company captains.",
                                "english": "There are also Danube steamship company captains."
                            },
                            {
                                "example_id": "5ac73a5d-7e6a-4ccc-83b5-c619727319d2",
                                "sense_id": "71300627-2b0e-33e8-8bc5-fabc9c417d02",
                                "text": "An der Donaulände legte ein Ausflugsschiff an. Donaudampfschifffahrtsgesellschaftskapitän, dachte Reitinger.",
                                "translation": "On the Danube-landing a cruise boat docked. Danube steamship company captain Reitinger thought.",
                                "english": "On the Danube-landing a cruise boat docked. Danube steamship company captain Reitinger thought."
                            },
                            {
                                "example_id": "fdf7162f-0f16-4f81-bee7-2016e47da3f8",
                                "sense_id": "71300627-2b0e-33e8-8bc5-fabc9c417d02",
                                "text": "Zum dreißigsten Geburtstag des Donaudampfschifffahrtsgesellschaftskapitäns",
                                "translation": "For the 30th birthday of the Danube steamship company captain",
                                "english": "For the 30th birthday of the Danube steamship company captain"
                            }
                        ]
                    }
