{
    "word_family": [
        "model",
        "modeler",
        "remodel",
        "supermodel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e66c6660-fb0f-3a2a-8480-a13a21e46359",
                    "sense_definition": "The profession or activity of working as a fashion model to display clothes or pose for photographs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to pursue a career in <w>modeling</w> after finishing school.",
                            "target_lang_translations": {
                                "ru": "Она решила сделать карьеру в <w>модельном бизнесе</w> после окончания школы.",
                                "zh": "毕业后，她决定从事<w>模特行业</w>。"
                            }
                        },
                        {
                            "text": "The agency is looking for new faces for fashion <w>modeling</w>.",
                            "target_lang_translations": {
                                "ru": "Агентство ищет новые лица для <w>работы моделью</w> в сфере моды.",
                                "zh": "该机构正在寻找从事时装<w>模特工作</w>的新面孔。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fashion modeling",
                        "career in modeling",
                        "modeling agency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессия или деятельность фотомодели для демонстрации одежды или позирования для фотографий.",
                        "zh": "担任时装模特以展示服装或摆姿势拍照的职业或行业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "модельный бизнес",
                                "target_lang_sense_clarification": "сфера деятельности"
                            },
                            {
                                "target_lang_word": "работа моделью",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模特行业",
                                "target_lang_sense_clarification": "行业"
                            },
                            {
                                "target_lang_word": "模特工作",
                                "target_lang_sense_clarification": "职业活动"
                            },
                            {
                                "target_lang_word": "当模特",
                                "target_lang_sense_clarification": "从事该职业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4e52a51-5b21-32ba-a74b-d591f897cad9",
                    "sense_definition": "The process of creating a mathematical or computer representation of a real-world system or object.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "creation_of_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists use computer <w>modeling</w> to predict future climate changes.",
                            "target_lang_translations": {
                                "ru": "Ученые используют компьютерное <w>моделирование</w> для прогнозирования будущих изменений климата.",
                                "zh": "科学家利用计算机<w>建模</w>来预测未来的气候变化。"
                            }
                        },
                        {
                            "text": "The architect used 3D <w>modeling</w> to show the client the building design.",
                            "target_lang_translations": {
                                "ru": "Архитектор использовал 3D-<w>моделирование</w>, чтобы показать клиенту проект здания.",
                                "zh": "建筑师使用三维<w>建模</w>向客户展示建筑设计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "simulation"
                    ],
                    "common_phrases": [
                        "computer modeling",
                        "data modeling",
                        "financial modeling",
                        "3D modeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс создания математической или компьютерной модели реальной системы или объекта.",
                        "zh": "创建现实系统或物体的数学或计算机表征的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моделирование",
                                "target_lang_sense_clarification": "создание моделей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建模",
                                "target_lang_sense_clarification": "计算机或数学建模"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e264394e-c8d6-3b36-85c8-22058e1f8a62",
                    "sense_definition": "The art or activity of shaping pliable material, such as clay or wax, into a specific form.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation_of_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed clay <w>modeling</w> during their art class.",
                            "target_lang_translations": {
                                "ru": "Детям понравилась <w>лепка</w> из глины на уроке рисования.",
                                "zh": "孩子们在美术课上非常喜欢玩橡皮泥<w>捏塑</w>。"
                            }
                        },
                        {
                            "text": "Her hobby is the <w>modeling</w> of miniature figures from wax.",
                            "target_lang_translations": {
                                "ru": "Её хобби — <w>лепка</w> миниатюрных фигурок из воска.",
                                "zh": "她的爱好是用蜡<w>塑造</w>微型人偶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpting",
                        "moulding"
                    ],
                    "common_phrases": [
                        "clay modeling",
                        "wax modeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или занятие по приданию формы пластичному материалу, такому как глина или воск.",
                        "zh": "将黏土、蜡等易塑材料塑造成特定形状的艺术或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лепка",
                                "target_lang_sense_clarification": "из глины, воска и т.д."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑造",
                                "target_lang_sense_clarification": "塑形、造型"
                            },
                            {
                                "target_lang_word": "捏塑",
                                "target_lang_sense_clarification": "泥塑、捏蜡"
                            },
                            {
                                "target_lang_word": "泥塑",
                                "target_lang_sense_clarification": "黏土造型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39b3a6df-446b-3be0-a582-d4835537ffc3",
                    "sense_definition": "The process of learning a new behavior or skill by observing and imitating others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "learning_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children often learn social skills through the <w>modeling</w> of their parents' behavior.",
                            "target_lang_translations": {
                                "ru": "Дети часто осваивают социальные навыки через <w>копирование</w> поведения своих родителей.",
                                "zh": "儿童通常通过<w>模仿</w>父母的行为来学习社交技能。"
                            }
                        },
                        {
                            "text": "The teacher used behavioral <w>modeling</w> to demonstrate the correct technique.",
                            "target_lang_translations": {
                                "ru": "Учитель использовал поведенческое <w>моделирование</w>, чтобы продемонстрировать правильную технику.",
                                "zh": "老师通过行为<w>示范</w>展示了正确的技术。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imitation",
                        "mimicking"
                    ],
                    "common_phrases": [
                        "behavioral modeling",
                        "role modeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс обучения новому поведению или навыку путем наблюдения и подражания другим.",
                        "zh": "通过观察和模仿他人来学习新行为或技能的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подражание",
                                "target_lang_sense_clarification": "копирование поведения"
                            },
                            {
                                "target_lang_word": "моделирование",
                                "target_lang_sense_clarification": "психологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模仿",
                                "target_lang_sense_clarification": "观察模仿"
                            },
                            {
                                "target_lang_word": "榜样示范",
                                "target_lang_sense_clarification": "示范作用"
                            },
                            {
                                "target_lang_word": "行为建模",
                                "target_lang_sense_clarification": "心理学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79901fb8-0435-32b6-a7da-6e45cb726f44",
                    "sense_definition": "The technique of rendering depth or solidity in a two-dimensional image or drawing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "visual_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist's careful <w>modeling</w> of the face gave the portrait a lifelike quality.",
                            "target_lang_translations": {
                                "ru": "Тщательная <w>моделировка</w> лица художником придала портрету реалистичность.",
                                "zh": "画家对脸部细致的<w>造型</w>赋予了肖像逼真的质感。"
                            }
                        },
                        {
                            "text": "Good <w>modeling</w> with light and shadow creates a sense of volume on the canvas.",
                            "target_lang_translations": {
                                "ru": "Хорошая <w>моделировка</w> светом и тенью создает ощущение объема на холсте.",
                                "zh": "巧妙利用光影进行<w>明暗表现</w>可以在画布上营造出体积感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shading"
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника передачи глубины или объема на двумерном изображении или рисунке.",
                        "zh": "在二维图像或绘画中表现深度或立体感的技法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моделировка",
                                "target_lang_sense_clarification": "в живописи и рисунке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "造型",
                                "target_lang_sense_clarification": "绘画中的体积感塑造"
                            },
                            {
                                "target_lang_word": "明暗表现",
                                "target_lang_sense_clarification": "用明暗表现立体感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b113ff1-bc6c-3522-a920-e00691594ad2",
                    "sense_definition": "Present participle and gerund of <w>model</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>modeling</w> a new line of sportswear for a famous brand.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он <w>демонстрирует</w> новую линию спортивной одежды для известного бренда.",
                                "zh": "他目前正为一个知名品牌<w>展示</w>新款运动服。"
                            }
                        },
                        {
                            "text": "They are <w>modeling</w> the data to find a solution to the problem.",
                            "target_lang_translations": {
                                "ru": "Они <w>моделируют</w> данные, чтобы найти решение проблемы.",
                                "zh": "他们正在对数据进行<w>建模</w>以寻找问题的解决方案。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола model.",
                        "zh": "动词 model 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "одежды, товаров"
                            },
                            {
                                "target_lang_word": "моделирование",
                                "target_lang_sense_clarification": "процесс создания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展示",
                                "target_lang_sense_clarification": "做模特展示衣服等"
                            },
                            {
                                "target_lang_word": "建模",
                                "target_lang_sense_clarification": "建立模型"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}