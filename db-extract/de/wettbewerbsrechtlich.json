                "senses": [
                    {
                        "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                        "entry_id": "b14413e4-5c01-3cfe-92b5-13fb0d9017f3",
                        "glosses": [
                            "das Wettbewerbsrecht/Kartellrecht betreffend, zu ihm gehörend; oft im Zusammenhang mit Fusionen/Firmenzusammenschlüssen benutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee11cf12-fffe-422e-87d1-c0327fc76022",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Das deutsche Urheberrecht sieht zivilrechtliche, strafrechtliche und wettbewerbsrechtliche Instrumentarien vor, um den nicht gestatteten Gebrauch von geschützten Werken zu ahnden.“"
                            },
                            {
                                "example_id": "4b26af2c-9cd1-4f8a-8fb9-66dfa1a5d558",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Die Fusion stieß jedoch auf wettbewerbsrechtlichen Widerstand.“"
                            },
                            {
                                "example_id": "e8975b77-a144-4178-9860-d2bb75560286",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Unklar ist aber, ob die Kartellbehörden der Fusion, die 2014 schon einmal an wettbewerbsrechtlichen Bedenken scheiterte, diesmal genehmigen.“"
                            },
                            {
                                "example_id": "81c663e9-4f28-4fe5-9761-a2200578472a",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Das US-Justizministerium hat Klage gegen die Fusion des Kommunikationsriesen AT&T mit dem Medienkonzern Time Warner eingereicht und führt wettbewerbsrechtliche Bedenken an.“"
                            },
                            {
                                "example_id": "be5a0b07-1990-4020-903c-0a0740829607",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Die Zuständigkeit für die wettbewerbsrechtliche Prüfung des Zusammenschlusses lag allein bei der Europäischen Kommission.“"
                            },
                            {
                                "example_id": "144d2792-598f-46c7-be64-eca7d71ef59c",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "[Bundeskartellamt:] „Die gemeinsamen Marktanteile der Unternehmen rechtfertigten keine wettbewerbsrechtliche Untersagung, hatten die Wettbewerbshüter mitgeteilt.“"
                            },
                            {
                                "example_id": "4288ef75-99bf-47e5-bcd7-81fe92e977da",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Aus wettbewerbsrechtlichen Gründen müssen Gewinnern und Unterlegenen nun zehn Tage Zeit eingeräumt werden, um gegen die Vergabe zu klagen.“"
                            },
                            {
                                "example_id": "fdf69b1b-0153-40ca-882b-18e526fabcef",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Holcim-Präsident Rolf Soiron spricht bei der Megafusion mit Lafarge von einem lange gehegten Traum. Er geht davon aus, dass der neue Weltmarktführer einen Zehntel der Fabriken aus wettbewerbsrechtlichen Gründen verkaufen muss.“"
                            },
                            {
                                "example_id": "6a911487-e66d-4e27-b95d-e1f323fe3595",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Das Bundeskartellamt hat die Übernahme des Mittelbayerischen Verlags durch die PNP gestattet – sie sei aus wettbewerbsrechtlicher Sicht unbedenklich, teilte die Behörde mit.“"
                            },
                            {
                                "example_id": "c4568ca4-8019-4d9b-8b2a-08feeaa27097",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Rechtsgrundlagen für die wettbewerbsrechtliche Einordnung der Zulässigkeit von Hyperlinks sind neben dem UrhG das UWG.“"
                            },
                            {
                                "example_id": "bc57fa33-a738-4718-a474-acbfb7438cb1",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Keine Informationen zu konkreten Fällen, über die noch nicht entschieden worden ist. So hält es die EU-Kommission immer dann, wenn es um wettbewerbsrechtliche Fragen geht.“"
                            },
                            {
                                "example_id": "57073434-2f7a-4d40-9aae-a5acca0c449e",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Nach Strafen der EU wegen wettbewerbsrechtlicher Verstöße in den vergangenen Jahren musste Google bereits mehr als acht Milliarden Euro zahlen.“"
                            },
                            {
                                "example_id": "d8442e23-6af7-49c3-ac0d-8bb96c435a43",
                                "sense_id": "40f0285f-8ab4-3e5f-9861-21c3f820cd7c",
                                "text": "„Hat der israelische Premier B. Netanjahu einem Medienunternehmer wettbewerbsrechtliche Vorteile verschafft im Gegenzug für eine positive Berichterstattung?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
