                "senses": [
                    {
                        "sense_id": "ce3ce50d-34d5-31a9-bc98-48af6d18e945",
                        "entry_id": "5823e4cb-b5b0-3cec-ae52-90291003ac0d",
                        "glosses": [
                            "To make something international; to involve multiple nations in."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "61035ec7-7d5f-4d46-954a-3776f74c83cb",
                                "sense_id": "ce3ce50d-34d5-31a9-bc98-48af6d18e945",
                                "text": "I must say there is something to be said, don't you agree darling, and I rather hope they'll internationalize the cosmic wireless and save us from some of this defatigating news."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "034f8ebf-1ed6-4afb-84c4-1617639c3d3d",
                        "source_entry_id": "5823e4cb-b5b0-3cec-ae52-90291003ac0d",
                        "source_sense_id": "ce3ce50d-34d5-31a9-bc98-48af6d18e945",
                        "source_sense_description": "to make something international",
                        "target_lang_word": "internationaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internationaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b52932c-76c8-3c9c-ad51-6322916d3f87",
                                        "entry_id": "4d0fbd43-c2c2-380c-8c4c-64d84abadfbc",
                                        "glosses": [
                                            "Rendre international, faire en sorte de concerner plusieurs ou toutes les nations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a865548-cfbb-419c-946e-124bcb917458",
                                                "sense_id": "6b52932c-76c8-3c9c-ad51-6322916d3f87",
                                                "text": "– Je comptais obtenir de la Wilhelmstrasse qu’elle étudierait les aspirations de l’Irlande, que, le jour de la Conférence de la Paix, la question irlandaise serait internationalisée, que…"
                                            },
                                            {
                                                "example_id": "fac51356-3144-4d0c-844e-551a7fc182cc",
                                                "sense_id": "6b52932c-76c8-3c9c-ad51-6322916d3f87",
                                                "text": "Internationaliser n’est donc pas angliciser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26892166-e105-4ece-a113-292055052f4d",
                        "source_entry_id": "5823e4cb-b5b0-3cec-ae52-90291003ac0d",
                        "source_sense_id": "ce3ce50d-34d5-31a9-bc98-48af6d18e945",
                        "source_sense_description": "to make something international",
                        "target_lang_word": "internationalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internationalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8c4b94-4be3-3a74-8df0-965386431bbe",
                                        "entry_id": "732cefef-2721-31b4-ac5d-292647f51b43",
                                        "glosses": [
                                            "die Gebietshoheit eines Staates über ein bestimmtes Staatsgebiet zugunsten der internationalen Gemeinschaft beschränken"
                                        ],
                                        "tags": [
                                            "Völkerrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69006203-b1db-49d0-af38-27c1975b789c",
                                                "sense_id": "6d8c4b94-4be3-3a74-8df0-965386431bbe",
                                                "text": "Diese [Studie] kam zu dem Schluss, dass die Bundesrepublik Deutschland nicht verpflichtet sei, den Kanal zu internationalisieren oder anderen Staaten Verkehrsrechte einzuräumen."
                                            },
                                            {
                                                "example_id": "8409f18f-75b0-4ae2-a73b-5122518fe604",
                                                "sense_id": "6d8c4b94-4be3-3a74-8df0-965386431bbe",
                                                "text": "Der Mehrheitsplan sah vor, Palästina in einen arabischen und einen jüdischen Staat zu teilen und Jerusalem als corpus separatum zu internationalisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d25226f8-1471-3a8a-8be5-91ed4eaa1b2d",
                                        "entry_id": "732cefef-2721-31b4-ac5d-292647f51b43",
                                        "glosses": [
                                            "etwas international machen oder international werden"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f7dfdf-3081-4f19-be5f-15ffb779c065",
                                                "sense_id": "d25226f8-1471-3a8a-8be5-91ed4eaa1b2d",
                                                "text": "In den vergangenen Jahren haben europäische Hochschulen damit begonnen, ihre Juristenausbildung zu internationalisieren und teilweise englische Namen anzunehmen."
                                            },
                                            {
                                                "example_id": "34095033-31c3-437b-b7d0-5fb2152189cc",
                                                "sense_id": "d25226f8-1471-3a8a-8be5-91ed4eaa1b2d",
                                                "text": "Die Leitung[,] der Satellitenorganisation wird internationalisiert, und die Technologie der Mitgliedsstaaten wird durch angemessene Verteilung der Aufträge gefördert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
