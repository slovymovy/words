                    {
                        "translation_id": "c2b5ee0f-de8d-4931-9d83-f97418813e00",
                        "source_entry_id": "2092642b-58cb-353c-8c7d-7e72765eea16",
                        "source_sense_id": "00f5788a-a977-3aeb-93f0-2b4fb7096856",
