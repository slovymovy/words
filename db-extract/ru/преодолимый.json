                        ]
                    },
                    {
                        "translation_id": "b6e01b82-ef8b-42f4-a2e3-3f3eece4b356",
                        "source_entry_id": "be892ded-129d-3f6e-a67b-a3a274df7860",
                        "source_sense_id": "7c86eae5-015c-3d11-8bdd-3398f57be03d",
                        "target_lang_word": "bezwingbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezwingbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                        "entry_id": "a7c0084f-01a7-3969-a008-5d6a58a30b8b",
                                        "glosses": [
                                            "so, dass man jemanden oder etwas in einem (Wett-)Kampf besiegen oder überwinden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4472287-6b50-4c2f-9195-0b33454b74e4",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Aber Erdme – die schafft es. Sie steht bis zu den Knien im eiskalten Wasser und sticht und gräbt und gräbt und sticht – quer durch das widerspenstige Wurzelwerk, das manchmal durch keine Menschenkraft bezwingbar scheint.“"
                                            },
                                            {
                                                "example_id": "c4f21838-3598-49d6-a842-10ef5008f8d7",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Sind die weiblichen Unvollkommenkeiten nicht eben so bezwingbar als die männlichen? Ganz gewiß, wenn Sie nur wollen meine Freundinnen!“"
                                            },
                                            {
                                                "example_id": "e55c87b3-33ab-4b1c-8ce1-6293dde750e9",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Sie machten Konstantinopel zu der großartigsten und uns bezwingbarsten Naturfestung des Erdballs.“"
                                            },
                                            {
                                                "example_id": "dbc851c1-4d1c-4425-ac36-9944e1f6274e",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Die letzte Hürde zwischen seinem Felsvorsprung und dem bezwingbareren Gelände war ein etwa einmeterfünfzig breiter Spalt.“"
                                            },
                                            {
                                                "example_id": "531efa71-f120-44b8-ac98-3e6f8eb287ef",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Ziel der Aktion war es gewesen, in der Runde der besten acht Mannschaften Weltmeister Polen aus dem Weg zu gehen. Bulgarien erschien da als bezwingbarerer Gegner.“"
                                            },
                                            {
                                                "example_id": "81a8331a-6d25-4bf8-966b-d5051dadfc46",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Das Team von Gerardo Seoane hatte fast keine Ferien und dies ist den Spielern zu Saisonbeginn schon ein wenig anzumerken, weswegen die Berner vor allem in dieser Phase wohl noch am bezwingbarsten wären.“"
                                            },
                                            {
                                                "example_id": "2718e2c5-3689-409d-8dd7-96a77d899931",
                                                "sense_id": "1cf25ee3-b060-3fb0-98aa-69f6a8f538cf",
                                                "text": "„Im Fürstentum würde der gebürtige Paderborner auf Ex-Bayern-Trainer Niko Kovac treffen, mit Schlussmann Benjamin Lecomte bekäme er es im Vergleich zu Neuer mit einem deutlich bezwingbareren Konkurrenten zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
