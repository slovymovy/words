    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b173660-8fbd-3e19-8ea7-c36c9452c1e4",
                    "sense_definition": "Angry or annoyed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mother gets <w>mad</w> if I come home late.",
                            "target_lang_translations": {
                                "ru": "Моя мама <w>злится</w>, если я прихожу домой поздно.",
                                "zh": "如果我回家晚了，妈妈就会<w>生气</w>。"
                            }
                        },
                        {
                            "text": "Are you still <w>mad</w> at me for breaking the cup?",
                            "target_lang_translations": {
                                "ru": "Ты всё ещё <w>зол</w> на меня за то, что я разбил чашку?",
                                "zh": "你还在因为我打碎了杯子而对我<w>生气</w>吗？"
                            }
                        }
                    ],
                    "antonyms": [
                        "calm",
                        "happy"
                    ],
                    "common_phrases": [
                        "get mad",
                        "mad at",
                        "so mad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "especially North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сердитый или раздраженный.",
                        "zh": "生气或恼火的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злой",
                                "target_lang_sense_clarification": "испытывающий гнев"
                            },
                            {
                                "target_lang_word": "рассерженный",
                                "target_lang_sense_clarification": "выведенный из себя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生气的",
                                "target_lang_sense_clarification": "感到愤怒或不高兴"
                            },
                            {
                                "target_lang_word": "恼火的",
                                "target_lang_sense_clarification": "因为某事而恼怒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54e6a0e6-7873-305d-b69b-cd0230b5b722",
                    "sense_definition": "Mentally ill; insane or crazy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise was enough to drive anyone <w>mad</w>.",
                            "target_lang_translations": {
                                "ru": "Постоянного шума было достаточно, чтобы свести кого угодно <w>с ума</w>.",
                                "zh": "持续不断的噪音足以把任何人逼<w>疯</w>。"
                            }
                        },
                        {
                            "text": "He went <w>mad</w> after living alone on the island for ten years.",
                            "target_lang_translations": {
                                "ru": "Он сошёл <w>с ума</w> после того, как прожил один на острове десять лет.",
                                "zh": "他在岛上独自生活了十年后就<w>疯</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "sane"
                    ],
                    "common_phrases": [
                        "go mad",
                        "drive someone mad",
                        "stark raving mad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически больной; безумный или сумасшедший.",
                        "zh": "精神失常的；疯狂的；发疯的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумасшедший",
                                "target_lang_sense_clarification": "лишенный рассудка"
                            },
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "страдающий психическим расстройством"
                            },
                            {
                                "target_lang_word": "душевнобольной",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疯的",
                                "target_lang_sense_clarification": "失去理智；发疯"
                            },
                            {
                                "target_lang_word": "精神失常的",
                                "target_lang_sense_clarification": "精神状态不正常"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95cb8150-1135-32fb-99d3-5573b386f88d",
                    "sense_definition": "Extremely foolish, irrational, or incredible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>mad</w> idea to go swimming in this freezing weather.",
                            "target_lang_translations": {
                                "ru": "Это <w>безумная</w> идея — идти плавать в такую холодную погоду.",
                                "zh": "这么冷的天气去游泳，真是个<w>荒唐</w>的主意。"
                            }
                        },
                        {
                            "text": "The traffic in the city center is completely <w>mad</w> today.",
                            "target_lang_translations": {
                                "ru": "Движение в центре города сегодня совершенно <w>сумасшедшее</w>.",
                                "zh": "今天市中心的交通状况简直<w>离谱</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "sensible",
                        "wise"
                    ],
                    "common_phrases": [
                        "mad idea",
                        "completely mad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "especially British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно глупый, нерациональный или невероятный.",
                        "zh": "极其愚蠢、不理智或夸张得令人难以置信的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "неразумный, абсурдный"
                            },
                            {
                                "target_lang_word": "сумасшедший",
                                "target_lang_sense_clarification": "невероятный, хаотичный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荒唐的",
                                "target_lang_sense_clarification": "不理智、很不明智"
                            },
                            {
                                "target_lang_word": "离谱的",
                                "target_lang_sense_clarification": "夸张到不合常理；乱得厉害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c80e73b-2024-3fed-9194-428f0bebcd56",
                    "sense_definition": "Extremely enthusiastic about or infatuated with someone or something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion_enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is absolutely <w>mad</w> about football and never misses a game.",
                            "target_lang_translations": {
                                "ru": "Она абсолютно <w>помешана</w> на футболе и никогда не пропускает матчи.",
                                "zh": "她对足球简直<w>着迷</w>，一场比赛都不落下。"
                            }
                        },
                        {
                            "text": "They are <w>mad</w> for the new band that is playing tonight.",
                            "target_lang_translations": {
                                "ru": "Они <w>без ума</w> от новой группы, которая играет сегодня вечером.",
                                "zh": "他们对今晚演出的那支新乐队都很<w>痴迷</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "indifferent"
                    ],
                    "common_phrases": [
                        "mad about",
                        "mad for"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно увлеченный или влюбленный в кого-то или что-то.",
                        "zh": "对某人或某事极其着迷、迷恋或热衷的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "сильно увлеченный чем-то"
                            },
                            {
                                "target_lang_word": "без ума",
                                "target_lang_sense_clarification": "фразеологизм: очень любящий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "着迷",
                                "target_lang_sense_clarification": "对人或事非常喜欢、沉迷"
                            },
                            {
                                "target_lang_word": "痴迷",
                                "target_lang_sense_clarification": "非常迷恋；十分热衷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "602c3c89-f4fa-3b87-9d40-8449a0b4f562",
                    "sense_definition": "Used to indicate a high quality or abundance of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>mad</w> skills on the guitar.",
                            "target_lang_translations": {
                                "ru": "У него <w>бешеные</w> навыки игры на гитаре.",
                                "zh": "他的吉他技术<w>超强</w>。"
                            }
                        },
                        {
                            "text": "I have <w>mad</w> respect for what she achieved in such a short time.",
                            "target_lang_translations": {
                                "ru": "Я испытываю <w>дикое</w> уважение к тому, чего она достигла за столь короткое время.",
                                "zh": "我对她在这么短时间内取得的成就怀有<w>极大</w>的敬意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wicked"
                    ],
                    "common_phrases": [
                        "mad skills",
                        "mad props",
                        "mad respect"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на высокое качество или изобилие чего-либо.",
                        "zh": "俚语，用来表示某事物质量很高、很厉害，或数量很多、程度很强。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "сленг: невероятный, огромный"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "сленг: чрезвычайный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超强的",
                                "target_lang_sense_clarification": "俚语，表示本领或表现非常厉害"
                            },
                            {
                                "target_lang_word": "极大的",
                                "target_lang_sense_clarification": "俚语，表示数量大或程度高"
                            }
                        ]
                    }
                }
            ]
        },
        {
