                    {
                        "sense_id": "fc3c723f-630e-3a49-8dcd-ad4caab4105c",
                        "entry_id": "436e7264-2bc3-3357-8d81-3b2e6e718b1e",
                        "glosses": [
                            "door de gemeenteraad gekozen lid van het dagelijks bestuur van een gemeente dat verantwoordelijk is voor het beleid rond kunst en erfgoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382be9c8-0a73-4438-801e-1d665e966753",
                                "sense_id": "fc3c723f-630e-3a49-8dcd-ad4caab4105c",
                                "text": "De cultuurwethouders van Rotterdam, Den Haag, Amsterdam en Utrecht vragen het Rijk om extra geld vrij te maken voor de culturele sector. Podia, theaters en museums die gesloten moeten blijven vanwege de coronacrisis kunnen de financiële tegenslag niet aan, waarschuwen de wethouders in een op zondag gepubliceerde brief in de Volkskrant."
                            },
                            {
                                "example_id": "2285c0f4-bbb0-467a-8623-77ca88aa0ccd",
                                "sense_id": "fc3c723f-630e-3a49-8dcd-ad4caab4105c",
                                "text": "“We willen graag dat iedereen mee kan doen aan kunst en cultuur”, legt de cultuurwethouder uit."
                            },
                            {
                                "example_id": "5db14fb3-1f7d-4422-abde-162cbac7a8f9",
                                "sense_id": "fc3c723f-630e-3a49-8dcd-ad4caab4105c",
                                "text": "Cultuurwethouder M. Swart vindt het een goed, maar schokkend schilderij, dat “op heel indringende wijze het onderwerp seksueel geweld in de maatschappij zichtbaar maakt”."
                            },
                            {
                                "example_id": "3c99ebd7-87b3-4158-844a-267b1db85e04",
                                "sense_id": "fc3c723f-630e-3a49-8dcd-ad4caab4105c",
                                "text": "⧖ Voor deze cultuurwethouder beteekent cultuur, dat je geld op tafel legt, zocals de Wagner-vereeniging heeft gedaan."
                            }
                        ]
                    }
                ],
