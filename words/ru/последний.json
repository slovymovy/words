{
    "word_family": [
        "после",
        "напоследок",
        "последствие",
        "последовательность",
        "последовать",
        "предпоследний"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2837672b-8d66-3781-b6e1-084c5d03a159",
                    "sense_definition": "Расположенный в конце ряда, очереди или списка; такой, за которым больше никого или ничего нет.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sequence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы едва успели запрыгнуть в <w>последний</w> вагон уходящего поезда.",
                            "target_lang_translations": {
                                "en": "We barely managed to jump into the <w>last</w> car of the departing train.",
                                "zh": "我们勉强跳上了那列火车<w>最后</w>的一节车厢。"
                            }
                        },
                        {
                            "text": "Это был <w>последний</w> дом на нашей улице, дальше начинался лес.",
                            "target_lang_translations": {
                                "en": "It was the <w>last</w> house on our street; the forest began beyond it.",
                                "zh": "那是我们街上<w>最后</w>一栋房子，再往前就是森林了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "конечный",
                        "завершающий"
                    ],
                    "antonyms": [
                        "первый"
                    ],
                    "common_phrases": [
                        "последний этаж",
                        "последний день",
                        "последний в очереди",
                        "последний путь"
                    ],
                    "target_lang_definitions": {
                        "en": "Located at the end of a row, queue, or list; followed by no one or nothing else.",
                        "zh": "位于行列、队列或列表的末尾；其后没有其他人或事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "coming after all others"
                            },
                            {
                                "target_lang_word": "final",
                                "target_lang_sense_clarification": "occurring at the end"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "位于所有事物之后"
                            },
                            {
                                "target_lang_word": "末尾",
                                "target_lang_sense_clarification": "处于终点位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b6c7bc-9ca4-37e8-b372-ec0784f99e54",
                    "sense_definition": "Самый новый, только что появившийся или произошедший недавно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_recency_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты уже слышал <w>последние</w> новости о событиях в мире?",
                            "target_lang_translations": {
                                "en": "Have you already heard the <w>latest</w> news about world events?",
                                "zh": "你听到关于世界局势的<w>最新</w>消息了吗？"
                            }
                        },
                        {
                            "text": "В <w>последнее</w> время погода нас совсем не радует теплом.",
                            "target_lang_translations": {
                                "en": "The weather hasn't been spoiling us with warmth at all <w>lately</w>.",
                                "zh": "<w>最近</w>的天气一点也不暖和。"
                            }
                        }
                    ],
                    "synonyms": [
                        "новейший",
                        "недавний",
                        "свежий"
                    ],
                    "antonyms": [
                        "старый",
                        "давний",
                        "старейший"
                    ],
                    "common_phrases": [
                        "последние новости",
                        "в последнее время",
                        "последняя мода",
                        "последняя модель"
                    ],
                    "target_lang_definitions": {
                        "en": "The newest, most recent, or having just appeared.",
                        "zh": "最新的，刚刚出现或发生的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "latest",
                                "target_lang_sense_clarification": "most recent"
                            },
                            {
                                "target_lang_word": "recent",
                                "target_lang_sense_clarification": "happened lately"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最新",
                                "target_lang_sense_clarification": "时间上最接近现在"
                            },
                            {
                                "target_lang_word": "最近",
                                "target_lang_sense_clarification": "指代近期发生的事情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b36bf0a4-e13e-3aab-8db4-f73fbe824e4b",
                    "sense_definition": "Окончательный, решающий, после которого ничего не изменится.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finality_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор сказал своё <w>последнее</w> слово, и спорить было бесполезно.",
                            "target_lang_translations": {
                                "en": "The director had said his <w>final</w> word, and it was useless to argue.",
                                "zh": "经理说了<w>最终</w>决定，再争论也没用了。"
                            }
                        },
                        {
                            "text": "Это моё <w>последнее</w> предупреждение, в следующий раз я приму меры.",
                            "target_lang_translations": {
                                "en": "This is my <w>final</w> warning; next time I will take measures.",
                                "zh": "这是我<w>最后</w>一次警告，下次我就会采取行动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "заключительный"
                    ],
                    "antonyms": [
                        "предварительный",
                        "временный"
                    ],
                    "common_phrases": [
                        "последнее слово",
                        "последний срок",
                        "в последний раз",
                        "последняя капля"
                    ],
                    "target_lang_definitions": {
                        "en": "Definitive, decisive, after which nothing will change.",
                        "zh": "最终的、决定性的，之后不会再有任何改变。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "final",
                                "target_lang_sense_clarification": "decisive or conclusive"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "definitive"
                            },
                            {
                                "target_lang_word": "ultimate",
                                "target_lang_sense_clarification": "final in a process"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "作为结论或结果"
                            },
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "作为决定性的结论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4a6096d-8551-395f-8fb2-e9d84a559633",
                    "sense_definition": "Оставшийся, единственный сохранившийся из того, что было.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finality_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент потратил свои <w>последние</w> деньги на билет до дома.",
                            "target_lang_translations": {
                                "en": "The student spent his <w>last</w> money on a ticket home.",
                                "zh": "那个学生花光了身上<w>最后</w>的钱买了回家的票。"
                            }
                        },
                        {
                            "text": "Спортсмен собрал <w>последние</w> силы для решающего рывка к финишу.",
                            "target_lang_translations": {
                                "en": "The athlete gathered his <w>last</w> strength for the decisive dash to the finish line.",
                                "zh": "运动员积攒了<w>最后</w>的力气，向终点发起了冲刺。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "последние деньги",
                        "последние силы",
                        "отдать последнее"
                    ],
                    "target_lang_definitions": {
                        "en": "Remaining, the only one preserved of what existed.",
                        "zh": "剩余的，仅存的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "only one remaining"
                            },
                            {
                                "target_lang_word": "remaining",
                                "target_lang_sense_clarification": "left over"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "仅存的"
                            },
                            {
                                "target_lang_word": "剩余",
                                "target_lang_sense_clarification": "剩下的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82d03cc4-0e7d-35eb-9357-9ddaa7bbceb6",
                    "sense_definition": "Упомянутый вторым из двух названных или в конце перечисления.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне предложили чай и кофе, но я выбрал <w>последнее</w>.",
                            "target_lang_translations": {
                                "en": "I was offered tea and coffee, but I chose the <w>latter</w>.",
                                "zh": "他们让我选茶或咖啡，我选了<w>后者</w>。"
                            }
                        },
                        {
                            "text": "Из двух вариантов решения проблемы мы остановились на <w>последнем</w>.",
                            "target_lang_translations": {
                                "en": "Of the two solutions to the problem, we settled on the <w>latter</w>.",
                                "zh": "在解决问题的两个方案中，我们选择了<w>后者</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "первый"
                    ],
                    "target_lang_definitions": {
                        "en": "Mentioned second of two or at the end of an enumeration.",
                        "zh": "在两者中提到的第二个，或在列举中位于末尾的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "latter",
                                "target_lang_sense_clarification": "second of two mentioned"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "last mentioned"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后者",
                                "target_lang_sense_clarification": "两者中提到的第二个"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ec52b07-7099-3bc9-825f-f256e3022448",
                    "sense_definition": "Самый плохой, никудышный, самый низкий по качеству или статусу.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Считать себя самым умным — это <w>последнее</w> дело в нашей команде.",
                            "target_lang_translations": {
                                "en": "Considering yourself the smartest is the <w>lowest</w> thing to do in our team.",
                                "zh": "在我们团队里，自以为最聪明是<w>最差</w>的行为。"
                            }
                        },
                        {
                            "text": "Он вёл себя как <w>последний</w> трус, когда отказался помочь другу в беде.",
                            "target_lang_translations": {
                                "en": "He behaved like a <w>complete</w> coward when he refused to help a friend in trouble.",
                                "zh": "当他拒绝帮助陷入困境的朋友时，表现得像个<w>彻底</w>的懦夫。"
                            }
                        }
                    ],
                    "antonyms": [
                        "элитный",
                        "возвышенный"
                    ],
                    "common_phrases": [
                        "последнее дело",
                        "ругать последними словами",
                        "последний негодяй"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The worst, of the lowest quality or status.",
                        "zh": "最差的，质量或地位最低的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lowest",
                                "target_lang_sense_clarification": "lowest in rank or quality"
                            },
                            {
                                "target_lang_word": "worst",
                                "target_lang_sense_clarification": "of very poor quality"
                            },
                            {
                                "target_lang_word": "complete",
                                "target_lang_sense_clarification": "intensifier for negative traits"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最差",
                                "target_lang_sense_clarification": "质量或品质极低"
                            },
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "用于强调负面特质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}