                        "form": "den Langfinger"
                    },
                    {
                        "form_id": "e6542cc0-0a1b-48e8-bbd4-f74d067e7195",
                        "entry_id": "6c4db122-a1e6-3ff8-b5c4-96b63e062614",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Langfinger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                        "entry_id": "6c4db122-a1e6-3ff8-b5c4-96b63e062614",
                        "glosses": [
                            "jemand, der lange Finger macht, das heißt: sich unrechtmäßig Dinge verschafft"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c02ed4ba-38c4-4b43-9e58-5acdde4328c2",
                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                "text": "Zum dritten Mal in diesem Monat verschafften sich dreiste Langfinger Zutritt zum Warenlager des Ersatzteilhändlers."
                            },
                            {
                                "example_id": "ac4dc001-adac-4d7a-9c49-4a44ec682e3c",
                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                "text": "„[… es] gibt Möglichkeiten die Langfinger abzuschrecken.“"
                            },
                            {
                                "example_id": "a63e6ec4-8f6e-493f-b59a-77c4f7e783d7",
                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                "text": "„Die Hausherrin des achtzehnten Jahrhunderts trug ständig einen riesigen Schlüsselbund um die Taille, die mehr dem Schutz vor Langfingern im eigenen Haus als dem vor Einbrechern diente.“"
                            },
                            {
                                "example_id": "0213fea5-3691-4efe-bf99-466bda5b0007",
                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                "text": "„Die neugegründete Soko „Castle“ hat sich zudem auf Einbrecher spezialisiert. Und dabei Erstaunliches über die Vorlieben einiger Langfinger herausgefunden.“"
                            },
                            {
                                "example_id": "2033a867-2c2a-455d-b59d-05ba9ad7159c",
                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                "text": "„Gerade in der dunklen Jahreszeit versuchen Diebe unbemerkt in die Häuser einzudringen. Einfache Fenster und Türen sind keine großen Hindernisse für die Langfinger.“"
                            },
                            {
                                "example_id": "864be959-0460-47bc-aa92-7e7483fcaa11",
                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                "text": "„[Smartphones gehören zu den] begehrten Objekten für Langfinger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b63501e8-9187-45c0-8ad9-9669ad5a6dec",
                        "source_entry_id": "6c4db122-a1e6-3ff8-b5c4-96b63e062614",
                        "source_sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                        "source_sense_description": "umgangssprachlich: jemand, der lange Finger macht, das heißt: sich unrechtmäßig Dinge verschafft",
                        "target_lang_word": "sticky fingers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sticky fingers",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a19d3a9-2c1c-3828-8ea9-f8b8f2d6e546",
                                        "entry_id": "feadd80d-cc15-32c8-9d1b-8ed5d3ee63a9",
                                        "glosses": [
                                            "An inclination to steal."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b295e9a-4c51-4c24-88cb-ce3817c83806",
                                                "sense_id": "9a19d3a9-2c1c-3828-8ea9-f8b8f2d6e546",
                                                "text": "You'd better lock up your belongings before handing your keys to a valet; some of them have sticky fingers."
                                            },
                                            {
                                                "example_id": "1d4806ae-94db-4b4a-a107-029de4097ef2",
                                                "sense_id": "9a19d3a9-2c1c-3828-8ea9-f8b8f2d6e546",
                                                "text": "‘She was great,’ Bennie said. ‘I was crazy about her. But it turned out she had sticky fingers.’ He glanced at Alex. ‘She stole things.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136e2f9e-bff5-311d-85d0-1520634dea03",
                                        "entry_id": "feadd80d-cc15-32c8-9d1b-8ed5d3ee63a9",
                                        "glosses": [
                                            "Petty thieves."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b771cdee-411b-4c61-b245-4f2ec684d18d",
                                                "sense_id": "136e2f9e-bff5-311d-85d0-1520634dea03",
                                                "text": "There are too many sticky fingers around for me to leave my purse unattended."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sticky fingers",
                                "target_lang_code": "en",
