                        "examples": [
                            {
                                "example_id": "179a8617-a93e-4230-a70e-3aa59c1b524f",
                                "sense_id": "654a0a8b-7b92-3032-8a0f-eb0d71d3d276",
                                "text": "Bei der Bestellung einer Ware einem Versandhaus, muss die entsprechende Bestellnummer des Artikels angegeben werden."
                            },
                            {
                                "example_id": "089c00af-45fa-4725-8435-a81f7d54c581",
                                "sense_id": "654a0a8b-7b92-3032-8a0f-eb0d71d3d276",
                                "text": "„Ich wich ihrem Blick aus und starrte auf den Bildschirm, wo die Bestellnummer für den Bauchmuskeltrainer rot aufleuchtete, 676881.“"
                            }
                        ],
