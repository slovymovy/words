                        "sense_id": "8c2a9eb1-224c-3556-a660-810dedcb9412",
                        "entry_id": "e793c061-f800-39e6-a9dc-0918577acd05",
                        "glosses": [
                            "Something which might be mistaken for, but which is not, a beast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6cf8d02-742a-4171-88c7-9b8a109e4bca",
                                "sense_id": "8c2a9eb1-224c-3556-a660-810dedcb9412",
                                "text": "That was no beast, said Irc scornfully into his mind. That was an unbeast. Twisty and nasty. Keep your eye out for more, Hem said."
                            },
                            {
                                "example_id": "52065fbd-bdec-4c5d-87d5-ee0e6f784b3c",
                                "sense_id": "8c2a9eb1-224c-3556-a660-810dedcb9412",
                                "text": "We don't deserve the epitaph of \"Beasts,\" for the natural beasts learned a long time ago what harmony in their ecosystems was. We are the plastic unbeasts called men. We kill our own flesh for spiritual reasons cloaked in patriotism. Were has our own animal gone? Are we so intellectually trapped that only didactic philosophies are left?"
                            }
                        ]
                    }
