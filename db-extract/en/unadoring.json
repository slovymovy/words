                        "examples": [
                            {
                                "example_id": "b45c090b-a2a9-4f11-808a-d50d0a55eb3f",
                                "sense_id": "307b256c-a281-31f0-ad9c-fc0fb870df55",
                                "text": "A man who had been more frequently contradicted and thwarted, who had learned to put up with criticism from kind but unadoring comrades, would have been more tolerant[…]"
                            },
                            {
                                "example_id": "00cdebd3-9b86-49e8-8714-59b4a34e473c",
                                "sense_id": "307b256c-a281-31f0-ad9c-fc0fb870df55",
                                "text": "I don't believe very young mothers ever get wrapped up in their babies. It's when women are older that they so adore their children, and maybe it's better for the children to have young unadoring mothers and to lead more detached lives."
                            }
                        ]
                    }
