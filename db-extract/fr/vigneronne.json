                "senses": [
                    {
                        "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                        "entry_id": "54dd78bb-a640-302a-a417-4557db6ac4bc",
                        "glosses": [
                            "Féminin singulier de vigneron."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "45ce517a-caa4-47a8-bd17-357a541a582c",
                                "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                "text": "En juillet, Visan honore le vin au cours d’une fête haute en couleurs : portée en procession au son des galoubets et des tambourins, une souche enrubannée, ornée de pampres de vignes, est bénie puis symboliquement brûlée, puis, à coups de masse, le roi, la reine et le lieutenant de la confrérie vigneronne locale, élus du jour, cassent le « marot » (pan de mur, vestige du château), pour “désencaver” les magnums de la cuvée précédente, après une année de vieillissement."
                            },
                            {
                                "example_id": "93066283-213d-4a0d-b4f1-4b1572460a34",
                                "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                "text": "La fondue vigneronne est une fondue où viande, fruits de mer et légumes sont trempés dans du vin blanc bouillant pour y être cuits avant d’être dégustés."
                            },
                            {
                                "example_id": "27047513-fe1c-4253-9b5e-457cf27fb22b",
                                "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                "text": "La sauce vigneronne se prépare avec des échalotes finement hachées, du vin rouge, du vinaigre balsamique, des herbes de Provence, et de l’huile d’olive."
                            }
                        ]
                    }
                ],
