                "translations": [
                    {
                        "translation_id": "167eb2c1-f0d7-45b2-a167-ca4d78d6dfd0",
                        "source_entry_id": "3e544bc3-557a-33fa-b9bc-774599d282e5",
                        "source_sense_id": "28ceee85-9cf4-3cb5-87f8-155bc7d69d94",
                        "source_sense_description": "een peloton dat een executie uitvoert, een vuurpeloton",
                        "target_lang_word": "Erschießungskommando",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erschießungskommando",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63cbdbc2-c70c-3929-9cbe-8a8a9f6df8a6",
                                        "entry_id": "e6a5be65-fe59-33bc-b262-a1464f95b3a8",
                                        "glosses": [
                                            "für eine Hinrichtung gebildete Gruppe von Personen mit Schusswaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037aafdd-10e7-4669-b3cc-08f244b8b012",
                                                "sense_id": "63cbdbc2-c70c-3929-9cbe-8a8a9f6df8a6",
                                                "text": "„‚Das Erschießungskommando ist archaisch, es ist brutal, und es macht die Gewalt, die unsere Gesellschaft ohnehin durch Waffen erleidet, nur schlimmer‘, klagt Salt Lake Citys Bischof John Wester.“"
                                            },
                                            {
                                                "example_id": "28983e94-cba4-4d51-985b-506f87fae456",
                                                "sense_id": "63cbdbc2-c70c-3929-9cbe-8a8a9f6df8a6",
                                                "text": "„[…] In der Ukraine ermordeten Nazis und ihre Verbündeten viele Juden nicht mit Gas, sondern durch Erschießungskommandos.“"
                                            },
                                            {
                                                "example_id": "2687eb4d-3b14-4797-ae6e-a83c8cf73b7c",
                                                "sense_id": "63cbdbc2-c70c-3929-9cbe-8a8a9f6df8a6",
                                                "text": "„Er wurde in Fresnes wegen Hochverrats zum Tode verurteilt und am 15. Oktober 1945 durch ein Erschießungskommando hingerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a18edfb-5f7f-40dd-a7c9-7f3f25fb24e7",
                        "source_entry_id": "3e544bc3-557a-33fa-b9bc-774599d282e5",
                        "source_sense_id": "28ceee85-9cf4-3cb5-87f8-155bc7d69d94",
                        "source_sense_description": "een peloton dat een executie uitvoert, een vuurpeloton",
                        "target_lang_word": "Exekutionskommando",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ad10e3a9-080e-4c7c-94dd-1951812058bd",
                        "source_entry_id": "3e544bc3-557a-33fa-b9bc-774599d282e5",
                        "source_sense_id": "28ceee85-9cf4-3cb5-87f8-155bc7d69d94",
                        "source_sense_description": "een peloton dat een executie uitvoert, een vuurpeloton",
                        "target_lang_word": "Peloton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Peloton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "943d96f5-0af3-349c-8fe0-803c37f5aa24",
                                        "entry_id": "6a2888da-b66c-3c7d-8198-088cb72447df",
                                        "glosses": [
                                            "geschlossenes Feld oder Hauptfeld im Straßenrennen"
                                        ],
                                        "tags": [
                                            "Radsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ea2c18-b278-433a-a792-d6ae15b2db27",
                                                "sense_id": "943d96f5-0af3-349c-8fe0-803c37f5aa24",
                                                "text": "Mit großem Peloton seien die jedes Mal unterwegs gewesen, zwei Polizeimotorräder vorneweg und zwei mit Blaulicht hinter dem Feld."
                                            },
                                            {
                                                "example_id": "3feb41a9-5c56-4b02-b1b3-902d2e385820",
                                                "sense_id": "943d96f5-0af3-349c-8fe0-803c37f5aa24",
                                                "text": "Ohnehin sind viele im Peloton verbreitete illegale Mittel mit den jetzigen Blut- und Urinanalysen noch nicht nachweisbar etwa Wachstumshormone und neue Epo-Varianten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cc34de7-a2ef-352e-8cd6-efef10f4324d",
                                        "entry_id": "6a2888da-b66c-3c7d-8198-088cb72447df",
                                        "glosses": [
                                            "kleiner Trupp"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de63e58-a794-41ab-a048-294c0e20ab46",
                                                "sense_id": "8cc34de7-a2ef-352e-8cd6-efef10f4324d",
                                                "text": "Ein Peloton Infanterie hielt in der Nähe des Wassers Schießübung, welche der Colonel selbst überwachte."
                                            },
                                            {
                                                "example_id": "1e0392bd-ac4d-4db8-a1f8-8a5d262db17a",
                                                "sense_id": "8cc34de7-a2ef-352e-8cd6-efef10f4324d",
                                                "text": "Sofort wurde mir ein ungeschriebenes Militärgesetz erläutert, wonach der Soldat bei solch seltenem Ergebnis gehalten wäre, das ganze Peloton mit einem Faß Bier freizuhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "849c4e68-1ab3-3325-8a21-3d035ea6ddd7",
                                        "entry_id": "6a2888da-b66c-3c7d-8198-088cb72447df",
                                        "glosses": [
                                            "Kommando zur Durchführung einer Exekution"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10576165-c5d4-4a0b-a41e-8d52a0933dda",
                                                "sense_id": "849c4e68-1ab3-3325-8a21-3d035ea6ddd7",
                                                "text": "»Also im zweiten Jahre meiner Abfahrt von Hamburg stand ich als Gefreiter in dem Peloton, das als Exekutionskommando in den Festungsgraben befehligt worden war. …«"
                                            },
                                            {
                                                "example_id": "ebb578de-b180-4a15-9c18-23d33b9be1d6",
                                                "sense_id": "849c4e68-1ab3-3325-8a21-3d035ea6ddd7",
                                                "text": "Einige murrten, – doch niemand wagte, dem Befehl sich zu widersetzen, – das Peloton stellte sich wieder in Reih und Glied, – die Gewehre wurden angeschlagen, – der Erzbischof stand allein in der Nähe der Mauer des Hofes, das Kreuz vor die Brust gedrückt, – freudige Verklärung in seinen Blicken."
                                            },
                                            {
                                                "example_id": "68b1978d-6b43-472b-a37d-3d756e125622",
                                                "sense_id": "849c4e68-1ab3-3325-8a21-3d035ea6ddd7",
                                                "text": "„Er endete trotz dieser Redlichkeit und trotz seiner Kooperationsbereitschaft mit der SS vor dem Peloton.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
