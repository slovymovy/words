                                "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
                                "text": "killing everybody is a stupid idea, and comatosing everybody is equally so."
                            },
                            {
                                "example_id": "43629503-674d-4439-8c1a-7d6396cd0553",
                                "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
