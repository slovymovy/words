                ],
                "senses": [
                    {
                        "sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                        "entry_id": "1b1a71b3-ae88-3660-817c-cb3588fc71db",
                        "glosses": [
                            "Gelände, auf dem sich Gebäude und weitere Anlagen einer Universität befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12a7317-33ed-407c-8634-1a5663a098da",
                                "sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                                "text": "Sie verabredeten sich für acht Uhr auf dem Campus."
                            },
                            {
                                "example_id": "e6f404db-2280-4121-97dd-ab9a2808afb1",
                                "sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                                "text": "„Nach dem Abitur schrieb sie sich an der Uni für Theater-, Film- und Fernsehwissenschaften ein, und wenn wir uns zufällig auf dem Campus trafen, tranken wir Kaffee zusammen und verwunderten einander mit Details aus unseren Leben.“"
                            },
                            {
                                "example_id": "a9b71404-e2fb-435d-9688-7a8a31fa3140",
                                "sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                                "text": "„Sophies erster Termin führte uns auf den Campus der Universität von Dakar.“"
                            },
                            {
                                "example_id": "401bdc2f-8b74-4414-a053-b64faa4ac1f8",
                                "sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                                "text": "„Roth wollte fort, er wollte auf einem richtigen Campus leben, unter anderem, weil dort ein weniger verstohlenes Liebesleben winkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2d4022e-5cc9-49de-ae7b-78aa0c8f5479",
                        "source_entry_id": "1b1a71b3-ae88-3660-817c-cb3588fc71db",
                        "source_sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                        "source_sense_description": "Gelände, auf dem sich Gebäude und weitere Anlagen einer Universität befinden",
                        "target_lang_word": "campus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee1aa986-9a69-322c-a546-f1dc3358f3a6",
                                        "entry_id": "35bfe5a6-bbff-398f-a6b6-1e2c6f7b25b6",
                                        "glosses": [
                                            "The grounds or property of a school, college, university, business, church, or hospital, often understood to include buildings and other structures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b233ef49-5d86-49af-830a-f15ad464d6b2",
                                                "sense_id": "ee1aa986-9a69-322c-a546-f1dc3358f3a6",
                                                "text": "The campus is sixty hectares in size."
                                            },
                                            {
                                                "example_id": "9a674b5b-f587-462a-b190-2c5ab2c3178e",
                                                "sense_id": "ee1aa986-9a69-322c-a546-f1dc3358f3a6",
                                                "text": "From their corporate campuses on the west coast, America’s technology entrepreneurs used to ignore faraway Washington, DC—or mention the place only to chastise it for holding back innovation with excessive regulation. They have, at times, invested in the low politics of self-interested lobbying […]. Yet unlike Wall Street[…]tech tycoons have remained largely aloof from the broader affairs of the nation’s capital."
                                            },
                                            {
                                                "example_id": "0fb5e7f2-7a25-49f9-8ab1-f2d7779f40c7",
                                                "sense_id": "ee1aa986-9a69-322c-a546-f1dc3358f3a6",
                                                "text": "In addition to this signage there are promotional videos broadcast in English on television screens around the campus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "935f54ae-d389-345f-a09a-f6a0a40b5e23",
                                        "entry_id": "35bfe5a6-bbff-398f-a6b6-1e2c6f7b25b6",
                                        "glosses": [
                                            "An institution of higher education and its ambiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e120f1a6-7703-451b-a997-632ee48bd0fd",
                                                "sense_id": "935f54ae-d389-345f-a09a-f6a0a40b5e23",
                                                "text": "During the late 1960s, many an American campus was in a state of turmoil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "campus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a3e733-4176-3543-9365-ce5c36c415b3",
                                        "entry_id": "a394eb2a-f0f6-3ac4-9103-598ca2218a20",
                                        "glosses": [
                                            "To confine (a student) to campus as a punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f147bc5-ee4c-4eea-af6b-4a2ec23428bc",
                                                "sense_id": "30a3e733-4176-3543-9365-ce5c36c415b3",
                                                "text": "They hold sessions regularly and “campus” women for staying out late—and they do their best campussing at those times when they are sleepiest and meanest from being out until three and four themselves the night before."
                                            },
                                            {
                                                "example_id": "62d5bd57-144f-4810-b4d4-9833c42057b5",
                                                "sense_id": "30a3e733-4176-3543-9365-ce5c36c415b3",
                                                "text": "A secondary punishment was ‘campussing’, or confinement to a campus; and for the most trivial offences the treatment was a withering harangue from Mrs Wilmington, sometimes lasting for over an hour."
                                            },
                                            {
                                                "example_id": "6e3ab49e-2001-42d8-80d8-4dbfce2594c3",
                                                "sense_id": "30a3e733-4176-3543-9365-ce5c36c415b3",
                                                "text": "SM has been very patient but just last Friday one of them was campussed for two weeks with an automatic two day suspension if he didn't heed the campussing because of repeated contempt for fairly easy to fulfill sentences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a251cf4-e628-38db-917d-1f50a3602ad5",
                                        "entry_id": "a394eb2a-f0f6-3ac4-9103-598ca2218a20",
                                        "glosses": [
                                            "To use a campus board, or to climb without feet as one would on a campus board."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b23304fa-016b-45a9-ab0a-dc71b98e9088",
                                                "sense_id": "5a251cf4-e628-38db-917d-1f50a3602ad5",
                                                "text": "It is climbed or \"campused\" with only your arms and hands."
                                            },
                                            {
                                                "example_id": "4c2b291b-97fb-4b38-8924-b84a176297a3",
                                                "sense_id": "5a251cf4-e628-38db-917d-1f50a3602ad5",
                                                "text": "Boulder campusing is a popular indoor training exercise among advanced climbers—it's also a heck of a lot of fun if you're strong enough to do it right!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "999308a9-6f5b-4cdc-b641-19b0204fee54",
                        "source_entry_id": "1b1a71b3-ae88-3660-817c-cb3588fc71db",
                        "source_sense_id": "30abe959-5a79-30ec-a13f-f97c961c6b34",
                        "source_sense_description": "Gelände, auf dem sich Gebäude und weitere Anlagen einer Universität befinden",
                        "target_lang_word": "campus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4394d82-a306-33f0-b508-20a979e69fa3",
                                        "entry_id": "17ca9cd9-03ab-3f4a-a493-0c40e3a4e3f1",
                                        "glosses": [
                                            "Vaste ensemble de bâtiments universitaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202f4146-326c-4d02-8039-b250584ed458",
                                                "sense_id": "e4394d82-a306-33f0-b508-20a979e69fa3",
                                                "text": "Retrouvez dans cette rubrique toutes les infos concernant la vie sur le campus : la culture, le sport, la restauration et logement, la santé et social."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
