{
    "word_family": [
        "staminate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                    "sense_definition": "The energy and strength for continuing to do something over a long period of time; power of sustained exertion, or resistance to hardship, illness etc.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_mental_endurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a lot of <w>stamina</w> and can run for a long time.",
                            "target_lang_translations": {
                                "ru": "У него большая <w>выносливость</w>, и он может долго бежать."
                            }
                        },
                        {
                            "text": "The marathon runner showed incredible <w>stamina</w> to finish the race.",
                            "target_lang_translations": {
                                "ru": "Марафонец проявил невероятную <w>выносливость</w>, чтобы закончить забег."
                            }
                        }
                    ],
                    "synonyms": [
                        "endurance",
                        "resilience",
                        "vitality"
                    ],
                    "antonyms": [
                        "weakness"
                    ],
                    "common_phrases": [
                        "build up stamina",
                        "physical stamina"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергия и сила для продолжения какой-либо деятельности в течение длительного времени; способность к длительному напряжению или сопротивляемость трудностям, болезням и т. д."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносливость",
                                "target_lang_sense_clarification": "способность организма переносить длительные физические или психические нагрузки"
                            },
                            {
                                "target_lang_word": "выдержка",
                                "target_lang_sense_clarification": "способность сохранять самообладание и терпение в трудных условиях"
                            },
                            {
                                "target_lang_word": "стойкость",
                                "target_lang_sense_clarification": "способность твердо переносить испытания и невзгоды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7205072-e209-322a-a481-569e527b61d5",
                    "sense_definition": "The basic elements of a thing; rudimentary structures or qualities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stamina</w> of the new theory was not yet fully developed.",
                            "target_lang_translations": {
                                "ru": "Основа новой теории была еще не полностью разработана."
                            }
                        },
                        {
                            "text": "He examined the <w>stamina</w> of the argument to see if it held any truth.",
                            "target_lang_translations": {
                                "ru": "Он изучил суть аргумента, чтобы понять, есть ли в нем доля правды."
                            }
                        }
                    ],
                    "synonyms": [
                        "essence",
                        "foundation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основные элементы чего-либо; базовые структуры или качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "фундаментальная часть или база чего-либо"
                            },
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "внутреннее содержание или главная суть предмета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                    "sense_definition": "The plural form of <w>stamen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flower's <w>stamina</w> were covered in yellow pollen.",
                            "target_lang_translations": {
                                "ru": "Тычинки цветка были покрыты желтой пыльцой."
                            }
                        },
                        {
                            "text": "Botanists often count the <w>stamina</w> to identify the plant species.",
                            "target_lang_translations": {
                                "ru": "Ботаники часто пересчитывают тычинки, чтобы определить вид растения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Plural form of stamen."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «тычинка» (ботанический термин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычинки",
                                "target_lang_sense_clarification": "репродуктивные органы цветка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
