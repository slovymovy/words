                ],
                "senses": [
                    {
                        "sense_id": "c8826068-1640-341f-a27d-5d9ccb442c77",
                        "entry_id": "18274f66-928b-33b0-be51-265db5d42437",
                        "glosses": [
                            "een klok die aan de muur hangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8f7acd-a67e-4f63-82c9-34373ec2e6af",
                                "sense_id": "c8826068-1640-341f-a27d-5d9ccb442c77",
                                "text": "Twintig torenuurwerken, circa vijftien hangklokken, negentien staande klokken en daarnaast ook nog eens wekkers, horloges en zonnewijzers staan uitgestald op de eerste verdieping van de Bibliotheek Hof van Twente in Goor. Bij binnenkomst van het gebouw lijkt het stil. De begane grond van de bibliotheek is, op rekken met boeken na, leeg."
                            },
                            {
                                "example_id": "a1030431-f05d-41e4-adde-763698fb2913",
                                "sense_id": "c8826068-1640-341f-a27d-5d9ccb442c77",
                                "text": "Nee, dan luister ik toch liever naar het mechaniek van zo’n grote antieke hangklok. Je hoort hoe de tandwielen in elkaar grijpen, hoe de seconden even loom als onverbiddelijk wegtikken. Laat je meevoeren door dat geluid en voordat je het weet ben je aan de beurt: ‘Dag meneer, wat mag ik voor u betekenen?’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0717b057-8629-47c0-8ead-a08200914573",
                        "source_entry_id": "18274f66-928b-33b0-be51-265db5d42437",
                        "source_sense_id": "c8826068-1640-341f-a27d-5d9ccb442c77",
                        "target_lang_word": "hanging clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "12817b77-b65f-484f-bf3c-66d1609d058e",
                        "source_entry_id": "18274f66-928b-33b0-be51-265db5d42437",
                        "source_sense_id": "c8826068-1640-341f-a27d-5d9ccb442c77",
                        "target_lang_word": "wall clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wall clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6448a51-dfbe-3d07-ab8c-341a5952b365",
                                        "entry_id": "7d2a6f55-5c02-3b02-9ff4-534705a81e0d",
                                        "glosses": [
                                            "A clock mounted on a wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72cceb34-e278-32de-8eef-8a99823f0f10",
                                        "entry_id": "7d2a6f55-5c02-3b02-9ff4-534705a81e0d",
                                        "glosses": [
                                            "The measure of wall time, the actual amount of time taken from the start to the end of an operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1847840d-3fce-4878-9453-2765824cd9c2",
                                                "sense_id": "72cceb34-e278-32de-8eef-8a99823f0f10",
                                                "text": "In recent years a consensus has been reached among many scientists in the field that the most relevant measure of run time is actual wall-clock elapsed time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1158ee26-2104-47da-b1de-d19207fa7564",
                        "source_entry_id": "18274f66-928b-33b0-be51-265db5d42437",
                        "source_sense_id": "c8826068-1640-341f-a27d-5d9ccb442c77",
                        "target_lang_word": "clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29fb87a7-b07d-3fb3-97ad-74f0310a9b56",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "A chronometer, an instrument that measures time, particularly the time of day."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99885bf3-1007-4c7e-9e29-76db9469dd3a",
                                                "sense_id": "29fb87a7-b07d-3fb3-97ad-74f0310a9b56",
                                                "text": "When the clock says midnight."
                                            },
                                            {
                                                "example_id": "d11fa5c8-6c9a-4679-bd36-f9b543699e3c",
                                                "sense_id": "29fb87a7-b07d-3fb3-97ad-74f0310a9b56",
                                                "text": "The seasons bring the flower again,\n⁠And bring the firstling to the flock;\n⁠And in the dusk of thee, the clock\nBeats out the little lives of men."
                                            },
                                            {
                                                "example_id": "543230ae-c290-440d-b77d-f73d26c64272",
                                                "sense_id": "29fb87a7-b07d-3fb3-97ad-74f0310a9b56",
                                                "text": "An interesting feature of the church is the invisible clock, which you can hear thumping away as you enter. Constructed in 1525, it is one of the oldest timepieces in England. It chimes the hours and the quarters, and every three hours it plays a hymn. But it has no faces."
                                            },
                                            {
                                                "example_id": "1a4ec2de-0104-4b0f-bde7-ccb4622883c8",
                                                "sense_id": "29fb87a7-b07d-3fb3-97ad-74f0310a9b56",
                                                "text": "In the June days of 1848 Baudelaire reports seeing revolutionaries (he might have been one of them) going through the streets of Paris with rifles, shooting all the clocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68dabed-51f4-37fd-ac8c-05419a00461a",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "A common noun relating to an instrument that measures or keeps track of time."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f68769ce-d4e4-4aea-b990-33f088ba78d2",
                                                "sense_id": "f68dabed-51f4-37fd-ac8c-05419a00461a",
                                                "text": "A 12-hour clock system; an antique clock sale; Acme is a clock manufacturer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91bc5738-3af8-3f93-a200-4b7b54e91596",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "The odometer of a motor vehicle."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8bdf37a-66ba-4670-9eca-03030c55d575",
                                                "sense_id": "91bc5738-3af8-3f93-a200-4b7b54e91596",
                                                "text": "This car has over 300,000 miles on the clock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f49783-78f3-3ea1-846b-52ed5b2619f7",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "An electrical signal that synchronizes timing among digital circuits of semiconductor chips or modules."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c88a8c8-dba9-3966-9c03-aad413dfda0c",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "The seed head of a dandelion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddab51b0-69d8-35a4-9f18-37b00d3687af",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "A time clock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d2a1c7-4c48-4e85-aa38-9d5b6bde157d",
                                                "sense_id": "ddab51b0-69d8-35a4-9f18-37b00d3687af",
                                                "text": "I can't go off to lunch yet: I'm still on the clock."
                                            },
                                            {
                                                "example_id": "374f255a-dca9-49fe-9e4c-2ab88af00510",
                                                "sense_id": "ddab51b0-69d8-35a4-9f18-37b00d3687af",
                                                "text": "We let the guys use the shop's tools and equipment for their own projects as long as they're off the clock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a38406-3dff-34ff-92fa-b2c7caff745f",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "A CPU clock cycle, or T-state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c974dc-5ee6-4e0e-957c-4509901bebf5",
                                                "sense_id": "d0a38406-3dff-34ff-92fa-b2c7caff745f",
                                                "text": "Executing a NEXT to code takes 7 clocks, or 1.05 microseconds."
                                            },
                                            {
                                                "example_id": "84b2a371-3db1-4a3a-8d38-9f0d4784d4cb",
                                                "sense_id": "d0a38406-3dff-34ff-92fa-b2c7caff745f",
                                                "text": "The best schedule produced by any hardware algorithm takes 7 clocks, whereas the statically reordered code in Figure 1.2(b) takes only 5 clocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6f38b63-1ef9-33df-8329-85ab10bb994f",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "A luck-based patience or solitaire card game with the cards laid out to represent the face of a clock."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a7c5f30-d632-3170-9d59-53237ec0aca8",
                                        "entry_id": "163c87c9-f1b0-32ee-b9da-fe87865fc9d0",
                                        "glosses": [
                                            "A watch (timepiece)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a295e6-346d-4f3c-bf5f-4b662c4a420d",
                                                "sense_id": "3a7c5f30-d632-3170-9d59-53237ec0aca8",
                                                "text": "Arthur Morrison, Chance of the Game\nBut if the clock was a red 'un, and the opportunity undoubted; to be pinched in the Bow Road merely might well imply loss of caste in the mob, but nobody need be ashamed to be pinched anywhere for a gold watch, after all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b35c931-635e-317a-a676-3bf3bf2eb0f3",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To measure the duration of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab5f0938-4cf9-37c7-9927-dec90518c631",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To measure the speed of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644d33d8-40de-4c6f-a3bf-0b4e756183f0",
                                                "sense_id": "ab5f0938-4cf9-37c7-9927-dec90518c631",
                                                "text": "He was clocked at 155 miles per hour."
                                            },
                                            {
                                                "example_id": "e31a142b-f0ed-4580-b691-2c8bb0744aad",
                                                "sense_id": "ab5f0938-4cf9-37c7-9927-dec90518c631",
                                                "text": "Dan Patch clocked a scorching 1:55.5 flat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e65af52-7f59-3d0d-b599-7f9a0a03ad20",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To hit (someone) heavily."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bd4b83-996d-4ab5-857a-4475ed95ef6e",
                                                "sense_id": "8e65af52-7f59-3d0d-b599-7f9a0a03ad20",
                                                "text": "When the boxer let down his guard, his opponent clocked him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To notice; to take notice of (someone or something)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2ba12e-3d09-4736-a7af-8ed0728d3514",
                                                "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                                "text": "Clock the wheels on that car!"
                                            },
                                            {
                                                "example_id": "834e16f2-2e80-4b3c-8c9c-9bb45bcd36e3",
                                                "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                                "text": "It is true. Carmen is an official gold digger. In fact, she is an instructor at the school of gold digging. Hood rats have been clocking her style for years. Wanting to pull the players she pulled, and wishing they had the looks she had."
                                            },
                                            {
                                                "example_id": "e538a2d0-78b1-45fe-b750-b2d39bd4bcd6",
                                                "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                                "text": "Cut to the pub on a lads night out, / Man at the bar cos it was his shout, / Clocks this bird and she looks OK, / Caught him looking and she walks his way,"
                                            },
                                            {
                                                "example_id": "04797c51-55fe-4021-8603-df6cdc95e3c8",
                                                "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                                "text": "First it was only when I was with him—we would pass a pretty girl, I would notice her first, and my eyes would dart to his to see him clock her."
                                            },
                                            {
                                                "example_id": "dc4d5780-ef19-4091-8f4b-a971f7551746",
                                                "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                                "text": "He made it to ten yards away. Still they hadn't clocked him. Five yards. He felt increasingly confident about grabbing the actual thief, even if it meant letting the other lad get away. Both were pretty scrawny kids, although the other one was quite a bit older, maybe twenty,[…]"
                                            },
                                            {
                                                "example_id": "76320f80-f9be-45c2-940f-1b05c5dce639",
                                                "sense_id": "0b315c2d-3190-3db0-affb-c7ee74949d4e",
                                                "text": "I had just long enough at Lancaster to clock another plaque to a great Victorian railway engineer, Joseph Locke (1805-60)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f5b9ba-a0af-3ec0-8ae5-37392e9347b8",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To recognize; to assess, register."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b1ea4ad-f1d6-432e-8752-2895c95308d7",
                                                "sense_id": "f2f5b9ba-a0af-3ec0-8ae5-37392e9347b8",
                                                "text": "I'd already clocked her as someone who couldn't reliably be believed when she spoke. And now this too!"
                                            },
                                            {
                                                "example_id": "71b783a9-ccb7-46d5-ba95-39db6486693f",
                                                "sense_id": "f2f5b9ba-a0af-3ec0-8ae5-37392e9347b8",
                                                "text": "Bo John and I twisted our heads around as Miranda braked over to the gravelly shoulder, let the Scout wheeze to a stop. She was climbing out, hurrying back to whatever had caught her eye. Bo John leered into the door mirror, clocking her flouncing, leggy strut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90f2f10-ab50-3678-b422-b022a28d054f",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To identify (someone) as having some attribute (for example, being trans or gay)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48ed7b8-19d2-487e-96fe-08d6f7869a14",
                                                "sense_id": "f90f2f10-ab50-3678-b422-b022a28d054f",
                                                "text": "Once my transition was complete I considered moving to London, where I felt there was less chance of being clocked and a larger support network."
                                            },
                                            {
                                                "example_id": "4b1a5d10-2ce8-4f77-a7c8-45d1e07aafc3",
                                                "sense_id": "f90f2f10-ab50-3678-b422-b022a28d054f",
                                                "text": "Jaz said that the palpitations of fear he used to experience at the prospect of being publicly outed in the gurdwara dissipated after he clocked other gay Sikhs in there, even one who professed a Jat caste identity, he said – Jatness being associated with stereotypical dominant macho masculinity. He reflected that this was a major factor in his rapprochement with his[…]"
                                            },
                                            {
                                                "example_id": "60cf1f40-880d-4c7c-a1e7-10f73cdefcdd",
                                                "sense_id": "f90f2f10-ab50-3678-b422-b022a28d054f",
                                                "text": "Consuella Lopez, the director of operations and housing at Casa Ruby, remembers. \"The more passable your body was, the less bullying you'd get, the more chances of you getting a regular job at a regular place without somebody clocking you.\""
                                            },
                                            {
                                                "example_id": "70c8bb0b-bc30-4b07-9cdc-0eaa2a0e1dc2",
                                                "sense_id": "f90f2f10-ab50-3678-b422-b022a28d054f",
                                                "text": "Jess was a sixty-something, short, White, bald man who could easily be \"clocked\" as gay."
                                            },
                                            {
                                                "example_id": "035158fa-cf9d-4261-a5a6-6a1febe1621f",
                                                "sense_id": "f90f2f10-ab50-3678-b422-b022a28d054f",
                                                "text": "Quarantine had thrown a new wrench \"do not perceive me\" discourse, but trans people have arguably always had a messy relationship to being perceived. We avoid it, and yet we also juice our lives to be seen. Getting clocked feels bad, but being hot feels good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4edbbf5a-ab9c-3eee-91cc-0fb502e96ecb",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To falsify the reading of the odometer of a vehicle."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1645fdd9-db64-465d-877c-b11c7aaaf080",
                                                "sense_id": "4edbbf5a-ab9c-3eee-91cc-0fb502e96ecb",
                                                "text": "I don't believe that car has done only 40,000 miles. It's been clocked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "954bba9f-5a1b-3048-b727-0d84a33ae1ff",
                                        "entry_id": "dc94b8b7-1256-3372-8aea-7b1c80069d6b",
                                        "glosses": [
                                            "To beat a video game."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
