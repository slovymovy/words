                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siderisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07dbfd06-a79d-3dce-9a33-459fa77597d8",
                                        "entry_id": "86831321-ba88-39c9-b752-b1b7271e100f",
                                        "glosses": [
                                            "auf die Fixsterne bezogen; Stern- oder Sternen-"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cabf38-df7a-4ff4-b5b4-6bd1d65aa670",
                                                "sense_id": "07dbfd06-a79d-3dce-9a33-459fa77597d8",
                                                "text": "Die Kamera wird während dieser Zeit siderisch nachgeführt, um die Rotation der Erde auszugleichen."
                                            },
                                            {
                                                "example_id": "46a52433-987b-4320-9b1b-88adf48a02ee",
                                                "sense_id": "07dbfd06-a79d-3dce-9a33-459fa77597d8",
                                                "text": "Das siderische Jahr dauert 365 Sonnentage, 6 Stunden, 9 Minuten und 9,54 Sekunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48993f0d-f773-3191-96f4-ffe6316ecabc",
                                        "entry_id": "86831321-ba88-39c9-b752-b1b7271e100f",
                                        "glosses": [
                                            "auf die Fixsterne bezogene Astrologie; Fixsternastrologie"
                                        ],
                                        "tags": [
                                            "Astrologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4621aa37-e832-4c1f-92e9-a104c5d2ece9",
                                                "sense_id": "48993f0d-f773-3191-96f4-ffe6316ecabc",
                                                "text": "Der tropische Tierkreis schließt die Existenz eines siderischen Tierkreises nicht aus und umgekehrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ce91ed91-5cb4-3678-af9c-6e20d80042d2",
                                        "entry_id": "86831321-ba88-39c9-b752-b1b7271e100f",
                                        "glosses": [
                                            "das Eisen betreffend"
                                        ],
                                        "tags": [
                                            "Parapsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c329eef-9bda-4da0-a573-7eeb5516f585",
                                                "sense_id": "ce91ed91-5cb4-3678-af9c-6e20d80042d2",
                                                "text": "Das siderische Pendel soll dem Aufspüren von Wasser- oder Metalladern im Boden dienen."
                                            },
                                            {
                                                "example_id": "d76af583-da95-4d0a-a284-b7e92dee6b0a",
                                                "sense_id": "ce91ed91-5cb4-3678-af9c-6e20d80042d2",
                                                "text": "Das siderische Pendel wird benutzt, um verborgene Dinge und verschollenes Wissen aufzuspüren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3085c01-ced7-4822-b33b-12cae8bae4db",
                        "source_entry_id": "496d9f8d-90c3-33fe-bfd9-e48bd0d19e10",
                        "target_lang_word": "sidereal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sidereal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1eee7c5-4b86-3910-a9a7-7a992e9bbd71",
                                        "entry_id": "a3073702-add4-3860-b940-c839e8658d95",
                                        "glosses": [
                                            "Of or relating to the stars."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5052e3-3238-4d4f-b736-2612be5744e5",
                                                "sense_id": "a1eee7c5-4b86-3910-a9a7-7a992e9bbd71",
                                                "text": "These fringes of lamplight, struggling up through smoke and thousandfold exhalation, some fathoms into the ancient reign of Night, what thinks Boötes of them, as he leads his Hunting-Dogs over the Zenith in their leash of sidereal fire?"
                                            },
                                            {
                                                "example_id": "00cae3b9-0574-4490-91b1-a278e1b8b87c",
                                                "sense_id": "a1eee7c5-4b86-3910-a9a7-7a992e9bbd71",
                                                "text": "The field of sidereal astronomy, therefore, was virtually untrodden when, shortly after the beginning of his telescopic work, Herschel began his first review of the heavens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a817ba89-0469-3a76-9d61-32f3e2f8af01",
                                        "entry_id": "a3073702-add4-3860-b940-c839e8658d95",
                                        "glosses": [
                                            "Relating to a measurement of time relative to the position of the stars."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ce0a45-2185-4dac-8698-4cbd6dbde7ba",
                                                "sense_id": "a817ba89-0469-3a76-9d61-32f3e2f8af01",
                                                "text": "Then, from a sufficient number of observations of synodic periods to give their mean, we obtain the sidereal period, or period with reference to the stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea638f72-24fe-3fd3-b291-ac96e0224b92",
                                        "entry_id": "a3073702-add4-3860-b940-c839e8658d95",
                                        "glosses": [
                                            "Relating to a measurement of time relative to the point of the vernal equinox."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
