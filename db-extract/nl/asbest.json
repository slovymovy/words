                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54aeb3b0-20aa-4946-b737-70dd3a91cd4b",
                        "source_entry_id": "b367034c-9add-37b1-8270-2616317e3f2d",
                        "source_sense_id": "0004741d-8a3e-3c14-bade-a074657f214c",
                        "source_sense_description": "verzamelnaam van een aantal silicaten met een vezelige structuur",
                        "target_lang_word": "asbestos",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asbestos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7cfe33b-5d0b-30c5-8a7b-4d2b0415fc77",
                                        "entry_id": "f40e9d99-d6e8-34b4-b98a-bcec8017071b",
                                        "glosses": [
                                            "Any of several fibrous mineral forms of magnesium silicate, used for fireproofing, electrical insulation, building materials, brake linings, chemical filters, suits, fireman's gloves, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63457474-9808-4591-a8ec-f7ef2894714e",
                                                "sense_id": "a7cfe33b-5d0b-30c5-8a7b-4d2b0415fc77",
                                                "text": "All types of asbestos are potentially carcinogenic when inhaled."
                                            },
                                            {
                                                "example_id": "1cb8dba3-1170-40b4-8a4f-4f2f0fb6e6b4",
                                                "sense_id": "a7cfe33b-5d0b-30c5-8a7b-4d2b0415fc77",
                                                "text": "Asbestos insulation was once ubiquitous."
                                            },
                                            {
                                                "example_id": "bfcfa855-d631-4b62-96ed-c5e128dd30cc",
                                                "sense_id": "a7cfe33b-5d0b-30c5-8a7b-4d2b0415fc77",
                                                "text": "Consul Baker, of Antung, China, states that valuable deposits of asbestos have been found in the vicinity of Kuantien, a small town lying about 45 miles northeast of Antung.[…]There are three mines now in operation, each employing about 30 workers. These workers, however, are mostly farmers who devote only their spare time to mining and use simply hammers and chisels and gather only the asbestos which lies near the surface."
                                            },
                                            {
                                                "example_id": "016c9c06-9c7c-4339-bdb9-1cfd644b7cb3",
                                                "sense_id": "a7cfe33b-5d0b-30c5-8a7b-4d2b0415fc77",
                                                "text": "Insulation against sound and changes in external temperature is given by a thickness of asbestos on the inside of the panels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d468d114-1f96-3c75-b770-1aefd7256fab",
                                        "entry_id": "f40e9d99-d6e8-34b4-b98a-bcec8017071b",
                                        "glosses": [
                                            "Any of asbestos-like forms of several minerals, asbestiforms"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2f63573-bedb-3a30-af5b-3c07303b477f",
                                        "entry_id": "f40e9d99-d6e8-34b4-b98a-bcec8017071b",
                                        "glosses": [
                                            "The supposed material composing part of the body that is impervious to heat, or by extension other unpleasant sensations; especially hot or spicy food."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd95ed7d-0165-4789-bd31-1c295e353537",
                                                "sense_id": "b2f63573-bedb-3a30-af5b-3c07303b477f",
                                                "text": "She sipped the coffee; she always did have asbestos lips."
                                            },
                                            {
                                                "example_id": "45e4756b-fa5a-4f0a-a1e6-37273a015826",
                                                "sense_id": "b2f63573-bedb-3a30-af5b-3c07303b477f",
                                                "text": "They were exceptionally good and were accompanied by a chili sauce that had to be eaten with great caution unless you had an asbestos tongue but was nonetheless delicious."
                                            },
                                            {
                                                "example_id": "5c02a17d-1f6d-4c27-9f98-3b4befc0b1a1",
                                                "sense_id": "b2f63573-bedb-3a30-af5b-3c07303b477f",
                                                "text": "\"Yikes!\" I yelped. \"This water is scalding!\" Lena explained to me that she had asbestos hands. Since it was obvious that I did not have asbestos hands, I offered to dry rather than wash."
                                            },
                                            {
                                                "example_id": "caad93da-ecb3-463a-a03a-0c93b617a5ee",
                                                "sense_id": "b2f63573-bedb-3a30-af5b-3c07303b477f",
                                                "text": "Dad plucks the steamed Chinese charcuterie out with his asbestos fingers, places it on the wooden circular chopping board and begins slicing it into bite-size pieces before returning it to the pot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asbestos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                        "entry_id": "3e85830c-19aa-3dee-9600-6eabcf9a5810",
                                        "glosses": [
                                            "To coat or line with asbestos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b83bbe66-d95a-4018-8135-d708ed271d4e",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "“Be sure you have plenty of kindling before you begin. They are rather non-inflammable and well asbestosed, so to speak.”"
                                            },
                                            {
                                                "example_id": "ca8e1f72-2ba2-4844-b904-7dad0ca48ac6",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "The latter department will be asbestosed without according to the idea of Professor Swain, whose deductions are that you should wear an overcoat in summer for the reason that what will keep out the cold will keep out the heat."
                                            },
                                            {
                                                "example_id": "eca67a46-46e2-4a28-9baf-325ee211b733",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Q. And you considered asbestosing the interior as part of your job, is that correct? A. That’s right."
                                            },
                                            {
                                                "example_id": "5c2796f5-f00e-4302-a55b-70b40a17f91d",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Though respectable ladies thought him a rake,\n He red-leaded Mrs. Brown’s gutter and spout\n And asbestosed the furnace for Mrs. Stout,\n And oh, the six weeks he spent refluing\n The winter home of Mrs. Hewing!"
                                            },
                                            {
                                                "example_id": "748da66d-7984-4d14-975d-95e2a45a44de",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Compound (I) (1.5 g.) and benzaldehyde (1.1 g.) were refluxed in glacial acetic acid (30-35 ml.) in presence of fused sodium acetate (2.6 g.) on an asbestosed wire gauge for 3 hr."
                                            },
                                            {
                                                "example_id": "a607422d-599f-4195-b1f2-9205e386cfe3",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "The other day one of the men doing the asbestosing on the acid retorts fell in a sulphuric sedimentation tank."
                                            },
                                            {
                                                "example_id": "d183c8f1-e1aa-442e-8df7-186f2aec59f3",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Alginate impressions of the “asbestosed” casts are then made and poured in plaster of paris."
                                            },
                                            {
                                                "example_id": "83e8b742-aa9a-4657-a5eb-f5b06adbf431",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "He actually was inside the asbestosed box buried under a roaring fire."
                                            },
                                            {
                                                "example_id": "186339f3-b2f9-44cb-8917-3b0b03497300",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "CLASS Nos. 26035 and 26038 have been de-asbestosed by MC Metals, of Glasgow, ready for their move to the South Yorkshire Railway at Meadowhall."
                                            },
                                            {
                                                "example_id": "893bbd73-d5b9-4039-a506-1a7c80a905a4",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Since low temperature is prevailing in hilly regions, tiled or asbestosed houses can be used to raise the room temperature."
                                            },
                                            {
                                                "example_id": "369631a7-93db-4932-bb96-10c960926dda",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Under Barroso, Commissioners were re-housed together in the new, refurbished (de-asbestosed) Berlaymont building in central Brussels."
                                            },
                                            {
                                                "example_id": "bba1a3b2-de99-453e-b9d1-d14cdc2ff584",
                                                "sense_id": "d284dd4b-e212-3c10-a5a5-9738bce54be4",
                                                "text": "Now Bush wondered / If the collapse of the three buildings could / Somehow be linked to an insurance scam / To win a fortune from asbestosed steel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d638c194-c206-39f3-a566-63b4c3741289",
                                        "entry_id": "3e85830c-19aa-3dee-9600-6eabcf9a5810",
                                        "glosses": [
                                            "To expose to asbestos; to cause to suffer asbestosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f80649-419d-48d2-bc02-980df2712cac",
                                                "sense_id": "d638c194-c206-39f3-a566-63b4c3741289",
                                                "text": "Lungs asbestosed / unable to breath^([sic]) / and so incapable / of producing for profit / sent away without delay / so a fresh lunged / could occupy / the vacant place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a67d6b-705d-38ed-bb1a-4b5c01494c42",
                                        "entry_id": "3e85830c-19aa-3dee-9600-6eabcf9a5810",
                                        "glosses": [
                                            "To insulate or buffer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffcce586-b03f-45fc-bbc9-5f9b3860a31f",
                                                "sense_id": "33a67d6b-705d-38ed-bb1a-4b5c01494c42",
                                                "text": "Like the house, I’d had my shiny youth of new love, my stuccoed divorce, my asbestosed fallout of pipe pain and dry-rot, my ill-conceived disco years, and my disastrous mid-life reno."
                                            },
                                            {
                                                "example_id": "8a2f7d96-2d2d-487f-b2ee-e4ba9ff321e4",
                                                "sense_id": "33a67d6b-705d-38ed-bb1a-4b5c01494c42",
                                                "text": "Is Malcolm J. Miller’s South Carolina Sinking Fund partly immune, partly asbestosed, or what?"
                                            },
                                            {
                                                "example_id": "71c57d11-f857-4dac-91af-ae257c3be9f6",
                                                "sense_id": "33a67d6b-705d-38ed-bb1a-4b5c01494c42",
                                                "text": "Whatever air’s asbestosing the prayers / Of this sparse April parlour must splutter / To dust until it dismantles itself."
                                            },
                                            {
                                                "example_id": "fd823d10-63a0-4281-a5e9-49a8068526fb",
                                                "sense_id": "33a67d6b-705d-38ed-bb1a-4b5c01494c42",
                                                "text": "Not enough if you / garlanded me before twenty, / asbestosed me several times / around the conjugal fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "852ec1c9-fd02-466a-8467-a0b2e2b7c6a7",
                        "source_entry_id": "b367034c-9add-37b1-8270-2616317e3f2d",
