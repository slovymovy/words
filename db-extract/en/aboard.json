                    {
                        "translation_id": "4df2a2b3-ad3e-448a-b46f-20002c5f7e67",
                        "source_entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                        "source_sense_description": "on board",
                        "target_lang_word": "à bord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à bord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af4f342e-0562-3639-b8d0-09559f792534",
                                        "entry_id": "ba042e04-c33f-3684-9d9e-a464b11f227c",
                                        "glosses": [
                                            "Sur le navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad44ba8-33b6-47d0-9fd4-c2aa151800f8",
                                                "sense_id": "af4f342e-0562-3639-b8d0-09559f792534",
                                                "text": "La navigation cesse aussitôt que le soleil est couché et à bord des bateaux amarrés le long des rives, les mariniers éteignent leurs falots à l'heure où jadis on sonnait le couvre-feu."
                                            },
                                            {
                                                "example_id": "71cc3fcd-015f-4035-a104-f80132138804",
                                                "sense_id": "af4f342e-0562-3639-b8d0-09559f792534",
                                                "text": "Les vagues brisent à bord et submergent constamment le pont qui, mal calfaté à New-York, laisse pénétrer l'eau dans la cabine."
                                            },
                                            {
                                                "example_id": "595cd71f-1d19-4a23-90d6-68fed633a9d5",
                                                "sense_id": "af4f342e-0562-3639-b8d0-09559f792534",
                                                "text": "Il se fit admettre à bord d’un brick qui partait de Boston sans son fret habituel de bois, […]."
                                            },
                                            {
                                                "example_id": "244168a6-2b74-4add-97f1-ae6e4763c049",
                                                "sense_id": "af4f342e-0562-3639-b8d0-09559f792534",
                                                "text": "— En 1947, au tout début des apparitions d’ovnis, une soucoupe se serait écrasée à Roswell, au Nouveau-Mexique. On aurait trouvé des extraterrestres humanoïdes morts à bord et des médecins militaires les auraient autopsiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d9fa53d-bc02-343b-bbdc-79ab782c2bd5",
                                        "entry_id": "ba042e04-c33f-3684-9d9e-a464b11f227c",
                                        "glosses": [
                                            "Se dit d'une marchandise prise en charge à bord du navire au port de déchargement."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f6c4172-36e7-3aaa-9566-1c8602927b2a",
                                        "entry_id": "ba042e04-c33f-3684-9d9e-a464b11f227c",
                                        "glosses": [
                                            "Dans le projet, dans l’aventure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f62126cb-7dce-4c98-8ab3-aee9083687dd",
                                                "sense_id": "4f6c4172-36e7-3aaa-9566-1c8602927b2a",
                                                "text": "« Il y a une résistance silencieuse au sein de l’administration, rassemblant des gens qui ont choisi de privilégier d’abord leur pays », témoigne l’anonyme, qui estime que « les Américains doivent savoir qu’il y a encore des adultes à bord »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
