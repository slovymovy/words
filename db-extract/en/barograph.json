                        "entry_id": "64346bbd-9009-3621-a36b-a777439ab39b",
                        "glosses": [
                            "A type of barometer that continuously records air pressure on a sheet or rotating drum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e56320-cb35-492f-8251-20a572e14716",
                                "sense_id": "972358d7-df25-344b-8556-642b09f4e249",
                                "text": "Thanks to their barograph, however, they could judge their height above the sea."
                            },
                            {
                                "example_id": "f798803e-e812-46e7-bbd2-ec09838ac956",
                                "sense_id": "972358d7-df25-344b-8556-642b09f4e249",
                                "text": "At noon the barograph curve turned up and the wind moderated, the sky gradually clearing."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b56e2d4-6f4b-3e73-a1a8-2ca1be7d80a2",
                        "entry_id": "64346bbd-9009-3621-a36b-a777439ab39b",
                        "glosses": [
                            "An illuminated glass plate covered by a pressure sensitive sheet, used to measure pressure."
                        ],
