    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05f50c31-9193-3189-aadd-76c4617b47fc",
                    "sense_definition": "вытереть себе лицо, руки или другую часть тела",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После умывания он <w>утёрся</w> мягким полотенцем.",
                            "target_lang_translations": {
                                "it": "Dopo essersi lavato, si è <w>asciugato</w> con un asciugamano morbido."
                            }
                        },
                        {
                            "text": "Ребёнок <w>утёрся</w> рукавом после того, как попил воды.",
                            "target_lang_translations": {
                                "it": "Il bambino si è <w>asciugato</w> con la manica dopo aver bevuto dell'acqua."
                            }
                        }
                    ],
                    "synonyms": [
                        "вытереться"
                    ],
                    "common_phrases": [
                        "утереться полотенцем"
                    ],
                    "target_lang_definitions": {
                        "it": "Asciugarsi il viso, le mani o un'altra parte del corpo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "asciugarsi",
                                "target_lang_sense_clarification": "Azione di rimuovere l'umidità o l'acqua da sé stessi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2d74a2b-8c44-3f9c-89cb-ca9d5d73b1c6",
                    "sense_definition": "смириться с обидой или оскорблением, не ответив на них",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не стал спорить и просто <w>утёрся</w>, хотя его несправедливо обвинили.",
                            "target_lang_translations": {
                                "it": "Non ha voluto discutere e ha semplicemente <w>incassato</w>, anche se era stato accusato ingiustamente."
                            }
                        },
                        {
                            "text": "Не думай, что я <w>утрусь</w> после таких грубых слов в мой адрес.",
                            "target_lang_translations": {
                                "it": "Non pensare che io <w>manderò giù</w> dopo parole così offensive nei miei confronti."
                            }
                        }
                    ],
                    "synonyms": [
                        "проглотить"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Accettare un'offesa o un insulto senza reagire o difendersi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "incassare",
                                "target_lang_sense_clarification": "Subire passivamente un colpo o un'offesa."
                            },
                            {
                                "target_lang_word": "mandare giù",
                                "target_lang_sense_clarification": "Accettare con rassegnazione qualcosa di spiacevole."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}