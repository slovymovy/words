                            {
                                "example_id": "e0c94a53-652a-4214-a9e1-3636e4e351a6",
                                "sense_id": "5b9a5dc0-d373-3f03-97ce-4d8f96f0f0b3",
                                "text": "Mijn vrienden lagen stoned en diep onderuitgezakt op de bank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29912c50-ca75-4980-9929-bcb9513bdce0",
