                ],
                "senses": [
                    {
                        "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                        "entry_id": "5303ee11-ac58-3229-8752-003952e1073b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e124c910-09ec-4bc8-8cf7-fb29ed679d5f",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Frau Angele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5b8046b0-8b71-4bd8-a621-c6a43e734cd8",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Herr Angele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2435b0d1-efea-432b-ac5e-2d0e40c4579e",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Die Angeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8885c065-6cf0-4ffe-81d8-21b2f9232dd4",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Der Angele trägt nie die Pullover, die die Angele ihm strickt."
                            },
                            {
                                "example_id": "06fe7794-3c98-4d5a-ae93-c17da2ac42d6",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Angele kommt, geht der Herr Angele.“"
                            },
                            {
                                "example_id": "216fd926-a407-4aea-96c7-4c76dd48d196",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Angele kommt und geht."
                            },
                            {
                                "example_id": "1155a074-71bf-47aa-a09a-978273d3dbdd",
                                "sense_id": "de6237ca-3e67-3d5e-86c0-e819dab5f3da",
                                "text": "Angeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
