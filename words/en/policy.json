{
    "word_family": [
        "policymaker",
        "policyholder",
        "political",
        "politics",
        "politician"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7043c6d0-c94b-346b-830b-1a0190386455",
                    "sense_definition": "A course of action, set of rules, or principle of behaviour adopted or proposed by a government, party, business, or individual.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "governance_plan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government has introduced a new foreign <w>policy</w> regarding trade.",
                            "target_lang_translations": {
                                "ru": "Правительство представило новую внешнюю <w>политику</w> в отношении торговли.",
                                "zh": "政府出台了一项关于贸易的新外交<w>政策</w>。"
                            }
                        },
                        {
                            "text": "It is against company <w>policy</w> to use personal phones during meetings.",
                            "target_lang_translations": {
                                "ru": "Использование личных телефонов во время собраний противоречит <w>политике</w> компании.",
                                "zh": "开会时使用个人手机违反了公司<w>政策</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "foreign policy",
                        "company policy",
                        "privacy policy",
                        "public policy",
                        "strict policy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Курс действий, свод правил или принципов поведения, принятых правительством, партией, компанией или отдельным лицом.",
                        "zh": "政府、政党、企业或个人所采取或提议的一套行动方针、规则或行为准则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "политика",
                                "target_lang_sense_clarification": "государственная или корпоративная стратегия"
                            },
                            {
                                "target_lang_word": "курс",
                                "target_lang_sense_clarification": "направление деятельности"
                            },
                            {
                                "target_lang_word": "линия",
                                "target_lang_sense_clarification": "стратегия поведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政策",
                                "target_lang_sense_clarification": "政府或机构的方针"
                            },
                            {
                                "target_lang_word": "方针",
                                "target_lang_sense_clarification": "指导行动的原则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17e35a65-cd5b-3cd6-beee-fc7447ce223d",
                    "sense_definition": "A contract with an insurance company, or the official document containing the details of this contract.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "insurance_contract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should read the small print in your insurance <w>policy</w> carefully.",
                            "target_lang_translations": {
                                "ru": "Вам следует внимательно прочитать мелкий шрифт в вашем страховом <w>полисе</w>.",
                                "zh": "你应该仔细阅读<w>保险单</w>上的细则。"
                            }
                        },
                        {
                            "text": "She decided to renew her life insurance <w>policy</w> for another year.",
                            "target_lang_translations": {
                                "ru": "Она решила продлить свой <w>полис</w> страхования жизни еще на один год.",
                                "zh": "她决定将人寿<w>保险单</w>续保一年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "insurance policy",
                        "life policy",
                        "renewal of policy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Договор со страховой компанией или официальный документ, содержащий условия этого договора.",
                        "zh": "与保险公司签订的合同，或包含该合同详细条款的正式文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полис",
                                "target_lang_sense_clarification": "страховой документ"
                            },
                            {
                                "target_lang_word": "страховой полис",
                                "target_lang_sense_clarification": "полное название документа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保险单",
                                "target_lang_sense_clarification": "保险合同文件"
                            },
                            {
                                "target_lang_word": "保单",
                                "target_lang_sense_clarification": "保险单的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "564354fd-2428-3607-a76f-0e4b83e8d4da",
                    "sense_definition": "The enclosed grounds or park surrounding a large country house.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "land_grounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a long walk through the <w>policies</w> of the old estate.",
                            "target_lang_translations": {
                                "ru": "Мы долго гуляли по <w>парку</w> старого поместья.",
                                "zh": "我们在那座老庄园的<w>庭院</w>里散了很久的步。"
                            }
                        },
                        {
                            "text": "The mansion stands within its own walled <w>policy</w>, separated from the village.",
                            "target_lang_translations": {
                                "ru": "Особняк стоит на собственной огороженной <w>территории</w>, отделенной от деревни.",
                                "zh": "这座宅邸坐落在其围墙内的<w>私家园林</w>中，与村庄隔开。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огороженная территория или парк, окружающий большой загородный дом (преимущественно в Шотландии).",
                        "zh": "环绕大型乡村住宅的封闭式庭院或公园。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парк",
                                "target_lang_sense_clarification": "при усадьбе"
                            },
                            {
                                "target_lang_word": "территория поместья",
                                "target_lang_sense_clarification": "земельный участок вокруг дома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庄园庭院",
                                "target_lang_sense_clarification": "大宅周围的土地"
                            },
                            {
                                "target_lang_word": "私家园林",
                                "target_lang_sense_clarification": "私人拥有的景观区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da6ccd45-d3c2-3b14-8bc6-8e2d834e0b59",
                    "sense_definition": "Prudence, wisdom, or cunning in the management of affairs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wisdom_cunning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted with great <w>policy</w> to avoid offending the powerful duke.",
                            "target_lang_translations": {
                                "ru": "Он действовал с большой <w>проницательностью</w>, чтобы не обидеть могущественного герцога.",
                                "zh": "他表现得十分<w>精明</w>，避免了得罪那位权势显赫的公爵。"
                            }
                        },
                        {
                            "text": "It was considered poor <w>policy</w> to reveal one's true intentions so early.",
                            "target_lang_translations": {
                                "ru": "Считалось недальновидной <w>политикой</w> раскрывать свои истинные намерения так рано.",
                                "zh": "过早暴露自己的真实意图被认为是一种不明智的<w>权谋</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Благоразумие, мудрость или хитрость в ведении дел (устаревшее значение).",
                        "zh": "在处理事务时的审慎、智慧或狡黠（旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проницательность",
                                "target_lang_sense_clarification": "мудрость в делах"
                            },
                            {
                                "target_lang_word": "дальновидность",
                                "target_lang_sense_clarification": "умение предвидеть последствия"
                            },
                            {
                                "target_lang_word": "политика",
                                "target_lang_sense_clarification": "образ действий (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精明",
                                "target_lang_sense_clarification": "处事智慧"
                            },
                            {
                                "target_lang_word": "权谋",
                                "target_lang_sense_clarification": "处事的手段与策略"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a920e408-030c-3c4c-a98a-ad65bbcd1e39",
                    "sense_definition": "An illegal lottery game in which players bet on numbers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gambling_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people in the neighborhood lost their savings playing the <w>policy</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди в округе потеряли свои сбережения, играя в <w>подпольную лотерею</w>.",
                                "zh": "社区里的许多人因为玩<w>地下彩票</w>而输光了积蓄。"
                            }
                        },
                        {
                            "text": "The police tried to shut down the <w>policy</w> racket operating in the city.",
                            "target_lang_translations": {
                                "ru": "Полиция пыталась закрыть банду, занимавшуюся <w>игрой в числа</w>, действовавшую в городе.",
                                "zh": "警方试图取缔城内运作的<w>地下彩票</w>团伙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "policy racket"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нелегальная лотерея, в которой игроки делают ставки на выпадение определенных чисел.",
                        "zh": "一种玩家对数字下注的非法彩票游戏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпольная лотерея",
                                "target_lang_sense_clarification": "азартная игра"
                            },
                            {
                                "target_lang_word": "игра в числа",
                                "target_lang_sense_clarification": "вид лотереи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地下彩票",
                                "target_lang_sense_clarification": "非法赌博游戏"
                            },
                            {
                                "target_lang_word": "数字博彩",
                                "target_lang_sense_clarification": "基于数字的赌博"
                            }
                        ]
                    }
                }
            ]
        }
    ]
