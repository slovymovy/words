                                "target_senses": [
                                    {
                                        "sense_id": "11c69771-fd99-3e12-a213-c8932107fe16",
                                        "entry_id": "df2bf189-914b-383f-a02e-e55aedbb74fd",
                                        "glosses": [
                                            "Making a strong impression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832de598-f3e6-4afb-9509-44b5095e026b",
                                                "sense_id": "11c69771-fd99-3e12-a213-c8932107fe16",
                                                "text": "He looked quite striking in his new suit and tie."
                                            },
                                            {
                                                "example_id": "de38de0e-dbcd-4dcd-83b2-050b4efabfc3",
                                                "sense_id": "11c69771-fd99-3e12-a213-c8932107fe16",
                                                "text": "This new-comer was a man who in any company would have seemed striking. In complexion fair, and with blue or gray eyes, he was tall as any Viking, as broad in the shoulder."
                                            },
                                            {
                                                "example_id": "fe9531d7-12eb-406f-b223-b5a00e5832fb",
                                                "sense_id": "11c69771-fd99-3e12-a213-c8932107fe16",
                                                "text": "This worrisome tendency was on display in recent weeks as Israelis reacted with striking vehemence to remarks by UN secretary general, Ban Ki-moon, and US ambassador to Israel, Daniel Shapiro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b173f366-3d84-365b-ab4b-a57856131f6e",
                                        "entry_id": "df2bf189-914b-383f-a02e-e55aedbb74fd",
                                        "glosses": [
                                            "On strike, taking part in industrial action."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faaa706-2df7-4642-9a65-70bdae3a9cdd",
                                                "sense_id": "b173f366-3d84-365b-ab4b-a57856131f6e",
                                                "text": "a striking employee"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "striking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb5a98a-d5b2-3630-95ac-3dc1808d2486",
                                        "entry_id": "47232ed4-8a35-32dd-8583-1d734f1edb6f",
                                        "glosses": [
                                            "The act by which something strikes or is struck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "581c94af-20f6-48c7-824e-879f3bd88639",
                                                "sense_id": "4fb5a98a-d5b2-3630-95ac-3dc1808d2486",
                                                "text": "We've observed plenty of strikings followed by lightings, so even if we should not say that the strikings cause the lightings, isn't it at least reasonable to predict, and to believe, that the next time we strike a match in similar conditions, it will be followed by a lighting?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7de77889-2918-4810-a1f5-2b8dfcf8973f",
                        "source_entry_id": "56ff898c-ee63-3ba7-9985-e3b8745c0ae3",
                        "source_sense_id": "3a59c605-91f6-36cc-b907-3a851fd48977",
