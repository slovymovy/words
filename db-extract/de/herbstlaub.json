                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f391ca6-72c2-4fa2-b8cc-6ef29dca44c7",
                                "sense_id": "13bfb800-4f48-36dd-82b3-f6aba5a07383",
                                "text": "Er fegte das abgefallene Herbstlaub mit dem Rechen zusammen."
                            },
                            {
                                "example_id": "b8b05369-4e10-4173-b903-d8637f58d078",
                                "sense_id": "13bfb800-4f48-36dd-82b3-f6aba5a07383",
                                "text": "„Natürlich brachte ich die langen Halme zum Kompost im hinteren Teil des Gartens, auf den ich auch das gefallene Herbstlaub gehäuft hatte, bevor die Sache mit Amalia passiert war und der Garten und ich in eine Art Winterstarre verfallen waren.“"
                            }
                        ],
