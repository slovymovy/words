                ],
                "senses": [
                    {
                        "sense_id": "18fff7bc-2673-36c6-a91e-dd197cac2da7",
                        "entry_id": "a2cd1695-a1e8-3eed-b6a3-a0f475b5606c",
                        "glosses": [
                            "S’approprier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6f3514-2637-4319-b0cb-2e19f6b9fb6b",
                                "sense_id": "18fff7bc-2673-36c6-a91e-dd197cac2da7",
                                "text": "Du coup, les sociétés en profitent pour grappiller des avantages qu'elles ne devraient pas s'autoapproprier."
                            },
                            {
                                "example_id": "17366ae7-518c-4d32-851d-d2432d5dd8d1",
                                "sense_id": "18fff7bc-2673-36c6-a91e-dd197cac2da7",
                                "text": "A l'inverse, je pense que vos adhérents sont en capacité de se détacher de votre ligne politique car le syndicat, depuis sa création, intègre la notion de responsabilité individuelle et de capacité à s'autoapproprier un message qui apparaît comme 'collectivement utile'."
                            },
                            {
                                "example_id": "7beebfc6-7e44-4d00-bcf8-621074e8ba78",
                                "sense_id": "18fff7bc-2673-36c6-a91e-dd197cac2da7",
                                "text": "ça veut dire qu'on s'autoapproprie la qualité de représenter les masses."
                            }
                        ]
                    }
