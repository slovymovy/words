                        "entry_id": "e914bbf6-1cb2-384d-93bb-fd30da62d134",
                        "glosses": [
                            "wyrób wędliniarski, głównie do smarowania kanapek; pasztet z podrobów i resztek mięsnych w formie kiełbasy"
                        ],
                        "tags": [],
