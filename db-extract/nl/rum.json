                            },
                            {
                                "target_word": "rum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf6ba78a-fa0c-3335-8757-2f2d19bd2952",
                                        "entry_id": "529d9aa1-3d03-3381-83a6-8597c3a178f6",
                                        "glosses": [
                                            "Fine, excellent, valuable."
                                        ],
                                        "tags": [
