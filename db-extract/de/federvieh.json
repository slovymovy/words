                        "sense_id": "1bcd185a-6208-3bbe-94dd-29b18206d3c3",
                        "entry_id": "b805dbc2-7c0e-3c96-94bc-0d24f3b9203c",
                        "glosses": [
                            "Vögel als landwirtschaftliche Nutztiere und als Haustiere"
                        ],
                        "tags": [
                            "Nutztier"
                        ],
                        "examples": [
                            {
                                "example_id": "3d92e300-e9c6-4706-b7ba-7aeafd93ff1f",
                                "sense_id": "1bcd185a-6208-3bbe-94dd-29b18206d3c3",
                                "text": "„Darum muß neben den Frauen bald auch das Federvieh im Moor versteckt werden; eilig wird dort ein Gehege gebaut.“"
                            },
                            {
                                "example_id": "b6567f45-ff3d-4a6b-8d24-2d5aff32396c",
                                "sense_id": "1bcd185a-6208-3bbe-94dd-29b18206d3c3",
                                "text": "„Heu und Federvieh holten sie aus den Ställen, verflucht von den Bauern, die mit Knüppeln und Mistforken drohten, aber nichts gegen die Waffen der Reiter ausrichten konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
