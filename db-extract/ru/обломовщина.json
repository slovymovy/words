                "senses": [
                    {
                        "sense_id": "b121ccb4-a13b-3ced-9584-a08ef7272828",
                        "entry_id": "01048c6a-481c-3f1f-a28a-1f6abcf8abdd",
                        "glosses": [
                            "Oblomovism (indolent apathy)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eaa1af9-7b8b-4a9e-abdd-45e7de3970ef",
                                "sense_id": "b121ccb4-a13b-3ced-9584-a08ef7272828",
                                "text": "— Куда́ ты? Возьми́ да смети́: здесь сесть нельзя́, ни облокоти́ться… Ведь э́то га́дость, э́то… обло́мовщина!",
                                "translation": "“Where are you going? Go sweep. A person can’t sit down or lean on his elbows here. This is filth. This is Oblomovshchina!”",
                                "english": "“Where are you going? Go sweep. A person can’t sit down or lean on his elbows here. This is filth. This is Oblomovshchina!”"
                            }
                        ]
                    }
                ],
