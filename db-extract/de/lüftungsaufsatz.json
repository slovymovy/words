                "senses": [
                    {
                        "sense_id": "836a4672-c9a3-3050-86b0-e20325bd0b42",
                        "entry_id": "b8693caa-1335-312e-a851-a2634ea1cd2d",
                        "glosses": [
                            "lüftungstechnischer Aufbau, aufgesetzter Teil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7a2830-b060-4200-8e1c-32ee05872a96",
                                "sense_id": "836a4672-c9a3-3050-86b0-e20325bd0b42",
                                "text": "„Sofern diese Breite eingehalten wird, kann der Lüftungsaufsatz jederzeit nachgerüstet werden.“"
                            },
                            {
                                "example_id": "2ac264f2-b430-4ec8-b322-59d76a97f382",
                                "sense_id": "836a4672-c9a3-3050-86b0-e20325bd0b42",
                                "text": "„Die Regenhaube wird aus verzinktem Stahlblech gefertigt und wird als Lüftungsaufsatz für Rundrohrkanäle genutzt.“"
                            },
                            {
                                "example_id": "6e915586-6d44-4b9a-bb86-1ff5fa8e52e0",
                                "sense_id": "836a4672-c9a3-3050-86b0-e20325bd0b42",
                                "text": "„In eingeschoßigen Gebäuden müssen Arbeitsräume mit mehr als 500 m2 Bodenfläche, die ausschließlich natürlich be- und entlüftet werden, zusätzlich durch Lüftungsaufsätze auf dem Dach lüftbar sein.“"
                            },
                            {
                                "example_id": "ef054861-d457-454c-b560-38b2671973db",
                                "sense_id": "836a4672-c9a3-3050-86b0-e20325bd0b42",
                                "text": "„Durch die Anordnung sogenannter Lüftungsaufsätze (Sauger) verbessert sich die Schachtlüftung.“"
                            },
                            {
                                "example_id": "5e3eb3bc-e0d5-4a88-a5e8-68d6dcbc30ca",
                                "sense_id": "836a4672-c9a3-3050-86b0-e20325bd0b42",
                                "text": "„RHA ist überall dort als Lüftungsaufsatz geeignet, wo es keine speziellen Anforderungen an die Entfernung der ausgestoßenen Luft gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
