                    },
                    {
                        "translation_id": "6dfd99f8-53e1-4572-a950-0e609c5bb3d4",
                        "source_entry_id": "e69c5f91-c1d5-35a1-b51f-98ac1613b86b",
                        "source_sense_id": "6eec4d8b-5b95-3ec4-b2af-d332ada37891",
                        "target_lang_word": "Fake",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fake",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                        "entry_id": "25c50d4c-1fe0-34a8-a7ed-28c95cfc3d57",
                                        "glosses": [
                                            "Fälschung, Kopie, Nachahmung, versuchter Betrug"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b7f5d8c-61ee-4e31-b9a2-32bf1a88398d",
                                                "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                                "text": "Das ist doch nie im Leben eine echte Rolex, die ist doch Fake!"
                                            },
                                            {
                                                "example_id": "57600718-d62b-4cd9-b9af-36125943dc34",
                                                "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                                "text": "Du chattest nicht mit deiner Traumfrau. Das ist nur ein Fake im Internet-Forum!"
                                            },
                                            {
                                                "example_id": "f18836bc-5f2f-4e78-a5e2-23abbb331075",
                                                "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                                "text": "„Jemand wird uns das Geld abnehmen, der Vertrag wird sich als Fake erweisen, oder aber alles ist korrekt und es kommt niemand, um ein Buch zu kaufen.“"
                                            },
                                            {
                                                "example_id": "700ad962-89db-4534-a8ea-858a3e5a53f9",
                                                "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                                "text": "„Das gilt auch für solche Fakes, die wie etwa beim Chatten »zum Spiel« gehören: Hier wird in Rechnung gestellt, ja sogar erwartet, dass Identitäten, das Alter oder das Geschlecht der Akteure »gefakt« werden.“"
                                            },
                                            {
                                                "example_id": "be1a3255-17f8-4b9c-9ec0-3b8567cda103",
                                                "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                                "text": "„Die Experten des Verlags waren sich sicher: Der Satz steht nirgendwo bei Lindgren, das ist ein Fake.“"
                                            },
                                            {
                                                "example_id": "b828da46-2573-4a1c-a568-2ce6613562a1",
                                                "sense_id": "db4173aa-4689-3ad0-9d48-cce93324c384",
                                                "text": "„Die dokumentarischen Fotos sind Fake und die Maschinen wahrhaft nutzlos, aber das alles zusammmen ist hochkomisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c02c147-a3a5-37aa-83e9-b936d0365634",
                                        "entry_id": "25c50d4c-1fe0-34a8-a7ed-28c95cfc3d57",
                                        "glosses": [
                                            "Nachahmung eines Kunstwerkes, jedoch nicht mit der Absicht, das Kunstwerk aufgrund seiner Optik zu kopieren, sondern offenkundig ein „Fake“ zu erstellen, um Kritik an der Institution der Kunst und an dessen Ideologie des originalen Kunstwerks auszuüben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22291dd1-6062-4e43-8719-4ecd66a03250",
                                                "sense_id": "8c02c147-a3a5-37aa-83e9-b936d0365634",
                                                "text": "Diese Collage ist ein Fake!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
