                                "sense_id": "96d9b703-6878-35d1-8952-ae4c71a8758a",
                                "text": "The disgraceful conduct of the Returning Officer for the City of London Election has been the subject of animadversive conversation in our own particular circle."
                            },
                            {
                                "example_id": "2b52fef1-e4e5-40b0-bde9-8edc868a07e4",
                                "sense_id": "96d9b703-6878-35d1-8952-ae4c71a8758a",
                                "text": "The conduct of the medical practitioner was denounced by one of the jurors as \"mercenary\"; and a special verdict, animadversive of the practice (if it be a practice), was entered."
                            }
                        ]
