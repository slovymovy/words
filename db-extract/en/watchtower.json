                                        "entry_id": "bb12219f-2fd2-3771-aefc-861121243c99",
                                        "glosses": [
                                            "toren waarop een persoon de omgeving in de gaten houd om alarm te kunnen slaan als er een ongewenste situtie ontstaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
