                ],
                "senses": [
                    {
                        "sense_id": "91533a12-040b-389d-8b4e-79a800b6301e",
                        "entry_id": "77556899-76b6-3275-8802-5e684042cede",
                        "glosses": [
                            "страд. прич. прош. вр. от разупорядочить; приведённый в беспорядок"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "377fdb5a-e1a1-4354-97da-100fe19e33a0",
                                "sense_id": "91533a12-040b-389d-8b4e-79a800b6301e",
                                "text": "Уже практически отсортированный массив будет сортироваться столько же, сколько и полностью разупорядоченный."
                            }
                        ]
                    },
                    {
                        "sense_id": "4002d75a-a04c-3971-9df6-d3ef2cd12a5f",
                        "entry_id": "77556899-76b6-3275-8802-5e684042cede",
                        "glosses": [
                            "адъектив.; физ. потерявший упорядоченность под воздействием чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a513569-fbde-464d-ae1f-c587b3c10cd8",
                                "sense_id": "4002d75a-a04c-3971-9df6-d3ef2cd12a5f",
                                "text": "Разупорядоченную структуру имеют чаще всего смешанные ферриты, определённым образом термообработанные."
                            },
                            {
                                "example_id": "f587d404-69f3-4b93-aba5-8d7098f4bec4",
                                "sense_id": "4002d75a-a04c-3971-9df6-d3ef2cd12a5f",
                                "text": "По мере роста флюенса вследствие увеличения концентрации разупорядоченных микрообластей должно происходить перекрытие отдельных микрообластей."
                            }
                        ]
                    }
