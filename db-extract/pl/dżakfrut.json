                "senses": [
                    {
                        "sense_id": "59e639ea-8204-3269-9d43-e52a1826ca00",
                        "entry_id": "69d03133-4951-319a-8d10-811e14e0cf3b",
                        "glosses": [
                            "ogromny, jadalny owoc chlebowca różnolistnego"
                        ],
                        "tags": [],
