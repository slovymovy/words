                    {
                        "translation_id": "88db75bf-fa08-4163-ba51-efd278d542dc",
                        "source_entry_id": "cce8590e-fafa-34ad-8dbc-982909b702f4",
                        "source_sense_id": "d3f354d1-6f2c-3ae9-aa9e-cea0f282b5c4",
                        "source_sense_description": "Jewish prayer of praise to God",
                        "target_lang_word": "kaddish",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kaddish",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8637a8-d454-3051-b552-951afb01ecb6",
                                        "entry_id": "5fadbb9f-ea8f-3cac-bad1-1468815d5596",
                                        "glosses": [
                                            "Prière ayant pour thème la glorification et sanctification de Dieu."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08d680ac-5a6a-477e-afe3-f4f17cb875c6",
                                                "sense_id": "0c8637a8-d454-3051-b552-951afb01ecb6",
                                                "text": "Le kaddish le plus connu est le kaddish des endeuillés, récité lors de tous les offices de prière, ainsi que lors des funérailles et des cérémonies de commémoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a76df979-a667-3c0c-b8d7-54de557fd7fe",
                                        "entry_id": "5fadbb9f-ea8f-3cac-bad1-1468815d5596",
                                        "glosses": [
                                            "Prière ayant pour thème la glorification et sanctification de Dieu.",
                                            "Oraison funèbre, prière des morts."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acd0f814-e5f2-41b0-b433-44ad2ed8685e",
                                                "sense_id": "a76df979-a667-3c0c-b8d7-54de557fd7fe",
                                                "text": "La foule ne retient plus son émotion quand les familles récitent ensemble le \"kaddish\", la prière des morts, avant que les cortèges funéraires ne s’ébranlent en direction des cimetières."
                                            },
                                            {
                                                "example_id": "cdafb705-c2cf-4a3e-a01d-8dde1be76431",
                                                "sense_id": "a76df979-a667-3c0c-b8d7-54de557fd7fe",
                                                "text": "La cérémonie est sobre, mais l’émotion est palpable, surtout lorsqu’un kaddish (la prière des morts) évoque les membres de la communauté disparus récemment."
                                            },
                                            {
                                                "example_id": "89787100-d6e3-42da-8fda-527239f7960d",
                                                "sense_id": "a76df979-a667-3c0c-b8d7-54de557fd7fe",
                                                "text": "À cette occasion, le kaddish, la prière des morts, a notamment été récitée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21a68d4-e56e-416e-9557-d595ef5885b7",
                        "source_entry_id": "cce8590e-fafa-34ad-8dbc-982909b702f4",
                        "source_sense_id": "d3f354d1-6f2c-3ae9-aa9e-cea0f282b5c4",
                        "source_sense_description": "Jewish prayer of praise to God",
                        "target_lang_word": "qaddich",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qaddich",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91ba4a6a-c98f-3710-982e-db1f697fd565",
                                        "entry_id": "48653b41-1b03-3220-8580-0939753e5fd3",
                                        "glosses": [
                                            "Variante orthographique de kaddish."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca67c1b-ae4d-4c4c-a994-e0bff79e9feb",
                                                "sense_id": "91ba4a6a-c98f-3710-982e-db1f697fd565",
                                                "text": "Le qaddich est une prière araméenne qui appartient à la liturgie synagogale, et qui vient en conclusion de la prédication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4bd2626-36f2-46b3-9eb4-786e19c04dd4",
                        "source_entry_id": "cce8590e-fafa-34ad-8dbc-982909b702f4",
                        "source_sense_id": "d3f354d1-6f2c-3ae9-aa9e-cea0f282b5c4",
                        "source_sense_description": "Jewish prayer of praise to God",
                        "target_lang_word": "Kaddisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaddisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949d01a8-20cc-3776-a5a0-84da3838f0d0",
                                        "entry_id": "7abaf3b1-d275-3c32-9f3c-860fe58da0f9",
                                        "glosses": [
                                            "Gebet der Juden, das unter anderem als Totengebet gesprochen wird"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7013a77f-aeef-4f22-976c-8430cab7976e",
                                                "sense_id": "949d01a8-20cc-3776-a5a0-84da3838f0d0",
                                                "text": "„»Kannst du noch Kaddisch sagen?« hörte ich ihn fragen.“"
                                            },
                                            {
                                                "example_id": "767e37ed-0b80-44d0-9705-410c6a4de744",
                                                "sense_id": "949d01a8-20cc-3776-a5a0-84da3838f0d0",
                                                "text": "„Heine, der jegliche organisierte Religion hasste und sich eine Messe oder ein Kaddisch zu seiner Beisetzung verbat, war Schockens Lieblingsschriftsteller.“"
                                            },
                                            {
                                                "example_id": "081c4d67-7ee6-492c-8ae8-41b7d569f788",
                                                "sense_id": "949d01a8-20cc-3776-a5a0-84da3838f0d0",
                                                "text": "„Niemand hat ihnen und den meisten anderen Ermordeten das \"Kaddisch\" gesagt, also das Totengebet der Juden, in dem Gott gelobt und ihm gedankt wird - gerade in der größten Stunde der Not.“"
                                            },
                                            {
                                                "example_id": "0e567e9c-6cd3-48ff-b106-72856939d193",
                                                "sense_id": "949d01a8-20cc-3776-a5a0-84da3838f0d0",
                                                "text": "„Vor vielen Jahren ging er noch ganz allein, um das «Kaddisch» am Grab seiner Familie zu sprechen.“"
                                            },
                                            {
                                                "example_id": "593bc031-b390-4f3d-bfb2-bd09e9441d07",
                                                "sense_id": "949d01a8-20cc-3776-a5a0-84da3838f0d0",
                                                "text": "„Er wollte in der Lautsprache beten lernen, und als er es konnte, ging er auf den Friedhof zum Grab seines vor vielen Jahren gestorbenen Vaters, um das Kaddisch zu sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
