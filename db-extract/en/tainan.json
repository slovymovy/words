    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c7b75e51-5ff4-336a-9504-8cc097d0d360",
                "word": "Tainan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cacc54d-cbf6-3bee-bc6c-6ad440eba41a",
                        "entry_id": "c7b75e51-5ff4-336a-9504-8cc097d0d360",
                        "glosses": [
                            "A major city in southern Taiwan, dating to the 16th century"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51602c9a-54e4-46b9-a4f6-8e5807609641",
                                "sense_id": "1cacc54d-cbf6-3bee-bc6c-6ad440eba41a",
                                "text": "Camphora officinarum, Nees. The aggregate exports of camphor from China have increased considerably of late years. They were 22,231 cwt. in 1892, and 40,763 cwt. in 1893. The island of Formosa yields the principal quantities, the yearly output being now as much as 41,650 cwt., shipped from the ports of Tamsui and Tainan."
                            },
                            {
                                "example_id": "b7b2d727-2b5f-4c45-a0e7-83fee10e797b",
                                "sense_id": "1cacc54d-cbf6-3bee-bc6c-6ad440eba41a",
                                "text": "The Council of the Mission, at its headquarters in Tainan appeals to the Church at home to make the jubilee year worthy of the name by an endeavor to reach with the Gospel the yet unevangelized tribes of uncivilized aborigines on the eastern side of the island."
                            },
                            {
                                "example_id": "9987069b-a740-494e-bcad-39b551431e17",
                                "sense_id": "1cacc54d-cbf6-3bee-bc6c-6ad440eba41a",
                                "text": "\"Without him, what kind of life would we have today,\" sobbed an old man from Tainan."
                            },
                            {
                                "example_id": "54a09a8c-588c-4434-a63c-cb963d28b8aa",
                                "sense_id": "1cacc54d-cbf6-3bee-bc6c-6ad440eba41a",
                                "text": "Taiwan was fighting against time on Sunday to rescue some 120 people believed to be trapped in a building, which collapsed on Saturday when a 6.4-magnitude earthquake rocked the southern city of Tainan."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a649db9-3250-3e41-9bb9-ce644b4a9cbe",
                        "entry_id": "c7b75e51-5ff4-336a-9504-8cc097d0d360",
                        "glosses": [
                            "A former county of Taiwan."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "47e3e42d-c87e-4334-9429-b7a8072760a1",
                                "sense_id": "2a649db9-3250-3e41-9bb9-ce644b4a9cbe",
                                "text": "Chungshe is one of eleven villages in Liuchia township, Tainan county (see Maps 2 and 3). It lies about 30 kilometers northeast of Tainan city."
                            },
                            {
                                "example_id": "d71f6190-0380-4481-b33c-1afdf032d243",
                                "sense_id": "2a649db9-3250-3e41-9bb9-ce644b4a9cbe",
                                "text": "At graduation from Lungtien Primary School in Tainan County, I received the County Magistrate's Award, given to the top-ranked student in the class. From there, I tested into Tainan County's junior high school, and during my junior year there represented Tainan County in the first national Chinese language essay competition, placing second."
                            }
                        ]
                    }
                ],
