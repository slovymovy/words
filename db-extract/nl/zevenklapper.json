                                                "example_id": "3aff2769-1207-40ae-86fd-2f1b6a19e8f1",
                                                "sense_id": "17331681-ad72-3070-9695-cf87113d0400",
                                                "text": "A Snider squibbed in the jungle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57650aac-fcac-37f7-9086-51ca00b86c34",
                                        "entry_id": "9585b4e5-c374-3f47-afca-3de4aadaaf6e",
                                        "glosses": [
                                            "To throw squibs; to utter sarcastic or severe reflections; to contend in petty dispute."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33726433-3ac5-4b05-a64e-dabddf8e3593",
                                                "sense_id": "57650aac-fcac-37f7-9086-51ca00b86c34",
                                                "text": "to squib a little debate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17250c4b-d359-39e5-8d52-2c483ad6d1ee",
                                        "entry_id": "9585b4e5-c374-3f47-afca-3de4aadaaf6e",
                                        "glosses": [
                                            "To dodge something difficult, to bottle."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f320f3c-c186-499d-8f93-4b0fa2cb5b46",
                                                "sense_id": "17250c4b-d359-39e5-8d52-2c483ad6d1ee",
                                                "text": "He squibbed the opportunity to push the claim that Kyoto should remain the flagship for international action - because deep down those on the other side know that the world has moved on beyond Kyoto."
                                            }
                                        ]
                                    }
                                ]
                            }
