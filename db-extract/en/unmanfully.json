                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6349a39a-de74-4cb1-b3d4-162e368eacd6",
                                "sense_id": "3254b0c9-73fe-3635-8177-7f5b052b16f3",
                                "text": "But in the name of justice, law, and common sense, do not insiduously and unmanfully continue a sentence for one and a former offense, as a punishment for another and a later one, and that, too, without the due forms of trial."
                            },
                            {
                                "example_id": "e551b03b-b1fd-4a8d-af89-828ce8606734",
                                "sense_id": "3254b0c9-73fe-3635-8177-7f5b052b16f3",
                                "text": "So Sara Lee's room had a different occupant for a time, a thin and fine-worn young Belgian, who yielded to Sara Lee when Jean gave up in despair, and who proceeded, most unmanfully, to faint as soon as he was between the blankets."
                            }
                        ]
                    }
