            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbc91c7a-95b3-313f-9852-6c4ddfed3941",
                    "sense_definition": "Eieren warm houden met het lichaam om de jongen te laten uitkomen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eieren_warm_houden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel bleef geduldig op haar nest zitten om de eieren te <w>broeden</w>.",
                            "target_lang_translations": {
                                "en": "The bird remained patiently on her nest to <w>brood</w> the eggs."
                            }
                        },
                        {
                            "text": "Sommige vogelsoorten <w>broeden</w> gezamenlijk in grote kolonies langs de kust.",
                            "target_lang_translations": {
                                "en": "Some bird species <w>breed</w> collectively in large colonies along the coast."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op eieren broeden"
                    ],
                    "target_lang_definitions": {
                        "en": "To keep eggs warm with the body in order to hatch the young."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brood",
                                "target_lang_sense_clarification": "of birds sitting on eggs"
                            },
                            {
                                "target_lang_word": "incubate",
                                "target_lang_sense_clarification": "of eggs being kept warm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bb05310-fc72-3363-96bb-6e546e01048d",
                    "sense_definition": "In het geheim nadenken over een plan of een idee.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plannen_beramen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zat al uren in stilte op een nieuw plan te <w>broeden</w>.",
                            "target_lang_translations": {
                                "en": "She had been sitting in silence for hours, <w>brooding</w> over a new plan."
                            }
                        },
                        {
                            "text": "De uitvinders <w>broedden</w> op een revolutionaire oplossing voor het energieprobleem.",
                            "target_lang_translations": {
                                "en": "The inventors were <w>hatching</w> a revolutionary solution to the energy problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "beramen",
                        "koesteren"
                    ],
                    "common_phrases": [
                        "op een plan broeden"
                    ],
                    "target_lang_definitions": {
                        "en": "To secretly think about or hatch a plan or an idea."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brood",
                                "target_lang_sense_clarification": "to dwell on or ponder over something"
                            },
                            {
                                "target_lang_word": "hatch",
                                "target_lang_sense_clarification": "to plot or devise a plan"
                            },
                            {
                                "target_lang_word": "scheme",
                                "target_lang_sense_clarification": "to make secret plans"
                            }
                        ]
                    }
                }
            ]
        }
    ]
