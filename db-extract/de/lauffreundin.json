                "senses": [
                    {
                        "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                        "entry_id": "37181ef7-3fe8-3448-ada9-24ccb815f36d",
                        "glosses": [
                            "weibliche Person, mit der man eine laufbezogene Freundschaft pflegt; häufig jemand, mit der man regelmäßig gemeinsam läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "65dd03d0-9bd0-4816-9f3e-3578b7f83ec6",
                                "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                                "text": "„Ich bin glücklich, euch als Lauffreundinnen zu haben.“"
                            },
                            {
                                "example_id": "3fb53ff7-d4c1-4dbd-b6f0-a6c52fa9db41",
                                "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                                "text": "„Christian Hottas erreicht gemeinsam mit seiner Lauffreundin Christine Schroeder erst nach fast neun Stunden den Bahnhof.“"
                            },
                            {
                                "example_id": "9c32df50-9ae1-4d0b-a2d9-5e71e371fdcd",
                                "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                                "text": "„Es bleibt also auch nach dem Lauf genug Zeit, das ein oder andere Kölsch zu geniessen und neue Lauffreundinnen und Lauffreunde kennenzulernen.“"
                            },
                            {
                                "example_id": "b39c1cfa-dba2-4801-ad96-625cf61040d4",
                                "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                                "text": "„Etwas ‚angedickt‘ fühlte sich Norbert jenseits des 45. Geburtstags, ließ sich daher von einer Lauffreundin für die 42,195 km begeistern.“"
                            },
                            {
                                "example_id": "a05f08e9-8365-4225-b580-a12f4a2a83d1",
                                "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                                "text": "„Ich war mittlerweile ziemlich am Ende des Läuferfeldes angelangt und am Ende meiner Kräfte, sodass ich weder auf meine Lauffreundin Qi warten noch an den spektakulären Aussichten viel fotografieren konnte.“"
                            },
                            {
                                "example_id": "67430944-f366-4d0a-b8f8-c2f9e6591eb8",
                                "sense_id": "65620745-4b2f-3a07-a002-85b21e0dd867",
                                "text": "„Ich empfinde es als großes Geschenk, inzwischen gemeinsam mit meiner Lauffreundin Katja 2-3 Mal pro Woche zu trainieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
