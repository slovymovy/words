                        "glosses": [
                            "Of or pertaining to Bertolt Brecht (1898–1956), German poet and playwright, or his works."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db1d44c-211a-49b1-8c3a-aadf28477442",
                                "sense_id": "2c5736ab-ad5d-3db1-9242-ae74064c3932",
                                "text": "Rainer Werner Fassbinder's films are simplistic or didactic but never for the sake of railroading us into formang a single opinion, adapting a certain stance. They are Brechtian fables, using simple plots, filled with contradictions and ironies, that force us to reexamine our political and moral ideas."
                            }
                        ]
                    }
                ],
