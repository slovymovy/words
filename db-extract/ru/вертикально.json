                    {
                        "translation_id": "f0aafc40-fd71-4f2f-b5e5-cd093bfacda5",
                        "source_entry_id": "5362cee0-f431-3d54-b34a-62a48aa9b42e",
                        "source_sense_id": "c4f12191-6c11-39e7-af9e-96e1bff462f7",
                        "target_lang_word": "senkrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senkrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                        "entry_id": "4a20b837-b0cc-3e93-be3d-aff3c8fb6467",
                                        "glosses": [
                                            "in einer geraden Linie von unten nach oben oder von oben nach unten verlaufend, in einem Winkel von 90 Grad auf die (idealisierte) Erdoberfläche gerichtet sein"
                                        ],
                                        "tags": [
                                            "Steigerung selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f63c06d5-7ed4-4159-b430-349b4f224f24",
                                                "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                                "text": "In der Wand befanden sich senkrechte Schlitze."
                                            },
                                            {
                                                "example_id": "0cad8802-0182-40d0-aa5c-7aab15bf244f",
                                                "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                                "text": "„Die einen, die eine noch vertretbare Gefahr einkalkulieren, etwa bei einer Erstbesteigung in den Anden oder im Himalaja, und die zweiten, die, nachdem die Gipfel in den Alpen ‚ausverkauft‘ seien, immer direktere, immer senkrechtere und immer sensationellere Routen suchten und damit Bergsteigen zur Akrobatik degradierten.“"
                                            },
                                            {
                                                "example_id": "14f0192a-b048-4cd1-9916-1b21f27caef2",
                                                "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                                "text": "„Es ist früher schon dadurch erklärt worden, daß die Stellung der Blätter eine senkrechtere sei, oder daß die Bäume spärlichere Belaubung hätten; ich konnte aber keinen Unterschied zwischen diesen und unseren heimischen Bäumen in der erwähnten Beziehung finden und glaube, daß die Schattenlosigkeit nur durch den senkrechteren Stand der Sonne bedingt wird.“"
                                            },
                                            {
                                                "example_id": "474b66da-d920-4570-acdd-5d608c806d60",
                                                "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                                "text": "„Daß aber nicht ein fortdauerndes Übergewicht dieser Naturkraft durch den Einfluß des Sonnenlichts entstehe, dafür ist durch den Weltbau selbst, durch den Wechsel des Tags, der Nacht, der Jahreszeiten, ja selbst durch die Form der Planeten gesorgt, da, analogisch nach der Form unserer Erde zu urteilen, ohne Zweifel auf allen, wo die Lichtstrahlen am senkrechtesten auffallen (gegen den Äquator hin), die größte Masse angehäuft ist; während sie da, wo jene schiefer auffallen (gegen die Pole hin) allmählich sich abplatten.“"
                                            },
                                            {
                                                "example_id": "6b2e73eb-fdb5-4834-9ecc-d6e26f9d9720",
                                                "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                                "text": "„Die senkrechtesten Strahlen der Sonne sollen natürlicher Weise den höchsten Grad der Hitze mit sich führen oder hervorbringen, aber in Südamerika findet man hiervon ehe das Gegentheil.“"
                                            },
                                            {
                                                "example_id": "140c474a-9904-4ae5-bf77-7a48a0b25d8e",
                                                "sense_id": "db6805fa-1d3d-34f6-b75b-687b3f82034e",
                                                "text": "„Da der Erdboden durch die Sonne am stärksten erwärmt wird, wenn die Sonnenstrahlen senkrecht auffallen, die Sonne aber stets schräg über der Erde steht und die Strahlen nur um die Mittagszeit rechtwinkelig auffallen, so wird eine Südlage, die eine Neigung von 25–35° besitzt, während des Sommers von den Sonnenstrahlen am senkrechtesten getroffen und sich in Folge dessen am stärksten erwärmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f31985d-4bc5-30aa-a1a2-0acd56df5338",
                                        "entry_id": "4a20b837-b0cc-3e93-be3d-aff3c8fb6467",
                                        "glosses": [
                                            "einen rechten Winkel bildend"
                                        ],
                                        "tags": [
                                            "geometry",
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4399df3-16fb-47b5-ac28-18378f2b4787",
                                                "sense_id": "5f31985d-4bc5-30aa-a1a2-0acd56df5338",
                                                "text": "Das Einfallslot steht senkrecht auf der Oberfläche."
                                            },
                                            {
                                                "example_id": "269dc1ee-41ea-4a5d-bd62-65c68834c287",
                                                "sense_id": "5f31985d-4bc5-30aa-a1a2-0acd56df5338",
                                                "text": "„Zwei Ebenen sind genau dann parallel, wenn sie eine gemeinsame senkrechte Gerade haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de97f258-cc3f-365c-9b2f-acd7cc5ded97",
                                        "entry_id": "4a20b837-b0cc-3e93-be3d-aff3c8fb6467",
                                        "glosses": [
                                            "Steigerung selten, von aufrechter, rechtschaffener Gesinnung"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede24584-bfbe-48d8-b124-87ca63cde316",
                                                "sense_id": "de97f258-cc3f-365c-9b2f-acd7cc5ded97",
                                                "text": "Heller ist von Parteien und Zeugen übereinstimmend als rechtschaffener und senkrechter Mann beschrieben worden."
                                            },
                                            {
                                                "example_id": "5c2c07b4-e8bf-4ab5-b177-a5bafad4d749",
                                                "sense_id": "de97f258-cc3f-365c-9b2f-acd7cc5ded97",
                                                "text": "„Was ist ein senkrechter Schweizer? Ist der ein senkrechter Schweizer, der keine eigene Meinung hat?“"
                                            },
                                            {
                                                "example_id": "a1dd389c-b5dd-4ae0-9d89-5f820c681821",
                                                "sense_id": "de97f258-cc3f-365c-9b2f-acd7cc5ded97",
                                                "text": "„So vermute ich, auch der Maurer vom verdrehten Kamin sei nicht verdrehter gewesen als wir auch; schließlich macht auch der senkrechteste Eidgenosse einmal etwas Verdrehtes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
