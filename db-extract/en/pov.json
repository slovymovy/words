                        ],
                        "examples": [
                            {
                                "example_id": "0b31460c-d93f-40f0-9ee5-1041b26ecd67",
                                "sense_id": "0ab58c33-88a1-360b-8c99-ccf68c3f433b",
                                "text": "Phantazeum is still in existence, on Chapel Street (the more pov end, not the yuppy end) ..."
                            },
                            {
                                "example_id": "fcfa4f43-f5f0-4817-8fb4-f8dcddad0938",
                                "sense_id": "0ab58c33-88a1-360b-8c99-ccf68c3f433b",
                                "text": "Especially considering the most pov Astra is $18,990 and $20k gets you a fully loaded Pulsar..."
