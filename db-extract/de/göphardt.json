                ],
                "senses": [
                    {
                        "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                        "entry_id": "3cb59644-61e0-3554-ab4a-87d32ceeb063",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e6bac43-f3ef-4bd0-919b-a9fecc4feb7b",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Frau Göphardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "996d320d-ccc3-4f81-a44e-19cc70bb73e3",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Herr Göphardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "99d1e3f4-fe07-428c-bb6a-b0a0142c5a9a",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Die Göphardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e9a68f29-bc55-47fa-86cf-a71da3f76912",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Der Göphardt trägt nie die Schals, die die Göphardt ihm strickt."
                            },
                            {
                                "example_id": "b3a56270-43df-4f27-9f13-0e2446b1d2d7",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Göphardt kommt, geht der Herr Göphardt.“"
                            },
                            {
                                "example_id": "3c17c9e0-20e2-41a0-83a3-9df84358bc2e",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Göphardt kommt und geht."
                            },
                            {
                                "example_id": "f161f761-9eca-4440-b413-e1a6db7a7e4f",
                                "sense_id": "c1a4f313-4b35-3b9a-847c-263d450eb66d",
                                "text": "Göphardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
