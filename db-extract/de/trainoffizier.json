                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a3241e-a5e4-47a3-8465-50f2ada6bbd8",
                                "sense_id": "c9c7df3d-5dbc-3be9-8133-87c9ed7d5c87",
                                "text": "„Ihm war gerade wieder seine Begegnung mit der Doktorsfrau und dem Trainoffizier eingefallen.“"
                            },
                            {
                                "example_id": "8f0fcada-158a-4cbd-8702-5bc79a6b64bc",
                                "sense_id": "c9c7df3d-5dbc-3be9-8133-87c9ed7d5c87",
                                "text": "„Per Schiff, Eisenbahn, Flugzeug und nicht zuletzt im Sattel, den er als ehemaliger Trainoffizier besonders hochschätzte, legte er tausende Kilometer zurück und bahnte wertvolle neue Geschäftsverbindungen an.“"
                            },
                            {
                                "example_id": "ada42d4d-ea54-410c-9fc3-cf64da235d94",
                                "sense_id": "c9c7df3d-5dbc-3be9-8133-87c9ed7d5c87",
                                "text": "„Er wuchs schon als Junge mit Pferden auf und wurde später Trainoffizier in der Schweizer Armee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
