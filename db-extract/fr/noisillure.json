                        "examples": [
                            {
                                "example_id": "9a3db11b-259b-46aa-8113-37bd0e1fdeb5",
                                "sense_id": "5907f462-0cae-359d-82b9-6894d94458fb",
                                "text": "Les chèvres et les chevreaux sont très-rarement galeux, mais ils sont sujets, dans les pays chauds, à une noisillure, qui est aussi une espèce de rougeole."
                            },
                            {
                                "example_id": "ceb8836b-6008-4b7e-bf69-fb58bc90a1de",
                                "sense_id": "5907f462-0cae-359d-82b9-6894d94458fb",
                                "text": "Toutefois, sa présence [du pou du mouton] en trop grand nombre peut déprécier la valeur mégissière des peaux en provoquant la lésion dite de noisillure."
                            }
