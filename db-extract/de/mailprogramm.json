                        "sense_id": "a19a86b6-1b8f-3139-8b10-7e8678332844",
                        "entry_id": "1af8270f-2efc-3469-ab28-135b3fc33732",
                        "glosses": [
                            "Software für das Verfassen, Senden, Empfangen und Ordnen von E-Mails (elektronischen Mitteilungen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d61462e-a202-49fe-9364-ab66d8da6070",
                                "sense_id": "a19a86b6-1b8f-3139-8b10-7e8678332844",
                                "text": "Öffnen Sie Ihr Mailprogramm und schauen Sie im Eingangskorb, ob Sie neue Nachrichten bekommen haben."
                            },
                            {
                                "example_id": "ac33ff7d-a1d6-4883-ae3a-4464e91dca24",
                                "sense_id": "a19a86b6-1b8f-3139-8b10-7e8678332844",
                                "text": "„Ari zögerte, ehe er das Mailprogramm öffnete, doch er gab sich einen Ruck.“"
                            },
                            {
                                "example_id": "7bb63c1b-96f6-4975-9d43-16fa3e530e3e",
                                "sense_id": "a19a86b6-1b8f-3139-8b10-7e8678332844",
                                "text": "„Google platziert Anzeigen auch in sogenannten personalisierten Diensten, also etwa im Mailprogramm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
