                        "entry_id": "0a42fae8-efbe-32df-8d57-ffc98aea2efc",
                        "glosses": [
                            "Épithète d’Apollon, signifiant tueur de lézards."
                        ],
                        "tags": [
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "37881910-f366-4953-a41c-4cf91e827437",
                                "sense_id": "d63000ce-7036-39a6-b696-5f959f1c4301",
                                "text": "Il existe, tant en marbre qu’en bronze, plusieurs statues d’Apollon sauroctone, c’est-à-dire qui tue un lézard."
                            }
                        ]
                    }
