                "forms": [
                    {
                        "form_id": "ae001264-7ffe-4818-aff0-f5254c1991f2",
                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                        "tags": [
                            "plural"
                        ],
                        "form": "dysphories"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0abe4c72-4b62-38f5-b0ba-c06d83fbc8ca",
                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                        "glosses": [
                            "Perturbation de l’humeur caractérisée par l’irritabilité et un sentiment déplaisant de tristesse, d’anxiété."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9d7e01a7-dbc8-31d9-9eb0-11a19b2b719f",
                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                        "glosses": [
                            "Sentiment désagréable de tristesse, d'inadéquation, de déception."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86aa31b-accb-454d-916c-282d973a8f7c",
                                "sense_id": "9d7e01a7-dbc8-31d9-9eb0-11a19b2b719f",
                                "text": "Il en est ainsi dans ce que le charabia médical appelle la dysphorie post-coïtale. Il s'agit d'un syndrome caractérisé par de la tristesse, une perte d'énergie voire de la mélancolie juste après l'acte sexuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "694926c9-f899-3aec-8f7c-699881bfbf5f",
                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                        "glosses": [
                            "État de malaise social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b1b68ed-463e-439c-9e5d-5e9925522ecf",
                                "sense_id": "694926c9-f899-3aec-8f7c-699881bfbf5f",
                                "text": "Dysphorie collective (Durkheim)"
                            }
                        ]
                    },
                    {
                        "sense_id": "032c239c-6457-3c3d-ab2f-6779195be820",
                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                        "glosses": [
                            "Dysphorie de genre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "11140cac-e342-410c-91c1-abab90dfd651",
                                "sense_id": "032c239c-6457-3c3d-ab2f-6779195be820",
                                "text": "Plus il y aura de familles trans, plus nombreux seront les parents qui détecteront chez leurs enfants des indices de dysphorie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5df19c-d8b8-4045-98e6-97e7ac1ff708",
                        "source_entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                        "target_lang_word": "dysphoria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysphoria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                        "entry_id": "aef6d105-eb80-316b-8afa-2d4b2c70f932",
                                        "glosses": [
                                            "A state of feeling unwell or unhappy; a feeling of emotional and mental discomfort and suffering from restlessness, malaise, depression, or anxiety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a075e993-adf9-4b9f-9705-e85a130177f5",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "body dysphoria"
                                            },
                                            {
                                                "example_id": "fc4540ba-c76a-48b7-8ce0-e4939d89ace7",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "premenstrual dysphoria"
                                            },
                                            {
                                                "example_id": "3722a3d1-fc23-4b0a-a9a6-e75bd381933c",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "weight dysphoria"
                                            },
                                            {
                                                "example_id": "6b2e985f-e898-4a84-ad16-24e63aa9469d",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "Chronic dysphoria can be secondary to a debilitating medical illness, a psychiatric disorder, or both (Akiskal, 1983)."
                                            },
                                            {
                                                "example_id": "abd838f5-690f-4464-82bb-2a132565ae4f",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "As a result of the critical review of the literature by the Work Group on Late Luteal Phase Dysphoric Disorder (LLPDD), it was agreed that the studies reviewed support the view that the predominant feature of LLPDD is the dysphoria that occurs during the premenstrual period."
                                            },
                                            {
                                                "example_id": "7b7ce6f4-b84f-4c19-be55-b88ae03efe13",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "While the reason for the individual's dysphoria on realizing that he has an STD is a result of lack of acceptance of his sexual orientation, the basis is not religious, and the dysphoria not so pronounced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f1c239-636a-3292-bf4a-db9f0bfb1525",
                                        "entry_id": "aef6d105-eb80-316b-8afa-2d4b2c70f932",
                                        "glosses": [
                                            "Ellipsis of gender dysphoria."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
