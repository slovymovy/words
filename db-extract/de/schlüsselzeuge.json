                            {
                                "example_id": "f0415f2c-4cde-403d-b11e-850348cc0fb9",
                                "sense_id": "116d0e14-896e-39a7-ab5c-82e9bd51564a",
                                "text": "„Der Schlüsselzeuge in der Affäre, Andrej Lugowoi, wurde am Montag in Moskau von britischen und russischen Ermittlern befragt.“"
                            }
                        ],
