{
    "word_family": [
        "lustre",
        "luster",
        "lustrously",
        "lustrousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0b3b5c3-9511-3370-a18b-7e205eccd5d2",
                    "sense_definition": "Reflecting light evenly and softly; having a natural sheen or glow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shampoo claimed to leave hair soft and <w>lustrous</w> after only one wash. ;",
                            "target_lang_translations": {
                                "de": "Das Shampoo versprach, das Haar nach nur einer Wäsche weich und <w>glänzend</w> zu machen."
                            }
                        },
                        {
                            "text": "She wore a string of pearls that had a rich, <w>lustrous</w> surface. ;",
                            "target_lang_translations": {
                                "de": "Sie trug eine Perlenkette mit einer edlen, <w>schimmernden</w> Oberfläche."
                            }
                        }
                    ],
                    "synonyms": [
                        "splendent"
                    ],
                    "common_phrases": [
                        "lustrous hair",
                        "lustrous pearls",
                        "lustrous surface"
                    ],
                    "target_lang_definitions": {
                        "de": "Licht sanft und gleichmäßig reflektierend; mit einem natürlichen Schimmer oder Glanz versehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "glänzend",
                                "target_lang_sense_clarification": "von Oberflächen, Haaren oder Perlen mit schönem Glanz"
                            },
                            {
                                "target_lang_word": "schimmernd",
                                "target_lang_sense_clarification": "mit sanftem, weichem Glanz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f948d1d7-9e41-3d1c-9f75-420b04dc3740",
                    "sense_definition": "Shining brightly or vividly; radiant or dazzling in appearance or spirit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evening sky was filled with <w>lustrous</w> stars that guided travelers home. ;",
                            "target_lang_translations": {
                                "de": "Der Abendhimmel war voller <w>leuchtender</w> Sterne, die den Reisenden den Weg nach Hause wiesen."
                            }
                        },
                        {
                            "text": "Her face seemed <w>lustrous</w> with happiness when she announced the good news. ;",
                            "target_lang_translations": {
                                "de": "Ihr Gesicht wirkte <w>strahlend</w> vor Glück, als sie die gute Nachricht verkündete."
                            }
                        }
                    ],
                    "synonyms": [
                        "splendent"
                    ],
                    "target_lang_definitions": {
                        "de": "Hell oder leuchtend strahlend; von strahlender oder bezaubernder Erscheinung oder Stimmung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "strahlend",
                                "target_lang_sense_clarification": "voller Licht, Helligkeit oder Freude"
                            },
                            {
                                "target_lang_word": "leuchtend",
                                "target_lang_sense_clarification": "hell scheinend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}