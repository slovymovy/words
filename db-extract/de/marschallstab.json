                "senses": [
                    {
                        "sense_id": "3d06b8e9-bba9-3844-9db6-a83c2d6220fd",
                        "entry_id": "11ea5ce7-aac5-3881-afb0-13412e4588ee",
                        "glosses": [
                            "militärisches Rangabzeichen für einen Feldmarschall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2702a763-4ab7-4b9d-87e2-ad1141ef0ce1",
                                "sense_id": "3d06b8e9-bba9-3844-9db6-a83c2d6220fd",
                                "text": "Im Museum ist der Marschallstab des Kurfürsten August ausgestellt."
                            },
                            {
                                "example_id": "3b2bcd64-41ca-4612-8035-b16c6b79e9f8",
                                "sense_id": "3d06b8e9-bba9-3844-9db6-a83c2d6220fd",
                                "text": "Wenn Sie heute die Universität mit Ihrem Examen verlassen, sollten Sie sich im Klaren darüber sein, dass Sie den Marschallstab im Tornister tragen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
