                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "564a0ca6-174d-3354-b8a1-19c31afcb9df",
                                        "entry_id": "549c40da-7077-3146-97a6-4d1ef43fca3a",
                                        "glosses": [
                                            "A serious form or stage of periodontal disease which may lead to loss of bone and falling out of teeth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277aacb2-09a5-4e2c-9928-07c43e25f3d5",
                                                "sense_id": "564a0ca6-174d-3354-b8a1-19c31afcb9df",
                                                "text": "An untreated gingivitis may lead to periodontitis, both forms of periodontal disease."
                                            },
                                            {
                                                "example_id": "7fc5e8a1-841f-4f63-957f-8cd1f0c2b885",
                                                "sense_id": "564a0ca6-174d-3354-b8a1-19c31afcb9df",
                                                "text": "Schlein reports favorable results from the use of Besredka's antivirus in cases of ulcerous stomatitis, acute pulpitis and periodontitides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
