                ],
                "senses": [
                    {
                        "sense_id": "8c324786-4f04-346b-a372-8644cf0e6d49",
                        "entry_id": "87974258-3932-30bc-ab4f-07c5bc20d517",
                        "glosses": [
                            "Wasser, in welchem Kochsalz gelöst wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88ff2ee8-12e2-4ba3-bce4-3f3bdf132515",
                                "sense_id": "8c324786-4f04-346b-a372-8644cf0e6d49",
                                "text": "„Das anschließende Spülen der Linse wird durch sterile Kochsalzlösung vorgenommen.“"
                            },
                            {
                                "example_id": "6dc85770-9060-4371-aa3d-ac65392517e3",
                                "sense_id": "8c324786-4f04-346b-a372-8644cf0e6d49",
                                "text": "„Das tägliche Spülen der Nase mit einer lauwarmen, isotonen Kochsalzlösung verbessert die Symptome einer Erkältung und beugt dem Wiederauftreten von Infektionen vor.“"
                            },
                            {
                                "example_id": "bc3087a1-c812-44e2-a0a7-93df61f1ede3",
                                "sense_id": "8c324786-4f04-346b-a372-8644cf0e6d49",
                                "text": "„Dabei dient Quecksilber dazu, Chlor aus einer Kochsalzlösung zu isolieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
