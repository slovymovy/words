                        "translation_id": "5b473dc4-29c6-401f-9446-c59409dc61f5",
                        "source_entry_id": "2e0e5377-fbe5-3381-9448-270feb6082af",
                        "source_sense_id": "5cfee88d-54d9-3731-a166-64b2525ed0b3",
