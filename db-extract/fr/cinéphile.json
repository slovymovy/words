                    }
                ],
                "senses": [
                    {
                        "sense_id": "a23ef1f1-a7c9-3aaa-b8b3-28c5b41fa682",
                        "entry_id": "d281ddff-a5df-3237-978b-f7a60631dcec",
                        "glosses": [
                            "Personne qui aime le cinéma."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f279a3-ee45-4be9-b81b-e031d8f7bcb4",
                                "sense_id": "a23ef1f1-a7c9-3aaa-b8b3-28c5b41fa682",
                                "text": "Le cinéphile, à partir des années 80, n’est plus ce que furent les membres actifs des ciné-clubs."
                            },
                            {
                                "example_id": "31dd4b0f-e79f-42e8-a7cd-883960d59bfc",
                                "sense_id": "a23ef1f1-a7c9-3aaa-b8b3-28c5b41fa682",
                                "text": "Si « Hitler, le Juif et le Troisième Homme », de Fernand Rohman, n’est pas à proprement parler un livre de cinéma, il tisse un tel réseau de références qu’il pourra être utilement lu en complément du récent « Hitler, un film d’Allemagne », de Syberberg, tellement cette gigantesque fresque (6 heures de projection) s’avère complexe et ardue à décryptographier pour des cinéphiles ayant peu de connaissances du sujet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c644c80-b71c-4725-b975-3991578a1c81",
                        "source_entry_id": "d281ddff-a5df-3237-978b-f7a60631dcec",
                        "source_sense_id": "a23ef1f1-a7c9-3aaa-b8b3-28c5b41fa682",
