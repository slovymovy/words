                        ]
                    },
                    {
                        "translation_id": "d9bd20dc-6016-4898-b099-da5044923954",
                        "source_entry_id": "dd2928e4-18a8-3c84-8a8f-29bf934c68ae",
                        "source_sense_id": "907fc490-8a99-35eb-83c5-d5c60be2fa85",
                        "target_lang_word": "Kaliningrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaliningrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3359dce-03d8-3c24-ad25-d4cec3a8c1e7",
                                        "entry_id": "e50504d1-88b5-3f2e-87cc-0c94878b4c68",
                                        "glosses": [
                                            "die westlichste Oblast Russlands, einer Exklave zwischen Polen und Litauen, und deren Hauptstadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9f0a2a-4163-4371-83fa-96c365e4a910",
                                                "sense_id": "f3359dce-03d8-3c24-ad25-d4cec3a8c1e7",
                                                "text": "Im heutigen Kaliningrad erinnert kaum noch etwas an die lange preußische Geschichte der Stadt; alleine der Königsberger Dom ist übrig geblieben."
                                            },
                                            {
                                                "example_id": "475d1268-8c1c-4bef-80e8-91b543cd516f",
                                                "sense_id": "f3359dce-03d8-3c24-ad25-d4cec3a8c1e7",
                                                "text": "„Vom polnischen Teil Ostpreußens sollten Busse über die Grenze nach Kaliningrad pendeln, und zwar aus Elblag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1251cd7c-09b1-422d-8c17-233e83c1533c",
                        "source_entry_id": "dd2928e4-18a8-3c84-8a8f-29bf934c68ae",
                        "source_sense_id": "907fc490-8a99-35eb-83c5-d5c60be2fa85",
                        "target_lang_word": "Königsberg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Königsberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                        "entry_id": "120fd940-638e-37b8-8cba-41a201223f9a",
                                        "glosses": [
                                            "deutsche Bezeichnung von Kaliningrad, Russland ( die Hauptstadt Preußens; die Hauptstadt Ostpreußens)"
                                        ],
                                        "tags": [
                                            "1525 - 1701",
                                            "1525 - 1945"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7770413-0386-4532-b91c-adc95ec10e6e",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "Die betagte alte Dame ist in Königsberg, also damals in Deutschland, geboren, laut ihrem heutigen Pass aber, kam sie Russland zur Welt."
                                            },
                                            {
                                                "example_id": "6b16ad84-29d1-4a31-b9ec-6fd6225d845f",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "In Königsberg wurden viele preußische Könige gekrönt, bis die Hauptstadt Preußens Berlin wurde."
                                            },
                                            {
                                                "example_id": "66e47947-f697-4d17-a6f8-52654d272d62",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "Königsberg wurden im Zweiten Weltkrieg schwere Schäden zugefügt."
                                            },
                                            {
                                                "example_id": "127ad0f5-691a-4229-8d98-cb5a5961831f",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "„Der ein Dichter des Absonderlichen werden sollte, wurde in Königsberg im Land des Bernsteins geboren.“"
                                            },
                                            {
                                                "example_id": "d5e1f3be-2a15-46a7-8e68-21cb9f7e80f7",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "„Dieses kleine Mißgeschick hinderte mich, einige Tage in Königsberg zu verbringen, an dessen Gouverneur, den Feldmarschall Lehwald, ich empfohlen war.“"
                                            },
                                            {
                                                "example_id": "1fae754c-1694-4b46-98d4-28938368f338",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "„In Königsberg, der Hauptstadt des Herzogtums Preußen, wurde Immanuel Kant am 22. April 1724 geboren.“"
                                            },
                                            {
                                                "example_id": "c39bb1c6-6c58-465f-ad4e-ff3472f5539e",
                                                "sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                                                "text": "„Schon im September 1944 wurde meiner Großmutter eine ausgebombte Familie mit zwei Kindern und Kindermädchen aus Königsbergzugewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e0d8fc0-986e-3bc0-b166-19ca092280a0",
                                        "entry_id": "120fd940-638e-37b8-8cba-41a201223f9a",
                                        "glosses": [
                                            "Königsberg in Bayern, Stadt im Landkreis Haßberge, Deutschland"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913c1696-4dfe-4f24-8802-0db66f9ba038",
                                                "sense_id": "9e0d8fc0-986e-3bc0-b166-19ca092280a0",
                                                "text": "Königsberg liegt im Südosten von Deutschland."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
