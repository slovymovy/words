                    {
                        "sense_id": "3c0da663-83a2-3f73-89ab-9337f86ca541",
                        "entry_id": "565c8086-abad-3306-bbfb-910fe880b63b",
                        "glosses": [
                            "Expressed in a statement; uttered or written."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce218607-6340-4933-b578-d2c661efb5cf",
                                "sense_id": "3c0da663-83a2-3f73-89ab-9337f86ca541",
                                "text": "Our stated policy of nonalignment has kept us out of any military alliance such as NATO and Warsaw Pact. However, in reality, we have had to concede ground to nations from which we import military hardware."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6e63e36-45fe-306a-9df8-71c349b257e6",
                        "entry_id": "565c8086-abad-3306-bbfb-910fe880b63b",
                        "glosses": [
                            "Settled; established; fixed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c6808360-1fda-4117-83ed-dd24feba5233",
                                "sense_id": "f6e63e36-45fe-306a-9df8-71c349b257e6",
                                "text": "[…] he had never any stated hours for his dinner, supper, or sleep; because, said he, we ought to attend the calls of nature, and not set our appetites to our meals […]"
                            }
                        ]
                    },
