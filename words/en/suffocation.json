                    "sense_id": "34a19753-ae3c-3f59-9a84-f47bcb01c31b",
                    "sense_definition": "The condition of being severely deprived of oxygen, leading to unconsciousness or death; asphyxia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "asphyxiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smoke was so thick that several firefighters showed early signs of <w>suffocation</w>.",
                            "target_lang_translations": {
                                "ru": "Дым был настолько густым, что у нескольких пожарных появились первые признаки <w>удушья</w>."
                            }
                        },
                        {
                            "text": "Leaving young children unattended in hot cars can lead to death by <w>suffocation</w>.",
                            "target_lang_translations": {
                                "ru": "Оставление маленьких детей без присмотра в нагретых машинах может привести к смерти от <w>удушья</w>."
                            }
                        }
                    ],
                    "synonyms": [
