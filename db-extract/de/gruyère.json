                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c6f212-4525-43d3-948f-a37d6f74680f",
                                "sense_id": "5db68b64-be3c-309e-a74b-d3395d00f8e1",
                                "text": "Heute gibt es ein Käsefondue mit einer Mischung aus Gruyère, Emmentaler und Appenzeller."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "facfaac2-e105-4147-901f-309b5e4c9257",
                        "source_entry_id": "c8722e8c-dedb-3ecd-8f68-e6afe36be4af",
                        "source_sense_id": "5db68b64-be3c-309e-a74b-d3395d00f8e1",
                        "source_sense_description": "Gastronomie: ein Schweizer Hartkäse (mit geschützter Herkunftsbezeichnung)",
                        "target_lang_word": "Gruyère",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gruyère",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54239169-eee7-3540-a279-683666eee308",
                                        "entry_id": "b3f5bacf-18cf-303c-9292-d25fb1d11889",
                                        "glosses": [
                                            "A hard yellow cheese originating from Gruyères, Switzerland and made in the cantons of Fribourg."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01381448-a2b1-4d69-a85a-dabdf3a031bd",
                                                "sense_id": "54239169-eee7-3540-a279-683666eee308",
                                                "text": "So many Gruyères are chopped […]"
                                            },
                                            {
                                                "example_id": "0b1a58ac-42e6-404d-99d4-f8f273d657f0",
                                                "sense_id": "54239169-eee7-3540-a279-683666eee308",
                                                "text": "Several cheeses fall into the Gruyère family. First and foremost is Swiss Gruyère. It is softer and smoother than Emmental and considered to be a better cooking cheese. The finest Gruyère has a slight dampness in its pea-sized eyes. The French cheese Beaufort, known as the Prince of Gruyères, is higher in butterfat than most Gruyères and has a sticky moist rind from the bacteria linens."
                                            },
                                            {
                                                "example_id": "141981ed-ab78-4aab-bcff-f01b0983f97d",
                                                "sense_id": "54239169-eee7-3540-a279-683666eee308",
                                                "text": "Cheese was traditionally made using rennet taken from the stomachs of slaughtered calves; some cheeses, such as Parmesan, Gorgonzola, most Gruyères and Roquefort, still are."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Gruyère",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9110497d-6df3-39e9-9876-a76f0b843fa3",
                                        "entry_id": "056f5e77-8e30-391b-ae61-3b697ce293ae",
                                        "glosses": [
                                            "A local government district in Fribourg canton, Switzerland; in full, Gruyère District."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0553720-78a8-4196-8126-a25d139c2237",
                        "source_entry_id": "c8722e8c-dedb-3ecd-8f68-e6afe36be4af",
                        "source_sense_id": "5db68b64-be3c-309e-a74b-d3395d00f8e1",
                        "source_sense_description": "Gastronomie: ein Schweizer Hartkäse (mit geschützter Herkunftsbezeichnung)",
                        "target_lang_word": "gruyère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gruyère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19c557e6-1885-334f-9fd6-6ba02fcbd182",
                                        "entry_id": "f8478ce2-c634-3168-b239-ce9cf3d02bb8",
                                        "glosses": [
                                            "Féminin singulier de gruyer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gruyère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f72394-0772-31ca-826d-f567b9b4b214",
                                        "entry_id": "f4919693-87e0-3345-a697-1dd389d70955",
                                        "glosses": [
                                            "Fromage au lait cru de vache et à pâte pressée cuite, sans trous, fabriqué essentiellement en Suisse romande mais aussi dans certaines communes de Suisse alémanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0978854a-d000-40d5-95ba-97468deebaf5",
                                                "sense_id": "c4f72394-0772-31ca-826d-f567b9b4b214",
                                                "text": "Il les effrayait un peu parfois quand on servait du gruyère et qu’il le mangeait avec la croûte. Pourquoi s’en prenait-il ainsi aux choses non comestibles et dures ?"
                                            },
                                            {
                                                "example_id": "c7433861-a6e0-4f2a-a99a-29f00f50c962",
                                                "sense_id": "c4f72394-0772-31ca-826d-f567b9b4b214",
                                                "text": "Cette ignorance ne l’empêcha pas de venir à bout de tout le repas, jusques et y compris la peau du saucisson et la croûte du gruyère."
                                            },
                                            {
                                                "example_id": "9a9cbe2e-cfc6-40ca-a1c9-6cb0f153df25",
                                                "sense_id": "c4f72394-0772-31ca-826d-f567b9b4b214",
                                                "text": "Le canton de Berne en fait aussi partie, sous la pression conjuguée du Jura bernois (où se produit du Gruyère et de la Tête de Moine) et de l’Oberland bernois, où naît le projet d'une AOC pour le fromage d'alpage et le fromage à rebibes (Hobelkäse)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c61818e-f36e-3fd3-a657-575b96a1dc77",
                                        "entry_id": "f4919693-87e0-3345-a697-1dd389d70955",
                                        "glosses": [
                                            "Autre fromage ressemblant au précédent, mais avec des trous, et très proche de l’emmental. Il est fabriqué en Franche-Comté et en Rhône-Alpes."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72541b51-039e-4559-ac66-404d5fab552c",
                                                "sense_id": "3c61818e-f36e-3fd3-a657-575b96a1dc77",
                                                "text": "Les races de vaches utilisées pour fabriquer le gruyère français sont la montbéliarde, la simmental, l’abondance, la tarentaise et la vosgienne."
                                            },
                                            {
                                                "example_id": "8cb977bc-bfd6-4df1-9f51-5aeadaa2a080",
                                                "sense_id": "3c61818e-f36e-3fd3-a657-575b96a1dc77",
                                                "text": "Devant une table, encombrée par un chanteau de pain, une demi-meule de gruyère et une innombrable quantité de bouteilles vides, les deux amis qu’on croyait morts devisaient paisiblement comme des sages."
                                            },
                                            {
                                                "example_id": "6a4310e3-4afb-485a-86c1-08dccb3bf26f",
                                                "sense_id": "3c61818e-f36e-3fd3-a657-575b96a1dc77",
                                                "text": "Papa aurait bien aimé y saupoudrer du parmesan râpé, sur sa soupe, mais maman trouve que le parmesan, au prix qu’il est, c’est bon pour les riches, que s’il veut du fromage il a qu’à se râper un peu de gruyère, il y en a toujours une croûte qui sue au fond d’un bol. Papa blêmit devant le sacrilège. Du gruyère dans la soupe ? Dans les pâtes ? Horreur ! Faut être un Français, un Allemand, un Méricain, un Marocain, pour avaler ça et pas tomber foudroyé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ecd41e-1002-383c-a962-a5b173924211",
                                        "entry_id": "f4919693-87e0-3345-a697-1dd389d70955",
                                        "glosses": [
                                            "Objet percé de multiples trous; passoire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2911b4c-0624-40a7-aa7b-4f81cd1c6d64",
                                                "sense_id": "f7ecd41e-1002-383c-a962-a5b173924211",
                                                "text": "Ainsi, 50 % des décisions de justice et 80 % des amendes ne sont ni exécutées, ni recouvrées dix-huit mois après avoir été prononcées ! L'État régalien est donc devenu un véritable gruyère!"
                                            },
                                            {
                                                "example_id": "db8f3fd1-ed2c-4296-99f9-b303cc5feed6",
                                                "sense_id": "f7ecd41e-1002-383c-a962-a5b173924211",
                                                "text": "Vilstuf est bâtie sur un vrai gruyère! Des lieues et des lieues de galeries naturelles qui courent dans toutes les directions."
                                            },
                                            {
                                                "example_id": "93101a3b-003d-4eca-851e-fe6fa4d3992e",
                                                "sense_id": "f7ecd41e-1002-383c-a962-a5b173924211",
                                                "text": "La rafale de mitraillette a fait du gruyère de ce mur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc0db55-0563-3b8e-820e-0d21f6f92801",
                                        "entry_id": "f4919693-87e0-3345-a697-1dd389d70955",
                                        "glosses": [
                                            "Yeux de gruyère : Yeux sans expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0fc7683-5fec-4f78-a3f3-db4fceb2bbbe",
                                                "sense_id": "fbc0db55-0563-3b8e-820e-0d21f6f92801",
                                                "text": "Ne me regardez pas avec ces yeux de gruyère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
