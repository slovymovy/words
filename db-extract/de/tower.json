                "senses": [
                    {
                        "sense_id": "e46af810-cf52-30fb-a2d1-c949641e3ebb",
                        "entry_id": "a682e99d-3c39-3314-82bb-6559f0346d48",
                        "glosses": [
                            "Turm auf einem Flugplatz, der zur Überwachung der Bewegungen auf und um diesen Flugplatz dient"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "48c28eea-49ae-43d4-846d-c91abbaa817e",
                                "sense_id": "e46af810-cf52-30fb-a2d1-c949641e3ebb",
                                "text": "Im Tower sitzen die Fluglotsen und koordinieren die Starts und Landungen."
                            },
                            {
                                "example_id": "0e852cde-d959-414f-85f3-f32373ca7f3a",
                                "sense_id": "e46af810-cf52-30fb-a2d1-c949641e3ebb",
                                "text": "Die Höhe des Towers ist unter anderem von der Größe des Rollfeldes abhängig."
                            },
                            {
                                "example_id": "0486a26f-c53d-4a26-bda0-33ecb6e0dd45",
                                "sense_id": "e46af810-cf52-30fb-a2d1-c949641e3ebb",
                                "text": "„Er zog sich am Automaten eine gekühlte Flasche Wasser und machte sich dann auf den Weg zum Tower des Flughafens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f23d555c-6abf-38b1-a6da-8572b3717f41",
                        "entry_id": "a682e99d-3c39-3314-82bb-6559f0346d48",
                        "glosses": [
                            "Gehäuse eines Computers in spezieller Bauform, zum aufrechten Aufstellen"
                        ],
                        "tags": [
                            "Informationstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "3b5e2dca-d9ed-4c73-b72e-ae6ff9636126",
                                "sense_id": "f23d555c-6abf-38b1-a6da-8572b3717f41",
                                "text": "Ein Computer ist für manchen Laien nur ein Monitor, eine Maus und eine Tastatur sowie der Klotz unter dem Schreibtisch - der Tower."
                            },
                            {
                                "example_id": "19aadd36-a46e-4959-b7e7-d5b5fdd24966",
                                "sense_id": "f23d555c-6abf-38b1-a6da-8572b3717f41",
                                "text": "Serversysteme werden in Racks eingebaut, Tower werden eher selten genutzt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4e315ed-f034-48d8-a160-469b7387f390",
                        "source_entry_id": "a682e99d-3c39-3314-82bb-6559f0346d48",
                        "source_sense_id": "e46af810-cf52-30fb-a2d1-c949641e3ebb",
