                        "examples": [
                            {
                                "example_id": "051827d7-366a-465e-aa6c-d87b166bdc56",
                                "sense_id": "3abe20d8-c1c4-39fd-aa64-e5a7b7efbd39",
                                "text": "„›Mir ist egal, wie gut du bist. Sich alleine in dieses Ödland zu wagen, ist eine Selbstmordmission. Dann müssen wir nicht mehr nach zwei, sondern nach drei Leuten suchen.‹“"
