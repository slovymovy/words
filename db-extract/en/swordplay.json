                                        "glosses": [
                                            "eine Kampfsportart, bei der zwei Fechter gegeneinander antreten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6269b1e8-fdb8-43f9-961f-a69470f2ada0",
                                                "sense_id": "4fff19a2-7f70-3252-8936-59d6199efa53",
                                                "text": "Sie ist im Fechten wesentlich besser trainiert."
                                            },
                                            {
                                                "example_id": "0b1edc88-356f-41f3-b661-866306c5b901",
                                                "sense_id": "4fff19a2-7f70-3252-8936-59d6199efa53",
                                                "text": "Tauberbischofsheim ist eine kleine Stadt mit nur 13.000 Einwohnern, aber eine Größe in der Welt des Fechtens."
                                            },
                                            {
                                                "example_id": "36091efd-01a5-4f3a-93b5-3705af0d4bf7",
                                                "sense_id": "4fff19a2-7f70-3252-8936-59d6199efa53",
                                                "text": "Sie spricht fließend Chinesisch, spielt Orgel und ist über den Modernen Fünfkampf zum Fechten gekommen: Olympiasiegerin Britta Heidemann. Beim Fechten habe sie sehr schnell herausgefunden, dass auch mentale Stärke, Konzentration und der richtige Fokus eine wichtige Rolle spielen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
