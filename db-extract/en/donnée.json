                        "glosses": [
                            "A given; in a literary work, that which is assumed as to characters, situation, etc., as a basis for the plot or story."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99f305fb-dffb-4bb2-bc7b-a117c2ec2853",
                                "sense_id": "2a0c4ae9-0a3c-395d-8ba8-a48c4fa6cb35",
                                "text": "We must grant the artist his subject, his idea, what the French call his donnée; our criticism is applied only to what he makes of it."
                            },
                            {
                                "example_id": "2a84b1a9-befd-43cc-beb8-aa9ba6b3410d",
                                "sense_id": "2a0c4ae9-0a3c-395d-8ba8-a48c4fa6cb35",
                                "text": "There is also some similarity between the general subject of both, which is that favourite romance donnée of the heir kept out of his own."
                            },
                            {
                                "example_id": "bcd360e8-2e7e-4577-b9af-9b83e125648e",
                                "sense_id": "2a0c4ae9-0a3c-395d-8ba8-a48c4fa6cb35",
                                "text": "The donnée is from Boccaccio's Decameron, where a party of Florentine gentry flee to the countryside to escape the Black Death."
                            }
                        ]
                    }
