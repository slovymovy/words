                    {
                        "sense_id": "4c984b12-001b-378b-9aca-fca9f5e3767c",
                        "entry_id": "11afa2df-bee7-3d84-91dd-37c816544a4d",
                        "glosses": [
                            "het totaal aan middelen om oorlog te voeren"
