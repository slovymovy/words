                        "form": "die Altruisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                        "entry_id": "bf1b7380-12ed-36a1-b223-c4ae5b39e816",
                        "glosses": [
                            "selbstloser Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdb9f3f-5f0d-4ad1-a128-695c7a38d897",
                                "sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                                "text": "Wovon der Altruist sich all die Jahre ernährt, bleibt unklar. Die Fluchthilfe ist für ihn, so betont er, kein Geschäft, sondern humanitäre Berufung und Strafaktion in einem."
                            },
                            {
                                "example_id": "8ef2cbe2-682d-4e0f-ac6f-4a144d870a23",
                                "sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                                "text": "Längst schon ist der Herrscher über das Microsoft-Imperium in die globale Altruisten-Liga aufgestiegen, auf Du und Du mit Bill Clinton, Buffet und Bono."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10a98542-9609-40b4-b790-04535f2a3ee2",
                        "source_entry_id": "bf1b7380-12ed-36a1-b223-c4ae5b39e816",
                        "source_sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                        "source_sense_description": "selbstloser Mensch",
                        "target_lang_word": "altruist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "122a6584-9b17-3c0b-a270-53994f1ef753",
                                        "entry_id": "230f1fd3-4d84-3461-9cf8-28091ad83dc3",
                                        "glosses": [
                                            "A person showing altruism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6609393b-82c3-418b-b090-c7adba5386a8",
                                                "sense_id": "122a6584-9b17-3c0b-a270-53994f1ef753",
                                                "text": "This event couldn't have been possible without the efforts of the altruists who helped in their spare time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d386584b-1055-4502-8a2b-4ae0f53bbf54",
                        "source_entry_id": "bf1b7380-12ed-36a1-b223-c4ae5b39e816",
                        "source_sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                        "source_sense_description": "selbstloser Mensch",
                        "target_lang_word": "altruiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                        "entry_id": "ab8a3c2f-9309-30b8-9393-9490afe203e2",
                                        "glosses": [
                                            "Qui manifeste de l’altruisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26a7f81-8453-4a99-978d-880b2fc8bf49",
                                                "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                                "text": "Un comportement altruiste, dirigé vers les organismes apparentés, aura toutes les chances de favoriser la propagation des gènes de lʼindividu qui adopte ce comportement."
                                            },
                                            {
                                                "example_id": "7734d72f-9688-4488-9b67-17f89caed901",
                                                "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                                "text": "Débusquer les bases biologiques d’un comportement n’enlève rien à l’humanisme du geste ni au libre arbitre : nous demeurons toujours libres de choisir entre un geste altruiste ou égoïste."
                                            },
                                            {
                                                "example_id": "3997ea35-9592-40dd-ac89-a711bdd7cd86",
                                                "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                                "text": "De plus, pour Monroe, un acte ne peut être considéré comme altruiste s’il ne comporte pas un risque et n'a aucun « coût », réel ou potentiel, pour celui qui le commet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "altruiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc48970-2428-37d3-8e36-dc85c3ceac5a",
                                        "entry_id": "81c8e141-b746-30b6-ab93-ccaca584dae8",
                                        "glosses": [
                                            "Celui, celle qui pratique l’altruisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93eca202-0473-48e2-a3da-659d65b3458c",
                                                "sense_id": "5cc48970-2428-37d3-8e36-dc85c3ceac5a",
                                                "text": "Le médecin apparaît à chacun comme un altruiste professionnel qui ne saurait être considéré avec la même rigueur et les mêmes règles que le criminel nuisible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
