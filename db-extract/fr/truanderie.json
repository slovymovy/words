                    },
                    {
                        "sense_id": "cf24d6df-2fc9-3cc8-b56d-878d012d170d",
                        "entry_id": "5ce73add-2dae-3a0e-986b-afc7844b22d3",
                        "glosses": [
                            "Ensemble des truands, pègre, manœuvres frauduleuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c009a90-c178-446f-a383-5cd4681cf07c",
                                "sense_id": "cf24d6df-2fc9-3cc8-b56d-878d012d170d",
                                "text": "La truanderie, cette picareria gauloise, acceptait l’égout comme succursale de la Cour des Miracles, et le soir, narquoise et féroce, rentrait sous le vomitoire Maubuée comme dans une alcôve."
                            },
                            {
                                "example_id": "2addc094-12c6-414a-b0f3-a044ac8bae3e",
                                "sense_id": "cf24d6df-2fc9-3cc8-b56d-878d012d170d",
                                "text": "Il connaissait Em depuis des années et savait son habileté et sa connaissance de la pègre. C’était une sorte de Bottin de la truanderie."
                            }
                        ]
                    },
                    {
                        "sense_id": "32ef5186-3361-3cbf-8836-73a7576029d7",
