                        "glosses": [
                            "A pale earth composed of strontium oxide (SrO)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0e855572-9510-48fc-97c5-c9133d2ce8e5",
                                "sense_id": "59e2ba6f-f7b7-3115-bad2-d61ba9ab11bc",
                                "text": "1829, Jacob Green, A Text Book of Chemical Philosophy, R. H. Small, page 247,\nFrom the close resemblance between baryta and strontia, these substances were once supposed to be identical."
                            },
                            {
                                "example_id": "7a0d847d-ea58-4fb4-947b-88d29e36374b",
                                "sense_id": "59e2ba6f-f7b7-3115-bad2-d61ba9ab11bc",
                                "text": "1825 [Clara F. Cutbush], James Cutbush, A System of Pyrotechny, 2018, Outlook Verlag, page 230,\nNitrate of strontia deflagrates on ignited coals Dr. Hope pointed out, that if nitrate of strontia be exposed to a red heat, and a combustible substance be, at this time, brought in contact with it, a deflagration, with a very vivid red flame, will be produced."
                            },
                            {
                                "example_id": "3121f2b0-d14b-4d3c-b444-f5366bafd6e5",
                                "sense_id": "59e2ba6f-f7b7-3115-bad2-d61ba9ab11bc",
                                "text": "1866, C. Remigius Fresenius, Manual of Qualitative Chemical Analysis, 2021, Salzwasser Verlag, page 103,\nThe solution of sulphate of strontia in hydrochloric acid is made turbid by chloride of barium, after addition of water."
                            }
                        ]
                    }
