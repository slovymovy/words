                                        "glosses": [
                                            "зоол., орнитол. разновидность домашней птицы семейства фазановых (лат. Gallus gallus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b91430a-b149-441a-8044-3ae7b7dce28e",
                                                "sense_id": "752c708c-7940-3755-8036-47d6994ee237",
                                                "text": "Наискось стояло несколько избушек; по улице бродило несколько куриц."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c6a995-2636-3fa3-95cb-45befbcb1ffb",
                                        "entry_id": "ace76818-ed0a-32f1-afb3-c1305e791367",
