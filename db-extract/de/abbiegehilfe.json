                    {
                        "sense_id": "5b204cb3-e8a0-316e-9e90-b334d08f5579",
                        "entry_id": "5127803f-c811-388b-9f00-255d4964cec0",
                        "glosses": [
                            "etwas, dass jemanden dabei unterstützt, die Fahrtrichtung (auf eine sichere Weise) bogenartig zu ändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a214d1a-8c97-4b14-bffc-61c9b1ad574d",
                                "sense_id": "5b204cb3-e8a0-316e-9e90-b334d08f5579",
                                "text": "„Durch eine neue Veloabbiegehilfe, die auf der Fahrbahn der Zürcherstrasse markiert worden ist, können Velofahrende ab sofort aus dem Schwanenkreisel via Abbiegehilfe in die Alleestrasse fahren.“"
                            },
                            {
                                "example_id": "ac46c96f-b150-4139-aff3-faa558aafb8d",
                                "sense_id": "5b204cb3-e8a0-316e-9e90-b334d08f5579",
                                "text": "„Die neue Abbiegehilfe aktiviert sich automatisch bei einer Geschwindigkeit von unter 30 km/h.“"
                            },
                            {
                                "example_id": "4dc52dff-31f9-4f16-b637-314c33cfd8e0",
                                "sense_id": "5b204cb3-e8a0-316e-9e90-b334d08f5579",
                                "text": "„Eine Abbiegehilfe ist baulich relativ einfach realisierbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
