                                        "entry_id": "8d8093f1-0016-335b-bb62-8a5a9cfd5fbb",
                                        "glosses": [
                                            "Darstellung, die zu sehr vereinfacht und somit der Komplexität des Gegenstandes nicht gerecht wird"
                                        ],
