                "senses": [
                    {
                        "sense_id": "e6c9697f-d757-392e-b917-d7ea4c5a33d0",
                        "entry_id": "832c7de1-52c9-3687-a8a2-857b69b276da",
                        "glosses": [
                            "Segmentierung, Zerlegung von Sätzen oder Wörtern in ihre Morphe (= bedeutungstragenden Bestandteile)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2758b5ed-6139-46fa-9f8e-e7161d92c58b",
                                "sense_id": "e6c9697f-d757-392e-b917-d7ea4c5a33d0",
                                "text": "Durch Morphsegmentierung von Wörtern oder Sätzen erhält man ihre Morphe."
                            },
                            {
                                "example_id": "9813eb82-3c21-4299-9ebb-ac41bde906dd",
                                "sense_id": "e6c9697f-d757-392e-b917-d7ea4c5a33d0",
                                "text": "Einfaches Beispiel für eine Morphsegmentierung: \"Manch-e Kind-er spiel-en lust-voll ander-en Kind-er-n bös-e Streich-e.\""
                            },
                            {
                                "example_id": "ecdfc0a1-9bd3-4b38-b6bb-ecdbe0fc0b1f",
                                "sense_id": "e6c9697f-d757-392e-b917-d7ea4c5a33d0",
                                "text": "Die Morphsegmentierung ist die Voraussetzung für die Klassifizierung der Morphe zu Morphemen."
                            },
                            {
                                "example_id": "5336387b-dac1-4481-9c31-59c4bedb0ef3",
                                "sense_id": "e6c9697f-d757-392e-b917-d7ea4c5a33d0",
                                "text": "„Im sogenannten »amerikanischen Strukturalismus« fand eine intensive Diskussion von Segmentierungsfragen - insbesondere auch der Morphsegmentierung - statt.“"
                            },
                            {
                                "example_id": "9750cf0f-a505-4d1f-8592-0b54db6ee93a",
                                "sense_id": "e6c9697f-d757-392e-b917-d7ea4c5a33d0",
                                "text": "„Ohne eines der genannten Verfahren strikt zu befolgen, seien hier einige Kriterien der Morphsegmentierung des Deutschen mit Beispielen erläutert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
