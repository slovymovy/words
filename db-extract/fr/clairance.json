                        "cross_references": []
                    },
                    {
                        "translation_id": "c17130a6-69df-41c4-b3f5-a4a5dc31a4fc",
                        "source_entry_id": "5a21805b-7a13-3579-b380-b59610b1be01",
                        "source_sense_id": "ab40aaec-b562-33e8-8467-a0cba63b62a1",
                        "source_sense_description": "Luftfahrt: Clearance, Freigabe",
                        "target_lang_word": "Freigabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freigabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22304fa4-cb2b-34d7-abe9-de5ef8fc5cbe",
                                        "entry_id": "55565da4-0892-3baa-a2f7-34016d4f9a47",
                                        "glosses": [
                                            "Erlaubnis zur Benutzung von etwas (beispielsweise Geld, ein Computernetzwerk)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8deae1c1-9b53-4081-a515-a040d85b8e15",
                                                "sense_id": "22304fa4-cb2b-34d7-abe9-de5ef8fc5cbe",
                                                "text": "Die Document Foundation hat die Freigabe von LibreOffice 6.1 bekannt gegeben […]"
                                            },
                                            {
                                                "example_id": "ecbb2be1-5229-4210-aed8-624dfaf3f57b",
                                                "sense_id": "22304fa4-cb2b-34d7-abe9-de5ef8fc5cbe",
                                                "text": "Wie der Hersteller der Spieleengine Xenko bekannt gab, wird die Software mit der Freigabe der aktuellen Version 3.0 unter den Bedingungen der MIT-Lizenz vertrieben."
                                            },
                                            {
                                                "example_id": "ed262c61-f9fd-4c25-8521-7f4b5b39180b",
                                                "sense_id": "22304fa4-cb2b-34d7-abe9-de5ef8fc5cbe",
                                                "text": "Der Finne Valtteri Bottas erhält von Williams die Freigabe für einen Wechsel zu Mercedes als Nachfolger des zurückgetretenen Formel-1-Weltmeisters Nico Rosberg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                        "entry_id": "55565da4-0892-3baa-a2f7-34016d4f9a47",
                                        "glosses": [
                                            "gesetzliche oder behördliche Aufhebung eines Verbots"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ac20cc-72d8-4af8-8bf9-d726faabb42c",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Der Geheimdienstausschuss des Repräsentantenhauses hatte am Montag für die Freigabe des Papiers gestimmt, Trump lehnte dies aber am Freitag ab."
                                            },
                                            {
                                                "example_id": "120e1101-9529-4317-afc7-c966d566cb7a",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Vor allem Frankreich, Spanien und Polen haben Bedenken gegen die Freigabe [von 75 Millionen chinesischen Kleidungsstücke zum Import in die EU] geäußert, weil sie um die Wettbewerbsfähigkeit der eigenen Textilbranche fürchten."
                                            },
                                            {
                                                "example_id": "639eeb2e-0938-413b-bb23-33e79b14f523",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Der Gesetzentwurf zur Freigabe der Ladenöffnungszeiten wurde am Dienstag vom nordrhein-westfälischen Kabinett verabschiedet […]"
                                            },
                                            {
                                                "example_id": "46384f7a-3b05-449e-b5d7-46363730b37d",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Nach der Freigabe durch die EU-Kommission können jetzt wie geplant die Tiefdrucksparten des Axel Springer Verlages und der Bertelsmann AG fusionieren."
                                            },
                                            {
                                                "example_id": "daba7d65-f9f7-4c35-81af-7124bda3d0fe",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Die gerade mit überwältigender Mehrheit beschlossene Freigabe der Abtreibung ist nur ein erster wichtiger Schritt zu einem freieren Irland."
                                            },
                                            {
                                                "example_id": "d93b1eab-0bf3-43a0-956b-91f2cea3f806",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Die Bundesanwaltschaft will bei Innenminister Wolfgang Schäuble die Freigabe der Akten beantragen, wenn nötig."
                                            },
                                            {
                                                "example_id": "fb3c5f8d-567f-4c7e-b10e-50e48eec4871",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "[Der bolivianische Botschafter bei der UN Pablo Solon] setzt sich bei den Vereinten Nationen dafür ein, dass die jahrtausendalte Tradition [des Koka-Kauens] beibehalten werden kann und betont dabei, dass er nicht für eine Freigabe von Kokain ist."
                                            },
                                            {
                                                "example_id": "2d74f602-e070-452a-82c7-968e7e4d4551",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Die Erleichterung war groß, nachdem sich die Euro-Finanzminister auf die Freigabe neuer Milliardenkredite für Griechenland geeinigt hatten."
                                            },
                                            {
                                                "example_id": "b5cb2445-3650-4333-90f2-9ddc698ef448",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Eine Genehmigungsbehörde muss zuvor die (Wartungs- und Instandhaltungs-)Arbeiten [an der Transrapidstrecke] allerdings abnehmen und eine Freigabe erteilen."
                                            },
                                            {
                                                "example_id": "88378bc3-a7b4-4a47-ba0a-8f9e3d0b5350",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Die Freigabe des vergrößerten Panama-Kanals soll den Warenverkehr zwischen den USA und Asien erleichtern und Panama viel Geld einbringen."
                                            },
                                            {
                                                "example_id": "89bfbfc5-b579-4bd1-b26f-dd02c736e63b",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Die testweise Freigabe des Pannenstreifens auf einem Abschnitt der Ostautobahn (A4) in Fahrtrichtung Ungarn beginnt heute, Freitag."
                                            },
                                            {
                                                "example_id": "aed338c3-f12f-488d-bb47-4209eec870c2",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "„Ich denke nicht, dass die Freigabe des [ägyptischen] Pfunds eine Reform darstellt.“"
                                            },
                                            {
                                                "example_id": "5c71c069-8d17-4d0d-be35-0065a240b86e",
                                                "sense_id": "3d7885d8-9099-3992-beda-535374d69ac7",
                                                "text": "Die Freigabe der Treibjagd [auf Wölfe bringt] nun ganze Rudel in Gefahr, warnt Umweltschützer Jan Kalavsky […]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "44e74b70-caa9-356e-8f7b-2db2f6329f85",
                                        "entry_id": "55565da4-0892-3baa-a2f7-34016d4f9a47",
                                        "glosses": [
                                            "Entlassung aus einer Haft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2178e672-99bb-481b-9a65-c260d8ca6af0",
                                                "sense_id": "44e74b70-caa9-356e-8f7b-2db2f6329f85",
                                                "text": "So steht es in einem Bericht der Bezirksbehörde der Deutschen Volkspolizei Cottbus. „Sie zogen vor das Gebäude der Kreisverwaltung und forderten dort vom Staatsanwalt die Freigabe aller inhaftierten Großbauern.“"
                                            },
                                            {
                                                "example_id": "f5982f30-dd51-4cd4-a6e1-cd67354c7cb6",
                                                "sense_id": "44e74b70-caa9-356e-8f7b-2db2f6329f85",
                                                "text": "Das gesamte gezahlte Lösegeld für die Freigabe dieser [von somalischen Piraten gekaperten] Schiffe soll rund 120 Millionen US-Dollar betragen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
