                            {
                                "example_id": "516560a0-bdd0-4042-aef4-f00f1b19fe54",
                                "sense_id": "5ec61db0-6706-3985-ab47-ff235afe9535",
                                "text": "Het boek van de homoseksuele stripmaker gaat onder meer over zijn zoektocht naar vriendschap en liefde. De boekpresentatie in de kerk vlak bij de Dom zou worden omlijst met optredens en interviews over het thema zonde."
                            },
                            {
                                "example_id": "37a339e3-15bb-4579-a5d8-a7e934b4489e",
                                "sense_id": "5ec61db0-6706-3985-ab47-ff235afe9535",
                                "text": "Tot nu toe waren zwarte personages helemaal afwezig in de Lucky Luke-serie. \"Toen ik ging terugkijken, was ik geschokt\", zegt Jul, de stripmaker die het scenario van het nieuwe album schreef. \"Ik realiseerde me dat de hele Frans-Belgische stripwereld verstoken is van zwarte personen, afgezien van een paar kleine karakters van tijd tot tijd.\""
                            },
                            {
                                "example_id": "0c5557a0-f13b-48d5-8a74-52e941cc589b",
                                "sense_id": "5ec61db0-6706-3985-ab47-ff235afe9535",
                                "text": "Deze stripmaker is hier nauwelijks bekend, maar in het buitenland breekt ze door"
                            }
                        ]
                    }
