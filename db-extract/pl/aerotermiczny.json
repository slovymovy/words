                    }
                ],
                "senses": [
                    {
                        "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                        "entry_id": "13d8fc56-4b1b-3ebc-a848-c55fbeb39236",
                        "glosses": [
                            "aerothermal"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "af5d3421-a2c5-47a7-aad8-6149fb76bffb",
                                "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                                "text": "piec aerotermiczny",
                                "translation": "aerothermal oven",
                                "english": "aerothermal oven"
                            },
                            {
                                "example_id": "1509768c-a768-4565-971e-a554607dc932",
                                "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                                "text": "od Salmana na wprowadzenie do państwa pieca aerotermicznego wynalezionego przez Kaisera, […]",
                                "translation": "from Salman for the introduction into the state of the aerothermic furnace invented by the Kaiser, […]",
                                "english": "from Salman for the introduction into the state of the aerothermic furnace invented by the Kaiser, […]"
                            },
                            {
                                "example_id": "9654cc35-a569-4d80-a7f7-82e877d91207",
                                "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                                "text": "— Przywileje na nowe wynalazki udzielone zostały następującym osobom: […]\n 3) Inżynierowi Wiktorowi Zalman, przywilej sześcioletni na piec aerotermiczny do wypieku chleba.",
                                "translation": "— Privileges for new inventions were granted to the following persons: […]\n 3) Engineer Wiktor Zalman, six-year privilege for the aerothermic oven for baking bread.",
                                "english": "— Privileges for new inventions were granted to the following persons: […]\n 3) Engineer Wiktor Zalman, six-year privilege for the aerothermic oven for baking bread."
                            },
                            {
                                "example_id": "11300e25-a224-407a-b642-830f16b1d117",
                                "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                                "text": "— Prośby o patenty na nowe wynalazki podali: […] Taddei na piec powietrzny czyli aerotermiczny",
                                "translation": "— Requests for patents for new inventions were submitted by: […] Taddei for an air oven that is an aerothermic oven.",
                                "english": "— Requests for patents for new inventions were submitted by: […] Taddei for an air oven that is an aerothermic oven."
                            },
                            {
                                "example_id": "03ef01dd-a1cf-4c02-81ea-c3e0c36b301b",
                                "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                                "text": "Wychodząc tedy z dwóch punktów: 1) że temperatura źródła w pewnych razach jest identyczna ze średnią roczną miejsca, 2) że w górach ze wzrastającą wysokością temperatura powietrza ubywa, autor stawia sobie prooblemat: za pomocą temperatury źródeł na różnych wysokościach oznaczyć dla południowego stoku gór Taurydzkich stopień aerotermiczny, tj. wielkość ubytku temperatury powietrza z wysokością.",
                                "translation": "Therefore, starting from two points: 1) that the temperature of the source in some cases is identical with the annual average of the place, 2) that in the mountains the air temperature decreases with increasing height, the author poses a problem: using the temperature of the sources at different heights, determine for the southern slope of the mountains of the Taurides, the aerothermic degree, i.e. the amount of air temperature loss with height.",
                                "english": "Therefore, starting from two points: 1) that the temperature of the source in some cases is identical with the annual average of the place, 2) that in the mountains the air temperature decreases with increasing height, the author poses a problem: using the temperature of the sources at different heights, determine for the southern slope of the mountains of the Taurides, the aerothermic degree, i.e. the amount of air temperature loss with height."
                            },
                            {
                                "example_id": "a8fb9820-2d60-451f-b49b-af5a3a849ec5",
                                "sense_id": "b14f5b24-cd87-30a0-b447-898ad6e03948",
                                "text": "W roku bieżącym wprowadzono również kąpiele aerotermiczne.",
                                "translation": "This year also aerothermic baths were introduced.",
                                "english": "This year also aerothermic baths were introduced."
                            }
                        ]
                    }
                ],
