                                        "glosses": [
                                            "für fünf Wochen, fünf Wochen dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc12d8d3-b1ad-4122-a2b1-053f4d9cdbe8",
                                                "sense_id": "eca0b5f6-2e40-3718-9339-933955ee4cb7",
                                                "text": "Im Sommer wird Peter ein fünfwöchiges Praktikum bei der Tischlerei absolvieren."
                                            }
