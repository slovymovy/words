                "senses": [
                    {
                        "sense_id": "b2e3e38c-7029-395e-85e0-7181e6b2afdd",
                        "entry_id": "1ae7880e-a8e1-3a3d-baca-f353cfe017bd",
                        "glosses": [
                            "met een zoute smaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68579af-a851-4515-a998-118aeb11151a",
                                "sense_id": "b2e3e38c-7029-395e-85e0-7181e6b2afdd",
                                "text": "\"Een goed betaalbaar alternatief en ook nog eens diervriendelijk. De smaak is bijzonder; het is licht ziltig en romig. De eitjes, die je samen proeft met een saus op basis van crème fraiche en gesnipperd ei, exploderen als het ware in je mond. Viskuit en aardappel gaan al tijden goed samen. Sla er de oude kookboeken maar op na,\" aldus Roos."
                            },
                            {
                                "example_id": "9b1f4ec7-5994-4329-a60e-0706a62cb750",
                                "sense_id": "b2e3e38c-7029-395e-85e0-7181e6b2afdd",
                                "text": "Ik druppel dan wat citroen en wodka op de oester, zodat je een smaakcombinatie krijgt van zoet, zuur en ziltig. Soms probeer ik mensen over te halen om te proeven. Meestal met een grapje. Dan zeg ik: \"Joh, probeer gewoon, misschien heb je geluk en zit er een parel in.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d242a4cc-6904-4d02-b408-b72792d6c47e",
                        "source_entry_id": "1ae7880e-a8e1-3a3d-baca-f353cfe017bd",
                        "source_sense_id": "b2e3e38c-7029-395e-85e0-7181e6b2afdd",
                        "target_lang_word": "brackish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brackish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0665519b-34c3-3993-84e1-c732e68aa4a2",
                                        "entry_id": "8d2310bf-22bd-3e92-b364-d691eebdd2b4",
                                        "glosses": [
                                            "Salty or slightly salty, as a mixture of fresh and sea water, such as that found in estuaries."
                                        ],
                                        "tags": [
                                            "of water"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "882380a8-86f8-4b09-8585-94af1f72e4bf",
                                                "sense_id": "0665519b-34c3-3993-84e1-c732e68aa4a2",
                                                "text": "...by a low courſe and too long ſporting with the briny Ocean it taſts brackiſh and inſalubrious..."
                                            },
                                            {
                                                "example_id": "30fb019d-cb98-4649-8e1e-8e3583f39d76",
                                                "sense_id": "0665519b-34c3-3993-84e1-c732e68aa4a2",
                                                "text": "1992, Joyce Carol Oates, Black Water, Penguin Books, paperback edition, page 4.\nOn all sides a powerful brackish marshland odor, the odor of damp, and decay, and black earth, black water."
                                            },
                                            {
                                                "example_id": "dbb6531b-e00b-49a0-aa8d-1b964b75f51e",
                                                "sense_id": "0665519b-34c3-3993-84e1-c732e68aa4a2",
                                                "text": "2004, David Mitchell, Cloud Atlas, Random House.\nThe water we took on at Chatham Isle is now brackish & without a dash of brandy in it, my stomach rebels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72238e97-9b3b-37e6-931a-bfbea54c6ab1",
                                        "entry_id": "8d2310bf-22bd-3e92-b364-d691eebdd2b4",
                                        "glosses": [
                                            "Distasteful; unpleasant; not appealing to the taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8eb4b9e-656f-46bf-a208-f33c6e47bdeb",
                                                "sense_id": "72238e97-9b3b-37e6-931a-bfbea54c6ab1",
                                                "text": "Therefore the bread he had to eat\nSeemed brackish, less like corn than tares;"
                                            }
                                        ]
