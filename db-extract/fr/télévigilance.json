                    {
                        "sense_id": "30035abf-802d-3638-9bd8-f7b019b70862",
                        "entry_id": "5dace3c6-c13b-3e70-a326-766fa85c5baa",
                        "glosses": [
                            "Service de secours permettant à une personne de demander de l’aide à domicile en cas d’urgence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e4c214-9a18-4f6f-9b93-32d405f5a61c",
                                "sense_id": "30035abf-802d-3638-9bd8-f7b019b70862",
                                "text": "« Prendre contact avec les opérateurs téléphoniques est compliqué pour une personne âgée. Elles entendent de la musique, une voix les invite à taper un, deux, trois..., elles s'embrouillent et parfois, malgré une longue patience, personne ne prend le combiné à l’autre bout de la ligne », a déclaré à Belga le directeur du système de télévigilance Télé-Secours, Bernard De Roover."
                            },
                            {
                                "example_id": "671429f9-7803-432f-839e-44bd1046bbf8",
                                "sense_id": "30035abf-802d-3638-9bd8-f7b019b70862",
                                "text": "Le développement des systèmes de télévigilance répond à ces besoins, aussi bien pour les personnes ayant un trouble physiologique, comme le diabète, ou un trouble cognitif, comme la maladie d’Alzheimer."
                            },
                            {
                                "example_id": "f7f2d0c5-69ae-43cf-b96f-156b627af413",
                                "sense_id": "30035abf-802d-3638-9bd8-f7b019b70862",
                                "text": "On pense aussi à y rattacher les prestations de télétravail effectués en équipe dans le cadre d’activité relevant de l’enseignement à distance et de la télévigilance."
                            }
                        ]
                    }
