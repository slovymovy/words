                                "example_id": "4fae9530-ff84-47b1-b5a8-857139ae5d48",
                                "sense_id": "8df3715c-3d37-39ea-997d-2d91a0a8b0f9",
                                "text": "J'adore sa voix mais sa façon de surlécher chaque mot!"
