                "senses": [
                    {
                        "sense_id": "670ff538-df67-35b3-8ba9-3c21cd65ca67",
                        "entry_id": "03d223e7-7538-32ef-b935-7921b30e44b7",
                        "glosses": [
                            "Faire perdre son caractère abruti à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7304f4e-1ad6-490a-b033-d3580df285f6",
                                "sense_id": "670ff538-df67-35b3-8ba9-3c21cd65ca67",
                                "text": "En attendant Melle Petit Corsage, Thomas affirme que seuls des chefs-d’œuvre dramatiques auraient quelque chance de désabrutir le peuple."
                            },
                            {
                                "example_id": "9b4a4416-d665-4b72-943b-4143f14f728b",
                                "sense_id": "670ff538-df67-35b3-8ba9-3c21cd65ca67",
                                "text": "Pour me désabrutir de la vie insipide où j’étais voué aux chiffres, j’avais comme principale ressource d’aller le soir au cercle Pigalle."
                            },
                            {
                                "example_id": "1b238b23-fe91-40d5-8619-42caa5dd4857",
                                "sense_id": "670ff538-df67-35b3-8ba9-3c21cd65ca67",
                                "text": "Pendant le repas Péchard s’échappe pour se \"désabrutir\"."
                            }
                        ]
                    }
