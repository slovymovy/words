                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d74427c-f62e-4779-ad19-7a002e33a641",
                                "sense_id": "8b5d68fe-c38e-336f-add9-ccd5bfd627a9",
                                "text": "„Nach einem brutalen Messerangriff auf offener Straße ist ein 15-Jähriger zu einer Jugendstrafe von fünf Jahren verurteilt worden.“"
                            },
                            {
                                "example_id": "e12b8cd8-45e1-44c0-bdb0-4a6178d29fbc",
                                "sense_id": "8b5d68fe-c38e-336f-add9-ccd5bfd627a9",
                                "text": "„Die große Jugendkammer des Oldenburger Landgerichts hat zwei 17-Jährige wegen gefährlicher Körperverletzung zu Jugendstrafen von drei Jahren verurteilt.“"
                            }
                        ],
