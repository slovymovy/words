                ],
                "senses": [
                    {
                        "sense_id": "13630199-965d-3864-9936-ed4a5377f0f5",
                        "entry_id": "943cc8cc-f1ce-3be1-8e11-e4f8ddf1e704",
                        "glosses": [
                            "water dat geschikt is om gedronken te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e46a54-4b5d-4169-81e9-d5431d61b13a",
                                "sense_id": "13630199-965d-3864-9936-ed4a5377f0f5",
                                "text": "In het westelijk deel van Nederland is het grondwater niet geschikt voor het maken van drinkwater"
                            },
                            {
                                "example_id": "6534c4e1-95b0-4a0a-9111-3bf9cf779850",
                                "sense_id": "13630199-965d-3864-9936-ed4a5377f0f5",
                                "text": "Andere opties voor waterfiltering zijn de Aquamira-chlorine-dioxine-druppels, of simpelweg chloor, waarvan alle bacteriën en microben blijkbaar doodgaan. Wc-chloor in je drinkwater, best een gekke gedachte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e64d6f1-afb1-4752-967c-ca999413484a",
                        "source_entry_id": "943cc8cc-f1ce-3be1-8e11-e4f8ddf1e704",
                        "source_sense_id": "13630199-965d-3864-9936-ed4a5377f0f5",
                        "source_sense_description": "water dat geschikt is om gedronken te worden",
                        "target_lang_word": "Trinkwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trinkwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                        "entry_id": "a87f56d7-2827-312d-b510-65aa129b84b1",
                                        "glosses": [
                                            "Wasser, das einem bestimmten Standard entspricht, um zum menschlichen Verzehr nutzbar zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71992f3d-83d4-4e92-834e-8e3e44e750a9",
                                                "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                                "text": "Trinkwasser ist die wichtigste Ressource der Erde. Es ist eins der drei Lebensmittel, neben Luft und Nahrung."
                                            },
                                            {
                                                "example_id": "c9bb5d76-d4ec-47a9-ab60-44d27a41d871",
                                                "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                                "text": "„Kritiker befürchten unabsehbare Umweltschäden, insbesondere für das Trinkwasser.“"
                                            },
                                            {
                                                "example_id": "8c3bf292-ddde-4081-ad91-8e4155367d9e",
                                                "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                                "text": "„Die meisten Bauern sind von der Stromversorgung ausgeschlossen und haben keinen direkten Zugang zu sauberem Trinkwasser.“"
                                            },
                                            {
                                                "example_id": "0ac4271f-8e52-4e16-8ba4-8ed83a08c426",
                                                "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                                "text": "„Nach kurzer Zeit auf See bemerkten wir, dass unser gesamtes Trinkwasser bis auf ein Fass verschwunden war.“"
                                            },
                                            {
                                                "example_id": "3e67a735-af5a-4e73-953a-eeb7c63ebbe0",
                                                "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                                "text": "„So teilten sie Trinkwasser mit Fröschen und Schnecken in den Bächen.“"
                                            },
                                            {
                                                "example_id": "0da1f420-ebdc-480c-ad02-d197823b678d",
                                                "sense_id": "b1e05976-815e-36bd-a22f-ca55139645f1",
                                                "text": "„Bei akutem Wassermangel hilft oft nur, Trinkwasser zu rationieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cbd3b7f-8240-42f8-934b-80e25736d3d3",
                        "source_entry_id": "943cc8cc-f1ce-3be1-8e11-e4f8ddf1e704",
                        "source_sense_id": "13630199-965d-3864-9936-ed4a5377f0f5",
                        "source_sense_description": "water dat geschikt is om gedronken te worden",
                        "target_lang_word": "drinking water",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drinking water",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c3bb120-3996-3351-92ee-f49cb9ffeb6d",
                                        "entry_id": "ef787015-f99d-3597-9e1b-aae4d61348c6",
                                        "glosses": [
                                            "Water that is suitable or intended for ingestion by humans: potable water."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e1d063f-1d39-45cc-863d-e33c46ca3443",
                                                "sense_id": "4c3bb120-3996-3351-92ee-f49cb9ffeb6d",
                                                "text": "Near-synonym: tap water (for washing and, ideally, drinking too)"
                                            },
                                            {
                                                "example_id": "211793ce-7b82-4b89-adcf-4118d5298879",
                                                "sense_id": "4c3bb120-3996-3351-92ee-f49cb9ffeb6d",
                                                "text": "One day a saint, wandering in the vicinity in search of drinking water, fainted. As he regained his senses, he could hear the trickle of water running from the Pot. He drank his fill and since then the spring has never gone dry."
                                            },
                                            {
                                                "example_id": "c5c0f292-af56-4f79-b058-25ba481ecedb",
                                                "sense_id": "4c3bb120-3996-3351-92ee-f49cb9ffeb6d",
                                                "text": "It seems unlikely that the ancient Maya would have ventured into Actun Pech in search of drinking water when it could have been more easily and regularly procured from local wells. Rather, the water collected from Actun Pech and other caves discussed below, was likely valued for its remote and sacred origin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e62ce0a-b084-4a43-8ea8-0a11390c57a7",
                        "source_entry_id": "943cc8cc-f1ce-3be1-8e11-e4f8ddf1e704",
                        "source_sense_id": "13630199-965d-3864-9936-ed4a5377f0f5",
                        "source_sense_description": "water dat geschikt is om gedronken te worden",
                        "target_lang_word": "eau potable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau potable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf02596-89a9-373f-956a-61ab46098f5a",
                                        "entry_id": "b748d59d-c13f-3870-8859-731900646503",
                                        "glosses": [
                                            "Eau dont les caractéristiques physico-chimiques, microbiologiques et organoleptiques la rendent propre à la consommation humaine."
                                        ],
                                        "tags": [
                                            "Hydrologie appliquée",
                                            "Santé publique",
                                            "Gestion de l’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a18e139-3e50-4d17-bb1f-6f04db5c39cb",
                                                "sense_id": "4bf02596-89a9-373f-956a-61ab46098f5a",
                                                "text": "Ces chiffres comparés avec le nombre de pieds cubes d'eau que les aqueducs de la ville fournissent en 24 heures, démontreraient, ce que la simple inspection des fontaines publiques aux diverses heures du jour et de la nuit prouve déjà, que les deux tiers environ de l’eau potable qui arrive à Lausanne se répandent dans les égouts , sans avoir été préalablement utilisés."
                                            },
                                            {
                                                "example_id": "ded57045-010e-4f95-9c3b-74963939caf8",
                                                "sense_id": "4bf02596-89a9-373f-956a-61ab46098f5a",
                                                "text": "Hippocrate définissait ainsi les caractères des eaux potables : « Une bonne eau doit être limpide, légère, aérée, sans odeur ni saveur sensible, chaude en hiver, fraîche en été. »"
                                            },
                                            {
                                                "example_id": "54e9aac5-b214-47a8-9c9c-6bd2ee2ccfa8",
                                                "sense_id": "4bf02596-89a9-373f-956a-61ab46098f5a",
                                                "text": "Le groupement d'entreprises Suez-Ragot entame cette semaine le chantier d'une usine de décarbonatation de l’eau potable pour le compte de la commune de Saint-Jean-de-Braye (Loiret) et de la métropole d’Orléans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
