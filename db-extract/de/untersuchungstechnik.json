                "senses": [
                    {
                        "sense_id": "5ab6a550-c5d6-3a7c-9ef0-0953bcbd56b4",
                        "entry_id": "5883bf9e-9d66-31b7-8006-f03551a2ad62",
                        "glosses": [
                            "Methode (Technik) mit der etwas betrachtet und analysiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ebc2aa-58b5-4320-91aa-7a89c26c9632",
                                "sense_id": "5ab6a550-c5d6-3a7c-9ef0-0953bcbd56b4",
                                "text": "„Untersuchungstechniken bei Rücken- und Nackenschmerzen umfassen klinische neuroorthopädische Untersuchungen sowie apparative Verfahren inklusive der apparativen Funktionsdiagnostik, der Bildgebung, der Neurophysiologie und Laboruntersuchungen.“"
                            },
                            {
                                "example_id": "74865367-fde0-48c1-ad7d-ec86fbbe8c04",
                                "sense_id": "5ab6a550-c5d6-3a7c-9ef0-0953bcbd56b4",
                                "text": "„Die Bronchoskopie ist eine Routine-Untersuchung, schwerere Komplikationen sind bei der heutigen Untersuchungstechnik sehr selten.“"
                            },
                            {
                                "example_id": "cd15ea44-2914-4cdf-992e-a7c6a74355fd",
                                "sense_id": "5ab6a550-c5d6-3a7c-9ef0-0953bcbd56b4",
                                "text": "„Eine weitere Sonographische Untersuchungstechnik ist die Kontrastechographie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
