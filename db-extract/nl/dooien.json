                ],
                "senses": [
                    {
                        "sense_id": "7f850022-4f1d-3790-9bf5-2145063195b2",
                        "entry_id": "b234af6e-8835-36da-bd66-cc07df4645ec",
                        "glosses": [
                            "het stijgen van de buitentemperatuur boven het vriespunt waardoor alle ijs en sneeuw begint te smelten"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "8cbe3372-b565-4506-beb5-05e055369b06",
                                "sense_id": "7f850022-4f1d-3790-9bf5-2145063195b2",
                                "text": "Het dooide gedurende de dag, maar 's nachts vroor het weer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf155352-0e4c-3d04-911d-f0a520c48b7c",
                        "entry_id": "b234af6e-8835-36da-bd66-cc07df4645ec",
                        "glosses": [
                            "door een boven het vriespunt stijgende temperatuur vloeibaar worden"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "fe20fbba-0ed5-4f21-b443-beb1af2aace0",
                                "sense_id": "bf155352-0e4c-3d04-911d-f0a520c48b7c",
                                "text": "De sneeuw begon te dooien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "646b1470-75ba-4c53-ba5e-1259fadb696f",
                        "source_entry_id": "b234af6e-8835-36da-bd66-cc07df4645ec",
                        "source_sense_id": "7f850022-4f1d-3790-9bf5-2145063195b2",
                        "source_sense_description": "het stijgen van de buitentemperatuur boven het vriespunt waardoor alle ijs en sneeuw begint te smelten",
                        "target_lang_word": "tauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a18cbe90-b0b6-3808-8e15-69f2b307b3d2",
                                        "entry_id": "6d7f414e-4c7a-3adf-a683-cf23a8823020",
                                        "glosses": [
                                            "flüssig werden von Eis oder Schnee durch Wärme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ff4704-273f-47e8-9bbb-3f13cfbb2f41",
                                                "sense_id": "a18cbe90-b0b6-3808-8e15-69f2b307b3d2",
                                                "text": "„Wenn die Sonne so kräftig wie heute scheint, dann tauen die Eiszapfen an der Regenrinne. Achtung, dass dir keiner auf den Kopf fällt!“"
                                            },
                                            {
                                                "example_id": "157a53f7-eee5-4338-955f-0d7f2a661dfa",
                                                "sense_id": "a18cbe90-b0b6-3808-8e15-69f2b307b3d2",
                                                "text": "Wegen des milden Klimas der letzten Wochen taute der Schnee auf den vergleichsweise warmen Erdböden der Mittelgebirge aber zügig wieder ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec03a76f-4ddc-31ee-8951-a1a84f75d29a",
                                        "entry_id": "6d7f414e-4c7a-3adf-a683-cf23a8823020",
                                        "glosses": [
                                            "so warm sein oder werden, dass Eis und Schnee draußen flüssig werden"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2424e85f-982b-4646-8a62-595ee221326f",
                                                "sense_id": "ec03a76f-4ddc-31ee-8951-a1a84f75d29a",
                                                "text": "Bei Temperaturen über 0 °C taut es."
                                            },
                                            {
                                                "example_id": "36dfb4c5-5672-448b-8024-37782f9d32a2",
                                                "sense_id": "ec03a76f-4ddc-31ee-8951-a1a84f75d29a",
                                                "text": "Der Frühling ist da, schon gestern hat es stark getaut."
                                            },
                                            {
                                                "example_id": "369e09b9-2116-443d-8225-a889028a0f61",
                                                "sense_id": "ec03a76f-4ddc-31ee-8951-a1a84f75d29a",
                                                "text": "Selbst wenn es taut können die Straßen im Schatten auf gefrorenem Boden noch gefährlich glatt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3aebf6-ea8a-3baf-a322-fa8d038775eb",
                                        "entry_id": "59a9967f-a5b7-36bb-a519-ff405ef96b44",
                                        "glosses": [
                                            "mit einem Tau vorwärtsziehen; schleppen"
                                        ],
                                        "tags": [
                                            "North German",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c31b90-b6f8-4f52-9596-1c5547e083a8",
                                                "sense_id": "2c3aebf6-ea8a-3baf-a322-fa8d038775eb",
                                                "text": "Schließlich lag das Schiff parallel zum Passagierkai, wurde vorsichtig längsseits getaut, an Deck standen die Gäste und warteten gespannt auf den Moment, in dem aus der Nebelwand die Kaibeleuchtung auftauchen würde."
                                            },
                                            {
                                                "example_id": "06bbdb5f-e31d-45c0-b031-9f3aa2fefffc",
                                                "sense_id": "2c3aebf6-ea8a-3baf-a322-fa8d038775eb",
                                                "text": "Der Schlepperkapitän habe dem Lotsen deshalb den Vorschlag gemacht, nach achteraus zu tauen. Die FALCON BAY sei nun sehr schnell freigekommen. Sofort danach habe man wieder quer getaut, um das Schiff stromrecht zu legen."
                                            },
                                            {
                                                "example_id": "193835d3-f26d-4627-9acc-d8e4f5c4adf1",
                                                "sense_id": "2c3aebf6-ea8a-3baf-a322-fa8d038775eb",
                                                "text": "In einem halben Monde nahte sich die ganze Flotte von siebzig bis achtzig Schiffen (die Schiffe von den Galeeren getaut) den Laufgräben, deren Stücke jetzt gegen das Meer gekehrt; …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25d191ec-b229-4945-a47b-5fae9c0bb5f8",
                        "source_entry_id": "b234af6e-8835-36da-bd66-cc07df4645ec",
                        "source_sense_id": "7f850022-4f1d-3790-9bf5-2145063195b2",
