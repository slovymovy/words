                "senses": [
                    {
                        "sense_id": "011b6e2f-b987-3f07-9ef6-4b3aa6695180",
                        "entry_id": "cffd3af9-9a45-3993-8bc0-0dd7198c8889",
                        "glosses": [
                            "To join again; to unite after separation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ea64f3-1a0d-42bb-934d-2b117a021ee6",
                                "sense_id": "011b6e2f-b987-3f07-9ef6-4b3aa6695180",
                                "text": "Soon after departure, we cross the invisible border into Scotland to enjoy more stunning coastal scenery, before the line finally swings inland at Burnmouth to traverse pine-clad valleys, shadowed by the A1 trunk road until we rejoin the coast at Cove, east of Dunbar."
                            }
                        ]
                    },
                    {
                        "sense_id": "64d08a4b-e162-379e-9ef6-fc0eb4dd6f6d",
                        "entry_id": "cffd3af9-9a45-3993-8bc0-0dd7198c8889",
                        "glosses": [
                            "To come, or go, again into the presence of; to join the company of again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ac78f3-0bdc-4e6e-92e4-61c9c6ea5fa3",
                                "sense_id": "64d08a4b-e162-379e-9ef6-fc0eb4dd6f6d",
                                "text": "Meet and rejoin me, in my penſive Grott."
                            },
                            {
                                "example_id": "b5cb5fcf-a51c-4d8d-8e73-33fa607d303c",
                                "sense_id": "64d08a4b-e162-379e-9ef6-fc0eb4dd6f6d",
                                "text": "The pair parted company and Stephen rejoined Mr Bloom, who with his practised eye, was not without perceiving that he had succumbed to the blandiloquence of the other parasite. Alluding to the encounter he said, laughingly, Stephen, that is: […]"
                            },
                            {
                                "example_id": "10bb8406-8422-4960-bca2-9c168887ea84",
                                "sense_id": "64d08a4b-e162-379e-9ef6-fc0eb4dd6f6d",
                                "text": "Williams had a problem fitting his left rear tyre and that left Alonso only 3.1secs adrift when he rejoined from his final stop three laps later."
                            }
                        ]
                    }
                ],
