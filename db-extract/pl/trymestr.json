                "senses": [
                    {
                        "sense_id": "af5a38c9-8aa0-3f27-8094-5a958474007d",
                        "entry_id": "1e3e7b6f-beaf-381b-b99e-0b5a0bea1b09",
                        "glosses": [
                            "trzymiesięczny okres stanowiący jedną trzecią roku akademickiego na niektórych uczelniach"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3c3440-c533-450c-8c1f-5d094e2b2a0c",
                                "sense_id": "af5a38c9-8aa0-3f27-8094-5a958474007d",
                                "text": "A jak zapewniają nasi rozmówcy, kto choć jeden trymestr postudiuje w Anglii, ten już raczej nie wróci na polską uczelnię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2a962940-1763-3d22-abb0-2f9422ce40ca",
                        "entry_id": "1e3e7b6f-beaf-381b-b99e-0b5a0bea1b09",
                        "glosses": [
                            "trzymiesięczny okres stanowiący jedną trzecią ciąży u kobiety"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c648b92-d0a8-4c0b-9023-fbf952bc6088",
                                "sense_id": "2a962940-1763-3d22-abb0-2f9422ce40ca",
                                "text": "Są różne podziały czasu trwania ciąży, możemy ją liczyć w tygodniach, miesiącach lub trymestrach"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
