                            {
                                "example_id": "9dbe7947-c815-4607-9fe7-5342f00b8daf",
                                "sense_id": "7bb5a707-0d4e-3d78-8c2c-3b63cf1e5083",
                                "text": "Herr Synnatzschke ist jetzt Pensionär."
                            },
                            {
                                "example_id": "74687d57-47ee-42a4-bc72-0b867f32ce96",
                                "sense_id": "7bb5a707-0d4e-3d78-8c2c-3b63cf1e5083",
                                "text": "In München besucht er seine Kollegin Synnatzschke."
                            },
                            {
                                "example_id": "9a226645-6d7a-4cfb-a788-3c2c24213b10",
                                "sense_id": "7bb5a707-0d4e-3d78-8c2c-3b63cf1e5083",
                                "text": "Die Synnatzschkes engagieren sich für den Tierschutz."
                            },
                            {
                                "example_id": "c807fa63-d992-4b53-a4c6-f7794755d58b",
                                "sense_id": "7bb5a707-0d4e-3d78-8c2c-3b63cf1e5083",
                                "text": "Herrn Synnatzschkes neuer Roman liegt wie Blei in den Regalen."
                            },
                            {
                                "example_id": "be2acabb-3571-4e60-9047-cd1812829589",
                                "sense_id": "7bb5a707-0d4e-3d78-8c2c-3b63cf1e5083",
                                "text": "Jetzt hören Sie uns mal zu, Synnatzschke!"
                            }
