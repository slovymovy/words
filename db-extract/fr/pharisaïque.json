                        "entry_id": "8256a790-34a7-34f0-b605-9a9c855e941f",
                        "glosses": [
                            "Qui tient du caractère des pharisiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4bb2c8a-9b5f-4cc4-aca6-e573322752e8",
                                "sense_id": "88f26754-8ca6-34c3-b259-e182a01f8012",
                                "text": "Orgueil pharisaïque."
                            },
                            {
                                "example_id": "08cef705-a1f8-4240-a6cc-c66cd8f8dc47",
                                "sense_id": "88f26754-8ca6-34c3-b259-e182a01f8012",
                                "text": "Justice pharisaïque."
                            }
