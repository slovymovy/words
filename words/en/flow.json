                            "target_lang_translations": {
                                "ru": "Спортсмены часто выступают лучше всего, когда испытывают состояние <w>потока</w>.",
                                "nl": "Atleten presteren vaak op hun best wanneer ze <w>flow</w> ervaren."
                            }
                        }
