                                    {
                                        "sense_id": "d0ff1f02-29e6-33c2-a488-5fef215d6488",
                                        "entry_id": "ada558d1-2a0f-3f1e-afba-0e954bec8ed6",
                                        "glosses": [
                                            "An advantage consisting in starting a competition or task earlier than might be expected; given (or taken), for example, prior to the beginning of a race."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495100e2-17d1-4122-99f4-d73ad9d6e371",
                                                "sense_id": "d0ff1f02-29e6-33c2-a488-5fef215d6488",
                                                "text": "Fred gave his younger brother a five minute head start in the Easter egg hunt."
                                            },
                                            {
                                                "example_id": "a871eff2-649b-4539-9f40-74e154e96279",
                                                "sense_id": "d0ff1f02-29e6-33c2-a488-5fef215d6488",
                                                "text": "I want to set off at dawn to get a head start over the competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f821d9-60c7-3e45-84c1-8ca1e9500a14",
                                        "entry_id": "ada558d1-2a0f-3f1e-afba-0e954bec8ed6",
                                        "glosses": [
                                            "A factor conducive to superiority and success."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec855bc-e428-4082-b850-094e0e5cdb7b",
                                                "sense_id": "08f821d9-60c7-3e45-84c1-8ca1e9500a14",
                                                "text": "His father's money gave him a head start in life."
                                            }
                                        ]
                                    }
                                ]
