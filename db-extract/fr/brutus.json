                        "glosses": [
                            "Lucius Junius Brutus, fondateur légendaire de la République romaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664e50e2-018c-474c-bfec-f529ea7a0b17",
                                "sense_id": "dfe27a7f-7635-324b-a9ee-ab64dda1fd0a",
                                "text": "Lorenzo. – Brutus a fait le fou pour tuer Tarquin, et ce qui m’étonne en lui, c’est qu’il n’y ait pas laissé sa raison."
                            }
                        ]
                    },
                    {
                        "sense_id": "224f3a52-aed8-3dfe-8a8a-f9670edb1e7c",
                        "entry_id": "7ba3e332-d957-3b4c-82a9-208962ea4af5",
                        "glosses": [
                            "Marcus Junius Brutus, qui participa à l’assassinat de Jules César en 44 av. J.-C."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851923bf-ebf1-418e-a0cc-e9b7ca37da92",
                                "sense_id": "224f3a52-aed8-3dfe-8a8a-f9670edb1e7c",
                                "text": "Il y avait alors une fièvre de délation. Pas un marmiton qui ne se crût un Brutus pour avoir trahi les maîtres qui le nourrissaient."
                            },
                            {
                                "example_id": "0a9617b9-905d-4bdd-8e31-b83a224a6c5b",
                                "sense_id": "224f3a52-aed8-3dfe-8a8a-f9670edb1e7c",
                                "text": "Mais Pompée est battu à la bataille de Pharsale, et Brutus opte alors pour César, qui finit par le considérer comme son fils et le nomme gouverneur de la Gaule Cisalpine."
                            }
                        ]
                    }
