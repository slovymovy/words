                        "examples": [
                            {
                                "example_id": "0c5d620e-f2a0-4e5e-bec0-502b10745453",
                                "sense_id": "bc5796db-1f4a-32e7-82fb-39228c369c13",
                                "text": "– Y a-t-il plus grand goulafre que ces princes, ces ducs, le Condé, le Soissons, et le nôtre, le Nevers, et le gros d’Épernon, qui, lorsqu’ils en ont plein les bajoues et la panse, s’empiffrent, les cochons, de millions à crever, et quand le roi est mort, vont piller son trésor ! Voilà leur honneur à eux !"
                            },
                            {
                                "example_id": "c0913298-af30-46a1-9a5f-ee77f004acc3",
                                "sense_id": "bc5796db-1f4a-32e7-82fb-39228c369c13",
                                "text": "Jacques lui avait conseillé de planquer la nourriture. Ce type était un estomac sur pattes, elle n’avait jamais vu un goulafre pareil !"
                            }
                        ]
                    }
