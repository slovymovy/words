                                            {
                                                "example_id": "0b37ddc3-f9b8-4bb1-ae3c-a0c04a95560a",
                                                "sense_id": "7bff67de-07c7-384a-b39a-7314b74cb8df",
                                                "text": "Куча железных винтов, слесарных инструментов, блестящих кофейников и подсвечников была на столе; пол был засорён медными и железными опилками."
                                            },
                                            {
                                                "example_id": "c75ea9fd-843c-4345-b81d-e270b713d371",
                                                "sense_id": "7bff67de-07c7-384a-b39a-7314b74cb8df",
                                                "text": "Он застенчиво ходил около верстака и полою армяка сметал с него опилки и стружки."
                                            }
                                        ]
                                    }
