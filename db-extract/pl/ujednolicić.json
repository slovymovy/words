                "senses": [
                    {
                        "sense_id": "238605f7-e2bd-32a6-9ca3-de9c6cb23e1b",
                        "entry_id": "97de638b-fa16-33e0-9aad-aadf79cdea7b",
                        "glosses": [
                            "to homogenize, to make homogeneous"
                        ],
                        "tags": [
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "88e309a9-4663-4e51-9f69-c8e85528d3d9",
                                "sense_id": "238605f7-e2bd-32a6-9ca3-de9c6cb23e1b",
                                "text": "Poprawiał jednak nie tylko Mickiewicz, lecz przede wszystkim Bohdan Jański starając się ujednolicić pisownię, ale stosując niekonsekwentne i chaotyczne kryteria w transkrypcjach pisowni Mickiewicza...",
                                "translation": "But it was not Mickiewicz who corrected, but first of all Bohdan Jański, who tried to homogenize the orthography but used inconsistent and chaotic criteria in his transcriptions of Mickiewicz's writing...",
                                "english": "But it was not Mickiewicz who corrected, but first of all Bohdan Jański, who tried to homogenize the orthography but used inconsistent and chaotic criteria in his transcriptions of Mickiewicz's writing..."
                            },
                            {
                                "example_id": "7b965330-b47e-47a1-acd8-bc10d0aef01d",
                                "sense_id": "238605f7-e2bd-32a6-9ca3-de9c6cb23e1b",
                                "text": "Dzisiaj niby ujednolica ją [kulturę europejską] kino, ale nie tak skutecznie, jak wówczas robiły to paryskie salony.",
                                "translation": "Now it's as though the movie theater is homogenizing it [European culture], but not as effectively as the Parisian salons did then.",
                                "english": "Now it's as though the movie theater is homogenizing it [European culture], but not as effectively as the Parisian salons did then."
                            },
                            {
                                "example_id": "95484bf0-fb61-48ee-b74f-2d477d49885b",
                                "sense_id": "238605f7-e2bd-32a6-9ca3-de9c6cb23e1b",
                                "text": "Harmonizacja rachunkowości ... to jej ujednolicenie, mające na celu zbliżenie (współżycie) poszczególnych krajowych systemów rachunkowości poprzez eliminowanie różnic między nimi...",
                                "translation": "The harmonization of accounting ... is its homogenization, which has as its purpose the bringing together (coexistence) of each country's system of accounting through the elimination of differences between them...",
                                "english": "The harmonization of accounting ... is its homogenization, which has as its purpose the bringing together (coexistence) of each country's system of accounting through the elimination of differences between them..."
                            }
                        ]
                    },
