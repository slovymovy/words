                "translations": [
                    {
                        "translation_id": "06009ee0-1888-411f-bdec-70e425b0acc0",
                        "source_entry_id": "dd4cf9ef-6672-33e4-90c7-6633326fc9ce",
                        "source_sense_id": "aedcb8bc-2783-3849-a6b3-8e483be55da3",
