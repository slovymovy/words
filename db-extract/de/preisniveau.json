                "senses": [
                    {
                        "sense_id": "f7d285f5-e6c3-310b-a0ad-41c7e116f795",
                        "entry_id": "ebcee44d-c5cb-3b8a-a1ab-527dd79a8fb2",
                        "glosses": [
                            "Höhe der Preise für relevante Waren und Dienstleistungen in einer Ökonomie, gemessen am volkswirtschaftlichen Warenkorb und dessen Preisindex"
                        ],
                        "tags": [
                            "Volkswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "090131ad-0662-40ad-ad52-3393223e9c51",
                                "sense_id": "f7d285f5-e6c3-310b-a0ad-41c7e116f795",
                                "text": "„Seit 1997 wird die Inflation in der Eurozone erfasst – und noch nie lag sie so hoch wie im Januar dieses Jahres. Vor allem Energie lässt das Preisniveau steigen.“"
                            },
                            {
                                "example_id": "fb219aaa-2ab0-485b-88e6-e9daf46c35c7",
                                "sense_id": "f7d285f5-e6c3-310b-a0ad-41c7e116f795",
                                "text": "„Die Verantwortung der Zentralbank für die Stabilität des Preisniveaus sollte Regierungen nicht dazu einladen, mit schlechter Politik die Aufgabe der Geldpolitik zu erschweren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77dce712-928a-3ac5-abee-dc0336c7cc27",
                        "entry_id": "ebcee44d-c5cb-3b8a-a1ab-527dd79a8fb2",
                        "glosses": [
                            "durchschnittliche Ebene der zu zahlenden Preise"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bd02fa36-9426-40a6-9063-405938edeace",
                                "sense_id": "77dce712-928a-3ac5-abee-dc0336c7cc27",
                                "text": "„Der Maler selbst profitiert vom dramatisch anschwellenden Preisniveau seiner Bilder nicht direkt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
