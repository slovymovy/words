                "translations": [
                    {
                        "translation_id": "51399154-2ef1-4d0a-a215-9edf6066b319",
                        "source_entry_id": "f2d60c16-a0e9-3570-8536-1632e459b902",
                        "source_sense_description": "being or resembling virgin",
                        "target_lang_word": "virginal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virginal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52eab7e9-ff2d-3a71-b766-66e73c6f7ebf",
                                        "entry_id": "9067bd31-01b3-39d1-baab-61d867f3afd8",
                                        "glosses": [
                                            "Qui est propre aux vierges, qui annonce la virginité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5512f16b-efb8-41aa-89a6-704c1d46bda8",
                                                "sense_id": "52eab7e9-ff2d-3a71-b766-66e73c6f7ebf",
                                                "text": "C’est cela qu’évoque le journaliste américain Garry Will lorsqu’il pose la question : « Un peuple qui croit avec plus de ferveur en la conception virginale du Christ qu’en l’évolution des espèces peut-il être encore qualifié de nation éclairée ? »."
                                            },
                                            {
                                                "example_id": "c681dd81-85f6-487b-bde3-401a5d079d82",
                                                "sense_id": "52eab7e9-ff2d-3a71-b766-66e73c6f7ebf",
                                                "text": "La figure, de l’ovale si souvent trouvé par Raphaël pour ses madones, se distingue par la couleur sobre et virginale des pommettes […]"
                                            },
                                            {
                                                "example_id": "79665114-a432-409d-bac1-535e4aa9cbcb",
                                                "sense_id": "52eab7e9-ff2d-3a71-b766-66e73c6f7ebf",
                                                "text": "C’est l’heure charmante où l’alouette s’élève dans le ciel, salue de ses trilles et de ses roulades le matin jeune, virginal et triomphant."
                                            },
                                            {
                                                "example_id": "e615b6ad-4e5c-4f63-b015-e3ba1287378d",
                                                "sense_id": "52eab7e9-ff2d-3a71-b766-66e73c6f7ebf",
                                                "text": "La tenture semée de petites fleurs roses et bleues donnait à cette pièce un air que le mot « virginal » eût sans doute décrit mieux qu’un autre. On songeait, en effet, à une chambre de jeune fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef14d79-a74f-3a93-8716-d2c934082769",
                                        "entry_id": "9067bd31-01b3-39d1-baab-61d867f3afd8",
                                        "glosses": [
                                            "Qui concerne la Vierge Marie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37954b4-cbac-4741-a83e-5f6dad441b25",
                                                "sense_id": "4ef14d79-a74f-3a93-8716-d2c934082769",
                                                "text": "Lille est la prunelle des yeux virginaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "virginal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f55bace5-22b5-3191-8c7a-375b33a56f4f",
                                        "entry_id": "56913fa4-5c71-386f-b4f2-61c8e7be9c3e",
                                        "glosses": [
                                            "Instrument de musique dont les cordes sont pincées par des vergettes (ou sautereaux); en forme de coffre et doté d’un clavier rentrant ; le virginal est proche du clavecin et de l’épinette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a122c3f-0abf-4c3d-a959-878eaab22dd4",
                                                "sense_id": "f55bace5-22b5-3191-8c7a-375b33a56f4f",
                                                "text": "Si l’on en juge par le nombre important de tableaux de scènes d’intérieur flamand dans lesquelles on voit un virginal, on est tenté de penser que ce genre d’instrument devait être très répandu dans les familles bourgeoises de l’époque."
                                            },
                                            {
                                                "example_id": "8c7833ab-0b6e-4738-807f-3d653ba95225",
                                                "sense_id": "f55bace5-22b5-3191-8c7a-375b33a56f4f",
                                                "text": "Dans le salon de musique, la mère joue du virginal posé sur une large table recouverte d’un tapis d’Orient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cf65c52-7134-42d3-a87b-0ff9d40e286e",
                        "source_entry_id": "f2d60c16-a0e9-3570-8536-1632e459b902",
                        "source_sense_description": "being or resembling virgin",
                        "target_lang_word": "jungfräulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jungfräulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0112bde-aa1a-33b6-8617-dc86f96dc449",
                                        "entry_id": "5b1028b5-01aa-3a38-882f-016411b10726",
                                        "glosses": [
                                            "als Mädchen/Frau unberührt, also ohne bereits Geschlechtsverkehr/Beischlaf praktiziert zu haben"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ff52f29-9e4f-42bf-a27a-c407300d8c1b",
                                                "sense_id": "c0112bde-aa1a-33b6-8617-dc86f96dc449",
                                                "text": "Und du möchtest wirklich jungfräulich in die Ehe gehen?"
                                            },
                                            {
                                                "example_id": "d91d39bc-61db-4b5b-9f72-8ab73f3ef820",
                                                "sense_id": "c0112bde-aa1a-33b6-8617-dc86f96dc449",
                                                "text": "„Dem Ceremonienmeister steht eine bestimmte ältere Frau zur Seite, welche die herbeigebrachten Bräute untersucht, ob sie wirklich jungfräulich sind.“"
                                            },
                                            {
                                                "example_id": "ed84031e-fc38-4384-8b02-20494feec6a8",
                                                "sense_id": "c0112bde-aa1a-33b6-8617-dc86f96dc449",
                                                "text": "Maria ist die jungfräuliche Gottesmutter, und Elisabeth I. nannte man die jungfräuliche Königin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e178c89-a9d1-30b4-8601-25d9181d8642",
                                        "entry_id": "5b1028b5-01aa-3a38-882f-016411b10726",
                                        "glosses": [
                                            "als Landschaft/Gegenstand noch unberührt, also nicht entdeckt, benutzt, betreten oder Ähnliches"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dea2a98-6be0-4bac-b365-8b1d5a462bb1",
                                                "sense_id": "7e178c89-a9d1-30b4-8601-25d9181d8642",
                                                "text": "Wir sahen die Spur eines Rehs, das über die jungfräuliche Schneedecke gestakst war."
                                            },
                                            {
                                                "example_id": "7a21abc2-8d62-44ab-b876-00beb79846c6",
                                                "sense_id": "7e178c89-a9d1-30b4-8601-25d9181d8642",
                                                "text": "„Das einzige Mittel, um diese Wiederbelebung der Obstbaumzucht auf nicht jungfräulichem Boden wieder herzustellen, besteht in der Düngung der Obstbäume, welche auf nicht jungfräulichem Boden zu stehen kommen.“ (1872)"
                                            },
                                            {
                                                "example_id": "9982673a-5e01-4dd1-b256-656dc64ef770",
                                                "sense_id": "7e178c89-a9d1-30b4-8601-25d9181d8642",
                                                "text": "„Im Kolonialismus war es ein wiederkehrendes Muster, das kolonisierte Land als jungfräulich, als leer oder unmarkiert zu bezeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
