                ],
                "senses": [
                    {
                        "sense_id": "3751292e-bd39-3954-840a-e87449f7cb3b",
                        "entry_id": "35405854-f789-39fb-b661-aefe1a18a913",
                        "glosses": [
                            "qualifizierte Person mit umfassend hohem Wissensstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a1fc41c-19c8-48df-b9da-6ce2cc1a3162",
                                "sense_id": "3751292e-bd39-3954-840a-e87449f7cb3b",
                                "text": "„Burckhardt geht noch weiter: Clauß sei 1945 ›aus der Hölle, als ein Wissender und nicht wie die Emigranten, als in propagandistischen Scheinvorstellungen Verstrickter 'praeceptor Germaniae' zurückgekehrt‹.“"
                            },
                            {
                                "example_id": "2d7e7846-699e-47a8-b5e0-8c3f9a887675",
                                "sense_id": "3751292e-bd39-3954-840a-e87449f7cb3b",
                                "text": "„Dann, nach dreijähriger Odyssee, ein Wissender unter den Weißkitteln.“"
                            },
                            {
                                "example_id": "8135a816-aad1-4b55-b7d7-e98d8bb687bb",
                                "sense_id": "3751292e-bd39-3954-840a-e87449f7cb3b",
                                "text": "„Als ein solcher Wissender präsentiert sich der Psychiater Hans-Joachim Maaz, ehemals Chefarzt der Klinik für Psychotherapie und Psychosomatik des Diakonie-Krankenhauses in Halle.“"
                            },
                            {
                                "example_id": "9ff7a30d-50d8-40eb-8e44-55cfbd13d9b0",
                                "sense_id": "3751292e-bd39-3954-840a-e87449f7cb3b",
                                "text": "„Auch wenn man Thukydides, der am Beginn des Verfassungsvertrags zitiert wird, dann wohl so lesen müsste: Die Verfassung, die wir haben, heißt Technokratie, weil der Staat nicht auf die Mehrheit, sondern auf die Einsicht der Wissenden ausgerichtet ist.“"
                            },
                            {
                                "example_id": "dddba28e-03ea-4150-9e7c-71d23efbf353",
                                "sense_id": "3751292e-bd39-3954-840a-e87449f7cb3b",
                                "text": "„Ein Wissender bzw. Wissenschaftler [alim] ist im Islam ein Oberbegriff für alle Gelehrten [faqih] und alle Kenntnisreichen von nützlichen Wissenschaften, die über Wissen verfügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
