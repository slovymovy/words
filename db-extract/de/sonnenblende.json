                "senses": [
                    {
                        "sense_id": "f2c314e2-366f-3870-815b-e9cd5c8d12df",
                        "entry_id": "cf803e0f-c14e-3d2b-9079-8e2777521fc7",
                        "glosses": [
                            "Bauteil eines Autos, das als Blendschutz gegen zu starkes Sonnenlicht ausgerichtet werden kann"
                        ],
                        "tags": [
                            "Automobilzubehör"
                        ],
                        "examples": [
                            {
                                "example_id": "552796cf-a9e0-4ed0-8ed5-b963d4db5f34",
                                "sense_id": "f2c314e2-366f-3870-815b-e9cd5c8d12df",
                                "text": "„Er klappte die Sonnenblende nieder, auf ihrer Rückseite war ein Spiegel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7abda2ca-394a-3492-98c0-731d52d38978",
                        "entry_id": "cf803e0f-c14e-3d2b-9079-8e2777521fc7",
                        "glosses": [
                            "Vorsatzblende für einen Fotoapparat gegen das Sonnenlicht"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "e87a765e-4c7b-44e2-a219-a4ceeccbdc4b",
                                "sense_id": "7abda2ca-394a-3492-98c0-731d52d38978",
                                "text": "Wegen des Gegenlichts setzte er eine Sonnenblende auf das Objektiv."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7449d804-44e6-36a7-9119-b07d5e19b0f4",
                        "entry_id": "cf803e0f-c14e-3d2b-9079-8e2777521fc7",
                        "glosses": [
                            "Sonnenblende an Gebäuden oder Liegestühlen"
                        ],
                        "tags": [
                            "Sonnenschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "486def4c-57ba-4fee-9695-0b3f453b1a25",
                                "sense_id": "7449d804-44e6-36a7-9119-b07d5e19b0f4",
                                "text": "Die Sonnenblende in der Reichstagskuppel soll die Bundestagsabgeordneten vor direkter Sonneneinstrahlung schützen."
                            },
                            {
                                "example_id": "e902f4fd-31c4-43ec-95ec-824bbc497643",
                                "sense_id": "7449d804-44e6-36a7-9119-b07d5e19b0f4",
                                "text": "Die Sonnenblende am Liegestuhl schützt vor einem Sonnenbrand im Gesicht."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
