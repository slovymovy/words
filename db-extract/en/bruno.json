                    },
                    {
                        "translation_id": "7ce0d7b0-3db7-4e0a-b008-63e9c1c0a5df",
                        "source_entry_id": "2327650f-e886-34e0-9fc2-172004a2e461",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Bruno",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bruno",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f464611e-3347-31cd-a733-ebb628c81ee7",
                                        "entry_id": "a4b553bc-9278-3863-b3ef-f07cfb71bab1",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8dd7057-bd64-498c-a4bb-bc65cc4e3717",
                                                "sense_id": "f464611e-3347-31cd-a733-ebb628c81ee7",
                                                "text": "Par ailleurs, Bruno Joucla a dû faire le tri parmi une centaine d’heures d'archives."
                                            },
                                            {
                                                "example_id": "74b22ec4-ca6b-4222-9bb5-3fef1984eed7",
                                                "sense_id": "f464611e-3347-31cd-a733-ebb628c81ee7",
                                                "text": "Selon lui, la fin de l’exigence remonte à l’épilogue de l’ère Hubert Fournier, limogé en décembre 2015 : « Durant les trois ans et demi avec Bruno Genesio, il y avait des excuses à tout va pour surprotéger et dédouaner les joueurs »."
                                            },
                                            {
                                                "example_id": "4c806b48-f7c7-40d6-bb3c-0bce023b8876",
                                                "sense_id": "f464611e-3347-31cd-a733-ebb628c81ee7",
                                                "text": "L’opinion tranchée de Yannick Jaouen a aussi provoqué la colère de Bruno Berréhar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25a939e-792f-39f2-94ba-333098393a9b",
                                        "entry_id": "a4b553bc-9278-3863-b3ef-f07cfb71bab1",
                                        "glosses": [
                                            "Indicatif radio du capitaine Marcel Bigeard lors de la bataille de Diên Biên Phu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c14a6d0-dcd1-4ca8-8382-8a67deff1eb9",
                                                "sense_id": "f25a939e-792f-39f2-94ba-333098393a9b",
                                                "text": "« — Bruno [le surnom de Bigeard, ndlr], c’est Allaire au bigo. Je tente une percée ou j’annule ?\n— Allaire, c’est foutu. Cessez-le-feu à 17 h 30. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bruno",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11d0881f-63e9-3882-9815-8b2dfc0ae638",
                                        "entry_id": "96ec1eee-7076-3824-9946-35060128c2b1",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34e9b4e-52c2-4fe0-a887-758899f58476",
                                                "sense_id": "11d0881f-63e9-3882-9815-8b2dfc0ae638",
                                                "text": "On traverse une décennie où la notion de fin du monde est devenue plus réelle, témoigne Anthony Bruno."
                                            },
                                            {
                                                "example_id": "5bac1a70-5471-4f25-888c-2a8c748fe2d9",
                                                "sense_id": "11d0881f-63e9-3882-9815-8b2dfc0ae638",
                                                "text": "Belle histoire aussi que celle qu’a connue ND Stevenson, auteur qui s’est fait connaître sur Internet avant que ses récits se retrouvent adaptés à l’écran par Nick Bruno et Troy Quane, les réalisateurs des Incognitos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bruno",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e56a5e-50e6-33eb-b2c1-ae81464cd3e7",
