                    {
                        "translation_id": "f2deb32c-50ac-4222-be6e-cd9492d3e471",
                        "source_entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                        "source_sense_description": "state of being taciturn",
                        "target_lang_word": "taciturnité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taciturnité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                        "entry_id": "5707313a-4eca-321b-9585-73d05ddfb25a",
                                        "glosses": [
                                            "Humeur, tempérament ou état d’une personne taciturne."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8588d75f-29bc-462f-a1cc-9f435f9d85b1",
                                                "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                                "text": "Comment ne l’eût-on pas fui, quand déjà son extérieur, sa taciturnité, la vue de son fils, suffisaient et au delà à éteindre aussitôt dans tous les esprits jusqu’à la velléité de le connaître intimement ?"
                                            },
                                            {
                                                "example_id": "b2808b70-c0b0-4a38-9041-a0edb7c12825",
                                                "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                                "text": "Il semble que la colère ne produise pas la taciturnité. Car la taciturnité est opposée à la parole."
                                            },
                                            {
                                                "example_id": "1bc1cd15-7991-4e84-84ed-22d3ac4ac063",
                                                "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                                "text": "Dès lors, le péché de taciturnité va présenter une distinction, qui connaîtra ensuite une longue carrière : d’une part la « taciturnité excessive » (nimia tacitumitas), dont les dangers et les fautes peuvent concerner tous les hommes ; de l’autre le « silence sans discernement » […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25342bb6-a487-45cb-ad3d-efa246b7d8e6",
                        "source_entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                        "source_sense_description": "state of being taciturn",
                        "target_lang_word": "Schweigsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweigsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c99d81a4-2165-3559-ae9c-87e416628a29",
                                        "entry_id": "e9155893-310d-368a-972f-bd0cac06b3ae",
                                        "glosses": [
                                            "Verhalten, das darin besteht, dass jemand wenig oder gar nicht spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12c491b-c4e3-4e8c-9821-5b94f2807fce",
                                                "sense_id": "c99d81a4-2165-3559-ae9c-87e416628a29",
                                                "text": "„Bald nach dem Frühstück, das Ambly in ungewohnter Schweigsamkeit zu sich genommen hatten, bekamen wir nämlich Besuch.“"
                                            },
                                            {
                                                "example_id": "561bff2e-697d-4d70-9102-961b396d4f5a",
                                                "sense_id": "c99d81a4-2165-3559-ae9c-87e416628a29",
                                                "text": "„Übrigens war diese große Schweigsamkeit auch Frau Doris Jackopp eigentümlich, einer winzig kleinen, äußerst zierlichen, ja zerbrechlichen Person ebenfalls aus der Schweiz.“"
                                            },
                                            {
                                                "example_id": "305d7f73-2c02-42e6-a507-a36962f8eb7b",
                                                "sense_id": "c99d81a4-2165-3559-ae9c-87e416628a29",
                                                "text": "„Im Rostowschen Hause herrschte jene Atmosphäre poetisch verklärter Langeweile, Bedrücktheit und Schweigsamkeit, die ein Brautpaar immer zu umgeben pflegt.“"
                                            },
                                            {
                                                "example_id": "23719281-2fe0-4508-ab88-81888da5c484",
                                                "sense_id": "c99d81a4-2165-3559-ae9c-87e416628a29",
                                                "text": "„Seine rauhe Schweigsamkeit hätte den Schotten noch gefallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
