    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d15f80a-e27e-31d1-8c58-035898eac9a1",
                    "sense_definition": "informatie, een verhaal of een gebeurtenis mondeling of schriftelijk overbrengen aan iemand anders",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb het gisteren aan hem <w>verteld</w> tijdens de lunch.",
                            "target_lang_translations": {
                                "en": "I <w>told</w> him about it yesterday during lunch."
                            }
                        },
                        {
                            "text": "Kun je een <w>verhaal vertellen</w> over je vakantie in Frankrijk?",
                            "target_lang_translations": {
                                "en": "Can you <w>tell</w> a story about your holiday in France?"
                            }
                        }
                    ],
                    "synonyms": [
                        "verhalen"
                    ],
                    "common_phrases": [
                        "verhaal vertellen",
                        "mop vertellen",
                        "sprookje vertellen",
                        "de waarheid vertellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To convey information, a story, or an event to someone else, either orally or in writing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tell",
                                "target_lang_sense_clarification": "to narrate or convey information"
                            },
                            {
                                "target_lang_word": "narrate",
                                "target_lang_sense_clarification": "to relate a story or series of events"
                            },
                            {
                                "target_lang_word": "relate",
                                "target_lang_sense_clarification": "to tell in a descriptive way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60ecb057-dfea-3a57-beda-5ab76e5ea3df",
                    "sense_definition": "een fout maken bij het tellen van een aantal",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen kan <w>zich vertellen</w> als er veel lawaai in de kamer is.",
                            "target_lang_translations": {
                                "en": "Anyone can <w>miscount</w> if there is a lot of noise in the room."
                            }
                        },
                        {
                            "text": "Ik moet de munten opnieuw tellen omdat ik <w>me verteld</w> heb.",
                            "target_lang_translations": {
                                "en": "I have to count the coins again because I <w>miscounted</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich vertellen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wederkerig werkwoord (zich vertellen)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a mistake while counting a number of items."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miscount",
                                "target_lang_sense_clarification": "to count incorrectly"
                            },
                            {
                                "target_lang_word": "lose count",
                                "target_lang_sense_clarification": "to forget where one is in a sequence"
                            }
                        ]
                    }
                }
            ]
        }
    ]
