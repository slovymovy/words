                            {
                                "example_id": "8159f8d8-cdcc-4094-a81a-17e397f203c3",
                                "sense_id": "e0784ffa-ad8e-3cea-a74e-c151018a524c",
                                "text": "The gerontic population of the U.S., those of 65 and over, numbered 3.1 million in 1900."
                            },
                            {
                                "example_id": "f79548b7-941b-450f-9e0d-d2ed8f25cbcf",
                                "sense_id": "e0784ffa-ad8e-3cea-a74e-c151018a524c",
                                "text": "Academic staff from schools of nursing across Australia were asked to contribute information about their current funded research in gerontic nursing, and also to provide their thoughts on what issues future research projects within gerontic nursing should address."
                            },
                            {
                                "example_id": "128950db-6dfa-4f99-803c-554422c652df",
                                "sense_id": "e0784ffa-ad8e-3cea-a74e-c151018a524c",
                                "text": "previously there had been gerontic oligarchy"
                            }
