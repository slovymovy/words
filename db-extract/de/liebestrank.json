                "senses": [
                    {
                        "sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                        "entry_id": "4d13cf29-5270-3a7f-9835-806d057c6b2e",
                        "glosses": [
                            "Trank, der Liebe erregt, nach dessen Trinken man sich in jemanden verliebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c1f7b7-e591-405f-958a-28c7fb6f205b",
                                "sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                                "text": "„›Aber wenn Marshall dich einbuchtet, weil du Voodoo-Puppen bastelst oder einen Liebestrank braust oder was auch immer, dann rechne nicht damit, dass ich dir helfe.‹“"
                            },
                            {
                                "example_id": "fb12a5db-09ab-42dc-8ad6-5985f1ff856a",
                                "sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                                "text": "„Wir hoffen von ganzem Herzen, dass du diesen einen letzten Auftrag annimmst. Wenn ja, füge bitte das Wort ›Liebestränke‹ in die Überschrift der Anzeige ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1505243-e176-40fe-9d6b-85c03fc6cb87",
                        "source_entry_id": "4d13cf29-5270-3a7f-9835-806d057c6b2e",
                        "source_sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                        "source_sense_description": "Trank, der Liebe erregt",
                        "target_lang_word": "love potion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "love potion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "356e7f35-33b9-3f09-b895-8d7af80bd81f",
                                        "entry_id": "1f7eb545-107e-3268-af8b-04bf099404ee",
                                        "glosses": [
                                            "A drink supposed to have the magic power to make the drinker fall in love with a specified person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c2014d-4b73-46e8-b5fd-6ab72676cdd0",
                                                "sense_id": "356e7f35-33b9-3f09-b895-8d7af80bd81f",
                                                "text": "One love potion was composed of the powdered navel string of a new-born baby boy."
                                            },
                                            {
                                                "example_id": "06abb797-e067-4e76-aaf9-709acd708664",
                                                "sense_id": "356e7f35-33b9-3f09-b895-8d7af80bd81f",
                                                "text": "I took my troubles down to Madame Ruth\n You know that gypsy with the gold-capped tooth\n She's got a pad down on Thirty-Fourth and Vine\n Sellin' little bottles of Love Potion Number Nine."
                                            },
                                            {
                                                "example_id": "c77d1c8b-5731-46f9-8ab7-d685fd60b80c",
                                                "sense_id": "356e7f35-33b9-3f09-b895-8d7af80bd81f",
                                                "text": "Cuttle-fish, spiced oysters, sea hedge-hogs, and lobsters were among the ingredients of love-potions that reputed thaumaturgist Apuleius [...] was accused of have prepared in order to win the love of a widow."
                                            }
                                        ]
                                    }
                                ]
                            }
