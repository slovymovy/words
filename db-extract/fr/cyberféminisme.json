                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyberfeminism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07445cde-fb96-337f-b772-6838ab008f31",
                                        "entry_id": "476724c0-073a-3d66-b34f-027b8c560094",
                                        "glosses": [
                                            "A community, philosophy and set of practices concerned with feminist acts in cyberspace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c17a48-f8ab-4036-a6cb-a7f4d1b43e2a",
                                                "sense_id": "07445cde-fb96-337f-b772-6838ab008f31",
                                                "text": "Because of its similarity to what is often referred to as \"liberal feminism\" in the non-virtual world, I identify this perspective as liberal cyberfeminism."
                                            },
                                            {
                                                "example_id": "cbadc979-7842-4345-9ff9-a1bf7fdb94c6",
                                                "sense_id": "07445cde-fb96-337f-b772-6838ab008f31",
                                                "text": "At the opening to On the Matrix: Cyberfeminist Simulations, Plant says that cyber-feminism—and/or the complex systems and virtual worlds upon which it is based—has the capacity to undermine the ‘world view and material reality of two thousand years of patriarchal control’."
                                            },
                                            {
                                                "example_id": "0224da45-1cd7-4454-a126-0c72c10297c8",
                                                "sense_id": "07445cde-fb96-337f-b772-6838ab008f31",
                                                "text": "Cyberfeminism is an attempt by feminists to own a part of the computer revolution, where the field of computer science has established a resistant, male center of power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
