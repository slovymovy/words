                        "glosses": [
                            "Gebäck zu Weihnachten, zum Teil in Form weihnachtlicher Motive (zum Beispiel Herzen, Sterne, Tannenbäume, Glocken oder Engel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
