            {
                "entry_id": "480a559b-2b4b-37bf-92c3-666b1c2c99cd",
                "word": "yager",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4641286d-1a8a-459a-814b-2222322c85c2",
                        "entry_id": "480a559b-2b4b-37bf-92c3-666b1c2c99cd",
                        "tags": [
                            "plural"
                        ],
                        "form": "yagers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ff74f63-5502-33ee-b302-6181cc2d6cfe",
                        "entry_id": "480a559b-2b4b-37bf-92c3-666b1c2c99cd",
                        "glosses": [
                            "A heavy, muzzle-loading hunting rifle"
                        ],
                        "tags": [
                            "US",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d8f8b80c-8c4f-4ee9-893e-de330bc9a631",
                                "sense_id": "2ff74f63-5502-33ee-b302-6181cc2d6cfe",
                                "text": "There are fourscore of them; and but that each carries a yager rifle in his hand, a knife in his belt, and a Colt's pistol on his thigh, you could not discover the slightest point of resemblance between any two of them."
                            },
                            {
                                "example_id": "f7f1a135-eedb-4abc-8e36-1d65693968d6",
                                "sense_id": "2ff74f63-5502-33ee-b302-6181cc2d6cfe",
                                "text": "Many present identify it as the yager usually carried by Clancy."
                            },
                            {
                                "example_id": "a732562a-05cd-49ff-bba7-749a49a42052",
                                "sense_id": "2ff74f63-5502-33ee-b302-6181cc2d6cfe",
                                "text": "We were each armed with a Mississippi yager and two Colt's revolvers."
                            }
                        ]
                    },
                    {
                        "sense_id": "a22c70d9-e597-32d9-9a9a-264dbfd0d5cc",
                        "entry_id": "480a559b-2b4b-37bf-92c3-666b1c2c99cd",
                        "glosses": [
                            "A Jäger, an elite soldier of the Austrian army"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f955de00-2468-495e-8ecd-1e80225cd879",
                                "sense_id": "a22c70d9-e597-32d9-9a9a-264dbfd0d5cc",
                                "text": "Most of the officers were dressed in […] a bluish-grey frock-coat of a colour similar to Austrian yagers."
                            },
                            {
                                "example_id": "c23911a5-ae19-4be9-8c74-cb43a5185fc8",
                                "sense_id": "a22c70d9-e597-32d9-9a9a-264dbfd0d5cc",
                                "text": "A battalion of yagers, the pride of the Austrian army, charged up the fatal hill and succeeded in taking it, after which the rattle of musketry beyond announced that the fight was being continued on the farther side."
                            },
                            {
                                "example_id": "74d766bb-0283-48a1-9ced-cddc0f81f23b",
                                "sense_id": "a22c70d9-e597-32d9-9a9a-264dbfd0d5cc",
                                "text": "Three days after this affair, Colonel Richard Butler, with a detachment of infantry, assisted by Major Lee with a part of his cavalry, fell in with a small party of chasseurs and yagers under Captain Donop, which he instantly charged, and, without the loss of a man, killed ten on the spot, and took the officer commanding the chasseur, and eighteen of the yagers, prisoners."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
