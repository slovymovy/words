                "senses": [
                    {
                        "sense_id": "f7972d64-1962-3f7f-b8f9-b04fcd2180ef",
                        "entry_id": "707cf1f5-7d62-35d1-a568-96a6fb1acf4f",
                        "glosses": [
                            "заранее, заблаговременно приготовить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39f8ddd9-cece-4d7a-8c83-5b5ef8ce917d",
                                "sense_id": "f7972d64-1962-3f7f-b8f9-b04fcd2180ef",
                                "text": "Он заготовил в уездном городе на имя одного из своих достойных друзей законную доверенность .."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ca5746d-1e55-31bb-8272-be5d3d6fd680",
                        "entry_id": "707cf1f5-7d62-35d1-a568-96a6fb1acf4f",
                        "glosses": [
                            "создать запас чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e76693-323f-4443-93f0-363ec91c4e28",
                                "sense_id": "0ca5746d-1e55-31bb-8272-be5d3d6fd680",
                                "text": "Поначалу не любовь к лесу толкнула его на это дело, всё было проще: можно было запастись деловой древесинкой, заготовить на зиму сенца по лесным полянкам."
                            }
                        ]
                    }
