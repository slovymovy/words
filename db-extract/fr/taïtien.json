                    {
                        "sense_id": "6871c2ce-d128-36b5-8ada-e2aff817958f",
                        "entry_id": "a11e5f00-6b7d-3410-8a92-b0613ba9cf04",
                        "glosses": [
                            "Orthographe ancienne de tahitien : relatif à Tahiti, à ses habitants ou à sa langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ba9a61-b2b5-4e8e-947e-33f10bd86060",
                                "sense_id": "6871c2ce-d128-36b5-8ada-e2aff817958f",
                                "text": "Deux seulement firent quelque bruit par suite de catastrophes analogues, la Queen-Charlotte, commandée par le missionnaire Shelly ; le second, le Dolphin, capitaine Folger ; l’un et l’autre occupés, avec un équipage taïtien, à la pêche des perles sur les îles Pomotou, et enlevés l’un et l’autre à l’improviste par ces auxiliaires dangereux."
                            },
                            {
                                "example_id": "56e6cdbb-b909-4a80-9f55-0f1edfa618db",
                                "sense_id": "6871c2ce-d128-36b5-8ada-e2aff817958f",
                                "text": "Il n’avait alors que vingt ans, et sa jeunesse, sa vivacité, sa gaieté, et la connaissance qu’il avait de la langue taïtienne paraissent l’avoir rendu cher aux habitants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "524a7c44-04a8-4a81-b445-99165155167d",
                        "source_entry_id": "a11e5f00-6b7d-3410-8a92-b0613ba9cf04",
