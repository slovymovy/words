                "senses": [
                    {
                        "sense_id": "431b5957-f70b-372f-9aee-7d0753fbef55",
                        "entry_id": "071991e4-eacc-3736-9574-468edeecde72",
                        "glosses": [
                            "Pronunciation spelling of bother."
                        ],
                        "tags": [
                            "alt-of",
                            "pronunciation-spelling"
                        ],
                        "examples": [
                            {
                                "example_id": "90ac41e7-6521-4d2d-b922-7eba07e41de2",
                                "sense_id": "431b5957-f70b-372f-9aee-7d0753fbef55",
                                "text": "\"You specials,\" Nigel said disgustedly. \"I don't know why I bovver, really I don't.\""
                            },
                            {
                                "example_id": "b7c8323a-980e-4a53-8a94-87d7ddbd8730",
                                "sense_id": "431b5957-f70b-372f-9aee-7d0753fbef55",
                                "text": "\"I don't bovver,\" he said, with a cross look in the direction of his brother and sister Rochesters."
                            },
                            {
                                "example_id": "fe55a503-88ac-4f32-a74a-8b360537dfe6",
                                "sense_id": "431b5957-f70b-372f-9aee-7d0753fbef55",
                                "text": "[…] in Brighton & Hove, where the council were not above attempting a sort of half-hearted, class-based ethnic-cleansing-without-violence, wherein families who have been in Brighton for generations—who could probably even trace their lineage right back to Brighthelmstone if they could be bovvered […]"
                            },
                            {
                                "example_id": "8a37e55e-5b8f-4181-adb1-e211b407faf0",
                                "sense_id": "431b5957-f70b-372f-9aee-7d0753fbef55",
                                "text": "“Playgrounds and canteens are denied catchphrases,” he writes in the Radio Times, fretting that “the art will be lost.” Which begs the question: am I bovvered?"
                            }
                        ]
                    }
