                        "source_sense_description": "Abkürzung für „Domain Name Server“",
                        "target_lang_word": "DNS",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DNS",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "841e9e0c-43dd-3c6b-b5c0-61bcf644eafe",
                                        "entry_id": "1fd3763b-b9f3-3168-bb21-20b32637169d",
                                        "glosses": [
                                            "Desoxyribonukleinsäure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175ed063-1159-4756-9858-c14f6992750b",
                                                "sense_id": "841e9e0c-43dd-3c6b-b5c0-61bcf644eafe",
                                                "text": "Die DNS ist ein Makromolekül, das in Lebewesen als Träger der Erbinformation dient."
                                            },
                                            {
                                                "example_id": "ebc6078e-66b9-4a27-beba-b3ba0fdf0f30",
                                                "sense_id": "841e9e0c-43dd-3c6b-b5c0-61bcf644eafe",
                                                "text": "„So liefert der Abgleich archaischer DNS mit dem Erbgut heutiger Menschen Aufschluss über deren Abstammungs- und Verwandtschaftsverhältnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86380661-698b-3f5b-8aaa-b66d6e3f296a",
                                        "entry_id": "1fd3763b-b9f3-3168-bb21-20b32637169d",
                                        "glosses": [
                                            "Direkte Numerische Simulation"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d48a9b2-06d7-4498-b6db-3628c82ff637",
                                                "sense_id": "86380661-698b-3f5b-8aaa-b66d6e3f296a",
                                                "text": "Mithilfe der DNS lassen sich instationäre Strömungsvorgänge berechnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fb3610f5-4756-3d5d-8340-2924dc57c2e7",
                                        "entry_id": "1fd3763b-b9f3-3168-bb21-20b32637169d",
                                        "glosses": [
                                            "Domain Name System"
                                        ],
                                        "tags": [
                                            "Informatik/Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f9fdf9-03c7-4639-b482-0389ad35e462",
                                                "sense_id": "fb3610f5-4756-3d5d-8340-2924dc57c2e7",
                                                "text": "Ohne das DNS würde das Internet nicht funktionieren. Es schafft die Verbindung zwischen Domain-Namen (die sich im allgemeinen leicht einprägen) und IP-Adressen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
