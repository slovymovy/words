                "senses": [
                    {
                        "sense_id": "71a50cab-e91c-3176-b120-d21fe4bcf7b5",
                        "entry_id": "1fe7c530-072a-3632-906d-9e8a928419bc",
                        "glosses": [
                            "Maulwurf- und Mäusefänger, der auf Feldern und Weiden Fallen anbrachte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "170dd8e5-619b-447f-b856-016b527e7bba",
                                "sense_id": "71a50cab-e91c-3176-b120-d21fe4bcf7b5",
                                "text": "Als Organe der Gemeinde waren zu wählen: der Gemeinderat, der Gemeindepräsident, der Gemeindeschreiber und -kassier, ferner die Hilfsorgane wie Ortspolizist, Feld-, Wald- und Rebhüter, Schermauser u.a.m."
                            },
                            {
                                "example_id": "38e18d69-c5b6-4d7d-9d27-ba678677750a",
                                "sense_id": "71a50cab-e91c-3176-b120-d21fe4bcf7b5",
                                "text": "Darum hatte jede Gegend ihren Feld- oder Schermauser. Die «Schere» mit dem Ring wurde ins Mausloch geschoben, und beim Berühren des Rings durch die Maus schnappte die Schere zu und tötete sie."
                            },
                            {
                                "example_id": "79d2e7e8-87c0-4a18-a221-50d1db62dabc",
                                "sense_id": "71a50cab-e91c-3176-b120-d21fe4bcf7b5",
                                "text": "Der Schermauser hat auf diesem Feld viel zu tun."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
