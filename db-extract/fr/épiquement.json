                                                "example_id": "c8f1bac5-c410-4662-9665-a0d088842053",
                                                "sense_id": "46ba393b-2206-3468-b513-08269ce9639f",
                                                "text": "Due to some epically drunk behavior at his sister's Prada fashion thing the weekend before last, he'd somehow cheated on his supremely hot, now ex-girlfriend, […]"
                                            },
                                            {
                                                "example_id": "c17643f7-d6d6-4038-ab03-59509992d004",
                                                "sense_id": "46ba393b-2206-3468-b513-08269ce9639f",
                                                "text": "They stopped discussing them because it usually meant epically dull speeches from Steve on market fluctuations and innovations in Internet trading."
                                            },
                                            {
                                                "example_id": "2ab6fd44-bd15-434e-912c-3cee1ac19ab6",
                                                "sense_id": "46ba393b-2206-3468-b513-08269ce9639f",
                                                "text": "[…] I've been so stupid, so epically stupid and selfish and cruel and …\""
                                            }
