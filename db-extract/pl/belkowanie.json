                        "entry_id": "10c70648-f85f-3e76-9246-2c50a63dd432",
                        "glosses": [
                            "najwyższy, poziomy, trójdzielny człon starożytnych budowli spoczywający na kolumnach lub ścianach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e4bd63-9056-4206-b4fc-bb00a875bd27",
                                "sense_id": "ea29014b-0c2c-3cfe-a810-f5b08a054a2b",
                                "text": "W skład klasycznego belkowania wchodzi architraw, fryz i gzyms."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "54777e3f-ae78-3eb5-94f7-5b64d3e1d1e4",
                        "entry_id": "10c70648-f85f-3e76-9246-2c50a63dd432",
                        "glosses": [
                            "zespół belek tworzących konstrukcję budowli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c88790-1901-448e-85e7-750e1e782ce1",
                                "sense_id": "54777e3f-ae78-3eb5-94f7-5b64d3e1d1e4",
                                "text": "Odłożył derkę, raz jeszcze przeciągnął dłonią po belkowaniu dachu"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
