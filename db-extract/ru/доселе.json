        "ru-extract.jsonl": [
            {
                "entry_id": "eab1a87d-ed69-3fa1-ba90-febcc2cdb3db",
                "word": "доселе",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eae8b28a-9fd0-32bf-b433-d640b2ae1611",
                        "entry_id": "eab1a87d-ed69-3fa1-ba90-febcc2cdb3db",
                        "glosses": [
                            "устар., прост. до настоящего времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b653733-77e5-4672-a2c4-70eb7fad53bd",
                                "sense_id": "eae8b28a-9fd0-32bf-b433-d640b2ae1611",
                                "text": "Плоды, цветы и различные фигуры, изображённые на стенах между окнами, превосходили всё, что я доселе видел по части ваятельного искусства."
                            },
                            {
                                "example_id": "9a3e8d16-84b9-4cf4-aa91-5f809f50e494",
                                "sense_id": "eae8b28a-9fd0-32bf-b433-d640b2ae1611",
                                "text": "Года три назад, получив свою учёную степень и став по возможности свободным, он пошёл к одному старичку, которого доселе знал понаслышке, и долго ждал, покамест ливрейный камердинер согласился доложить о нём в другой раз."
                            },
                            {
                                "example_id": "62634499-3bf9-4851-b7d1-481d81eb6347",
                                "sense_id": "eae8b28a-9fd0-32bf-b433-d640b2ae1611",
                                "text": "Первый прерывает молчание Никандр Сапожников, который доселе не проронил ещё ни одного слова."
                            },
                            {
                                "example_id": "08995cc7-0ead-43d3-be79-fc7ee230952d",
                                "sense_id": "eae8b28a-9fd0-32bf-b433-d640b2ae1611",
                                "text": "Я начал ощущать себя так, будто принял дитя в себя, во мне пробуждалось неведомое доселе томление и умильность ― так вот оно как!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7878e403-456a-3780-b217-e1ce66e7f518",
                        "entry_id": "eab1a87d-ed69-3fa1-ba90-febcc2cdb3db",
                        "glosses": [
                            "устар. до данного места"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c3710e0-c705-4c17-860f-ab8294241367",
                        "source_entry_id": "eab1a87d-ed69-3fa1-ba90-febcc2cdb3db",
                        "source_sense_description": "до настоящего времени",
                        "target_lang_word": "bisher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bisher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95c41bc2-0962-394e-a0d5-6c902c19bc3e",
                                        "entry_id": "4df6d1c0-921c-3f13-8ca0-80efed0665dc",
                                        "glosses": [
                                            "seit einem vergangenen Zeitpunkt bis zur Gegenwart"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff232e1-5b37-455d-bdf2-1ff70870c35b",
                                                "sense_id": "95c41bc2-0962-394e-a0d5-6c902c19bc3e",
                                                "text": "Bisher ist nichts passiert."
                                            },
                                            {
                                                "example_id": "7d23ba6e-a573-41af-ac1d-87932b6f37e0",
                                                "sense_id": "95c41bc2-0962-394e-a0d5-6c902c19bc3e",
                                                "text": "„Äußerlich anpassungsfähig und im Innern zählebig, haben die Stierspiele bisher alle Anfeindungen überlebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
