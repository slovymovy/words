                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déclinaison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff3ac641-4264-387c-a183-d1f9a07cc093",
                                        "entry_id": "1e94679e-8401-3fad-895f-2727b13394ed",
                                        "glosses": [
                                            "Arc de la sphère céleste qui mesure la distance angulaire dont un astre est éloigné de l’équateur, soit au nord, soit au sud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72215dfa-8f1c-4eba-ae12-bbf296080c32",
                                                "sense_id": "ff3ac641-4264-387c-a183-d1f9a07cc093",
                                                "text": "Thevet, lui, maniait fébrilement le bâton de Jacob afin de mesurer la déclinaison du soleil."
                                            },
                                            {
                                                "example_id": "f31ece31-2c45-4870-a016-4473c76170d9",
                                                "sense_id": "ff3ac641-4264-387c-a183-d1f9a07cc093",
                                                "text": "La déclinaison d’un astre se mesure sur son cercle horaire."
                                            },
                                            {
                                                "example_id": "2aa0e4d6-f887-4e38-8b12-6db5ce9f1e26",
                                                "sense_id": "ff3ac641-4264-387c-a183-d1f9a07cc093",
                                                "text": "Déclinaison boréale, australe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ffcf77-b474-32dc-b05e-f8920cbc9f81",
                                        "entry_id": "1e94679e-8401-3fad-895f-2727b13394ed",
                                        "glosses": [
                                            "Angle qui mesure l’écart du vrai nord avec une aiguille, soit vers l’est, soit vers l’ouest."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c71f3534-674a-421a-92c6-d10e6a84e80c",
                                                "sense_id": "06ffcf77-b474-32dc-b05e-f8920cbc9f81",
                                                "text": "La déclinaison de l’aiguille aimantée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c519163-52d0-38ef-9a4e-010864a18d79",
                                        "entry_id": "1e94679e-8401-3fad-895f-2727b13394ed",
                                        "glosses": [
                                            "Action de donner à chaque cas d’un nom, d’un pronom, d’un adjectif la forme qui lui est propre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f051838-a274-4532-a3b4-e8e05dc1f4af",
                                                "sense_id": "9c519163-52d0-38ef-9a4e-010864a18d79",
                                                "text": "1. beaucoup de grammairiens ont agité la question de savoir si, dans la déclinaison des mots, il faut suivre la dissimilitude ou la similitude, c’est-à-dire, en d’autres termes, l’anomalie ou l’analogie."
                                            },
                                            {
                                                "example_id": "2b4a39eb-5701-4335-ae67-4c68b474d85b",
                                                "sense_id": "9c519163-52d0-38ef-9a4e-010864a18d79",
                                                "text": "La caractéristique du langage schtroumpf est que les noms propres et les noms communs, les verbes et les adverbes y sont remplacés, et chaque fois que possible, par des conjugaisons et déclinaisons du mot schtroumpf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae216b3-1aa4-3436-9ec1-5ec573cd6d9f",
                                        "entry_id": "1e94679e-8401-3fad-895f-2727b13394ed",
                                        "glosses": [
                                            "Ensemble de ces formes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42527f17-5f7b-4df8-bbea-fe7e8cede74f",
                                                "sense_id": "2ae216b3-1aa4-3436-9ec1-5ec573cd6d9f",
                                                "text": "Il y a plusieurs déclinaisons dans cette langue."
                                            },
                                            {
                                                "example_id": "9f92bacc-0fea-4408-a643-1fb892606ec1",
                                                "sense_id": "2ae216b3-1aa4-3436-9ec1-5ec573cd6d9f",
                                                "text": "Dans cette étonnante maison j’entends affirmer que sans la clé magique du latin il est inutile d’espérer ouvrir les portes du monde et qu’on demeure à jamais aveugle, sourd, invalide (le médecin, du reste, entreprend, dans cette année d’avant la sixième, d’enseigner les déclinaisons à mon amie et à moi et de nous initier à l’épitomé)."
                                            }
                                        ]
                                    },
