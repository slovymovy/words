                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "ситуация"
                            },
                            {
                                "target_lang_word": "ситуация",
                                "target_lang_sense_clarification": "обстоятельства"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sprawa",
