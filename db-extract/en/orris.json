                    },
                    {
                        "sense_id": "93162b49-c2cd-35c3-b746-ea21bf4c311e",
                        "entry_id": "4e23124f-609d-3115-bda8-d53608a12d58",
                        "glosses": [
                            "The fragrant root of such an iris."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56d12a9d-b83c-437d-b79d-b250edac0395",
                                "sense_id": "93162b49-c2cd-35c3-b746-ea21bf4c311e",
                                "text": "Drop twelve drops of genuine oil of rhodium on a lump of loaf-sugar ; grind this wel in a glass mortar, and mix it thoroughly with three pounds of orris powder."
                            },
                            {
                                "example_id": "8c8d9494-ccf5-4dda-ac58-a9b95dbf9104",
                                "sense_id": "93162b49-c2cd-35c3-b746-ea21bf4c311e",
                                "text": "1998, Claire Kowalchik, William H. Hylton, Orris, entry in Rodale′s Illustrated Encyclopedia of Herbs, page 406,\nOrris is the part of the florentine iris you don′t see — the rhizome. […] The ancient Egyptians and Greeks learned that the bland-smelling orris root would take on a remarkable fragrance if dried for at least two years."
                            },
                            {
                                "example_id": "d79c58f3-36fb-4343-80b9-571ab766ce8c",
                                "sense_id": "93162b49-c2cd-35c3-b746-ea21bf4c311e",
                                "text": "Next place your hair, the rose quartz, some of the orris root powder, and the candle drippings into the box."
                            }
                        ]
                    }
