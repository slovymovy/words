                                "target_senses": [
                                    {
                                        "sense_id": "d0965458-0e27-3c90-bc70-a33bae62c9c8",
                                        "entry_id": "90c4b6f9-147f-3629-b2da-6cdbab2c7744",
                                        "glosses": [
                                            "Laubbaum mit gelappten Blättern (Gattung Acer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99743852-8cf6-4266-9cd1-49b6f02d0ea4",
                                                "sense_id": "d0965458-0e27-3c90-bc70-a33bae62c9c8",
                                                "text": "Zwischen den Eichen stehen einzelne Ahorne."
                                            },
                                            {
                                                "example_id": "9c20a618-6151-4c1b-8188-45d2f3262505",
                                                "sense_id": "d0965458-0e27-3c90-bc70-a33bae62c9c8",
                                                "text": "„Alleen aus Ulmen, Pappeln, Eichen, Ahorn, Eschen oder Linden verbanden die Gutsdörfer und Kleinstädte, deren solide erbaute Häuser mit farbenprächtig angelegten Vorgärten strunzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24a8eccb-fc0f-3208-9135-35bdd197be54",
                                        "entry_id": "90c4b6f9-147f-3629-b2da-6cdbab2c7744",
                                        "glosses": [
                                            "Holz von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f4512d-9258-40a6-958d-b794e4a821dd",
                                                "sense_id": "24a8eccb-fc0f-3208-9135-35bdd197be54",
                                                "text": "Der Tisch ist aus Ahorn."
                                            },
                                            {
                                                "example_id": "f60bbac7-936c-4391-93b6-49c6e52e7b0d",
                                                "sense_id": "24a8eccb-fc0f-3208-9135-35bdd197be54",
                                                "text": "„Während er in dieses Faktum einsackte, nahm er fasziniert die Eleganz seiner Möbel wahr: das Telefontischchen aus Ahorn mit den spitz zulaufenden Beinen, den Spiegelrahmen mit dem Akanthusmuster und der abblätternden Vergoldung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdfc6071-0944-4e27-b9c7-5ebcbaac9bec",
                        "source_entry_id": "df552f54-b2a3-39ca-ab69-46033331273a",
                        "source_sense_id": "c38f046d-a223-3ccc-bc03-34e93cf3c0bc",
                        "source_sense_description": "boom of heester uit het geslacht (Acer )",
                        "target_lang_word": "maple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20c93fdb-6808-369a-a651-f1965e0f56c5",
                                        "entry_id": "adc1786e-9c39-3262-8663-7d0f4a7797d4",
                                        "glosses": [
                                            "A tree of the genus Acer, characterised by its usually palmate leaves and winged seeds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f3e44d-0855-44f9-848e-02e46f5d050c",
                                                "sense_id": "20c93fdb-6808-369a-a651-f1965e0f56c5",
                                                "text": "They have a large maple in their yard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f2788dc-2320-3272-bfa9-839f2959baeb",
                                        "entry_id": "adc1786e-9c39-3262-8663-7d0f4a7797d4",
                                        "glosses": [
                                            "The wood of such a tree, prized for its hardness and attractive appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677c2dd5-c11d-4313-9c47-2c2bd5080247",
                                                "sense_id": "1f2788dc-2320-3272-bfa9-839f2959baeb",
                                                "text": "This table is made of maple and also has some fruitwood inlays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "718943e9-a468-3e2c-abef-9260571d515c",
                                        "entry_id": "adc1786e-9c39-3262-8663-7d0f4a7797d4",
                                        "glosses": [
                                            "The flavor of such a tree's sap, or an imitation of that flavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e78b1da-dc6b-4472-9eca-3ef35fe914b0",
                                                "sense_id": "718943e9-a468-3e2c-abef-9260571d515c",
                                                "text": "A: Mmm, this one is strawberry! What flavor is yours? B: This one is maple! I wonder if any of them will turn out to be pineapple!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd9fba64-c831-4bfe-b7a8-3677bf2694ae",
                        "source_entry_id": "df552f54-b2a3-39ca-ab69-46033331273a",
                        "source_sense_id": "c38f046d-a223-3ccc-bc03-34e93cf3c0bc",
                        "source_sense_description": "boom of heester uit het geslacht (Acer )",
                        "target_lang_word": "érable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "érable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                        "entry_id": "3f92c231-55bd-37a0-b992-880d3a571148",
                                        "glosses": [
                                            "Genre d’arbre qui croît naturellement dans les régions tempérées à feuilles opposées, pétiolées et palmatilobées, généralement simples, dont le fruit est une disamare formée de 2 samares réunies à la base, et dont plusieurs espèces fournissent une liqueur qui peut être convertie en sucre par évaporation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1dc9765-aa78-4155-9078-da5713cece82",
                                                "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                                "text": "Les papillons de nuit (hétérocères) suivants (classés par famille) se nourrissent d’érables :"
                                            },
                                            {
                                                "example_id": "d91d17d4-79f1-45f2-b268-ff91089de267",
                                                "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                                "text": "Je dirai l’emprise de tes mains longues qui font à ma taille une ceinture frémissante ; je dirai ton regard volontaire qui anéantit ma pensée, ta poitrine battante soudée à ma poitrine, et tes jambes aussi fermes que le tronc de l’érable, où les miennes s’enroulent comme les jets onduleux des houblons."
                                            },
                                            {
                                                "example_id": "3b5bea6d-d079-4892-816f-7cef2328f3ff",
                                                "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                                "text": "J’écris ces lignes dans la cabine du Firecrest. Le teck et le bois d’érable brillent."
                                            },
                                            {
                                                "example_id": "08b0d16e-6f0e-44dc-ac99-cde69e8507b5",
                                                "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                                "text": "La grille de bois s’ouvre sur une allée bordée d’érables."
                                            },
                                            {
                                                "example_id": "9386f9f2-72c0-4155-96e3-f73b4f2776d6",
                                                "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                                "text": "Ifs, érables, hêtres et lierre contribuent aujourd’hui encore à préserver la fraîcheur de ce lieu ombragé, propice au repos et à la contemplation, l’extrémité du belvédère offrant une vue spectaculaire sur le lac et, à l’horizon, sur le Parlement européen."
                                            },
                                            {
                                                "example_id": "3b03c57b-1556-426c-beb0-4130ab0a36b6",
                                                "sense_id": "1becd6b4-bbf5-3288-bcd5-92323ae72c10",
                                                "text": "En cas d’attaques pathogènes, comme la maladie de la suie sur l’érable, si on a d’autres essences, elles vont supporter le choc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8fe20d8-e4b9-39af-9f1b-0bf51de6ad19",
                                        "entry_id": "3f92c231-55bd-37a0-b992-880d3a571148",
                                        "glosses": [
                                            "Bois tiré de cet arbre."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7669ac49-2882-4c24-846e-32611f4d3181",
                                                "sense_id": "e8fe20d8-e4b9-39af-9f1b-0bf51de6ad19",
                                                "text": "L’érable sert à la fabrication d’avirons et de mécanismes pour les moulins à eau ou à vent. On l’utilise aussi pour faire du charbon de bois."
                                            },
                                            {
                                                "example_id": "ee666e1c-2224-4937-85ae-5487443f6e4b",
                                                "sense_id": "e8fe20d8-e4b9-39af-9f1b-0bf51de6ad19",
                                                "text": "Le cyprès est un bois tendre qui possède certaines des meilleures caractéristiques des bois durs. Il est léger comme le pin et robuste comme les bois durs tels que le frêne et l’érable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
