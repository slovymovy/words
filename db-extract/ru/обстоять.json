                "senses": [
                    {
                        "sense_id": "8a1fe8cc-7534-3ad9-9987-98bfb726d00b",
                        "entry_id": "739826d7-76fb-3b28-a64a-a91882acfb72",
                        "glosses": [
                            "to be, to be going, to be getting on, to stand (of affairs)"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4e78be43-04fb-4426-bdb1-252bd70732e8",
                                "sense_id": "8a1fe8cc-7534-3ad9-9987-98bfb726d00b",
                                "text": "Как обстоя́т дела́ с подгото́вкой к полёту?",
                                "translation": "How are things getting on with the preparation to the flight?",
                                "english": "How are things getting on with the preparation to the flight?"
                            },
                            {
                                "example_id": "4a764a67-d1e4-4ded-9515-d2a435a9ab27",
                                "sense_id": "8a1fe8cc-7534-3ad9-9987-98bfb726d00b",
                                "text": "Всё обстои́т намно́го лу́чше, чем тогда́.",
                                "translation": "Things are much better than back then.",
                                "english": "Things are much better than back then."
                            },
                            {
                                "example_id": "9007f4be-38fb-42f8-af51-64237956f06a",
                                "sense_id": "8a1fe8cc-7534-3ad9-9987-98bfb726d00b",
                                "text": "Е́сли де́ло обстои́т так...",
                                "translation": "If that's the case...",
                                "english": "If that's the case..."
                            },
                            {
                                "example_id": "e748d287-5593-4e0f-b799-585d7088dfd8",
                                "sense_id": "8a1fe8cc-7534-3ad9-9987-98bfb726d00b",
                                "text": "На са́мом де́ле всё обстои́т наоборо́т.",
                                "translation": "Actually, it's the opposite.",
                                "english": "Actually, it's the opposite."
                            }
                        ]
                    }
                ],
