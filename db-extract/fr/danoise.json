            {
                "entry_id": "61b01cc2-2124-35a1-9fcc-550c5ac16cb6",
                "word": "danoise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7649f5d-7d54-40ff-910a-f320d0ca7d66",
                        "entry_id": "61b01cc2-2124-35a1-9fcc-550c5ac16cb6",
                        "tags": [
