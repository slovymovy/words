                                    {
                                        "sense_id": "632bc412-27aa-38a6-b456-6e12c36da9d8",
                                        "entry_id": "e55fdd6c-d64a-3ab6-9764-2f4ea778fb1b",
                                        "glosses": [
                                            "An instance of something occurring; an event or happening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808833d1-bfb0-4017-ab7d-4f53ab6ef14e",
                                                "sense_id": "632bc412-27aa-38a6-b456-6e12c36da9d8",
                                                "text": "The perceived and known fact on which this discussion is based, is not the difference between the occurring and the non-occurring of an act (for non-occurring does not say impossibility), nor the difference between possibility and impossibility of the act (for the possibility cannot be perceived), but the difference between the occurring and the impossibility."
                                            },
                                            {
                                                "example_id": "3d51c814-de50-413e-81af-b275ac12a78e",
                                                "sense_id": "632bc412-27aa-38a6-b456-6e12c36da9d8",
                                                "text": "While it was noted above that the interaffecting of the present by the occurrings and implyings of the past provides a means of generating a sense of a personal past through the accumulation of bodily-relevant occurrings and implyings, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
