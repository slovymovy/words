                                        "examples": [
                                            {
                                                "example_id": "b5e2121b-7f7c-4cb0-bdea-3c0345fe47ae",
                                                "sense_id": "9d7d6a1c-525e-3631-8027-2366287cdc90",
                                                "text": "Advocates for gay and lesbian issues suggest the increase in discharges reflects the hostility of the military towards homosexual soldiers and a growing number of \"forced outings\" of gay and lesbian troops."
                                            }
