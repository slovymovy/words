{
    "word_family": [
        "mimicry",
        "mimicker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5b594e4-212b-3469-bac2-94a5107d3eca",
                    "sense_definition": "A person who performs impressions of others for entertainment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The talented <w>mimic</w> performed a hilarious routine featuring several famous politicians."
                        },
                        {
                            "text": "As a professional <w>mimic</w>, he can copy almost any celebrity voice perfectly."
                        }
                    ],
                    "synonyms": [
                        "impressionist",
                        "mimicker"
                    ],
                    "common_phrases": [
                        "talented mimic"
                    ]
                },
                {
                    "sense_id": "5443df12-6385-3a07-b289-4a81dcb45ce3",
                    "sense_definition": "A fictional monster that disguises itself as an object to trap adventurers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The adventurer opened the chest, only to realize it was a <w>mimic</w> waiting to attack."
                        },
                        {
                            "text": "Be careful when looting dungeons, as a <w>mimic</w> might be hiding in plain sight."
                        }
                    ],
                    "common_phrases": [
                        "dungeon mimic"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4c000d9-fed2-3caf-bea3-05d9d7282e2f",
                    "sense_definition": "To copy the actions or speech of someone, often to make fun of them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is rude to <w>mimic</w> the way your teacher speaks during class."
                        },
                        {
                            "text": "The parrot began to <w>mimic</w> the sounds of the ringing telephone."
                        }
                    ],
                    "common_phrases": [
                        "mimic someone"
                    ]
                },
                {
                    "sense_id": "fc1e4511-b99d-36ea-9f80-043560eac235",
                    "sense_definition": "To look like another organism or object for camouflage or protection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some harmless insects <w>mimic</w> the appearance of poisonous ones to avoid predators."
                        },
                        {
                            "text": "The moth's wings <w>mimic</w> the texture of tree bark to stay hidden."
                        }
                    ],
                    "common_phrases": [
                        "mimic the appearance"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92d5bebf-717b-3ace-a6de-0eb6d888dda1",
                    "sense_definition": "Not real; pretended or fake.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers practiced with <w>mimic</w> weapons during the training exercise."
                        },
                        {
                            "text": "They held a <w>mimic</w> trial to prepare for the actual court case."
                        }
                    ],
                    "common_phrases": [
                        "mimic battle"
                    ]
                }
            ]
        }
    ]
}