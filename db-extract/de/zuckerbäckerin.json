                "senses": [
                    {
                        "sense_id": "ed86fb92-114a-3526-9c67-0210fa0067c8",
                        "entry_id": "42e287af-df49-37d6-b738-d11da7148af5",
                        "glosses": [
                            "Handwerkerin, die Feinbackwerk wie Torten und Kuchen, Teegebäck, Pralinen, Konfekt, ebenso kandierte Früchte, Speiseeis und dergleichen herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8d724a-fcde-4390-9e69-e3aabbb2b7fe",
                                "sense_id": "ed86fb92-114a-3526-9c67-0210fa0067c8",
                                "text": "„Dann ging sie zu den Zuckerbäckerinnen, die hinter ihren großen Glasgefäßen saßen, und kaufte, indem sie mit dem Finger auf das jeweilige Glas zeigte, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "233697c0-6a23-3d78-9ea6-458d6b891cdc",
                        "entry_id": "42e287af-df49-37d6-b738-d11da7148af5",
                        "glosses": [
                            "Frau eines Zuckerbäckers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d14e1d02-7237-4b2a-a0d7-5f1a5ab6b6d6",
                                "sense_id": "233697c0-6a23-3d78-9ea6-458d6b891cdc",
                                "text": "„Das war ein neuer Regieeinfall; die liebe Mama stieß bei diesem Anblick in ihrer Freude einen Jubelruf aus, und die Zuckerbäckerin glänzte vor Stolz, daß sie vier volle Stunden lang den Platz der Contessa eingenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
