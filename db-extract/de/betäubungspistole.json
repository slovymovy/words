                        "sense_id": "a7a89bd3-99bc-3746-98e4-5d2018a47184",
                        "entry_id": "599e4149-61f7-3a41-b766-5e1c99c0cef2",
                        "glosses": [
                            "Pistole, mit der man Pfeile mit einem Betäubungsmittel abschießen kann, um jemanden zu betäuben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5261f864-b4c6-40fd-b084-830988d1c14c",
                                "sense_id": "a7a89bd3-99bc-3746-98e4-5d2018a47184",
                                "text": "„Jetzt waren nur noch der hünenhafte, teilnahmslose Wärter da und die lautlose Uhr hinter ihm und sein Drahtgeflechtschrank mit dem Tränengasspray und den Fesseln, dem Beißschutz und der Betäubungspistole.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
