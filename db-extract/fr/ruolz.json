        "fr-extract.jsonl": [
            {
                "entry_id": "4619ced1-977f-3075-b10f-9fdc3cf62979",
                "word": "ruolz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "edd0f60d-0bd1-3e9c-a8fa-84280f109a33",
                        "entry_id": "4619ced1-977f-3075-b10f-9fdc3cf62979",
                        "glosses": [
                            "Métal argenté par la galvanoplastie et dont on fabrique principalement des couverts de table."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92035031-6bec-385d-b76c-85a6c47932e0",
                        "entry_id": "4619ced1-977f-3075-b10f-9fdc3cf62979",
                        "glosses": [
                            "Alliage dont l’aspect est celui de l’argent et qui est employé en orfèvrerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5603a18-244f-4e0c-a9ec-3630e8a14966",
                                "sense_id": "92035031-6bec-385d-b76c-85a6c47932e0",
                                "text": "Une cuiller, une fourchette en ruolz."
                            },
                            {
                                "example_id": "cd2708d0-c73d-4b01-a581-7e73df89e54d",
                                "sense_id": "92035031-6bec-385d-b76c-85a6c47932e0",
                                "text": "Or, il advint, peu de temps après, que, se trouvant sans le sou, elle dut faire porter son cadeau au Mont-de-Piété..... Horreur ! le service était en ruolz ! ! !"
                            },
                            {
                                "example_id": "1b79a9fa-c80a-4e17-926e-cddd53683beb",
                                "sense_id": "92035031-6bec-385d-b76c-85a6c47932e0",
                                "text": "Doucement il met le sucre dans le verre et longuement il remue l’eau avec une cuillère de ruolz."
                            },
                            {
                                "example_id": "b20e35c9-b5b4-44eb-8b29-c103120f8915",
                                "sense_id": "92035031-6bec-385d-b76c-85a6c47932e0",
                                "text": "Les consommateurs, entassés autour des tables, à ne pouvoir bouger, se levaient pour laisser passage aux garçons noirs et blancs, qui élevaient au-dessus des têtes le ruolz des plateaux."
                            },
                            {
                                "example_id": "649aab4e-7fe8-4f9c-a175-d49c269f294f",
                                "sense_id": "92035031-6bec-385d-b76c-85a6c47932e0",
                                "text": "Ce qu’on voit au travers des carreaux suants des marchands de vin, les batteries de cuisine, les bols de punch étagés entre deux bouteilles vides d’où sort un brin de laurier, les vitrines où les liqueurs mettent leurs couleurs dans un éclair, une choppe pleine de petites cuillers de Ruolz, cela l’arrêtait longuement."
                            }
                        ]
                    }
                ],
