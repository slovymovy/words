        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b07a848c-1b61-329a-8390-319046118395",
                    "sense_definition": "Having one or more pointed projections or peaks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer adjusted his <w>peaked</w> cap before inspecting the ranks of soldiers.",
                            "target_lang_translations": {
                                "tr": "Subay, asker saflarını denetlemeden önce <w>kasketli</w> şapkasını düzeltti."
                            }
                        },
                        {
                            "text": "The mountain range displayed sharp, <w>peaked</w> ridges against the clear morning sky.",
                            "target_lang_translations": {
                                "tr": "Sıradağlar, berrak sabah gökyüzüne karşı keskin, <w>sivri</w> sırtlar sergiliyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "pointed"
                    ],
                    "antonyms": [
                        "flat"
                    ],
                    "common_phrases": [
                        "peaked cap",
                        "peaked roof"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sivri bir ucu veya tepesi olan; kasketli veya çıkıntılı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sivri",
                                "target_lang_sense_clarification": "ucu sivri olan"
                            },
                            {
                                "target_lang_word": "kasketli",
                                "target_lang_sense_clarification": "siperlikli şapka gibi"
                            },
                            {
                                "target_lang_word": "tepeli",
                                "target_lang_sense_clarification": "zirveleri olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e8b18c0-33b8-38fd-84c0-fd00f35f7b2b",
                    "sense_definition": "Looking pale, thin, or sickly, as if from illness or exhaustion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked <w>peaked</w> and tired after spending three sleepless nights caring for her sick child.",
                            "target_lang_translations": {
                                "tr": "Hasta çocuğuna bakarak geçirdiği üç uykusuz gecenin ardından <w>solgun</w> ve yorgun görünüyordu."
                            }
                        },
                        {
                            "text": "His coworkers noticed that he looked <w>peaked</w> and suggested he go home early to rest.",
                            "target_lang_translations": {
                                "tr": "İş arkadaşları onun <w>hastalıklı</w> göründüğünü fark ettiler ve dinlenmek için eve erken gitmesini önerdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "pale",
                        "sickly",
                        "wan",
                        "peaky"
                    ],
                    "antonyms": [
                        "healthy",
                        "flushed",
                        "blooming"
                    ],
                    "common_phrases": [
                        "look peaked"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hastalık veya yorgunluk nedeniyle solgun, bitkin ve hasta görünen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "solgun",
                                "target_lang_sense_clarification": "yüzü renksiz, soluk"
                            },
                            {
                                "target_lang_word": "bitkin",
                                "target_lang_sense_clarification": "halsiz ve yorgun"
                            },
                            {
                                "target_lang_word": "çelimsiz",
                                "target_lang_sense_clarification": "hastalıklı görünen"
