                ],
                "senses": [
                    {
                        "sense_id": "7800b81b-249b-33c5-8063-a4d2939e7321",
                        "entry_id": "4d157260-87f8-392f-b346-2b6d56992cec",
                        "glosses": [
                            "Relatif au cinéaste Alfred Hitchcock."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fad6391-0ff3-44d5-905a-90353843a0f2",
                                "sense_id": "7800b81b-249b-33c5-8063-a4d2939e7321",
                                "text": "Ceux qui ont assisté à ses présentations n’oublieront jamais sa silhouette hitchcockienne plantée devant l’écran et son regard matois, se réjouissant d’avance de l’effet que produirait le film choisi."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfb07208-9d31-3da1-9f2e-b596c1dfc741",
                        "entry_id": "4d157260-87f8-392f-b346-2b6d56992cec",
                        "glosses": [
                            "Se dit d’une œuvre de fiction ou d’une situation dont l’intrigue présente une tension intense."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "950146cb-59b0-454a-8670-fa4645e32fe4",
                                "sense_id": "dfb07208-9d31-3da1-9f2e-b596c1dfc741",
                                "text": "Avec ce scénario très hitchcockien, le spectateur est tenu en haleine tout le long de notre film."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcf73341-b0d9-3bca-a77c-bc43e1ac4206",
                        "entry_id": "4d157260-87f8-392f-b346-2b6d56992cec",
                        "glosses": [
                            "Qualifie un héros ou une héroïne de fiction qui a des points communs marquants avec ceux d’Hitchcock."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "e43ed1d0-b1dc-48e8-886e-2e6ff5319cbf",
                                "sense_id": "bcf73341-b0d9-3bca-a77c-bc43e1ac4206",
                                "text": "La journaliste en question, une belle blonde hitchcockienne, cache bien son jeu : en réalité, c’est elle qui a empoisonné le dignitaire américain."
                            },
                            {
                                "example_id": "09a44028-6f28-47b2-ac14-2a3e61a5162c",
                                "sense_id": "bcf73341-b0d9-3bca-a77c-bc43e1ac4206",
                                "text": "Discrètement maquillée, les cheveux relevés en un chignon parfait, il ne lui manquait que les longs gants blancs pour ressembler en tout point à une héroïne hitchcockienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f118db6b-f86c-4a13-bb0c-b24c799d5f33",
                        "source_entry_id": "4d157260-87f8-392f-b346-2b6d56992cec",
