                        "examples": [
                            {
                                "example_id": "3a60e383-b899-4f17-8aca-7edfd1c1c4b9",
                                "sense_id": "fdcc3b1a-fb76-3c9a-8466-1711482b2830",
                                "text": "Il y a cent ans à peine, à Pétersbourg, les mémoires de Catherine II le racontent, quand le czar ou la czarine étaient mécontents d’un prince russe, on faisait accroupir le prince dans la grande antichambre du palais, et il restait dans cette posture un nombre de jours déterminé, miaulant, par ordre, comme un chat, ou gloussant comme une poule qui couve, et becquetant à terre sa nourriture."
                            },
                            {
                                "example_id": "7b63aa73-c5a2-443d-9e21-818f503afb40",
                                "sense_id": "fdcc3b1a-fb76-3c9a-8466-1711482b2830",
                                "text": "« De même, disait-elle, que le Czar n'a jamais connu sujet plus loyal qu'Ephrem Fedorovitch, de même la Czarine n'a jamais connu meilleure automobile que la sienne. »"
                            }
                        ]
                    }
