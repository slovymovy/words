                "senses": [
                    {
                        "sense_id": "b07721bd-d63f-3d21-ba7f-e54fd77cdd4f",
                        "entry_id": "cbea60b5-e4a9-390a-90e1-9a130dc85fe5",
                        "glosses": [
                            "Faire sortir des casernes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7f90c2-52e5-443f-bf46-d78296222247",
                                "sense_id": "b07721bd-d63f-3d21-ba7f-e54fd77cdd4f",
                                "text": "La thèse française qui, nous l'espérons, ne sera pas maintenue, est la suivante : décaserner la police et la ramener aux effectifs d'autrefois."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffb5387a-f929-3e34-ae71-c713cc0801e1",
                        "entry_id": "cbea60b5-e4a9-390a-90e1-9a130dc85fe5",
                        "glosses": [
                            "Ne plus considérer comme une caserne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02275653-7505-47a1-b8aa-db0f674f2d4e",
                                "sense_id": "ffb5387a-f929-3e34-ae71-c713cc0801e1",
                                "text": "En résumé, Messieurs, ce serait, je crois, une grande faute de décaserner l'Ecole polytechnique."
                            }
                        ]
