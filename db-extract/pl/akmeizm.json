                                "target_senses": [
                                    {
                                        "sense_id": "40b1cb76-3e95-3936-8165-15c08f73b9e2",
                                        "entry_id": "bb41a4a6-b47c-3c1c-ba79-1fe82223e7fc",
                                        "glosses": [
                                            "Mouvement poétique russe qui a connu son heure de gloire au début des années 1910 sous la direction de Nikolaï Goumilev et Sergueï Gorodetski."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034de8c7-672c-4653-93b5-2735feea3f34",
                                                "sense_id": "40b1cb76-3e95-3936-8165-15c08f73b9e2",
                                                "text": "Dans l’acméisme aussi la tâche essentielle de la poétique a été altérée par les intérêts du mouvement et une idéologie de groupe bornée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
