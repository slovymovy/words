                        "form": "den Sternenhimmel"
                    },
                    {
                        "form_id": "7ea07802-77c6-4b87-9248-4d9f71ed4021",
                        "entry_id": "a7523026-bfdf-3cf1-b6d5-17f99ce9515a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sternenhimmel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                        "entry_id": "a7523026-bfdf-3cf1-b6d5-17f99ce9515a",
                        "glosses": [
                            "Nachthimmel mit den sichtbaren Sternen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cf2f83-8dc6-4be1-9f93-d0b2ca8098e5",
                                "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                                "text": "„Dabei blickte er hinauf zum funkelnden Sternenhimmel.“"
                            },
                            {
                                "example_id": "f5fe9a4e-2dce-4eb2-b7c0-8399ce18b7ba",
                                "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                                "text": "„Der funkelnde Sternenhimmel über uns sieht genauso eiskalt wie der im Licht der Stirnlampe funkelnde Reif aus, der unsere Zelte bedeckt.“"
                            },
                            {
                                "example_id": "eddb7ee3-db92-44d7-8ddb-a0d31b15dd53",
                                "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                                "text": "„Bis wir ein Lager aufgeschlagen, ein Feuer entfacht und unser Abendessen zubereitet hatten, war es meistens stockdunkel, nur der klare Sternenhimmel funkelte über uns.“"
                            },
                            {
                                "example_id": "70edf571-064f-4ce9-aef4-d1030ea951e1",
                                "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                                "text": "„Unter dem Sternenhimmel wehte eine warme Luft, und der Wind trug den Geruch des reifenden Getreides herüber.“"
                            },
                            {
                                "example_id": "6e350a66-ebfd-47c6-a698-1ccafe10f907",
                                "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                                "text": "„Sie saßen draußen unter dem Sternenhimmel, ein Heizstrahler neben ihrem Tisch vertrieb mit seinen blau-gelben Flammen die abendliche Kühle.“"
                            },
                            {
                                "example_id": "dbf855aa-418a-42a6-b8fa-6d0d6801782a",
                                "sense_id": "c90cb385-8097-3341-a5cb-2e5782dec8e3",
                                "text": "„Seine steile Stirn, seine Braue, die Schräge seiner Nase, seine WImpern und die Linie seiner Augen, das plastische Profil seines Mundes, das alles hebt sich schwarz vor dem Sternenhimmel ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
