                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                        "entry_id": "2feb9498-3d2a-3557-ab45-37083a022532",
                        "glosses": [
                            "Conviction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b42993f-2d4a-4614-aabb-9a50b804e5be",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "Uit overtuiging handelen.",
                                "translation": "Agir par conviction."
                            },
                            {
                                "example_id": "f9cb2708-7ada-4ae4-a875-1224af740883",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "In de overtuiging dat...",
                                "translation": "Convaincu que..."
                            },
                            {
                                "example_id": "5d56c6c7-1fc3-49a2-a5f4-c95937d2eb61",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "De innerlijke overtuiging.",
                                "translation": "L’intime conviction."
                            },
                            {
                                "example_id": "77bc83c9-411d-4532-81b2-2ba291458c3e",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "Politieke, religieuze overtuigingen.",
                                "translation": "Convictions politiques, religieuses."
                            },
                            {
                                "example_id": "1310189e-0789-4d8e-b5a1-0b1b59755147",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "Naar de algemene overtuiging.",
                                "translation": "Au sentiment général."
                            },
                            {
                                "example_id": "7fd32284-e1f5-4793-adb3-ec3face30ee0",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "In de stellige overtuiging verkeren.",
                                "translation": "Être totalement convaincu (de quelque chose)."
                            },
                            {
                                "example_id": "7883af24-ad1a-4dbd-80a2-3e747ef0bd38",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "Tot de overtuiging komen.",
                                "translation": "Acquérir la conviction."
                            },
                            {
                                "example_id": "e1571494-8593-44fa-b9f5-8379895df64b",
                                "sense_id": "7c21aae2-63f9-30e1-879e-b519ae50a11a",
                                "text": "De overtuiging toegedaan zijn, dat...",
                                "translation": "Être convaincu que..."
                            }
                        ]
                    }
