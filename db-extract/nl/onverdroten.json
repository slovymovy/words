                        "examples": [
                            {
                                "example_id": "8bc0cbcd-f7b7-4404-b61a-8c6fb1dcb2b5",
                                "sense_id": "9d3e975c-fdb9-3be5-a24c-922b26992ec6",
                                "text": "Onverdroten gingen de monniken door met het overschrijven van bijbels, theologische traktaten en werken van klassieke auteurs als Vergilius, Tacitus en Seneca"
                            }
                        ]
                    }
                ],
                "translations": [
