                "senses": [
                    {
                        "sense_id": "1b2e46b5-95d3-3a39-b6a6-bd7e09ad4f12",
                        "entry_id": "2bd3080e-1d09-3774-b28b-9310b3863114",
                        "glosses": [
                            "Faire perdre (ou diminuer) son caractère empathique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be3f4ec8-0650-480c-ba1b-0723c2a15f40",
                                "sense_id": "1b2e46b5-95d3-3a39-b6a6-bd7e09ad4f12",
                                "text": "(-dí n’est pas ici incident au quantificateur — ce qui pourrait signifier « rien du tout » — mais à la jonction verbe — marque d’agent, de sorte que sa fonction est de « désempathiser » l’agent, comme centre éventuel d’une sphère à laquelle on attend que s’agrègent certains « accomplissements » ; c’est justement cette attente qui est marquée comme déçue)."
                            },
                            {
                                "example_id": "94b35b11-0f32-490e-bd90-ceb1bc92e9f5",
                                "sense_id": "1b2e46b5-95d3-3a39-b6a6-bd7e09ad4f12",
                                "text": "Vous voulez dire qu'on veut nous « désempathiser » ?"
                            },
                            {
                                "example_id": "8c4d8059-b2a0-439a-afa5-ab1f5cac686f",
                                "sense_id": "1b2e46b5-95d3-3a39-b6a6-bd7e09ad4f12",
                                "text": "Il est terrible de pleurer si souvent de désespoir et d'impuissance mais je refuse de me « désempathiser » (ce que refuse aussi ton conte, en invoquant le lien inextricable du vécu entre les peuples du monde)."
                            },
                            {
                                "example_id": "fbec0c2f-196c-49b2-96ac-bcb280a81b51",
                                "sense_id": "1b2e46b5-95d3-3a39-b6a6-bd7e09ad4f12",
                                "text": "Bref toute solution pour se \"désempathiser\" est bienvenue."
                            }
                        ]
                    }
                ],
