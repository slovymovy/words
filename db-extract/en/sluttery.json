                                "target_senses": [
                                    {
                                        "sense_id": "72a4a607-9d15-3d86-aa68-821f8bb8d0c2",
                                        "entry_id": "d5d552d4-1e82-3a4a-b85e-d8dfc4c1d99b",
                                        "glosses": [
                                            "sexuell ausschweifendes Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e6359b-0a13-458f-b3c8-ef8eb2fd27dc",
                                                "sense_id": "72a4a607-9d15-3d86-aa68-821f8bb8d0c2",
                                                "text": "„Gewöhnlich gipfelte die Auseinandersetzung darin, daß Alf die Mutter seiner Frau der Hurerei in jungen Jahren bezichtigte, indes Recha ihm triumphierend die Geschlechtskrankheit seiner Eltern an den Kopf warf.“"
                                            },
                                            {
                                                "example_id": "a6c71360-fd47-4c0c-b98a-880138fff053",
                                                "sense_id": "72a4a607-9d15-3d86-aa68-821f8bb8d0c2",
                                                "text": "„Der sinnenfreudige, denkende Mensch verachtet die Gefräßigkeit, die Hurerei und die brutale Rache in einer ersten Zornesaufwallung.“"
                                            },
                                            {
                                                "example_id": "cd90fda8-419f-4cab-b8db-02f599ba200e",
                                                "sense_id": "72a4a607-9d15-3d86-aa68-821f8bb8d0c2",
                                                "text": "„Sie konnte eigentlich nur für ihn kochen, ohne dauernd an mich denken zu müssen, denn das hat sie so selten für mich getan, daß es nicht unbedingt Verrat oder Hurerei sein würde.“"
                                            },
                                            {
                                                "example_id": "2cb66954-599e-4c24-b13e-550eff931324",
                                                "sense_id": "72a4a607-9d15-3d86-aa68-821f8bb8d0c2",
                                                "text": "„Ist mir egal. Ich will keine Hurerei vor meiner Haustür!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96f7a925-9a74-467a-8240-541aeb930a93",
