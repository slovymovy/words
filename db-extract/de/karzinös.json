                "senses": [
                    {
                        "sense_id": "c5e9c79e-ac4a-313c-9d3e-9a06c46bf6f1",
                        "entry_id": "2788fdef-efde-3bd8-9e3a-4498bbf6e4b3",
                        "glosses": [
                            "von Krebs befallen, von Karzinomen befallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc3caace-734d-4df0-bdd1-9d17a27ff43d",
                                "sense_id": "c5e9c79e-ac4a-313c-9d3e-9a06c46bf6f1",
                                "text": "„Ein weiteres Beispiel für Nanoschalen-Plasmonik in der Krebsbehandlung ist es, toxische Medikamente in das Nanopartikel einzubringen und es als Vehikel zu verwenden, diese ausschließlich zu den karzinösen Stellen zu transportieren“"
                            },
                            {
                                "example_id": "21c09457-4e10-4109-bc82-96dc392f93ba",
                                "sense_id": "c5e9c79e-ac4a-313c-9d3e-9a06c46bf6f1",
                                "text": "„Es kommt vom englischen Wort cancerous und darf auch mit karzinös oder krebsartig übersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
