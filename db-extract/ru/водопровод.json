                        ]
                    },
                    {
                        "translation_id": "29e12f2e-341a-43b6-b647-dd31335af634",
                        "source_entry_id": "f1798e62-1b2e-3deb-b001-bb8f31e961c6",
                        "source_sense_id": "b0e85e56-fe80-34c6-856e-8c6bf4fedfcf",
                        "target_lang_word": "water-pipe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aa39773a-65fc-4a27-817f-3d39307a28f4",
                        "source_entry_id": "f1798e62-1b2e-3deb-b001-bb8f31e961c6",
                        "source_sense_id": "b0e85e56-fe80-34c6-856e-8c6bf4fedfcf",
                        "target_lang_word": "water-supply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a33aca85-09fb-451a-acf1-f5cfbb83c330",
                        "source_entry_id": "f1798e62-1b2e-3deb-b001-bb8f31e961c6",
                        "source_sense_id": "b0e85e56-fe80-34c6-856e-8c6bf4fedfcf",
                        "target_lang_word": "running water",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "running water",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                        "entry_id": "97d688dd-5254-3a86-8f8a-57fe729409a6",
                                        "glosses": [
                                            "Water available from taps."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88455176-2916-4dd0-ac92-ac3ad76d2d64",
                                                "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                                "text": "The rural population of the United States in 1950 was 57.5 million; ( of this total 22 percent was served by running water) and used an estimated 3,500 million gallons of water per day."
                                            },
                                            {
                                                "example_id": "07faa657-67df-4e69-bee7-1c2a9a379888",
                                                "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                                "text": "A public system or private company refers to any source supplying running water to six or more housing units."
                                            },
                                            {
                                                "example_id": "c291add5-c12a-46a6-9950-16090ceaeccc",
                                                "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                                "text": "The things I previously seen as life's necessities—proper running water to drink and wash with, sanitary restrooms, and local medical help—were nowhere to be found in this God-forsaken little town."
                                            },
                                            {
                                                "example_id": "2e3a2a18-17e9-442f-9adc-23015e8a464b",
                                                "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                                "text": "In sight of the river, their factories' source for water, they often live without running water and electricity [...because] the river becomes polluted with industrial wastewater as well as untreated, raw sewage."
                                            },
                                            {
                                                "example_id": "2b1a4433-eee6-4f42-89d2-29c7598dcede",
                                                "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                                "text": "At the time being middle class in America meant education for the children and modern home conveniences, most basically, hot and cold running water."
                                            },
                                            {
                                                "example_id": "63fb2a27-b8a4-43c5-a39e-4e8ca9493afa",
                                                "sense_id": "6a71061d-ec63-3d15-83d1-49cfca5cd48c",
                                                "text": "First, since resettled people had to move into existing communities in designated resettlement areas, policy adjustment to assist host communities with running water and electricity were needed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bed5a521-dd1f-348f-a9f7-6ad943ed7786",
                                        "entry_id": "97d688dd-5254-3a86-8f8a-57fe729409a6",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see running, water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f30935fe-94f6-4a03-bb4a-916419eb5f80",
                                                "sense_id": "bed5a521-dd1f-348f-a9f7-6ad943ed7786",
                                                "text": "Productivity in running water is dependent primarily on attached algae, which is part of the periphyton."
                                            },
                                            {
                                                "example_id": "569b3da9-f057-4750-8591-7778f6dab760",
                                                "sense_id": "bed5a521-dd1f-348f-a9f7-6ad943ed7786",
                                                "text": "The action of running water is such as to wear away the banks against which the current is directed, and therefore one riparian owner has no right to change the flow of the current so as to direct it against the land of the opposite owner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26f6c2e9-4fb3-4dce-98f4-02114c0f7c45",
                        "source_entry_id": "f1798e62-1b2e-3deb-b001-bb8f31e961c6",
                        "source_sense_id": "b0e85e56-fe80-34c6-856e-8c6bf4fedfcf",
                        "target_lang_word": "Wasserleitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserleitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                        "entry_id": "e93b7912-56f2-3bf9-ab9b-bc249b72b5db",
                                        "glosses": [
                                            "Rohrsystem zum Transport von Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50bcef54-9ce6-4608-b7e3-fc92901742e4",
                                                "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                                "text": "Die Wasserleitung ist gebrochen."
                                            },
                                            {
                                                "example_id": "afc4dc22-6029-4d75-a73d-18581d885ccf",
                                                "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                                "text": "Wasserleitungen in nicht sanierten Altbauten sind häufig aus Blei und müssen ausgetauscht werden, um eine Bleibelastung der Bewohner zu vermeiden."
                                            },
                                            {
                                                "example_id": "caad2739-a4c1-4523-ab56-681d63388df1",
                                                "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                                "text": "„Wir wählen ein Zimmer im Untergeschoß, das gleich zweifach Vorteile bietet: ein Waschbecken mit Wasserleitung, die sogar funktioniert, und einen rückwärtigen Ausgang.“"
                                            },
                                            {
                                                "example_id": "2e6bc245-ab18-40ee-a66c-5aeb0243fd8e",
                                                "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                                "text": "„Es herrschte dauernd ein Polarklima, und während der zweiten Kältewelle froren nicht nur die Wasserleitungen zu, sondern eines Nachts platzte und explodierte das Abflußrohr unter der Toilette, und eine Flut von gefrorenen Exkrementen kam heraus, die den ganzen Boden des Badezimmers bedeckten.“"
                                            },
                                            {
                                                "example_id": "968f827f-d893-49c1-8899-bee0ad1545de",
                                                "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                                "text": "„Wasserleitungen rauschten, Türen klappten, und unten hustete der Emigrant Wiesenhoff sein Erwachen aus dem Fenster.“"
                                            },
                                            {
                                                "example_id": "b4385726-c6fd-4a1c-944b-9c313fc02089",
                                                "sense_id": "5cb4fc7c-008c-3456-a046-22f39633f704",
                                                "text": "„Wir wollten trinken, die Wasserleitungen waren durchschnitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6724e468-ec6f-3e6c-9e1a-b68c033d5758",
                                        "entry_id": "e93b7912-56f2-3bf9-ab9b-bc249b72b5db",
                                        "glosses": [
                                            "Harnröhre, Harntrakt"
                                        ],
                                        "tags": [
                                            "humoristisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7497f6-d410-49e9-982a-bd16eee93ed0",
                                                "sense_id": "6724e468-ec6f-3e6c-9e1a-b68c033d5758",
                                                "text": "Er liegt schon wieder auf der Urologie; andauernd hat er etwas an der Wasserleitung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
