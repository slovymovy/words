                                    {
                                        "sense_id": "2bef4151-6f50-304a-9180-8b79817bd891",
                                        "entry_id": "e5ec28c6-f1db-36bf-a2f9-5d952097aa6e",
                                        "glosses": [
                                            "Grand lémurien de Madagascar, de la famille des indridés, diurne et folivore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4764cf-0f1a-49d8-abb0-24e46696e830",
                                                "sense_id": "2bef4151-6f50-304a-9180-8b79817bd891",
                                                "text": "L’hôte le plus recherché de la réserve est l’indri, le plus grand des lémuriens, appelé babakoto (babakout) en malgache."
                                            },
                                            {
                                                "example_id": "5457536c-a578-4f68-a585-8da24cafc021",
                                                "sense_id": "2bef4151-6f50-304a-9180-8b79817bd891",
                                                "text": "Concernant les organisations sociales, on observe des groupes strictement familiaux rassemblant les parents monogames, la progéniture et éventuellement les jeunes de la génération précédente (comme chez les titis, indris, gabbons et siamangs)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0425eeb-31c2-4429-bcfc-1c933c10b430",
                        "source_entry_id": "76855af3-6aa0-3d86-b5c1-e58d5265f397",
                        "source_sense_id": "1e1bf969-272e-3bbd-8483-849017540106",
                        "source_sense_description": "Indri indri",
                        "target_lang_word": "Indri",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indri",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                        "entry_id": "33b4dc06-2ed2-3c9b-b120-75434caf1b76",
                                        "glosses": [
                                            "Primatenart aus der Familie der Lemuren, die im Nordosten Madagaskars vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7ecd21-b5f4-4fc0-8672-bd5310ec5dc8",
                                                "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                                "text": "„Mit einer Körperhöhe von 80 cm ist der Indri (Indri Indri) heute die größte noch existierende Lemurenart.“"
                                            },
                                            {
                                                "example_id": "95855715-0189-44e8-8e0e-bce72e9db9ef",
                                                "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                                "text": "„Da sein Lebensraum zunehmend zerstört wird, ist der Indri vom Aussterben bedroht.“"
                                            },
                                            {
                                                "example_id": "caa32b00-2b74-4609-a987-4f9f05df6738",
                                                "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                                "text": "„Zur Familie der Indridae gehören der kleine Wollmaki und der Indri, der von den Eingeborenen wegen seiner lauten Stimme Amboanala oder Hund des Waldes genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
