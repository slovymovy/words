                "senses": [
                    {
                        "sense_id": "a1643578-04cb-3130-8263-0e0bb2e2dec5",
                        "entry_id": "a64fa2b2-3459-3be2-9e03-9f3004a5940b",
                        "glosses": [
                            "техн. резервуар для хранения масла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3325d871-2925-4c25-a577-dfec76790444",
                                "sense_id": "a1643578-04cb-3130-8263-0e0bb2e2dec5",
                                "text": "В заднем обтекателе мотогондолы размещены маслобак и агрегаты маслосистемы двигателя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2020578a-aade-4d08-9d02-0f4e3e86b7ad",
                        "source_entry_id": "a64fa2b2-3459-3be2-9e03-9f3004a5940b",
                        "source_sense_id": "a1643578-04cb-3130-8263-0e0bb2e2dec5",
                        "target_lang_word": "oil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "439cc7ec-0ccc-3d09-ac42-c3e0ef125e8f",
                                        "entry_id": "c3a6f0e3-2981-3db1-bf39-b45b6cf563b1",
                                        "glosses": [
                                            "Liquid fat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642fec55-2ec5-4f55-9922-ee04681b98af",
                                                "sense_id": "439cc7ec-0ccc-3d09-ac42-c3e0ef125e8f",
                                                "text": "Oil is mostly found in Saudi Arabia and is transported all over the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a78ac8c-c469-3e11-a8b5-19d9e14c736a",
                                        "entry_id": "c3a6f0e3-2981-3db1-bf39-b45b6cf563b1",
                                        "glosses": [
                                            "Petroleum-based liquid used as fuel or lubricant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a10737af-9993-3044-be26-428cddd1a216",
                                        "entry_id": "c3a6f0e3-2981-3db1-bf39-b45b6cf563b1",
                                        "glosses": [
                                            "Petroleum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b80b6fd-bbd3-46d9-8f6b-f091bf9856a3",
                                                "sense_id": "a10737af-9993-3044-be26-428cddd1a216",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices). It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37642c40-af6f-35a0-bd97-0e673a5e6864",
                                        "entry_id": "c3a6f0e3-2981-3db1-bf39-b45b6cf563b1",
                                        "glosses": [
                                            "An oil painting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37c8b6f1-d2d3-4de0-9abd-4cb763d260aa",
                                                "sense_id": "37642c40-af6f-35a0-bd97-0e673a5e6864",
                                                "text": "Yet, in another way, I was unable to put Picasso's oils in the same class as Cezanne's, or even (which will no doubt shock many readers) as Renoir's."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c6f1a6-d649-368a-9641-0c23e4ae6502",
                                        "entry_id": "c3a6f0e3-2981-3db1-bf39-b45b6cf563b1",
                                        "glosses": [
                                            "Oil paint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86bf4f10-4ff0-43d1-913c-4e457e531db8",
                                                "sense_id": "01c6f1a6-d649-368a-9641-0c23e4ae6502",
                                                "text": "I prefer to paint in oil"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a434743a-48af-3f50-bcb4-b56149c4401c",
                                        "entry_id": "0bb6a032-7f3a-3a02-a51f-3aa3cb53957a",
                                        "glosses": [
                                            "To lubricate with oil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c2f1e08-a74d-461d-97bf-b3c14533d5d7",
                                                "sense_id": "a434743a-48af-3f50-bcb4-b56149c4401c",
                                                "text": "Before they went to see Glinda, however, they were taken to a room of the Castle, where Dorothy washed her face and combed her hair, and the Lion shook the dust out of his mane, and the Scarecrow patted himself into his best shape, and the Woodman polished his tin and oiled his joints."
                                            },
                                            {
                                                "example_id": "aaa083a3-3187-4d04-8c51-f372ca673fe6",
                                                "sense_id": "a434743a-48af-3f50-bcb4-b56149c4401c",
                                                "text": "Platform faces in Holland are further back from the track than they are in Britain, and it is a common thing to see a driver standing quite comfortably between his engine and the platform while oiling the motion."
                                            },
                                            {
                                                "example_id": "c3c3183f-293a-488f-9d5e-dd5d32072865",
                                                "sense_id": "a434743a-48af-3f50-bcb4-b56149c4401c",
                                                "text": "The face which emerged was not reassuring.[…]. He was not a mongol but there was a deficiency of a sort there, and it was not made more pretty by a latter-day hair cut which involved eccentrically long elf-locks and oiled black curls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98ea9a9-8cfe-372b-b3ea-fb7b49c2b71f",
                                        "entry_id": "0bb6a032-7f3a-3a02-a51f-3aa3cb53957a",
                                        "glosses": [
                                            "To grease with oil for cooking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "643809df-dfb4-3abc-9834-59597395d0f2",
                                        "entry_id": "0bb6a032-7f3a-3a02-a51f-3aa3cb53957a",
                                        "glosses": [
                                            "To fuel with oil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e451e4c-6883-3f95-b5d6-bc33d3a2f869",
                                        "entry_id": "0bb6a032-7f3a-3a02-a51f-3aa3cb53957a",
                                        "glosses": [
                                            "To say in an unctuous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad00dd6-c849-4404-89bd-0ecb4b91515d",
                                                "sense_id": "3e451e4c-6883-3f95-b5d6-bc33d3a2f869",
                                                "text": "\"Do you need a drink?\" oils Robert Ryan to the disinterested Stanwyck in Clash By Night; \"Let's say that's what I need,\" she sneers back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
