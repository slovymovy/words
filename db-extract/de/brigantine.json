                ],
                "senses": [
                    {
                        "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                        "entry_id": "2cd8e40f-adb3-3ce2-8366-7ac9ecb65af2",
                        "glosses": [
                            "Segelschiff mit zwei Masten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76f5fe9-5f7e-4ed2-be84-fcdced974727",
                                "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                "text": "„Hier war es besonders schwierig, weil die Brigantine unaufhörlich in der bewegten See hin und her gierte und das kleine Boot von jeder heranlaufenden Welle hochgehoben wurde, bevor es wieder in ein Wellental sackte.“"
                            },
                            {
                                "example_id": "845c43fb-4f2b-4a58-8ac1-c2a88e5e769a",
                                "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                "text": "„Eine neue Waffe schwamm jetzt im trüben Wasser des Sees: 13 kleine Kriegsschiffe, Brigantinen, bemannt mit Armbrustschützen und Musketieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d70bc27-b198-3542-8de7-d2b74e1e6a48",
                        "entry_id": "2cd8e40f-adb3-3ce2-8366-7ac9ecb65af2",
                        "glosses": [
                            "Rüstung aus zahlreichen kleinen Metallplättchen, die auf Stoff befestigt sind"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54ae1c86-79dd-4c73-9035-9827a17eed7e",
                        "source_entry_id": "2cd8e40f-adb3-3ce2-8366-7ac9ecb65af2",
                        "source_sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                        "source_sense_description": "Segelschiff mit zwei Masten",
                        "target_lang_word": "бригантина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бригантина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8a144bc2-076c-3584-ae7e-0245517a53af",
                                        "entry_id": "f19d32be-495d-3b90-af17-2d334d007982",
                                        "glosses": [
                                            "морск. лёгкое и быстроходное судно со смешанным парусным вооружением — прямыми парусами на фок-мачте и косыми на грот-мачте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89609b60-226a-462b-bc1a-b7edefb4d82c",
                                                "sense_id": "8a144bc2-076c-3584-ae7e-0245517a53af",
                                                "text": "Фок-мачта имела поперечные реи и, следовательно, прямые паруса, бизань вооружена гиком и гафелем, судно было бригантиной. … Походив по трюму, старпом уяснил себе, что треск издается почти всем корпусом бригантины, а раздирающий уши скрип идёт от мачт судна."
                                            },
                                            {
                                                "example_id": "0692cb6b-de2c-4f05-bdff-9f45de09413b",
                                                "sense_id": "8a144bc2-076c-3584-ae7e-0245517a53af",
                                                "text": "Даже издали было заметно, что мачты корвета повреждены в бою, а паруса бригантины изодраны и потрёпаны."
                                            },
                                            {
                                                "example_id": "062d9522-4dae-4ee9-94cc-a4a151c3ee9f",
                                                "sense_id": "8a144bc2-076c-3584-ae7e-0245517a53af",
                                                "text": "Всякий, кто видел «Товарища» хотя бы на картинке, не может не ощутить, что этот красавец корабль с его высокими мачтами, несущими на себе наполненные солёным ветром паруса, кажется пришельцем из мира легенд, из прошлых веков, когда морские суда назывались каравеллами и бригантинами, а легенда о «Летучем голландце» ещё воспринималась как быль."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бригантина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1480ba38-fa17-3877-b052-6f2f87ebd915",
                                        "entry_id": "d74290a8-b486-3528-a088-c269e908cd57",
                                        "glosses": [
                                            "воен. вид средневековых доспехов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681597f6-b3f0-41e5-b324-ad00ab912998",
                                                "sense_id": "1480ba38-fa17-3877-b052-6f2f87ebd915",
                                                "text": "При слове «доспехи» у подавляющего большинства людей возникают в сознании образы сплошных рыцарских лат, реже кольчуг или пластинчатых доспехов и, как это ни странно, крайне редко вспоминается бригантина. Факт сей более чем удивителен, ведь бригантина долгое время была наиболее распространенным типом как европейского, так и восточного доспеха."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
