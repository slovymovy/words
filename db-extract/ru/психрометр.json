                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "29ccd831-74ca-4dee-a529-01cfa77536dd",
                        "source_entry_id": "49e2ca80-1181-35e2-9fae-c6a4e5bc2bb1",
                        "source_sense_id": "aceaf29f-085e-32b1-8d46-c3ed0b40fb06",
                        "target_lang_word": "Hygrometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hygrometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fde4ea9c-48e1-38b0-8807-b1719981b346",
                                        "entry_id": "a297a190-4ec1-3a8c-92e6-5ff541c6efbe",
                                        "glosses": [
                                            "Messgerät zur Bestimmung der relativen Luftfeuchtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c470c680-5b58-4447-9594-b8a7ec782398",
                                                "sense_id": "fde4ea9c-48e1-38b0-8807-b1719981b346",
                                                "text": "Ein Hygrometer ist eine Messgerät welches die relative Luftfeuchtigkeit anzeigt. Im Hygrometer ist ein Pferdehaar eingespannt, welches über die Längenänderung, bei veränderlicher Luftfeuchtigkeit, den Zeiger bewegt. Geeichte Hygrometer sollten regelmäßig einer Luftfeuchtigkeit von 100% ausgesetzt werden, um das Haar und die Messfähigkeit dessen zu erhalten."
                                            },
                                            {
                                                "example_id": "86fa2018-114d-4d57-ace2-8b271d89108d",
                                                "sense_id": "fde4ea9c-48e1-38b0-8807-b1719981b346",
                                                "text": "Der Mensch fühlt sich bei 40% bis 60% relativer Luftfeuchtigkeit (Normal) am wohlsten und überprüft dieses mit dem Hygrometer im Raum."
                                            },
                                            {
                                                "example_id": "15c64061-c1d0-4c90-81e6-0d08f8cbb117",
                                                "sense_id": "fde4ea9c-48e1-38b0-8807-b1719981b346",
                                                "text": "„Das preisgünstige Hygrometer testo 608-H1 misst kontinuierlich Feuchte, Temperatur und Taupunkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0436abc0-eafa-4133-9644-24b9116a9561",
                        "source_entry_id": "49e2ca80-1181-35e2-9fae-c6a4e5bc2bb1",
                        "source_sense_id": "aceaf29f-085e-32b1-8d46-c3ed0b40fb06",
                        "target_lang_word": "Luftfeuchtigkeitsmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9b02b070-b655-4641-ba00-11772e041d1e",
                        "source_entry_id": "49e2ca80-1181-35e2-9fae-c6a4e5bc2bb1",
                        "source_sense_id": "aceaf29f-085e-32b1-8d46-c3ed0b40fb06",
                        "target_lang_word": "Psychrometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychrometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                        "entry_id": "f0c979f4-3232-3d5c-84d0-a87a632de7e2",
                                        "glosses": [
                                            "Instrument zur Bestimmung der Luftfeuchtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ff76ec-e7db-4513-a8ea-5c4a144c1609",
                                                "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                                "text": "„Schließlich kann die Luftfeuchte noch durch Messung mit dem Psychrometer ermittelt werden.“"
                                            },
                                            {
                                                "example_id": "c77bfab9-fd84-4c6c-b915-612ef4e4bfbc",
                                                "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                                "text": "„Bei dem Psychrometer nach Aßmann strömt die zu messende Luft mit einer definierten Geschwindigkeit an zwei Thermometern vorbei.“"
                                            },
                                            {
                                                "example_id": "3e8c554b-fd43-40e6-9fe2-7a738aa9cbb6",
                                                "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                                "text": "„Gleichzeitig wurden mehrere Observationen mit dem Psychrometer der nahe gelegenen meteorologischen Station vorgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
