                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1a9fc1fb-2c98-427f-94b3-315185734f87",
                                "sense_id": "ca2c42eb-0f8a-351b-81bc-771c23a652d0",
                                "text": "this present Act, or any Thing therein contained, shall not extend nor take place to abridge, deprive or minorate any Liberties, Privilege or Authority of any Lords Marchers"
                            },
                            {
                                "example_id": "49822b8f-522c-4b58-8d59-2869c8e5e7ed",
                                "sense_id": "ca2c42eb-0f8a-351b-81bc-771c23a652d0",
                                "text": "Forget not how assuefaction unto any thing minorates the passion from it, how constant Objects loose their hints, and steal an inadvertisement upon us."
                            },
                            {
                                "example_id": "07145648-93c6-4f53-aa4d-2c11fd70e919",
                                "sense_id": "ca2c42eb-0f8a-351b-81bc-771c23a652d0",
                                "text": "Assuefaction minorates atrocities (as Tully saith of his darling Stoics) and Hamlet his father showeth the prince no blister of combustion."
                            }
                        ]
                    },
                    {
                        "sense_id": "d094c835-965d-3485-9220-4157715d0ae3",
