                "senses": [
                    {
                        "sense_id": "426b4dad-1652-37c8-9307-6a1d5704d434",
                        "entry_id": "d9450f90-647c-3db6-9e35-56d04d0dbc81",
                        "glosses": [
                            "Pilot, der ein Jagdflugzeug steuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e76109-e1e4-4b67-a9c2-ba11c12735b0",
                                "sense_id": "426b4dad-1652-37c8-9307-6a1d5704d434",
                                "text": "Er war lange Jahre als Jagdflieger bei der Luftwaffe."
                            },
                            {
                                "example_id": "55525288-fc60-461e-9072-40317f68e430",
                                "sense_id": "426b4dad-1652-37c8-9307-6a1d5704d434",
                                "text": "„Der Jagdflieger Schnell ist ebenfalls nach Escoublac gekommen, rauchte mit seinem abgeschossenen Kollegen James M. Ferguson, dem B-17-Piloten, eine Zigarette und setzte sich dann mit ihm zusammen in den Sand, um dort mit einem Stöckchen nachzuzeichnen, wie es zu dem Abschuss kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
