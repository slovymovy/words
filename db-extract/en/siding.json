                                    {
                                        "sense_id": "dedb0c79-04bd-3de6-b9be-13f4ed6e1ebd",
                                        "entry_id": "d15be34e-ff40-3979-940a-b0e5045bd8b7",
                                        "glosses": [
                                            "Voie qui permet de se garer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8768ed68-f30c-4934-bf15-c4d93e12d354",
                                                "sense_id": "dedb0c79-04bd-3de6-b9be-13f4ed6e1ebd",
                                                "text": "La sortie du train de la voie de garage, vers la voie principale a lieu par accès direct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14a6c84-0224-3127-a9e3-f9b33764deef",
                                        "entry_id": "d15be34e-ff40-3979-940a-b0e5045bd8b7",
                                        "glosses": [
                                            "Impasse ; voie sans issue."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155933fa-57f3-4101-8e76-a5910f0e5de0",
                                                "sense_id": "f14a6c84-0224-3127-a9e3-f9b33764deef",
                                                "text": "Cela m’a donné envie et j’ai décidé, après ma licence d’histoire, de m’inscrire en fac d’arts du spectacle à Metz, avec l’idée de devenir scénariste. Comme voie de garage, c’est à peu près ce que l’on fait de mieux, mais je l’ignorais totalement…"
                                            },
                                            {
                                                "example_id": "3e68d3d3-260b-4ee8-ad4e-87ea0de0ae3c",
                                                "sense_id": "f14a6c84-0224-3127-a9e3-f9b33764deef",
                                                "text": "Commencer sa carrière dans une petite entreprise, tremplin ou voie de garage ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be76175b-5b74-436d-9448-e9da68f9e82f",
                        "source_entry_id": "2f30976d-0aa7-33bd-9d39-b71ce865f182",
                        "source_sense_id": "9e4a77f3-830d-3fb5-9093-2ec9ed4dd41a",
                        "source_sense_description": "side track",
                        "target_lang_word": "Nebengleis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebengleis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95275398-e962-3d74-bc74-b10f4e63811e",
                                        "entry_id": "b7541a97-b78e-3fb0-8649-17e4b3a6caf8",
                                        "glosses": [
                                            "Bahnhofsgleis, das kein Hauptgleis ist; das nicht planmäßig von Zügen befahren wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ed0085-dd7a-41cc-bcf8-42ca95323767",
                                                "sense_id": "95275398-e962-3d74-bc74-b10f4e63811e",
                                                "text": "„Durchgehende Hauptgleise sind die Hauptgleise der freien Strecke und ihre Fortsetzung in den Bahnhöfen. Alle übrigen Gleise sind Nebengleise.“"
                                            },
                                            {
                                                "example_id": "d9dce306-d7eb-467a-a461-727dc2b78118",
                                                "sense_id": "95275398-e962-3d74-bc74-b10f4e63811e",
                                                "text": "„Ein Aufenthalt folgt dem anderen; jedes Nebengleis ist offenbar dazu bestimmt, unsere Geduld auf die Probe zu stellen.“"
                                            },
                                            {
                                                "example_id": "0a6baa43-a3d0-4971-a8be-552071b62961",
                                                "sense_id": "95275398-e962-3d74-bc74-b10f4e63811e",
                                                "text": "„Also fuhren wir mit dem Zug von der Gare du Nord durch den schmutzigsten und traurigsten Teil der Stadt und gingen vom Nebengleis zur Oase der Rennbahn.“"
                                            },
                                            {
                                                "example_id": "daf510a9-f5fa-4f83-bb69-50d7676cff87",
                                                "sense_id": "95275398-e962-3d74-bc74-b10f4e63811e",
                                                "text": "„Auf dem Nebengleis fährt ein langsamer Zug ohne Fenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e577879c-d28b-4ae7-9cc6-cadc23c5099b",
                        "source_entry_id": "2f30976d-0aa7-33bd-9d39-b71ce865f182",
                        "source_sense_id": "9e4a77f3-830d-3fb5-9093-2ec9ed4dd41a",
                        "source_sense_description": "side track",
                        "target_lang_word": "Abstellgleis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstellgleis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                        "entry_id": "6f46bc65-788f-366e-9a44-c2cfa663db18",
                                        "glosses": [
                                            "Gleis, auf dem Eisenbahnfahrzeuge abgestellt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd220f59-e876-48b4-a812-d3d6d89d649c",
                                                "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                                "text": "Eisenbahn-Starterset mit Güterzug und Abstellgleis."
                                            },
                                            {
                                                "example_id": "8dcda004-e2ce-420e-9793-9cde9217b46e",
                                                "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                                "text": "„Sie haben uns auf ein Abstellgleis geschoben.“"
                                            },
                                            {
                                                "example_id": "4fe8c9a5-f72e-4d99-a334-70568a494343",
                                                "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                                "text": "„Vielleicht war es ihnen obendrein gelungen, auf den Bahngleisen ein paar heruntergefallene Briketts oder Steinkohlebrocken aufzusammeln oder – der Herrgott drücke ein Auge zu! – von lässlich bewachten Waggons auf den Abstellgleisen der Reichsbahn zu stehlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
