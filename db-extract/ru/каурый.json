                "senses": [
                    {
                        "sense_id": "3130bdd9-d301-3a2f-ad44-7ee5b72f03ca",
                        "entry_id": "3e8a982f-ed38-3b7d-9e64-5ea91a58b550",
                        "glosses": [
                            "животн. светло-каштановый, рыжеватый"
                        ],
                        "tags": [
                            "о масти лошадей"
                        ],
                        "examples": [
                            {
                                "example_id": "d7990cd9-3b6e-422b-beb9-47247aa21cf8",
                                "sense_id": "3130bdd9-d301-3a2f-ad44-7ee5b72f03ca",
                                "text": "Этот чубарый конь был сильно лукав и показывал только для вида, будто бы везёт, тогда как коренной гнедой и пристяжной каурой масти, называвшийся Заседателем, потому что был приобретён от какого-то заседателя, трудились от всего сердца, так что даже в глазах их было заметно получаемое ими от того удовольствие."
                            }
                        ]
                    }
