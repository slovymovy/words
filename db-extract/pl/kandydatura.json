                        "sense_id": "51982dc2-43ed-3379-908a-4e69ec727df6",
                        "entry_id": "cd3382ee-bad6-339a-8f6c-d0a5f30e5616",
                        "glosses": [
                            "wniosek proponujący kogoś na określone stanowisko czy funkcję"
