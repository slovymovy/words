                        "entry_id": "4f748087-9737-3077-a5bf-fa38a6bdd52f",
                        "glosses": [
                            "Verehren von Menschen, die als Heilige gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635df100-2011-4ed7-917b-4a989cf4583c",
                                "sense_id": "5d4d7f54-c342-3172-9dfb-ab3fe841fec3",
                                "text": "„Vor allem durch die seit dem 12. Jahrhundert zunehmende Heiligenverehrung werden die christlichen Heiligennamen weiter verbreitet.“"
                            },
                            {
                                "example_id": "8ae00137-686c-4aef-94e2-89393bc28f18",
                                "sense_id": "5d4d7f54-c342-3172-9dfb-ab3fe841fec3",
                                "text": "„Die Lebensgeschichte des wohl berühmtesten Sufi-pirs Pakistans - Pir Sahib Pagaro aka. Sayyed Shah Mardan Shah II. (1928–2012), kurz auch Pir Pagaro VII. genannt - ist exemplarisch für die Verquickung von lokaler Heiligenverehrung, wadera-Mentalität und nationaler Parteipolitik.“"
                            },
                            {
                                "example_id": "43e7bf3f-bab3-4bb6-94f9-af95a276ca85",
                                "sense_id": "5d4d7f54-c342-3172-9dfb-ab3fe841fec3",
                                "text": "„Luther indessen waren Marienlied und Marienlob so wenig geheuer wie generell die Heiligenverehrung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
