                "translations": [
                    {
                        "translation_id": "57b1a332-4fea-41c0-9842-9e8e73b57408",
                        "source_entry_id": "262109e1-6646-3dc2-ad1d-e7f617f6403c",
                        "source_sense_id": "9eb517af-ccfc-34cf-a608-45e680c51cec",
                        "source_sense_description": "quality of being useless",
                        "target_lang_word": "inutilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inutilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "042377ba-cad5-38d2-8848-1c91c52d3bc2",
                                        "entry_id": "e885d625-5825-3a29-afe0-5db743f14080",
                                        "glosses": [
                                            "Défaut d’utilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31bb0164-2c88-4273-8221-226d8db97ad5",
                                                "sense_id": "042377ba-cad5-38d2-8848-1c91c52d3bc2",
                                                "text": "Il s’est aperçu de l’inutilité de ses visites."
                                            },
                                            {
                                                "example_id": "adeb14ea-86b3-4800-8f3a-5a92cf8d23a6",
                                                "sense_id": "042377ba-cad5-38d2-8848-1c91c52d3bc2",
                                                "text": "On a reconnu l’inutilité de cette machine."
                                            },
                                            {
                                                "example_id": "5632ce99-76d1-4670-82cf-a2ed0ee5eade",
                                                "sense_id": "042377ba-cad5-38d2-8848-1c91c52d3bc2",
                                                "text": "Que tu es drôle, Bernard, avec ta peur de la mort ! N’éprouves-tu jamais, comme moi, le sentiment profond de ton inutilité ? Non ? Ne penses-tu pas que la vie des gens de notre espèce ressemble déjà terriblement à la mort ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf8bedc5-5299-3e3d-97f2-fcd6a2792bfb",
                                        "entry_id": "e885d625-5825-3a29-afe0-5db743f14080",
                                        "glosses": [
                                            "Défaut d’emploi ou d’occasion de servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68cec208-9d72-4236-8a78-c98f66cfdddf",
                                                "sense_id": "bf8bedc5-5299-3e3d-97f2-fcd6a2792bfb",
                                                "text": "C’est un homme qu’on laisse dans l’inutilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                                        "entry_id": "e885d625-5825-3a29-afe0-5db743f14080",
                                        "glosses": [
                                            "Chose inutile ou superflue."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af0b6a7-0687-49d4-9c43-0b5e56ac67ab",
                                                "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                                                "text": "Un discours rempli d’inutilités."
                                            },
                                            {
                                                "example_id": "3ded4e60-7577-4e2d-9df8-6a314472aa93",
                                                "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                                                "text": "Cette femme ne s’occupe qu’à des inutilités."
                                            },
                                            {
                                                "example_id": "3484a925-0516-49c3-97d8-d03c75919c22",
                                                "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                                                "text": "Un Petit Dunkerque est une sorte de bazar de fines porcelaines et de curiosités artistiques, de charmantes et délicates inutilités , qui en font un bric-à-brac fashionable."
                                            },
                                            {
                                                "example_id": "a66588bc-ab4f-481c-9923-5723274274f2",
                                                "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                                                "text": "Mais c'était parce que M. de Norpois lui avait dit qu'il devrait me laisser entendre la Berma, que c'était pour un jeune homme un souvenir à garder, que mon père, jusque-là si hostile à ce que j'allasse perdre mon temps à risquer de prendre du mal pour ce qu'il appelait, au grand scandale de ma grand'mère, des inutilités, n'était plus loin de considérer cette soirée préconisée par l'Ambassadeur comme faisant vaguement partie d'un ensemble de recettes précieuses pour la réussite d'une brillante carrière."
                                            },
                                            {
                                                "example_id": "fa7dcc42-198a-46bd-8bcc-a24b2435a4e7",
                                                "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                                                "text": "Agacé de s'attarder à ces inutilités, M. Verdurin répliqua d'un ton pressé et avec un gémissement suraigu, non de chagrin, mais d'impatience irritée : « Hé bien oui, mais qu'est-ce que vous voulez, nous n'y pouvons rien, ce ne sont pas nos paroles qui le ressusciteront, n'est-ce pas ? »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d1ce5ef-e23e-4e18-8e55-56b6ccdc7041",
                        "source_entry_id": "262109e1-6646-3dc2-ad1d-e7f617f6403c",
                        "source_sense_id": "9eb517af-ccfc-34cf-a608-45e680c51cec",
                        "source_sense_description": "quality of being useless",
                        "target_lang_word": "Sinnlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sinnlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                        "entry_id": "cd027366-2f21-3623-b422-128c2ca0576b",
                                        "glosses": [
                                            "das Fehlen von Bedeutung; das Nichterfüllen eines Zwecks; die Eigenschaft sinnlos zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ccdf6ca-7b62-4b8b-a71b-981bfb8706bb",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "Der Frust über die Sinnlosigkeit der Aktion sorgte für Streit."
                                            },
                                            {
                                                "example_id": "65293b2d-2344-4355-9661-a172f112e6f4",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Angenommen, man sagt sich, daß alles sinnlos ist, dann kann es nicht ganz sinnlos sein, weil man sich bewußt ist, daß es sinnlos ist, und dieses Bewußtsein von Sinnlosigkeit gibt ihm fast einen Sinn.“"
                                            },
                                            {
                                                "example_id": "750c0734-e431-40a2-aae8-4c9833a74f87",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                                            },
                                            {
                                                "example_id": "44bcc05e-ef68-4cd7-8937-34d042060ff9",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Man kann hier natürlich sagen, das Tier sei zu töricht, um die Sinnlosigkeit seines Verfahrens einzusehen.“"
                                            },
                                            {
                                                "example_id": "81c660c1-d17e-4819-9d70-af95ae1a960f",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Drei schwarze Vögel verspotten ihn mit einem Lied auf die Sinnlosigkeit alles menschlichen Tuns.“"
                                            },
                                            {
                                                "example_id": "4da6c7fb-f664-40fb-80dd-14dc09822476",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Und es ist eine Sinnlosigkeit und ein Verbrechen wider die Natur und Kultur, wenn die westeuropäischen Emigranten nun durchaus in Landarbeiter umgewandelt werden sollen.“"
                                            },
                                            {
                                                "example_id": "7df88f5a-c3e3-40d7-b8c0-9b9fa70470ad",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Zur postmodernen Erfahrung gehört, mit der ständigen Produktion von Sinnlosigkeit fertig zu werden.“"
                                            },
                                            {
                                                "example_id": "31851dfb-f935-42fa-a3d7-192ed3d34ab2",
                                                "sense_id": "2e426681-fff5-3fd9-b4b1-4e6d67b4646c",
                                                "text": "„Es gibt diese Augenblicke, wo man in ein Loch der Sinnlosigkeit stürzt und überlegt, ob nicht alles vertan ist, ob das, was man macht, ein falscher Weg ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
