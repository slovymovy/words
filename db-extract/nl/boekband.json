                                        "sense_id": "729d21ed-b715-3da8-a02b-e2c9176d05fd",
                                        "entry_id": "c086d689-59cb-3546-b275-f971468c907a",
                                        "glosses": [
                                            "äußere Hülle eines Buches, bestehend aus Buchdeckel und Buchrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c8bbed-6d44-4134-90a0-0359a102f61d",
                                                "sense_id": "729d21ed-b715-3da8-a02b-e2c9176d05fd",
                                                "text": "Bucheinbände können aus festem oder flexiblem Material bestehen."
                                            }
