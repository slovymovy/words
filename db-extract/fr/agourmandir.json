                        "glosses": [
                            "Allécher, rendre gourmand."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "fd8f55a1-4e85-4e9a-b019-9995263cbc2e",
                                "sense_id": "808b09c9-19c8-3c94-9d0a-532b5c0f0375",
                                "text": "Il plisse les yeux, découvre largement ses gencives édentées : - « Tu veux agourmandir la souris, tu veux faire connaissance avec le Drah ! et la Revenante !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f699d839-8448-3a46-bd3a-3fe22b906df2",
                        "entry_id": "09a6c8d1-acd8-3444-b62e-f0df9ca68429",
                        "glosses": [
                            "Devenir gourmand, se régaler."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7274388e-dbd1-4c8d-a9b0-f1995c8d6105",
                                "sense_id": "f699d839-8448-3a46-bd3a-3fe22b906df2",
                                "text": "On doit y retourner sans doute ce week-end car les sangliers ont commencé à s'agourmandir dans le maïs mais il est possible que ce soit sans moi car il fait vraiment des températures insupportables pour les chiens sur le coup de 13h30-14h !!!"
                            }
                        ]
                    }
