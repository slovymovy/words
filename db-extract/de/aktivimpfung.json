                ],
                "senses": [
                    {
                        "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                        "entry_id": "4e629a35-ba52-3116-87e7-0c66d8762f4f",
                        "glosses": [
                            "Anregung des Immunsystems zur Bildung einer spezifischen Immunität durch die Gabe von Impfstoffen (=Vakzinen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13aa77bb-1e9c-469c-b9c5-4fac70330091",
                                "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                                "text": "Bei der Aktivimpfung baut das Immunsystem selbstständig Abwehrkräfte auf."
                            },
                            {
                                "example_id": "a40847af-d9b6-490b-a63d-a2e687125233",
                                "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                                "text": "Die Aktivimpfung schützt länger vor Krankheiten als die Passivimpfung."
                            },
                            {
                                "example_id": "d069b055-a3e2-4fe5-8a56-15cd975e2eab",
                                "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                                "text": "„Damit war bereits das Prinzip der Aktivimpfung entdeckt: Der bewusst und gezielt herbeigeführte Kontakt des gesunden Körpers mit einem Krankheitserreger schützt vor einer echten Infektion.“"
                            },
                            {
                                "example_id": "d858a99f-ae09-470f-9af3-ea04633d4f83",
                                "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                                "text": "„Viele Aktivimpfungen wirken erst richtig und über Jahre, wenn sie zwei oder dreimal durchgeführt wurden.“"
                            },
                            {
                                "example_id": "985c7b1a-259f-4411-a323-6d8293d7a8d6",
                                "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                                "text": "„Etwa 5% sonst gesunder Personen weisen – wahrscheinlich genetisch bedingt – keine ausreichende Immunantwort auf eine Aktivimpfung gegen HBV auf.“"
                            },
                            {
                                "example_id": "80aa495c-1df3-48dc-bc3e-6198402e5d6b",
                                "sense_id": "0a565e37-4391-3086-8f04-13819d4258f8",
                                "text": "„Bei Verletzungen sollte die Aktivimpfung aufgefrischt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
