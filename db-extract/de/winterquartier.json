                            {
                                "example_id": "b4c5b2dc-7711-43d2-a20b-897bef21e3a1",
                                "sense_id": "5876cc1d-5958-3b14-9f6e-d9456b95aaff",
                                "text": "„Kurz darauf gingen beide Parteien ins Winterquartier, und beide begannen zu bauen.“"
                            },
                            {
                                "example_id": "0627f38d-9936-4f68-bc83-9ac2ea85bbc5",
                                "sense_id": "5876cc1d-5958-3b14-9f6e-d9456b95aaff",
                                "text": "„Die Winterquartiere römischer Truppen betrachteten sie als unrechtmäßige Besetzung ihres Territoriums, sie versuchten, die Römer zu vertreiben.“"
                            }
                        ],
