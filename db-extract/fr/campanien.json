                        "sense_id": "8ec23db9-1780-3293-894b-14f6058b1c63",
                        "entry_id": "0eb5a608-9f42-36d6-aa34-104d725b0ced",
                        "glosses": [
                            "Relatif à la Campanie et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e80b80-946d-4e6f-a408-651d0fbb804b",
                                "sense_id": "8ec23db9-1780-3293-894b-14f6058b1c63",
                                "text": "[…] il insiste implicitement sur la prééminence de la Campagnie, ce qu’avait fait avant lui L. Breglia, qui affirmait nettement l’hégémonie de l’art campanien dans ce domaine."
                            },
                            {
                                "example_id": "29974919-112c-455e-aa28-7e99c78ae6b3",
                                "sense_id": "8ec23db9-1780-3293-894b-14f6058b1c63",
                                "text": "Elle était belle, … quand elle chantait lentement sa complainte campanienne et qu’on entendait sur le Tibre de longs refrains d’orgie."
                            }
                        ]
                    }
                ],
