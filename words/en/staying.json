                        "zh": "动词 stay 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставаться",
                                "target_lang_sense_clarification": "находиться на прежнем месте или в прежнем состоянии"
                            },
                            {
                                "target_lang_word": "останавливаться",
                                "target_lang_sense_clarification": "временно проживать где-либо (в отеле, у друзей)"
