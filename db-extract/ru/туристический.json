                    }
                ],
                "translations": [
                    {
                        "translation_id": "4268e619-8c6b-4279-a153-ae8dec16903f",
                        "source_entry_id": "587584b0-1f2b-37e4-905c-e8e6a98e12fe",
                        "source_sense_id": "14c7212e-a159-39fb-90eb-e3858b2a8ee5",
                        "target_lang_word": "touristisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touristisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                        "entry_id": "1c2b5d6a-d39d-385c-9d84-7c5c8d91554b",
                                        "glosses": [
                                            "auf den Tourismus bezogen, nach Art des Tourismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "754ab3d9-f1eb-498b-b29d-4bd52c5fcda7",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„Die BUGA ermöglicht Koblenz die Aufwertung seines städtischen Raums bei gleichzeitiger Steigerung des touristischen Potentials.“"
                                            },
                                            {
                                                "example_id": "f4e8a7e5-9232-4606-8a0c-2efe01d90b55",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„Den größten Anteil am touristischen CO₂-Fußabdruck macht die Luftfahrt aus, gefolgt von An- und Abreisen mit dem Privatauto.“"
                                            },
                                            {
                                                "example_id": "faed8f23-d94c-44fb-859f-2494dd3f985f",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„»Jede vierte Tonne CO₂, die Deutsche emittieren, ist touristisch.«“"
                                            },
                                            {
