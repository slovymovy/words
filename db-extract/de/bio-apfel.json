                        "glosses": [
                            "Apfel, der aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ae063b-de79-4dd9-82b9-f9b6877517d4",
                                "sense_id": "8a17ea3b-efc9-3655-ad1d-e737b72e0af5",
                                "text": "„Heute steckt sie Bio-Äpfel, frische Kräuter, Hafermilch und Heumilch-Butter in ihren Rucksack.“"
                            },
                            {
                                "example_id": "b00d901e-6a47-40cc-af2d-d9aed527a1dc",
                                "sense_id": "8a17ea3b-efc9-3655-ad1d-e737b72e0af5",
                                "text": "„Wenn wir Bio-Äpfel kaufen, kommen die vielleicht aus Neuseeland oder lagerten monatelang in deutschen Kühlhäusern und sind deshalb auch nicht klimafreundlich.“"
                            }
