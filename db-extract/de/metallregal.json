                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06097c0c-dfb7-4e17-beec-d4190a0f94a1",
                                "sense_id": "5ae06e33-5cf9-30eb-b417-98f9347d83b6",
                                "text": "„Es handelte sich um so etwas wie einen Geräteschuppen. Gestampfter Boden. Metallregale, darauf ein paar Blumentöpfe aus Plastik.“"
                            },
                            {
                                "example_id": "02028621-d47d-4dbd-875f-4f5cf7375a23",
                                "sense_id": "5ae06e33-5cf9-30eb-b417-98f9347d83b6",
                                "text": "„Hunderte von Taschenbüchern lagerten hier auf billigen Metallregalen und aufgestapelt auf dem Boden.“"
                            },
                            {
                                "example_id": "df42ec00-fa92-49ac-99af-b73c189b7dfd",
                                "sense_id": "5ae06e33-5cf9-30eb-b417-98f9347d83b6",
                                "text": "„Auf diesem Wg komme ich von hinten in den Zeitschriftenraum mit seinen zwei Dutzend Reihen blaugrauer Metallregale voll penibel geordneter, zerlesener juristischer Periodika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
