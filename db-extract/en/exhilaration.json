                    {
                        "translation_id": "e3dd670a-2a7b-4549-bff1-1f1e88de8d9e",
                        "source_entry_id": "00af5555-0750-31a0-87b5-84ecd3c4a6e1",
                        "source_sense_description": "the state of being enlivened, cheerful or exhilarated",
                        "target_lang_word": "Heiterkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiterkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                        "entry_id": "ed69b608-134e-3e17-8b08-b5c5bed4a816",
                                        "glosses": [
                                            "frohe, heitere, aufgelockerte Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a76224-4a71-4f0d-8032-57b2ffb218bb",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "Mit einem lustigen Witz trug er zur allgemeinen Heiterkeit bei."
                                            },
                                            {
                                                "example_id": "346d4350-f5a1-4464-9ae4-70e9e40d732c",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Die subversive Heiterkeit des künstlerischen Werkes von Yves Klein ist nur die Vorderseite seines hintergründigen Ernstes.“"
                                            },
                                            {
                                                "example_id": "cdebacbc-11df-481a-8d97-c7f5ce2e27f9",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„In unserer Runde hat er den Eindruck unerschöpflicher Vitalität und Lebensfreude vermittelt, sein freundliches Wesen, sein stiller Humor, seine Gelassenheit haben mich, der ich oft und schnell vom Gipfel der Heiterkeit ins Tal der Schwermut gleite, immer beschämt.“"
                                            },
                                            {
                                                "example_id": "f7608300-8cea-48ce-af37-02e62236c723",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Nach diesem Entschluß brachte mich Lias Heiterkeit um den Appetit.“"
                                            },
                                            {
                                                "example_id": "114b9851-2f06-4162-86bb-1bd1bb4071f4",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Dieser Sandersche Schmerzensschrei stellte die Heiterkeit wieder her, und unter Tappen und Tasten war man endlich bis in Nähe der Hoftür gekommen, wo, nach rechts hin, einige der Fässer weniger dicht nebeneinander lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc032275-d635-4cb2-bdbf-82090ca9da00",
                        "source_entry_id": "00af5555-0750-31a0-87b5-84ecd3c4a6e1",
                        "source_sense_description": "the state of being enlivened, cheerful or exhilarated",
                        "target_lang_word": "Euphorie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euphorie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                        "entry_id": "796f7160-6c59-3e0e-a215-917740857742",
                                        "glosses": [
                                            "ein begeisterter Gemütszustand der Lebensfreude, ein vorübergehendes gesteigertes gutes Lebensgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7815a60-4eb7-4776-b184-a0f7a2e8a5c9",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "Jetzt in Optimismus oder gar Euphorie auszubrechen, wäre falsch, doch vorsichtige Hoffnungen darf man erstmals hegen."
                                            },
                                            {
                                                "example_id": "f6741dc0-2dca-45aa-9260-92b3596ff67c",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Ich hätte nicht geglaubt, dass seine Euphorie so lange vorhalten würde.“"
                                            },
                                            {
                                                "example_id": "0638160e-b4f2-4313-b2b7-674cb706c36a",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Die europäische Presse versammelte ihre Korrespondenten in London, deren Berichte sich vor wissenschaftlicher Euphorie überschlugen.“"
                                            },
                                            {
                                                "example_id": "dc6653d6-6176-4b8d-8430-b1756ee8a067",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Wie war es möglich, daß die gesamte Bevölkerung übergangslos vom Zustand der Katatonie in den der Euphorie kippte?“"
                                            },
                                            {
                                                "example_id": "f5a26361-d6f3-4313-8ab5-cc18c86b16e5",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Eine Euphorie stellte sich ein, man kennt sie nach Fastenkuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebdaed40-1850-31e0-ba4c-2dcb4c5165a2",
                                        "entry_id": "796f7160-6c59-3e0e-a215-917740857742",
                                        "glosses": [
