                                    },
                                    {
                                        "sense_id": "66ae4697-502c-321f-8d3d-8db667a046d5",
                                        "entry_id": "d7e10e22-7239-3443-83d8-328b47f15639",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de proscrire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
