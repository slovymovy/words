                    {
                        "translation_id": "5ea728e2-488d-4be7-9655-df076195c827",
                        "source_entry_id": "5eda2cb4-c119-35d0-af4c-dca042ff720f",
                        "target_lang_word": "melodiös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melodiös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64bc2283-2ac2-310b-966f-c8d1383a86d1",
                                        "entry_id": "1cac1cc8-ceb8-3f88-8ba6-e9e6497cf1d4",
                                        "glosses": [
                                            "in der Art einer Melodie klingend, angenehm klingend"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5060484c-d18c-46ec-8226-72357e6027a6",
                                                "sense_id": "64bc2283-2ac2-310b-966f-c8d1383a86d1",
                                                "text": "„Die Sonate IV B-Dur op.65/4 von Mendelssohn erklang farbig, melodiös und sehr gefällig.“"
                                            },
                                            {
                                                "example_id": "269c8660-63ab-492f-b716-63f48a5ad846",
                                                "sense_id": "64bc2283-2ac2-310b-966f-c8d1383a86d1",
                                                "text": "„Apropos Melodik: Eigentlich ist Marc Anthony ein typischer Vertreter des puerto-ricanischen Salsa, der ‚weissesten‘ (Puerto Rico betrieb kaum Sklaverei) und melodiösesten Form des Genres.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be993707-3aa5-41e8-9889-de75ee1ac420",
                        "source_entry_id": "5eda2cb4-c119-35d0-af4c-dca042ff720f",
                        "target_lang_word": "melodious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melodious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "894e63f1-47fd-3710-bcb4-8da9df6876dc",
                                        "entry_id": "a9f89374-47f4-3dda-b4df-47d4199ec4c0",
                                        "glosses": [
                                            "Having a pleasant melody or sound; tuneful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c429f202-9264-42d0-bdb4-0597a3db0cc6",
                                                "sense_id": "894e63f1-47fd-3710-bcb4-8da9df6876dc",
                                                "text": "Tremulous on the bladed graſs ſhone bright the pearly drops, like an aſſembly of ſparkling ſtars dancing on the plains of the zodiac; vocal was every bending ſpray, every reed was inſpired, each warbling throat ſeemed to emulate the melodious voice of the bird of a thouſand ſongs."
                                            },
                                            {
                                                "example_id": "5bd146f0-df28-4ae7-8ac4-3af926ee7c64",
                                                "sense_id": "894e63f1-47fd-3710-bcb4-8da9df6876dc",
                                                "text": "A lovely crisp exhaust: a feeling of almost unlimited power combined with complete freedom of running: and, to crown it all, a most melodious and wholly American chime whistle—these were my immediate impressions as we stormed rapidly out of Göttingen, intent on winning back some of the lost time."
                                            },
                                            {
                                                "example_id": "184f5fbe-161c-4dcb-b101-71a9b7219de7",
                                                "sense_id": "894e63f1-47fd-3710-bcb4-8da9df6876dc",
                                                "text": "Patinkin’s melodious voice is a natural fit for animation, and he breathes just the right type of upper-crust life into Hugh in 22 short minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5b4af6b-bc35-44c3-8d0a-b5881f116984",
                        "source_entry_id": "5eda2cb4-c119-35d0-af4c-dca042ff720f",
                        "target_lang_word": "tuneful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
