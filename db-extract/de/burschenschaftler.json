                        "examples": [
                            {
                                "example_id": "30bfb20b-3a1f-479a-802f-7c07a07892ac",
                                "sense_id": "d7171ecc-bfb4-31c0-9583-ac143b90ab55",
                                "text": "„Am Gedenkplatz zur Erinnerung an die Bücherverbrennungen hatten am 15. Mai 1933 NS-Studentenorganisationen und Burschenschaftler Bücher von \"schädlichen und unerwünschten\" Schriftstellern verbrannt.“"
                            },
                            {
                                "example_id": "c114db84-9c3b-4a30-a893-909489d007d8",
                                "sense_id": "d7171ecc-bfb4-31c0-9583-ac143b90ab55",
                                "text": "Am 6. Juli 1938 wurden die zu dieser Zeit letzten bestehenden Korporationsverbände von Burschenschaftlern durch Heinrich Himmler verboten, gleiches folgte später in den einverleibten Gebieten. Zu diesem Zeitpunkt existieren nur noch 4 Buschenschaften in Chile."
                            }
                        ],
