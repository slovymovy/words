                    "sense_definition": "The act of causing persistent annoyance or harassment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>plaguing</w> by his peers made him want to change schools.",
                            "target_lang_translations": {
                                "tr": "Emsallerinin sürekli <w>taciz etmesi</w> okul değiştirmek istemesine neden oldu."
                            }
                        },
                        {
                            "text": "Despite the constant <w>plaguing</w> from her older brother, she stayed calm.",
                            "target_lang_translations": {
                                "tr": "Ağabeyinin sürekli <w>rahatsız etmesine</w> rağmen sakin kaldı."
                            }
