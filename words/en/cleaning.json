                {
                    "sense_id": "cc5dab81-ef58-3c61-81c3-06a8798f9485",
                    "sense_definition": "The afterbirth of cows, ewes, or other animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer waited to ensure the cow expelled the <w>cleaning</w> naturally.",
                            "target_lang_translations": {
                                "ru": "Фермер ждал, чтобы убедиться, что у коровы естественно вышел <w>послед</w>.",
                                "zh": "农夫等着以确保母牛自然地排出了<w>胎衣</w>。"
                            }
                        },
                        {
                            "text": "Veterinary help was called because the ewe retained its <w>cleaning</w> after giving birth.",
                            "target_lang_translations": {
                                "ru": "Пришлось вызвать ветеринара, так как у овцы после родов задержался <w>послед</w>.",
                                "zh": "因为母羊分娩后滞留了<w>胎衣</w>，所以叫了兽医来帮忙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afterbirth",
                        "placenta"
                    ],
                    "target_lang_definitions": {
                        "ru": "Послед у коров, овец или других животных.",
                        "zh": "母牛、母羊或其他动物分娩后的胎盘。"
