    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "efda6316-aff9-3c60-961c-c74e59a36530",
                "word": "rainforest",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7cabf0a6-059c-4e5a-9463-c7e227bd7b18",
                        "entry_id": "efda6316-aff9-3c60-961c-c74e59a36530",
                        "tags": [
                            "plural"
                        ],
                        "form": "rainforests"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                        "entry_id": "efda6316-aff9-3c60-961c-c74e59a36530",
                        "glosses": [
                            "A forest in a climate with high annual rainfall and no dry season."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c859e80c-9955-4975-a550-d948de51db25",
                                "sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                                "text": "Perhaps the most impressive expression of species diversity is the density of species found in a given area of rainforest."
                            },
                            {
                                "example_id": "3093e009-1efe-44c6-8f34-cd8d384efcf7",
                                "sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                                "text": "Tropical rainforests in Australia have suffered a fate similar in many ways to that of rainforests elsewhere in the world, but considerable progress in safeguarding the future of what remains has been made."
                            },
                            {
                                "example_id": "57a67fe4-ab04-4c5b-a943-b997b9d2f55c",
                                "sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                                "text": "Enjoy your visit to the rainforests, because the next time you go there things could be very different."
                            },
                            {
                                "example_id": "c32d26cd-08ce-42c4-8410-89018865deb7",
                                "sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                                "text": "Some researchers worry that rainforests will soon reach a tipping point — a point of no return in which the once-lush forests transition to arid regions."
                            },
                            {
                                "example_id": "2156274f-1008-49b1-99db-b2b3123631e7",
                                "sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                                "text": "The Sentinelese hunt in the rainforest and fish in the coastal waters using spears, bows and arrows, as well as homemade narrow outrigger canoes, according to Survival International."
                            }
                        ]
                    }
                ],
                "translations": [
