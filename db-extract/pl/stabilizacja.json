                    {
                        "sense_id": "858d9dee-ed9e-3ee4-90f1-4e9f6eab6b44",
                        "entry_id": "54b2fb6e-c07f-33b4-8051-0643f782cd2a",
                        "glosses": [
                            "stan trwałości i równowagi w przebiegu określonych procesów, w określonej dziedzinie życia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f98adba-f2db-41e4-8caf-7db294fdb3f0",
                                "sense_id": "858d9dee-ed9e-3ee4-90f1-4e9f6eab6b44",
                                "text": "Ponadto stała para ślubna czy nieślubna zwykle ma konkretne plany, dotyczące przyszłości i stabilizacji życia we dwoje, w związku z czym zależy im na możliwie jak najszybszym ukończeniu studiów i stworzeniu sobie własnego domu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
