                        "form": "katalizatory"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f581a8ca-1b6f-378b-b161-d18558491fcc",
                        "entry_id": "10bd81d5-80c8-385d-af0e-5df14716402a",
                        "glosses": [
                            "substancja przyspieszająca przebieg reakcji chemicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5e3eb5f-b94e-4eee-a131-397eb428cc09",
                                "sense_id": "f581a8ca-1b6f-378b-b161-d18558491fcc",
                                "text": "Do butelki został nalany perhydrol, do niego płyn do mycia naczyń. Teraz dodajemy katalizator, dwuchromian potasu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a25de347-9c08-36b7-b3ed-24db67939ace",
                        "entry_id": "10bd81d5-80c8-385d-af0e-5df14716402a",
                        "glosses": [
                            "urządzenie zawierające katalizator (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ab94f0-4688-42b0-b16f-fb9ce9b4548b",
                                "sense_id": "a25de347-9c08-36b7-b3ed-24db67939ace",
                                "text": "Muszę wymienić w samochodzie katalizator na nowy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "529859e0-022c-3a61-a310-fd06d2febe69",
                        "entry_id": "10bd81d5-80c8-385d-af0e-5df14716402a",
                        "glosses": [
                            "czynnik będący przyczyną czegoś, przyśpieszający coś"
                        ],
                        "tags": [
                            "literary",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "a62d5830-b1f5-4894-bb8e-838ce2c45a1f",
                                "sense_id": "529859e0-022c-3a61-a310-fd06d2febe69",
                                "text": "Nikt nie przewidział sukcesu Internetu i telefonii komórkowej, nikt też nie przewidział głębokości społecznych zmian, których katalizatorem stały się nowe technologie komunikacyjne."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49744fe0-589c-4d39-aad7-d27929a84bba",
                        "source_entry_id": "10bd81d5-80c8-385d-af0e-5df14716402a",
                        "source_sense_id": "f581a8ca-1b6f-378b-b161-d18558491fcc",
                        "target_lang_word": "catalyst",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catalyst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7084389e-117f-3ece-9bcc-c5550694b398",
                                        "entry_id": "8622aa95-2bdd-3a03-841b-c2b61efaf29a",
                                        "glosses": [
                                            "A substance that increases the rate of a chemical reaction without being consumed in the process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257ab2f9-8945-4ab6-bfd1-34ea6f0a6bbe",
                                                "sense_id": "7084389e-117f-3ece-9bcc-c5550694b398",
                                                "text": "Enzymes, the catalysts of biological systems, are remarkable molecular devices that determine the pattern of chemical transformations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                        "entry_id": "8622aa95-2bdd-3a03-841b-c2b61efaf29a",
                                        "glosses": [
                                            "Something that encourages progress or change."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74914cef-7010-4777-b624-58cce8a26c3b",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "Economic development and integration are working as a catalyst for peace."
                                            },
                                            {
                                                "example_id": "1167b004-cca1-44cc-a4d5-973abd061fe5",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "It was a morning baptized by my first cup of coffee, freshly brewed over a gravel-bar fire, while they celebrated with the stronger catalyst of sour-mash whiskey in their fishing-vest cups."
                                            },
                                            {
                                                "example_id": "c09e747b-1e76-4b2b-87c9-94abddc9dc20",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "Israel's fear for the reactor—rather than Egypt's of it—was the greater catalyst for war."
                                            },
                                            {
                                                "example_id": "b0bbc392-a6ce-4baa-9472-f92a65312cf4",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "Rosa Parks was a true catalyst for change and she was only one person. Hearing about Rosa Parks and her protest showed me that there is hope for me and all the students in Ms. G's classes to truly be catalysts for change."
                                            },
                                            {
                                                "example_id": "e16c3af8-da7e-4278-9b4a-240d82dfbb37",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "He [countertenor Anthony Roth Constanzo] also enjoys being the catalyst whereby opera fertilises other art forms: recently, he's collaborated with Japanese kabuki actors, and a project with dancers from New York City Ballet is in the offing."
                                            },
                                            {
                                                "example_id": "66cd9305-30f9-45a4-b0a6-860c0c715342",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "The catalyst was the introduction of the Health & Safety at Work Act in 1974. While it applied to all workplaces, it gradually brought about a sea change in the attitude towards death and injury. Accidents were no longer accepted as 'inevitable'."
                                            },
                                            {
                                                "example_id": "1cc6badc-de91-4d9d-9318-f11f02996bfb",
                                                "sense_id": "0af48cd0-0d85-358a-8e71-66e6d74c32cc",
                                                "text": "The housing crisis is now a “catalyst” for anti-immigrant sentiment, an Irish parliamentary committee warned in November."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0474ac-9501-338e-9f2a-47e01e997aa1",
                                        "entry_id": "8622aa95-2bdd-3a03-841b-c2b61efaf29a",
                                        "glosses": [
                                            "An inciting incident that sets the successive conflict into motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb5d066-ff8a-4728-8a86-5cb0087056e0",
                                                "sense_id": "ba0474ac-9501-338e-9f2a-47e01e997aa1",
                                                "text": "The current view by both Labour and Conservative politicians is that the state of the UK railway is unsustainable, and the pandemic acted as a catalyst in exposing its weaknesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8acaf34a-b5f9-36c8-aadd-cd126b38456b",
                                        "entry_id": "8622aa95-2bdd-3a03-841b-c2b61efaf29a",
                                        "glosses": [
                                            "A catalytic converter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be504ff4-5d02-3736-ba70-cdc23ccfee78",
                                        "entry_id": "8622aa95-2bdd-3a03-841b-c2b61efaf29a",
                                        "glosses": [
                                            "An object that facilitates the casting of a spell (such as a magic wand)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
