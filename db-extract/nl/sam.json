                        "examples": [
                            {
                                "example_id": "228c2af2-23e1-4790-8afd-9ca4db48594e",
                                "sense_id": "f1c7997f-8ecc-323c-8299-5dfaccda24f9",
                                "text": "Een fontein van rijst, witte regen op de lachende gezichten van Sam en Cynth, op de trap van het gemeentehuis, met hun twee handen samen in de lucht, terwijl de korrels als een waterval op hen neerdalen. Wat trouwen betrof had Cynth in elk geval gezegevierd."
                            },
                            {
                                "example_id": "370630e1-3106-40df-9157-e591d6bcec76",
                                "sense_id": "f1c7997f-8ecc-323c-8299-5dfaccda24f9",
                                "text": "Samen met commandant Frank Schubert, een 47-jarige architect en componist ('Serieus, ik ben verre familie van Franz'), werkt Sam aan een uniek muziekproject: via e-mail staat de Marsbemanning in contact met een aantal musici over de hele wereld, onder wie Elton John."
                            }
                        ]
                    }
