                                "target_senses": [
                                    {
                                        "sense_id": "3fb5650a-9c27-3818-aa4e-a2481cb5e56e",
                                        "entry_id": "15645c05-27a8-303d-aca4-f4c012dc8b4b",
                                        "glosses": [
                                            "Incapable of being reversed or turned about or back; incapable of being made to run backwards."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57be1d4e-41dc-4715-8844-0b99db8c0a6c",
                                                "sense_id": "3fb5650a-9c27-3818-aa4e-a2481cb5e56e",
                                                "text": "an irreversible engine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f658f24-297e-3750-aedd-a936b455c919",
                                        "entry_id": "15645c05-27a8-303d-aca4-f4c012dc8b4b",
                                        "glosses": [
                                            "Incapable of being reversed, recalled, repealed, or annulled."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50fb6331-ca6d-41e8-8d55-1858efadf0bb",
                                                "sense_id": "6f658f24-297e-3750-aedd-a936b455c919",
                                                "text": "an irreversible sentence or decree"
                                            },
                                            {
                                                "example_id": "fbeede5b-113b-4a16-b2a6-b74d0a53f2a3",
                                                "sense_id": "6f658f24-297e-3750-aedd-a936b455c919",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death."
                                            },
                                            {
                                                "example_id": "5346c329-c513-4eaf-bc77-04863c33085d",
                                                "sense_id": "6f658f24-297e-3750-aedd-a936b455c919",
                                                "text": "“Even under a variety of policies, including plastic product reduction, waste management, and environmental recycling, microplastic pollution is irreversible and escalating.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690bc23d-e452-3f09-9649-72013f7af62d",
                                        "entry_id": "15645c05-27a8-303d-aca4-f4c012dc8b4b",
                                        "glosses": [
                                            "Incapable of being reversed to the original state without consumption of free energy and increase of entropy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
