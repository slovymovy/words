                                        "entry_id": "b9abb50f-9561-3769-a4e6-14af13bb8a81",
                                        "glosses": [
                                            "etwas zur Gänze befüllen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c85dbd-f932-44f0-981c-19c8f3d81c2b",
                                                "sense_id": "b9e12dd0-7168-3db2-a548-0271b507f3fe",
                                                "text": "Am Abend vor der Abreise stopfte seine Ehefrau ihren Koffer voll."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "969cfd66-cbff-3e14-8d7c-0fbd02d839af",
                                        "entry_id": "b9abb50f-9561-3769-a4e6-14af13bb8a81",
                                        "glosses": [
                                            "sehr viel, sehr schnell essen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c521aa-a40f-4d78-bc18-1abb3545f42f",
                                                "sense_id": "969cfd66-cbff-3e14-8d7c-0fbd02d839af",
                                                "text": "In der Mittagspause stopft der Chef sich immer mit Burgern voll."
                                            },
                                            {
                                                "example_id": "86e6f166-6ed1-4eb2-8c82-11c59343c295",
                                                "sense_id": "969cfd66-cbff-3e14-8d7c-0fbd02d839af",
                                                "text": "„Aber die Leute beschließen nicht einfach ohne jeden Grund, sich mit Drogen vollzustopfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "182fcadd-fe17-46b2-8942-82926c44e5d9",
                        "source_entry_id": "a2766d6c-cdb7-3d09-bd16-661849a37c03",
                        "source_sense_id": "f967481f-2b96-3773-be92-16d9e33d93b9",
                        "source_sense_description": "etwas bis zum Übermaß füllen",
                        "target_lang_word": "zusammendrängen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusammendrängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7cf954-008f-3001-8d6e-17604e48af37",
                                        "entry_id": "80c77a7d-bdbf-3fd2-bead-7f8447dd595a",
                                        "glosses": [
                                            "eng zusammendrücken, so dass Personen/Tiere oder Dinge weniger Platz einnehmen"
                                        ],
                                        "tags": [
                                            "auch reflexiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e142d7e4-24b6-4437-9f1c-5ac4c34e40f6",
                                                "sense_id": "5e7cf954-008f-3001-8d6e-17604e48af37",
                                                "text": "Die Hütehunde haben die Schafherde zusammengedrängt."
                                            },
                                            {
                                                "example_id": "3875bb97-ca59-4e21-a2fb-611bd226ef3d",
                                                "sense_id": "5e7cf954-008f-3001-8d6e-17604e48af37",
                                                "text": "Die Katzenbabys drängten sich dicht um die Mutter zusammen."
                                            },
                                            {
                                                "example_id": "d41fae93-ce52-41a9-ba9e-45220e2046b8",
                                                "sense_id": "5e7cf954-008f-3001-8d6e-17604e48af37",
                                                "text": "Wo der Fluss sich am engsten zusammendrängt, steigen hoch und schroff zu beiden Seiten Felswände empor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b300d9e6-0a5a-387a-846a-cd8a762e1b81",
                                        "entry_id": "80c77a7d-bdbf-3fd2-bead-7f8447dd595a",
                                        "glosses": [
                                            "in wenige Worte fassen, auf den Punkt bringen"
                                        ],
                                        "tags": [
                                            "auch reflexiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca4fe7c-4a71-41fe-b353-39822745afb7",
                                                "sense_id": "b300d9e6-0a5a-387a-846a-cd8a762e1b81",
                                                "text": "Ich versuche mal, das Ergebnis in wenige Worte zusammenzudrängen."
                                            },
                                            {
                                                "example_id": "2ccdefcf-becd-467d-b63d-f3df4306b0b3",
                                                "sense_id": "b300d9e6-0a5a-387a-846a-cd8a762e1b81",
                                                "text": "Die These drängt sich letztlich auf ein einziges Hauptargument zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "882c3610-9f84-47a1-a184-9da4eaedc0d0",
                        "source_entry_id": "a2766d6c-cdb7-3d09-bd16-661849a37c03",
                        "source_sense_id": "0c3573ba-d232-3994-b9b6-c0cd6c96d28b",
                        "source_sense_description": "unnatürlich viel Blut oder andere Flüssigkeit sammelt sich an einer Stelle im Körper an",
                        "target_lang_word": "anhäufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anhäufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7df162ab-29ae-3b9f-9f25-82b142c1eab8",
                                        "entry_id": "00715083-d331-3825-b0eb-74d734aa4c84",
                                        "glosses": [
                                            "etwas in großen Mengen sammeln"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3a83ca-8a1a-4e30-843d-a21b00570cb6",
                                                "sense_id": "7df162ab-29ae-3b9f-9f25-82b142c1eab8",
                                                "text": "Er häuft massenweise Antiquitäten an, verkauft aber so gut wie nichts."
                                            },
                                            {
                                                "example_id": "41c62dbc-7156-4932-952d-660126a14022",
                                                "sense_id": "7df162ab-29ae-3b9f-9f25-82b142c1eab8",
                                                "text": "„Mehr als 370 Mrd. Dollar Währungsreserven hat Brasilien angehäuft.“"
                                            },
                                            {
                                                "example_id": "1073c9c6-ccfc-498d-b20a-aa2ca7e06bba",
                                                "sense_id": "7df162ab-29ae-3b9f-9f25-82b142c1eab8",
                                                "text": "„Es häufen sich immer mehr verfälschte Definitionen im Internet an, wodurch beispielsweise der Begriff Aquaterrarium mit Paludarium gleichgestellt wird.“"
                                            },
                                            {
                                                "example_id": "77c7fce2-482e-4e54-bcc1-f9d7437fdea6",
                                                "sense_id": "7df162ab-29ae-3b9f-9f25-82b142c1eab8",
                                                "text": "„97 Prozent der Klimaforschenden sagen, die Krise sei menschengemacht. Sie haben Beweise angehäuft, die diese These stützen.“"
                                            },
                                            {
                                                "example_id": "64df7281-57c9-4f9d-9c46-08554f3908b3",
                                                "sense_id": "7df162ab-29ae-3b9f-9f25-82b142c1eab8",
                                                "text": "„Das reichste Prozent der Weltbevölkerung hat 2020 und 2021 rund 63 Prozent des neu erworbenen Vermögens angehäuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4b80449-31c3-3a00-ba72-d159c1135fb2",
                                        "entry_id": "00715083-d331-3825-b0eb-74d734aa4c84",
                                        "glosses": [
                                            "sich ansammeln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f57ebfa-fe13-4e86-b51a-f650b10ac76c",
                                                "sense_id": "b4b80449-31c3-3a00-ba72-d159c1135fb2",
                                                "text": "Der Müll häuft sich immer mehr an. Wir sollten dringend sauber machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b0d4668-e5ef-4e61-9e98-564fcf0f1fed",
                        "source_entry_id": "a2766d6c-cdb7-3d09-bd16-661849a37c03",
                        "source_sense_id": "0c3573ba-d232-3994-b9b6-c0cd6c96d28b",
                        "source_sense_description": "unnatürlich viel Blut oder andere Flüssigkeit sammelt sich an einer Stelle im Körper an",
                        "target_lang_word": "anstauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anstauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d14a13-681e-3f7e-8d14-78dcee50e975",
                                        "entry_id": "b9ebf53a-0832-3a15-8270-b4807d647866",
                                        "glosses": [
                                            "etwas am Abfließen oder Abtransport hindern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c18ef58-687b-448d-8c57-bc10d9c4ff3a",
                                                "sense_id": "a0d14a13-681e-3f7e-8d14-78dcee50e975",
                                                "text": "Auf einer Fläche von etwa 250 mal 100 Metern bauten die Biber - vermutlich ein Elternpaar mit drei bis vier Jungen - in den vergangenen Jahren mehrere imposante Dämme, mit denen sie den dort verlaufenden Bach anstauten."
                                            },
                                            {
                                                "example_id": "b619c25f-cd7f-4829-b81a-be0038f85392",
                                                "sense_id": "a0d14a13-681e-3f7e-8d14-78dcee50e975",
                                                "text": "Seit der Biber den Bach regelmäßig anstaut, gibt es Probleme mit den Drainagen."
                                            },
                                            {
                                                "example_id": "126c86b9-ae5c-4ad8-b75e-dad799903437",
                                                "sense_id": "a0d14a13-681e-3f7e-8d14-78dcee50e975",
                                                "text": "Man staut dann das Wasser höher an und läßt es rasch abfließen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7f1cdb4-3115-3e24-90f1-4c4f51c9691f",
                                        "entry_id": "b9ebf53a-0832-3a15-8270-b4807d647866",
                                        "glosses": [
                                            "sich verstärkt ansammeln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3091d304-be28-4f46-b44f-0168c955e9bc",
                                                "sense_id": "f7f1cdb4-3115-3e24-90f1-4c4f51c9691f",
                                                "text": "Oft überschütten wir einen Menschen mit dem Ärger, der gar nicht ihm gilt, sondern der sich in uns angestaut hat."
                                            },
                                            {
                                                "example_id": "1a4e0053-fd2a-4e18-ab42-bf772cbff598",
                                                "sense_id": "f7f1cdb4-3115-3e24-90f1-4c4f51c9691f",
                                                "text": "Hinter ihnen haben sich ein paar Autos angestaut, und der Unwille der Fahrer bohrt sich wie Xenon-Scheinwerfer in Ginas Rücken."
                                            },
                                            {
                                                "example_id": "4376f80f-b544-4334-af1b-780c456c18c4",
                                                "sense_id": "f7f1cdb4-3115-3e24-90f1-4c4f51c9691f",
                                                "text": "Die hohe Scheidungsanstieg hat zwei Gründe. Einerseits haben sich während der geschlossenen Ämter viele Fälle angestaut, die in den vergangenen Wochen nicht bearbeitet werden konnten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
