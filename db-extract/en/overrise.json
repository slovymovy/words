                        ],
                        "examples": [
                            {
                                "example_id": "6eca0720-98c7-456f-8a67-5ec26d6dc013",
                                "sense_id": "020cda05-e601-39ec-bef6-a10982b4ecf0",
                                "text": "In high-altitude baking, you don't want as tender a cake because it will overrise, so be wary of cakes with a lot of added sugar and oil."
                            },
                            {
                                "example_id": "710da8e8-ae7d-426d-8a27-a096aa3df99e",
                                "sense_id": "020cda05-e601-39ec-bef6-a10982b4ecf0",
                                "text": "Be careful not to overrise the dough—it might collapse upon being places in a hot oven; […]"
                            },
                            {
                                "example_id": "b5fe9cc3-3923-4e54-814b-8bc31cef4a05",
                                "sense_id": "020cda05-e601-39ec-bef6-a10982b4ecf0",
                                "text": "The second rise is what gives the dough its final structure. It's especially important not to let the dough overrise, or your bread may be flat and dense."
                            }
                        ]
                    }
