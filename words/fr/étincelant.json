    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                    "sense_definition": "Qui brille d'un éclat vif et intermittent, qui jette des étincelles de lumière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eclat_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La neige fraîche était <w>étincelante</w> sous les premiers rayons du soleil d'hiver.",
                            "target_lang_translations": {
                                "en": "The fresh snow was <w>sparkling</w> under the first rays of the winter sun.",
                                "ru": "Свежий снег <w>сверкал</w> под первыми лучами зимнего солнца.",
                                "de": "Der frische Schnee lag unter den ersten Strahlen der Wintersonne <w>funkelnd</w> da.",
                                "es": "La nieve fresca estaba <w>resplandeciente</w> bajo los primeros rayos del sol de invierno.",
                                "zh": "新雪在冬日的第一缕阳光下<w>闪亮</w>。"
                            }
                        },
                        {
                            "text": "Elle portait pour la soirée une robe <w>étincelante</w> ornée de perles et de sequins.",
                            "target_lang_translations": {
                                "en": "For the evening she wore a <w>sparkling</w> dress adorned with pearls and sequins.",
                                "ru": "На вечер она надела <w>сверкающее</w> платье, расшитое жемчугом и пайетками.",
                                "de": "Für den Abend trug sie ein <w>glitzerndes</w> Kleid, verziert mit Perlen und Pailletten.",
                                "es": "Para la velada, ella llevaba un vestido <w>brillante</w> adornado con perlas y lentejuelas.",
                                "zh": "她晚上穿了一条缀满珍珠和亮片的<w>闪亮</w>长裙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brillant",
                        "scintillant"
                    ],
                    "common_phrases": [
                        "lumière étincelante"
                    ],
                    "target_lang_definitions": {
                        "en": "Shining with bright, intermittent flashes of light.",
                        "ru": "Испускающий яркие, прерывистые вспышки света.",
                        "de": "Mit hellen, wechselnden Lichtblitzen glänzend.",
                        "es": "Que brilla con destellos vivos e intermitentes.",
                        "zh": "发出明亮而断续的光芒，闪烁不定。"
                    },
                    "translations": {
