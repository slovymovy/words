                                "sense_id": "fb387b97-9bfd-3dcc-896f-fbe6a85fab21",
                                "text": "„Die cultuur wordt gekarakteriseerd door een beaming van het leven, omdat het anders niet uit te houden zou zijn."
                            },
                            {
                                "example_id": "e94c5200-04c4-4cdd-873f-1e6ca8314b99",
                                "sense_id": "fb387b97-9bfd-3dcc-896f-fbe6a85fab21",
                                "text": "Torfs: 'Ik vind het zelfs een beaming van wat het leven is. De keuzes die mensen maken in het leven zijn meestal ook mossel noch vis. Zij maken ook compromissen.'"
                            }
                        ]
                    }
