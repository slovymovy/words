                                "target_senses": [
                                    {
                                        "sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                                        "entry_id": "c8d37c77-45d2-346a-bc43-1d6294e0d276",
                                        "glosses": [
                                            "met bergen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664fd8e5-0ce4-4553-ad26-6854023632a8",
                                                "sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                                                "text": "In Zwitserland zijn veel bergachtige streken"
                                            },
                                            {
                                                "example_id": "7de86b03-1895-479b-a28d-b16f6071283d",
                                                "sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                                                "text": "Opgelucht trok ik de volgende ochtend de moteldeur achter me dicht, de frisse lucht in, met mijn rugzak vol eten voor de komende zes dagen. Het terrein werd bergachtiger en de trail steeds steiler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "917dc894-2796-4528-8bf1-7c982f8daa9a",
                        "source_entry_id": "0b2d7c4c-ba10-316a-912c-28d4bad4746d",
                        "source_sense_description": "having many mountains",
                        "target_lang_word": "montagneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "montagneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cdeecf5-a524-35fc-a1c1-58ebe523a324",
                                        "entry_id": "30f232e5-ace3-381d-9c8a-0905633187a6",
                                        "glosses": [
                                            "Où il y a beaucoup de montagnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d643a6c7-dc2f-465e-b887-1f613592a6ff",
                                                "sense_id": "4cdeecf5-a524-35fc-a1c1-58ebe523a324",
                                                "text": "Les reliefs se dressent en puissants massifs ou encore constituent des systèmes montagneux très digités qui cloisonnent des petites pénéplaines. Aussi le paysage qui s'offre à la vue est-il toujours limité à l'horizon par des reliefs plus ou moins vigoureux."
                                            },
                                            {
                                                "example_id": "bf13c03e-96bd-422c-a8a6-688f8be60f51",
                                                "sense_id": "4cdeecf5-a524-35fc-a1c1-58ebe523a324",
                                                "text": "La structure du relief est bien conservée, les vastes vallées du bassin lacustre se trouvent pour la plupart à une altitude de 4400-4700 m, composant une surface complète de plateau et le niveau de base de l'érosion des régions montagneuses et des collines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0d1bf4-0119-3834-832d-45b0ec95f977",
                                        "entry_id": "30f232e5-ace3-381d-9c8a-0905633187a6",
                                        "glosses": [
                                            "Constitué de montagnes ; qui fait partie de la montagne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "211338ef-8957-3414-9f4e-8b8e78a5a8d5",
                                        "entry_id": "30f232e5-ace3-381d-9c8a-0905633187a6",
                                        "glosses": [
                                            "Qui ressemble à une montagne, qui évoque des montagnes."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e83eb73-fc3e-46b3-be2c-e5fec61032ad",
                        "source_entry_id": "0b2d7c4c-ba10-316a-912c-28d4bad4746d",
                        "source_sense_description": "having many mountains",
                        "target_lang_word": "bergig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bergig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                        "entry_id": "4658ceae-a60b-3be3-8a2a-85d749de2efd",
                                        "glosses": [
                                            "aus vielen Bergen oder Hügeln bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70198647-0fa6-47e2-8c43-8e6be725c95b",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "Gerade waren wir in Zentralchile gestrandet, immerhin die Hauptstadtregion, und bergig dazu."
                                            },
                                            {
                                                "example_id": "8b3987cf-3208-42c4-a55b-2965dd9224b6",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "Der Niederösterreicher Bernhard Kohl bot auf den bergigen Etappen eine starke Leistung, für einen Platz ganz vorne reichte es für den ÖRV-Staatsmeister aber nicht."
                                            },
                                            {
                                                "example_id": "2fea899e-5b50-4c97-abed-1a85e424a4e7",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "Den Absturz eines Charterflugzeugs im bergigen Süden Kambodschas vor zwei Tagen hat keiner der 22 Menschen an Bord überlebt."
                                            },
                                            {
                                                "example_id": "64c2aac6-942b-402d-bd97-4457d3e97b7b",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "»Ist die dortige Gegend eben oder bergig?«"
                                            },
                                            {
                                                "example_id": "e3e92510-a1e3-408a-b9f5-00f27948c368",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "„Von der Scala bis Radicosani ist der Weg bergig und schwierig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
