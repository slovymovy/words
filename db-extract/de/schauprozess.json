                        "sense_id": "905a7cc6-6fa9-39d5-a9f4-c9865c3cdfbb",
                        "entry_id": "2d61891c-84b8-35fd-9a03-e7932d22b6b9",
                        "glosses": [
                            "öffentlich inszeniertes Gerichtsverfahren, bei dem die Verurteilung des Angeklagten von Anfang an feststeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd76ef0-a896-4db4-adf1-aac03478de4e",
                                "sense_id": "905a7cc6-6fa9-39d5-a9f4-c9865c3cdfbb",
                                "text": "Mitglieder des Widerstands werden zur Abschreckung in Schauprozessen zu langen Haftstrafen verurteilt."
                            },
                            {
                                "example_id": "e3a25330-cbd7-4f04-8db2-959104442875",
                                "sense_id": "905a7cc6-6fa9-39d5-a9f4-c9865c3cdfbb",
                                "text": "„Jetzt gibt es gar keinen Prozess mehr. Nicht einmal einen Schauprozess.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
