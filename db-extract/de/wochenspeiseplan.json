                "senses": [
                    {
                        "sense_id": "b477462e-fdcd-35ae-a89a-9521c20c95f7",
                        "entry_id": "11bbfebf-afc9-353d-be63-7deea3f8fbee",
                        "glosses": [
                            "Liste, welche die für den Zeitraum von einer Woche geplanten Speisen beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "449d992c-df98-45c1-9b11-ab6c8cb63efc",
                                "sense_id": "b477462e-fdcd-35ae-a89a-9521c20c95f7",
                                "text": "„Mit der Rezeptauswahl lässt sich auch gleich die Einkaufsliste – beispielsweise für den gewünschten Wochenspeiseplan – erstellen.“"
                            },
                            {
                                "example_id": "1fcb611c-def1-446a-8552-5607a8886ff9",
                                "sense_id": "b477462e-fdcd-35ae-a89a-9521c20c95f7",
                                "text": "„„Meine Güte, ich beneide euch so, einfach in den Tag hinein leben und alle Routinen abstreifen, herrlich!“, sagt ein Kollege, der sich schon am Montag den Wochenspeiseplan der Kantine herunterlädt, um keine bösen Überraschungen in puncto Essen zu erleben.“"
                            }
                        ],
