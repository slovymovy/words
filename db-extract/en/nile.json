                "translations": [
                    {
                        "translation_id": "48497d76-0e68-4329-a5b6-1708bd245ad1",
                        "source_entry_id": "00d3105e-8c06-37b7-8935-70c848783360",
                        "source_sense_id": "d720e9d9-c92a-33ea-ba4b-b02d94089a86",
                        "source_sense_description": "Nil",
                        "target_lang_word": "Nil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "666d51f9-1070-30fd-b88b-c4baac0b6d7c",
                                        "entry_id": "c1a647ec-0e96-3097-92e9-5366ec971658",
                                        "glosses": [
                                            "Fluss in Nordafrika, der in Ruanda und Burundi entspringt und in Ägypten ins Mittelmeer mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1a6358-1741-4b0d-9c33-09f7b726bdf4",
                                                "sense_id": "666d51f9-1070-30fd-b88b-c4baac0b6d7c",
                                                "text": "Der Nil ist der längste Fluss der Erde."
                                            },
                                            {
                                                "example_id": "b1ba297f-042a-4d11-8ddf-23e2aa6019fe",
                                                "sense_id": "666d51f9-1070-30fd-b88b-c4baac0b6d7c",
                                                "text": "„Bis vor rund 4.500 Jahren war der Nil ein schnell fließender Strom, der sich tief in sein Bett eingrub.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb55e1c9-455a-4ab6-b603-2f9e813393e6",
                        "source_entry_id": "00d3105e-8c06-37b7-8935-70c848783360",
                        "source_sense_id": "d720e9d9-c92a-33ea-ba4b-b02d94089a86",
                        "source_sense_description": "Nil",
                        "target_lang_word": "Nil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d39de0-5113-32c2-9b52-578edc4a7003",
                                        "entry_id": "f9d57a8d-a1ea-3c37-8ea1-38bff7fa36eb",
                                        "glosses": [
                                            "Très long fleuve africain, qui traverse le Rwanda, le Burundi, la Tanzanie, l’Ouganda, l’Éthiopie, le Soudan et enfin l’Égypte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9fd0e2-476d-421e-93a0-11252e5bd1d0",
                                                "sense_id": "e5d39de0-5113-32c2-9b52-578edc4a7003",
                                                "text": "Des oiseaux qui parent encore agréablement les rives du Nil sont les hérons. Dans le nombre, on en distingue des espèces blanches, parmi lesquelles sont le garde-bœuf et l’aigrette."
                                            },
                                            {
                                                "example_id": "d92bf103-0cff-4ea7-9305-58202e2cca31",
                                                "sense_id": "e5d39de0-5113-32c2-9b52-578edc4a7003",
                                                "text": "Dix prêtres, du Nil clair suivant la haute berge,\nD’un pas égal, le front incliné vers le sol,\nPortent la barque peinte où, sous un parasol,\nSiège le fils d’Amon, Khons, le Dieu calme et vierge."
                                            },
                                            {
                                                "example_id": "551bae17-315b-4255-99cf-1f3c1b07826b",
                                                "sense_id": "e5d39de0-5113-32c2-9b52-578edc4a7003",
                                                "text": "C’est à partir de la Méditerranée que les Grecs entreprirent de coloniser la côte ouest de l’Asie Mineure, mille ans avant l’ère chrétienne, ou s’établir sur la côte de Cyrénaïque et le delta du Nil, en Sicile et en Italie du Sud (Grande-Grèce)."
                                            },
                                            {
                                                "example_id": "28117110-c3bb-4142-8df4-0fbedfa95d19",
                                                "sense_id": "e5d39de0-5113-32c2-9b52-578edc4a7003",
                                                "text": "Je jette un coup d’œil par le hublot. Peu à peu, la piste disparaît et se met à ressembler à un fil au-dessous de nous. Plus loin, le tracé du Nil coupe le désert en deux, et va se dispersant dans la mer avec une couleur merdâtre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
