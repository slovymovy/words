        "fr-extract.jsonl": [
            {
                "entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                "word": "arpège",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8cf9b1ea-710f-47e2-a939-e57eb7f42d4d",
                        "entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                        "tags": [
                            "plural"
                        ],
                        "form": "arpèges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                        "entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                        "glosses": [
                            "Accord dont on fait entendre successivement les notes, au lieu de les frapper toutes à la fois comme dans l’accord plaqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e26099a-df3e-499b-84bc-0d24a776c043",
                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                "text": "Le diable musique, ce démon qui secoue un trousseau étincelant de strettes, de trilles et d’arpèges, se fut emparé du pauvre sourd."
                            },
                            {
                                "example_id": "c6788477-e893-4066-9122-b6a948bfd6d2",
                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                "text": "Monk appuie souvent ses solos sur des arpèges, c’est-à-dire sur des notes constitutives d’accords, égrenés l’une à la suite de l’autre, et non sur les fameuses gammes et phrases bebop qui font maintenant irruption dans l’improvisation."
                            },
                            {
                                "example_id": "07b14c67-f797-4232-977c-317b36542e6f",
                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                "text": "Jamais on n’attrapera Monk à faire ces arpèges en guimauve dont les pianistes sont si friands, qui se finissent à l’extrémité du clavier, et qui les transforment momentanément en harpistes."
                            },
                            {
                                "example_id": "e0b9cf57-9957-455b-a8d5-b694a64f949e",
                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                "text": "Un chat qui parcourt un clavier exécute couramment un arpège correct, et s’il s’assoit, il a beaucoup de chances pour frapper un accord parfait."
                            }
                        ]
                    },
                    {
                        "sense_id": "36582834-1f36-3a62-b314-c507d698143d",
                        "entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                        "glosses": [
                            "Suite musicale de sons arrangés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f603ea49-0411-42b5-8cd1-4969fe7a3a35",
                                "sense_id": "36582834-1f36-3a62-b314-c507d698143d",
                                "text": "Nous voulions l’arpège. Le chant. Le gazouillis des mots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c95208ee-9d96-49d6-b390-28125e1f4707",
                        "source_entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                        "target_lang_word": "Arpeggio",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arpeggio",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                        "entry_id": "df1deb7c-613d-3b53-8c8e-67948f1be153",
                                        "glosses": [
                                            "Akkord, bei dem die einzelnen Töne nicht gleichzeitig, sondern in kurzen Abständen nacheinander erklingen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef938b9e-215c-4de2-970b-df039efe449c",
                                                "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                                "text": "Sehr gut sieht man dies, wenn man sich den melodischen und rhythmischen Verlauf ohne das rankende Beiwerk pianistischer Raffinessen veranschaulicht: Viele Werke schließen mit einem Arpeggio auf dem Schlußakkord."
                                            },
                                            {
                                                "example_id": "fa721cad-f697-4102-8467-70b16eb217c9",
                                                "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                                "text": "„Als er die Treppe hinabging, ließen ihn andere Klavierklänge stillstehen: Arpeggien, Dezimen überspannend, sonore Bass-Oktaven, wechselnde Harmoniefolgen.“"
                                            },
                                            {
                                                "example_id": "e727b133-6254-42d3-a9f1-0b2a150a1817",
                                                "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                                "text": "„Sie schienen überall zu sein und von überall zu kommen, stark und fordernd, manchmal allein und manchmal wie ein Arpeggio und ein unaugelöster Akkord trostloser Trauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf6d32ac-4570-44b1-9f56-d2b4a3c2d33d",
                        "source_entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                        "target_lang_word": "arpeggio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arpeggio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4d00fa-1ab1-3f17-a4e8-9ecf93fb9b7d",
                                        "entry_id": "50080332-9562-3d7f-a0b4-6b77b55322c5",
                                        "glosses": [
                                            "The notes of a chord played individually instead of simultaneously, usually moving from lowest to highest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa14e95d-d114-4d24-ab12-8428da9c4c67",
                                                "sense_id": "ac4d00fa-1ab1-3f17-a4e8-9ecf93fb9b7d",
                                                "text": "He struck the opening chords of the passage; but this time Irene's voice was silent. Victor stopped in the middle of an arpeggio."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arpeggio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f88ffc40-479e-35b3-938b-6938c6d78abc",
                                        "entry_id": "95393fff-00c9-3a42-a0b3-05923087729b",
                                        "glosses": [
                                            "To play (a chord) as an arpeggio; to play (a piece of music) with arpeggios."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3954a53f-2c8a-4c9a-a8ee-337bf92ca647",
                                                "sense_id": "f88ffc40-479e-35b3-938b-6938c6d78abc",
                                                "text": "1819, Abraham Rees (ed.), The Cyclopædia, London: Longman, Hurst, Rees, Orme & Brown, Volume 14, entry “Fingering on Keyed Instruments,”\nIn practising quick passages, the fingers should be lifted up with a spring, and not allowed to hang on the keys, till wanted again, unless in arpeggioing chords, or in passages of expression."
                                            },
                                            {
                                                "example_id": "6c210a31-df67-421f-9ec8-f8966ae5eafe",
                                                "sense_id": "f88ffc40-479e-35b3-938b-6938c6d78abc",
                                                "text": "[…] I could see a man with his head buried forward towards a key-board, and his body swaying from side to side amid the storm of huge arpeggioed harmonies that came crashing overhead and round."
                                            },
                                            {
                                                "example_id": "b5c1b26c-905c-466d-b408-5d0a1403df8f",
                                                "sense_id": "f88ffc40-479e-35b3-938b-6938c6d78abc",
                                                "text": "[…] having finished her piano-forte practice, touched her harp twice, and arpeggioed the Spanish Fandango on her guitar, Miss Betty read two paragraphs of “Gilbert” […]"
                                            },
                                            {
                                                "example_id": "58ac428a-0489-4e18-8be2-559b1d567d87",
                                                "sense_id": "f88ffc40-479e-35b3-938b-6938c6d78abc",
                                                "text": "When his fingers touched the piano, he formed a D7 chord, arpeggioed it up the inversions, then started singing and playing the “Happy Birthday” song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290c6292-6933-3235-a3a4-05e3c6d76fd3",
                                        "entry_id": "95393fff-00c9-3a42-a0b3-05923087729b",
                                        "glosses": [
                                            "To produce arpeggios; to produce sounds resembling arpeggios."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a172a0a4-607b-4801-a2c9-f4c0369bc7e5",
                                                "sense_id": "290c6292-6933-3235-a3a4-05e3c6d76fd3",
                                                "text": "Herr Schlitz seated himself on the piano chair, pushed it a little back, drew it a little forward to the original place, looked under the piano at the pedals, took out his handkerchief and wiped his face and hands, and after arpeggioing up and down the keyboard, swung into a waltz of Chopin’s […]"
                                            },
                                            {
                                                "example_id": "bde6e75d-50b3-43a9-a65f-21481504968e",
                                                "sense_id": "290c6292-6933-3235-a3a4-05e3c6d76fd3",
                                                "text": "The soaring sound [of the whistling] rippled and trilled and arpeggioed as the songs of wild birds do not;"
                                            },
                                            {
                                                "example_id": "0d903539-df79-459a-9cd5-52a8785cfe9b",
                                                "sense_id": "290c6292-6933-3235-a3a4-05e3c6d76fd3",
                                                "text": "The accordion player arpeggioed through a chord […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5970bd1-8b12-3c01-8158-ed518b5be687",
                                        "entry_id": "95393fff-00c9-3a42-a0b3-05923087729b",
                                        "glosses": [
                                            "To move (the hand or fingers) against a surface as if playing arpeggios on a keyboard; to touch different points in succession along a surface."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d4e651-d7c9-4110-a91e-823e5adfee0d",
                                                "sense_id": "f5970bd1-8b12-3c01-8158-ed518b5be687",
                                                "text": "Her hand was still arpeggioing softly on his arm."
                                            },
                                            {
                                                "example_id": "ec98caa1-5516-4a82-bb7c-0f435144c29d",
                                                "sense_id": "f5970bd1-8b12-3c01-8158-ed518b5be687",
                                                "text": "the prickle of horripilation which arpeggioed my spine as I came barrelling down the hill from that ghost house"
                                            },
                                            {
                                                "example_id": "820fe8f1-60d7-471b-9955-5a179eccc742",
                                                "sense_id": "f5970bd1-8b12-3c01-8158-ed518b5be687",
                                                "text": "While we thanked him for having us and told him the car was packed, and so on, he arpeggioed his stumpy fingers across his scarlet blanket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
