                "translations": [
                    {
                        "translation_id": "ae840016-50c9-44f2-8891-2bb3bf5775ee",
                        "source_entry_id": "b3b55b5e-21ba-3436-a497-4e04ac71013b",
                        "source_sense_id": "fc609279-cf3a-3cc1-b46f-74a166f5fe2d",
                        "target_lang_word": "prescience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prescience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                        "entry_id": "7cd62e9c-e2bb-39a8-aab5-4cda454683b1",
                                        "glosses": [
                                            "Knowledge of events before they take place."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0d1a58-8434-48d1-9bdc-b1c42d958829",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "Near-synonyms: foreknowledge, foresight"
                                            },
                                            {
                                                "example_id": "679bc3d4-3873-42a7-be93-3f882d517e3b",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "God's certain prescience of the volitions of moral agents"
                                            },
                                            {
                                                "example_id": "f506670c-f461-405d-a6c1-8835ffede5ec",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "O thou, who thus the eye hast veil'd,\nThe book of fate so slowly given,\nI thank thee, that thou hast conceal'd\nFrom man the prescience of heaven."
                                            },
                                            {
                                                "example_id": "c53d298a-a76e-43c7-9f1b-f4411b1faf68",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "With prescience, the Barlows designed them to withstand a third more weight than they would be expected to bear in normal conditions - future proofing the bridge for the weight of trains we see using it today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e2cee7b-68e4-4f64-a1f5-e02433ff5934",
                        "source_entry_id": "b3b55b5e-21ba-3436-a497-4e04ac71013b",
                        "source_sense_id": "fc609279-cf3a-3cc1-b46f-74a166f5fe2d",
                        "target_lang_word": "предвидение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "предвидение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8b35dce7-0791-3df5-b1a1-64ea1dcee21b",
                                        "entry_id": "1a6a2cf0-04cc-33db-8446-5e9024389732",
                                        "glosses": [
                                            "действие по значению гл. предвидеть"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff70d456-481e-36ae-9800-2f4baee7d7f2",
                                        "entry_id": "1a6a2cf0-04cc-33db-8446-5e9024389732",
                                        "glosses": [
                                            "книжн. способность, умение предвидеть будущее, предугадать то, что должно произойти, наступить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "303e3605-b18f-478e-894f-e3710071a553",
                                                "sense_id": "ff70d456-481e-36ae-9800-2f4baee7d7f2",
                                                "text": "На первый взгляд физическое объяснение и обоснование такого явления как ясновидение, то есть предвидение (точное предсказание) будущих, ещё не состоявшихся событий ― неосуществимо в принципе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51533ca8-56ee-40d7-ba6e-5c3c63fd6836",
                        "source_entry_id": "b3b55b5e-21ba-3436-a497-4e04ac71013b",
                        "source_sense_id": "f5c81d92-9f69-3f85-80cc-eaa0b5b102e3",
                        "target_lang_word": "prediction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prediction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                        "entry_id": "cbca37e4-30c1-39fd-b032-5455e8bb4069",
                                        "glosses": [
                                            "A statement of what will happen in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26eb2ab6-fc4b-417f-b261-77298a4dba64",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "make predictions about something"
                                            },
                                            {
                                                "example_id": "ef647445-d2e4-41a9-8dbd-577e5377d1b3",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "correct prediction"
                                            },
                                            {
                                                "example_id": "62d249dd-e84d-4f57-84ed-701aaa2759c8",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "offer up a prediction"
                                            },
                                            {
                                                "example_id": "67786423-d0a8-4019-a4fd-44a00cb36d76",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "incorrect prediction"
                                            },
                                            {
                                                "example_id": "7fae8364-62f9-4400-9a43-3816ae30479f",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "the prediction came true"
                                            },
                                            {
                                                "example_id": "9581b362-4611-42c2-b069-6bf452418fa4",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "The weather forecaster made a prediction of heavy rain tomorrow."
                                            },
                                            {
                                                "example_id": "3c7fe0c9-19a3-406d-8558-54c744af45c2",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "His prediction about the stock market proved correct."
                                            },
                                            {
                                                "example_id": "d93c9d4a-22a5-4625-b27a-79705569b906",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "It’s difficult to make an accurate prediction about the future."
                                            },
                                            {
                                                "example_id": "5e80fc47-ce7f-43cc-92a1-0c7b9d99b00a",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "The scientists issued a bold prediction of technological change."
                                            }
                                        ]
                                    },
                                    {
