                "senses": [
                    {
                        "sense_id": "098e6ecd-5c5e-3792-8882-8420c28f6867",
                        "entry_id": "bb0a02fb-7b17-31d7-b928-5220159219d5",
                        "glosses": [
                            "Donner un caractère cicéronien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e529da7-a1c5-4a30-bc5f-c24595c64ff3",
                                "sense_id": "098e6ecd-5c5e-3792-8882-8420c28f6867",
                                "text": "Dolet désespère d’arriver à « cicéronianiser » Erasme : tu es incorrigible, mon vieil Erasme !"
                            },
                            {
                                "example_id": "e89768d3-2999-4da6-bde5-9093872467d1",
                                "sense_id": "098e6ecd-5c5e-3792-8882-8420c28f6867",
                                "text": "Au-delà de cette symétrie apparente, la position n’est pas exactement la même car, si l’effort pour « cicéronianiser » le latin peut se justifier par la perte d’un rapport « naturel » (maternel) à la langue latine, la réduction draconienne à la langue de Pétrarque devient refus d’une évolution inévitable de la langue : ce n’est pas une langue morte que l’on propose, mais une langue artificielle."
                            }
                        ]
                    }
