                ],
                "senses": [
                    {
                        "sense_id": "fcaa23c0-dc21-3f00-b3db-06765981f9d9",
                        "entry_id": "5b1e9d6d-f615-38ab-8d3d-d0c78e2ff18b",
                        "glosses": [
                            "Jouer du bigophone."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2f3c0c1c-d747-4456-be15-1769d0fc6834",
                                "sense_id": "fcaa23c0-dc21-3f00-b3db-06765981f9d9",
                                "text": "Isidore Baluchard décida donc, qu’ayant du souffle, ils joueront tous du bigophone.\nBiraque leur en apprendra la technique.\nQuarante-cinq jours plus tard, la fanfare bigophoniste pouvait bigophoner."
                            }
                        ]
                    },
                    {
                        "sense_id": "325f3811-01c0-3e8c-8397-ed761c7b2382",
                        "entry_id": "5b1e9d6d-f615-38ab-8d3d-d0c78e2ff18b",
                        "glosses": [
                            "Téléphoner."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "05842f9e-ebee-4e2a-911f-9cad2fad975c",
                                "sense_id": "325f3811-01c0-3e8c-8397-ed761c7b2382",
                                "text": "Donc, lorsqu’il aura bigophoné, tu lui fileras rencart."
                            },
                            {
                                "example_id": "aaee3601-2eae-49b4-bd06-c110763e6134",
                                "sense_id": "325f3811-01c0-3e8c-8397-ed761c7b2382",
                                "text": "Entre-temps, je bigophone à m’sieu Kahn, mais ça répond toujours pas chez lui."
                            }
                        ]
                    }
                ],
