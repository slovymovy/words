                    {
                        "sense_id": "a15e5045-071e-3b5a-aea0-5ade3ebf4742",
                        "entry_id": "745a68cf-f4a0-3097-af1f-df8cb22db7e2",
                        "glosses": [
                            "With hands joined; hand in hand."
                        ],
                        "tags": [
