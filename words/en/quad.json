            "pos": "noun",
            "senses": [
                {
                    "sense_id": "253114de-4dd4-3abf-826b-4f0d33903ad4",
                    "sense_definition": "A quadrangle, especially a rectangular courtyard surrounded by buildings on a college or university campus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students often gather on the <w>quad</w> to study or relax between their afternoon lectures.",
                            "target_lang_translations": {
                                "ru": "Студенты часто собираются во <w>внутреннем дворе</w>, чтобы поучиться или отдохнуть между дневными лекциями.",
                                "zh": "学生们经常在下午的课间聚集在<w>方庭</w>里学习或休息。"
                            }
                        },
                        {
                            "text": "The historic university buildings are arranged around a beautiful green <w>quad</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические здания университета расположены вокруг красивого зеленого <w>двора</w>.",
                                "zh": "历史悠久的大学建筑围绕着一个美丽的绿色<w>方庭</w>而建。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "university quad",
                        "college quad",
                        "on the quad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четырёхугольный двор, обычно прямоугольный, окружённый зданиями в колледже или университетском кампусе.",
                        "zh": "大学校园内被建筑物包围的四方形庭院。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний двор",
                                "target_lang_sense_clarification": "университетский"
                            },
                            {
                                "target_lang_word": "двор-каре",
                                "target_lang_sense_clarification": "архитектурный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方庭",
                                "target_lang_sense_clarification": "大学校园内的庭院"
                            },
                            {
                                "target_lang_word": "庭院",
                                "target_lang_sense_clarification": "通用建筑空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "720d3df4-00dd-3c66-b724-5b476e027923",
                    "sense_definition": "A quad bike; a small open vehicle with four wheels designed for off-road use.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire weekend riding his <w>quad</w> through the muddy forest trails.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные, катаясь на своем <w>квадроцикле</w> по грязным лесным тропам.",
                                "zh": "他整个周末都在泥泞的森林小径上骑行他的<w>全地形车</w>。"
                            }
                        },
                        {
                            "text": "You should always wear a helmet when you are driving a <w>quad</w> in the desert.",
                            "target_lang_translations": {
                                "ru": "Всегда следует надевать шлем, когда едешь на <w>квадроцикле</w> в пустыне.",
                                "zh": "在沙漠中驾驶<w>全地形车</w>时，一定要戴上头盔。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ride a quad",
                        "quad bike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Квадроцикл; небольшое открытое четырехколесное транспортное средство для езды по бездорожью.",
                        "zh": "一种小型四轮越野车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квадроцикл",
                                "target_lang_sense_clarification": "транспорт"
                            },
                            {
                                "target_lang_word": "квадрик",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全地形车",
                                "target_lang_sense_clarification": "正式名称"
                            },
                            {
                                "target_lang_word": "沙滩车",
                                "target_lang_sense_clarification": "常用称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00ee6436-2f3e-365d-bfba-f155bc2aed7c",
                    "sense_definition": "The quadriceps muscle, located at the front of the thigh.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After doing so many heavy squats at the gym, my <w>quads</w> are incredibly sore today.",
                            "target_lang_translations": {
                                "ru": "После стольких тяжелых приседаний в зале мои <w>квадрицепсы</w> сегодня невероятно болят.",
                                "zh": "在健身房做了那么多大重量深蹲后，我的<w>股四头肌</w>今天酸痛得厉害。"
                            }
                        },
                        {
                            "text": "Cyclists usually develop very strong <w>quads</w> because of the constant pedaling motion.",
                            "target_lang_translations": {
                                "ru": "У велосипедистов обычно развиваются очень сильные <w>квадры</w> из-за постоянного кручения педалей.",
                                "zh": "由于持续的踩踏动作，骑行者通常会练就非常强壮的<w>股四头肌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sore quads",
                        "train your quads"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in fitness and sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Четырехглавая мышца бедра (квадрицепс).",
                        "zh": "大腿前侧的股四头肌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квадрицепс",
                                "target_lang_sense_clarification": "анатомия"
                            },
                            {
                                "target_lang_word": "квадры",
                                "target_lang_sense_clarification": "спортивный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "股四头肌",
                                "target_lang_sense_clarification": "解剖学名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c7790d-b062-31ac-aeea-3eadff2560e8",
                    "sense_definition": "A quadruplet; one of four children born at the same time to the same mother.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parents were exhausted trying to look after the <w>quads</w> all by themselves.",
                            "target_lang_translations": {
                                "ru": "Родители были измотаны, пытаясь в одиночку присматривать за <w>четверняшками</w>.",
