                "senses": [
                    {
                        "sense_id": "c9310d53-5555-3f5b-bcaf-2ab29874f749",
                        "entry_id": "7c28be87-3f3a-32cb-a546-209b05a569e7",
                        "glosses": [
                            "Tout cocktail constitué d’alcool étendu de boisson gazeuse non alcoolisée (eau, soda), servi avec beaucoup de glaçons dans un grand verre (Scotch and soda, Cuba libre…)."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c0f2d542-4476-4352-a224-c76351403b5c",
                                "sense_id": "c9310d53-5555-3f5b-bcaf-2ab29874f749",
                                "text": "Je m’assieds et m’octroie une cigarette, et elle va préparer des highballs. J’entends le cliquetis de la glace."
                            },
                            {
                                "example_id": "98a7aab1-25e9-4b64-8273-7d23454ad723",
                                "sense_id": "c9310d53-5555-3f5b-bcaf-2ab29874f749",
                                "text": "Un alcool, des gros glaçons et une boisson non-alcoolisée sont les ingrédients de base d’un highball."
                            },
                            {
                                "example_id": "dc5d25a0-c081-4d46-99c1-fd8fd4324f54",
                                "sense_id": "c9310d53-5555-3f5b-bcaf-2ab29874f749",
                                "text": "Le premier bar à highball a ouvert en 2008, dans le quartier de Ginza, autour des autres bistrots et pubs."
                            }
                        ]
                    }
                ],
