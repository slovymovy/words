                ],
                "senses": [
                    {
                        "sense_id": "f654590e-0345-36bd-9d96-7e349cd3ab0b",
                        "entry_id": "eb363e06-27bf-3fcf-be97-d4c1f9f4d1b1",
                        "glosses": [
                            "gevoel"
                        ],
                        "tags": [],
