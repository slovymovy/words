                    {
                        "translation_id": "0129ce6b-7357-4285-b580-65e99a960dcd",
                        "source_entry_id": "0e3d4cca-110f-3f6c-b536-8a8a2066de9e",
                        "source_sense_id": "a5a1386b-8362-3b5b-a374-b06fbacf2bef",
                        "target_lang_word": "caillou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caillou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb068fa6-1f13-32ea-94f5-7b2439eac295",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Pierre de petite (ou moyenne) dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3e26f0-fb24-49bf-b3eb-42d735d8fe47",
                                                "sense_id": "cb068fa6-1f13-32ea-94f5-7b2439eac295",
                                                "text": "Cet homme a le cœur dur comme un caillou."
                                            },
                                            {
                                                "example_id": "6c0efa49-eed0-4a01-8f23-78f98cbe652e",
                                                "sense_id": "cb068fa6-1f13-32ea-94f5-7b2439eac295",
                                                "text": "Les racines tordues s'accrochent entre les cailloux comme des pieds désespérés."
                                            },
                                            {
                                                "example_id": "32d3c806-174e-41b4-9487-c400d3e4a46b",
                                                "sense_id": "cb068fa6-1f13-32ea-94f5-7b2439eac295",
                                                "text": "Dans beaucoup de contrées, où les grès sont rares, on utilise pour les pavages les cailloux roulés que l'on trouve en abondance dans le lit des fleuves ou sur les plages de la mer."
                                            },
                                            {
                                                "example_id": "0992de02-c908-45b3-abd3-9fd3f4007ea9",
                                                "sense_id": "cb068fa6-1f13-32ea-94f5-7b2439eac295",
                                                "text": "Puis, apercevant, sur le sentier du bas-côté, un caillou dont l’aspect lui convint, il le ramassa et le mit dans sa poche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ede8ad-5ca2-3582-a42e-c1d62091316f",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Pierre précieuse, cristal de roche, diamant."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4be8095-37ef-424e-bc2f-6a65733d3c89",
                                                "sense_id": "22ede8ad-5ca2-3582-a42e-c1d62091316f",
                                                "text": "Le mobile de la tuerie ? Le vol d’une collection de cailloux importée d’Amsterdam."
                                            },
                                            {
                                                "example_id": "d43ba1f5-87c1-4675-a846-d94e40b41b29",
                                                "sense_id": "22ede8ad-5ca2-3582-a42e-c1d62091316f",
                                                "text": "À la fin de la semaine, une élégante hôtesse de l’air avec un gros diamant au doigt m’a fait gravir les escaliers de l’avion […]\n“Regarde comme les diamants habillent une femme, m’a dit l’hôtesse avec un clin d’œil. […]” Elle a battu des paupières et la lueur du caillou a elle aussi vacillé."
                                            },
                                            {
                                                "example_id": "6db0c03a-ce6e-4f91-83b8-af1d89c7b2c7",
                                                "sense_id": "22ede8ad-5ca2-3582-a42e-c1d62091316f",
                                                "text": "Cailloux de Médoc, du Rhin, cristal de roche en galet."
                                            },
                                            {
                                                "example_id": "acc4b5bf-f4bb-4a51-ae71-cb0ef46ea01e",
                                                "sense_id": "22ede8ad-5ca2-3582-a42e-c1d62091316f",
                                                "text": "Caillou d’Égypte, jaspe dans lequel on aperçoit différentes figures qui ressemblent à des grottes, à des paysages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b1b1de-14ee-3563-809d-a00021f915d0",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Récif, rocher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d762b1-6fc3-4877-bda6-01c2d742f7e0",
                                                "sense_id": "58b1b1de-14ee-3563-809d-a00021f915d0",
                                                "text": "Avec un petit caillou situé à 200 mètres dans le nord-est, connu sous le nom de Hazelwood, dont la tête se montre, soit dans le creux des lames, soit couronnée de brisants, Rockall est tout ce qui émerge d'une grande terre disparue."
                                            },
                                            {
                                                "example_id": "ab1751b4-28df-485c-9094-2d23ce7ecb05",
                                                "sense_id": "58b1b1de-14ee-3563-809d-a00021f915d0",
                                                "text": "Le raz de Sein est un sale endroit, parsemé de cailloux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbec30fc-a7e5-3b65-a88d-d8d950c37500",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Tête, crâne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc77dc1-2ab3-495a-a0c9-2d669c2d198e",
                                                "sense_id": "fbec30fc-a7e5-3b65-a88d-d8d950c37500",
                                                "text": "Le monsieur n'avait pas un poil sur le caillou, mais il portait une moustache noire et fournie en brosse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf3df812-0f17-36c2-ae77-b10d46dbebea",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Glaçon."
                                        ],
                                        "tags": [
                                            "Occitanie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755fa502-ebc2-4ce1-b1f3-ee64dd19e36c",
                                                "sense_id": "bf3df812-0f17-36c2-ae77-b10d46dbebea",
                                                "text": "Mets-moi un caillou dans mon pastis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca9c7ca-7a2e-3c68-83ed-d80628b1eb55",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Personne têtue, tête dure."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3621c20-6287-4b72-9d5c-26e44eaa664d",
                                                "sense_id": "fca9c7ca-7a2e-3c68-83ed-d80628b1eb55",
                                                "text": "Qu'il est caillou celui-là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b19277-ee97-31c2-af07-cb5280f0b212",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Morceau de sucre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6a6ff9c-65bc-4b02-85d4-4a0870e3db74",
                                                "sense_id": "95b19277-ee97-31c2-af07-cb5280f0b212",
                                                "text": "Un ou deux cailloux dans ton café ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0891f75-c511-37cf-bff6-c3153312bf15",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Huître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a3840b-9ccc-4213-a089-684329a92417",
                                                "sense_id": "d0891f75-c511-37cf-bff6-c3153312bf15",
                                                "text": "Ouvrir les cailloux pour le repas de Noël."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f01484-9e8c-3afa-a5bd-a445fdd559d3",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Objectif, en référence à la matière minérale du verre ou la manière dont les lentilles sont enchâssées dans le fût en métal comme une pierre précieuse l'est sur une bague."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83492ef3-102a-4253-9df7-25cdb4b6f180",
                                                "sense_id": "23f01484-9e8c-3afa-a5bd-a445fdd559d3",
                                                "text": "Il utilise encore de vieux cailloux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc10b8f2-6d5c-3664-a938-0dd8517dabdf",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Nouvelle-Calédonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46089f30-e321-4245-b54f-6aab74ca9668",
                                                "sense_id": "fc10b8f2-6d5c-3664-a938-0dd8517dabdf",
                                                "text": "Enfin, dimanche, le chef de l’État français doit exposer sa vision de l’avenir du caillou, qui doit se prononcer sur son avenir par référendum, entre 2014 et 2018."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0b6d9e5-12c4-35f3-ab42-0485fd146630",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Île peu peuplée, avec peu d’activité, présentant peu d’intérêt."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4803eae3-7545-4d6e-9ab0-e752531cff51",
                                                "sense_id": "b0b6d9e5-12c4-35f3-ab42-0485fd146630",
                                                "text": "L’île [Jan Mayen] était inhabitée. Comment un humain aurait pu vivre sur ce caillou gelé, trempé en permanence ?"
                                            },
                                            {
                                                "example_id": "e3e8a095-d38b-4f00-ba8c-e6e591909385",
                                                "sense_id": "b0b6d9e5-12c4-35f3-ab42-0485fd146630",
                                                "text": "Un étranger à Sainte-Kristen est un événement hors du commun, surtout en ces temps troublés. L’île ne possède d’ailleurs aucun hôtel. Seule la petite pension de Mme Huchon, en face du café-tabac, accueillait avant guerre quelques rares clients, des originaux, des farfelus en quête de solitude. Mais, depuis trois ans, plus rien. D’où l’étonnement des villageois de voir cet homme débarquer sur leur caillou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d06692ff-12a1-32a7-adfd-840eace1ce66",
                                        "entry_id": "ded1a750-ecdb-3298-823a-ba10fbd924db",
                                        "glosses": [
                                            "Corps céleste (planète, lune, astéroïde) d’apparence rocheuse et inhospitalière."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687570a1-fc3b-4fa2-8515-a00e6f9e1320",
                                                "sense_id": "d06692ff-12a1-32a7-adfd-840eace1ce66",
                                                "text": "Procédons donc à cette division des diamètres du Soleil et des planètes et des distances qui les séparent par un milliard, c’est-à-dire plus simplement par 10⁹. […] Mercure, la première planète du système solaire, ce caillou brûlant, criblé de cratères, comme la Lune, et qui est si difficile à observer tant il reste proche du Soleil dans le ciel, serait une petite boule d’a peine ^([sic : à peine]) 5 millimètres, tournant à 58 mètres du Soleil."
                                            },
                                            {
                                                "example_id": "ec01ee85-d4df-4b28-8c86-de0dc0a4c583",
                                                "sense_id": "d06692ff-12a1-32a7-adfd-840eace1ce66",
                                                "text": "Mars est un caillou mort et notre avenir se situe sur la Terre que nous pouvons encore sauver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
