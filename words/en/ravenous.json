            "senses": [
                {
                    "sense_id": "348b951f-d6d7-38e6-9b8e-bb8c97bd6258",
                    "sense_definition": "Extremely hungry; starving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hungry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hiking in the mountains all day, the children were <w>ravenous</w> and ate everything on their plates.",
                            "target_lang_translations": {
                                "ru": "После целого дня походов в горах дети были <w>изголодавшимися</w> и съели всё, что было на их тарелках."
                            }
                        },
                        {
                            "text": "He woke up with a <w>ravenous</w> appetite and immediately went to the kitchen to make a large breakfast.",
                            "target_lang_translations": {
                                "ru": "Он проснулся с <w>волчьим</w> аппетитом и сразу же пошел на кухню, чтобы приготовить плотный завтрак."
                            }
                        }
                    ],
                    "synonyms": [
                        "starving"
                    ],
                    "antonyms": [
                        "full",
                        "sated"
                    ],
                    "common_phrases": [
                        "ravenous appetite",
                        "feel ravenous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно голодный; испытывающий сильный голод."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изголодавшийся",
                                "target_lang_sense_clarification": "очень сильно хотящий есть"
                            },
                            {
                                "target_lang_word": "голодный как волк",
                                "target_lang_sense_clarification": "разговорное выражение крайней степени голода"
                            },
                            {
                                "target_lang_word": "ненасытный",
                                "target_lang_sense_clarification": "о сильном аппетите"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c27c2997-6ae2-3816-829d-d9f5f50f4c88",
                    "sense_definition": "Extremely greedy; characterized by insatiable desire or lust.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "greedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corporation's <w>ravenous</w> greed led to the exploitation of local natural resources.",
                            "target_lang_translations": {
                                "ru": "<w>Ненасытная</w> жадность корпорации привела к эксплуатации местных природных ресурсов."
                            }
                        },
                        {
                            "text": "She had a <w>ravenous</w> desire for power that could never be satisfied by minor promotions.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>ненасытное</w> стремление к власти, которое никогда не могло быть удовлетворено мелкими повышениями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ravenous greed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно жадный; характеризующийся ненасытным желанием или страстью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненасытный",
                                "target_lang_sense_clarification": "о жадности, желании власти или ресурсов"
                            },
                            {
                                "target_lang_word": "хищный",
                                "target_lang_sense_clarification": "о жадном, агрессивном стремлении к чему-либо"
                            }
                        ]
                    }
                }
            ]
