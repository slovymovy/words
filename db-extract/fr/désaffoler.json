                        "tags": [],
                        "examples": [
                            {
                                "example_id": "124055b0-bc1a-4ba9-a394-4eb9cdd995bf",
                                "sense_id": "73ffeaca-3321-3db4-9dad-d0aa1d747a85",
                                "text": "Tandis qu’il s’éloigne, elle lui écrit, elle écrit de lui, pour lui, et pour tous; elle remue de l’air pour se désaffoler, pour ne pas voir la nuit qu’il a faite en sortant : elle reste dans l’ordre."
                            },
                            {
