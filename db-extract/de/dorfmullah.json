                "senses": [
                    {
                        "sense_id": "79805c96-21b4-3565-b8b0-f318b39fc3ef",
                        "entry_id": "c47958d5-4ab7-3ed2-87f1-95b5e562d926",
                        "glosses": [
                            "Mullah, der in einem Dorf tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70170759-bde3-49c0-b17b-5bb8f33aff02",
                                "sense_id": "79805c96-21b4-3565-b8b0-f318b39fc3ef",
                                "text": "„Zu unserer Verblüffung sahen wir aber, dass der Rest der Gemeinde sitzen blieb und der Dorfmullah eine Predigt anfing.“"
                            },
                            {
                                "example_id": "f31dd700-0d3c-4d4d-a7d9-498e753dfab4",
                                "sense_id": "79805c96-21b4-3565-b8b0-f318b39fc3ef",
                                "text": "„Ihr schlichter Glaube an einen messianischen, puritanischen Islam, eingetrichtert von einfachen Dorfmullahs, war ihr einziger Halt und gab ihrem Leben eine gewisse Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
