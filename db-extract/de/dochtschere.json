                "senses": [
                    {
                        "sense_id": "6037a9ac-933e-37e7-9da5-3cb04e4297c8",
                        "entry_id": "cdf05a77-3fed-3b1c-9de4-c3cb9164d6ab",
                        "glosses": [
                            "spezielle Schere zum Kürzen von brennenden Kerzendochten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c233db6b-30f4-4f5e-80f5-6d405cab00e4",
                                "sense_id": "6037a9ac-933e-37e7-9da5-3cb04e4297c8",
                                "text": "Der Gebrauch der Dochtschere ist heute bei den meisten Kerzen nicht mehr nötig."
                            },
                            {
                                "example_id": "bba13c08-b159-43b8-b5eb-1acc7c041837",
                                "sense_id": "6037a9ac-933e-37e7-9da5-3cb04e4297c8",
                                "text": "„Die Bezeichnung «Sternschnuppe» geht ins Mittelalter zurück. Unter «Schnuppe» ist das glühende Dochtende einer brennenden Kerze gemeint. Früher schnitt man dieses mit einer speziellen Dochtschere ab, damit die herabfallende glimmende «Schnuppe» keinen Brand verursachen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
