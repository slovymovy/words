                "senses": [
                    {
                        "sense_id": "cebf20f3-8a96-3bc2-8bc6-5ba84d3402c1",
                        "entry_id": "ec92d987-e7f7-3ee1-a3a4-0ca683ea58c0",
                        "glosses": [
                            "Faire perdre son caractère administratif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33fcc9f7-adf0-4a57-9d13-226694597842",
                                "sense_id": "cebf20f3-8a96-3bc2-8bc6-5ba84d3402c1",
                                "text": "Il devient urgent de « désadministrativiser » le recrutement des juges, ce qui ne signifie pas la disparition de l’ENM, qui symbolise injustement aux yeux de certains ce corporatisme détestable."
                            },
                            {
                                "example_id": "e696f7fb-5051-4e04-a821-85d48abc6fd6",
                                "sense_id": "cebf20f3-8a96-3bc2-8bc6-5ba84d3402c1",
                                "text": "Depuis trois ou quatre lustres, le droit des libertés publiques s’est assez substantiellement \"désadministrativisé” à cause, (ou grâce à) d’une part, de la jurisprudence du Conseil constitutionnel et d’autre part de celle des organes de la CEDH."
                            }
                        ]
                    }
                ],
