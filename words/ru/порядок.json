    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8821b331-3020-36f1-bc61-7de115e105fa",
                    "sense_definition": "Правильное устройство, организованное состояние, чистота и аккуратность в расположении чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tidiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В её комнате всегда царил идеальный <w>порядок</w>.",
                            "target_lang_translations": {
                                "en": "Her room was always in perfect <w>order</w>.",
                                "zh": "她的房间里总是保持着完美的<w>秩序</w>。"
                            }
                        },
                        {
                            "text": "Тебе давно пора привести свои дела в <w>порядок</w>.",
                            "target_lang_translations": {
                                "en": "It is high time you put your affairs in <w>order</w>.",
                                "zh": "你早就该把你的事情<w>整理</w>好了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "устроенность",
                        "упорядоченность",
                        "лад",
                        "чистота"
                    ],
                    "antonyms": [
                        "беспорядок",
                        "хаос",
                        "непорядок"
                    ],
                    "common_phrases": [
                        "привести в порядок",
                        "навести порядок",
                        "содержать в порядке",
                        "призвать к порядку"
                    ],
                    "target_lang_definitions": {
                        "en": "Correct arrangement, organized state, cleanliness and neatness in the placement of something.",
                        "zh": "指事物排列整齐、有条理的状态，或整洁、干净。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "state of being well arranged or tidy"
                            },
                            {
                                "target_lang_word": "tidiness",
                                "target_lang_sense_clarification": "cleanliness and organization"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秩序",
                                "target_lang_sense_clarification": "指有条理的状态"
                            },
                            {
                                "target_lang_word": "整洁",
                                "target_lang_sense_clarification": "指干净且有条理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62fa3686-acb9-306e-8cda-76cfccf80f0b",
                    "sense_definition": "Состояние благополучия, когда всё идёт хорошо или по плану (часто используется как сказуемое).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tidiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не волнуйся, с документами всё в <w>порядке</w>.",
