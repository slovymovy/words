            "senses": [
                {
                    "sense_id": "87e3601c-0715-3e10-b067-bcd1642ee8d9",
                    "sense_definition": "Не трудный, доступный для понимания, решения или выполнения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель объяснил нам это правило через очень <w>простой</w> пример.",
