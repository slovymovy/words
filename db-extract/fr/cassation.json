                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                        "entry_id": "5f0e63ea-463f-3ebf-a8b2-92e18c0fc5c9",
                        "glosses": [
                            "Acte juridique par lequel on casse des jugements, des actes et des procédures."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "4f887bb3-ccb5-4b0b-831b-e9764a827795",
                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                "text": "La cassation d’une procédure."
                            },
                            {
                                "example_id": "fccfb4f0-c499-41e6-bd48-93c00d987fb5",
                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                "text": "La cassation d’une sentence."
                            },
                            {
                                "example_id": "4a79ff56-5414-410d-b982-aee3b3ce9b89",
                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                "text": "La cassation d’un testament."
                            },
                            {
                                "example_id": "32fcc874-cb7b-482d-bb95-2b2963bee046",
                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                "text": "Se pourvoir en cassation, se pourvoir pour faire casser un arrêt ou un jugement en dernier ressort."
                            },
                            {
                                "example_id": "b3427e91-fcfb-4ae6-b7f1-377cceb0a236",
                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                "text": "pourvoi en cassation."
                            },
                            {
                                "example_id": "2783588f-8da4-4ede-ad64-2e9cabb0f6e9",
                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                "text": "M. R. se pourvoit en cassation, pour contester le fait que le tribunal de proximité se soit abstenu de rechercher s'il existait ou non un arrêté municipal instituant la ligne continue."
                            }
                        ]
                    },
                    {
                        "sense_id": "80c8e0e5-e5c7-353f-8150-04c4fdcac5b2",
                        "entry_id": "5f0e63ea-463f-3ebf-a8b2-92e18c0fc5c9",
                        "glosses": [
                            "Décision par laquelle un arrêt ou un jugement en dernier ressort est annulé."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3da5b6c1-f021-467c-b27a-508129f16605",
                                "sense_id": "80c8e0e5-e5c7-353f-8150-04c4fdcac5b2",
                                "text": "Demande, pourvoi, recours en cassation."
                            },
                            {
                                "example_id": "056cfd07-31ef-4884-ab4f-87af3bd8d82e",
                                "sense_id": "80c8e0e5-e5c7-353f-8150-04c4fdcac5b2",
                                "text": "Poursuivre la cassation d’un arrêt, etc."
                            },
                            {
                                "example_id": "de6a78c6-73ae-41d8-bae3-8d5c5a392bfa",
                                "sense_id": "80c8e0e5-e5c7-353f-8150-04c4fdcac5b2",
                                "text": "Aller en cassation."
                            }
                        ]
                    },
                    {
                        "sense_id": "1efd40c1-116c-3cf7-a159-12d59dddd2b2",
                        "entry_id": "5f0e63ea-463f-3ebf-a8b2-92e18c0fc5c9",
                        "glosses": [
                            "Rétrogradation d'un gradé ou d'un sous-officier au rang de soldat de seconde classe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2fb9dd1-f080-4ece-ad81-512c83ed2ebb",
                                "sense_id": "1efd40c1-116c-3cf7-a159-12d59dddd2b2",
                                "text": "Le vaguemestre, que l'idée de la cassation terrorisait et enfermait dans son mensonge, vient enfin d'avouer qu'il a perdu le message sans savoir comment."
                            }
                        ]
                    }
