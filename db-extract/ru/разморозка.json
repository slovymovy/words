                                        "sense_id": "9f6b00a9-6d77-3462-88c3-ba24f56700e6",
                                        "entry_id": "b30a16c5-46cf-3113-887b-51cb6c237cbb",
                                        "glosses": [
                                            "Action de décongeler, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b96341b-9a46-462d-a1ed-d0e7194a9e1e",
                                                "sense_id": "9f6b00a9-6d77-3462-88c3-ba24f56700e6",
                                                "text": "Il faut aussi savoir que les micro-organismes restent vivants et que lors de la décongélation, ils reprennent leur travail avec force et vigueur…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f49bfad-592c-4cc3-b022-15d8f05f88f1",
                        "source_entry_id": "0a502b89-b623-32ef-91bd-92b912b5812b",
                        "source_sense_id": "bfdc5eb1-6b04-3273-b589-526a0d7a6d70",
                        "target_lang_word": "dégivrage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégivrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6898633e-9661-3136-a563-d1626c7435ef",
                                        "entry_id": "6e317870-585b-3c0c-b6a8-93e81af07730",
                                        "glosses": [
                                            "Action d'enlever le givre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eac1ac3-17af-4a7f-88f1-fd3047f71d5d",
                                                "sense_id": "6898633e-9661-3136-a563-d1626c7435ef",
                                                "text": "Le dégivrage du congélateur doit se faire régulièrement pour économiser l’électricité."
                                            },
                                            {
                                                "example_id": "cf643967-d70e-41ec-a2ec-e8206813311b",
                                                "sense_id": "6898633e-9661-3136-a563-d1626c7435ef",
                                                "text": "Le dégivrage s’effectue de façon cyclique à intervalles réguliers à partir d’une température extérieure susceptible de provoquer le givrage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f537f571-2db5-47bc-8877-852680a48b98",
                        "source_entry_id": "0a502b89-b623-32ef-91bd-92b912b5812b",
                        "source_sense_id": "bfdc5eb1-6b04-3273-b589-526a0d7a6d70",
                        "target_lang_word": "déblocage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déblocage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa02c34-250f-3f3d-9452-4376ff47c975",
                                        "entry_id": "b1195db6-aa10-3316-a832-f4f7ad67d432",
                                        "glosses": [
                                            "Action de débloquer ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b0f417-fb32-4948-abc0-66af4050d8ef",
                                                "sense_id": "6fa02c34-250f-3f3d-9452-4376ff47c975",
                                                "text": "L’objectif primordial du premier plan quadriennal fut de donner au Cameroun l’infrastructure indispensable au déblocage d’une production que l’on s'efforça d’intensifier dans tous les domaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae22bd2-902d-3e4a-b14c-3016077a56c7",
                                        "entry_id": "b1195db6-aa10-3316-a832-f4f7ad67d432",
                                        "glosses": [
                                            "Opération qui permet de remettre en fonction un terminal de radiocommunication qui a été rendu inutilisable par plusieurs tentatives d’identification infructueuses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32ca8405-7925-442a-9fb0-069696335ead",
                        "source_entry_id": "0a502b89-b623-32ef-91bd-92b912b5812b",
                        "source_sense_id": "bfdc5eb1-6b04-3273-b589-526a0d7a6d70",
                        "target_lang_word": "dégel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                        "entry_id": "b0e5b557-16c3-3003-bdb0-3d94ba0e93a3",
                                        "glosses": [
                                            "Fonte naturelle de la glace et de la neige par l’adoucissement de la température, qui remonte au-dessus de zéro degrés Celsius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb85557f-2bbd-443d-801e-d29b1cf9581c",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Nous avons eu de cruels temps, de cruels froids, et je n’en ai pas été seulement enrhumée ; voilà le dégel, je me porte si bien […]"
                                            },
                                            {
                                                "example_id": "7c1d7d35-0761-4ca9-816e-ad00bf63a160",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Les vastes plaines subissaient un dégel complet. La nappe blanche s'en allait en eau."
                                            },
                                            {
                                                "example_id": "6a6f2913-9429-4766-855a-c6f0a308ab5d",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Les grands floes épais mis en liberté sont usés par la friction, rongés par les mouvements de la mer et par le dégel, ils constituent fréquemment des masses aux formes bizarres et élégantes d'une glace bleue-verdâtre très dure."
                                            },
                                            {
                                                "example_id": "c1a3ff56-8934-44a6-8410-b778d11e404f",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Sur la pente des toits exposés au soleil, la neige commença à mollir, puis elle fondit presque aussitôt et un bruit d'eau dégorgeant des chanlates ou ruisselant des tuiles sur la chaussée, annonça le dégel."
                                            },
                                            {
                                                "example_id": "17ca99cd-5846-4683-b384-d510ea693773",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Lors du dégel printanier, cette situation, qui est d'ailleurs commune au Québec (…), favorise la création d’embâcles surtout le long de son cours inférieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f517b3c-e569-3c5e-ba0e-21b6bea357e1",
                                        "entry_id": "b0e5b557-16c3-3003-bdb0-3d94ba0e93a3",
                                        "glosses": [
                                            "Adoucissement de l’air."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570ba447-2a1c-4a70-9826-72c0fcba3550",
                                                "sense_id": "8f517b3c-e569-3c5e-ba0e-21b6bea357e1",
                                                "text": "L'hiver était rude. Sur les routes que le court dégel de midi amollissait vaguement, la boue se ridait, se hérissait en lilliputiennes murailles et les sillons durcis qui bordaient les ornières ne s'affaissaient point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
