                "senses": [
                    {
                        "sense_id": "273077d1-c120-3987-9fb7-65c8b3d6f523",
                        "entry_id": "f3434c95-ec91-3788-9a2e-cefa90e23510",
                        "glosses": [
                            "deutlich ansteigende Zahl an Neuerkrankungen bei einem (erneuten) Ausbruch einer Krankheit in einer Population"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c612a63e-b122-4c92-9981-7397a697012e",
                                "sense_id": "273077d1-c120-3987-9fb7-65c8b3d6f523",
                                "text": "„Die Betrachtung der Fehlzeitenquote gibt Auskunft darüber, welche Ausmaße das Risiko bereits hat. Gibt es vermehrt personelle Ausfälle, ist zunächst festzustellen, ob es sich um eine temporäre Krankheitswelle handelt.“"
                            },
                            {
                                "example_id": "850ae7a8-43ec-488c-a278-77539acbd015",
                                "sense_id": "273077d1-c120-3987-9fb7-65c8b3d6f523",
                                "text": "„Unter Krankheitswellen sind zeitliche Schwankungen der Morbidität und des Charakters von Krankheiten auch nichtinfektiösen Ursprungs zu verstehen. Das Bestehen derartiger Wellen ist von vielen Klinikern beschrieben […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
