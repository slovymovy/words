                                        "sense_id": "86e49754-3f19-36bd-80fa-8f84974313f3",
                                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                                        "glosses": [
                                            "Lack of decency; the property or degree of being indecent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0c87a5-8997-4182-8dab-0df0ae0b4e49",
                                                "sense_id": "86e49754-3f19-36bd-80fa-8f84974313f3",
                                                "text": "One sure sign of indecency is criticizing foreigners constantly, but remaining silent about the problems within your own land, or by your own people, or both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a99de16-971b-35c1-a05d-6daa9e2debcf",
                                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                                        "glosses": [
                                            "Something showing lack of decency; something (such as a word) that is indecent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "914f142c-2a51-4b38-a9cf-1141095c5694",
                        "source_entry_id": "367c8bc1-c468-37bc-ad5b-feb6f7dd9e6d",
                        "source_sense_id": "99f85fdc-daca-36c1-bf96-2b53db476bb6",
                        "target_lang_word": "impudicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impudicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57e24c69-6173-33ff-8930-d8780ac815dd",
                                        "entry_id": "02bd68ee-0b63-303e-b75a-31dfbf8aaef0",
                                        "glosses": [
                                            "Vice contraire à la pudicité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717950c2-07fa-4bf7-9a3e-b170a333d77b",
                                                "sense_id": "57e24c69-6173-33ff-8930-d8780ac815dd",
                                                "text": "L’impudicité perd le corps et l’âme."
                                            },
                                            {
                                                "example_id": "bedff650-2ca5-4ff0-aa07-b0f3f3413b35",
                                                "sense_id": "57e24c69-6173-33ff-8930-d8780ac815dd",
                                                "text": "L’auteur est bon courtisan : parlant des villes foudroyées par l’Éternel à cause de leur impudicité, il a eu la délicatesse de ne point nommer la plus fameuse, pour ne pas chagriner Sa Majesté sans doute."
                                            },
                                            {
                                                "example_id": "f76e4313-c8a7-4add-a900-c93296a9dd3d",
                                                "sense_id": "57e24c69-6173-33ff-8930-d8780ac815dd",
                                                "text": "En un mot, elle ne serait rien pour l’œil, à peine supportable à regarder. Ce qui m’intéresserait en elle, c’était sa merveilleuse impudicité."
                                            },
                                            {
                                                "example_id": "4c11a5f5-1a13-4ac8-8f4d-af7aa35aee10",
                                                "sense_id": "57e24c69-6173-33ff-8930-d8780ac815dd",
                                                "text": "Elles savaient que la réalité et l’avenir se trouvaient dans les films de Martine Carol, les journaux dont les titres, Nous deux, Confidences et Intimités, annonçaient la désirable et interdite impudicité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83dc4f2f-e4ff-395f-8d88-1986fb4daa1c",
                                        "entry_id": "02bd68ee-0b63-303e-b75a-31dfbf8aaef0",
                                        "glosses": [
                                            "Actions impudiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
