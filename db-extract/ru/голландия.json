                "senses": [
                    {
                        "sense_id": "ca17b5a5-7594-31e1-bb1f-f4364e8f161c",
                        "entry_id": "4daca362-b057-36b6-a05b-fd434c542f69",
                        "glosses": [
                            "истор. бывшая провинция Нидерландов; ныне разделена на провинции Северная Голландия и Южная Голландия"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a10e81c5-83f8-3aae-b3a3-e7e11534253a",
                        "entry_id": "4daca362-b057-36b6-a05b-fd434c542f69",
                        "glosses": [
                            "разг. то же, что Нидерланды, государство в Западной Европе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed5005e-e7eb-495b-a461-7b6e7b1d7c1c",
                                "sense_id": "a10e81c5-83f8-3aae-b3a3-e7e11534253a",
                                "text": "В Амстердаме (Голландия) стали строить дома из поставленных друг на друга грузовых контейнеров, вроде тех, в которых торгуют у нас на рынках, но побольше, размером 12 на 2, 4 метра."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d719051c-6acb-4240-ba54-0186cd468a16",
                        "source_entry_id": "4daca362-b057-36b6-a05b-fd434c542f69",
                        "target_lang_word": "Holland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97d6db4c-1d33-3951-826d-4a3e862fcbc0",
                                        "entry_id": "d56198e0-7720-321c-9ebc-d013dc592798",
                                        "glosses": [
                                            "Region im Westen der Niederlande, bestehend aus den Provinzen Nordholland und Südholland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589b5bfc-e177-43fa-b66d-d163be226ff2",
                                                "sense_id": "97d6db4c-1d33-3951-826d-4a3e862fcbc0",
                                                "text": "„Der Großteil Hollands liegt unterhalb des Meeresspiegels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fff1752-31fd-3921-b1c1-8223847ecc3f",
                                        "entry_id": "d56198e0-7720-321c-9ebc-d013dc592798",
                                        "glosses": [
                                            "die Niederlande"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e7e1fd-6984-4c00-9623-aa44eb1010d7",
                                                "sense_id": "8fff1752-31fd-3921-b1c1-8223847ecc3f",
                                                "text": "Mein Nachbar ist verärgert, weil sich Holland zur Fußball-WM qualifiziert hat."
                                            },
                                            {
                                                "example_id": "a9bfe083-31cf-4a8e-b51c-3a192f760ea5",
                                                "sense_id": "8fff1752-31fd-3921-b1c1-8223847ecc3f",
                                                "text": "„Alle Menschen in Holland hatten von Hekkenfeldt auf Island vernommen, in dessen Tiefe die Hölle brennt, und sie waren sehr begierig, Neues über diesen Felsberg zu vernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
