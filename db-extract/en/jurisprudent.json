                "senses": [
                    {
                        "sense_id": "17b2da6d-493a-3d5a-b2dd-ccf09e2fde64",
                        "entry_id": "99fbfb49-2af0-33ed-9d6b-6bede2dc123f",
                        "glosses": [
                            "Someone skilled in law or jurisprudence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a732e754-e9d3-4b21-b3f8-2d0a8201679d",
                                "sense_id": "17b2da6d-493a-3d5a-b2dd-ccf09e2fde64",
                                "text": "Nobody should imagine that the fitness of the jurisprudent for rule raises him to the status of prophecy or of Imams because our discussion here is not concerned with status and rank but with the actual task."
                            },
                            {
                                "example_id": "4a3323e9-e59e-442e-9750-4c28759be540",
                                "sense_id": "17b2da6d-493a-3d5a-b2dd-ccf09e2fde64",
                                "text": "Both the official and the jurisprudent can make mistakes; they can go wrong."
                            },
                            {
                                "example_id": "4000383a-e5ee-425a-be69-a9c23e13044f",
                                "sense_id": "17b2da6d-493a-3d5a-b2dd-ccf09e2fde64",
                                "text": "According to Shaun McVeigh, the persona of the jurisprudent 'is presented in terms of dissent from the (major) jurisprudences of rationalist legal traditions and state authority."
                            }
                        ]
                    }
