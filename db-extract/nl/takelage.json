                "translations": [
                    {
                        "translation_id": "7dc2a13f-8fdf-44db-9cfa-ac2e8fcded9f",
                        "source_entry_id": "56e5d8d4-5169-3947-94ea-7e8f95a6edb0",
                        "source_sense_id": "50b7cb6b-33b1-34a5-b4fc-3318ab80e5d0",
                        "source_sense_description": "het geheel van masten en de verstaging van traditionele zeilschepen",
                        "target_lang_word": "Takelage",
