                                    {
                                        "sense_id": "cc4700fb-175c-3848-ac7c-8c9103aad366",
                                        "entry_id": "5d280ac4-b59f-3767-b850-89762bc302d5",
                                        "glosses": [
                                            "A scheme for the distribution of prizes by lot or chance, especially a gaming scheme in which one or more tickets bearing particular numbers draw prizes, the other tickets are blanks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fec2acd-15e0-4a07-ada7-a5ada530b588",
                                                "sense_id": "cc4700fb-175c-3848-ac7c-8c9103aad366",
                                                "text": "Dave plays the lottery almost every week, but always picks different numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f138e6-e04e-32ab-86fc-bd91e6349c91",
                                        "entry_id": "5d280ac4-b59f-3767-b850-89762bc302d5",
                                        "glosses": [
                                            "Something decided by chance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25df8c8d-1a5b-4b13-bb1e-5e02cad88327",
                                                "sense_id": "c9f138e6-e04e-32ab-86fc-bd91e6349c91",
                                                "text": "It's a bit of a lottery whether we'll get a good table in that diner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd3eeff8-c781-3f2c-90e3-1a7d4781bfeb",
                                        "entry_id": "5d280ac4-b59f-3767-b850-89762bc302d5",
                                        "glosses": [
                                            "Allotment; a thing allotted."
                                        ],
                                        "tags": [
