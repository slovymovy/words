                                        "sense_id": "9d61440b-661f-3413-babc-aeb92439570e",
                                        "entry_id": "7334c716-ce89-32ae-8e85-162579387085",
                                        "glosses": [
                                            "di chi, entrando in scena o colpendo quando e dove nessuno se l'aspetta, riesce sempre a sfuggire o a mantenere inalterato l'alone di mistero che lo circonda"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
