                    {
                        "translation_id": "ba34dfbb-7eca-4fbf-b13b-77e0aaab2ff8",
                        "source_entry_id": "3c835a7f-077b-3682-8a34-d95af1114ebe",
                        "source_sense_id": "02f9f6ad-092a-30fe-9643-1ff2ed36cd02",
                        "target_lang_word": "lysol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lysol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d95bf78a-9ce6-3545-b48d-01cf76ab3985",
                                        "entry_id": "01a5bb56-52dc-3e8d-a462-18b5cfdb5a31",
                                        "glosses": [
                                            "Crésol émulsionné dans un savon, jadis à usage d’insecticide et de désinfectant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2084ee70-295c-453d-ab2c-bacc2f09cf0d",
                                                "sense_id": "d95bf78a-9ce6-3545-b48d-01cf76ab3985",
                                                "text": "Quant au lysol, nous avons déjà noté, à plusieurs reprises, ses remarquables propriétés insecticides, en particulier dans nos études sur l’acariose."
                                            },
                                            {
                                                "example_id": "8ca581fb-8e2d-4631-a06b-ffa9ef11e3f0",
                                                "sense_id": "d95bf78a-9ce6-3545-b48d-01cf76ab3985",
                                                "text": "Les lysols préparés d’après ces méthodes se présentent sous la forme du liquides huileux, brunâtres et transparents."
                                            },
                                            {
                                                "example_id": "867864cc-9811-494f-9fc8-e289f04f909a",
                                                "sense_id": "d95bf78a-9ce6-3545-b48d-01cf76ab3985",
                                                "text": "Le lysol à 1/40 est également très bon pour le traitement d’hiver du kermès. On lui adjoint 2 kilogrammes de cristaux de soude pour 100 litres d’eau."
                                            },
                                            {
                                                "example_id": "f342345a-f071-46b9-a5ab-c0b7fc20884a",
                                                "sense_id": "d95bf78a-9ce6-3545-b48d-01cf76ab3985",
                                                "text": "Le moment utopique, le plus élevé et le plus profond, au sein du mythique, compte sûrement au nombre des trésors qui ne sont pas mangés par la rouille et les nuits, nin non plus, toutefois, par le simple lysol d’une \"vision moderne du monde\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
