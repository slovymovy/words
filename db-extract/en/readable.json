                                        "sense_id": "d64b5d95-9520-3dbb-8b28-2e410cf54a99",
                                        "entry_id": "90bb37ae-4bdc-30b3-a7e0-465868bcf7a6",
                                        "glosses": [
                                            "waarneembaar en interpreteerbaar zijn van tekst en/of symbolen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00aff5a-c47f-4348-b21d-b1b246c69051",
                                                "sense_id": "d64b5d95-9520-3dbb-8b28-2e410cf54a99",
                                                "text": "„Onderzoek naar populaties is van cruciaal belang. Alles komt hierin samen: geboorte en sterfte, eileg, aantal jongen, predatie en trekgedrag. Als we vogels kleurringen omdoen dan kunnen we achterhalen hoe oud ze worden en of ze trouw zijn aan een bepaalde broed- of foerageplek. Zijn ze nomadisch, of juist niet? Die ringen zijn van grote afstand met een telescoop afleesbaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f28c26ea-ccb6-4b43-846a-1ea67623c18f",
                        "source_entry_id": "ef1f6739-acf5-39dc-8323-7e8f8748cf4f",
                        "source_sense_description": "which can be read by a certain device",
                        "target_lang_word": "leesbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leesbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "431143a5-c9ba-3076-8923-5a6d6652d5ad",
                                        "entry_id": "ac895e54-c76e-3feb-8458-74f851a5da73",
                                        "glosses": [
                                            "van iets dat het makkelijk te lezen of te begrijpen is"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63c7c7d-e785-451e-9867-41ba337a14fd",
                                                "sense_id": "431143a5-c9ba-3076-8923-5a6d6652d5ad",
                                                "text": "Deze journalist kan heel ingewikkelde zaken zo opschrijven dat het voor iedereen leesbaar is."
                                            },
                                            {
                                                "example_id": "8ac95c28-1edc-41e0-b694-55663c744c72",
                                                "sense_id": "431143a5-c9ba-3076-8923-5a6d6652d5ad",
                                                "text": "Er is geen bestemming zonder duidelijkheid over de herkomst en geen toekomst zonder een leesbare versie van het verleden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfda55ae-d01b-3396-b6b7-1d22be9ea1ce",
                                        "entry_id": "ac895e54-c76e-3feb-8458-74f851a5da73",
                                        "glosses": [
                                            "dat een handschrift makkelijk te lezen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d882b4cd-33f9-4c77-b56f-d0bf2230da86",
                                                "sense_id": "bfda55ae-d01b-3396-b6b7-1d22be9ea1ce",
                                                "text": "Deze dokter schreef zo leesbaar dat er geen fouten gemaakt konden worden in de apotheek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
