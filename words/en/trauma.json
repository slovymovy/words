{
    "word_family": [
        "traumatic",
        "traumatize",
        "traumatology",
        "post-traumatic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                    "sense_definition": "An emotional or psychological wound caused by a deeply distressing or disturbing experience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "psychological injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people suffer from childhood <w>trauma</w> that affects their adult relationships and mental health.",
                            "target_lang_translations": {
                                "ru": "Многие люди страдают от детских <w>травм</w>, которые влияют на их взрослые отношения и психическое здоровье."
                            }
                        },
                        {
                            "text": "The therapist helped her process the emotional <w>trauma</w> caused by the sudden loss of her home.",
                            "target_lang_translations": {
                                "ru": "Терапевт помог ей проработать эмоциональную <w>травму</w>, вызванную внезапной потерей дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotional trauma",
                        "childhood trauma",
                        "psychological trauma",
                        "overcome trauma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональная или психологическая рана, вызванная глубоко огорчающим или тревожным опытом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травма",
                                "target_lang_sense_clarification": "психологическая или эмоциональная"
                            },
                            {
                                "target_lang_word": "рана",
                                "target_lang_sense_clarification": "душевная или сердечная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "430edc1e-4d14-321f-a4a3-aed0542f87b6",
                    "sense_definition": "A deeply distressing or disturbing event or experience.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "distressing event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moving to a new country can be a significant <w>trauma</w> for a young child.",
                            "target_lang_translations": {
                                "ru": "Переезд в новую страну может стать серьезной <w>травмой</w> для маленького ребенка."
                            }
                        },
                        {
                            "text": "The survivors of the natural disaster are still trying to cope with the <w>trauma</w> of that night.",
                            "target_lang_translations": {
                                "ru": "Пострадавшие от стихийного бедствия все еще пытаются справиться с <w>травмой</w> той ночи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recent trauma",
                        "severe trauma",
                        "experience trauma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко огорчающее или тревожное событие или переживание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травма",
                                "target_lang_sense_clarification": "тяжелое жизненное событие"
                            },
                            {
                                "target_lang_word": "потрясение",
                                "target_lang_sense_clarification": "сильное эмоциональное воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                    "sense_definition": "A physical injury to the body, typically caused by a violent impact or accident.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was rushed to the hospital with severe head <w>trauma</w> after the car accident.",
                            "target_lang_translations": {
                                "ru": "После автомобильной аварии пациента срочно доставили в больницу с тяжелой <w>травмой</w> головы."
                            }
                        },
                        {
                            "text": "Repeated blunt force <w>trauma</w> to the brain can lead to long-term neurological issues.",
                            "target_lang_translations": {
                                "ru": "Повторяющиеся тупые <w>травмы</w> головного мозга могут привести к долгосрочным неврологическим проблемам."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult"
                    ],
                    "common_phrases": [
                        "head trauma",
                        "blunt force trauma",
                        "physical trauma",
                        "trauma center"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое повреждение тела, обычно вызванное сильным ударом или несчастным случаем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травма",
                                "target_lang_sense_clarification": "медицинское повреждение организма"
                            },
                            {
                                "target_lang_word": "увечье",
                                "target_lang_sense_clarification": "серьезное телесное повреждение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}