                                "ru": "Он <w>очень</w> плакал из-за горькой утраты своего верного друга.",
                                "nl": "Hij weende <w>zeer</w> om het bittere verlies van zijn trouwe vriend.",
                                "pl": "Płakał <w>bardzo</w> nad gorzką stratą swojego wiernego przyjaciela.",
                                "fr": "Il pleura bien <w>fort</w> sur la perte amère de son fidèle ami.",
                                "it": "Pianse <w>assai</w> per l'amara perdita del suo fedele amico.",
                                "cs": "Plakal <w>převelice</w> nad hořkou ztrátou svého věrného přítele.",
                                "tr": "Sadık dostunun acı kaybına <w>pek çok</w> ağladı.",
                                "es": "Lloró <w>sobremanera</w> por la amarga pérdida de su fiel amigo.",
                                "zh": "面对痛失挚友的惨痛打击，他哭得<w>极其</w>伤心。"
                            }
