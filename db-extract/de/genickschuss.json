                "senses": [
                    {
                        "sense_id": "d73dfce2-d0c1-3286-971e-3967b655918e",
                        "entry_id": "9db32036-cf65-3d49-9947-f87addd2f412",
                        "glosses": [
                            "Schuss, bei dem das Projektil aus nächster Nähe das Genick trifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e4ee02-4d24-4001-985d-7586a42277d8",
                                "sense_id": "d73dfce2-d0c1-3286-971e-3967b655918e",
                                "text": "Der Gefangene wurde mit einem Genickschuss getötet."
                            },
                            {
                                "example_id": "75af2dd5-2b42-4098-b39f-86b2a3e169f7",
                                "sense_id": "d73dfce2-d0c1-3286-971e-3967b655918e",
                                "text": "„Bis zuletzt wurden im Lager noch per Genickschuss Exekutionen vorgenommen.“"
                            },
                            {
                                "example_id": "6f31575d-5e70-45da-8724-1a590adb4ba8",
                                "sense_id": "d73dfce2-d0c1-3286-971e-3967b655918e",
                                "text": "„Die NKWD-Beamten liquidierten sie daraufhin am 28. Juni 1942 durch Genickschuss.“"
                            },
                            {
                                "example_id": "671a47bf-ffb2-4b68-831a-93f87bf11c80",
                                "sense_id": "d73dfce2-d0c1-3286-971e-3967b655918e",
                                "text": "„Besonders sympathisch war er mir nicht, aber zusammengekrümmt im Kofferraum eines Autos zu enden, durch Genickschuss hingerichtet, war entwürdigend.“"
                            },
                            {
                                "example_id": "1782f6d3-687f-4a17-8e9d-d02ccac679fd",
                                "sense_id": "d73dfce2-d0c1-3286-971e-3967b655918e",
                                "text": "„Sie starben durch Genickschüsse, an medizinischen Versuchen, auch durch Gas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
