                                "target_senses": [
                                    {
                                        "sense_id": "f2d8e7ea-653d-371b-89dc-6c731c3209bb",
                                        "entry_id": "39333a74-34fd-3912-9e7c-d646a38aa91e",
                                        "glosses": [
                                            "auf die Erdoberfläche bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7f73de-c1be-4c63-b242-9f48cd0bf2af",
                                                "sense_id": "f2d8e7ea-653d-371b-89dc-6c731c3209bb",
                                                "text": "In einer globalisierten Welt sind geografische Kenntnisse von Vorteil."
                                            },
                                            {
                                                "example_id": "71f5e28a-7432-48d7-ac51-91de5d25b105",
                                                "sense_id": "f2d8e7ea-653d-371b-89dc-6c731c3209bb",
                                                "text": "„Geografische Namen erfüllen eine ungeheuer wichtige Funktion in unserem täglichen Leben - und dennoch werden sie fast als etwas Selbstverständliches gesehen, etwas schon immer Dagewesenes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
