                        "M.",
                        "m.",
                        "MM",
                        "MM.",
                        "mn",
                        "mn."
                    ],
                    "common_phrases": [
                        "one million dollars",
                        "several million people",
                        "million years ago"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количественное числительное 1 000 000, равное десяти в шестой степени или тысяче тысяч.",
                        "zh": "基数1,000,000，等于10的6次方或一千个一千。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миллион",
                                "target_lang_sense_clarification": "число 1 000 000"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "百万",
                                "target_lang_sense_clarification": "数字1,000,000"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5969678d-ad0a-372a-a1fc-2c5bc1fc900e",
                    "sense_definition": "An unspecified, very large number used for emphasis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hyperbole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have told you a <w>million</w> times to clean your room.",
                            "target_lang_translations": {
                                "ru": "Я тебе <w>миллион</w> раз говорил убраться в своей комнате.",
                                "zh": "我跟你说过<w>百万</w>次要打扫你的房间了。"
                            }
                        },
                        {
                            "text": "There are a <w>million</w> reasons why this plan won't work.",
                            "target_lang_translations": {
                                "ru": "Есть <w>миллион</w> причин, почему этот план не сработает.",
                                "zh": "这个计划行不通的原因有<w>百万</w>个。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "million times before",
                        "million miles away",
                        "thanks a million"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used for hyperbolic emphasis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопределенно большое количество чего-либо, используемое для усиления выразительности.",
                        "zh": "用于强调的非特定、非常大的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миллион",
                                "target_lang_sense_clarification": "огромное количество"
