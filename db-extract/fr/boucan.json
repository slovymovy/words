                                "sense_id": "63598223-9de6-38b9-bbb7-9ab6146ec348",
                                "text": "Ce n'est pas bientôt fini ce boucan, on ne s'entend plus !",
                                "translation": "Are you about finished making that racket? We can't hear ourselves think!",
                                "english": "Are you about finished making that racket? We can't hear ourselves think!"
                            },
                            {
                                "example_id": "5e16c608-acb2-4597-a33b-1daa8246249c",
                                "sense_id": "63598223-9de6-38b9-bbb7-9ab6146ec348",
                                "text": "Ça a fait un de ces boucans !",
                                "translation": "It made an awful racket!",
                                "english": "It made an awful racket!"
                            }
                        ]
