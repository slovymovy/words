{
    "word_family": [
        "loud",
        "loudly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee1a1e28-fad4-3004-9b7b-3f70d4117e06",
                    "sense_definition": "The quality or state of being loud; the perceived strength or volume of a sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned down the <w>loudness</w> of the music because it was hurting his ears.",
                            "target_lang_translations": {
                                "tr": "Kulaklarını acıttığı için müziğin <w>ses yüksekliğini</w> kıstı."
                            }
                        },
                        {
                            "text": "The extreme <w>loudness</w> of the concert made it hard to speak to anyone.",
                            "target_lang_translations": {
                                "tr": "Konserin aşırı <w>yüksek sesli olması</w> kimseyle konuşmayı mümkün kılmadı."
                            }
                        }
                    ],
                    "synonyms": [
                        "volume"
                    ],
                    "antonyms": [
                        "quietness",
                        "silence"
                    ],
                    "common_phrases": [
                        "extreme loudness",
                        "reduce the loudness"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüksek sesli olma durumu; bir sesin algılanan şiddeti veya ses seviyesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ses yüksekliği",
                                "target_lang_sense_clarification": "sesin duyulan gücü"
                            },
                            {
                                "target_lang_word": "ses seviyesi",
                                "target_lang_sense_clarification": "genel ses şiddeti"
                            },
                            {
                                "target_lang_word": "yüksek seslilik",
                                "target_lang_sense_clarification": "sesin yüksek olma durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4803fe53-5575-3827-959c-2ad12b1e10e0",
                    "sense_definition": "The physical amplitude or sound pressure level of a acoustic signal, measured scientifically in decibels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audio engineer adjusted the peak <w>loudness</w> of the track before broadcasting.",
                            "target_lang_translations": {
                                "tr": "Ses mühendisi, yayından önce parçanın tepe <w>ses şiddetini</w> ayarladı."
                            }
                        },
                        {
                            "text": "A high sound pressure level results in greater physical <w>loudness</w>.",
                            "target_lang_translations": {
                                "tr": "Yüksek bir ses basınç seviyesi, daha büyük bir fiziksel <w>ses gürlüğü</w> ile sonuçlanır."
                            }
                        }
                    ],
                    "synonyms": [
                        "sound pressure level",
                        "amplitude"
                    ],
                    "common_phrases": [
                        "peak loudness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir akustik sinyalin desibel cinsinden bilimsel olarak ölçülen fiziksel genliği veya ses basınç seviyesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ses şiddeti",
                                "target_lang_sense_clarification": "akustik ve fiziksel ölçüm"
                            },
                            {
                                "target_lang_word": "ses gürlüğü",
                                "target_lang_sense_clarification": "fiziksel genlik seviyesi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}