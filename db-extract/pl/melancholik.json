                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4b17f8-caa0-44ff-a710-c7920db29de3",
                                                "sense_id": "b0c6ee82-31ea-3d0c-80af-6b3edd0daf81",
                                                "text": "Dieser arme Melancholiker bläst ständig Trübsal. Etwas Spaß würde ihm gut tun."
                                            }
