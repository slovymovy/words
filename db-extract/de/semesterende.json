                "senses": [
                    {
                        "sense_id": "faabffe1-2ce2-3d61-8dc5-f1dfac6d46ca",
                        "entry_id": "03042ab0-eb10-3e02-9ad8-1aef8cad3cfd",
                        "glosses": [
                            "Zeitraum am Ende eines Semesters; Termin, an dem ein Semester vorbei ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc72cda-9e65-4765-97cb-f3302aa17960",
                                "sense_id": "faabffe1-2ce2-3d61-8dc5-f1dfac6d46ca",
                                "text": "„In manchen Fächern dürfte das allerdings schwierig sein, da alle Klausuren am Semesterende zusammenfallen.“"
                            },
                            {
                                "example_id": "448338ec-84ae-4f3c-b285-a6e78c3f63d1",
                                "sense_id": "faabffe1-2ce2-3d61-8dc5-f1dfac6d46ca",
                                "text": "„An einem warmen Frühlingsmorgen kurz vor Semesterende saß ich mit meiner vierjährigen Tochter auf dem Rasen und bemühte mich, ihr meine Entscheidung zu erklären.“"
                            },
                            {
                                "example_id": "eff1ff59-ff5a-4b8d-b391-d387010a7110",
                                "sense_id": "faabffe1-2ce2-3d61-8dc5-f1dfac6d46ca",
                                "text": "„Nach Semesterende wartete dann gewissermaßen eine Belohnung auf mich: Simon, ein Postdoc, den ich kannte, lud mich zum Abendessen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
