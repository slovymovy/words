                "senses": [
                    {
                        "sense_id": "3fb1825d-effb-3d06-a99b-df4ab598952f",
                        "entry_id": "a3408bae-be2e-3508-89bb-3a2042de21ae",
                        "glosses": [
                            "van duiven dat ze altijd terugkomen naar hun eigen duiventil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa39eb0c-043d-4fca-96ed-a07e12974fd1",
                                "sense_id": "3fb1825d-effb-3d06-a99b-df4ab598952f",
                                "text": "Duiven die verwilderen en dus niet echt hokvast meer zijn, overleven gemakkelijk in de vrije natuur of in steden, waar ze voor veel overlast zorgen. Daarom heeft de overheid beslist om drie weken lang de jacht open te stellen op ‘wilde’ duiven."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3ad7fba-1c81-3480-95ed-c9b23a9f52b8",
                        "entry_id": "a3408bae-be2e-3508-89bb-3a2042de21ae",
                        "glosses": [
                            "van mensen dat ze zeer gehecht zijn aan de eigen woon- of verblijfplaats"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c08371e-0ed1-475f-91b2-2eb1668613f7",
                        "source_entry_id": "a3408bae-be2e-3508-89bb-3a2042de21ae",
                        "source_sense_id": "3fb1825d-effb-3d06-a99b-df4ab598952f",
                        "source_sense_description": "van duiven dat ze altijd terugkomen naar hun eigen duiventil",
                        "target_lang_word": "stay-at-home",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stay-at-home",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21165451-4fa3-35c5-b4a2-fb4636fd1a8b",
                                        "entry_id": "aa6fd579-8058-3fc3-bc74-317819925f6e",
                                        "glosses": [
                                            "Of a parent: not employed and rather devoting more time to one's children."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5010a4-d87b-4695-a43a-df55e20e7caa",
                                                "sense_id": "21165451-4fa3-35c5-b4a2-fb4636fd1a8b",
                                                "text": "stay-at-home dad"
                                            },
                                            {
                                                "example_id": "715f2d3b-4ddb-42bd-b9d0-69f37c629a5b",
                                                "sense_id": "21165451-4fa3-35c5-b4a2-fb4636fd1a8b",
                                                "text": "Ms. Andrews is forthright about her distress. “Jonathan’s eating habits have irritated me for years anyway and have only been exacerbated during the last six or seven weeks of him working from home,” said Ms. Andrews, 53, a stay-at-home parent who lives just outside London, in Surrey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f89287b-d38f-3efd-bc46-5ae262cd9a17",
                                        "entry_id": "aa6fd579-8058-3fc3-bc74-317819925f6e",
                                        "glosses": [
                                            "Of rules or regulations: forbidding the populace to leave their domicile except under emergency or other special circumstances, especially for purposes of quarantine."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a05cf641-afbb-4b54-b78e-24a0aaf37814",
                                                "sense_id": "0f89287b-d38f-3efd-bc46-5ae262cd9a17",
                                                "text": "stay-at-home orders"
                                            },
                                            {
                                                "example_id": "d2969f86-64c7-4f85-9425-7d76af846f30",
                                                "sense_id": "0f89287b-d38f-3efd-bc46-5ae262cd9a17",
                                                "text": "In April Jenny Rappaport sat down to inspect her calendar because she could not tell how many days had passed since New Jersey’s stay-at-home order took effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d595687f-fe8c-3d5e-958c-f6cf6a917c49",
                                        "entry_id": "aa6fd579-8058-3fc3-bc74-317819925f6e",
                                        "glosses": [
                                            "Of or relating to quarantine in the home."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59cea834-53eb-468d-b942-b87a0c35ed90",
                                                "sense_id": "d595687f-fe8c-3d5e-958c-f6cf6a917c49",
                                                "text": "the stay-at-home era"
                                            },
                                            {
                                                "example_id": "1221e0af-a922-4efe-a454-0a5e4beda06c",
                                                "sense_id": "d595687f-fe8c-3d5e-958c-f6cf6a917c49",
                                                "text": "stay-at-home boredom"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce2deb93-d34e-340b-a1ec-0e4bb598a339",
                                        "entry_id": "aa6fd579-8058-3fc3-bc74-317819925f6e",
                                        "glosses": [
                                            "Not ever travelling or moving far from home."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6466a7a6-90e5-4a28-9c7c-d4171276210d",
                                                "sense_id": "ce2deb93-d34e-340b-a1ec-0e4bb598a339",
                                                "text": "He was a seaman, but he was a wanderer too, while most seamen lead, if one may so express it, a sedentary life. Their minds are of the stay-at-home order, and their home is always with them—the ship; and so is their country—the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae587cc0-642a-322c-9aa0-69f06d1ab8f8",
                                        "entry_id": "aa6fd579-8058-3fc3-bc74-317819925f6e",
                                        "glosses": [
                                            "Playing very defensively; not leaving the defensive zone early."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stay-at-home",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a71bdd32-27e2-34c1-a6b8-12dbba6e68e9",
                                        "entry_id": "bcb5994f-893f-3048-8ef1-eac45c0a0fc5",
                                        "glosses": [
                                            "A person or animal that prefers to stay at home rather than socialize or travel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82bed636-47d3-453e-a160-85ff62a93507",
                                                "sense_id": "a71bdd32-27e2-34c1-a6b8-12dbba6e68e9",
                                                "text": "I had a fancy to go there [Archangel in Russia]. Now my fancy has been gratified, and there is yet another place written down in the charts of my experience. And it is always a little saddening to exchange a dream for a reality—once also the Caucasus was a name crowded with boundless possibility, and I went there and saw what it was. I almost envy those stay-at-homes for whom Europe and the world is quite unproved."
                                            },
                                            {
                                                "example_id": "ba894820-fba9-46ec-b099-3ac3b0a04626",
                                                "sense_id": "a71bdd32-27e2-34c1-a6b8-12dbba6e68e9",
                                                "text": "Some animals are stay-at-homes, and some are travelers and migrate. Tommy, who finds this out, is a little like both."
                                            },
                                            {
                                                "example_id": "35d4dd6b-3297-4c41-8873-4ebb32b930d1",
                                                "sense_id": "a71bdd32-27e2-34c1-a6b8-12dbba6e68e9",
                                                "text": "Many stay-at-homes stay at home because they truly love the place. Of course, some people simply are too timid to go to unfamiliar places."
                                            },
                                            {
                                                "example_id": "06ab8e2a-f822-4402-9971-bdbb4c638913",
                                                "sense_id": "a71bdd32-27e2-34c1-a6b8-12dbba6e68e9",
                                                "text": "Other species, like wildebeest, forage over large distances, while others again, like birds, are strictly territorial at certain times of the year yet, at other times, have the capacity to make long migrations. But on the whole, animals are ‘stay-at-homes’, and it is the ability to leave home without anxiety that is exceptional and which requires explanation."
                                            },
                                            {
                                                "example_id": "92dfe3f7-777a-4ea7-9d52-fe874e45d382",
                                                "sense_id": "a71bdd32-27e2-34c1-a6b8-12dbba6e68e9",
                                                "text": "Both the hardy long-distance travelers and the butterfly stay-at-homes face continual danger from predators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d5e8e40-1746-373f-b896-6502e7ae538c",
                                        "entry_id": "bcb5994f-893f-3048-8ef1-eac45c0a0fc5",
                                        "glosses": [
                                            "A parent who is not employed and rather devoting more time to children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ac08dd-d819-4106-9da2-eb802edd59bb",
                                                "sense_id": "1d5e8e40-1746-373f-b896-6502e7ae538c",
                                                "text": "We [women], I guess, got into the habit of being stay-at-homes while our children were small because you’re not there during the day with them, you tend to spend your evenings and weekends [with them] […]"
                                            },
                                            {
                                                "example_id": "7f3774e0-c9fa-48e2-b604-8e0d1ca10692",
                                                "sense_id": "1d5e8e40-1746-373f-b896-6502e7ae538c",
                                                "text": "Many of the women domestics and store clerks become stay-at-homes by default. Their immersion in their own needs, their hunger for something, prompts a comparison to Winesburg, Ohio (1919) and the white aspiration theme of so much 1920s work fiction."
                                            },
                                            {
                                                "example_id": "ef7f363f-d939-44c0-bf8a-c2c9de3580b9",
                                                "sense_id": "1d5e8e40-1746-373f-b896-6502e7ae538c",
                                                "text": "Like many stay-at-home dads, I found myself both elated and paralyzed by the idea of caring for our son eights hours a day, five days a week. My wife and I were in the same position many stay-at-homes face: she made more money than I did, and the cost of daycare per month was as much as I was making in a month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
