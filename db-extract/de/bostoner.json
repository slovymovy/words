            {
                "entry_id": "760e8a71-ec1a-3187-8d4c-b64fba66a5fb",
                "word": "Bostoner",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "9def2e77-2d99-4b46-968c-a8a95a2b329b",
                        "entry_id": "760e8a71-ec1a-3187-8d4c-b64fba66a5fb",
                        "tags": [
                            "positive"
                        ],
                        "form": "Bostoner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                        "entry_id": "760e8a71-ec1a-3187-8d4c-b64fba66a5fb",
                        "glosses": [
                            "sich auf Boston beziehend, aus Boston kommend, zu Boston gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f85b0ae-358b-4013-8768-803bce0bf02c",
                                "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                                "text": "„Über die lange Einfahrt rollten die Kutschen des Bostoner Großbürgertums heran und aus den benachbarten Anwesen kamen zu Fuß große Gruppen von Edelleuten mit gepuderten Perücken.“"
                            },
                            {
                                "example_id": "98fce5b4-5a80-45d6-882b-251438bda2f1",
                                "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                                "text": "„Das Handbuch der Bostoner Polizei – in den Augen der oberen Etagen eine wohldurchdachte Regelsammlung, die Quelle von Autorität und Ordnung, für den normalen Cop ein elendes Machwerk – unterscheidet kaum zwischen Streifenpolizisten und Detectives.“"
                            },
                            {
                                "example_id": "16f3e910-5bc2-42cc-a578-cd919ceb64c0",
                                "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                                "text": "„Sein englischer Akzent stand in scharfem Kontrast zum Bostoner Tonfall des Interviewers.“"
                            },
                            {
                                "example_id": "0e16285e-0d8a-4419-975d-d26d655c86dc",
                                "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                                "text": "„Sie lud Anna zum Abendessen ins Locke-Ober ein, ihr Bostoner Lieblingsrestaurant, in dem sie – wie sie Anna anvertraute – schon zwei Heiratsanträge bekommen hatte.“"
                            },
                            {
                                "example_id": "1409fa29-0b4e-43b4-83e6-1de45f721469",
                                "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                                "text": "„Doch damals war er ein echter Meilenstein in der Entwicklung dessen, was man eines Tages als ›kriminalpolizeiliche Verhaltensforschung‹ bezeichnen sollte, und Dr. Brussel, der später mit der Bostoner Polizei am ›Boston-Strangler‹-Fall arbeitete, war ein wirklicher Pionier auf diesem Gebiet.“"
                            },
                            {
                                "example_id": "6808d617-281e-4116-ab8f-bfc700f61c8d",
                                "sense_id": "fce775d4-dce0-3c94-9ef0-3790c42ea6fb",
                                "text": "„Einige seiner mehr esoterischen Studien behagten seinen Bostoner Nachbarn nicht, sodass er sich nach Ardham zurückzog und dieses Haus hier als Zufluchtsort bauen ließ, an dem er und seine Philosophenfreunde ihre Experimente unbehelligt durchführen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
