                "senses": [
                    {
                        "sense_id": "305a64e7-fb5f-37c9-b111-a96e971e369f",
                        "entry_id": "7cc4a1e5-5573-321e-84a2-8a6146cca8ef",
                        "glosses": [
                            "A hostel or other facility operated by the Young Men's Christian Association."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9221ed22-fcf1-4bd7-93ce-6bf888304e52",
                                "sense_id": "305a64e7-fb5f-37c9-b111-a96e971e369f",
                                "text": "In Houston, the YMCA downtown has offered dormitorylike rooms since 1908. The current building was built in 1941. Over the years it drew such fledgling business leaders as Gerald Hines and Fayez Sarofim."
                            },
                            {
                                "example_id": "100c6181-dd66-4268-a26f-db8af1970c48",
                                "sense_id": "305a64e7-fb5f-37c9-b111-a96e971e369f",
                                "text": "The title of Smith’s first magic film is to the point: The Vanishing Lady (1898). Blackton operated the camera while Smith hocused and pocused one of their wives away. Presumably there were no trap doors through which a woman could disappear in the stages of the YMCAs and churches where Smith entertained, but thanks to moving pictures he was able to add this most basic of illusions to his repertoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "7be25681-7336-3511-bf6e-fa3e90119f08",
                        "entry_id": "7cc4a1e5-5573-321e-84a2-8a6146cca8ef",
                        "glosses": [
                            "A particular dance in which the arms and body are used to imitate the letters Y, M, C, and A, in succession, danced to the Village People song Y.M.C.A."
                        ],
                        "tags": [],
                        "examples": []
                    }
