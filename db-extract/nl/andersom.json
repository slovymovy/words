                "forms": [],
                "senses": [
                    {
                        "sense_id": "65786295-acd1-3c86-a154-68610084a720",
                        "entry_id": "15f1ec7e-4506-3a63-b9bf-84133194fbf2",
                        "glosses": [
                            "the other way around"
