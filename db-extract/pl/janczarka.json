                "senses": [
                    {
                        "sense_id": "324114ac-9c3e-32cf-8c87-026182a3fb48",
                        "entry_id": "3a3bde29-6f85-36ce-8f1c-aff839528049",
                        "glosses": [
                            "strzelba turecka o długiej lufie i krótkiej zakrzywionej kolbie, często bardzo ozdobna, używana głównie przez osmańskich janczarów, także w XVII-wiecznej Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b623eed-5b2e-4cf3-9bd0-67d40b1e0e0b",
                                "sense_id": "324114ac-9c3e-32cf-8c87-026182a3fb48",
                                "text": "Janczarowie (…) służyli pieszo uzbrojeni w strzelby, zwane w Polsce janczarkami, krótkie szable, kordelas i pistolet za pasem"
                            },
                            {
                                "example_id": "9dbe90d9-1a15-4c07-8bb1-ae5c4e6840eb",
                                "sense_id": "324114ac-9c3e-32cf-8c87-026182a3fb48",
                                "text": "Z promów zaczęły grzmieć janczarki, którym dragonia huknęła w odpowiedź z bandoletów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
