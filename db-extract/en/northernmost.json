                            {
                                "example_id": "4652f50b-2403-4c31-b7e4-69e8b910e5ea",
                                "sense_id": "5fa74f4b-2902-3fd5-9118-f6dc84c660dc",
                                "text": "Alaska is the northernmost American state."
                            },
                            {
                                "example_id": "49af81ab-82d4-4d48-ba5a-a87a2c90efbf",
                                "sense_id": "5fa74f4b-2902-3fd5-9118-f6dc84c660dc",
                                "text": "Thailand’s northernmost province is the best place to see the famed (and infamous) Golden Triangle."
                            },
                            {
                                "example_id": "251f2cc1-2519-4b2c-8d65-11f41e073e78",
                                "sense_id": "5fa74f4b-2902-3fd5-9118-f6dc84c660dc",
                                "text": "For those coming by rail from London and the South East, the only direct service each day (LNER's 'Highland Chieftain') takes approximately eight hours to reach the UK's northernmost city [Inverness]."
                            }
                        ]
