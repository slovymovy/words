                "senses": [
                    {
                        "sense_id": "1c08fbf1-3082-3a1b-b2b1-a6b66fbf89dc",
                        "entry_id": "971a1a1c-6586-31ad-9d9c-d9f565ab05f8",
                        "glosses": [
                            "Instrument zur Messung der Oberflächenkrümmung der Hornhaut"
                        ],
                        "tags": [
                            "Augenheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba1c049-20c1-472d-bc16-2e8c95598ed7",
                                "sense_id": "1c08fbf1-3082-3a1b-b2b1-a6b66fbf89dc",
                                "text": "„Schon damals maass ich die Hornhaut mit dem Ophthalmometer und fand keine Asymmetrie derselben.“"
                            },
                            {
                                "example_id": "8b8e459f-7137-4dcd-97af-2a01827bad15",
                                "sense_id": "1c08fbf1-3082-3a1b-b2b1-a6b66fbf89dc",
                                "text": "„Der Krümmungsradius der Hornhaut wird auf bekannte Weise mit dem Ophthalmometer gemessen.“"
                            },
                            {
                                "example_id": "34a1eec3-062c-4357-883b-a546421df1c1",
                                "sense_id": "1c08fbf1-3082-3a1b-b2b1-a6b66fbf89dc",
                                "text": "„Der Hornhautastigmatismus läßt sich mit dem Ophthalmometer nach Javal in Höhe und Achsenlage messen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
