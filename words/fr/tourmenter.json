            "pos": "verb",
            "senses": [
                {
                    "sense_id": "677a1ab4-cbbf-390d-acaf-2590425357d6",
                    "sense_definition": "Causer de l'inquiétude, de l'angoisse ou des soucis à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiétude_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette sombre perspective d'avenir recommençait à <w>tourmenter</w> son esprit jour et nuit.",
                            "target_lang_translations": {
                                "en": "This dark prospect for the future began again to <w>torment</w> his mind day and night.",
                                "ru": "Эта мрачная перспектива будущего снова начала <w>мучить</w> его разум день и ночь.",
                                "de": "Diese düstere Zukunftsperspektive begann seine Gedanken Tag und Nacht wieder zu <w>quälen</w>.",
                                "es": "Esta sombría perspectiva de futuro volvía a <w>atormentar</w> su mente día y noche.",
                                "zh": "这个阴暗的未来前景又开始日日夜夜<w>折磨</w>他的心神。"
                            }
                        },
                        {
                            "text": "Une lancinante question sans réponse le <w>tourmentait</w> depuis plusieurs jours.",
                            "target_lang_translations": {
                                "en": "A nagging, unanswered question had been <w>tormenting</w> him for several days.",
                                "ru": "Назойливый вопрос без ответа уже несколько дней <w>мучил</w> его.",
                                "de": "Eine nagende, unbeantwortete Frage <w>plagte</w> ihn seit mehreren Tagen.",
                                "es": "Una pregunta persistente sin respuesta lo <w>atormentaba</w> desde hacía varios días.",
                                "zh": "一个挥之不去、无法回答的问题已经<w>困扰</w>了他好几天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inquiéter",
                        "préoccuper",
                        "tarauder"
                    ],
                    "common_phrases": [
                        "tourmenter l'esprit"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause anxiety, anguish or worry in someone.",
                        "ru": "Вызывать тревогу, душевные муки или беспокойство у кого-либо.",
                        "de": "Bei jemandem Sorgen, Angst oder Kummer auslösen.",
                        "es": "Causar inquietud, angustia o preocupación a alguien.",
                        "zh": "使某人感到焦虑、痛苦或忧虑。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worry",
                                "target_lang_sense_clarification": "troubling someone's mind"
                            },
                            {
                                "target_lang_word": "distress",
                                "target_lang_sense_clarification": "formal, causing emotional strain"
                            },
                            {
                                "target_lang_word": "torment",
                                "target_lang_sense_clarification": "persistent thoughts, mental anguish"
                            }
