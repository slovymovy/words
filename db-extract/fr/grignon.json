                ],
                "senses": [
                    {
                        "sense_id": "8654b2ab-ab24-34ff-bb42-f9f1a3ee0d02",
                        "entry_id": "dedf3f1e-620f-38d9-a2bc-3b763ea8d5cd",
                        "glosses": [
                            "Morceau de l’entamure du pain du côté où il y a le plus de croûte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cf926e-7541-4004-935a-545978e0d702",
                                "sense_id": "8654b2ab-ab24-34ff-bb42-f9f1a3ee0d02",
                                "text": "Il a de bonnes dents, il prend toujours le grignon."
                            },
                            {
                                "example_id": "43de8d9a-a69a-4cd9-b040-57e2de5b2546",
                                "sense_id": "8654b2ab-ab24-34ff-bb42-f9f1a3ee0d02",
                                "text": "— Chez les Dissidents, y a-t-il encore du pain pour Jules qui n’a pas fini son lard ?\nMadeleine lui tendit un petit grignon."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdae05b6-22b6-3ec4-9f98-d3bf43341e6d",
                        "entry_id": "dedf3f1e-620f-38d9-a2bc-3b763ea8d5cd",
                        "glosses": [
                            "Morceau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1f6eb5c0-38ec-4f84-8d27-7dd337f13ad7",
                                "sense_id": "fdae05b6-22b6-3ec4-9f98-d3bf43341e6d",
                                "text": "Près de l’âtre plein d’un grand feu qui s’escrimait contre un chaudron, une femme grasse et plus blanche que le lard qu’elle découpait avec un long couteau, faisait fondre des grignons de saindoux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d70c2015-8b48-3d79-8529-bfd142d2596c",
                        "entry_id": "dedf3f1e-620f-38d9-a2bc-3b763ea8d5cd",
                        "glosses": [
                            "Biscuit sec faisant partie de la ration des marins."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8aa33de6-bd5c-3b05-baca-3f2f98775f91",
                        "entry_id": "dedf3f1e-620f-38d9-a2bc-3b763ea8d5cd",
                        "glosses": [
                            "Tourteau de première ou de seconde pression."
                        ],
                        "tags": [
                            "Huilerie"
                        ],
                        "examples": [
                            {
                                "example_id": "611c2da2-f64a-4d45-b9ce-d051e62a03af",
                                "sense_id": "8aa33de6-bd5c-3b05-baca-3f2f98775f91",
                                "text": "Les grignons sont encore riches en huile et sont utilisés comme aliments du bétail."
                            }
                        ]
                    }
