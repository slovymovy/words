                "senses": [
                    {
                        "sense_id": "912d6596-720a-3fc7-b0a5-7109f2c35ebb",
                        "entry_id": "1b52f351-940d-3c1f-b961-78b67ca4dfc9",
                        "glosses": [
                            "Stoff mit nutzbarer Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc435583-3a9b-4c5e-93d4-558f4aafd3df",
                                "sense_id": "912d6596-720a-3fc7-b0a5-7109f2c35ebb",
                                "text": "„Auf der Suche nach neuen Rohstoffen und Energieträgern nutzen Forscher Prinzipien der Katalyse, um bisher wenig brauchbare Stoffe in nützliche umzuwandeln.“"
                            },
                            {
                                "example_id": "6c8e4847-2665-4ffc-8d50-5c4eaf2364f8",
                                "sense_id": "912d6596-720a-3fc7-b0a5-7109f2c35ebb",
                                "text": "„Wasserstoff ist ein umweltfreundlicher Energieträger. Bei seiner Verbrennung entstehen keine schädlichen Abgase, sondern nur Wasserdampf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40f31df4-4c75-49bb-8c7f-71c217a8fc00",
