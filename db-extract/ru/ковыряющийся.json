                                        "entry_id": "19b03918-301c-3a7a-9f5f-71c9d08ce49a",
                                        "glosses": [
                                            "A gathering to pick fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3a2bce-3827-4479-b29e-d0d3f760640f",
                                                "sense_id": "73aa9acc-667a-3a9c-9c36-97c39456fd42",
                                                "text": "We went to a strawberry picking last June."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d36c955-c1c4-36c6-90eb-e8df8b3b03b7",
                                        "entry_id": "19b03918-301c-3a7a-9f5f-71c9d08ce49a",
                                        "glosses": [
                                            "Items remaining after others have selected the best; scraps, as of food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd4e34f-e44a-494a-b469-8a794441bcf0",
                                                "sense_id": "8d36c955-c1c4-36c6-90eb-e8df8b3b03b7",
                                                "text": "Gilbert wandered through . . .the haunts of ravenous dogs and homeless cats that kept themselves alive on the choice pickings of the city's garbage."
                                            }
                                        ]
                                    },
