                "senses": [
                    {
                        "sense_id": "c49fd8c3-205c-3135-9ae0-3813e769500e",
                        "entry_id": "5afdc529-cda6-32d3-a8f9-808c54524e2a",
                        "glosses": [
                            "meist an Faschingsdienstag durch Kinder ausgeführter Schabernack mithilfe einer von Holzlatten oder Seilen abgesperrte Straße, um Autofahrern zur Abgabe von Süßigkeiten oder Münzgeld zu bewegen"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "19d50ce5-d519-4a7e-ba68-bf9c58db8720",
                                "sense_id": "c49fd8c3-205c-3135-9ae0-3813e769500e",
                                "text": "„Kurz vor dem Ziel muss er noch Narrenzoll an die plärrenden Nachbarskinder zahlen.“"
                            },
                            {
                                "example_id": "6459d14d-3bc0-479c-a6ef-ddf21d889f14",
                                "sense_id": "c49fd8c3-205c-3135-9ae0-3813e769500e",
                                "text": "„Außerhalb von Wohngebieten, wo jeder jeden kennt, sollte man auf den Narrenzoll lieber verzichten.“"
                            },
                            {
                                "example_id": "150fa47e-9ea5-4aa9-b94c-7c55f4d4f568",
                                "sense_id": "c49fd8c3-205c-3135-9ae0-3813e769500e",
                                "text": "„Von Altweiber bis Rosenmontag wird in vielen Stadtteilen, bevorzugt in Wohnsiedlungen, der sogenannte Narrenzoll kassiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
