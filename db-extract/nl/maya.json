                        "examples": [
                            {
                                "example_id": "70303168-72a6-4be3-8450-89255276b83e",
                                "sense_id": "a823299f-bf40-3ddf-8a56-c641095e201f",
                                "text": "Sommige Maya’s zeggen dat zij nooit geconsulteerd zijn over het project over ‘hun’ land."
                            },
                            {
                                "example_id": "46cc362e-bea5-4be4-9650-9a80765a3456",
                                "sense_id": "a823299f-bf40-3ddf-8a56-c641095e201f",
                                "text": "Bovendien bleek het hoofd niet van een Mixteek maar van een Maya."
                            }
                        ]
                    }
                ],
