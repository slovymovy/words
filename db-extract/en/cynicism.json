                    {
                        "translation_id": "a8fa1d17-c58b-4d8f-be12-0b9f6b74878b",
                        "source_entry_id": "9f446324-3c3f-33e4-bd49-d0bea6bb5a9b",
                        "source_sense_description": "skeptical, scornful or pessimistic attitude",
                        "target_lang_word": "cynisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9c57e096-3e3c-399e-96e4-44aea30949ed",
                                        "entry_id": "1a01c83a-c72d-3940-8098-a9e537fe1721",
                                        "glosses": [
                                            "wijsgerige school bij de oude Grieken"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cb25b62-96ca-324f-96a4-6101a256d179",
                                        "entry_id": "1a01c83a-c72d-3940-8098-a9e537fe1721",
                                        "glosses": [
                                            "levenshouding waarbij men afwijzend staat tegenover idealisme of geestdrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046f00a0-8aed-432d-9de0-39d8b6200156",
                                                "sense_id": "9cb25b62-96ca-324f-96a4-6101a256d179",
                                                "text": "'Heel misschien gaat het in uw bovenkamer dagen, meneer Steiner,' zei Jeroen met een stem waar het cynisme vanaf droop."
                                            },
                                            {
                                                "example_id": "3525bec7-21da-40db-840a-acba501e8611",
                                                "sense_id": "9cb25b62-96ca-324f-96a4-6101a256d179",
                                                "text": "Aan deze kant van de Atlantische Oceaan wordt het politieke landschap gekenmerkt door een versterking van radicale antidemocratische, neofascistische krachten; door onliberale democratieën en autoritaire, racistische, antimoderne partijen; maar ook door polarisatie, pessimisme en ja, cynisme ten opzichte van het heersende systeem waarvan grote delen van de Europese bevolking vinden dat het hen niet langer vertegenwoordigt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bda7964-4690-4fd4-a342-3da1daf4db2e",
                        "source_entry_id": "9f446324-3c3f-33e4-bd49-d0bea6bb5a9b",
                        "source_sense_description": "skeptical, scornful or pessimistic attitude",
                        "target_lang_word": "cynisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ab0db8-0a1d-32d7-baa6-f75dcca42af7",
                                        "entry_id": "c884f2fd-1c5b-3c4a-bae6-b02dc43ebccc",
                                        "glosses": [
                                            "Philosophie cynique, doctrine matérialiste et anticonformiste des philosophes cyniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a215e2f-c94c-4348-b03c-b6a58555aa75",
                                                "sense_id": "e9ab0db8-0a1d-32d7-baa6-f75dcca42af7",
                                                "text": "Le cynisme fit de grands progrès dans la Grèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070d111c-263e-3622-a6d5-aed0d8089543",
                                        "entry_id": "c884f2fd-1c5b-3c4a-bae6-b02dc43ebccc",
                                        "glosses": [
                                            "Affectation d’impudence, mépris des convenances et de la morale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c8322d4-9c66-4b1a-95ca-51fed91e5456",
                                                "sense_id": "070d111c-263e-3622-a6d5-aed0d8089543",
                                                "text": "Mépris des hommes encore, le cynisme qui le fait parler de « succès prodigieux » quand on est en pleine catastrophe."
                                            },
                                            {
                                                "example_id": "4d664067-71ff-4f32-a249-10a9a6a6f61f",
                                                "sense_id": "070d111c-263e-3622-a6d5-aed0d8089543",
                                                "text": "Philip H. Sheridan ne manquait pas de cynisme en disant : «Un bon Indien est un Indien mort»."
                                            },
                                            {
                                                "example_id": "13ad8672-fef9-425b-9f53-ad2189fe0f35",
                                                "sense_id": "070d111c-263e-3622-a6d5-aed0d8089543",
                                                "text": "Et je voulais aussi mettre en avant leurs discours : quand Amine Nasser dit que le pétrole est indispensable à la lutte contre le réchauffement climatique, quand le PDG de Total Patrick Pouyanné dit que grâce au plastique, le pétrole a de beaux jours devant lui… Ces gens sont d’un cynisme total."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6411a32e-7a67-426a-94cc-fd150fc9b82f",
                        "source_entry_id": "9f446324-3c3f-33e4-bd49-d0bea6bb5a9b",
                        "source_sense_description": "skeptical, scornful or pessimistic attitude",
                        "target_lang_word": "Zynismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zynismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "503b0035-65a0-3b09-99e4-bf895308f65e",
                                        "entry_id": "39f380bc-034e-3574-9e6c-8bf5b4f959a7",
                                        "glosses": [
                                            "Geisteshaltung, bei der durch verletzende Bemerkungen die Wertvorstellungen anderer geringgeschätzt werden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1da70f-704b-4681-8066-c96e03fdc347",
                                                "sense_id": "503b0035-65a0-3b09-99e4-bf895308f65e",
                                                "text": "Zynismus wird oft fälschlicherweise mit Sarkasmus gleichgesetzt."
                                            },
                                            {
                                                "example_id": "ae9e89c1-e21a-4e1e-8cd7-bb7b3746872c",
                                                "sense_id": "503b0035-65a0-3b09-99e4-bf895308f65e",
                                                "text": "„Im Kaukasus-Konflikt hat der russische Regierungschef Wladimir Putin dem Westen Zynismus und Verdrehung von Tatsachen vorgeworfen.“"
                                            },
                                            {
                                                "example_id": "159ab09c-dc2f-4210-b662-0e84f13c5095",
                                                "sense_id": "503b0035-65a0-3b09-99e4-bf895308f65e",
                                                "text": "„Es gehörte wohl ein besonderer politischer Zynismus dazu, sich eine solche Geschichte zu merken und zu denken, es lohne sich, sie zu erzählen.“"
                                            },
                                            {
                                                "example_id": "1c282ed2-52e7-497a-8604-dbbc4d38fc46",
                                                "sense_id": "503b0035-65a0-3b09-99e4-bf895308f65e",
                                                "text": "„Skepsis, Zynismus und der gesunde kulturelle und politische Verstand, der mich normalerweise von Massenbewegungen fern hielt, waren ein guter Schutzschild.“"
                                            },
                                            {
                                                "example_id": "be9502a3-35bf-4675-964c-c25baaab750e",
                                                "sense_id": "503b0035-65a0-3b09-99e4-bf895308f65e",
                                                "text": "„Dann dachte er an die Roheit und den Zynismus ihrer Denkweise, an die vulgären Ausdrücke, die sie häufig brauchte, obwohl sie doch in den Kreisen der höchsten Aristokratie aufgewachsen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42fe6f7b-f467-34cb-95ac-453372998195",
                                        "entry_id": "39f380bc-034e-3574-9e6c-8bf5b4f959a7",
                                        "glosses": [
                                            "eine zynische Bemerkung"
                                        ],
                                        "tags": [
                                            "konkret"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5625bc4b-b029-4cd4-905d-20d924ccfcbb",
                                                "sense_id": "42fe6f7b-f467-34cb-95ac-453372998195",
                                                "text": "Es wäre mir sehr daran gelegen, dass Sie Ihre Zynismen für sich behalten."
                                            },
                                            {
                                                "example_id": "6f55b3a1-2ef4-465f-9a4b-99a29eef3113",
                                                "sense_id": "42fe6f7b-f467-34cb-95ac-453372998195",
                                                "text": "„Er besann sich auf seine Zynismen, um den Großen zu zwingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "982ee25b-6ddf-3602-a1d0-983410bbde5d",
                                        "entry_id": "39f380bc-034e-3574-9e6c-8bf5b4f959a7",
                                        "glosses": [
                                            "Weltanschauung der Kyniker"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "931bd6bd-a2b1-4b20-a5ce-c5e799f66726",
                                                "sense_id": "982ee25b-6ddf-3602-a1d0-983410bbde5d",
                                                "text": "Es gibt natürlich doch einen Unterschied zwischen dem antiken Zynismus, also dem antiken Kynismus, an den Nietzsche anknüpft, und dem modernen Zynismus."
                                            },
                                            {
                                                "example_id": "35ed5b8b-2c16-4fe7-b8b4-781f7f9295c9",
                                                "sense_id": "982ee25b-6ddf-3602-a1d0-983410bbde5d",
                                                "text": "„Der Zynismus ist eine Philosophie, das kann man nicht leugnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
