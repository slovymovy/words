                "senses": [
                    {
                        "sense_id": "8e563500-ce26-3af4-84c6-34df0cce546c",
                        "entry_id": "f43a808c-211d-3198-97b3-6999ea85faab",
                        "glosses": [
                            "ein Land in Südostasien"
                        ],
                        "tags": [
                            "traditionelle Bezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "e476e39f-720c-49dc-b4eb-06f373d3f39e",
                                "sense_id": "8e563500-ce26-3af4-84c6-34df0cce546c",
                                "text": "1948 wurde Burma in die Unabhängigkeit entlassen."
                            },
                            {
                                "example_id": "8a08e220-271c-43fd-b440-b46f50ccc469",
                                "sense_id": "8e563500-ce26-3af4-84c6-34df0cce546c",
                                "text": "„Die Versorgung mit Reis konnte nicht mehr gewährleistet werden, und erstmals seit der Erringung der Unabhängigkeit am 4. Januar 1948 sah sich das ehemals als ‚Reisschüssel Asiens‘ bekannte Burma gezwungen, das wichtigste Grundnahrungsmittel in größeren Mengen zu importieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
