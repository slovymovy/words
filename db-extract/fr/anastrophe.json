                ],
                "senses": [
                    {
                        "sense_id": "e32834db-42a3-3204-88fe-65a9f067869a",
                        "entry_id": "17593349-1b1c-3f7d-a9d7-ac9467712763",
                        "glosses": [
                            "Renversement de la construction naturelle ou ordinaire."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "805cdb85-66fa-4be9-81ea-2c7ad42e7f2f",
                                "sense_id": "e32834db-42a3-3204-88fe-65a9f067869a",
                                "text": "Il reste dès lors à expliquer le cas d’anastrophe des prépositions."
                            },
                            {
                                "example_id": "24667bd7-e1c7-4faa-85e0-ede8f75f171e",
                                "sense_id": "e32834db-42a3-3204-88fe-65a9f067869a",
                                "text": "Un paladin de la liberté d’expression qui avait par le passé attaqué dans moult textes la bien-pensance de Céline Wachowski, membre adhérant au lobby victimaire qu’il percevait, oeil fin, partout, sortir rabibochages et anastrophes au sujet de ce peuple qui n’acceptait pas son destin historique — ravage de l’orthodoxie pluraliste."
                            },
                            {
                                "example_id": "33fc761b-f815-404b-aa6e-35f5fc2c7172",
                                "sense_id": "e32834db-42a3-3204-88fe-65a9f067869a",
                                "text": "En latin, « Mecum, vobiscum » sont des anastrophes, pour « Cum me, cum vobis »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d54e15-9745-4f55-92f0-af239abc0b8d",
                        "source_entry_id": "17593349-1b1c-3f7d-a9d7-ac9467712763",
                        "source_sense_id": "e32834db-42a3-3204-88fe-65a9f067869a",
                        "target_lang_word": "anastrophe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anastrophe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27cc5289-1213-327a-b800-bc0d8169824b",
                                        "entry_id": "8d899c0d-0044-3a7f-bbe7-2617130f5d8f",
                                        "glosses": [
                                            "Unusual word order, often involving an inversion of the usual pattern of the sentence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59957f1c-a6fa-47ad-8540-7a8256d5549e",
                                                "sense_id": "27cc5289-1213-327a-b800-bc0d8169824b",
                                                "text": "Anastrophe often, by a pleasing change,\nGracefuly puts last the words that first should range."
                                            },
                                            {
                                                "example_id": "7bd88d28-0acf-4fc7-809a-94f8ddbdc4c8",
                                                "sense_id": "27cc5289-1213-327a-b800-bc0d8169824b",
                                                "text": "[…] thus the foreign-born baby was denounced and welcomed, the circumstances lamented and the mother congratulated, in a breath, all under cover of the happiest misunderstanding, as effective as the cabalism of Prospero's wand among the Neapolitan mariners, by the skilful Irish development on a grand scale of the rhetorical figure anastrophe, or a turning about and about."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cacd91eb-74fe-4195-a347-d0082aac45be",
                        "source_entry_id": "17593349-1b1c-3f7d-a9d7-ac9467712763",
