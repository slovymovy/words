                        "glosses": [
                            "Technique de conservation par irradiation des aliments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96e8edac-14aa-4c49-a264-2e3e8aeee886",
                                "sense_id": "27c6c1cb-81f4-316d-8724-e400fcb8cae2",
                                "text": "En radioconservation, on utilise aussi la dose de réduction décimale, DRD ; elle provoque la réduction de 90 % de la population microbienne initiale, effet généralement suffisant."
                            },
                            {
                                "example_id": "184051f2-a9ac-48a5-86b0-4c71dba5ee9f",
                                "sense_id": "27c6c1cb-81f4-316d-8724-e400fcb8cae2",
                                "text": "Dans le domaine de la radioconservation des denrées, les recherches réalisées notamment sur l’amidon montrent que les ruptures définitives de liaisons chimiques dues au rayonnement sont peu nombreuses et ont peu d’effets."
                            }
                        ]
                    }
