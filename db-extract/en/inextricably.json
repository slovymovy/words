                            "comparative"
                        ],
                        "form": "more inextricably"
                    },
                    {
                        "form_id": "e1c481db-1e7e-4030-bd09-a43c9a73558b",
                        "entry_id": "7f58d961-0fae-3048-8b25-78fe7477c8a6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most inextricably"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c36f55f1-1a89-3772-8f46-3306d7328328",
                        "entry_id": "7f58d961-0fae-3048-8b25-78fe7477c8a6",
                        "glosses": [
                            "In an inextricable manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173ea199-54eb-43ce-9dcb-30f07b1c60d9",
                                "sense_id": "c36f55f1-1a89-3772-8f46-3306d7328328",
                                "text": "And yet, so inextricably blended are happiness and sorrow on our earth, that fortunate, thrice fortunate, are they who have such ties to sever."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89db8e9d-4b0e-47bc-868b-5d5edac48453",
                        "source_entry_id": "7f58d961-0fae-3048-8b25-78fe7477c8a6",
                        "source_sense_id": "c36f55f1-1a89-3772-8f46-3306d7328328",
                        "source_sense_description": "Translations",
                        "target_lang_word": "inextricablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inextricablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36ca951c-5f0f-3609-90a3-5e461d578bb1",
                                        "entry_id": "f10b4e5f-6681-36a6-9bc9-27450a045bbc",
                                        "glosses": [
                                            "D’une manière inextricable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec7ae19-4282-4633-a8d6-170a2e0a5b9c",
                                                "sense_id": "36ca951c-5f0f-3609-90a3-5e461d578bb1",
                                                "text": "Nous commencions, avec un grand sérieux, à enlever les draps. Puis, comme le matelas, ainsi débarrassé, montrait ses rayures, je faisais semblant de lui trouver un défaut ; Concha se penchait aussi et nous roulions ensemble, bientôt inextricablement mêlés l’un à l’autre."
                                            },
                                            {
                                                "example_id": "d58839fc-12ad-4e8e-b5ad-72bba633d96f",
                                                "sense_id": "36ca951c-5f0f-3609-90a3-5e461d578bb1",
                                                "text": "Et comment ces Indiens eussent-ils pu supposer que la mort de ce prêtre obscur allait amener parmi eux un homme dont la vie se mêlerait inextricablement à la leur ?"
                                            },
                                            {
                                                "example_id": "4b46856f-125e-4e97-92ee-d2a6a2ef3917",
                                                "sense_id": "36ca951c-5f0f-3609-90a3-5e461d578bb1",
                                                "text": "Elle n’a rien compris et, blessée à mort, elle blesse à son tour les autres tant ce monde est absurde, peuplé de solitudes inextricablement liées les unes aux autres."
                                            },
                                            {
                                                "example_id": "9362e022-26ee-47e4-a388-8b3b89634201",
                                                "sense_id": "36ca951c-5f0f-3609-90a3-5e461d578bb1",
                                                "text": "Le drame ivoirien mêle inextricablement ces deux dimensions et a abouti à partir de la tentative d’instauration du concept d’« ivoirité » à une coupure du pays en deux et à une situation de guerre civile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99ea0a2c-1e3c-43fc-a3fb-d46ebf18a4b9",
                        "source_entry_id": "7f58d961-0fae-3048-8b25-78fe7477c8a6",
                        "source_sense_id": "c36f55f1-1a89-3772-8f46-3306d7328328",
                        "source_sense_description": "Translations",
                        "target_lang_word": "eng",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eng",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "schmal, nahe anliegend; von relativ geringer Ausdehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c1dfc1-75b2-483f-a196-f647ab5cea27",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "Ich habe wohl zugenommen, meine Hose ist jetzt etwas eng."
                                            },
                                            {
                                                "example_id": "d3222db5-33c4-4afb-a565-4ea8924b6efc",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "In der engen Gasse war ein Überholen unmöglich."
                                            },
                                            {
                                                "example_id": "55c0f382-00ad-4318-941e-341fa1608077",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "Wenn du auch noch zum Bäcker willst, wird es eng."
                                            },
                                            {
                                                "example_id": "cce00e8a-dea9-4c4a-9d48-52cc3b8abafb",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "„Um durch das enge Gitter vor dem Fenster zu kommen, muß man fast ein Zirkusakrobat sein, so Blume.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "sehr dicht beieinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae248f-664b-4560-b3d9-7bcc3ab5ca69",
                                                "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                                "text": "Die beiden auf der Tanzfläche müssen sich sehr mögen, so eng wie die miteinander tanzen."
                                            },
                                            {
                                                "example_id": "3cac56b0-371f-4680-a0cd-547894aae19c",
                                                "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                                "text": "Auf der Geburtstagskarte ist nicht viel Platz, du musst ganz eng schreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "ein intimes Verhältnis besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c01036-c99d-4b50-aa38-3c98e8c305f9",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "Wir sind so eng miteinander, der besorgt mir bestimmt auch eine Eintrittskarte."
                                            },
                                            {
                                                "example_id": "6a91906d-652f-4e7b-9578-19736528b2ba",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "Zur Hochzeit kommt nur der engste Freundeskreis."
                                            },
                                            {
                                                "example_id": "be84b3cc-af61-4919-b9e8-212daa2dd3e0",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "„Wie eng war die Verbindung zwischen der kleinen Gruppe der Araber in Berlin und der viel größeren Gruppe der Juden gewesen, wie viel hatten Araber in dieser Stadt gerade den Juden zu verdanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "keinen Spielraum habend, in Schwierigkeiten steckend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7fb190f-5f01-4813-b96a-8e4d05528152",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "Wenn es um die Deutsche Bank irgendwann eng wird, dann wird es wieder Steuerzahlergelder geben."
                                            },
                                            {
                                                "example_id": "3e7be11a-e077-48a0-9877-f1499eb05a37",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "Wenn es für ihn eng wird, steht für Präsident Erdogan der Schuldige oft schon fest."
                                            },
                                            {
                                                "example_id": "023cef77-96e5-49ac-a62e-70a9bf534a01",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "\"Wir haben erwartet, dass es eng wird. Wir hätten noch eine Nullrunde gebraucht\", sagte [der Bundestrainer der deutschen Springreiter Otto] Becker: \"Das ist bitter.\""
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "eng",
                                "target_lang_code": "de",
                                "target_senses": [
