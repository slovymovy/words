                        "coût supplémentaire",
                        "temps supplémentaire"
                    ]
                },
                {
                    "sense_id": "2de0ab6b-b9aa-3e8e-ac0c-7873f7e67767",
                    "sense_definition": "En géométrie, qualifie deux angles dont la somme des mesures est égale à deux angles droits, soit 180 degrés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cours de géométrie, nous avons calculé la valeur de deux angles <w>supplémentaires</w>."
                        },
                        {
                            "text": "Si un premier angle vaut soixante degrés, son angle <w>supplémentaire</w> en mesure cent vingt."
                        }
                    ],
                    "common_phrases": [
                        "angles supplémentaires"
                    ]
                },
                {
                    "sense_id": "a3bf28b3-0274-3088-8302-a6ac9ca7a414",
                    "sense_definition": "En droit, qualifie les jurés tirés au sort pour suppléer les jurés titulaires en cas d'empêchement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président de la cour d'assises a désigné un juré <w>supplémentaire</w> avant le début des débats."
                        },
                        {
                            "text": "Les jurés <w>supplémentaires</w> doivent suivre tout le procès afin de pouvoir remplacer un juré malade."
