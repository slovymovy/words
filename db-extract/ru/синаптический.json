                "senses": [
                    {
                        "sense_id": "8ac20fa3-5cba-3854-8cb2-d5a00a0fa56e",
                        "entry_id": "6da92190-2df3-32ad-8547-15b0b9396d67",
                        "glosses": [
                            "физиол. связанный, соотносящийся по значению с существительным синапс"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f68861-390c-47f9-aeaf-59c9844b90d1",
                                "sense_id": "8ac20fa3-5cba-3854-8cb2-d5a00a0fa56e",
                                "text": "Особенно велико значение местного возбуждения в деятельности синаптического аппарата нервной системы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86c3d3b7-c7c4-4fd7-bcef-ee199aca994f",
                        "source_entry_id": "6da92190-2df3-32ad-8547-15b0b9396d67",
                        "source_sense_id": "8ac20fa3-5cba-3854-8cb2-d5a00a0fa56e",
                        "target_lang_word": "synaptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synaptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fcd4901-b141-3bdf-9a32-49a563554297",
                                        "entry_id": "2ced6728-d819-3b7a-9330-6dee2620e3bf",
                                        "glosses": [
                                            "Of or relating to a synapse—the junction between the terminal of a neuron and another cell."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b94e75f-97f5-4560-9f44-a579f0b9ad25",
                                                "sense_id": "4fcd4901-b141-3bdf-9a32-49a563554297",
                                                "text": "With a pencil, he highlights areas where synaptic function is declining, where the neurons are dying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d37ca056-ae2f-3989-a0fd-5cfe440aed22",
                                        "entry_id": "2ced6728-d819-3b7a-9330-6dee2620e3bf",
                                        "glosses": [
                                            "Of or relating to a synapsis—the association of homologous maternal and paternal chromosomes during the initial part of meiosis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68fbdfe3-d5b3-4c31-828f-49d7f2dfe806",
                                                "sense_id": "d37ca056-ae2f-3989-a0fd-5cfe440aed22",
                                                "text": "By far the greater proportion of cytologists however are of the opinion that the synaptic contraction is a normal stage in the heterotypic prophases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
