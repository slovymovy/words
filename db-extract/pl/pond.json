                                        "sense_id": "07a67ede-768f-3454-86a3-61bbe49ae875",
                                        "entry_id": "d7dcade3-0067-3b9a-9cbb-3f9b2322f42e",
                                        "glosses": [
                                            "An inland body of standing water, either natural or man-made, that is smaller than a lake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b760bd-a0c1-4cc1-8253-74a1ba49e2bd",
                                                "sense_id": "07a67ede-768f-3454-86a3-61bbe49ae875",
                                                "text": "But when the moon rose and the breeze awakened, and the sedges stirred, and the cat's-paws raced across the moonlit ponds, and the far surf off Wonder Head intoned the hymn of the four winds, the trinity, earth and sky and water, became one thunderous symphony—a harmony of sound and colour silvered to a monochrome by the moon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd35895-d490-33e1-9fbe-c0484a728d6e",
                                        "entry_id": "d7dcade3-0067-3b9a-9cbb-3f9b2322f42e",
                                        "glosses": [
                                            "An inland body of standing water of any size that is fed by springs rather than by a river."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                                        "entry_id": "d7dcade3-0067-3b9a-9cbb-3f9b2322f42e",
                                        "glosses": [
                                            "Chiefly in across the pond: the Atlantic Ocean."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e4fb2e-c81e-4eae-8e01-1b9ce5995de4",
                                                "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                                                "text": "I wonder how they do this on the other side of the pond."
                                            },
                                            {
                                                "example_id": "6bb252db-8073-48fe-b277-0ac3386d4d6f",
                                                "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                                                "text": "I haven’t been back home across the pond in twenty years."
                                            }
                                        ]
                                    }
                                ]
                            },
