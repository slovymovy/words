                    ]
                },
                {
                    "sense_id": "640becc9-7502-30b7-96cf-9833587e39d8",
                    "sense_definition": "Chercher à obtenir des informations sur un sujet ; s'informer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de réserver cet hôtel, nous devons nous <w>renseigner</w> sur les tarifs."
                        },
                        {
                            "text": "Il va se <w>renseigner</w> auprès de sa banque pour obtenir un prêt."
                        }
                    ],
                    "synonyms": [
                        "s'informer",
                        "s'enquérir"
                    ],
                    "common_phrases": [
                        "se renseigner sur",
                        "se renseigner auprès de"
                    ]
                },
                {
                    "sense_id": "9d4fa01b-f952-3147-8aee-07667173ee31",
                    "sense_definition": "Compléter ou remplir un document ou un formulaire avec les données demandées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "administratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez <w>renseigner</w> toutes les cases obligatoires pour valider votre inscription."
                        },
                        {
                            "text": "Le candidat a oublié de <w>renseigner</w> son numéro de téléphone sur la fiche."
                        }
                    ],
                    "synonyms": [
                        "remplir",
                        "compléter"
                    ],
                    "common_phrases": [
