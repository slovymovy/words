                    {
                        "sense_id": "3d787d62-1b19-3d75-9c93-be198223ceb5",
                        "entry_id": "930ea84c-3ac3-35ba-82f1-4bab15507e0c",
                        "glosses": [
                            "Chazara briseis een dagvlinder uit de familie van de Nymphalidae, de vossen, parelmoervlinders en weerschijnvlinders, onderfamilie Satyrinae"
                        ],
                        "tags": [
