                        "entry_id": "2efc6ab1-9fb1-3740-acb4-4ff0f37a4c9a",
                        "glosses": [
                            "someone who keeps livestock, a livestock farmer"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "cffe3af0-3e12-4d7b-9be7-a5073e90765d",
                                "sense_id": "4edbdc3d-2655-30b9-a0a6-6393499623d6",
                                "text": "De veehouder is verantwoordelijk voor het welzijn van de dieren.",
                                "translation": "The livestock farmer is responsible for the welfare of the animals.",
                                "english": "The livestock farmer is responsible for the welfare of the animals."
                            },
                            {
                                "example_id": "0d607b05-8037-4d2d-a432-a39f5968a9f8",
                                "sense_id": "4edbdc3d-2655-30b9-a0a6-6393499623d6",
                                "text": "Als veehouder besteedt hij veel tijd aan het verzorgen van zijn vee.",
                                "translation": "As a livestock farmer, he spends a lot of time caring for his cattle.",
                                "english": "As a livestock farmer, he spends a lot of time caring for his cattle."
                            }
                        ]
