                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94bf6b1b-ff94-3510-9c76-7f2ac5746535",
                                        "entry_id": "12848270-7cda-34f3-9497-b5edc4bd0230",
                                        "glosses": [
                                            "aus Medien stammend, die medische Sprache oder Kultur betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6bfa2af-0b4c-4d97-a661-2b481c4fec2d",
                                                "sense_id": "94bf6b1b-ff94-3510-9c76-7f2ac5746535",
                                                "text": "„Manche der über 1100 ausgestellten Objekte sind tatsächlich erst in den letzten Jahren zum Vorschein gekommen, etwa die 1957 in Amlasch ausgegrabenen Dinge, Vieles, was früher als medisch, ägyptisch, mesopotamisch galt, wurde inzwischen als persischen Ursprungs nachgewiesen.“"
