                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c204be69-94da-4da6-a917-24d2acd83968",
                                                "sense_id": "f9e3bab6-0f45-3c34-ac4e-1b938acfe2c8",
                                                "text": "Mein Sohn Rufus hat sich neulich in der Schule geprügelt und dabei wurde ihm ein Schneidezahn ausgeschlagen."
                                            },
                                            {
                                                "example_id": "9fb192aa-e1a5-4268-b346-c3a4e99a1e25",
                                                "sense_id": "f9e3bab6-0f45-3c34-ac4e-1b938acfe2c8",
                                                "text": "„Lumpen, Knochen, Eisen und Papier, / ausgeschlagne Zähne sammeln wir, / Lumpen, Knochen, Eisen und Papier, / ja, das sammeln wir.“ (Straßenlied der Altmaterialsammler ums Jahr 1944)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3ed7fbcb-3451-3fac-b400-312416950451",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
                                            "etwas von etwas befreien, indem darauf eingeschlagen wird"
                                        ],
                                        "tags": [
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbbeca07-0535-4cb1-8b12-c2d8fba88c3a",
                                                "sense_id": "3ed7fbcb-3451-3fac-b400-312416950451",
                                                "text": "Wenn du hier gefeudelt hast, kannst du gleich die staubigen Teppiche im Garten ausschlagen."
                                            },
                                            {
                                                "example_id": "24618931-bcf9-4ad0-8163-69f662ed4529",
                                                "sense_id": "3ed7fbcb-3451-3fac-b400-312416950451",
                                                "text": "Sie schlug das Öl aus den Nüssen aus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cd31083a-f34f-37da-bb50-cdaa5dea3fb8",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
                                            "etwas mithilfe von Schlägen ersticken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d0c572-884d-4ec6-81c7-fb64b6097cf7",
                                                "sense_id": "cd31083a-f34f-37da-bb50-cdaa5dea3fb8",
                                                "text": "Es gelang uns in letzter Sekunde, das Feuer mit einer Decke auszuschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "03ca215e-6857-354c-8cb9-0c6c6eac0f7f",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
                                            "etwas mit Textilien auskleiden, füttern"
