                                    {
                                        "sense_id": "f9b6d927-198e-3689-a315-a13579dc6ad1",
                                        "entry_id": "0e2bf50e-a7f5-35c7-9b0f-d3c103523806",
                                        "glosses": [
                                            "Qui comporte plusieurs dimensions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b1253f-a72d-4c69-9993-1d723c1c41fd",
                                                "sense_id": "f9b6d927-198e-3689-a315-a13579dc6ad1",
                                                "text": "Sauf que Lance est le genre de quart-arrière multidimensionnel qui peut transformer sa position, un match, une franchise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6013adaa-2a68-40d1-9cb1-dabc04b4eb5e",
                        "source_entry_id": "4e99bab2-ea44-3887-9d75-fe9d50b211d6",
