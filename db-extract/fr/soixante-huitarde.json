                    {
                        "sense_id": "7504a764-eaa6-3eda-b202-08026b145b41",
                        "entry_id": "af34f9c6-626f-3f7c-8209-ab1018949b5c",
                        "glosses": [
                            "Femme ayant participé au mouvement de mai 1968 en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b29d5e9-e7c3-4f47-a85e-837243b2680c",
                                "sense_id": "7504a764-eaa6-3eda-b202-08026b145b41",
                                "text": "Mirella Barracco a de délicieuses fossettes de petite fille, des cheveux gris frisés d’ex-soixante-huitarde, un pull chic d’un gris très doux et le regard rafraîchissant d’une amoureuse du siècle des Lumières."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f5abc5e-ce0f-31aa-86bc-77e63ac7cd8e",
                        "entry_id": "af34f9c6-626f-3f7c-8209-ab1018949b5c",
                        "glosses": [
                            "Femme conservant, bien après le mouvement de mai 1968 en France, la culture, les modes de vie des participants à ce mouvement."
                        ],
                        "tags": [
                            "Par dérision"
                        ],
                        "examples": [
                            {
                                "example_id": "94cc40a9-47e5-4384-8ef1-58af1e7847a0",
                                "sense_id": "6f5abc5e-ce0f-31aa-86bc-77e63ac7cd8e",
                                "text": "Sa blouse était assortie au bermuda en jeans qui mettait en valeur ses grandes jambes couvertes de poussière en ce début d’été. Ses pieds chaussaient une paire de sandales à lanières de couleur marron. On aurait dit une soixante-huitarde."
                            }
                        ]
                    }
                ],
