            "senses": [
                {
                    "sense_id": "939aca83-749c-31c3-bd6e-886b98428d65",
                    "sense_definition": "A monospace font that resembles the characters produced by a typewriter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Screenplays are traditionally written in 12-point <w>Courier</w> font.",
                            "target_lang_translations": {
                                "ru": "Киносценарии традиционно пишутся 12-м кеглем шрифта <w>Courier</w>.",
                                "zh": "电影剧本传统上使用 12 号 <w>Courier</w> 字体书写。"
                            }
                        },
                        {
                            "text": "The document was difficult to read because it was printed in <w>Courier</w>.",
                            "target_lang_translations": {
                                "ru": "Документ было трудно читать, потому что он был напечатан шрифтом <w>Courier</w>.",
                                "zh": "这份文件很难阅读，因为它使用的是 <w>Courier</w> 字体打印的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Courier font",
                        "Courier New"
                    ],
                    "target_lang_definitions": {
                        "ru": "Моноширинный шрифт, напоминающий символы печатной машинки.",
                        "zh": "一种类似于打字机字符的等宽字体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Courier",
                                "target_lang_sense_clarification": "название шрифта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Courier",
                                "target_lang_sense_clarification": "字体名称"
                            }
                        ]
                    }
                },
                {
