                            {
                                "target_lang_word": "драфт",
                                "target_lang_sense_clarification": "спортивный термин"
                            },
                            {
                                "target_lang_word": "отбор",
                                "target_lang_sense_clarification": "игроков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95cb6409-cf88-380d-b1b4-9c6dcdb47472",
                    "sense_definition": "The amount of liquid swallowed in one continuous act of drinking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a long <w>draft</w> of cold water after her long run.",
                            "target_lang_translations": {
                                "ru": "Она сделала долгий <w>глоток</w> холодной воды после долгой пробежки."
                            }
                        },
                        {
                            "text": "He finished the entire glass of juice in a single <w>draft</w>.",
                            "target_lang_translations": {
                                "ru": "Он выпил весь стакан сока одним <w>глотком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swig"
                    ],
                    "common_phrases": [
                        "deep draft",
                        "single draft"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often spelled 'draught' in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество жидкости, проглатываемое за один непрерывный акт питья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глоток",
                                "target_lang_sense_clarification": "однократное глотание"
