                "senses": [
                    {
                        "sense_id": "61aaf00a-ac0a-3694-9736-4e131f6044ab",
                        "entry_id": "0752eb9a-7df0-3de5-acb5-3207a5ae8257",
                        "glosses": [
                            "Polymère ramifié de dextrose de masse moléculaire très élevée, appartenant au groupe des colloïdes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947bde95-108b-49c8-b07b-2d3f6eb647be",
                                "sense_id": "61aaf00a-ac0a-3694-9736-4e131f6044ab",
                                "text": "Nous avons étudié l’activité antiproliférative et antitumorale des dérivés du dextrane sur plusieurs lignées de cellules épithéliales mammaires humaines et tenté d’élucider leur mécanisme d’action."
                            },
                            {
                                "example_id": "e59e87fc-bed3-46c1-bdbe-d49bfd1a6d51",
                                "sense_id": "61aaf00a-ac0a-3694-9736-4e131f6044ab",
                                "text": "La dextrane-saccharase DSR-S de Leuconostoc mesenteroides NRRL B-512F catalyse à partir de saccharose la synthèse d’un polymère d’unités glucosyle appelé dextrane, dont plus de 95% des liaisons sont de type alpha-1,6."
                            },
                            {
                                "example_id": "d3ecc1a3-33ec-4f32-8cb4-bf40f1a93a80",
                                "sense_id": "61aaf00a-ac0a-3694-9736-4e131f6044ab",
                                "text": "Les dextranes amphiphiles sont obtenus par réaction d’un époxyalcane sur les groupements hydroxyles des motifs glucose."
                            }
                        ]
                    }
                ],
