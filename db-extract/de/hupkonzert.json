                ],
                "senses": [
                    {
                        "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                        "entry_id": "814ed7dd-9ce7-3ba6-8f50-996e60fad248",
                        "glosses": [
                            "spontan einsetzendes und zunächst unkoordiniertes, fortwährendes Hupen mehrerer (mit Ungeduld auf die Weiterfahrt wartender) Kraftfahrer"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "626fa0c3-7bd1-4945-b385-17431077af71",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„In die wilden Schreie der amerikanischen Kinder, die sich vor Entzücken über die Launen des Stromes kaum fasse[n] konnten, mischte sich das Geklick zahlloser Kameras und das Hupkonzert der Fahrzeuge.“"
                            },
                            {
                                "example_id": "8fa2f1a0-f82c-412e-8216-312256bafde1",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Auch das nach längerer Wartezeit einsetzende Hupkonzert der hinter mir wartenden Kraftfahrzeuge, an dem sich — das sei ausdrücklich festgestellt — der Fahrer des Dienstkraftwagens nicht beteiligt hat, konnte ihn aus seiner Versunkenheit nicht aufwecken.“"
                            },
                            {
                                "example_id": "db6bc879-b40c-49ca-944d-adff5c020ead",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Die Fahrer in der ständig hinter uns wachsenden Autoschlange fingen an, allmählich ungeduldig zu werden, und stimmten ein wütendes Hupkonzert an.“"
                            },
                            {
                                "example_id": "8c997c8e-9445-4466-8621-b066b7a9eacf",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Auch auf dem Prenzlauer Berg knallten wie überall in der DDR sonst nur zu Silvester um Mitternacht Böllerschüsse, stiegen Feuerwerkskörper in den Himmel, riefen Menschen ‚Hurra‘ und sangen ‚so ein Tag, so wunderschön wie heute‘, wurden unzählige Sektflaschen geköpft, hier und dort formierte sich ein Autocorso zum Hupkonzert.“"
                            },
                            {
                                "example_id": "42f8ac76-8bce-4946-b90e-bd9e539cdf59",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Wir steigen aus zu den Klängen eines Hupkonzerts und umrunden prüfend die Blechmelange.“"
                            },
                            {
                                "example_id": "d6143b8b-a9e4-4a49-8051-aebfe76ef6a5",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Von überall strömten mit Fahnen, Trikots und Narrenkappen ausgerüstete, jubelnde, singende Menschen auf die Straße, mit Hupkonzerten unterstützten die Autofahrer die Schlachtgesänge der Fans.“"
                            },
                            {
                                "example_id": "dc518fa1-5749-4ca3-886e-ebfcecc88b72",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Die Hupkonzerte in der Stadt verdünnten sich gegen drei Uhr früh zu vereinzeltem Getröte.“"
                            },
                            {
                                "example_id": "d90a2351-227b-4c87-a76c-2fb61d5a319d",
                                "sense_id": "74c05699-b231-3c96-abef-49bf27bd7344",
                                "text": "„Wiederholt habe der Bus zurückrangieren müssen, weil sich trotz eines Hupkonzertes niemand bemüßigt sah, seinen Wagen wegzufahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
