                "senses": [
                    {
                        "sense_id": "bbd7c54a-11a6-3be8-b7bb-7495c6e519f1",
                        "entry_id": "548eacbd-91c5-32bc-94ae-459ae7b36eeb",
                        "glosses": [
                            "Frau, die gerne Klatsch und Tratsch verbreitet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b4cff21c-cb87-469b-a231-6ab6d0cb08cc",
                                "sense_id": "bbd7c54a-11a6-3be8-b7bb-7495c6e519f1",
                                "text": "Wenn du das Neueste wissen willst, geh zu Frau Kaske. Sie ist die größte Klatschbase hier im Haus."
                            },
                            {
                                "example_id": "505dcacb-a1b2-493a-bc87-4a2fd8be19e0",
                                "sense_id": "bbd7c54a-11a6-3be8-b7bb-7495c6e519f1",
                                "text": "„Auf unser Nachfragen wurde uns das Geheimnis erklärt: die Eingeborenen sind solche ausgemachten Klatschbasen, daß sie an keinem Haus vorbeigehen, ohne stehenzubleiben und ein Schwätzchen zu halten…“"
                            },
                            {
                                "example_id": "fc6e1ac5-66c3-4057-a1b2-880ef603656c",
                                "sense_id": "bbd7c54a-11a6-3be8-b7bb-7495c6e519f1",
                                "text": "„Ihnen gesellten sich die Klatschbasen und Klatschvettern hinzu, deren Blick über den Topf in der Nachbarsecke nicht hinausging, um mit neidgeschwollener Zunge in der ungreifbaren Sprache des Gerüchts zu reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed4df649-ef90-4e40-b3ab-59b269deb8e4",
                        "source_entry_id": "548eacbd-91c5-32bc-94ae-459ae7b36eeb",
                        "source_sense_id": "bbd7c54a-11a6-3be8-b7bb-7495c6e519f1",
                        "source_sense_description": "umgangssprachlich: Frau, die gerne Klatsch und Tratsch verbreitet",
                        "target_lang_word": "pipelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pipelette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                        "entry_id": "c33b36c1-2416-3b74-add3-27e1ccf5effc",
                                        "glosses": [
                                            "Personne bavarde voire indiscrète."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ced98f3e-345c-474f-8155-39ba57aab566",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Les enfants, on sait ce que c’est, n’est-ce pas ! On peut le répéter : des braillards, des insolents, des crève-culotte, côté garçons ; des sournoises, des mijaurées, de petites pipelettes, côté filles."
                                            },
                                            {
                                                "example_id": "b9738bb9-2eec-4772-8daf-657e5be7660d",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Elle me l’a donné parce que c’était celui d’une de ses tantes préférées, mais ça rime en “ette”, comme pipelette, allumette et claquette."
                                            },
                                            {
                                                "example_id": "a5dc6a05-2ba1-42ab-8623-3046a959f864",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Il/Elle n’arrête jamais de parler, c’est une véritable pipelette."
                                            },
                                            {
                                                "example_id": "170e2f36-0df6-41a0-be94-03ed66c48ac8",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Caroline et Éric sont de véritables pipelettes avec un grand P."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beba02a1-4a85-3a7a-b054-dbe6c12952fb",
                                        "entry_id": "c33b36c1-2416-3b74-add3-27e1ccf5effc",
                                        "glosses": [
                                            "Concierge."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc77e903-0c68-4ac6-909d-41ebab53a5df",
                                                "sense_id": "beba02a1-4a85-3a7a-b054-dbe6c12952fb",
                                                "text": "Il s’rend aux endroits en question et passe la loge d’la cloporte, une serviette sous le bras. « Eh bien ! crie la pip'lette, où qu’vous aller ? » — (Francis Carco, Messieurs les vrais de vrai, Les Éditions de France, Paris, 1927)"
                                            },
                                            {
                                                "example_id": "2bd065d4-2474-48df-acfe-0e4f124c1b75",
                                                "sense_id": "beba02a1-4a85-3a7a-b054-dbe6c12952fb",
                                                "text": "Contrairement à la tradition qui représente les pipelettes sous des traits carabosses, c’est une aimable dame, jeune et tuberculeuse, qui nous ouvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84b46a33-9dfb-400e-a5b1-d369bc3deb5f",
                        "source_entry_id": "548eacbd-91c5-32bc-94ae-459ae7b36eeb",
                        "source_sense_id": "bbd7c54a-11a6-3be8-b7bb-7495c6e519f1",
                        "source_sense_description": "umgangssprachlich: Frau, die gerne Klatsch und Tratsch verbreitet",
                        "target_lang_word": "commère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04b3d67c-724e-3358-b89f-d14d5b0ebb5d",
                                        "entry_id": "1d656e09-7f9d-3b35-96be-23396ce88606",
                                        "glosses": [
                                            "Personne qui est la marraine d’un même enfant, du point de vue du parrain, du père et de mère de l’enfant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dbab45a-e6b9-4d7b-a96e-5cc6974d7301",
                                                "sense_id": "04b3d67c-724e-3358-b89f-d14d5b0ebb5d",
                                                "text": "SUZANNE. Mes amis, je vous présente le nouveau fermier de Gros-Bois.\nNANETTE, à André. Na !… quand je vous avais dit que vous seriez content d’la commère que je vous donn’ra,\nANDRÉ, à Landuriau. Si je suis parrain aujourd’hui, c’est à charge de revanche, et je te le promets avant un an… Partons pour le baptême… Ma commère, voulez-vous permettre ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1abc06b-2959-3b4c-88d4-64e6d22e7932",
                                        "entry_id": "1d656e09-7f9d-3b35-96be-23396ce88606",
                                        "glosses": [
                                            "Femme bavarde, qui aime jaser, médire d’autrui."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "note": "On peut l’appliquer aux hommes",
                                        "examples": [
                                            {
                                                "example_id": "323e6b47-07f2-45a8-8e82-989df60acc79",
                                                "sense_id": "a1abc06b-2959-3b4c-88d4-64e6d22e7932",
                                                "text": "Mettons dans la même classe les dialecticiens et les sophistes, gens qui font plus de bruit que tous les chaudrons de Dodone, et dont le moins babillard pourrait tenir tête aux vingt plus bavardes commères qu'on puisse trouver sous le ciel."
                                            },
                                            {
                                                "example_id": "b97cbde4-48b4-4af2-8457-b4fc08876dfc",
                                                "sense_id": "a1abc06b-2959-3b4c-88d4-64e6d22e7932",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "065a0485-12d8-48fb-acc6-f3240aaeacea",
                                                "sense_id": "a1abc06b-2959-3b4c-88d4-64e6d22e7932",
                                                "text": "[…] il accueillit d’un air enjoué et d’une âme égale l’annonce câlinement faite par la Julie d’une paternité future et les sourires des voisins, les cancans des commères et jusqu’aux plaisanteries égrillardes du maire […]."
                                            },
                                            {
                                                "example_id": "c84ce9b2-c421-40dc-afac-ef5c538d1c45",
                                                "sense_id": "a1abc06b-2959-3b4c-88d4-64e6d22e7932",
                                                "text": "Toi, il faut que tu saches tout, parce que tu as un esprit de commère, d’espincheur, et de bazarette."
                                            },
                                            {
                                                "example_id": "31de5972-a17f-4ee6-a0de-474c90c8ffc0",
                                                "sense_id": "a1abc06b-2959-3b4c-88d4-64e6d22e7932",
                                                "text": "– La classe est encore vide, je suis seule à mon rang et derrière moi sont assises les deux plus mauvaises élèves de la classe, des commères inséparables, toujours en train de chuchoter entre elles, d’échanger des coups d’œil, de ricaner…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbdf1ea4-9fdb-337a-8724-38418b293cd0",
                                        "entry_id": "1d656e09-7f9d-3b35-96be-23396ce88606",
                                        "glosses": [
                                            "Appellation familière, entre gens du peuple qui ont des relations fréquentes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7829ba1-3aef-4428-b05a-9e7ca543138e",
                                                "sense_id": "fbdf1ea4-9fdb-337a-8724-38418b293cd0",
                                                "text": "Avec ou sans patente — la loi l'y autorisait peut-être à l'époque, et de toute manière il y a prescription — elle tenait dans sa vaste cuisine un lot de marchandises épicières qu'elle débitait aux commères du voisinage."
                                            },
                                            {
                                                "example_id": "17b6d87a-6514-43e3-9f81-901bfc5520b6",
                                                "sense_id": "fbdf1ea4-9fdb-337a-8724-38418b293cd0",
                                                "text": "L’onde était transparente ainsi qu’aux plus beaux jours ;\nMa commère la carpe y faisait mille tours\nAvec le brochet son compère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b663043f-7913-3cab-aef0-c19ec4adde6c",
                                        "entry_id": "1d656e09-7f9d-3b35-96be-23396ce88606",
                                        "glosses": [
                                            "Femme du peuple qui a de la tête, une femme hardie, que rien ne rebute, une maîtresse femme."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69ee54f-1f85-4ad4-bd15-ddb5f58d7275",
                                                "sense_id": "b663043f-7913-3cab-aef0-c19ec4adde6c",
                                                "text": "Une commère dont la chemise très courte cachait mal les rondeurs, m'accueillit et, me poussant dans une pièce quasiment obscure, me confia d'un air canaille: […]."
                                            },
                                            {
                                                "example_id": "84bcba19-71b0-4d18-8c85-1194282db167",
                                                "sense_id": "b663043f-7913-3cab-aef0-c19ec4adde6c",
                                                "text": "Napoléon Bayet s'y est installé tout aussitôt après la guerre ; il y a ramené sa commère, et six enfants lui sont nés : […]."
                                            },
                                            {
                                                "example_id": "ba7e5618-a948-4e27-88f1-d15a9a24b10d",
                                                "sense_id": "b663043f-7913-3cab-aef0-c19ec4adde6c",
                                                "text": "Cette gamine vicieuse et prétentieuse est la fille d'une grosse commère qui tenait, naguère, une fruiterie dans les environs du Barbès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d56bcd-2209-3467-bbdd-202c719fee78",
                                        "entry_id": "1d656e09-7f9d-3b35-96be-23396ce88606",
                                        "glosses": [
                                            "Les deux personnages principaux d’une revue. → voir compère"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b584723-8e68-4435-9dfb-91b270cc7d15",
                                                "sense_id": "71d56bcd-2209-3467-bbdd-202c719fee78",
                                                "text": "Tandis que Joséphine Balsamo s’apprêtait, il apprit par une ouvreuse que la commère de la revue, Brigitte Rousselin, habitait une ancienne maison de Montmartre, d’où chaque jour, avec une vieille femme de chambre très dévouée, du nom de Valentine, elle descendait pour assister aux répétitions de la prochaine pièce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3465a5c4-c714-31c5-a8db-61ab2227fb5d",
                                        "entry_id": "1d656e09-7f9d-3b35-96be-23396ce88606",
                                        "glosses": [
                                            "Animatrice d’une revue."
                                        ],
                                        "tags": [
                                            "Music-hall"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
