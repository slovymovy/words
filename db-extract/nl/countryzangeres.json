                        "examples": [
                            {
                                "example_id": "179ed08a-842d-4070-bbdc-859aef401ddc",
                                "sense_id": "8728b9d2-9a37-367b-861f-2a92a00aca7e",
                                "text": "De Amerikaanse countryzangeres Lynn Anderson is op 67-jarige leeftijd overleden aan een hartaanval. Ze was vooral bekend van de hit (I never promised you a) Rose Garden uit 1970, waarvoor ze een Grammy Award kreeg. Het nummer was oorspronkelijk van singer-songwriter Joe South."
                            },
                            {
                                "example_id": "a7b68e70-a4c2-4e85-b653-efd98307d875",
                                "sense_id": "8728b9d2-9a37-367b-861f-2a92a00aca7e",
                                "text": "The Passion, gebaseerd op de Nederlandse versie, werd dit jaar voor het eerst opgevoerd in de VS, in de stad New Orleans. Jezus werd gespeeld door soapster Jencarlos Canela, countryzangeres Trisha Yearwood was Maria en Seal speelde Pontius Pilatus. Zij zongen popnummers van onder anderen Whitney Houston, Creed en Train, die door de religieuze setting een andere betekenis kregen."
                            }
                        ]
                    }
