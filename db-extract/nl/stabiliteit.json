                                "target_senses": [
                                    {
                                        "sense_id": "6e86af7b-e2c5-3a7a-9eed-65b7cb97f103",
                                        "entry_id": "f2712c6d-5461-3e84-8c87-2a1e3b593952",
                                        "glosses": [
                                            "The condition of being stable or in equilibrium, and thus resistant to change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501ff07f-bbd6-4ccf-9242-6913fa03ede7",
                                                "sense_id": "6e86af7b-e2c5-3a7a-9eed-65b7cb97f103",
                                                "text": "This platform offers good stability"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                        "entry_id": "f2712c6d-5461-3e84-8c87-2a1e3b593952",
                                        "glosses": [
                                            "The tendency to recover from perturbations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b1a7e9-fee2-4df5-b8bc-8f232a72a867",
                                                "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                                "text": "emotional stability"
                                            },
                                            {
                                                "example_id": "88de0018-4a11-451e-a74f-bfc0cbc17a6e",
                                                "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                                "text": "Globalization has re-ordered the global economy in ways that are destructive to civic stability, as decentralized, localized producers cannot compete with globalized, commoditized crops, capital, labor and goods."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
