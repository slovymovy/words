                                "target_senses": [
                                    {
                                        "sense_id": "7721f580-43d7-3df2-aa0a-639e8246f3dd",
                                        "entry_id": "ef8fa7a8-e19f-3836-aa18-613680fe365b",
                                        "glosses": [
                                            "женск. к охотник (I)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6541494e-1ecb-4c89-bae0-a29c29077931",
                                                "sense_id": "7721f580-43d7-3df2-aa0a-639e8246f3dd",
                                                "text": "Я хочу находиться в пути. Я ― охотница, а не смиренная дичь. Я сама выбираю."
                                            },
                                            {
                                                "example_id": "48b15af6-c6e0-4754-aa0c-6a21f2508e17",
                                                "sense_id": "7721f580-43d7-3df2-aa0a-639e8246f3dd",
                                                "text": "Зеленая охотница тут же снова свернулась для броска, но… то ли добыча показалась ей слишком крупной, то ли змея наконец увидела меня и испугалась."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "охотница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0313c3e2-04dd-3120-84f8-52dd0a490dc7",
                                        "entry_id": "9c01a37f-e81e-32e0-84f3-b42ddd1c965d",
                                        "glosses": [
                                            "женск. к охотник II; то же, что любительница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb027b0-a578-444d-ae17-33564254f584",
                                                "sense_id": "0313c3e2-04dd-3120-84f8-52dd0a490dc7",
                                                "text": "Верочка, что с тобой? разве ты охотница плакать? когда ж это с тобой бывает? что ж это с тобой?"
                                            }
                                        ]
                                    }
                                ]
                            }
