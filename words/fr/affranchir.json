    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cbaadbbe-2c17-3d85-b151-0990c21b1a7f",
                    "sense_definition": "Payer les frais de port d'un courrier ou d'un paquet en y collant un timbre ou une marque postale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas d'<w>affranchir</w> cette lettre avant de la déposer dans la boîte aux lettres."
                        },
                        {
                            "text": "L'employé de la poste lui a montré comment <w>affranchir</w> le colis avec la machine automatique."
                        }
                    ],
                    "synonyms": [
                        "timbrer"
                    ],
                    "common_phrases": [
                        "affranchir une lettre",
                        "affranchir un colis"
                    ]
                },
                {
                    "sense_id": "500bd263-33a4-3137-83df-a7b40c0a62d1",
                    "sense_definition": "Rendre juridiquement libre une personne assujettie à l'esclavage ou au servage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la Rome antique, un maître pouvait <w>affranchir</w> son esclave par un acte officiel."
                        },
                        {
                            "text": "Ce décret historique a permis d'<w>affranchir</w> des milliers de personnes soumises au servage."
                        }
                    ],
                    "synonyms": [
                        "émanciper",
                        "libérer"
                    ],
                    "antonyms": [
                        "asservir"
                    ],
                    "common_phrases": [
                        "affranchir un esclave"
                    ]
                },
                {
                    "sense_id": "0bd7a368-19b4-36b8-8d8a-236f28341dc3",
                    "sense_definition": "Délivrer une personne d'une contrainte, d'une obligation, d'une peine ou d'une sujétion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La signature de ce contrat permet d'<w>affranchir</w> les deux entreprises de leurs obligations antérieures."
                        },
                        {
                            "text": "Son aide précieuse m'<w>affranchit</w> d'un travail administratif particulièrement long et difficile."
                        }
                    ],
                    "synonyms": [
                        "délivrer",
                        "dispenser",
                        "exempter"
                    ],
                    "antonyms": [
                        "assujettir",
                        "contraindre"
                    ],
                    "common_phrases": [
                        "affranchir d'une obligation"
                    ]
                },
                {
                    "sense_id": "e6af9bce-fbbc-3c00-b356-95a6f3b276f8",
                    "sense_definition": "Se soustraire à une tutelle, à une autorité morale ou à des conventions restrictives.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune peintre a cherché à s'<w>affranchir</w> des traditions académiques pour inventer son propre style."
                        },
                        {
                            "text": "Cette nation a lutté pendant des décennies afin de s'<w>affranchir</w> d'un régime particulièrement oppressif."
                        }
                    ],
                    "synonyms": [
                        "s'émanciper",
                        "se libérer"
                    ],
                    "antonyms": [
                        "se soumettre"
                    ],
                    "common_phrases": [
                        "s'affranchir des règles",
                        "s'affranchir des contraintes",
                        "s'affranchir des codes"
                    ]
                },
                {
                    "sense_id": "0ddd4928-f72b-3b98-9e7b-81a3c2afc957",
                    "sense_definition": "Informer quelqu'un de faits confidentiels ou le mettre au courant d'une situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant la réunion avec les enquêteurs, il a voulu m'<w>affranchir</w> sur le comportement du suspect."
                        },
                        {
                            "text": "Mon collègue m'a vite <w>affranchi</w> sur les rivalités internes qui divisaient le service."
                        }
                    ],
                    "synonyms": [
                        "briefer",
                        "renseigner",
                        "tuyauter"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre familier ou argotique"
                        }
                    ]
                }
            ]
        }
