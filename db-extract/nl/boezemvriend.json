                                        ]
                                    },
                                    {
                                        "sense_id": "aec1b12a-9ee8-31f0-b96a-d8b47336b432",
                                        "entry_id": "c7e726a7-d4ca-312b-86c8-2a0a81cb7af2",
                                        "glosses": [
                                            "An informal and friendly address to a stranger, usually male; a friendly (or occasionally antagonistic) placeholder name for a person one does not know."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66bb7cd-78b8-4e8e-a868-99e33bbac335",
                                                "sense_id": "aec1b12a-9ee8-31f0-b96a-d8b47336b432",
                                                "text": "Hey, buddy, I think you dropped this."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20af575f-80f0-3438-b9d5-9642df523db2",
                                        "entry_id": "1279c245-105f-3ce7-8ada-fb835a9de7bd",
                                        "glosses": [
