                    }
                ],
                "senses": [
                    {
                        "sense_id": "1015f68b-407b-3f6c-878d-64e3fbca29d8",
                        "entry_id": "6323d2dd-ee2b-3938-a3bd-a210b1fb9d27",
                        "glosses": [
                            "Qui provoque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c92bc20-b355-4b47-950a-7626630efa1c",
                                "sense_id": "1015f68b-407b-3f6c-878d-64e3fbca29d8",
                                "text": "Il avait un rire d’enfant très doux et bête à ravir, un rire plein de grâces, provocant, vous donnant de mauvais frissons."
                            },
                            {
                                "example_id": "327fa370-1490-42e5-bb3f-df27b88c9cab",
                                "sense_id": "1015f68b-407b-3f6c-878d-64e3fbca29d8",
                                "text": "La porte s’était ouverte et, en même temps que Cogolin disparaissait, une jeune fille au regard effronté, au sourire provocant, à la fraîche et radieuse beauté, entra !"
                            },
                            {
                                "example_id": "4a08bb15-90fd-4554-abb7-08a4006e30b3",
                                "sense_id": "1015f68b-407b-3f6c-878d-64e3fbca29d8",
                                "text": "À l'approche des vagos, les travs déchaînés aux tenues provocantes se mettent à siffler, exhibent leur tarpéou carrément leur gourdin. Perso, ce spectacle me donne la nausée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e077ec7-2dc0-4dc1-acc5-70b818b89c7c",
                        "source_entry_id": "6323d2dd-ee2b-3938-a3bd-a210b1fb9d27",
                        "source_sense_id": "1015f68b-407b-3f6c-878d-64e3fbca29d8",
                        "source_sense_description": "Qui provoque",
                        "target_lang_word": "provokant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provokant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30d8dc05-fffd-32e0-84e8-863228fe7f4f",
                                        "entry_id": "8d19a5c2-595d-3b28-945a-354542914c64",
                                        "glosses": [
                                            "so, dass es andere zu Abwehrreaktionen veranlassen kann oder soll"
                                        ],
                                        "tags": [
                                            "Eigenschaft einer Handlung oder eines Verhaltens"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2b79b1-e777-4de5-9ebd-1e1f2fd9da67",
                                                "sense_id": "30d8dc05-fffd-32e0-84e8-863228fe7f4f",
                                                "text": "Sein Verhalten war provokant."
                                            },
                                            {
                                                "example_id": "f4193bef-c030-48f3-bc65-7118a5e13540",
                                                "sense_id": "30d8dc05-fffd-32e0-84e8-863228fe7f4f",
                                                "text": "Schon das provokante Gesicht allein ließ Martin an einen Feuermelder denken."
                                            },
                                            {
                                                "example_id": "c4f61421-2e0d-46e5-a276-822c2dc933b0",
                                                "sense_id": "30d8dc05-fffd-32e0-84e8-863228fe7f4f",
                                                "text": "„Deshalb wurden die 02er-Modelle rasch nachgeschoben, zweitürige Klein-Rabauken mit scharfen Vierzylindern, bis hin zum provokanten BMW 2002 Turbo, der mit seiner pubertierenden Modellbezeichnung in Spiegelschrift auf dem vorderen Spoiler („Kriegsbemalung“) für das Überholprestige sorgen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf8b1a80-497d-4bfd-a934-f00829af9493",
                        "source_entry_id": "6323d2dd-ee2b-3938-a3bd-a210b1fb9d27",
                        "source_sense_id": "1015f68b-407b-3f6c-878d-64e3fbca29d8",
                        "source_sense_description": "Qui provoque",
                        "target_lang_word": "provocative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provocative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22a49219-efb0-39d7-baea-370da933ddc1",
                                        "entry_id": "3e9be939-c436-34a7-99f8-04ff9b80bf5c",
                                        "glosses": [
                                            "Serving or tending to elicit a strong, often negative sentiment in another person; exasperating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bae42c6-3dda-354d-b1cf-410772d1a920",
                                        "entry_id": "3e9be939-c436-34a7-99f8-04ff9b80bf5c",
                                        "glosses": [
                                            "Serving or tending to excite, stimulate or arouse sexual interest; sexy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c5eea8a-1721-34ce-af25-76ef859db627",
                                        "entry_id": "3e9be939-c436-34a7-99f8-04ff9b80bf5c",
                                        "glosses": [
                                            "Provoking or triggering any response."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b171e42d-b7f2-4a58-aaeb-8c92daf59b24",
                                                "sense_id": "6c5eea8a-1721-34ce-af25-76ef859db627",
                                                "text": "[I]t is a terrible long and slippery descent, and a shocking bad road. At the bottom, however, there is a pleasant public; whereat we must really take a modest quencher, for the down air is provocative of thirst."
                                            },
                                            {
                                                "example_id": "8099ef3e-73a1-4d62-a1e0-58f66be4d3e2",
                                                "sense_id": "6c5eea8a-1721-34ce-af25-76ef859db627",
                                                "text": "And the ‘wailing noise,’ which had induced the prosaic, indurated London cabman to get twice off his box to see what was the matter, what anguish had been provocative of that?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "provocative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                        "entry_id": "b5218580-09ab-3b4f-8e25-0105f2a318d1",
                                        "glosses": [
                                            "Something that provokes an appetite, especially a sexual appetite; an aphrodisiac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ee46ba-730f-4253-898a-ddad71c5800d",
                                                "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                                "text": "She used by way of Provocative, to read the wanton Verses of her Paramour in the day time [...]."
                                            },
                                            {
                                                "example_id": "5442ac11-ad0e-418f-bd07-5a8a1360e519",
                                                "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                                "text": "[A]nd that one great and all-important occasion and provocative of these beliefs was actually the rise of self-consciousness — that is, the coming of the mind to a more or less distinct awareness of itself and of its own operation, and the consequent development and growth of Individualism, and of the Self-centred attitude in human thought and action."
                                            },
                                            {
                                                "example_id": "c4bbf79e-0544-430e-a871-8b8095a122a1",
                                                "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                                "text": "In Turkey, Iran, and Syria salep is popular as a restorative and also as a provocative to amatory activity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
