                        ],
                        "form": "dem Kunstturnen"
                    },
                    {
                        "form_id": "ea62b6c8-15ff-422b-a6a1-d22fc137eeec",
                        "entry_id": "3661eac8-075d-322c-88f0-846b6fb761fc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Kunstturnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                        "entry_id": "3661eac8-075d-322c-88f0-846b6fb761fc",
                        "glosses": [
                            "wettkampfmäßiges Turnen an Geräten oder dem Boden mit (meist sehr) schwierigen Elementen, die von Kampfrichtern bewertet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef25d720-54b9-4b3d-8e5c-0b42f972121c",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "Die einzelnen Disziplinen des Kunstturnens sind: Boden, Barren, Pauschenpferd (Pferd), Pferdsprung, Reck, Ringe, Schwebebalken und Stufenbarren."
                            },
                            {
                                "example_id": "ad6e6ffd-408d-4d7d-bd2d-93915257c0d0",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Er nahm an den Olympischen Spielen 1980 in Moskau in allen Disziplinen des Kunstturnens teil und gewann mit der ungarischen Mannschaft die Bronzemedaille im Mannschaftsmehrkampf.“"
                            },
                            {
                                "example_id": "41874d84-c56e-4bda-b39e-34fc447aec23",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Kunstturnen ist eine olympische Disziplin der ersten Stunde: schon 1896 - bei den ersten Spielen der Neuzeit in Athen - kämpften die Männer an Barren, Reck, Seitpferd und im Pferdsprung um den Titel.“"
                            },
                            {
                                "example_id": "9f48d54f-7982-4bce-be01-ba6f2b156c77",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Lange Zeit war das Kunstturnen bei Olympischen Spielen eine reine Männerdomäne.“"
                            },
                            {
                                "example_id": "50150060-12d6-4ffc-a27b-b4d0e9c0e3be",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "[6. Mai 1990:] „Die Sowjetrussin Swetlana Boginskaja gewinnt bei den Europameisterschaften im Kunstturnen in Athen alle fünf zu vergebenden Titel.“"
                            },
                            {
                                "example_id": "e7584dac-51b0-4568-bcfa-527359fd6d9f",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Im norwegischen Skien wird die 13-jährige Rumänin Nadia Comaneci vierfache Europameisterin im Kunstturnen.“"
                            },
                            {
                                "example_id": "9918719f-f1d4-404f-aed6-a295d5bf035a",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Der TV Wetzgau wurde 2013 Deutscher Meister im Kunstturnen.“"
                            },
                            {
                                "example_id": "9b2a4740-c1d0-4c79-969d-3f47a514ec7b",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Der Thuner Ernst Fivian gewann an den Olympischen Spielen in Helsinki 1952 Silber im Kunstturnen.“"
                            },
                            {
                                "example_id": "acad8aa5-d3f9-488e-aae1-cb4e21c5f7cb",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Seit 2012 arbeitet sie als Cheftrainerin des Bereichs Kunstturnen im Gym Center Emme in Utzenstorf.“"
                            },
                            {
                                "example_id": "32580da1-1b43-42c6-be02-dc5c900758a8",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Über 50 Prozent der rund 1.600 Cirque-du-Soleil-Artisten kommen aus dem Leistungssport, die meisten aus dem Kunstturnen.“"
                            },
                            {
                                "example_id": "e7eb8588-5d52-477a-80e9-b68985725dcf",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Es gibt nichts in den Regeln des Turnens, was Frauen daran hindert, Ganzkörper-Outfits zu tragen, doch der Leotard - ein hautenger einteiliger Turnanzug mit nackten Beinen, hat sich in den letzten Jahren beim Kunstturnen etabliert.“"
                            },
                            {
                                "example_id": "24711b5d-380a-497b-80e7-012993964d8a",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "[Olympische Spiele 2024 in Paris: …] „Verkauf der Tickets: Was den Interessierten, die sich dafür eingeschrieben hatten, Mitte Mai zum Kauf angeboten wurde, überstieg in vielen Fällen bei Weitem ihr Budget: 680 Euro für einen Platz bei Leichtathletikanlässen, 480 Euro beim Kunstturnen und 2.700 Euro für einen Sitzplatz bei der Eröffnung.“"
                            },
                            {
                                "example_id": "0688085a-a5e4-4059-a3d6-9fa6be5d0d58",
                                "sense_id": "ffa88561-a17e-334e-b6c0-c9e8d294e768",
                                "text": "„Im Programm sämtlicher Sommerspiele enthalten waren Leichtathletik, Schwimmen, Fechten und Kunstturnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
