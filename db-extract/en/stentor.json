        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1a403938-3a3d-31a1-8615-5f61fa4e61d1",
                "word": "Stentor",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96671bb6-e567-344b-bb43-bfcd1e2c2ae6",
                        "entry_id": "1a403938-3a3d-31a1-8615-5f61fa4e61d1",
                        "glosses": [
                            "A herald in the Iliad celebrated for his loud voice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2776dd8d-2011-4d25-b3d4-a14bda8de812",
                                "sense_id": "96671bb6-e567-344b-bb43-bfcd1e2c2ae6",
                                "text": "For who can be the general of such a vast multitude, or who the herald, unless he have the voice of a Stentor?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c64b7aeb-6f4d-330d-8648-051821c41eb3",
                        "entry_id": "1a403938-3a3d-31a1-8615-5f61fa4e61d1",
                        "glosses": [
                            "The Jovian asteroid 2146 Stentor."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                "word": "stentor",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aaf40684-3c5e-47c1-b143-1c96e4fa533b",
                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                        "tags": [
                            "plural"
                        ],
                        "form": "stentors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67b6a2ae-5e57-39d7-acf1-be8f21a70f3c",
                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                        "glosses": [
                            "A person with a powerful or stentorian voice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1d1100-66bf-4e7d-924e-2afed868347b",
                                "sense_id": "67b6a2ae-5e57-39d7-acf1-be8f21a70f3c",
                                "text": "1609, Ben Jonson, Epicoene Act IV, Scene II, 1989, Johanna Procter (editor), The Selected Plays of Ben Jonson, Volume 1, page 381,\nRogues, hellhounds, Stentors, out of my doors, you sons of noise and tumult, begot on an ill May Day, or when the galley-foist is afloat to Westminster!"
                            }
                        ]
                    },
                    {
                        "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                        "glosses": [
                            "Any protozoan of the genus Stentor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b2e06c-88ae-43c1-82e5-3d6ce7fc1d19",
                                "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                "text": "Ere long a solitary amœba and stentor were found engaged in a struggle, which continued for some time with varying success, finally ending with the escape of the latter."
                            },
                            {
                                "example_id": "81e7379a-703d-4388-91cc-d6f65857397a",
                                "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                "text": "When the stentors become too numerous it is a simple matter to subdivide the culture and add the requisite amount of spring water to each culture."
                            },
                            {
                                "example_id": "5e775b13-7ec6-406c-b835-730c6ae0d7d4",
                                "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                "text": "It can be an irritant even for humans and is certainly toxic to tiny animals like stentor. He added carmine to the water tank in which the stentor was living, and simply watched to see what happened."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4792db8-1070-360e-9351-9b0f9b516e25",
                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                        "glosses": [
                            "A part of the amplification system of a carillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052fa351-542c-4ccb-b418-4f6738c8eee3",
                                "sense_id": "b4792db8-1070-360e-9351-9b0f9b516e25",
                                "text": "The unit is completely automatic in operation and tower stentors, matching the power output of the amplifier, are provided for roof or tower mounting."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5c1b9bf-ab12-3d91-979b-e1de45693341",
                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                        "glosses": [
                            "A howler monkey."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
