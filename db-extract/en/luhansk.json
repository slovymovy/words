                        "cross_references": [
                            {
                                "target_word": "Louhansk",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                        "entry_id": "52962e3a-e8d0-376f-b73a-a15cf3405743",
                                        "glosses": [
                                            "Ville d’Ukraine, capitale administrative de l’oblast de Louhansk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8098f0-8c06-42ff-a909-d4348c42b407",
                                                "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                                "text": "Les drapeaux russes sont installés aux fenêtres d’un immeuble à Louhansk, le 27 septembre 2022."
                                            },
                                            {
                                                "example_id": "20fe92b7-9a96-4d9b-a7f6-08f5f76e8e0d",
                                                "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                                "text": "Le gouvernement de Kiev lance, mercredi 14 mai, un « dialogue national » qui paraît bancal, tardif, et auquel n’assistent pas ceux qui ont mis en actes l’éclatement de l’autorité centrale : les séparatistes armés de Donetsk et de Louhansk."
                                            },
                                            {
                                                "example_id": "110c997a-625a-46fe-8066-a469f3d8538f",
                                                "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                                "text": "Ainsi, la Crimée, dès son annexion en mars 2014, puis les oblasts de Donetsk et de Louhansk, tenus par les séparatistes du Donbass, sont passés au rouble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea2bbd05-d5ff-3f80-a5c2-0b19b1bdad96",
                                        "entry_id": "52962e3a-e8d0-376f-b73a-a15cf3405743",
                                        "glosses": [
                                            "Oblast situé en Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0681f89-9533-482e-85e9-f1648c50a036",
                        "source_entry_id": "fb929f21-0769-3f09-9c50-a86df2323b4b",
                        "source_sense_description": "city",
                        "target_lang_word": "Lougansk",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lougansk",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ef2a1e6-a01b-363b-b5fb-5ba5d6dbc5cd",
                                        "entry_id": "2c55d932-b260-3dab-a708-1efb23946380",
                                        "glosses": [
                                            "Ville d’Ukraine, capitale administrative de l’oblast de Lougansk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5eefb41-70af-413f-83c0-e6584e71f665",
                                                "sense_id": "2ef2a1e6-a01b-363b-b5fb-5ba5d6dbc5cd",
                                                "text": "À Lougansk, le bâtiment de l’administration régionale a été occupé mardi soir par un groupe d’activistes armés pendant qu’une foule manifestait devant l’immeuble."
                                            },
                                            {
                                                "example_id": "decaf767-61d0-4be4-9c3a-3d0d223bb212",
                                                "sense_id": "2ef2a1e6-a01b-363b-b5fb-5ba5d6dbc5cd",
                                                "text": "Comme nous approchons de Lougansk, on m’appelle sur la plateforme du wagon d’arrière pour jouir d’un admirable coucher de soleil."
                                            },
                                            {
                                                "example_id": "3de629a1-3c70-4ecd-b84f-4fb41147be8c",
                                                "sense_id": "2ef2a1e6-a01b-363b-b5fb-5ba5d6dbc5cd",
                                                "text": "Les républiques de Donetsk et de Lougansk, reconnues indépendantes par Vladimir Poutine avant le début de la guerre, ainsi que les régions de Kherson et de Zaporijie, sont concernées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1ea1145-9064-35a2-824b-bd3b6701044d",
                                        "entry_id": "2c55d932-b260-3dab-a708-1efb23946380",
                                        "glosses": [
                                            "Oblast situé en Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a739244a-6e7d-4885-a864-d540e76bc03d",
                        "source_entry_id": "fb929f21-0769-3f09-9c50-a86df2323b4b",
