                                "target_senses": [
                                    {
                                        "sense_id": "dd6ab964-7f08-340b-af29-ce0a8c0d4c97",
                                        "entry_id": "8b1b3f96-2237-377d-b138-60dd7589356e",
                                        "glosses": [
                                            "uit de ruimte afkomstige steen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181c020f-4018-4cde-8506-d4673a2a9c8f",
                                                "sense_id": "dd6ab964-7f08-340b-af29-ce0a8c0d4c97",
                                                "text": "Het voorwerp dat in januari met hoge snelheid neerstortte in de Noord-Hollandse plaats Broek in Waterland blijkt een meteoriet te zijn geweest."
                                            },
                                            {
                                                "example_id": "b8c143c1-7421-425c-bf88-b511013bd5ec",
                                                "sense_id": "dd6ab964-7f08-340b-af29-ce0a8c0d4c97",
                                                "text": "Alle bouwstenen van DNA bereikten de aarde ooit via meteorieten"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b19557f8-e8d1-41b1-ae11-335bd15b1b39",
                        "source_entry_id": "bc774bb5-2d61-3507-a994-744d69b4c2a3",
                        "source_sense_id": "4d0c44d0-85e3-351a-9bcd-f45949943cf4",
                        "source_sense_description": "remains of a meteor",
                        "target_lang_word": "météorite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "météorite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b85dd7-0581-3d07-a45d-8e906022266e",
                                        "entry_id": "b55cccbd-73bc-3dff-8b60-ac0f766e2e7d",
                                        "glosses": [
                                            "Aérolithe, masse minérale, pierre tombée du ciel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef93eb7-3644-4a91-b133-fa914bc7bee4",
                                                "sense_id": "e5b85dd7-0581-3d07-a45d-8e906022266e",
                                                "text": "Par contre il faut arriver à prélever un microfragment du matériau, sans abîmer ta météorite."
                                            },
                                            {
                                                "example_id": "4fa966b2-0278-48df-a668-a6b16a7c7abb",
                                                "sense_id": "e5b85dd7-0581-3d07-a45d-8e906022266e",
                                                "text": "Un jour, elle m’apporte une pierre couleur de fer, lisse et lourde. C’est une météorite, et le contact de mes mains avec ce corps tombé du ciel il y a peut-être des millénaires me fait frissonner comme un secret."
                                            },
                                            {
                                                "example_id": "ad843b35-c10e-47aa-8ffa-661454959e5b",
                                                "sense_id": "e5b85dd7-0581-3d07-a45d-8e906022266e",
                                                "text": "Le fer sulfuré magnètique se trouve également dans le météorite, tantôt disséminé en petits grains, tantôt enchâssé, en amas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
