                        "entry_id": "78708af4-8103-37a4-a82d-d1c385296431",
                        "glosses": [
                            "pochodna kwasu fosforowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93a6843-141c-4d6a-8284-4e793106b96c",
                                "sense_id": "a050fbcc-baaa-33dd-a862-a2a5badc255e",
                                "text": "Stosowanie nawozów na bazie fosforanów wywołuje eutrofizację wód, w sensie – powoduje nadmierny wzrost glonów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77831cff-90fb-4c3a-90e8-5071029552cb",
                        "source_entry_id": "78708af4-8103-37a4-a82d-d1c385296431",
                        "source_sense_id": "a050fbcc-baaa-33dd-a862-a2a5badc255e",
                        "target_lang_word": "phosphate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phosphate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e684c9f7-493d-3558-892a-00b1eb4a8e7c",
                                        "entry_id": "ccf7a243-6bdc-3d8b-a2a8-f0d9933173bf",
                                        "glosses": [
                                            "Any salt or ester of phosphoric acid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e9c83c2-fd2d-49d9-be78-1cc5f58f4b39",
                                                "sense_id": "e684c9f7-493d-3558-892a-00b1eb4a8e7c",
                                                "text": "Make sure you don’t use detergents with phosphates or nonylphenol ethoxylate surfactants, but that information is rarely available on the labels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f37be5fb-f7cb-3bc4-84e4-30a12cda2e72",
                                        "entry_id": "ccf7a243-6bdc-3d8b-a2a8-f0d9933173bf",
                                        "glosses": [
                                            "Any fertiliser containing phosphate compounds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f1df201-2fda-32f4-b504-6ecca89c7938",
                                        "entry_id": "ccf7a243-6bdc-3d8b-a2a8-f0d9933173bf",
                                        "glosses": [
                                            "Guano (containing high levels of phosphates and harvested for the fertiliser industry)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cef2023-d2ff-3220-8dbc-cb7738a938f6",
                                        "entry_id": "ccf7a243-6bdc-3d8b-a2a8-f0d9933173bf",
                                        "glosses": [
                                            "A carbonated soft drink containing phosphoric acid, often flavored with a fruit-based syrup."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5630a827-84b7-42b3-8ae4-62fe5b31ea78",
                                                "sense_id": "6cef2023-d2ff-3220-8dbc-cb7738a938f6",
                                                "text": "An egg phosphate is a phosphate to which an egg has been added in the proper manner. While an egg phosphate can be flavored with any syrup that makes a good phosphate, still the standard flavor by long usage has com to be orange […]"
                                            },
                                            {
                                                "example_id": "78b82def-27c7-4647-b954-92cd4668213f",
                                                "sense_id": "6cef2023-d2ff-3220-8dbc-cb7738a938f6",
                                                "text": "“This man here,” she said, “can make you a cherry Coke or a chocolate Coke or a phosphate — a chocolate phosphate or. “Vanilla phosphate,” the man helped, “cherry phosphate, orange phosphate, lime phosphate, lemon phosphate,"
                                            },
                                            {
                                                "example_id": "44d6a59a-5391-42dd-bafa-a0f70dfec818",
                                                "sense_id": "6cef2023-d2ff-3220-8dbc-cb7738a938f6",
                                                "text": "You order California burgers for us both, even though I don't eat lettuce or tomato, then you order me a phosphate, cherry, a dreadful fizzy drink you say you always loved. It's bitter, bubbly, unbearable; but, thirsty for your past, force myself to drink it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phosphate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed023657-2b75-3ec6-b493-88019cd84cd1",
                                        "entry_id": "1b2a353e-deaf-3360-9ef2-4bf57acbc8ce",
                                        "glosses": [
                                            "To treat or coat with a phosphate or phosphoric acid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5501660a-22fe-4096-ba96-c33cf5d8c46c",
                        "source_entry_id": "78708af4-8103-37a4-a82d-d1c385296431",
                        "source_sense_id": "a050fbcc-baaa-33dd-a862-a2a5badc255e",
                        "target_lang_word": "fosfat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dff30888-a48b-45f1-9930-3d53b661f70f",
                        "source_entry_id": "78708af4-8103-37a4-a82d-d1c385296431",
                        "source_sense_id": "a050fbcc-baaa-33dd-a862-a2a5badc255e",
                        "target_lang_word": "phosphate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phosphate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                        "entry_id": "53be5672-78dc-3b4c-b362-714c1cb502c4",
                                        "glosses": [
                                            "Combinaison de l’acide phosphorique avec une base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d655f1a7-b6f0-4db6-bc28-1624c1331964",
                                                "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                                "text": "L’échantillon dont on a soumis une partie à l’analyse, contenant du phosphate de plomb, il est très-probable que l’acide phosphorique que l'on a trouvé représente une certaine quantité de phosphate mélangé au plomb-gomme."
                                            },
                                            {
                                                "example_id": "9a184ab3-6cdc-47ac-b711-861c31e1ef5a",
                                                "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                                "text": "Les éléments dominants de ses alluvions sont les silex dérivés de l'argile à silex, des nodules de phosphate de chaux, de quartz, et des fragments de grès: […]."
                                            },
                                            {
                                                "example_id": "6a6d187b-0412-49cf-861c-fcf8f0e01510",
                                                "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                                "text": "On a employé aussi comme bain oxydant des phosphates de potasse, de soude, de chaux ou d'alumine en proportion variable …."
                                            },
                                            {
                                                "example_id": "b5b26aa9-a075-49f1-a6c6-6b38ea30e349",
                                                "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                                "text": "Les phosphates arénacés, ou sables phosphatés, se rencontrent dans des poches à la partie supérieure de la craie à bélemnites, sur la limite des départements de la Somme et du Pas-de-Calais."
                                            },
                                            {
                                                "example_id": "769dfd97-1c4a-4f5a-bb66-6052040f75ae",
                                                "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                                "text": "En Algérie, les premières mines avaient été ouvertes en 1845; en Tunisie, les gisements des phosphates de Gafsa étaient déjà découverts en 1885-1886 (quatre ans seulement après l'établissement du protectorat) et exploités à partir de 1889."
                                            },
                                            {
                                                "example_id": "8d6ccb7f-edf4-4f21-9070-a885f0a2c978",
                                                "sense_id": "9cf2c924-ba65-39da-9206-f80fefa0c4c8",
                                                "text": "Mais c’est le phosphate, dont le Maroc possède 70 % des réserves mondiales, qui devrait tout particulièrement gagner en importance, assurent les experts, à mesure que les batteries lithium-fer-phosphate deviendront plus communément utilisées dans les véhicules électriques à l’échelle mondiale, comme c’est déjà le cas en Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8026a11-3095-3cd2-9134-a12def650714",
                                        "entry_id": "53be5672-78dc-3b4c-b362-714c1cb502c4",
                                        "glosses": [
                                            "Composé organophosphoré dérivé de l'acide phosphorique ; on parle parfois de « phosphate organique »."
                                        ],
                                        "tags": [
                                            "Chimie organique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c64d460-20db-41d6-b6a0-11e9f097d1e0",
                                                "sense_id": "e8026a11-3095-3cd2-9134-a12def650714",
                                                "text": "Depuis le 1ᵉʳ janvier 2002, il n'y a plus, en principe, de rejets de plomb par les pots d'échappement car le super plombé a été remplacé par du super au phosphate. Cette évolution a eu des effets incontestables."
                                            }
                                        ]
                                    }
                                ]
                            },
