                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a48ed67-5c60-45f4-afb0-b593bfa2a94f",
                                "sense_id": "a7bc4546-a9fc-335b-aa0a-91313f7a98d8",
                                "text": "„Nicht acht, sondern Tausende Unternehmen müssen auf die schwarze Steuerliste.“"
                            },
                            {
