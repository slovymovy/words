                    {
                        "sense_id": "59c75d25-57d2-3b5d-b272-bcdedc0c1fcd",
                        "entry_id": "8dcf8eba-e4a4-310d-aef9-3d32d01ae7ab",
                        "glosses": [
                            "Region im Nordwesten Afrikas westlich von Ägypten"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "68ec4866-0f0a-440b-8c81-51d88be90086",
                                "sense_id": "59c75d25-57d2-3b5d-b272-bcdedc0c1fcd",
                                "text": "In allen Wüsten, welche, mindestens dem Namen nach, unter der Herrschaft des Khedive von Aegypten stehen, spielen die Beduinen heutzutage bei weitem nicht mehr die Rolle, welche sie dort in früheren Zeiten gespielt haben oder gegenwärtig noch in Arabien und in den Ländern Nordwestafrikas spielen."
                            },
                            {
                                "example_id": "ff11c98e-a4e6-4865-89f1-718f66fe87f3",
                                "sense_id": "59c75d25-57d2-3b5d-b272-bcdedc0c1fcd",
                                "text": "Am 8. März 2006 hat der \"Terra\"-Satellit der Nasa diesen Sandsturm über Nordwestafrika aufgenommen."
                            },
                            {
                                "example_id": "df16b161-b436-47f6-b5e1-51d2c29a82bf",
                                "sense_id": "59c75d25-57d2-3b5d-b272-bcdedc0c1fcd",
                                "text": "In Algerien liegen die Wurzeln des islamistischen Terrors in Nordwestafrika."
                            },
                            {
                                "example_id": "a2a42272-7b70-4910-b0a2-b6eab095e77b",
                                "sense_id": "59c75d25-57d2-3b5d-b272-bcdedc0c1fcd",
                                "text": "Die USA planen eine Drohnenbasis in Nordwestafrika, um Gruppen des Terrornetzwerkes al-Qaida sowie islamische Extremisten in der Region besser überwachen zu können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
