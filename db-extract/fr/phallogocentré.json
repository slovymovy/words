                                        "glosses": [
                                            "Pertaining to phallogocentrism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a93344-8823-4bd7-8127-d8486f9cb802",
                                                "sense_id": "4a0d639b-8b4b-3737-a60a-9af354564c88",
                                                "text": "Philosophers of language may wonder whether Latin was a phallogocentric language because of its use of gender to refer to non-gendered things such as water."
                                            },
                                            {
                                                "example_id": "40a98219-165a-424e-81c7-468a68967ca2",
                                                "sense_id": "4a0d639b-8b4b-3737-a60a-9af354564c88",
                                                "text": "We men, at least in our standard phallogocentric mode of sexuality, even when we are doing it with the real women, we are effectively doing it with our fantasy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
