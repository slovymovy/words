                "senses": [
                    {
                        "sense_id": "882101d6-0ee2-3e90-8051-b63b7065277d",
                        "entry_id": "bbaefd8e-0e04-3b40-a827-e54bfc3da245",
                        "glosses": [
                            "Person, die auf dem Land lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4169796-aac7-4251-b7de-3ece43635c61",
                                "sense_id": "882101d6-0ee2-3e90-8051-b63b7065277d",
                                "text": "„Das Brot war etwa eine Woche alt, und weil das Feuer schon glühte, röstete es Marcell als angehender Landbewohner und Fachmann für das Landleben an einer Gabel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aaf1b47-54d1-4da2-bb02-a32f30a572cd",
                        "source_entry_id": "bbaefd8e-0e04-3b40-a827-e54bfc3da245",
                        "source_sense_id": "882101d6-0ee2-3e90-8051-b63b7065277d",
                        "source_sense_description": "Person, die auf dem Land lebt",
                        "target_lang_word": "campagnard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campagnard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3916e340-c0c9-3b49-b2e5-088a2e9681a6",
                                        "entry_id": "4b56e460-2cca-37bf-91b9-bbbab41af19e",
                                        "glosses": [
                                            "Qui vit ordinairement à la campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6408cf76-7561-4b55-8806-1dfc384b2ef4",
                                                "sense_id": "3916e340-c0c9-3b49-b2e5-088a2e9681a6",
                                                "text": "Gentilhomme campagnard."
                                            },
                                            {
                                                "example_id": "d24953e4-3f7f-4d36-a0b5-14d17442af09",
                                                "sense_id": "3916e340-c0c9-3b49-b2e5-088a2e9681a6",
                                                "text": "Avoir l’air campagnard, les manières campagnardes."
                                            },
                                            {
                                                "example_id": "918d55ee-cda6-4db1-9f61-469f38b14ad7",
                                                "sense_id": "3916e340-c0c9-3b49-b2e5-088a2e9681a6",
                                                "text": "Il était venu travailler un matin à la Nationale, et malgré l’élégance de son pardessus bleu, de son écharpe claire, de son complet bien coupé, je lui avais trouvé quelque chose de campagnard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dcb18aa-f82a-3d48-96c5-b895a9aafae0",
                                        "entry_id": "4b56e460-2cca-37bf-91b9-bbbab41af19e",
                                        "glosses": [
                                            "Relatif à la campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4ff9038-37db-4f57-87f9-3bca0d87df49",
                                                "sense_id": "5dcb18aa-f82a-3d48-96c5-b895a9aafae0",
                                                "text": "Buffet campagnard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1151f8-ad8a-3cb6-9172-a24f2f62dc60",
                                        "entry_id": "4b56e460-2cca-37bf-91b9-bbbab41af19e",
                                        "glosses": [
