                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eedee17-5b8b-47b0-af3c-563e12b7b036",
                                                "sense_id": "d9799b1e-8890-3b19-8b8c-58aad8901470",
                                                "text": "It was dissolved in distilled water to prepare the exact aqueous dose (900 mg Kg −1 body weight) for intragastrical injection [ 9 ]."
                                            }
