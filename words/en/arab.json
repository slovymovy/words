    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e7f8381-401b-33c9-8042-c99032f2298b",
                    "sense_definition": "A person from the Arabian Peninsula or the Arab world.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is an <w>Arab</w> who moved to Europe for his studies.",
                            "target_lang_translations": {
                                "ru": "Он <w>араб</w>, который переехал в Европу на учебу.",
                                "zh": "他是一位为了求学而搬到欧洲的<w>阿拉伯人</w>。"
                            }
                        },
                        {
                            "text": "Many <w>Arabs</w> share a common cultural and linguistic heritage.",
                            "target_lang_translations": {
                                "ru": "Многие <w>арабы</w> имеют общее культурное и языковое наследие.",
                                "zh": "许多<w>阿拉伯人</w>拥有共同的文化和语言遗产。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Arab world",
                        "Arab League",
                        "Arab spring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек родом с Аравийского полуострова или из арабского мира.",
                        "zh": "来自阿拉伯半岛或阿拉伯世界的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ара́б",
                                "target_lang_sense_clarification": "мужской род"
                            },
