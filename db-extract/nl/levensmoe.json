                "senses": [
                    {
                        "sense_id": "cd1f1403-2b12-3708-a213-cca149f34002",
                        "entry_id": "20008886-b3ba-36b1-93f5-56a3c9d259a2",
                        "glosses": [
                            "zonder de wil nog langer te bestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc87d7d-23e5-4ac9-bf85-09d2b83876f2",
                                "sense_id": "cd1f1403-2b12-3708-a213-cca149f34002",
                                "text": "Volgens de definitie wenst een levensmoe iemand naar de dood."
                            },
                            {
                                "example_id": "8658a584-f688-41fa-ae02-b4fa10bd36ee",
                                "sense_id": "cd1f1403-2b12-3708-a213-cca149f34002",
                                "text": "Hij wou helemaal niet dood, hij was helemaal niet levensmoe en heeft tot het allerlaatste gewerkt."
                            },
                            {
                                "example_id": "5464a4f2-8bf4-4c40-bdce-1cdce0e3efcf",
                                "sense_id": "cd1f1403-2b12-3708-a213-cca149f34002",
                                "text": "⧖ Toen riep hij levensmoe, verdrietig om den dood."
                            }
                        ]
                    }
