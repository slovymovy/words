                        ],
                        "form": "die Fernsehapparate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                        "entry_id": "593cd0e0-f5f0-3603-b64c-b66726d98033",
                        "glosses": [
                            "elektronisches Gerät, das von Fernsehanstalten ausgestrahlte Sendungen über terrestrische Wellen, Satelliten oder Glasfaserkabel empfangen und wiedergeben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57cb6fd4-e32a-448b-9870-1d5e1b70b7e2",
                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                "text": "Dieser Fernsehapparat beinhaltet die neueste Digitaltechnik."
                            },
                            {
                                "example_id": "59381c20-6bb2-4f2a-a44f-c6c5b3a5e38f",
                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                "text": "„Helena und Moritz, die Eltern, überlegen, den beiden Größeren einen eigenen Fernsehapparat ins Zimmer zu stellen.“"
                            },
                            {
                                "example_id": "6f007320-396e-44f4-ac63-6fa45c9f2ae8",
                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                "text": "„Austragungsort war der Keller meines Elternhauses, in dem ich einen alten Fernsehapparat aufgestellt hatte, eine riesige Kiste mit Schwarz-Weiss-Bild, Seitenwänden aus Holzimitat und massiven Knöpfen, an denen man drehen konnte.“"
                            },
                            {
                                "example_id": "3fb943c4-861f-4071-a951-8c05b0ada171",
                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                "text": "„Dem Inseratenteil einer führenden Tageszeitung entnahm ich kürzlich, dass man diesen kostbaren Kräften nicht nur Rundfunkgeräte, Fernsehapparate und Theaterkarten aufdrängt.“"
                            },
                            {
                                "example_id": "e64e2ac9-ff80-4243-8974-79b88ea3db95",
                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                "text": "„Die Schwägerin setzte sich mit dem Stiefbruder vor den Fernsehapparat und verfolgte mit ihm das Programm bis gegen Mitternacht und äußerte gelegentlich eine Vermutung über das Scheitern von Rotermunds Plänen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
