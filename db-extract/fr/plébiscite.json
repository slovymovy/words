                                    {
                                        "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "A direct popular vote on an issue of public importance, such as an amendment to the constitution, a change in the sovereignty of the nation, or some government policy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eacf62-ada4-48f0-939b-00ec74b12f30",
                                                "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                                "text": "A political result, we may also say aim, of the frumentarian plebiscite of Gaius was to disattach the city populace from its conservative moorings and to enlist it in the service of reform."
                                            },
                                            {
                                                "example_id": "b2bfb294-7101-4115-8434-6c3b06bda2ab",
                                                "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                                "text": "Then something changed, and Mr. Mitterrand said he thought it would be a good idea if the Constitution allowed plebiscites, on the recommendation of the President, on issues involving personal freedoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d83936-a608-380e-bbaf-9ed24d2dd9f6",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "An expression of the public's views on an issue, whether legally binding or not."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc92c3a5-b94c-38a2-99c6-af64d1bae287",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "Synonym of plebiscitum (“a law enacted by the common people, under the superintendence of a tribune or some subordinate plebeian magistrate, without the intervention of the senate”)."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
