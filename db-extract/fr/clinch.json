                "translations": [
                    {
                        "translation_id": "fd82c581-bc87-4bdb-aead-af740c8e43d4",
                        "source_entry_id": "99e79975-dce4-3b1b-92d2-4cbfa8ee9992",
                        "source_sense_id": "2ca53a39-0cbf-3a4e-bb0b-1b7e458083f7",
                        "target_lang_word": "Schwitzkasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwitzkasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                                        "entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                                        "glosses": [
                                            "Kasten für Schwitzbäder, bei dem während der Benutzung nur der Kopf aus einer Öffnung schaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e64c78f-eb4d-4ddf-a30a-afa637a15ec8",
                                                "sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                                                "text": "Er saß eine Stunde lang im Schwitzkasten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                        "entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                                        "glosses": [
                                            "Griff, bei dem jemand den Kopf eines anderen unter den Arm klemmt, so dass dieser in seiner Bewegungsfreiheit stark eingeschränkt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80948093-bd5e-4dcd-aa95-d56e5b8d0f97",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "Der Rowdy nahm seinen Mitschüler in den Schwitzkasten und gab ihm Kopfnüsse."
                                            },
                                            {
                                                "example_id": "31b12ecb-fa6d-4592-ab87-e5d3cd580396",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„Das nahm er in den Schwitzkasten und zerrte es zentaurenähnlich über den Flur.“"
                                            },
                                            {
                                                "example_id": "33d66371-b8fd-457d-b43f-dd8346ee1b52",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„Er konzentriert sich darauf, sich aus dem Schwitzkasten des Gladiators zu befreien.“"
                                            },
                                            {
                                                "example_id": "129fc5eb-d9ef-4a26-a58b-5db4304f1f1a",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„Bevor sie sich auch nur in Positur gestellt hätten, hätte ich schon drei Purzelbäume geschlagen, mich von hinten an sie herangemacht, sie aufs Kreuz gelegt und in den Schwitzkasten genommen.“"
                                            },
                                            {
                                                "example_id": "0139cd13-fb79-4333-9215-36fb6a29ffa3",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„In keuchenden Kämpfen, bei Schwitzkasten und Schweiß kommt es leicht abhanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cbedc7a-9015-4d7e-8b8a-4be6b12eb5c9",
                        "source_entry_id": "99e79975-dce4-3b1b-92d2-4cbfa8ee9992",
                        "source_sense_id": "2ca53a39-0cbf-3a4e-bb0b-1b7e458083f7",
                        "target_lang_word": "clinch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "302f2ae6-0de6-39c0-8eac-f9a31f2ecc05",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To bend and hammer the point of (a nail) so it cannot be removed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e019f8c-54a6-3f91-96c3-2b79b8d10b21",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To clasp; to interlock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74816c88-f4e9-4d65-9595-dd19fb8daffd",
                                                "sense_id": "5e019f8c-54a6-3f91-96c3-2b79b8d10b21",
                                                "text": "“Beloved shipmates, clinch the last verse of the first chapter of Jonah—‘And God had prepared a great fish to swallow up Jonah.’”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3060571c-92e7-3755-96cb-d89b07d740ce",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To fasten securely or permanently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To make certain; to finalize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3cc82d-1245-4d2b-9946-8b9f91dd8cae",
                                                "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                                                "text": "I already planned to buy the car, but the color was what really clinched it for me."
                                            },
                                            {
                                                "example_id": "45c3f819-40f2-4a39-adc3-59f757048f6f",
                                                "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                                                "text": "Vincent Kompany was sent off after conceding a penalty that was converted by Stephen Hunt to give Wolves hope. But Adam Johnson's curling shot in stoppage time clinched the points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6b83407-110b-3e50-a6c8-2747fa3e5342",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To hold firmly; to clench"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To set closely together; to close tightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1885cff9-80b2-4d5a-b2fa-0d91eba64b81",
                                                "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                                                "text": "to clinch the teeth or the fist"
                                            },
                                            {
                                                "example_id": "abc36e5b-629a-44b1-a91e-acadb1a22601",
                                                "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                                                "text": "[T]ry if the heads of the nails [of horseshoes] be fast, and whether they be well clinched; if not, send presently for a smith; always stand by while the smith is employed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28260bae-4339-37e4-9374-c041a2659f14",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To hold a boxing opponent with one or both arms so as to avoid being hit while resting momentarily"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5001db14-291d-3aaa-9c7a-3a155a1f51bf",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To secure a spot (e.g., at the divisional championship) before the end of regular season play by having an insurmountable lead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec3da3d9-a652-4d90-beaa-86fa8c9bc492",
                                                "sense_id": "5001db14-291d-3aaa-9c7a-3a155a1f51bf",
                                                "text": "It put the U.S. on the brink of clinching a spot in the quarterfinals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8197c624-7063-3d13-887a-cd14767c07cf",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To embrace passionately."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
