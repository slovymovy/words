                                        "sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                                        "entry_id": "ee32f03e-c557-35c8-ab18-c222f6ebc7fb",
                                        "glosses": [
                                            "Ablauf auf einem Schiffsdeck, durch den das Wasser nach Außenbord oder in die Bilge ablaufen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f443e7a-fd5f-4c11-8a45-5cafdf7644ab",
                                                "sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                                                "text": "„Man hatte nur zwei Mann als Wache an Bord zurückgelassen, und alle beide lagen total betrunken im Speigatt.“"
                                            },
                                            {
                                                "example_id": "63423c01-286f-4eab-8318-2b1537efa6e3",
                                                "sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                                                "text": "„Als der Fremde nah genug herangekommen war, sahen wir, dass er pumpte, da unablässig Wasser aus dem Speigatt lief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "744973d8-faa9-427d-98eb-6c4765b8ef8f",
                        "source_entry_id": "418f45fb-4621-3cb7-86dc-ba8c32acf5b8",
                        "source_sense_id": "dffa1589-bca7-3742-9b5b-e60fb1d830ec",
