                "senses": [
                    {
                        "sense_id": "02513c21-19b5-37ef-b35a-8d9fe8e8f367",
                        "entry_id": "c12684ad-69c7-3bdd-a132-33d4ba7d7929",
                        "glosses": [
                            "Häufigkeit chemischer Elemente schwerer als Helium in Sternen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1e25b0-119b-46ed-86e0-49d70e893a59",
                                "sense_id": "02513c21-19b5-37ef-b35a-8d9fe8e8f367",
                                "text": "Sterne mit relativ niedrigerem Metallgehalt (niedrigerer Metallizität) sind verhältnismäßig älter."
                            },
                            {
                                "example_id": "6151ae28-140f-4ea8-ac76-f4b3388e98de",
                                "sense_id": "02513c21-19b5-37ef-b35a-8d9fe8e8f367",
                                "text": "„Der geringste metallische Anteil, der bislang im Universum gemessen wurde, entspricht etwa einem Tausendstel der Metallizität der Sonne.“"
                            },
                            {
                                "example_id": "9a2fa6ce-1004-43b4-9178-dcf412dbe391",
                                "sense_id": "02513c21-19b5-37ef-b35a-8d9fe8e8f367",
                                "text": "„‚Sie sind Rote Riesensterne mit einer hohen Metallizität, dadurch haben sie eine ungewöhnliche Farbe.‘ Als Metallizität bezeichnen Astronomen den Gehalt eines Sterns an chemischen Elementen, die schwerer als Wasserstoff und Helium sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
