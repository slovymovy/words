{
    "word_family": [
        "soulagement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "165ba144-5915-3209-826f-6b61c5cf8984",
                    "sense_definition": "Diminuer ou faire cesser une douleur, une souffrance physique ou une peine morale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apaisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament permet de <w>soulager</w> la douleur en quelques minutes seulement."
                        },
                        {
                            "text": "Ses paroles réconfortantes ont réussi à <w>soulager</w> un peu sa tristesse."
                        }
                    ],
                    "synonyms": [
                        "apaiser",
                        "calmer",
                        "adoucir",
                        "atténuer"
                    ],
                    "antonyms": [
                        "aggraver",
                        "accentuer"
                    ],
                    "common_phrases": [
                        "soulager la douleur",
                        "soulager les maux"
                    ]
                },
                {
                    "sense_id": "97b1812f-4c85-3fc1-9554-3b3213ca2c67",
                    "sense_definition": "Débarrasser quelqu'un ou quelque chose d'une partie de sa charge, d'un fardeau ou d'une tâche pénible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>soulager</w> ce cheval car ses sacs sont beaucoup trop lourds."
                        },
                        {
                            "text": "Le nouvel assistant va nous <w>soulager</w> d'une grande partie du travail administratif."
                        }
                    ],
                    "synonyms": [
                        "décharger",
                        "délester"
                    ],
                    "antonyms": [
                        "alourdir",
                        "charger"
                    ],
                    "common_phrases": [
                        "soulager d'un poids"
                    ]
                },
                {
                    "sense_id": "9b060f40-9db9-3f7f-8ece-48af826b0146",
                    "sense_definition": "Éprouver un réconfort moral ou se libérer d'une angoisse en confiant ses pensées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apaisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avait besoin de parler à un proche pour se <w>soulager</w> la conscience."
                        },
                        {
                            "text": "Il s'est enfin <w>soulagé</w> en avouant toute la vérité à ses parents."
                        }
                    ],
                    "synonyms": [
                        "s'apaiser",
                        "se libérer"
                    ],
                    "antonyms": [
                        "s'angoisser"
                    ],
                    "common_phrases": [
                        "se soulager la conscience"
                    ]
                },
                {
                    "sense_id": "14db8fd1-d5d5-33be-9266-2aac9038d8b6",
                    "sense_definition": "Satisfaire un besoin naturel d'élimination corporelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "besoins",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chauffeur s'est arrêté sur l'aire d'autoroute pour aller se <w>soulager</w>."
                        },
                        {
                            "text": "Excusez-moi un instant, j'ai besoin de me <w>soulager</w> avant de reprendre la route."
                        }
                    ],
                    "synonyms": [
                        "uriner",
                        "déféquer"
                    ],
                    "antonyms": [
                        "se retenir"
                    ],
                    "common_phrases": [
                        "besoin de se soulager"
                    ]
                }
            ]
        }
    ]
}