                "senses": [
                    {
                        "sense_id": "6bdd1ab2-ad12-3c99-9b72-1a746c56f9b0",
                        "entry_id": "14d9e002-85e8-37b1-a53d-f6690de8312a",
                        "glosses": [
                            "Möbelstück, in dem man schläft; Bett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d6db10-e2bb-4e60-a814-f0af5a52bf98",
                                "sense_id": "6bdd1ab2-ad12-3c99-9b72-1a746c56f9b0",
                                "text": "„Herstellerunabhängig wird hier ein breites Sortiment an Schlafmöbeln angeboten, welches auch den modernsten optischen Ansprüchen gerecht wird.“"
                            },
                            {
                                "example_id": "41e2ee4b-2e82-40a7-a7da-3eb7f933dba2",
                                "sense_id": "6bdd1ab2-ad12-3c99-9b72-1a746c56f9b0",
                                "text": "„Von individuell gestalteten und handwerklich gefertigten Wohn- und Schlafmöbeln über Leuchten, Heimtextilien und Wohnacccessoires findet sich in Halle A2 alles, was das Leben in den eigenen vier Wänden noch schöner macht.“"
                            },
                            {
                                "example_id": "87fc361c-bc89-4a0b-b797-4f0f00bbd7b6",
                                "sense_id": "6bdd1ab2-ad12-3c99-9b72-1a746c56f9b0",
                                "text": "„Der Fußboden ist gefliest; es ist angenehm kühl, und in fast jedem Zimmer steht ein Schlafmöbel, hier eine Liege, dort ein Himmelbett mit Baldachin; hier verbringt Twombly seine Tage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
