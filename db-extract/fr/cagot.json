                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "defa4a10-1f66-3c62-8c6f-87f149aa7b23",
                                        "entry_id": "56e0f18c-a839-3543-879e-e522937c6d9f",
