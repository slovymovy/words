                        "form": "dem Universalismus"
                    },
                    {
                        "form_id": "94d80436-eecf-4a26-85bf-4263627e88d6",
                        "entry_id": "9ed048fa-587e-389b-9a8d-75c8fea486ae",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Universalismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                        "entry_id": "9ed048fa-587e-389b-9a8d-75c8fea486ae",
                        "glosses": [
                            "Denkart, die den Vorrang des Allgemeinen beziehungsweise des Ganzen gegenüber dem Besonderen und Einzelnen betont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7677138-b986-4594-9aa4-bdd269cf2dab",
                                "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                                "text": "„Doch der wichtigste philosophische Impuls dieses Universalismus kommt aus der europäischen Aufkärung.“"
                            },
                            {
                                "example_id": "545fc798-3e9b-4aa8-b6f2-7f0afd1c3f04",
                                "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                                "text": "„Der moralische und kulturelle Relativismus, ein Stiefkind des Universalismus, wäre demnach zum Scheitern verurteilt, weil er die abweichenden Eigenarten der Fremdkultur nicht genügend beachtet.“"
                            },
                            {
                                "example_id": "6c391756-7467-49ad-b5ee-91b82acfd731",
                                "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                                "text": "„Sein Universalismus erhielt erst durch sein nationales Denken eine schärfere Kontur.“"
                            },
                            {
                                "example_id": "35a06b74-1cc2-46f9-846c-a218bd0d6d01",
                                "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                                "text": "„Dieser Prozess der distinkten Konstruktion von nationalen Gemeinschaften wird durch die beschriebenen Herausforderungen des Universalismus erschwert.“"
                            },
                            {
                                "example_id": "43b010f8-3799-4afb-b313-cdcfa9cf6c4f",
                                "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                                "text": "„Beim Klima und beim Internet weist China den westlichen Universalismus zurück und beruft sich auf die Ungleichheit der Welt.“"
                            },
                            {
                                "example_id": "f99fc01c-433b-4b7e-9562-a92718740cc9",
                                "sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
                                "text": "„Umrissen dargestellt lautet die Kritik, dass der Monotheismus nicht – wie von Assmann behauptet – die Religion der Unterscheidung, sondern die Religion der Einheit und des Universalismus sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5008910c-0a9f-3be8-94a3-77d3462c2297",
                        "entry_id": "9ed048fa-587e-389b-9a8d-75c8fea486ae",
                        "glosses": [
                            "(Konfession auf Basis der) Lehre, nach der alle Menschen mit Gott versöhnt beziehungsweise erlöst werden"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b1233297-d28b-48c3-a283-b07deca6ee0b",
                                "sense_id": "5008910c-0a9f-3be8-94a3-77d3462c2297",
                                "text": "„Dabei stand der Universalismus des Heils im Sinne der Apokatastasis im Mittelpunkt der Eschatologie.“"
                            },
                            {
                                "example_id": "ed5fd6f2-2641-44b3-a84d-13ff623d0e08",
                                "sense_id": "5008910c-0a9f-3be8-94a3-77d3462c2297",
                                "text": "„Als konfessionale Gruppierung trat der Universalismus jedoch erst im 18. und 19. Jahrhundert in Nordamerika auf. Er entwickelte sich in einem vornehmlich protestantisch geprägten Umfeld.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
