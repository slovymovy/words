                    {
                        "sense_id": "76840b23-d7a8-3a5b-ab49-29e43a877f91",
                        "entry_id": "889fd758-72a9-388a-8083-2f4445ae3f85",
                        "glosses": [
                            "To annul the certification of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "222aa083-e73c-49ff-bd1f-5e163d442c37",
                                "sense_id": "76840b23-d7a8-3a5b-ab49-29e43a877f91",
                                "text": "The American Medical Association (AMA) was formed in 1845 to gain for medical doctors a monopoly on legal licensure as health practitioners. The young AMA waged fierce (and quite successful) battles to de-certify the then-dominant natural healers — a range of herbalists, midwives, and homeopathic doctors."
                            },
                            {
                                "example_id": "54aeb1b2-db13-4a81-8af6-991761668ee8",
                                "sense_id": "76840b23-d7a8-3a5b-ab49-29e43a877f91",
                                "text": "Nigeria was tagged as a transit-route of drug carriers. This prompted the United States government to decertify the country."
                            }
                        ]
                    },
                    {
                        "sense_id": "513065da-6aca-308d-bd0a-9a8299660d5e",
                        "entry_id": "889fd758-72a9-388a-8083-2f4445ae3f85",
                        "glosses": [
                            "To annul a labor union."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f7c313a5-5af3-4ce4-a53f-19b00b9a1cdf",
                                "sense_id": "513065da-6aca-308d-bd0a-9a8299660d5e",
                                "text": "As Sallas immediately said, the 130 scabs who so easily replaced the striking printers in '85 won't be foisted upon the union--to degrade it and possibly decertify it."
                            }
                        ]
                    }
