                    },
                    {
                        "translation_id": "340d21b0-d396-4c11-81d7-0cf3a39fd5e5",
                        "source_entry_id": "773a8560-4409-36d2-8d8e-4a96a4468163",
                        "target_lang_word": "Totalisator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totalisator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7c5178-28f8-3ad8-95af-012a3f964c97",
                                        "entry_id": "58fe4d4d-d9c7-3474-8d62-c65a3e63c093",
                                        "glosses": [
                                            "Einrichtung zum Abschließen von Wetten; auch für das Verfahren und den Ort, an dem man diesen Typ Wette abschließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2e8ff3-64d1-41f9-821f-a2b5ef345bf2",
                                                "sense_id": "4d7c5178-28f8-3ad8-95af-012a3f964c97",
                                                "text": "Der Totalisator stellt quasi das Wettgeschäft auf der Rennbahn dar."
                                            },
                                            {
                                                "example_id": "80691b5e-ae50-458f-aa9d-273ad0a612d3",
                                                "sense_id": "4d7c5178-28f8-3ad8-95af-012a3f964c97",
                                                "text": "„Das Wettbüro war ein ziemlich großer Raum. Rechts war ein Zigarrenladen abgeteilt, links befand sich der Totalisator.“"
                                            },
                                            {
                                                "example_id": "4cea97c5-4b72-4402-ba32-bc73d88cec00",
                                                "sense_id": "4d7c5178-28f8-3ad8-95af-012a3f964c97",
                                                "text": "Der Totalisator gibt die Eventualquoten bekannt."
                                            },
                                            {
                                                "example_id": "5272ef3b-ad6a-40ff-989b-4f82291fef45",
                                                "sense_id": "4d7c5178-28f8-3ad8-95af-012a3f964c97",
                                                "text": "Beim Totalisator wird nicht gegen einen Buchmacher, sondern untereinander gewettet."
                                            },
                                            {
                                                "example_id": "4f253fd2-ac0b-4944-8d6f-9f22602a8630",
                                                "sense_id": "4d7c5178-28f8-3ad8-95af-012a3f964c97",
                                                "text": "Wer in England eine Wette auf irgend ein Pferd anlegen will, muss sich aber an den Buchmacher wenden, denn der Totalisator hat in England nie Eingang gefunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "edab6ef3-29b5-3dcd-ac06-55aa24a8916b",
                                        "entry_id": "58fe4d4d-d9c7-3474-8d62-c65a3e63c093",
                                        "glosses": [
                                            "Behältnis, das Niederschläge zur Messung auffängt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a99a152-54aa-4889-8a3e-84ff187feb2d",
                                                "sense_id": "edab6ef3-29b5-3dcd-ac06-55aa24a8916b",
                                                "text": "Kann aus technischen Gründen der Totalisator nicht oberhalb solcher Hindernisse angebracht werden, so muss er mindestens in einer Entfernung, die der doppelten Höhe des Hindernisses entspricht, angebracht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55609d8d-4329-4452-ae77-0789ec9b3fcd",
                        "source_entry_id": "773a8560-4409-36d2-8d8e-4a96a4468163",
                        "target_lang_word": "totalizatör",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "14c0e6f8-9cfc-4114-9e6f-d6ea51b1422e",
                        "source_entry_id": "773a8560-4409-36d2-8d8e-4a96a4468163",
                        "target_lang_word": "totaliseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e4c0ffce-0caa-43be-b108-af20d73d2200",
                        "source_entry_id": "773a8560-4409-36d2-8d8e-4a96a4468163",
                        "target_lang_word": "totalisateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab7dea4d-0afc-395c-8460-1ea656fb5bf4",
                                        "entry_id": "9403ef05-b550-3e73-92bb-c65024912df7",
                                        "glosses": [
                                            "Qui totalise, qui fait un total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31390db7-d33e-4b53-a1b9-53496a2d4d10",
                                                "sense_id": "ab7dea4d-0afc-395c-8460-1ea656fb5bf4",
                                                "text": "En fait, ce recueil propose un acte de foi, une sorte d'accueil totalisateur des possibles, une disponibilité sans faille devant l'étonnement."
                                            },
                                            {
                                                "example_id": "4ff8b2e8-c5d0-452d-a47b-42c193cb3efa",
                                                "sense_id": "ab7dea4d-0afc-395c-8460-1ea656fb5bf4",
                                                "text": "En trente secondes, la course est finie, le tableau d'affichage annonce les résultats et l'appareil totalisateur des produits fonctionne, envoyant en tous sens par fil spécial, dans tous les offices du pari mutuel, dans tous les cercles (…) le nom et la cote du gagnant."
                                            },
                                            {
                                                "example_id": "f07d5d14-a488-4999-aa48-2e83a4c8918d",
                                                "sense_id": "ab7dea4d-0afc-395c-8460-1ea656fb5bf4",
                                                "text": "Mais cette montre, qu'est-elle exactement ? C'est un modèle à compteurs totalisateurs qui vous permet de prendre le meilleur départ possible en régates, quel que soit le système de compte à rebours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fc662a-39d0-3d94-8cfa-a59ceb83f692",
                                        "entry_id": "9403ef05-b550-3e73-92bb-c65024912df7",
                                        "glosses": [
                                            "Qui totalise, qui prend ou tend à prendre en compte le total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "917b9af9-227d-43eb-8e89-4ca7da9633a4",
                                                "sense_id": "45fc662a-39d0-3d94-8cfa-a59ceb83f692",
                                                "text": "Dans ce domaine, l'École, dès sa lointaine origine, fut d'ailleurs tirée à hue et à dia. Poussée par son esprit totalisateur, elle voulut toujours être, à la fois, le temple de la science « pure » et le conservatoire de la technique."
                                            },
                                            {
                                                "example_id": "44ae79b7-be61-4d84-a0e7-ab7c71c77954",
                                                "sense_id": "45fc662a-39d0-3d94-8cfa-a59ceb83f692",
                                                "text": "On ne peut imaginer, en effet, formulations plus différentes que l'abstraction du peintre italien et le baroque imaginatif et lyrique du sculpteur. Néanmoins, loin de se nuire par leur opposition, elles composent du monde, appréhendé ici par l'esprit de finesse et par l'esprit de géométrie, une image totalisatrice exemplaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "totalisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b7d68c1-5249-3d6e-b74f-ef5057827ea7",
                                        "entry_id": "c4a2c6c7-897f-31c7-8bd8-9663b88b0f45",
                                        "glosses": [
                                            "Compteur qui totalise, qui fait un total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce2067d-eb44-48d6-874e-d9d4ef113fb9",
                                                "sense_id": "8b7d68c1-5249-3d6e-b74f-ef5057827ea7",
                                                "text": "Totalisateur journalier, compteur kilométrique qui permet de mesurer la distance parcourue sur un trajet déterminé."
                                            },
                                            {
                                                "example_id": "b5930e6c-9fba-494b-8ebc-05880fd6b752",
                                                "sense_id": "8b7d68c1-5249-3d6e-b74f-ef5057827ea7",
                                                "text": "« La dernière expertise sur le totalisateur, le mécanisme qui permet de comptabiliser la consommation totale n'a pas permis de déterminer que le compteur fonctionnait normalement », a précisé le service communication à La Voix du Nord."
                                            },
                                            {
                                                "example_id": "6bc06db5-6c73-448d-8d69-6041798475bf",
                                                "sense_id": "8b7d68c1-5249-3d6e-b74f-ef5057827ea7",
                                                "text": "Les fournitures d'eau et de gaz se mesurent (...) au moyen de compteurs pourvus d'un totalisateur à cadrans sur lesquels on peut relever (…) le volume total débité (Ser, Phys. industr., 1890, p. 212"
                                            },
                                            {
                                                "example_id": "aa6d2fba-0d21-4def-a571-846a92d208c7",
                                                "sense_id": "8b7d68c1-5249-3d6e-b74f-ef5057827ea7",
                                                "text": "De part et d'autre de la tribune de l'Assemblée Nationale, les totalisateurs électroniques s'allument, provoquant un tumulte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f3544d-c1a5-3769-b5bd-81348b29a4a6",
                                        "entry_id": "c4a2c6c7-897f-31c7-8bd8-9663b88b0f45",
                                        "glosses": [
                                            "Dans le domaine des courses hippiques, appareil enregistreur et calculateur indiquant le nombre de paris engagés sur chaque cheval pendant la période où les paris se prennent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d421de-2e9c-492a-98ea-4a928e28d4ae",
                                                "sense_id": "95f3544d-c1a5-3769-b5bd-81348b29a4a6",
                                                "text": "Aussitôt que la course est courue, il suffit de défalquer la part qui est réservée à l’Assistance publique et de diviser ce qui reste par le nombre de mises du cheval gagnant pour avoir immédiatement le rapport. Tout cela demande deux minutes, grâce à l’appareil installé.\nCe totalisateur automatique imaginé par un ingénieur australien, G. A. Julius, fonctionne depuis une dizaine d’années déjà sur une trentaine de champ de courses en Australie et aux Indes mais l’installation grandiose qui a été faite sur l’hippodrome de Longchamp est actuellement l’une des plus complètes et des plus perfectionnées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
