                                "fr": "Tu es fâché contre moi <w>par hasard</w> ?",
                                "it": "Sei <w>per caso</w> arrabbiato con me?",
                                "cs": "Nezlobíš se na mě <w>náhodou</w>?",
                                "tr": "Bana kızgın mısın <w>yoksa</w>?",
                                "es": "¿Estás enfadado conmigo <w>por casualidad</w>?"
                            }
                        },
                        {
                            "text": "Heb je <w>soms</w> een pen voor mij?",
                            "target_lang_translations": {
                                "en": "Do you <w>happen to</w> have a pen for me?",
                                "ru": "У тебя <w>случайно</w> нет для меня ручки?",
                                "pl": "Masz <w>może</w> dla mnie długopis?",
                                "de": "Hast du <w>vielleicht</w> einen Stift für mich?",
                                "fr": "Aurais-tu <w>par hasard</w> un stylo pour moi ?",
                                "it": "Hai <w>per caso</w> una penna per me?",
                                "cs": "Nemáš pro mě <w>náhodou</w> pero?",
                                "tr": "Yanında <w>acaba</w> benim için bir kalem var mı?",
                                "es": "¿Tienes <w>por casualidad</w> un bolígrafo para mí?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Maybe; expresses a suspicion or a tentative question.",
                        "ru": "Случайно, может быть; используется в вопросительных предложениях для выражения вежливого предположения или догадки.",
                        "pl": "Może; wyraża przypuszczenie lub ostrożne pytanie.",
                        "de": "Vielleicht; drückt eine Vermutung oder eine vorsichtige Frage aus.",
                        "fr": "Peut-être ; exprime une supposition ou une question prudente.",
                        "it": "Forse; esprime un sospetto o una domanda cauta.",
                        "cs": "Možná; vyjadřuje domněnku nebo zdvořilou, opatrnou otázku.",
                        "tr": "Belki; bir tahmini veya kibar bir soruyu ifade eder.",
                        "es": "Tal vez; expresa una sospecha o una pregunta prudente."
