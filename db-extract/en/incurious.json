                        "entry_id": "e84e0d04-22f9-3359-8e2d-09a590c88a23",
                        "glosses": [
                            "Lacking interest or curiosity; uninterested."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9825d5b-6f35-4436-8ae1-cb57a0c4fa7e",
                                "sense_id": "b2b05dc1-a4c4-35f6-81c4-269640da54b0",
                                "text": "A genuine Londoner is the most incurious animal in nature. Divide your acquaintance into two parts; the one set will never have seen Westminster Abbey—the other will be equally ignorant of St. Paul's."
                            },
                            {
                                "example_id": "d8816c2f-009c-4fdb-b6fb-b206a89ff4d5",
                                "sense_id": "b2b05dc1-a4c4-35f6-81c4-269640da54b0",
                                "text": "It takes an extraordinarily incurious mind to believe, in 2019, that the most vulnerable populations online are moderate Republicans like himself, given what women and people of color who dare to participate in public discourse routinely face."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b8f5eb7-0146-3592-b80c-1a2d5ba45e8d",
                        "entry_id": "e84e0d04-22f9-3359-8e2d-09a590c88a23",
                        "glosses": [
                            "Apathetic or indifferent."
                        ],
