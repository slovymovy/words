                        "entry_id": "6e775a73-fc7d-367f-af82-a10db6853973",
                        "glosses": [
                            "Reich, Königreich im alten Nordmesopotamien. Hauptstädte: Assur, später Ninive. Im engeren Sinne das Kernland, Siedlungsgebiet der Assyrer im heutigen Nordirak"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "94e57e0a-65d3-4fcf-97f3-1d20c56070a8",
                                "sense_id": "a588f935-34b5-32ca-a11c-2ab08d2e4790",
                                "text": "Der Händler reiste zwischen Anatolien und Assyrien hin und her."
                            },
                            {
                                "example_id": "2acb152c-f2a9-4624-8fe7-48b31ba857d9",
                                "sense_id": "a588f935-34b5-32ca-a11c-2ab08d2e4790",
                                "text": "Sanherib war König von Assyrien und von Babylonien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
