                    "sense_definition": "Quitter un endroit, ou contraindre quelqu'un à partir, généralement de force ou par ordre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quitter_lieu",
                    "name_type": "no",
                    "examples": [
