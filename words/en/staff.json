{
    "word_family": [
        "staffing",
        "staffer",
        "overstaffed",
        "understaffed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                    "sense_definition": "the group of people who work for an organization or business",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "workforce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to hire ten new members of <w>staff</w> this month to handle the extra work.",
                            "target_lang_translations": {
                                "ru": "Компания решила нанять десять новых <w>сотрудников</w> в этом месяце, чтобы справиться с дополнительной работой."
                            }
                        },
                        {
                            "text": "Most <w>staff</w> members at the hospital are working long hours to provide the best care for patients.",
                            "target_lang_translations": {
                                "ru": "Большинство <w>персонала</w> больницы работают сверхурочно, чтобы обеспечить лучший уход за пациентами."
                            }
                        }
                    ],
                    "synonyms": [
                        "personnel",
                        "employees",
                        "workers"
                    ],
                    "common_phrases": [
                        "members of staff",
                        "hospital staff",
                        "teaching staff",
                        "staff meeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "группа людей, работающих в организации или на предприятии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "персонал",
                                "target_lang_sense_clarification": "общий термин для сотрудников"
                            },
                            {
                                "target_lang_word": "сотрудники",
                                "target_lang_sense_clarification": "работники организации"
                            },
                            {
                                "target_lang_word": "штат",
                                "target_lang_sense_clarification": "постоянный состав работников"
                            },
                            {
                                "target_lang_word": "кадры",
                                "target_lang_sense_clarification": "совокупность работников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "256227ea-6c13-3750-82be-fc3ed35d3d84",
                    "sense_definition": "a long, thick wooden stick used for support while walking or as a weapon",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old traveler leaned heavily on his wooden <w>staff</w> as he climbed the steep mountain path.",
                            "target_lang_translations": {
                                "ru": "Старый путешественник тяжело опирался на свой деревянный <w>посох</w>, поднимаясь по крутой горной тропе."
                            }
                        },
                        {
                            "text": "He carried a sturdy walking <w>staff</w> to help him navigate the rocky terrain during the hike.",
                            "target_lang_translations": {
                                "ru": "Он нес крепкую <w>палку</w> для ходьбы, чтобы она помогала ему передвигаться по скалистой местности во время похода."
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "stave"
                    ],
                    "common_phrases": [
                        "walking staff",
                        "wooden staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "длинная толстая деревянная палка, используемая для опоры при ходьбе или как оружие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посох",
                                "target_lang_sense_clarification": "длинная палка для опоры"
                            },
                            {
                                "target_lang_word": "палка",
                                "target_lang_sense_clarification": "простой предмет для опоры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e9730f-8fc8-3b0a-8c1a-8bc6ae862095",
                    "sense_definition": "a set of five horizontal lines and four spaces on which musical notes are written",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer carefully wrote the high notes on the upper part of the musical <w>staff</w>.",
                            "target_lang_translations": {
                                "ru": "Композитор аккуратно записал высокие ноты в верхней части <w>нотного стана</w>."
                            }
                        },
                        {
                            "text": "Beginner students must learn how to read the notes placed on each line of the <w>staff</w>.",
                            "target_lang_translations": {
                                "ru": "Начинающие ученики должны научиться читать ноты, расположенные на каждой линии <w>нотоносца</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stave"
                    ],
                    "common_phrases": [
                        "musical staff",
                        "bass staff",
                        "treble staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "набор из пяти горизонтальных линий и четырех промежутков, на которых пишутся музыкальные ноты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нотный стан",
                                "target_lang_sense_clarification": "система линий для записи нот"
                            },
                            {
                                "target_lang_word": "нотоносец",
                                "target_lang_sense_clarification": "синоним нотного стана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e2b333-e3bf-321b-8c04-1dd29b30b106",
                    "sense_definition": "a group of officers who assist a commanding officer in the military",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "workforce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general met with his <w>staff</w> to discuss the strategic plans for the upcoming operation.",
                            "target_lang_translations": {
                                "ru": "Генерал встретился со своим <w>штабом</w>, чтобы обсудить стратегические планы предстоящей операции."
                            }
                        },
                        {
                            "text": "He served as a high-ranking officer on the general <w>staff</w> during the conflict.",
                            "target_lang_translations": {
                                "ru": "Во время конфликта он служил высокопоставленным офицером в генеральном <w>штабе</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "general staff",
                        "chief of staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "группа офицеров, помогающих командующему в армии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штаб",
                                "target_lang_sense_clarification": "орган управления войсками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71c180ab-272f-331b-921e-97a66c4e0514",
                    "sense_definition": "a pole used to support and display a flag",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national flag was raised to the top of the <w>staff</w> during the morning ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время утренней церемонии национальный флаг был поднят на вершину <w>флагштока</w>."
                            }
                        },
                        {
                            "text": "A tall silver flag <w>staff</w> stood prominently in front of the government building.",
                            "target_lang_translations": {
                                "ru": "Высокий серебряный <w>флагшток</w> заметно возвышался перед правительственным зданием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flag staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "шест, используемый для поддержки и демонстрации флага"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флагшток",
                                "target_lang_sense_clarification": "шест для флага"
                            },
                            {
                                "target_lang_word": "древко",
                                "target_lang_sense_clarification": "основание для крепления флага"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a1f06f0-5f76-3c4c-b93e-3b45a79d7824",
                    "sense_definition": "a pole or wand carried as a symbol of authority or office",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official carried a ceremonial <w>staff</w> to signify his high rank within the court.",
                            "target_lang_translations": {
                                "ru": "Чиновник нес церемониальный <w>жезл</w>, чтобы подчеркнуть свой высокий ранг при дворе."
                            }
                        },
                        {
                            "text": "During the procession, the bishop held a golden <w>staff</w> as a badge of his office.",
                            "target_lang_translations": {
                                "ru": "Во время процессии епископ держал золотой <w>посох</w> как символ своего сана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ceremonial staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "жезл или палочка, носимая как символ власти или должности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жезл",
                                "target_lang_sense_clarification": "символ власти или полномочий"
                            },
                            {
                                "target_lang_word": "скипетр",
                                "target_lang_sense_clarification": "символ монархической власти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ca04c7f-a46c-3fcf-b7fb-7df0f03168af",
                    "sense_definition": "to provide an organization with the necessary number of workers",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new restaurant needs to <w>staff</w> the kitchen with experienced chefs before the grand opening.",
                            "target_lang_translations": {
                                "ru": "Новому ресторану необходимо <w>укомплектовать</w> кухню опытными шеф-поварами перед торжественным открытием."
                            }
                        },
                        {
                            "text": "It is difficult to fully <w>staff</w> the hospital during the holiday season when many people are away.",
                            "target_lang_translations": {
                                "ru": "Трудно полностью <w>обеспечить персоналом</w> больницу в сезон отпусков, когда многие люди уезжают."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fully staff",
                        "staff a booth",
                        "adequately staffed"
                    ],
                    "target_lang_definitions": {
                        "ru": "обеспечивать организацию необходимым количеством работников"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укомплектовывать штаты",
                                "target_lang_sense_clarification": "набирать персонал"
                            },
                            {
                                "target_lang_word": "набирать персонал",
                                "target_lang_sense_clarification": "обеспечивать кадрами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}