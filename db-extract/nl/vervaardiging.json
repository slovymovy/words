                                                "sense_id": "73c29d22-eb58-35fa-b88a-01db4709233b",
                                                "text": "He had worked in construction all his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7bab559-84f5-3b42-ad63-ef0cd6da36b6",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "A building, model or some other structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b2ea9fc-da8b-479b-84bc-f1e4d8ad3f47",
                                                "sense_id": "b7bab559-84f5-3b42-ad63-ef0cd6da36b6",
                                                "text": "The office was a construction of steel and glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b927e54-622d-3ec7-a564-1bfbc0c72023",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "A (usually non-representational) structure, such as a collage etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d65081c7-f59d-4314-8256-f5b45bbb7fea",
                                                "sense_id": "7b927e54-622d-3ec7-a564-1bfbc0c72023",
                                                "text": "\"Construction in string and clockwork\" took first prize."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33463c40-bf5e-3acf-aee6-a25b5599efce",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "The manner in which something is built."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0407876-8b0f-4b7b-b396-54665cbf143d",
                                                "sense_id": "33463c40-bf5e-3acf-aee6-a25b5599efce",
                                                "text": "A thing of simple construction."
                                            },
                                            {
                                                "example_id": "5a8f623c-cb59-4a17-91ee-61b0285ca717",
                                                "sense_id": "33463c40-bf5e-3acf-aee6-a25b5599efce",
                                                "text": "Nothing could be more business-like than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins like a veteran army that had marched down to drink, only to be stricken motionless at the water’s edge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e0e99a-6668-3eb7-992d-9bcf63a6e2e4",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "A group of words arranged to form a meaningful phrase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c861fd7f-ddbe-3770-8ba7-937b36115dec",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "The act or result of construing the meaning of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdc5b1d-a057-4d45-bbc7-5312f6c66489",
                                                "sense_id": "c861fd7f-ddbe-3770-8ba7-937b36115dec",
                                                "text": "American conservatives tend to favor strict construction of the Constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "951075a9-c493-3d2c-abc6-0ae5599e64c9",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "The meaning or interpretation of a text, action etc.; the way something is viewed by an observer or onlooker."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6bfce46-5ecb-4694-a053-d53a5237be91",
                                                "sense_id": "951075a9-c493-3d2c-abc6-0ae5599e64c9",
                                                "text": "He had considered sending Lucille away to stay with relations. But then people might have put the worst construction on it – might believe she had done something she shouldn't have."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca41b80-ec96-3687-9c48-019abf1d30f8",
                                        "entry_id": "7d235bea-50e6-34f2-9372-93cfd329538a",
                                        "glosses": [
                                            "A geometric figure of arcs and line segments that is drawable with a straightedge and compass."
                                        ],
                                        "tags": [
