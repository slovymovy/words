                        ],
                        "form": "das Fallobst"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8aa5711e-70c6-32a4-a870-ba460b3545a1",
                        "entry_id": "5f2eb979-d535-32d9-a2d9-9a3282ff78a7",
                        "glosses": [
                            "reife (essbare) Früchte, die von hochwachsenden Pflanzen fallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cafb3306-6626-4061-aace-27513c080729",
                                "sense_id": "8aa5711e-70c6-32a4-a870-ba460b3545a1",
                                "text": "Das Fallobst liegt verstreut auf der Weide und ist schon von den Ameisen befallen."
                            },
                            {
                                "example_id": "57899a0b-80af-46f0-a5fc-37fbfbfc918c",
                                "sense_id": "8aa5711e-70c6-32a4-a870-ba460b3545a1",
                                "text": "„Es soll ja nur für Minuten sein; am Nachmittag hat es ein Gewitter mit kräftigen Böen gegeben, und ich möchte meinen Korb mit Fallobst füllen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "681ac391-e712-3420-9f12-bd0ae52f7c66",
                        "entry_id": "5f2eb979-d535-32d9-a2d9-9a3282ff78a7",
                        "glosses": [
                            "verdorbene Früchte, aufgrund der Schäden durch den Fall und dem folgenden Verrottungsprozess und/oder Insektenbefall; als minderwertig angesehene Ware"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4039a469-7644-4eb2-88f4-7fa59aef3d7b",
                                "sense_id": "681ac391-e712-3420-9f12-bd0ae52f7c66",
                                "text": "Das ist doch Fallobst, das Sie mir da andrehen wollen!"
                            },
                            {
                                "example_id": "5719fd62-515d-49ce-995b-568ca5a9eb7e",
                                "sense_id": "681ac391-e712-3420-9f12-bd0ae52f7c66",
                                "text": "„Eine gute Methode zur wirkungsvollen Entfernung größerer Mengen Fallobst, ist auch das Vergraben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ea534340-d671-313c-8f6e-332659e43b9d",
                        "entry_id": "5f2eb979-d535-32d9-a2d9-9a3282ff78a7",
                        "glosses": [
                            "Boxer, der sich möglichst schnell auszählen lässt, ohne wirklich angeschlagen zu sein"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b586fc0f-a45c-48ab-adb0-4efb7f736477",
                                "sense_id": "ea534340-d671-313c-8f6e-332659e43b9d",
                                "text": "„»Fallobst nennt man Leute, die sich flachlegen, ohne richtige Hiebe kassiert zu haben.«“"
                            },
                            {
                                "example_id": "76350fb1-55a0-41c3-a7c9-c1d43d586900",
                                "sense_id": "ea534340-d671-313c-8f6e-332659e43b9d",
                                "text": "„Und HBO, Amerikas Box-Fernsehsender, mag kein Fallobst auf dem Schirm.“"
                            },
                            {
                                "example_id": "33bfea18-8a1d-4b39-9652-eedd85bfdfb5",
                                "sense_id": "ea534340-d671-313c-8f6e-332659e43b9d",
                                "text": "„Der 1,95 Meter große Schwede mit afrikanischen Wurzeln, der 29 seiner 31 Profikämpfe gewonnen hat, davon 23 durch Knockout, ist wahrlich kein Fallobst.“"
                            },
                            {
                                "example_id": "39bf97e8-f8f6-4551-bd63-285cf8ada7dd",
                                "sense_id": "ea534340-d671-313c-8f6e-332659e43b9d",
                                "text": "„Fallobst sind Gegner, die sich bei der erstbesten Gelegenheit auch ohne harten Treffer auszählen lassen und unbeschadet mit der Kampfbörse nach Hause fahren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba4744cf-07c8-4e85-92a7-bff76e564105",
                        "source_entry_id": "5f2eb979-d535-32d9-a2d9-9a3282ff78a7",
                        "source_sense_id": "8aa5711e-70c6-32a4-a870-ba460b3545a1",
                        "source_sense_description": "reife (essbare) Früchte, die von hochwachsenden Pflanzen fallen",
                        "target_lang_word": "windfall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windfall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92c2f153-4fd9-39db-a536-d68b996b1c7b",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "Something that has been blown down by the wind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e93d463-284c-38f8-849c-d592e2eda51d",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "The act of something being blown down by wind."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45875ac5-299f-4a3c-a3b3-fd4da5174d31",
                                                "sense_id": "2e93d463-284c-38f8-849c-d592e2eda51d",
                                                "text": "The danger from windfall is greatest to trees developed in dense stands, which are tall and have slender stems, and increases with the age of the stand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aff33d22-9d55-326d-bccc-9911759bc189",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "A fruit that has fallen from a tree naturally, as from wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a790415e-5b52-4310-a15d-3d226f913a04",
                                                "sense_id": "aff33d22-9d55-326d-bccc-9911759bc189",
                                                "text": "They couldn't reach the branches, so they ate the windfalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "A sudden large benefit; especially, a sudden or unexpected large amount of money, as from lottery or sweepstakes winnings or an unexpected inheritance or gift."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad07cc43-4463-4162-9eb1-9c5abb8495a2",
                                                "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                                "text": "Businessmen rushed to get every last commodity aboard a departing ship, hoping for a windfall once the world realized these would be the very last sacks of flour available, thus driving up prices."
                                            },
                                            {
                                                "example_id": "7bf3917a-6ead-4bbd-a46d-11092edfdb6c",
                                                "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                                "text": "One of six siblings who’d been raised by a single mother, the client had earned a windfall of around $400,000 after going viral in 2021."
                                            },
                                            {
                                                "example_id": "cd1807a4-d245-4cc5-9892-c03a47b50e49",
                                                "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                                "text": "In addition to following the lead of Newcastle and Crystal Palace in making this a season of glory for clubs who rarely, if ever, win a trophy, Tottenham are also set to benefit from a £100m windfall after qualifying for next season's Champions League."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e504957-3a59-4ab5-8b5b-a3a16b6d3d20",
                        "source_entry_id": "5f2eb979-d535-32d9-a2d9-9a3282ff78a7",
