{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8ea7ed7-c3a9-3d8b-95b9-5e19d827e4f3",
                    "sense_definition": "To think about something carefully and for a period of time.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a few days to <w>mull</w> over your proposal before answering.",
                            "target_lang_translations": {
                                "ru": "Мне нужно несколько дней, чтобы <w>обдумать</w> ваше предложение, прежде чем ответить.",
                                "zh": "在回答之前，我需要几天时间来<w>琢磨</w>你的提议。"
                            }
                        },
                        {
                            "text": "He sat quietly by the window to <w>mull</w> the complex situation.",
                            "target_lang_translations": {
                                "ru": "Он тихо сидел у окна, чтобы <w>поразмыслить</w> над сложной ситуацией.",
                                "zh": "他静静地坐在窗边，<w>深思</w>着复杂的局势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ponder",
                        "consider",
                        "contemplate",
                        "reflect",
                        "deliberate"
                    ],
                    "antonyms": [
                        "ignore",
                        "dismiss"
                    ],
                    "common_phrases": [
                        "mull over",
                        "mull it over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и долго обдумывать что-либо.",
                        "zh": "指长时间且仔细地思考某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "тщательно взвешивать"
                            },
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "думать о чем-то продолжительное время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深思",
                                "target_lang_sense_clarification": "仔细考虑"
                            },
                            {
                                "target_lang_word": "琢磨",
                                "target_lang_sense_clarification": "反复思考"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a051067b-5885-374d-b1fb-70fa9e7eb6f6",
                    "sense_definition": "To heat a beverage, such as wine, cider, or beer, with spices and sugar.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>mull</w> the wine with cinnamon and cloves for the party.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>подогреть</w> вино с корицей и гвоздикой для вечеринки.",
                                "zh": "我们决定为派对准备一些<w>加香料加热</w>的葡萄酒，里面放了肉桂和丁香。"
                            }
                        },
                        {
                            "text": "The smell of <w>mulled</w> cider filled the warm kitchen.",
                            "target_lang_translations": {
                                "ru": "Запах <w>горячего сидра со специями</w> наполнил теплую кухню.",
                                "zh": "温暖的厨房里弥漫着<w>加香料加热</w>的苹果酒香气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mulled wine",
                        "mulled cider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нагревать напиток (вино, сидр, пиво) со специями и сахаром.",
                        "zh": "将葡萄酒、苹果酒或啤酒等饮料加热，并加入香料和糖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подогревать со специями",
                                "target_lang_sense_clarification": "готовить горячий напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加香料加热",
                                "target_lang_sense_clarification": "制作热饮"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba640797-d5f3-38a5-89e8-0ed846e94898",
                    "sense_definition": "A situation that has been mishandled; a mess, failure, or mistake.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to fix the engine himself but made a <w>mull</w> of it.",
                            "target_lang_translations": {
                                "ru": "Он попытался починить двигатель сам, но устроил из этого <w>путаницу</w>.",
                                "zh": "他试图自己修理引擎，结果却<w>搞砸</w>了。"
                            }
                        },
                        {
                            "text": "I hope I do not make a <w>mull</w> of this important presentation.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, я не устрою <w>провал</w> на этой важной презентации.",
                                "zh": "我希望这次重要的演讲不要<w>搞砸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mess",
                        "bungle",
                        "botch"
                    ],
                    "antonyms": [
                        "success",
                        "triumph"
                    ],
                    "common_phrases": [
                        "make a mull of"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, с которой плохо справились; беспорядок, неудача или ошибка.",
                        "zh": "处理不当的情况；搞砸、失败或错误。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "беспорядок"
                            },
                            {
                                "target_lang_word": "провал",
                                "target_lang_sense_clarification": "неудача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞砸",
                                "target_lang_sense_clarification": "弄糟事情"
                            },
                            {
                                "target_lang_word": "一团糟",
                                "target_lang_sense_clarification": "混乱的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daf0f352-d766-3d5c-8689-3c3e28adcc06",
                    "sense_definition": "A high point of land extending into a body of water; a promontory or headland.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighthouse stands on the rocky <w>mull</w> overlooking the stormy sea.",
                            "target_lang_translations": {
                                "ru": "Маяк стоит на скалистом <w>мысе</w>, возвышающемся над бурным морем.",
                                "zh": "灯塔矗立在俯瞰风暴海面的岩石<w>岬角</w>上。"
                            }
                        },
                        {
                            "text": "We hiked around the <w>mull</w> to get a better view of the coast.",
                            "target_lang_translations": {
                                "ru": "Мы обошли <w>мыс</w>, чтобы лучше рассмотреть побережье.",
                                "zh": "我们绕着<w>岬角</w>徒步，以便更好地欣赏海岸景色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promontory",
                        "headland",
                        "cape"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий участок суши, выдающийся в водоем; мыс.",
                        "zh": "伸入水中的高地；岬角或海角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мыс",
                                "target_lang_sense_clarification": "география"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "岬角",
                                "target_lang_sense_clarification": "地理术语"
                            },
                            {
                                "target_lang_word": "海角",
                                "target_lang_sense_clarification": "突出于海面的陆地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f068a395-a6f3-3f42-8148-66fcc8418a67",
                    "sense_definition": "A thin, soft, plain-woven cotton fabric.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The summer dress was made of fine white <w>mull</w>.",
                            "target_lang_translations": {
                                "ru": "Летнее платье было сшито из тонкого белого <w>муслина</w>.",
                                "zh": "这条夏日连衣裙是用精细的白色<w>薄棉布</w>制成的。"
                            }
                        },
                        {
                            "text": "She bought some <w>mull</w> to make light curtains for the nursery.",
                            "target_lang_translations": {
                                "ru": "Она купила немного <w>кисеи</w>, чтобы сшить легкие занавески для детской.",
                                "zh": "她买了一些<w>薄棉布</w>来给婴儿房做轻薄的窗帘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "muslin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая, мягкая хлопчатобумажная ткань полотняного переплетения.",
                        "zh": "一种薄而柔软的平纹棉织物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "муслин",
                                "target_lang_sense_clarification": "тип ткани"
                            },
                            {
                                "target_lang_word": "кисея",
                                "target_lang_sense_clarification": "легкая прозрачная ткань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄棉布",
                                "target_lang_sense_clarification": "织物类型"
                            },
                            {
                                "target_lang_word": "细棉纱",
                                "target_lang_sense_clarification": "轻薄织物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10c239a4-4d3c-3f67-93b3-9436997dfe3e",
                    "sense_definition": "Marijuana that has been chopped or prepared for smoking.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept his <w>mull</w> in a small tin box inside his bag.",
                            "target_lang_translations": {
                                "ru": "Он хранил свою <w>травку</w> в маленькой жестяной коробочке в сумке.",
                                "zh": "他把<w>大麻</w>放在包里的一个小铁盒子里。"
                            }
                        },
                        {
                            "text": "They sat in the park and smoked some <w>mull</w>.",
                            "target_lang_translations": {
                                "ru": "Они сидели в парке и курили <w>травку</w>.",
                                "zh": "他们坐在公园里抽了一些<w>大麻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weed",
                        "pot",
                        "cannabis",
                        "marijuana",
                        "grass"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Марихуана, измельченная или подготовленная для курения.",
                        "zh": "已切碎或准备好用于吸食的大麻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травка",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "марихуана",
                                "target_lang_sense_clarification": "наркотическое вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大麻",
                                "target_lang_sense_clarification": "毒品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21214bc0-25ba-3d7d-880f-c98d90cb1886",
                    "sense_definition": "A type of forest humus consisting of mixed organic matter and mineral soil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rich <w>mull</w> on the forest floor supports diverse plant life.",
                            "target_lang_translations": {
                                "ru": "Богатый <w>мулль</w> на лесной подстилке поддерживает разнообразную растительность.",
                                "zh": "森林地面上肥沃的<w>腐殖质</w>滋养了多样的植物生命。"
                            }
                        },
                        {
                            "text": "Earthworms play a key role in creating <w>mull</w> by mixing soil and leaves.",
                            "target_lang_translations": {
                                "ru": "Дождевые черви играют ключевую роль в создании <w>мягкого гумуса</w>, смешивая почву и листья.",
                                "zh": "蚯蚓通过混合土壤和落叶，在形成<w>腐殖质</w>的过程中起着关键作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип лесного гумуса, состоящий из смешанных органических веществ и минеральной почвы.",
                        "zh": "一种由有机物质和矿质土壤混合而成的森林腐殖质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мулль",
                                "target_lang_sense_clarification": "тип гумуса"
                            },
                            {
                                "target_lang_word": "мягкий гумус",
                                "target_lang_sense_clarification": "почвоведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "森林腐殖质",
                                "target_lang_sense_clarification": "土壤学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ae30951f-936e-3405-84e0-0c60a48510ee",
                    "sense_definition": "An island in the Inner Hebrides of Scotland.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a ferry to visit the Isle of <w>Mull</w> last summer.",
                            "target_lang_translations": {
                                "ru": "Прошлым летом мы сели на паром, чтобы посетить остров <w>Малл</w>.",
                                "zh": "去年夏天，我们乘渡轮去了<w>马尔岛</w>。"
                            }
                        },
                        {
                            "text": "The colorful houses of Tobermory are a famous sight on <w>Mull</w>.",
                            "target_lang_translations": {
                                "ru": "Разноцветные дома Тобермори — известная достопримечательность на <w>Малле</w>.",
                                "zh": "托伯莫里的彩色房屋是<w>马尔岛</w>上的著名景观。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Isle of Mull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остров во Внутренних Гебридских островах Шотландии.",
                        "zh": "苏格兰内赫布里底群岛中的一个岛屿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Малл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马尔岛",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}