                ],
                "senses": [
                    {
                        "sense_id": "4871de28-f0a7-35b9-8590-7bfa43c89ea9",
                        "entry_id": "eff3fb88-f2e2-3d5c-a899-27629cbac9b5",
                        "glosses": [
                            "Sortir des bouteilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd11e09-3f57-44c7-b42c-3caa79b60352",
                                "sense_id": "4871de28-f0a7-35b9-8590-7bfa43c89ea9",
                                "text": "Lorsqu’un vin vient à mal tourner, la maison n’hésite pas à le débouteiller pour l’employer dans un vin de consommation courante, dont il peut servir à bonifier la qualité."
                            },
                            {
                                "example_id": "d65271c4-196e-43e8-ae90-05efa968f83c",
                                "sense_id": "4871de28-f0a7-35b9-8590-7bfa43c89ea9",
                                "text": "Peut-être convient-il pourtant de mentionner qu’il trouva ou systématisa le moyen d’éclaircir le vin sans le débouteiller, comme on le faisait jusqu’alors, et qu’il multiplia les essais sur la qualité et la quantité du sucre à introduire dans les tirages pour obtenir une mousse contrôlable."
                            }
                        ]
                    },
                    {
                        "sense_id": "acb216bf-6e27-33ef-97ee-c9c0da1af368",
                        "entry_id": "eff3fb88-f2e2-3d5c-a899-27629cbac9b5",
                        "glosses": [
                            "Cesser (pour un embouteillage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a191ca01-3e69-4791-bc2a-eb5e964b5bd9",
                                "sense_id": "acb216bf-6e27-33ef-97ee-c9c0da1af368",
                                "text": "Mais si avec les conducteurs l’embouteillage ne pouvait absolument pas se débouteiller, sans les conducteurs il le pouvait encore moins."
                            }
                        ]
                    }
                ],
