                        ],
                        "form": "es ist behandtucht"
                    },
                    {
                        "form_id": "74452a01-2dd7-48c4-87ae-e150474be863",
                        "entry_id": "01bfac2b-a41c-384a-94ef-0d367f622873",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind behandtucht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d9408fa-33bd-3c0a-b7b6-dc5a0ebafe0f",
                        "entry_id": "01bfac2b-a41c-384a-94ef-0d367f622873",
                        "glosses": [
                            "ein Handtuch um den Körper gelegt tragend; mit einem ausgebreiteten Handtuch versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aaf4490-8ef2-4fdc-b32b-92b95e466d71",
                                "sense_id": "2d9408fa-33bd-3c0a-b7b6-dc5a0ebafe0f",
                                "text": "„War er draußen vielleicht noch ein betuchter Mercedesfahrer, so ist er hier nur noch ein behandtuchter Nackedei.“"
                            },
                            {
                                "example_id": "3c04a2f6-ad23-4755-abd0-2d6d7e68abb8",
                                "sense_id": "2d9408fa-33bd-3c0a-b7b6-dc5a0ebafe0f",
                                "text": "„Nach nur rund vier Wochen war es dann soweit: Aus fünf rohen Baumstämmen aus Bayern war eine Sauna entstanden, die den behandtuchten Besucher sogleich nach Skandinavien versetzt.“"
                            },
                            {
                                "example_id": "1d1faa6b-10be-481e-9de0-918c73361e8f",
                                "sense_id": "2d9408fa-33bd-3c0a-b7b6-dc5a0ebafe0f",
                                "text": "„Liegewiesen an den Badeseen, Cafés, der Englische Garten, alle öffentlichen Plätze Münchens quellen über vor Menschen, der Geräuschpegel ist stabil auf Discomodus und die Schattenplätze sind behandtucht seit spätestens sieben Uhr.“"
                            },
                            {
                                "example_id": "1013568f-6c8d-43a9-b422-f91e80b8661c",
                                "sense_id": "2d9408fa-33bd-3c0a-b7b6-dc5a0ebafe0f",
                                "text": "„Die ersten zehn standen Punkt zwei Uhr behandtucht vor der Tür zu den Duschkabinen, P. Franz, der die ganze Aktion überwachte, öffnete, dann stürmte man hinein.“"
                            },
                            {
                                "example_id": "11c6c731-9c8b-4fce-a5e5-f160da60f99f",
                                "sense_id": "2d9408fa-33bd-3c0a-b7b6-dc5a0ebafe0f",
