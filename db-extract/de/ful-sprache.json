                "senses": [
                    {
                        "sense_id": "ec3cb0c0-1d19-3460-ac25-6f096ed868f6",
                        "entry_id": "6720cf09-1f91-3be5-9fec-a3a6e23d0069",
                        "glosses": [
                            "eine Niger-Kongo-Sprache (genauer: atlantische Sprache), die in Westafrika und Zentralafrika verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9328ff-e95d-4e39-868c-b4b75aa45608",
                                "sense_id": "ec3cb0c0-1d19-3460-ac25-6f096ed868f6",
                                "text": "„Die Übereinstimmung einiger Zahlwörter der Ful-Sprache mit den entsprechenden einiger Süd-Afrikanischen Sprachen hat zu allerlei verfänglichen Schlüssen geführt, seitdem besonders Richard Lauder diesen Stamm in vielen Punkten mit den Kafirn Süd-Afrika’s verglich.“"
                            },
                            {
                                "example_id": "17a172b7-f56e-4244-8599-9d5eb6cbf377",
                                "sense_id": "ec3cb0c0-1d19-3460-ac25-6f096ed868f6",
                                "text": "„Für unser Thema sei erwähnt, dass Westermann selbst die Fulbe-Sprache in den Hausa-Städten in heutigem Nigeria studierte und 1909 ein ‚Handbuch der Ful-Sprache‘ publizierte.“"
                            },
                            {
                                "example_id": "579832b3-7068-49ab-90f6-a74d4fdcd5d8",
                                "sense_id": "ec3cb0c0-1d19-3460-ac25-6f096ed868f6",
                                "text": "„Auch für die Ful-Sprache steht ein Wörterbuch von D. Westermann zur Verfügung.“"
                            },
                            {
                                "example_id": "d4c636cc-3531-45bf-bef8-9284b5376288",
                                "sense_id": "ec3cb0c0-1d19-3460-ac25-6f096ed868f6",
                                "text": "„Zuerst habe ich als charakteristisch für die Ful-Sprache zu bemerken, dass ein Unterschied zwischen denjenigen Eigenschaftswörtern, welche die Eigenschaften von Menschen, und denjenigen, welche die von Thieren bezeichnen, sich in den Endungen nachweisen lässt[…]“"
                            },
                            {
                                "example_id": "5f8a4f34-afb8-4e8f-8a26-f488967678ef",
                                "sense_id": "ec3cb0c0-1d19-3460-ac25-6f096ed868f6",
                                "text": "„[…] Adjektiv als Wortstamm sind z.B. mōdibbo- ‚gelehrt‘ von mōdibbo ‚Gelehrter‘, laddē- ‚wild‘ von ladde ‚Steppe‘, fulfuldē- ‚auf die Ful-Sprache bezüglich‘, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
