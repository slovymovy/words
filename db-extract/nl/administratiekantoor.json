                                        "sense_id": "175cce2f-e1fe-3fbd-a841-d1f687b7467e",
                                        "entry_id": "863b787c-af2b-3761-8702-d5a9662d211d",
                                        "glosses": [
                                            "Judicious use of means to accomplish an end."
