                                                "example_id": "fcac05c0-b27e-45ab-9a89-761b2c24656a",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Spätestens als der Koblenzer Verleger Karl Baedeker im Jahr 1828 die »Rheinreise von Mainz bis Cöln. Handbuch für Schnellreisende« publizierte und damit die Reihe seiner Reiseführer eröffnete, war Forster widerlegt.“"
                                            },
                                            {
                                                "example_id": "bec52ce9-cf7c-4ea0-858b-80123d1fa7a5",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Touristen bewegen sich im Bekannten, in dem, was sie sorgfältig im Reiseführer und im Hotelprospekt studiert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aadd3ae-06c8-42a9-9470-6d6d83c5b6c2",
                        "source_entry_id": "0f4001ac-1ea2-3f7a-ae35-de155ba21341",
                        "source_sense_id": "93efcf42-096e-3d95-9cd5-b79cd5736e74",
                        "source_sense_description": "iemand die reizigers begeleidt",
                        "target_lang_word": "Fremdenführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fremdenführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e926d57a-2014-3173-8ddc-4c1affd7fb06",
                                        "entry_id": "d394f6a0-d9a1-3972-961d-8ac9c0d3b18f",
                                        "glosses": [
                                            "Person, die andere durch eine ihnen unbekannte Umgebung führt und sie erklärt"
                                        ],
                                        "tags": [
                                            "Tourismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "535afa80-c252-4994-b700-5066253f5b3c",
                                                "sense_id": "e926d57a-2014-3173-8ddc-4c1affd7fb06",
                                                "text": "„Ein Fremdenführer zeigt ihnen die Pariser Katakomben.“"
                                            },
                                            {
                                                "example_id": "c4b5787a-b125-4f32-bfbc-2ac552bc71b6",
                                                "sense_id": "e926d57a-2014-3173-8ddc-4c1affd7fb06",
                                                "text": "„Der Fremdenführer war der wichtigste Mann der Unternehmung.“"
                                            },
                                            {
                                                "example_id": "20173f33-fefb-4002-bf95-26e9e0e0170c",
                                                "sense_id": "e926d57a-2014-3173-8ddc-4c1affd7fb06",
                                                "text": "Seit 1952 leiten Fremdenführer Touren durch die UN-Gebäude in New York. Jetzt haben sie ein neues Outfit bekommen."
                                            },
                                            {
                                                "example_id": "54c94bfe-98e1-4832-8764-7376ccc9d8c8",
                                                "sense_id": "e926d57a-2014-3173-8ddc-4c1affd7fb06",
                                                "text": "Der Fremdenführer erzählte, dass die britischen Soldaten, die dort [in Cape Coast Castle in Ghana] stationiert waren, oft die einheimischen Frauen heirateten."
                                            },
                                            {
                                                "example_id": "1fe2ff3f-089a-4ffe-97fc-d0e14be0d406",
                                                "sense_id": "e926d57a-2014-3173-8ddc-4c1affd7fb06",
                                                "text": "Robert, Mitte 60, arbeitet dort [in Bagiu, Philippinen] als Fremdenführer und lädt uns ein zu einer Wanderung über Stock und Stein, Abhänge hinab und hinauf – wir gehen und sehen …."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
