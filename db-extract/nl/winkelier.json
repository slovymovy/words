                        "sense_id": "0772e071-efe8-360f-a56c-c25f902dced0",
                        "entry_id": "ff6db0eb-ee36-34eb-9506-18c744a91128",
                        "glosses": [
                            "een detailhandelaar die een winkel houdt of heeft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "5da1d93a-1840-40bb-a316-1e7029cd790c",
                                "sense_id": "0772e071-efe8-360f-a56c-c25f902dced0",
                                "text": "Vraag het anders even aan die winkelier, dan weet je het zeker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cfdc5d3-5834-4d02-80fe-29706b9c30c9",
                        "source_entry_id": "ff6db0eb-ee36-34eb-9506-18c744a91128",
                        "source_sense_id": "0772e071-efe8-360f-a56c-c25f902dced0",
                        "target_lang_word": "Ladenbesitzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ladenbesitzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                        "entry_id": "aae3cbce-dc94-3def-a048-8b947e3ccc31",
                                        "glosses": [
                                            "jemand, der einen Laden (ein Geschäft) besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd7a8969-4880-4f0c-bb43-6dad88fc4953",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„Auf den Straßen jenseits des eisernen Zaunes ballten sich Touristen, Radfahrer, Ladenbesitzer und Gemüsehändler vom nahen Markt.“"
                                            },
                                            {
                                                "example_id": "b3f5161b-f375-49cb-b4b4-8ebc9eaaf21a",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„In der Bayerischen Residenz und im Umland erkannten am 30. Juli 1914 viele Ladenbesitzer die günstige Gelegenheit und setzten, getreu dem Prinzip von Angebot und Nachfrage, die Preise herauf.“"
                                            },
                                            {
                                                "example_id": "b668cb6e-a534-4e05-9110-a700d148c051",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„Der Ladenbesitzer wischte sich mit der dunkelblauen Schürze, die seinen dicken Bauch bedeckte, als wäre er ein Tisch und die Schürze eine Decke voller Fettflecken, den Mund ab.“"
                                            },
                                            {
                                                "example_id": "ab557c6b-42a4-4bcf-b4cf-6f0ec659022e",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„Der Ladenbesitzer kannte die Not der Kinder und hatte sie während des Krieges einmal dabei erwischt, wie sie heimlich ihre schmutzigen Finger in ein Honigglas getaucht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "948d13f9-a228-490f-986c-4797d20661d5",
                        "source_entry_id": "ff6db0eb-ee36-34eb-9506-18c744a91128",
