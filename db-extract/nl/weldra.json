                                    {
                                        "sense_id": "ab0db28e-022a-3505-848d-00862ac45ec3",
                                        "entry_id": "adcf6f38-eca8-3625-b2b7-87c8b7e18dcd",
                                        "glosses": [
                                            "Dans peu de temps ; incessamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3eae2b0-3f4f-41dd-a057-0250f0060217",
                                                "sense_id": "ab0db28e-022a-3505-848d-00862ac45ec3",
                                                "text": "Bientôt vous le recevrez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0326dd59-5c72-3571-a359-1ed61827ed93",
                                        "entry_id": "adcf6f38-eca8-3625-b2b7-87c8b7e18dcd",
                                        "glosses": [
                                            "Peu de temps après."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187eb560-602f-489d-a474-de9363294f48",
                                                "sense_id": "0326dd59-5c72-3571-a359-1ed61827ed93",
                                                "text": "Le jeune Desherbiers avait bien supporté la fatigue des marches, il commençait même à se donner des airs en faisant résonner les molettes de ses éperons sur le pavé, en portant son bonnet de police coquettement posé sur l’oreille droite, et les Berlinoises, qui avaient remarqué sa jolie tête blonde, lui eurent bientôt appris à walser."
                                            },
                                            {
                                                "example_id": "2518ef47-0746-4567-b15e-bf09ae16c966",
                                                "sense_id": "0326dd59-5c72-3571-a359-1ed61827ed93",
                                                "text": "Le vent, qui parfois mollissait, reprenait bientôt avec plus de rage, au milieu de grains de grêle et de neige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba10592-2e10-3c8f-86c0-4109022b86c3",
                                        "entry_id": "adcf6f38-eca8-3625-b2b7-87c8b7e18dcd",
                                        "glosses": [
                                            "Vite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38198225-94b5-41d7-8be6-74ada62e9289",
                                                "sense_id": "2ba10592-2e10-3c8f-86c0-4109022b86c3",
                                                "text": "On s’habitue bientôt à cela."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22cb443-c92a-3e61-ad58-13399f74f2ee",
                                        "entry_id": "adcf6f38-eca8-3625-b2b7-87c8b7e18dcd",
                                        "glosses": [
                                            "Avec une maturation insuffisante"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71779148-a3d4-4661-8c00-1ee5ccf1a46a",
                                                "sense_id": "d22cb443-c92a-3e61-ad58-13399f74f2ee",
                                                "text": "Cela est bientôt dit : cela est facile à dire, à prescrire, mais non à exécuter."
                                            },
                                            {
                                                "example_id": "0f8cf7f9-df09-464e-af1c-c86a83becc32",
                                                "sense_id": "d22cb443-c92a-3e61-ad58-13399f74f2ee",
                                                "text": "— Un ministère homogène, s’écria Garain, c’est bientôt dit. Il n’en faut pas moins s’inspirer des tendances propres aux différentes fractions de la Chambre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
