                ],
                "senses": [
                    {
                        "sense_id": "8ffad6ee-4f27-3b90-ae23-90f8a907b097",
                        "entry_id": "d1f26610-600e-31a3-b9ec-5949c843f903",
                        "glosses": [
                            "Eingang zu einem Tunnel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c8ae06-454e-4120-8c2d-4b216bf05648",
                                "sense_id": "8ffad6ee-4f27-3b90-ae23-90f8a907b097",
                                "text": "„An der Innenwand befand sich ein Tunneleingang.“"
                            },
                            {
                                "example_id": "6a6c1b65-7b3e-43be-a435-e7cf644ad9a9",
                                "sense_id": "8ffad6ee-4f27-3b90-ae23-90f8a907b097",
                                "text": "„Den Reliefs zufolge konnte der angestrebte Tunneleingang nicht viel weiter als 400 Meter von unserem Standort entfernt sein; dazwischen erhoben sich solide wirkende Bauwerke, die vermutlich bis unterhalb der Eisoberfläche noch begehbar waren.“"
                            },
                            {
                                "example_id": "aa3143dd-bc6c-44ec-99ae-e994c2c1c641",
                                "sense_id": "8ffad6ee-4f27-3b90-ae23-90f8a907b097",
                                "text": "„Wir blieben ungefähr eine halbe Stunde in der Nähe des Tunneleingangs, und meine Begleiter stellten Messungen und navigatorische Berechnungen an.“"
                            },
                            {
                                "example_id": "208509ed-3fef-4929-bcc4-5b219c0c168a",
                                "sense_id": "8ffad6ee-4f27-3b90-ae23-90f8a907b097",
                                "text": "„Vergeblich forderte Ben-Dov ihn auf, den Tunneleingang zu schließen, bevor die Angelegenheit von den Muslimen entdeckt würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
