                                    {
                                        "sense_id": "67e96ab4-5cfe-3d5d-8d51-a6add651adfa",
                                        "entry_id": "2a2c645c-a500-3975-b48d-48433ee1a982",
                                        "glosses": [
                                            "One who oversees a gang of workmen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67742037-51eb-40af-afe0-8b1dc4fc481d",
                                                "sense_id": "67e96ab4-5cfe-3d5d-8d51-a6add651adfa",
                                                "text": "Primary responsibility must rest with a ganger. He failed to appreciate the danger of disturbing the track, short of ballast, on a very hot day."
                                            },
                                            {
                                                "example_id": "3fbd289b-f8d9-499f-8ceb-64319b6db5a5",
                                                "sense_id": "67e96ab4-5cfe-3d5d-8d51-a6add651adfa",
                                                "text": "The length ganger saw the train passing with the van derailed and promptly telephoned the Sandbach signalman, who restored his signals to danger, but not in time to stop the train before the final derailment occurred."
                                            },
                                            {
                                                "example_id": "b6316778-8428-477b-a84f-9bcece58826c",
                                                "sense_id": "67e96ab4-5cfe-3d5d-8d51-a6add651adfa",
                                                "text": "'My dad was a railway ganger.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa82c31b-a222-387b-80a5-030a959b221c",
                                        "entry_id": "2a2c645c-a500-3975-b48d-48433ee1a982",
