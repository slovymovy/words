    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fd8e1052-9de5-38db-85e0-83abd9f43d96",
                "word": "unaided",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "205ee605-edc4-34d0-b4e5-65996d23769f",
                        "entry_id": "fd8e1052-9de5-38db-85e0-83abd9f43d96",
                        "glosses": [
                            "Without the help, aid or assistance of someone or something."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "02f2427c-f250-4567-b638-5bb9f3e09565",
                                "sense_id": "205ee605-edc4-34d0-b4e5-65996d23769f",
                                "text": "Fleas are difficult to see with the unaided eye."
                            },
                            {
                                "example_id": "22eb5e25-0763-412e-91fe-43fefdc0bc72",
                                "sense_id": "205ee605-edc4-34d0-b4e5-65996d23769f",
                                "text": "So much for Norman blood unaided by Victorian lucre."
                            },
                            {
                                "example_id": "6f0a4e6c-49be-4a96-b003-d4a485199830",
                                "sense_id": "205ee605-edc4-34d0-b4e5-65996d23769f",
                                "text": "Superheating, first introduced with the \"Abs\", stopped further development in compounding, in New Zealand as elsewhere, and the \"Abs\" succeeded in dealing with the growing traffic unaided for more than a decade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27564671-f89c-42a5-8a15-733bed30d9b5",
                        "source_entry_id": "fd8e1052-9de5-38db-85e0-83abd9f43d96",
                        "source_sense_id": "205ee605-edc4-34d0-b4e5-65996d23769f",
                        "source_sense_description": "without the aid of a tool",
                        "target_lang_word": "bloß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02db5d15-ad7b-3d63-81bd-bf33347cf849",
                                        "entry_id": "dc3e8e61-5ce1-3b2f-a3d6-6e1e278299c4",
                                        "glosses": [
                                            "ohne Bekleidung, ohne Hülle, ohne Schutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704b1e88-7a90-4764-9e80-bb91558446f3",
                                                "sense_id": "02db5d15-ad7b-3d63-81bd-bf33347cf849",
                                                "text": "Mit bloßen Füßen lief sie durch den Schlamm."
                                            },
                                            {
                                                "example_id": "431ebb0b-6998-44a1-91d6-caef3476a9b8",
                                                "sense_id": "02db5d15-ad7b-3d63-81bd-bf33347cf849",
                                                "text": "Das Baby hatte sich bloß gestrampelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                        "entry_id": "dc3e8e61-5ce1-3b2f-a3d6-6e1e278299c4",
                                        "glosses": [
                                            "ohne alles andere, Ergänzende, nichts Weiteres als das Bezeichnete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78374237-11d6-4b31-964c-7cbde9cf36f3",
                                                "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                                "text": "Auf einen bloßen Brief würde ich nicht reagieren."
                                            },
                                            {
                                                "example_id": "02e91d9d-6b54-44db-aab6-3786e926402f",
                                                "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                                "text": "Mir wurde schon beim bloßen Anblick ganz mulmig."
                                            },
                                            {
                                                "example_id": "cabeebc4-2ee3-486b-893e-77ba946fa0f5",
                                                "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                                "text": "Kannst du das mit bloßem Auge erkennen?"
                                            },
                                            {
                                                "example_id": "b566e972-6c61-463f-983e-1047ac4b2f80",
                                                "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                                "text": "„Wie man mit ihm umging, machte deutlich, daß die Sache mehr als eine bloße Untersuchungshaft war.“"
                                            },
                                            {
                                                "example_id": "7482cf85-b218-422c-b515-1ad500951ff9",
                                                "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                                "text": "adverbial: Bloß mit Worten wirst du nicht überzeugen."
                                            },
                                            {
                                                "example_id": "479ec63b-2803-442c-8734-f52518b75fad",
                                                "sense_id": "246166ed-8482-3d30-a434-74c301dc4afd",
                                                "text": "„Seit die Kultur vom Kultus abgefallen ist und aus sich selber einen gemacht hat, ist sie denn auch nichts anderes mehr als ein Abfall, und alle Welt ist ihrer nach bloßen fünfhundert Jahren so müd und satt, als wenn sie's, salva venia, mit eisernen Kochlöffeln gefressen hätt...“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bloß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab57b6b9-3469-3eb2-a88b-45618ac6cad6",
