    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1178977-e4ed-3082-bed8-b6d04b835207",
                    "sense_definition": "iets openen door een draaiende beweging te maken, zoals een kraan of een deksel",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "openen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>draait</w> de keukenkraan voorzichtig <w>open</w> om water te pakken.",
                            "target_lang_translations": {
                                "en": "He carefully <w>turns on</w> the kitchen tap to get some water."
                            }
                        },
                        {
                            "text": "Kun je die glazen pot met jam voor mij <w>opendraaien</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>twist open</w> that glass jar of jam for me?"
                            }
                        }
                    ],
                    "antonyms": [
                        "dichtdraaien",
                        "toedraaien"
                    ],
                    "common_phrases": [
                        "de kraan opendraaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to open something by making a turning or twisting motion, such as a tap, faucet, lid, or cap"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn on",
                                "target_lang_sense_clarification": "tap, faucet"
                            },
                            {
                                "target_lang_word": "to unscrew",
                                "target_lang_sense_clarification": "lid, cap"
                            },
                            {
                                "target_lang_word": "to twist open",
                                "target_lang_sense_clarification": "jar, bottle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9100b24b-c005-3d52-bd7c-952971abfad6",
                    "sense_definition": "door middel van een draaiende beweging wijder openzetten of activeren",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "openen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat het koud werd in de kamer, <w>draaide</w> hij de verwarming verder <w>open</w>.",
                            "target_lang_translations": {
                                "en": "Because it was getting cold in the room, he <w>turned up</w> the heating."
                            }
                        },
                        {
                            "text": "Ze <w>draaiden</w> de gaskraan helemaal <w>open</w> om het fornuis aan te steken.",
                            "target_lang_translations": {
                                "en": "They <w>opened</w> the gas valve completely to light the stove."
                            }
                        }
                    ],
                    "antonyms": [
                        "dichtdraaien"
                    ],
                    "common_phrases": [
                        "de verwarming opendraaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn up or open wider by rotating a knob or valve"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn up",
                                "target_lang_sense_clarification": "heating, radiator"
                            },
                            {
                                "target_lang_word": "to open up",
                                "target_lang_sense_clarification": "valve"
                            }
                        ]
                    }
                }
            ]
        }
    ]
