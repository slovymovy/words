            {
                "entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                "word": "homothétie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4808d41e-382c-44fb-be57-e5171ae2c820",
                        "entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                        "tags": [
                            "plural"
                        ],
                        "form": "homothéties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5c5b8bf-4b27-382f-911a-72c54a85b996",
                        "entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                        "glosses": [
                            "Transformation géométrique avec un facteur k, positif ou négatif, qui, étant donné un centre O, associe à un point M le point M' tel que ⃑OM'=k⃑OM."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31642d58-48d4-4979-9b7c-a29a2e1536b6",
                                "sense_id": "e5c5b8bf-4b27-382f-911a-72c54a85b996",
                                "text": "Le pantographe qui permet à un dessinateur de reporter un tracé à une échelle plus ou moins grand ou les agrandissements d’épreuves photographiques sont des applications de l’homothétie."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb1a4527-7cbd-3d2e-a262-b5b17ef40d8a",
                        "entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                        "glosses": [
                            "Transposition à plus petite ou plus grande échelle."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "0821e15c-4a2d-44d8-81bf-cd5068766ffd",
                                "sense_id": "cb1a4527-7cbd-3d2e-a262-b5b17ef40d8a",
                                "text": "L’histoire de ma famille est une bluette à côté des drames de la sienne, une homothétie par réduction d’échelle au pantographe."
                            },
                            {
                                "example_id": "fafe1d82-0251-4778-82e9-d7554caa9967",
                                "sense_id": "cb1a4527-7cbd-3d2e-a262-b5b17ef40d8a",
                                "text": "Les maxi-trimarans sont d’ailleurs des homothéties de ces mêmes trimarans Orma."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01a77203-6b20-4dae-a90c-aa585a94fbf4",
                        "source_entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                        "target_lang_word": "Homothetie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cfadf40b-565f-4764-8316-22a9abcd565e",
                        "source_entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                        "target_lang_word": "homothety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homothety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8413c8e-716d-3043-acb8-3d8fc084a35c",
                                        "entry_id": "394e417c-3113-327d-9673-42c8f7585fb3",
                                        "glosses": [
                                            "An isotropic scaling transformation of an affine space with a single fixed point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78309f1-a6df-4843-8c7d-0d9f1497f577",
                                                "sense_id": "c8413c8e-716d-3043-acb8-3d8fc084a35c",
                                                "text": "The product of two homotheties with the same centre is a homothety with that centre."
                                            },
                                            {
                                                "example_id": "2ec386ee-1bfb-4a6f-91d6-2298140547bc",
                                                "sense_id": "c8413c8e-716d-3043-acb8-3d8fc084a35c",
                                                "text": "One cannot obtain all similarity mappings from products of homotheties alone, but they are necessary and basic to similarities."
                                            },
                                            {
                                                "example_id": "8a3e5f7a-5d4b-4825-946c-fdf99c11ecc0",
                                                "sense_id": "c8413c8e-716d-3043-acb8-3d8fc084a35c",
                                                "text": "Since homotheties are determined by the fixed point, called the center of the homothety, and by the similitude ratio λ, we shall denote by h_(P,λ) the homothety with center P and similitude ratio λ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f86b8de-ca26-32f9-9d9e-9d9f2c253a00",
                                        "entry_id": "394e417c-3113-327d-9673-42c8f7585fb3",
                                        "glosses": [
                                            "A homomorphism from a module M over a ring A to itself of the form ν:x↦ax for some fixed a∈A (especially when M=A; a is said to be the ratio of the homothety, by analogy with the geometric case)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85e0d035-37fa-470e-9405-24052e6d19a4",
                        "source_entry_id": "0c4d0748-813f-3c6b-9d14-760f55148745",
                        "target_lang_word": "homothecy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homothecy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dcab8e8-88ce-3b9c-922c-2fe3b8ae3179",
                                        "entry_id": "08cf6feb-83b0-3dcc-8dd1-35eeee33afcb",
                                        "glosses": [
                                            "A homothetic transformation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f1bfd45-4712-40df-a986-54373384268e",
                                                "sense_id": "4dcab8e8-88ce-3b9c-922c-2fe3b8ae3179",
                                                "text": "Let us determine the center and the ratio of this homothecy."
                                            },
                                            {
                                                "example_id": "78cbd0da-3609-4df0-9706-10d05edb9743",
                                                "sense_id": "4dcab8e8-88ce-3b9c-922c-2fe3b8ae3179",
                                                "text": "The restriction of B to S_b is a homothecy of scale b."
                                            },
                                            {
                                                "example_id": "10c65a98-ed29-4a84-aeb7-7ad12aeb57d9",
                                                "sense_id": "4dcab8e8-88ce-3b9c-922c-2fe3b8ae3179",
                                                "text": "Proposition 7.4 Homothecies preserve circles. That is, for any homothecy h and any circle C, h(C) is a circle as well.[…]Were we willing to do the same with homothecies, we would meet an obstruction: the composition of two homothecies is not necessarily a homothecy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
