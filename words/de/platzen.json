    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd5711d7-3830-3d12-8f62-b1a74e7685e1",
                    "sense_definition": "Durch hohen Innendruck oder Krafteinwirkung plötzlich auseinanderbrechen oder zerreißen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bersten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du zu viel Luft hineinpumpst, <w>platzt</w> der Ballon."
                        },
                        {
                            "text": "Auf der Autobahn <w>platzte</w> plötzlich der linke Vorderreifen unseres Wagens."
                        }
                    ],
                    "synonyms": [
                        "bersten",
                        "explodieren",
                        "zerbrechen",
                        "zerplatzen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "zum Platzen voll"
                    ]
                },
                {
                    "sense_id": "e86c67f6-9fa1-3b86-aab5-e88a8aff5195",
                    "sense_definition": "Einen heftigen emotionalen Ausbruch haben, besonders vor Wut oder Lachen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ausbruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als er die schlechte Nachricht hörte, <w>platzte</w> er fast vor Wut."
                        },
                        {
                            "text": "Die Geschichte war so komisch, dass alle Anwesenden vor Lachen <w>platzten</w>."
                        }
                    ],
                    "synonyms": [
                        "aufbrausen",
                        "explodieren",
                        "hochfahren"
                    ],
                    "common_phrases": [
                        "vor Wut platzen",
                        "vor Lachen platzen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                },
                {
                    "sense_id": "e49d8691-7be7-3dc5-b1c9-09de2db733ac",
                    "sense_definition": "Plötzlich und unerwartet scheitern oder nicht zustande kommen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheitern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weil das Geld fehlte, ist der geplante Hauskauf leider <w>geplatzt</w>."
                        },
                        {
                            "text": "Im letzten Moment <w>platzte</w> das wichtige Treffen zwischen den beiden Politikern."
                        }
                    ],
                    "synonyms": [
                        "auffliegen",
                        "missglücken",
                        "misslingen",
                        "scheitern"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ],
                    "common_phrases": [
                        "etwas platzen lassen"
                    ]
                },
                {
                    "sense_id": "29b3da0d-7fbb-3c84-9fe0-7621f341da2f",
                    "sense_definition": "Plötzlich, unangekündigt und störend einen Raum betreten oder zu einer Situation hinzustoßen.",
