                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "Finnland ist reich an Seen und Wäldern."
                                            },
                                            {
                                                "example_id": "ce912205-7565-470c-88ae-c0cc85656b76",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "Helsinki ist die Hauptstadt von Finnland."
                                            },
                                            {
                                                "example_id": "95077237-ad20-483c-b3b9-198510239de6",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "Meine Freundin möchte unbedingt wieder nach Finnland."
                                            },
                                            {
                                                "example_id": "69509c38-69a7-485d-ab5a-64447b642215",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "„Finnland hat die Welt gerettet.“"
                                            },
                                            {
                                                "example_id": "5a5c5f33-4dd5-46c7-ab74-0cf86d001701",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "„Es gibt drei Millionen Saunas in Finnland, mehr als es Autos im Lande gibt.“"
                                            }
