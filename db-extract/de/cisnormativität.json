                ],
                "senses": [
                    {
                        "sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                        "entry_id": "f788042f-a0cf-338f-aaf8-82bcba9ab9e5",
                        "glosses": [
                            "Weltbild, in dem die Übereinstimmung des (ursprünglichen) anatomischen Geschlechts mit der Geschlechtsidentität die soziale Norm darstellt"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "83ef41cf-d83d-44b4-9547-21ef0c89b1d5",
                                "sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                                "text": "„Je älter sie jedoch werden und je stärker damit der Einfluss der sie umgebenden Cisnormativität wird, desto mehr wird dieses Erleben für sie zu einem Problem.“"
                            },
                            {
                                "example_id": "66c3f772-02c2-4fa2-ab55-87cde372760f",
                                "sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                                "text": "„Darum lesen wir in der Social-Justice-Forschung unaufhörlich, dass das Patriarchat, die weiße Vorherrschaft, der Imperialismus, die Cisnormativität, die Heteronormativität, der Ableismus und die Fat-Phobie die Gesellschaft buchstäblich prägen und alle infizieren.“"
                            },
                            {
                                "example_id": "2bd04725-6be6-4de0-bbd0-c2046e5437dc",
                                "sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                                "text": "„Der informelle Care-Sektor ist für LSBTIQ ein Bereich, den sie wählen, um Cisnormativität zu entkommen.“"
                            },
                            {
                                "example_id": "88fa04bb-855b-4b30-8765-760ff5949de9",
                                "sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                                "text": "„Queer beschreibt eine politische und kulturelle Bewegung von Menschen, die Selbstverständnisse und Lebensformen quer zu Zweigeschlechtlichkeit, Heteronormativität, Cisnormativität sowie essentialisierten Subjektpositionen entwerfen und ermöglichen.“"
                            },
                            {
                                "example_id": "4d725cc2-b71b-464c-b7b9-ccea6ff07d96",
                                "sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                                "text": "„Reden sie von ›Patriarchat‹ oder ›Heteronormativität‹ oder ›Cisnormativität‹?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62be72b8-0e1c-401f-8265-2b8f028f9633",
                        "source_entry_id": "f788042f-a0cf-338f-aaf8-82bcba9ab9e5",
                        "source_sense_id": "abe450ce-5eb4-333f-94d7-71000c154ee6",
                        "source_sense_description": "Weltbild, in dem die Übereinstimmung des anatomischen Geschlechts mit der Geschlechtsidentität die soziale Norm darstellt",
                        "target_lang_word": "cisnormativity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cisnormativity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc4bdbd-f656-36a6-95ce-4df8ca3aa78d",
                                        "entry_id": "9b24d943-141b-3e24-9d8f-fab8743fc8bc",
                                        "glosses": [
                                            "The assumption that all human beings are cisgender, i.e. have a gender identity which matches their biological sex."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06ed3e5-b67c-49f4-9e80-d4dfbc0ae581",
                                                "sense_id": "9bc4bdbd-f656-36a6-95ce-4df8ca3aa78d",
                                                "text": "The erasure of transpeople's experiences can be understood, at least partially, as a function of the hegemony of cisnormativity."
                                            },
                                            {
                                                "example_id": "e8436c24-8585-462c-9d4f-3ab4ae0fd3b3",
                                                "sense_id": "9bc4bdbd-f656-36a6-95ce-4df8ca3aa78d",
                                                "text": "These are the bodily consequences of cisnormativity—the prevalent and presumptuous assumption that cissexuality is the only acceptable and legible form of gender identity—which show us why, when we engage in feminist activism and inquiry, we must be trans-inclusive in our efforts to ensure that every human being deserves decency and justice when wronged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
