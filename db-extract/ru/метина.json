                        "examples": [
                            {
                                "example_id": "9acd8cfc-c6dd-4978-8f50-578365b85910",
                                "sense_id": "af905e11-07e7-3bec-813e-0af741397500",
                                "text": "Чего ты себя выдаешь: что, на тебе метина что ли положена?"
                            },
                            {
                                "example_id": "dd42196f-850a-47ee-9ae2-5581b986e310",
                                "sense_id": "af905e11-07e7-3bec-813e-0af741397500",
                                "text": "Между тем, прежде чем у Сергея зажили метины, положенные зубами Зиновия Борисыча, мужа Катерины Львовны хватились."
                            }
                        ]
                    }
