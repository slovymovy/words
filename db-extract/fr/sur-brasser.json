                "senses": [
                    {
                        "sense_id": "159e2dbc-3377-352a-873d-36649897edda",
                        "entry_id": "b27b300c-6001-3d22-bf35-818a806c7058",
                        "glosses": [
                            "Brasser le tangon plus que la normale."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "7d3073db-e9d0-42f0-8d8a-7fdf260e1ba0",
                                "sense_id": "159e2dbc-3377-352a-873d-36649897edda",
                                "text": "Pour stabiliser un peu le spi, je préfère sur-brasser pour aplatir un peu le spi."
                            }
                        ]
                    },
                    {
                        "sense_id": "999c371e-181d-3148-bfd5-4800c7cced66",
                        "entry_id": "b27b300c-6001-3d22-bf35-818a806c7058",
                        "glosses": [
                            "Brasser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697f0dd1-512a-4705-a450-5a2ff4305737",
                                "sense_id": "999c371e-181d-3148-bfd5-4800c7cced66",
                                "text": "Il vaut mieux sur-brasser que sous-brasser en faisant attention aux coraux les plus fragiles."
                            },
                            {
                                "example_id": "4fc3e237-ba2d-4c2c-8412-37050f936afe",
                                "sense_id": "999c371e-181d-3148-bfd5-4800c7cced66",
                                "text": "Selon le type d'aquarium que tu as, fais juste attention à ne pas sur-brasser ton bac, comme en tout l'excès est nuisible."
                            }
                        ]
                    }
