                ],
                "senses": [
                    {
                        "sense_id": "23a431d5-aca5-39e9-b275-540eb243e037",
                        "entry_id": "f3080e92-ae27-3a45-8015-74b03581648b",
                        "glosses": [
                            "Herstellung von Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d95180-98a3-4f11-bc4b-968a6ba707ec",
                                "sense_id": "23a431d5-aca5-39e9-b275-540eb243e037",
                                "text": "„Gleichzeitig machten Skandale über die Techniken der Fleischproduktion in den USA von sich reden.“"
                            },
                            {
                                "example_id": "6493b20c-7b6a-47bc-8b81-be1e7356aadf",
                                "sense_id": "23a431d5-aca5-39e9-b275-540eb243e037",
                                "text": "„Exkurs in die Funktionsweisen der Massentierhaltung und die Arbeitsweisen der Fleischproduktion machen.“"
                            },
                            {
                                "example_id": "b395cceb-ea43-41c5-ac89-a79ed53c43e0",
                                "sense_id": "23a431d5-aca5-39e9-b275-540eb243e037",
                                "text": "„Aber auch Deutschland spielt eine signifikante Rolle auf dem Weltmarkt, was die Fleischproduktion betrifft.“"
                            },
                            {
                                "example_id": "34d34416-6142-4e13-b768-83308c7ae0e5",
                                "sense_id": "23a431d5-aca5-39e9-b275-540eb243e037",
                                "text": "„Die KubanerInnen [sic] hatten zuvor viel Fleisch konsumiert, aber die Fleischproduktion benötigte fossile Rohstoffe, zu denen sie keinen Zugang mehr hatten.“"
                            },
                            {
                                "example_id": "d9140b42-dbae-45bb-8aaa-70d90bb681ea",
                                "sense_id": "23a431d5-aca5-39e9-b275-540eb243e037",
                                "text": "„Er sprach über den Zusammenhang von Fleischproduktion und dem Ausstoß von Methan, über die Klimaauswirkungen und die Nachteile der Massentierhaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
