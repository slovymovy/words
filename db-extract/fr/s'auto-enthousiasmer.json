                "senses": [
                    {
                        "sense_id": "55acd110-580d-3be2-a18b-eec89afec521",
                        "entry_id": "e5274d4c-9544-38d9-963f-a73620a8aa53",
                        "glosses": [
                            "S’enthousiasmer de soi-même, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f978bf-17c7-46cd-bb50-40d5d4bda4fe",
                                "sense_id": "55acd110-580d-3be2-a18b-eec89afec521",
                                "text": "Elle estimait que, même seul, il réussissait souvent à s’auto-enthousiasmer."
                            },
                            {
                                "example_id": "ec3b2f23-d694-4fe9-8001-15de7f5c9cd3",
                                "sense_id": "55acd110-580d-3be2-a18b-eec89afec521",
                                "text": "Judith N. Shklar précise que si Saint-Preux se gargarise de modèles spartiates et romains, s’il les appelle pour guider sa réflexion, ce n’est pas pour cautionner la dureté et l’austérité de telles morales, mais simplement pour s’auto-enthousiasmer et se mettre dans des conditions passionnelles favorables à la vertu."
                            }
                        ]
                    }
