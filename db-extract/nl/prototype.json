                    {
                        "translation_id": "ee867a75-23ee-4882-aaa3-a3195e78f59d",
                        "source_entry_id": "38dc8454-b273-3a80-b702-466409efe451",
                        "source_sense_id": "06a6e567-49ac-3583-9e81-4d8dc259abb5",
                        "source_sense_description": "oorspronkelijk model, eerste model van een product",
                        "target_lang_word": "Prototyp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prototyp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dfd7cd4-11e0-397b-8eb0-0ed9e5732e06",
                                        "entry_id": "547fd0f2-5840-3bf6-b4e2-057cf2b26e13",
                                        "glosses": [
                                            "Inbegriff für etwas, typischer Vertreter einer Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e7260d-9490-404e-85f4-f591a9b034ed",
                                                "sense_id": "8dfd7cd4-11e0-397b-8eb0-0ed9e5732e06",
                                                "text": "Er ist der Prototyp eines Spießbürgers."
                                            },
                                            {
                                                "example_id": "cd2cd01e-d145-4599-820b-17b399557eae",
                                                "sense_id": "8dfd7cd4-11e0-397b-8eb0-0ed9e5732e06",
                                                "text": "„Die Wallaces waren der Prototyp einer Familie auf dem sozialen Abstieg, wie man heute sagen würde.“"
                                            },
                                            {
                                                "example_id": "b467936e-16f3-4d6f-8cf9-b048ef9991ba",
                                                "sense_id": "8dfd7cd4-11e0-397b-8eb0-0ed9e5732e06",
                                                "text": "„Als Prototyp des Söldners entwickelte sich seit dem letzten Drittel des 15. Jahrhunderts der Schweizer Reisläufer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85a352ff-c2b5-3c7e-9857-0d1795b79339",
                                        "entry_id": "547fd0f2-5840-3bf6-b4e2-057cf2b26e13",
                                        "glosses": [
                                            "Muster, Urform von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027cace8-44b1-4cb6-9009-cf7e57fd9872",
                                                "sense_id": "85a352ff-c2b5-3c7e-9857-0d1795b79339",
                                                "text": "Das alte Griechenland gilt als Prototyp der Demokratie."
                                            },
                                            {
                                                "example_id": "5142bcad-f3c6-4397-9c17-b377f46bd3a7",
                                                "sense_id": "85a352ff-c2b5-3c7e-9857-0d1795b79339",
                                                "text": "Die Länge eines Meters wurde 1799 durch einen Prototyp realisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0abab42d-63bb-3e78-b5b2-4b2c653ee3c8",
                                        "entry_id": "547fd0f2-5840-3bf6-b4e2-057cf2b26e13",
                                        "glosses": [
                                            "Vorab-Exemplar, erste Ausführung eines Produktes vor der Serienfertigung, das zur Erprobung von Eigenschaften dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a857f8-7e6c-46e5-93cf-916c835fa663",
                                                "sense_id": "0abab42d-63bb-3e78-b5b2-4b2c653ee3c8",
                                                "text": "Von dem geplanten neuen Automodell existiert bisher nur ein Prototyp."
                                            },
                                            {
                                                "example_id": "c9238e00-9715-4e7f-9e87-e9e40883bc1c",
                                                "sense_id": "0abab42d-63bb-3e78-b5b2-4b2c653ee3c8",
                                                "text": "„Sie war einundsechzig Meter lang, verhältnismäßig breit und klobig, einzig und allein zur Abwehr von Unterseebooten gebaut und eigentlich nur ein Ponton für Wasserbomben, Prototyp einer Schiffsklasse, die fortan rasch und billig hergestellt werden konnte, um dem dringenden Bedarf für den Geleitschutz zu genügen.“"
                                            },
                                            {
                                                "example_id": "cd0de76b-fbb6-45d0-a582-0b5fe0a72d18",
                                                "sense_id": "0abab42d-63bb-3e78-b5b2-4b2c653ee3c8",
                                                "text": "„Sampson ließ einen Prototyp in einem simulierten Beschleunigungswettbewerb antreten gegen einen Bentley, einen Ferrari und zwei Elektromodelle der Marke Tesla.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d559022-de35-4abb-8a2d-efb3f2d77fa9",
                        "source_entry_id": "38dc8454-b273-3a80-b702-466409efe451",
                        "source_sense_id": "06a6e567-49ac-3583-9e81-4d8dc259abb5",
                        "source_sense_description": "oorspronkelijk model, eerste model van een product",
                        "target_lang_word": "prototype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prototype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ece2dbb3-c984-367e-b425-487311fc77c1",
                                        "entry_id": "b1a837ff-ec66-35ed-bb91-1fff9b41ed10",
                                        "glosses": [
                                            "An original form or object which is a basis for other forms or objects (particularly manufactured items), or for its generalizations and models."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b18710e-3ab7-4b45-99b2-496ec3835b44",
                                                "sense_id": "ece2dbb3-c984-367e-b425-487311fc77c1",
                                                "text": "And if Jordan were but Jaar Eden, that is, the Riuer of Eden, Geneſar but Ganſar or the Prince of Gardens; and it could be made out, that the Plain of Jordan were watered not comparatively, but cauſally, and becauſe it was the Paradiſe of God, as the Learned Abramas hinteth, he was not far from the Prototype and originall of Plantations."
                                            },
                                            {
                                                "example_id": "3551dd0c-e3f1-4597-a831-94d95eea7f73",
                                                "sense_id": "ece2dbb3-c984-367e-b425-487311fc77c1",
                                                "text": "[T]his Holy Trinity is not Three Divine Attributes, ſuch as Wiſdom, Power, and Goodneſs; for they are all Three the very ſame with each other, the ſame Wiſdom, Goodneſs, and Power, and therefore not Three Parts or Attributes of the ſame Deity, but each is the whole, the Prototype, and its living Image is."
                                            },
                                            {
                                                "example_id": "a4fd354a-0a15-406d-9507-c0a078ed68c2",
                                                "sense_id": "ece2dbb3-c984-367e-b425-487311fc77c1",
                                                "text": "Only one manuscript of Plautus seems to have escaped the general wreck of ancient literature; and it served as the prototype to all the manuscripts at present extant."
                                            },
                                            {
                                                "example_id": "b8e62fab-74b5-4198-9c1e-55e1980bdf7c",
                                                "sense_id": "ece2dbb3-c984-367e-b425-487311fc77c1",
                                                "text": "The making of the new prototypes of the metre and the kilogramme, the tracing of the metres, the comparison of the new prototypes with those of the Archives, as well as the construction of the auxillary apparatus necessary to these operations, are entrusted to the care of the French section, with the concurrence of the Permanent Committee, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f7f274-d7da-3505-9361-d0b75ab8bc29",
                                        "entry_id": "b1a837ff-ec66-35ed-bb91-1fff9b41ed10",
                                        "glosses": [
                                            "An early sample or model built to test a concept or process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5630b03e-6854-4919-87de-51cda4e78157",
                                                "sense_id": "46f7f274-d7da-3505-9361-d0b75ab8bc29",
                                                "text": "The prototype had loose wires and rough edges, but it worked."
                                            },
                                            {
                                                "example_id": "207f8de9-3e11-4341-95dd-e4ae8be036c5",
                                                "sense_id": "46f7f274-d7da-3505-9361-d0b75ab8bc29",
                                                "text": "General Electric, under contract to the A.E.C., is now building a land-based prototype of this nuclear-power plant at West Milton, N.Y. A land-based prototype of the nuclear-power plant for the \"Nautilus,\" developed jointly by the A.E.C.'s Argonne National Laboratory and the Westinghouse Electric Corporation, is now being built by Westinghouse, also under contract to the A.E.C."
                                            },
                                            {
                                                "example_id": "09cec06b-95e0-42a1-afb0-49dec53f3582",
                                                "sense_id": "46f7f274-d7da-3505-9361-d0b75ab8bc29",
                                                "text": "Unfortunately however, what may seem on paper an ideal specification for a particular type of machine does not always prove to be so in practice and the German Federal Railway submits prototypes of every new design to long and exhaustive tests before plans are made to put it into service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f120ce5-183a-3add-8d74-10b0af5a362f",
                                        "entry_id": "b1a837ff-ec66-35ed-bb91-1fff9b41ed10",
                                        "glosses": [
                                            "A declaration of a function that specifies the name, return type, and parameters, but none of the body or actual code."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b61401b-3f81-4686-969c-099d5fe8c051",
                                                "sense_id": "7f120ce5-183a-3add-8d74-10b0af5a362f",
                                                "text": "Like any variable in a C program it is necessary to prototype or declare a function before its use, if it returns a value other than an int. It informs the compiler that the function would be referenced at a later stage in the program. / For example, / In program 1, the statement / void display_message(); / is a function prototype or declaration. Here void specifies that this function does not return any value, and the empty parenthesis^([sic – meaning parentheses]) indicate that it takes no parameters (arguments)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fabfd6e6-b9d6-3201-900e-545f8557d064",
                                        "entry_id": "b1a837ff-ec66-35ed-bb91-1fff9b41ed10",
                                        "glosses": [
                                            "An instance of a category or a concept that combines its most representative attributes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba425e4-cc19-4ee5-a669-c8177d83b8ba",
                                                "sense_id": "fabfd6e6-b9d6-3201-900e-545f8557d064",
                                                "text": "A robin is a prototype of a bird; a penguin is not."
                                            },
                                            {
                                                "example_id": "bf56af7e-2423-409a-8c97-d54527f6749d",
                                                "sense_id": "fabfd6e6-b9d6-3201-900e-545f8557d064",
                                                "text": "If the robin is the prototype of bird, do particular examples of robin constitute that prototype for different people? I think not. Rather, prototypes are themselves categories. Thus, to say that a robin is a prototypic bird is to propose that a class of similar creatures called robin is a prototype of bird."
                                            },
                                            {
                                                "example_id": "4b91cc67-7515-4eb4-bcd4-e05840ec7155",
                                                "sense_id": "fabfd6e6-b9d6-3201-900e-545f8557d064",
                                                "text": "Although it is common knowledge today that a great many linguistic categories are, indeed, prototype categories[…], a number of linguists still perceive grammatical categories as being classical in their nature[…]. These linguists are reluctant to accept the idea that prototypicality might be relevant to grammar and that grammatical categories, like all other categories, can also display prototype effects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd341fe6-e3c9-3d30-956b-58327cdf874d",
                                        "entry_id": "b1a837ff-ec66-35ed-bb91-1fff9b41ed10",
                                        "glosses": [
                                            "A type of race car, a racing sports car not based on a production car. A 4-wheeled cockpit-seating car built especially for racing on sports car circuits, that does not use the silhouette related to a consumer road car."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prototype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9859d0b3-7070-38ca-8f3a-ad353e84768f",
                                        "entry_id": "e9fd4b3f-2cb6-30c1-837f-f27bf85bef99",
                                        "glosses": [
                                            "To create a prototype of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9ac1a83-6696-4dd5-81b9-9d10a526c569",
                                                "sense_id": "9859d0b3-7070-38ca-8f3a-ad353e84768f",
                                                "text": "In short, he has purposely perverted the whole case from beginning to end, and distorted it in such a manner, as not to be prototyped except by his own mind; […]"
                                            },
                                            {
                                                "example_id": "978bc66c-00a6-4bdb-9138-38f34b603615",
                                                "sense_id": "9859d0b3-7070-38ca-8f3a-ad353e84768f",
                                                "text": "[Y]ou may form acquaintance with the Wye before it sees the light, by penetrating that interesting cavern, Poole's Hole, as I have several times before. It is a wondrous place, and worthy of a far more dignified name; a sort of crypt in Nature's vast cathedral; an assemblage of all grotesque, fantastic and beautiful mineral formations, in a fretted vault not made by man, yet mimicking or prototyping all his art."
                                            },
                                            {
                                                "example_id": "4ca48f3c-8525-4bd6-8235-f7991df549a6",
                                                "sense_id": "9859d0b3-7070-38ca-8f3a-ad353e84768f",
                                                "text": "[W]hatsoe'er the poet sings, / Of prototyped in nature or in man, / Moves deeply, though it touch not wrath of kings / Or frantic battle-van."
                                            },
                                            {
                                                "example_id": "60685544-c071-4c3a-a378-ebdaa4e9f84c",
                                                "sense_id": "9859d0b3-7070-38ca-8f3a-ad353e84768f",
                                                "text": "The following themes will arise repeatedly in this book: / • the use of symbolic computation to prototype the behaviour of models."
                                            },
                                            {
                                                "example_id": "ec70c9e4-1b84-48ff-afe8-5081dd9845e2",
                                                "sense_id": "9859d0b3-7070-38ca-8f3a-ad353e84768f",
                                                "text": "The BBC wanted a computer to go with their television series and started to look for candidate systems. […] Several companies competed for the contract, and the Proton project was an ideal candidate. The only problem was the Proton didn't actually exist. It was only in the design stage; it wasn't prototyped. Acorn had little time, only 4 days, and spent those 4 days working night and day, prototyping the design, and getting the Proton ready to show to the BBC. […] The BBC Micro was born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae8823e-2903-329c-a3ee-0ba34218fb56",
                                        "entry_id": "e9fd4b3f-2cb6-30c1-837f-f27bf85bef99",
                                        "glosses": [
                                            "To imitate or emulate."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44b4851d-4a5b-4841-bc30-587ef9e38886",
                        "source_entry_id": "38dc8454-b273-3a80-b702-466409efe451",
                        "source_sense_id": "06a6e567-49ac-3583-9e81-4d8dc259abb5",
                        "source_sense_description": "oorspronkelijk model, eerste model van een product",
                        "target_lang_word": "prototype",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prototype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8986b187-2d80-35a1-8ff2-25004cd6a73f",
                                        "entry_id": "89e7ff6f-4d36-3f1d-b9f4-8b246cd0cae6",
                                        "glosses": [
                                            "Première ébauche fonctionnelle d’un objet, d'un concept ou d’une idée développée par un concepteur, afin d'en évaluer la pertinence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80274a3a-4542-4503-8d3a-f6b5a3f8bda1",
                                                "sense_id": "8986b187-2d80-35a1-8ff2-25004cd6a73f",
                                                "text": "Il y avait aussi à la base un prototype qui était arrivé depuis peu de temps, c'était le dernier-né de la société Avions Marcel Dassault. L’Ouragan MD 450 le premier avion à réaction de fabrication française, […]."
                                            },
                                            {
                                                "example_id": "4afbbacd-66a2-4521-b73d-b12b973705a9",
                                                "sense_id": "8986b187-2d80-35a1-8ff2-25004cd6a73f",
                                                "text": "Le terrain était devenu une sorte de rétrospective de tout ce que l'Armée de l'Air avait compté comme prototypes depuis vingt ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9e5d64-de63-37b2-8d21-449cbac12637",
                                        "entry_id": "89e7ff6f-4d36-3f1d-b9f4-8b246cd0cae6",
                                        "glosses": [
                                            "Type d’objet propre à la programmation orientée prototype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b986b93f-d095-4d2a-ba23-892c55dd537a",
                                                "sense_id": "6a9e5d64-de63-37b2-8d21-449cbac12637",
                                                "text": "Chaque objet est lié à un objet prototype dont il peut hériter des propriétés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e157ef85-9355-3072-a7ef-eac0cb9e0eec",
                                        "entry_id": "89e7ff6f-4d36-3f1d-b9f4-8b246cd0cae6",
                                        "glosses": [
                                            "Engin fabriqué uniquement pour une saison ou une compétition. Ces engins ne sont pas forcément uniques, mais leur(s) spécification(s) varie(nt) très souvent en fonction des contraintes du moment."
                                        ],
                                        "tags": [
                                            "Sports mécaniques"
                                        ],
                                        "examples": []
