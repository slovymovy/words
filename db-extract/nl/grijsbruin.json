            {
                "entry_id": "15868970-aa77-35eb-9452-5fae98d0207f",
                "word": "grijsbruin",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "43b1deb5-8d4f-3ac9-8943-68f7f70fb34a",
                        "entry_id": "15868970-aa77-35eb-9452-5fae98d0207f",
                        "glosses": [
                            "in een tint bruin met RAL-nummer 8019 ( )."
                        ],
                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "388ebc03-7990-46b0-a8c6-5ee20bb6db10",
                                "sense_id": "43b1deb5-8d4f-3ac9-8943-68f7f70fb34a",
                                "text": "De zijkant was een egaal grijsbruin vlak."
                            },
                            {
                                "example_id": "f58b1963-ef24-4214-a6cf-6213b252d0c8",
                                "sense_id": "43b1deb5-8d4f-3ac9-8943-68f7f70fb34a",
                                "text": "Hij rijdt in een grijsbruine auto."
                            },
                            {
                                "example_id": "b6c91014-751e-4732-bb1a-d79015a65105",
                                "sense_id": "43b1deb5-8d4f-3ac9-8943-68f7f70fb34a",
                                "text": "Hij voelde zich verkleed en het had bovendien elf dagen loon gekost, een grijsbruin kostuum, visgraatpatroon met een beetje wijde pijpen en schoudervulling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13f8b369-abba-437f-9c62-8d692bdf54df",
                        "source_entry_id": "15868970-aa77-35eb-9452-5fae98d0207f",
                        "source_sense_id": "43b1deb5-8d4f-3ac9-8943-68f7f70fb34a",
                        "target_lang_word": "Graubraun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a154d7f5-7af1-4a87-aed1-f8e77330f420",
                        "source_entry_id": "15868970-aa77-35eb-9452-5fae98d0207f",
                        "source_sense_id": "43b1deb5-8d4f-3ac9-8943-68f7f70fb34a",
                        "target_lang_word": "graubraun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graubraun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e45526c-e5f8-3922-a5f1-a2b2f11f64b4",
                                        "entry_id": "d6e4e413-8a69-3574-ba96-4aa786096816",
                                        "glosses": [
                                            "braun mit Graustich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c36752-8ef2-4ee0-a369-9cac6baf7e2d",
                                                "sense_id": "5e45526c-e5f8-3922-a5f1-a2b2f11f64b4",
                                                "text": "„Zwei oder drei weiße Pfauen pickten sich den Rasen entlang, und eine graubraune Taube saß so reglos auf dem Arm einer der Parzen, dass sie ein Teil der Skulptur zu sein schien.“"
                                            },
                                            {
                                                "example_id": "4fc3fea9-50db-4c4f-a440-aa543698d4e7",
                                                "sense_id": "5e45526c-e5f8-3922-a5f1-a2b2f11f64b4",
                                                "text": "„Während ich unterschreibe, fragt sie mich: »Haben Sie die Frau hier in der Straße gekannt, die in dem großen graubraunen Haus gearbeitet hat?«“"
                                            },
                                            {
                                                "example_id": "16f0a640-62ea-4e40-b1c4-f69c477b417d",
                                                "sense_id": "5e45526c-e5f8-3922-a5f1-a2b2f11f64b4",
                                                "text": "„Als Letztes entfernte Raynor den Deckel einer Gummiwanne und entdeckte darin landesübliche Kleidung, abgetragen und schmutzig. Ihre graubraune Farbe und der üble Gestank passten perfekt zu Raynors Tarnung.“"
                                            },
                                            {
                                                "example_id": "d15c0951-c028-4a9d-b816-07a62660d421",
                                                "sense_id": "5e45526c-e5f8-3922-a5f1-a2b2f11f64b4",
                                                "text": "„Stellen Sie sich meine Überraschung vor, als ich sah, dass der gesamte azurne Himmel mit einem Mal eine graubraune, düstere Farbe angenommen hatte und in seiner Mitte immer noch wie ein riesenhaftes, kreisrundes, glimmendes Stück Holzkohle klar und deutlich die Sonne zu sehen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
