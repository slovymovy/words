                "senses": [
                    {
                        "sense_id": "1e44d0be-09f2-334a-b943-c593aa47cde9",
                        "entry_id": "e73bc340-04a9-309c-b44d-c0ee02b21235",
                        "glosses": [
                            "Surgeler à nouveau (mais ce verbe est en pratique plutôt utilisé à la place de recongeler)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65d811e-326f-44f5-a83c-156314ae8b9f",
                                "sense_id": "1e44d0be-09f2-334a-b943-c593aa47cde9",
                                "text": "Une fois décongelé ne pas resurgeler et consommer rapidement."
                            },
                            {
                                "example_id": "9ef27cc9-6ab3-455d-8b5d-a35265f6de2e",
                                "sense_id": "1e44d0be-09f2-334a-b943-c593aa47cde9",
                                "text": "Je pense qu'il ne faut pas resurgeler un produit."
                            },
                            {
                                "example_id": "a8a37095-c3d0-4740-998d-9d2120738644",
                                "sense_id": "1e44d0be-09f2-334a-b943-c593aa47cde9",
                                "text": "Les micro-ondes, au contraire, réchauffent la viande surgelée de façon uniforme en un quart d'heure, ce qui permet de la resurgeler sans aucun risque."
                            }
                        ]
                    }
