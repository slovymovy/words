                        "glosses": [
                            "Éducation des enfants telle que pratiquée dans la Grèce ancienne, ou pratique inspirée de cette éducation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e9c3c7e-bd71-4721-8ec6-393ad1134ee3",
                                "sense_id": "dd6b3b34-f752-3fe9-bc98-b694652958bd",
                                "text": "Sophocle propose aux spectateurs une leçon de vie et cette leçon est au cœur de l'enseignement (paideia) que les Anciens attendaient du théâtre."
                            },
                            {
                                "example_id": "3da5d516-4cc2-4b62-a114-df28487d00d2",
                                "sense_id": "dd6b3b34-f752-3fe9-bc98-b694652958bd",
                                "text": "Bookchin rappelle que cette citoyenneté active est intimement liée à la paideia, c’est-à-dire la culture intentionnelle des qualités civiques et morales nécessaires à l’exercice politique."
                            }
                        ]
                    }
