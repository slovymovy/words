                "forms": [],
                "senses": [
                    {
                        "sense_id": "af906c56-c945-3f86-833f-981da419719b",
                        "entry_id": "07de80fd-3795-34b3-9f27-e0051424e358",
                        "glosses": [
                            "Hamsterer, wucherhafter Aufkäufer, jemand, der große Mengen an Ware mit spekulativen Zielen hortet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ae19e0-4b0f-48be-a5f5-dce7df660855",
                                "sense_id": "af906c56-c945-3f86-833f-981da419719b",
                                "text": "Le gouvernement a publié une loi qui prévoit les peines les plus sévères contre les accapareurs de denrées alimentaires.",
                                "translation": "Die Regierung hat ein Gesetz erlassen, das schwerste Strafen gegen Hamsterer von Lebensmitteln vorsieht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c5d0dfa-154b-4e38-9561-c3a81315d880",
                        "source_entry_id": "07de80fd-3795-34b3-9f27-e0051424e358",
                        "source_sense_id": "af906c56-c945-3f86-833f-981da419719b",
                        "source_sense_description": "jemand, der große Mengen an Ware mit spekulativen Zielen hortet",
                        "target_lang_word": "Hamsterer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hamsterer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e25d9906-82d1-30dc-96eb-76ab96146823",
                                        "entry_id": "eff151a4-a5b1-38a0-b021-312e4e10f977",
                                        "glosses": [
                                            "Person, die hamstert, also versucht, sich zusätzlich zur zugeteilten Menge oder zum aktuellen Bedarf Lebensmittel und andere wichtige Artikel zu verschaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa354f92-6a9f-499e-971f-3168b504f230",
                                                "sense_id": "e25d9906-82d1-30dc-96eb-76ab96146823",
                                                "text": "„Abends und nachts sammeln sich die Hamsterer schon auf dem Bahnhof, um in der Frühe in die Dörfer zu fahren.“"
                                            },
                                            {
                                                "example_id": "316a4d6e-554a-4bfe-9c53-e213de6bd41a",
                                                "sense_id": "e25d9906-82d1-30dc-96eb-76ab96146823",
                                                "text": "„Mit der Bahn fuhren die Hamsterer weit hinaus aufs Land, zwanzig, dreißig, fünfzig Kilometer, mit dem Fahrrad auch, solange sie genug heile Schläuche und Mäntel hatten, notfalls eben zu Fuß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
