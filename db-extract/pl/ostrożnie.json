                                            {
                                                "example_id": "0ba7991e-9e6b-4b5c-8560-aa06cb982b74",
                                                "sense_id": "1c4675e0-f784-35f6-a5f2-3880332fe94b",
                                                "text": "He said cautiously, \"I do not think it right, Imperator.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f6d753-eebd-4064-981a-d14a92de9b90",
                        "source_entry_id": "605ca6a1-3de0-3904-8d11-107a50563b61",
                        "source_sense_id": "25c60fa9-6377-39cf-bf42-a25f5f253090",
                        "target_lang_word": "carefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Sorrowfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d576e34d-ceea-469a-92fe-9644ec612b52",
                                                "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                                "text": "[…] there was she faine / To call them all in order to her ayde, / And them conjure, upon eternall paine, / To counsell her, so carefully dismayd, / How she might heale her sonne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "With care; attentively, circumspectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12f86b6-398b-4efc-8ec2-a7c8fde00a7b",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "As he was a politician, he discussed all subjects carefully, not offending anyone."
                                            },
                                            {
                                                "example_id": "44d6896b-126b-4311-8dd1-6153bab77d62",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully studied the papers, while planning his next move."
                                            },
                                            {
                                                "example_id": "e910d059-3f2c-4dd6-9a4a-871e8e7a1de1",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully avoided the subject all evening."
                                            },
                                            {
                                                "example_id": "6a2cba9f-d721-4c60-9a4e-db2d04a144f6",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean. ¶ There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Conscientiously, painstakingly, fastidiously, meticulously"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4328fed-7f13-4cf2-9b6e-d54bdcd5b3f1",
                        "source_entry_id": "605ca6a1-3de0-3904-8d11-107a50563b61",
                        "source_sense_id": "25c60fa9-6377-39cf-bf42-a25f5f253090",
                        "target_lang_word": "guardedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guardedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28c6a453-ecd1-38b8-91fa-b031db54519e",
                                        "entry_id": "d26cef02-0508-3bd6-9fb7-fc321e302c55",
                                        "glosses": [
                                            "In a guarded manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad928060-f098-44d2-834c-9e75e25e12be",
                                                "sense_id": "28c6a453-ecd1-38b8-91fa-b031db54519e",
                                                "text": "The DfT states guardedly: \"Subject to future decisions, this first phase of the Rail Hub could be completed by the early 2030s.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5ca5e64-3d2e-44e3-bfa5-50147cac2604",
                        "source_entry_id": "605ca6a1-3de0-3904-8d11-107a50563b61",
                        "source_sense_id": "25c60fa9-6377-39cf-bf42-a25f5f253090",
                        "target_lang_word": "prudemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prudemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                        "entry_id": "d7591969-fe42-39f1-9e4a-b180190577f0",
                                        "glosses": [
                                            "Avec prudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd25c964-f126-4eb3-9596-ff1655c17687",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Être prudemment barbare et exercer la tyrannie conséquemment signifie, selon ce politique abominable, exécuter tout d'un coup toutes les violences et tous les crimes que l'on juge utiles à ses intérêts."
                                            },
                                            {
                                                "example_id": "8f5fe4b5-865c-4cee-8f24-a675cc9b2595",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Un vague et déprimant malaise planait. Sous le porche des Réguliers, personne. Les trafiquants de drogue qui s'y postaient le soir s'étaient, prudemment, éclipsés."
                                            },
                                            {
                                                "example_id": "bf04b53a-e662-4c21-ab87-b3b395bf4432",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Évrard seul, dans un coin prudemment retiré, Se croyait à couvert de l’insulte sacré,"
                                            },
                                            {
                                                "example_id": "5dc59c91-7559-425c-b62f-7963b4eaf833",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Ces sensibilités qui veulent choisir les misères, et qui, en nous rendant trop prudemment charitables, nous rendent pieusement cruels,"
                                            },
                                            {
                                                "example_id": "347f2d26-946b-4558-a3d3-16e68381cb09",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "— Heureusement tous les cossons n'étaient pas partis. Il y a des cépages peu hâtifs qui prudemment n’ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63f6a695-0126-4bef-b51d-a652522a42a8",
                        "source_entry_id": "605ca6a1-3de0-3904-8d11-107a50563b61",
                        "source_sense_id": "25c60fa9-6377-39cf-bf42-a25f5f253090",
                        "target_lang_word": "précautionneusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précautionneusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                        "entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
                                        "glosses": [
                                            "D'une façon précautionneuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5cb9862-7f1c-4254-8055-d788e770c966",
                                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                                "text": "Eugène marchait précautionneusement."
                                            },
                                            {
                                                "example_id": "61a9ee1a-3b17-4b5d-81f9-ce485c5bd0f2",
                                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                                "text": "La double feuille remue entre les doigts qui la tiennent précautionneusement, — comme une colombe dans l’espace."
                                            },
                                            {
                                                "example_id": "5b85ced9-77d1-46fa-b862-a16d38e5f236",
                                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                                "text": "Je regagnai l’appartement sans autre rencontre inopportune et me précipitai dans le salon, posant le sac sur le canapé et le dézippant précautionneusement."
                                            },
                                            {
                                                "example_id": "04e709f7-501e-4907-bc7e-e5d07b00ccc7",
                                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                                "text": "On tourne les pages précautionneusement, avec une lenteur révélatrice : il s’agit moins d’absorber le contenu que de profiter au mieux du contenant."
                                            },
                                            {
                                                "example_id": "919862ac-dcf9-4eaa-b68f-cb3cc82667e7",
                                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                                "text": "Il ne s’agissait pas de vaincre les montagnes mais de les arpenter : les gravir, y ramper, les descendre précautionneusement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58cd507d-7977-47f7-bda6-9d252355ec3f",
                        "source_entry_id": "605ca6a1-3de0-3904-8d11-107a50563b61",
