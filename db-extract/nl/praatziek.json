                                "target_senses": [
                                    {
                                        "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                        "entry_id": "f799cc27-124a-35cd-9e80-8d92f1d2eb27",
                                        "glosses": [
                                            "Tending to talk a lot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00034a50-714d-4b15-9c63-ab9a055a4287",
                                                "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                                "text": "a talkative girl"
                                            },
                                            {
                                                "example_id": "53f60aa0-7998-4dd5-aafb-814f09e31b30",
                                                "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                                "text": "a talkative TV show"
                                            },
                                            {
                                                "example_id": "7d90a6f7-8aae-4938-80c8-fffeb9feaa22",
                                                "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                                "text": "Tarzan nodded his head. He was a man of few words, and possibly it was for this reason as much as any that Kadour ben Saden had taken to him, for if there be one thing that an Arab despises it is a talkative man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd3f098-b99b-3165-b269-a71fa26331de",
                                        "entry_id": "f799cc27-124a-35cd-9e80-8d92f1d2eb27",
                                        "glosses": [
                                            "Speaking openly and honestly, neglecting privacy and consequences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf79fe2d-e874-4aae-ae1f-09e583f47608",
                        "source_entry_id": "6191c6e5-6321-33f0-991d-3fcfaf6a3ddd",
                        "source_sense_id": "dd870816-8961-38b0-b45c-de192a4742a9",
                        "target_lang_word": "communicative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communicative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06b4a1dc-90d1-3b8e-8b56-a488f953a433",
                                        "entry_id": "e49c1dfa-aae8-3adc-a15d-9e2967af3539",
                                        "glosses": [
                                            "Eager to communicate; talkative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc482e2-0d74-4272-8c7a-38358de6181c",
                                                "sense_id": "06b4a1dc-90d1-3b8e-8b56-a488f953a433",
                                                "text": "One of his attendants had found no little favour in the eyes of Alice, who expressed her suspicions that her mistress had some secret correspondence, for two reasons; first, to satisfy a naturally communicative temper—all common people are communicative: and secondly, in hopes of gaining such assistance as might ultimately gratify her own curiosity, now most uncomfortably excited."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05fbca6-0002-40c7-8994-0edc3bb17c82",
                        "source_entry_id": "6191c6e5-6321-33f0-991d-3fcfaf6a3ddd",
