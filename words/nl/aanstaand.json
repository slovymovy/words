{
    "word_family": [
        "aanstaan"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                    "sense_definition": "Dat wat in de nabije toekomst gaat gebeuren of plaatsvinden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toekomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>aanstaande</w> maandag hebben wij een belangrijke afspraak bij de tandarts.",
                            "target_lang_translations": {
                                "zh": "<w>下周一</w>我们有个重要的牙医预约。"
                            }
                        },
                        {
                            "text": "De <w>aanstaande</w> moeder kijkt erg uit naar de geboorte van haar eerste kind.",
                            "target_lang_translations": {
                                "zh": "这位<w>准妈妈</w>非常期待她第一个孩子的出生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "komend",
                        "volgend"
                    ],
                    "antonyms": [
                        "voorbij",
                        "verleden"
                    ],
                    "common_phrases": [
                        "aanstaande maandag",
                        "aanstaande moeder"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在不久的将来即将发生或出现的事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "即将到来的",
                                "target_lang_sense_clarification": "用于描述时间上紧接在后的事物。"
                            },
                            {
                                "target_lang_word": "未来的",
                                "target_lang_sense_clarification": "用于描述身份或状态即将发生转变。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4efd018-57c9-3480-b2ec-2bcbc714cfcd",
                    "sense_definition": "Het onvoltooid deelwoord van <w>aanstaan</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>aanstaande</w> televisie veroorzaakte per ongeluk een kleine brand in de woonkamer.",
                            "target_lang_translations": {
                                "zh": "客厅里<w>开着的</w>电视不小心引发了一场小火灾。"
                            }
                        },
                        {
                            "text": "Door de <w>aanstaande</w> lampen in de hal was het erg licht in huis.",
                            "target_lang_translations": {
                                "zh": "因为门厅里<w>开着的</w>灯，屋子里非常亮。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammaticale vorm van het werkwoord aanstaan."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词“aanstaan”（开启、处于工作状态）的现在分词形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "开着的",
                                "target_lang_sense_clarification": "指电器或设备处于运行状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
