                "senses": [
                    {
                        "sense_id": "835024d8-c8f4-358b-a23d-fd9c87f42081",
                        "entry_id": "784b67c9-6510-327e-90d3-e7a57aa17787",
                        "glosses": [
                            "Spielklasse, die parallel zu einer anderen existiert und mit ihr konkurriert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae80e3d-a469-4c95-abbc-e6e830d192cd",
                                "sense_id": "835024d8-c8f4-358b-a23d-fd9c87f42081",
                                "text": "„Den vielfältigen Aktivitäten der Konkurrenzliga konnte die NFL nicht lange tatenlos zusehen.“"
                            },
                            {
                                "example_id": "670030b9-e4d4-409e-847f-4297e7a0a1ff",
                                "sense_id": "835024d8-c8f4-358b-a23d-fd9c87f42081",
                                "text": "„Fünf englische Fußball-Spitzenclubs prüfen einem Bericht zufolge Pläne für eine Konkurrenzliga zur Champions League.“"
                            },
                            {
                                "example_id": "b1992933-d4eb-4b10-b05e-95f021e758cc",
                                "sense_id": "835024d8-c8f4-358b-a23d-fd9c87f42081",
                                "text": "„Schnell hatte er genug Investoren gefunden, um sich in die AFL - die damalige Konkurrenzliga der NFL - einzukaufen.“"
                            }
                        ],
