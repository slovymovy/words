                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian William <w>Hone</w> is known for his political writings.",
                            "target_lang_translations": {
                                "zh": "历史学家威廉·<w>霍恩</w>以其政治著作而闻名。"
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Hone</w> can trace their ancestry back to England.",
                            "target_lang_translations": {
