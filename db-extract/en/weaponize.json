                        "translation_id": "b9d19421-6a9d-450b-b992-99640ab9159e",
                        "source_entry_id": "931427ca-0465-3c86-bb43-58aa315c9e17",
                        "source_sense_description": "make into a weapon",
                        "target_lang_word": "arsenaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
