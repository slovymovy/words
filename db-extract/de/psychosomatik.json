                    {
                        "translation_id": "844ac120-d5e1-4fd4-b87e-6509590a8e8b",
                        "source_entry_id": "b2006d22-f2a5-39ab-93da-e3804994da43",
                        "source_sense_id": "6b189702-841b-31ef-b7fc-dd458915fec6",
