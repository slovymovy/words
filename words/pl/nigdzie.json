                            {
                                "target_lang_word": "нигде",
                                "target_lang_sense_clarification": "отсутствие в каком-либо месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4585a12f-b9a8-39b0-80a2-efcbac561919",
                    "sense_definition": "do żadnego miejsca",
