                "senses": [
                    {
                        "sense_id": "771de740-76ca-388e-9852-25ec0f8fd192",
                        "entry_id": "508766ab-928e-3713-9b3a-cdb3c938a863",
                        "glosses": [
                            "Alpenpass im Schweizer Kanton Graubünden, der die Täler Oberhalbstein und Engadin verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1677033d-8847-4f5c-8072-dbf7c81f3e11",
                                "sense_id": "771de740-76ca-388e-9852-25ec0f8fd192",
                                "text": "„Es ist dasselbe Bild, das sich den Segantinis bot an diesem Knotenpunkt des Dorfes, an dem sich die Postkutschen zur Fahrt über den Julierpass sammelten.“"
                            },
                            {
                                "example_id": "cebb0935-03a0-4647-9cea-aea034d83f86",
                                "sense_id": "771de740-76ca-388e-9852-25ec0f8fd192",
                                "text": "„Auf Wanderungen in der Schweiz stösst man mitunter auf Überreste römischer Verkehrswege – am Julierpass genauso wie im Berner Jura.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
