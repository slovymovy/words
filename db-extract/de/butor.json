                "senses": [
                    {
                        "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                        "entry_id": "61014742-4e5c-3313-9beb-0ce017e67db8",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8637a7a9-e869-4426-ad85-0be159bb7897",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Frau Butor ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dd4b139a-a13e-4366-8c98-329d4f87c1e8",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Herr Butor wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec063ff6-e9f9-4fa5-a4f0-27f5871fe990",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Die Butors kommen heute aus dem Odenwald."
                            },
                            {
                                "example_id": "f26ea78e-6425-444a-a62c-02af175c55c1",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Der Butor trägt nie die Schals, die die Butor ihm strickt."
                            },
                            {
                                "example_id": "d2710059-2e60-4217-8a57-9a2a8b4b954a",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Butor kommt, geht der Herr Butor.“"
                            },
                            {
                                "example_id": "cb4d703c-13db-4ff9-abc1-2feaba818d26",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Butor kommt und geht."
                            },
                            {
                                "example_id": "74645afa-a0d9-4594-99f1-430a9ca6ff1e",
                                "sense_id": "d82c078b-b1d1-394d-9450-4a888c51f809",
                                "text": "Butors kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
