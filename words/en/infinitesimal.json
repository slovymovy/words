            "senses": [
                {
                    "sense_id": "cf92c23d-2328-37f9-934a-c29e49179c4f",
                    "sense_definition": "Extremely small; minute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smallness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even an <w>infinitesimal</w> change in the temperature can affect the delicate chemical reaction.",
                            "target_lang_translations": {
                                "pl": "Nawet <w>nieskończenie mała</w> zmiana temperatury może wpłynąć na delikatną reakcję chemiczną."
                            }
                        },
                        {
                            "text": "The difference between the two runners was an <w>infinitesimal</w> fraction of a second.",
                            "target_lang_translations": {
                                "pl": "Różnica między dwoma biegaczami była <w>nieskończenie małym</w> ułamkiem sekundy."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiny",
                        "minuscule",
                        "microscopic"
                    ],
                    "antonyms": [
                        "enormous"
                    ],
                    "common_phrases": [
                        "infinitesimal fraction",
                        "infinitesimal difference"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niezwykle mały; drobny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieskończenie mały",
                                "target_lang_sense_clarification": "używane do opisania czegoś o znikomej wielkości"
                            },
                            {
                                "target_lang_word": "znikomy",
                                "target_lang_sense_clarification": "bardzo mały, niemal niezauważalny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f218ab2-6025-36f1-ae2c-586aa75db5ac",
                    "sense_definition": "Incalculably, exceedingly, or immeasurably minute; vanishingly small.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smallness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you ever get the feeling that you are but an <w>infinitesimal</w> speck, swallowed by the vastness of the universe?",
                            "target_lang_translations": {
                                "pl": "Czy masz czasem wrażenie, że jesteś tylko <w>nieskończenie małym</w> pyłkiem, pochłoniętym przez ogrom wszechświata?"
                            }
                        },
                        {
                            "text": "The glass shattered into <w>infinitesimal</w> pieces that were almost impossible to clean up completely.",
                            "target_lang_translations": {
                                "pl": "Szkło rozbiło się na <w>nieskończenie małe</w> kawałki, które prawie niemożliwe było całkowicie posprzątać."
                            }
                        }
                    ],
                    "synonyms": [
                        "immeasurable",
                        "vanishingly small"
                    ],
                    "antonyms": [
                        "infinite"
                    ],
                    "common_phrases": [
                        "infinitesimal speck",
                        "infinitesimal amount"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niemożliwy do obliczenia, nadmiernie lub niezmierzalnie drobny; zanikający."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieskończenie mały",
                                "target_lang_sense_clarification": "podkreślające ekstremalną małość"
                            },
                            {
                                "target_lang_word": "mikroskopijny",
                                "target_lang_sense_clarification": "tak mały, że ledwo widoczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0a9b20a-90e7-3779-901a-365b35ca4de9",
                    "sense_definition": "Of or pertaining to non-zero quantities whose magnitude is less than any positive rational number.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In non-standard analysis, we work with <w>infinitesimal</w> quantities that are smaller than any positive real number.",
                            "target_lang_translations": {
                                "pl": "W analizie niestandardowej pracujemy z <w>infinitezymalnymi</w> wielkościami, które są mniejsze od każdej dodatniej liczby rzeczywistej."
                            }
                        },
                        {
                            "text": "The calculus of Leibniz was originally formulated using <w>infinitesimal</w> steps.",
                            "target_lang_translations": {
                                "pl": "Rachunek różniczkowy Leibniza został pierwotnie sformułowany przy użyciu <w>nieskończenie małych</w> kroków."
                            }
                        }
                    ],
                    "common_phrases": [
                        "infinitesimal calculus",
                        "infinitesimal quantity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dotyczący niezerowych wielkości, których wartość jest mniejsza niż jakakolwiek dodatnia liczba wymierna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "infinitezymalny",
                                "target_lang_sense_clarification": "termin techniczny w matematyce"
                            },
                            {
                                "target_lang_word": "nieskończenie mały",
                                "target_lang_sense_clarification": "w kontekście matematycznym"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0659690f-a154-3e2d-85f3-8f4fa80eca7f",
                    "sense_definition": "A non-zero quantity whose magnitude is smaller than any positive number.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mathematics, an <w>infinitesimal</w> is a value that approaches zero but is not exactly zero.",
                            "target_lang_translations": {
                                "pl": "W matematyce <w>wielkość nieskończenie mała</w> to wartość, która dąży do zera, ale nie jest dokładnie zerem."
                            }
                        },
                        {
                            "text": "He explained how the integral can be viewed as the sum of an infinite number of <w>infinitesimals</w>.",
                            "target_lang_translations": {
                                "pl": "Wyjaśnił, jak całkę można postrzegać jako sumę nieskończonej liczby <w>wielkości nieskończenie małych</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "infinity"
                    ],
