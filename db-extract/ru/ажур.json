                    {
                        "translation_id": "ecbe81b0-98c9-4448-b0f4-bf9e35dd1771",
                        "source_entry_id": "f1cbe29d-57b7-3c1f-8dfd-83306a3ab0e1",
                        "source_sense_description": "узор",
                        "target_lang_word": "ajour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
