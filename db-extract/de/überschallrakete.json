                ],
                "senses": [
                    {
                        "sense_id": "110b4c0c-ef6c-37a9-84ab-310890d876df",
                        "entry_id": "415382b4-639d-3ee1-ac04-97b8f75f426c",
                        "glosses": [
                            "Rakete, die in der Lage ist, die Schallgeschwindigkeit zu überschreiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb16832-b18a-4926-a5ab-38750c3bed0c",
                                "sense_id": "110b4c0c-ef6c-37a9-84ab-310890d876df",
                                "text": "„Es gab da mal vor 76 Jahren einen deutschen Raketenforscher, der die erste Überschallrakete erfand und diese auch erfolgreich testete und in andere Länder verschießen ließ.“"
                            },
                            {
                                "example_id": "1f969d61-629a-4054-96a6-f43301b88f30",
                                "sense_id": "110b4c0c-ef6c-37a9-84ab-310890d876df",
                                "text": "„Die Chinesen enthüllten bei der Gelegenheit auch ihre neueste »bahnbrechende« Waffe, eine Überschallrakete mit fünffacher Schallgeschwindigkeit.“"
                            },
                            {
                                "example_id": "4e1871cf-82dc-4f4b-a316-7da816dc7232",
                                "sense_id": "110b4c0c-ef6c-37a9-84ab-310890d876df",
                                "text": "„Eine Überschallrakete bräuchte von der Sowjetunion zu den Vereinigten Staaten bloß eine halbe Stunde.“"
                            },
                            {
                                "example_id": "f2e1c45a-327c-48f3-995f-77f784f22a73",
                                "sense_id": "110b4c0c-ef6c-37a9-84ab-310890d876df",
                                "text": "„Die Überschallrakete sei im Süden Russlands gestartet und habe ihr Ziel 4000 Kilometer entfernt auf der Halbinsel Kamtschatka im äußersten Osten Russlands erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
