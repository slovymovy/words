                "senses": [
                    {
                        "sense_id": "346c41b1-6627-3f61-9cbb-f8a514e923cf",
                        "entry_id": "38672f90-b48c-3845-9270-78b72486aad3",
                        "glosses": [
                            "das Vorhandensein von etwas, das nicht im Fokus der Öffentlichkeit steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0c81c1-6969-4229-ae26-32f8d93f8fd0",
                                "sense_id": "346c41b1-6627-3f61-9cbb-f8a514e923cf",
                                "text": "„Den kleinen jüdischen Geldverleihern blieb die Winkelexistenz als Pfandleiher, die sie sich mit den Lombarden teilten.“"
                            },
                            {
                                "example_id": "ef7b1024-71de-4cec-a2ec-748564c32639",
                                "sense_id": "346c41b1-6627-3f61-9cbb-f8a514e923cf",
                                "text": "„Die Schweizer Eidgenossenschaft verdankt ihre relative Stabilität nicht zuletzt dem Umstand, daß sie von ihrer Winkelexistenz im Windschatten der allgemeinen europäischen Friedensordnung der großen Mächte profitiert.“"
                            },
                            {
                                "example_id": "384bf8ce-f0e8-45c4-8f33-859f27baec02",
                                "sense_id": "346c41b1-6627-3f61-9cbb-f8a514e923cf",
                                "text": "„Zu einer Winkelexistenz schien Jerusalem nunmehr verurteilt zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
