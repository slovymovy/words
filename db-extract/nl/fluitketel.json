                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flötenkessel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35e4113c-e5b1-33fa-9a94-b34b79a52bde",
                                        "entry_id": "3ac67f80-0bf6-3699-a752-8d434bb0358f",
                                        "glosses": [
                                            "metallisches Gefäß zum Wasserkochen"
                                        ],
                                        "tags": [
                                            "Küchengerät"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37c201bb-00c7-42ee-aa92-b6695af1b9f6",
                                                "sense_id": "35e4113c-e5b1-33fa-9a94-b34b79a52bde",
                                                "text": "Beim Flötenkessel hört man, wenn das Wasser kocht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d35979e7-ff38-4cb0-8aa8-f0eb83cb1a65",
                        "source_entry_id": "aab2c696-6d5b-306d-959c-5bc6e8f26d7e",
                        "source_sense_id": "cbfd8030-9057-3c5a-83db-352b314b29d8",
                        "target_lang_word": "Teekessel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teekessel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61f3c411-7462-3e5d-9770-a915a9a6a1a7",
                                        "entry_id": "67135a3d-293d-3340-9374-bb1b1e84f038",
                                        "glosses": [
                                            "kleiner Kessel zum Wasserkochen, mit Tülle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d047169-a60c-4ef6-af07-2dfd30365d9c",
                                                "sense_id": "61f3c411-7462-3e5d-9770-a915a9a6a1a7",
                                                "text": "Hier machen wir das Kaffeewasser noch mit dem Teekessel heiß."
                                            },
                                            {
                                                "example_id": "4aca93f8-d128-49ec-ba66-b93153f0ae19",
                                                "sense_id": "61f3c411-7462-3e5d-9770-a915a9a6a1a7",
                                                "text": "„Was wir besitzen, ist rasch aufgezählt: meine Matratze, Küchenmesser und Teekessel, einen Kochtopf samt Kochlöffel, drei Thermosflaschen und pro Kopf ein Eßbesteck, einen Teller und anderthalb Tassen.“"
                                            },
                                            {
                                                "example_id": "e016451b-1870-4b4d-a100-eaf3e4c9909f",
                                                "sense_id": "61f3c411-7462-3e5d-9770-a915a9a6a1a7",
                                                "text": "„Der Teekessel summte behaglich.“"
                                            },
                                            {
                                                "example_id": "465fe563-6c29-4a8f-b026-71d4bceeb16b",
                                                "sense_id": "61f3c411-7462-3e5d-9770-a915a9a6a1a7",
                                                "text": "„Ich holte mir aus einer vom Feuer verschont gebliebenen Wohnung im zweiten Aufgang einen Teekessel und einen Topf und kehrte auf meinen Hängeboden zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6bbda69f-24ce-3c69-b2a4-155d76473f07",
                                        "entry_id": "67135a3d-293d-3340-9374-bb1b1e84f038",
                                        "glosses": [
                                            "Spiel, bei dem Homonyme geraten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b5fb7e-2644-488d-abe3-8d3e45e07b1e",
                                                "sense_id": "6bbda69f-24ce-3c69-b2a4-155d76473f07",
                                                "text": "Wollen wir lieber „Teekessel“ oder „Wer bin ich?“ spielen?"
                                            },
                                            {
                                                "example_id": "fae0506e-c3ab-4b08-9a89-4a5f396730b6",
                                                "sense_id": "6bbda69f-24ce-3c69-b2a4-155d76473f07",
                                                "text": "„Er kam nicht drauf, daß mein Teekessel das Garagentor war und Stephans Teekessel das Tor als anderes Wort für Narr, und Oliver Wolter sagte, das sei kein echter Teekessel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
