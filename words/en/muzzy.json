                    "sense_definition": "A moustache.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to grow a thick <w>muzzy</w> for the charity event this November.",
                            "target_lang_translations": {
                                "de": "Er beschloss, sich für die Benefizveranstaltung in diesem November einen dichten <w>Schnauzer</w> wachsen zu lassen.",
                                "fr": "Il a décidé de se laisser pousser une épaisse <w>moustache</w> pour l'événement caritatif de ce mois de novembre.",
                                "ru": "Он решил отрастить густые <w>усы</w> для благотворительного мероприятия в этом ноябре."
                            }
                        },
                        {
                            "text": "His grandfather had spent decades grooming and trimming a distinctive grey <w>muzzy</w>.",
                            "target_lang_translations": {
                                "de": "Sein Großvater hatte Jahrzehnte damit verbracht, einen markanten grauen <w>Schnurrbart</w> zu pflegen und zu stutzen.",
                                "fr": "Son grand-père avait passé des décennies à soigner et tailler une <w>moustache</w> grise caractéristique.",
                                "ru": "Его дедушка десятилетиями ухаживал и подравнивал свои приметные седые <w>усы</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal abbreviation of moustache"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Schnurrbart (umgangssprachliche Kurzform).",
                        "fr": "Moustache (argot ou familier).",
                        "ru": "Усы (разговорное сокращение от moustache)."
                    },
