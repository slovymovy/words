                    {
                        "translation_id": "e45355a5-f128-4f78-a394-6f0d38365a39",
                        "source_entry_id": "63a955b6-e0e2-3c5e-bcbc-1a2ea0ac5140",
                        "source_sense_id": "fe375614-8389-31ef-8a72-74dcf2a43205",
                        "source_sense_description": "in a half-hearted manner",
                        "target_lang_word": "halbherzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halbherzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                        "entry_id": "50cbac08-fdf2-3026-823f-6366e33bdec3",
                                        "glosses": [
                                            "sich nicht voll für etwas einsetzend: ohne echte Motivation, ohne Elan, ohne Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1c431e-5e0d-44c3-9191-5e7e5c018ee0",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "Jodtabletten an die Bevölkerung zu verteilen als Vorsorge gegen einen Unfall eines Atomkraftwerkes ist ein halbherziger Versuch, die Bevölkerung zu schützen."
                                            },
                                            {
                                                "example_id": "939c8279-268b-41b6-8e80-207ac5cab728",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "Klimapolitik wird in Deutschland nur halbherzig betrieben: im Zweifel hat die Wirtschaftspolitik Vorrang."
                                            },
                                            {
                                                "example_id": "d59d83dc-4e01-4267-abb6-1b72d15fcdb2",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„Viele osteuropäische Staaten sind besorgt, weil US-Präsident Trump sich [nur] halbherzig zur NATO und zur Beistandspflicht bekannt hat.“"
                                            },
                                            {
                                                "example_id": "ea4de37c-8f41-4328-a4b7-7629ea25f256",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„Zwar beginnt der französische Energieriese EDF inzwischen mit Planungen für mehr Wind- und Solarkraft, jedoch wirkt die ganze Energiepolitik halbherzig und unkoordiniert.“"
                                            },
                                            {
                                                "example_id": "753b102b-6128-473e-bcb3-1826900cad78",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„Bildungspolitiker gehen das Problem [der Schulabbrecher] nur halbherzig an […].“"
                                            },
                                            {
                                                "example_id": "e3089003-9559-48e0-a998-af2136d9c701",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "[Schlagzeile:] „EU kämpft nur halbherzig gegen Steuertricks“"
                                            },
                                            {
                                                "example_id": "99de9dbd-f853-4bfe-ad04-5a3e2a13825d",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„[Mahatma] Gandhis Idee von der Dorfindustrie wurde nur halbherzig umgesetzt.“"
                                            },
                                            {
                                                "example_id": "de04298d-4c33-4d10-bf5c-128c2abc3d82",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„Die meisten grossen Exportnationen verfolgen den Kampf gegen Korruption bei Exportgeschäften nicht oder nur halbherzig.“ [Anmerkung: ‚grossen‘ ist Schweizer Rechtschreibung]"
                                            },
                                            {
                                                "example_id": "7ee3dc79-5f8a-4ac0-a31d-38bdf3ed5c04",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„Ab 1771 arbeitete [Johann Wolfgang von Goethe] als Anwalt in seiner Heimatstadt Frankfurt – eher halbherzig. Mit weit größerer Begeisterung widmete er sich der Literatur und seinen naturwissenschaftlichen Studien.“"
                                            },
                                            {
                                                "example_id": "5a7e8149-335a-4928-913e-a171f08ef50a",
                                                "sense_id": "1ebde44f-86c7-39b3-8af6-0a6746a0160e",
                                                "text": "„Die Online-Umfrage der EU zur Zeitumstellung war nicht nur halbherzig, sie schadet der Kommission in Brüssel sogar […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
