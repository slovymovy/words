            {
                "entry_id": "531e4b04-a58e-3a99-9701-cbf3387b5e58",
                "word": "awa",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "43267d37-2217-31c9-bbdf-16f014642c30",
                        "entry_id": "531e4b04-a58e-3a99-9701-cbf3387b5e58",
                        "glosses": [
                            "Kava, specifically Piper methysticum."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3a509be8-3474-4f4d-8c0c-e4a2ece45224",
                                "sense_id": "43267d37-2217-31c9-bbdf-16f014642c30",
                                "text": "The manner of preparing awa is peculiarly disgusting. The root is chewed by women, and the spit out well-chewed mouthfuls into a calabash."
                            },
                            {
                                "example_id": "92b5eff1-567a-443d-96ee-08c468c2bddd",
                                "sense_id": "43267d37-2217-31c9-bbdf-16f014642c30",
                                "text": "The awa plant is a species of pepper, the piper methysticum of the botanist, and is described as having fleshy stems from two to three feet high."
                            },
                            {
                                "example_id": "57d2aee9-b900-4803-91b8-69aca71cb437",
                                "sense_id": "43267d37-2217-31c9-bbdf-16f014642c30",
                                "text": "The majority say that there is little awa growing wild on Government lands, the bulk of that at present in the market being obtained from cultivated patches."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ce90ba1-5467-3abb-a8e0-3adde649a596",
                        "entry_id": "531e4b04-a58e-3a99-9701-cbf3387b5e58",
                        "glosses": [
                            "An intoxicating drink made from the kava plant, typically the root."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d72883d9-61b5-4f69-9437-d3dc1d42db82",
                                "sense_id": "9ce90ba1-5467-3abb-a8e0-3adde649a596",
                                "text": "The Hawaiian gods were supposed to be particularly addicted to the use of awa. Songs were sung in praise of the drink."
                            },
                            {
                                "example_id": "2b0d6e09-25a4-4323-bb24-168874947f96",
                                "sense_id": "9ce90ba1-5467-3abb-a8e0-3adde649a596",
                                "text": "When the prayer had finished, the awa was drunk and the sacred feast then began."
                            }
                        ]
                    }
                ],
