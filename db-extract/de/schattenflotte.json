                "senses": [
                    {
                        "sense_id": "b3183569-e5ce-35b2-afe3-637f0308c4b9",
                        "entry_id": "26b69040-83a1-3153-a907-1aebf73b9e9a",
                        "glosses": [
                            "Gesamtheit der inoffiziellen Schiffe eines Landes mit unklaren Eigentumsverhältnissen, die zum Transport durch Sanktionen verbotener Waren verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f6ad45-dadf-4aa8-9d64-c6b75fb92b69",
                                "sense_id": "b3183569-e5ce-35b2-afe3-637f0308c4b9",
                                "text": "„Die Schattenflotte ist allerdings kein Novum, sondern schon lange durch andere vom Westen mit Sanktionen belegte Länder bekannt, darunter Venezuela oder der Iran.“"
                            },
                            {
                                "example_id": "d4330810-34b9-465b-a776-7953d697d03e",
                                "sense_id": "b3183569-e5ce-35b2-afe3-637f0308c4b9",
                                "text": "„Die Umweltorganisation Greenpeace rechnet das 2006 gebaute Schiff zur sogenannten russischen Schattenflotte, mit der das mit Sanktionen belegte Russland Öl exportiert.“"
                            },
                            {
                                "example_id": "488f4a02-7e52-42b6-b13b-fccdad6267a3",
                                "sense_id": "b3183569-e5ce-35b2-afe3-637f0308c4b9",
                                "text": "„Das Schiff steht im Verdacht, zur russischen Schattenflotte zu gehören.“"
                            },
                            {
                                "example_id": "dbdc0b69-ce8a-4981-8a0b-a21bef9f194c",
                                "sense_id": "b3183569-e5ce-35b2-afe3-637f0308c4b9",
                                "text": "„Es kann nicht sein, dass täglich marode Tanker der Schattenflotte auslaufen, um das Öl zu verkaufen und damit der Überfall auf die Ukraine finanziert wird.“"
                            },
                            {
                                "example_id": "d334a60f-5c6f-4cc2-ac68-e4b118890ce0",
                                "sense_id": "b3183569-e5ce-35b2-afe3-637f0308c4b9",
                                "text": "„Bislang hatte man in China nichts gegen die Schattenflotte unternommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
