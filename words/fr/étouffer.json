                        "étouffer les sons"
                    ]
                },
                {
                    "sense_id": "59c06c11-58b0-3f9d-800e-ee906f02d848",
                    "sense_definition": "Empêcher des végétaux de pousser ou de respirer en leur dérobant l'air ou la lumière.",
