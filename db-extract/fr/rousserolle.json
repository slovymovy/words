                "senses": [
                    {
                        "sense_id": "4012f373-5710-3ec3-b895-6413efa82acb",
                        "entry_id": "511506bf-b73c-3692-827f-00cd03a2f062",
                        "glosses": [
                            "Nom vernaculaire de plus de trente espèces de petits oiseaux passereaux de type fauvette de marais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f960b2e-fe53-4cea-9111-5650f864eeaa",
                                "sense_id": "4012f373-5710-3ec3-b895-6413efa82acb",
                                "text": "Morel lève la tête et aperçoit un oiseau de couleur jaune, perché sur la branche basse d’un arbre voisin.\n- Une rousserolle, dit Wong qui a suivi son regard. Ici, on l’appelle komako."
                            },
                            {
                                "example_id": "2ef47b87-0ef7-4438-bcb2-df65278492a6",
                                "sense_id": "4012f373-5710-3ec3-b895-6413efa82acb",
                                "text": "Alors, surgit dans un battement d’ailes une rousserolle au plumage qui ressemblait à la robe d’un chamois."
                            },
                            {
                                "example_id": "89d0f10c-a480-46ea-86a7-c5833453fff1",
                                "sense_id": "4012f373-5710-3ec3-b895-6413efa82acb",
                                "text": "La rousserolle verderolle (Acrocephalus palustris) a un chant extrêmement varié et musical, elle est capable d’imiter d’autres passereaux, ce qui la distingue de la rousserolle effarvatte (Acrocephalus scirpaceus)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d1db193-6ca0-425c-b38e-039fac5f7249",
                        "source_entry_id": "511506bf-b73c-3692-827f-00cd03a2f062",
                        "source_sense_id": "4012f373-5710-3ec3-b895-6413efa82acb",
