                "senses": [
                    {
                        "sense_id": "9ef8015c-51d2-3a47-9354-a3396fb91e93",
                        "entry_id": "ee6ae661-475c-3f29-b9d4-5c33c4f19f2d",
                        "glosses": [
                            "Enlever le bicarbonate de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be57b68-8ca5-4636-8200-9665b98c9fc5",
                                "sense_id": "9ef8015c-51d2-3a47-9354-a3396fb91e93",
                                "text": "On peut encore citer l’addition de gypse ou de chlorure de calcium pour limiter le gonflement des argiles, l’addition d’hydroxyde de calcium, ou de chaux éteinte, pour débicarbonater des boues contaminées par du dioxyde de carbone."
                            },
                            {
                                "example_id": "a7f9bc2e-6507-4dec-9b00-78a37f546817",
                                "sense_id": "9ef8015c-51d2-3a47-9354-a3396fb91e93",
                                "text": "La liqueur-mère aqueuse (G) est partiellement débicarbonatée et une partie de l’eau est retirée pour obtenir le flux (B) et un gaz optionnel (H) comprenant du CO₂ dans un débicarbonateur 3."
                            },
                            {
                                "example_id": "2d1cdfc4-ac48-4391-85e5-0ba37885fb29",
                                "sense_id": "9ef8015c-51d2-3a47-9354-a3396fb91e93",
                                "text": "Pour débicarbonater les boues contaminées par le gaz carbonique (CO₂)."
                            },
                            {
                                "example_id": "45e0a011-4f39-4e5b-93a6-6430a77d4178",
                                "sense_id": "9ef8015c-51d2-3a47-9354-a3396fb91e93",
                                "text": "au ^([sic : Au]) 5ᵉᵐᵉ match le csp ^([sic : CSP]) débicarbonate l’eau de vichy ^([sic : Vichy]) et s’impose largement."
                            }
                        ]
                    }
