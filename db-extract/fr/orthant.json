                                "sense_id": "b230cd04-705d-32ef-892a-3dc4cefafe00",
                                "text": "Cas n = 2 : l’orthant positif est le premier quadrant."
                            },
                            {
                                "example_id": "d90d69ad-81da-4142-87a9-66df8d8f8326",
                                "sense_id": "b230cd04-705d-32ef-892a-3dc4cefafe00",
                                "text": "Montrons que p est sans zéro dans l’orthant {x ≥ t}."
                            },
