                                "sense_id": "0c83810f-915d-3074-b326-85ba54302060",
                                "text": "In diesem Jahr verbringen sie ihren Urlaub auf den Hebriden."
                            },
                            {
                                "example_id": "df8b1c90-4a03-446c-8f71-0f3cb9ee34d6",
                                "sense_id": "0c83810f-915d-3074-b326-85ba54302060",
                                "text": "Die Hebriden liegen im Atlantik."
                            },
                            {
                                "example_id": "b37a8e29-950a-4e8e-8c6b-b695d7d2d797",
                                "sense_id": "0c83810f-915d-3074-b326-85ba54302060",
                                "text": "Das Lagerfeuer auf den Hebriden erlosch erst am frühen Morgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
