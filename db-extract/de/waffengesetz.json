                "senses": [
                    {
                        "sense_id": "5f2faa20-90df-32c5-8270-d539a58ebc9e",
                        "entry_id": "e3ce3610-caf4-3fc1-91c2-a82547dfb520",
                        "glosses": [
                            "Gesetz, das den Kauf von und Umgang mit Waffen (und Munition) regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f44edd2a-0d1c-4fd3-9bc1-dd9ce635aa41",
                                "sense_id": "5f2faa20-90df-32c5-8270-d539a58ebc9e",
                                "text": "„Nicole ist groß, schlank, blond und trägt ein schlichtes schwarzes Minikleid, schwarze Strumpfhosen mit Naht und hochhackige spitze Schuhe, die eigentlich unter das Waffengesetz fallen müssten.“"
                            },
                            {
                                "example_id": "b345494d-20e5-471d-bb12-34c1ea61a926",
                                "sense_id": "5f2faa20-90df-32c5-8270-d539a58ebc9e",
                                "text": "„Die öffentliche Meinung verhindert immer wieder strengere Waffengesetze in den USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
