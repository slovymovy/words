                "senses": [
                    {
                        "sense_id": "63429812-0e4d-30c8-9b8b-f11224300b67",
                        "entry_id": "db33f8a6-b84e-33c1-a1b6-fdefed891345",
                        "glosses": [
                            "Tag, an dem ein Markt abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c578f09b-4ea6-47bf-a840-5a1f5a376228",
                                "sense_id": "63429812-0e4d-30c8-9b8b-f11224300b67",
                                "text": "„An Markttagen bieten in Ouida Dutzende Prostituierte für eine Handvoll Kaurischnecken ihre Dienste an.“"
                            },
                            {
                                "example_id": "73efc2b6-d8b5-4498-ac80-12a95fe8c61e",
                                "sense_id": "63429812-0e4d-30c8-9b8b-f11224300b67",
                                "text": "„Der Annaberger Rat versuchte 1517, den Brotverkauf nach Joachimsthal auf den Markttag zu beschränken.“"
                            },
                            {
                                "example_id": "a892a02f-35b5-450e-b352-b8a32e6a2a29",
                                "sense_id": "63429812-0e4d-30c8-9b8b-f11224300b67",
                                "text": "„Das war ein Knabe, den sie an einem Markttage getroffen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
