                        "examples": [
                            {
                                "example_id": "10ef4136-90c3-4318-8a43-ae617983db1a",
                                "sense_id": "619f9441-a798-3e85-8532-42672dae8f1b",
                                "text": "Je recrémouille, la plupart du temps."
                            },
                            {
                                "example_id": "93d5736b-707b-486d-b548-a1d4f62be549",
                                "sense_id": "619f9441-a798-3e85-8532-42672dae8f1b",
                                "text": "Là, avec cette crème Bioderma, je tiens une demi-journée (de toute façon je me démaquille à midi, et je me recrémouille et remaquille en début d'après-midi) ou une nuit (mais le matin, aouch, ça tire à mort, enfin cela vient peut-être du Pannogel)."
                            }
                        ]
                    }
