    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                "word": "backyard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cbdace4c-406d-486f-b83d-786bb8cbaf2e",
                        "entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "tags": [
                            "plural"
                        ],
                        "form": "backyards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5832ab4-04d6-304a-a802-e6bae3907469",
                        "entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "glosses": [
                            "A yard to the rear of a house or similar residence."
                        ],
                        "tags": [
                            "Australia",
                            "Canada",
                            "New-Zealand",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "69d8e383-fdb1-45f7-a2a0-ebf963918da7",
                                "sense_id": "d5832ab4-04d6-304a-a802-e6bae3907469",
                                "text": "I think when I discovered this republic, which is in Nevada - in one man's house and backyard and front garden - I think I stumbled across what for me really typifies the whole micronational movement."
                            }
                        ]
                    },
                    {
                        "sense_id": "f43b1caf-36f5-3b22-883b-af5695b916da",
                        "entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "glosses": [
                            "A person's neighborhood, or an area nearby to a person's usual residence or place of work and where the person is likely to go."
                        ],
                        "tags": [
                            "Australia",
                            "Canada",
                            "New-Zealand",
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d62a49a6-d202-4670-bf38-068fb6adf295",
                                "sense_id": "f43b1caf-36f5-3b22-883b-af5695b916da",
                                "text": "The entire beach was my backyard, from the Hiltons' house in the south all the way to Steele Hunter's house in the north."
                            }
                        ]
                    },
                    {
                        "sense_id": "031d2edd-2937-3c86-9e72-0d330b5361da",
                        "entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "glosses": [
                            "An area nearby to a country or other jurisdiction's legal boundaries, particularly an area in which the country feels it has an interest."
                        ],
                        "tags": [
                            "Australia",
                            "Canada",
                            "New-Zealand",
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "af0da3cb-6574-47b7-bfef-e6ed5ef52cf0",
                                "sense_id": "031d2edd-2937-3c86-9e72-0d330b5361da",
                                "text": "However, the region was in the United States backyard and Britain should look passively on with acquiescence in whatever policy the United States saw fit to pursue about Mexico."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45b51f0e-1129-44a9-8886-b9339ea9b9b9",
                        "source_entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "source_sense_description": "yard to the rear of a house",
                        "target_lang_word": "achtertuin",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achtertuin",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6a21bafc-4fd1-319a-8c12-39a91ae5ff6a",
                                        "entry_id": "09799eba-744a-3dfc-8b72-ed0bd6d5be29",
                                        "glosses": [
                                            "een tuin aan de achterzijde van een huis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77e1be6d-18cc-44d4-a8d4-c55272c9fe07",
                                                "sense_id": "6a21bafc-4fd1-319a-8c12-39a91ae5ff6a",
                                                "text": "Ze zaten gezellig in hun achtertuintje."
                                            },
                                            {
                                                "example_id": "01b9495d-54c4-49fa-81c9-5dc76fc0e2f9",
                                                "sense_id": "6a21bafc-4fd1-319a-8c12-39a91ae5ff6a",
                                                "text": "Ze vertelde me uitgebreid dat ze zo van het hiker season hield, wanneer er talloze mensen (‘…met die heerlijke zweetgeur’) in haar achtertuin verbleven."
                                            },
                                            {
                                                "example_id": "52147c2f-14b1-494f-bb1d-2c8c70cac950",
                                                "sense_id": "6a21bafc-4fd1-319a-8c12-39a91ae5ff6a",
                                                "text": "De achtertuin was zoals ze in oude kinderboeken werden beschreven: een beetje rommelig, met verwilderde struiken, knoestige pruimenbomen, kapotte bloempotten met munt erin, wilde viooltjes die het uitstekend deden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46e1a2ef-7a82-4227-aa6e-8f0a36bf29e8",
                        "source_entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "source_sense_description": "yard to the rear of a house",
                        "target_lang_word": "arrière-cour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-cour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65c7003d-5191-3e9d-bf85-71fb2a3df086",
                                        "entry_id": "2a5b60f2-d91e-3048-b825-45bb25bc4950",
                                        "glosses": [
                                            "Petite cour qui, dans un corps de bâtiment, sert à dégager et à éclairer les appartements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09093d19-ef3e-4fc9-91cd-99113b152723",
                                                "sense_id": "65c7003d-5191-3e9d-bf85-71fb2a3df086",
                                                "text": "Nicolas Poux peaufine les derniers réglages depuis l’arrière-cour de son bar de Verteuil-sur-Charente."
                                            },
                                            {
                                                "example_id": "acc27a27-b4cb-4acd-a628-b04f1bb746b0",
                                                "sense_id": "65c7003d-5191-3e9d-bf85-71fb2a3df086",
                                                "text": "Ces rares vestiges, il faut les chercher dans les angles obscurs, au fond des arrière-cours."
                                            },
                                            {
                                                "example_id": "a9fa42d3-3adc-49fa-a35a-6059ae4023ab",
                                                "sense_id": "65c7003d-5191-3e9d-bf85-71fb2a3df086",
                                                "text": "L’atelier donnait sur l’arrière-cour de l’immeuble, où quatre apprentis patientaient au garde-à-vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adadc4cf-73e0-3c81-95ca-9ea7e634dfc6",
                                        "entry_id": "2a5b60f2-d91e-3048-b825-45bb25bc4950",
                                        "glosses": [
                                            "Étendue géographique considérée par une puissance géopolitique comme faisant partie de sa sphère d’influence exclusive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731be976-7193-49ec-a509-cfb8d113001b",
                                                "sense_id": "adadc4cf-73e0-3c81-95ca-9ea7e634dfc6",
                                                "text": "À quoi peut-on s’attendre de la nouvelle administration démocrate à la Maison-Blanche en ce qui a trait à l’Amérique latine, que les États-Unis considèrent encore et toujours comme leur arrière-cour?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f2ddaf6-4421-388a-a09e-ad5db65b4a45",
                                        "entry_id": "2a5b60f2-d91e-3048-b825-45bb25bc4950",
                                        "glosses": [
                                            "Fesses."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aeb9b3-efe6-4c74-91cb-3c1a64143146",
                                                "sense_id": "6f2ddaf6-4421-388a-a09e-ad5db65b4a45",
                                                "text": "Des bubons sur les boules,\nL’arrière-cour qui fleure la palourde…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a51fdda-3a60-464c-a774-1be4da54ab07",
                        "source_entry_id": "83398553-1f0c-3b32-96d3-76acb7c74b49",
                        "source_sense_description": "yard to the rear of a house",
                        "target_lang_word": "Hinterhof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterhof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5495f7-3e4d-3d76-941a-7c515ec651e4",
                                        "entry_id": "024deda6-7a86-314d-8f1b-e5e6d72c750b",
                                        "glosses": [
                                            "freier Platz auf der Rückseite eines Gebäudes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3241d3-b714-48ba-8ad5-5f9665c1e97b",
                                                "sense_id": "3a5495f7-3e4d-3d76-941a-7c515ec651e4",
                                                "text": "„Was sie auszeichnete, war einzig ein gewisser Einfallsreichtum an Verwahrlosung, der sich bis auf die Straßen und in die Hinterhöfe fortsetzte.“"
                                            },
                                            {
                                                "example_id": "3aea10bf-6cb9-4650-82ee-2eab8e564aa5",
                                                "sense_id": "3a5495f7-3e4d-3d76-941a-7c515ec651e4",
                                                "text": "„Es war eine geräumige Wohnung, mit zwei hellen Zimmern nach vorn, während das dritte und die Küche auf den Hinterhof wiesen.“"
                                            },
                                            {
                                                "example_id": "05b6856d-09ea-4d6e-9287-f97713ccd960",
                                                "sense_id": "3a5495f7-3e4d-3d76-941a-7c515ec651e4",
                                                "text": "„Jährlich im Februar drängen sich über eine Woche lang viele nervöse junge Menschen im Hinterhof der Münchner Kammerspiele.“"
                                            },
                                            {
                                                "example_id": "5a63b2fe-d705-4db5-b71b-8632180065e1",
                                                "sense_id": "3a5495f7-3e4d-3d76-941a-7c515ec651e4",
                                                "text": "„Tatsächlich sei sie bis zum Tischler Lý Phong vorgedrungen, der in einem dritten Hinterhof nahe dem Mauerpark Möbel ausbesserte und von geradezu sprichwörtlich schlechter Laune war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
