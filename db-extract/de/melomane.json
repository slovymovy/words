                        "examples": [
                            {
                                "example_id": "9048d6f0-ebf8-45df-9f00-fe41ba3764c2",
                                "sense_id": "f1aa8f7b-d64b-32b5-84c4-c4b8d5ada206",
                                "text": "Auch Mozart war bewusst, dass er Melomane^([sic]) mit Hilfe der Klavierkonzerte für seine Kunst begeistern konnte."
                            },
                            {
                                "example_id": "07f3c736-e610-43f8-a55f-cd6699c38d11",
                                "sense_id": "f1aa8f7b-d64b-32b5-84c4-c4b8d5ada206",
                                "text": "Die Melomanen bereiten sich vor auf die Opernspektakel zu Ostern, die Schauspielfreunde räsonieren über die Auswahl des Berliner Theatertreffens im Mai, in Hessen kamen bis Sonntag gut 10.000 Zuschauer zum Festival Tanzplattform."
                            }
                        ]
                    }
