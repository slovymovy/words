                    {
                        "translation_id": "98b33c36-328b-45c5-8c2e-ca0e47f496ac",
                        "source_entry_id": "1e8b5196-45b3-3bae-997a-e85c67218a43",
                        "source_sense_id": "3549591c-b16d-3a43-bf1b-2f4acfe5677b",
