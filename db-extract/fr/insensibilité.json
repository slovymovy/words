        "fr-extract.jsonl": [
            {
                "entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
                "word": "insensibilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77664b7a-cc29-47a5-94aa-c86c5058dfa1",
                        "entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
                        "tags": [
                            "plural"
                        ],
                        "form": "insensibilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                        "entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
                        "glosses": [
                            "Absence de sensibilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9336e50-3fa0-4984-ab9e-1d9ae5c96b97",
                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                "text": "On a dit une grande vérité lorsqu’on a posé en principe que toute la science du jockey consistait à faire supporter tout son poids par la bouche de son cheval ; mais on n’a pas parlé de l’insensibilité des barres que l’on produisait par cette manœuvre, […]."
                            },
                            {
                                "example_id": "4177c0cd-64ec-423d-b623-a292dad2885c",
                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                "text": "— Deux sortes de personnes contractent nécessairement beaucoup d’insensibilité : les chirurgiens, les prêtres. A voir toujours souffrir et mourir, on meurt peu à peu soi-même dans les facultés sympathiques."
                            },
                            {
                                "example_id": "083e7a96-bb1b-46a1-acb6-54c99847616e",
                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                "text": "L’examen par ce praticien révéla sans tarder sur le corps de Thomas le signe d’un pacte infernal, ces fameuses plaques d’insensibilité tenues de nos jours pour pathologiques, où les opérateurs pouvaient à leur aise enfoncer des épingles sans obtenir de cri ou de soubresaut du patient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b7d40fd-0e92-44dc-abf8-15ff70780551",
                        "source_entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
                        "source_sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                        "target_lang_word": "insensibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insensibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f604c9c-93c7-349e-b5ec-2dbacfab2c82",
                                        "entry_id": "bf96d953-b871-3d08-a0d1-a4f39d6eab60",
                                        "glosses": [
                                            "The property of being insensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0da3f69-2aa0-4ef8-9fe5-caacf043aa1d",
                                                "sense_id": "0f604c9c-93c7-349e-b5ec-2dbacfab2c82",
                                                "text": "What a deal of grief, care, and other harmful excitement does a healthy dulness and cheerful insensibility avoid!"
                                            },
                                            {
                                                "example_id": "aa809952-9d34-4bcf-ba05-fff9c7b4c425",
                                                "sense_id": "0f604c9c-93c7-349e-b5ec-2dbacfab2c82",
                                                "text": "When I recovered I found myself lying on a clean, comfortable bed, while there bent over me a physician and an elderly woman. I learned that I had been found early in the morning in the rear of the house in a state of insensibility, and that the owner of the place […] had caused me to be brought in and placed on the bed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9be4c11-6add-4b09-99b2-045a422c5844",
                        "source_entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
