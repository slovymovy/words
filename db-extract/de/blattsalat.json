                                                "sense_id": "d80d78be-0c96-34ec-be43-73f3e8b2b62f",
                                                "text": "Ik sla om me heen om de muggen bij me weg te houden."
                                            },
                                            {
                                                "example_id": "9d82a525-88b3-4867-8d11-9172527339d9",
                                                "sense_id": "d80d78be-0c96-34ec-be43-73f3e8b2b62f",
                                                "text": "Ook al ben ik geen katholiek, toch sla ik vaak een kruisje voor mijn borst."
                                            }
