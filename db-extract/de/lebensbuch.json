                            "biographisch"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "58928215-2a44-37af-8e83-0ce1ccab0f3c",
                        "entry_id": "cbff60f6-11f8-3733-b9d6-c5873c42bdfa",
                        "glosses": [
                            "dasjenige Buch, das für eine Person lebenslang als Ratgeber eine Bedeutung hat, das beispielsweise oft auf Reisen mitgenommen wird, das durchgearbeitet sowie mit Anstreichungen und Bemerkungen versehen wird, und in das oft wichtige Notizen auf Zetteln eingelegt werden"
                        ],
                        "tags": [
                            "persönlich"
                        ],
                        "examples": [
                            {
                                "example_id": "24082e75-9e38-4848-b4a2-626f3fe30d3c",
                                "sense_id": "58928215-2a44-37af-8e83-0ce1ccab0f3c",
                                "text": "Die klassischen Lebensbücher vieler Menschen sind die Bibel und das Kochbuch."
                            },
                            {
                                "example_id": "d96577ba-cc48-4fd0-bc87-b7a0de0d0002",
                                "sense_id": "58928215-2a44-37af-8e83-0ce1ccab0f3c",
                                "text": "Immanuel Kants „Grundlegung zur Metaphysik der Sitten“ diente dem deutschen Philosophen Hans-Georg Gadamer als Lebensbuch, das er auf fast all seinen Reisen bei sich trug."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
