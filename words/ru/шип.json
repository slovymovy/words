                    "sense_definition": "Вид рыбы семейства осетровых.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В Каспийском море обитает редкий вид осетровых — <w>шип</w>.",
                            "target_lang_translations": {
                                "en": "A rare species of sturgeon, the <w>ship sturgeon</w>, lives in the Caspian Sea."
                            }
                        },
                        {
                            "text": "Вылов <w>шипа</w> в реках сейчас строго запрещен.",
                            "target_lang_translations": {
                                "en": "Fishing for <w>ship sturgeon</w> in rivers is now strictly prohibited."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A type of fish belonging to the sturgeon family."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ship sturgeon",
                                "target_lang_sense_clarification": "A specific species of sturgeon (Acipenser nudiventris)."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b5a8123-3d67-33b6-9e90-460efda3c8b4",
