                                        "glosses": [
                                            "Aufbewahrungs- und Schutztasche für Kameraobjektive oder auch Ferngläser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89000b1f-325d-4e8b-b05d-b4ff88570df4",
                                                "sense_id": "9dade93b-6a9f-3d32-94db-3e87d8e7f57f",
                                                "text": "Sie steckte das 300er in den Köcher."
                                            },
                                            {
                                                "example_id": "8815ad02-eef9-4ce0-a4cd-391031d77393",
                                                "sense_id": "9dade93b-6a9f-3d32-94db-3e87d8e7f57f",
                                                "text": "„Noch bevor der Köcher den Boden des Terrariums erreicht hat, ist Titho zur Stelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3cffbca-a3e5-36ee-b954-7f6410936ce5",
                                        "entry_id": "78f77a1b-27c9-3b9e-9b64-76f8774fa852",
                                        "glosses": [
                                            "ein gerichteter Graph"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3011d66-0717-4cef-a2ef-3831f4f5dd46",
                                                "sense_id": "c3cffbca-a3e5-36ee-b954-7f6410936ce5",
                                                "text": "Ein Köcher ist dasselbe wie ein gerichteter Graph mit Schleifen und Mehrfachkanten."
