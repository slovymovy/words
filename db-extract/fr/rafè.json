                                        "entry_id": "f72db6e7-0390-31a9-bb6e-bb75942ddf09",
                                        "glosses": [
                                            "A seamlike ridge or furrow on an organ, bodily tissue, or other structure, typically marking the line where two halves or sections fused in the embryo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44eb14c-7e68-42fd-8c1f-e4e83e56decf",
                                                "sense_id": "2092b516-32f3-31e7-bfe4-26790bb99e65",
                                                "text": "They are inserted into the midline raphae or the anococcygeal raphae and the coccyx."
                                            },
                                            {
                                                "example_id": "fe76c317-05e1-456c-84d1-60e2e204b97e",
                                                "sense_id": "2092b516-32f3-31e7-bfe4-26790bb99e65",
                                                "text": "It shows three symmetrical raphes (asterisk) radiating from the centre of the aortic root, but in fetuses there is often asymmetry between the raphes with the one between the left and noncoronary sinuses being larger than the others (red asterisk in Figure 2.14b)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4db6ceb0-4932-38fd-a729-32b3cfb932a9",
                                        "entry_id": "f72db6e7-0390-31a9-bb6e-bb75942ddf09",
                                        "glosses": [
                                            "A seamlike ridge or furrow on an organ, bodily tissue, or other structure, typically marking the line where two halves or sections fused in the embryo.",
                                            "The connecting ridge between the two halves of the medulla oblongata or the tegmentum of the midbrain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b060156e-9399-35ba-8b03-222edcfd4c89",
                                        "entry_id": "f72db6e7-0390-31a9-bb6e-bb75942ddf09",
                                        "glosses": [
                                            "The part of the stalk of an anatropous ovary that is united in growth to the outside covering and forms a ridge along the body of the ovule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca48ece-6e29-44c8-b8a2-5692798069e6",
                                                "sense_id": "b060156e-9399-35ba-8b03-222edcfd4c89",
                                                "text": "The vast majority of the raphes do not bifurcate (123 genera), but the raphes of 7 genera do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c941a71d-ab6a-375a-ade2-a01798623250",
                                        "entry_id": "f72db6e7-0390-31a9-bb6e-bb75942ddf09",
                                        "glosses": [
                                            "A longitudinal median groove in the valve of many diatoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "769ea83e-88bd-4a54-a6df-1f0ef5d93d20",
                                                "sense_id": "c941a71d-ab6a-375a-ade2-a01798623250",
                                                "text": "The invariant occurrence of adhesive EPS at both the driving and the non-driving raphes supports a model for constitutive, rather than induced, secretion of the raphe adhesive."
                                            }
