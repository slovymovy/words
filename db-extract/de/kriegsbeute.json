                ],
                "senses": [
                    {
                        "sense_id": "ecf1e163-1292-3df5-a496-21c319ade9e2",
                        "entry_id": "fb7bd5a7-ff1e-3416-97a6-166784248bcf",
                        "glosses": [
                            "im Krieg durch Raub oder Plünderung angeeignete Güter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabd9880-a5f3-4547-8430-d97a31eaacce",
                                "sense_id": "ecf1e163-1292-3df5-a496-21c319ade9e2",
                                "text": "„Durch ihre Taten charakterisieren sie sich als sehr kriegerisch, als Völker, in deren Wirtschaft Kriegsbeuten eine wesentliche Rolle spielten.“"
                            },
                            {
                                "example_id": "96a27ab9-b175-4059-a7b9-0db2faf3b7c5",
                                "sense_id": "ecf1e163-1292-3df5-a496-21c319ade9e2",
                                "text": "„Für die Spanier waren wir nichts als eine Kriegsbeute, die man wie Arbeitstiere behandelte und schuften ließ, bis sie zusammenbrachen.“"
                            },
                            {
                                "example_id": "ec0a60ec-d88b-4c3a-8c78-ee947ecb316a",
                                "sense_id": "ecf1e163-1292-3df5-a496-21c319ade9e2",
                                "text": "„Als Resultat der Abkommen von Jalta und Potsdam erhält die Sowjetunion das nordöstliche Ostpreußen als Kriegsbeute.“"
                            },
                            {
                                "example_id": "ee9e2563-81f4-421a-bff3-da1bb82f7eb4",
                                "sense_id": "ecf1e163-1292-3df5-a496-21c319ade9e2",
                                "text": "„Nur eine überaus reiche Kriegsbeute durch Ausplünderung der Nachbarstaaten würde das Kaiserreich noch vor einer scharfen Inflation und damit Verarmung nach Kriegsende bewahren können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
