                                "example_id": "7d4604a8-577e-4c7e-94b2-2d4d5bafcd9d",
                                "sense_id": "fca964e1-810f-3cf2-a8c3-fe1769427ec6",
                                "text": "'Godswonder dat er niemand een schrammetje heeft opgelopen'"
