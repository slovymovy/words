                        ],
                        "examples": [
                            {
                                "example_id": "2d9fd09f-8860-4f99-8155-5406f222e8b0",
                                "sense_id": "0767f085-4d9f-322f-bc71-dfabc492bad6",
                                "text": "„Im Jahre 1793 klagten die Lehrerinnen zu St. Castor in Koblenz, dass die Sprachmeisterin des Französischen Sophie Berlang eine eigene Schule errichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
