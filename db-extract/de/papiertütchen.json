                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb6f3ed-0f7c-4703-98ce-e2072ca4351d",
                                "sense_id": "1cf40e85-91b0-32db-ba27-2eb9ca3f284e",
                                "text": "„Nun schleppt er wahrscheinlich Papiertütchen mit Beweismitteln vom Labor der Spurensicherung zum Kabuff irgendeines Anwalts im zweiten Stock, wo man ihm sagen wird, dass sein bester Zeuge noch nicht aufgetaucht ist und auch nicht auf Anrufe reagiert.“"
                            },
                            {
                                "example_id": "4e8f926a-aff7-436e-8ded-24784c982fb4",
                                "sense_id": "1cf40e85-91b0-32db-ba27-2eb9ca3f284e",
                                "text": "„Er setzte sich auf die Ladeklappe und aß das Fleisch mit Salz und Pfeffer aus kleinen Papiertütchen von einem Drive-in.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
