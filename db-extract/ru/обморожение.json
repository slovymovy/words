                "senses": [
                    {
                        "sense_id": "293f6eb4-1a3b-36d8-86e0-d6879f293d51",
                        "entry_id": "d22f9a0c-fd49-3e27-9c0a-60524c18c2bb",
                        "glosses": [
                            "действие по значению гл. обмораживать, обморозить; повреждающее воздействие сильного холода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade97380-e3b2-48df-ad1e-d512cd9ddd6d",
                                "sense_id": "293f6eb4-1a3b-36d8-86e0-d6879f293d51",
                                "text": "Спрашивают: не воевала ли я, не подвергалась ли обморожению во время войны?"
                            }
                        ]
                    },
                    {
                        "sense_id": "77d7db4e-2895-3491-98ef-c5753f2bccc5",
                        "entry_id": "d22f9a0c-fd49-3e27-9c0a-60524c18c2bb",
                        "glosses": [
                            "состояние по значению гл. обморозиться; повреждение в результате воздействия сильного холода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa57c2af-7a84-4b0b-b607-aeefee5647f2",
                                "sense_id": "77d7db4e-2895-3491-98ef-c5753f2bccc5",
                                "text": "Двое из них доставлены в госпиталь с обморожениями."
                            }
                        ]
                    }
