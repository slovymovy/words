                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eabe17bd-be52-4037-995b-4a197b538c45",
                                                "sense_id": "f593cc60-37f5-3192-b3c1-503ecda34f91",
                                                "text": "И мы намерены отстаивать их на международной арене, в Совете Безопасности ООН."
                                            },
                                            {
                                                "example_id": "91d1dc6b-cc97-4ea4-9808-540935430365",
                                                "sense_id": "f593cc60-37f5-3192-b3c1-503ecda34f91",
                                                "text": "― Эксперты ООН утверждают, что Россия сегодня среди мировых лидеров по скорости развития эпидемии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
