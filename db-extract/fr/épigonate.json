                        "glosses": [
                            "Pièce d'étoffe carrée que les abbés officiant portent au côté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad9b225-442a-4d5d-bd7c-551e8c0a5469",
                                "sense_id": "d0656ee5-e750-3a4d-893e-30d1965e9205",
                                "text": "Il revêt ensuite l’épigonate, pièce d’étoffe carrée, partant de la hanche droite et descendant au genou."
                            },
                            {
                                "example_id": "65a23e0b-e3b7-4ab7-abb4-e4a0417dcfa2",
                                "sense_id": "d0656ee5-e750-3a4d-893e-30d1965e9205",
                                "text": "Je viens de recevoir en cadeau un épigonate (vêtement de prêtre) et ne sais à quoi l’attribuer; serait-ce à l’incident de la visite, et pour faire pièce au gouverneur qui ne m'apprécie pas ?"
                            },
                            {
                                "example_id": "4e6ae29c-4a0b-4eb9-8ea4-6b130d2d4611",
                                "sense_id": "d0656ee5-e750-3a4d-893e-30d1965e9205",
                                "text": "Le père Cyprien, prêtre de l’extérieur le plus digne, revêtu de l’épigonate et de la mitre d’honneur, prêcha un sermon extrêmement instructif, qu’il lut sur un petit cahier ;"
                            }
                        ]
                    }
