                ],
                "senses": [
                    {
                        "sense_id": "c333c5f6-44fc-33ca-8e8a-7d50ec75d4b4",
                        "entry_id": "f503d836-67d6-3a64-b116-dedae85a5eee",
                        "glosses": [
                            "Kapelle, die dem Heiligen Laurentius geweiht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f1f80d-868b-485e-99bc-1a831f145c48",
                                "sense_id": "c333c5f6-44fc-33ca-8e8a-7d50ec75d4b4",
                                "text": "„Alljährlich ist die Laurentiuskapelle am 2. Wochenende im August Ziel einer feierlichen Prozession. Im Rahmen eines Gottesdienstes gedenkt man dem Schutzpatron der Reben und erbittet Gottes Segen für eine \"Gedeihliche Ernte und Verschonung vor Unwetter und Plag\".“"
                            },
                            {
                                "example_id": "1ab3be18-2663-4f11-b69b-8c8e6b08d7bb",
                                "sense_id": "c333c5f6-44fc-33ca-8e8a-7d50ec75d4b4",
                                "text": "„Die St. Laurentiuskapelle in Dahlenburg wurde 1248 als romanischer Saalbau mit gotischen Fenstern erbaut.“"
                            },
                            {
                                "example_id": "f0560c0e-0c14-484a-b409-5420209c5968",
                                "sense_id": "c333c5f6-44fc-33ca-8e8a-7d50ec75d4b4",
                                "text": "„Betritt der Besucher von Westen kommend die Stadt, so empfängt ihn vor dem Westtor hangseitig der Laurentiusfriedhof mit der historischen Laurentiuskapelle.“"
                            },
                            {
                                "example_id": "af18fbe3-5c04-490e-94c2-75eaab89fdcb",
                                "sense_id": "c333c5f6-44fc-33ca-8e8a-7d50ec75d4b4",
                                "text": "„1440 wurde die Laurentiuskapelle um ein Schiff nach Süden erweitert, dessen Gewölbe von achteckigen gotischen Säulen getragen wird.“"
                            },
                            {
                                "example_id": "67ab79b6-5682-457c-8e32-4f9abec1d9cc",
                                "sense_id": "c333c5f6-44fc-33ca-8e8a-7d50ec75d4b4",
                                "text": "„Am Sonntag den 8. September 2002 konnte der Abschluss der Renovierungsarbeiten an der Laurentiuskapelle gefeiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
