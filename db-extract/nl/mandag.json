                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a741154-ace2-393a-ad62-4ff6c8cd4846",
                        "entry_id": "78d3e26c-92fe-38e3-a3d3-f6f230e6f1ea",
                        "glosses": [
                            "hoeveelheid werk die één persoon op één werkdag kan verzetten, eenheid om de omvang van werkzaamheden in uit te drukken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5b040c-299f-4758-80ef-7c1b259f679e",
                                "sense_id": "6a741154-ace2-393a-ad62-4ff6c8cd4846",
                                "text": "De kosten per mandag zijn te hoog geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a73f07a2-9596-443e-8577-4de731c05c64",
                        "source_entry_id": "78d3e26c-92fe-38e3-a3d3-f6f230e6f1ea",
                        "source_sense_id": "6a741154-ace2-393a-ad62-4ff6c8cd4846",
                        "source_sense_description": "hoeveelheid werk die één persoon op één werkdag kan verzetten",
                        "target_lang_word": "Manntag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manntag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                        "entry_id": "9d5398a1-88cf-3261-bb8c-b22b6eff734c",
                                        "glosses": [
                                            "Maßeinheit für den Aufwand an Arbeitskraft (in Tagen), der zur Erledigung einer Aufgabe/eines Projektes nötig ist"
                                        ],
                                        "tags": [
                                            "oft im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37fd9a73-87da-4fd8-81ad-837cbba2bd34",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "„Die Software spart im Einsatz monatlich mehrere Manntage an Arbeitszeit ein.“"
                                            },
                                            {
                                                "example_id": "7605253e-6ba6-4e4a-b89e-096a507d8f67",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "Dauert die Angebotserstellung länger als einen Manntag, dann stellen wir die Kosten dafür dem Auftraggeber des Angebots in Rechnung."
                                            },
                                            {
                                                "example_id": "c9587927-52ed-4497-90e6-a633138578e5",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "Wir rechnen, dass die Erstellung des Benchmarks 60 Manntage kosten wird."
                                            },
                                            {
                                                "example_id": "86cb6c1d-5fa1-4ebe-b8bd-00a25fe67bd1",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "60 Manntage x 1.500,-- EUR/Tag ergibt Kosten von 90.000,-- EUR."
                                            },
                                            {
                                                "example_id": "f77aa298-eb11-4856-b477-ba8d639897f1",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "„»In den sechs Wochen davor haben wir über 1.000 Manntage investiert«, berichtete CTO Günter Ottendorfer heise online.“"
                                            },
                                            {
                                                "example_id": "9563c897-334d-4d0c-9656-3c708923c4fb",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "„An der optimalen Lösung dieses linearen Programms mit neun Ungleichungen und 77 Variablen waren damals neun Personen beschäftigt, die zusammen etwa 120 Manntage Rechenarbeit benötigten.“"
                                            },
                                            {
                                                "example_id": "938f1886-8803-4d41-8642-762896cce7c2",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "[…] Können die Controller Berichte »auf Knopfdruck« erstellen, brauchen sie dafür erstaunlicherweise nur geringfügig weniger Input (6,0 Manntage), als wenn sie das manuell tun (6,2 Manntage)."
                                            },
                                            {
                                                "example_id": "db1495b3-93ac-4353-af95-22bf282fd371",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "[…] Ein Bericht mit 50 Seiten Länge erfordert im Durchschnitt ca. 11,5 Manntage zu seiner Erstellung, ein »Kurzbericht« (1 bis 5 Seiten Länge) noch nicht einmal 3 Manntage."
                                            },
                                            {
                                                "example_id": "6a53723d-ea1a-49fc-8fbc-669e33bc3d94",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "„Zusätzlich zu dem in den Tabellen genannten Aufwand (Manntage x Tagessatz) werden in der Regel noch Gebühren erhoben.“"
                                            },
                                            {
                                                "example_id": "9f89f4a3-9112-4c74-b063-79f5bb9c1a26",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "Unternehmensberater mit ihrem Tageshonorar von 1.500 und 3.000 DM pro „Manntag“ sind „eine Nummer zu groß“."
                                            },
                                            {
                                                "example_id": "6d3a1b37-2ae8-4d71-94d8-63cbac93abd9",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "„Das Auftragsvolumen könne zwischen 1000 Euro und einer fünfstelligen Summe liegen. Wenn es ums Geld geht, werden die geschäftstüchtigen Studenten einsilbiger. Was genau ein \"Manntag\" kostet, richte sich nach der Aufgabe, dem Auftraggeber und der Erfahrung der Studierenden im Projekt.“"
                                            },
                                            {
                                                "example_id": "b66fc03c-fea7-4c8f-9534-a4ce837ef6b7",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "[Hochwasser in Mitteleuropa 2002:] „Soldaten der Bundeswehr leisteten insgesamt 270 000 Manntage Einsatz, weitere 190 000 Manntage Bereitschaft.“"
                                            },
                                            {
                                                "example_id": "9926eba6-07c8-46cd-83e3-b77cf03466ca",
                                                "sense_id": "eecaa63a-94d4-3f28-93bf-3d10c5f55eab",
                                                "text": "„Er will nicht wissen, wie viel er fürs Wissen schon an Zeit aufgewendet hat. Diego Hättenschwiler ist seit 2004 «Wikipedianer». Er hat freiwillig und unbezahlt unzählige Stunden, Manntage, Mannjahre investiert, um neue Artikel zu schreiben und sie mit Bildern in die deutschsprachige Wikipedia einzufügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfe498cd-4610-41f6-8213-c41263638bd4",
                        "source_entry_id": "78d3e26c-92fe-38e3-a3d3-f6f230e6f1ea",
                        "source_sense_id": "6a741154-ace2-393a-ad62-4ff6c8cd4846",
                        "source_sense_description": "hoeveelheid werk die één persoon op één werkdag kan verzetten",
                        "target_lang_word": "Personentag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Personentag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "545485ba-e720-3ce4-817c-5595edf8de44",
                                        "entry_id": "6e502e9c-4d97-3251-9f55-2e4ff205ca1a",
                                        "glosses": [
                                            "Maßeinheit für den Zeitaufwand von einem Arbeitstag (in der Regel acht Arbeitsstunden), die eine Person für die Erledigung einer bestimmten Aufgabe benötigt"
                                        ],
                                        "tags": [
                                            "Projektmanagement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec645f1-19fe-4b9a-9f80-52e138e247be",
                                                "sense_id": "545485ba-e720-3ce4-817c-5595edf8de44",
                                                "text": "„Die Personentage — oftmals als PT abgekürzt zu finden — geben an, wie viele Arbeitsstunden eine einzelne Arbeitskraft für die Ausführung einer bestimmten Leistung benötigt.“"
                                            },
                                            {
                                                "example_id": "8dc55629-ed32-48b9-a0b0-d07330fc238b",
                                                "sense_id": "545485ba-e720-3ce4-817c-5595edf8de44",
                                                "text": "„Werden für eine Arbeitsleistung im Rahmen eines Beratungsprojekts in Summe 130 Personentage veranschlagt, so kann man eine einzige Person etwa ein halbes Jahr beschäftigen oder 130 Personen einen einzigen Tag lang.“"
                                            },
                                            {
                                                "example_id": "2422d812-3be8-4ed4-8ed9-a935b2ad3594",
                                                "sense_id": "545485ba-e720-3ce4-817c-5595edf8de44",
                                                "text": "„Der ehemals gängige Begriff Manntag“ für den heute üblichen Begriff Personentag „ist aufgrund von Forderungen an die sprachliche Geschlechtergleichstellung kaum noch vorzufinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
