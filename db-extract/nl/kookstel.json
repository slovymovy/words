                        "glosses": [
                            "klein toestel waarop men kan koken en braden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573d3f36-976f-44c0-983e-54e77541dec8",
                                "sense_id": "12e84cb3-2400-3920-98df-b7202d8e705d",
                                "text": "Ook is propaan gevonden, wat op onze planeet veel wordt gebruikt in draagbare kookstellen. Titan is de grootste maan van Saturnus en bevat voornamelijk koolwaterstoffen, met name methaan. Dat is na stikstof de meest voorkomende component van de atmosfeer."
                            },
                            {
                                "example_id": "ff41f272-46c0-48d1-b56f-3d219ae0d107",
                                "sense_id": "12e84cb3-2400-3920-98df-b7202d8e705d",
                                "text": "Drie bezoekers van het Solarfestival in Roermond zijn zaterdagochtend gewond geraakt toen lekkend gas ontvlamde. Dat gebeurde bij het verwisselen van gasflessen van een kookstel op de camping bij het festivalterrein. Dat maakte de brandweer bekend."
                            }
                        ]
                    }
