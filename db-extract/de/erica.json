                "translations": [
                    {
                        "translation_id": "a9ce45ae-f767-4c57-bb36-208420f771a4",
                        "source_entry_id": "42b69b91-dc3e-34b0-b6c8-b8e15b2e7bc5",
                        "source_sense_id": "e191b89c-83be-3b55-834e-2b3362975aea",
                        "source_sense_description": "wissenschaftlicher Name der Gattung der Glockenheiden oder Heidekräuter",
                        "target_lang_word": "Glockenheide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "701bf740-8180-4506-8d05-194f0bd87390",
                        "source_entry_id": "42b69b91-dc3e-34b0-b6c8-b8e15b2e7bc5",
                        "source_sense_id": "e191b89c-83be-3b55-834e-2b3362975aea",
                        "source_sense_description": "wissenschaftlicher Name der Gattung der Glockenheiden oder Heidekräuter",
                        "target_lang_word": "Heidekraut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heidekraut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                        "entry_id": "febb9369-dfb5-3da8-aac0-e22b4805d632",
                                        "glosses": [
                                            "auf sandigen oder moorigen Böden gedeihende Pflanze, die in Zwergsträuchern wächst und nadelartige, immergrüne Blättchen sowie besonders kleine, zumeist rot-lila Blüten aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6b6b4b-4fc9-4bb7-ad76-559f9c1bec9f",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Je nach Jahreszeit wachsen lila Heidekraut, rosa Alpenveilchen, weiße Meerzwiebeln oder gelber Fenchel.“"
                                            },
                                            {
                                                "example_id": "1f2d4a5c-978f-47dd-beb0-22793c28337a",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„In den einsamen Highlands mit Heidekraut und Kiefern hat der 48-jährige Modemilliardär inzwischen so viele Ländereien zusammengekauft, dass er sich größter privater Grundeigentümer des Vereinigten Königreichs nennen kann.“"
                                            },
                                            {
                                                "example_id": "35c62d22-5c5c-4768-a834-5f94d5dbc612",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Wir hielten die Füße ins Heidekraut, die Holzbretter waren warm, die Kiefern dufteten, und der feuchte Waldboden dampfte.“"
                                            },
                                            {
                                                "example_id": "59c0993c-32e5-42d5-847e-1213372c237d",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Die Ackerflächen werden weniger, Föhren und Heidekraut verraten die Kargheit des Bodens, Schafe und Rinder, zierliche Hängebrücken überspannen den Gebirgsfluss.“"
                                            },
                                            {
                                                "example_id": "e5e44490-cfa0-42dd-9155-3ce734819447",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Das Heidekraut ist wohl die beliebteste Dekopflanze für den winterlichen Blumenkasten, wo sie ein trauriges Dasein fristet, ehe sie den Primeln weicht.“"
                                            },
                                            {
                                                "example_id": "ab91d37a-f528-47b9-8a0d-597887b9b2b5",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Eine frühherbstliche Sonne leuchtet mild, und in der Ferne ist violett blühendes Heidekraut zu sehen.“"
                                            },
                                            {
                                                "example_id": "d9883602-f381-4160-9eb8-ee09ab33f9a5",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Tausende Spezies aus aller Welt wurden hier angesiedelt: Azaleen und Orchideen aus dem Himalaja, Heidekraut aus Schottland, prächtige Farne aus den heimischen Wäldern.“"
                                            },
                                            {
                                                "example_id": "e91f8855-45e0-437b-9cd9-a7ba599c9c72",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Als Heide oder Heidekräuter werden verschiedene Pflanzen bezeichnet, die eine typische Heidelandschaft bewachsen.“"
                                            },
                                            {
                                                "example_id": "cd44aeec-a2c3-49e7-bd6a-757c405cfe1b",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Rot, rosa, gelb und weiß blühen dort mehr als sechshundert Heidekräuter der Gattung Erica, der Rest der Welt muss mit gerade einmal 26 Arten dieser Gattung vorliebnehmen.“"
                                            },
                                            {
                                                "example_id": "39e46395-ff38-44e4-bd31-07292dd26853",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Damit die Heidekräuter auch nach Jahren noch ausreichend neue Triebe bilden, sollte der Hobbygärtner sie regelmäßig schneiden.“"
                                            },
                                            {
                                                "example_id": "00673088-42fb-44cf-a061-d1f89960187a",
                                                "sense_id": "a0af4a8c-4386-309f-ab0a-c3c0be1af1ce",
                                                "text": "„Während die sonnigeren Südhänge noch grün glänzen, erstrahlen die Beerensträucher und Heidekräuter der Nordseiten in tiefem Rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
