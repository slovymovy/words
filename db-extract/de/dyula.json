                                        "examples": [
                                            {
                                                "example_id": "872bb18c-07fd-47d0-a93f-fbfede3d38dd",
                                                "sense_id": "abb45292-bd33-337b-a384-6a2708ecbd54",
                                                "text": "Il désigna d’un mouvement de tête la cabine d’en face et je levai la main pour saluer les deux interprètes embauchés pour l’occasion, qui levèrent la main en retour ; ces collègues traduiraient en français le témoin qui parlait dioula, et nous les traduirions en anglais."
                                            },
                                            {
                                                "example_id": "82f5c9de-c6ac-40db-89a7-ea1880ca6bc6",
                                                "sense_id": "abb45292-bd33-337b-a384-6a2708ecbd54",
                                                "text": "En plus, elle invite un Ivoirien qui chante en dioula et le grand chantre Vusi Mahlasela qui ajoute aux couleurs linguistiques."
                                            }
                                        ]
                                    },
