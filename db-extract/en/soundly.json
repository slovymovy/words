                        "examples": [
                            {
                                "example_id": "a4708eca-a884-4a95-ae99-0b998343a19a",
                                "sense_id": "80fcee12-9c6d-3da3-bbcf-6ece6ca08f49",
                                "text": "He was soundly thrashed by the semi-professional boxer.",
                                "translation": "他被半职业拳击手狠狠地揍了一顿。"
                            },
                            {
                                "example_id": "5f58c3eb-752e-4079-8c6c-5c0dc7b5917d",
                                "sense_id": "80fcee12-9c6d-3da3-bbcf-6ece6ca08f49",
                                "text": "I slept quite soundly last night.",
                                "translation": "我昨天晚上睡得很踏实。"
                            },
                            {
                                "example_id": "6a7da76c-349a-4ac7-b926-ab1ad8c48b4d",
                                "sense_id": "80fcee12-9c6d-3da3-bbcf-6ece6ca08f49",
                                "text": "Pro. Let them be hunted ſoundly : At this houre / Lies at my mercy all mine enemies :[…]"
                            },
                            {
                                "example_id": "7e648e27-38c7-4bea-9e07-02fd191bf79d",
                                "sense_id": "80fcee12-9c6d-3da3-bbcf-6ece6ca08f49",
                                "text": "The wedding company, fatigued with their enjoyment of the previous night, slept soundly late into the next morning."
                            }
                        ]
                    }
                ],
