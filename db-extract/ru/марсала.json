                    {
                        "translation_id": "9e892e8b-79c1-4113-b636-35204adf632f",
                        "source_entry_id": "ff48bab2-c818-3ad8-91c1-b49c0ee459c7",
                        "target_lang_word": "Marsala",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marsala",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                        "entry_id": "df7cdadd-fc8b-3c72-93e9-125c86bf2e20",
                                        "glosses": [
                                            "goldgelber, sizilianischer Süßwein, der nur aus den Traubensorten Grillo, Cattaratto und Inozolia hergestellt werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831319bf-acb9-4cc0-aa7e-1b520edbd7c4",
                                                "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                                "text": "Den Marsala haben englische Kaufleute in der zweiten Hälfte des 18. Jahrhunderts erfunden, die einen preiswerten Ersatz für in England beliebte spanische und portugiesische Weine suchten."
                                            },
                                            {
                                                "example_id": "c57cb049-0fab-4399-86d5-10a9b1c7259b",
                                                "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                                "text": "Der Marsala erinnert leicht an den Sherry."
                                            },
                                            {
                                                "example_id": "762adcb2-be38-43f4-8968-aace3555bda9",
                                                "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                                "text": "„Ebenso wie Sherry ist Marsala im Naturzustand […] ein trockener Wein, der seinen Alkoholgehalt durch Zusatz hochprozentigen Traubenbranntweines und die jeweils gewünschte Süße durch Verbesserung mit einem sehr süßen Traubenkonzentrat erhält, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29861ae1-6d39-401d-b1ff-8ac70aced4ff",
                        "source_entry_id": "ff48bab2-c818-3ad8-91c1-b49c0ee459c7",
                        "target_lang_word": "Marsala",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marsala",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87c8410a-4c70-385f-9e53-cb85356832d2",
                                        "entry_id": "50a46881-1275-3017-b9a3-165d317648c1",
                                        "glosses": [
                                            "Commune et ville du libre consortium municipal de Trapani dans la région de Sicile en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3ceb32-27da-4f71-a801-039d8fecd152",
                                                "sense_id": "87c8410a-4c70-385f-9e53-cb85356832d2",
                                                "text": "Mon père me tenait la main, et me montra l’Etna tout fumant et des rochers que je n’oubliai point : c’était la Favaniane et le mont Éryx. Marsala, l’ancien Lilybée, passait à travers ses vapeurs."
                                            },
                                            {
                                                "example_id": "1e71e45c-bbec-4b51-9bb1-38f39ebd11a5",
                                                "sense_id": "87c8410a-4c70-385f-9e53-cb85356832d2",
                                                "text": "Ce n’était pas une balle bourbonnienne qui l’avait tué, mais une prostituée du port de Marsala à l’hygiène douteuse..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
