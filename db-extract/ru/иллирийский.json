                                        "entry_id": "2c4322cb-e2e3-3ce4-b02b-f218e60dca97",
                                        "glosses": [
                                            "An extinct Indo-European language or group of languages spoken in modern Southeast Europe, in the western half of the Balkan Peninsula."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
