                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a banana <w>split</w> to share after our meal.",
                            "target_lang_translations": {
