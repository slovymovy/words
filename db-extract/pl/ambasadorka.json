                    },
                    {
                        "sense_id": "7323ce41-2d7e-374b-a469-2342696d749b",
                        "entry_id": "e0c799c2-f64d-3d69-96ec-ca585614c8af",
                        "glosses": [
                            "rzeczniczka, obrończyni danej sprawy, interesu"
                        ],
