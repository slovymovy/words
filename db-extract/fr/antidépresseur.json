        "fr-extract.jsonl": [
            {
                "entry_id": "39586d5f-fd3d-377f-846c-2362be0e72bd",
                "word": "antidépresseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c9466e2f-2f25-4a80-8fc5-e9e075a15f08",
                        "entry_id": "39586d5f-fd3d-377f-846c-2362be0e72bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "antidépresseurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                        "entry_id": "39586d5f-fd3d-377f-846c-2362be0e72bd",
                        "glosses": [
                            "Médicament contre la dépression et les troubles anxieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4ff314-f707-47a2-9ffc-b14ec824b081",
                                "sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                                "text": "Les antidépresseurs modernes provoquent de la dépendance dans une proportion de 50% à 80% selon les molécules. L’arrêt brutal provoque des symptômes de sevrage qui peuvent être très sévères. Afin d’atténuer ces symptômes il est conseillé d’en effectuer un sevrage très lent."
                            },
                            {
                                "example_id": "b7ac4bd1-e471-481b-9eae-38bf03cb2aab",
                                "sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                                "text": "« Les antidépresseurs de nouvelle génération ne fonctionnent pas mieux qu’un placebo (produit inactif donné à l’insu du patient) pour la majorité des patients souffrant d’une dépression légère ou modérée … Il semble y avoir très peu de raisons de prescrire des antidépresseurs à quiconque sauf aux personnes les plus sévèrement déprimées »."
                            },
                            {
                                "example_id": "7bfc6b14-f080-457e-ba30-b97bf9a17ffa",
                                "sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                                "text": "Le médecin m’examina et s’alarma de ma faiblesse, il me prescrivit des médicaments pour une forme sérieuse d’arthrose, des antidépresseurs, des anxiolytiques, des vitamines."
                            },
                            {
                                "example_id": "8514220f-3faf-48cf-87e0-7197809f94c0",
                                "sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                                "text": "La conclusion qui se dégageait peu à peu, c’est que l’art médical demeurait en ces matières confus et approximatif, et que les antidépresseurs faisaient partie de ces nombreux médicaments qui fonctionnent (ou pas) sans que l’on sache exactement pourquoi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a42403bc-5b89-45dd-a599-43e4d0b778fa",
                        "source_entry_id": "39586d5f-fd3d-377f-846c-2362be0e72bd",
                        "source_sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                        "target_lang_word": "Antidepressivum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antidepressivum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                        "entry_id": "dae27eab-2fe8-31f7-babf-e613c1e5c12c",
                                        "glosses": [
                                            "Medikament gegen Depressionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8f2de9-b9a6-40e7-a35b-df97722696c0",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "Ein depressiver Patient muss sein Antidepressivum auch dann einnehmen, wenn es ihm besser geht."
                                            },
                                            {
                                                "example_id": "a7100348-b444-4dcc-a921-bc5c09ff6d48",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "„Die Deutschen schlucken denn auch doppelt so viele Antidepressiva wie noch vor zehn Jahren.“"
                                            },
                                            {
                                                "example_id": "348869a8-bff2-437e-a5fa-ce3f3684c8d3",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "„Frauen bauen viele Antidepressiva langsamer ab, weil das aber bei der Dosierung nicht genug beachtet wird, leiden sie häufiger an Nebenwirkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aeb0b8a4-a444-496c-9eb7-3386aa92889d",
                        "source_entry_id": "39586d5f-fd3d-377f-846c-2362be0e72bd",
                        "source_sense_id": "2a48482d-a867-382f-bcd5-7dead411143d",
                        "target_lang_word": "antidepressant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidepressant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                        "entry_id": "9cd047d5-d0fd-38f4-808b-3871dd432e08",
                                        "glosses": [
                                            "An agent that prevents or counteracts depression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cffa35b5-61bc-4449-be4b-428f381c8962",
                                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                                "text": "Some women with postpartum depression and thyroid imbalance may require antidepressants and psychiatric therapy."
                                            },
                                            {
                                                "example_id": "c1500701-868b-4239-bcd7-cd0166b0ece0",
                                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                                "text": "She had a history of depression and was taking phenelzine, an antidepressant."
                                            },
                                            {
                                                "example_id": "d5697c9e-cf7f-451d-82a3-8ec3e398d6ea",
                                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                                "text": "Dr. Melanie met with Annabelle and delivered her diagnosis: Benny was in the prodromal phase of schizoaffective disorder, and she was recommending that they stop the Ritalin and start him on an antidepressant for the mood disorder and an antipsychotic to treat the auditory hallucinations."
                                            }
                                        ]
                                    }
                                ]
