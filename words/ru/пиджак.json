                    "sense_id": "4fc738c3-ef1e-30d9-89ad-ae36d546102e",
                    "sense_definition": "Верхняя часть мужского костюма с рукавами, открытым отложным воротником и застёгивающимися полами.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В офисе принято носить строгий костюм и <w>пиджак</w>.",
                            "target_lang_translations": {
                                "en": "It is customary to wear a formal suit and <w>jacket</w> in the office.",
                                "nl": "Op kantoor is het gebruikelijk om een formeel pak en een <w>colbert</w> te dragen.",
                                "pl": "W biurze przyjęło się nosić elegancki garnitur i <w>marynarkę</w>.",
                                "de": "Im Büro ist es üblich, einen formellen Anzug und ein <w>Sakko</w> zu tragen.",
                                "fr": "Au bureau, il est d'usage de porter un costume strict et une <w>veste</w>.",
                                "it": "In ufficio è consuetudine indossare un abito formale e una <w>giacca</w>.",
                                "cs": "V kanceláři je zvykem nosit formální oblek a <w>sako</w>.",
                                "tr": "Ofiste resmi bir takım elbise ve <w>ceket</w> giymek adettendir.",
                                "es": "En la oficina se acostumbra a llevar un traje formal y <w>chaqueta</w>."
                            }
                        },
                        {
                            "text": "Он снял <w>пиджак</w> и повесил его на спинку стула.",
                            "target_lang_translations": {
                                "en": "He took off his <w>jacket</w> and hung it on the back of the chair.",
                                "nl": "Hij deed zijn <w>jasje</w> uit en hing het over de rugleuning van de stoel.",
                                "pl": "Zdjął <w>marynarkę</w> i powiesił ją na oparciu krzesła.",
                                "de": "Er zog sein <w>Jackett</w> aus und hängte es über die Stuhllehne.",
                                "fr": "Il a enlevé son <w>veston</w> et l'a accroché au dossier de la chaise.",
                                "it": "Si è tolto la <w>giacca</w> e l'ha appesa allo schienale della sedia.",
                                "cs": "Sundal si <w>sako</w> a pověsil ho na opěradlo židle.",
                                "tr": "<w>Ceketini</w> çıkardı ve sandalyenin arkalığına astı.",
                                "es": "Se quitó la <w>chaqueta</w> y la colgó en el respaldo de la silla."
                            }
                        }
                    ],
                    "common_phrases": [
                        "надеть пиджак",
