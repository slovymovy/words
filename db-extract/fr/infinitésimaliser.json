                "senses": [
                    {
                        "sense_id": "faa762e1-a0d9-3243-b377-59e0ccab295c",
                        "entry_id": "5cb368cf-ac9e-305a-9eef-7931ecdff181",
                        "glosses": [
                            "Donner un caractère infinitésimal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7207ce80-b204-450b-b483-b78e82e77c0a",
                                "sense_id": "faa762e1-a0d9-3243-b377-59e0ccab295c",
                                "text": "Mais il est ravi du fait que les sciences tendent à infinitésimaliser la nature, à la « trouer » de l'intérieur."
                            },
                            {
                                "example_id": "c20e6a4b-4c81-43ff-9cf4-c36e32ba5b4b",
                                "sense_id": "faa762e1-a0d9-3243-b377-59e0ccab295c",
                                "text": "Infinitésimaliser les axiomes."
                            },
                            {
                                "example_id": "76d4a247-fc6e-47c2-b858-a0d8b89a95d9",
                                "sense_id": "faa762e1-a0d9-3243-b377-59e0ccab295c",
                                "text": "Ce sont les mille et une manières d'approche et d'accès au réel qui font le langage cinématographique se démultiplier, s'infinitésimaliser pour mieux s'étendre qui fait la grâce de la projection."
                            }
                        ]
                    }
