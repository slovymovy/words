                        "sense_id": "cbed2298-66f6-3172-a927-880dc2aa393f",
                        "entry_id": "81fafaae-c9e7-3f15-897c-e00f22170fcf",
                        "glosses": [
                            "Sorte de grand manteau imperméable qui sert à protéger de la pluie et du froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946739de-e0cd-4c02-9b6d-49cd143f56ea",
                                "sense_id": "cbed2298-66f6-3172-a927-880dc2aa393f",
                                "text": "Bob se leva, saisit son trench-coat, le jeta sur ses épaules et nous souhaita le bonsoir."
                            },
                            {
                                "example_id": "e6600cf2-1199-4992-b678-5485da25c60a",
                                "sense_id": "cbed2298-66f6-3172-a927-880dc2aa393f",
                                "text": "L’homme qui sortait de la villa portait un mauvais « trench-coat » à ceinture, dont il avait relevé le col usé."
                            },
                            {
                                "example_id": "ad5eee2b-beda-45f8-be46-e7efce9269cd",
                                "sense_id": "cbed2298-66f6-3172-a927-880dc2aa393f",
                                "text": "L'inspecteur SInet s'avança vers le feu, les mains enfouies dans les poches de son trench-coat vert bouteille, son chapeau baissé sur les yeux."
                            },
                            {
                                "example_id": "fe414d1d-3929-405b-9304-519752e40b44",
                                "sense_id": "cbed2298-66f6-3172-a927-880dc2aa393f",
                                "text": "Sous les averses, le trench-coat se dévoile."
                            }
                        ]
                    }
