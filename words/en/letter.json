{
    "word_family": [
        "lettering",
        "letterhead",
        "letterbox",
        "letterman",
        "letterpress",
        "unlettered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ee8bc91-b39f-3c12-b495-e48b07d2ba52",
                    "sense_definition": "A symbol in an alphabet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "writing_symbols",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are twenty-six <w>letters</w> in the English alphabet.",
                            "target_lang_translations": {
                                "ru": "В английском алфавите двадцать шесть <w>букв</w>."
                            }
                        },
                        {
                            "text": "Please write your name in capital <w>letters</w> on the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, впишите свое имя в форму заглавными <w>буквами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bookstaff",
                        "bookstave"
                    ],
                    "common_phrases": [
                        "capital letter",
                        "block letters",
                        "lowercase letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ в алфавите."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буква",
                                "target_lang_sense_clarification": "графический знак алфавита"
                            },
                            {
                                "target_lang_word": "литера",
                                "target_lang_sense_clarification": "устаревший или типографский термин для буквы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                    "sense_definition": "A written or printed communication, generally longer and more formal than a note.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wrote a <w>letter</w> to my sister about my life.",
                            "target_lang_translations": {
                                "ru": "Я написал сестре <w>письмо</w> о своей жизни."
                            }
                        },
                        {
                            "text": "He read the <w>letter</w> aloud to the rest of the family.",
                            "target_lang_translations": {
                                "ru": "Он прочитал <w>письмо</w> вслух всей семье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "write a letter",
                        "send a letter",
                        "formal letter",
                        "love letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменное или печатное сообщение, обычно более длинное и официальное, чем записка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "письмо",
                                "target_lang_sense_clarification": "текстовое послание"
                            },
                            {
                                "target_lang_word": "послание",
                                "target_lang_sense_clarification": "более формальное или литературное обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c9e323-8ebc-30de-86ee-ea1f057d8e51",
                    "sense_definition": "The literal meaning of something, as distinguished from its intended and remoter meaning (the spirit).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people follow the <w>letter</w> of the law but ignore its true purpose.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди следуют <w>букве</w> закона, но игнорируют его истинную цель."
                            }
                        },
                        {
                            "text": "I broke the <w>letter</w> of the rule to keep the sense of the agreement.",
                            "target_lang_translations": {
                                "ru": "Я нарушил <w>букву</w> правила, чтобы сохранить смысл соглашения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "letter of the law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Буквальный смысл чего-либо, в отличие от его духа или намерения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буква",
                                "target_lang_sense_clarification": "в контексте «буква закона»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a39b3ed5-2303-3dda-bc76-2a1e424a3b2a",
                    "sense_definition": "A standard size of paper, typically 8½ in × 11 in.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "paper_sizes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the printer is set to <w>letter</w> size before you start.",
                            "target_lang_translations": {
                                "ru": "Перед началом убедитесь, что принтер настроен на размер <w>letter</w>."
                            }
                        },
                        {
                            "text": "The document was printed on standard <w>letter</w> paper.",
                            "target_lang_translations": {
                                "ru": "Документ был напечатан на стандартной бумаге формата <w>letter</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "letter size",
                        "letter paper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартный размер бумаги, обычно 8½ на 11 дюймов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "леттер",
                                "target_lang_sense_clarification": "формат бумаги Letter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f72aac0e-3f8a-37d9-b723-e05f2c153286",
                    "sense_definition": "Literature or the profession of writing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Benjamin Franklin was multiskilled – a scientist, politician and a man of <w>letters</w>.",
                            "target_lang_translations": {
                                "ru": "Бенджамин Франклин был разносторонним человеком — ученым, политиком и человеком <w>слова</w>."
                            }
                        },
                        {
                            "text": "She dedicated her life to the pursuit of <w>letters</w> and philosophy.",
                            "target_lang_translations": {
                                "ru": "Она посвятила свою жизнь занятиям <w>словесностью</w> и философией."
                            }
                        }
                    ],
                    "common_phrases": [
                        "man of letters"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Литература или профессия писателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словесность",
                                "target_lang_sense_clarification": "литература и искусство слова"
                            },
                            {
                                "target_lang_word": "литература",
                                "target_lang_sense_clarification": "сфера письменного творчества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "823435cd-4101-34a6-9889-afd4be12e0ad",
                    "sense_definition": "A division unit of a piece of law or a document marked by a letter of the alphabet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Letter</w> (b) constitutes an exception to this provision in the contract.",
                            "target_lang_translations": {
                                "ru": "<w>Пункт</w> (b) является исключением из этого положения в контракте."
                            }
                        },
                        {
                            "text": "Please refer to paragraph four <w>letter</w> c for the specific details.",
                            "target_lang_translations": {
                                "ru": "Для получения подробной информации обратитесь к четвертому абзацу, <w>пункту</w> c."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подпункт закона или документа, обозначенный буквой алфавита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пункт",
                                "target_lang_sense_clarification": "обозначенный буквой"
                            },
                            {
                                "target_lang_word": "литера",
                                "target_lang_sense_clarification": "буквенное обозначение в документе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d4b52bb-ac64-3e0f-af92-86dced343346",
                    "sense_definition": "A style of type or a single piece of type used in printing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer used a famous <w>letter</w> that was highly esteemed by collectors.",
                            "target_lang_translations": {
                                "ru": "Печатник использовал знаменитую <w>литеру</w>, которая высоко ценилась коллекционерами."
                            }
                        },
                        {
                            "text": "The old printing press still had several sets of lead <w>letter</w>.",
                            "target_lang_translations": {
                                "ru": "В старом печатном станке все еще оставалось несколько наборов свинцовых <w>литер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to physical type"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Типографский шрифт или отдельная металлическая форма для печати."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "литера",
                                "target_lang_sense_clarification": "типографский брусок с изображением буквы"
                            },
                            {
                                "target_lang_word": "шрифт",
                                "target_lang_sense_clarification": "стиль печати"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88d8f8ef-a703-34af-a15f-54ddfc90a129",
                    "sense_definition": "One who lets, or rents out property or services.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>letter</w> of the room was responsible for maintaining the common areas.",
                            "target_lang_translations": {
                                "ru": "<w>Арендодатель</w> комнаты отвечал за содержание мест общего пользования."
                            }
                        },
                        {
                            "text": "As a frequent <w>letter</w> of equipment, he knew the contract well.",
                            "target_lang_translations": {
                                "ru": "Как человек, часто <w>сдающий</w> оборудование в аренду, он хорошо знал условия контракта."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто сдает в аренду имущество или услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арендодатель",
                                "target_lang_sense_clarification": "лицо, сдающее имущество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33e459e5-1749-3af8-9593-ea42e70284ee",
                    "sense_definition": "To print, inscribe, or paint letters on something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist will <w>letter</w> the sign by hand using gold paint.",
                            "target_lang_translations": {
                                "ru": "Художник вручную <w>выведет буквы</w> на вывеске золотой краской."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>lettering</w> the covers of the new journals.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел, <w>подписывая</w> обложки новых журналов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Печатать, вписывать или рисовать буквы на чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить буквы",
                                "target_lang_sense_clarification": "аккуратно писать или рисовать"
                            },
                            {
                                "target_lang_word": "подписывать",
                                "target_lang_sense_clarification": "наносить надписи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c12186b7-62a5-3f46-9fff-b29080d59801",
                    "sense_definition": "To earn a varsity letter as an award in school sports.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think Mom <w>lettered</w> in shot put her junior year of high school.",
                            "target_lang_translations": {
                                "ru": "Я думаю, мама <w>получила спортивную нашивку</w> за толкание ядра в предпоследнем классе школы."
                            }
                        },
                        {
                            "text": "He hoped to <w>letter</w> in football before he graduated.",
                            "target_lang_translations": {
                                "ru": "Он надеялся <w>получить спортивную награду</w> по футболу до окончания школы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "letter in"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить спортивную нашивку (букву) в качестве награды в школьном спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получить спортивную нашивку",
                                "target_lang_sense_clarification": "за достижения в школьном спорте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}