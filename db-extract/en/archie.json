                ],
                "senses": [
                    {
                        "sense_id": "a2e4336b-4c2a-33d4-9df2-d106ee20d2a6",
                        "entry_id": "9e59e2f2-c5f5-3f6f-ae6f-ed47314e8df2",
                        "glosses": [
                            "An Acorn Archimedes computer."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c41e410a-937b-4034-ba37-549dc2f0f764",
                                "sense_id": "a2e4336b-4c2a-33d4-9df2-d106ee20d2a6",
                                "text": "FOR ARCHIE USERS. At last, a powerful database with details of every track (over 700 to date) on Classic CD discs from issue 1 to the present day is available for uses of Acorn (Archimedes) computers."
                            },
                            {
                                "example_id": "58d9caca-cc55-4823-b25b-2c6f59e4acc3",
                                "sense_id": "a2e4336b-4c2a-33d4-9df2-d106ee20d2a6",
                                "text": "And what about getting the data from the Archie to the PC?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8a4a11ef-f09d-3c01-91f2-4b4aeb7c8578",
                "word": "archie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6f7ed0b7-850d-4846-af73-427e1fb24dff",
                        "entry_id": "8a4a11ef-f09d-3c01-91f2-4b4aeb7c8578",
                        "tags": [
                            "plural"
                        ],
                        "form": "archies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b84a946-a6e0-3d43-b966-f5258866fab2",
                        "entry_id": "8a4a11ef-f09d-3c01-91f2-4b4aeb7c8578",
                        "glosses": [
                            "Alternative form of Archie (“anti-aircraft artillery”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c787f6ad-75d7-4401-8482-f1adbd1cf8bb",
                                "sense_id": "5b84a946-a6e0-3d43-b966-f5258866fab2",
                                "text": "I had to take a large turn, for the \"archies\" were shooting pretty close."
                            },
                            {
                                "example_id": "10b44bec-41c5-4c58-8f0d-c6006e6f5c82",
                                "sense_id": "5b84a946-a6e0-3d43-b966-f5258866fab2",
                                "text": "I'll pretend I'm scared of everything and sideslip away from every archie burst."
                            },
                            {
                                "example_id": "05af81cf-e400-47aa-9698-18b032ad6b23",
                                "sense_id": "5b84a946-a6e0-3d43-b966-f5258866fab2",
                                "text": "Several of our planes droned overhead, undeterred by the German 'archies', machine-gun and rifle fire, but not as yet the contact monoplane."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
