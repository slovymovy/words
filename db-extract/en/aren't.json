                                            {
                                                "example_id": "7f08521b-fb26-4c13-b20b-cff019a9bd8f",
                                                "sense_id": "d2ba6f7f-f663-3733-9c0d-54e94cda08ed",
                                                "text": "„Das Lachen wurde immer geller.“"
                                            },
                                            {
                                                "example_id": "4836b643-d8e9-4670-bd71-f6f6180a17a0",
                                                "sense_id": "d2ba6f7f-f663-3733-9c0d-54e94cda08ed",
                                                "text": "Ein geller Schrei tönt durch den Raum."
                                            },
                                            {
                                                "example_id": "dff3ec32-5d92-44b2-a59a-d62f03d8eb81",
                                                "sense_id": "d2ba6f7f-f663-3733-9c0d-54e94cda08ed",
                                                "text": "„Und immer war diese Stimme da, diese gelle, erbarmungslose Stimme, wie eine häßlich klingende Glocke aus Eisen, blechern, aber unverwüstlich, seit seinen Kindertagen unverwüstlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
