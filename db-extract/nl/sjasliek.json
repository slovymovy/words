        "nl-extract.jsonl": [
            {
                "entry_id": "1a0fbb53-5d23-30b6-8d35-71426a88f440",
                "word": "sjasliek",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7bde538c-cf36-4e20-93e9-146b71145b0f",
                        "entry_id": "1a0fbb53-5d23-30b6-8d35-71426a88f440",
                        "tags": [
                            "plural"
                        ],
                        "form": "sjaslieks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6dc9ac5-deea-3793-92e0-0a0256a744cb",
                        "entry_id": "1a0fbb53-5d23-30b6-8d35-71426a88f440",
                        "glosses": [
                            "aan een spit geroosterde stukjes vlees en paprika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970e1097-d7f8-43b3-b585-b8dfbea5cfee",
                                "sense_id": "d6dc9ac5-deea-3793-92e0-0a0256a744cb",
                                "text": "Vlak bij de Turkmeense grens ligt het mausoleum van Khaled Nabi. Vroeger kwam hier echt niemand, nu hebben de Iraniërs deze ‘picknickplek met het mooiste uitzicht ter wereld’ duidelijk ontdekt. Bij het schrijn zelf is het druk. Families roosteren bergen sjasliek op de grote barbecues."
                            },
                            {
                                "example_id": "b2bc75e9-862f-4607-92eb-cbd9a7e546d2",
                                "sense_id": "d6dc9ac5-deea-3793-92e0-0a0256a744cb",
                                "text": "Dit coming-of-agevehikel leverde het Franse horrordrama Raw uitstekende publiciteit op: op het filmfestival van Toronto zouden enkele bezoekers tijdens het kijken zijn flauwgevallen. Waar of niet, debuterend regisseur Julie Ducournau, die met Raw in Cannes de Fipresci-prijs won in de Semaine de la Critique-sectie, werkt sappig toe naar Justines eerste hap mensenvlees: van het konijnenniertje en een sjasliek naar een rauwe kipfilet."
                            },
                            {
                                "example_id": "e355459f-cfaa-4721-9433-de5e157109ba",
                                "sense_id": "d6dc9ac5-deea-3793-92e0-0a0256a744cb",
                                "text": "Nu zie ik sjasliek eerder in de snackbar dan bij mij op de barbecue, maar met dit recept ga ik het toch een keer proberen. Verhit de barbecue of kamado goed heet. Meng de varkenshaas, kogelbiefstuk, ui, champignons, paprika en ananas en schep de sjasliekkruiden en zonnebloemolie erdoor. Rijg de stukken vlees, ui, champignons, paprika en ananas om en om aan metalen spiesen. Je kunt 4 grotere spiesen maken of 8 kleinere. Leg ze op de barbecue en bak ze in 6 tot 7 minuten rondom bruin. Het vlees mag vanbinnen iets rosé blijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a173128-ca3d-4350-bb70-3ea51b57a408",
                        "source_entry_id": "1a0fbb53-5d23-30b6-8d35-71426a88f440",
                        "source_sense_id": "d6dc9ac5-deea-3793-92e0-0a0256a744cb",
                        "source_sense_description": "aan een spit geroosterde stukjes vlees en paprika",
                        "target_lang_word": "shashlik",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shashlik",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                        "entry_id": "e57b99ed-1a59-3cd7-9e2e-713e531ca88d",
                                        "glosses": [
                                            "A form of shish kebab, originally made of marinated lamb meat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a71e24-4b77-4ced-9aee-282f358e3bad",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Men entered the room bearing skewers of tikas—kebabs or shashliki, we would call them—spitted chunks of lamb that had been roasted with onions and other seasoning."
                                            },
                                            {
                                                "example_id": "ca2e61ac-31ff-43fe-af15-d2e03756140f",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Everyone went to the Pump Room where the children would be entertained by the Nubian Slaves with flaming skewers of shashlik, while their parents talked to Irving Kupcinet, the Eiffel Tower of Chicago columnists."
                                            },
                                            {
                                                "example_id": "56184872-f1ce-47a3-9d77-998055c4fbc0",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "They swam and fished by day, they drank wine and grilled shashliki in the evenings, and sometimes they drove into Yalta to enjoy the night-life, but throughout it all Minka remained detached, like a convalescent."
                                            },
                                            {
                                                "example_id": "5b7a98c9-85ea-4a57-a051-c6d7489c390c",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Some, having lighted a fire on the ground, cook (some) food, roast (some) shashliki."
                                            },
                                            {
                                                "example_id": "ba4c5fe6-7f30-4f33-9041-e068865e04c9",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "You may well have heard of some of the national dishes of the Soviet Union, such as Borsch (beetroot soup), Bliny (pancakes), Beef Stroganoff, Chicken Kiev and Shashliki (Georgian kebabs)."
                                            },
                                            {
                                                "example_id": "39452600-39b2-4208-a849-aba7aaede782",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "The pork shashliki which they had marinated in a large glass jar all day were speared onto long metal skewers, and these were placed over the fire, straddling the large stones."
                                            },
                                            {
                                                "example_id": "18cc2fe6-db47-41c1-949c-73a3194c71c9",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "If you are determined to try something really Russian, go for the shashliki or kebabs at the top of the Old Arbat near the Prague Restaurant, or the Papsi kiosk by the picture of Checkhov on Tverskaya."
                                            },
                                            {
                                                "example_id": "230bb4eb-9ea7-49cb-9f52-1a71ff222923",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "On the menu at the restaurant (open noon to 6pm; and from 8pm to 2am) are pelmeni and shashliki, as well as other Russian dishes – a live band strikes up after 9pm."
                                            },
                                            {
                                                "example_id": "49ebe108-1d0b-48f3-9351-3ce33959970d",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "On the corner there are three men standing behind flaming barbecues of shashlik kebabs. I ask for one, hand over my roubles and wait while it is cooked. The fat drips down onto the charcoal and orange flames dance up in the soft evening light. I am so tired that I sway slightly on my feet and I am afraid that the shashliki men will think I am drunk."
                                            },
                                            {
                                                "example_id": "49b72464-3ce3-4e27-abd6-2d994766e2e1",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Why you don’t make shashliki? You jyust^([sic]) soak in wine the meat—"
                                            },
                                            {
                                                "example_id": "b90051ca-0f14-4b7e-9b03-043b68573b19",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Now, I should mention that all this was happening on 23 February, Defenders of the Fatherland Day (formerly Red Army Day, a big holiday for all the men), so the head of security was at home in Moscow, enjoying his holiday, maybe barbecuing shashliki."
                                            },
                                            {
                                                "example_id": "c950ceca-0ea4-403b-bc55-2aa79876ec2d",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Valya and Tanya sat there in silence, menacingly eating shashliki some guy had cooked for them."
                                            },
                                            {
                                                "example_id": "eeec65a5-7cc9-47e3-997e-06855b524487",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Beria hissed at his aides, who rushed out of the alcove and returned with an avalanche of waiters carrying trays filled with caviar, blinis, borscht, sour cream, shashliki, cucumber soup . . ."
                                            },
                                            {
                                                "example_id": "62f24d1d-feec-4b5d-9c7b-bca165acc4eb",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Shashliki are similar to kebabs. The meat is cooked on skewers over a barbecue. […] Shashliki is a meat dish, often made with chicken or lamb."
                                            },
                                            {
                                                "example_id": "4bff04c6-b742-4dbe-beec-aae1f5d82d70",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "No friends, no big parade with flags. Just us and I will make shashliki on the barbecue."
                                            },
                                            {
                                                "example_id": "24c49e65-0a80-43dc-8840-557182dabf49",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Somewhere we stopped by the roadside for shashliki."
                                            },
                                            {
                                                "example_id": "70e22339-5d28-49e8-a310-a79d480e67c1",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "When they arrived, Masha and Natasha joined the other girls in the kitchen, and Pasha scurried Seth out into the great outdoors with the men to barbeque shashliki, a delicious Russian marinated meat."
                                            },
                                            {
                                                "example_id": "e4999508-7705-4a6c-8510-2e9958457818",
                                                "sense_id": "a246309a-a00e-3293-bfa1-7670cb901215",
                                                "text": "Before them is an elaborate presentation of shashliki in the shape of a dartboard. They slide the meat off with their teeth, then use the skewer for target practice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
