                ],
                "senses": [
                    {
                        "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                        "entry_id": "a0d70772-bd0f-36cd-8450-8fa175900e5c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f3b550-73eb-41df-a3bd-d2f2bb4ca9db",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Frau Veigel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "795da78c-bf5a-4370-9ee6-726b71f53951",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Herr Veigel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "99c9d697-4c90-4e80-9c17-ee23ca24534a",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Die Veigels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "418e6b7b-f391-41c2-b294-cdfd7d8dce49",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Der Veigel trägt nie die Schals, die die Veigel ihm strickt."
                            },
                            {
                                "example_id": "77b6f71b-e03a-4bd6-95b4-a9dd500712c3",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Veigel kommt, geht der Herr Veigel.“"
                            },
                            {
                                "example_id": "4cef76b0-61d9-4eff-a252-8ae0546fc6b5",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Veigel kommt und geht."
                            },
                            {
                                "example_id": "f3dd25e0-07ac-4541-b77c-7cf495f71fe0",
                                "sense_id": "c8be4023-37bf-3034-8bfe-41e681b11b71",
                                "text": "Veigels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
