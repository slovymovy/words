                                        "sense_id": "dc6ea3b4-918e-38c3-bddb-47dfab48541f",
                                        "entry_id": "63f311d0-7fca-378e-b08f-e2e0bf8d8f8e",
                                        "glosses": [
                                            "gegen eine Sache; so, dass man einer Sache abgeneigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a37711ae-d589-4bfa-ba00-eeb3ba4e689f",
                                                "sense_id": "dc6ea3b4-918e-38c3-bddb-47dfab48541f",
                                                "text": "Wenn Sie mich fragen, bin ich dagegen."
                                            },
                                            {
                                                "example_id": "cb14f33f-4078-4d46-b96d-a52859d780e1",
                                                "sense_id": "dc6ea3b4-918e-38c3-bddb-47dfab48541f",
                                                "text": "Sie wenden sich dagegen, dass ein Unschuldiger verhaftet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "767d5e8e-3bda-3ac4-962d-8741d349ca7c",
                                        "entry_id": "63f311d0-7fca-378e-b08f-e2e0bf8d8f8e",
                                        "glosses": [
                                            "auf der anderen Seite, im Gegensatz dazu"
                                        ],
                                        "tags": [
                                            "Konjunktionaladverb",
                                            "Übergang zur Konjunktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "867b15b2-9ba5-46be-a814-e0f851f0b4d5",
                                                "sense_id": "767d5e8e-3bda-3ac4-962d-8741d349ca7c",
                                                "text": "Wir kommen sonst immer pünktlich; heute dagegen sind wir in einen Stau geraten."
                                            },
                                            {
                                                "example_id": "869bad95-7cc8-4e4b-ae6c-4e4557eb2d26",
                                                "sense_id": "767d5e8e-3bda-3ac4-962d-8741d349ca7c",
                                                "text": "„Grundsätzlich gilt die Namensregelung, wonach SUV ungerade Ziffern (Q1, Q3, Q5, etc.) erhalten, die geraden Zahlen dagegen den sportlicheren, eleganteren Crossover-Modellen vorbehalten bleiben.“"
                                            },
                                            {
                                                "example_id": "8783209b-92c9-4a89-9edb-4a64dc093ed9",
                                                "sense_id": "767d5e8e-3bda-3ac4-962d-8741d349ca7c",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "05d3e55c-3591-3253-825f-81dbf71e6505",
                                        "entry_id": "63f311d0-7fca-378e-b08f-e2e0bf8d8f8e",
                                        "glosses": [
                                            "im Vergleich dazu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d8eb1d-7fba-4a8f-a0dd-7e1465f82203",
                                                "sense_id": "05d3e55c-3591-3253-825f-81dbf71e6505",
                                                "text": "Das Gewitter letzte Woche war dagegen eine Kleinigkeit."
                                            },
                                            {
                                                "example_id": "58ce4038-2c38-4436-ba75-038c1f97014a",
                                                "sense_id": "05d3e55c-3591-3253-825f-81dbf71e6505",
                                                "text": "Mats ist ein Faulpelz, dagegen bin ja sogar ich richtig sportlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "27e0e138-b469-3875-b8a3-bbdb99a7b441",
                                        "entry_id": "63f311d0-7fca-378e-b08f-e2e0bf8d8f8e",
                                        "glosses": [
