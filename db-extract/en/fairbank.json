                "senses": [
                    {
                        "sense_id": "ff988ed6-5ec6-3d8a-a379-ffdd3aea609b",
                        "entry_id": "12be6401-3371-3a7d-b237-ab9749e08a91",
                        "glosses": [
                            "For the bank or dealer to assist (the player) by cheating in his/her favour, to encourage further play and facilitate a later swindle."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "564bd722-2c35-4a11-9834-af4b98e9e9c9",
                                "sense_id": "ff988ed6-5ec6-3d8a-a379-ffdd3aea609b",
                                "text": "I keep on fairbanking the chump until he is between a poop and a sweat. The score is half a C and he's broke."
                            },
                            {
                                "example_id": "c39aeda9-07ae-4553-a481-fea8e9be34d9",
                                "sense_id": "ff988ed6-5ec6-3d8a-a379-ffdd3aea609b",
                                "text": "I didn't check the dart board for the winner's precise total and will assume he hadn't been “fairbanked.” The guy didn't look like a professional, so I attributed his success to the lean and lady luck."
                            }
                        ]
                    }
                ],
