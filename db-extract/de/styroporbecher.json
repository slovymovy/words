                "senses": [
                    {
                        "sense_id": "616cd5fc-4cdf-38f2-9b46-4863622bd9db",
                        "entry_id": "eb4a17cc-65f4-3f1f-ba20-1b1906c1ebca",
                        "glosses": [
                            "Becher aus Styropor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81367cc-8bfb-4ea3-9375-e481dc793d61",
                                "sense_id": "616cd5fc-4cdf-38f2-9b46-4863622bd9db",
                                "text": "„An der Raststätte besorgte er sich einen Stadtplan, den er neben sich auf dem Sitz des Streifenwagens ausbreitete, während er Kaffee aus einem Styroporbecher trank.“"
                            },
                            {
                                "example_id": "92e05f70-a482-40aa-ae56-ffe8ff5a577d",
                                "sense_id": "616cd5fc-4cdf-38f2-9b46-4863622bd9db",
                                "text": "„Dabei hat er lange Schnitte in T-Bones Schlagadern gemacht, so dass das gesamte Blut aus ihm herausgelaufen ist. Als würde man den Boden eines Styroporbechers abschneiden.“"
                            },
                            {
                                "example_id": "ec96dbf3-ab24-4edc-9bc5-8174bf3c0eb7",
                                "sense_id": "616cd5fc-4cdf-38f2-9b46-4863622bd9db",
                                "text": "„Hin und wieder dringen die lautesten Stimmen sogar bis zu dem Raum vor, in dem Gene Cassidy und seine Angehörigen zwischen leeren Pizzaschachteln und Styroporbechern sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
