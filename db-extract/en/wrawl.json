                "senses": [
                    {
                        "sense_id": "f7edd4bd-5976-30e6-be64-c67d46307846",
                        "entry_id": "de2ff212-9f48-3309-b1ec-8098b4716056",
                        "glosses": [
                            "To cry like a cat; to waul."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "392678c5-8a52-4898-9e1d-7c887f7553e5",
                                "sense_id": "f7edd4bd-5976-30e6-be64-c67d46307846",
                                "text": "Some were of dogs, that barked day and night, And some of cats, that wrawling still did cry."
                            },
                            {
                                "example_id": "0ddcf3e7-ac30-4b72-8411-9ed7d88ccb49",
                                "sense_id": "f7edd4bd-5976-30e6-be64-c67d46307846",
                                "text": "Such successours [of Peter] yben to bolde, In winning all ther witte thei wral."
                            },
                            {
                                "example_id": "dd8a15ac-2940-409b-b155-158454ddb57f",
                                "sense_id": "f7edd4bd-5976-30e6-be64-c67d46307846",
                                "text": "The fog horns groaned and groaned again, and siren whistled and wrawled."
                            },
                            {
                                "example_id": "f07ffe79-bdde-4863-9f9a-750c8ed888ef",
                                "sense_id": "f7edd4bd-5976-30e6-be64-c67d46307846",
                                "text": "Man alone, poore wretch, she hath laid all naked upon the bare earth, even on his birth-day, to cry and wraule presently from the very first houre that he is borne into this worlde."
                            },
                            {
                                "example_id": "990a7a40-5bff-4789-9cc3-c31e07ada282",
                                "sense_id": "f7edd4bd-5976-30e6-be64-c67d46307846",
                                "text": "Howbeit, crying and wrawling as like as possibly might be to an infant new come into the world."
                            }
                        ]
                    }
                ],
