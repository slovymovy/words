                ],
                "senses": [
                    {
                        "sense_id": "01c5574a-3bfd-3aa8-b389-b667acc3861d",
                        "entry_id": "7e26a964-b192-3e28-a51e-4433726d8780",
                        "glosses": [
                            "Endroit généralement souterrain où l’on cultive les champignons sur couche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb8d187-835a-4fc7-8559-2580450de473",
                                "sense_id": "01c5574a-3bfd-3aa8-b389-b667acc3861d",
                                "text": "Tous les matériaux nécessaires aux constructions sont réunis autour de Paris. C’est ce qui explique pourquoi tout autour de la ville, surtout au sud et sous la primitive Lutèce, se trouvent des vides énormes. Une partie forme les catacombes, d’autres sont transformés en champignonnières ou en serres."
                            },
                            {
                                "example_id": "daf1a5b7-62ed-49ed-afe3-f59608a80eda",
                                "sense_id": "01c5574a-3bfd-3aa8-b389-b667acc3861d",
                                "text": "Au bout de quelques heures le mycélium ou les filaments blancs de la champignonnière atteignent et dans l’après-midi recouvrent les boulettes mises en place le matin."
                            },
                            {
                                "example_id": "d646730c-d5d9-4572-93a6-bb8bcbc9bc87",
                                "sense_id": "01c5574a-3bfd-3aa8-b389-b667acc3861d",
                                "text": "Odeur intense de champignonnière, règne du spongieux et du croupi."
                            },
                            {
                                "example_id": "8ae3989c-863d-42e5-9985-f2cf0ee973b8",
                                "sense_id": "01c5574a-3bfd-3aa8-b389-b667acc3861d",
                                "text": "Le frais du sous-sol accueille une endiverie et une champignonnière de shiitake et pleurotes."
                            }
                        ]
                    }
                ],
                "translations": [
