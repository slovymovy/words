                        "form": "die Fotografin"
                    },
                    {
                        "form_id": "fa759048-6817-47ad-9de7-5102ae2afef4",
                        "entry_id": "ddc438ee-5d3f-3753-a57f-f0c565753373",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fotografinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0c21d43-439c-37c8-b225-529fd5fea74f",
                        "entry_id": "ddc438ee-5d3f-3753-a57f-f0c565753373",
                        "glosses": [
                            "weibliche Person, die sich als Beruf oder Hobby intensiv der Fotografie widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78b01e47-5a10-436f-aceb-16ac4e4fc6d8",
                                "sense_id": "e0c21d43-439c-37c8-b225-529fd5fea74f",
                                "text": "„Die Fotografin Ute Mahler hat genau in diesem Restaurant 1990 ein Foto gemacht.“"
                            },
                            {
                                "example_id": "708de059-1910-47b7-bcf1-c8c1408a03b2",
                                "sense_id": "e0c21d43-439c-37c8-b225-529fd5fea74f",
                                "text": "„Besonders von der Eleganz des Foyers und der geschwungenen Treppenhäuser waren die jungen Fotografinnen begeistert.“"
                            },
                            {
                                "example_id": "95143e30-21ea-4600-9f65-4e9d0544bba5",
                                "sense_id": "e0c21d43-439c-37c8-b225-529fd5fea74f",
                                "text": "„Winnie, die Fotografin, hatte die Bewegungen ihres Metiers angenommen, ein klein wenig lässig, doch stets mit dem Ruch des klug Arrangierten.“"
                            },
                            {
                                "example_id": "43af59b7-1900-4f2d-a7ba-d864f012b151",
                                "sense_id": "e0c21d43-439c-37c8-b225-529fd5fea74f",
                                "text": "„Sie war gut zwanzig Jahre älter als die Fotografin, die fünfundzwanzig war; es wäre also möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "477e6cb8-d465-4883-a125-29528749176f",
                        "source_entry_id": "ddc438ee-5d3f-3753-a57f-f0c565753373",
                        "source_sense_id": "e0c21d43-439c-37c8-b225-529fd5fea74f",
                        "source_sense_description": "weibliche Person, die sich als Beruf oder Hobby intensiv der Fotografie widmet",
                        "target_lang_word": "photographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "312ce042-ae3a-312e-bb3d-ae8977b740ea",
                                        "entry_id": "1957fbe2-c567-3673-bd4d-b03abb9d15b8",
                                        "glosses": [
                                            "Personne qui prend des photographies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                        "entry_id": "1957fbe2-c567-3673-bd4d-b03abb9d15b8",
                                        "glosses": [
                                            "Personne qui s’occupe professionnellement de photographie, qui en fait son métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5bec39-8c4c-48b0-87ae-94f2f4e9f16b",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                                            },
                                            {
                                                "example_id": "8f739ff4-4ca8-4ae0-87c2-33148fb8b1da",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "Il n’est plus permis aujourd’hui à un photographe quelque peu averti, d’ignorer la sensitométrie. Les méthodes de mesures créées par Hürter et Driffield, perfectionnées par un grand nombre de savants, ont acquis une importance considérable en photographie."
                                            },
                                            {
                                                "example_id": "b6b38b37-34f1-453d-873a-31a02c580e4c",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "C'était le photographe. Il fit son entrée avec les instruments de son art sorcier : les plaques de verre sensibilisées de façon à fixer pour longtemps, sinon pour toujours, l'aspect des choses, la chambre obscure construite à l'instar de l'œil et pour suppléer aux manques de la mémoire, le trépied avec son voile noir."
                                            },
                                            {
                                                "example_id": "0c85e412-c962-4a37-864e-6c2fe4b1e5a5",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "Une fois les yeux dessillés, un observateur attentif ne peut manquer de remarquer la présence de ces photographes qui, dans les grandes villes comme dans les villages les plus reculés, de jour comme de nuit, sont devenus les témoins obligés des évènements ordinaires ou extraordinaires qui jalonnent la vie quotidienne des populations."
                                            },
                                            {
                                                "example_id": "8314afd2-662c-45d2-9aa6-3fe870071e45",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "Le jeune musicien, mitraillé par les photographes, est à bonne école, son père étant l’un des sonneurs principaux du bagad Kevrenn Kastell."
                                            },
                                            {
                                                "example_id": "38174d55-58ad-478d-b5fa-71c46f98a8a4",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "— Si seules de rares femmes photographes marquent l’histoire de la photographie au XIXᵉ siècle, elles prennent superbement leur revanche à partir des années vingt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a2eda7-5584-3c58-b387-9e34c6d50e78",
                                        "entry_id": "1957fbe2-c567-3673-bd4d-b03abb9d15b8",
                                        "glosses": [
                                            "Nom donné à l’assistant-bourreau qui tient la tête du condamné dans la lunette de la guillotine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d963e837-e2fc-4b65-a549-75afac111fd6",
                                                "sense_id": "20a2eda7-5584-3c58-b387-9e34c6d50e78",
                                                "text": "Moi, j’étais «photographe». Devant la lunette, les doigts placés derrière les oreilles du type, je devais le tirer vers moi pour qu’il ne se rétracte pas soudainement."
                                            },
                                            {
                                                "example_id": "e0952df3-0bed-4082-9b40-349382b8095d",
                                                "sense_id": "20a2eda7-5584-3c58-b387-9e34c6d50e78",
                                                "text": "La fonction de «photographe» (placé au pied de la guillotine, il doit saisir la tête du condamné qui passe par «l’objectif» et la poser, une fois coupée, dans la bassine prévue à cet effet) est une fonction «délicate» et «dangereuse»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
