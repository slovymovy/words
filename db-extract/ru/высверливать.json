                "senses": [
                    {
                        "sense_id": "e54f8c97-4461-34e3-a6cd-5d7d32b255b5",
                        "entry_id": "6adb6c15-89a5-3952-a623-cf70925dbdb7",
                        "glosses": [
                            "делать отверстие сверлом, буром"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ec4485-df71-4730-8a86-f6cf2c814925",
                                "sense_id": "e54f8c97-4461-34e3-a6cd-5d7d32b255b5",
                                "text": "После подгонки на одной заготовке высверливаем отверстия."
                            },
                            {
                                "example_id": "fd10d8a3-91ff-4c0b-9968-0efe552db34d",
                                "sense_id": "e54f8c97-4461-34e3-a6cd-5d7d32b255b5",
                                "text": "На некоторых шахтах Кривого Рога руда была мягкая и рыхлая. Длинным буром удавалось высверливать в ней глубокие скважины."
                            }
                        ]
                    },
                    {
                        "sense_id": "051a1b2f-e299-3b8f-a5b7-06483007ea9f",
                        "entry_id": "6adb6c15-89a5-3952-a623-cf70925dbdb7",
                        "glosses": [
                            "удалять сверлением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4a36d8-759b-444c-a55f-9705dbe81399",
                                "sense_id": "051a1b2f-e299-3b8f-a5b7-06483007ea9f",
                                "text": "Один зуб болит; придётся, вероятно, завтра высверливать пломбу."
                            }
                        ]
                    }
