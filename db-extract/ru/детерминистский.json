                ],
                "senses": [
                    {
                        "sense_id": "921ae1b4-957f-3086-a387-4574040b6589",
                        "entry_id": "e7b2e349-2a01-347f-8723-4c77a0f656ce",
                        "glosses": [
                            "относящийся к детерминизму или детерминистам, основанный на принципе детерминизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1dcd401-2b22-4af0-b037-d98621b92443",
                                "sense_id": "921ae1b4-957f-3086-a387-4574040b6589",
                                "text": "В детстве я мучительно переживал детерминистскую свою зависимость от Бога, мелочную Его опеку над собой."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ffc62f9-7473-380f-8646-3d38660a079f",
                        "entry_id": "e7b2e349-2a01-347f-8723-4c77a0f656ce",
                        "glosses": [
                            "спец. то же, что детерминированный; заранее определимый, предсказуемый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8a12f8-050b-4469-a052-de104d74beb4",
                                "sense_id": "8ffc62f9-7473-380f-8646-3d38660a079f",
                                "text": "Крен в математизацию позволил конструировать на языке математики не только строго детерминистские, но и случайные процессы, которые, согласно принципам классического рационализма, могли рассматриваться только как иррациональные"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8d2c2de-c2c5-4089-8654-ab6d8159010f",
                        "source_entry_id": "e7b2e349-2a01-347f-8723-4c77a0f656ce",
                        "target_lang_word": "deterministic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deterministic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a27b98-6da4-3821-aa56-4cabdb36f477",
                                        "entry_id": "4dd0cf8a-7d62-3409-86d6-25ee2ead72a4",
                                        "glosses": [
                                            "Of, or relating to determinism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c4cb4d1-02c8-31ea-bac5-4633409d0791",
                                        "entry_id": "4dd0cf8a-7d62-3409-86d6-25ee2ead72a4",
                                        "glosses": [
                                            "Having at most one instruction associated with any given internal state."
                                        ],
                                        "tags": [
                                            "of a Turing machine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdcf0269-5cf7-43d2-ad1e-2c2d31bdf5b2",
                                                "sense_id": "9c4cb4d1-02c8-31ea-bac5-4633409d0791",
                                                "text": "Another class, P, is a subset of NP, and includes all decision problems that can be solved by a (deterministic) Turing machine in polynomial time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b71ceb-2508-3de1-8cd3-a8d2ff202272",
                                        "entry_id": "4dd0cf8a-7d62-3409-86d6-25ee2ead72a4",
                                        "glosses": [
                                            "Having exactly predictable time evolution."
                                        ],
                                        "tags": [
                                            "of a system"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f1b6834-c29a-3caa-b300-17a3f7c6bbcc",
                                        "entry_id": "4dd0cf8a-7d62-3409-86d6-25ee2ead72a4",
                                        "glosses": [
                                            "For a given particular input, always producing the same output through the same sequence of states."
                                        ],
                                        "tags": [
                                            "of an algorithm"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e30a140-b67b-417d-9ce1-409919fc3259",
                                                "sense_id": "6f1b6834-c29a-3caa-b300-17a3f7c6bbcc",
                                                "text": "On the other hand, if the genetic algorithm has many advantages, their computation cost is higher as compared with deterministic algorithms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
