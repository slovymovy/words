                ],
                "senses": [
                    {
                        "sense_id": "a9341a2d-9cb8-3516-9dc3-8d702ca3f5f5",
                        "entry_id": "c2d50147-4e90-329f-ad94-4f0dcffb08bd",
                        "glosses": [
                            "Aktivität/Institution/Organisation für die Gewährleistung der Sicherheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c877ac-958b-46e4-9c73-fb435da6c426",
                                "sense_id": "a9341a2d-9cb8-3516-9dc3-8d702ca3f5f5",
                                "text": "„Die Polizei wird aufgelöst, die rote Garde übernimmt den Sicherheitsdienst der Stadt.“"
                            },
                            {
                                "example_id": "54e295a4-8825-4722-a817-32073851e3d4",
                                "sense_id": "a9341a2d-9cb8-3516-9dc3-8d702ca3f5f5",
                                "text": "„Der polnische Sicherheitsdienst interessiert sich nicht mehr für die junge Frau.“"
                            },
                            {
                                "example_id": "aa32f02b-0259-46be-af03-377c7dfbd1ee",
                                "sense_id": "a9341a2d-9cb8-3516-9dc3-8d702ca3f5f5",
                                "text": "„Vor allem auf dem Land werden zunehmend mehr Kommunen auf private Sicherheitsdienste zurückgreifen müssen, weil sie nicht mehr über genügend eigenes Personal verfügen.“"
                            },
                            {
                                "example_id": "8aa889c9-b3cd-4cdf-899f-dcf9ae1e5984",
                                "sense_id": "a9341a2d-9cb8-3516-9dc3-8d702ca3f5f5",
                                "text": "„Es gäbe Gerüchte, sie sei eine Spionin, und möglicherweise wolle der Sicherheitsdienst – die Auslandsabteilung der Gestapo – sie demnächst befragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
