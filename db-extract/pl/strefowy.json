                "senses": [
                    {
                        "sense_id": "3e9c3c85-e73e-3e29-8464-bc2e2c13d85f",
                        "entry_id": "5202306f-d8e9-3089-aa99-4befb7e87295",
                        "glosses": [
                            "związany ze strefą, dotyczący strefy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde35530-9586-4464-91a0-0e6d3ebe815a",
                                "sense_id": "3e9c3c85-e73e-3e29-8464-bc2e2c13d85f",
                                "text": "Formacje trawiaste dzieli się na strefowe lub azonalne odpowiednio do rozmieszczenia czynników warunkujących ich występowanie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a8a1440-20ba-44d5-8b6d-4b294b35d35d",
                        "source_entry_id": "5202306f-d8e9-3089-aa99-4befb7e87295",
                        "source_sense_id": "3e9c3c85-e73e-3e29-8464-bc2e2c13d85f",
                        "target_lang_word": "zonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51f93634-afd0-3301-b5ed-8f4ea6ef2a4b",
                                        "entry_id": "022c51de-27da-3921-a304-1a33b2ad6abd",
                                        "glosses": [
                                            "Divided into zones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3a34da-96ac-4dec-8d05-17716098de64",
                                                "sense_id": "51f93634-afd0-3301-b5ed-8f4ea6ef2a4b",
                                                "text": "Decisions made at the DfT inevitably reflect a London-centric experience, with a comparison being made with the closure of ticket offices throughout the London Underground network. This is not judged to have been detrimental, but there is a simple zonal fares system that is hardly comparable with the range of ticket types used on the national rail network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b17ced5c-1338-3f3e-b436-86df486279c0",
                                        "entry_id": "022c51de-27da-3921-a304-1a33b2ad6abd",
                                        "glosses": [
                                            "Related to, associated with, or similar to zones."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f1679ca-956d-3232-bffe-e67024ba63a2",
                                        "entry_id": "022c51de-27da-3921-a304-1a33b2ad6abd",
                                        "glosses": [
                                            "roughly longitudinal (east to west, or west to east)"
                                        ],
                                        "tags": [
                                            "of air or ocean currents"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a46d50b-2496-4c96-8c10-f9f3801cfb84",
                        "source_entry_id": "5202306f-d8e9-3089-aa99-4befb7e87295",
                        "source_sense_id": "3e9c3c85-e73e-3e29-8464-bc2e2c13d85f",
                        "target_lang_word": "zonal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zonal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3d887b-bfed-3e8e-8910-ca8d5f92ce5c",
                                        "entry_id": "50c08dec-2823-3d19-bf91-f6689afd97c8",
                                        "glosses": [
                                            "Relatif à une ou des zones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d231d8-e5ee-4649-a17a-bd743f10059c",
                                                "sense_id": "5c3d887b-bfed-3e8e-8910-ca8d5f92ce5c",
                                                "text": "Au plus fort du Logos, il y a un champ proscrit, tabou zonal dont aucun n’approchait, qu’aucun soupçon n’indiquait : un Trou, un Blanc, signal omis qui, jour sur jour, prohibait tout discours, laissait tout mot vain, brouillait la diction, abolissait la voix dans la maldiction d’un gargouillis strangulant."
                                            },
                                            {
                                                "example_id": "09d0f1a7-1d82-421d-a199-2e27f22149d1",
                                                "sense_id": "5c3d887b-bfed-3e8e-8910-ca8d5f92ce5c",
                                                "text": "L’atlas zonal des risques majeurs présente une synthèse des risques naturels et technologiques inventoriés dans les régions de la zone défense sud-ouest soit : Poitou-Charentes, Limousin, Aquitaine, Midi-Pyrénées (définition, exemples, consignes à la population, cartes de synthèse)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c969e0ac-cfaa-36e4-8aa6-3d26867abd08",
                                        "entry_id": "50c08dec-2823-3d19-bf91-f6689afd97c8",
                                        "glosses": [
                                            "Qualifie un sol dont la genèse est due aux conditions climatiques de la zone où il s’est formé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb14481-f4a9-42dd-955c-64f9126ca6d8",
                                                "sense_id": "c969e0ac-cfaa-36e4-8aa6-3d26867abd08",
                                                "text": "Depuis Dokutchaieff, le terme de « sol de toundra » est utilisé pour la dénomination d'un des grands groupes de sols zonaux."
                                            },
                                            {
                                                "example_id": "b75660d1-cc80-4ca6-882f-480ca6cbb711",
                                                "sense_id": "c969e0ac-cfaa-36e4-8aa6-3d26867abd08",
                                                "text": "De même, le podzol que l’on considère comme zonal en régions boréales, est, chez nous, un sol intrazonal car il n’apparaît que sur des roches-mères suffisamment grossières, très perméables (sables, grès, quartzites,… )."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd67894c-13c5-4f98-83b5-8d05e0a3809a",
                        "source_entry_id": "5202306f-d8e9-3089-aa99-4befb7e87295",
                        "source_sense_id": "3e9c3c85-e73e-3e29-8464-bc2e2c13d85f",
                        "target_lang_word": "zonier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zonier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "952765cc-c355-316d-b1c4-1400c44644e7",
                                        "entry_id": "52030d87-c5db-3ef3-8d91-beed66af2025",
                                        "glosses": [
                                            "Relatif à une zone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8b1faf-1e69-4cba-a894-24daf6f6e7ac",
                                                "sense_id": "952765cc-c355-316d-b1c4-1400c44644e7",
                                                "text": "Non, le chemin de fer coupe en deux le champ des recherches ; de l'autre côté, il n'y a que des terrains industriels et quelque vagues friches zonières."
                                            },
                                            {
                                                "example_id": "9e63239a-09bc-461f-9141-95d8b385260b",
                                                "sense_id": "952765cc-c355-316d-b1c4-1400c44644e7",
                                                "text": "Saoulé de l’arôme des fleurs engelées dans les fioles, percolé des aromates vengeurs nés de ma rage zonière à ne pas céder, je me lève au gré d’un cri de la concierge excédée des bouteilles en vrac sous la roulette de ses poubelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cd8006-6790-39c9-bf98-fae6fb7077ae",
                                        "entry_id": "52030d87-c5db-3ef3-8d91-beed66af2025",
                                        "glosses": [
                                            "Relatif à une zone.",
                                            "Relatif à la zone autour de Paris."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a968194-e0f9-4a7a-af02-52cc9031965d",
                                                "sense_id": "43cd8006-6790-39c9-bf98-fae6fb7077ae",
                                                "text": "Sa famille répondait parfaitement à l’image type que l’on peut se faire d’une famille zonière avec un père manœuvre et une belle-mère porteuse de pain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zonier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "192f4d63-ec3f-30ae-9021-1b0f130690a8",
                                        "entry_id": "10924334-442b-36c3-b3f0-07743e0a7ee5",
                                        "glosses": [
                                            "Habitant d’une zone. Nom donné en particulier à ceux qui habitaient aux abords de l'ancienne zone militaire désaffectée qui autrefois entourait Paris, et où il était interdit de construire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b851d16-4852-4f01-ad98-93aaaa8e0159",
                                                "sense_id": "192f4d63-ec3f-30ae-9021-1b0f130690a8",
                                                "text": "Les zoniers sont nombreux encore qui habitent des cabanes plus ou moins construites avec de vieilles boites à sardines. L'industrie des chiffons et l'exploration matutinale des poubelles ne leur permettent pas de villas plus cossues."
                                            },
                                            {
                                                "example_id": "dee84c47-e3e9-48f3-8937-b8262d400e63",
                                                "sense_id": "192f4d63-ec3f-30ae-9021-1b0f130690a8",
                                                "text": "Des bidonvilles apparaissent alors aux portes de Paris, transformant les secteurs limitrophes en « zone ». De cette appellation, naît le nom donné aux habitants de ces quartiers : les « zoniers ». La plupart d’entre eux sont chiffonniers, ils vivent de la récupération et de la revente des déchets de la ville."
                                            },
                                            {
                                                "example_id": "eff6cb3a-265e-42c7-8bd4-e2a8a0d081db",
                                                "sense_id": "192f4d63-ec3f-30ae-9021-1b0f130690a8",
                                                "text": "Chaque quartier avait sa communauté, il y avait les Italiens, les Arméniens, les Espagnols, les Portugais… mais tous étaient surnommés les zonards ou les zoniers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zonier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05b93249-e948-33d3-a33e-3b819cc12e89",
                                        "entry_id": "83cbc1d8-ab6a-308c-ac37-bef0b78983f3",
                                        "glosses": [
                                            "Résultat du découpage d’un territoire en zones, en fonction de l’exposition aux risques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc4cbea-ec5f-4760-a29e-a3e9cad4c18f",
                                                "sense_id": "05b93249-e948-33d3-a33e-3b819cc12e89",
                                                "text": "Le zonier obtenu permet de localiser des concentrations des risques, mais il est difficilement applicable tel quel lors d'une tarification car il présente de trop fortes disparités entre des régions proches géographiquement."
                                            },
                                            {
                                                "example_id": "a9209db0-0716-49f5-8d67-663c8d836a61",
                                                "sense_id": "05b93249-e948-33d3-a33e-3b819cc12e89",
                                                "text": "Dans le cours d’actuariat de l’assurance non-vie, on avait évoqué rapidement l’idée de faire un zonier. Autrement dit, on souhaite créer une variable polytomique (avec 4 ou 5 classes) représentant le critère spatial du risque."
                                            },
