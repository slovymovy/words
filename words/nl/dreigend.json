    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae23dd05-d5a8-3d9c-b823-68293786b3c5",
                    "sense_definition": "angst of onrust oproepend door een vijandige houding of een gevaarlijke uitstraling",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gevaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>dreigende</w> houding van de man maakte iedereen in de kamer erg bang.",
                            "target_lang_translations": {
                                "en": "The man's <w>threatening</w> posture made everyone in the room very afraid."
                            }
                        },
                        {
                            "text": "Er hingen <w>dreigende</w> wolken boven de stad vlak voordat de storm losbarstte.",
                            "target_lang_translations": {
                                "en": "There were <w>menacing</w> clouds hanging over the city just before the storm broke."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimiderend",
                        "gevaarlijk",
                        "angstaanjagend"
                    ],
                    "antonyms": [
                        "vriendelijk",
                        "geruststellend"
                    ],
                    "common_phrases": [
                        "dreigende taal",
                        "dreigende houding",
                        "dreigende wolken"
                    ],
                    "target_lang_definitions": {
                        "en": "evoking fear or unrest through a hostile attitude or a dangerous appearance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "threatening",
                                "target_lang_sense_clarification": "posing a risk of harm or danger"
                            },
                            {
                                "target_lang_word": "menacing",
                                "target_lang_sense_clarification": "suggesting the presence of danger; threatening"
                            },
                            {
                                "target_lang_word": "ominous",
                                "target_lang_sense_clarification": "giving the impression that something bad is going to happen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef6adcf4-f60c-30e7-9074-c590311fd364",
                    "sense_definition": "op het punt staand om te gebeuren, meestal gezegd van iets negatiefs",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "gevaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid waarschuwt de bevolking voor een <w>dreigend</w> tekort aan drinkwater.",
                            "target_lang_translations": {
                                "en": "The government is warning the population about an <w>imminent</w> shortage of drinking water."
                            }
                        },
                        {
                            "text": "Door de economische crisis is er een <w>dreigend</w> gevaar voor massale ontslagen.",
                            "target_lang_translations": {
                                "en": "Due to the economic crisis, there is a <w>looming</w> danger of mass layoffs."
                            }
                        }
                    ],
                    "synonyms": [
                        "naderend",
                        "aanstaand"
                    ],
                    "common_phrases": [
                        "dreigend tekort",
                        "dreigend gevaar",
                        "dreigend faillissement"
                    ],
                    "target_lang_definitions": {
                        "en": "about to happen, usually said of something negative"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imminent",
                                "target_lang_sense_clarification": "about to happen; overhanging"
                            },
                            {
                                "target_lang_word": "looming",
                                "target_lang_sense_clarification": "appearing as a shadowy form, especially one that is large or threatening"
                            },
                            {
                                "target_lang_word": "impending",
                                "target_lang_sense_clarification": "about to happen; forthcoming"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
