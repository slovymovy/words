                        "entry_id": "c95f25a7-6a01-39dd-b8ba-b187c256ea6c",
                        "glosses": [
                            "nicht cisgender und nicht binär transgender; sich als weder männlich noch weiblich verstehend; eine Geschlechtsidentität habend, die weder männlich noch weiblich ist, oder die sowohl männlich als auch weiblich (also androgyn) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b568be7a-d785-4a33-8f09-601b07317579",
                                "sense_id": "2d7311db-a8cd-35ec-9366-b3f09b3f6373",
                                "text": "Louise Fitzhugh was more consistently genderqueer than Harriet ever was. A tomboyish girl and a butch woman, Fitzhugh went by the nicknames of Sport and Willie—names that she assigned to male characters in her fiction."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
