                        ],
                        "form": "die Deformationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "240d3d73-9221-3a1a-b2fc-8c063ba8a724",
                        "entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "glosses": [
                            "Änderung der Form eines Körpers durch äußere Einflüsse"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "4a9b889b-56bd-42f6-bffb-83ad0221e8b5",
                                "sense_id": "240d3d73-9221-3a1a-b2fc-8c063ba8a724",
                                "text": "„Die Weimarer Republik hatte mit schweren wirtschaftlichen Hypotheken zu kämpfen, die auf die Deformation der Volkswirtschaft in der Kriegszeit zurückzuführen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "659019fb-f4ba-3478-ba65-ccfdf4e239f4",
                        "entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "glosses": [
                            "abnorme Ausbildung eines Organs bei Lebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99ee71d1-8b48-43e6-9207-7897ba1e4fc2",
                                "sense_id": "659019fb-f4ba-3478-ba65-ccfdf4e239f4",
                                "text": "Die angeborene Deformation des Herzens führte zu einer verkürzten Lebenserwartung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7aeb2ad6-d8e3-3b29-b26a-f6259924d1ed",
                        "entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "glosses": [
                            "Veränderung in der Struktur der Persönlichkeit"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "309d6b0f-c09b-3e7e-9722-1e6e4249891c",
                        "entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "glosses": [
                            "bewusst herbeigeführte Veränderung des Körpers aus religiösen, ästhetischen oder sozialen Gründen"
                        ],
                        "tags": [
                            "Ethnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "299f7700-ba98-4af2-9ee6-e382aa63cd2c",
                                "sense_id": "309d6b0f-c09b-3e7e-9722-1e6e4249891c",
                                "text": "Beschneidung ist eine Deformation."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "9dc2b688-522d-3513-b0a3-4f63eb9524c5",
                        "entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "glosses": [
                            "stetige Überführung eines Weges in einem topologischen Raum in einen anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23fa70d5-8bef-49c3-b15a-bc4737a50cd4",
                                "sense_id": "9dc2b688-522d-3513-b0a3-4f63eb9524c5",
                                "text": "„Für dieses Phänomen gibt es tatsächlich eine Erklärung, die Kreise mit diesen Radien lassen sich alle stetig ineinander deformieren, und wir werden sehen, dass sich Kurvenintegrale unter solchen stetigen Deformationen des Integrationswegs nicht ändern.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "614a447e-1c8e-322d-a1a1-9c627bd30ad7",
                        "entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "glosses": [
                            "Bewegung innerhalb des Gesteins/Materials"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93faf2e2-4fe4-4639-bf6e-f690082763c2",
                                "sense_id": "614a447e-1c8e-322d-a1a1-9c627bd30ad7",
                                "text": "Bei der Bildung der Kristalle findet eine doppelte Deformation statt, sie besteht aus zwei Vorgängen, einer Biegung und einer Kippung."
                            }
                        ],
                        "sense_index_json": "\"6\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bb5f49d-1b90-413c-b82a-2f972e5d52c4",
                        "source_entry_id": "04cec5e9-33ae-3f59-8511-a5e83a1625dc",
                        "source_sense_id": "240d3d73-9221-3a1a-b2fc-8c063ba8a724",
                        "source_sense_description": "auch übertragen: Änderung der Form eines Körpers durch äußere Einflüsse",
                        "target_lang_word": "déformation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déformation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Action de déformer, ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6bef29-4239-4296-8743-bfa4202fab5a",
                                                "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                                                "text": "La déformation du langage, son altération par l’incorrection des mots ou des tours de phrases."
                                            },
                                            {
                                                "example_id": "58b61f2b-8d89-4f69-93d5-327014e683a8",
                                                "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                                                "text": "Dans ce cas, le conformisme s’avère être également une déformation de l’évidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Altération de la forme de quelque partie du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a667a51-7ee7-44d7-af1b-cf6278487183",
                                                "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                                                "text": "La déformation de la tête, du bassin."
                                            },
                                            {
                                                "example_id": "3fc02297-8039-4509-b18a-744cc509b38a",
                                                "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                                                "text": "HP compte également parmi ses clients l’entreprise française Chabloz qui imprime des casques destinées à corriger les déformations positionnelles ou posturales chez les jeunes enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d91eb7d-3e44-342d-a3de-aa791e2e45ba",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Perturbation de la forme ou de la taille d’un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a362f08-133c-462c-a9c8-75bcf1ab5230",
                                                "sense_id": "8d91eb7d-3e44-342d-a3de-aa791e2e45ba",
                                                "text": "Un matériau peut montrer deux types de déformation sous champ électrique : l’électrostriction et la piézoélectricité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d56f08-558f-3159-a6d4-0d6caaec018d",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Déformation mécanique : perturbation de la géométrie d’un corps sous l’effet d’une contrainte mécanique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a297c8-6fc8-48ff-933a-2c1d0ed6f90f",
                                                "sense_id": "e0d56f08-558f-3159-a6d4-0d6caaec018d",
                                                "text": "Le résultat de l’essai de traction est illustré par la courbe de traction, ou courbe contrainte-déformation, montrant la relation entre la contrainte (en ordonnée) et la déformation (en abscisse)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
