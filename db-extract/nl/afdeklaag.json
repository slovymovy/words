                    {
                        "sense_id": "f7c38c90-41c9-3b38-954d-84a525679b9f",
                        "entry_id": "c27335f1-53e3-3d3d-963b-27f85122baae",
                        "glosses": [
                            "een laag die zorgt dat twee zaken niet met elkaar in contact kunnen komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "805b7525-b161-42de-9a5a-60616362c365",
                                "sense_id": "f7c38c90-41c9-3b38-954d-84a525679b9f",
                                "text": "Als de tuinen eenmaal aangepakt zijn, medio april, volgt de rest van de voormalige vuilstort. Daar wordt ook een folie-afdeklaag neergelegd waarna de vuilstort met schoon zand wordt afgedekt."
                            },
                            {
                                "example_id": "edf8b0f2-db1b-449b-8072-59562985a53c",
                                "sense_id": "f7c38c90-41c9-3b38-954d-84a525679b9f",
                                "text": "We weten door de lemen en houten afdeklaag te voorkomen dat bijvoorbeeld muizen en vogels bezit nemen van het gebouw.”"
                            }
                        ]
                    }
                ],
