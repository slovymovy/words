                "senses": [
                    {
                        "sense_id": "48dd4592-6d21-38ab-8c79-658e7d9aa73e",
                        "entry_id": "60a7350b-3575-36fc-985d-b6c9e72a286f",
                        "glosses": [
                            "een hoeveelheid steenkool die men direct tot zijn beschikking heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8d809a-54d6-48bb-9c7e-689b0f467ea5",
                                "sense_id": "48dd4592-6d21-38ab-8c79-658e7d9aa73e",
                                "text": "Maar voor de kust van Cape Cod is het schip door zijn kolenvoorraad heen, de kapitein geeft het bevel al het hout aan boord in stukken te hakken en aan de stoomketels te voeren, er zit voor Harbo en Samuelsen niets anders op dan hun boot langs de zijkant van het schip te laten vieren, hem te water te laten en terug te roeien naar New York; dit moeten ze als de ultieme vernedering ervaren hebben."
                            },
                            {
                                "example_id": "4f308572-07f4-45ac-bc3d-30cebc6ef8b0",
                                "sense_id": "48dd4592-6d21-38ab-8c79-658e7d9aa73e",
                                "text": "De energievoorziening heeft ook ernstige schade opgelopen, vooral waterkrachtcentrales en kolenvoorraden. De woningen van zeker 240.000 gezinnen zijn verwoest, ondergelopen of beschadigd. Circa 100.000 mensen zijn hierdoor volkomen dakloos. Circa 200.000 hectare landbouwgrond is vlak voor de oogst verwoest, volgens het staatspersbureau KCNA."
                            }
                        ]
                    }
