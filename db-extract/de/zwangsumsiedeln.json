                "senses": [
                    {
                        "sense_id": "33bd3cf4-9850-3011-a37a-c1f7f2d26d28",
                        "entry_id": "365a04ff-ccc4-33a6-b3f8-fda943983f3a",
                        "glosses": [
                            "unter Anwendung von Zwang umsiedeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d920dc79-9d56-4348-925a-1a8defb28cc8",
                                "sense_id": "33bd3cf4-9850-3011-a37a-c1f7f2d26d28",
                                "text": "„Hunderttausende Afrikaner wurden zwangsumgesiedelt, um Land für die Neueinwanderer frei zu machen.“"
                            },
                            {
                                "example_id": "93ee2530-f465-4021-9443-48b85d70f367",
                                "sense_id": "33bd3cf4-9850-3011-a37a-c1f7f2d26d28",
                                "text": "„Das Hasarajat war weitgehend unabhängig geblieben, bis es 1893 vom Paschtunen-König Abdul Rehman erobert wurde, der Tausende Hasaras tötete und Tausende nach Kabul zwangsumsiedelte, wo sie als Sklaven und Dienstboten ihr Leben fristeten.“"
                            },
                            {
                                "example_id": "5056d44c-ba17-4746-8ef4-2ddb4b2e68c1",
                                "sense_id": "33bd3cf4-9850-3011-a37a-c1f7f2d26d28",
                                "text": "„Wie ihre Häuser mussten auch die Bewohner des Maghrebiner-Viertels den israelischen Baggern weichen. Anders als manch für den Abriss Verantwortlicher behauptete, gingen sie keineswegs freiwillig, sondern wurden zwangsumgesiedelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
