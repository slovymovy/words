                                            {
                                                "example_id": "295e9d01-e0eb-44f8-97cf-c4abed443024",
                                                "sense_id": "bddf5b8a-8ec8-3e6b-900a-94151d27ee5b",
                                                "text": "Laos bildet einen schmalen Streifen zwischen Vietnam und Thailand."
                                            },
                                            {
                                                "example_id": "552d2079-61f5-4460-a79f-fd65efcf6ad7",
                                                "sense_id": "bddf5b8a-8ec8-3e6b-900a-94151d27ee5b",
                                                "text": "Vientiane ist die Hauptstadt von Laos."
                                            },
                                            {
                                                "example_id": "ab6850bc-63f3-473d-82de-b8a78d9ffabd",
                                                "sense_id": "bddf5b8a-8ec8-3e6b-900a-94151d27ee5b",
                                                "text": "„Der 39-jährige Prinz nennt das Laos der Kommunisten ein ‚Desaster‘ und ruft aus dem französischen Exil zur Rückkehr zur laotischen Krone auf.“"
                                            },
                                            {
                                                "example_id": "37032a56-38dc-4613-8466-7637f82bf39d",
                                                "sense_id": "bddf5b8a-8ec8-3e6b-900a-94151d27ee5b",
                                                "text": "„Im Jahre 1959 begannen die Bauernsoldaten Nordvietnams damit, den so genannten Ho-Chi-Minh-Pfad durch die Dschungelwälder von Laos zu schlagen; das Netz der Wege füllte sich mit Guerillakämpfern und Spionen, die alle Richtung Südvietnam marschierten.“"
                                            }
                                        ],
