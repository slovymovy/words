                        "glosses": [
                            "A piece, a clove (of segmented produce, especially oranges and garlic)."
                        ],
                        "tags": [
                            "Caribbean",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "6b32ed08-1dc3-430d-9dc6-d9197e1d6e07",
                                "sense_id": "afbabf1e-e557-3370-95eb-00d240f15ecc",
                                "text": "I have many relations and friends who are West Indians. They always speak of the section of an orange as a \"fig,\" and of tearing an orange into its different pieces as \"figging an orange.\" This does not apply to a division by knife."
                            },
                            {
                                "example_id": "8367be4d-be00-4bec-b553-bc3efd1bc46c",
                                "sense_id": "afbabf1e-e557-3370-95eb-00d240f15ecc",
                                "text": "Place about ten to fifteen fegs of garlic, half cup of dried fine thyme, (more if fresh thyme is used), 4 or more wiri wiri peppers, and a tablespoon of salt in a blender with about a cup of vinegar and blend for about a minute until well blended."
                            }
                        ]
                    }
