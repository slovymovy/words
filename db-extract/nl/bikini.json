                    {
                        "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                        "entry_id": "e1ed3d3e-a094-30e1-a68b-0005ae37734e",
                        "glosses": [
                            "tweedelige zwemkleding voor de vrouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f945899-ef46-48cc-afd3-391c468c1487",
                                "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                "text": "Ze trok alle aandacht in haar bikinietje."
                            },
                            {
                                "example_id": "f15666b5-4a3b-4944-9fdb-c51add7b6306",
                                "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                "text": "Ze droegen bikini's met tijgermotieven en glimlachten verleidelijk."
                            },
                            {
                                "example_id": "897e09df-fa04-460e-b267-c28b25d71823",
                                "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                "text": "Mijn moeder en vader stonden in badkleding bij de steiger en glimlachten naar de camera, zij in een tweedelig badpak, dus geen bikini, hij in zo'n strakke zwembroek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e037e116-78d6-41a0-bd53-c35f4476d8a5",
                        "source_entry_id": "e1ed3d3e-a094-30e1-a68b-0005ae37734e",
                        "source_sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                        "source_sense_description": "tweedelige zwemkleding voor de vrouw",
                        "target_lang_word": "Bikini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
