                    },
                    {
                        "translation_id": "375ef80d-3797-42ce-b226-e872dbf84c8f",
                        "source_entry_id": "d08cacb5-8fd0-323a-ad0b-e63c1f75fa90",
                        "source_sense_description": "man who delivers milk early in the morning",
                        "target_lang_word": "laitier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laitier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0964981a-f23f-3dff-a6c1-44c93936cf66",
                                        "entry_id": "8a657630-9382-374b-9759-8b2cda61fcd5",
                                        "glosses": [
                                            "Relatif au lait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41f7966b-175b-43bc-99a9-8a53fc51270e",
                                                "sense_id": "0964981a-f23f-3dff-a6c1-44c93936cf66",
                                                "text": "Au moment de la crise agricole frappant une partie de l´Europe à la fin du 19ᵉ siècle, le pays a pu reconvertir son agriculture fondée sur une production de céréales vers l´industrie laitière."
                                            },
                                            {
                                                "example_id": "8c1aecb4-30be-4af7-a203-e602f49dd4ab",
                                                "sense_id": "0964981a-f23f-3dff-a6c1-44c93936cf66",
                                                "text": "Les arômes contribuent à rendre le produit agréable au palais, ce qui dépend essentiellement de la présence de produits laitiers ou de la matière édulcorante dans la formule."
                                            },
                                            {
                                                "example_id": "e8d2d34b-678c-4d1f-bfce-19b8aa85e667",
                                                "sense_id": "0964981a-f23f-3dff-a6c1-44c93936cf66",
                                                "text": "La vache marocaine est mauvaise laitière : on ne peut guère en tirer qu’un à trois litres de lait, et seulement tant qu’elle allaite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laitier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f3784d2-0326-3974-bc8e-4c08b7f6ae5f",
                                        "entry_id": "3f8749bd-5540-3c98-990d-0489141efc44",
                                        "glosses": [
                                            "Celui qui fait le métier de vendre du lait, de la crème, et autres produits dérivés du lait."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a25872-0cee-41a7-a0cb-ba9caa60e5c7",
                                                "sense_id": "3f3784d2-0326-3974-bc8e-4c08b7f6ae5f",
                                                "text": "Parfois encore, s’il traversait la chaussée, la voiture du laitier où dansaient en chantant les boîtes de fer-blanc s’arrêtait si près de lui, qu’il sentait sur sa joue le souffle chaud du cheval."
                                            },
                                            {
                                                "example_id": "683f5bf3-3145-40c1-9a1a-2be4643db3ad",
                                                "sense_id": "3f3784d2-0326-3974-bc8e-4c08b7f6ae5f",
                                                "text": "Le laitier déposa chaque jour à leur porte, comme à toutes les portes de la rue, la bouteille de lait qui les sacrait, sinon citoyens anglais, du moins hôtes de la Grande-Bretagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73df033-5700-3a65-80d8-abaf147d9795",
                                        "entry_id": "3f8749bd-5540-3c98-990d-0489141efc44",
                                        "glosses": [
                                            "Sorte de matière vitrifiée qui surnage à la surface de quelques métaux en fusion."
                                        ],
                                        "tags": [
                                            "Fonderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f154530-4eda-426c-b749-9ed75924e550",
                                                "sense_id": "a73df033-5700-3a65-80d8-abaf147d9795",
                                                "text": "Le laitier des hauts fourneaux, donne aussi l'acier fondu , mais ce flux ne vaut pas le verre alkalin."
                                            },
                                            {
                                                "example_id": "11096f1d-60f4-4d0c-a804-60568cf30c59",
                                                "sense_id": "a73df033-5700-3a65-80d8-abaf147d9795",
                                                "text": "Depuis minuit jusqu'au matin , le laitier resta très-pesant et la fonte fluide. Comme les charges descendaient lentement, j'accélérai la vitesse des soufflets : le laitier devint peu-à-peu plus pur, et la fonte grise ; […]."
                                            },
                                            {
                                                "example_id": "1c629433-e001-4a19-bc4c-282e2e5dfff0",
                                                "sense_id": "a73df033-5700-3a65-80d8-abaf147d9795",
                                                "text": "Pour fondre les matières étrangères du minerai, on ajoute en outre un fondant qui est destiné à former avec la gangue terreuse des silicates fusibles ou laitiers."
                                            },
                                            {
                                                "example_id": "cd4ab98e-13f9-4cf4-b9c3-d29bd3a86bf6",
                                                "sense_id": "a73df033-5700-3a65-80d8-abaf147d9795",
                                                "text": "La mine calcareuse a, en outre, l’inconvénient de rendre le premier laitier ferreux, apte à mazer la fonte et à rendre son expulsion du creuset difficile."
                                            },
                                            {
                                                "example_id": "7695cfe9-43be-49ff-ac1a-83275d5ab7b5",
                                                "sense_id": "a73df033-5700-3a65-80d8-abaf147d9795",
                                                "text": "Pour écouler le laitier, qui s'accumulait à la partie supérieure (étant plus léger que le fer), le fondeur avait ménagé, à hauteur convenable, un conduit appelé queue de renard, d'où le nom de renardière ou goupillière, donné à ce genre de four qui permettait d'obtenir directement le fer à partir du minerai et sans passer par la fonte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9467d85-0152-345b-9697-4e2aa65814f0",
                                        "entry_id": "3f8749bd-5540-3c98-990d-0489141efc44",
                                        "glosses": [
                                            "Nom vernaculaire de plusieurs espèces de polygales, censées augmenter la production de lait des vaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc06d956-9f89-4b72-8e82-0e4c249c998a",
                                                "sense_id": "b9467d85-0152-345b-9697-4e2aa65814f0",
                                                "text": "La plante est, également, appelée le polygala commun, le polygala vulgaire, l’herbe à lait, le polygalon ou encore le laitier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
