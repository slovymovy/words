                "senses": [
                    {
                        "sense_id": "375bdbe2-cd6d-3b8d-9a08-883565eb50f0",
                        "entry_id": "ab989cf6-6909-3a23-bbf4-7959834d5c03",
                        "glosses": [
                            "Copy or type set in excess of a given space; (countable) an instance of this."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "811aaa63-cd91-3e48-8b22-6fcc64279dc6",
                        "entry_id": "ab989cf6-6909-3a23-bbf4-7959834d5c03",
                        "glosses": [
                            "An act of knocking over or overturning; a capsize or capsizing, an overturning, an upset."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e14ff8d9-c230-49f0-bf20-f35a24f34342",
                                "sense_id": "811aaa63-cd91-3e48-8b22-6fcc64279dc6",
                                "text": "[…] I vvas upon the Rock vvhen their Boat vvas daſh'd againſt it, and vvas over-ſet vvith the ſame Sea, under the flat bottom'd Boat, vvhere you found me. That vvas a happy Overſet for thee; vvell, is there no Gratitude due to Providence for thy Eſcape? due to Providence, ſaid he, vvhy, I thought you had ſav'd me?"
                            }
                        ]
                    },
                    {
                        "sense_id": "53725daa-16bd-3927-8c0b-84a1cbffd2e1",
                        "entry_id": "ab989cf6-6909-3a23-bbf4-7959834d5c03",
                        "glosses": [
                            "An excess, a surplus."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "95835e59-8cf8-402c-b8b7-0533b358e441",
                                "sense_id": "53725daa-16bd-3927-8c0b-84a1cbffd2e1",
                                "text": "And vvith this overſet of vvealth and pomp, that came on men in the decline of their parts and age, they, vvho vvere novv grovving into old age, became lazy and negligent in all the true concerns of the Church: […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
