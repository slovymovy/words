                        "glosses": [
                            "Parfüm, das für Männer bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "833844be-821b-4bea-94a2-cd45b2c4137e",
                                "sense_id": "4564db84-5620-3592-a7b8-93da71ca4d71",
                                "text": "„Der Jesus an allen Kreuzen, die du jemals gesehen hast, kann sich sehen lassen und könnte genauso gut als Model für Designerjeans oder Herrenparfüm auftreten.“"
                            },
                            {
                                "example_id": "2017abe7-f378-45a2-89e8-0a639728d730",
                                "sense_id": "4564db84-5620-3592-a7b8-93da71ca4d71",
                                "text": "„Aus Anlass des aktuellen Jubiläums lancierten die Hersteller nun ein Herrenparfüm, über das wir, so hofften sie, dann schreiben würden.“"
                            }
                        ],
