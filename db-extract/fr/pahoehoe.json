                        "source_entry_id": "29389228-a73f-3551-b670-2e37af6a582e",
                        "source_sense_id": "f7fb7cc9-5a3a-3eb0-bc40-938a084cc9c3",
                        "source_sense_description": "forme de lave :",
                        "target_lang_word": "pahoehoe",
