                    },
                    {
                        "translation_id": "a7637f3d-f5b7-470b-9e05-8752631757f0",
                        "source_entry_id": "fb173b8e-09ac-3f5c-97fe-2d66d12153cd",
                        "source_sense_id": "0b94fa08-c961-3071-8220-55e4e726f3bc",
                        "source_sense_description": "historisch: antikes, vor allem aus schräg angeschnittenem Schilfrohr gefertigtes Schreibgerät",
                        "target_lang_word": "calame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07e52b79-1793-3757-b91b-d4529e9eb6b3",
                                        "entry_id": "6a2f5040-8e7a-3aaa-a6f7-3f97a729995b",
                                        "glosses": [
                                            "Roseau taillé pour l’écriture, soit utilisé avec l'encre sur papyrus, parchemin, etc., soit à sec pour créer des impressions sur argile, et encore utilisé en calligraphie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1566ff-3141-46ca-a190-191617bdb523",
                                                "sense_id": "07e52b79-1793-3757-b91b-d4529e9eb6b3",
                                                "text": "Pour écrire les mots comme les nombres, ils utilisaient des calames, qui consistaient en une tige de roseau taillée au couteau, qu’ils pressaient dans des plaquettes d’argile habituellement grandes comme la paume d’une main. Cela donnait des petites encores de forme de coins ou clous — cuneus en latin, d’où le nom d’écriture cunéiforme."
                                            },
                                            {
                                                "example_id": "e8d1c66c-eb4b-41d8-b032-bd683d623c45",
                                                "sense_id": "07e52b79-1793-3757-b91b-d4529e9eb6b3",
                                                "text": "Près de lui, sur une table basse, calame et encrier, une lampe éteinte, et son livre ouvert à la première page, demeurée blanche."
                                            },
                                            {
                                                "example_id": "65b82afd-ec86-4a46-a443-f1842ef604dd",
                                                "sense_id": "07e52b79-1793-3757-b91b-d4529e9eb6b3",
                                                "text": "On trouve d’abord sur des petites tablettes d’argile cuite (les tablettes du site d’Uruk), de forme rectangulaire, des lignes courbes tracées à l’aide de la pointe d’un calame, des pictogrammes."
                                            },
                                            {
                                                "example_id": "89e51d79-5238-4e66-9648-40cfc3929df8",
                                                "sense_id": "07e52b79-1793-3757-b91b-d4529e9eb6b3",
                                                "text": "Associée au livre, la baguette du Baga peut être vue comme un stylet, ou même comme le calame, le roseau avec lequel on gravait des signes sur les tablettes d’argiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e5e433-b88e-30e4-94c5-e7ee11178c32",
                                        "entry_id": "6a2f5040-8e7a-3aaa-a6f7-3f97a729995b",
                                        "glosses": [
                                            "Plume, stylo, voire style d’un auteur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f68e449f-6f6a-421b-a7b0-6a8570627845",
                                                "sense_id": "c8e5e433-b88e-30e4-94c5-e7ee11178c32",
                                                "text": "Sous le calame de Musset, on trouve une prose désenchantée qui se lamente du mal séculaire provoqué par la fin de l’épopée napoléonienne et le retour en arrière initié par la Restauration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
