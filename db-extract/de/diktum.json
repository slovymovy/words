                "senses": [
                    {
                        "sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                        "entry_id": "6d964703-ad93-337c-a383-732fc6cb38c7",
                        "glosses": [
                            "geistreicher, bedeutsamer Ausspruch"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "3d836c36-dbb6-4edb-8d9d-f263472796d7",
                                "sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                                "text": "„Einstein war entsetzt über dieses Element des Zufalls, des Unvorhersagbaren in den grundlegenden Naturgesetzen und hat die Quantenmechanik nie wirklich akzeptiert. Seine Einstellung brachte er in seinem berühmten Diktum \"Der Herrgott würfelt nicht\" zum Ausdruck.“"
                            },
                            {
                                "example_id": "a0e7c569-faf3-4132-88de-6a39352699e7",
                                "sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                                "text": "„Das Diktum gilt noch immer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da895702-0ff8-3bac-bd4f-d282c6f3064b",
                        "entry_id": "6d964703-ad93-337c-a383-732fc6cb38c7",
                        "glosses": [
                            "Entscheid, Befehl"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4c55dbf1-f29f-4068-ab24-d45b61eb8f14",
                                "sense_id": "da895702-0ff8-3bac-bd4f-d282c6f3064b",
                                "text": "„Mit seinem Diktum will Clinton die internationale Gemeinschaft zwingen, die Blockierer härter anzupacken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1cb3d97-a46d-4501-af6c-7200c14c3631",
                        "source_entry_id": "6d964703-ad93-337c-a383-732fc6cb38c7",
                        "source_sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                        "source_sense_description": "bildungssprachlich: geistreicher, bedeutsamer Ausspruch",
                        "target_lang_word": "adage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9228eeec-4566-3c47-a15c-000f4348e45c",
                                        "entry_id": "5d684f1d-1494-34e5-b8ee-30fe2914ac74",
                                        "glosses": [
                                            "An old saying which has obtained credit by long use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84308d8-ab05-4b26-a44e-f66f474cfc48",
                                                "sense_id": "9228eeec-4566-3c47-a15c-000f4348e45c",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee72bc7-a340-398a-8caa-6831fad858fc",
                                        "entry_id": "5d684f1d-1494-34e5-b8ee-30fe2914ac74",
                                        "glosses": [
                                            "An old saying which has been overused or considered a cliché; a trite maxim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60581145-33ef-4cb6-a639-99f6f773f5de",
                                                "sense_id": "1ee72bc7-a340-398a-8caa-6831fad858fc",
                                                "text": "Like the poore Cat i’ th’ Addage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2da705e9-11c2-4ec7-9e4c-cac61b666c64",
                        "source_entry_id": "6d964703-ad93-337c-a383-732fc6cb38c7",
                        "source_sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                        "source_sense_description": "bildungssprachlich: geistreicher, bedeutsamer Ausspruch",
                        "target_lang_word": "dictum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2acfef-0171-339c-9ffe-2e36fdd9a955",
                                        "entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                                        "glosses": [
                                            "An authoritative statement; a dogmatic saying; a maxim, an apothegm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee212e23-8201-4dc1-825e-b651a39aa4b0",
                                                "sense_id": "7b2acfef-0171-339c-9ffe-2e36fdd9a955",
                                                "text": "This should not surprise us who know that van Gogh wrote: 'To paint and to love women is incompatible'; van Gogh was right for himself, which does not mean that he was right for everybody, and I will not draw from his dictum the probably incorrect conclusion that 'To paint and to love literature is incompatible.'"
                                            },
                                            {
                                                "example_id": "8cad4bf6-b384-427b-be94-e2276df6dfc7",
                                                "sense_id": "7b2acfef-0171-339c-9ffe-2e36fdd9a955",
                                                "text": "[…]a dictum which he had heard an economics professor once propound[…]"
                                            },
                                            {
                                                "example_id": "e84187a4-737e-4d20-b32f-8cfc23f6839b",
                                                "sense_id": "7b2acfef-0171-339c-9ffe-2e36fdd9a955",
                                                "text": "1. The utmost in steam producing capacity permitted by weight and dimensions; in other words, capacity to boil water—H. A. Ivatt's old dictum."
                                            },
                                            {
                                                "example_id": "dfd29bf7-d9f1-4fd3-a59f-b530a28b6361",
                                                "sense_id": "7b2acfef-0171-339c-9ffe-2e36fdd9a955",
                                                "text": "But this is not the philosophical revolution of which I speak. What Warhol's dictum amounted to was that you cannot tell when something is a work of art just by looking at it, for there is no particular way that art has to look."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6d78ff-501d-306d-a1a0-6269607c37cf",
                                        "entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                                        "glosses": [
                                            "A judicial opinion expressed by judges on points that do not necessarily arise in the case, and are not involved in it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f2efa53-649f-3cf1-a4c0-ca54df8e11b2",
                                        "entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                                        "glosses": [
                                            "The report of a judgment made by one of the judges who has given it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed069880-f881-391b-ae7c-9367c7ffb6d4",
                                        "entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                                        "glosses": [
                                            "An arbitrament or award."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
