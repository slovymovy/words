                ],
                "senses": [
                    {
                        "sense_id": "dee563f9-f31c-3ce1-ade5-518145f4a3ad",
                        "entry_id": "699bb0ca-825f-331e-ba14-89df57865e6e",
                        "glosses": [
                            "Autre écriture, moins fréquente, de états-unien."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "abc43bad-f3b3-40ab-84cc-ca8d4ddccd55",
                                "sense_id": "dee563f9-f31c-3ce1-ade5-518145f4a3ad",
                                "text": "Si le gouvernement étatsunien demande d’établir un consul au Tibet, quelle sera l’attitude du Tibet ?"
                            },
                            {
                                "example_id": "3cae71cb-44b5-41ab-abc2-a1edbbfbc61e",
                                "sense_id": "dee563f9-f31c-3ce1-ade5-518145f4a3ad",
                                "text": "La désignation des terres bombardées pendant soixante ans comme réserves naturelles permet de couvrir tant les dominations à l’œuvre par la marine étatsunienne que les résistances des habitants de Vieques."
                            },
                            {
                                "example_id": "294a8abf-1996-4af4-b446-b9fd41814656",
                                "sense_id": "dee563f9-f31c-3ce1-ade5-518145f4a3ad",
                                "text": "Ils défendent une idéologie nationaliste, autoritaire et antidémocratique via les réseaux sociaux, et s’inspirent grandement des tactiques militantes de l’alt right étatsunienne."
                            },
                            {
                                "example_id": "0408e288-df2a-481e-a259-43709564ff89",
                                "sense_id": "dee563f9-f31c-3ce1-ade5-518145f4a3ad",
                                "text": "Ce qui n'empêche pas les participants chinois au colloque d'affirmer avec satisfaction qu'il y a aussi dans leur Code civil des articles qui s'approchent de conceptions juridiques étatsuniennes."
                            }
                        ]
                    }
