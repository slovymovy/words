                                        "entry_id": "a42b2724-067e-33ea-831f-d25e80b50774",
                                        "glosses": [
                                            "Décoration même que portent les grand-croix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df9af9e-968c-4c6e-a1f5-16b9b1472544",
                                                "sense_id": "7137ae26-2cd6-3c6f-a670-04ee801458a0",
                                                "text": "On assure qu’il va recevoir la grand-croix de la Légion d’honneur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
