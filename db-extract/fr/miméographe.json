                "senses": [
                    {
                        "sense_id": "ca11003b-dcad-36c2-9fe4-bac6914ee7ac",
                        "entry_id": "9ad0e5f1-189a-352b-bed0-73aacb184a08",
                        "glosses": [
                            "Presse à imprimer à bas coût qui fonctionne en forçant l'encre à travers un pochoir ou un stencil sur du papier."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "c4313205-d588-4291-9a21-ecb9d3f9fe99",
                                "sense_id": "ca11003b-dcad-36c2-9fe4-bac6914ee7ac",
                                "text": "Non seulement King accueille le rassemblement mais, avec l’aide d’Abernathy, imprime des centaines de tracts sur le miméographe de Dexter."
                            },
                            {
                                "example_id": "ad6efc88-d9ff-44fd-bacd-20d08cba8498",
                                "sense_id": "ca11003b-dcad-36c2-9fe4-bac6914ee7ac",
                                "text": "Après avoir répondu à plusieurs articles de presse et rempli un formulaire de commande pour un miméographe à l’usage exclusif de la tribu, Thomas se rappela que, lorsqu’il était au pensionnat, il agissait de façon stratégique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8d356cf-c8d6-4fd4-8433-a9dd408909b2",
                        "source_entry_id": "9ad0e5f1-189a-352b-bed0-73aacb184a08",
                        "source_sense_id": "ca11003b-dcad-36c2-9fe4-bac6914ee7ac",
                        "target_lang_word": "mimeograph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimeograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61316d11-2eeb-39c8-8732-876027153ea6",
                                        "entry_id": "beeffda6-870d-396f-b24d-60acf5d786da",
                                        "glosses": [
                                            "A machine for making printed copies using typed stencil, eventually superseded by photocopying."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7446b27-d1cc-4ccb-a0ef-c952cf559415",
                                                "sense_id": "61316d11-2eeb-39c8-8732-876027153ea6",
                                                "text": "So it also is in regard to the mimeograph, whose forerunner, the electric pen, was born of Edison's brain in 1877. He had been long impressed by the desirability of the rapid production of copies of written documents, and, as we have seen by a previous chapter, he invented the electric pen for this purpose, only to improve upon it later with a more desirable device"
                                            },
                                            {
                                                "example_id": "11a8ce21-d687-48a8-a45b-2a69a767c896",
                                                "sense_id": "61316d11-2eeb-39c8-8732-876027153ea6",
                                                "text": "The old “work horse” of the office, the mimeograph, was a starred performer at the National Business Show, which was recently held at the New York Coliseum. Although glamour equipment such as the electronic computers have had most of the headlines in recent years, the mimeograph machine is still grinding out billions of copies of material a year."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mimeograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db0964ef-1851-3d46-a642-d3ced601c723",
                                        "entry_id": "34479e8d-444c-3dd0-bf44-fe246f5876fb",
                                        "glosses": [
                                            "To make mimeograph copies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f7af64-ba83-46be-8125-38c3036974e6",
                                                "sense_id": "db0964ef-1851-3d46-a642-d3ced601c723",
                                                "text": "Even the ultra-respectable \"Evening Transcript\", organ of the Brahmins of culture, was down for $144 for typing, mimeographing and sending out \"dope\" to the country press."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
