                "senses": [
                    {
                        "sense_id": "22e53a50-ddc9-31cb-b722-cc8c2a3a0924",
                        "entry_id": "0ac23de0-99ab-350a-ab27-934c6af555e1",
                        "glosses": [
                            "разг. повар в воинской части или в рабочей артели"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac0c8f0-24bf-4432-9619-67f2868c9388",
                                "sense_id": "22e53a50-ddc9-31cb-b722-cc8c2a3a0924",
                                "text": "Видны уже кашевары около больших дымящихся ротных котлов .."
                            },
                            {
                                "example_id": "f3b4a128-e20f-48e3-9f08-b473026260d8",
                                "sense_id": "22e53a50-ddc9-31cb-b722-cc8c2a3a0924",
                                "text": "Там и сям кашевары несли .. артельные котлы с водою, качаясь под тяжестью."
                            },
                            {
                                "example_id": "83baf17d-3a1f-4f3c-af6f-15d9935f448f",
                                "sense_id": "22e53a50-ddc9-31cb-b722-cc8c2a3a0924",
                                "text": "Кашевары, вырыв яму и притащив с разных дворов плохо лежавшие чурки, уже варили кашу."
                            },
                            {
                                "example_id": "e3791d03-c31d-45e0-aace-2b257bf831b3",
                                "sense_id": "22e53a50-ddc9-31cb-b722-cc8c2a3a0924",
                                "text": "Три кашевара развели огонь, .. рассекли баранину на куски .. и начали стряпню."
                            }
                        ]
                    }
                ],
