                "senses": [
                    {
                        "sense_id": "d515258e-81ed-3787-b30d-ff39952bfe14",
                        "entry_id": "52dc6960-0ea0-3b24-b5e9-5362d0519fd5",
                        "glosses": [
                            "Gabe (Geschenk), die man gibt, weil man selbst zuvor Empfänger eines Geschenks war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0732efdb-26bf-4a8d-a822-1bddfe77e4fe",
                                "sense_id": "d515258e-81ed-3787-b30d-ff39952bfe14",
                                "text": "„Die mittelalterliche Lehensgabe begründet das wechselseitige Verhältnis von Treue und Gefolgschaft. Nach japanischer Konventionalregel schuldet der Beschenkte dem Geber ein Gegengeschenk, welches mindestens halb so viel wert ist wie das empfangene.“"
                            },
                            {
                                "example_id": "3c0214a3-8f2e-4bf7-9f0c-52bf7df5745a",
                                "sense_id": "d515258e-81ed-3787-b30d-ff39952bfe14",
                                "text": "„Wenn man für jede Liebe Gegenliebe, für jedes Geschenk ein Gegengeschenk erwartet, darf man sich nicht wundern, wenn das Leben merkantil wird.“"
                            },
                            {
                                "example_id": "f24ab72b-d52c-472a-9856-466f47632683",
                                "sense_id": "d515258e-81ed-3787-b30d-ff39952bfe14",
                                "text": "„Anderntags gab mir Don Antonio als Gegengeschenk für den Muskatwein, den ich ihm geschickt hatte, einen Stock, der mindestens zwanzig Unzen wert war, und sein Schneider brachte mir einen Reiseanzug sowie einen blauen Überrock mit goldenen Knopflöchern, beides aus dem feinsten Tuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
