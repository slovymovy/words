        "fr-extract.jsonl": [
            {
                "entry_id": "f0bb5992-88d2-326e-936d-1749edb308a8",
                "word": "détriment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2350f329-4c41-4a9f-be79-d844c4e929a4",
                        "entry_id": "f0bb5992-88d2-326e-936d-1749edb308a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "détriments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                        "entry_id": "f0bb5992-88d2-326e-936d-1749edb308a8",
                        "glosses": [
                            "Dommage, préjudice, désavantage."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "444ef3c1-3357-42a0-a069-d50c548f626b",
                                "sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                                "text": "Où irait-on, si, sous le prétexte du bonheur général, on engraissait le consommateur au détriment du producteur ?"
                            },
                            {
                                "example_id": "d1630af0-ee00-47c2-8d19-cde9e4735d37",
                                "sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                                "text": "Entre autres, on y allègue que des informations \"qui peuvent être démontrées fausses\" ont été propagées par les avocats de Donald Trump et le réseau Fox et certains de ses animateurs, au détriment de ces deux sociétés, entre autres qu’elles auraient été fondées grâce à de l’argent des régimes cubains et vénézuéliens pour produire des machines à voler les élections."
                            },
                            {
                                "example_id": "b82f88c3-95a0-4498-bd52-65c0086a2338",
                                "sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                                "text": "Aller, tourner à mon détriment."
                            },
                            {
                                "example_id": "7d7136f6-c332-4399-9e6e-640f7d9a4fcf",
                                "sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                                "text": "Causer, recevoir un notable détriment."
                            },
                            {
                                "example_id": "8b29c08f-d4d2-4f23-aff7-27a217d302ca",
                                "sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                                "text": "Il n’acquit tant de richesses qu’au détriment de sa réputation, de son honneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "80094f51-0d25-3444-8329-689c302ad6cd",
                        "entry_id": "f0bb5992-88d2-326e-936d-1749edb308a8",
                        "glosses": [
                            "Résidus de la désagrégation d’un matériau."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fbb56a86-dfb6-475b-a450-8afff4b1866e",
                                "sense_id": "80094f51-0d25-3444-8329-689c302ad6cd",
                                "text": "Toutes ces substances sont parfaitement brutes, elles existent et existeraient indépendamment des animaux et des végétaux ; mais d'autres substances, en très grand nombre et qui paraissent également brutes, tirent leur origine du détriment des corps organisés […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e263ce3-84cf-34ce-a260-c94134c1cfa5",
                        "entry_id": "f0bb5992-88d2-326e-936d-1749edb308a8",
                        "glosses": [
                            "Restes (dépouille mortelle)."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "011fa1e4-ceef-4def-82ac-0e6e83c8bdad",
                                "sense_id": "4e263ce3-84cf-34ce-a260-c94134c1cfa5",
                                "text": "Quand le travail fut terminé, la reine voulut que son église paroissiale profitât, la première, des grâces dévolues à ces glorieux détriments et elle en ordonna l’exhibition pendant la durée de trois neuvaines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355c30fa-cd1c-413b-a26c-e59461f9eaad",
                        "source_entry_id": "f0bb5992-88d2-326e-936d-1749edb308a8",
                        "source_sense_id": "091fafed-6e7d-3b6c-8302-5bd57149b390",
                        "source_sense_description": "(Au singulier) Dommage, préjudice, désavantage.",
                        "target_lang_word": "detriment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detriment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dd9f93a-fb24-3efc-9924-b100250362fe",
                                        "entry_id": "682658fb-bc6f-3569-b561-31ade7d0c3cd",
                                        "glosses": [
                                            "Harm, hurt, damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7feaec29-b4d4-4d8a-a653-6f2e14e19e2b",
                                                "sense_id": "6dd9f93a-fb24-3efc-9924-b100250362fe",
                                                "text": "“But marriage in secret, Nikolay Vsyevolodovitch — a fatal secret. I receive money from you, and I'm suddenly asked the question, 'What's that money for?' My hands are tied; I cannot answer to the detriment of my sister, to the detriment of the family honour.”"
                                            },
                                            {
                                                "example_id": "2dd721f1-8f97-4d1b-b5f2-4ac20ac56535",
                                                "sense_id": "6dd9f93a-fb24-3efc-9924-b100250362fe",
                                                "text": "\"Would it be fair to say that when it came to making trouble, you'd make up for what you didn't absolutely know . . . and to our detriment?\""
                                            },
                                            {
                                                "example_id": "321ec99a-ed5a-4e5b-afe5-621e9bffbcea",
                                                "sense_id": "6dd9f93a-fb24-3efc-9924-b100250362fe",
                                                "text": "“There’s far more evidence for coffee’s benefits than harms,” Dr. Cryer said — which is something worth keeping in mind, he added, while you scroll through social media stories that profess the brew’s detriments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9300adf2-01b9-35a2-bbb4-cb9aecf10fdb",
                                        "entry_id": "682658fb-bc6f-3569-b561-31ade7d0c3cd",
                                        "glosses": [
                                            "A charge made to students and barristers for incidental repairs of the rooms they occupy."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                        "entry_id": "682658fb-bc6f-3569-b561-31ade7d0c3cd",
                                        "glosses": [
                                            "The position or state of a planet when it is in the sign opposite its house, considered to weaken it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e436957-f311-43dc-aafe-9bf89b1a6faf",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "Saturn, Jupiter and Mars from their conjunction to their opposition with the Sun are Oriental, and gain two fortitudes; but from their Opposition to their Conjunction are occidental, and incur two detriments."
                                            },
                                            {
                                                "example_id": "5d1da210-6894-4f10-888e-d8c4bff7cf7d",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "DEJECTION [with Astrol.] said of the planets, when in their detriment, i.e. when they have lost their force or influence by reason of being in opposition to some other, which check and contract them."
                                            },
                                            {
                                                "example_id": "175686be-63ec-41fd-ae53-9ec6bdc89f4c",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "This is infallible : Saturn out of all Dignities in his Detriment and Fall, combust : and Venus in the South-angle elevated above him, Lady of both their Nativities, in her essential and accidental Dignities; occidental from the[…]"
                                            },
                                            {
                                                "example_id": "97535ec8-e316-4e32-a22b-0b3026d4c552",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "Mercury peregrine, and in detriment or fall, retrograde or combust, in quartile or opposition of Luna from angles, Now in motion, cadent, or in via combusta, or afflicted by Saturn or Mars, shows[…]"
                                            },
                                            {
                                                "example_id": "aa9340ab-8e3c-444b-a063-cea9d2360d97",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "The dignity or debility of the planet the eclipse falls on must be noted. Eclipses that fall on a planet in detriment or fall seem to have more of an adverse effect. Eclipses that fall on a planet in its rulership or exaltation seem[…]"
                                            },
                                            {
                                                "example_id": "071bebf6-11c5-4822-baf1-32997abbc85c",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "The Moon is in her detriment in Capricorn, which is opposite Cancer. Those with the Moon in Capricorn may be afraid of their feelings, keeping them locked away. The Moon is in her fall in Scorpio, which is opposite Taurus."
                                            },
                                            {
                                                "example_id": "9191b4ad-adee-4aca-9e65-28c99343fdeb",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "Planets in their detriment do not operate well with their basic natural energies because they are not in a comfortable environment within which to do so. Planets in detriment are disorganized. The easy, peace-loving energy of Venus is[…]"
                                            },
                                            {
                                                "example_id": "fb6aae3b-0a60-47c4-bb85-4e8a1502befe",
                                                "sense_id": "8290af24-476b-30d5-9c4b-7539ed1ba2d3",
                                                "text": "The Moon is in detriment and doesn't aspect the ascendant. Mercury applies to an opposition with Jupiter without reception. Judgement: The Mercury/Jupiter opposition is not fortunate, but there are two very fortunate testimonies,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e5f4117-1176-3816-9b8e-a1fcbe9ee627",
                                        "entry_id": "682658fb-bc6f-3569-b561-31ade7d0c3cd",
                                        "glosses": [
                                            "The position or state of being eclipsed, entirely dark (sable)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f7bb1f-5cd5-4667-a077-a8bd61660c03",
                                                "sense_id": "1e5f4117-1176-3816-9b8e-a1fcbe9ee627",
                                                "text": "Argent, a Moon in her detriment or Eclipse Sable[…]"
                                            },
                                            {
                                                "example_id": "27624ff2-c5fd-4fe2-8c87-ca407aeb90f8",
                                                "sense_id": "1e5f4117-1176-3816-9b8e-a1fcbe9ee627",
                                                "text": "Moon in its Detriment, or Wane"
                                            },
                                            {
                                                "example_id": "76f5ec3a-0dd6-4f62-bdc4-a91c4900d184",
                                                "sense_id": "1e5f4117-1176-3816-9b8e-a1fcbe9ee627",
                                                "text": "Argent; a Moon in her detriment, Sable. This word is used in heraldry to denote her being eclipsed."
                                            },
                                            {
                                                "example_id": "9dc9d6a4-d398-4ba9-8fb9-e6c38010d3a0",
                                                "sense_id": "1e5f4117-1176-3816-9b8e-a1fcbe9ee627",
                                                "text": "When sable, the moon is said to be in her detriment."
                                            }
                                        ]
                                    }
                                ]
                            },
