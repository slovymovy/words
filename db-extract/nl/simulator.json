                            },
                            {
                                "target_word": "simulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                        "entry_id": "f17d883f-db1e-3f82-8f85-cfcd0b76cdb5",
                                        "glosses": [
                                            "Appareil qui permet de simuler un système quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce745f6-6b58-4af4-bb63-3f8bb4297390",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Des études sur simulateur (Rudin-Brown, 2004 ; Rudin-Brown et McCurdie, 2004 ; Lee, 1995), ainsi que des études expérimentales, laissent penser que les conducteurs de véhicules tout-terrain, de pick-up et de camionnettes évaluent leur vitesse avec moins de précision, parce qu'ils sont assis plus haut, au-dessus de la chaussée, que les conducteurs de voitures particulières."
                                            },
                                            {
                                                "example_id": "7c2324e0-0a43-406e-bc5d-0b27d6d7e807",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Les pilotes de chasse professionnels, dont le numéro 2 de la Patrouille de France, venus tester le simulateur alsacien, sont tous unanimes sur le réalisme de l'expérience."
                                            },
                                            {
                                                "example_id": "097ffc5a-5fc0-478b-942d-a522fce7618d",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Monsieur, vous avez deux options : soit vous payez une amende et vous allez peut-être au tribunal, soit vous suivez un stage sur la thématique des téléphones au volant, avec des passages dans un simulateur de conduite par exemple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2d6840-169c-3eb2-99ce-f3dbe02208cf",
                                        "entry_id": "f17d883f-db1e-3f82-8f85-cfcd0b76cdb5",
                                        "glosses": [
                                            "Simulateur-ergomètre."
                                        ],
