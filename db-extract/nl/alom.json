                "senses": [
                    {
                        "sense_id": "24bf2834-828c-3077-a88e-5cdbd002f1a6",
                        "entry_id": "6748f9ab-d19c-3373-8f41-d539031ce3b5",
                        "glosses": [
                            "overal, onder velen, op vele plekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0265adb4-9e23-46e6-a56b-b500cf8a8f2e",
                                "sense_id": "24bf2834-828c-3077-a88e-5cdbd002f1a6",
                                "text": "Barack Obama is ondertussen alom bekend."
                            },
                            {
                                "example_id": "9c0cd6bf-635c-4854-bdab-923e453ca63f",
                                "sense_id": "24bf2834-828c-3077-a88e-5cdbd002f1a6",
                                "text": "Dit verlies moeten we met z’n tweeën verwerken. ’ Knikkende hoofden en strakke gezichten alom. Haar geest schroefde het tempo op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27f11ecc-e8f6-45ea-a43f-a652eb90211e",
                        "source_entry_id": "6748f9ab-d19c-3373-8f41-d539031ce3b5",
                        "source_sense_id": "24bf2834-828c-3077-a88e-5cdbd002f1a6",
