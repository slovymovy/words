                ],
                "senses": [
                    {
                        "sense_id": "b6d11a86-10c2-3f75-bbcd-4a1236cf11b7",
                        "entry_id": "a9b1f8a2-4742-3530-bec7-01e27d32b7a9",
                        "glosses": [
                            "räumlicher Bereich in direkter Nähe zum Ufer eines Sees, Meeres oder Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2aa2c1e-bf4d-4247-8a21-6ffe3e69f59e",
                                "sense_id": "b6d11a86-10c2-3f75-bbcd-4a1236cf11b7",
                                "text": "„Israel hat vor mehr als zehn Jahren eine Blockade über das Küstengebiet verhängt, die von Ägypten mitgetragen wird.“"
                            },
                            {
                                "example_id": "20483fa8-ccde-402f-a7c9-f3e68a78dc7d",
                                "sense_id": "b6d11a86-10c2-3f75-bbcd-4a1236cf11b7",
                                "text": "„Auch die neun Besatzungsmitglieder eines im selben Küstengebiets ebenfalls in Seenot geratenen Frachters wurden laut Nachrichtenagentur NTB mittlerweile in Sicherheit gebracht.“"
                            },
                            {
                                "example_id": "7bfa6707-c160-4884-9bb6-e0e6d98be2f4",
                                "sense_id": "b6d11a86-10c2-3f75-bbcd-4a1236cf11b7",
                                "text": "„Meetom, der als Schüler einer Missionsschule Englisch gelernt hatte, war als Vermittler zwischen den Deutschen und der Bevölkerung des Küstengebiets eine Schlüsselfigur.“"
                            },
                            {
                                "example_id": "c7fa0852-2492-4378-b9cb-309117a2f718",
                                "sense_id": "b6d11a86-10c2-3f75-bbcd-4a1236cf11b7",
                                "text": "„Die europäischen Kolonialmächte, die zuvor nur Küstengebiete kontrolliert hatten, teilten den afrikanischen Kontinent in den 1880er Jahren in rasantem Tempo untereinander auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
