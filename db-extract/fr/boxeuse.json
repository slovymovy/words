                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d4d5618-bac3-327d-879e-083c2bd2f986",
                                        "entry_id": "b5369ea5-9cac-3e25-9cc2-6ceedc45d390",
                                        "glosses": [
                                            "Attributive form of boxers (“boxer shorts”)."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a245d8-a1be-4f3f-b9ef-a54e57afee11",
                                                "sense_id": "6d4d5618-bac3-327d-879e-083c2bd2f986",
                                                "text": "Jockey International, the major boxer maker, has a design for everyone: jungle prints featuring the irrepressible Garfield the cat peeping out between the leaves; […]"
                                            },
                                            {
                                                "example_id": "d16f79ab-8dda-4d03-b15a-192400ea5ab3",
                                                "sense_id": "6d4d5618-bac3-327d-879e-083c2bd2f986",
                                                "text": "My husband, Zac, noticed my laundry shortcomings when his sock and boxer drawer came up empty, and kindly asked if I could please do some laundry."
                                            },
                                            {
                                                "example_id": "a044e1f8-0bc9-4314-80e7-2a0be7eaeb5f",
                                                "sense_id": "6d4d5618-bac3-327d-879e-083c2bd2f986",
                                                "text": "The boxer-type underwear would tear and get tangled up, and the brief kind would get too binding and hot, so we might not wear either."
                                            }
                                        ]
                                    }
                                ]
