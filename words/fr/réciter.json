                    "frequency": "Middle",
                    "semantic_group_id": "dire_de_memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'est levé pour <w>réciter</w> un poème devant toute la classe."
                        },
                        {
                            "text": "Chaque soir avant de dormir, elle <w>récite</w> une prière en silence dans sa chambre."
                        }
                    ],
