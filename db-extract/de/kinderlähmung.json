                        "glosses": [
                            "Poliomyélite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5bd0d82-ccec-45fc-ad5a-1b299145a8bd",
                                "sense_id": "dd74970d-4166-3200-89ae-5ab97caf1e83",
                                "text": "Und auch an anderen Orten, an denen Polio als ausgerottet galt, hat man Ähnliches beobachtet: Bereits im März gab es in Israel einen Fall von Kinderlähmung bei einem dreijährigen Mädchen.",
                                "translation": "Des cas similaires ont également été observés dans d'autres endroits où la polio était considérée comme éradiquée : En mars déjà, un cas de poliomyélite a été enregistré en Israël chez une fillette de trois ans."
                            }
                        ]
                    }
