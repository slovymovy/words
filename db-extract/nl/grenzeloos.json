                ],
                "senses": [
                    {
                        "sense_id": "027735b3-b47d-3827-be1d-01eeca52ae85",
                        "entry_id": "a1677dea-7a0a-373d-828d-180a7c6753a3",
                        "glosses": [
                            "zonder landsgrenzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65dd9d13-ee87-4941-aa2e-ad035351c5f3",
                                "sense_id": "027735b3-b47d-3827-be1d-01eeca52ae85",
                                "text": "We leven in een grenzeloos Europa."
                            }
                        ]
                    },
                    {
                        "sense_id": "be8863ed-2f20-3d71-858c-cf5fc94f0163",
                        "entry_id": "a1677dea-7a0a-373d-828d-180a7c6753a3",
                        "glosses": [
                            "niet beperkt door landsgrenzen, internationaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6134ac-b061-44fe-93fb-b11d71506516",
                                "sense_id": "be8863ed-2f20-3d71-858c-cf5fc94f0163",
                                "text": "Kunst is tijd- en grenzeloos."
                            }
                        ]
                    },
                    {
                        "sense_id": "edb81e40-7dc4-3089-afc5-1a6745fd369e",
                        "entry_id": "a1677dea-7a0a-373d-828d-180a7c6753a3",
                        "glosses": [
                            "zonder grenzen, beperkingen, oneindig groot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39230199-fdc0-42f0-b6f8-169078b8a655",
                                "sense_id": "edb81e40-7dc4-3089-afc5-1a6745fd369e",
                                "text": "De mogelijkheden zijn grenzeloos."
                            },
                            {
                                "example_id": "7582da05-ad90-4631-91d7-fac3c47a887b",
                                "sense_id": "edb81e40-7dc4-3089-afc5-1a6745fd369e",
                                "text": "Ik had een grenzeloos vertrouwen in hem."
                            },
                            {
                                "example_id": "badb389f-2064-4857-86b2-3fef303d2562",
                                "sense_id": "edb81e40-7dc4-3089-afc5-1a6745fd369e",
                                "text": "De liedjes zijn van een grenzeloze pracht."
                            },
                            {
                                "example_id": "25360b89-18b9-4adb-8550-8dc8270f3dc4",
                                "sense_id": "edb81e40-7dc4-3089-afc5-1a6745fd369e",
                                "text": "De Amerikaanse vicepresident Vance zegt te denken aan de miljoenen christenen over de hele wereld die van de paus hielden. De Israëlische president Herzog roemt Franciscus als een \"man van diep geloof en grenzeloze compassie\"."
                            }
                        ]
                    }
