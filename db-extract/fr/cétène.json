                        "entry_id": "8d7ff40e-1a60-3e41-b9af-9998fc89d7bb",
                        "glosses": [
                            "Composé éthylique, gaz toxique de formule semi-développée H₂C=C=O, instable dans les conditions normales de température et de pression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6817a129-59b9-40fc-ae21-26bb6df83940",
                                "sense_id": "f36a434b-696b-3df3-a428-09d1f1826b25",
                                "text": "Le tautomère du cétène est l’éthynol."
                            },
                            {
                                "example_id": "0e301f2c-5dc4-4437-acde-b3c59bb877cf",
                                "sense_id": "f36a434b-696b-3df3-a428-09d1f1826b25",
                                "text": "Le cétène lui-même est préparé habituellement par pyrolyse à haute température de l’acétone, mais certains cétènes se préparent facilement en solution."
                            }
                        ]
                    }
