{
    "word_family": [
        "pousser",
        "repousse",
        "repoussoir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0122379c-9546-3b11-8ded-b3b680cb984e",
                    "sense_definition": "Remettre à plus tard un événement, une réunion ou une échéance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison du mauvais temps, les organisateurs ont décidé de <w>repousser</w> le festival au mois prochain."
                        },
                        {
                            "text": "Nous devons <w>repousser</w> la date de cette réunion car le directeur est absent."
                        }
                    ],
                    "synonyms": [
                        "reporter",
                        "différer",
                        "ajourner"
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "repousser la date",
                        "repousser une réunion",
                        "repousser un rendez-vous",
                        "repousser l'échéance"
                    ]
                },
                {
                    "sense_id": "898a1d04-1f8c-3d66-b37b-74c3ac7134ed",
                    "sense_definition": "Faire reculer ou éloigner par la force physique ou militaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont réussi à <w>repousser</w> l'ennemi hors des frontières après plusieurs heures de combat."
                        },
                        {
                            "text": "Le gardien a levé la main pour <w>repousser</w> le ballon au dernier moment."
                        }
                    ],
                    "synonyms": [
                        "écarter",
                        "chasser",
                        "reculer"
                    ],
                    "antonyms": [
                        "attirer"
                    ],
                    "common_phrases": [
                        "repousser l'ennemi",
                        "repousser une attaque",
                        "repousser les assaillants"
                    ]
                },
                {
                    "sense_id": "93e25960-3f2b-310f-aa8d-e02f286ada31",
                    "sense_definition": "Refuser nettement une demande, une offre ou une proposition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "refus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité a immédiatement <w>repoussé</w> notre proposition de budget sans explication."
                        },
                        {
                            "text": "Elle a fermement <w>repoussé</w> l'offre d'emploi qu'une entreprise concurrente lui avait transmise."
                        }
                    ],
                    "synonyms": [
                        "rejeter",
                        "décliner",
                        "refuser"
                    ],
                    "antonyms": [
                        "accepter",
                        "accueillir"
                    ],
                    "common_phrases": [
                        "repousser une offre",
                        "repousser une proposition",
                        "repousser une demande"
                    ]
                },
                {
                    "sense_id": "dbab39d4-eca3-33c2-8439-f5bdb9199a96",
                    "sense_definition": "Croître de nouveau, en parlant des végétaux, des cheveux ou des poils.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir été coupée au printemps, l'herbe du jardin commence déjà à <w>repousser</w>."
                        },
                        {
                            "text": "Ses cheveux <w>repoussent</w> très vite depuis qu'elle utilise ces soins naturels."
                        }
                    ],
                    "synonyms": [
                        "reverdir",
                        "renaître"
                    ],
                    "common_phrases": [
                        "repousser vite",
                        "laisser repousser"
                    ]
                },
                {
                    "sense_id": "96aa58d1-c7df-3e8f-a249-1fd0e8d86e85",
                    "sense_definition": "Provoquer un sentiment de dégoût ou de répulsion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "refus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette odeur nauséabonde dans la cuisine me <w>repousse</w> complètement."
                        },
                        {
                            "text": "Son comportement agressif et méprisant finit par <w>repousser</w> tous ses collègues."
                        }
                    ],
                    "synonyms": [
                        "dégoûter",
                        "répugner"
                    ],
                    "antonyms": [
                        "attirer",
                        "séduire"
                    ]
                },
                {
                    "sense_id": "8da0c9be-d638-3dd4-8723-e6282d59bf7f",
                    "sense_definition": "Exercer une force de réaction ou reculer violemment lors d'une décharge ou d'une détente.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention lorsque tu tires, car ce vieux fusil de chasse <w>repousse</w> violemment contre l'épaule."
                        },
                        {
                            "text": "Le mécanisme ne s'enclenche plus car le ressort ne <w>repousse</w> plus assez fort."
                        }
                    ],
                    "synonyms": [
                        "reculer"
                    ]
                }
            ]
        }
    ]
}