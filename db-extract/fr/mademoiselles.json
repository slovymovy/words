                        "examples": [
                            {
                                "example_id": "66e6964d-1978-4967-96e4-ab1a372c42fa",
                                "sense_id": "5b803eba-42c4-38ad-82e4-145fbcf9deac",
                                "text": "Les nombreuses Mademoiselles du lieu l’appelaient Max, sans façons, y compris la négresse."
                            },
                            {
                                "example_id": "7a7215ba-2810-4b04-91cc-121971c08057",
                                "sense_id": "5b803eba-42c4-38ad-82e4-145fbcf9deac",
                                "text": "Une circulaire met fin aux « mademoiselles » dans les formulaires administratifs"
                            },
                            {
                                "example_id": "6d31bc52-d192-4f0f-affa-22574892db85",
                                "sense_id": "5b803eba-42c4-38ad-82e4-145fbcf9deac",
                                "text": "A défaut d’avoir pu conserver la case qui leur était réservée dans les formulaires administratifs, les mademoiselles pourront donc se consoler avec un jus pensé rien que pour elles par le grand Alberto Morillas …."
                            }
                        ]
