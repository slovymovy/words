                                    },
                                    {
                                        "sense_id": "a0e4b41d-c12c-3d1b-a114-a6a7d49b9a97",
                                        "entry_id": "5b02463c-eb7a-3115-959e-b04a9cd8753f",
                                        "glosses": [
                                            "A person from Slovenia."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eacfaea4-fa08-41c6-b9dd-1667367c13d1",
                                                "sense_id": "a0e4b41d-c12c-3d1b-a114-a6a7d49b9a97",
                                                "text": "Mom had called Cory, who contacted Vlado, who brought a crew of Slovenians over to help."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c7f9b6d-8222-42fe-b9de-5b5ba766eb66",
