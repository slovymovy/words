                                    {
                                        "sense_id": "ca6bfaaa-99e5-3c53-aed9-ad182d461d66",
                                        "entry_id": "89bc3ff6-adcc-3b92-8ac2-fb6071fc16ec",
                                        "glosses": [
                                            "nominativ plurálu středního rodu adjektiva ženský"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
