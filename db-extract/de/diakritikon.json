                    {
                        "sense_id": "ecfe313c-39d2-369a-a732-3eb304655fdb",
                        "entry_id": "764fef20-e03b-3cc2-a8d5-8e59a9a8d407",
                        "glosses": [
                            "zusätzliches Zeichen zu den Buchstaben eines Schriftsystems, um unterschiedliche Dinge wie Akzent oder die genaue Aussprache anzuzeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d383b8-ed37-468c-add6-4cd2213c3895",
                                "sense_id": "ecfe313c-39d2-369a-a732-3eb304655fdb",
                                "text": "Die Cedille ist ein Diakritikon im Französischen, um eine bestimmte Lautqualität anzuzeigen."
                            },
                            {
                                "example_id": "b1b42302-31df-48d1-96df-0e4eb81fc84b",
                                "sense_id": "ecfe313c-39d2-369a-a732-3eb304655fdb",
                                "text": "„Darüber hinaus wird (b) das Zeicheninventar dadurch gering gehalten, daß einige Silbenzeichen in verkleinerter Form auch als Diakritika verwendet werden.“"
                            },
                            {
                                "example_id": "397a5fe9-1ff4-44ed-822a-9bab104b4de4",
                                "sense_id": "ecfe313c-39d2-369a-a732-3eb304655fdb",
                                "text": "„Insgesamt existieren circa 25 solcher Diakritika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
