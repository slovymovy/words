                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36dffd85-0812-4074-9f56-59747b649f46",
                        "source_entry_id": "953afdf6-bb62-38ba-8160-dd53d797d990",
                        "source_sense_id": "cd90e7ab-5495-3160-834e-f514e6ee3fe6",
                        "target_lang_word": "Charlotte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charlotte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71b1ea66-4d43-3a00-b94f-33ac1168e19d",
                                        "entry_id": "1d051c74-c197-3e9c-9996-cb37ab21be3e",
                                        "glosses": [
                                            "A female given name from French."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d2e1a3-f6b0-4c38-b875-047e0cde6bcc",
                                                "sense_id": "71b1ea66-4d43-3a00-b94f-33ac1168e19d",
                                                "text": "My Charlotte conquers with a smile, / And reigneth queen of love.\nIn the home-circle and among her companions, Charlotte lays aside her queenship and becomes a gentle Lottie."
                                            },
                                            {
                                                "example_id": "9958b8bc-4ddc-4283-9561-da6078264020",
                                                "sense_id": "71b1ea66-4d43-3a00-b94f-33ac1168e19d",
                                                "text": "\"Here's Totty! By-and-by, what's her other name? She wasn't christened Totty.\" \"Oh, sir, we call her sadly out of name. Charlotte's her christened name. It's a name i' Mr. Poyser's family; his grandmother was named Charlotte. But we began calling her Lotty, and now it's got to Totty. To be sure it's more like a name for a dog than a Christian child.\""
                                            },
                                            {
                                                "example_id": "114b3a73-f2f9-4ae6-ab5f-8364542a92f9",
                                                "sense_id": "71b1ea66-4d43-3a00-b94f-33ac1168e19d",
                                                "text": "'Can I call you Charlotte?'\n'No. I hate the name, makes me sound like a Victorian aunt. I'm Charlie, and no, you can't call me that either.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b948fe52-0d84-34c2-aea2-4cb39632ab38",
                                        "entry_id": "1d051c74-c197-3e9c-9996-cb37ab21be3e",
                                        "glosses": [
                                            "A civil parish of Queens County, Prince Edward Island, Canada."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d426080c-1573-3f8c-b7b7-f1c1c99c0947",
                                        "entry_id": "1d051c74-c197-3e9c-9996-cb37ab21be3e",
                                        "glosses": [
                                            "A city, the county seat of Eaton County, Michigan, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1f11a7f-fa1e-36d4-82da-db270693e6c4",
                                        "entry_id": "1d051c74-c197-3e9c-9996-cb37ab21be3e",
                                        "glosses": [
                                            "The largest city in North Carolina, United States and the county seat of Mecklenburg County."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "558deccd-99cd-46c6-a2e2-7ff9d517ac90",
                                                "sense_id": "e1f11a7f-fa1e-36d4-82da-db270693e6c4",
                                                "text": "The past three decades have been a roller-coaster ride for the Charlotte, N.C., company, aiming to keep investors on a sugar high as it works out how to expand while remaining true to its heritage of serving fresh doughnuts."
                                            },
                                            {
                                                "example_id": "70f6938a-8053-4126-b49a-d18ea0026190",
                                                "sense_id": "e1f11a7f-fa1e-36d4-82da-db270693e6c4",
                                                "text": "Local, state and national Republicans have accused Lyles and other Democrats who lead Charlotte of installing criminal justice policies at the expense of public safety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cda58c-0761-35b8-beed-99e6e57ad8d6",
                                        "entry_id": "1d051c74-c197-3e9c-9996-cb37ab21be3e",
                                        "glosses": [
                                            "A town, the county seat of Dickson County, Tennessee, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad82c0df-e4ba-3b21-a871-a7c67aa3fe77",
                                        "entry_id": "1d051c74-c197-3e9c-9996-cb37ab21be3e",
                                        "glosses": [
                                            "University of North Carolina at Charlotte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Charlotte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef9a8858-b514-348d-8357-a3be16483b5f",
                                        "entry_id": "b880395b-21db-3878-b366-57e9818b8ae6",
                                        "glosses": [
                                            "A type of women's bonnet popular in the 18th and 19th centuries."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "historical",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c555b8-8065-49ed-bb6a-08722271297a",
                                                "sense_id": "ef9a8858-b514-348d-8357-a3be16483b5f",
                                                "text": "The Charlotte bonnet, form'd to please, / And Strelitz coif she wore with ease."
                                            },
                                            {
                                                "example_id": "cbdb17b6-9013-47d4-9d99-66bf82357e81",
                                                "sense_id": "ef9a8858-b514-348d-8357-a3be16483b5f",
                                                "text": "the Charlotte bonnet, from the Sorrows of Werther, was the most becoming and elegantly retired bonnet ever yet sported for walking."
                                            },
                                            {
                                                "example_id": "73d794c8-59db-4cec-b01d-42656dad3d76",
                                                "sense_id": "ef9a8858-b514-348d-8357-a3be16483b5f",
                                                "text": "Women now resembled well-rounded cabbages from which protruded a tiny head crushed beneath a Charlotte hat covered with plumes and gew-gaws."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
