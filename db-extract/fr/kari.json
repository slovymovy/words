                        "tags": [],
                        "form": "carry"
                    },
                    {
                        "form_id": "0bf48663-f65c-420c-83a6-8a198d8c670f",
                        "entry_id": "da37a75b-6cb9-3128-9df5-78b41575f312",
                        "tags": [],
                        "form": "curry"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8da99307-fc84-38f8-be50-f3779b71fe1b",
                        "entry_id": "da37a75b-6cb9-3128-9df5-78b41575f312",
                        "glosses": [
                            "Variante de cari."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "59746d58-6cc1-42f6-a629-87ec614bb25a",
                                "sense_id": "8da99307-fc84-38f8-be50-f3779b71fe1b",
                                "text": "Je fus parfaitement surpris de voir mes jolies voisines empiler sur leur assiette d’énormes cuillerées de riz qu'elles entouraient d’autres légumes et de viandes de toutes sortes, saupoudrer le tout de fortes quantités de piment et de kari, puis porter délicatement à leurs lèvres cette singulère composition qui rappelle le thé de madame Gibou."
                            },
                            {
                                "example_id": "d1019902-5b22-4aef-bd04-7f779793fb21",
                                "sense_id": "8da99307-fc84-38f8-be50-f3779b71fe1b",
                                "text": "Deux poivrières à compartiments, contenant quatre sortes de sauces diaboliques à bases de kari et de poivre rouge accompagnaient les cruches."
                            }
                        ]
                    },
                    {
                        "sense_id": "809bb657-d612-3f3b-93df-daa2ef8551b2",
                        "entry_id": "da37a75b-6cb9-3128-9df5-78b41575f312",
                        "glosses": [
                            "Plat traditionnel réunionnais ou mauricien d’origine tamoule, utilisant ces épices."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "27fa0eb9-ecd3-4157-bcb2-4122488db152",
                                "sense_id": "809bb657-d612-3f3b-93df-daa2ef8551b2",
                                "text": "Certains plats sont cencés être à la fois le riz et le kari : un kari de manioc ou un kari de \" fouyapin \" par exemple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e9fdafd-e49b-45c4-91bf-767193cc1c30",
                        "source_entry_id": "da37a75b-6cb9-3128-9df5-78b41575f312",
                        "target_lang_word": "curry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
