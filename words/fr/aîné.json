                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme c'est l'<w>aîné</w> de la famille, il aide souvent ses parents à la maison."
                        },
                        {
                            "text": "L'<w>aînée</w> veille attentivement sur son petit frère à la sortie des classes."
                        }
                    ],
                    "synonyms": [
