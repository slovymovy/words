                    {
                        "translation_id": "8f025e0b-b80c-4289-aedb-ecda41ec56de",
                        "source_entry_id": "92eab6cf-658a-34c0-97e0-e920272ffd60",
                        "source_sense_id": "a1a6f6b6-04b9-331c-9103-dc404a18ecbd",
                        "target_lang_word": "meteoroide",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteoroide",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "721ece85-db19-388f-8235-7f7f5657fc47",
                                        "entry_id": "e251cea4-c469-33c7-ad3b-ab8f25eba849",
                                        "glosses": [
                                            "Pequeño cuerpo rocoso del espacio. Si penetra en la atmósfera recibe el nombre de meteoro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c50b303-bdd6-4aad-9cbf-1002fcfb4a07",
                                                "sense_id": "721ece85-db19-388f-8235-7f7f5657fc47",
                                                "text": "Los meteoros son las estrellas fugaces, o estelas de luz, que se observan cuando un meteoroide cruza la atmósfera."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2492ac1-3de0-4fd7-a9cf-7dae9c8ff584",
                        "source_entry_id": "92eab6cf-658a-34c0-97e0-e920272ffd60",
                        "source_sense_id": "a1a6f6b6-04b9-331c-9103-dc404a18ecbd",
                        "target_lang_word": "метео́рное те́ло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5a3b8a9f-ae2e-4380-83d8-29a37377ad66",
                        "source_entry_id": "92eab6cf-658a-34c0-97e0-e920272ffd60",
                        "source_sense_id": "a1a6f6b6-04b9-331c-9103-dc404a18ecbd",
                        "target_lang_word": "метеоро́ид",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "метеоро́ид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1900befe-3bf2-34fc-8c53-294eec762f2f",
                                        "entry_id": "7d9968f7-266d-325f-bf25-5d64642a0b68",
                                        "glosses": [
                                            "астрон. твёрдый объект, движущийся в межпланетном пространстве, размером значительно меньше астероида, но значительно больше атома"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc8c2369-e0c4-4b6f-8c07-8db387f50798",
                                                "sense_id": "1900befe-3bf2-34fc-8c53-294eec762f2f",
                                                "text": "На протяжении нескольких дней максимальной активности потока метеоров на высоте около 30 км летал американский высотный зонд — собирал частицы, среди которых вполне могли оказаться несгоревшие метеороиды."
                                            },
                                            {
                                                "example_id": "5395ac26-8713-4812-acb2-af54fb56cfab",
                                                "sense_id": "1900befe-3bf2-34fc-8c53-294eec762f2f",
                                                "text": "Метеороид — это тело, которое летает вне атмосферы Земли, в околоземном пространстве. ❬…❭ Разница между метеороидами, астероидами и кометами принципиально только в размерах и, может быть, в орбитах. Считается, что метеор и метеороид это тело примерно так в несколько десятков метров."
                                            },
                                            {
                                                "example_id": "01520fad-75b6-4464-90b5-66c707042be1",
                                                "sense_id": "1900befe-3bf2-34fc-8c53-294eec762f2f",
                                                "text": "Малые тела Солнечной системы — это метеороиды, астероиды, кометы. ❬…❭ Что же касается терминологии метеоритно — метеорной, то немного поясню. Пока тело находится в космическом пространстве, это метеороид. Когда оно попадает в атмосферу Земли, то становится метеором, и мы видим яркий след летящего метеора в атмосфере. А когда оно падает на Землю, вот это уже метеорит."
                                            },
                                            {
                                                "example_id": "6180be39-c10e-4c21-8011-5ebca357108f",
                                                "sense_id": "1900befe-3bf2-34fc-8c53-294eec762f2f",
                                                "text": "Простые наблюдения глазом «падающих звёзд» были объяснены учёными, как свечение при сгорании внеземных массивных тел (метеороидов и метеоров) в верхней атмосфере."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
