                "senses": [
                    {
                        "sense_id": "4c48b8e4-ece9-3e8a-87f4-9fff4a67f405",
                        "entry_id": "cc619030-a805-3c23-8028-bf9d03b71773",
                        "glosses": [
                            "openbare inrichting waar men tegen betaling een bad of douche kan nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b24a1c-0df9-4393-9f7e-03b2e96279a3",
                                "sense_id": "4c48b8e4-ece9-3e8a-87f4-9fff4a67f405",
                                "text": "Toen nog niet alle woningen een eigen douche of bad hadden, ging men wekelijks naar het badhuis"
                            },
                            {
                                "example_id": "8c5ec8d0-a4ee-4fce-8219-d244964f2c01",
                                "sense_id": "4c48b8e4-ece9-3e8a-87f4-9fff4a67f405",
                                "text": "Ik moest denken aan de badhuizen waar ik als kind kwam en waar ik van vrouwenlichaam naar vrouwenlichaam werd meegedragen, onder twee massieve borsten het martelende gekneed van goedbedoelende grote handen zachtjes kermend verdroeg, want wie wil er nou niet schoon uit het badhuis komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74fcc673-b57c-454e-951e-b8a392ff3b9d",
                        "source_entry_id": "cc619030-a805-3c23-8028-bf9d03b71773",
                        "source_sense_id": "4c48b8e4-ece9-3e8a-87f4-9fff4a67f405",
                        "source_sense_description": "openbare inrichting waar men tegen betaling een bad of douche kan nemen",
                        "target_lang_word": "Badehaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Badehaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "199eb34a-5ba6-3a5f-9230-0bba2912ed60",
                                        "entry_id": "d5af4f68-27bc-318c-a3d2-64bedf3a981b",
                                        "glosses": [
                                            "öffentliches Bad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f6be83d-63ed-4124-b3b9-7d0dda476087",
                                                "sense_id": "199eb34a-5ba6-3a5f-9230-0bba2912ed60",
                                                "text": "„Schneider will uns noch ein Badehaus zeigen.“"
                                            },
                                            {
                                                "example_id": "17e65dbf-599e-4bdf-bb02-41a6257db44f",
                                                "sense_id": "199eb34a-5ba6-3a5f-9230-0bba2912ed60",
                                                "text": "„Der Herrenhof bestand aus der Tenne, den Hofgebäuden, den Ställen, dem Badehaus, dem Seitengebäude und endlich dem grossen, noch im Bau begriffenen steinernen Wohnhause mit der halbkreisförmigen Vorderfront.“"
                                            },
                                            {
                                                "example_id": "043f9f1e-f07c-4a21-b0aa-d2d9f25a2e09",
                                                "sense_id": "199eb34a-5ba6-3a5f-9230-0bba2912ed60",
                                                "text": "„Als das Gnadenbild seine Wundertaten einstellte (oder die Menschen aufhörten, daran zu glauben), waren die Leute von Zehma so vernünftig, die Kapelle wieder in ein Badehaus zu verwandeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
