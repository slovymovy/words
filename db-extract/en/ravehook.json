                            {
                                "example_id": "fe48df04-c8ec-439a-b71c-29db4db7863b",
                                "sense_id": "1d1ba004-4f17-3c68-aa7f-28c59d70edb9",
                                "text": "2012, J. E. Fender, The Lucifer Cypher\nSmall fires […] smoldered in half a dozen places, where the few workmen paying oakum into Hampshires hull seams with ravehooks' would periodically repair to warm themselves."
                            },
                            {
                                "example_id": "e7c46d60-2e7b-4b52-8ea1-3a28fe51a651",
                                "sense_id": "1d1ba004-4f17-3c68-aa7f-28c59d70edb9",
                                "text": "2014, Laura London, The Windflower\nBut the ship's carpenter had cut his hand open on a ravehook while cleaning out some old caulking on the fo'c'sle, and Cat stayed aloft to attend him."
                            }
                        ]
