                    }
                ],
                "senses": [
                    {
                        "sense_id": "29e6ef29-8012-3913-a410-816683c5b02f",
                        "entry_id": "ed549f23-ce8d-37e7-bd5f-05b6a0699b28",
                        "glosses": [
                            "Plancton permanent, composé d’espèces végétales ou animales qui vivent toute leur existence sous forme planctonique, par opposition au méroplancton."
                        ],
                        "tags": [
                            "Hydrobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6b4b6dee-ec8e-453a-93e2-bfcaaea4808c",
                                "sense_id": "29e6ef29-8012-3913-a410-816683c5b02f",
                                "text": "Une autre distinction, fondée sur une caractéristique essentielle du zooplancton, sépare l’holoplancton qui comprend les organismes appartenant tout leur cycle vital au monde planctonique, du méroplancton dont les représentants ne sont planctoniques que durant une partie de ce cycle."
                            },
                            {
                                "example_id": "6d737991-2bce-420f-b7c3-017da0088a1e",
                                "sense_id": "29e6ef29-8012-3913-a410-816683c5b02f",
                                "text": "En biologie marine, l’holoplancton est l’ensemble des organismes qui passent tout leur cycle de vie dans la colonne d’eau, faisant partie du plancton."
                            },
                            {
                                "example_id": "0179c463-772e-4ab5-9c76-066efdc4c659",
                                "sense_id": "29e6ef29-8012-3913-a410-816683c5b02f",
                                "text": "L’holoplancton comprend les organismes unicellulaires, les Cnidaires Siphonophores, Les Chaetognathes, les Annélides errantes, certains crustacés comme les Copépodes et les Ostracodes."
                            }
                        ]
                    }
                ],
