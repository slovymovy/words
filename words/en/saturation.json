{
    "word_family": [
        "saturate",
        "saturated",
        "saturating"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "feab6767-78bc-3652-9b10-1aa9ff4d8153",
                    "sense_definition": "The intensity or vividness of a color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist adjusted the <w>saturation</w> to make the red paint look more vibrant."
                        },
                        {
                            "text": "High <w>saturation</w> makes the colors in the photograph appear very bright and intense."
                        }
                    ],
                    "synonyms": [
                        "vividness",
                        "intensity"
                    ],
                    "common_phrases": [
                        "color saturation"
                    ]
                },
                {
                    "sense_id": "95b4ec7a-4c55-32c1-b1ac-29fa683888de",
                    "sense_definition": "The state of the atmosphere when it is filled with water vapor, reaching 100% humidity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air reached <w>saturation</w> during the night, leading to heavy fog in the morning."
                        },
                        {
                            "text": "When the air reaches <w>saturation</w>, water vapor begins to condense into dew."
                        }
                    ],
                    "common_phrases": [
                        "atmospheric saturation"
                    ]
                },
                {
                    "sense_id": "f00c2d1d-62ef-3660-9f26-d0c13095a711",
                    "sense_definition": "The state of a market when it is flooded with a product and no more can be sold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "market_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company struggled to grow because the market had reached total <w>saturation</w>."
                        },
                        {
                            "text": "Market <w>saturation</w> means that almost everyone who wants the product already owns one."
                        }
                    ],
                    "synonyms": [
                        "oversupply"
                    ],
                    "common_phrases": [
                        "market saturation"
                    ]
                },
                {
                    "sense_id": "befec49b-d583-3fc2-803d-505bb1651bf0",
                    "sense_definition": "The act of soaking something completely or the process of becoming completely soaked.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>saturation</w> of the soil with water caused the basement to flood."
                        },
                        {
                            "text": "Complete <w>saturation</w> of the sponge ensures it can hold no more liquid."
                        }
                    ],
                    "synonyms": [
                        "soaking",
                        "drenching"
                    ]
                },
                {
                    "sense_id": "3674e242-ce8e-3e34-804d-4f3b4de81247",
                    "sense_definition": "The state of a solution that has dissolved the maximum possible amount of a substance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist heated the liquid to increase the <w>saturation</w> point of the salt."
                        },
                        {
                            "text": "At <w>saturation</w>, no more sugar will dissolve in the water."
                        }
                    ],
                    "common_phrases": [
                        "point of saturation"
                    ]
                },
                {
                    "sense_id": "134e318c-4a0c-35e5-bc49-2acabcc3d955",
                    "sense_definition": "The condition where a system reaches its maximum capacity and cannot increase its output further.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "limit_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The amplifier was pushed to <w>saturation</w>, causing the sound to become distorted."
                        },
                        {
                            "text": "Modulation often requires that amplifiers operate below <w>saturation</w>."
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "maximum"
                    ],
                    "common_phrases": [
                        "reach saturation"
                    ]
                }
            ]
        }
    ]
}