                "senses": [
                    {
                        "sense_id": "5474c516-2508-3ab8-b678-8121a77574af",
                        "entry_id": "f647ee58-add8-3dd0-8c29-230e3717be46",
                        "glosses": [
                            "Dünkel, der auf den Sprecher selbst bezogen ist, sich selbst als überlegen auffasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77140c4f-b04f-4687-ba60-a08f289f0168",
                                "sense_id": "5474c516-2508-3ab8-b678-8121a77574af",
                                "text": "„Ich zweifelte nicht am Erfolg, und diese Gewißheit war nicht frei von Eigendünkel.“"
                            },
                            {
                                "example_id": "33075cd9-59a8-4b50-9cd6-d9d3c13dbe45",
                                "sense_id": "5474c516-2508-3ab8-b678-8121a77574af",
                                "text": "„Jede verschmähte Geliebte aber vermag unseren Eigendünkel auf eine ziemlich schäbige Art zu erpressen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aa55774-96d1-4fb7-8500-55aca0bc87a2",
                        "source_entry_id": "f647ee58-add8-3dd0-8c29-230e3717be46",
                        "source_sense_id": "5474c516-2508-3ab8-b678-8121a77574af",
                        "source_sense_description": "Dünkel, der auf den Sprecher selbst bezogen ist, sich selbst als überlegen auffasst",
                        "target_lang_word": "conceit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conceit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8797090e-f2b5-371a-9a04-e9413576149b",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "Something conceived in the mind; an idea, a thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5536106-1758-4589-b100-d717bcadefe5",
                                                "sense_id": "8797090e-f2b5-371a-9a04-e9413576149b",
                                                "text": "In laughing, there ever procedeth a conceit of somewhat ridiculous."
                                            },
                                            {
                                                "example_id": "75f65c6b-a681-41fd-bba4-2538fe63f49f",
                                                "sense_id": "8797090e-f2b5-371a-9a04-e9413576149b",
                                                "text": "a man wise in his own conceit"
                                            },
                                            {
                                                "example_id": "d3ea09e7-298e-497b-8656-9fec99737d19",
                                                "sense_id": "8797090e-f2b5-371a-9a04-e9413576149b",
                                                "text": "It was after a night like this that I shocked the community with a queer conceit about the burial of the rich and celebrated Squire Brewster […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3516b4a-a9dd-3dd6-a052-df5d6ac2bc35",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "The faculty of conceiving ideas; mental faculty; apprehension."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648c9fea-8db1-485c-ad17-405fa6c2de76",
                                                "sense_id": "f3516b4a-a9dd-3dd6-a052-df5d6ac2bc35",
                                                "text": "a man of quick conceit"
                                            },
                                            {
                                                "example_id": "8099e781-ef4a-4e47-9b50-a2b7031b7368",
                                                "sense_id": "f3516b4a-a9dd-3dd6-a052-df5d6ac2bc35",
                                                "text": "How often, alas! did her eyes say unto me that they loved! and yet I, not looking for such a matter, had not my conceit open to understand them.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4284e9c7-8067-3e0c-aa49-bc3dd4f95e62",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "Quickness of apprehension; active imagination; lively fancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81d9192-a71d-43b6-bd43-54ed8902832d",
                                                "sense_id": "4284e9c7-8067-3e0c-aa49-bc3dd4f95e62",
                                                "text": "His wit's as thick as Tewksbury mustard; there is no more conceit in him than is in a mallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7913af-b9ad-353f-9b83-a55cc158f9e3",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "Opinion, (neutral) judgment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "546e36c9-ed9d-3d64-ad88-007d2c989bda",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "Esteem, favourable opinion."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d28af8a1-c784-4ed4-b588-99c0e54d5f02",
                                                "sense_id": "546e36c9-ed9d-3d64-ad88-007d2c989bda",
                                                "text": "By him that me boughte, than quod Dysdayne, / I wonder sore he is in suche cenceyte."
                                            },
                                            {
                                                "example_id": "a2caf4ce-e07a-48f0-972c-979b7a6e6ed6",
                                                "sense_id": "546e36c9-ed9d-3d64-ad88-007d2c989bda",
                                                "text": "[G]ive him thy thanks for putting her into conceit with the sex that thou hast given her so much reason to execrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "173c70df-1a8e-31bb-a632-dba1c4307fdf",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "A novel or fanciful idea; a whim."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26be312b-0f4c-45b8-aace-1adea9132d30",
                                                "sense_id": "173c70df-1a8e-31bb-a632-dba1c4307fdf",
                                                "text": "On his way to the gibbet, a freak took him in the head to go off with a conceit."
                                            },
                                            {
                                                "example_id": "578a813e-cc97-48e4-91dd-737fb568ec8d",
                                                "sense_id": "173c70df-1a8e-31bb-a632-dba1c4307fdf",
                                                "text": "Some to conceit alone their works confine, / And glitt'ring thoughts struck out at ev'ry line."
                                            },
                                            {
                                                "example_id": "2e8aa27a-b550-4b60-ac24-6986a1fd44ce",
                                                "sense_id": "173c70df-1a8e-31bb-a632-dba1c4307fdf",
                                                "text": "Tasso[…] is full of conceits […] which are not only below the dignity of heroic verse but contrary to its nature."
                                            },
                                            {
                                                "example_id": "d795a6f1-8445-40bc-964b-dcafdb5b6bfb",
                                                "sense_id": "173c70df-1a8e-31bb-a632-dba1c4307fdf",
                                                "text": "By reason of these things, then, the whaling voyage was welcome; the great flood-gates of the wonder-world swung open, and in the wild conceits that swayed me to my purpose, two and two there floated into my inmost soul, endless processions of the whale, and, mid most of them all, one grand hooded phantom, like a snow hill in the air."
                                            },
                                            {
                                                "example_id": "a61225c7-a80a-4a93-b698-4ad31b963656",
                                                "sense_id": "173c70df-1a8e-31bb-a632-dba1c4307fdf",
                                                "text": "The book's main conceit is to make poetry from univocal words (words containing just one vowel) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f45136-92b4-3c92-b3a0-2a4927243e46",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "An ingenious expression or metaphorical idea, especially in extended form or used as a literary or rhetorical device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30e26f4-aa13-4c78-941d-b55b9c7bdc0b",
                                                "sense_id": "86f45136-92b4-3c92-b3a0-2a4927243e46",
                                                "text": "The “cyberspace” conceit allows him to dramatize computer hacking in nontechnical language, although I wonder how much his somewhat florid descriptions of the “bodiless exultation of cyberspace” will mean to readers who have not experienced the illusion of power that punching the keyboard of even a dinky little word-processor can give."
                                            },
                                            {
                                                "example_id": "f48d49fb-0254-4152-83bc-71b7ecfe2b3a",
                                                "sense_id": "86f45136-92b4-3c92-b3a0-2a4927243e46",
                                                "text": "In the next and final stanza, Donne expands the conceit of world exploration to present us with a further distinction between the spirituality of the lovers and the “map reader” and “sea-discoverers.”"
                                            },
                                            {
                                                "example_id": "ee13fa41-f758-48d1-ad45-4942b90cc658",
                                                "sense_id": "86f45136-92b4-3c92-b3a0-2a4927243e46",
                                                "text": "Jones and Palin wrote and starred in The Complete and Utter History of Britain (1969) for LWT. Its conceit was to relate historical incidents as if TV had existed at the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1351b26-1b1c-3255-9f25-47e6cdf12b84",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "Overly high self-esteem; vain pride; hubris."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fffb587-9eb1-4c9d-9814-c81ceba20117",
                                                "sense_id": "b1351b26-1b1c-3255-9f25-47e6cdf12b84",
                                                "text": "Plum'd with conceit he calls aloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4e4d1f-625a-370d-bbf2-826bfc87c9fe",
                                        "entry_id": "1917c7fa-fdf8-3dce-9f24-da742716988c",
                                        "glosses": [
                                            "Design; pattern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1904376-6366-4a63-bcb9-93e88deb5f4e",
                                                "sense_id": "bc4e4d1f-625a-370d-bbf2-826bfc87c9fe",
                                                "text": "And yet I know not how conceit may rob the treasury of life when life itself yields to the theft;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conceit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef874fa-83a0-3a53-b2c6-6f9faa3790de",
                                        "entry_id": "95d20a2f-023d-3bed-a7d5-9d42acd579d7",
                                        "glosses": [
                                            "To form an idea; to think."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b730bfd6-0e15-494e-9e5d-a5abe8971f00",
                                                "sense_id": "5ef874fa-83a0-3a53-b2c6-6f9faa3790de",
                                                "text": "Those whose […] vulgar apprehensions conceit but low of matrimonial purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da85ebb2-b16c-30f1-a77a-f2a8dedab250",
                                        "entry_id": "95d20a2f-023d-3bed-a7d5-9d42acd579d7",
                                        "glosses": [
                                            "To conceive."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7194fd86-a945-4b83-af39-fb80a0804019",
                                                "sense_id": "da85ebb2-b16c-30f1-a77a-f2a8dedab250",
                                                "text": "[T]his Medicine he conceits worse than the Disesase."
                                            },
                                            {
                                                "example_id": "83d05e2b-14ff-4c14-9158-8da248e7d14e",
                                                "sense_id": "da85ebb2-b16c-30f1-a77a-f2a8dedab250",
                                                "text": "That owls and ravens are ominous appearers, and presignifying unlucky events, as Christians yet conceit, was also an augurial conception."
                                            },
                                            {
                                                "example_id": "affebaae-9f8b-4f1d-aaa9-b695c4c8acc6",
                                                "sense_id": "da85ebb2-b16c-30f1-a77a-f2a8dedab250",
                                                "text": "The strong, by conceiting themselves weak, are therebly rendered as inactive […] as if they really were so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a60b54-982b-46ef-9c1a-662309f8f11a",
                        "source_entry_id": "f647ee58-add8-3dd0-8c29-230e3717be46",
                        "source_sense_id": "5474c516-2508-3ab8-b678-8121a77574af",
                        "source_sense_description": "Dünkel, der auf den Sprecher selbst bezogen ist, sich selbst als überlegen auffasst",
                        "target_lang_word": "présomption",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "présomption",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c220667c-5b00-3b0a-bf7e-d61ffc5409e7",
                                        "entry_id": "7310ce45-b048-3967-a594-6f5d9fd2263d",
                                        "glosses": [
                                            "Jugement, conjecture, fondé non sur des preuves, mais sur des indices, des apparences, sur ce qui est probable sans être certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17fa5685-1850-4e07-9160-41e06c531a2b",
                                                "sense_id": "c220667c-5b00-3b0a-bf7e-d61ffc5409e7",
                                                "text": "L'opinion ne suit pas l'exalté, le fou, qui, sur de simples présomptions, sans preuves, vous impute le plus grave des forfaits."
                                            },
                                            {
                                                "example_id": "0c94d3bb-107b-47b0-a3d7-92979762ae36",
                                                "sense_id": "c220667c-5b00-3b0a-bf7e-d61ffc5409e7",
                                                "text": "Des preuves, non, je n’en ai pas, répondit l’énigmatique vieillard, mais j’ai des pressentiments, mieux encore, des présomptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5614d010-bba6-3af1-9d2d-6877b32d7b71",
                                        "entry_id": "7310ce45-b048-3967-a594-6f5d9fd2263d",
                                        "glosses": [
                                            "Ce qui est supposé vrai jusqu’à preuve du contraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3acdeb-c88e-449f-822b-bb7805382ff7",
                                                "sense_id": "5614d010-bba6-3af1-9d2d-6877b32d7b71",
                                                "text": "Certes il est facile de comprendre qu’un accusé ait tout intérêt à nier son crime et à mettre en cause la victime, et qu’il puisse bénéficier de la présomption d’innocence (mais il faudrait en miroir que la victime puisse bénéficier de la présomption de crédibilité)."
                                            },
                                            {
                                                "example_id": "6d2feb0a-6b59-4811-a9a0-94c61611cf81",
                                                "sense_id": "5614d010-bba6-3af1-9d2d-6877b32d7b71",
                                                "text": "Des présomptions ? On en pouvait réunir autant qu’on en voulait. Mais le jury ne condamne pas sur des présomptions, lui qui se méfie des preuves les plus formelles, par crainte du fantôme de l’erreur judiciaire toujours agité par la défense."
                                            },
                                            {
                                                "example_id": "620983ef-2a82-43fb-a586-b9ba065b9454",
                                                "sense_id": "5614d010-bba6-3af1-9d2d-6877b32d7b71",
                                                "text": "Ce dernier critère introduit une présomption : si l’intention lucrative est caractérisée, alors la personne qui fait le lien sera présumée savoir qu’elle pointait vers un contenu illicite et ce sera à elle de prouver le contraire ; si à l’inverse, le lien a été posé sans intention lucrative, la personne bénéficie d’une présomption d’ignorance et c’est la partie adverse qui devra démontrer par tout moyen qu’elle savait que le contenu désigné par le lien était illicite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6b9e06-bc91-38f4-afec-bbaab378943d",
                                        "entry_id": "7310ce45-b048-3967-a594-6f5d9fd2263d",
                                        "glosses": [
                                            "Opinion trop avantageuse de soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a4b08f-4101-40eb-9fe6-3235d2f35546",
                                                "sense_id": "9f6b9e06-bc91-38f4-afec-bbaab378943d",
                                                "text": "La sobriété, le dévouement et la piété de nos prédécesseurs nous avaient gagné de puissants amis ; notre présomption, notre richesse et notre luxure nous ont suscité de formidables ennemis."
                                            },
                                            {
                                                "example_id": "a127e480-dd11-42ce-93ea-c9a562daea49",
                                                "sense_id": "9f6b9e06-bc91-38f4-afec-bbaab378943d",
                                                "text": "L’Invincible Armada devait avoir pour amiral le marquis de Santa-Cruz ; mais il mourut pendant les préparatifs, et le commandement fut donné au duc de Medina-Sidonia, marin de cour, dont la présomption égalait l’ignorance."
                                            },
                                            {
                                                "example_id": "448f603a-073f-493f-8183-85c939be2c8f",
                                                "sense_id": "9f6b9e06-bc91-38f4-afec-bbaab378943d",
                                                "text": "Quand je lui parle de la sphéricité et des évolutions de la terre et des astres, de la découverte de l’Amérique, des tentatives faites pour atteindre les pôles, il se contente de hausser les épaules et sourit de ma présomption : la présomption d’un œuf qui prétendrait en savoir plus long que la poule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ffff47-7b67-3011-bb3e-80c1996e30ca",
                                        "entry_id": "7310ce45-b048-3967-a594-6f5d9fd2263d",
                                        "glosses": [
                                            "Action de présumer de ses forces, de surestimer ses capacités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987c9010-8c85-4913-b44b-8e33474f2386",
                                                "sense_id": "63ffff47-7b67-3011-bb3e-80c1996e30ca",
                                                "text": "Il arriva au concours plein de présomption."
                                            }
                                        ]
                                    }
                                ]
