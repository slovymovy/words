                "senses": [
                    {
                        "sense_id": "4f67d02c-eb7d-34f3-a0b5-e584f3a6061a",
                        "entry_id": "2d58980a-f01b-39d8-9245-f034ef65215a",
                        "glosses": [
                            "podprda, podprsenka"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "09930a61-21a5-4de6-a80f-aced2c79601a",
                                "sense_id": "4f67d02c-eb7d-34f3-a0b5-e584f3a6061a",
                                "text": "Państwa, którzy odjechali z moimi wielkimi majtami i cyckonoszami, pozdrawiam i życzę pożytku z bielizny."
                            },
                            {
                                "example_id": "036f428b-f306-4e54-b28f-299b6c8a44e7",
                                "sense_id": "4f67d02c-eb7d-34f3-a0b5-e584f3a6061a",
                                "text": "Moja córka poprosiła mnie, by kupić jej pierwszy cyckonosz.",
                                "translation": "Dcera mě požádala, abych jí koupil(a) její první podprdu."
                            }
                        ]
                    }
