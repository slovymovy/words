                "senses": [
                    {
                        "sense_id": "26245342-ad63-3741-a753-81bea4a92be7",
                        "entry_id": "35faa621-e0c3-3255-b676-58556516611c",
                        "glosses": [
                            "heel erg goed"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f54ac108-9016-4fd6-941d-821451052d16",
                                "sense_id": "26245342-ad63-3741-a753-81bea4a92be7",
                                "text": "Maar dat gezegd zijnde: de Cavalera’s waren retegoed, zoals altijd. Dat gold ook voor Megadeth. Daarover heb ik een behoorlijk onkatholieke mening: ik vind hen nog altijd beter dan Metallica. Niet alleen omdat ze stuk voor stuk goede muzikanten zijn, maar omdat ze ook nog eens tonnen humor hebben. Bovendien is hun drummer een Belg: Dirk Verbeuren. Een beetje chauvinisme mag ook.’"
                            },
                            {
                                "example_id": "445ba0e2-4ec0-43cc-aeb9-1f315c0d8ddc",
                                "sense_id": "26245342-ad63-3741-a753-81bea4a92be7",
                                "text": "Komende zondag zijn de FBK Games in Hengelo en daar wil de medewerker van de luchtmobiele brigade opnieuw voluit gaan en de EK-limiet slechten. \"De benen zijn retegoed. Ik moet alleen mijn kop op scherp krijgen. Zodat ik me helemaal concentreer op de race en me niet laat afleiden door wat er langs de baan gebeurt.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f8a59af-2dd1-491f-b890-7a12680a692a",
                        "source_entry_id": "35faa621-e0c3-3255-b676-58556516611c",
                        "source_sense_id": "26245342-ad63-3741-a753-81bea4a92be7",
                        "source_sense_description": "heel erg goed",
                        "target_lang_word": "awsome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awsome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c764e0c-1265-30bc-aaf1-d8f9b77bd0c5",
                                        "entry_id": "2e93aa35-9d75-37ed-a663-727b8e95587b",
                                        "glosses": [
                                            "Archaic form of awesome."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce0526c-4b73-4527-a4ef-44ee08f7f37d",
                                                "sense_id": "4c764e0c-1265-30bc-aaf1-d8f9b77bd0c5",
                                                "text": "“Aye, Sibbie, it was an awsome sight,” quoth Archy."
                                            },
                                            {
                                                "example_id": "6ea9e0a1-4e67-40a5-afe1-a5c0831a03f0",
                                                "sense_id": "4c764e0c-1265-30bc-aaf1-d8f9b77bd0c5",
                                                "text": "The landlord nodded gravely, then spoke aloud:— “I was out last night; it was indeed an awsome time."
                                            },
                                            {
                                                "example_id": "43aa6397-4fa6-40ac-bd96-ab61486d5a2a",
                                                "sense_id": "4c764e0c-1265-30bc-aaf1-d8f9b77bd0c5",
                                                "text": "1. objectively. Inspiring fear; awsome, dreadful; = Fearful 1."
                                            }
                                        ]
                                    },
