        "ru-extract.jsonl": [
            {
                "entry_id": "74eec6c4-a8ad-352e-aa20-590b0f41c07a",
                "word": "поодаль",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2cd2b30d-d8c3-3789-9ed2-3488becd3123",
                        "entry_id": "74eec6c4-a8ad-352e-aa20-590b0f41c07a",
                        "glosses": [
                            "в некотором отдалении от кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df2892a2-b58b-482f-bc36-f807f738b94d",
                                "sense_id": "2cd2b30d-d8c3-3789-9ed2-3488becd3123",
                                "text": "Поодаль в стороне темнел каким-то скучно-синеватым цветом сосновый лес."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8636f279-4328-4c7d-b382-b06d7a2fcc4e",
                        "source_entry_id": "74eec6c4-a8ad-352e-aa20-590b0f41c07a",
                        "source_sense_id": "2cd2b30d-d8c3-3789-9ed2-3488becd3123",
                        "target_lang_word": "aloof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aloof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0c1cb2-adcc-3fe6-97cb-ab154116e666",
                                        "entry_id": "e8b9f1af-798c-3270-8b0f-f73d74856331",
                                        "glosses": [
                                            "At or from a distance, but within view, or at a small distance; apart; away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e51a784-8b27-4ae1-b0d5-81ed8b9163e2",
                                                "sense_id": "dc0c1cb2-adcc-3fe6-97cb-ab154116e666",
                                                "text": "Sisyphus also I saw, with unwelcomest taskage tormented, / Toilsomely hoisting aloof, unassisted, a ponderous round stone."
                                            },
                                            {
                                                "example_id": "a7187152-14e0-4650-a9f7-60e410125618",
                                                "sense_id": "dc0c1cb2-adcc-3fe6-97cb-ab154116e666",
                                                "text": "The noise approaches, tho' our palace stood\n Aloof from streets, encompass'd with a wood"
                                            },
                                            {
                                                "example_id": "23ed6a0e-4d00-4fc3-93d0-848f4833c092",
                                                "sense_id": "dc0c1cb2-adcc-3fe6-97cb-ab154116e666",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f244dcc-b469-3ce9-986c-bcd361631f3a",
                                        "entry_id": "e8b9f1af-798c-3270-8b0f-f73d74856331",
                                        "glosses": [
                                            "Without sympathy; unfavorably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd6e1df8-cb18-4643-9897-972f0b438cf8",
                                                "sense_id": "5f244dcc-b469-3ce9-986c-bcd361631f3a",
                                                "text": "But to open the Bible in this spirit — to take the Book as from the hand of God, and then to look at it aloof, and with caution, as if throughout it were illusory and enigmatical, is the worst of all impieties."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aloof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8cad14-162a-35fa-92fe-97cecfba5e3c",
                                        "entry_id": "16303d9b-aefa-3eb3-901f-293edc7948b8",
                                        "glosses": [
                                            "Reserved and remote; either physically or emotionally distant; standoffish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ed8727-dec8-48b7-ba2f-de85954c12f4",
                                                "sense_id": "9a8cad14-162a-35fa-92fe-97cecfba5e3c",
                                                "text": "I'm a courteous but somewhat aloof man that just tries to stay aloof of any infighting and squalid scandals."
                                            },
                                            {
                                                "example_id": "d5276d77-0ddb-4950-b43c-bbd49d883e5f",
                                                "sense_id": "9a8cad14-162a-35fa-92fe-97cecfba5e3c",
                                                "text": "None may ever hear the speech of the poets of that city, to whom the gods have spoken. It stands a city aloof. There hath been no rumour of it—I alone have dreamed of it, and I may not be sure that my dreams are true."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aloof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe59f66e-9342-3ae4-bc25-a64f62efedbb",
                                        "entry_id": "a9a3e41b-f322-390d-b34d-c883b59ec9ed",
                                        "glosses": [
                                            "Away from; clear of."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05deb51c-9016-458b-bfa4-eecf91935598",
                                                "sense_id": "fe59f66e-9342-3ae4-bc25-a64f62efedbb",
                                                "text": "Rivetus […] would fain work himself aloof these rocks and quicksands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
