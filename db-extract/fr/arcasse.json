                    {
                        "translation_id": "dfc6ed2c-9268-4127-9346-9814354f2637",
                        "source_entry_id": "2a0666b0-2a65-38b0-bc7e-eb9bb57a4e3b",
                        "source_sense_description": "arrière du navire",
                        "target_lang_word": "корма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "корма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b32f7bff-6079-3da9-b367-43af7b9d7212",
                                        "entry_id": "feb5105d-d1e5-334b-b0b6-98394d903887",
                                        "glosses": [
                                            "морск. задняя часть корабля, судна, яхты и т. п., а также космического корабля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41359ebd-2831-441e-b9b3-98f4f5a6b676",
                                                "sense_id": "b32f7bff-6079-3da9-b367-43af7b9d7212",
                                                "text": "Вследствие неправильной погрузки нос и корма катера получили разную осадку."
                                            },
                                            {
                                                "example_id": "45266798-ba61-497a-b996-155c8fe0c5e7",
                                                "sense_id": "b32f7bff-6079-3da9-b367-43af7b9d7212",
                                                "text": "Интересный вариант предложили для «Клипера»: традиционный один большой ракетный двигатель твердого топлива в носу корабля заменили на восемь маленьких в корме."
                                            },
                                            {
                                                "example_id": "90198125-4347-48fd-86bc-cba2268a4a2d",
                                                "sense_id": "b32f7bff-6079-3da9-b367-43af7b9d7212",
                                                "text": "Русские вместо брандер запускали паровые катера с шестовыми минами, их заводили под корму или ещё куда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a380db47-9f24-39f1-b933-d6aa44fa4e29",
                                        "entry_id": "feb5105d-d1e5-334b-b0b6-98394d903887",
                                        "glosses": [
                                            "разг. задняя часть транспортного средства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a16ffa-1349-4cfc-bae6-dc2e242816bd",
                                                "sense_id": "a380db47-9f24-39f1-b933-d6aa44fa4e29",
                                                "text": "К корме танка крепится трассировщик и кассета с пиросигналами."
                                            },
                                            {
                                                "example_id": "f32cfcdd-64b0-4379-86f4-1d72fd57290b",
                                                "sense_id": "a380db47-9f24-39f1-b933-d6aa44fa4e29",
                                                "text": "Но стоило повернуть ручку и потянуть крышку-спинку на себя, как в корме автомобиля открывалась небольшая уютная скамейка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "640d78a9-68b2-36b3-92f4-2beb63dfeee4",
                                        "entry_id": "feb5105d-d1e5-334b-b0b6-98394d903887",
                                        "glosses": [
                                            "перен., прост., шутл. то же, что зад"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636a3875-6251-43b1-b9d7-d2a28d8713b3",
                                                "sense_id": "640d78a9-68b2-36b3-92f4-2beb63dfeee4",
                                                "text": "Якорь тебе в корму!"
                                            }
                                        ]
                                    }
                                ]
