                                        "examples": [
                                            {
                                                "example_id": "0511f254-199c-49b9-bb7c-947b749a4346",
                                                "sense_id": "0c7bca75-38a9-36b6-9647-e39e01b191a8",
                                                "text": "What is this globalism anyway? This new world order? This one world order? It all seems very vague to me. When I start hearing those terms, I start imagining some kind of 1984-esque, soulless, desolate society, of dependence on government, with Big Brother as the totalitarian leader, I guess."
                                            }
                                        ]
                                    }
                                ]
                            }
