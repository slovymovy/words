            "senses": [
                {
                    "sense_id": "a8274051-12fb-3dfc-bd1a-8cb46d54dfe9",
                    "sense_definition": "Characterized by great intensity or being deeply felt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loss of his grandfather had a <w>profound</w> impact on his childhood development.",
                            "target_lang_translations": {
                                "ru": "Потеря дедушки оказала <w>глубокое</w> влияние на его развитие в детстве."
                            }
                        },
                        {
                            "text": "She felt a <w>profound</w> sense of relief after hearing the good news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>глубокое</w> чувство облегчения, услышав хорошие новости."
