                        "entry_id": "e7cd4c20-3d5c-36ed-8f27-59c143139246",
                        "glosses": [
                            "flight"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "acb77c30-1c50-4c41-8f52-8ef76c68cc21",
                                "sense_id": "d6d981c8-ba76-3507-9b44-0329bb7e84b2",
                                "text": "на лету́",
                                "translation": "in flight, on the fly",
                                "english": "in flight, on the fly"
                            },
                            {
                                "example_id": "9424b410-f52f-499b-912f-85c3cf349ba7",
                                "sense_id": "d6d981c8-ba76-3507-9b44-0329bb7e84b2",
                                "text": "Для выявле́ния напада́ющей семьи́ ве́чером, когда́ норма́льно рабо́тающие се́мьи зако́нчат лёт, пчёл, вылета́ющих из обворо́вываемого у́лья, посыпа́ют толчёным ме́лом и́ли муко́й и наблюда́ют, в како́й у́лей они́ летя́т."
                            }
                        ]
                    }
