    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c4cbb5a-e2df-37e7-8afb-102a43f09dd6",
                    "sense_definition": "Devoir imposé par la morale, les lois, la religion ou les règles sociales.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "devoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents ont l'<w>obligation</w> de veiller sur la santé et l'éducation de leurs enfants."
                        },
                        {
                            "text": "Il participe à cet événement par simple <w>obligation</w> sociale et non par réel plaisir."
                        }
                    ],
                    "synonyms": [
                        "contrainte",
                        "devoir",
                        "exigence",
                        "impératif",
                        "nécessité"
                    ],
                    "common_phrases": [
                        "obligation morale",
                        "obligation légale",
                        "avoir l'obligation de",
                        "sans obligation d'achat"
                    ]
                },
                {
                    "sense_id": "154f8e2b-4abf-31eb-852d-cb185db121d5",
                    "sense_definition": "Lien juridique par lequel une personne est contrainte d'accomplir une prestation envers une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "devoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce contrat précise clairement chaque <w>obligation</w> contractuelle qui lie le fournisseur au client."
                        },
                        {
                            "text": "L'avocat rappelle que le locataire a l'<w>obligation</w> de payer son loyer à la date convenue."
                        }
                    ],
                    "synonyms": [
                        "engagement"
                    ],
                    "common_phrases": [
                        "obligation contractuelle",
                        "manquer à ses obligations"
                    ]
                },
                {
                    "sense_id": "78f8dc64-e446-3a30-a25b-b1147fb780bc",
                    "sense_definition": "Titre financier de créance émis par un État ou une entreprise, rapportant un intérêt fixé d'avance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour financer ses projets, le gouvernement a décidé d'émettre de nouvelles <w>obligations</w> sur les marchés."
                        },
                        {
                            "text": "Cet investisseur prudent préfère placer son capital dans des <w>obligations</w> d'État plutôt que dans des actions risquées."
                        }
                    ],
                    "common_phrases": [
                        "marché des obligations",
                        "obligations d'État",
                        "émission d'obligations"
                    ]
                },
                {
                    "sense_id": "78e87242-439f-3ced-988c-6001173b9fe0",
                    "sense_definition": "Sentiment ou dette de gratitude envers une personne qui a rendu un service important.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après tout ce soutien dans les moments difficiles, j'ai une grande <w>obligation</w> envers vous."
                        },
                        {
                            "text": "Il refuse toujours d'accepter une faveur pour ne pas se sentir sous une quelconque <w>obligation</w>."
                        }
                    ],
                    "common_phrases": [
                        "avoir une obligation envers",
                        "contracter une obligation"
                    ]
                }
            ]
        }
    ]
}