{
    "word_family": [
        "puppetry",
        "puppeteer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2314a869-f111-307c-aae3-87f64274dd5c",
                    "sense_definition": "A small model of a person or animal that is moved by strings, rods, or by a hand inside it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched the <w>puppet</w> show with great excitement."
                        },
                        {
                            "text": "She used a hand <w>puppet</w> to tell the story to the class."
                        }
                    ],
                    "common_phrases": [
                        "puppet show",
                        "hand puppet"
                    ]
                },
                {
                    "sense_id": "6f164e35-ec43-3bb0-999d-3be6354a1263",
                    "sense_definition": "A person or organization that is controlled by someone else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government was seen as a <w>puppet</w> of the neighboring country."
                        },
                        {
                            "text": "He refused to be a <w>puppet</w> for his boss and quit the job."
                        }
                    ],
                    "synonyms": [
                        "monkey"
                    ],
                    "common_phrases": [
                        "puppet government",
                        "political puppet"
                    ]
                },
                {
                    "sense_id": "f4233337-f5ec-382e-bc66-bf8a5d43c471",
                    "sense_definition": "A small doll or image in human form.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "toy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique shop displayed a tiny wooden <w>puppet</w> from the last century."
                        },
                        {
                            "text": "She kept a small <w>puppet</w> on her shelf as a decorative item."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the older usage of the word as a doll."
                        }
                    ]
                },
                {
                    "sense_id": "53906212-7950-365b-9eca-5b27b69707bc",
                    "sense_definition": "The upright support for the bearing of a spindle in a lathe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist adjusted the <w>puppet</w> to ensure the spindle was stable."
                        },
                        {
                            "text": "A worn <w>puppet</w> can cause vibrations during the turning process."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58253fe4-aac8-3747-8987-516735265fc1",
                    "sense_definition": "To control or manipulate someone or something as if they were a puppet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tried to <w>puppet</w> the entire department from behind the scenes."
                        },
                        {
                            "text": "It is frustrating to be <w>puppeted</w> by someone who does not understand the work."
                        }
                    ]
                }
            ]
        }
    ]
}