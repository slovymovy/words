                "senses": [
                    {
                        "sense_id": "205dd5c5-8f21-38c8-89e0-62c8de72a96a",
                        "entry_id": "f2395db2-c12d-356b-838e-3745fef53bf9",
                        "glosses": [
                            "Delikt, das nur auf Antrag des Opfers strafrechtlich verfolgt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776dda05-6845-43f0-a568-d24993375b81",
                                "sense_id": "205dd5c5-8f21-38c8-89e0-62c8de72a96a",
                                "text": "„Bei einem Antragsdelikt tritt der Staatsanwalt dem Gericht gegenüber nur insoweit als gesetzlich berechtigter Ankläger auf, als der Verfolgungsantrag des Verletzten als des eigentlichen Trägers des Verfolgungsrechtes vorliegt.“"
                            },
                            {
                                "example_id": "36f6a2f9-68ed-4b53-abb4-e7763f10ebae",
                                "sense_id": "205dd5c5-8f21-38c8-89e0-62c8de72a96a",
                                "text": "„Bei Diebstahl im Familienkreis handelt es sich um ein sogenanntes ‚Antragsdelikt‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
