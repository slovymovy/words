                                        "examples": [
                                            {
                                                "example_id": "63423e4d-5156-4817-928e-764ca0ecdb50",
                                                "sense_id": "fb4844d1-ed53-3267-9859-288eb552a775",
                                                "text": "К примеру, в свое время Шостакович подарил нам две песни, которые получили широкую популярность, и обе они написаны в мажоре."
                                            }
