                "senses": [
                    {
                        "sense_id": "38c140a2-5e1c-3257-892c-7dce52e28eb8",
                        "entry_id": "653470aa-1d30-3358-b58f-1adbdf1e97c6",
                        "glosses": [
                            "der Philosophie Descartes ^(→ WP) entsprechend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d29436-cf42-4fb4-a66d-bd169e333746",
                                "sense_id": "38c140a2-5e1c-3257-892c-7dce52e28eb8",
                                "text": "„Gründlicher als im Heimatland von Descartes konnte das cartesische ‚Cogito‘ gewiß nicht zertrümmert werden.“"
                            },
                            {
                                "example_id": "a37ecfda-7315-464a-bf63-a5868b861e1b",
                                "sense_id": "38c140a2-5e1c-3257-892c-7dce52e28eb8",
                                "text": "„Aus diesen Grundthesen der Cartesischen Metaphysik ergeben sich mehrere Konsequenzen für das Problem der Kausalität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
