                },
                {
                    "sense_id": "81229724-3c99-3354-819d-ae063fcbfe44",
                    "sense_definition": "The city of Bagan in Myanmar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Tourists often visit the ancient temples in <w>Pagan</w>.",
                            "target_lang_translations": {
                                "nl": "Toeristen bezoeken vaak de oude tempels in <w>Bagan</w>."
                            }
                        },
                        {
                            "text": "The historical site of <w>Pagan</w> is a major cultural landmark.",
                            "target_lang_translations": {
