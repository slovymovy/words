                "senses": [
                    {
                        "sense_id": "a2cb284f-df1b-3834-aa6c-192145b05f60",
                        "entry_id": "03762f97-7f5a-382a-b3de-8751df59f053",
                        "glosses": [
                            "zur Erbauung oder zur Belehrung dienende Erzählung biblischer Stoffe im Talmud"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "107cbde7-2b99-491b-bf87-826d2d92dd54",
                                "sense_id": "a2cb284f-df1b-3834-aa6c-192145b05f60",
                                "text": "Wer auf dem Felde der Agade bewandert ist, weiß, daß oft zur Begründung agadischer Aussprüche nur der Anfang einer Bibelstelle angeführt wird, obwohl man hauptsächlich den Schluß im Auge hat."
                            },
                            {
                                "example_id": "d2907308-7735-483a-bcb6-a7557c54c4dc",
                                "sense_id": "a2cb284f-df1b-3834-aa6c-192145b05f60",
                                "text": "Schon in dem Novellenfragment »Der Rabbi von Bacherach«, an dem Heine wahrscheinlich 1824 zu arbeiten begann, ist die »Agade« Gegenstand literarischen Schreibens."
                            },
                            {
                                "example_id": "2f9209a7-ec4f-4977-b609-11d8207c3474",
                                "sense_id": "a2cb284f-df1b-3834-aa6c-192145b05f60",
                                "text": "Ich ließ die Agade nur im Allgemeinen als Anregung auf mich wirken, in ihrem Geiste, nicht in ihrem Tone und ihrer Form wollte ich reden."
                            },
                            {
                                "example_id": "0c15b320-6964-4a5e-b237-dccfaefe45b8",
                                "sense_id": "a2cb284f-df1b-3834-aa6c-192145b05f60",
                                "text": "Man wird daher Manches finden, das wie Selbsterfundenes aussieht, und dennoch ist es seiner Genesis nach, nur Kommentar zu dem was mir aus der Agade entgegentrat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
