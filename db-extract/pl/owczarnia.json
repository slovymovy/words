                    },
                    {
                        "sense_id": "a927e9b0-fd36-36f8-9196-fa2b39dcdd1a",
                        "entry_id": "3fc307de-8231-388b-a879-9a894c559327",
                        "glosses": [
                            "wspólnota kościoła"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "0b5ef6c3-565a-4ae8-bab7-236d43be79c8",
                                "sense_id": "a927e9b0-fd36-36f8-9196-fa2b39dcdd1a",
                                "text": "I będą słuchać głosu mego, i nastanie jedna owczarnia, jeden pasterz"
                            }
