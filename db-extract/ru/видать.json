                            {
                                "example_id": "20e68099-356a-4640-8c24-3b073de8780a",
                                "sense_id": "3dbdc748-f0d1-3872-8fcd-7c6d36814f2d",
                                "text": "и во сне не ～ (кого-чего)　 就连做梦也见不到…"
                            },
