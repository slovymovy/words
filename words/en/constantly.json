                {
                    "sense_id": "9cee734c-845f-37e7-a300-30336e7d3306",
                    "sense_definition": "In a consistent manner that does not change or vary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature in the laboratory must be <w>constantly</w> maintained at twenty degrees.",
                            "target_lang_translations": {
                                "ru": "Температура в лаборатории должна <w>постоянно</w> поддерживаться на уровне двадцати градусов.",
                                "tr": "Laboratuvardaki sıcaklık <w>sürekli olarak</w> yirmi derecede tutulmalıdır.",
                                "zh": "实验室的温度必须<w>始终</w>保持在二十度。",
                                "nl": "De temperatuur in het laboratorium moet <w>constant</w> op twintig graden gehouden worden.",
                                "pl": "Temperatura w laboratorium musi być <w>stale</w> utrzymywana na poziomie dwudziestu stopni.",
                                "de": "Die Temperatur im Labor muss <w>konstant</w> bei zwanzig Grad gehalten werden.",
                                "fr": "La température dans le laboratoire doit être <w>constamment</w> maintenue à vingt degrés.",
                                "it": "La temperatura nel laboratorio deve essere mantenuta <w>costantemente</w> a venti gradi.",
                                "cs": "Teplota v laboratoři musí být <w>trvale</w> udržována na dvaceti stupních.",
                                "es": "La temperatura en el laboratorio debe mantenerse <w>de manera constante</w> a veinte grados.",
                                "ja": "研究室の温度は20度で<w>一定に</w>保つ必要があります。",
                                "pt": "A temperatura no laboratório deve ser <w>constantemente</w> mantida a vinte graus."
                            }
                        },
                        {
                            "text": "They <w>constantly</w> deliver high-quality results regardless of the circumstances.",
                            "target_lang_translations": {
                                "ru": "Они <w>неизменно</w> выдают качественные результаты, независимо от обстоятельств.",
                                "tr": "Koşullar ne olursa olsun <w>istikrarlı bir şekilde</w> yüksek kaliteli sonuçlar sunuyorlar.",
                                "zh": "无论环境如何，他们都能<w>一贯</w>地提供高质量的成果。",
                                "nl": "Ze leveren ongeacht de omstandigheden <w>consistent</w> resultaten van hoge kwaliteit.",
                                "pl": "Oni <w>niezmiennie</w> zapewniają wysokiej jakości rezultaty, bez względu na okoliczności.",
                                "de": "Sie liefern unabhängig von den Umständen <w>beständig</w> hochwertige Ergebnisse.",
                                "fr": "Ils fournissent <w>invariablement</w> des résultats de haute qualité, quelles que soient les circonstances.",
                                "it": "Forniscono <w>invariabilmente</w> risultati di alta qualità, a prescindere dalle circostanze.",
                                "cs": "Bez ohledu na okolnosti <w>soustavně</w> odvádějí vysoce kvalitní výsledky.",
                                "es": "Ellos ofrecen <w>invariablemente</w> resultados de alta calidad, independientemente de las circunstancias.",
                                "ja": "彼らは状況にかかわらず、<w>一貫して</w>高品質な結果を出しています。",
                                "pt": "Eles <w>invariavelmente</w> entregam resultados de alta qualidade, independentemente das circunstâncias."
                            }
                        }
