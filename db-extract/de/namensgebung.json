                ],
                "senses": [
                    {
                        "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                        "entry_id": "805fb8bf-2306-384e-8a94-c6eeaa89c639",
                        "glosses": [
                            "die Handlung, etwas zu benennen (einen „Namen zu geben“)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d22edf3-1ffb-4d38-ab57-5bfb13ddad28",
                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                "text": "Die Namensgebung war von einem Science-Fiction-Roman beeinflusst."
                            },
                            {
                                "example_id": "745d7b71-b88f-4cfa-b23f-80dc2b11cd1e",
                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                "text": "„Aus dem Bootsinneren sollte dazu mit Stulpenhandschuhen und Greifarmen ein rund 50 Kilogramm schwerer Explosivkörper, der »Brand«, an den feindlichen Objekten befestigt werden, was die außergewöhnliche Namensgebung des ältesten erhaltenen Ubootes der Welt erklärt.“"
                            },
                            {
                                "example_id": "780966bf-bd1e-41cf-aae3-59824c5e7bfa",
                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                "text": "„Auf Nólsoy hatte der Prinz hingegen mehr Glück, was die Namensgebung anging.“"
                            },
                            {
                                "example_id": "0a0a65e4-ec65-4303-949d-d8260d4579c5",
                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                "text": "„Diese Systematik der Namensgebung sorgt natürlich für Unordnung.“"
                            },
                            {
                                "example_id": "1d88699e-a84e-4902-8471-20f9544b33f9",
                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                "text": "„Den Wegen so beschriebener Ungereimtheiten nachzugehen und die eigentliche, ehedem wohl vorhandene Sinnhaftigkeit der Namensgebung aufzuspüren, ist wiederum Aufgabe der Etymologie, auch wenn diese nicht in allen Fällen eine befriedigende Lösung bereitstellen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
