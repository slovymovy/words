                "senses": [
                    {
                        "sense_id": "1d4a1260-2191-331d-8c3d-b7ec68d1ad71",
                        "entry_id": "c9df8de4-2a83-3e83-bc43-091f15699222",
                        "glosses": [
                            "Geschichte, die von Agenten handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488dd59b-e98d-4116-8194-cf02979ca1db",
                                "sense_id": "1d4a1260-2191-331d-8c3d-b7ec68d1ad71",
                                "text": "„Im Finale der zweiten Staffel geraten Castle und Beckett bei der Aufklärung eines Profimordes in eine brenzlige Agentengeschichte ganz nach dem Geschmack des Autors.“"
                            },
                            {
                                "example_id": "5fff8e6a-013f-4b20-93b4-32eb34347ed1",
                                "sense_id": "1d4a1260-2191-331d-8c3d-b7ec68d1ad71",
                                "text": "„Möglicherweise kam die Agentengeschichte auch deswegen nicht so gut an, weil der Name ‚Jerry Cotton‘ zu weit weg war vom heutigen Kinopublikum.“"
                            },
                            {
                                "example_id": "9267f3e0-583e-4654-94a0-eea6d01852ce",
                                "sense_id": "1d4a1260-2191-331d-8c3d-b7ec68d1ad71",
                                "text": "„Russland bemüht sich nach Berichten georgischer Medien um eine weitere Eskalation der Krise mit Georgien und hat aus der Trickkiste der Zeit des Kalten Krieges nun eine Agentengeschichte hervorgezaubert."
                            },
                            {
                                "example_id": "86656020-ceff-4dfc-9042-5d95c4963c5e",
                                "sense_id": "1d4a1260-2191-331d-8c3d-b7ec68d1ad71",
                                "text": "„Und es war ja gerade nicht meine Intention, eine Analyse der realen Gefahrenlage zu schreiben, sondern eine spannende Agentengeschichte.“"
                            },
                            {
                                "example_id": "14d90530-6413-46c7-8471-a1c3fe812e4a",
                                "sense_id": "1d4a1260-2191-331d-8c3d-b7ec68d1ad71",
                                "text": "„Was sie aber nicht wussten: Der ‚schöne Peter‘ diente lange Jahre dem BND als Spitzel und versorgte seinen Auftraggeber mit pikanten Details aus dem Leben seiner ‚Glückspieler‘. Was, sie glauben das nicht? Sie haben Recht. Die Agentengeschichte ist Lug und Trug – aber durchaus denkbar, siehe ‚Geständnisse – Confessions of a Dangerous Mind‘, die angeblich wahre Geschichte der amerikanischen TV-Berühmtheit Charles ‚Chuck‘ Hirsch Barris, der in seiner Autobiografie behauptet: ‚Ich habe Pop Songs geschrieben, ich war Fernsehproduzent. Ich bin für die Verschmutzung der Fernsehlandschaft mit hirnerweichendem und kindischem Entertainment verantwortlich.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
