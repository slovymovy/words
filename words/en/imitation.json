    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a772c789-f524-3d82-8fc4-08b6aadccad5",
                    "sense_definition": "The act of copying or mimicking the behavior, appearance, or actions of someone or something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imitation_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child learned to speak through the <w>imitation</w> of his parents."
                        },
                        {
                            "text": "He performed a funny <w>imitation</w> of the teacher's walk."
                        }
                    ],
                    "synonyms": [
                        "copying",
                        "replication"
                    ],
                    "antonyms": [
                        "creation"
                    ],
                    "common_phrases": [
                        "in imitation of"
                    ]
                },
                {
                    "sense_id": "45b7ca43-88d2-3995-b9ee-9a65e2d0c42d",
                    "sense_definition": "A thing that is made to look like something else, often of lower quality or value than the original.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "imitation_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jacket is made of <w>imitation</w> leather rather than real animal skin."
                        },
                        {
                            "text": "This cheap <w>imitation</w> of a designer watch stopped working after only one week."
                        }
                    ],
                    "synonyms": [
                        "imitation"
                    ],
                    "common_phrases": [
                        "imitation leather"
                    ]
                }
            ]
        }
    ]
