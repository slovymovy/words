                                            {
                                                "example_id": "ef4a6aaf-c9f0-4f2e-aab5-d37d3194790a",
                                                "sense_id": "61ce4ed5-8377-39d1-9ac3-cb17bb0a5ade",
                                                "text": "Als Kind gab es für ihn kein Entkommen vor dem sonntäglichen Kirchgang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1923e7a2-86f8-3ae8-b9c4-455da5b8ab46",
                                        "entry_id": "4dfe7e97-0bba-3999-9e44-09b4625def94",
                                        "glosses": [
                                            "wie an einem Sonntag üblich, zu diesem Wochentag passend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf57841f-ac0e-4ac7-ba3a-0a05dd22de23",
                                                "sense_id": "1923e7a2-86f8-3ae8-b9c4-455da5b8ab46",
                                                "text": "Für den Theaterbesuch hatten sich die Jugendlichen überraschenderweise sogar sonntäglich gekleidet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a6f05c2-6521-403b-b644-a7e15e6194b0",
                        "source_entry_id": "8752fcbe-4f2a-31d1-a73a-c3fe2df0e4e0",
                        "source_sense_description": "Relatif au dimanche.",
                        "target_lang_word": "Sunday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sunday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "679aee5a-e3ce-36c0-9ebe-c4949788ffd4",
                                        "entry_id": "39ecb485-f410-3083-8283-14584cc72ec1",
                                        "glosses": [
                                            "The first day of the week in many religious traditions, and the seventh day of the week in systems using the ISO 8601 standard; the Christian Sabbath; the Lord's Day; it follows Saturday and precedes Monday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f1d7b9-b85d-4adb-ac63-666152b9ef2a",
                                                "sense_id": "679aee5a-e3ce-36c0-9ebe-c4949788ffd4",
                                                "text": "Every day is like Sunday / Every day is silent and grey"
                                            },
                                            {
                                                "example_id": "328b1b5d-6fb6-40c2-b26c-f6739c242924",
                                                "sense_id": "679aee5a-e3ce-36c0-9ebe-c4949788ffd4",
                                                "text": "And after missing a simple header in the first half, the Manchester United striker ensured England topped Group D to set up a quarter-final meeting with Italy in Kiev on Sunday."
                                            },
                                            {
                                                "example_id": "0dcfb7de-d3ff-4958-a354-d89244136e59",
                                                "sense_id": "679aee5a-e3ce-36c0-9ebe-c4949788ffd4",
                                                "text": "But on that Sunday it was filled with Episcopalians from around the country who had traveled to South Bend to attend his campaign launch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27055f8a-8e8e-3fd2-9a54-c331f772a715",
                                        "entry_id": "39ecb485-f410-3083-8283-14584cc72ec1",
                                        "glosses": [
                                            "A newspaper published on Sunday."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b82a4d6-ea82-40dc-8c31-d0a32617b411",
                                                "sense_id": "27055f8a-8e8e-3fd2-9a54-c331f772a715",
                                                "text": "I gave him the switchboard with my love, went down to the Savoy for breakfast and read the Sundays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c8ae0f-6cc6-31f0-a075-1b0652e20ef7",
                                        "entry_id": "39ecb485-f410-3083-8283-14584cc72ec1",
                                        "glosses": [
                                            "A comic strip published in a Sunday newspaper."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca4ceea-dc0d-44cf-a7d4-d2239d0434f2",
                                                "sense_id": "45c8ae0f-6cc6-31f0-a075-1b0652e20ef7",
                                                "text": "It just wasn't his thing, although he did beautiful Sundays for however long he did them. So as soon as he could, he hired someone to do the Sundays. Karen and I would do some dailies, but we were the Sunday artists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8acdb6f-fd3a-31bb-ab7b-db97dd27785e",
                                        "entry_id": "39ecb485-f410-3083-8283-14584cc72ec1",
                                        "glosses": [
                                            "Describes someone who does something occasionally or casually, and therefore without skill."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99c4a3f-36ec-4270-9206-547f1d821292",
                                                "sense_id": "a8acdb6f-fd3a-31bb-ab7b-db97dd27785e",
                                                "text": "Your face is the color of a Sunday swimmer who swallowed half the pool."
                                            },
                                            {
                                                "example_id": "ca36971e-d1eb-4fa0-a4b2-76cd7adb1cef",
                                                "sense_id": "a8acdb6f-fd3a-31bb-ab7b-db97dd27785e",
                                                "text": "My limbs felt hollow, empty. Empty, empty, empty. A Sunday cyclist on a casual ride could have passed me."
                                            },
                                            {
                                                "example_id": "bbeb4e6f-4e50-4e62-b67f-385d0c445c69",
                                                "sense_id": "a8acdb6f-fd3a-31bb-ab7b-db97dd27785e",
                                                "text": "Below, a Sunday painter dabs at a canvas near the Pont Neuf, his suit as natty as any Landru wore. He tilts his bowler hat and steps back to view his efforts. 'What is a Sunday painter?' Matisse says aloud. 'When we start, we are all Sunday painters.'"
                                            },
                                            {
                                                "example_id": "928e0156-a3ee-47e6-8936-981175f786a3",
                                                "sense_id": "a8acdb6f-fd3a-31bb-ab7b-db97dd27785e",
                                                "text": "If he even tries it, then his addiction will take over again. An alcoholic can never become a “Sunday drinker”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "750f2cef-9dae-3a57-8b69-f2784abcb164",
                                        "entry_id": "39ecb485-f410-3083-8283-14584cc72ec1",
                                        "glosses": [
                                            "Describes something particularly fine and elegant, particularly something that could be worn to or used at church."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5c3ea5-0b1b-462d-aabc-14058f1af734",
                                                "sense_id": "750f2cef-9dae-3a57-8b69-f2784abcb164",
                                                "text": "His father replies with a special tone of voice (his 'Sunday voice', which he also used for reading fairy tales): 'That is about the tragedy of human beings!'"
                                            },
                                            {
                                                "example_id": "cc5f77d3-aae2-474f-9833-2c8fa2a72748",
                                                "sense_id": "750f2cef-9dae-3a57-8b69-f2784abcb164",
                                                "text": "It landed on the wire mesh in front of me, thrust its thin, monkey-arm through the wire, seized my Sunday hat, blue satin ribbons, rosettes and all, and squealing in triumph made off with it, leaping and bounding, to the top of the monkey-tree."
                                            },
                                            {
                                                "example_id": "204fb4af-48a9-463c-9ad9-5e28c59791ba",
                                                "sense_id": "750f2cef-9dae-3a57-8b69-f2784abcb164",
                                                "text": "On the day of the show I decided to wear my good blue Sunday suit, even though Ms. Arnoldi had prescribed flannel shirts, boots, and jeans for all the boys."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sunday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f24127-1b86-3e84-8b26-842b7d2ed21e",
                                        "entry_id": "6ad8fdb4-5689-39fa-a9ea-5c037cecc866",
                                        "glosses": [
                                            "To spend Sunday (at a certain place, with a certain person or people, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f78a65-616a-4822-a774-3751c9dd7656",
                                                "sense_id": "f8f24127-1b86-3e84-8b26-842b7d2ed21e",
                                                "text": "I waded through accounts of new calves and colts, new fences and barns, who “Sundayed” with his brother, etc., and soon had a list of all the cases in that part of the country."
                                            },
                                            {
                                                "example_id": "df8681ae-ee17-4ff8-a783-6f7124b60867",
                                                "sense_id": "f8f24127-1b86-3e84-8b26-842b7d2ed21e",
                                                "text": "The dogs and I were Sundaying on the garden lawn."
                                            },
                                            {
                                                "example_id": "a3cddd24-b234-4e93-a013-2265c41b31be",
                                                "sense_id": "f8f24127-1b86-3e84-8b26-842b7d2ed21e",
                                                "text": "2016, Brian Finnegan, “Your Sunday Best,” in totallydublin.ie,\nWhen we’re Sundaying in the city, I like nothing better than to roll out of bed and head straight for Noshington on the corner of South Circular Road and Washington Street, for one of their hugely satisfying weekend brunch options."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sunday",
                                "target_lang_code": "en",
