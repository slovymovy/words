                        "glosses": [
                            "Extrémité d'un tentacule renflé et chargé de cnidoblastes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b5c312-63a4-48fc-9d18-933bdeaeb3a8",
                                "sense_id": "c6990ed5-2dbf-3a49-b1c5-8cae7c326579",
                                "text": "On trouve dans les acrosphères plusieurs types de nématocystes. Dans celles de Sideractis glacialis on trouve des holotriches, des microbasiques b-mastigophores, des p-mastigophores et les spirocystes."
                            }
                        ]
                    },
                    {
