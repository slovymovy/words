                    },
                    {
                        "form_id": "3bd28582-4293-4d8e-8b87-1f0fecf05294",
                        "entry_id": "ee322047-0e5d-3f19-a5fa-b281fe7129f6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Magengrimmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                        "entry_id": "ee322047-0e5d-3f19-a5fa-b281fe7129f6",
                        "glosses": [
                            "Schmerzgefühl im Bauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9d8655-3806-47ad-ae45-d825bbfbf4e9",
                                "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                                "text": "„Ich mag nicht zu viel von dieser gewürzten Soße kosten, weil ich befürchte, dass sie mir des Nachts Magengrimmen verursacht.“"
                            },
                            {
                                "example_id": "79f189e8-afc2-4cab-96af-155b5794fe50",
                                "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                                "text": "„Kamille ist eh bekannt für seine Antikrampfwirkung, bekamen wir ihn nicht schon als Kinder bei Bauch- oder Magengrimmen als Tee?“"
                            },
                            {
                                "example_id": "5a84a0cb-adae-441a-9449-34a97cca48d1",
                                "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                                "text": "„Alles sprach für einen grippalen Infekt: Magengrimmen, Knochen- und Gliederschmerzen.“"
                            },
                            {
                                "example_id": "7647c461-5099-4bbc-9873-54f4829bf2f1",
                                "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                                "text": "„Darauf hat er ihr drei von diesen Tabletten gegeben – die seien gegen Durchfall und Magengrimmen, ein wahres Wundermittel, das ihren aufgebrachten Bauch schnell beruhigen würde …“"
                            },
                            {
                                "example_id": "9dddc540-cbfc-4040-bcb2-1263f9eace8b",
                                "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                                "text": "„Wieder lachte er schallend und hielt sich den Bauch, als habe er Magengrimmen.“"
                            },
                            {
                                "example_id": "df9f87b7-67c2-4cd5-983d-5195f01a3463",
                                "sense_id": "202dae5c-836a-3d0e-8a6b-237506cac7e0",
                                "text": "„Unsere Gefühlswelt – Magengrimmen, Kopfschmerzen, Schmetterlinge im Bauch, Herzklopfen, Schweiß in den Handflächen – ist hormonell bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                        "entry_id": "ee322047-0e5d-3f19-a5fa-b281fe7129f6",
                        "glosses": [
                            "unangenehmes Gefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50eafd8e-f621-4248-9218-3b2d824bea8a",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Unsere Gefühlswelt – Magengrimmen, Kopfschmerzen, Schmetterlinge im Bauch, Herzklopfen, Schweiß in den Handflächen – ist hormonell bestimmt.“"
                            },
                            {
                                "example_id": "dc5cf973-766d-4db5-95a9-d5fa8e2f0b1c",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Mich hier inmitten von so vielen Menschen zu befinden, verursachte mir Magengrimmen.“"
                            },
                            {
                                "example_id": "eb7259c7-a8fa-4912-b11a-c972883c94ba",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Das Magengrimmen entsteht, weil wir bei allem Neuen unsere Komfortzone verlassen müssen.“"
                            },
                            {
                                "example_id": "1dc88ed3-8a53-450e-bf0d-86f4c133808f",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Vor einer großen Menschenmenge frei zu sprechen, verursachte ihr schon jetzt Magengrimmen und Herzklopfen.“"
                            },
                            {
                                "example_id": "f77ec915-20d7-49b6-90d3-b7762c6eb716",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Die Ankunft der Polizei verursachte ihm Magengrimmen, aber er fuhr mit seiner Arbeit fort, als ob das Polieren der Gläser seine einzige Sorge wäre.“"
                            },
                            {
                                "example_id": "b8adc4cd-3b9e-4e64-ad46-686997d3e7ee",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Daß er ausgerechnet Engländer schonen sollte, bereitete dem Kapitän ein scheußliches Magengrimmen.“"
                            },
                            {
                                "example_id": "ed300419-ae13-4007-a665-de12e9e5a37d",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Die Vorstellung, Karin allein mit Pierre in dessen Praxis zu wissen, verursachte ihr heftiges unangenehmes Magengrimmen.“"
                            },
                            {
                                "example_id": "b5044f6d-15f5-4ff9-a948-7184329fbf79",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Ich hatte Magengrimmen, weil mein eng gestrickter Zeitplan mit ihrer Vorstellung von Liebe und Zusammensein nicht in Einklang zu bringen war.“"
                            },
                            {
                                "example_id": "716b2f4f-39e0-4e39-acf2-97f69ecb0db1",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Die Amis hatten aus allem eine Staatsaffäre gemacht, jedes noch so harmlose Magengrimmen war – akribisch verschlüsselt – untersucht worden.“"
                            },
                            {
                                "example_id": "305c684e-cd85-4a20-ab28-593fe375bcdd",
                                "sense_id": "bbe5da90-33c9-37ef-83e6-e5e59df27d61",
                                "text": "„Doch wenn das so ist, warum empfinden dann viele Menschen ein Magengrimmen, wenn etwas Neues ansteht?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
