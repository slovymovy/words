                "senses": [
                    {
                        "sense_id": "6848c649-fee4-31fe-ab23-738a3855a82a",
                        "entry_id": "74cb8537-60f4-383f-9bad-7dd7ca30c385",
                        "glosses": [
                            "ein Tag, an welchem aufgrund eines Ereignisses gefeiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa52313-081f-41b5-b05e-7b3abab4af0b",
                                "sense_id": "6848c649-fee4-31fe-ab23-738a3855a82a",
                                "text": "„Kurz vor Heiligabend mauerte das Kölner Straßentheater den Eingang von Karstadt zu.“"
                            },
                            {
                                "example_id": "7b47a726-9fe9-4e6d-86d9-801b40cce73d",
                                "sense_id": "6848c649-fee4-31fe-ab23-738a3855a82a",
                                "text": "„Ich antwortete ihr unverzüglich, daß sie mich an allen Festtagen in ihrer Kirche bei der Messe sehen werde; ich habe auch sofort damit begonnen.“"
                            },
                            {
                                "example_id": "126fd8ac-c6f0-4d2e-a0be-5026d93df7f6",
                                "sense_id": "6848c649-fee4-31fe-ab23-738a3855a82a",
                                "text": "„Hilfe kam ausgerechnet von der Hauseigentümerin, die vier Wochen vor dem Festtag ein Carepaket mit Kaffee und Zigaretten über den Atlantik nach Arolsen geschickt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad46391e-a0ff-3f26-b6aa-d0b157714c65",
                        "entry_id": "74cb8537-60f4-383f-9bad-7dd7ca30c385",
                        "glosses": [
