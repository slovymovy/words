            {
                "entry_id": "d1bb6843-59e8-3af5-a141-c5b3765e37d7",
                "word": "violet",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bfeb0247-fb28-3bc2-8ac5-6dcbf6f8581c",
                        "entry_id": "d1bb6843-59e8-3af5-a141-c5b3765e37d7",
                        "glosses": [
                            "een kleur tussen blauw en ultraviolet, met een golflengte tussen de 430 en 380 nm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd474f2-a48a-45d6-a5ff-4ae75225128d",
                                "sense_id": "bfeb0247-fb28-3bc2-8ac5-6dcbf6f8581c",
                                "text": "Rood, oranje, geel, groen, blauw, indigo en violet zijn de zeven kleuren van de regenboog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc517322-301d-4bcc-8017-a7607fe2d011",
                        "source_entry_id": "d1bb6843-59e8-3af5-a141-c5b3765e37d7",
                        "source_sense_id": "bfeb0247-fb28-3bc2-8ac5-6dcbf6f8581c",
                        "source_sense_description": "(kleur) een kleur tussen blauw en ultraviolet, met een golflengte tussen de 430 en 380 nm",
                        "target_lang_word": "Violett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Violett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbfc1a8-101d-3c7c-ac38-c18c806c2a96",
                                        "entry_id": "4263afb8-6a5f-3bf3-9dfd-967ada53a9fa",
                                        "glosses": [
                                            "Name des violetten Farbtons, eines bestimmten Abschnitts des sichtbaren Lichts im Spektrum der elektromagnetischen Wellen, Malfarbe, Streichfarbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d624f693-d6b3-48d1-ad38-826fbcc09da3",
                                                "sense_id": "4fbfc1a8-101d-3c7c-ac38-c18c806c2a96",
                                                "text": "Die Gardinen sind in einem kräftigen Violett."
                                            },
                                            {
                                                "example_id": "3c6e5c2a-2fe9-4c19-9e85-4fcc7357b81b",
                                                "sense_id": "4fbfc1a8-101d-3c7c-ac38-c18c806c2a96",
                                                "text": "„Auf dem Boden ein Raster aus weißen Fliesen, die Zeitschriften liegen auf Kante auf den Tischen, und die Wollschals im Garderobenschrank sind wie eine Farbskala von Blau über Violett zu Dunkelrot und Rot sortiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c1112cd-9c22-42a3-bea2-737a175c1b41",
                        "source_entry_id": "d1bb6843-59e8-3af5-a141-c5b3765e37d7",
                        "source_sense_id": "bfeb0247-fb28-3bc2-8ac5-6dcbf6f8581c",
                        "source_sense_description": "(kleur) een kleur tussen blauw en ultraviolet, met een golflengte tussen de 430 en 380 nm",
                        "target_lang_word": "violet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc56d64f-7cc8-3708-8c63-e36167ee74c9",
                                        "entry_id": "cd0cb5e3-4825-3765-abc4-72040e0fbc76",
                                        "glosses": [
                                            "A plant or flower of the genus Viola, especially the fragrant Viola odorata; (inexact) similar-looking plants and flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec76d2b-412e-4929-bdc2-881a560f840c",
                                                "sense_id": "cc56d64f-7cc8-3708-8c63-e36167ee74c9",
                                                "text": "Refreshed by their cooling bath of evening dew, the violets and other nocturnal flowers emitted a pleasant fragrance over the fields, but from the bogs and the rivulets came up now and then damp, penetrating gusts, that sent an icy chill through me."
                                            },
                                            {
                                                "example_id": "5384052c-0395-4883-85d8-b9eb492f1e9d",
                                                "sense_id": "cc56d64f-7cc8-3708-8c63-e36167ee74c9",
                                                "text": "Albertus Magnus, the thirteenth century philosopher and occultist, states that coriander, valerian, and violet are love producing herbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4a44ffc-88b8-3658-a3a9-06c08b4bc2d0",
                                        "entry_id": "cd0cb5e3-4825-3765-abc4-72040e0fbc76",
                                        "glosses": [
                                            "A person thought to resemble V. odorata, especially in its beauty and delicacy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90af45ce-54cb-4af0-82bf-1f050ea2aad5",
                                                "sense_id": "f4a44ffc-88b8-3658-a3a9-06c08b4bc2d0",
                                                "text": "‘Tom,’ he said, ‘you are looking at a crushed violet, a spent egg, a squeezed tube.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0310b327-3799-35f8-9761-dd7537bfd98e",
                                        "entry_id": "cd0cb5e3-4825-3765-abc4-72040e0fbc76",
                                        "glosses": [
                                            "The color of most violets; the colour evoked by the shortest visible wavelengths between 380 and 435 nm, an additive tertiary colour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd3574b3-14e5-3198-a014-46f0666d1681",
                                        "entry_id": "cd0cb5e3-4825-3765-abc4-72040e0fbc76",
                                        "glosses": [
                                            "Clothes and (ecclesiastical) vestments of such a colour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36204419-c1d5-3911-9ad5-6a1a57f930c1",
                                        "entry_id": "cd0cb5e3-4825-3765-abc4-72040e0fbc76",
                                        "glosses": [
                                            "The characteristic scent of V. odorata."
                                        ],
                                        "tags": [],
