                        "cross_references": [
                            {
                                "target_word": "Spinnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a763d794-ccb7-32bc-9c7d-e65905f6226e",
                                        "entry_id": "6f7a1535-d645-3b88-a877-7dcf091506d4",
                                        "glosses": [
                                            "weibliche Person, die das Spinnen betreibt, in einer Spinnerei arbeitet, Garn herstellt"
                                        ],
                                        "tags": [
                                            "Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938a2c30-7207-4276-ac99-6351ca59ee28",
                                                "sense_id": "a763d794-ccb7-32bc-9c7d-e65905f6226e",
                                                "text": "Eine Spinnerin arbeitet in einer Firma, die Garn für Textilien herstellt."
                                            },
                                            {
                                                "example_id": "dc8a3ea1-fd56-4522-971c-78146f4db4a2",
                                                "sense_id": "a763d794-ccb7-32bc-9c7d-e65905f6226e",
                                                "text": "„Isis, eine zeugende und gebärende Erdgöttin, die man sich als Spinnerin vorstellte und der man als Attribut die Spindel, als Zeichen der Weiblichkeit beigab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad7c236e-ed55-3f11-8b39-313ccfe617a5",
                                        "entry_id": "6f7a1535-d645-3b88-a877-7dcf091506d4",
                                        "glosses": [
                                            "weibliche Person, die unsinnige Gedanken, Vorstellungen hat/äußert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4326bdff-c040-497d-8d4d-e87de13ad0e7",
                                                "sense_id": "ad7c236e-ed55-3f11-8b39-313ccfe617a5",
                                                "text": "Alle halten sie für eine Spinnerin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "510f35db-bace-3615-aca8-9794dc211216",
                                        "entry_id": "6f7a1535-d645-3b88-a877-7dcf091506d4",
                                        "glosses": [
                                            "Spinne"
                                        ],
                                        "tags": [
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69cebd89-f826-4613-a156-e727509f76da",
                                                "sense_id": "510f35db-bace-3615-aca8-9794dc211216",
                                                "text": "„Ist diese erste Schichte dick genug, so verändert die Spinnerin ihre Lage und wiederholt dasselbe Verfahren anderswo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
