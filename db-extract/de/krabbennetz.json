                                    {
                                        "sense_id": "1e2f58b8-2bda-3846-b870-b2b589d77907",
                                        "entry_id": "6097cdd7-f2dc-31ea-a531-58d7b4c330ed",
                                        "glosses": [
                                            "Filet destiné à capturer les crevettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab2deb2-7773-4f82-9ddc-0296a18ee62c",
                                                "sense_id": "1e2f58b8-2bda-3846-b870-b2b589d77907",
                                                "text": "Il ne pouvait plus faire un pas sans croiser les deux pseudo-touristes affublés de filets à crevettes."
                                            },
                                            {
                                                "example_id": "3150e878-d9c1-4860-9526-0e8c219fe4fc",
                                                "sense_id": "1e2f58b8-2bda-3846-b870-b2b589d77907",
                                                "text": "Au même titre que le filet à papillon, le filet à crevettes a disparu de l’étal des marchands d’articles de loisirs."
                                            },
                                            {
                                                "example_id": "a49b2daa-a8c1-4cb5-b289-c2221e460825",
                                                "sense_id": "1e2f58b8-2bda-3846-b870-b2b589d77907",
                                                "text": "À son seau et sa pelle en fer-blanc, il préfère son filet à crevettes, qu’il pousse devant lui en raclant le fond des flaques à marée basse."
                                            }
                                        ]
                                    }
                                ]
                            }
