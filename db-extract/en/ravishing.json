                "senses": [
                    {
                        "sense_id": "aa117783-5ad2-3566-9332-03d40c8e3a8e",
                        "entry_id": "bb51d2aa-301c-3b8d-8936-cb1505e59811",
                        "glosses": [
                            "Extremely beautiful"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae513c6-0dd3-4918-beec-cf4a4ccf4615",
                                "sense_id": "aa117783-5ad2-3566-9332-03d40c8e3a8e",
                                "text": "Every time I get into a conversation with this ravishing girl, I want it to last forever."
                            },
                            {
                                "example_id": "a3ee075d-1f1f-4f7b-b86b-8da816a0cc71",
                                "sense_id": "aa117783-5ad2-3566-9332-03d40c8e3a8e",
                                "text": "Richard DeLongpre: Who did this to you?\nAllen Gregory DeLongpre: Possibly the most ravishing gal I've ever seen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffa6de00-85e7-4d9f-8310-8d74972279d9",
                        "source_entry_id": "bb51d2aa-301c-3b8d-8936-cb1505e59811",
                        "source_sense_id": "aa117783-5ad2-3566-9332-03d40c8e3a8e",
                        "source_sense_description": "Extremely beautiful",
                        "target_lang_word": "beeldschoon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beeldschoon",
