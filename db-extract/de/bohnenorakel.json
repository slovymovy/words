                "senses": [
                    {
                        "sense_id": "ea91e960-0df2-3c8f-9aac-5bede9df5794",
                        "entry_id": "19193531-68d9-3678-9c64-c9b751b14f70",
                        "glosses": [
                            "Methode zur Weissagung beziehungsweise zur Zukunftsdeutung mithilfe von Bohnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850a7764-3c89-4dd2-9843-050cff936b50",
                                "sense_id": "ea91e960-0df2-3c8f-9aac-5bede9df5794",
                                "text": "„Ist der Wahrsager bereit, sich des Falles anzunehmen, bestimmen sie gemeinsam mit dem Bohnenorakel einen günstigen Tag.“"
                            },
                            {
                                "example_id": "3db53d80-b9ea-474a-81e3-d8ca6561191b",
                                "sense_id": "ea91e960-0df2-3c8f-9aac-5bede9df5794",
                                "text": "„Das sogenannte Bohnenorakel („suerte de habas“), eine äußerst weitverbreitete Form der Zukunftsdeutung, die auch zum Liebeszauber Verwendung fand und vorwiegend von Frauen ausgeübt wurde.“"
                            },
                            {
                                "example_id": "c471d967-3007-41bc-b62c-f60e13dc75cc",
                                "sense_id": "ea91e960-0df2-3c8f-9aac-5bede9df5794",
                                "text": "„Der Preis für das Bohnenorakel betrug für die Gemeinde ebenfalls einen Stater […].“"
                            },
                            {
                                "example_id": "ad3358f7-7a8b-463f-8174-7f00ec85931e",
                                "sense_id": "ea91e960-0df2-3c8f-9aac-5bede9df5794",
                                "text": "„Ganz vertieft in das Bohnenorakel hörte und sah ich Nichts von der Außenwelt, als plötzlich zwei kräftige Arme mich faßten und mir Jemand einen Kuß aufdrückte, daß mir die Ohren klangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
