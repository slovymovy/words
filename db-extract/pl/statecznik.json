                        "entry_id": "41624de2-426c-3768-96ab-4b3fc6598c96",
                        "glosses": [
                            "urządzenie elektryczne mające za zadanie ograniczenie natężenia prądu płynącego przez lampę wyładowczą"
                        ],
                        "tags": [],
                        "examples": [],
