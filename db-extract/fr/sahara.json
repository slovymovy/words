        "fr-extract.jsonl": [
            {
                "entry_id": "95c77bd2-35d8-3a76-b14c-0ba5c295863f",
                "word": "Sahara",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6a67874-4a70-35da-81f5-d9e1579bd336",
                        "entry_id": "95c77bd2-35d8-3a76-b14c-0ba5c295863f",
                        "glosses": [
                            "Vaste désert chaud situé dans la partie nord du continent africain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b2894b-481a-4c9e-a453-4faa3703ef1e",
                                "sense_id": "f6a67874-4a70-35da-81f5-d9e1579bd336",
                                "text": "Ces chasseurs du Sahara sont des hommes rudes et primitifs, vivant à ciel ouvert, sans résidence fixe."
                            },
                            {
                                "example_id": "59180fd8-d0ae-47a5-a37c-4e279c81c368",
                                "sense_id": "f6a67874-4a70-35da-81f5-d9e1579bd336",
                                "text": "En descendant la côte d’Afrique, quand on a dépassé l’extrémité sud du Maroc, on suit pendant des jours et des nuits un interminable pays désolé. C’est le Sahara, la « grande mer sans eau » que les Maures appellent aussi « Bled-el-Ateuch », le pays de la soif."
                            },
                            {
                                "example_id": "907d882a-1ca9-4dcc-9d41-8b2c75b8f5ca",
                                "sense_id": "f6a67874-4a70-35da-81f5-d9e1579bd336",
                                "text": "Après la Libération, l’abbé de Lapparent reprit ses recherches en Provence. Il se rendit également en 1946 au Sahara, qui le fascina et où il multiplia les méharées, s’intéressant tout particulièrement au « Continental intercalaire ». Il y découvrit des restes de dinosaures, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9af656b-4548-4476-8412-5e8ab48c5fd6",
                        "source_entry_id": "95c77bd2-35d8-3a76-b14c-0ba5c295863f",
                        "source_sense_id": "f6a67874-4a70-35da-81f5-d9e1579bd336",
                        "target_lang_word": "Sahara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sahara",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40a70c89-96c1-30b5-a713-cb32dd25b590",
                                        "entry_id": "51375a74-daed-372a-b16d-e3809881922c",
                                        "glosses": [
                                            "die sich über das ganze nördliche Afrika erstreckende und mit über 9 Millionen Quadratkilometern größte Trockenwüste der Welt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe8619fb-fb38-4254-abf7-2def1b8cb604",
                                                "sense_id": "40a70c89-96c1-30b5-a713-cb32dd25b590",
                                                "text": "„Die Sahara ist mit neun Millionen km² die größte Trockenwüste der Erde.“"
                                            },
                                            {
                                                "example_id": "60e7bed9-366d-4d26-b157-ee4d7ca45dda",
                                                "sense_id": "40a70c89-96c1-30b5-a713-cb32dd25b590",
                                                "text": "„Ein Krankenbett in der Sahara ist wohl einer der unpassendsten Orte, um auf die Idee zu kommen, alleine mit dem Motorrad von London nach Kapstadt zu fahren.“"
                                            },
                                            {
                                                "example_id": "0581cd80-6061-4feb-ab6b-866ccb252cef",
                                                "sense_id": "40a70c89-96c1-30b5-a713-cb32dd25b590",
                                                "text": "„Staubstürme, die Partikel aus der Sahara nach Europa tragen, kommen seit Jahren regelmäßig vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
