                    {
                        "translation_id": "5c458d19-6004-46c2-b448-2456dd5ced45",
                        "source_entry_id": "d0f0e415-e8b4-3ef2-9a6e-577d516d81a4",
                        "source_sense_description": "city",
                        "target_lang_word": "Kharkiv",
