                "senses": [
                    {
                        "sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                        "entry_id": "08d84740-fd99-3482-99b7-e4deaeeba783",
                        "glosses": [
                            "een steekspel van argumenten tussen mensen met verschillende opvattingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "610fa777-c143-4c4a-8a70-6956bda70323",
                                "sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                                "text": "Een dode bij schietpartij tijdens debat over godslastering in Kopenhagen"
                            },
                            {
                                "example_id": "04147256-90cb-4c59-b702-b9a53297a63a",
                                "sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                                "text": "De nieuwbouw van de Tweemaster-Kameleon heeft een lange aanloop gehad. De discussie over de nieuwbouw duurt al zo'n twintig jaar. In de gemeenteraad zijn lange debatten geweest over het onderwerp. Zo zijn verschillende locaties aan bod gekomen, maar steeds was er te weinig ruimte voor een brede basisschool met bijbehorende voorzieningen."
                            },
                            {
                                "example_id": "9e736353-f254-461f-8f76-d809f844ad29",
                                "sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                                "text": "Buikhuisen kwam eind jaren 70 in opspraak nadat hij had aangekondigd onderzoek te willen doen naar de rol die erfelijkheid speelt bij crimineel gedrag. Buikhuisen was op dat moment werkzaam als hoogleraar criminologie aan de Universiteit van Leiden. Zowel in het maatschappelijk debat als onder zijn collega's kregen zijn onderzoeksvoorstellen felle kritiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89cbf434-29e2-4e30-a549-d7de3e6234f4",
                        "source_entry_id": "08d84740-fd99-3482-99b7-e4deaeeba783",
                        "source_sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                        "target_lang_word": "Debatte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Debatte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6a0a8a-7635-3a1c-ad83-54c5f52e388f",
                                        "entry_id": "34e193dc-e5e7-33b4-afcb-8f79766ceb6a",
                                        "glosses": [
                                            "Streitgespräch, das bestimmten Regeln folgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa68c5b-8ec8-4900-b1e1-edf31f6ce346",
                                                "sense_id": "0b6a0a8a-7635-3a1c-ad83-54c5f52e388f",
                                                "text": "Eine kritische Debatte über die durch die Einwanderung seit 30 Jahren entstandene Situation hat es nicht gegeben."
                                            },
                                            {
                                                "example_id": "1f0c1876-a15b-48ab-a32f-07942a248b6c",
                                                "sense_id": "0b6a0a8a-7635-3a1c-ad83-54c5f52e388f",
                                                "text": "„Doch früher oder später wird es auch die Intendanten von ARD und ZDF beschäftigen und ihnen eine neue Debatte über ihre Gebührenmilliarden bescheren.“"
                                            },
                                            {
                                                "example_id": "b023851c-e20a-43c9-b1a3-e5a12b1038f1",
                                                "sense_id": "0b6a0a8a-7635-3a1c-ad83-54c5f52e388f",
                                                "text": "„Bisher wurde es in zwei großen Debatten verhandelt.“"
                                            },
                                            {
                                                "example_id": "45ad4327-9fc8-4778-91cd-311117082d19",
                                                "sense_id": "0b6a0a8a-7635-3a1c-ad83-54c5f52e388f",
                                                "text": "„Als sehr anregend erweist sich die Einbindung der Debatte in die thematische Vorbereitung der erörternden Schreibformen.“"
                                            },
                                            {
                                                "example_id": "06f07475-a3da-4f49-bed7-b39827da9f56",
                                                "sense_id": "0b6a0a8a-7635-3a1c-ad83-54c5f52e388f",
                                                "text": "„In Deutschland sind durch die AfD Begriffe in die öffentliche Debatte eingeführt worden, die stark an den Nationalsozialismus erinnern: Volksverräter, Lügenpresse, linksgrün-versifft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a3ee961-bce5-33de-a300-54c7a48a539f",
                                        "entry_id": "34e193dc-e5e7-33b4-afcb-8f79766ceb6a",
                                        "glosses": [
                                            "Aussprache, Erörterung im Parlament"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4281441e-993e-4573-bf23-26210725de88",
                                                "sense_id": "5a3ee961-bce5-33de-a300-54c7a48a539f",
                                                "text": "Nach langen kontroversen Debatten hat die Bundesregierung Eckpunkte zur Bekämpfung von Kinderpornografie im Internet beschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fc20854-e00d-4d4d-b1c7-983a5cee53b9",
                        "source_entry_id": "08d84740-fd99-3482-99b7-e4deaeeba783",
                        "source_sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                        "target_lang_word": "debate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To participate in a debate; to dispute, argue, especially in a public arena."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bed9ca-6579-4253-b10d-6656efc74b9a",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "\"Debate me, coward!\" snarled the completely normal intellectual."
                                            },
                                            {
                                                "example_id": "eb8729b9-2bf5-42b3-aedf-adfdb483402c",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "a wise council […] that did debate this business"
                                            },
                                            {
                                                "example_id": "387097f8-b990-4f54-bc8d-c8fb97f52003",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "Debate thy cause with thy neighbour himself."
                                            },
                                            {
                                                "example_id": "2085742e-e8ad-4cad-b921-4bb66199dc19",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "He presents that great soul debating upon the subject of life and death with his intimate friends."
                                            },
                                            {
                                                "example_id": "4929d094-8fbd-46c4-a8c1-c9580f3dd815",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "When the legislation was debated by the House of Commons, Labour Deputy Leader Angela Rayner said it was \"riddled with holes\", while former Conservative Commons Leader Jacob Rees-Mogg said it was \"badly written\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To fight."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62eb8683-8fa3-4abe-81d2-61eac10f6536",
                                                "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                                "text": "Well knew they both his person, sith of late / With him in bloudie armes they rashly did debate."
                                            },
                                            {
                                                "example_id": "a85892a5-5746-46d6-ad07-1e4b15d4a429",
                                                "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                                "text": "[…] wasteful Time debateth with Decay,\nTo change your day of youth to sullied night"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To engage in combat for; to strive for."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "316e49f4-cedc-4910-8327-3a8a8feb97ef",
                                                "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                                                "text": "Volunteers […] thronged to serve under his banner, and the cause of religion was debated with the same ardour in Spain as on the plains of Palestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To consider (to oneself), to think over, to attempt to decide"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cafcb58-caf6-454d-bb64-311dbd02ed8e",
                                                "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                                                "text": "He was debating where he'd spend his holiday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "An argument, or discussion, usually in an ordered or formal setting, often with more than two people, generally ending with a vote or other decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c039e8c5-433c-4f00-a28d-5d18e9f9762f",
                                                "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                                                "text": "After a four-hour debate, the committee voted to table the motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "An informal and spirited but generally civil discussion of opposing views."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa23377-8856-4644-8c09-81cc82928210",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "The debate over the age of the universe is thousands of years old."
                                            },
                                            {
                                                "example_id": "5c5e2055-afc4-413d-aaea-a7eba9c9e737",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "There was a bit of a debate over who should pay for the damaged fence."
                                            },
                                            {
                                                "example_id": "c96da967-9dcf-4817-bf77-101d5ebc8e90",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives. And, as their ubiquity spreads, so too does the debate around whether we should allow ourselves to become so reliant on them – and who, if anyone, is policing their use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "Discussion of opposing views."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59179a42-5b68-447d-aa7e-882a53ecd7ef",
                                                "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                                "text": "There has been considerable debate concerning exactly how to format these articles."
                                            },
                                            {
                                                "example_id": "2c0c1e0e-3751-407a-8f93-4bb01bbd35e0",
                                                "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eccd06d-09d6-3dbd-8c22-52e2632c933f",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "A type of literary composition, taking the form of a discussion or disputation, commonly found in the vernacular medieval poetry of many European countries, as well as in medieval Latin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "825e5560-a37e-31fb-a29d-aa5c5193bc5b",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "Strife, discord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "460715f8-8339-408a-ab35-da8b6d933f50",
                        "source_entry_id": "08d84740-fd99-3482-99b7-e4deaeeba783",
                        "source_sense_id": "0a9a24e2-8ecc-3a9c-b72e-9fd1655a48ee",
                        "target_lang_word": "débat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01e35b29-51c8-3432-a89e-b9af5c088a67",
                                        "entry_id": "bc597e3e-a46f-3877-bdb9-19ded4d482f6",
                                        "glosses": [
                                            "Action de débattre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710f3ef9-dd85-478f-bc8d-48fad066eb92",
                                                "sense_id": "01e35b29-51c8-3432-a89e-b9af5c088a67",
                                                "text": "Par-delà les débats idéologiques, on a déjà pointé les dérives potentielles d’une société ultra-gérée (de Gaulejac, 2005) dans laquelle la production se réoriente en fonction d’indicateurs et d’objectifs de plus en plus souvent détachés de la réalité, tandis que le non-mesurable tend à être négligé."
                                            },
                                            {
                                                "example_id": "43cc2081-f11e-4322-baaa-6b48e7773740",
                                                "sense_id": "01e35b29-51c8-3432-a89e-b9af5c088a67",
                                                "text": "Ainsi la télévision publique est-elle un thème de débat, une posture obligée, une rhétorique de salon qui mériterait de figurer dans les mythologies des couches cultivées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc09dfd-f3e1-3319-af43-66fe610fbbc0",
                                        "entry_id": "bc597e3e-a46f-3877-bdb9-19ded4d482f6",
                                        "glosses": [
                                            "Contestation, altercation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cddba445-1790-4682-8c1f-3d99923c8f8d",
                                                "sense_id": "9cc09dfd-f3e1-3319-af43-66fe610fbbc0",
                                                "text": "La réal-politique peut donc, par cet exécutoire linguistique, banaliser le débat ou tout au moins le dépassionner."
                                            },
                                            {
                                                "example_id": "d140d9ea-b502-4583-bd37-c6677da3beb8",
                                                "sense_id": "9cc09dfd-f3e1-3319-af43-66fe610fbbc0",
                                                "text": "Apaiser un débat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c24f6340-28a1-30b2-a150-fd37c8842f6b",
                                        "entry_id": "bc597e3e-a46f-3877-bdb9-19ded4d482f6",
                                        "glosses": [
                                            "Discussion sur un sujet pouvant conduire à une décision"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355a11f9-65e5-4ac9-8401-e7286938cb7d",
                                                "sense_id": "c24f6340-28a1-30b2-a150-fd37c8842f6b",
                                                "text": "Outre les pays membres de l’Otan, la Finlande et la Suède, deux nations officiellement non-alignées mais où le débat sur une adhésion a été relancé par l’invasion russe en Ukraine, devraient envoyer un contingent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a94a823-b08b-3378-adf5-18b1fbf2cea1",
                                        "entry_id": "bc597e3e-a46f-3877-bdb9-19ded4d482f6",
                                        "glosses": [
                                            "Discussion, en parlant des assemblées politiques."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67da3eb3-2578-4634-bf70-1380fd28d309",
                                                "sense_id": "4a94a823-b08b-3378-adf5-18b1fbf2cea1",
                                                "text": "Les débats du Parlement d’Angleterre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfba3ba-6519-3221-96f7-06b3ae127360",
                                        "entry_id": "bc597e3e-a46f-3877-bdb9-19ded4d482f6",
                                        "glosses": [
                                            "Discussion publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef4c2e5-55af-48df-a934-d9ac204df4ec",
                                                "sense_id": "abfba3ba-6519-3221-96f7-06b3ae127360",
                                                "text": "Ouvrir, fermer les débats. — La clôture des débats. — Les débats ont duré plusieurs jours."
                                            },
                                            {
                                                "example_id": "d48bdf31-e90c-4443-922b-e56ec89022cc",
                                                "sense_id": "abfba3ba-6519-3221-96f7-06b3ae127360",
                                                "text": "Débats publics. — Les débats ont lieu quelquefois à huis clos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a7a24f-6c62-38aa-b501-3d38d3ea35cf",
                                        "entry_id": "bc597e3e-a46f-3877-bdb9-19ded4d482f6",
                                        "glosses": [
                                            "Fesses, arrière-train, en particulier d’une jeune femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f6b793-ceb3-4f60-bf8a-0988d9c7e604",
                                                "sense_id": "71a7a24f-6c62-38aa-b501-3d38d3ea35cf",
                                                "text": "Elles attiraient le regard de tous les hommes avec leurs larges débats."
                                            },
                                            {
                                                "example_id": "351b719f-a063-46f6-ad54-d6f52157bf1d",
                                                "sense_id": "71a7a24f-6c62-38aa-b501-3d38d3ea35cf",
                                                "text": "Les jeunes filles aiment bien porter des habits qui mettent leurs débats en valeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd03d908-cb62-3c7a-a5f1-1ae368e4d028",
                                        "entry_id": "1b83e4f5-99d6-30bb-b0a7-a2504535d006",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de débattre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63207534-8ba1-4d78-943f-88a6af887697",
                                                "sense_id": "dd03d908-cb62-3c7a-a5f1-1ae368e4d028",
                                                "text": "Cette valse-hésitation à un poste aussi stratégique résume le brouillard dans lequel notre meilleur ennemi se débat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
