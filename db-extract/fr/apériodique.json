                                "target_senses": [
                                    {
                                        "sense_id": "55ed35ad-5c86-3a62-ab4a-8aa61a3636d5",
                                        "entry_id": "77b20258-7797-3a64-a198-155f2c0fe923",
                                        "glosses": [
                                            "nicht periodisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e1c361-9129-4894-92a1-99eea15007b6",
                                                "sense_id": "55ed35ad-5c86-3a62-ab4a-8aa61a3636d5",
                                                "text": "„Die Lufttemperatur stand in einem ordnungsgemäßen Verhältnis zur mittleren Jahrestemperatur, zur Temperatur des kältesten wie des wärmsten Monats und zur aperiodischen monatlichen Temperaturschwankung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "129a21fe-35ad-3461-bdfd-e627d60b0a81",
                                        "entry_id": "77b20258-7797-3a64-a198-155f2c0fe923",
                                        "glosses": [
                                            "nicht oszillierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b1ee5c-caaa-4c25-ae45-4f67e5aadfdc",
                                                "sense_id": "129a21fe-35ad-3461-bdfd-e627d60b0a81",
                                                "text": "„Aperiodisch“ bezeichnet einen nicht oszillierenden Übergang von einem stationären Zustand in einen anderen."
                                            },
                                            {
                                                "example_id": "7dd9e9a7-c023-4548-8f05-c81d270406a0",
                                                "sense_id": "129a21fe-35ad-3461-bdfd-e627d60b0a81",
                                                "text": "„Die Bewegung eines Körpers ist aperiodisch, wenn er allmählich in seine Ruhelage zurückkehrt, ohne über sie hinauszuschwingen.“"
                                            },
                                            {
                                                "example_id": "1f72bdcd-88f6-4968-b6c2-7c123b8049e4",
                                                "sense_id": "129a21fe-35ad-3461-bdfd-e627d60b0a81",
                                                "text": "„Nach Abschluss des Regelvorgangs tritt eine alternierende, jedoch abklingende Druckschwingung oder eine aperiodisch abklingende Druckschwingung auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
