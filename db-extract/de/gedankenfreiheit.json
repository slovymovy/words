                ],
                "senses": [
                    {
                        "sense_id": "c17483bc-7efe-3c2d-b9d7-bed485e1d179",
                        "entry_id": "160159c2-4397-37c0-96ce-2dd633c86ed0",
                        "glosses": [
                            "Freiheit, zu denken was man möchte, insbesondere in Fragen der Weltanschauung und Politik"
                        ],
                        "tags": [
                            "Weltanschauung",
                            "Westen"
                        ],
                        "examples": [
                            {
                                "example_id": "a5281e4f-5c46-4d6e-a662-5ea0059ffe01",
                                "sense_id": "c17483bc-7efe-3c2d-b9d7-bed485e1d179",
                                "text": "„Sie [Gesetze] widersprechen dem Menschenrecht auf Gedankenfreiheit und sind mit einem Rechtsstaat nicht zu vereinbaren.“"
                            },
                            {
                                "example_id": "cc364f62-bd5b-4c1e-aa5a-530fc397a040",
                                "sense_id": "c17483bc-7efe-3c2d-b9d7-bed485e1d179",
                                "text": "„Art. 9 [der Europäische Menschenrechtskonvention] enthält die Menschenrechte der Gedankenfreiheit, der Gewissensfreiheit und der Religionsfreiheit.“"
                            },
                            {
                                "example_id": "71d5e682-3805-434d-9809-bcfbd9c86736",
                                "sense_id": "c17483bc-7efe-3c2d-b9d7-bed485e1d179",
                                "text": "„Auch berechtigte Fragen kommen zur Sprache; die wichtigste ist, jedenfalls in den Augen der arabischen Kommentatoren, warum es in Europa und Frankreich Gesetze gibt, die das Leugnen des Holocaust – richtigerweise – unter Strafe stellen und warum Deutschland negative Darstellungen von Juden in den Medien verbietet, während Kritik an den Symbolen des Islams als Ausdruck der Meinungs- und Gedankenfreiheit gelten soll; diesen Punkt sprach etwa Muhammad al-Ramihi im zuvor erwähnten Beitrag an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
