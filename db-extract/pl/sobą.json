                        "entry_id": "9b0a0585-59fe-3a8a-8841-402e9ede7de2",
                        "glosses": [
                            "…wskazujący na podmiot jako jednocześnie wykonawcę i odbiorcę czynności, używany z czasownikami rządzącymi narzędnikiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc52f561-bdaa-4f8f-8b28-c23a6a2e5238",
                                "sense_id": "891d108e-1bf3-3c0b-94dd-92a85615c0a2",
                                "text": "Możemy ze sobą rozmawiać godzinami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70e3c6b3-664d-49ab-9435-38f6889733c4",
                        "source_entry_id": "9b0a0585-59fe-3a8a-8841-402e9ede7de2",
                        "source_sense_id": "891d108e-1bf3-3c0b-94dd-92a85615c0a2",
                        "target_lang_word": "myself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myself",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "423445cd-fb31-3cd3-956f-38da13d99857",
                                        "entry_id": "ab7667f5-0624-307f-9f80-7f0e5c4d460f",
                                        "glosses": [
                                            "Me, as direct or indirect object the speaker as the object of a verb or preposition, when the speaker is also the subject."
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c83f9be5-8450-4f6a-9756-489b51a5c744",
                                                "sense_id": "423445cd-fb31-3cd3-956f-38da13d99857",
                                                "text": "I taught myself."
                                            },
                                            {
                                                "example_id": "5b4ab0b3-deec-4b94-aa4f-aa753e8381d2",
                                                "sense_id": "423445cd-fb31-3cd3-956f-38da13d99857",
                                                "text": "(I) don’t think much of your new car, myself."
                                            },
                                            {
                                                "example_id": "62a5e23c-f9b8-43a3-8316-b920d9293a4c",
                                                "sense_id": "423445cd-fb31-3cd3-956f-38da13d99857",
                                                "text": "Thinks I to myself, “Sol, you're run off your course again. This is a rich man's summer ‘cottage’ and if you don't look out there's likely to be some nice, lively dog taking an interest in your underpinning.”"
                                            },
                                            {
                                                "example_id": "282fe366-c8b9-44ea-a605-b32c767ddfa3",
                                                "sense_id": "423445cd-fb31-3cd3-956f-38da13d99857",
                                                "text": "“If you were a little bit kinder to yourself today, or if you gained insight, if you had an ‘Aha’ like, ‘Oh, man, I really do talk to myself the way my mom talked to me,’ or you identify a childhood wound … all of that is a form of reparenting,” she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4fc4d58-5623-38a9-9a0f-0ca28b31e5b5",
                                        "entry_id": "ab7667f5-0624-307f-9f80-7f0e5c4d460f",
                                        "glosses": [
                                            "Personally, for my part; used in apposition to I, sometimes for simple emphasis and sometimes with implicit exclusion of any others performing the activity described."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a38218a-679e-4cc1-b0e8-632f4c4da9c0",
                                                "sense_id": "f4fc4d58-5623-38a9-9a0f-0ca28b31e5b5",
                                                "text": "I myself have witnessed the event."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75d3e491-c7bb-3060-8f50-cb1e6c0ee442",
                                        "entry_id": "ab7667f5-0624-307f-9f80-7f0e5c4d460f",
                                        "glosses": [
                                            "In my normal state of body or mind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc031a7-ed0d-4c0f-87e0-2687267b9fb7",
                                                "sense_id": "75d3e491-c7bb-3060-8f50-cb1e6c0ee442",
                                                "text": "I feel like myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0873e4-a4ab-35f0-8f9e-17aa5f947c75",
                                        "entry_id": "ab7667f5-0624-307f-9f80-7f0e5c4d460f",
                                        "glosses": [
                                            "Me, as the object of a verb or preposition without a reflexive trigger. Sometimes used for intensifying the pronoun of oneself."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f704aaf1-7eef-4495-8dc8-c73e7554340a",
                                                "sense_id": "bc0873e4-a4ab-35f0-8f9e-17aa5f947c75",
                                                "text": "Give the ball to John or myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557eec69-3198-3596-a473-11c2d5508df4",
                                        "entry_id": "ab7667f5-0624-307f-9f80-7f0e5c4d460f",
                                        "glosses": [
                                            "I (as the subject of a verb)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6481302-6b62-4774-a0c2-a15f76733b34",
                                                "sense_id": "557eec69-3198-3596-a473-11c2d5508df4",
                                                "text": "My wife and myself want to go on vacation."
                                            },
                                            {
                                                "example_id": "bfe47b6d-fc30-442d-8256-4bd08752051e",
                                                "sense_id": "557eec69-3198-3596-a473-11c2d5508df4",
                                                "text": "And my selfe have knowen a Gentleman, a chiefe officer of our crowne, that by right and hope of succession (had he lived unto it) was to inherit above fifty thousand crownes a yeere good land[…]."
                                            },
                                            {
                                                "example_id": "4bb351ea-1842-4f0b-9693-a63459e0292e",
                                                "sense_id": "557eec69-3198-3596-a473-11c2d5508df4",
                                                "text": "Myself am confident that an ointment of it is one of the best remedies for a scabby head that is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6122b569-3021-3c65-8ea7-399bfe17b453",
                                        "entry_id": "ab7667f5-0624-307f-9f80-7f0e5c4d460f",
                                        "glosses": [
                                            "my name is..."
                                        ],
                                        "tags": [
                                            "India",
                                            "Pakistan",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b77201-18a9-430e-b4d2-32797fd74867",
                                                "sense_id": "6122b569-3021-3c65-8ea7-399bfe17b453",
                                                "text": "Myself John."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f875141d-1442-4f6d-82de-6b14a57ef049",
                        "source_entry_id": "9b0a0585-59fe-3a8a-8841-402e9ede7de2",
                        "source_sense_id": "891d108e-1bf3-3c0b-94dd-92a85615c0a2",
                        "target_lang_word": "yourself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yourself",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                        "entry_id": "ec981b62-ebe2-3d5e-9938-48f23a7fae7c",
                                        "glosses": [
                                            "Your own self (singular)."
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c787f8ff-fc41-4594-bb29-55f6c1285bd7",
                                                "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                                "text": "Be careful with that fire or you'll burn yourself."
                                            },
                                            {
                                                "example_id": "41c00eb1-bc79-43aa-afa6-d6db33b3421a",
                                                "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                                "text": "After a good night's sleep you'll feel like yourself again."
                                            },
                                            {
                                                "example_id": "1d9aee55-93a1-4238-b498-a13e624697f1",
                                                "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                                "text": "As an adult, you would find yourself being a people pleaser with the men in your life –– afraid to be rejected and emotionally abandoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7541cc1-572d-37d9-8fe7-2bd70be03373",
                                        "entry_id": "ec981b62-ebe2-3d5e-9938-48f23a7fae7c",
                                        "glosses": [
                                            "You (singular); used emphatically, especially to indicate exclusiveness of the referent's participation in the predicate, i.e., that no one else is involved."
                                        ],
                                        "tags": [
                                            "emphatic",
                                            "pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f00f413-03f9-467a-89a0-63482de6d8e3",
                                                "sense_id": "a7541cc1-572d-37d9-8fe7-2bd70be03373",
                                                "text": "You yourself know that what you wrote was wrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                        "entry_id": "ec981b62-ebe2-3d5e-9938-48f23a7fae7c",
                                        "glosses": [
                                            "You (singular); even when \\\"you\\\" has not been used previously; see usage notes."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "especially",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7481ef82-a0e2-48b8-ac11-2a6447eb551d",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "I spoke with yourself last in February."
                                            },
                                            {
                                                "example_id": "b1926751-57ac-4f8b-8541-849398e2e9f2",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "No one understands me like yourself."
                                            },
                                            {
                                                "example_id": "97e07701-765d-4445-ac2a-bc4f8906fb16",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "My colleague and yourself are invited to the conference."
                                            },
                                            {
                                                "example_id": "4b1cb4fc-07ad-4be6-b845-b49fff1c7af0",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "I only spoke to my lawyer and yourself about the issue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "913c89cf-ec30-4994-b523-eb1281a53dbe",
                        "source_entry_id": "9b0a0585-59fe-3a8a-8841-402e9ede7de2",
                        "source_sense_id": "891d108e-1bf3-3c0b-94dd-92a85615c0a2",
                        "target_lang_word": "himself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "himself",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "790faa07-561b-3569-b69a-deaed7c43505",
                                        "entry_id": "024ecc0f-4527-3d74-80f6-6e3969bf24a6",
                                        "glosses": [
                                            "Him; the male object of a verb or preposition that also appears as the subject"
                                        ],
                                        "tags": [
                                            "masculine",
                                            "personal",
                                            "pronoun",
                                            "reflexive",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e970c502-ef85-495f-939d-dcb8d3ff73f4",
                                                "sense_id": "790faa07-561b-3569-b69a-deaed7c43505",
                                                "text": "He injured himself."
                                            },
                                            {
                                                "example_id": "d17db0a3-67db-4c23-95ab-93f5fe6eda04",
                                                "sense_id": "790faa07-561b-3569-b69a-deaed7c43505",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "ae014f57-0f66-4e42-9c4b-303072b13ce7",
                                                "sense_id": "790faa07-561b-3569-b69a-deaed7c43505",
                                                "text": "One Terrorgram user livestreamed himself stabbing five people outside of a mosque in Turkey, she said, and a 19-year-old Slovakian man praised the group in a manifesto before killing two people at an LGBTQ bar in Bratislava, the capital of Slovakia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4cadc99-5d10-3045-b307-ddc1119535de",
                                        "entry_id": "024ecc0f-4527-3d74-80f6-6e3969bf24a6",
                                        "glosses": [
                                            "He; used as an intensifier, often to emphasize that the referent is the exclusive participant in the predicate"
                                        ],
                                        "tags": [
                                            "emphatic",
                                            "masculine",
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72ae6bd-e31b-449a-aa1c-ec588aef967b",
                                                "sense_id": "e4cadc99-5d10-3045-b307-ddc1119535de",
                                                "text": "He was injured himself."
                                            },
                                            {
                                                "example_id": "010268e9-d3f0-4ac9-a113-1155c525b45a",
                                                "sense_id": "e4cadc99-5d10-3045-b307-ddc1119535de",
                                                "text": "Therefore the Lord himſelfe ſhal giue you a ſigne:[…]."
                                            },
                                            {
                                                "example_id": "bfccd267-8a4f-4fb2-9812-2c29bfb6709f",
                                                "sense_id": "e4cadc99-5d10-3045-b307-ddc1119535de",
                                                "text": "The [Isaac] Newton that emerges from the [unpublished] manuscripts is far from the popular image of a rational practitioner of cold and pure reason. The architect of modern science was himself not very modern. He was obsessed with alchemy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f83f9e3-2d28-3783-bfbb-7c21d8489228",
                                        "entry_id": "024ecc0f-4527-3d74-80f6-6e3969bf24a6",
                                        "glosses": [
                                            "The subject or non-reflexive object of a predicate; he himself."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "masculine",
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a524cceb-952d-4829-b64b-46b4f02ff985",
                                                "sense_id": "8f83f9e3-2d28-3783-bfbb-7c21d8489228",
                                                "text": "Yet it is that himselfe had been liberally gratified by his Unkle with militarie rewards, before ever he went to warres."
                                            },
                                            {
                                                "example_id": "4533f97c-80f5-4f63-a9e1-5eaf317dd403",
                                                "sense_id": "8f83f9e3-2d28-3783-bfbb-7c21d8489228",
                                                "text": "With shame remembers, while himself was one / Of the same herd, himself the same had done."
                                            },
                                            {
                                                "example_id": "46fc8361-9a1b-4766-9f5c-6f856496d237",
                                                "sense_id": "8f83f9e3-2d28-3783-bfbb-7c21d8489228",
                                                "text": "Dennis: His glass is there and himself is in the toilet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15779eae-4b5e-356c-b28a-db5e69bbaa0f",
                                        "entry_id": "024ecc0f-4527-3d74-80f6-6e3969bf24a6",
                                        "glosses": [
                                            "The subject or non-reflexive object of a predicate; he (used of upper-class gentlemen, or sarcastically, of men who imagine themselves to be more important than others)"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "masculine",
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfa8296-8fc1-43f7-937b-20bc79ae7fd8",
                                                "sense_id": "15779eae-4b5e-356c-b28a-db5e69bbaa0f",
                                                "text": "Has himself come down to breakfast yet?"
                                            },
                                            {
                                                "example_id": "09b19f02-bc43-48bb-93e9-f2aac1c36585",
                                                "sense_id": "15779eae-4b5e-356c-b28a-db5e69bbaa0f",
                                                "text": "Have you seen himself yet this morning?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9ac21d7-94ca-4972-9fda-a1dd1f5f1780",
                        "source_entry_id": "9b0a0585-59fe-3a8a-8841-402e9ede7de2",
