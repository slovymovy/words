                "senses": [
                    {
                        "sense_id": "c56e9392-e256-3bb1-b7ae-8c5ea22920c8",
                        "entry_id": "9d00e08c-3a69-3b67-ac1d-86c0d88cacfc",
                        "glosses": [
                            "Donner un caractère compétitif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddacb5c2-7d05-49de-ba61-746061c07b07",
                                "sense_id": "c56e9392-e256-3bb1-b7ae-8c5ea22920c8",
                                "text": "Mais ce que ce tournoi révèle, c'est que naturellement, les joueurs veulent « compétitiviser » les débats."
                            },
                            {
                                "example_id": "40ab616a-85fa-4dc1-a281-dc9a372d46ef",
                                "sense_id": "c56e9392-e256-3bb1-b7ae-8c5ea22920c8",
                                "text": "Et je ne parle pas du bouclier fiscal juste pour les riches, du cadeau qu'on a fait à Tapie, de l'avion pour frimer, des milliards d'allègements de charges pour compétitiviser les usines, et qui n'ont servi à rien, de la TVA réduite pour que les restaurants embauchent et baissent leurs prix."
                            }
                        ]
                    }
                ],
