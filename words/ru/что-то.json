{
    "word_family": [
        "что",
        "ничто",
        "нечто"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "72fdb16b-7c2c-3689-b35e-18806c31bf6f",
                    "sense_definition": "неопределенный предмет или явление, о котором говорят, когда не знают точно, что это такое",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "indefinite_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>что-то</w> вижу в темноте.",
                            "target_lang_translations": {
                                "en": "I see <w>something</w> in the dark."
                            }
                        },
                        {
                            "text": "В сумке лежит <w>что-то</w> тяжелое.",
                            "target_lang_translations": {
                                "en": "There is <w>something</w> heavy in the bag."
                            }
                        }
                    ],
                    "antonyms": [
                        "ничто"
                    ],
                    "common_phrases": [
                        "что-то новое",
                        "что-то интересное"
                    ],
                    "target_lang_definitions": {
                        "en": "An unspecified object or phenomenon that the speaker cannot identify precisely."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "something",
                                "target_lang_sense_clarification": "An uncertain or unspecified thing."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1f13ba4-e6ce-3c16-a7e5-73b10436d50e",
                    "sense_definition": "некий объект или неопределенная вещь",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indefinite_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>что-то</w> вспомнил перед самым уходом.",
                            "target_lang_translations": {
                                "en": "He remembered <w>something</w> just before leaving."
                            }
                        },
                        {
                            "text": "<w>Что-то</w> темное показалось на горизонте.",
                            "target_lang_translations": {
                                "en": "<w>Something</w> dark appeared on the horizon."
                            }
                        }
                    ],
                    "common_phrases": [
                        "что-то сказать",
                        "что-то сделать"
                    ],
                    "target_lang_definitions": {
                        "en": "A certain object or an indefinite thing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "something",
                                "target_lang_sense_clarification": "An object whose nature is yet to be defined."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3b4e49d6-f14a-3567-86b0-5957916a67dc",
                    "sense_definition": "в некоторой степени, слегка, отчасти",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <w>что-то</w> стало грустно после этого разговора.",
                            "target_lang_translations": {
                                "en": "I felt <w>somewhat</w> sad after that conversation."
                            }
                        },
                        {
                            "text": "Погода сегодня <w>что-то</w> совсем испортилась.",
                            "target_lang_translations": {
                                "en": "The weather has gotten <w>somewhat</w> worse today."
                            }
                        }
                    ],
                    "synonyms": [
                        "отча́сти",
                        "слегка́"
                    ],
                    "antonyms": [
                        "сильно",
                        "полностью"
                    ],
                    "common_phrases": [
                        "что-то грустно",
                        "что-то холодно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To a certain degree, slightly, or partially."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "somewhat",
                                "target_lang_sense_clarification": "To a moderate degree."
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "Slightly or to a small extent."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0070c760-359f-35ca-9ee8-d79ece4be196",
                    "sense_definition": "по какой-то причине, неясно почему",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reason",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня должен быть дождь, но <w>что-то</w> он не начинается.",
                            "target_lang_translations": {
                                "en": "It was supposed to rain today, but <w>for some reason</w> it hasn't started."
                            }
                        },
                        {
                            "text": "Он <w>что-то</w> сегодня очень задумчив.",
                            "target_lang_translations": {
                                "en": "He is <w>for some reason</w> very pensive today."
                            }
                        }
                    ],
                    "synonyms": [
                        "почему́-то"
                    ],
                    "antonyms": [
                        "наверняка"
                    ],
                    "common_phrases": [
                        "что-то не идет",
                        "что-то не получается"
                    ],
                    "target_lang_definitions": {
                        "en": "For some reason, or it is unclear why something is happening."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for some reason",
                                "target_lang_sense_clarification": "Used when the cause of an event is unknown or puzzling."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e94cd93-559d-38f3-acc0-cb068cfdf7aa",
                    "sense_definition": "приблизительно, около",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Там было <w>что-то</w> около десяти человек.",
                            "target_lang_translations": {
                                "en": "There were <w>about</w> ten people there."
                            }
                        },
                        {
                            "text": "Это стоило <w>что-то</w> около тысячи рублей.",
                            "target_lang_translations": {
                                "en": "It cost <w>around</w> a thousand rubles."
                            }
                        }
                    ],
                    "synonyms": [
                        "приблизи́тельно"
                    ],
                    "antonyms": [
                        "точно"
                    ],
                    "common_phrases": [
                        "что-то около"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Approximately or about."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "about",
                                "target_lang_sense_clarification": "Used to indicate an approximate quantity."
                            },
                            {
                                "target_lang_word": "around",
                                "target_lang_sense_clarification": "Used to indicate an approximate amount or number."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "179789b9-4211-3964-86eb-b5c32aa9b858",
                    "sense_definition": "выражение неуверенности, сомнения или необъяснимости происходящего",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— <w>Что-то</w> на дачу больно похоже будет… а впрочем, это всё пустяки.",
                            "target_lang_translations": {
                                "en": "— It <w>somehow</w> looks a lot like a dacha... but anyway, it's all trivial."
                            }
                        },
                        {
                            "text": "Ну, <w>что-то</w> у вас глаза подозрительно бегают.",
                            "target_lang_translations": {
                                "en": "Well, <w>somehow</w> your eyes are darting around suspiciously."
                            }
                        }
                    ],
                    "synonyms": [
                        "наверное"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An expression of uncertainty, doubt, or the inexplicable nature of a situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "somehow",
                                "target_lang_sense_clarification": "Used to express that something feels strange or inexplicable."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}