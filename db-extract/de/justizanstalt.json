                "senses": [
                    {
                        "sense_id": "94f56c01-d8d9-39d1-ad8d-16eeabc817c3",
                        "entry_id": "f033e419-e44d-33e4-8b76-1112364a222c",
                        "glosses": [
                            "alle Gefängnisse des judikativen Strafvollzugs für den Vollzug von Freiheitsstrafen, dem Maßnahmenvollzug oder der Untersuchungshaft."
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "89b0775f-124b-4f08-aecd-7831d7556ba9",
                                "sense_id": "94f56c01-d8d9-39d1-ad8d-16eeabc817c3",
                                "text": "„Der doppelte Rücktritt war nun ein nahezu unausweichlicher Dienst. Wann Hoeneß seine Haftstrafe in der Justizanstalt Landsberg am Lech antreten muss, ist offen. Das Oberlandesgericht München wies darauf hin, dass das Urteil weiterhin nicht rechtskräftig sei.“"
                            },
                            {
                                "example_id": "952999dc-f278-40a5-82b0-4e40cd7f1735",
                                "sense_id": "94f56c01-d8d9-39d1-ad8d-16eeabc817c3",
                                "text": "„Diesfalls wäre der Inzest-Fall für die Gerichte erledigt und Josef F. würde zur Verbüßung seiner Strafe unverzüglich von der Justizanstalt St. Pölten, wo er seit Ende April als U-Häftling untergebracht ist, in eine Justizvollzugsanstalt verlegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
