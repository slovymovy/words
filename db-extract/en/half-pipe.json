                    },
                    {
                        "translation_id": "d5f23245-e085-43bb-ae4a-de7b646565c0",
                        "source_entry_id": "d8a1497e-5eb6-3061-8fb9-94bcba7e1862",
                        "source_sense_id": "f57e9924-b463-36e3-bff5-921e37293cc7",
                        "source_sense_description": "A structure used to perform tricks",
                        "target_lang_word": "demi-lune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-lune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deb02f74-655f-3091-9b52-55f96992b218",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Ouvrage de fortification correspondant à une porte et construit en avant d’une courtine pour couvrir la contrescarpe et le fossé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ec90d4-7f16-448b-8e66-2c022e056293",
                                                "sense_id": "deb02f74-655f-3091-9b52-55f96992b218",
                                                "text": "— Ce n’était ni le Castillet, ni ces six grands bastions de l’enveloppe, ni la demi-lune qu’il fallait attaquer. Si nous allons ce train, le grand bras de pierre de la citadelle nous montrera le poing longtemps encore."
                                            },
                                            {
                                                "example_id": "3353db23-bdf1-4072-adf1-706cee264519",
                                                "sense_id": "deb02f74-655f-3091-9b52-55f96992b218",
                                                "text": "Cette enceinte, faite de gros pieux pointus, hauts de quinze pieds, formait une sorte de demi-lune ou de cavalier sur sa partie antérieure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "102953dc-9bb8-31fe-a348-fe7e37b0c7e2",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Partie circulaire à l’entrée d’un palais, à l’extrémité d’un jardin, à la rencontre de plusieurs allées, de plusieurs routes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa32be31-2a04-4645-9dee-9ed9f9200fcc",
                                                "sense_id": "102953dc-9bb8-31fe-a348-fe7e37b0c7e2",
                                                "text": "À Paris, la place Vauban est en demi-lune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Forme de demi-cercle, de croissant de lune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69ef63fa-f311-4dc4-b179-d3f918d34ba9",
                                                "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                                "text": "Ce sont des hidalgos en escarpins, en frac prodigieux, avec le chapeau demi-lune sous le bras et des grappes de breloques sur le ventre, faisant des révérences à trois temps."
                                            },
                                            {
                                                "example_id": "1f87d15b-2607-4f64-8366-5316a2cec160",
                                                "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                                "text": "Le premier plan en était formé par le pont lui-même avec les gracieuses demi-lunes pratiquées au-dessus de chaque pile."
                                            },
                                            {
                                                "example_id": "345ea156-670f-4328-b096-2d0358e44017",
                                                "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                                "text": "D’autres, assis déjà, la face grise, accablée, levaient les yeux vers le plafond, où blanchissait le vitrage en demi-lune."
                                            },
                                            {
                                                "example_id": "1fa6305f-7511-4742-8ae3-737661387f44",
                                                "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                                "text": "Une salle claire, longue de seize mètres, avec des tables de sapin rose, des boiseries vernies le long des murs et ces fenêtres en demi-lune découpant si plaisamment le paysage."
                                            },
                                            {
                                                "example_id": "dd38c507-4896-40e7-8646-298c77b4146e",
                                                "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                                "text": "Sur l’autre côté, une pente peu sensible conduisait à la rivière. À proximité de celle-ci, là où le sol devenait plat, une arène grossière avait été aménagée. Des piquets plantés en demi-lune, reliés par des branches d’épineux, en fixaient les limites."
                                            },
                                            {
                                                "example_id": "1dea4c4f-6fe6-417b-9260-24c2140506eb",
                                                "sense_id": "184eb0b7-d16b-3e36-bcf1-08ff46056bf0",
                                                "text": "Ses lunettes en demi-lunes étaient perchées sur son front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b42742-2ce3-3506-898a-eeab8f49fc5e",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Outil dont se servent les plâtriers pour gratter les parties arrondies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60defda1-cd0b-321e-93f0-5d421eea2a9b",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Pâte alimentaire fourrée en forme de demi-lune."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "832082a0-c4c1-3d03-8a0e-07d8f61469bd",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Rampe de neige."
                                        ],
                                        "tags": [
                                            "Sports de glisse",
                                            "Sports d’hiver"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e252874a-131f-4c99-9dd2-4863aee2a63e",
                                                "sense_id": "832082a0-c4c1-3d03-8a0e-07d8f61469bd",
                                                "text": "La double championne du monde 2021 de ski acrobatique est sans rivale en demi-lune et en descente acrobatique (slopestyle), et peut même viser un triplé en or si elle prend part au grand saut (big air)."
                                            },
                                            {
                                                "example_id": "bbd3b018-f145-44b1-87a7-37b8e75b1227",
                                                "sense_id": "832082a0-c4c1-3d03-8a0e-07d8f61469bd",
                                                "text": "La planchiste québécoise Elizabeth Hosking, étoile montante de l’épreuve de demi-lune, sera de la grande finale, samedi soir, à la Coupe du monde de Mammoth Mountain, en Californie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8269b13-e726-386a-88e1-0a7e3cd8a100",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Arc de cercle situé devant la surface de réparation, non comptabilisé comme en faisant partie, dans lequel il est interdit aux joueurs de pénétrer lors d’un penalty, à l’exception du tireur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd6a60f-f5fe-4214-b444-8cd6aec20e66",
                                                "sense_id": "a8269b13-e726-386a-88e1-0a7e3cd8a100",
                                                "text": "Pour la presse espagnole, le VAR a checké les pieds de Navas sur le penalty, mais pas le fait que Verratti soit entré trop tôt dans la demi-lune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae88286-d706-321f-91d3-5c6d4b07c585",
                                        "entry_id": "37815930-0a04-38fa-bba2-201acaab07b9",
                                        "glosses": [
                                            "Instrument tranchant utilisé parfois dans les corridas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "936132e5-3c4b-4709-9f44-7ad07a8bba38",
                                                "sense_id": "fae88286-d706-321f-91d3-5c6d4b07c585",
                                                "text": "On emploie aussi quelquefois une espèce d’instrument appelé media luna (demi-lune), qui lui coupe les jarrets de derrière et le rend incapable de toute résistance ; alors ce n’est plus un combat, mais une boucherie dégoûtante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
