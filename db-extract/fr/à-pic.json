                        "form": "à-pics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                        "entry_id": "22615cd0-e9a4-37d2-b20f-178ea7e794a5",
                        "glosses": [
                            "Endroit d’une montagne dont la pente est très escarpée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ded33da-1978-4cd2-8acc-44ce17ca7352",
                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                "text": "[…] nous avons pu encore admirer les falaises de la côte Nord ; découpées en architectures fantastiques, elles se dressent parfois en à-pics de 600 mètres de hauteur."
                            },
                            {
                                "example_id": "8264d0f4-ecc3-4ba7-81b3-faa9ea82a0a1",
                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                "text": "On trouve en Bretagne des anatifes cramponnés en colonies serrées au bas des à-pics rocheux sans cesse battus par les vagues."
                            },
                            {
                                "example_id": "55fe912c-374e-4d89-85e7-67f724069642",
                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                "text": "En quittant les hautes terres de Tulancingo et en progressant vers le nord et l’est, on traverse la forêt sclérophylle pour aboutir dans une zone de montagnes escarpées où l’affleurement du Jurassique se traduit par une succession d'à-pics vertigineux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eacd85c-55ae-4d55-9711-b93335b17c6d",
                        "source_entry_id": "22615cd0-e9a4-37d2-b20f-178ea7e794a5",
                        "source_sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                        "target_lang_word": "Steilwand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steilwand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                        "entry_id": "4cfa73c7-12eb-33d0-968c-866794bf6cbf",
                                        "glosses": [
                                            "Felswand, die besonders steil ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a551b4a-a1be-464b-9fb8-d3ca68fa912c",
                                                "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                                "text": "Sie hatten großen Probleme, die Steilwand zu überwinden."
                                            },
                                            {
                                                "example_id": "c52bb645-66bd-4349-b829-feedbff0e904",
                                                "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                                "text": "„Wir ließen das Auto zurück und gingen zu Fuß am nackten Fels entlang den Berg hinauf, kletterten eine Steilwand hoch und klammerten uns dabei an eine im Fels befestigte Kette.“"
                                            },
                                            {
                                                "example_id": "e5bf34ad-2c29-455c-8e10-2ffae8db3b31",
                                                "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                                "text": "„Nach einer Viertelstunde hatten Harbert, der Reporter und Pencroff das Ende der Steilwand erreicht, der sie bei ihrem Wettlauf mit dem Sturm immer ausgewichen waren und verschnauften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
