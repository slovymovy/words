                        "hulpkreet",
                        "noodroep",
                        "hulproep"
                    ],
                    "common_phrases": [
                        "een noodkreet slaken",
                        "wanhopige noodkreet",
                        "dringende noodkreet"
                    ],
                    "target_lang_definitions": {
                        "en": "an urgent cry or expression from someone in a very difficult or dangerous situation"
                    },
