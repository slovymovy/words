                "senses": [
                    {
                        "sense_id": "854aff2d-8c04-3503-95d4-4de3234abc52",
                        "entry_id": "ee446dfe-1332-3fb4-8919-98d6668a2101",
                        "glosses": [
                            "To reduce the moisture in a body of air; to lower the humidity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa728590-3f71-4c96-b7f9-c3a120c05446",
                                "sense_id": "854aff2d-8c04-3503-95d4-4de3234abc52",
                                "text": "Many air conditioners, in addition to reducing the temperature, also dehumidify the air."
                            },
                            {
                                "example_id": "52cc90ad-8c81-4b06-95d0-d85c918f81bf",
                                "sense_id": "854aff2d-8c04-3503-95d4-4de3234abc52",
                                "text": "The air-handling equipment humidifies, dehumidifies, and distributes the correct amount of fresh air into every zone and eliminates all smoke, dust, and odors, with electric precipitrons."
                            },
                            {
                                "example_id": "b4dd8a67-823c-4778-b650-a4808448d17d",
                                "sense_id": "854aff2d-8c04-3503-95d4-4de3234abc52",
                                "text": "[...] the compressor and condenser units of the refrigeration apparatus, which cools and de-humidifies the air entering the cars, are underframe-mounted, with evaporator units in the ceiling, [...]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72fbc2b7-30ae-40ef-a690-9c3c9e78cce4",
                        "source_entry_id": "ee446dfe-1332-3fb4-8919-98d6668a2101",
                        "source_sense_id": "854aff2d-8c04-3503-95d4-4de3234abc52",
