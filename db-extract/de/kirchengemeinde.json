                        "form": "die Kirchengemeinde"
                    },
                    {
                        "form_id": "80f4c25e-17ef-4502-b45c-12dfcd4536e6",
                        "entry_id": "96d97033-795f-35aa-a18e-eb4ca470bb36",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kirchengemeinden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a538680-a8b2-3aff-a1c6-d74500eaac0c",
                        "entry_id": "96d97033-795f-35aa-a18e-eb4ca470bb36",
                        "glosses": [
                            "kleinste organisierte Verwaltungseinheit einer christlichen Religionsgemeinschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba07d92-2912-4cb6-b9d2-5b01f248a374",
                                "sense_id": "7a538680-a8b2-3aff-a1c6-d74500eaac0c",
                                "text": "„Ein Kirchenkreis ist in einigen evangelischen Kirchen ein Zusammenschluss mehrerer benachbarter Kirchengemeinden.“"
                            },
                            {
                                "example_id": "63149124-f027-4bec-aebb-6b53dc732d39",
                                "sense_id": "7a538680-a8b2-3aff-a1c6-d74500eaac0c",
                                "text": "„Er ist Mitglied im Gemeinderat und im Vorstand der evangelischen Kirchengemeinde; gelegentlich hält er die Sonntagspredigt, weil der Pfarrer frühzeitig senil und unfähig geworden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e794732-bbb2-4202-ac72-a82efd345cb7",
                        "source_entry_id": "96d97033-795f-35aa-a18e-eb4ca470bb36",
                        "source_sense_id": "7a538680-a8b2-3aff-a1c6-d74500eaac0c",
                        "source_sense_description": "kleinste organisierte Verwaltungseinheit einer christlichen Religionsgemeinschaft",
                        "target_lang_word": "communauté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communauté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd18fea5-99c1-3ce3-a7c8-09fe9f709ebc",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "État de ce qui est commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7ba3bb-62bd-4045-88a4-9c8005a6e5e1",
                                                "sense_id": "dd18fea5-99c1-3ce3-a7c8-09fe9f709ebc",
                                                "text": "[…] nous travaillâmes désormais ensemble, avec un accord et une communauté de jugement qu’il est rare de trouver entre deux hommes."
                                            },
                                            {
                                                "example_id": "d18e427b-19a9-4d19-8cf7-74d80dac4a36",
                                                "sense_id": "dd18fea5-99c1-3ce3-a7c8-09fe9f709ebc",
                                                "text": "Les Saint-Simoniens repoussent le système de la communauté des biens, car cette communauté serait une violation manifeste de la première de toutes les lois morales qu’ils ont reçu mission d’enseigner, et qui veut qu’à l’avenir chacun soit placé selon sa capacité et rétribué selon ses œuvres."
                                            },
                                            {
                                                "example_id": "811e9881-1c09-4568-ad61-29fd8a9bee6b",
                                                "sense_id": "dd18fea5-99c1-3ce3-a7c8-09fe9f709ebc",
                                                "text": "— Il savait que les femmes de l’aristocratie devenaient après leur mariage des meubles de communauté pour la famille et les amis de leur mari. Elles sont d'ailleurs bien trop dévotes pour être sensuelles. Les étrangers n'ont pas beau jeu à ce train de galanterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a4c3e5-e800-37cf-ba41-edff19ab15ba",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "Société de biens entre conjoints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6027afa-ba86-4e8f-8b7c-1f7db61986ee",
                                                "sense_id": "d1a4c3e5-e800-37cf-ba41-edff19ab15ba",
                                                "text": "La stipulation de reprise est une clause apposée dans un contrat de mariage, par laquelle il est porté que la femme, au cas qu'elle renonce à la communauté, reprendra franchement et quittement tout ce qu'elle aura mis dans ladite communauté."
                                            },
                                            {
                                                "example_id": "e071eba1-a298-4e6d-a70f-ad1d4983f22b",
                                                "sense_id": "d1a4c3e5-e800-37cf-ba41-edff19ab15ba",
                                                "text": "Les explications de l’huissier étaient claires et précises : Adélaïde avait, il est vrai, épousé Rougon sous le régime de la communauté ; mais toute la fortune consistant en biens-fonds, la jeune femme, selon la loi, était rentrée en possession de cette fortune, à la mort de son mari ; d’un autre côté, Macquart et Adélaïde avaient reconnu leurs enfants qui dès lors devaient hériter de leur mère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "Réunion ou association de personnes morales ou physiques, ayant des buts ou des intérêts communs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811be76b-a366-443c-ac39-9f2d04c4dc92",
                                                "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                                "text": "La cohabitation était assez harmonieuse mais les deux communautés menaient des vies distinctes. Les enfants juifs fréquentaient l’école du kheider, les enfants catholiques l’école de leur église."
                                            },
                                            {
                                                "example_id": "dadf6a65-9531-4413-bc31-3009219404bf",
                                                "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                                "text": "Enfin, à l'est de Sens, en 1177, les seigneuries laïques de Flagy et Bichereau font l'objet d'un traité de pariage avec le roi qui concède aux communautés paysannes la charte de Lorris."
                                            },
                                            {
                                                "example_id": "f9583bae-acb0-4451-baf6-46a91d12a241",
                                                "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                                "text": "Ce patchwork est encore plus manifeste dans les mégapoles, l’archétype étant New York avec ses communautés irlandaise, italienne, chinoise…, leurs quartiers et leurs festivités."
                                            },
                                            {
                                                "example_id": "f4ad64ff-4bd3-49e7-89f2-08fb8a77d4bf",
                                                "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                                "text": "Mais que dit, ou plutôt que fait l’Union européenne ? Elle ergote, ratiocine, tergiverse, louvoie, au point d’accréditer l’idée fâcheuse que, dans cette communauté de 27, il en coûte plus de transgresser les règles de bonne gestion que d’enfreindre celles d’une bonne démocratie. On punit la Grèce mais on ferme les yeux sur la Hongrie."
                                            },
                                            {
                                                "example_id": "ac5295e5-68c9-49c5-9944-d1c304d0411e",
                                                "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                                "text": "Mais peut-on interdire la sociabilité, au sein d’une communauté qui a l’habitude de se retrouver au bar-tabac Le Vézelien ou de discuter longuement en pleine rue ?"
                                            },
                                            {
                                                "example_id": "d750aa2d-21cc-46bc-8051-b600f91b2f11",
                                                "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                                                "text": "En dépit d’une politique très volontariste et l’ampleur des mesures prises par l’État depuis 1988, avec des investissements structurants dans le domaine des transports (transversale Koné-Tiwaka), de la santé (Médipôle de Koutio) ou de la formation (programmes « 400 Cadres » et « Cadres Avenir ») notamment, avec une discrimination positive en faveur des Kanak, les inégalités restent spectaculaires entre communautés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "230b188c-20a3-3f0b-9200-658f9c71b419",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "Société de plusieurs personnes qui vivent ensemble sous certaines règles religieuses et dans certaines pratiques de dévotion."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4985c16-c488-40e0-b781-313438fdec5c",
                                                "sense_id": "230b188c-20a3-3f0b-9200-658f9c71b419",
                                                "text": "La communauté désigne un groupe de consacrés qui, ayant fait profession de vie commune, vivent ensemble dans la même maison. Certains instituts ont aussi pris comme nom le terme générique de communauté."
                                            },
                                            {
                                                "example_id": "00f0e529-9c92-4c04-9554-615d2b87d28f",
                                                "sense_id": "230b188c-20a3-3f0b-9200-658f9c71b419",
                                                "text": "Une communauté de religieux, de religieuses, de femmes, de prêtres."
                                            },
                                            {
                                                "example_id": "f200a8a8-678a-4340-9349-a724d24a2d59",
                                                "sense_id": "230b188c-20a3-3f0b-9200-658f9c71b419",
                                                "text": "Le bonhomme, ayant fait cette acquisition, prit l'habit de derviche, pour mener une vie plus retirée, et fit faire plusieurs cellules dans la maison, où il établit en peu de temps une communauté nombreuse de derviches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298073d8-9c45-3e28-8c6d-147ffe7ad7b0",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "Maison religieuse où l’on vit en communauté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e3abdf-47ca-494d-bcf2-09629020797a",
                                                "sense_id": "298073d8-9c45-3e28-8c6d-147ffe7ad7b0",
                                                "text": "Le jardin de la communauté."
                                            },
                                            {
                                                "example_id": "8687cf15-2788-4160-bda7-c4b55e18aeb7",
                                                "sense_id": "298073d8-9c45-3e28-8c6d-147ffe7ad7b0",
                                                "text": "Nous visitâmes toute la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1ac4dca-20eb-3708-8abc-ebe3c9f91f86",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "Collectivité politique fédérée exerçant des diverses compétences liées à la culture, à l'éducation, à la santé ou encore à l'aide aux personnes."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c431ad1-6407-3899-bbca-2602fd21e46e",
                                        "entry_id": "73439a43-daac-30bd-b68b-95727604af0f",
                                        "glosses": [
                                            "Division administrative du Pays de Galles équivalente à la division administrative paroisse civile en Angleterre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
