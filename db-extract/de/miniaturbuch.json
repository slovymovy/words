                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daba5e07-5e10-42c3-82dc-212dafb995e8",
                                "sense_id": "b22edc63-26ac-3d72-a42c-1c4060e144a5",
                                "text": "„Bei Büchern mit einer Rückenhöhe bis 3 inches (76,2 mm) spricht man von Miniaturbüchern.“"
                            },
                            {
                                "example_id": "27becf3a-9582-40a7-8bc1-659c37d78c43",
                                "sense_id": "b22edc63-26ac-3d72-a42c-1c4060e144a5",
                                "text": "Anlässlich des Stadtjubiläums 1075 Jahre Duderstadt sind Eichsfelder Sagen in zwei verschiedenen Formaten als Miniaturbücher gedruckt worden."
                            },
                            {
                                "example_id": "421cc4b5-3fe4-461e-b346-3177e5ea30d3",
                                "sense_id": "b22edc63-26ac-3d72-a42c-1c4060e144a5",
                                "text": "„Neben den noch mit bloßem Auge lesbaren Miniaturbüchern gibt es mikroskopische Varianten, die nur mit der Lupe wahrnehmbar sind.“"
                            }
                        ],
