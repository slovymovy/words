        "de-extract.jsonl": [
            {
                "entry_id": "3212b001-2194-3941-b626-a743dfd3e9ed",
                "word": "wordplay",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2586551-421f-3b82-8361-e118114d3882",
                        "entry_id": "3212b001-2194-3941-b626-a743dfd3e9ed",
                        "glosses": [
                            "Wortspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1d363f-7ad9-4834-96a9-ca896f326fe2",
                                "sense_id": "a2586551-421f-3b82-8361-e118114d3882",
                                "text": "It isn't a wordplay.",
                                "translation": "Es ist kein Wortspiel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a20d73d5-943c-41d9-8c23-9db57ab2d27c",
                        "source_entry_id": "3212b001-2194-3941-b626-a743dfd3e9ed",
                        "source_sense_id": "a2586551-421f-3b82-8361-e118114d3882",
                        "source_sense_description": "Wortspiel",
                        "target_lang_word": "Wortspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                        "entry_id": "5e74d537-8cd5-3fcf-8e8c-7d9ff37403c5",
                                        "glosses": [
                                            "witziges Spiel mit Worten, z. B. mit deren Mehrdeutigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceafc35-e6dd-4a0c-a7dd-9ad5f9ea770a",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "Wortspiele sind selten in andere Sprachen übersetzbar."
                                            },
                                            {
                                                "example_id": "82d9accb-2c25-4a4b-b630-f9cacaa52e5f",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Womöglich erklärt sich die Beliebtheit des Wortspiels in diesem Fall schon durch seine auffallende Schlichtheit, die jedem Grundschulkind erlauben dürfte, es mühelos zu verstehen.“"
                                            },
                                            {
                                                "example_id": "72e72d28-f379-4fa7-abba-bf4dc824b50a",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Man hat in angelsächsischen Ländern einen besonderen Sinn für Wortspiele, sogenannte ‚puns‘, und macht sich seit jeher einen Spaß daraus, immer neue Abkürzungen zu erfinden…“"
                                            },
                                            {
                                                "example_id": "f33fdc48-cb6f-438e-b20e-c778881306df",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Auch ein wortspielender Satz wirkt kläglich, wenn er nur des Wortspiels wegen geschrieben wurde.“"
                                            },
                                            {
                                                "example_id": "dbc8ee82-f9ff-4b18-b771-36822acc2eb9",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Um die Gründung Warschaus rankt sich eine Legende, die auf einem Wortspiel beruht.“"
                                            },
                                            {
                                                "example_id": "68c809f2-7593-4a75-8d79-d58619e06a4d",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Allerdings gehen die Kalenberger Späße und Possen keineswegs auf ›calembours‹ oder Wortspiele hinaus, und so ist diese Etymologie auch wieder bestritten worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
