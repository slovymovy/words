                "senses": [
                    {
                        "sense_id": "588e9230-1f4f-31b2-ad63-64f57dfe3895",
                        "entry_id": "7fd56c00-bb7f-3522-bee7-3204415e8364",
                        "glosses": [
                            "typische Situation, in der sich Flüchtlinge befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64da7aa9-c8e3-4a0d-a883-1fbd708f1033",
                                "sense_id": "588e9230-1f4f-31b2-ad63-64f57dfe3895",
                                "text": "„Bedrohung und Hoffnungslosigkeit sind in erster Linie ein Gefühl, in zweiter ein Fakt. Thomas de Maizière sagte in einem Interview mit der ZEIT, dass mit Geld allein die Flüchtlingssituation in Deutschland nicht zu lösen sei; es müsse auch die Bereitschaft der Flüchtlinge geben, am Asylverfahren mitzuwirken, Ausweise vorzuzeigen, die Herkunft anzugeben. Aber wer könnte es Flüchtlingen verübeln, zu lügen, um der Heimat zu entkommen, nachdem man alles riskiert hat?“"
                            },
                            {
                                "example_id": "f53ff85b-5c9a-4226-9ba2-a878d1c7c01e",
                                "sense_id": "588e9230-1f4f-31b2-ad63-64f57dfe3895",
                                "text": "„Vom 1. Juli 1948 bis zu seinem frühen Tod war er Oberbürgermeister von Weiden.[2] Unter dem Eindruck der Flüchtlingssituation in den Nachkriegsjahren förderte er den Wohnungsbau.“"
                            },
                            {
                                "example_id": "8cff99f9-c032-42bc-a02d-3065b462ef07",
                                "sense_id": "588e9230-1f4f-31b2-ad63-64f57dfe3895",
                                "text": "„Für den weiteren Verlauf des Afghanistankriegs ist vor allem die Flüchtlingssituation in Pakistan von Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
