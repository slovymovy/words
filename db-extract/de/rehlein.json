                ],
                "senses": [
                    {
                        "sense_id": "ba4207f6-44ca-3f57-9a6a-3e3ab6460275",
                        "entry_id": "a47d399a-8243-3551-bd3a-da6de52e1789",
                        "glosses": [
                            "(kleines oder junges) Reh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbdd7b4-870c-4b0a-9c7a-3dbdc7f57beb",
                                "sense_id": "ba4207f6-44ca-3f57-9a6a-3e3ab6460275",
                                "text": "„Liebevoll päppelte das Paar das Rehlein auf – mit Ziegenmilch aus dem Supermarkt.“"
                            },
                            {
                                "example_id": "eb73fb2c-4076-46bb-80c9-079608c1e2a5",
                                "sense_id": "ba4207f6-44ca-3f57-9a6a-3e3ab6460275",
                                "text": "„Ein zartes Rehlein steht in einem ungastlichen Nebelwald, der aussieht, als wüchsen in ihm Knochen in den Himmel statt Bäume.“"
                            },
                            {
                                "example_id": "f991c682-fa46-429b-9521-88ee5371a1ed",
                                "sense_id": "ba4207f6-44ca-3f57-9a6a-3e3ab6460275",
                                "text": "„Im sächsischen Wald nämlich springt ein munteres Rehlein über Feld und Auen.“"
                            },
                            {
                                "example_id": "a8afd5e2-38df-4ff6-a50f-d1daca997683",
                                "sense_id": "ba4207f6-44ca-3f57-9a6a-3e3ab6460275",
                                "text": "„Eines Tages nun, da veranstaltete der König eine Jagd im Wald und das Rehlein wurde ganz unruhig, weil es liebend gerne bei diesem Abenteuer dabei gewesen wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
