                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3fdfa11-088d-3a81-a894-93df65732d28",
                        "entry_id": "e0057d65-bbe6-31c7-976c-bff54d31afb3",
                        "glosses": [
                            "Alternative letter-case form of menologium, particularly in reference to (Eastern Orthodoxy) specific editions of the menaia or synaxaria or (Roman Catholicism) biographical records of members of religious orders."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "52e04259-42d9-4ff5-9c9b-f289389b88c7",
                                "sense_id": "b3fdfa11-088d-3a81-a894-93df65732d28",
                                "text": "The Menologium of Basil II is an important work for understanding the medieval Byzantine church."
                            }
                        ]
                    }
                ],
                "translations": [],
