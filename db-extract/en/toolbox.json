                                            {
                                                "example_id": "cfbc9a70-e667-40dd-b226-0a0bb5d02bfe",
                                                "sense_id": "14e03ae0-3dfb-3b51-8dc1-ed6049efe7f6",
                                                "text": "Leg dat alsjeblieft terug in de gereedschapskist!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03fed809-cbd2-3416-9214-0e3d005e12eb",
                                        "entry_id": "a02a47b3-4ea7-366e-9508-ca48da061b6a",
                                        "glosses": [
                                            "aantal mogelijkheden tot actie"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b05190-aed8-4f75-a737-a28a5e82f642",
                                                "sense_id": "03fed809-cbd2-3416-9214-0e3d005e12eb",
                                                "text": "Het is „typisch Rutte”, vindt R. W. Maar ook weer niet helemaal. „Als premier doseerde hij het wat meer. Nu doet hij er een extra schep bovenop. Zijn hele gereedschapskist met overtuigende taal zet hij open voor onze Donald.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9114acd7-285b-4b95-bafa-94ec2fa0331e",
                        "source_entry_id": "a98d77e4-8f9f-3064-a931-6d9f8748399c",
                        "source_sense_description": "storage case for tools",
                        "target_lang_word": "boite à outils",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boite à outils",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11199799-6fa6-3014-b728-9b68b94681ae",
                                        "entry_id": "30826c5e-f5af-340d-9357-335a955ca586",
                                        "glosses": [
                                            "Coffret où ranger les outils de manière fonctionnelle pour pouvoir les protéger et les transporter plus facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33254052-f34b-4414-b72a-bdd146681981",
                                                "sense_id": "11199799-6fa6-3014-b728-9b68b94681ae",
                                                "text": "Ta boite à outils neuve me fait envie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6638fef-4324-346c-bc6d-b43b0057ef6b",
                                        "entry_id": "30826c5e-f5af-340d-9357-335a955ca586",
                                        "glosses": [
                                            "Ensemble d’outils, de méthodes, de techniques, de règles."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e58d0b-b83a-426b-8d29-d48e1d2366ce",
                                                "sense_id": "a6638fef-4324-346c-bc6d-b43b0057ef6b",
                                                "text": "Pour que sa boîte à outils soit complète, l’Europe devra encore se doter, dans les mois qui viennent, d’un règlement limitant les émissions de CO2 des camions : ces derniers peuvent aujourd’hui émettre sans aucun contrôle communautaire !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7aa37d-524c-395e-8ae8-64fa8eb0f4a3",
                                        "entry_id": "30826c5e-f5af-340d-9357-335a955ca586",
                                        "glosses": [
                                            "Ensemble des éléments d’aides pour travailler sur un site, une page Web, un progiciel, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b05cd56-7c06-44c2-8f65-64fc58c1e4bb",
                                                "sense_id": "ef7aa37d-524c-395e-8ae8-64fa8eb0f4a3",
                                                "text": "La boite à outils du Wiktionnaire comprend les « pages liées », les « pages spéciales » et offre la possibilité d’« importer une image ou un son »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5de15d79-919a-4e49-b281-86a938982c70",
                        "source_entry_id": "a98d77e4-8f9f-3064-a931-6d9f8748399c",
