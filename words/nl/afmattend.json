                    "sense_definition": "bijzonder vermoeiend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vermoeiend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lange wandeling in de hitte was erg <w>afmattend</w>.",
                            "target_lang_translations": {
