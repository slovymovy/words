            "senses": [
                {
                    "sense_id": "95db24ee-debb-316c-bc7a-e1320769730f",
                    "sense_definition": "Een vruchtbare plek in een woestijn waar water te vinden is en planten groeien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De reizigers waren opgelucht toen ze eindelijk een groene <w>oase</w> in de droge woestijn bereikten.",
                            "target_lang_translations": {
                                "en": "The travelers were relieved when they finally reached a green <w>oasis</w> in the dry desert."
                            }
                        },
                        {
                            "text": "In deze <w>oase</w> groeien prachtige palmbomen dankzij de natuurlijke waterbron.",
                            "target_lang_translations": {
                                "en": "Beautiful palm trees grow in this <w>oasis</w> thanks to the natural water source."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groene oase",
                        "oase in de woestijn"
                    ],
                    "target_lang_definitions": {
                        "en": "A fertile spot in a desert where water is found and plants grow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oasis",
                                "target_lang_sense_clarification": "fertile area in a desert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24741b0c-f2e7-3a04-b717-759362009860",
                    "sense_definition": "Een rustige, aangename plaats waar men kan ontspannen en ontsnappen aan de drukte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rustplek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verborgen binnentuin is een echte <w>oase</w> van rust midden in de drukke stad.",
                            "target_lang_translations": {
                                "en": "The hidden courtyard is a real <w>oasis</w> of peace in the middle of the busy city."
                            }
                        },
                        {
                            "text": "Na een lange werkweek voelt zijn vakantiehuisje aan als een heerlijke <w>oase</w>.",
                            "target_lang_translations": {
                                "en": "After a long work week, his holiday cottage feels like a wonderful <w>oasis</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustpunt",
                        "toevluchtsoord"
                    ],
                    "common_phrases": [
                        "oase van rust"
                    ],
                    "target_lang_definitions": {
                        "en": "A peaceful, pleasant place where one can relax and escape the hustle and bustle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oasis",
                                "target_lang_sense_clarification": "peaceful place or haven"
                            },
                            {
                                "target_lang_word": "haven",
                                "target_lang_sense_clarification": "place of safety or peace"
                            },
                            {
                                "target_lang_word": "sanctuary",
                                "target_lang_sense_clarification": "place of refuge and quiet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
