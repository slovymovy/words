                                        "sense_id": "133e7abe-c7e6-3dad-bc83-600ac53d63bc",
                                        "entry_id": "cdfa6c92-08b6-3630-9081-23801d194fe2",
                                        "glosses": [
                                            "A Catalan fish soup or stew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce5afcbe-15b1-46e9-85e7-c8255b7bb51e",
                                                "sense_id": "133e7abe-c7e6-3dad-bc83-600ac53d63bc",
                                                "text": "Only in Catalonia can you eat a proper zarzuela, a gargantuan fish soup; […]."
                                            }
                                        ]
                                    }
                                ]
