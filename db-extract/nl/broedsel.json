                "senses": [
                    {
                        "sense_id": "c09aa256-fda8-3d64-bbcf-f5bcafd9e924",
                        "entry_id": "71a3bd1a-c0f2-33de-bcf0-c1b2e0acc9dc",
                        "glosses": [
                            "een aantal gezamenlijk bebroede eieren en de jongen die daaruit voortkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1273c0a9-5cd2-4120-8a12-f3cd242aa444",
                                "sense_id": "c09aa256-fda8-3d64-bbcf-f5bcafd9e924",
                                "text": "Dit is het al het tweede broedsel dit jaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93b75aba-c428-46f4-9322-dd308e61fa34",
                        "source_entry_id": "71a3bd1a-c0f2-33de-bcf0-c1b2e0acc9dc",
                        "source_sense_id": "c09aa256-fda8-3d64-bbcf-f5bcafd9e924",
                        "target_lang_word": "clutch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06df2cbe-d6cb-37aa-af50-0212ea1dd872",
                                        "entry_id": "ac16c1ea-f6bd-3e48-9bfa-14fdb87621dd",
                                        "glosses": [
                                            "To hatch."
                                        ],
                                        "tags": [
                                            "collective",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "927c7f1b-3f7e-31a3-9fca-3cf440466d27",
                                        "entry_id": "6ac3c85a-f0ea-34ab-9816-78be5b7b99d1",
                                        "glosses": [
                                            "To seize, as though with claws."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1405737-a556-4ec2-b91b-b5d13972df2a",
                                                "sense_id": "927c7f1b-3f7e-31a3-9fca-3cf440466d27",
                                                "text": "to clutch power"
                                            },
                                            {
                                                "example_id": "e20e88bd-7a1d-420b-8b79-451f7bfe4d01",
                                                "sense_id": "927c7f1b-3f7e-31a3-9fca-3cf440466d27",
                                                "text": "A man may set the poles together in his head, and clutch the whole globe at one intellectual grasp."
                                            },
                                            {
                                                "example_id": "5c50e081-5b1c-496f-b60d-ff245283fb8c",
                                                "sense_id": "927c7f1b-3f7e-31a3-9fca-3cf440466d27",
                                                "text": "Is this a Dagger, which I ſee before me, [...] ? / Come, let me clutch thee: / I haue thee not, and yet I ſee thee ſtill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8331f8a1-3822-37c6-83f0-17209260ddf0",
                                        "entry_id": "6ac3c85a-f0ea-34ab-9816-78be5b7b99d1",
                                        "glosses": [
                                            "To grip or grasp tightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7dfade-7c0b-42f2-ba49-19cfab22ae61",
                                                "sense_id": "8331f8a1-3822-37c6-83f0-17209260ddf0",
                                                "text": "She clutched her purse tightly and walked nervously into the building."
                                            },
                                            {
                                                "example_id": "4f898474-70d4-4f1e-8274-e6e685226ea9",
                                                "sense_id": "8331f8a1-3822-37c6-83f0-17209260ddf0",
                                                "text": "Not that I haue the power to clutch my hand,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "953cf5bd-e58a-3278-8646-8c80838263ed",
                                        "entry_id": "6ac3c85a-f0ea-34ab-9816-78be5b7b99d1",
                                        "glosses": [
                                            "To win despite being the only remaining player on one's team, against several opponents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f3fb39-152d-4b79-9f4f-dab9954dde53",
                                                "sense_id": "953cf5bd-e58a-3278-8646-8c80838263ed",
                                                "text": "For quotations using this term, see Citations:clutch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0c2ed69-371c-3888-bfcf-3dc345f5dcf5",
                                        "entry_id": "6ac3c85a-f0ea-34ab-9816-78be5b7b99d1",
                                        "glosses": [
                                            "To unexpectedly or luckily succeed in a difficult activity."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3380b36-548a-3b6d-8bb4-12bf5eacedd3",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "The claw of a predatory animal or bird."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a1c412e-adba-3915-b29d-d97a9c553515",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "A grip, especially one seen as rapacious or evil."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02682f66-bdaa-40b0-982e-461ee63986b4",
                                                "sense_id": "5a1c412e-adba-3915-b29d-d97a9c553515",
                                                "text": "I muſt have great leiſure, and little care of my ſelf, if I ever more come near the Clutches of ſuch a Giant, who ſeems to write with a Beetle inſtead of a Pen; […]"
                                            },
                                            {
                                                "example_id": "0f4cf098-87d9-4b94-ad91-1119fd911ca3",
                                                "sense_id": "5a1c412e-adba-3915-b29d-d97a9c553515",
                                                "text": "Should when he pleaſes, and on whom he will / Wage war, with any or with no pretence / Of provocation, giv'n or wrong ſuſtained, / And force the beggarly laſt doit, by means / That his own humour dictates, from the clutch / Of poverty, that thus he may procure / His thouſands weary of penurious life / A ſplendid opportunity to die?"
                                            },
                                            {
                                                "example_id": "e34b840c-bcec-4136-a2e9-7f454d60274b",
                                                "sense_id": "5a1c412e-adba-3915-b29d-d97a9c553515",
                                                "text": "The more cunning heads thought it was all an expiring clutch at popularity, on the part of a Minister, whom domestic embarrassments, court intrigues, old age, and dropsy soon afterward finally drove from the helm."
                                            },
                                            {
                                                "example_id": "64302927-e681-4803-b63e-a80655f5ae91",
                                                "sense_id": "5a1c412e-adba-3915-b29d-d97a9c553515",
                                                "text": "You scold yourself; you know it is only your nerves—and yet, and yet … In a little while, it is impossible to resist the terror that seizes you, and you are helpless in the clutch of an unseen horror."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695034ad-17ee-300b-abf2-4bf3123602f9",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "A device to interrupt power transmission, commonly used to separate the engine and gearbox in a car."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d7f076e-16b1-3357-833d-b6110eb42ace",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "The pedal in a car that disengages power and torque transmission from the engine (through the drivetrain) to the drive wheels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62f7af9f-2fbb-31fc-b624-f04ac2234d70",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "Any device for gripping an object, as at the end of a chain or tackle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2eb3c00e-0f91-36ea-ae7c-ba257834ab60",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "A fastener that attaches to the back of a tack pin to secure an accessory to clothing. (See Clutch (pin fastener).)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e838ea2-8a74-33d0-8b2e-f2b492f47da6",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "A small handbag or purse with no straps or handle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd39424-ef3d-488f-a672-878276a41343",
                                                "sense_id": "7e838ea2-8a74-33d0-8b2e-f2b492f47da6",
                                                "text": "The clutch which I had made to save myself in falling had torn away from this chin-band and let the lower jaw drop on the breast, but little else was disturbed, and there was Colonel John Mohune resting as he had been laid out a century ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "An important or critical situation."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54914aad-43bb-46df-abf3-20c6d68428bb",
                                                "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                                                "text": "to come in clutch"
                                            },
                                            {
                                                "example_id": "6a146959-730b-4af2-8271-75717757a994",
                                                "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                                                "text": "And when it came to the clutch, Johnny Mize, who was washed up five years ago, would crack out a pinch double, or Mickey Mantle, who is not yet ready for the big leagues, would slam out a home run."
                                            },
                                            {
                                                "example_id": "371a2055-133c-4590-98e8-2b9de6fdf3db",
                                                "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                                                "text": "He is the player who has come through so often in the clutch during his days at Camarillo."
                                            },
                                            {
                                                "example_id": "f8308bf0-bc71-473f-9888-b20af9a2dcc4",
                                                "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                                                "text": "Stempel came through in the clutch again. GM's across-the-board launch of the catalytic converter was a coup that left Ford and Chrysler gaspind in the dust."
                                            },
                                            {
                                                "example_id": "60c4c4da-b75d-4ef1-b294-52af871a22a8",
                                                "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                                                "text": "But not just strong women: women who don’t turn to a man in the clutch; women whose strength is inseparable from the walls they’ve built around themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c41265e-e01f-3f99-8305-936c6f7b084e",
                                        "entry_id": "4483c115-b625-39cc-bf60-0e1393481b82",
                                        "glosses": [
                                            "A difficult maneuver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3735f7f-2341-30cd-968c-3602092a7d32",
                                        "entry_id": "6c75a238-4c78-3824-adff-116aaa9ed322",
                                        "glosses": [
                                            "Performing or tending to perform well in difficult, high-pressure situations."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e95d4adc-bca8-4331-befd-b0d653b64625",
                                                "sense_id": "d3735f7f-2341-30cd-968c-3602092a7d32",
                                                "text": "NC State made the most of their overtime possession scoring a touchdown on some very clutch plays."
                                            },
                                            {
                                                "example_id": "04411d6c-ae52-4081-ae21-46dd1bf2378c",
                                                "sense_id": "d3735f7f-2341-30cd-968c-3602092a7d32",
                                                "text": "I start with his most obvious characteristic: he was clutch. He is Mr. Clutch. In the last chapter I mentioned that Bernie Williams was clutch, which was a valid assessment, but nobody on the Yankees was as clutch as Jeter was."
                                            },
                                            {
                                                "example_id": "6e7e7e7a-da47-4875-8ba5-164bb036d501",
                                                "sense_id": "d3735f7f-2341-30cd-968c-3602092a7d32",
                                                "text": "It doesn't get more clutch than that!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d365009c-127f-3110-b3fd-ececb6631d08",
                                        "entry_id": "c5632769-75e5-3d08-a81d-f2bc23d186eb",
                                        "glosses": [
                                            "A brood of chickens or a sitting of eggs; a sitting."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "391fbbfd-d3cf-47fc-b98e-99d668faab04",
                                                "sense_id": "d365009c-127f-3110-b3fd-ececb6631d08",
                                                "text": "For instance, baby chicks influence their mother’s behaviour by giving high piercing cheeps when they are lost or cold. This usually has the immediate effect of summoning the mother, who leads the chick back to the main clutch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c042234f-e6c0-3215-a913-b19cde74eca4",
                                        "entry_id": "c5632769-75e5-3d08-a81d-f2bc23d186eb",
                                        "glosses": [
                                            "A group or bunch (of people or things)."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e9e935-4c4e-4e7b-8a92-a299d6ce9675",
                                                "sense_id": "c042234f-e6c0-3215-a913-b19cde74eca4",
                                                "text": "No longer would Britons routinely blame the national government when things went wrong. Instead they would demand action from a new clutch of elected mayors, police commissioners and the like."
                                            },
                                            {
                                                "example_id": "97405212-c2ed-4b29-a014-9612020a1b2b",
                                                "sense_id": "c042234f-e6c0-3215-a913-b19cde74eca4",
                                                "text": "And, so, although the Zeros knocked out four dive bombers (two of them permanently and two forced to abort), the other eleven made it to a position above Shōkaku, which pulled a neat evasive turn that sent the first clutch of thousand-pound bombs into the sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
