                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem tragischen Unglück versammelten sich die tief betrübten <w>Kläger</w> vor dem Rathaus."
                        },
                        {
                            "text": "Die lauten <w>Kläger</w> begleiteten den Leichenzug auf seinem Weg durch die dunklen Gassen."
