                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wait for the <w>green</w> before you drive through the intersection.",
                            "target_lang_translations": {
                                "ru": "Подожди <w>зелёного</w>, прежде чем проезжать перекрёсток."
                            }
                        },
                        {
                            "text": "The pilot confirmed they had three <w>greens</w> for landing.",
