                ],
                "senses": [
                    {
                        "sense_id": "2e292038-9ec9-3a57-8ac6-a1e5c65e0291",
                        "entry_id": "7937a70b-e38f-3977-ad30-1c2496e6da92",
                        "glosses": [
                            "Faire sortir de l’influence de l’Otan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57abf505-ef90-431a-87a1-0b28f6d20430",
                                "sense_id": "2e292038-9ec9-3a57-8ac6-a1e5c65e0291",
                                "text": "Saisir l’occasion du Brexit pour « dés-otaniser » et recontinentaliser nos politiques antiterroristes et de renseignement, notamment en termes d’architecture de notre dispositif et de renforcement de notre indépendance en matière de surveillance électronique."
                            },
                            {
                                "example_id": "cf97f3f2-83f2-4f0c-bcf9-e7904f29feba",
                                "sense_id": "2e292038-9ec9-3a57-8ac6-a1e5c65e0291",
                                "text": "Ils étaient censés renverser le gouvernement, dés-otaniser et dénazifier l’Ukraine."
                            },
                            {
                                "example_id": "8b9cec3c-a126-4c44-b907-fb5d105e8a29",
                                "sense_id": "2e292038-9ec9-3a57-8ac6-a1e5c65e0291",
                                "text": "Par conséquent, mettre fin à la Seconde Guerre mondiale signifie aujourd’hui dés-américaniser l’Europe, ce qui signifie la dés-otaniser, c’est-à-dire la démilitariser."
                            }
                        ]
                    }
                ],
