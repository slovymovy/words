{
    "word_family": [
        "response",
        "respondent",
        "responsive",
        "responsiveness",
        "responder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d53cf9ab-cd5e-38f0-8d26-953f5b5f0679",
                    "sense_definition": "To say or write something as a reply to a question or statement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She did not <w>respond</w> to my text message yesterday.",
                            "target_lang_translations": {
                                "ru": "Она не <w>ответила</w> на мое текстовое сообщение вчера.",
                                "tr": "Dün mesajıma <w>yanıt vermedi</w>.",
                                "zh": "她昨天没有<w>回复</w>我的短信。"
                            }
                        },
                        {
                            "text": "When the teacher asked a question, the student was eager to <w>respond</w>.",
                            "target_lang_translations": {
                                "ru": "Когда учитель задал вопрос, ученик очень хотел <w>ответить</w>.",
                                "tr": "Öğretmen bir soru sorduğunda, öğrenci <w>cevap vermeye</w> hevesliydi.",
                                "zh": "当老师提问时，学生急于<w>回答</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "answer",
                        "reply",
                        "retort",
                        "rejoin"
                    ],
                    "common_phrases": [
                        "respond to a question",
                        "respond immediately",
                        "respond to an email"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать или написать что-либо в ответ на вопрос или утверждение.",
                        "tr": "Bir soruya veya ifadeye yanıt olarak bir şey söylemek veya yazmak.",
                        "zh": "指对问题或陈述做出回答或书面回复。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвечать",
                                "target_lang_sense_clarification": "давать ответ (несов. вид)"
                            },
                            {
                                "target_lang_word": "ответить",
                                "target_lang_sense_clarification": "дать ответ (сов. вид)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yanıt vermek",
                                "target_lang_sense_clarification": "bir soruya veya mesaja cevap yazmak veya söylemek"
                            },
                            {
                                "target_lang_word": "cevap vermek",
                                "target_lang_sense_clarification": "birine karşılık vermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回答",
                                "target_lang_sense_clarification": "口头或书面做出回应"
                            },
                            {
                                "target_lang_word": "回复",
                                "target_lang_sense_clarification": "针对信息或信件做出回应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66debc6b-7256-3046-b0b8-c2baeb23e318",
                    "sense_definition": "To do something as a reaction to a force, stimulus, or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient is starting to <w>respond</w> well to the new treatment.",
                            "target_lang_translations": {
                                "ru": "Пациент начинает хорошо <w>реагировать</w> на новое лечение.",
                                "tr": "Hasta yeni tedaviye iyi <w>yanıt vermeye</w> başlıyor.",
                                "zh": "病人开始对新疗法产生良好的<w>反应</w>。"
                            }
                        },
                        {
                            "text": "The government must <w>respond</w> to the economic crisis quickly.",
                            "target_lang_translations": {
                                "ru": "Правительство должно быстро <w>отреагировать</w> на экономический кризис.",
                                "tr": "Hükümet ekonomik krize hızlıca <w>tepki vermelidir</w>.",
                                "zh": "政府必须迅速对经济危机做出<w>反应</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "react",
                        "reply",
                        "answer"
                    ],
                    "common_phrases": [
                        "respond to treatment",
                        "respond to pressure",
                        "respond to changes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать действия в качестве реакции на силу, стимул или ситуацию.",
                        "tr": "Bir güce, uyarana veya duruma tepki olarak bir şey yapmak.",
                        "zh": "指对某种力量、刺激或情况做出反应或表现出效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реагировать",
                                "target_lang_sense_clarification": "проявлять реакцию на воздействие"
                            },
                            {
                                "target_lang_word": "отзываться",
                                "target_lang_sense_clarification": "реагировать на лечение или стимул"
                            },
                            {
                                "target_lang_word": "отвечать",
                                "target_lang_sense_clarification": "действовать в ответ"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tepki vermek",
                                "target_lang_sense_clarification": "bir duruma veya uyarana karşı hareket etmek"
                            },
                            {
                                "target_lang_word": "yanıt vermek",
                                "target_lang_sense_clarification": "tedaviye veya değişime olumlu karşılık vermek"
                            },
                            {
                                "target_lang_word": "karşılık vermek",
                                "target_lang_sense_clarification": "bir eyleme karşı harekete geçmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反应",
                                "target_lang_sense_clarification": "对外界刺激做出动作或态度"
                            },
                            {
                                "target_lang_word": "响应",
                                "target_lang_sense_clarification": "对号召或需求做出积极回应"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef15961e-f44f-3e85-aba8-4394b85e408c",
                    "sense_definition": "A half-pillar or pilaster attached to a wall to support an arch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy arch rests on a stone <w>respond</w> embedded in the wall.",
                            "target_lang_translations": {
                                "ru": "Тяжелая арка опирается на каменную <w>полуколонну</w>, встроенную в стену.",
                                "tr": "Ağır kemer, duvara gömülü taştan bir <w>yarım sütun</w> üzerine oturuyor.",
                                "zh": "沉重的拱门支撑在嵌入墙壁的石制<w>壁柱</w>上。"
                            }
                        },
                        {
                            "text": "The architect designed a decorative <w>respond</w> to match the columns.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал декоративную <w>пилястру</w> в тон колоннам.",
                                "tr": "Mimar, sütunlara uyum sağlaması için dekoratif bir <w>pilaster</w> tasarladı.",
                                "zh": "建筑师设计了一个装饰性的<w>壁柱</w>来与柱子相配。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical architecture term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полуколонна или пилястра, примыкающая к стене и поддерживающая арку.",
                        "tr": "Bir kemeri desteklemek için duvara bitişik inşa edilmiş yarım sütun veya pilaster.",
                        "zh": "建筑术语，指附着在墙上以支撑拱门的半柱或壁柱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полуколонна",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            },
                            {
                                "target_lang_word": "пилястра",
                                "target_lang_sense_clarification": "плоский вертикальный выступ"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yarım sütun",
                                "target_lang_sense_clarification": "duvara gömülü mimari öğe"
                            },
                            {
                                "target_lang_word": "pilaster",
                                "target_lang_sense_clarification": "duvara yapışık sütun ayağı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "壁柱",
                                "target_lang_sense_clarification": "附着在墙上的柱状结构"
                            },
                            {
                                "target_lang_word": "半柱",
                                "target_lang_sense_clarification": "嵌入墙体的一半柱子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2520bf56-4c46-32e8-bb38-2fd95b8a2aee",
                    "sense_definition": "A short verse or anthem chanted at intervals during a religious reading.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang a beautiful <w>respond</w> after the first reading.",
                            "target_lang_translations": {
                                "ru": "Хор спел красивый <w>респонсорий</w> после первого чтения.",
                                "tr": "Koro, ilk okumadan sonra güzel bir <w>responsorium</w> söyledi.",
                                "zh": "唱诗班在第一次诵读后唱了一段优美的<w>应答咏</w>。"
                            }
                        },
                        {
                            "text": "The service included a medieval <w>respond</w> that echoed through the church.",
                            "target_lang_translations": {
                                "ru": "Служба включала средневековый <w>респонсорий</w>, эхом разносившийся по церкви.",
                                "tr": "Aayin, kilisede yankılanan orta çağdan kalma bir <w>yanıtlı ilahi</w> içeriyordu.",
                                "zh": "礼拜仪式中包含了一段在中世纪教堂里回荡的<w>应答经文</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "religious/liturgical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий стих или песнопение, исполняемое между чтениями во время богослужения.",
                        "tr": "Dini bir okuma sırasında belirli aralıklarla okunan veya söylenen kısa ayet veya ilahi.",
                        "zh": "宗教术语，指在宗教诵读过程中间隔吟唱的短诗或应答经文。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "респонсорий",
                                "target_lang_sense_clarification": "литургическое песнопение"
                            },
                            {
                                "target_lang_word": "ответ",
                                "target_lang_sense_clarification": "ответ хора или прихожан"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "responsorium",
                                "target_lang_sense_clarification": "dini törenlerde koro ile cemaat arasındaki yanıtlı ilahi"
                            },
                            {
                                "target_lang_word": "yanıtlı ilahi",
                                "target_lang_sense_clarification": "dini okumalar arasında söylenen ilahi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "应答经文",
                                "target_lang_sense_clarification": "礼拜仪式中领唱与合唱的应答部分"
                            },
                            {
                                "target_lang_word": "应答咏",
                                "target_lang_sense_clarification": "宗教仪式中的应答式歌咏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
