                                "target_senses": [
                                    {
                                        "sense_id": "60a66b96-cc85-36f7-a13f-5bd8014ed64a",
                                        "entry_id": "ae59620e-0ab8-3875-a799-e6f994f842d5",
                                        "glosses": [
                                            "Happening at regular intervals; isochronal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cbd4ad3-7e88-3211-8636-99d735625dfa",
                                        "entry_id": "ae59620e-0ab8-3875-a799-e6f994f842d5",
                                        "glosses": [
                                            "Happening at the same time; simultaneous."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f3b07d-062e-45c0-af89-fc48efdf95c3",
                                                "sense_id": "9cbd4ad3-7e88-3211-8636-99d735625dfa",
                                                "text": "We observed, on attentive examination, the following phenomena: cough, with sense of constriction in the middle of the chest; orthopnœa, threatening suffocation; face violet coloured; lips swollen; beatings of the jugular veins isochronous with those of the carotid arteries; palpitation; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e22ede4e-3811-38a7-9fd6-34ec324d3bec",
                                        "entry_id": "ae59620e-0ab8-3875-a799-e6f994f842d5",
                                        "glosses": [
                                            "Of or pertaining to the use of clocks derived from the same clock reference."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5c1d062-7f7f-45bc-af08-25221cec56d4",
                                                "sense_id": "e22ede4e-3811-38a7-9fd6-34ec324d3bec",
                                                "text": "Their entire national telephone network is isochronous, with a clock distribution tree radiating from a single, protected cesium reference clock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f2c8432-5f75-3943-ac2b-2de656232b2a",
                                        "entry_id": "ae59620e-0ab8-3875-a799-e6f994f842d5",
                                        "glosses": [
                                            "of or pertaining to data associated with time-sensitive applications."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ce1000-6ee2-453e-8c60-a568328cce2c",
                                                "sense_id": "9f2c8432-5f75-3943-ac2b-2de656232b2a",
                                                "text": "These packets belong to an isochronous voice application and need priority handling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
