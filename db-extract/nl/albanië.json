                                                "example_id": "946f51e7-15c6-4987-873f-aaf91c0865df",
                                                "sense_id": "ef0fce39-0c3b-3339-9fa1-63be37c25bab",
                                                "text": "Tirana ist die Hauptstadt von Albanien."
                                            },
