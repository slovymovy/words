                "forms": [],
                "senses": [
                    {
                        "sense_id": "c570503b-494c-3c05-bb52-90b990fc8b8e",
                        "entry_id": "70b79316-24dc-35a8-bcfd-835f408e2d66",
                        "glosses": [
                            "D’une manière lumineuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb1b16dc-0fe1-4aba-ac4d-1a6a8fc2925e",
                                "sense_id": "c570503b-494c-3c05-bb52-90b990fc8b8e",
                                "text": "Laurent a établi lumineusement que j'avais péché surtout par ignorance."
                            },
                            {
                                "example_id": "dbc36287-5a51-46a2-9498-6c4affb82f6f",
                                "sense_id": "c570503b-494c-3c05-bb52-90b990fc8b8e",
                                "text": "On peut dire hardiment et sans blasphème qu’il y a de petites vérités que nous savons aussi bien que lui [Dieu] […] l’être souverainement intelligent ne peut savoir ces petites vérités ni plus lumineusement, ni plus certainement que nous."
                            },
                            {
                                "example_id": "b2fe41a7-db9f-4c2f-914e-5b3a7ece6d43",
                                "sense_id": "c570503b-494c-3c05-bb52-90b990fc8b8e",
                                "text": "Cela n'empêche pas que vous n'ayez très lumineusement raison contre l’abbé Mably, et je vous en rends, monsieur, mille actions de grâces."
                            }
                        ]
                    }
                ],
