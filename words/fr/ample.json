                {
                    "sense_id": "33ef4303-c908-34b1-8b7d-f5926d8c6e34",
                    "sense_definition": "Qui est large, spacieux et ne serre pas le corps, en parlant d'un vêtement ou d'un tissu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dimensions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle préfère porter une robe <w>ample</w> et légère pendant les chaudes journées d'été.",
                            "target_lang_translations": {
                                "en": "She prefers to wear a <w>loose</w>, light dress on hot summer days.",
                                "ru": "Она предпочитает носить <w>свободное</w> и лёгкое платье в жаркие летние дни.",
                                "nl": "Op hete zomerdagen draagt ze liever een <w>ruime</w> en lichte jurk.",
                                "de": "An heißen Sommertagen trägt sie am liebsten ein <w>weites</w>, leichtes Kleid.",
                                "pl": "W upalne letnie dni woli nosić <w>luźną</w>, lekką sukienkę.",
                                "it": "Preferisce indossare un vestito <w>largo</w> e leggero nelle calde giornate d'estate.",
                                "cs": "Během horkých letních dnů raději nosí <w>volné</w> a lehké šaty.",
                                "tr": "Sıcak yaz günlerinde <w>bol</w> ve hafif bir elbise giymeyi tercih ediyor.",
                                "es": "Prefiere llevar un vestido <w>holgado</w> y ligero en los calurosos días de verano.",
                                "zh": "炎热的夏天，她更喜欢穿<w>宽松</w>轻薄的连衣裙。"
                            }
                        },
                        {
                            "text": "Ce manteau est beaucoup trop <w>ample</w> pour lui, il devrait choisir la taille inférieure.",
                            "target_lang_translations": {
                                "en": "This coat is far too <w>baggy</w> on him; he should choose the next size down.",
                                "ru": "Это пальто ему слишком <w>широко</w>, ему следует выбрать размер поменьше.",
                                "nl": "Deze jas is voor hem veel te <w>ruim</w>; hij zou de kleinere maat moeten kiezen.",
                                "de": "Dieser Mantel ist ihm viel zu <w>weit</w>; er sollte die nächstkleinere Größe wählen.",
                                "pl": "Ten płaszcz jest na nim o wiele za <w>luźny</w>; powinien wybrać mniejszy rozmiar.",
                                "it": "Questo cappotto gli va decisamente troppo <w>largo</w>; dovrebbe prendere la taglia più piccola.",
                                "cs": "Tenhle kabát je na něj daleko příliš <w>volný</w>, měl by si vybrat menší velikost.",
                                "tr": "Bu palto ona çok <w>bol</w> geliyor; daha küçük bedeni seçmeli.",
                                "es": "Este abrigo le queda demasiado <w>holgado</w>; debería elegir la talla más pequeña.",
                                "zh": "这件外套他穿起来太<w>宽大</w>了，他应该选小一号的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flottant",
                        "large"
                    ],
                    "antonyms": [
                        "ajusté",
                        "étriqué",
                        "serré"
                    ],
                    "common_phrases": [
                        "robe ample",
                        "vêtement ample"
                    ],
                    "target_lang_definitions": {
                        "en": "Loose-fitting and roomy, not tight on the body, said of a garment or fabric.",
                        "ru": "Свободный, просторный, не облегающий тело (о предмете одежды или ткани).",
                        "nl": "Kleding of stof die ruim valt en het lichaam niet nauw omsluit.",
                        "de": "Weit geschnitten und locker sitzend, den Körper nicht eng umschließend, meist bei Kleidung oder Stoffen.",
                        "pl": "Szeroki i luźny, nieprzylegający do ciała; mówi się o ubraniu lub tkaninie.",
                        "it": "Detto di un indumento o di un tessuto che è ampio e non stringe il corpo.",
                        "cs": "Prostorný a volný, tělo nestahuje; říká se o oděvu nebo látce.",
                        "tr": "Vücudu sıkmayan, geniş ve rahat kesimli giysi veya kumaşlar için kullanılır.",
                        "es": "Dicho de una prenda o de una tela, que es espaciosa y no ajusta al cuerpo.",
                        "zh": "形容衣服或布料宽敞，不紧贴身体。"
                    },
