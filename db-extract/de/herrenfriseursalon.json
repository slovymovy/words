                "senses": [
                    {
                        "sense_id": "0417315f-1308-3972-8908-f5d2e72583a2",
                        "entry_id": "c942a491-a30a-3f43-b73a-4ebca9d0ba16",
                        "glosses": [
                            "Friseursalon speziell und ausschließlich für Herren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb2b43e-f5a9-47ca-9eff-2c188e3dc7ee",
                                "sense_id": "0417315f-1308-3972-8908-f5d2e72583a2",
                                "text": "„2006 eröffnete er einen Herrenfriseursalon in Damaskus.“"
                            },
                            {
                                "example_id": "e1dfcf0d-e807-4cb7-8c91-73bbe9d57bfa",
                                "sense_id": "0417315f-1308-3972-8908-f5d2e72583a2",
                                "text": "„Der 40-Jährige arbeitet seit drei Jahren in einem arabischen Herrenfriseursalon am Gothaer Markt.“"
                            },
                            {
                                "example_id": "65a378f4-7579-4685-8f66-4fde2760f6fe",
                                "sense_id": "0417315f-1308-3972-8908-f5d2e72583a2",
                                "text": "„Die klassischen Herrenfriseursalons der siebziger Jahre haben ausgedient, moderne, durchgestylte \"Shops\" sprießen vor allem in großen Städten wie Pilze aus dem Boden.“"
                            },
                            {
                                "example_id": "6c1bc7f3-5b3c-4c47-b6e6-5bebbb17e2b0",
                                "sense_id": "0417315f-1308-3972-8908-f5d2e72583a2",
                                "text": "„Auf dem Stuhl sitzt ein Arnstädter Kunde, um sich in Ilmenau im Herrenfriseursalon hinter dem Apothekerbrunnen Haare schneiden zu lassen.“"
                            },
                            {
                                "example_id": "9d1af54b-b8a9-419b-a2a7-c2993d9deacc",
                                "sense_id": "0417315f-1308-3972-8908-f5d2e72583a2",
                                "text": "„Das Schulzimmer anno 1900, der Herrenfriseursalon Gerhard aus Bleidenstadt oder die Ortsschellen, mit denen bis Anfang der 1960er Jahre der Ortsdiener das Neueste im Dorf unter die Leute brachte, legen Zeugnis von einem längst vergangenen Alltag ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
