                    },
                    {
                        "translation_id": "33092e2c-236f-42c0-8196-8eefb2eeabdc",
                        "source_entry_id": "f98f5ff2-4cd7-3445-927f-ab3750121be6",
                        "source_sense_id": "d732f871-ccbe-3f14-85e0-00625ff5438e",
                        "target_lang_word": "Ismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                        "entry_id": "58415706-3511-3a98-8df6-e0eaaee8b39f",
                                        "glosses": [
                                            "bloße Theorie, theoretisches Gedankengebäude"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b460ce-7e8d-4677-b357-8dbdb2c627b7",
                                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                                "text": "Doch das wäre doch das wahre Ziel jeder (auch politischen) Aufklärung: Der Verzicht auf jeden „-Ismus“. Denn der „Ismus“ ist es doch, der eine vernünftige Idee ins Unvernünftige übertreibt."
                                            },
                                            {
                                                "example_id": "19c8b4f6-b43a-4a82-bcbf-87660a5c4be3",
                                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                                "text": "Die hiervon abgeleiteten Ismen sind im Gegensatz zu einer wissenschaftlichen Theorie starr und nicht wandlungsfähig, sie verharren auf dem einmal angenommenen Erkenntnisstand."
                                            },
                                            {
                                                "example_id": "27a066c8-0f09-496a-a7ed-cbb45d398de4",
                                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                                "text": "„Er hat sich von allen Parteien, Kulten, Ismen, Ideologien losgelöst.“"
                                            },
                                            {
                                                "example_id": "dba02bb2-be09-4148-a78d-fd63f6ee92c0",
                                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                                "text": "„Wilfried Hasselmann war ihm als Typus näher als irgendwelche Ex-68er, die sich mit Theoriesystemen oder Ismen beschäftigt hatten, mochten sie von Mao, Tito, Enver Hodscha oder Lenin stammen.“"
                                            },
                                            {
                                                "example_id": "16962d08-ccf3-40f3-a1a0-f8f0e7d3099d",
                                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                                "text": "„Vielmehr wurde ihm klar, dass es weder Anglikanismus noch andere Ismen neben dem Kommunismus geben würde, wenn dessen Zeit erst gekommen war.“"
                                            },
                                            {
                                                "example_id": "ab2fe46e-c045-4261-9713-01dc0ff8ee3f",
                                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                                "text": "„Zu den Leitmotiven von Canettis Leben gehört schließlich sein Freiheitsdrang, der sich nicht nur in der Systemlosigkeit und der Distanz zu allen Ismen des 20. Jahrhunderts zeigt, sondern auch in der Verweigerung einer erkennbaren aktiven Mitgliedschaft in den Religionen des Judentums oder des Christentums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
