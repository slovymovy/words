                "senses": [
                    {
                        "sense_id": "ab31059b-777b-3576-bcd4-ab481e60c97b",
                        "entry_id": "1f3cc6fd-6fd1-3bd4-a262-661871c584dc",
                        "glosses": [
                            "weibliche Person, die ein Unternehmen, einen Betrieb besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c66aba-d937-43b7-bb79-662261bf368d",
                                "sense_id": "ab31059b-777b-3576-bcd4-ab481e60c97b",
                                "text": "„Die Geschäftsinhaberin verriet ihm einmal, dass sie in solchen Momenten astronomische Fantasiepreise aufrief, die jedes Mal anstandslos bezahlt wurden.“"
                            },
                            {
                                "example_id": "e2e2f104-ca14-4674-8168-ea527626b2f7",
                                "sense_id": "ab31059b-777b-3576-bcd4-ab481e60c97b",
                                "text": "„Diese Entwicklung in Kombination mit der erläuterten Veränderung der Positionierung wird seitens der Geschäftsinhaberin als kritisch und als nicht anstrebenswert betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
