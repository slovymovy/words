                            "trait_type": "archaic",
                            "comment": "modern usage prefers 'simultaneously'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В одно и то же время (устаревшее значение).",
                        "zh": "同时地（较少见用法）。"
                    },
                    "translations": {
