                "senses": [
                    {
                        "sense_id": "c8236678-c2cc-3b76-8d4c-58c37331c4bf",
                        "entry_id": "da3b9099-08e7-3e2c-931b-44987348dd4d",
                        "glosses": [
                            "aanstoot gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c73a180-c5b6-4e0c-ad52-b65c44852237",
                                "sense_id": "c8236678-c2cc-3b76-8d4c-58c37331c4bf",
                                "text": "“Maria Schneider werd een enorme ster door Last Tango in Paris. Deze film was schandaleus door wilde seks tussen Marlon Brandon als weduwnaar met de jonge Schneider. Daar kwam ook wat geweld bij kijken. De ‘boterscene’ waarin boter als vaseline wordt gebruikt is berucht. Als je het over een pakje boter had in die tijd, wist iedereen waar je het over had.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "76772bd1-b45a-3a2a-8921-9b5cf93dbd20",
                        "entry_id": "da3b9099-08e7-3e2c-931b-44987348dd4d",
                        "glosses": [
                            "moreel verwerpelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b210426-c6cc-441f-b8f9-f57c55fb1596",
                                "sense_id": "76772bd1-b45a-3a2a-8921-9b5cf93dbd20",
                                "text": "GR Katelijne met 7 combi's ontzet na schandaleus doelpunt: Als er een speler geveld ligt, wordt de bal buitengetrapt en daarna teruggegeven aan de tegenstander. Een voor de hand liggende fair-playregel die als logisch ervaren wordt."
                            }
                        ]
                    }
