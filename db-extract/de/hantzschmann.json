                ],
                "senses": [
                    {
                        "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                        "entry_id": "9ff3cb80-492b-31e6-a8dd-0025c34ca153",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68c1d76-28ff-4563-b394-e79a506fc939",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Frau Hantzschmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1aeb8d4c-1ead-436a-9b58-5de8bccdbdbc",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Herr Hantzschmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "577b0dca-ed9b-4af4-a0ed-1c8657b149de",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Die Hantzschmanns fahren heute in die Niederlausitz."
                            },
                            {
                                "example_id": "452f6b63-70d3-41d1-a7b1-55640fded30e",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Der Hantzschmann trägt nie die Schals, die die Hantzschmann ihm strickt."
                            },
                            {
                                "example_id": "472a4549-7be3-4d47-b583-425f9f588ce7",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hantzschmann kommt, geht der Herr Hantzschmann.“"
                            },
                            {
                                "example_id": "5e486bb4-6931-4fc5-8838-b5240d525282",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Hantzschmann kommt und geht."
                            },
                            {
                                "example_id": "06924c7b-71ad-4e35-852a-5c01f948c367",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "Hantzschmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d63347d7-a596-4418-bcd5-81a4abd77ad2",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "An verregneten Herbsttagen ist Familie Hantzschmanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "dc50b1a7-6265-4bab-9be7-c892725cb15e",
                                "sense_id": "b7b598f3-1f5a-327c-a640-8047043dc936",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hantzschmann das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
