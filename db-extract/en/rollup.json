            {
                "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                "word": "rollup",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "852429ef-8e32-4da1-bcf6-44f78d8381bb",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "tags": [
                            "plural"
                        ],
                        "form": "rollups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d5a86f7-3928-387c-8e85-f314b381ea43",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "glosses": [
                            "A kind of food made by wrapping ingredients in another food, e.g. fajitas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa366964-618f-4562-bc90-ca300f182fe5",
                                "sense_id": "3d5a86f7-3928-387c-8e85-f314b381ea43",
                                "text": "She ate a chicken rollup and a salad."
                            },
                            {
                                "example_id": "af3d288b-bcd7-4019-b92e-ab0bef8169ec",
                                "sense_id": "3d5a86f7-3928-387c-8e85-f314b381ea43",
                                "text": "He considered moving to the dining room, but ordered a fourth vodka martini and sent it down in three gulps to join a half-dozen bacon rollups and two baked cheese appetizers."
                            }
                        ]
                    },
                    {
                        "sense_id": "12f8bee8-7868-3a0d-8287-0400193d586d",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "glosses": [
                            "A kind of flat, pectin-based, fruit-flavored snack rolled into a tube."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e38a06d9-a0ff-32f9-b212-d878127ca144",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "glosses": [
                            "A self-made cigarette of tobacco and rolling paper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0284e48b-51d4-4846-89d5-8fd6a6406af4",
                                "sense_id": "e38a06d9-a0ff-32f9-b212-d878127ca144",
                                "text": "I smoke rollups because they are cheaper than buying cigarettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa8e4145-f2fb-31b7-a7f3-49fe07f32f3d",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "glosses": [
                            "A business technique where multiple small companies in the same market are acquired and merged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e476dea-0b9d-42c9-b30b-5005d5f91dd6",
                                "sense_id": "aa8e4145-f2fb-31b7-a7f3-49fe07f32f3d",
                                "text": "In geographic rollups, it's more important to hold on to key employees — and customers — than to realize efficiencies quickly."
                            }
                        ]
                    },
                    {
                        "sense_id": "8db1bb42-55ee-398b-9aa7-69e86824167b",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "glosses": [
                            "A collection of software updates distributed as a single package."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "717412c9-d9f1-4a6c-a410-69d1ae7f8512",
                                "sense_id": "8db1bb42-55ee-398b-9aa7-69e86824167b",
                                "text": "Between issuance of service packs, Microsoft released update rollups for Exchange Server on a regular basis […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c09c8714-e246-3f51-8335-f17dc85d5307",
                        "entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "glosses": [
                            "That which is rolled up; a summation; an aggregation; a total."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "490a598d-a764-4270-b6f7-72c2fb91625d",
                                "sense_id": "c09c8714-e246-3f51-8335-f17dc85d5307",
                                "text": "In some cases, you may want to add custom rollups that change the way a measure is calculated on a specific level."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcda12bf-06cd-4516-ad88-3a0dfc069825",
                        "source_entry_id": "4439fc81-bf59-3936-bac2-162a9bc4426e",
                        "source_sense_description": "food made by wrapping ingredients in another food",
                        "target_lang_word": "wrap",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrap",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f41f8c-a380-3d76-92ca-403595a526e8",
                                        "entry_id": "37b986a9-1114-318f-9f3a-9dcf449e3794",
                                        "glosses": [
                                            "Sandwich constitué d’une galette fine enroulée autour d’une garniture."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096a772b-9319-4d1f-b28c-311ba5e79157",
                                                "sense_id": "e6f41f8c-a380-3d76-92ca-403595a526e8",
                                                "text": "Un sandwich enroulé (wrap en anglais) dans une tortilla de blé, voilà l’idée toute simple née en Californie dans les années 1990. Digne descendant du burrito, le wrap n’a pas tardé à conquérir le monde, tant il se prête à toutes les variations."
                                            },
                                            {
                                                "example_id": "f5601ca6-251a-40c2-b47c-2c185710a2ad",
                                                "sense_id": "e6f41f8c-a380-3d76-92ca-403595a526e8",
                                                "text": "Que la vie était facile pour les voleurs. En quelques secondes, il venait de gagner les 15,89 euros qu’il lui manquait pour s’acheter le Kisifrötsipik ainsi que 4,11 euros d’argent de poche. Ainsi, non seulement il put manger à sa faim (des tomates au paprika, un wrap de saumon fumé avec des frites, une banane, le tout accompagné d’un Coca-cola sans gaz), mais en plus, il eut le privilège de ne pas déjeuner seul ce jour-là."
                                            },
                                            {
                                                "example_id": "0ab2128f-24f0-4716-902c-90ee5f2a95a3",
                                                "sense_id": "e6f41f8c-a380-3d76-92ca-403595a526e8",
                                                "text": "Végétariens et végétaliens seront heureux d’apprendre que les veloutés, gâteaux et la plupart des wraps sont réalisés avec des ingrédients d’origine végétale."
                                            },
                                            {
                                                "example_id": "f585bae6-f5f0-4aaf-82a2-70b3ecbf2573",
                                                "sense_id": "e6f41f8c-a380-3d76-92ca-403595a526e8",
                                                "text": "Certains joueurs ont des habitudes déroutantes après une rencontre à l’image de Madosh Tambwe : « J’avale quatre cheeseburgers, deux boîtes de tenders, deux wraps et un burger »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621373fa-afcd-4d85-b99a-cdb7e9f70e17",
