                                "example_id": "be1c422d-c0bc-48e6-8ff3-4c3eb1d0462a",
                                "sense_id": "90253d18-5803-3f71-91ff-2aa8d0c652f8",
                                "text": "Het was moeilijk om een beleefde manier te vinden om haar woordenvloed te stuiten, ze was buitensporig ambitieus."
                            }
                        ]
