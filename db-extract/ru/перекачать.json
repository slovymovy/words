                ],
                "translations": [
                    {
                        "translation_id": "0e2cf91f-b830-44a5-aae8-0f14881cbf1e",
                        "source_entry_id": "fd48b74d-b1b8-3c79-94f9-348aaa96e1e4",
                        "source_sense_id": "8d761be4-9310-320d-8613-e5ffba7f32df",
                        "target_lang_word": "pomper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pomper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b501835-f8fd-3282-baef-373b07faf20d",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Élever, attirer, puiser un liquide ou un gaz avec une pompe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a182980-bafb-4166-93bf-6d5eef6079b4",
                                                "sense_id": "3b501835-f8fd-3282-baef-373b07faf20d",
                                                "text": "Pomper l’eau d’un bateau."
                                            },
                                            {
                                                "example_id": "6b1c3b05-0580-4625-be03-da61f08d7617",
                                                "sense_id": "3b501835-f8fd-3282-baef-373b07faf20d",
                                                "text": "Pomper l’air du récipient de la machine pneumatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe8a85a6-aa2a-363f-a745-48edc43e1133",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Élever, attirer, puiser un liquide ou un gaz avec une pompe.",
                                            "Utiliser une pompe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f460a5f-3a4e-4fe9-919d-3708e317b99a",
                                                "sense_id": "fe8a85a6-aa2a-363f-a745-48edc43e1133",
                                                "text": "J’embarque toujours beaucoup d’eau et je dois pomper constamment."
                                            },
                                            {
                                                "example_id": "349fcedd-c4f6-444a-bbea-86da088a9f98",
                                                "sense_id": "fe8a85a6-aa2a-363f-a745-48edc43e1133",
                                                "text": "Il faut pomper longtemps pour remplir d’eau ce réservoir."
                                            },
                                            {
                                                "example_id": "8dcb5587-5e50-4931-8606-f54ebd94c92b",
                                                "sense_id": "fe8a85a6-aa2a-363f-a745-48edc43e1133",
                                                "text": "On a pompé toute la journée pour vider les caves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee455ca9-2cdb-3354-a729-94315dc3becf",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Ôter l’eau, évaporer, retirer l’humidité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07001d4b-a1ca-437b-bc53-49bd91b202cc",
                                                "sense_id": "ee455ca9-2cdb-3354-a729-94315dc3becf",
                                                "text": "Ce linge a pompé l’humidité."
                                            },
                                            {
                                                "example_id": "63004782-0b30-4c3a-9164-89733afcebed",
                                                "sense_id": "ee455ca9-2cdb-3354-a729-94315dc3becf",
                                                "text": "Le soleil pompe les eaux de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350a4b5f-e2b1-3bd3-bf5a-dd2925922dca",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Absorber l’énergie d’une personne, fatiguer, épuiser."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4eae9be-9cd4-4713-b8fe-8ff024a7b726",
                                                "sense_id": "350a4b5f-e2b1-3bd3-bf5a-dd2925922dca",
                                                "text": "Le moindre effort lui coûtait une fatigue immense, le pompait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b982f182-ebad-339a-83c9-bf84cb648881",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Boire plus que de raison des boissons enivrantes."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41bae50b-283f-4b06-82d2-a488ee4c0ba5",
                                                "sense_id": "b982f182-ebad-339a-83c9-bf84cb648881",
                                                "text": "Ainsi que cela se produisait chaque fois qu’il avait trop pompé le jour d’avant, il se sentait la tête un peu fiévreuse, le front chaud, les nerfs excités et la gorge sèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b455e1-c16a-3981-8557-13e9db70bafe",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Tricher en recopiant ce qu’a fait quelqu’un, copier."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd7d840b-bc88-48ff-b70f-37ee9030b209",
                                                "sense_id": "69b455e1-c16a-3981-8557-13e9db70bafe",
                                                "text": "Le tricheur ! Il a pompé sur moi !"
                                            },
                                            {
                                                "example_id": "885623b3-e764-444c-b472-7d5e73ef0e17",
                                                "sense_id": "69b455e1-c16a-3981-8557-13e9db70bafe",
                                                "text": "Nous convoquerons des jeunes réalisateurs pour leur pomper des idées fraîches en leur faisant miroiter un gros boulot que nous finirons par exécuter nous-mêmes dans leur dos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67311f1a-b0a6-38b2-a02e-04d4bba45235",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Pratiquer une fellation."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05881dc8-2135-4170-8eb6-a6039776ba2d",
                                                "sense_id": "67311f1a-b0a6-38b2-a02e-04d4bba45235",
                                                "text": "Il voulait être César, il ne fut que Pompée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6837c0f-df06-3549-9584-2b41623d9da2",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Faire des pompes (exercice de musculation)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0b22f42-7293-34c9-b8e1-75fd3690c5c0",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Faire enrager, fâcher."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bdd1fee-0949-48dd-aa95-e58da13f5dab",
                                                "sense_id": "b0b22f42-7293-34c9-b8e1-75fd3690c5c0",
                                                "text": "Arrête de le faire pomper pour rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b90714d4-2a15-3f30-81d3-5c0eceda3a07",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Entretenir, voire attiser ses émotions."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "613a9c45-3241-4be2-96df-f30bdaee118d",
                                                "sense_id": "b90714d4-2a15-3f30-81d3-5c0eceda3a07",
                                                "text": "Entre un gars qui arbore un macaron du PQ, un gars qui porte un t-shirt à l’effigie de René Lévesque et un gars qui brandit un drapeau des patriotes, qui vous paraît comme le séparatiste le plus pompé des trois ?"
                                            },
                                            {
                                                "example_id": "83112a7b-dfdc-4fbb-ad10-dc646c06e164",
                                                "sense_id": "b90714d4-2a15-3f30-81d3-5c0eceda3a07",
                                                "text": "Il se pompe vite quand je lui demande certaines choses, et il me tient tête dès qu’il en a l’occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5177c8b7-e1ff-3887-aae3-127e9fec7be6",
                                        "entry_id": "5f8e51e2-a986-3d14-bfaf-e303772b8916",
                                        "glosses": [
                                            "Travailler vite."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a969d72a-f03f-4d9b-aa01-9cc985a47323",
                        "source_entry_id": "fd48b74d-b1b8-3c79-94f9-348aaa96e1e4",
