                                "target_senses": [
                                    {
                                        "sense_id": "4804d00b-7a94-3ee5-b393-0323ea05936d",
                                        "entry_id": "64451c0e-9ab5-35d8-a568-fb52022ac4f2",
                                        "glosses": [
                                            "die männlichen oder weiblichen Fortpflanzungsorgane entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da97d85e-8a18-4489-bc81-a7a2ccf14bca",
                                                "sense_id": "4804d00b-7a94-3ee5-b393-0323ea05936d",
                                                "text": "Der Arzt hat die Katze und den Kater kastriert."
                                            },
                                            {
                                                "example_id": "e5d52efe-2dfe-4362-831a-5fa48ad5100b",
                                                "sense_id": "4804d00b-7a94-3ee5-b393-0323ea05936d",
                                                "text": "„Gefangene werden kastriert, so berichten Augenzeugen, als Zielscheiben benutzt, lebendig verbrannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2191f022-d02d-31ec-9170-8bf8c88851ef",
                                        "entry_id": "64451c0e-9ab5-35d8-a568-fb52022ac4f2",
                                        "glosses": [
                                            "die Keimdrüsen des Menschen entfernen oder zerstören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74e04c7-934f-4348-87e4-b5a3bed8dd8e",
                                                "sense_id": "2191f022-d02d-31ec-9170-8bf8c88851ef",
                                                "text": "Der Mann hatte Angst, die Frau könne ihn nachts kastrieren, deshalb ließen sie sich scheiden."
