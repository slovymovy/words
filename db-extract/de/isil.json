                                        "examples": [
                                            {
                                                "example_id": "0ed1913e-d8da-4391-82f6-8af8ec3f5f3d",
                                                "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                                "text": "They didn't know the room was too big, because they didn't have anybody there. How are they going to beat ISIS? I don't think it's gonna happen."
                                            },
