                "translations": [
                    {
                        "translation_id": "4930b2a4-460f-4401-a945-98db1c556409",
                        "source_entry_id": "43fad93a-9934-3a0a-8fd6-c433ad146270",
                        "source_sense_id": "1a95313f-82fa-3cc6-9ab5-1130bb997c57",
                        "source_sense_description": "Neigung zu etwas",
                        "target_lang_word": "penchant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penchant",
