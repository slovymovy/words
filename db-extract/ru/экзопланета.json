                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "50a577ac-abf3-419c-bb3d-c47c434684c7",
                        "source_entry_id": "adb31656-bd05-31ad-b879-7818b69143a4",
                        "source_sense_id": "e0d3bd2e-8257-3c19-a8f4-9cdfda135801",
                        "target_lang_word": "Exoplanet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exoplanet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91e74483-3a74-319b-bd3d-1cb8fc164403",
                                        "entry_id": "25aaae4c-724e-32a0-a063-28dd9737c64d",
                                        "glosses": [
                                            "ein Planet, der ein Zentralgestirn in einem fremden Planetensystem umkreist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee0e232-ed45-46a6-8b2f-c2a9c3cb41ff",
                                                "sense_id": "91e74483-3a74-319b-bd3d-1cb8fc164403",
                                                "text": "Astronomen haben erstmals einen Planeten um einen anderen Stern identifiziert, dessen Atmosphäre mehr Kohlenstoff als Sauerstoff enthält. Damit eröffnet er eine ganz neue Klasse von Exoplaneten."
                                            },
                                            {
                                                "example_id": "829c423d-9414-461f-a484-2b03e0fb6f21",
                                                "sense_id": "91e74483-3a74-319b-bd3d-1cb8fc164403",
                                                "text": "Zum anderen aber bedeutet dies, dass auch andere, erdähnlichere Exoplaneten, eine kohlenstoffhaltige Atmosphäre und auch eine kohlenstoffhaltige Oberfläche besitzen könnten."
                                            },
                                            {
                                                "example_id": "25088802-d65c-4fcc-a642-3956e50bb8c4",
                                                "sense_id": "91e74483-3a74-319b-bd3d-1cb8fc164403",
                                                "text": "Ein Sternensystem allerdings, in dem einigermaßen vielversprechende Exoplaneten unterwegs sind, ist Gliese 581."
                                            },
                                            {
                                                "example_id": "2ae8ceeb-4f5c-4cba-b9f1-bbd110e50d36",
                                                "sense_id": "91e74483-3a74-319b-bd3d-1cb8fc164403",
                                                "text": "Immigration gibt es auch im Weltall: Ein internationales Team von Astronomen hat in der Milchstraße erstmals einen Exoplaneten mit extragalaktischem Ursprung entdeckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd06fa43-ebed-47a8-9485-ba44ddfec750",
                        "source_entry_id": "adb31656-bd05-31ad-b879-7818b69143a4",
                        "source_sense_id": "e0d3bd2e-8257-3c19-a8f4-9cdfda135801",
