                    },
                    {
                        "translation_id": "5e4fd267-8c52-41b6-8ada-8e71c8e7f878",
                        "source_entry_id": "4392057a-8651-3484-b625-9b4246a45846",
                        "source_sense_description": "1-2",
                        "target_lang_word": "Halbleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a76e1f12-ef4b-36f5-8bed-5535d3eeeffd",
                                        "entry_id": "93d5900c-8f6f-3f9a-bedd-b6fefbd30a80",
                                        "glosses": [
                                            "ein Stoff/Material, der/das für den elektrischen Strom unter bestimmten Voraussetzungen leitend oder sperrend ist."
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c694c32-eff3-49a7-9e49-06e773b31be8",
                                                "sense_id": "a76e1f12-ef4b-36f5-8bed-5535d3eeeffd",
                                                "text": "Silizium ist ein guter Halbleiter, deshalb sind viele Elektronikteile aus diesem Material."
                                            },
                                            {
                                                "example_id": "cc2bce9e-ff14-4937-8931-f8b314389eaa",
                                                "sense_id": "a76e1f12-ef4b-36f5-8bed-5535d3eeeffd",
                                                "text": "„Der Übergang von Halbleitern zu Isolatoren ist fließend. So wird beispielsweise Galliumnitrid (GaN; Einsatz in blauen LEDs) mit einer Bandlückenenergie von ≈ 3,2 eV ebenfalls zu den Halbleitern gezählt, Diamant mit einer Bandlücke von ≈ 5,5 eV aber nicht mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ead2d4c-5816-4e2c-a34e-240033a19360",
                        "source_entry_id": "4392057a-8651-3484-b625-9b4246a45846",
                        "source_sense_description": "1-2",
                        "target_lang_word": "semiconductor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semiconductor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd362fa6-7bd7-3d1f-834e-8b83ee3e5955",
                                        "entry_id": "24c37138-2f94-3852-bb94-efc0e5188eb1",
                                        "glosses": [
                                            "A substance with electrical properties intermediate between a good conductor and a good insulator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4772d00e-903f-47ae-b0e9-67444a23914b",
                                                "sense_id": "bd362fa6-7bd7-3d1f-834e-8b83ee3e5955",
                                                "text": "Holonyms: chip, microchip, integrated circuit"
                                            },
                                            {
                                                "example_id": "e6f03add-0a50-4441-b221-c23034095dfb",
                                                "sense_id": "bd362fa6-7bd7-3d1f-834e-8b83ee3e5955",
                                                "text": "Integrated circuits are made from semiconductors, especially silicon."
                                            },
                                            {
                                                "example_id": "dcc1fcbd-de81-4f9d-aadc-d791c06ed5b2",
                                                "sense_id": "bd362fa6-7bd7-3d1f-834e-8b83ee3e5955",
                                                "text": "In this sense we are to understand the following table in which bodies are classed as conductors, semiconductors, and nonconductors; those bodies being conveniently designated as conductors which, when applied to an electroscope charged with either kind of electricity discharge it almost instantaneously; semiconductors being those which discharge it in a short but measurable time, a few seconds, for instance; while nonconductors effect no discharge even, in the course of a minute."
                                            },
                                            {
                                                "example_id": "4caf28c0-afd5-48cd-981f-f34e4a93886c",
                                                "sense_id": "bd362fa6-7bd7-3d1f-834e-8b83ee3e5955",
                                                "text": "The following table of conductors may therefore be used in inverse order as a table of resistances, the good conductors being bodies of slight resistance, the semiconductors being bodies of great resistance, and the insulators being bodies of so great resistance that they almost effectually oppose the passage of any current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8ba5be-d9f0-30be-9927-15d0767ac5b5",
                                        "entry_id": "24c37138-2f94-3852-bb94-efc0e5188eb1",
                                        "glosses": [
                                            "Ellipsis of semiconductor device."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51f1a344-c3a7-4318-ae29-2f244f12036a",
                                                "sense_id": "4e8ba5be-d9f0-30be-9927-15d0767ac5b5",
                                                "text": "Near-synonyms: chip, microchip, integrated circuit"
                                            },
                                            {
                                                "example_id": "6b182d3e-189e-4e87-b9d4-1812053fdc3a",
                                                "sense_id": "4e8ba5be-d9f0-30be-9927-15d0767ac5b5",
                                                "text": "The company supplies semiconductors to laptop, server, and smartphone manufacturers."
                                            },
                                            {
                                                "example_id": "983c5307-09cd-4baf-a476-fcc71cea64fb",
                                                "sense_id": "4e8ba5be-d9f0-30be-9927-15d0767ac5b5",
                                                "text": "Taiwan Semiconductor Manufacturing Co. on Wednesday said its revenues increased more sharply in the first quarter of 2024 than in any previous quarter since 2022 following a surge in demand for microchips driven by the artificial-intelligence boom. TSMC, which supplies semiconductors to top companies including Apple and Nvidia, posted a 16.5% increase in its first-quarter sales to NT$592.64 billion ($18.54 billion), in a sign the global chip market has now started recovering from the major slump that hit sales in 2023."
                                            },
                                            {
                                                "example_id": "75f476b5-13d0-4e6e-a7dd-f75d07cba647",
                                                "sense_id": "4e8ba5be-d9f0-30be-9927-15d0767ac5b5",
                                                "text": "Commerce Secretary Gina Raimondo proudly held up the progress of American industry on semiconductor manufacturing Sunday, declaring the U.S. has “outinnovated” China as the two nations fight to advance their domestic technology manufacturing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7d44bb2-8cdc-4c42-a977-e4b8d026808e",
                        "source_entry_id": "4392057a-8651-3484-b625-9b4246a45846",
                        "source_sense_description": "1-2",
                        "target_lang_word": "semi-conducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semi-conducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                        "entry_id": "a7bf95ae-59ef-3d26-aca5-516fab9228bf",
                                        "glosses": [
                                            "Matériau présentant une conductivité électrique intermédiaire entre les métaux et les isolants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c65403-7d15-4a5c-a4c1-a57f3e05a45d",
                                                "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                                "text": "Les semi-conducteurs sont primordiaux parce qu’ils offrent la possibilité de contrôler à la fois la quantité de courant électrique les traversant et la direction de ce courant."
                                            },
                                            {
                                                "example_id": "42df268a-3200-4e7c-aa38-5b05404b395e",
                                                "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                                "text": "L’effet photovoltaïque se manifeste lorsqu’un semi-conducteur absorbe de la lumière. En acceptant l’énergie des photons, les électrons de la bande de valence des semi-conducteurs passent dans la bande de conduction et créent ainsi des paires électron-trou."
                                            },
                                            {
                                                "example_id": "9f2e6c20-8519-4206-b2c4-eed209a983c0",
                                                "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                                "text": "L’industrie du semi-conducteur a suivi pendant longtemps la loi de Moore: environ tous les deux ans, elle est parvenue à doubler le nombre de transistors sur une puce. Mais, depuis quelques années, cette progression a été enrayée, certains éléments ayant atteint leur limite inférieure de taille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semi-conducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d91285f4-8cd8-31bb-afa3-bba072680435",
                                        "entry_id": "7a09681d-6805-3c59-a5ee-40d24d72166f",
                                        "glosses": [
                                            "Qui présente une conductivité électrique intermédiaire entre les métaux et les isolants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070c5b3c-f01f-411b-be14-893b7ec49cb5",
                                                "sense_id": "d91285f4-8cd8-31bb-afa3-bba072680435",
                                                "text": "Une céramique semi-conductrice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
