                    "frequency": "VeryLow",
                    "semantic_group_id": "alignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche du front froid, le vent s'est <w>rangé</w> au nord en quelques minutes seulement."
