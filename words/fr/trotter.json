                    ],
                    "common_phrases": [
                        "trotter dans la tête"
                    ]
                },
                {
                    "sense_id": "89fffed5-da35-3aa0-9b22-eb60fb6af492",
                    "sense_definition": "Faire de nombreuses allées et venues ou démarches pour une affaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai dû <w>trotter</w> toute la journée entre les différents bureaux pour obtenir ce visa."
                        },
                        {
                            "text": "Elle en a assez de <w>trotter</w> partout sans jamais obtenir de réponse claire."
                        }
                    ],
                    "common_phrases": [
