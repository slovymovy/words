                    ],
                    "synonyms": [
                        "discrétionnaire"
                    ],
                    "common_phrases": [
                        "peine arbitraire"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8cb662c-deec-3c5d-8eab-eaafb4a311e4",
                    "sense_definition": "Comportement ou pouvoir qui s'exerce selon le bon plaisir individuel au détriment des lois.",
