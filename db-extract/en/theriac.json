                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "663b94bd-3478-41d6-bdda-d8d24b980413",
                        "source_entry_id": "a2a2f8ad-49c6-32db-aca8-08c5708a0a70",
                        "source_sense_description": "a supposed universal antidote, distinguished from mithridate",
