                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b37f117-ba4a-4972-9c96-476414046bc2",
                                "sense_id": "905ee97a-d35b-31cb-950f-36f7ecd4a9b5",
                                "text": "„Einem Starkwind widerstehen oft fast alle Bäume oder kaum einer.“"
                            },
                            {
                                "example_id": "ac137de0-b896-4fbf-a224-1279860ba0b5",
                                "sense_id": "905ee97a-d35b-31cb-950f-36f7ecd4a9b5",
                                "text": "„Zu den gewaltigsten Wettererscheinungen der Erde gehören die Wirbelstürme der Tropen und Subtropen: Mit Dauerregen und Starkwinden sowie heftiger Brandung an der Küste können sie komplette Landstriche verwüsten.“"
                            }
                        ],
