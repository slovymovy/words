                "senses": [
                    {
                        "sense_id": "5fa9fbd7-9411-3a3b-8399-14ecd5f4def3",
                        "entry_id": "fc3c39ca-f71a-366e-8258-e4b1470e8494",
                        "glosses": [
                            "Erweiterung/Zunahme des Wortschatzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1ce147-46f8-4b6a-8934-1c883e89edca",
                                "sense_id": "5fa9fbd7-9411-3a3b-8399-14ecd5f4def3",
                                "text": "„Was den Wortschatzumfang und Wortschatzzuwachs im Vorschulalter betrifft, so gibt es eine große Zahl von Untersuchungen auf Grundlage des Englischen, kritisch erörtert von McCarthy (1954: 526 – 537).“"
                            },
                            {
                                "example_id": "1efe7b50-84e9-4633-8404-578de892b904",
                                "sense_id": "5fa9fbd7-9411-3a3b-8399-14ecd5f4def3",
                                "text": "„Dies ist der Wortschatzzuwachs des Englischen, wie er sich auf der Grundlage eines Lexikons (OED) darstellt.“"
                            },
                            {
                                "example_id": "63b139f7-104b-45be-ae93-7d9418c9889c",
                                "sense_id": "5fa9fbd7-9411-3a3b-8399-14ecd5f4def3",
                                "text": "„Den Wortschatzzuwachs Ihrer Schülerinnen und Schüler können Sie wie folgt feststellen.“"
                            },
                            {
                                "example_id": "e12e6c08-b819-492f-80ba-703731c7e3b1",
                                "sense_id": "5fa9fbd7-9411-3a3b-8399-14ecd5f4def3",
                                "text": "„Um den Wortschatzzuwachs bei den Kindern bestimmen zu können, wurde zu allen Messzeitpunkten ein Test zum Zielwortschatz eingesetzt.“"
                            },
                            {
                                "example_id": "6eab4fc4-f4b0-4626-bd8c-0a64a553fe59",
                                "sense_id": "5fa9fbd7-9411-3a3b-8399-14ecd5f4def3",
                                "text": "„Die Studie offenbart neben einer altersbedingten Veränderung in der Lexikonentwicklung eine zunehmende interindividuelle Variabilität in Bezug auf Wortschatzzuwachs und Wortschatzgröße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
