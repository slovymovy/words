                        "glosses": [
                            "to tear apart, to completely separate by tearing"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a41d1af-5474-40ed-8ed7-eb0c39fafd89",
                                "sense_id": "468fddfd-499f-3e9e-a2d0-213c9a078b94",
                                "text": "Jason had alle liefdesbrieven doorgescheurd.",
                                "translation": "Jason had torn all the love letters apart.",
                                "english": "Jason had torn all the love letters apart."
                            }
