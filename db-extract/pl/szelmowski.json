                "translations": [
                    {
                        "translation_id": "1ec06da7-341c-4af1-97a7-dbfc747d3663",
                        "source_entry_id": "eaf0c529-9681-3a5e-83ec-67ee91dec4d0",
                        "source_sense_id": "6833ed21-c7e7-3f88-8155-97c32ab7d2e3",
                        "target_lang_word": "skittish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skittish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af6b8a6f-443c-3580-8cb8-19d3316d4502",
                                        "entry_id": "95a9078f-e58c-3b90-bb40-ff1cf6cf9f83",
                                        "glosses": [
                                            "Easily scared or startled; timid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca196fd8-1891-4928-8895-c5101006d26f",
                                                "sense_id": "af6b8a6f-443c-3580-8cb8-19d3316d4502",
                                                "text": "The dog likes people he knows, but he is skittish around strangers."
                                            },
                                            {
                                                "example_id": "7c8d2575-ee07-46fe-aaa3-424ae84ef42b",
                                                "sense_id": "af6b8a6f-443c-3580-8cb8-19d3316d4502",
                                                "text": "1557, Roger Edgeworth, Sermons Very Fruitfull, Godly, and Learned, London: Robert Caly, The fiftenth treatice or Sermon,\nAll such be like a skittish starting horse, whiche coming ouer a bridge, wil start for a shadowe, or for a stone lying by him, and leapeth ouer on the other side into the water, & drowneth both horse and man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704f90a1-6b61-36bc-9632-d9173dcc145f",
                                        "entry_id": "95a9078f-e58c-3b90-bb40-ff1cf6cf9f83",
                                        "glosses": [
                                            "Wanton; changeable; fickle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27faee98-65f5-4609-93ce-0982633aa82b",
                                                "sense_id": "704f90a1-6b61-36bc-9632-d9173dcc145f",
                                                "text": "How some men creep in skittish fortune’s hall,\nWhiles others play the idiots in her eyes!"
                                            },
                                            {
                                                "example_id": "9285f2e4-5b85-489c-8330-dd4b34b9cc6e",
                                                "sense_id": "704f90a1-6b61-36bc-9632-d9173dcc145f",
                                                "text": "[…] ’Tis pitiful\nTo court a grin, when you should wooe a soul;\nTo break a jest, when pity would inspire\nPathetic exhortation; and t’ address\nThe skittish fancy with facetious tales,\nWhen sent with God’s commission to the heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "441a5811-ba22-3739-8865-3290097fa7a5",
                                        "entry_id": "95a9078f-e58c-3b90-bb40-ff1cf6cf9f83",
                                        "glosses": [
                                            "Difficult to manage; tricky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "806498f1-9e96-46e2-9b24-bb25027aa71e",
                                                "sense_id": "441a5811-ba22-3739-8865-3290097fa7a5",
                                                "text": "For everybody’s family doctor was remarkably clever, and was understood to have immeasurable skill in the management and training of the most skittish or vicious diseases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bfbf0d4-1b92-49ea-879f-2d3832f8e1c8",
                        "source_entry_id": "eaf0c529-9681-3a5e-83ec-67ee91dec4d0",
