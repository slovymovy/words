                "senses": [
                    {
                        "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                        "entry_id": "765cc969-b100-3522-9b9d-2851f729fb7d",
                        "glosses": [
                            "Anordnung der Schriftzeichen in einem Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "541bc80b-9a3e-4615-a4c7-4817cc8a2b10",
                                "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                                "text": "„Die Schriftrichtung der Runenzeilen in der älteren Zeit der Runendenkmäler ist beliebig: Sie können, wie in unserer heutigen Schrift und wie ganz überwiegend auch in der Runenschrift seit der Wikingerzeit, von links nach rechts gehen (rechtsläufig), aber ebensogut von rechts nach links (linksläufig), wie etwa in den semitischen Schriften.“"
                            },
                            {
                                "example_id": "02261bb6-bf84-459f-9e05-4ef475f2aa34",
                                "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                                "text": "„Geschrieben wurde zunächst furchenwendig (= bustrophedon), das heißt die Schriftrichtung wechselte von Zeile zu Zeile…“"
                            },
                            {
                                "example_id": "ae416512-e389-44c2-a2a3-86a7c2d679ef",
                                "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                                "text": "„Wenderunen heißen Runen, die gegen die Schriftrichtung verlaufen.“"
                            },
                            {
                                "example_id": "c46108d8-fa3a-4dc3-9c05-b93d784e8cab",
                                "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                                "text": "„Wenderunen heißen Runen, die gegen die Schriftrichtung verlaufen.“"
                            },
                            {
                                "example_id": "1a91cb30-ccec-4fa7-b4bd-c2c9bf24ec2c",
                                "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                                "text": "„…; sie treten unabhängig von der Schriftrichtung in diesen Spiegelformen auf.“"
                            },
                            {
                                "example_id": "2185ca08-7129-48db-8df0-2f592cf0a06d",
                                "sense_id": "b2ea1430-192f-3375-9da9-b595e34cf17c",
                                "text": "„Die Schriftrichtung verraten die Menschen- und Tierköpfe, weil sie nach dem Zeilenanfang blicken, und gelegentliche unausgefüllte Zeilenstücke: man schrieb ›bustrophedon‹, kehrte die Schriftrichtung jeweils am Zeilenende um, wie der Pflüger sein Gespann mit dem Pflug am Ende einer Ackerfurche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
