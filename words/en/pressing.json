            "senses": [
                {
                    "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                    "sense_definition": "Needing urgent attention.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government must address the <w>pressing</w> issue of unemployment immediately.",
                            "target_lang_translations": {
                                "ru": "Правительство должно немедленно решить эту <w>насущную</w> проблему безработицы.",
