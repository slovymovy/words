                        "examples": [
                            {
                                "example_id": "eacaa9b1-3957-403e-8d98-b44ceb9c6f1d",
                                "sense_id": "027bce89-04e3-3b42-9d5e-5b537c4fbd5d",
                                "text": "Durant une journée, nous avons suivi Laurent Ramon dans sa tournée des établissements de santé, au plus près des personnels soignants qui ont entamé depuis la semaine dernière la phase de « décovidisation » dans les services d’hospitalisation et d’urgences."
                            },
                            {
                                "example_id": "4fd4c21f-9038-47ab-8d62-112eeb211ff7",
                                "sense_id": "027bce89-04e3-3b42-9d5e-5b537c4fbd5d",
                                "text": "C'est ainsi que le combat de la décovidisation se remportera avec le moins de dégâts et de dommages collatéraux."
                            },
                            {
                                "example_id": "4945c51f-7969-48b5-a46b-83e21c8823fa",
                                "sense_id": "027bce89-04e3-3b42-9d5e-5b537c4fbd5d",
                                "text": "La science étant contrainte de fonctionner dans la patience, la persévérance, les thèses, les antithèses et les synthèses, alors la « décovidisation » n'est certainement pas pour demain."
                            }
                        ]
                    }
