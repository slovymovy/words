        "nl-extract.jsonl": [
            {
                "entry_id": "d7833280-2e8f-363f-a9d4-ec77b5bf99b4",
                "word": "taalschat",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "22b043b4-1f1b-47ac-ab57-696feaa0236e",
                        "entry_id": "d7833280-2e8f-363f-a9d4-ec77b5bf99b4",
                        "tags": [
                            "plural"
                        ],
                        "form": "taalschatten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18ecd227-13ae-3c40-b91f-0a635885bf19",
                        "entry_id": "d7833280-2e8f-363f-a9d4-ec77b5bf99b4",
                        "glosses": [
                            "de hoeveelheid en kwaliteit van de taal die men tot zijn beschikking heeft om zich te uiten of die men kan begrijpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0f42d4f-2f9f-40f9-9abb-b937e69b05f2",
                                "sense_id": "18ecd227-13ae-3c40-b91f-0a635885bf19",
                                "text": "Christelijke jongeren maken steeds meer gebruik van moderne media, waar de taalverruwing het sterkst openbaar komt. Dan gaat het niet alleen om vloeken in films, maar ook om platte taal op Hyves en MSN. Nieuwsbronnen als Metro, Sp!ts en nu.nl zijn onder meer vanwege het taalgebruik discutabel, maar desondanks populair. Het is onvermijdelijk dat deze media de taalschat van jongeren verarmen en vervuilen. Dat is een reden om zeer selectief met deze media om te gaan of ze gewoonweg te mijden."
                            },
                            {
                                "example_id": "5a0ace53-f33d-4f1b-a77e-dcff3329578a",
                                "sense_id": "18ecd227-13ae-3c40-b91f-0a635885bf19",
                                "text": "Iedereen heeft grotere en kleinere taalklonten in zijn hoofd. Een hoger opgeleide Nederlander kent volgens sommige schattingen zo’n veertigduizend woorden, maar het is duidelijk te simplistisch om iemands taalschat alleen aan zijn woorden af te meten. Ergens in het hoofd van die hoger opgeleide zitten ook taalbrokken als vijftig tinten x. Zoals daar trouwens ook wie denk je wel dat je bent? zit en al zeg ik het zelf en nog talloze vaste verbindingen. Niemand weet hoeveel dat er zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "b54281e3-53f4-37c3-b5b1-b699e5141d93",
                        "entry_id": "d7833280-2e8f-363f-a9d4-ec77b5bf99b4",
                        "glosses": [
                            "heel waardevol, mooi, belangrijk taalelement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45c1a80-bc6b-4dab-b2ac-64fab6ad372b",
                                "sense_id": "b54281e3-53f4-37c3-b5b1-b699e5141d93",
                                "text": "Achenebbisj, wiedeweerga, abominabel, prudent, balorig en navenant. Woorden die vandaag de dag niet veel meer worden gebruikt. Ze zijn ondergebracht in het boek '1000 vergeetwoorden om te koesteren', dat Van Dale heeft uitgebracht. Schrijfster en neerlandica Nelleke Noordervliet, die de samenstelling op zich nam, breekt in het boekje een lans voor deze \"vergeten taalschatten\" die het volgens haar verdienen om opnieuw te worden omarmd."
                            },
                            {
                                "example_id": "ec2159ba-cbef-4def-b24c-1462a1530279",
                                "sense_id": "b54281e3-53f4-37c3-b5b1-b699e5141d93",
                                "text": "Jacques Klöters moet nou eenmaal kletsen, in zijn onstuitbare drang anderen deelgenoot te maken van al die taalschatten. „Ik ben een ouwehoer.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "353a4d18-56be-40b0-a6d3-2dd305fa5b22",
                        "source_entry_id": "d7833280-2e8f-363f-a9d4-ec77b5bf99b4",
                        "source_sense_id": "18ecd227-13ae-3c40-b91f-0a635885bf19",
                        "source_sense_description": "beschikbare taal",
                        "target_lang_word": "idiom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d87e37-8c8d-4f6d-8ecf-ad670d282f6c",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "In English, idiom requires the indefinite article in a phrase such as \"she's an engineer\", whereas in Spanish, idiom forbids it."
                                            },
                                            {
                                                "example_id": "251e739c-fe54-45ed-9e43-37d875570181",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "Some of the usage prescriptions improved clarity and were kept; others that yielded discordant violations of idiom were eventually revised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people.",
                                            "A programming construct or phraseology that is characteristic of the language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ed047a-020a-4bdf-92d8-b8bd6707f9af",
                                                "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                                "text": "I have to use the same assignment and call to raw_input in two places. How can I avoid that? I can use the while True/break idiom: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A language or language variety; specifically, a restricted dialect used in a given historical period, context etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694ce1c5-20d5-41ca-94e1-4514efdf8a2d",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "In the idiom of the day, they were sutlers, although today they'd probably be called vendors."
                                            },
                                            {
                                                "example_id": "9364d6fd-b949-416f-bd8f-3126dd3dee8c",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "Many parents and teachers have become irritated to the point of distraction at the way the weed-style growth of \"like\" has spread through the idiom of the young."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An established phrasal expression whose meaning may not be deducible from the literal meanings of its component words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db5e533-89e7-4d96-996a-2da4bc4ae757",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "She often spoke in idioms, pining for salad days and complaining about pots calling the kettle black."
                                            },
                                            {
                                                "example_id": "4d267c6a-d6ab-4038-a898-cb5fa85f273c",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "You’re history, we say […]. Surely it is an American idiom. Impossible to imagine a postwar European saying, “You’re history. . . . That’s history,” meaning fuhgeddaboudit, pal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An artistic style (for example, in art, architecture, or music); an instance of such a style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416762a8-e688-4c82-9ce0-cf636b403e6a",
                                                "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                                "text": "the idiom of the expressionists"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
