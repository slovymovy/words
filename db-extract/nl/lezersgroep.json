                        "sense_id": "a5e4b5ba-dde2-3443-b5c8-b93ad4b721b8",
                        "entry_id": "6e1d83a1-1ad3-3938-9522-9451948533a5",
                        "glosses": [
                            "aantal mensen die samen een bepaalde tekst lezen; groep lezers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e18d78c-8b2c-4f63-9c91-5c1ae2c97360",
                                "sense_id": "a5e4b5ba-dde2-3443-b5c8-b93ad4b721b8",
                                "text": "Bij het verplaatsen vanuit de ene taal, cultuur en lezersgroep naar de andere gaan sommige aspecten van het origineel onvermijdelijk verloren."
                            },
                            {
                                "example_id": "850c44b8-e4a4-48d5-944a-c8b5d1e80689",
                                "sense_id": "a5e4b5ba-dde2-3443-b5c8-b93ad4b721b8",
                                "text": "Maar opvallend is dat, terwijl in de jaren vijftig de groep van twaalf- tot negentienjarigen tot de ijverigste lezers behoorde, juist bij de jeugd de leeslust meer daalde dan bij andere lezersgroepen."
                            },
                            {
                                "example_id": "7627c625-fc6a-41ca-b412-6c6a9e31ee33",
                                "sense_id": "a5e4b5ba-dde2-3443-b5c8-b93ad4b721b8",
                                "text": "Er zijn wel pogingen ondernomen om De Pers als krant te behouden, maar die mochten niet baten. Ook de actie Red De Pers van een fanatieke lezersgroep kon het tij niet keren."
                            }
                        ]
                    }
