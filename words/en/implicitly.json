    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e090fb6f-c369-381d-aca7-8640ce9e7ca9",
                    "sense_definition": "In a way that is suggested or understood without being directly stated.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract <w>implicitly</w> requires both parties to act in good faith."
                        },
                        {
                            "text": "She <w>implicitly</w> criticized his work by pointing out all the errors."
                        }
                    ],
                    "synonyms": [
                        "tacitly",
                        "indirectly"
                    ],
                    "antonyms": [
                        "explicitly"
                    ]
                },
                {
                    "sense_id": "1d751dde-2bad-33c3-9170-12d075f031b0",
                    "sense_definition": "With complete trust or without any doubt or questioning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team <w>implicitly</w> trusted their leader to make the right decision."
                        },
                        {
                            "text": "He <w>implicitly</w> followed every instruction given by his mentor."
                        }
                    ],
                    "synonyms": [
