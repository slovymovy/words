                "senses": [
                    {
                        "sense_id": "81b62315-19c9-3938-b20e-32b643ebf6f1",
                        "entry_id": "dc8ea9d8-9b95-318a-ae1d-a2182e77f4e8",
                        "glosses": [
                            "Nachttemperaturen von unter 0 °Celsius in Bodennähe, vor allem, wenn tagsüber höhere Temperaturen erreicht werden (sonst Dauerfrost)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4027bac-fa7e-4c29-9672-a3c5555e0dbf",
                                "sense_id": "81b62315-19c9-3938-b20e-32b643ebf6f1",
                                "text": "In der kommenden Woche sind weiterhin Nachtfröste zu erwarten."
                            },
                            {
                                "example_id": "d7bf6bce-38aa-4435-bee5-9d9c7aa42081",
                                "sense_id": "81b62315-19c9-3938-b20e-32b643ebf6f1",
                                "text": "„Der violett schimmernde Abendhimmel und der dumpf pochende Schmerz, der von ihrer Hüfte bis in den Oberschenkel zieht, kündigt Nachtfrost an.“"
                            },
                            {
                                "example_id": "2aff9723-4af3-49f3-afb7-432ff8d935a2",
                                "sense_id": "81b62315-19c9-3938-b20e-32b643ebf6f1",
                                "text": "„Nachdem die Schafherden von den Hochweiden heimgetrieben, der Herbstregen aufgehört, kam klares Wetter mit leichten Nachtfrösten, so daß die Wasserpfützen Eisränder bekamen und Rauhreif an den Gräsern hing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
