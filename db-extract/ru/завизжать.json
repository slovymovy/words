                ],
                "senses": [
                    {
                        "sense_id": "2a85e85c-ae8a-3300-9bb2-83b2eb6243b5",
                        "entry_id": "d8ec106f-28a7-36ee-97a8-01f47441cb86",
                        "glosses": [
                            "начать визжать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639ca6a5-e3f3-4ad7-8d5f-5a9aa0343379",
                                "sense_id": "2a85e85c-ae8a-3300-9bb2-83b2eb6243b5",
                                "text": "Завизжала, затрещала глупая баба, ― дескать, куда ты, батюшка, лезешь, чего тебе надо?"
                            },
                            {
                                "example_id": "94c47de4-2665-449a-bb2c-b0b97939caf4",
                                "sense_id": "2a85e85c-ae8a-3300-9bb2-83b2eb6243b5",
                                "text": "Утром загремели замки, завизжали на ржавых петлях двери, и в тюрьму вошел Герцик."
                            },
                            {
                                "example_id": "9b0f581b-34b9-4582-b810-7cd88378162e",
                                "sense_id": "2a85e85c-ae8a-3300-9bb2-83b2eb6243b5",
                                "text": "Завизжала собака, как обваренная кипятком, и бросилась в подворотню."
                            }
                        ]
                    }
                ],
