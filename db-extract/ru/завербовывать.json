                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7d15925-e3d2-4cb1-be3e-24e36df951f8",
                        "source_entry_id": "2354cfee-55f3-3faf-8437-8e5ce0630850",
                        "target_lang_word": "enrôler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enrôler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "439c29e0-33ce-3a09-bc68-ad11ec981e09",
                                        "entry_id": "54527378-15de-3e68-9206-a037aa0d42cc",
                                        "glosses": [
                                            "Inscrire sur les rôles de l’armée de terre ou de mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "266aeab3-e258-4b09-a963-b0c34553affd",
                                                "sense_id": "439c29e0-33ce-3a09-bc68-ad11ec981e09",
                                                "text": "Enrôler des soldats. - Enrôler des matelots."
                                            },
                                            {
                                                "example_id": "6e6a525a-1604-4960-a4be-31a7ca9b4b3f",
                                                "sense_id": "439c29e0-33ce-3a09-bc68-ad11ec981e09",
                                                "text": "On l’a enrôlé dans une compagnie d’infanterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5bf1581-5b9a-3126-8b4d-8620d6dc727e",
                                        "entry_id": "54527378-15de-3e68-9206-a037aa0d42cc",
                                        "glosses": [
                                            "Inscrire dans une étude clinique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a994973-d5f4-4ec2-ae5a-6ae2e8f33f74",
                                                "sense_id": "f5bf1581-5b9a-3126-8b4d-8620d6dc727e",
                                                "text": "Seize jeunes adultes (moyenne d’âge de 27 ans) ont été enrôlés pour cette étude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26de0dc5-ae04-3a47-b833-beeaf03320e6",
                                        "entry_id": "54527378-15de-3e68-9206-a037aa0d42cc",
                                        "glosses": [
                                            "Affilier à un parti, à un groupement, à une société, etc."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949ca564-d535-492c-abf0-85b107a0c5fb",
                                                "sense_id": "26de0dc5-ae04-3a47-b833-beeaf03320e6",
                                                "text": "Une guerre au service d'une grande idée est la seule susceptible d'être comprise par un Berbère, c'est la guerre sainte, celle qui, sous le nom de djehad, permit aux Arabes d’enrôler les indigènes nord-africains sous les bannières de l'Islam […]."
                                            },
                                            {
                                                "example_id": "d2fea71d-48fd-4230-ad2d-52075a9b4a6f",
                                                "sense_id": "26de0dc5-ae04-3a47-b833-beeaf03320e6",
                                                "text": "Enrôler quelqu’un dans une troupe de comédiens ambulants."
                                            },
                                            {
                                                "example_id": "13f39aea-0ee3-4b8a-9d92-fda56f494cdf",
                                                "sense_id": "26de0dc5-ae04-3a47-b833-beeaf03320e6",
                                                "text": "Il s’est laissé enrôler dans notre syndicat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86fbfa53-d83f-3d5b-a5f2-467220b33312",
                                        "entry_id": "54527378-15de-3e68-9206-a037aa0d42cc",
                                        "glosses": [
                                            "Se faire inscrire sur les rôles militaires ou maritimes, en s’engageant à servir durant un temps déterminé."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f918b630-d8f8-4159-a742-191aa06b8376",
                                                "sense_id": "86fbfa53-d83f-3d5b-a5f2-467220b33312",
                                                "text": "[…], tous les hommes en état de porter les armes furent mis en activité. On s'enrôla sur les places publiques ; on fabriqua des fusils et des piques."
                                            },
                                            {
                                                "example_id": "6818cc43-5800-4042-84bb-e34b209c9311",
                                                "sense_id": "86fbfa53-d83f-3d5b-a5f2-467220b33312",
                                                "text": "Des guerrières, il s'en trouve et s'en trouvera partout. De la Soudanaise qui refuse de porter le voile à la Kurde qui s'enrôle comme soldat contre les djihadistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e83c0ba-01d2-4b10-8574-04b60b8cd107",
                        "source_entry_id": "2354cfee-55f3-3faf-8437-8e5ce0630850",
                        "target_lang_word": "recruter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recruter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0309f7ea-2464-301c-ab3b-be7ee47359c2",
                                        "entry_id": "571e8dd0-b619-39a7-9206-ee3499436040",
                                        "glosses": [
                                            "Lever des hommes pour le service militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b06be1b-5073-4a92-9b2d-9446eb414582",
                                                "sense_id": "0309f7ea-2464-301c-ab3b-be7ee47359c2",
                                                "text": "Recruter une troupe."
                                            },
                                            {
                                                "example_id": "3c46797d-324b-4b0e-a741-b8318d684470",
                                                "sense_id": "0309f7ea-2464-301c-ab3b-be7ee47359c2",
                                                "text": "Recruter une armée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f815390-d380-347f-9b37-2ed3d32d4bc3",
                                        "entry_id": "571e8dd0-b619-39a7-9206-ee3499436040",
                                        "glosses": [
                                            "Sélectionner et embaucher du personnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67f9c34-942a-413d-a16c-676d6dd4c2eb",
                                                "sense_id": "0f815390-d380-347f-9b37-2ed3d32d4bc3",
                                                "text": "« Il ne faut pas recourir à du job dating pour recruter les professeurs », a glissé la patronne de l’Ageem au ministre, avant de rappeler la nécessité de former les enseignants tout au long de leur carrière et de faire en sorte qu’ils puissent être accompagnés par des Atsem en classe."
                                            },
                                            {
                                                "example_id": "9748069f-74ab-472c-96b2-3104c871de4a",
                                                "sense_id": "0f815390-d380-347f-9b37-2ed3d32d4bc3",
                                                "text": "Recruter de nouveaux collaborateurs est un réel relai de croissance pour les entreprises et contribue fortement à leur permettre de se développer sereinement."
                                            },
                                            {
                                                "example_id": "384528a3-4b69-4630-8eb5-7dc948da1579",
                                                "sense_id": "0f815390-d380-347f-9b37-2ed3d32d4bc3",
                                                "text": "Un cabinet de conseil, partenaire de la Philharmonie de Paris a eu une idée originale pour recruter ses jeunes consultants. Ils sont invités à un concert à la Philharmonie, avant de passer un entretien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95138ef6-8c63-37db-8953-6bfc5da9b8c1",
                                        "entry_id": "571e8dd0-b619-39a7-9206-ee3499436040",
                                        "glosses": [
                                            "Amener des personnes à faire partie d’une association, d’un parti, d’une école, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3874c58e-fb92-48e2-b69d-d3c91c8794cf",
                                                "sense_id": "95138ef6-8c63-37db-8953-6bfc5da9b8c1",
                                                "text": "Des groupes nombreux et menaçans recommencèrent à se former dès le milieu d'octobre ; ils allaient çà et là recrutant les gens sans aveu, les désœuvrés, les ouvriers fâchés encore, les curieux, qui par leur masse augmentaient la foule […]."
                                            },
                                            {
                                                "example_id": "71eb05cc-7f5a-4a35-8451-0aa6d68ff170",
                                                "sense_id": "95138ef6-8c63-37db-8953-6bfc5da9b8c1",
                                                "text": "Au cours du procès Zola, les antisémites recrutèrent des troupes de manifestants soldés, qui étaient chargés d'exprimer les indignations patriotiques ; le gouvernement de Méline protégeait ces manœuvres."
                                            },
                                            {
                                                "example_id": "c5bb824a-5f9d-4810-baf2-5cef0b64b843",
                                                "sense_id": "95138ef6-8c63-37db-8953-6bfc5da9b8c1",
                                                "text": "Casablanca est une ville bédouine. Le gros de sa population se recrute parmi les tribus voisines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1dcb605-c7e7-31e9-a096-aab20f521b81",
                                        "entry_id": "571e8dd0-b619-39a7-9206-ee3499436040",
                                        "glosses": [
                                            "Se fournir de recrues."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b39e8646-9929-431b-8231-c3309ea6bffd",
                                                "sense_id": "c1dcb605-c7e7-31e9-a096-aab20f521b81",
                                                "text": "Déterminer le mode suivant lequel l’armée se recrute, doit se recruter."
                                            },
                                            {
                                                "example_id": "83697b62-3305-4957-94bc-fcc5fab3332b",
                                                "sense_id": "c1dcb605-c7e7-31e9-a096-aab20f521b81",
                                                "text": "Ce régiment s’est recruté dans telle province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a85643-f35e-33dd-aa6b-370a4fdc3157",
                                        "entry_id": "571e8dd0-b619-39a7-9206-ee3499436040",
                                        "glosses": [
                                            "Remplacer les membres qui lui manquent, en parlant d'un corps politique."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb25dab-c0cd-4759-87dc-baea5888cbca",
                                                "sense_id": "84a85643-f35e-33dd-aa6b-370a4fdc3157",
                                                "text": "Le Sénat romain se recrutait parmi les grands fonctionnaires publics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f62ca3b-d1aa-3518-a1b2-242672f2c391",
                                        "entry_id": "571e8dd0-b619-39a7-9206-ee3499436040",
                                        "glosses": [
                                            "Repérer, marquer des tiges d’avenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603bdcc1-22b0-4ece-8349-a57019bd0b0e",
                                                "sense_id": "4f62ca3b-d1aa-3518-a1b2-242672f2c391",
                                                "text": "Les tiges des essences du mélange temporaire, qui ont un âge d’exploitabilité beaucoup plus réduit que celui du chêne, sont désignées en sus et sont détourées plus précocement […]. Elles sont recrutées à la densité de 10 à 20 tiges maximum par hectare et récoltées progressivement dès que leur diamètre d’exploitabilité est atteint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
