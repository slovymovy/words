                ],
                "senses": [
                    {
                        "sense_id": "368d16b4-6dcc-3017-bd0f-2ce41765a718",
                        "entry_id": "622024f1-d491-368a-b4f0-cbe0eb609fe8",
                        "glosses": [
                            "(wie Regen[tropfen]) von oben, einem höher gelegenen Ort, nach unten, einen tiefer gelegenen Ort, fallen/herabkommen"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4d264a22-7f0a-4821-b4df-215d2e95c024",
                                "sense_id": "368d16b4-6dcc-3017-bd0f-2ce41765a718",
                                "text": "„Über Meilen sieht man endlose Felder, auf die das Wasser der Berieselungsanlagen herniederregnet und auf denen Landarbeiter in gebeugter Haltung die Ernte einbringen.“"
                            },
                            {
                                "example_id": "301eaa4f-2501-4090-990e-e7eb4f4c46e0",
                                "sense_id": "368d16b4-6dcc-3017-bd0f-2ce41765a718",
                                "text": "„Man sollte es nicht glauben, aber jeder geübte Bogenschütze konnte […] in einer Minute bis zu zwölf Pfeile ins Ziel bringen und einen regelrechten Pfeilhagel auf die Gegner herniederregnen lassen.“"
                            },
                            {
                                "example_id": "89cea2c5-ffa6-4af0-a4d6-69ba36b6cd83",
                                "sense_id": "368d16b4-6dcc-3017-bd0f-2ce41765a718",
                                "text": "„In der Morgenröte läßt er Kuchen, in der Dämmerung des Abends Schauer von Weizen herniederregnen.“"
                            },
                            {
                                "example_id": "40ae3d01-e9e8-4bb4-b081-a63cb27a4131",
                                "sense_id": "368d16b4-6dcc-3017-bd0f-2ce41765a718",
                                "text": "„[…] Wir alle schauten nach Westen, wo wir eine schwarze Rauchwand in den Himmel steigen sahen. Noch während wir dort standen und offenen Mundes auf das Schauspiel starrten, begannen Asche und Funken auf uns herniederzuregnen.“"
                            },
                            {
                                "example_id": "ffd953bd-98c3-4e28-a18b-a94bd3342556",
                                "sense_id": "368d16b4-6dcc-3017-bd0f-2ce41765a718",
                                "text": "„Schlingrosen übermoosten teppichweich den Boden, während Kletterrosen andere Rosenstöcke umschlangen, wie zähes Efeugerank; grüne Raketen stiegen und ließen beim leisesten Hauch Blumenblätter herniederregnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
