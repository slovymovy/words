                                                "sense_id": "f6b57a60-ab0f-3f33-b662-8e7425c61376",
                                                "text": "Die Gärtnerin ist emsig wie eine Biene."
                                            },
                                            {
                                                "example_id": "18746210-bbbc-4861-bf07-752c0660b73a",
                                                "sense_id": "f6b57a60-ab0f-3f33-b662-8e7425c61376",
                                                "text": "Emsig sammeln die Kinder den Müll vom Schulhof auf und bringen ihn zum Hausmeister."
                                            }
