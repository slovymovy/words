                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fceeb1-42ab-4cd8-9141-4dc61645781a",
                                "sense_id": "64d2751f-f0a3-3eef-8915-5ea146dd7557",
                                "text": "La constitution cyclothymique a été décrite successivement par Kahlbaum, Hecker, Kraepelin et son élève Wilmanns, en Allemagne, puis par G. Denis et son élève Pierre Kahn en France."
                            },
                            {
                                "example_id": "6a328d92-2632-4ce5-a291-064b6dfa3ce7",
                                "sense_id": "64d2751f-f0a3-3eef-8915-5ea146dd7557",
                                "text": "Pour tenter de voir plus clair, la figure qui suit illustre les différences entre les variations normales de l’humeur, le tempérament cyclothymique et le trouble cyclothymique."
                            }
                        ]
                    }
