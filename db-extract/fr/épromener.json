                "senses": [
                    {
                        "sense_id": "6cf2609d-269a-3276-a4e7-8fd566c73e64",
                        "entry_id": "946d39e6-f400-314a-bac3-b89468782cb4",
                        "glosses": [
                            "Ancienne variante de promener."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad37288-717a-4c32-ab99-08b616971626",
                                "sense_id": "6cf2609d-269a-3276-a4e7-8fd566c73e64",
                                "text": "C'est pourquoi, bien souvent, ses récits avancent comme au hasard, et comme une promenade, tout événement s’y trouvant \"épromené\" : on passe à autre chose!"
                            },
                            {
                                "example_id": "d9855b83-8390-4e6b-b881-22720bffdd46",
                                "sense_id": "6cf2609d-269a-3276-a4e7-8fd566c73e64",
                                "text": "Veux-tu venir bell’ Jeanneton le long de la mer coulante. Nous épromener tout au long. Y a du plaisir, nous en prendrons. (J. Bujeaud, Chants et chansons populaires des Province de l’Ouest, Niort, 1895, vol. 2, p. 237)"
                            }
                        ]
                    }
