                "senses": [
                    {
                        "sense_id": "4eb60e8f-43a5-35ef-b43c-d597a9979fb4",
                        "entry_id": "4fe50833-dc8c-3195-8d0d-2b8e9b9fb7b0",
                        "glosses": [
                            "сопровождать игрой на музыкальном инструменте или на музыкальных инструментах сольную вокальную или инструментальную партию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8134958-13ea-44ce-8a08-4406b335edde",
                                "sense_id": "4eb60e8f-43a5-35ef-b43c-d597a9979fb4",
                                "text": "Она не умела себе аккомпанировать, но прекрасно читала ноты голосом. Кити, хорошо игравшая, аккомпанировала ей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e924ead9-fc16-4619-a41e-68d9ec965e54",
                        "source_entry_id": "4fe50833-dc8c-3195-8d0d-2b8e9b9fb7b0",
                        "source_sense_id": "4eb60e8f-43a5-35ef-b43c-d597a9979fb4",
                        "target_lang_word": "accompany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accompany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026f738d-5f22-3d93-a540-bcef407c5b24",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To go with or attend as a companion or associate; to keep company with; to go along with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7ead24-5d84-4d2d-b47b-df7e6d0cbe78",
                                                "sense_id": "026f738d-5f22-3d93-a540-bcef407c5b24",
                                                "text": "Geoffrey accompanied the group on their pilgrimage."
                                            },
                                            {
                                                "example_id": "51582a1d-8ca7-47c5-93d0-52e252cd101d",
                                                "sense_id": "026f738d-5f22-3d93-a540-bcef407c5b24",
                                                "text": "The Persian dames, […] / In sumptuous cars, accompanied his march."
                                            },
                                            {
                                                "example_id": "32f5166f-ce39-4be2-8ba4-a7747b26c92f",
                                                "sense_id": "026f738d-5f22-3d93-a540-bcef407c5b24",
                                                "text": "They are never alone that are accompanied with noble thoughts."
                                            },
                                            {
                                                "example_id": "03d90640-8e4f-42bf-a373-d82fa16ca746",
                                                "sense_id": "026f738d-5f22-3d93-a540-bcef407c5b24",
                                                "text": "He was accompanied by two carts filled with wounded rebels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a514ab5-1671-3015-bb26-2f91920fc60e",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To supplement with; add to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ecdfc8-eccd-45c2-a4d9-622f76c7adec",
                                                "sense_id": "0a514ab5-1671-3015-bb26-2f91920fc60e",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "093d4aae-9ed5-3017-a0f2-7b6e6cd893fb",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To perform an accompanying part or parts in a composition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4655cab6-2068-3267-a2fe-95fdda9e894a",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To perform an accompanying part next to (another instrument or musician)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "658999a1-4124-4a3c-8f09-251a373a7a3c",
                                                "sense_id": "4655cab6-2068-3267-a2fe-95fdda9e894a",
                                                "text": "The strings were accompanied by two woodwinds."
                                            },
                                            {
                                                "example_id": "0a4a6843-93af-497e-91bb-eeaed9ac7c1c",
                                                "sense_id": "4655cab6-2068-3267-a2fe-95fdda9e894a",
                                                "text": "I will accompany her on the oboe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33275e27-bc7f-3757-825f-ed54428271a8",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To associate in a company; to keep company."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f23706-c08d-4cbb-a7b6-1da50f36f868",
                                                "sense_id": "33275e27-bc7f-3757-825f-ed54428271a8",
                                                "text": "Men say that they will drive away one another, […] and not accompanied together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757e6c94-bce0-3047-821c-a8eb80bfc32c",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To cohabit (with)."
