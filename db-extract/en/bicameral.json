                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08be61b7-f9ae-45d8-8bd6-c627c631e3c2",
                                "sense_id": "c62ff119-c43e-3cf1-ba8d-b5fb9d14e751",
                                "text": "By preventing legislative usurpation in the beginning, the bicameral legislature avoids executive usurpation in the end."
                            },
                            {
                                "example_id": "321f70df-bcfc-45a6-bf97-905fc69b8980",
                                "sense_id": "c62ff119-c43e-3cf1-ba8d-b5fb9d14e751",
                                "text": "The legislature (Standeversammlung) is bicameral — the constitution of the co-ordinate chambers being finally settled by a law of 1868 amending the enactment of 1831."
                            },
                            {
                                "example_id": "72a63a49-0d01-4e0f-a137-02c540acfa37",
                                "sense_id": "c62ff119-c43e-3cf1-ba8d-b5fb9d14e751",
                                "text": "Once the Senate votes, aides said, the first order of business in the bicameral talks will be to set an overall dollar figure […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4a44ed-103b-3748-8d65-1fc381aef536",
                        "entry_id": "9dacc463-8281-3202-8c14-cb3cbef921d5",
                        "glosses": [
                            "Bicaméral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e3cec8-50e8-427a-b610-6f780165ae9d",
                                "sense_id": "5a4a44ed-103b-3748-8d65-1fc381aef536",
                                "text": "Aspect values on bicameral fonts are based on the size of the lowercase characters."
                            },
                            {
                                "example_id": "fd436359-201b-41d5-9940-7995a0b1a4ef",
                                "sense_id": "5a4a44ed-103b-3748-8d65-1fc381aef536",
                                "text": "Bicameral (upper- and lowercase) unserifed roman fonts were apparently first cut in Leipzig in the 1820s."
                            },
                            {
                                "example_id": "9a11bf0b-efa2-4855-aea3-e4648c67fa8a",
                                "sense_id": "5a4a44ed-103b-3748-8d65-1fc381aef536",
                                "text": "For more than a thousand years, classical Greek has been habitually written in a bicameral, polytonic alphabet (one with caps and lower case and a set of diacritics marking tone and aspiration)."
                            }
                        ]
                    }
                ],
