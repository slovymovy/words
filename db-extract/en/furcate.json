                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebde2f1b-3c10-4fa0-92f0-cbfcbd09dccf",
                        "source_entry_id": "a989a9ad-25ef-3008-b54d-1cee9fda2deb",
                        "source_sense_id": "d163e21f-f4b3-3562-afd4-ee99392629cb",
                        "source_sense_description": "forked, branched",
                        "target_lang_word": "разветвлённый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разветвлённый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e41c4794-5143-3344-8f89-3fa49ad34421",
                                        "entry_id": "79a2986a-5917-3eaf-9c36-bf5522e52d14",
                                        "glosses": [
                                            "имеющий много ветвей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4cc25f-8055-4cb7-8255-e67bdd039c5e",
                                                "sense_id": "e41c4794-5143-3344-8f89-3fa49ad34421",
                                                "text": "Растение в это время имеет вид длинного разветвлённого корневища, может уходить глубоко под землю и занимать внушительные пространства."
                                            },
                                            {
                                                "example_id": "2be22214-fb6f-4a1f-a310-cfcb7141e877",
                                                "sense_id": "e41c4794-5143-3344-8f89-3fa49ad34421",
                                                "text": "Он образует под землёй мощную систему разветвлённых корней, рост которых идёт до глубокой осени."
                                            },
                                            {
                                                "example_id": "5b0a42b8-1156-46ff-9e5d-74eeabc5eef9",
                                                "sense_id": "e41c4794-5143-3344-8f89-3fa49ad34421",
                                                "text": "Заботливо ухожены и вымыты Сучки тропинок и стволы дорог. Дороги… Разветвлённые деревья Меня укрыли облачной листвой, И слышу я, как пролетает время, Шурша своей невидимой волной… И новый век, как новое цунами, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4ea2f6-8986-3263-b520-0411bdf9fe22",
                                        "entry_id": "79a2986a-5917-3eaf-9c36-bf5522e52d14",
                                        "glosses": [
                                            "расходящийся в разные стороны, идущий в разных направлениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23364dfa-6649-4448-bcb0-ed65298e069d",
                                                "sense_id": "1c4ea2f6-8986-3263-b520-0411bdf9fe22",
                                                "text": "Могучая река, разветвлённая на множество рукавов, показывала сразу все свои извилистые изгибы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1f6a61-5854-3bcf-a91b-3264adf941b8",
                                        "entry_id": "79a2986a-5917-3eaf-9c36-bf5522e52d14",
                                        "glosses": [
                                            "перен. состоящий из большого числа отделов, отделений, направлений, разветвлений, ответвлений и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7b10c2-5d67-4f1f-b7ee-d5c180554b50",
                                                "sense_id": "0f1f6a61-5854-3bcf-a91b-3264adf941b8",
                                                "text": "Наиболее удачный вариант банковских систем денежных переводов реализуется на базе многофилиальных банков, имеющих разветвлённую сеть отделений."
                                            },
                                            {
                                                "example_id": "76c0a9c7-6d70-461c-8471-d6abefafca76",
                                                "sense_id": "0f1f6a61-5854-3bcf-a91b-3264adf941b8",
                                                "text": "Вся вооружённая борьба будет пронизана разветвлённым информационным противоборством."
                                            },
                                            {
                                                "example_id": "0d081084-e881-4906-8e1b-2d8a8c5e3dad",
                                                "sense_id": "0f1f6a61-5854-3bcf-a91b-3264adf941b8",
                                                "text": "Теперешний наш союз — это большая разветвлённая структура со множеством отдельных подразделений, ведущих свою творческую, просветительскую и организационную работу, в которой участвуют музыкальные учреждения из разных регионов России, а также наши коллеги из стран СНГ."
                                            },
                                            {
                                                "example_id": "e2030d0a-c751-4751-b1fe-cf8626c773cb",
                                                "sense_id": "0f1f6a61-5854-3bcf-a91b-3264adf941b8",
                                                "text": "Работает в ателье у Офры, известной в Старгороде портнихи из семьи испанских евреев, семьи разветвлённой, старинной, с говорящей фамилией Толедано, чьи предки, покинув Испанию пять веков назад, поселились в Еврейском квартале."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26667f28-5b72-3eda-bc2a-b21f92d0f53b",
                                        "entry_id": "79a2986a-5917-3eaf-9c36-bf5522e52d14",
                                        "glosses": [
                                            "являющийся следствием разветвления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f876c7-106e-4e87-a01b-c3e7771d28c1",
                                                "sense_id": "26667f28-5b72-3eda-bc2a-b21f92d0f53b",
                                                "text": "Сучки — основания живых или отмерших при росте дерева ветвей, заключённые в основной массе древесины. Образуются они при росте… По расположению сучки делят на разбросанные, групповые и разветвлённые."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
