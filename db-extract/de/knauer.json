                ],
                "senses": [
                    {
                        "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                        "entry_id": "d00bb151-75ef-35a5-8127-ffe935f966bf",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47cc1998-008a-4219-9ad6-49c2aeeea12e",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knauer kommt, geht der Herr Knauer.“"
                            },
                            {
                                "example_id": "ba38ee4c-d29b-4b7d-b96b-7ff87d4670f1",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Knauer kommt und geht."
                            },
                            {
                                "example_id": "06cda904-5a59-4c0e-99f4-1f802a38ee3d",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Knauers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "91283213-c488-409f-80ce-7aaa732a7e92",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Frau Knauer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5fbdb0af-fffa-428c-895c-189943a3ee4a",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Herr Knauer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0e71b601-972e-4ddc-96d9-3512f497cd53",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Die Knauers fahren heute nach Frankfurt."
                            },
                            {
                                "example_id": "a67a6484-7825-4473-97e1-2d2f1901cbb0",
                                "sense_id": "9ca594ff-d050-3957-81a2-9b8d1559184f",
                                "text": "Der Knauer trägt nie die Schals, die die Knauer ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
