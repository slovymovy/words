                            "prepositional"
                        ],
                        "form": "кро́ншнепе"
                    },
                    {
                        "form_id": "61b072a2-0a2c-47ac-a839-b125d85c03d1",
                        "entry_id": "da1731d2-62e7-34a0-a02e-838cb8de7753",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "кро́ншнепах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34368543-4b9d-3984-bc64-d53ef7a9c905",
                        "entry_id": "da1731d2-62e7-34a0-a02e-838cb8de7753",
                        "glosses": [
                            "орнитол. птица семейства бекасовых (лат. Numenius)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa64f706-5457-4fb3-9d0a-edbb0aa49266",
                                "sense_id": "34368543-4b9d-3984-bc64-d53ef7a9c905",
                                "text": ".. я обстоятельно рассказывал ему, что есть болота и кустарники, реки и озёра, что всякой дичи бездна: куликов, дупельшнепов, вальдшнепов и гаршнепов, что диких гусей и уток миллионы и, сверх того, множество дичи степной: кроншнепов, драхв, стрепетов и журавлей .."
                            },
                            {
                                "example_id": "6188cd7f-e96e-4667-b41d-6ea51f8d29e0",
                                "sense_id": "34368543-4b9d-3984-bc64-d53ef7a9c905",
                                "text": "Французы называют его курли, русские охотники — кроншнепом, а народ — степняком, или степнягой, потому что степь по преимуществу служит ему постоянным жилищем; в степи выводит он детей, и в степи же достигают они полного возраста."
                            },
                            {
                                "example_id": "07d99148-3d91-4ee2-82da-c33f078a12af",
                                "sense_id": "34368543-4b9d-3984-bc64-d53ef7a9c905",
                                "text": ".. на горах же, сейчас превращавшихся в равнины, покрытые тучною травою, воздух оглашался другими особенными свистами и голосами; там водилась во множестве вся степная птица: дрофы, журавли, стрепета, кроншнепы и кречётки .."
                            },
                            {
                                "example_id": "6306115a-e23e-46a8-afc3-7d0f0f748fcc",
                                "sense_id": "34368543-4b9d-3984-bc64-d53ef7a9c905",
                                "text": "Иногда мы видели кроншнепов, тоже весьма строгих птиц. Они грациозно расхаживали по камням, входили в реку и что-то доставали из воды своими кривыми клювами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1e27c67-8e60-4055-a9e6-78d0f69d41ea",
                        "source_entry_id": "da1731d2-62e7-34a0-a02e-838cb8de7753",
                        "source_sense_id": "34368543-4b9d-3984-bc64-d53ef7a9c905",
                        "target_lang_word": "kulik",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kulik",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "4324a92a-592c-3ea2-99e0-cf66eb4224ef",
                                        "entry_id": "75abacd1-11fc-3a18-9d24-5c1b5c45119b",
                                        "glosses": [
                                            "Numenius, rodzaj dużego i cętkowanego, eurazjatyckiego ptaka z długim dziobem, z rodziny bekasowatych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4040e49b-25b6-4540-959b-98738239579e",
                                                "sense_id": "4324a92a-592c-3ea2-99e0-cf66eb4224ef",
                                                "text": "Były tam […] i żurawie z koronami na głowach, mnóstwo kulików, pstrych i szarych jak myszy, biegających szybko tam i na powrót, niby drobne duchy leśne, na długich, cienkich jak słomki nóżkach"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f36f879f-6561-3412-8fbb-d8ae88bf44f5",
                                        "entry_id": "75abacd1-11fc-3a18-9d24-5c1b5c45119b",
                                        "glosses": [
                                            "dziś zob. kulig"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03126bc-5c15-4db9-b36d-d5a05920c4b7",
                                                "sense_id": "f36f879f-6561-3412-8fbb-d8ae88bf44f5",
                                                "text": "Oto zapusty, dalej kulikiem, • Każdy wesoły, a każdy zbrojny, • Jedzie na wojnę jak gdyby z wojny, • Z szczękiem pałaszy, śmiechem i krzykiem"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "d16d3e71-f05f-3469-8d29-1cd93ca58b34",
                                        "entry_id": "75abacd1-11fc-3a18-9d24-5c1b5c45119b",
                                        "glosses": [
