                    {
                        "translation_id": "12638d58-9320-4326-995c-7d07c6d66579",
                        "source_entry_id": "55b2890e-99c4-33ba-b46b-6ad3b4330d32",
                        "source_sense_id": "c5ab6464-0194-3cce-a46b-c9ecaa8222af",
                        "source_sense_description": "Lieblichkeit, Milde",
                        "target_lang_word": "Lieblichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lieblichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd2968f-3085-386d-9287-67152f192fb4",
                                        "entry_id": "d4f728fc-9df7-3b28-a807-b09f8ee6a7e5",
                                        "glosses": [
                                            "Eigenschaft, lieblich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd71be4-9ae0-4a8a-86f6-fba0ec9e2075",
                                                "sense_id": "dbd2968f-3085-386d-9287-67152f192fb4",
                                                "text": "„Er hatte Natascha von ihren Kinderjahren an gekannt, und der Eindruck, den er von ihr hatte, war der einer solchen Lieblichkeit, dass er ihn mit der sich ihm neu aufdrängenden Vorstellung von ihrer Niedrigkit, Dummheit und Herzlosigkeit gar nicht in Einklang zu bringen vermochte.“"
                                            },
                                            {
                                                "example_id": "26aee597-6c64-4540-b97e-70cb465aedc6",
                                                "sense_id": "dbd2968f-3085-386d-9287-67152f192fb4",
                                                "text": "„Ich schilderte den zarten Kömmling im Elfenreiz, steigerte eine Zärtlichkeit meines eigenen Herzens ins nicht mehr ganz Rationale, zu einer Lieblichkeit, welche die Leute heimlich an Göttliches, an ein von hoch- und weither zu Besuch Kommendes, eine Epiphanie glauben läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
