                            {
                                "example_id": "cbb23e5c-196a-446a-b7fd-b95efcb240cc",
                                "sense_id": "06ecb59b-28c5-3f21-8a11-20547a29b2d2",
                                "text": "Je kunt niet vroeg genoeg beginnen met de financiële opvoeding, daar zijn deskundigen het over eens. Het geven van zakgeld, kleedgeld, een spaarpot en praten over de waarde van geld kan allemaal al vanaf de basisschool - wie een kind pas op zijn zestiende financieel gaat opvoeden is veel te laat."
                            }
                        ]
                    },
