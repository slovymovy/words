{
    "word_family": [
        "wretch",
        "wretchedly",
        "wretchedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8c43a11-fb4f-3bed-a503-31e30774f2bd",
                    "sense_definition": "Characterized by or feeling deep affliction or distress; very miserable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>wretched</w> and helpless in the darkness, surrounded by the noise of the angry waves.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя <w>несчастным</w> и беспомощным в темноте, окруженный шумом разгневанных волн.",
                                "de": "Ich fühlte mich in der Dunkelheit <w>elend</w> und hilflos, umgeben vom Tosen der wütenden Wellen."
                            }
                        },
                        {
                            "text": "The poor man felt <w>wretched</w> after his wife died, finding it hard to carry on with daily life.",
                            "target_lang_translations": {
                                "ru": "Бедняга чувствовал себя <w>жалким</w> после смерти жены, и ему было трудно продолжать обычную жизнь.",
                                "de": "Der arme Mann fühlte sich nach dem Tod seiner Frau <w>zutiefst unglücklich</w> und fand es schwer, den Alltag fortzusetzen."
                            }
                        }
                    ],
                    "synonyms": [
                        "miserable",
                        "unhappy",
                        "dejected",
                        "woebegone",
                        "forlorn"
                    ],
                    "antonyms": [
                        "cheerful",
                        "joyful",
                        "happy"
                    ],
                    "common_phrases": [
                        "feel wretched"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся глубоким страданием или горем; крайне несчастный.",
                        "de": "Geprägt von oder leidend unter tiefem Schmerz, Elend oder Verzweiflung; zutiefst unglücklich oder elend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный",
                                "target_lang_sense_clarification": "чувствующий глубокое горе"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "вызывающий сострадание своим состоянием"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "elend",
                                "target_lang_sense_clarification": "körperlich oder seelisch zutiefst unglücklich"
                            },
                            {
                                "target_lang_word": "miserabel",
                                "target_lang_sense_clarification": "sich extrem schlecht oder niedergeschlagen fühlend"
                            },
                            {
                                "target_lang_word": "unglücklich",
                                "target_lang_sense_clarification": "von Kummer und Verzweiflung erfüllt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9603db6-ba0e-3a66-9bfa-edb5e20200e3",
                    "sense_definition": "Used to express annoyance towards or dislike of someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Will you please stop playing that <w>wretched</w> trombone so early in the morning!",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прекрати играть на этом <w>проклятом</w> тромбоне так рано утром!",
                                "de": "Hörst du bitte auf, so früh am Morgen auf dieser <w>verfluchten</w> Posaune zu spielen!"
                            }
                        },
                        {
                            "text": "I cannot find my keys anywhere in this <w>wretched</w> house.",
                            "target_lang_translations": {
                                "ru": "Я нигде не могу найти ключи в этом <w>паршивом</w> доме.",
                                "de": "In diesem <w>verdammten</w> Haus kann ich meine Schlüssel nirgends finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasted",
                        "damned",
                        "confounded"
                    ],
                    "common_phrases": [
                        "wretched thing"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to emphasize frustration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения раздражения или неприязни к кому-либо или чему-либо.",
                        "de": "Wird verwendet, um Ärger, Frustration oder Abneigung gegenüber jemandem oder etwas auszudrücken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "вызывающий раздражение"
                            },
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "эмоциональное выражение неприязни"
                            },
                            {
                                "target_lang_word": "паршивый",
                                "target_lang_sense_clarification": "разговорное выражение недовольства"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verflucht",
                                "target_lang_sense_clarification": "emotionaler Ausdruck von großem Ärger"
                            },
                            {
                                "target_lang_word": "verdammte",
                                "target_lang_sense_clarification": "umgangssprachlicher Ausdruck von Frustration"
                            },
                            {
                                "target_lang_word": "elend",
                                "target_lang_sense_clarification": "abwertend zur Verstärkung von Unmut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4b1060a-0893-3108-8cde-3ffd527a709b",
                    "sense_definition": "Of weather: causing much discomfort; very unpleasant; miserable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to cancel our picnic because of the <w>wretched</w> weather and constant rain.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось отменить пикник из-за <w>скверной</w> погоды и постоянного дождя.",
                                "de": "Wegen des <w>scheußlichen</w> Wetters und des ständigen Regens mussten wir unser Picknick absagen."
                            }
                        },
                        {
                            "text": "The <w>wretched</w> cold made it impossible to stay outside for more than a few minutes.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>ужасного</w> холода было невозможно оставаться на улице дольше нескольких минут.",
                                "de": "Die <w>erbärmliche</w> Kälte machte es unmöglich, länger als ein paar Minuten draußen zu bleiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "miserable",
                        "unpleasant",
                        "dismal"
                    ],
                    "antonyms": [
                        "pleasant",
                        "lovely",
                        "fair"
                    ],
                    "common_phrases": [
                        "wretched weather"
                    ],
                    "target_lang_definitions": {
                        "ru": "О погоде: вызывающая сильный дискомфорт; крайне неприятная; скверная.",
                        "de": "Vom Wetter: großes Unbehagen verursachend; äußerst unangenehm oder scheußlich."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "о крайне неприятной погоде"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий сильный дискомфорт"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "scheußlich",
                                "target_lang_sense_clarification": "äußerst unangenehm und nasskalt"
                            },
                            {
                                "target_lang_word": "miserabel",
                                "target_lang_sense_clarification": "sehr schlecht und ungemütlich"
                            },
                            {
                                "target_lang_word": "hundsmiserabel",
                                "target_lang_sense_clarification": "umgangssprachlich für extrem widriges Wetter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ea2dd5-e8d9-3908-a7f7-ac96ffef0f12",
                    "sense_definition": "Of an inferior or unworthy nature or social status; contemptible, lowly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street was full of <w>wretched</w> beggars dressed in rags and seeking shelter.",
                            "target_lang_translations": {
                                "ru": "Улица была полна <w>убогих</w> нищих, одетых в лохмотья и ищущих убежища.",
                                "de": "Die Straße war voller <w>armseliger</w> Bettler, die in Lumpen gekleidet waren und nach Schutz suchten."
                            }
                        },
                        {
                            "text": "She lived in a <w>wretched</w> room near the hospital while working as a casual laborer.",
                            "target_lang_translations": {
                                "ru": "Она жила в <w>жалкой</w> каморке рядом с больницей, работая подсобным рабочим.",
                                "de": "Sie lebte in einem <w>erbärmlichen</w> Zimmer in der Nähe des Krankenhauses, während sie als Hilfsarbeiterin tätig war."
                            }
                        }
                    ],
                    "synonyms": [
                        "abject",
                        "lowly",
                        "shabby",
                        "beggarly"
                    ],
                    "antonyms": [
                        "noble",
                        "wealthy",
                        "grand"
                    ],
                    "common_phrases": [
                        "wretched conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкого или недостойного качества или социального статуса; презренный, убогий.",
                        "de": "Von minderem oder ärmlichem Zustand oder sozialem Status; erbärmlich, armselig."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убогий",
                                "target_lang_sense_clarification": "крайне бедный и жалкий"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "нищенский, вызывающий презрение"
                            },
                            {
                                "target_lang_word": "нищенский",
                                "target_lang_sense_clarification": "соответствующий крайне низкому статусу"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erbärmlich",
                                "target_lang_sense_clarification": "Mitleid erregend arm oder heruntergekommen"
                            },
                            {
                                "target_lang_word": "armselig",
                                "target_lang_sense_clarification": "von sehr kärglichen Verhältnissen zeugend"
                            },
                            {
                                "target_lang_word": "elend",
                                "target_lang_sense_clarification": "in bitterer Armut befindlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96e98cb8-8a03-3ce1-b2c7-d39509ebc297",
                    "sense_definition": "Of a person: behaving in a manner causing contempt; base, despicable, or wicked.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is nothing as <w>wretched</w> or as hated in all the world as a traitor.",
                            "target_lang_translations": {
                                "ru": "Нет ничего более <w>подлого</w> и ненавистного во всем мире, чем предатель.",
                                "de": "Es gibt auf der ganzen Welt nichts so <w>Niederträchtiges</w> oder Verhasstes wie einen Verräter."
                            }
                        },
                        {
                            "text": "The <w>wretched</w> man betrayed his friends just to save his own skin.",
                            "target_lang_translations": {
                                "ru": "<w>Презренный</w> человек предал своих друзей только для того, чтобы спасти свою шкуру.",
                                "de": "Der <w>verachtenswerte</w> Mann verriet seine Freunde, nur um seine eigene Haut zu retten."
                            }
                        }
                    ],
                    "synonyms": [
                        "despicable",
                        "vile",
                        "base",
                        "contemptible",
                        "ignoble"
                    ],
                    "antonyms": [
                        "honorable",
                        "virtuous",
                        "admirable"
                    ],
                    "common_phrases": [
                        "wretched man"
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке: ведущий себя презренно; подлый, низкий или нечестивый.",
                        "de": "Von Personen: sich auf verachtenswerte Weise verhaltend; niederträchtig, gemein oder boshaft."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "совершающий низкие поступки"
                            },
                            {
                                "target_lang_word": "презренный",
                                "target_lang_sense_clarification": "вызывающий глубокое презрение"
                            },
                            {
                                "target_lang_word": "низкий",
                                "target_lang_sense_clarification": "бесчестный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erbärmlich",
                                "target_lang_sense_clarification": "moralisch verwerflich und Verachtung verdienend"
                            },
                            {
                                "target_lang_word": "niederträchtig",
                                "target_lang_sense_clarification": "gemein und hinterhältig handelnd"
                            },
                            {
                                "target_lang_word": "verachtenswert",
                                "target_lang_sense_clarification": "tiefste moralische Ablehnung hervorrufend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40fd9a68-697d-383c-be6f-9e66f46b867d",
                    "sense_definition": "Of an insignificant, mean, or poor nature; miserable, paltry, or worthless.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All those <w>wretched</w> quarrels were very largely a question of money and greed.",
                            "target_lang_translations": {
                                "ru": "Все эти <w>ничтожные</w> ссоры были в значительной степени вопросом денег и жадности.",
                                "de": "All diese <w>armseligen</w> Streitigkeiten waren größtenteils eine Frage von Geld und Gier."
                            }
                        },
                        {
                            "text": "He offered a <w>wretched</w> excuse for his absence that no one believed.",
                            "target_lang_translations": {
                                "ru": "Он привел <w>жалкое</w> оправдание своего отсутствия, в которое никто не поверил.",
                                "de": "Er brachte eine <w>klägliche</w> Ausrede für seine Abwesenheit vor, die ihm niemand glaubte."
                            }
                        }
                    ],
                    "synonyms": [
                        "paltry",
                        "worthless",
                        "insignificant",
                        "trivial"
                    ],
                    "antonyms": [
                        "significant",
                        "valuable",
                        "substantial"
                    ],
                    "common_phrases": [
                        "wretched excuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный, скудный или не имеющий ценности; ничтожный, жалкий.",
                        "de": "Von unbedeutender, minderwertiger oder unzureichender Beschaffenheit; kläglich, dürftig oder wertlos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "ничтожный по качеству или количеству"
                            },
                            {
                                "target_lang_word": "ничтожный",
                                "target_lang_sense_clarification": "не имеющий никакой ценности"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "неубедительный (об оправдании)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kläglich",
                                "target_lang_sense_clarification": "völlig unzureichend oder peinlich schwach"
                            },
                            {
                                "target_lang_word": "armselig",
                                "target_lang_sense_clarification": "dürftig und unbedeutend"
                            },
                            {
                                "target_lang_word": "erbärmlich",
                                "target_lang_sense_clarification": "von extrem schlechter oder minderwertiger Qualität"
                            },
                            {
                                "target_lang_word": "wertlos",
                                "target_lang_sense_clarification": "ohne jeden Wert oder Nutzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}