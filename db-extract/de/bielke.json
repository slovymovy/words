                ],
                "senses": [
                    {
                        "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                        "entry_id": "dd3e3b6f-1b96-3c67-8656-b6dec74ed3a8",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5527242-2054-4e1a-9830-68e61c397fd0",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Frau Bielke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0a900bbe-3d41-4108-b024-f2cc12b11586",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Herr Bielke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7a30db0a-c0fc-4946-88cc-ebd605e5e27e",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Die Bielkes fliegen heute nach Omsk."
                            },
                            {
                                "example_id": "7888dbcf-a1f2-4adf-8d93-192ccab4aa10",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Der Bielke trägt nie die Pullover, die die Bielke ihm strickt."
                            },
                            {
                                "example_id": "5219463d-b8f0-404c-849b-20b5d89d9df6",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bielke kommt, geht der Herr Bielke.“"
                            },
                            {
                                "example_id": "95ea7a95-0a28-40b1-8dbe-2844176141a7",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Bielke kommt und geht."
                            },
                            {
                                "example_id": "18fb8cbe-db19-4c30-8741-f6db6ba0ef45",
                                "sense_id": "bc3d8f1b-8e6d-36e6-aa8a-056ac7e6014a",
                                "text": "Bielkes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
