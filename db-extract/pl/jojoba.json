                                        "sense_id": "20e6d299-6b6f-3f89-94a0-0f65008b8b5c",
                                        "entry_id": "0b7c7e30-e40f-3fd4-a0f4-2992724bcf95",
                                        "glosses": [
                                            "Any of species Simmondsia chinensis of shrubs native to the southwestern United States and to Mexico, the only plant known to store liquid wax in its seed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a3425c9-cf2a-470b-b1c3-ef4468ff5310",
                                                "sense_id": "20e6d299-6b6f-3f89-94a0-0f65008b8b5c",
                                                "text": "The ground was bad – rocky and hard. That was why we used it for jojoba plants. The plants are tough. They donʼt need much."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1acf2d7-e229-4d58-85ed-e689577ba34a",
                        "source_entry_id": "e5676954-af4f-39a9-a3ca-8bf51d7732eb",
                        "source_sense_id": "75226864-480e-3142-a100-299ee8357328",
                        "target_lang_word": "jojoba",
