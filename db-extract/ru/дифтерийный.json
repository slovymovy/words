                ],
                "senses": [
                    {
                        "sense_id": "de137f5c-d1fd-3e8f-9914-c8a52108291b",
                        "entry_id": "e6c638e9-f91d-3315-a863-563ab1987f06",
                        "glosses": [
                            "мед. связанный, соотносящийся по значению с существительным дифтерия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa6a0bf-4fd7-4911-b106-f95c665e06e9",
                                "sense_id": "de137f5c-d1fd-3e8f-9914-c8a52108291b",
                                "text": "Дифтерийный токсин — сложное белковое соединение. Под действием формалина оно необратимо изменяется и на пятые сутки уже почти не ядовито для человека."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7f31e76-2fe7-3561-bbf5-6eb335aef24e",
                        "entry_id": "e6c638e9-f91d-3315-a863-563ab1987f06",
                        "glosses": [
                            "мед. вызываемый дифтерией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fce028-97ba-4ed1-a06c-0f7d7b456310",
                                "sense_id": "c7f31e76-2fe7-3561-bbf5-6eb335aef24e",
                                "text": "Но тяжёлый характер дифтерийный нефрит приобретает редко; обыкновенно же он проходит без последствий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c104c01-215d-4817-b5e5-7304d0ac8f7b",
                        "source_entry_id": "e6c638e9-f91d-3315-a863-563ab1987f06",
                        "target_lang_word": "diphtheria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diphtheria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99dc2ff1-58a7-3ee7-aad0-5b79f3a8d8c4",
                                        "entry_id": "b55a5519-887e-384c-8524-58d00117f1c7",
                                        "glosses": [
                                            "A serious infectious disease leading to inflammation of mucous membranes of the upper respiratory tract, caused by Corynebacterium diphtheriae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22d0380-1a57-4d12-b3cc-d85e5e339d68",
                                                "sense_id": "99dc2ff1-58a7-3ee7-aad0-5b79f3a8d8c4",
                                                "text": "Today diphtheria has become so rare — just five cases in the United States in the most recent decade measured — that many doctors would struggle to recognize it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
