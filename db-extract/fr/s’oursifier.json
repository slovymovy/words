                "senses": [
                    {
                        "sense_id": "d614f615-b20f-39ea-9dde-f4fc4436db97",
                        "entry_id": "592d4ef2-9749-3112-9911-32ed8f6879a4",
                        "glosses": [
                            "Prendre un caractère d’ours, s’isoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3873756-22e6-4ef7-996b-7a1b6a0f1014",
                                "sense_id": "d614f615-b20f-39ea-9dde-f4fc4436db97",
                                "text": "Vraiment pas envie de m’oursifier moi décidément."
                            },
                            {
                                "example_id": "2273dc89-4149-4de8-bcbd-af4a6d8c0eed",
                                "sense_id": "d614f615-b20f-39ea-9dde-f4fc4436db97",
                                "text": "Je m’oursifie et m'assombris de plus en plus — et ce qui se passe dans la capitale n'est pas fait pour m’égayer."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b0ad540-0e2f-3e19-903a-202433ea87c6",
                        "entry_id": "592d4ef2-9749-3112-9911-32ed8f6879a4",
                        "glosses": [
                            "Hiberner comme un ours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c660be1-30b1-47a0-9ee6-b84c893aba8c",
                                "sense_id": "3b0ad540-0e2f-3e19-903a-202433ea87c6",
                                "text": "Pour passer le printemps sans rien faire, il suffit de s’oursifier."
                            }
                        ]
                    }
