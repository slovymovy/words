                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indefinite_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The story contains <w>somewhat</w> of a mystery regarding the lost family heirlooms.",
                            "target_lang_translations": {
                                "ru": "В этой истории есть <w>некоторая доля</w> тайны, касающейся утерянных семейных реликвий.",
                                "zh": "关于丢失的传家宝，这个故事里带着<w>一点</w>神秘色彩。"
                            }
                        },
                        {
                            "text": "He recovered <w>somewhat</w> of his former strength after a long period of rest.",
                            "target_lang_translations": {
                                "ru": "После длительного отдыха он восстановил <w>часть</w> своей прежней силы.",
                                "zh": "经过长时间的休息，他恢复了<w>部分</w>往日的体力。"
                            }
                        }
                    ],
                    "synonyms": [
