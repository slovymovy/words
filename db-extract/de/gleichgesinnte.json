                    {
                        "sense_id": "80f3e33f-f020-3289-84cb-13868fc6f85d",
                        "entry_id": "42749e26-5f38-3551-a23a-645dccedf78c",
                        "glosses": [
                            "weibliche Person, die die gleichen Ansichten/Einstellungen hat wie man selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289c8129-f8e1-44c3-991d-0d9dcfaf7c06",
                                "sense_id": "80f3e33f-f020-3289-84cb-13868fc6f85d",
                                "text": "„Dieser Blick, dazu das entspannende, einem Seufzer ähnliche Ausatmen, verführte mich zu glauben, er habe mir die Erleichterung signalisieren wollen, die ihm der Anblick einer Gleichgesinnten, als die er mich endlich ansah, bereitete.“"
                            }
                        ],
