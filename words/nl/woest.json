                {
                    "sense_id": "3fb73e74-9766-3bc0-bad4-c626f1010cc3",
                    "sense_definition": "Wild, onverzorgd of onbeschaafd in uiterlijk of gedrag.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wildness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met zijn lange haren en baard zag de man er nogal <w>woest</w> uit.",
                            "target_lang_translations": {
                                "en": "With his long hair and beard, the man looked rather <w>wild</w>.",
                                "ru": "С длинными волосами и бородой мужчина выглядел довольно <w>дико</w>.",
                                "fr": "Avec ses longs cheveux et sa barbe, l'homme avait l'air plutôt <w>sauvage</w>."
                            }
                        },
                        {
                            "text": "De piraten leidden een <w>woest</w> en gevaarlijk leven op zee.",
