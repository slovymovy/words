{
    "word_family": [
        "permeate",
        "permeability",
        "permeable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cac52894-4b0a-31c3-bf9a-527e0b8d66c6",
                    "sense_definition": "Not allowing passage, especially of liquids; waterproof.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impermeability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>impermeable</w> layer of clay prevents water from soaking into the ground.",
                            "target_lang_translations": {
                                "ru": "<w>Непроницаемый</w> слой глины препятствует просачиванию воды в почву."
                            }
                        },
                        {
                            "text": "He wore an <w>impermeable</w> raincoat to stay dry during the heavy storm.",
                            "target_lang_translations": {
                                "ru": "Он надел <w>непромокаемый</w> плащ, чтобы остаться сухим во время сильного ливня."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonpermeable",
                        "sealed"
                    ],
                    "antonyms": [
                        "permeable"
                    ],
                    "common_phrases": [
                        "impermeable layer",
                        "impermeable surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не пропускающий через себя что-либо, особенно жидкости; водонепроницаемый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непроницаемый",
                                "target_lang_sense_clarification": "общий термин для материалов, не пропускающих жидкости или газы"
                            },
                            {
                                "target_lang_word": "непромокаемый",
                                "target_lang_sense_clarification": "специально о материалах или одежде, не пропускающих воду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6624913-5fed-35ea-aff0-6574fde1765b",
                    "sense_definition": "Impossible to permeate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impermeability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fortress was built with <w>impermeable</w> walls that no enemy could breach.",
                            "target_lang_translations": {
                                "ru": "Крепость была построена с <w>непроницаемыми</w> стенами, которые не мог преодолеть ни один враг."
                            }
                        },
                        {
                            "text": "The scientist created an <w>impermeable</w> barrier to contain the hazardous chemical spill.",
                            "target_lang_translations": {
                                "ru": "Ученый создал <w>непроницаемый</w> барьер, чтобы локализовать разлив опасных химикатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "sealed"
                    ],
                    "antonyms": [
                        "permeable"
                    ],
                    "common_phrases": [
                        "impermeable barrier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, через который невозможно проникнуть или пройти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непроницаемый",
                                "target_lang_sense_clarification": "недоступный для проникновения, в том числе в переносном смысле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}