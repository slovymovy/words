                                    {
                                        "sense_id": "9f840036-db9c-3211-aec6-1b6ce76fa8f7",
                                        "entry_id": "56201d09-ce2c-33ed-8e72-166e69035464",
                                        "glosses": [
                                            "Wissenschaftlerin, die auf dem Gebiet der Sinologie tätig ist, sich also mit der chinesischen Sprache, Schrift, Literatur und Kultur befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff714d0-6b0d-472e-8583-1b58416eba15",
                                                "sense_id": "9f840036-db9c-3211-aec6-1b6ce76fa8f7",
                                                "text": "1995 schrieb die englische Sinologin Frances Wood über die spannende Frage, ob Marco Polo selbst überhaupt jemals in China war oder nicht."
