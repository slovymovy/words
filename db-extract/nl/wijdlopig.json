                                "target_senses": [
                                    {
                                        "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                        "entry_id": "8c25a616-9927-3a9e-814b-6eca19e894f8",
                                        "glosses": [
                                            "Having length; long and overextended, especially in time rather than dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d917de8f-c67c-43e8-a7d9-ac05fe39142e",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "a lengthy discussion"
                                            },
                                            {
                                                "example_id": "a44c8ce3-d16a-42f7-a4c5-07643b7408da",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "a laborious and lengthy process"
                                            },
                                            {
                                                "example_id": "ad6afda3-f7b3-4e3f-8e03-41ac855d737a",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "She died last night after a lengthy illness."
                                            },
                                            {
                                                "example_id": "18aa96a2-d347-4b66-a52b-e0cf4da2bae4",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "They received lengthy prison terms."
                                            },
                                            {
                                                "example_id": "70dde809-f021-42e6-bd9b-322c378020b0",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "a lengthy text"
                                            },
                                            {
                                                "example_id": "a8455b5d-5752-4efd-a652-2cc26a251c90",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "They traced the ancient lineages of two species to reveal the insects' lengthy history of asexual reproduction."
                                            },
                                            {
                                                "example_id": "4d1d7f99-33cd-45ae-b3e3-0ef36c9daf25",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "“In light of the current state of our country, I struggled to find the right words of wisdom for you today,” Obama says in her lengthiest public remarks to date about the protests taking place in the wake of the killing of George Floyd."
                                            },
                                            {
                                                "example_id": "d1fa5522-3a1e-4f37-8abd-9af155d42a66",
                                                "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                                                "text": "Without the help of the IEEPA, the Trump administration would have to take a slower approach, launching lengthier trade investigations and abiding by other trade laws to back the tariff threats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36dd13d1-c3fe-3768-8ce5-d0f49f5a31e6",
                                        "entry_id": "8c25a616-9927-3a9e-814b-6eca19e894f8",
                                        "glosses": [
                                            "Speaking or writing at length; long-winded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39478047-a795-4aa1-a10a-ee1cef4708d8",
                                                "sense_id": "36dd13d1-c3fe-3768-8ce5-d0f49f5a31e6",
                                                "text": "If, in addition to being a lengthy preacher, he had also been a Rev. Mr. Mumbles or a Rev. Dr. Drone, the penance thus endured by his people would have been intolerably severe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d385f2b-ae9b-423a-97cb-aee38ea8ee70",
                        "source_entry_id": "ff38cdb3-886c-3cf4-9341-c9af11ffe37f",
                        "source_sense_id": "533f75f7-76e0-34f9-8e94-4a8fbaf34c40",
                        "target_lang_word": "long-winded",
