                        "glosses": [
                            "Characterised or marked by glee; gleeful; joyous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42334307-31cc-49b7-a315-f16109874b2d",
                                "sense_id": "6675d174-7435-30e5-9ff8-d38222125d6c",
                                "text": "So long as the men kept sober, Jervis rather liked this, and was never better pleased than when, on the last evening of the week, he heard the voices of the men raised in song, or the squeaking of the merry fiddle and gleesome flute."
                            },
                            {
                                "example_id": "65fdc7bb-740b-4bce-a3d9-6f537c8ab065",
                                "sense_id": "6675d174-7435-30e5-9ff8-d38222125d6c",
                                "text": "\"And wasn't it just jolly!\" gloated a juvenile gleesome voice in a loud whisper."
                            },
                            {
                                "example_id": "f1012793-9d37-4668-bbc8-3ba82843d5f5",
                                "sense_id": "6675d174-7435-30e5-9ff8-d38222125d6c",
                                "text": "For the bird will sing gleesome dirges in your heart!\""
                            },
                            {
                                "example_id": "6eebba6d-0298-4e4c-a2b6-dc52d1248295",
                                "sense_id": "6675d174-7435-30e5-9ff8-d38222125d6c",
                                "text": "They were “gleesome as kittens, especially when off to a fight or a fire.”"
                            },
                            {
                                "example_id": "2920a435-1f9c-4b17-ab1e-dca35b2a584c",
                                "sense_id": "6675d174-7435-30e5-9ff8-d38222125d6c",
                                "text": "“So it was a right gleesome frolic he had that night?”"
                            }
                        ]
                    }
