                        "entry_id": "6551a2b5-2b23-3d19-a64e-ca4dfb19d4b6",
                        "glosses": [
                            "immigrierter Einwohner im antiken Griechenland ohne Bürgerrechte, der aber als freier Bürger gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4184732d-ca93-4d2a-86c2-306587e002eb",
                                "sense_id": "62d3c2e9-ea38-345d-82d5-4bc1c9fcb8d5",
                                "text": "„Da er aber als literarischer Metöke beim Ausbruch des Ersten Weltkrieges seine Loyalität besonders unter Beweis stellen mußte, geschah es ihm, daß er den kommunen Heldentod starb…“"
                            }
                        ],
