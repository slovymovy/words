                        "examples": [
                            {
                                "example_id": "5dc7adf8-ec32-4432-8a36-5e8073fe9fec",
                                "sense_id": "7b643e97-f394-3c10-abe3-f56a69b80ec1",
                                "text": "Het ministerie staat vandaag stil bij de eerste vrouwen die in dienst gingen. Dat waren de leden van het 75 jaar geleden opgerichte vrouwenkorps van het Koninklijk Nederlands-Indisch Leger (KNIL). Ze verrichtten ongewapend ondersteunende taken als transport, ziekenverpleging en werkten bij de militaire inlichtingendienst."
                            },
                            {
                                "example_id": "7639a7b2-c6f0-4931-b450-de6ce453afb4",
                                "sense_id": "7b643e97-f394-3c10-abe3-f56a69b80ec1",
                                "text": "De Vereeniging voor Ziekenverpleging, zoals het ziekenhuis tot voor enige jaren heette, is een particulier ziekenhuis. Voor de Tweede Wereldoorlog moesten de patienten de opname zelf betalen. Mede hierdoor kreeg het de naam een elite-ziekenhuis te zijn."
                            }
                        ]
                    }
