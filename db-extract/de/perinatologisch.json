                "senses": [
                    {
                        "sense_id": "2c9884c2-7851-3491-bed0-8a9b154a1c54",
                        "entry_id": "4d3f4a8d-9917-31e0-a09f-a7d5a283876c",
                        "glosses": [
                            "in Bezug auf die Perinatologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb02f81c-4207-499e-b74e-2eb2c18611d6",
                                "sense_id": "2c9884c2-7851-3491-bed0-8a9b154a1c54",
                                "text": "„Pränatale Beratung bei diagnostizierter lebensverkürzender oder -bedrohlicher Erkrankung sollte aus perinatologisch-palliativmedizinischer Sicht idealerweise interdisziplinär und multiprofessionell erfolgen.“"
                            },
                            {
                                "example_id": "bd0458e3-c8df-4728-9edc-2d6e6e74a037",
                                "sense_id": "2c9884c2-7851-3491-bed0-8a9b154a1c54",
                                "text": "„Die Geburt sollte in einer geburtshilflich, perinatologisch und anaesthesiologisch für Risikogeburten ausgerüsteten Klinik erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
