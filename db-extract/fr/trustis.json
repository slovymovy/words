                        "glosses": [
                            "Confiance, fidélité et assistance, dans l'histoire des Germains en Gaule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04583433-e6f0-4d45-aed4-e80d64ba9fd2",
                                "sense_id": "dc19fe2e-95ad-3b67-9f27-dd79ae43d7c1",
                                "text": "En Gaule mérovingienne, la trustis désigne la confiance et l'assistance qu'un Franc jurait au roi et la condition de celui qui a promis une telle assistance."
                            },
                            {
                                "example_id": "f800c5ae-6c44-42d7-a1e5-5fc06300c61e",
                                "sense_id": "dc19fe2e-95ad-3b67-9f27-dd79ae43d7c1",
                                "text": "La trustis et l'antrustion royal sous les deux premières races."
                            },
                            {
                                "example_id": "af615dbe-0a59-4a90-acdc-adc9bf597af2",
                                "sense_id": "dc19fe2e-95ad-3b67-9f27-dd79ae43d7c1",
                                "text": "En somme le mot trusti me paraît correspondre assez fidèlement à notre terme secours, pris, comme il arrive souvent, dans le sens d'assistance armée."
                            }
                        ]
                    }
