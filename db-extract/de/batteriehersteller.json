                        "examples": [
                            {
                                "example_id": "fe0d1e23-4ee7-44d8-b5e7-56bf781a1f4e",
                                "sense_id": "6e88b04e-f4eb-3fc0-9d0b-95c3f6ae7106",
                                "text": "„Nach einem vollständigen Ausstieg aus Öl, Gas und Kohle könnten europäische Batteriehersteller im Vergleich zu bisherigen Importen demnach sogar mehr als 60 Prozent weniger Kohlendioxid ausstoßen.“"
                            },
                            {
                                "example_id": "620a778a-07d0-4c01-9b4c-59649fd31698",
                                "sense_id": "6e88b04e-f4eb-3fc0-9d0b-95c3f6ae7106",
                                "text": "„Experten wie der Londoner Marktbeobachter Roger Atkins sehen unter den Newcomern durchaus Kandidaten mit Potenzial – so etwa den einstigen Batteriehersteller Lucid Motors.“"
                            }
