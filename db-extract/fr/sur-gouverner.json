                ],
                "senses": [
                    {
                        "sense_id": "dee36970-9dc1-38a0-a943-bcc6d4d0b0e9",
                        "entry_id": "7a79c15b-a3ed-3404-93ec-b5dd4ccb082e",
                        "glosses": [
                            "Gouverner de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6a50e0-3127-402b-97ff-4a340749fea9",
                                "sense_id": "dee36970-9dc1-38a0-a943-bcc6d4d0b0e9",
                                "text": "Je n'aime pas les gouvernements, je trouve qu'ils sur-gouvernent le peuple de nos jours."
                            },
                            {
                                "example_id": "f8ba351c-0fa3-4dff-a103-b474b7f89cf0",
                                "sense_id": "dee36970-9dc1-38a0-a943-bcc6d4d0b0e9",
                                "text": "Les frais d'administration seraient nettements réduits car, comme le note M. Goldenberg, la région est déjà sur-gouvernée."
                            },
                            {
                                "example_id": "c87412c9-75c8-492a-8996-1d57ac2081ad",
                                "sense_id": "dee36970-9dc1-38a0-a943-bcc6d4d0b0e9",
                                "text": "Montréal est donc, aujourd'hui, tout aussi inéquitable, sur-gouvernée et ingérable qu'elle l'était en 2001."
                            }
                        ]
                    }
                ],
