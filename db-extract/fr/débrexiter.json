                "senses": [
                    {
                        "sense_id": "56a33885-7415-3b17-aa57-0e79959d9b53",
                        "entry_id": "98a9831d-ecf3-3dc3-86ed-e9cc7b254221",
                        "glosses": [
                            "Faire annuler le Brexit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d6a86c-cebf-445f-a9bf-5b88e293587e",
                                "sense_id": "56a33885-7415-3b17-aa57-0e79959d9b53",
                                "text": "Quand la Chine veut « débrexiter » le Royaume Uni."
                            },
                            {
                                "example_id": "ecd23cec-dcb0-4eb2-8c7c-d89cf0675d3b",
                                "sense_id": "56a33885-7415-3b17-aa57-0e79959d9b53",
                                "text": "Allez, on va leur faire confiance pour nous trouver un truc de derrière les fagots pour débrexiter de report en report."
                            }
                        ]
                    },
                    {
                        "sense_id": "9460cf15-92b5-33f2-9cd5-6d19c93155c5",
                        "entry_id": "98a9831d-ecf3-3dc3-86ed-e9cc7b254221",
                        "glosses": [
                            "Se débarrasser du lien avec le Brexit."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "e3116bde-bdf9-4b6d-aa07-2cd3124e46c9",
                                "sense_id": "9460cf15-92b5-33f2-9cd5-6d19c93155c5",
                                "text": "Si les médias britanniques y voient le choix d’un nom à sonorité anglaise pour la « préparation au post-Brexit », Eurotunnel nous précise que « le Brexit n’est pas vraiment une raison, mais il est vrai que ce nouveau nom Corporate peut auprès des investisseurs nous aider à se débrexiter »."
                            }
                        ]
                    }
