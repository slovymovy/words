                "senses": [
                    {
                        "sense_id": "eb9390ca-2f53-37c3-921c-3cae0371d13d",
                        "entry_id": "b498ba46-6a0f-3fd7-a3f9-e9dc962b39aa",
                        "glosses": [
                            "истор. мера длины, равная около 4,445 см"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83432fb5-f8d3-456f-85e3-db71025692b7",
                                "sense_id": "eb9390ca-2f53-37c3-921c-3cae0371d13d",
                                "text": "… она была прострелена на вершок ото лба"
                            }
                        ]
                    },
                    {
                        "sense_id": "4b155ccd-80cc-37e5-8b47-89e33e23f8d9",
                        "entry_id": "b498ba46-6a0f-3fd7-a3f9-e9dc962b39aa",
                        "glosses": [
                            "истор. единица измерения роста сверх двух аршин"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279ebcfa-0f75-41a5-9e6c-6336b74c2470",
                                "sense_id": "4b155ccd-80cc-37e5-8b47-89e33e23f8d9",
                                "text": "Из числа всей ее челяди самым замечательным лицом был дворник Герасим, мужчина двенадцати вершков роста, сложенный богатырём и глухонемой от рожденья."
                            }
                        ]
                    }
                ],
