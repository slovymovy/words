                                    },
                                    {
                                        "sense_id": "7450850f-0c98-3a14-b769-c91433bf6138",
                                        "entry_id": "b90daf5b-8c20-3d99-8e61-79eff78de0cc",
                                        "glosses": [
                                            "Someone who seeks attention through inappropriate means or to an excessive degree."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "often",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "657fcc81-af57-4358-b04c-918de993a8b7",
                                                "sense_id": "7450850f-0c98-3a14-b769-c91433bf6138",
                                                "text": "a press slut"
                                            },
                                            {
                                                "example_id": "7d3677dd-09b5-4ca0-9495-56791ae0f5ec",
                                                "sense_id": "7450850f-0c98-3a14-b769-c91433bf6138",
                                                "text": "Dude: Since when did you become a political whore?\nPhil: I prefer the term political slut, thank you very much!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "672b1adc-8588-3d0c-8ec7-73fcce53b2b3",
                                        "entry_id": "b90daf5b-8c20-3d99-8e61-79eff78de0cc",
                                        "glosses": [
                                            "A disloyal individual; someone who does not commit to a particular thing."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "often",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a825389-88b8-43bb-87b9-149eb8fbdf9e",
                                                "sense_id": "672b1adc-8588-3d0c-8ec7-73fcce53b2b3",
                                                "text": "That guy was a job slut; he changed jobs way too often and quickly, to the point that employers will no longer hire him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fad67b8d-fe4e-3ec6-8990-83944a048bee",
                                        "entry_id": "b90daf5b-8c20-3d99-8e61-79eff78de0cc",
                                        "glosses": [
                                            "A slovenly, untidy person, usually a woman."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f316ad71-e0c1-4f99-b75f-8143ba2456ec",
                                                "sense_id": "fad67b8d-fe4e-3ec6-8990-83944a048bee",
                                                "text": "Clo. Truly, and to cast away honestie vppon a foule slut, were to put good meate into an vncleane dish. / Aud. I am not a slut, though I thanke the Goddes I am foule."
                                            },
                                            {
                                                "example_id": "df67fb1c-3e73-4166-99bb-6bc11594f16e",
                                                "sense_id": "fad67b8d-fe4e-3ec6-8990-83944a048bee",
                                                "text": "Where fires thou find’st unrak’d, and hearths unswept, / There pinch the Maids as blew as Bill-berry, / Our radiant Queene, hates Sluts, and Sluttery."
                                            },
                                            {
                                                "example_id": "fb0e1e45-6095-465d-b5f6-42943cacbd88",
                                                "sense_id": "fad67b8d-fe4e-3ec6-8990-83944a048bee",
                                                "text": "The doat on Dowdyes, and Deformity:\nE'en what they cannot praise, they will not blame,\nBut veil with some extenuating name:\nThe Sallow Skin is for the Swarthy put,\nAnd love can make a Slattern of a Slut …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71165ad5-01ea-39a5-baaa-61df2067ae50",
                                        "entry_id": "b90daf5b-8c20-3d99-8e61-79eff78de0cc",
                                        "glosses": [
                                            "A bold, outspoken woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3803a4c-5d85-43fd-b7f9-0c633079e361",
                                                "sense_id": "71165ad5-01ea-39a5-baaa-61df2067ae50",
                                                "text": "Our Polly is a sad Slut! nor heeds what we have taught her."
                                            },
                                            {
                                                "example_id": "2c815bd9-5a8f-4a5d-8d68-fee2bdd7ac27",
                                                "sense_id": "71165ad5-01ea-39a5-baaa-61df2067ae50",
                                                "text": "To hear her rant, one would have supposed, who had not seen him, that her lank-haired, grimly partner was the prettiest youth in the county of Dublin, and that all the comely lasses in Chapelizod and the country round were sighing and setting caps at him; and Devereux, who had a vein of satire, and loved even farce, enjoyed the heroics of the fat old slut."
                                            },
                                            {
                                                "example_id": "901f545e-6668-47b6-baab-4aab54115ce5",
                                                "sense_id": "71165ad5-01ea-39a5-baaa-61df2067ae50",
                                                "text": "You damned impudent slut, you! But it's better than snivelling; better than fetching slippers and finding spectacles, isnt it? [Rising] By George, Eliza, I said I'd make a woman of you; and I have. I like you like this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2df2c24e-e808-3410-88db-483174ea70ec",
                                        "entry_id": "b90daf5b-8c20-3d99-8e61-79eff78de0cc",
                                        "glosses": [
                                            "A female dog."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b80dca46-b2c3-44fe-8840-b0d79388e296",
                                                "sense_id": "2df2c24e-e808-3410-88db-483174ea70ec",
                                                "text": "‘Bête!’ returned the angry Frenchman, bestowing a savage kick on one of the unoffending pups which was frisking about his feet. The pup yelped; the slut barked and leaped furiously at the offender, and was only kept from biting him by Sam, who could scarcely hold her back for laughing; the captain was uproarious; the offended Frenchman alone maintained a severe and dignified aspect."
                                            },
                                            {
                                                "example_id": "2d4ef704-dd41-48d8-9397-b9a36fffb7ab",
                                                "sense_id": "2df2c24e-e808-3410-88db-483174ea70ec",
                                                "text": "He sent me to an old bark hut, / Inhabited by a greyhound slut, / Who put her fangs through my poor fut, / And, snarling, off she ran."
                                            },
                                            {
                                                "example_id": "44f0cd37-a4c2-4a07-a1ec-970106631bb6",
                                                "sense_id": "2df2c24e-e808-3410-88db-483174ea70ec",
                                                "text": "‘Like a slut and all the dogs mounting her.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f9e1be-4fc1-30cb-9909-075f5c32f7f5",
                                        "entry_id": "b90daf5b-8c20-3d99-8e61-79eff78de0cc",
                                        "glosses": [
                                            "A maidservant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85328ac4-01d2-46cf-ade6-78b586dc2edf",
                                                "sense_id": "46f9e1be-4fc1-30cb-9909-075f5c32f7f5",
                                                "text": "Our little girl Susan is a most admirable slut, and pleases us mightily, doing more service than both the others and deserves wages better."
                                            }
