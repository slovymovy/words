                "senses": [
                    {
                        "sense_id": "e15f09a7-8126-3bae-a45f-4c722bda875a",
                        "entry_id": "be1a547f-25a6-35f5-95a9-ce3a41ea83b2",
                        "glosses": [
                            "Gradeinheit auf der Temperaturskala nach Daniel Gabriel Fahrenheit"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "582e5ee7-61f6-4b68-90a3-87d9a7fe30bc",
                                "sense_id": "e15f09a7-8126-3bae-a45f-4c722bda875a",
                                "text": "100 Grad auf der Celsius-Skala entsprechen 212 Grad Fahrenheit."
                            },
                            {
                                "example_id": "eeb20622-a1db-4967-b6e8-731e4ec3a01c",
                                "sense_id": "e15f09a7-8126-3bae-a45f-4c722bda875a",
                                "text": "Vor allem in den vereinigten Staaten von Amerika werden Temperaturen in Fahrenheit gemessen."
                            },
                            {
                                "example_id": "4b585cf8-079f-4b8d-8ce9-700485931e45",
                                "sense_id": "e15f09a7-8126-3bae-a45f-4c722bda875a",
                                "text": "Der Flammpunkt von Papier liegt bei 451 Grad Fahrenheit."
                            },
                            {
                                "example_id": "1e87c2df-92d3-4930-97cb-5699312b5292",
                                "sense_id": "e15f09a7-8126-3bae-a45f-4c722bda875a",
                                "text": "„Auch in Washington herrschte bei 16 Grad Fahrenheit klare, klirrende Kälte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a16a1d36-bf96-4b05-8666-cb46748f76c4",
                        "source_entry_id": "be1a547f-25a6-35f5-95a9-ce3a41ea83b2",
                        "source_sense_id": "e15f09a7-8126-3bae-a45f-4c722bda875a",
                        "source_sense_description": "Physik: Gradeinheit auf der Temperaturskala nach Daniel Gabriel Fahrenheit",
                        "target_lang_word": "Fahrenheit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrenheit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0af2d9d4-1f9b-3e75-88a4-201feef6d32c",
                                        "entry_id": "503f17d5-6e2a-3e9d-8c0a-57cc39a2bd33",
                                        "glosses": [
                                            "Describing a temperature scale originally defined as having 0°F as the lowest temperature obtainable with a mixture of ice and salt, and 96°F as the temperature of the human body, and now defined with 32°F equal to 0°C, and each degree Fahrenheit equal to 5/9 of a degree Celsius or 5/9 kelvin."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3f948d7-9373-4243-9727-175d8d04695a",
                                                "sense_id": "0af2d9d4-1f9b-3e75-88a4-201feef6d32c",
                                                "text": "Pyeongchang sits nearly half a mile above sea level in the northeastern corner of South Korea, not too far from the border with the North. It is one of the coldest parts of the country — wind chill in February is often in single digits (Fahrenheit) — and notorious for a powerful, biting wind that gathers force as it barrels down out of Siberia and the Manchurian Plain and then across the jagged granite peaks of North Korea."
                                            },
                                            {
                                                "example_id": "fa89d4e7-1022-4e14-83c7-fb30ade41873",
                                                "sense_id": "0af2d9d4-1f9b-3e75-88a4-201feef6d32c",
                                                "text": "For example, in the Fahrenheit scale 212°F is the boiling point of water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
