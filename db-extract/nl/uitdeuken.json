                                        "entry_id": "05fbd0d5-b081-3b0b-aa78-8baa92814e1f",
                                        "glosses": [
                                            "To make something flat or flatter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2067fa-a8ee-490a-a14c-cb903354659d",
                                                "sense_id": "a0c05402-c816-365c-b86e-3ba4e53b6847",
                                                "text": "As there was a lot of damage, we chose the heavy roller to flatten the pitch."
                                            },
                                            {
                                                "example_id": "5bd74b13-fd0d-43f8-bdf1-8197a2a224d9",
                                                "sense_id": "a0c05402-c816-365c-b86e-3ba4e53b6847",
                                                "text": "Mary would flatten the dough before rolling it into pretzels."
                                            },
                                            {
                                                "example_id": "9c95d6a3-7162-47f6-b9c1-c7ac8fb38ee8",
                                                "sense_id": "a0c05402-c816-365c-b86e-3ba4e53b6847",
                                                "text": "Attempting to block the police van's path, protesters periodically surrounded the vehicle and eventually flattened one of its tires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b3fff4-c653-3a57-885b-60a8bd46a9c8",
                                        "entry_id": "05fbd0d5-b081-3b0b-aa78-8baa92814e1f",
                                        "glosses": [
                                            "To press one's body tightly against a surface, such as a wall or floor, especially in order to avoid being seen or harmed."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd99cbee-fb82-4337-9e4d-80ab38f3a933",
                                                "sense_id": "52b3fff4-c653-3a57-885b-60a8bd46a9c8",
                                                "text": "With a bolt of fright he remembered that there was no bathroom in the Hob-house Room. He leapt along the corridor in a panic, stopping by the long-case clock at the end where he flattened himself against the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddec9cd6-3506-377b-b566-89ee818da596",
                                        "entry_id": "05fbd0d5-b081-3b0b-aa78-8baa92814e1f",
                                        "glosses": [
                                            "To knock down or lay low."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6abdf1-ede3-4168-8110-f226ba1b1d4d",
                                                "sense_id": "ddec9cd6-3506-377b-b566-89ee818da596",
                                                "text": "The prize fighter quickly flattened his challenger."
