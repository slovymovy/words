                                                "sense_id": "c047e304-cdbf-30c4-95e3-3c47870f56d7",
                                                "text": "Ignition coils using a bobbin molded from high-performance polyester withstand open-circuit bench tests to 70kV."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1220bfd7-afac-351a-8acf-4742435a3041",
                                        "entry_id": "6d9cae83-3d19-38ac-8e99-9716af7c9a52",
                                        "glosses": [
                                            "In a sewing machine, the small spool that holds the lower thread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa5b9dd-7e54-4c99-b4f1-4e8c072df36b",
                                                "sense_id": "1220bfd7-afac-351a-8acf-4742435a3041",
                                                "text": "Wind the bobbin, place it in the machine, and raise the thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f209ed5f-e49e-3c12-9388-cf5bf62fdae4",
                                        "entry_id": "6d9cae83-3d19-38ac-8e99-9716af7c9a52",
                                        "glosses": [
                                            "The little rounded piece of wood at the end of a latch string, which is pulled to raise the latch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b18ec0-b213-4556-9914-3dc80b5dbe86",
                                                "sense_id": "f209ed5f-e49e-3c12-9388-cf5bf62fdae4",
                                                "text": "She went from the linhay and boldly pulled the bobbin of the fuel-house door."
                                            },
                                            {
                                                "example_id": "a795d1f9-78af-4d1b-b64c-86450f472467",
                                                "sense_id": "f209ed5f-e49e-3c12-9388-cf5bf62fdae4",
                                                "text": "Put the bobbin and the latch will go up"
                                            }
                                        ]
