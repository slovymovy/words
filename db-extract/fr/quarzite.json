                        ],
                        "examples": [
                            {
                                "example_id": "be612466-9275-4456-baec-4ce6e7f09098",
                                "sense_id": "d3629b1b-61a0-3a3e-bde5-f15a0ff6f579",
                                "text": "A mesure qu'on s'élève dans le système, le quarzite qui alterne avec ces roches devient plus noirâtre, pyritifère, schistoïde et pailleté."
                            },
                            {
                                "example_id": "ea562ed8-9f1f-4a15-b45b-0d2298f6ca7e",
                                "sense_id": "d3629b1b-61a0-3a3e-bde5-f15a0ff6f579",
                                "text": "La zone des quarzites de Givonne, qui constitue à elle seule le massif de Givonne, forme une bande qui s'étend de Rumel, hameau de Gernelle, jusqu'à Muno."
                            },
                            {
                                "example_id": "e18680b3-5ac1-4bc3-b4fd-816da32ac681",
                                "sense_id": "d3629b1b-61a0-3a3e-bde5-f15a0ff6f579",
                                "text": "En effet la surface des quarzites visible en regard des schistes présentent des traces de frottement en cannelures, qui semblent la résultante d'une friction énergique sur une surface à l'état de pâte molle."
                            }
                        ]
                    }
