                                "example_id": "4a4c3a77-9210-46d9-af67-2648eb3cb2b1",
                                "sense_id": "927b7d5f-7db4-3d5f-a685-d2149e3bbefd",
                                "text": "„Ähnlich äußerte sich später auch Israels Polizeiminister Jitzhak Bar Lev.“"
                            }
