                "senses": [
                    {
                        "sense_id": "c27dbc4f-58b0-3d83-b75f-6644f490e425",
                        "entry_id": "4a0be41e-bfeb-3283-8a8a-d0b56b3b325b",
                        "glosses": [
                            "langes, niedriges Möbelstück, in dem unter anderem Gegenstände aufbewahrt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e701859e-ad86-4a17-a5df-339607870cd0",
                                "sense_id": "c27dbc4f-58b0-3d83-b75f-6644f490e425",
                                "text": "Auf dem Sideboard im Wohnzimmer steht der 40-Zoll-Fernseher."
                            },
                            {
                                "example_id": "d46b9fe9-9ff0-4ddd-b631-8f51eaad8d50",
                                "sense_id": "c27dbc4f-58b0-3d83-b75f-6644f490e425",
                                "text": "„Als er dieses Lieblingsgeschäft eines echten Hinterwäldlers abgetan, war er zum Sideboard getreten, um sich ein Glas zu füllen.“"
                            },
                            {
                                "example_id": "c7e7f2d1-a3de-43d5-aafd-14cc0d4ac1c1",
                                "sense_id": "c27dbc4f-58b0-3d83-b75f-6644f490e425",
                                "text": "„Er ging zum Sideboard und rief an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
