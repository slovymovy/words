                        "target_lang_word": "city center",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "city center",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58589de5-7b1c-3ca4-a70a-e6fdb16ced7a",
                                        "entry_id": "8c4ab465-4e08-3032-aebf-69c806257bda",
                                        "glosses": [
                                            "The central business and shopping area of a city."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d434f9d-764c-4a9b-bc37-b11d8106a758",
                                                "sense_id": "58589de5-7b1c-3ca4-a70a-e6fdb16ced7a",
                                                "text": "In an effort to tackle mounting greenhouse gas emissions, the city of Hamburg, Germany, has decided to ban all cars from the city center by 2034."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352ce588-f4ca-4411-945b-a9550ddafec1",
                        "source_entry_id": "a99c4d99-2325-3622-852b-1f471a3d4c72",
                        "source_sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                        "source_sense_description": "zentral gelegener Teil einer Stadt",
                        "target_lang_word": "centre-ville",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centre-ville",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30328653-3fb3-3e58-a5d6-aa0242ff1f48",
                                        "entry_id": "3f36480e-2970-3702-b2cd-2c733e4a64bf",
                                        "glosses": [
                                            "Centre d’une ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2087baef-d8a8-4c55-8331-ace43bd576db",
                                                "sense_id": "30328653-3fb3-3e58-a5d6-aa0242ff1f48",
                                                "text": "La commune de NIVOLAS-VERMELLE a été saisie de la demande de délocalisation d’une entreprise nivolésienne du fait de l’impossibilité d’agrandir l’usine actuelle située en centre-ville."
                                            },
                                            {
                                                "example_id": "355f9180-8545-4c71-b6c8-68b4b0048390",
                                                "sense_id": "30328653-3fb3-3e58-a5d6-aa0242ff1f48",
                                                "text": "Dans le centre-ville, elle est heureuse comme un poisson dans l'eau. Elle a son petit atelier, un beau salon, une chambre et une minuscule cuisine qui lui suffit pour elle toute seule. En plus,elle est à deux pas du théâtre et de tous les cinémas."
                                            },
