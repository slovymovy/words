                "forms": [],
                "senses": [
                    {
                        "sense_id": "80d20034-6bdb-353d-ba78-2cc1aa58bc91",
                        "entry_id": "dd624a8e-1d85-3e48-8db1-d4cc04956838",
                        "glosses": [
                            "what, wot (replacing the nominative singular or accusative singular form of the interrogative pronoun что (što))"
                        ],
                        "tags": [
                            "colloquial",
                            "nonstandard",
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "a4ddf416-5b55-4337-a08c-1e2e2dafd4ea",
                                "sense_id": "80d20034-6bdb-353d-ba78-2cc1aa58bc91",
                                "text": "Спроси́ у неё, чё ей на́до.",
                                "translation": "Ask her what she wants.",
                                "english": "Ask her what she wants."
                            },
                            {
                                "example_id": "65d400ca-6295-4038-8335-8c88e9b8a2f3",
                                "sense_id": "80d20034-6bdb-353d-ba78-2cc1aa58bc91",
                                "text": "Ну чё, пойдём?",
                                "translation": "Well (so what), let's go?",
                                "english": "Well (so what), let's go?"
                            },
                            {
                                "example_id": "5f2a331f-3508-4f38-8bf9-c9e9af2acbcb",
                                "sense_id": "80d20034-6bdb-353d-ba78-2cc1aa58bc91",
                                "text": "Чё, серьёзно?",
                                "translation": "What, seriously?",
                                "english": "What, seriously?"
                            }
                        ]
                    }
                ],
