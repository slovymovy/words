        "de-extract.jsonl": [
            {
                "entry_id": "bd8e86e5-a14f-3fcd-af7e-5eafff1d465e",
                "word": "andernorts",
                "pos": "adv",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "941f4af5-ffe2-452f-bcf0-bea113ae90a4",
                        "entry_id": "bd8e86e5-a14f-3fcd-af7e-5eafff1d465e",
                        "tags": [
