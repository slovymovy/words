                "senses": [
                    {
                        "sense_id": "03a2d9b9-1eb5-3a8e-ac49-71518723acae",
                        "entry_id": "e0c7e34f-301e-371a-94d1-89350ee96659",
                        "glosses": [
                            "A channel where water flows during floods, especially one that is carved out by erosion caused by floodwater."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b976f989-5cf2-42d3-8ec4-62105d919aff",
                                "sense_id": "03a2d9b9-1eb5-3a8e-ac49-71518723acae",
                                "text": "[…] justifies a conclusion, that by the farther contraction of the descending waters over the washway, the navigation and drainage through the Wisbeach river, will be farther improved."
                            },
                            {
                                "example_id": "bee35570-a729-401c-b738-fcafab61bd09",
                                "sense_id": "03a2d9b9-1eb5-3a8e-ac49-71518723acae",
                                "text": "[…] these frontagers were obliged to leave a washway of half-a-mile wide on the west side of the river, so as not to impede the drainage of the country; […]"
                            },
                            {
                                "example_id": "056706b6-a864-46eb-8965-1f93a40fabfd",
                                "sense_id": "03a2d9b9-1eb5-3a8e-ac49-71518723acae",
                                "text": "Gradually, a narrow, tree-lined stream may be converted into a broad washway of drifts of sand and gravel."
                            },
                            {
                                "example_id": "6dc7bc08-be92-463a-ab88-ac4b23dcbd7c",
                                "sense_id": "03a2d9b9-1eb5-3a8e-ac49-71518723acae",
                                "text": "At the edge of the washway on our left it shot out several feet into the air before falling to the jumble of boulders below."
                            }
                        ]
                    },
                    {
                        "sense_id": "61e05b6c-38f1-3a5d-9700-8a034d4e89bf",
                        "entry_id": "e0c7e34f-301e-371a-94d1-89350ee96659",
                        "glosses": [
                            "A sluice where manure and other agricultural waste is washed away."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c92eef0-d538-4331-8849-b02a0285d5f6",
                                "sense_id": "61e05b6c-38f1-3a5d-9700-8a034d4e89bf",
                                "text": "The steers in this treatment had space for standing only in the washways, whereas the steers in all the other treatments had additional standing or lying space other than the washways."
                            },
                            {
                                "example_id": "60524947-e532-413e-ac8b-5851d2d3db02",
                                "sense_id": "61e05b6c-38f1-3a5d-9700-8a034d4e89bf",
                                "text": "Another test attack on the winter mud and manure problem is the installation of two four-hundred-foot washways immediately behind the feed bunks."
                            },
                            {
                                "example_id": "3e6aa806-d8cd-406b-afd8-02349a89bf1a",
                                "sense_id": "61e05b6c-38f1-3a5d-9700-8a034d4e89bf",
                                "text": "The four pens included a 9-ft-wide manure washway which ran the length of the feed bunk and was flushed daily."
                            }
                        ]
                    },
                    {
                        "sense_id": "0efb7b36-62d7-38d4-8075-6b69756d9b71",
                        "entry_id": "e0c7e34f-301e-371a-94d1-89350ee96659",
                        "glosses": [
                            "A portion of a device where something is washed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897673fa-4256-4f7f-aab9-62fd9312441d",
                                "sense_id": "0efb7b36-62d7-38d4-8075-6b69756d9b71",
                                "text": "[…] said deformable means having lens contacting opposed surfaces providing a washway and adapted for wiping engagement with a lens moved longitudinally in the washway."
                            },
                            {
                                "example_id": "c19b6430-5244-4ef9-af13-2cc128253a06",
                                "sense_id": "0efb7b36-62d7-38d4-8075-6b69756d9b71",
                                "text": ":Template:... such washing means comprising opposed confronting contacting elements defining the locus of an elongated washway aligned with the opening in said other neck, the body member and said other neck being formed with interfitting threads for facile removal and replacement of the scrubber assembly as a unit from and onto said other neck, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a20e7bd0-49e5-3796-afe9-1a7f508c0aaf",
                        "entry_id": "e0c7e34f-301e-371a-94d1-89350ee96659",
                        "glosses": [
                            "A means of washing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ffad62-4245-4e87-b5f6-e71a11272a3b",
                                "sense_id": "a20e7bd0-49e5-3796-afe9-1a7f508c0aaf",
                                "text": "You'll probably admit that a good washing machine is better than the old time washway."
                            }
                        ]
                    }
