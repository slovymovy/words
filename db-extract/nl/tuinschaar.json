                        "sense_id": "1b99f22c-85f9-3912-b59a-b58029f9ebe9",
                        "entry_id": "1179fb57-df05-35f7-b123-54bc04710112",
                        "glosses": [
                            "gereedschap waarmee men struiken, heggen en bomen kan snoeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a08597-0d52-4194-854e-4abdeb0a7a12",
                                "sense_id": "1b99f22c-85f9-3912-b59a-b58029f9ebe9",
                                "text": "D66-raadslid Marian Segers werd een jaar geleden bij haar huis neergestoken met een keukenmes en een tuinschaar toen ze de Fransman betrapte op insluiping, meldt omroep NH. Nadat de man haar met gereedschap had geslagen, ging hij er in de auto van Segers vandoor. Hoewel de politica zwaargewond was, wist ze op straat de aandacht te trekken van buurtgenoten die haar te hulp schoten."
                            },
                            {
                                "example_id": "f0032b51-d5bb-41a5-9cdc-5155611f490d",
                                "sense_id": "1b99f22c-85f9-3912-b59a-b58029f9ebe9",
                                "text": "Volgens de tandarts eindigde de beroving bijzonder traumatisch. Met bevende stem vertelde hij hoe een van de berovers een tuinschaar pakte en hem satanisch lachend een vinger afsneed."
                            }
                        ]
                    }
