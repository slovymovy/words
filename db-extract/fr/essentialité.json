                        "glosses": [
                            "État de ce qui est essentiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b9b666-03a8-416b-84c7-93a8b2e9e9e5",
                                "sense_id": "cf41ee8b-dcde-3be5-8a40-6aa4d7a15e7e",
                                "text": "L'essentialité est la caractéristique d'un objet, d'un concept à être essentiel, c'est à dire : « nécessaire, indispensable, très important, capital », C'est une notion bien connue des logisticiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f92a6ad-8680-3ad4-9251-50a8c69170f8",
                        "entry_id": "52d8945e-5869-3aa4-8f5e-95bbefb2903f",
                        "glosses": [
                            "Caractère essentiel d'une chose ; essence."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bd185f25-2835-4bd8-8007-b4e612c92323",
                                "sense_id": "9f92a6ad-8680-3ad4-9251-50a8c69170f8",
                                "text": "[…] ; et ces atomes sont représentés comme différant les uns des autres. La différence est leur caractère, — leur essentialité, — juste comme la non-différence était le caractère essentiel de leur mouvement."
                            }
                        ]
                    }
