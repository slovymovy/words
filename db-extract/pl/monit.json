                                        "sense_id": "48096a14-7ddd-3056-aebc-1c54e58cb144",
                                        "entry_id": "03f4202f-fc9b-3fdf-aedb-58f129f6aeee",
                                        "glosses": [
                                            "Someone or something that reminds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c20b849f-6257-4fd5-a640-9afdd367639b",
                                                "sense_id": "48096a14-7ddd-3056-aebc-1c54e58cb144",
                                                "text": "He left a note as a reminder to get groceries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbad5e43-6cc4-3898-acd8-4fc7d2924dca",
                                        "entry_id": "03f4202f-fc9b-3fdf-aedb-58f129f6aeee",
                                        "glosses": [
                                            "Writing that reminds of open payments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42907a8e-1ba5-459d-a85a-4dde09c4c2b5",
                                                "sense_id": "dbad5e43-6cc4-3898-acd8-4fc7d2924dca",
                                                "text": "She ignored first the reminder of 80 cents. At the end, she was sentenced to pay 200 euros!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78dbcca2-7b1b-4e69-982c-0d0d234fac0e",
                        "source_entry_id": "4dc8154f-d655-364b-bec4-7420508b283b",
                        "source_sense_id": "9b4c126f-085f-392a-a101-11695793f2ea",
                        "target_lang_word": "dun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae563a82-6bea-3b6b-b5ee-b2b2ddff9198",
                                        "entry_id": "a377972f-9396-3012-8059-9ecd85c414d2",
                                        "glosses": [
                                            "To cure, as codfish, by laying them, after salting, in a pile in a dark place, covered with saltgrass or a similar substance."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6f7df2-eb70-4fe4-82b1-18bf55e0cb8c",
                                                "sense_id": "ae563a82-6bea-3b6b-b5ee-b2b2ddff9198",
                                                "text": "Dun-fish are of a superior quality for the table, and are cured in such a manner as to give them a dun or brownish color. Fish for dunning are caught early in spring, and sometimes February, at the Isle of Shoals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f55d2efe-7a31-36c4-b624-086b809c20d6",
                                        "entry_id": "571e8e4c-630a-3e6e-907f-204c4aafc94d",
                                        "glosses": [
                                            "A mound or small hill."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb08acc-2891-3c1c-a074-3b3592c1f775",
                                        "entry_id": "652c2ba6-54b6-3414-a66a-f76adbf5c0a6",
                                        "glosses": [
                                            "Imitating a deep bass note, such as that found in suspenseful music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072f47d7-db08-43b8-be3a-926580a43589",
                                                "sense_id": "9cb08acc-2891-3c1c-a074-3b3592c1f775",
                                                "text": "How would you deal with that power? (Dun, dun, DUN! Insert dramatic music here.)"
                                            },
                                            {
                                                "example_id": "45a91157-3ce7-4ccd-968e-c3728c84555f",
                                                "sense_id": "9cb08acc-2891-3c1c-a074-3b3592c1f775",
                                                "text": "Dun, dun! Dun, dun! As the music continues, the long shot of Griff's walk is broken down into repeating tight shots of his face, his legs, and his shifting point of view of Brockie."
                                            },
                                            {
                                                "example_id": "7bd0ed41-57e3-47db-b2bd-3063f40d44ab",
                                                "sense_id": "9cb08acc-2891-3c1c-a074-3b3592c1f775",
                                                "text": "'DUN DUN DUN DUN-DUN-DUN-DUN! DUN DUN DUN DUNDUN-DUN-DUN... PRESSURE!' By 2.05 a.m. I am Very Awake Indeed and the catastrophising continues."
                                            },
                                            {
                                                "example_id": "6aa19335-0f84-47f1-872e-7686955cd3c3",
                                                "sense_id": "9cb08acc-2891-3c1c-a074-3b3592c1f775",
                                                "text": "Whenever that iconic riff in the score cued up—Dun dun ... dun dun ... dun dun dun dun dun-dun-dun-dun ... —Jack's heart would race, and she'd feel the fear on her skin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8422dacb-58b4-3092-b9e3-572906bb9bdf",
                                        "entry_id": "d02dfbac-5c1c-3034-aaac-fc07acade705",
                                        "glosses": [
                                            "A brownish grey colour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a505fc7-10bf-3335-8e20-ff29e433207c",
                                        "entry_id": "eb067104-a346-3cb1-8485-7291020ccbbb",
                                        "glosses": [
                                            "Of a brownish grey colour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e570aa6-4455-45d2-97c0-4ccf9b690ef9",
                                                "sense_id": "7a505fc7-10bf-3335-8e20-ff29e433207c",
                                                "text": "Come, thick Night,\n And pall thee in the dunneſt ſmoake of Hell,\n That my keene Knife ſee not the Wound it makes,\n Nor Heauen peepe through the Blanket of the darke,\n To cry, hold, hold."
                                            },
                                            {
                                                "example_id": "75fb91b9-bde7-4ce6-ad74-cdd91afdbeb6",
                                                "sense_id": "7a505fc7-10bf-3335-8e20-ff29e433207c",
                                                "text": "My Miſtres eyes are nothing like the Sunne,\n Currall is farre more red, then her lips red,\n If ſnow be white, why then her breſts are dun:\n If hairs be wiers, black wiers grow on her head: [...]"
                                            },
                                            {
                                                "example_id": "d1b02e29-ad1a-4fbb-b78f-8a84a44c3678",
                                                "sense_id": "7a505fc7-10bf-3335-8e20-ff29e433207c",
                                                "text": "Red o'er the forest glows the setting sun, / The line of yellow light dies fast away / That crown'd the eastern copse, and chill and dun / Falls on the moor the brief November day."
                                            },
                                            {
                                                "example_id": "bee6c576-5cc2-4ff5-b1ad-880c49eb97cd",
                                                "sense_id": "7a505fc7-10bf-3335-8e20-ff29e433207c",
                                                "text": "Where is the nobility in these streets paved with greasy carbon and dun ash?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a99916a-51cc-3d93-b272-eecd5df3b102",
                                        "entry_id": "18a83fb9-5b50-3f13-8e58-ddc690a125fe",
                                        "glosses": [
                                            "A collector of debts, especially one who is insistent and demanding."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f40280-4ee8-4fe8-add8-8cd7576558d6",
                                                "sense_id": "4a99916a-51cc-3d93-b272-eecd5df3b102",
                                                "text": "\"The truth is, Mr. Curl, I cannot write when I am plagued about trifles; and a tiresome dun this morning put to flight every idea that I had in the world.\"\n\"Mr. Maynard,\" said the bookseller, in a solemn tone, \"it is very wrong to run in debt.\""
                                            },
                                            {
                                                "example_id": "2a092e83-91d6-4b4f-91bd-8009a7b3ebed",
                                                "sense_id": "4a99916a-51cc-3d93-b272-eecd5df3b102",
                                                "text": "Look ye, gentlemen, I have lived with credit in the world, and it grieves my heart never to stir out of my doors but to be pulled by the sleeve by some rascally dun or other."
                                            },
                                            {
                                                "example_id": "55a027da-97c3-4749-882a-5b9e6af707d0",
                                                "sense_id": "4a99916a-51cc-3d93-b272-eecd5df3b102",
                                                "text": "Melancholy duns came looking for him at all hours."
                                            },
                                            {
                                                "example_id": "6b1ad575-2380-4660-966d-81c0e8b22748",
                                                "sense_id": "4a99916a-51cc-3d93-b272-eecd5df3b102",
                                                "text": "‘Frank's worried about duns,’ she said as the butler went away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a9f8c1-f56c-3adf-a102-b898f6dcf67a",
                                        "entry_id": "18a83fb9-5b50-3f13-8e58-ddc690a125fe",
                                        "glosses": [
                                            "An urgent request or demand of payment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f279450-43dc-49c8-be7b-3c5f9a7e3205",
                                                "sense_id": "96a9f8c1-f56c-3adf-a102-b898f6dcf67a",
                                                "text": "Miss Hoppin received a dun for volume 9 1840–1 which Mr. James McConnell, (who now pays the above) is sure was paid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7384cba2-fc94-3ad1-a115-0f2f113c8e9a",
                                        "entry_id": "3ad3801f-0e61-37c0-a106-88a8e8118c68",
                                        "glosses": [
                                            "To ask or beset a debtor for payment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cad4208d-e494-4617-bdd1-bac4304378b7",
                                                "sense_id": "7384cba2-fc94-3ad1-a115-0f2f113c8e9a",
                                                "text": "And hath she sent so soon to dun?"
                                            },
                                            {
                                                "example_id": "c6b76b2a-d31f-4480-b852-5e73c5fa5108",
                                                "sense_id": "7384cba2-fc94-3ad1-a115-0f2f113c8e9a",
                                                "text": "Of all he had received from Lady Bellaston, not above five guineas remained and that very morning he had been dunned by a tradesman for twice that sum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d618007-86f5-3105-a9fb-e257f0a4536d",
                                        "entry_id": "3ad3801f-0e61-37c0-a106-88a8e8118c68",
                                        "glosses": [
                                            "To harass by continually repeating e.g. a request."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c453de14-da14-4e99-a088-165b38ba3ba7",
                                                "sense_id": "3d618007-86f5-3105-a9fb-e257f0a4536d",
                                                "text": "Rich bitches who had to be dunned for their milk bills would pay him right now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d61eabc2-54f0-321d-9659-3df19a4aff64",
                                        "entry_id": "32744cca-112e-3e99-9bf5-4309dea31f8e",
                                        "glosses": [
                                            "A newly hatched, immature mayfly; a mayfly subimago."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9135914-f43c-48e5-9c6e-789bf712a6de",
                                                "sense_id": "d61eabc2-54f0-321d-9659-3df19a4aff64",
                                                "text": "Also, duns are dull and generally sober colored, whilst spinners are more brightly colored and shining and their wings are clear and transparent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b735e021-ed67-3261-9926-854af0b61632",
                                        "entry_id": "32744cca-112e-3e99-9bf5-4309dea31f8e",
                                        "glosses": [
                                            "A fly made to resemble the mayfly subimago."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b997cd6b-7bab-4556-a945-2b10d43e0377",
                                                "sense_id": "b735e021-ed67-3261-9926-854af0b61632",
                                                "text": "We have besides for this Month a little Dun call'd a whirling Dun (though it is not the whirling Dun indeed, which is one of the best Flies we have) and for this the dubbing must be of the bottom fur of a Squirrels tail and the wing of the grey feather of a Drake."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86916507-77f4-3984-a42a-35eaa80196ba",
                                        "entry_id": "0069a155-b9a0-3667-ab02-43df3087f0c7",
                                        "glosses": [
                                            "An ancient or medieval fortification; especially a hill-fort in Scotland or Ireland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76081d1c-4dfd-48d9-a54a-f8da97103962",
                                                "sense_id": "86916507-77f4-3984-a42a-35eaa80196ba",
                                                "text": "Pampedun, or Pandon, was probably a place of residence from the earliest times; its sheltered situation for boats, and proximity to the ancient way over the river, protected perhaps by a dun or camp, on the height above [...] possibly gave origin to the ancient name of the place, Pampedun, from the British pant, a hollow, and dun, a fort or camp, Pant-y-dun."
                                            }
                                        ]
                                    },
                                    {
