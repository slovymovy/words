                        "entry_id": "6c83adea-0880-34ed-9362-2e406d0623ac",
                        "glosses": [
                            "to pull about, to blow about, to flutter, to tousle"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "11f49bf5-3b68-3dd4-897c-f3a5de6381ee",
                        "entry_id": "6c83adea-0880-34ed-9362-2e406d0623ac",
                        "glosses": [
                            "to pat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76280c92-d922-4147-8fab-c0cb8a534de2",
                                "sense_id": "11f49bf5-3b68-3dd4-897c-f3a5de6381ee",
                                "text": "потрепа́ть кого́-либо по плечу́",
                                "translation": "to pat someone's shoulder",
                                "english": "to pat someone's shoulder"
                            },
                            {
                                "example_id": "44f8afdd-f156-44cd-8555-8c309fa6b78f",
                                "sense_id": "11f49bf5-3b68-3dd4-897c-f3a5de6381ee",
                                "text": "Ма́рья Па́вловна снисходи́тельно потрепа́ла подру́гу по щеке́ и вы́шла.",
                                "translation": "Maria Pavlovna patted her friend’s cheek indulgently and left.",
                                "english": "Maria Pavlovna patted her friend’s cheek indulgently and left."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b79b976-369e-37c1-96ee-b49ef010dd8d",
                        "entry_id": "6c83adea-0880-34ed-9362-2e406d0623ac",
                        "glosses": [
                            "to beat up, to maul, to pummel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d3bf574-8ca3-456e-bd3c-9001bad91c17",
                                "sense_id": "8b79b976-369e-37c1-96ee-b49ef010dd8d",
                                "text": "сосе́ди потрепа́ли во́ра",
                                "translation": "neighbours mauled the thief",
                                "english": "neighbours mauled the thief"
                            }
                        ]
                    },
                    {
                        "sense_id": "042aacf8-46a0-32c6-8963-50bf801e5e85",
                        "entry_id": "6c83adea-0880-34ed-9362-2e406d0623ac",
                        "glosses": [
                            "to give a hard life/time"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71680bd1-a7e7-4942-b633-f2601f5ca039",
                                "sense_id": "042aacf8-46a0-32c6-8963-50bf801e5e85",
                                "text": "жизнь потрепа́ла его́",
                                "translation": "he had a life full of trouble; his troubles had told on his appearance",
                                "english": "he had a life full of trouble; his troubles had told on his appearance"
                            }
                        ]
                    },
                    {
                        "sense_id": "b016dba0-191a-3ef2-bf2d-1de433f69aef",
                        "entry_id": "6c83adea-0880-34ed-9362-2e406d0623ac",
                        "glosses": [
                            "to mention too often, to make too many references (to), to hackney"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a676846-b457-4379-9f6b-0b1b0c3d1c38",
                                "sense_id": "b016dba0-191a-3ef2-bf2d-1de433f69aef",
                                "text": "не хо́чется потрепа́ть э́то высо́кое сло́во",
                                "translation": "I wouldn't like to use this lofty word without a special reason",
                                "english": "I wouldn't like to use this lofty word without a special reason"
                            },
                            {
                                "example_id": "13b18251-7aea-4199-8a76-352b55cccd68",
                                "sense_id": "b016dba0-191a-3ef2-bf2d-1de433f69aef",
                                "text": "по́сле э́той исто́рии его́ и́мя ста́ли потрепа́ть вовсю́",
                                "translation": "after that incident, his name became the talk of the town",
                                "english": "after that incident, his name became the talk of the town"
                            }
                        ]
                    }
