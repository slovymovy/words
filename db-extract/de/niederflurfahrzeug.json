                                "sense_id": "877dff38-deeb-312a-9c80-1f8e78a613a5",
                                "text": "Viele Rollstuhlfahrerinnen und Rollstuhlfahrer sind auf Niederflurfahrzeuge im ÖPNV angewiesen."
                            },
                            {
                                "example_id": "9217a8f9-c47d-45fd-88fc-6b19e2a21d75",
                                "sense_id": "877dff38-deeb-312a-9c80-1f8e78a613a5",
                                "text": "Die ersten Niederflurfahrzeuge wurden bereits 1896 in der U-Bahn von Budapest eingesetzt."
                            },
