                "senses": [
                    {
                        "sense_id": "47d41ae7-aa55-35f7-8a23-698b33fceda9",
                        "entry_id": "942ae8c7-31c5-3fd3-856c-bafeb756df45",
                        "glosses": [
                            "Rendre plus économe en énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c92ca32-9c5f-442e-be83-30aa96501473",
                                "sense_id": "47d41ae7-aa55-35f7-8a23-698b33fceda9",
                                "text": "La Suède s’efforce tout particulièrement d’éconergiser le secteur des transports."
                            },
                            {
                                "example_id": "ba5f8050-6037-446a-a6d7-1e784ee835be",
                                "sense_id": "47d41ae7-aa55-35f7-8a23-698b33fceda9",
                                "text": "Il s'agit de réserver l'usage de celle-ci aux transformations à haut rendement (p.ex. par pour le chauffage) et de disposer de systèmes « éconergisant » au maximum."
                            },
                            {
                                "example_id": "bbb4f589-1210-432b-b52c-7f9143adad61",
                                "sense_id": "47d41ae7-aa55-35f7-8a23-698b33fceda9",
                                "text": "Et si on éconergisait ?"
                            }
                        ]
                    }
