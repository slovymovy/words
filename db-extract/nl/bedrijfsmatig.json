                        "glosses": [
                            "in het kader van de uitoefening van een beroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82c8525-ee13-481c-a84f-31924e59fdea",
                                "sense_id": "7038e30e-65ab-3983-834b-e13b7c152483",
                                "text": "De bestuurders van DSS en Centric verklaarden in de rechtszaal dat het geen gecoördineerde actie was, dat de timing toevallig was en dat Sanderink beslist niets met deze juridische actie te maken had: het waren puur bedrijfsmatige beslissingen geweest door de bestuurders zelf."
                            },
                            {
                                "example_id": "6ec67bfd-a7e5-4fb2-a7bd-7aa8472f924c",
                                "sense_id": "7038e30e-65ab-3983-834b-e13b7c152483",
                                "text": "Tegen de 22-jarige eigenaresse wordt een proces-verbaal opgemaakt. Ze is eerder al in aanraking gekomen met de politie voor iets soortgelijks. De politie vermoedt dat de vrouw bedrijfsmatig bezig is met het fokken en verkopen van cavia's, terwijl ze niet aan de wettelijke eisen voldoet."
                            }
                        ]
