                "senses": [
                    {
                        "sense_id": "2ffbb67a-95da-3cb8-b809-90ca3d59070e",
                        "entry_id": "b31db1dd-a364-35c7-876e-8e9d821df0e8",
                        "glosses": [
                            "Qui n’est pas usité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181715ce-1c97-4fbb-aeee-e563be1215fe",
                                "sense_id": "2ffbb67a-95da-3cb8-b809-90ca3d59070e",
                                "text": "Il souriait à l’espace, il était d’une galanterie inusitée."
                            },
                            {
                                "example_id": "5ad8737d-19be-4d65-8a23-a17de7b58f02",
                                "sense_id": "2ffbb67a-95da-3cb8-b809-90ca3d59070e",
                                "text": "Le samedi 29 septembre 1925, vers 5 heures, la famille Mermoz, de Messigny, était éveillée par les aboiements inusités de son chien qui était attaché dans une cabane située dans un pré attenant à l’habitation."
                            },
                            {
                                "example_id": "c741782b-1bf3-48e5-b393-7484853cc458",
                                "sense_id": "2ffbb67a-95da-3cb8-b809-90ca3d59070e",
                                "text": "Monsieur Palanquin a approuvé ; une grimace inusitée s’est dessinée sur le visage de Julia."
                            },
                            {
                                "example_id": "aa334b32-d4ad-4ff6-b9ab-d8ddf244b8b9",
                                "sense_id": "2ffbb67a-95da-3cb8-b809-90ca3d59070e",
                                "text": "Un lecteur m'écrit « La prof de français nous a dit qu'il est inutile d'apprendre à conjuguer le passé simple, car c'est un temps archaïque, aujourd'hui complètement inusité »."
                            }
                        ]
                    }
