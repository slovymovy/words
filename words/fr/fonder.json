                    "frequency": "Middle",
                    "semantic_group_id": "appuyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chercheur doit <w>fonder</w> son jugement sur des données scientifiques rigoureuses."
                        },
                        {
                            "text": "Vous ne pouvez pas <w>fonder</w> de telles accusations sur de simples rumeurs."
                        }
                    ],
                    "common_phrases": [
