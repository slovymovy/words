                        "entry_id": "a84b216c-cd8d-3311-bcf6-119ecac25731",
                        "glosses": [
                            "The state or characteristic of being variable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "64fde03a-7ce7-36d9-9a4c-247370274a1c",
                        "entry_id": "a84b216c-cd8d-3311-bcf6-119ecac25731",
                        "glosses": [
                            "The degree to which a thing is variable. In data or statistics this is often a measurement of distance from the mean or a description of data range."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00b1c0a9-3b57-4361-b6cf-e15f1ba77f4b",
                        "source_entry_id": "a84b216c-cd8d-3311-bcf6-119ecac25731",
