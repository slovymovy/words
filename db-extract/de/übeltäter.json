                                "target_senses": [
                                    {
                                        "sense_id": "d93790ad-4c30-39e2-a13d-d840c407e3e7",
                                        "entry_id": "6715e8bc-ef13-3918-946c-7b49c8646993",
                                        "glosses": [
                                            "Voyou ; malfaiteur ; bandit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e79177-d2d1-4d12-852c-013f4be34787",
                                                "sense_id": "d93790ad-4c30-39e2-a13d-d840c407e3e7",
                                                "text": "Elle se souvenait du jour du défilé, quand Martial avait tiré Alex des griffes du malfrat."
                                            },
                                            {
                                                "example_id": "19328bf5-3311-4160-b775-1d9c1c997976",
                                                "sense_id": "d93790ad-4c30-39e2-a13d-d840c407e3e7",
                                                "text": "Un des informateurs du patron —[…]– nous a refilé un tuyau d'importance. Deux malfrats aguerris et une petite frappe en devenir ont eu vent de la prochaine opération « sac à dos »."
                                            },
                                            {
                                                "example_id": "2afd139f-5159-4fdb-aa95-059a712a6598",
                                                "sense_id": "d93790ad-4c30-39e2-a13d-d840c407e3e7",
                                                "text": "Près de son campement, au milieu des baraquements de prospecteurs, quelques malfrats ont coutume de tenir des parties de poker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae547aa-343a-41b2-809d-f29090352908",
                        "source_entry_id": "8395d4ff-4f89-347a-b1ab-effb989cdb8a",
                        "source_sense_id": "fc77f2d2-8582-3a64-92f2-e5af05ba9d86",
