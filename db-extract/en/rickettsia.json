                        "entry_id": "347d763e-bbcc-3d8c-960c-b075a5bb890f",
                        "glosses": [
                            "Any bacterium of the order Rickettsiales."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
