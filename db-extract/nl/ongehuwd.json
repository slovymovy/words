                        "examples": [
                            {
                                "example_id": "d2ce236b-35c4-42ac-8644-e494bf1f8589",
                                "sense_id": "07e500cc-4ba8-3db8-b655-48c10756513d",
                                "text": "De vondeling werd Jan van der Stoep genoemd, vanwege de plek waar hij lag. Pas jaren later werd bekend dat zijn ongehuwde moeder uit pure armoede haar zoontje op straat had achtergelaten."
                            },
                            {
                                "example_id": "0ad99cb3-eadd-48b7-a794-8be9c85c4963",
                                "sense_id": "07e500cc-4ba8-3db8-b655-48c10756513d",
                                "text": "Hij bleef ongehuwd."
                            },
                            {
                                "example_id": "01def953-a780-4766-99e2-1e844555d7a5",
                                "sense_id": "07e500cc-4ba8-3db8-b655-48c10756513d",
                                "text": "Het stel woont ongehuwd samen."
                            }
                        ]
                    }
                ],
