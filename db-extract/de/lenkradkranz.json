                        "glosses": [
                            "äußerer Rand eines Steuerrads"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2247ba8c-ab94-49e8-98a0-3bb8cdb5af35",
                                "sense_id": "b42c2460-4cc7-39b2-8c3d-46a3205af420",
                                "text": "„Im Vergleich zur ersten Baureihe ist die Lenkung mittlerweile erstaunlich leichtgängig. Im Verbund mit dem dünnen Lenkradkranz vermittelt sie die Illusion, ein leichtes und wendiges Fahrzeug zu bewegen.“"
                            },
                            {
                                "example_id": "72865aeb-7fb7-49c3-abf5-73baf1402e86",
                                "sense_id": "b42c2460-4cc7-39b2-8c3d-46a3205af420",
                                "text": "„Das Lenkrad wirkt seltsam klobig und unelegant, vor allem aber hat es einen im wahrsten Sinne des Wortes handfesten Makel: legt man die Hände in die für ambitioniertes Fahren sinnvolle Viertel-nach-Neun-Position, können die Finger nicht um den Lenkradkranz herumgreifen, weil da die Rückseite des wuchtigen Pralltopfs im Weg ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
