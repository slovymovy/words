                "senses": [
                    {
                        "sense_id": "6c0be6f3-ac90-3f18-b3f5-f9d0c71fbccc",
                        "entry_id": "92d62a70-9c37-33c7-8cf8-4beae1826aee",
                        "glosses": [
                            "разг. однокр. к нюхать; понюхать"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "b636f508-f942-4ceb-ad17-ebf41519ea6e",
                                "sense_id": "6c0be6f3-ac90-3f18-b3f5-f9d0c71fbccc",
                                "text": "Старик, на всякий случай скривившись, нюхнул янтарное вино, поднес ко рту и выпил, страдальчески морщась."
                            }
                        ]
                    },
                    {
                        "sense_id": "05fc09bc-1bd0-3203-9df8-4d9fb3feef4b",
                        "entry_id": "92d62a70-9c37-33c7-8cf8-4beae1826aee",
                        "glosses": [
                            "перен., разг. узнать что-либо на собственном опыте; познакомиться с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1936636-b1f3-491d-9dc8-f30657f165e6",
                                "sense_id": "05fc09bc-1bd0-3203-9df8-4d9fb3feef4b",
                                "text": "Он ступил на прямую дорогу ― пробыл в военном училище неделю, нюхнул казармы, побегал в кирзачах на зарядку, собрал свой чемоданчик и известил начальство, что эта бодяга не для него."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "676d455c-6a9a-42b8-882b-9fe5675ef47d",
                        "source_entry_id": "92d62a70-9c37-33c7-8cf8-4beae1826aee",
                        "target_lang_word": "smell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47f5cc84-0e54-3adb-90da-744e5d31d5c9",
                                        "entry_id": "1d98eeba-9b00-336f-aded-ec493f9b7fc2",
                                        "glosses": [
                                            "A sensation, pleasant or unpleasant, detected by inhaling air (or, the case of water-breathing animals, water) carrying airborne molecules of a substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a054be4-bd15-4334-9361-7f6bfd878ec8",
                                                "sense_id": "47f5cc84-0e54-3adb-90da-744e5d31d5c9",
                                                "text": "I love the smell of fresh bread."
                                            },
                                            {
                                                "example_id": "4da4734e-7f7d-4aac-9906-6e16d810c582",
                                                "sense_id": "47f5cc84-0e54-3adb-90da-744e5d31d5c9",
                                                "text": "The penetrating smell of cabbage reached the nose of Toad as he lay prostrate in his misery on the floor, and gave him the idea for a moment that perhaps life was not such a blank and desperate thing as he had imagined. But still he wailed, and kicked with his legs, and refused to be comforted. So the wise girl retired for the time, but, of course, a good deal of the smell of hot cabbage remained behind, as it will do, and Toad, between his sobs, sniffed and reflected, and gradually began to think new and inspiring thoughts: of chivalry, and poetry[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc3d732-75ad-36ab-ad5e-8f754e0e5f13",
                                        "entry_id": "1d98eeba-9b00-336f-aded-ec493f9b7fc2",
                                        "glosses": [
                                            "The sense that detects odours."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c009993-aeed-3e83-a893-d0f72ad5d5ef",
                                        "entry_id": "1d98eeba-9b00-336f-aded-ec493f9b7fc2",
                                        "glosses": [
                                            "A conclusion or intuition that a situation is wrong, more complex than it seems, or otherwise inappropriate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6fe672d-474d-49a0-8fbd-c3b705a045ee",
                                                "sense_id": "0c009993-aeed-3e83-a893-d0f72ad5d5ef",
                                                "text": "I’m just saying, this has a bad smell to it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3938bb6b-30cf-3f73-9bd1-54bf606fb365",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "To sense a smell or smells."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5a68ae-150d-48c2-8ef4-4859452aed80",
                                                "sense_id": "3938bb6b-30cf-3f73-9bd1-54bf606fb365",
                                                "text": "I can smell fresh bread."
                                            },
                                            {
                                                "example_id": "601a8d6b-af36-4fc2-89e2-e9e7d719a6aa",
                                                "sense_id": "3938bb6b-30cf-3f73-9bd1-54bf606fb365",
                                                "text": "Smell the milk and tell me whether it's gone off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7cec89f-1733-376b-a2e6-6a10e08cadf8",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "To sense a smell or smells.",
                                            "To detect or perceive; often with out."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e837d3de-fc8e-461f-b362-d7014849bc01",
                                                "sense_id": "b7cec89f-1733-376b-a2e6-6a10e08cadf8",
                                                "text": "I smell a device."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01d677d9-82cb-33a8-973a-3d03db6108d2",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "Followed by like or of if descriptive: to have a particular smell, whether good or bad."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6723564-ad89-4532-8010-8e42ceb194aa",
                                                "sense_id": "01d677d9-82cb-33a8-973a-3d03db6108d2",
                                                "text": "The roses smell lovely."
                                            },
                                            {
                                                "example_id": "8c6360bb-8b31-4c3f-abb7-ee82cf7c9e0b",
                                                "sense_id": "01d677d9-82cb-33a8-973a-3d03db6108d2",
                                                "text": "Her feet smell of cheese."
                                            },
                                            {
                                                "example_id": "f55c5e19-c68d-4ed6-9dd8-79a794aba85a",
                                                "sense_id": "01d677d9-82cb-33a8-973a-3d03db6108d2",
                                                "text": "The drunkard smelt like a brewery."
                                            },
                                            {
                                                "example_id": "712f9931-00a4-4951-ad0b-d9cc231440fa",
                                                "sense_id": "01d677d9-82cb-33a8-973a-3d03db6108d2",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel[…]. Next he put the mackerel in a fry-pan, and the shanty began to smell like a Banks boat just in from a v'yage."
                                            },
                                            {
                                                "example_id": "3879a29b-0f92-4076-93dc-c86b22ed9ae0",
                                                "sense_id": "01d677d9-82cb-33a8-973a-3d03db6108d2",
                                                "text": "Este's been losing sleep / Her husband's acting different and it smells like infidelity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63575ef-8f48-3ace-901c-32ab2d474a72",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "Followed by like or of if descriptive: to have a particular smell, whether good or bad.",
                                            "To smell of; to have a smell of"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633f409b-3da3-45c0-a968-e3bd55bf9709",
                                                "sense_id": "d63575ef-8f48-3ace-901c-32ab2d474a72",
                                                "text": "I do smell all horse-piss"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72bc6202-3be0-3b0f-a346-dccb3d33fed3",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "Followed by like or of if descriptive: to have a particular smell, whether good or bad.",
                                            "To smell bad; to stink."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68beed83-f462-4aa8-aead-20b9653f6892",
                                                "sense_id": "72bc6202-3be0-3b0f-a346-dccb3d33fed3",
                                                "text": "Ew, this restroom smells (loathsomely)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98aee624-b276-304e-8644-a9cc6f99569b",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "Followed by like or of if descriptive: to have a particular smell, whether good or bad.",
                                            "To have a particular tincture or smack of any quality; to savour."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a122d2d6-48d2-4a9f-9a9f-7f47f9e8e679",
                                                "sense_id": "98aee624-b276-304e-8644-a9cc6f99569b",
                                                "text": "A report smells of calumny."
                                            },
                                            {
                                                "example_id": "96bd68b2-bc11-49d9-990d-2b0854db7848",
                                                "sense_id": "98aee624-b276-304e-8644-a9cc6f99569b",
                                                "text": "Praises in an enemy are superfluous, or smell of craft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d6939ee-c07f-3666-8ef7-7c21e71fa022",
                                        "entry_id": "f9bb4dc0-6af8-38d4-a710-39281241c01c",
                                        "glosses": [
                                            "To give heed to."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9e674fd-7c69-492b-95b7-96f20d0516e6",
                                                "sense_id": "8d6939ee-c07f-3666-8ef7-7c21e71fa022",
                                                "text": "So from that tyme forwarde I began to ſmell the word of god, and forſoke the ſchole doctors and ſuch foolries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
