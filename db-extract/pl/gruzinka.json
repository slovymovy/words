                    {
                        "translation_id": "e9ed1f7c-8304-4b02-b9dc-f7a38679d94b",
                        "source_entry_id": "7759b374-dc31-3c5a-a17c-56f0da7639c2",
                        "source_sense_id": "56ff33a5-a7b4-35cc-b622-cdb97621724d",
                        "target_lang_word": "грузинка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "грузинка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "048139ad-bd2c-3091-92bd-2e9fa932d361",
                                        "entry_id": "f4162ed6-faf8-3f6d-96bf-d686fe318018",
                                        "glosses": [
                                            "женск. к грузин; представительница народа картвельской этноязыковой группы, составляющего коренное население Грузии, также жительница, уроженка или гражданка Грузии либо потомок выходцев из этой страны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc19122-d69b-4047-80ef-dd28e769e49a",
                                                "sense_id": "048139ad-bd2c-3091-92bd-2e9fa932d361",
                                                "text": "На крыльце появляется с недавних пор живущая в доме немолодая грузинка."
                                            },
                                            {
                                                "example_id": "9e986fe6-bc03-4291-83db-92d97a80a926",
                                                "sense_id": "048139ad-bd2c-3091-92bd-2e9fa932d361",
                                                "text": "И ближе, ближе всё звучал // Грузинки голос молодой."
                                            },
                                            {
                                                "example_id": "a7dc1972-11d4-44f1-b754-0da7862b5931",
                                                "sense_id": "048139ad-bd2c-3091-92bd-2e9fa932d361",
                                                "text": "Дамское общество делилось на два лагеря, на русских и некоторое число грузинок, одетых по французской моде, и на большинство грузинских дам, не изменивших еще своему национальному костюму."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
