    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                "word": "ordinarily",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b865ab3b-20a1-3d8e-aee8-db10eebfbe68",
                        "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                        "glosses": [
                            "In accordance with normal custom or routine; as a matter of established occurrence."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7c5aa90b-809a-404b-b2d4-06aee72c178e",
                                "sense_id": "b865ab3b-20a1-3d8e-aee8-db10eebfbe68",
                                "text": "It is ordinarily seene how good intentions, being managed without moderation, thrust men into most vicious effects."
                            }
                        ]
                    },
                    {
                        "sense_id": "d96ea233-674b-3f6a-a58a-2ca36a8eb4bf",
                        "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                        "glosses": [
                            "Usually or as a general rule; commonly."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c79e1ef9-f0c1-481c-ac0c-85b0334a40c0",
                                "sense_id": "d96ea233-674b-3f6a-a58a-2ca36a8eb4bf",
                                "text": "Ordinarily I go to the match on a Saturday."
                            },
                            {
                                "example_id": "e6699d06-b208-45f9-bf94-5a017098ddde",
                                "sense_id": "d96ea233-674b-3f6a-a58a-2ca36a8eb4bf",
                                "text": "I'm ordinarily supportive of free speech, but this dispay is obnoxious."
                            }
                        ]
                    },
                    {
                        "sense_id": "906ca307-a35b-3b70-b90b-c310c98eb69e",
                        "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                        "glosses": [
                            "In the usual manner; unexceptionally."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "50200c2b-5c0f-433d-80b8-08be4c4ab4e1",
                                "sense_id": "906ca307-a35b-3b70-b90b-c310c98eb69e",
                                "text": "The man was ordinarily dressed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e19b145a-ebb5-4843-9d3d-03bd9256188f",
                        "source_entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                        "source_sense_description": "usually or as a general rule",
                        "target_lang_word": "gewoon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "33399d2c-e4e7-35d7-8aad-17c63b684fdd",
                                        "entry_id": "b4fc3040-84f6-31fd-9344-cb8ba10942ab",
                                        "glosses": [
                                            "zoals gebruikelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5243f55e-abc9-4b3d-bfd4-ae4c00e39aac",
                                                "sense_id": "33399d2c-e4e7-35d7-8aad-17c63b684fdd",
                                                "text": "Het is gewoon en niets bijzonders."
                                            },
                                            {
                                                "example_id": "d086c8dd-dcc8-4a84-bbaa-e67a4fa15ddf",
                                                "sense_id": "33399d2c-e4e7-35d7-8aad-17c63b684fdd",
                                                "text": "Doe maar gewoon, dan doe je al gek genoeg"
                                            },
                                            {
                                                "example_id": "76b2abd6-531a-46f9-a4aa-fd166759b176",
                                                "sense_id": "33399d2c-e4e7-35d7-8aad-17c63b684fdd",
                                                "text": "In een interview in 2009 met Mare zei Buikhuisen dat hij nog altijd last had van de affaire. Hij zei nog elke keer te hopen op een verontschuldiging als hij post kreeg van de universiteit. \"Dat ze gewoon een beetje erkennen: we zijn toch wel tekortgeschoten. Ik zou daar heel blij mee zijn.\""
                                            },
                                            {
                                                "example_id": "8e83f6ae-3ad2-4f72-82ee-c707cb5d2f92",
                                                "sense_id": "33399d2c-e4e7-35d7-8aad-17c63b684fdd",
                                                "text": "Volgende week ga ik, denk ik, gewoon naar kantoor, we zitten daar maar met een man of vier. Maar als iemand straks hard gaat hoesten in de trein zonder zijn mond te bedekken – en dat gebeurt nogal eens – ga ik wel ergens anders zitten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c2529b-8208-35ea-aafd-d497a7e1015c",
                                        "entry_id": "b4fc3040-84f6-31fd-9344-cb8ba10942ab",
                                        "glosses": [
                                            "alledaags, normaal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba406002-1bb2-4eb3-9395-aa6416c6cb89",
                                                "sense_id": "e7c2529b-8208-35ea-aafd-d497a7e1015c",
                                                "text": "Dit zijn gewone mussen."
                                            },
                                            {
                                                "example_id": "521ee1ba-e0be-43f3-92dd-42ad8bf070fc",
                                                "sense_id": "e7c2529b-8208-35ea-aafd-d497a7e1015c",
                                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9bc9741-7fb1-3039-b6ff-2232b70503ef",
                                        "entry_id": "b4fc3040-84f6-31fd-9344-cb8ba10942ab",
                                        "glosses": [
                                            "de gewone man: iemand die niet erg rijk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f27659c-8f50-456b-8536-eb3b57c1c92f",
                                                "sense_id": "a9bc9741-7fb1-3039-b6ff-2232b70503ef",
                                                "text": "Voor het eerst trok de gewone man naar het zuiden, in zijn net aangeschafte 2 CV, Renault Dauphine of Simca Aronde - en een decennium later in een Citroën Ami of Peugeot 404. 'Parijs wordt een buitenwijk van Valence, een voorstad van Saint-Paul de Vence', zong Charles Trenet in 1955 in zijn klassieker Route Nationale 7."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20815e07-239a-3d0a-9c7b-5e8d6ba3edb7",
                                        "entry_id": "b4fc3040-84f6-31fd-9344-cb8ba10942ab",
                                        "glosses": [
                                            "iets ~ zijn: ergens aan gewend zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c6fdac-3732-4937-a126-84330658ec13",
                                                "sense_id": "20815e07-239a-3d0a-9c7b-5e8d6ba3edb7",
                                                "text": "Zij waren gewoon 's zondags naar de kerk te gaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f84f308-3cff-3d63-a0e3-aab867597adb",
                                        "entry_id": "b4fc3040-84f6-31fd-9344-cb8ba10942ab",
                                        "glosses": [
                                            "zonder verdere complicaties"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a54e677-6490-46e0-905e-0c8f79cc3536",
                                                "sense_id": "1f84f308-3cff-3d63-a0e3-aab867597adb",
                                                "text": "Het beste was wanneer je je kleren vroeg bij elkaar kon rapen en gewoon weg kon sluipen zonder afscheid te nemen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gewoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ecd2d70-9a35-3b14-ad33-8f7fb66bc87c",
                                        "entry_id": "db2c74a7-384e-3296-9a58-f3009af1770a",
                                        "glosses": [
                                            "de handeling van het wonen ww (vooral informeel taalgebruik)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3280ecb-7cf8-45ac-89d2-70be5fac777a",
                                                "sense_id": "9ecd2d70-9a35-3b14-ad33-8f7fb66bc87c",
                                                "text": "Al dat gewoon in buitenhuizen tegenwoordig!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "236cf33a-883f-4b22-b0d1-01246a6cb43f",
                        "source_entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                        "source_sense_description": "usually or as a general rule",
                        "target_lang_word": "d'ordinaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "43cca50d-d1de-44f2-8c57-dd1b451597c5",
                        "source_entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                        "source_sense_description": "usually or as a general rule",
                        "target_lang_word": "ordinairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordinairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                        "entry_id": "508a3ce8-c78c-3b07-b3c4-f49ec7f0ff32",
                                        "glosses": [
                                            "De manière ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03089cfd-620d-48f2-972c-6648a078f76f",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "L’évaluation de la netteté se fait ordinairement par le plus petit intervalle e mesuré entre deux points ou deux traits distincts de l'épreuve ; […]."
                                            },
                                            {
                                                "example_id": "b61a80c9-a858-49c1-8360-14d1d0872565",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "Cet angle a été adopté, parce qu'on a remarqué que le vent ne souffle pas horizontalement, mais que sa direction plonge ordinairement un peu sur la surface de la terre."
                                            },
                                            {
                                                "example_id": "c58947cd-dbf4-44cb-9add-eedfc16330c9",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "Quand le malade ne succombe pas, la convalescence est ordinairement longue. […]. L'albuminurie peut continuer pendant des mois."
                                            },
                                            {
                                                "example_id": "a91882c3-74a7-41e2-aa76-58c711f8a4a9",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "Le lundi, dix-huitième jour du mois d’août 1572, il y avait grande fête au Louvre.\nLes fenêtres de la vieille demeure royale, ordinairement si sombres, étaient ardemment éclairées ; […]."
                                            },
                                            {
                                                "example_id": "7109dafb-6ad4-4ac8-b6ea-dfc946e4d786",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "D’autres […] pratiquent dans le nez des lésions simulant les ulcères de la morve, et cautérisent adroitement les dilacérations, ordinairement avec le nitrate d’argent."
                                            },
                                            {
                                                "example_id": "8126c846-95e7-4b4a-9cda-e7b2f8c76e5c",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "Madame C*** se levait ordinairement vers les cinq heures du matin pour aller se promener dans un petit bosquet au bout de son jardin."
                                            },
                                            {
                                                "example_id": "30aced04-5617-4a16-a653-aa3b23e7b561",
                                                "sense_id": "c3e3ae05-e1ce-3e4c-82c3-247359d3bbcf",
                                                "text": "Qu'elle vienne samedi ou dimanche après dîner à Saint-Cyr ; ce sont les jours où j'y vais le plus ordinairement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
