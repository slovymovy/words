                        "entry_id": "ef517c8a-ffb9-339c-8757-218a0ad86276",
                        "glosses": [
                            "Composant de la structure d’un aéronef, comme le fuselage ou les ailes, à l’exception du système de propulsion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e4dc71-6d81-4b70-b76d-de5eb3c30137",
                                "sense_id": "69ded299-4a8e-3db8-88f2-75191eb5b50c",
                                "text": "Une telle expansion permettrait de fabriquer et d’assembler des systèmes d’aérostructure et de trains d’atterrissage."
                            },
                            {
                                "example_id": "3805422e-2a10-4c9d-ad5c-8af8066368aa",
                                "sense_id": "69ded299-4a8e-3db8-88f2-75191eb5b50c",
                                "text": "Héroux préfère garder son argent pour financer une éventuelle acquisition dans le secteur de l’aérostructure ou des trains d’atterrissage."
                            },
                            {
                                "example_id": "b2c8db34-c029-4952-a882-1ce85d08336b",
                                "sense_id": "69ded299-4a8e-3db8-88f2-75191eb5b50c",
                                "text": "La Division est aussi impliquée dans le segment aérostructure, fournissant des constructeur du monde entier."
                            }
                        ]
