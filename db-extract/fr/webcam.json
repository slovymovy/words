                "translations": [
                    {
                        "translation_id": "d8d8a94f-1c3e-469e-a35c-3fecf42d297a",
                        "source_entry_id": "c87796fb-1c40-3dc1-9c49-88fbc2dd5bd4",
                        "source_sense_id": "1bc96d62-1399-3bdb-9dcf-d8a31041e08a",
                        "target_lang_word": "webcam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "webcam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "685b3472-b3a3-36bf-9a0c-575a1505353d",
                                        "entry_id": "5caf4c26-db5a-32ff-83d3-b7a602e14ae4",
                                        "glosses": [
                                            "A video camera whose output may be viewed in real time over a computer network, originally the World Wide Web."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "906ba26f-2a3d-48ef-ad0a-adcfa6f3cd2d",
                                                "sense_id": "685b3472-b3a3-36bf-9a0c-575a1505353d",
                                                "text": "And while the Webcams focused on street scenes and other public gathering spots do seem to occupy an uncertain status as a new medium, they perhaps raise an ethical question: Is this the cinéma vérité of cyberspace or is it private surveillance?"
                                            },
                                            {
                                                "example_id": "925278ba-d96d-471b-9036-b265a9afb702",
                                                "sense_id": "685b3472-b3a3-36bf-9a0c-575a1505353d",
                                                "text": "As Covid-19 lockdowns took effect around the world, millions turned to remote working and organising virtual hangouts with friends. Overnight, webcams went from mundane computer accessories to gold dust."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "webcam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4c7456-2276-340c-a8f6-362e9ceaf598",
                                        "entry_id": "c199ec3f-76c2-3988-9da1-ee58278a5c5c",
                                        "glosses": [
                                            "To take part in a video communication using a webcam."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dcefa0f-d431-44dd-b63f-279fa4420309",
                                                "sense_id": "4f4c7456-2276-340c-a8f6-362e9ceaf598",
                                                "text": "I got on his computer and wrote the note. I swear there was nothing on his screen like he was webcamming with her but she must have been recording."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65574710-165b-3e72-83b9-eb2ab0c70a5e",
                                        "entry_id": "c199ec3f-76c2-3988-9da1-ee58278a5c5c",
                                        "glosses": [
                                            "To film and broadcast with a webcam."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "806dbecd-9a9e-4114-b8a7-24a36557ae6f",
                                                "sense_id": "65574710-165b-3e72-83b9-eb2ab0c70a5e",
                                                "text": "We should webcam it."
                                            }
                                        ]
                                    }
                                ]
                            }
