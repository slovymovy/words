                "senses": [
                    {
                        "sense_id": "e9ff3ece-a1a1-3e7f-a255-85108791e8e9",
                        "entry_id": "cd1c9760-a8dd-31d7-a8c7-63fd83de3e38",
                        "glosses": [
                            "S’apprivoiser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8f049f-d430-4cb1-9ecf-587d0360305f",
                                "sense_id": "e9ff3ece-a1a1-3e7f-a255-85108791e8e9",
                                "text": "C'est un peu comme si l'oiseau ou la souris se mettait à s'approcher du chat et s'autoapprivoiser avec lui."
                            },
                            {
                                "example_id": "df07c518-996a-4c44-8575-c48f5de4405b",
                                "sense_id": "e9ff3ece-a1a1-3e7f-a255-85108791e8e9",
                                "text": "Mine de rien, le game est un outil inespéré pour apprendre à s'autoapprivoiser."
                            },
                            {
                                "example_id": "d43a58cc-6e4e-4929-b8d9-64e2bb3b88c3",
                                "sense_id": "e9ff3ece-a1a1-3e7f-a255-85108791e8e9",
                                "text": "Je crois profondémment que seule la Vérité avec un grand V aurait pu nous rassembler : tout le reste n'est que division et j'avais plaisir à cet exercice de patience fraternel qui consiste à s'autoapprivoiser et à apprendre à s'aimer...comme des frères (ou soeurs)"
                            }
                        ]
                    }
