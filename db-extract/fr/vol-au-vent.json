                "senses": [
                    {
                        "sense_id": "8f815aab-2646-3cdb-befb-7fabf9ca5c9e",
                        "entry_id": "b168d5e1-6842-38f1-9702-03178295399e",
                        "glosses": [
                            "Timbale en pâte feuilletée très légère, dont les bords sont assez hauts, pouvant être garnie de poissons, de quenelles, de ris de veau, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c4b430-f711-40cd-922d-0dc7830eceb0",
                                "sense_id": "8f815aab-2646-3cdb-befb-7fabf9ca5c9e",
                                "text": "Vol-au-vent à la financière."
                            },
                            {
                                "example_id": "ca6d17ee-20cd-48db-ba20-f460e921ddf5",
                                "sense_id": "8f815aab-2646-3cdb-befb-7fabf9ca5c9e",
                                "text": "Ce pâtissier est renommé pour ses vol-au-vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "6431e37f-fb1e-3649-8237-f4149708ff47",
                        "entry_id": "b168d5e1-6842-38f1-9702-03178295399e",
                        "glosses": [
                            "Plat chaud, constitué d’une telle timbale garnie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901af27b-d4dd-4843-bc9a-4840a7594a06",
                                "sense_id": "6431e37f-fb1e-3649-8237-f4149708ff47",
                                "text": "La chère y était fine et, cependant, à un prix raisonnable. Il y eut du vol-au-vent, des épinards à la crème, du pintadon rôti."
                            },
                            {
                                "example_id": "55725bb3-6625-4de2-96be-b7985ef5ebc8",
                                "sense_id": "6431e37f-fb1e-3649-8237-f4149708ff47",
                                "text": "Il aimait les nourritures robustes : perdrix aux choux, vol-au-vent de poulet, canard aux olives, râble de lièvre, pâtés, tartes, tourtes, frangipanes, flognardes, clafoutis."
                            }
                        ]
                    }
