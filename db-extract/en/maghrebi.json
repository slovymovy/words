                    }
                ],
                "senses": [
                    {
                        "sense_id": "abf54cb3-4f66-35ff-beb9-77b685601daa",
                        "entry_id": "9656d626-ef51-3c8a-a0e9-6e46df6d0bb8",
                        "glosses": [
                            "A native or inhabitant of the Maghreb."
                        ],
                        "tags": [],
