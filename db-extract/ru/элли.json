                                    {
                                        "sense_id": "19f401e4-76cc-322c-9b39-dce7ae87e0fd",
                                        "entry_id": "2a3146f4-6c34-3272-aa4e-74eaacb49227",
                                        "glosses": [
                                            "A diminutive of the female given names Eleanor, Elizabeth, or Elena."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3895b268-ffa5-4beb-8f79-e4a8106041db",
                                                "sense_id": "19f401e4-76cc-322c-9b39-dce7ae87e0fd",
                                                "text": "\"It's funny, because when Ellie was born, I really hoped she'd turn out like this, feisty and rebellious and loud and bright. That's why I called her Eleanor Toyah.\"\n\"Is that something classical?\" Fiona asked.\n\"No, it's pop,\" said Will. Fiona laughed, although Will couldn't see why. \"Toyah Wilcox.\""
                                            }
                                        ]
                                    },
