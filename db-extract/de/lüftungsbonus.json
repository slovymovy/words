                        "glosses": [
                            "Möglichkeit der Reduzierung der errechneten Lüftungsverluste beim Heizbedarf von Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae666a1f-19a3-471e-b52c-6076c652f054",
                                "sense_id": "e45d4af6-153a-3150-93ba-a5bbb2a14275",
                                "text": "„Darüberhinaus gewährt der erfolgreich abgeschlossene Blower – Door – Test als Qualitätskontrolle für alle beheizten Neubauten einen Lüftungsbonus von 15 % bei der Berechnung des Energiebedarfs, d.h. die errechneten Wärmeverluste durch das ungewollte Entweichen von warmer Raumluft dürfen vom Planer um satte 15 % reduziert werden.“"
                            }
                        ],
