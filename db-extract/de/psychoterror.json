                ],
                "senses": [
                    {
                        "sense_id": "78f4e330-f2b0-3f00-a6dd-d470aafe5679",
                        "entry_id": "4aa937b8-8f7e-3c44-922e-89cbd8effa1a",
                        "glosses": [
                            "das Ausüben seelischer Gewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db3ff6f-6ba2-4ec6-a55a-bf17f437504b",
                                "sense_id": "78f4e330-f2b0-3f00-a6dd-d470aafe5679",
                                "text": "„Von da an reichen den Freitaler Terroristen Psychoterror und Anschläge auf Autos, Briefkästen oder Parteibüros nicht mehr aus.“"
                            },
                            {
                                "example_id": "ca7ccffe-906d-49c6-bd3e-bcff42c2e18d",
                                "sense_id": "78f4e330-f2b0-3f00-a6dd-d470aafe5679",
                                "text": "Was dann passierte, kann man nur als reinsten Psychoterror bezeichnen."
                            },
                            {
                                "example_id": "016ffe41-f24e-465a-b9dc-95fb1bccc2f3",
                                "sense_id": "78f4e330-f2b0-3f00-a6dd-d470aafe5679",
                                "text": "„Bossing ist eine Form des Mobbings, die von Führungskräften ausgeht[, d]abei werden Mitarbeitende durch systematische Schikanen und Psychoterror gezielt eingeschüchtert und manipuliert.“"
                            },
                            {
                                "example_id": "71d5d097-c488-48a4-a8f9-65334f6b7de2",
                                "sense_id": "78f4e330-f2b0-3f00-a6dd-d470aafe5679",
                                "text": "„Die Mafia geht mit Verleumdung und Psychoterror gegen ihre Gegner vor.“"
                            },
                            {
                                "example_id": "1c9ad6fa-bc07-4035-857e-78d9a5db9c90",
                                "sense_id": "78f4e330-f2b0-3f00-a6dd-d470aafe5679",
                                "text": "„Dem Psychoterror, den die PKK unter der großen friedlichen Mehrheit ihrer Landsleute in Deutschland verbreitet, kommen die Juristen nicht bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
