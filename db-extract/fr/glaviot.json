            {
                "entry_id": "1de1378e-4467-34bd-9faf-9c7bb669bf0b",
                "word": "glaviot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e5716cc-c7bc-4b23-badd-d498f66b951f",
                        "entry_id": "1de1378e-4467-34bd-9faf-9c7bb669bf0b",
                        "tags": [
