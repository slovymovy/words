                    {
                        "sense_id": "eda3da2a-1601-3167-82ca-be4e544a0470",
                        "entry_id": "d1cf90e0-3cec-32c6-8c52-ac0107f392c0",
                        "glosses": [
                            "stootstang voor en achter op de auto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ecc2593-98f3-47e1-8949-d1f7651cac38",
                                "sense_id": "eda3da2a-1601-3167-82ca-be4e544a0470",
                                "text": "Ik heb sensoren in mijn achterbumper om botsingen te voorkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96d6ff46-f140-4687-8db5-c4d796561bcd",
                        "source_entry_id": "d1cf90e0-3cec-32c6-8c52-ac0107f392c0",
                        "source_sense_id": "eda3da2a-1601-3167-82ca-be4e544a0470",
                        "source_sense_description": "stootstang",
                        "target_lang_word": "Stoßstange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoßstange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                        "entry_id": "8ffbf6e6-0af9-33e1-bc7b-a7efa7d3c163",
                                        "glosses": [
                                            "der im Allgemeinen vorderste beziehungsweise hinterste Teil eines Autos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298c544-84aa-4d7d-9725-f82744ce3c11",
                                                "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                                "text": "„Als er in der Nacht zum Montag gegen 1.30 Uhr zurückkam, entdeckte er, dass die Stoßstange vorne links verkratzt war.“"
                                            },
                                            {
                                                "example_id": "a4b33f34-5406-49ce-aa7d-a1ffde064300",
                                                "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                                "text": "„Fast in allen Wohnstraßen das gleiche Bild: Die Autos stehen Stoßstange an Stoßstange am Straßenrand, dazwischen Transporter von Kleinunternehmern, manchmal auch noch ein Anhänger.“"
                                            },
                                            {
                                                "example_id": "4b70d9dc-6844-44a7-b961-fa028bcbb67e",
                                                "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                                "text": "„Stoßstange an Stoßstange folgte er dem Auto Dr. Prachers, das sich durch den Verkehr quälte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fbaab8f-665f-32d0-818f-62d1114b55f6",
                                        "entry_id": "8ffbf6e6-0af9-33e1-bc7b-a7efa7d3c163",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "064211c4-2731-4dd4-a1c3-7b10ae9eaefe",
                                                "sense_id": "1fbaab8f-665f-32d0-818f-62d1114b55f6",
                                                "text": "„Abweichend von der Anordnung beim Ricardo-Motor werden die hängenden Ventile über Stoßstangen betätigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
