                ],
                "senses": [
                    {
                        "sense_id": "5c65f085-3354-3e00-bc02-e8ea0b221872",
                        "entry_id": "d5b0b88a-d9b0-3438-a5e8-28152623985c",
                        "glosses": [
                            "der Trieb von Herdentieren, in Herden zusammenzuleben und der Herde zu folgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e6a8266-e1e8-4807-af37-1199924a7dbd",
                                "sense_id": "5c65f085-3354-3e00-bc02-e8ea0b221872",
                                "text": "„Die Kühe einer Herde wenden sich beim Weiden bevorzugt in dieselbe Richtung. Die warme Sonne, der kalte Wind und der Herdentrieb mussten bereits als Erklärung dafür herhalten.“"
                            },
                            {
                                "example_id": "5090fd46-8f59-4079-8841-4a65b5178357",
                                "sense_id": "5c65f085-3354-3e00-bc02-e8ea0b221872",
                                "text": "„Die Theorie zum Herdentrieb des Triceratops lässt sich mit Funden bestätigen, bei denen eine große Zahl an Triceratops nebeneinander lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                        "entry_id": "d5b0b88a-d9b0-3438-a5e8-28152623985c",
                        "glosses": [
                            "die Neigung, sich sozialen Gruppen und deren Führern anzuschließen und deren Verhalten nachzuahmen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6c30ecd5-4199-4c89-8333-8753e2e351a2",
                                "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                "text": "„Der uns angeborene Herdentrieb wird auch an Fußgängerampeln wirksam.“"
                            },
                            {
                                "example_id": "7c2936c7-e964-4aa3-bd92-5116f8193879",
                                "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                "text": "„Ein bekannter Ökonom vertritt die Auffassung, dass der Herdentrieb zahlreiche Finanzmarktteilnehmer in die Irre geführt hat.“"
                            },
                            {
                                "example_id": "fc7e1210-bb9f-44ee-b579-05dc4af77da4",
                                "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                "text": "„Ich war eigentlich kein Fan von solchen Veranstaltungen, aber hier war der Herdentrieb unersetzlich, um die Angst zu überwinden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
