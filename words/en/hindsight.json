{
    "word_family": [
        "hind",
        "sight"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a27db26-4492-3308-9096-0012b5285913",
                    "sense_definition": "Realization or understanding of the significance and nature of events after they have occurred.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>hindsight</w>, I realize that I should have studied harder for the exam.",
                            "target_lang_translations": {
                                "ru": "Оглядываясь <w>назад</w>, я понимаю, что мне следовало усерднее готовиться к экзамену."
                            }
                        },
                        {
                            "text": "With the benefit of <w>hindsight</w>, we can see that the decision was a mistake.",
                            "target_lang_translations": {
                                "ru": "Оценивая ситуацию <w>задним числом</w>, мы видим, что это решение было ошибкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "retrospect"
                    ],
                    "antonyms": [
                        "foresight"
                    ],
                    "common_phrases": [
                        "benefit of hindsight",
                        "with hindsight",
                        "in hindsight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознание или понимание значения и характера событий после того, как они уже произошли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд в прошлое",
                                "target_lang_sense_clarification": "оценка событий задним числом"
                            },
                            {
                                "target_lang_word": "ретроспективный взгляд",
                                "target_lang_sense_clarification": "анализ произошедшего"
                            },
                            {
                                "target_lang_word": "оценка задним числом",
                                "target_lang_sense_clarification": "понимание после совершения событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c0f25a9-77b1-3a5a-8b52-b34e7b1862d0",
                    "sense_definition": "The rear sight of a firearm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "firearm_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He adjusted the <w>hindsight</w> of his rifle to improve his shooting accuracy.",
                            "target_lang_translations": {
                                "ru": "Он отрегулировал <w>целик</w> своей винтовки, чтобы повысить точность стрельбы."
                            }
                        },
                        {
                            "text": "The target was difficult to align because the <w>hindsight</w> was slightly damaged.",
                            "target_lang_translations": {
                                "ru": "Было трудно прицелиться, так как <w>задний прицел</w> был слегка поврежден."
                            }
                        }
                    ],
                    "synonyms": [
                        "rear sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заднее прицельное приспособление огнестрельного оружия (целик)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целик",
                                "target_lang_sense_clarification": "задняя часть прицела оружия"
                            },
                            {
                                "target_lang_word": "задний прицел",
                                "target_lang_sense_clarification": "прицельное приспособление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}