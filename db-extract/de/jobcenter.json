                ],
                "senses": [
                    {
                        "sense_id": "70958af8-8dcc-351d-ab4c-a7798b44dc93",
                        "entry_id": "7cc59953-83bf-3313-878b-50bfd5add423",
                        "glosses": [
                            "eine aus einem Zusammenschluss von Arbeitsagenturen und Sozialämtern bestehende Einrichtung zur Betreuung von Arbeitslosengeld-II-Empfängerinnen und -Empfängern bzw. Bürgergeld-Empfängerinnen und -Empfängern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0d98c81-d233-49c1-8fcd-b0ecb9081203",
                                "sense_id": "70958af8-8dcc-351d-ab4c-a7798b44dc93",
                                "text": "Wer vom Staat Leistungen erhält, soll auch selbst was leisten, weshalb das Jobcenter zum Beispiel langzeitarbeitslosen Menschen Arbeitsgelegenheiten vermittelt, die in Freiburg von verschiedenen Trägern angeboten werden und zu einer Stelle auf dem Arbeitsmarkt hinführen sollen."
                            },
                            {
                                "example_id": "bd6d7836-f664-4940-89ae-fef3df4c00e7",
                                "sense_id": "70958af8-8dcc-351d-ab4c-a7798b44dc93",
                                "text": "Bundestag und Bundesrat hatten 2010 beschlossen , dass sich 41 Kommunen zusätzlich - also insgesamt 110 - in Eigenregie um die Hartz-IV-Empfänger kümmern dürfen und dabei nicht mit der Bundesagentur für Arbeit (BA) in den Jobcentern kooperieren müssen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f001fcce-d6b2-3a7f-9507-a363a47ecb25",
                        "entry_id": "7cc59953-83bf-3313-878b-50bfd5add423",
                        "glosses": [
                            "ein Angebot oder Unternehmen zur Vermittlung von Arbeitsplätzen und Jobs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737b70a1-219d-448d-a8b4-1671cbe2dee8",
                                "sense_id": "f001fcce-d6b2-3a7f-9507-a363a47ecb25",
                                "text": "Wenn Jobcenter rechtswidrige Ein-Euro-Jobs vermitteln, können Arbeitslosengeld-II-Empfänger mehr Geld für ihre Arbeit fordern, entschied das Gericht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
