                ],
                "senses": [
                    {
                        "sense_id": "2e4df1aa-8066-317a-af77-551a51cf102f",
                        "entry_id": "8b1cdb8c-74be-3c19-a49f-4695cc929f84",
                        "glosses": [
                            "устар., книжн. то же, что страдать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4b6853-2496-4726-8893-f287b669d75a",
                                "sense_id": "2e4df1aa-8066-317a-af77-551a51cf102f",
                                "text": "Из письма к дядюшке увидишь ты, что бедный брат страждет."
                            },
                            {
                                "example_id": "28400823-0dfa-4b9c-8444-60a3a6abe549",
                                "sense_id": "2e4df1aa-8066-317a-af77-551a51cf102f",
                                "text": "Наш чудак так обрадовался этой благодати, что, закопавшись в пыльном архивном хламе, не мог даже и видеть, что вокруг него происходит: кто кого угнетает и кто от кого страждет."
                            },
                            {
                                "example_id": "7d734ab5-f0aa-40cb-ab27-e3b7d69668d4",
                                "sense_id": "2e4df1aa-8066-317a-af77-551a51cf102f",
                                "text": "Полдень, мой друг, я стражду."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40d6421e-ef9a-41cd-9722-53f1633c8cb7",
                        "source_entry_id": "8b1cdb8c-74be-3c19-a49f-4695cc929f84",
                        "source_sense_id": "2e4df1aa-8066-317a-af77-551a51cf102f",
                        "target_lang_word": "suffer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cacbfa2b-1199-3502-8c03-3a84518f98ef",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To undergo hardship."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59997073-368c-49b2-89a3-74f67ced3536",
                                                "sense_id": "cacbfa2b-1199-3502-8c03-3a84518f98ef",
                                                "text": "Many artists suffer before becoming famous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c9a474-b38b-3c39-8282-9769a518d487",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To feel pain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b53b07-443e-4b6b-a5c5-2f7749f8316c",
                                                "sense_id": "66c9a474-b38b-3c39-8282-9769a518d487",
                                                "text": "At least he didn't suffer when he died in the car crash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To become worse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608db170-2d4e-4154-8008-4403fabb34e4",
                                                "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                                                "text": "If you keep partying like this, your school-work will suffer."
                                            },
                                            {
                                                "example_id": "5d98fc6d-6320-4163-b577-b3f73bf8ca25",
                                                "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                                                "text": "Our correspondent found that timekeeping had suffered following the substitution of Class 5 4-6-0s on these workings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To endure, undergo."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c503c889-394e-48c3-be20-2f23dff4e1c4",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "I've been suffering your insults for years."
                                            },
                                            {
                                                "example_id": "bfbed1af-e154-4a9b-a68a-ba3e871582eb",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "We hope you never have to suffer the same pain."
                                            },
                                            {
                                                "example_id": "a1842a98-1477-414d-9e1a-55a88150746a",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "If you may pleaſe to thinke I loue the King, / And through him, what’s neereſt to him, which is / Your gracious ſelfe; embrace but my direction, / If your more ponderous and ſetled proiect may ſuffer alteration."
                                            },
                                            {
                                                "example_id": "c778bb48-0b6c-4d25-8c1b-3752350a2908",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To allow."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6141434-9c67-4570-8ca0-8305561bad94",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "Thou shalt not suffer a witch to liue."
                                            },
                                            {
                                                "example_id": "f3cc9212-47a7-4d74-9193-e32a2012fab7",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "But Iesus said, Suffer little children, and forbid them not to come vnto me: for of such is þe kingdome of heauen."
                                            },
                                            {
                                                "example_id": "66bc7a8f-4aeb-44fb-8a6a-794f0e7203e0",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "These constitute the important inflectional changes that have taken place in Modern English. There are other grammatical changes, mostly syntactical in their nature, into which the limits of this work do not suffer us to enter."
                                            },
                                            {
                                                "example_id": "44bc82f8-eae6-4bf2-9e55-ef7127780c6b",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "\"Employ\" includes to suffer or permit to work."
                                            },
                                            {
                                                "example_id": "f090223c-d698-4ad5-9d1f-2033540020d6",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "[…] it shall be unlawful for any person to cause, allow, permit or suffer any vehicle to be parked […] beyond the period of time established by the duration of the parking meter […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
