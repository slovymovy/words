                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fbde53c-35d9-48b9-ae8b-326f6e59526f",
                                "sense_id": "0550e0b8-ce34-368f-b011-986eb8d99d8c",
                                "text": "„Zwölf Jahre später fanden sie, zusammen mit dem bis anhin weiter im Gemeindehaus tagenden Kantonsrat, im neuen Repräsentativbau der Kantonalbank eine Bleibe.“"
                            },
                            {
                                "example_id": "018b9a80-afb3-4c55-90e3-821d00c82620",
                                "sense_id": "0550e0b8-ce34-368f-b011-986eb8d99d8c",
                                "text": "„In dem zum Verlaufen ausladenden Repräsentativbau aus sehr guten alten Zeiten gleich dahinter nimmt Irina Anghelescu diejenigen auf, die zu besagten Zeiten als die Aviatoren noch Helden waren - \"gefallene Mädchen\" genannt worden wären.“"
                            },
                            {
                                "example_id": "a06111aa-f740-458c-b594-ba5acd98e076",
                                "sense_id": "0550e0b8-ce34-368f-b011-986eb8d99d8c",
                                "text": "„im Gegensatz dazu wirkt die Frontalansicht, die mit antikem Giebel einen Repräsentativbau im üblichen klassizistischen Stil vortäuscht, eher konservativ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
