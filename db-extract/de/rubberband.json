                "senses": [
                    {
                        "sense_id": "67f3d901-3199-30ab-9ba1-f720e48bcea0",
                        "entry_id": "a98a01b6-49fb-3314-a207-8544c51162a3",
                        "glosses": [
                            "elastisches dehnfähiges Fitnessband aus Gummi"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "305f2f0a-6050-450b-9813-c47562e977ff",
                                "sense_id": "67f3d901-3199-30ab-9ba1-f720e48bcea0",
                                "text": "„Nach den Dehnübungen folgt dann das individuelle Personal Training, mit z. B. Functional Training, Kraftübungen (z. B. mit Slingtrainer, Rubberband, Kurzhanteln, Pilatesball o.ä [sic!]), effektives Bauchmuskeltraining oder Ausdauertraining, immer gefolgt von einem Cooling-Down.“"
                            },
                            {
                                "example_id": "cc1653ad-7960-4d38-af66-2a2a70277b21",
                                "sense_id": "67f3d901-3199-30ab-9ba1-f720e48bcea0",
                                "text": "„Im Gegensatz zu den Thera- und Tubingbändern ist das Miniband – auch Rubberband oder Loopband genannt – geschlossen und deutlich kürzer.“"
                            },
                            {
                                "example_id": "32b278db-842b-404c-9653-f9319a8204cf",
                                "sense_id": "67f3d901-3199-30ab-9ba1-f720e48bcea0",
                                "text": "„Für uns ist das Rubberband ein nahezu perfektes Trainingstool, denn es ist so klein und leicht, dass es in jede Tasche passt und auf Reisen mit dabei sein kann.“"
                            },
                            {
                                "example_id": "8d6942ff-f9e8-4d38-82b7-0050ae56c952",
                                "sense_id": "67f3d901-3199-30ab-9ba1-f720e48bcea0",
                                "text": "„Das Rubberband der Grundstufe ist gelb, die nächste Stufe ist rot, und am schwersten sind die Übungen mit dem grünen Band.“"
                            },
                            {
                                "example_id": "bab73b64-89b0-4a9b-8b02-b258d04af5b5",
                                "sense_id": "67f3d901-3199-30ab-9ba1-f720e48bcea0",
                                "text": "„Funktionelle Übungen mit Kleingeräten (Softball, Rubberband, Bohnensäckchen, Tücher usw.) werden ebenso durchgeführt wie Gymnastik mit dem Stuhl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
