                        "entry_id": "270bdd18-68b8-36b3-bc07-c1beeee3ede0",
                        "glosses": [
                            "Populärname für das Higgs-Boson, ein Elementarteilchen, das im Standardmodell der Teilchenphysik vorhergesagt und erstmals 2012 am CERN nachgewiesen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4bf133-e394-4189-99fd-59b98654031a",
                                "sense_id": "6f173f70-5084-31a2-9b29-f02bbfd24253",
                                "text": "Am CERN glaubt man, das Gottesteilchen gefunden zu haben."
                            },
                            {
                                "example_id": "eb9caf7c-53e0-4132-b405-cf8b4e2b9e60",
                                "sense_id": "6f173f70-5084-31a2-9b29-f02bbfd24253",
                                "text": "„Wenn sich die Erkenntnisse als richtig erweisen und Forscher tatsächlich das sogenannte Gottesteilchen entdeckt haben, dann sei dies ein bahnbrechender Fund - das sagt der Wissenschaftler und ARD-Moderator Ranga Yogeshwar. Auf den Begriff \"Gottesteilchen\" möchte er aber lieber verzichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
