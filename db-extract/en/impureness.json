                                        "examples": [
                                            {
                                                "example_id": "ebccaa22-ef94-48ce-8068-60a46562b9e7",
                                                "sense_id": "83aac55f-44a7-3715-81d4-7d0d37a219d3",
                                                "text": "„Wegen angeblicher Unreinheit verbietet Rußland Wein-Importe aus Moldau und Georgien.“"
                                            },
                                            {
                                                "example_id": "f6251f07-ada1-4701-99fb-f60e29f38272",
                                                "sense_id": "83aac55f-44a7-3715-81d4-7d0d37a219d3",
                                                "text": "„In der arabischen Welt gibt es wohl kein anderes Kleidungsstück, mit dem sich mehr Verachtung ausdrücken ließe: Der Schuh gilt als Inbegriff von Unreinheit und Schmutz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                        "entry_id": "34d69862-7c37-3f0e-9f1d-eba7a7689d6c",
