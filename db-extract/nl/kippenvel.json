                    {
                        "translation_id": "63f72fd0-2924-45f2-8cdb-96b87dad120f",
                        "source_entry_id": "f8bb4b49-2d6d-3af2-b54a-d72fd6f74e8b",
                        "source_sense_id": "78149f98-3eff-3119-8888-f9930fab22cb",
                        "source_sense_description": "het verschijnsel waarbij als gevolg van kou de huid gaat kleine bubbeltjes vertoont",
                        "target_lang_word": "chair de poule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chair de poule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad9c652c-e086-30b7-ae8a-cd84fb4969ae",
                                        "entry_id": "742f0ef0-95b5-3703-a760-2854bf0b92a9",
                                        "glosses": [
                                            "Hérissement des poils de la peau, souvent dans le cou ou sur les bras, causée par le froid (ou la peur, au moins dans la tradition populaire)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed767a7-fdcd-4644-9a9b-b0feeb2c5e97",
                                                "sense_id": "ad9c652c-e086-30b7-ae8a-cd84fb4969ae",
                                                "text": "À certains moments, le son s’étranglait à vous donner la chair de poule, même en sachant ce que c’était, tant il y avait dans cette musique de menaces ancestrales.\nBelle invention ces cors de chasse !"
                                            },
                                            {
                                                "example_id": "56b81eca-d5f3-4818-aaaa-d4d510c04380",
                                                "sense_id": "ad9c652c-e086-30b7-ae8a-cd84fb4969ae",
                                                "text": "Cependant, nos chères femmes, penchées à la fenêtre, poussaient des cris d’horreur et de dégoût, et ma mère frottait son avant-bras pour effacer la chair de poule."
                                            },
                                            {
                                                "example_id": "68e05a1e-4fdc-4387-a61b-cebabad04ed9",
                                                "sense_id": "ad9c652c-e086-30b7-ae8a-cd84fb4969ae",
                                                "text": "Et, vu la rareté des contrôles, une substance nettement plus méchante aurait pu tout aussi bien s’inviter. Ça file la chair de poule…"
                                            },
                                            {
                                                "example_id": "7de62699-8b9c-46fe-854b-a819b2cc2254",
                                                "sense_id": "ad9c652c-e086-30b7-ae8a-cd84fb4969ae",
                                                "text": "Elle regarde la banquette en chintz bleu qui lui donne la chair de poule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
