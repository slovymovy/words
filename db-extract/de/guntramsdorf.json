                "senses": [
                    {
                        "sense_id": "062d8b70-89c8-346d-8bd2-ec976a1e7ba6",
                        "entry_id": "93cb630c-cf0a-3e77-9055-f0ed9b63cd28",
                        "glosses": [
                            "niederösterreichische Marktgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e512ab76-0ad4-4a9d-b650-79764cdd5677",
                                "sense_id": "062d8b70-89c8-346d-8bd2-ec976a1e7ba6",
                                "text": "Die Lofts in der alten Mühle in Guntramsdorf gingen weg wie die warmen Semmeln."
                            },
                            {
                                "example_id": "16a88d51-3e43-4839-86f8-944a1d45a3be",
                                "sense_id": "062d8b70-89c8-346d-8bd2-ec976a1e7ba6",
                                "text": "Das letzte stärkere Erdbeben ereignete sich in Ostösterreich vor 41 Jahren. … In Guntramsdorf und in Schwarzau stürzten zwei ältere Gebäude ein, zwei Eisenkreuze fielen von den Türmen der Kirche."
                            },
                            {
                                "example_id": "18ccf709-8cf9-413a-8dfb-61e1bce90e18",
                                "sense_id": "062d8b70-89c8-346d-8bd2-ec976a1e7ba6",
                                "text": "Der Ozean in Guntramsdorf oder der Kahrteich in Wiener Neudorf sind deshalb entstanden, weil Lehm für die Ziegelproduktion in der Gründerzeit gebraucht wurde."
                            },
                            {
                                "example_id": "5d30d6a6-2ea7-40d3-b158-4a5eb78b87bd",
                                "sense_id": "062d8b70-89c8-346d-8bd2-ec976a1e7ba6",
                                "text": "Im Standort Guntramsdorf bieten wir Ihnen kompetente fachliche Beratung in den Bereichen Weinbau, Wein- und Obstverarbeitung und Kellerwirtschaft."
                            },
                            {
                                "example_id": "bddf3969-aec1-4819-bf6d-ab4339713952",
                                "sense_id": "062d8b70-89c8-346d-8bd2-ec976a1e7ba6",
                                "text": "Wenig bekannt ist, dass es in Guntramsdorf und Wiener Neudorf ein Konzentrationslager gab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
