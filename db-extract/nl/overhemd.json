                                        "entry_id": "73426c41-c559-3b30-b21d-c6c5bb078ee4",
                                        "glosses": [
                                            "To cover or clothe with a shirt, or as if with a shirt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbd2127-d4a5-4418-96c8-dee7897395ec",
                                                "sense_id": "4593f8ed-5fe5-3e04-abbd-5878ba98452d",
                                                "text": "1691, King Arthur, by John Dryden, act II, scene I.\nAh! for so many souls, as but this morn / Were clothed with flesh, and warm’d with vital blood / But naked now, or shirted just with air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shirt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95862d98-793b-3630-8561-3be37e6345c6",
                                        "entry_id": "5b8761e4-a797-3b02-beba-e719dd2a6a43",
                                        "glosses": [
                                            "An article of clothing that is worn on the upper part of the body, and often has sleeves, either long or short, that cover the arms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad900906-871f-49d2-991d-0d951f37acf1",
                                                "sense_id": "95862d98-793b-3630-8561-3be37e6345c6",
                                                "text": "He went to the mall to buy shirts his size."
                                            },
                                            {
                                                "example_id": "6dfee11d-26ac-441e-ab40-1924908c60a7",
                                                "sense_id": "95862d98-793b-3630-8561-3be37e6345c6",
                                                "text": "It can take a while to learn how to iron a shirt properly."
                                            },
                                            {
                                                "example_id": "9f3be2d4-f6b1-40e3-b310-1fcbef87e793",
                                                "sense_id": "95862d98-793b-3630-8561-3be37e6345c6",
                                                "text": "She had her shertes & gyrdyls of heere."
                                            },
                                            {
                                                "example_id": "b584cc3d-2111-4270-a496-35935087c37e",
                                                "sense_id": "95862d98-793b-3630-8561-3be37e6345c6",
                                                "text": "Several persons in December had nothing over their shoulders but their shirts."
                                            },
                                            {
                                                "example_id": "70eed3d4-4209-4f17-8243-ca030e5cf8fa",
                                                "sense_id": "95862d98-793b-3630-8561-3be37e6345c6",
                                                "text": "Holt was furious referee Michael Oliver refused to then award him a penalty after Ledley King appeared to pull his shirt and his anger was compounded when Spurs immediately levelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b8e79a-c474-38d7-a0c0-f933b71649b8",
                                        "entry_id": "5b8761e4-a797-3b02-beba-e719dd2a6a43",
                                        "glosses": [
                                            "An interior lining in a blast furnace."
                                        ],
                                        "tags": [],
