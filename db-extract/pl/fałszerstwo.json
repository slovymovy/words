                                "target_senses": [
                                    {
                                        "sense_id": "3ed32996-cb15-341d-8432-0509a3153811",
                                        "entry_id": "26e3c222-67c1-3c89-b3b7-c4ef8f1c7838",
                                        "glosses": [
                                            "The act of forging metal into shape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a2c37d6-218c-477d-9085-2ae10ce3f8ba",
                                                "sense_id": "3ed32996-cb15-341d-8432-0509a3153811",
                                                "text": "the forgery of horseshoes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b542cadc-4635-3a81-9767-6960c25f792b",
                                        "entry_id": "26e3c222-67c1-3c89-b3b7-c4ef8f1c7838",
                                        "glosses": [
                                            "The act of forging, fabricating, or producing falsely; especially the crime of fraudulently making or altering a writing or signature purporting to be made by another, the false making or material alteration of or addition to a written instrument for the purpose of deceit and fraud."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eba340fb-39e2-4fea-9dd0-087563478224",
                                                "sense_id": "b542cadc-4635-3a81-9767-6960c25f792b",
                                                "text": "the forgery of a bond"
                                            },
                                            {
                                                "example_id": "67453c55-5290-437e-9af6-5f23b9e0d997",
                                                "sense_id": "b542cadc-4635-3a81-9767-6960c25f792b",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a9d9f8-01e0-361e-a5fb-1cd579c4908f",
                                        "entry_id": "26e3c222-67c1-3c89-b3b7-c4ef8f1c7838",
                                        "glosses": [
                                            "That which is forged, fabricated, falsely devised or counterfeited."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "154cb325-6ce9-3ec3-adda-11381445c306",
                                        "entry_id": "26e3c222-67c1-3c89-b3b7-c4ef8f1c7838",
                                        "glosses": [
                                            "An invention, creation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6005a849-5bcf-41a0-aefb-2f8c4f916c69",
                        "source_entry_id": "d27800e5-21c4-39f1-8f9d-2a342040b078",
                        "source_sense_id": "5a620387-8b26-35f1-ab36-059163c4f8c6",
                        "target_lang_word": "falsification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                        "entry_id": "2970b7a4-6626-3a44-8474-f959952f2f4b",
                                        "glosses": [
                                            "Action de falsifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e456132-7c21-4887-aeb9-837dcbdbbf56",
                                                "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                                "text": "Une autre falsification, qu'opèrent les épureurs, se fait au moyen de l’huile de baleine, qu'on mélange avec celle épurée de colza par moitié, lorsque la différence des prix y donne lieu."
                                            },
                                            {
                                                "example_id": "fd10c86b-2a6e-40a6-8f3c-82be41c0e603",
                                                "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                                "text": "Il appartenait au gouvernement de montrer aux populations viticoles la périodicité inévitable des crises tant qu'il serait planté des ceps à tort et à travers, tant que producteurs et commerçants ne feraient pas la guerre aux falsifications."
                                            },
                                            {
                                                "example_id": "c1c4d987-aaaa-48db-8ed7-686c98fb8665",
                                                "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                                "text": "Face aux falsifications historiques massives venant de Moscou, il nous semble essentiel de rappeler certains faits incontestables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c23fa1-9b23-3516-a165-3f6a6a149b2c",
                                        "entry_id": "2970b7a4-6626-3a44-8474-f959952f2f4b",
                                        "glosses": [
                                            "En particulier, action de diminuer les performances du moteur en matière d'émissions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad64ac00-8063-4f43-a5d9-d1ae5bf437ab",
                                                "sense_id": "34c23fa1-9b23-3516-a165-3f6a6a149b2c",
                                                "text": "Les différents types de moteurs et familles de moteurs sont conçus et pourvus de stratégies de limitation des émissions de manière à prévenir les falsifications dans la mesure du possible. L'utilisation de stratégies d'invalidation est interdite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f98cd36-b9bc-4ebc-826a-dde80d0677ba",
                        "source_entry_id": "d27800e5-21c4-39f1-8f9d-2a342040b078",
                        "source_sense_id": "5a620387-8b26-35f1-ab36-059163c4f8c6",
