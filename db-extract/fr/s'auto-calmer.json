                        "entry_id": "ced96690-f3d0-37c7-b980-0a1f80662ba6",
                        "glosses": [
                            "Se calmer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4c8391-68b1-4a6b-ab8b-7c55109b66a4",
                                "sense_id": "e96f5e57-8278-3caf-9372-08ac14cbd857",
                                "text": "Message juste pour m'auto-calmer."
                            },
                            {
                                "example_id": "e5dfefc4-0100-4e53-a0ac-861ce1aff9bb",
                                "sense_id": "e96f5e57-8278-3caf-9372-08ac14cbd857",
                                "text": "En relaxant il favorise le sommeil, la capacité de gérer son environnement, de s'auto-calmer."
                            },
                            {
                                "example_id": "8628d224-aada-45bf-84aa-1e015054b43f",
                                "sense_id": "e96f5e57-8278-3caf-9372-08ac14cbd857",
                                "text": "Le mieux c'est qu'il puisse lui-même s'auto-calmer, se rassurer en la tétant."
                            }
                        ]
