                "senses": [
                    {
                        "sense_id": "44ae4175-4cc5-33de-b062-f5e219b57738",
                        "entry_id": "33e46d5f-d22a-3657-bafd-950ed93d6426",
                        "glosses": [
                            "een vrouw die naaiwerk verricht"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "e1bf7fb2-a14f-4e06-a5f1-7e080aef8a46",
                                "sense_id": "44ae4175-4cc5-33de-b062-f5e219b57738",
                                "text": "De naaister naaide al onze kapotte broeken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d32adeb0-3ff7-48bd-a4d0-8a6a2b4c8eeb",
                        "source_entry_id": "33e46d5f-d22a-3657-bafd-950ed93d6426",
                        "source_sense_id": "44ae4175-4cc5-33de-b062-f5e219b57738",
                        "source_sense_description": "een vrouw die naaiwerk verricht",
                        "target_lang_word": "Näherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Näherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                        "entry_id": "71dd254c-d039-35b5-8a89-c77a5505c859",
                                        "glosses": [
                                            "weibliche Person, die (meist beruflich) näht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c520b11f-c3da-4266-ac57-d8c94a4aba39",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "Er brachte seine kaputten Hemden zur Näherin."
                                            },
                                            {
                                                "example_id": "6edb511c-d8ee-4f17-b526-6daa5bffe864",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Mama arbeitet nicht mehr in der Produktion, sie hat eine Stelle als Näherin in einem der Kinderheime bekommen.“"
                                            },
                                            {
                                                "example_id": "06ccdf99-321f-46b5-9723-58c0f0fae5cb",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Die Näherin war schon bestellt, der Heiratsvertrag war aufgesetzt, da bekam der Bauer einen Schlaganfall und starb, ohne wieder zu sich gekommen zu sein.“"
                                            },
                                            {
                                                "example_id": "57f95e8d-906c-4ee3-a054-86141dbd1d88",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Auch dazu habe ich an anderer Stelle eine Nachkriegsvariante erzählt, wo eine Lehrerin in den Fünfzigerjahren ihre Schülerinnen fragt, was sie denn werden wollten, und die alle brav mit den damals typischen Frauenberufen antworteten: Stenotypistin will die eine werden, Näherin die andere, Kosmetikerin die dritte, und schließlich sagt eine, dass sie Prostituierte werden will.“"
                                            },
                                            {
                                                "example_id": "90520402-8762-40f6-9f50-60d4bfe2a176",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Offiziell war er der Singer-Ausbilder für die vielen Näherinnen der Region.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46c1fc7c-c7c9-4737-bce7-c5d42d05dd0d",
                        "source_entry_id": "33e46d5f-d22a-3657-bafd-950ed93d6426",
                        "source_sense_id": "44ae4175-4cc5-33de-b062-f5e219b57738",
                        "source_sense_description": "een vrouw die naaiwerk verricht",
                        "target_lang_word": "sewer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                                        "entry_id": "22dca22f-7086-3665-886f-2f79f856aa82",
                                        "glosses": [
                                            "A pipe or channel, or system of pipes or channels, used to remove human waste and to provide drainage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118e8a8d-156e-472c-8449-d0a7f91e912b",
                                                "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                                                "text": "He first learned about sewers last year in science class."
                                            },
                                            {
                                                "example_id": "869ba5aa-ad09-4c22-b937-e0a78ab13bd7",
                                                "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "084d4f14-581a-3361-8e57-b56509684d20",
                                        "entry_id": "98b833ae-6706-3b93-ba6c-fcf834492408",
                                        "glosses": [
                                            "To provide (a place) with a system of sewers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                                        "entry_id": "15052b04-7e8c-3ed9-98a7-6ce134d67ee7",
                                        "glosses": [
                                            "An official in charge of a princely household, also responsible for the ceremonial task of attending at dinners, seating the guests and serving dishes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec10901-bd6e-48ae-ae49-3f77cc28a622",
                                                "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                                                "text": "While the Saxon was plunged in these painful reflections, the door of their prison opened, and gave entrance to a sewer, holding his white rod of office."
                                            },
                                            {
                                                "example_id": "7c9c4f01-91d2-4adf-a208-3f295bc1f542",
                                                "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                                                "text": "His nephew Charles, meanwhile, had grown up in the royal household, working as a sewer, or waiter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "988c53f1-a60e-3ca1-8c24-99bd01f86993",
                                        "entry_id": "6cc41764-6864-3ade-b5e3-066373af4aaf",
                                        "glosses": [
                                            "One who sews."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2934ad4a-e7b5-450f-b468-9899d948bf22",
                                                "sense_id": "988c53f1-a60e-3ca1-8c24-99bd01f86993",
                                                "text": "Up under the roof three men are making boys’ jackets at twenty cents a piece, of which the sewer takes eight, the ironer three, the finisher five cents, and the buttonhole-maker two and a quarter, leaving a cent and three-quarters to pay for the drumming up, the fetching and bringing back of the goods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc6bb96-3c2d-3be2-84f9-cfe92e709c61",
                                        "entry_id": "6cc41764-6864-3ade-b5e3-066373af4aaf",
                                        "glosses": [
                                            "A small tortricid moth, the larva of which sews together the edges of a leaf using silk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeea2daa-fa35-4416-b94b-1f1ef7a76afb",
                                                "sense_id": "6fc6bb96-3c2d-3be2-84f9-cfe92e709c61",
                                                "text": "the apple-leaf sewer, Ancylis nubeculana"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8bc16ed-622d-4370-92ba-2f83c7b80646",
                        "source_entry_id": "33e46d5f-d22a-3657-bafd-950ed93d6426",
                        "source_sense_id": "44ae4175-4cc5-33de-b062-f5e219b57738",
                        "source_sense_description": "een vrouw die naaiwerk verricht",
                        "target_lang_word": "needlewoman",
