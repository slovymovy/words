                "senses": [
                    {
                        "sense_id": "48e876c8-778c-362e-a71c-e3671acf81ab",
                        "entry_id": "ab857095-38c1-37ac-8cdb-3db3fcb532fc",
                        "glosses": [
                            "Fibrinogen, das in seiner Funktion gestört ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6918e5d4-1513-4475-b71f-74f5e1bfb4c7",
                                "sense_id": "48e876c8-778c-362e-a71c-e3671acf81ab",
                                "text": "„Beim Lebewersagen werden dysfunktionale Proteine synthetisiert. So kann 2.8. das so synthetisierte Dysfibrinogen nicht mehr polymerisieren und ein festes Gerinnsel bilden.“"
                            },
                            {
                                "example_id": "2506360c-e958-4126-8f0e-0f011e954983",
                                "sense_id": "48e876c8-778c-362e-a71c-e3671acf81ab",
                                "text": "„Antithrombin III und Plasminogen waren normal und es gab keinen Hinweis auf ein Dysfibrinogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
