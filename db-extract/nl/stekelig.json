                        "entry_id": "8cc5a84a-b42f-3301-b4ec-a4a848b40a64",
                        "glosses": [
                            "met stekels bezet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67a4ccd-355d-4563-b6a0-32e23c2a5bec",
                                "sense_id": "967b201e-0856-33b4-af67-a5bcffcdae37",
                                "text": "Dat is wel een erg stekelige plant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0199acc9-e02a-4c31-af69-a46aabec1c0c",
                        "source_entry_id": "8cc5a84a-b42f-3301-b4ec-a4a848b40a64",
                        "source_sense_id": "967b201e-0856-33b4-af67-a5bcffcdae37",
                        "source_sense_description": "met stekels bezet",
                        "target_lang_word": "stachelig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stachelig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c4aa41-0710-37f7-bf79-22ca60219fa4",
                                        "entry_id": "b11f11c5-784e-3722-9d94-60f5243947ee",
                                        "glosses": [
                                            "mit Stacheln versehen, ausgestattet, besetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064413d6-70dc-44af-85b6-496390204b27",
                                                "sense_id": "e8c4aa41-0710-37f7-bf79-22ca60219fa4",
                                                "text": "Der Igel ist ein stacheliger Geselle."
                                            },
                                            {
                                                "example_id": "50206b36-987f-4960-8ded-e28073d574ce",
                                                "sense_id": "e8c4aa41-0710-37f7-bf79-22ca60219fa4",
                                                "text": "Um den Stieglitz in den Garten zu locken, muss es nur dessen Leibspeisen geben: Die Samen der stacheligen Kaden und Insekten, die an Pflanzen saugen."
                                            },
                                            {
                                                "example_id": "cac2ad91-0a96-4f17-a229-ca35ba2e1efe",
                                                "sense_id": "e8c4aa41-0710-37f7-bf79-22ca60219fa4",
                                                "text": "Seeigel kennen die meisten von uns nur aus dem Zoo oder vom Strandurlaub. Entweder, weil man gerade an einem vorbei geschnorchelt ist oder - im ungünstigsten Fall - weil man aus Versehen auf eines der stacheligen Tiere draufgetreten ist."
                                            },
                                            {
                                                "example_id": "532154db-085b-4a36-bdab-cca7995d626d",
                                                "sense_id": "e8c4aa41-0710-37f7-bf79-22ca60219fa4",
                                                "text": "Zum 300. Jubiläum des \"Act of Union\" wurde in London eine limitierte Anzahl von Zwei-Pfund-Münzen geprägt. Darauf sind die beiden stacheligen Nationalblumen der Insel zu sehen: die britische Rose, die schottische Distel - und natürlich die Queen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0963ca0-9db6-3cab-8e51-df7bee813c01",
                                        "entry_id": "b11f11c5-784e-3722-9d94-60f5243947ee",
                                        "glosses": [
                                            "gegen andere oder eigene Verhaltensweisen wirkend"
                                        ],
                                        "tags": [
                                            "charakterlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a248c7a-8052-49ba-9056-a3e4625243d8",
                                                "sense_id": "b0963ca0-9db6-3cab-8e51-df7bee813c01",
                                                "text": "Sei nicht so stachelig zu mir."
                                            },
                                            {
                                                "example_id": "c826904a-3630-4516-b8d0-03724a7e63c8",
                                                "sense_id": "b0963ca0-9db6-3cab-8e51-df7bee813c01",
                                                "text": "Nach [dem] Abgang [des Trainers Thomas] Tuchel vor anderthalb Jahren hatte [der Mainz 05-Präsident Harald] Strutz gesagt: \"Ich kam mir verraten vor.\" In diesen Tagen sagte er: \"Wir haben unterschiedliche Auffassungen von Respekt.\" Tuchel blieb zunächst cool, sagte dann aber leicht stachelig: \"Wie und wo er es gesagt hat, sagt am Ende mehr über ihn als über mich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3674200-ec34-4bcb-ba01-51920605b826",
                        "source_entry_id": "8cc5a84a-b42f-3301-b4ec-a4a848b40a64",
                        "source_sense_id": "967b201e-0856-33b4-af67-a5bcffcdae37",
                        "source_sense_description": "met stekels bezet",
                        "target_lang_word": "thorny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thorny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Having thorns or spines."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b81081e4-29c2-41fc-93c3-284f7cd37954",
                                                "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                                                "text": "Tara flour is one of two products made from the seed pods of a thorny shrub native to Peru. One of those, tara gum, has been used safely for years as a thickening agent or stabilizer in human foods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Troublesome or vexatious."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a94cb7-511d-4c40-813c-1356c206b800",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "thorny issues"
                                            },
                                            {
                                                "example_id": "4caabe0e-8af1-4430-9f7b-802d4901a127",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "the steep and thorny way to heaven"
                                            },
                                            {
                                                "example_id": "c344e867-dff1-4df0-b8ba-c0192ce0dc0d",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Westcott doesn’t even consider the thornier question of fan fiction based on real and often living people, for instance, the “bandslash” or “bandfic” phenomenon built around rock-star characters and often homoerotic subplots."
                                            },
                                            {
                                                "example_id": "0b74a2c4-3a7d-484a-9a06-ca24d689d039",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Six weeks into the renegotiation of the North American Free Trade Agreement, the thorniest issues surrounding the pact remain unresolved."
                                            },
                                            {
                                                "example_id": "d91a01af-009b-4c43-a477-59a6a70ba9b6",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Museums have recently begun to confront the same thorny question, with several issuing public apologies for collecting the remains of people believed or known to have been enslaved."
                                            },
                                            {
                                                "example_id": "c89aa11d-55c8-45f9-8c9d-e7996e57570d",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Station capacity in London, Paris, Brussels and Amsterdam remains a thorny issue, as does obtaining suitable Channel Tunnel-compliant trains."
                                            },
                                            {
                                                "example_id": "42e9dd9e-dc91-4480-8546-fc189c383552",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Mr. [Jake] Sullivan noted that turning away from thorny global issues like climate change would not stop them from posing a threat to the United States, and the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Aloof and irritable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c62bbd06-cb9a-4607-b5f1-d7fdb3351d2e",
                                                "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                                                "text": "Come, Jo, don't be thorny. After studying himself to a skeleton all the week, a fellow deserves petting, and ought to get it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
