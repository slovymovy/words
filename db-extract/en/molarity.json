                    },
                    {
                        "translation_id": "3b7aa18c-8986-48a7-966f-69482e2590d0",
                        "source_entry_id": "20063507-b92b-3617-bf5f-089994061b6b",
                        "source_sense_id": "28c9e29c-afc4-357a-8245-facb726ba490",
                        "source_sense_description": "moles per litre of a solution",
                        "target_lang_word": "Stoffmengenkonzentration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoffmengenkonzentration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f7586d5-5c2f-3ad3-a103-5e86487f9e86",
                                        "entry_id": "a72e945b-831d-3644-9177-4267b03e364f",
                                        "glosses": [
                                            "Gehaltsgröße zur Bestimmung der Konzentration einer chemischen Spezies, insbesondere eines gelösten Stoffes in Lösung im Sinne von Stoffmenge pro Volumeneinheit der Lösung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86026466-cb2c-4a7e-9855-e7e655019b4a",
                                                "sense_id": "9f7586d5-5c2f-3ad3-a103-5e86487f9e86",
                                                "text": "„Zu einer vollständigen Angabe der Stoffmengenkonzentration gehört neben der Speziesangabe i ferner auch die Angabe der Temperatur und evtl. des Drucks (siehe unten), bei Lösungen auch des Lösungsmittels (ist bei Lösungen kein Lösungsmittel angegeben, handelt es sich meist um eine wässrige Lösung).“"
                                            },
                                            {
                                                "example_id": "f6ef22b6-3c6e-4154-a048-5211b789c289",
                                                "sense_id": "9f7586d5-5c2f-3ad3-a103-5e86487f9e86",
                                                "text": "„Für Lösungen ist die gebräuchlichste Zusammensetzungsgröße die Stoffmengenkonzentration, weil aus dieser Größe die Stoffmenge eines gelösten Stoffs direkt aus dem Volumen der Lösung ermittelt werden kann.“"
                                            },
                                            {
                                                "example_id": "06662fbd-e15d-4f33-8aef-6fb57745c65f",
                                                "sense_id": "9f7586d5-5c2f-3ad3-a103-5e86487f9e86",
                                                "text": "„Die Stoffmengenkonzentration (Formelzeichen: c) ist der Quotient aus der Stoffmenge (n) eines gelösten Stoffes und dem Volumen (V) der Lösung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afa986da-25cb-4171-a923-682efdf99c10",
                        "source_entry_id": "20063507-b92b-3617-bf5f-089994061b6b",
                        "source_sense_id": "28c9e29c-afc4-357a-8245-facb726ba490",
                        "source_sense_description": "moles per litre of a solution",
                        "target_lang_word": "Molarität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molarität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5af582-6f3b-3188-ad7a-ef4255a8df5f",
                                        "entry_id": "6f106c87-532f-3c47-85fa-4616ced4be40",
                                        "glosses": [
                                            "Gehaltsgröße zur Beschreibung einer Lösung; sie gibt an, wieviel Mol eines Stoffes pro Liter Lösungsmittel gelöst sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8448b7b0-a825-4fee-a63c-735c441552f1",
                                                "sense_id": "5a5af582-6f3b-3188-ad7a-ef4255a8df5f",
                                                "text": "„Die Molarität einer gelösten Substanz ist aber nicht immer geeignet, um den osmotischen Druck und somit osmotische Prozesse vorherzusagen.“"
                                            },
                                            {
                                                "example_id": "8dc077ab-a0be-4335-8ad9-4f33950f16c9",
                                                "sense_id": "5a5af582-6f3b-3188-ad7a-ef4255a8df5f",
                                                "text": "„Allerdings hat die Molalität gegenüber der Stoffmengenkonzentration (Molarität) den Vorteil, dass sie unabhängig von thermisch bedingten Volumenänderungen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
