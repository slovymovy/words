                    {
                        "translation_id": "01274313-d597-45c3-b16b-7ff4df7c830a",
                        "source_entry_id": "7a14016a-afc1-3b14-b49d-d887608832b7",
                        "source_sense_id": "9dfd9304-8dc9-3bcf-96a7-ed3636ed250a",
                        "target_lang_word": "Lucie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lucie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f70be66f-b410-3bb5-a334-0610d626b8df",
                                        "entry_id": "05a0ef1a-46f9-3313-9580-05045581d068",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129ddf93-0d34-42e2-b9a9-1408887700ef",
                                                "sense_id": "f70be66f-b410-3bb5-a334-0610d626b8df",
                                                "text": "Lucie Félix-Faure Goyau avait un mot charmant : elle disait que le christianisme nous a appris l’art de désassombrir la mort."
                                            },
                                            {
                                                "example_id": "63a4c6f8-1503-4ae3-9202-0d47cb21c3f7",
                                                "sense_id": "f70be66f-b410-3bb5-a334-0610d626b8df",
                                                "text": "Louise Mailloux, l’auteure de la première plainte, remet en question la conduite de la juge en chef de la Cour du Québec, Lucie Rondeau."
                                            },
                                            {
                                                "example_id": "1ecd8486-35a1-4881-8971-5676400fd67f",
                                                "sense_id": "f70be66f-b410-3bb5-a334-0610d626b8df",
                                                "text": "L’équipe de France a à chaque fois placé trois bateaux sur trois en demi-finale, avec la Paloise Marjorie Delassus, toute récente vice-championne d’Europe, à la 2ᵉ place, et Lucie Baudu (Saran) 4ᵉ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
