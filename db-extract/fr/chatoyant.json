                "entry_id": "ed5a829a-0e52-3464-9b0e-a88afe86e709",
                "word": "chatoyant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e6dc6f40-1bec-433a-a481-cd4dc6e5145c",
                        "entry_id": "ed5a829a-0e52-3464-9b0e-a88afe86e709",
                        "tags": [
