                                    {
                                        "sense_id": "e2486bb8-97fb-3924-87ca-61c865d3cfea",
                                        "entry_id": "08ad0eb2-0de9-36a3-b5d9-339746bc9dde",
                                        "glosses": [
                                            "jemanden unerwartet, unvorbereitet treffend oder in Erstaunen setzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13186d93-46e0-4e98-9ba4-1df417ef46ab",
                                                "sense_id": "e2486bb8-97fb-3924-87ca-61c865d3cfea",
                                                "text": "Dass mein Vater seinen Fehler nun doch zugab, kam auch für mich überraschend."
                                            },
                                            {
                                                "example_id": "94c08afd-66b9-4ff5-a419-b46bb564b73e",
                                                "sense_id": "e2486bb8-97fb-3924-87ca-61c865d3cfea",
                                                "text": "Das überraschendste Ergebnis der Computerberechnungen sei, dass schon ein kurzer Gammablitz aus der unmittelbaren kosmischen Nachbarschaft der Erde verheerende Auswirkungen hätte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
