                            },
                            {
                                "target_lang_word": "褪色",
                                "target_lang_sense_clarification": "颜色变淡"
                            },
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "力量或影响减弱"
                            }
                        ]
                    }
                }
