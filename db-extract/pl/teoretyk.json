                    },
                    {
                        "sense_id": "d110e3df-f98b-36fe-88d1-02fcdf16f76a",
                        "entry_id": "514270c4-9ba9-351a-afca-147edbe809e2",
                        "glosses": [
                            "człowiek, który posiadł wiedzę ogólną w danej dziedzinie, ale nie potrafi wdrożyć ją w praktykę"
