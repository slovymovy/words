        "fr-extract.jsonl": [
            {
                "entry_id": "0ca59c5a-e8ae-32a2-85e0-9be926e3d221",
                "word": "bottine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85428737-8e09-4d1c-887d-ca9a9d8892e3",
                        "entry_id": "0ca59c5a-e8ae-32a2-85e0-9be926e3d221",
                        "tags": [
                            "plural"
                        ],
                        "form": "bottines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e611b65d-4c4b-3bf7-952b-e1ef62f566e7",
                        "entry_id": "0ca59c5a-e8ae-32a2-85e0-9be926e3d221",
                        "glosses": [
                            "Petite botte de cuir mince ou d’étoffe dont la tige a peu de hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4201c16-a9ef-45f4-9342-3cfcf66d9913",
                                "sense_id": "e611b65d-4c4b-3bf7-952b-e1ef62f566e7",
                                "text": "Des bottines de peau de daim non tannée le garantissaient des morsures des reptiles, […]."
                            },
                            {
                                "example_id": "39819e49-8f97-469b-8158-1ef81e153ec8",
                                "sense_id": "e611b65d-4c4b-3bf7-952b-e1ef62f566e7",
                                "text": "Sa jupe de soie gris argent, coupée en biais, se tendait de la hanche au jarret, découvrant ainsi quelques centimètres de bas minces et des souliers bas, au lieu des bottines à boutons que portaient encore la plupart des dames."
                            },
                            {
                                "example_id": "3b156d45-b7cf-438c-86ca-4258803dc9b1",
                                "sense_id": "e611b65d-4c4b-3bf7-952b-e1ef62f566e7",
                                "text": "Puis je lui proposai, à l’occasion, de livrer ses chapeaux les jours de pluie pour qu’elle ne crottât pas ses bottines."
                            },
                            {
                                "example_id": "4e80bd1f-48a2-4fee-b0cd-79397ef1d25b",
                                "sense_id": "e611b65d-4c4b-3bf7-952b-e1ef62f566e7",
                                "text": "Tu marchais dans les rues, enfoncée dans tes bottines ridicules à trois francs six sous. Tu marchais comme d’hab’, en baissant la tête. Jamais je t'ai vue regarder le ciel."
                            },
                            {
                                "example_id": "28186307-236f-40bd-8323-ef3490ae3897",
                                "sense_id": "e611b65d-4c4b-3bf7-952b-e1ef62f566e7",
                                "text": "À ceux qui pour avoir le respect du milieu\nEt de belles bottines,\nLivrent leur sœur cadette à de vilains messieurs,\nPour des prix de famine."
                            }
                        ]
                    },
                    {
                        "sense_id": "efcee2dd-3c77-39be-9019-6d4e93b809da",
                        "entry_id": "0ca59c5a-e8ae-32a2-85e0-9be926e3d221",
                        "glosses": [
                            "Sorte de brodequin à boutons, à élastiques ou à lacets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fdf0dc6-5ff7-49ba-835c-28ece9fb98a4",
                                "sense_id": "efcee2dd-3c77-39be-9019-6d4e93b809da",
                                "text": "Le soin excessif de sa toilette, des bottines de velours, une collerette de dentelles, le châle mis droit, tout attestait la sollicitude de Modeste pour sa mère."
                            },
                            {
                                "example_id": "ea9119ce-d3df-45e2-8d29-706b6107e82e",
                                "sense_id": "efcee2dd-3c77-39be-9019-6d4e93b809da",
                                "text": "[…] ; sous le dernier volant de sa robe, son pied passait dans une mince bottine en soie, de couleur marron ; […]."
                            },
                            {
                                "example_id": "2d0b8afd-deb4-4f16-82d6-ead5aa8092ab",
                                "sense_id": "efcee2dd-3c77-39be-9019-6d4e93b809da",
                                "text": "Le cri du gravier sous ses bottines, dans le silence, la fit tressaillir."
                            },
                            {
                                "example_id": "9af0e01f-f275-4e11-a609-d4a8be51174b",
                                "sense_id": "efcee2dd-3c77-39be-9019-6d4e93b809da",
                                "text": "Il vérifia une dernière fois la nominette aux armes de la ZP3 Uccle/Watermael-Boitsfort/Auderghem, laça les bottines à tige et se prépara à sortir."
                            }
                        ]
                    },
                    {
                        "sense_id": "846bf82f-486e-3672-9fd4-56c1c80eb979",
                        "entry_id": "0ca59c5a-e8ae-32a2-85e0-9be926e3d221",
                        "glosses": [
                            "(Afrique centrale francophone) Préservatif."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9845066-73ba-4f65-a68e-edde9510ac69",
                        "source_entry_id": "0ca59c5a-e8ae-32a2-85e0-9be926e3d221",
                        "target_lang_word": "Stiefelette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefelette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f83d72e-739f-344c-b3d6-10205ad8078a",
                                        "entry_id": "7988ceec-e4e9-38f8-be84-7540bde44736",
                                        "glosses": [
                                            "halbhoher und meist eleganter Stiefel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb76c6e4-d105-4390-8ed4-3541edf38fbb",
                                                "sense_id": "5f83d72e-739f-344c-b3d6-10205ad8078a",
                                                "text": "„Scharfe Sporen wollte ich an meine Stiefeletten schnallen und dich mit ihnen zerfleischen, und auch die müsstest du wieder blank lecken und noch ganz andre Dinge müsste deine Zunge mir leisten!“"
                                            },
                                            {
                                                "example_id": "461945f9-86f4-4203-b00d-d57e4314fecf",
                                                "sense_id": "5f83d72e-739f-344c-b3d6-10205ad8078a",
                                                "text": "„Ich betrachte die Stiefeletten, in denen meine Füße stecken, die einmal silbermetallic waren, jetzt grau sind, und nehme mir vor, nach meiner Rückkehr möglichst schnell neue zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
