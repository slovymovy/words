                        "glosses": [
                            "cienki, cynowy arkusz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41996d87-bf8e-48c3-ae43-062d9796fd77",
                                "sense_id": "55f5a33c-2c14-31f9-92bb-142ef5dfcee1",
                                "text": "Szeleściły na wietrze wielkie arkusze cynfolii, […] zdobywane nie wiadomo skąd przez przekupniów."
                            },
                            {
                                "example_id": "0bb39634-2fd8-4ef1-86e1-f592aceef7f8",
                                "sense_id": "55f5a33c-2c14-31f9-92bb-142ef5dfcee1",
                                "text": "Behemot pożarłszy trzecią mandarynkę wsunął łapę w przemyślną konstrukcję wzniesioną z tabliczek czekolady, wyciągnął jedną tabliczkę ze spodu, wskutek czego, oczywiście, wszystko runęło, po czym połknął czekoladę wraz ze złotą cynfolią"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
