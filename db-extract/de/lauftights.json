                "senses": [
                    {
                        "sense_id": "a051585f-63a2-3081-829b-d9ea30292caf",
                        "entry_id": "2468d6a3-783e-3302-bcfa-b2395208dba1",
                        "glosses": [
                            "eng anliegende, elastische Hose, die speziell fürs Laufen konzipiert ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "a5314902-d880-4885-8c99-0fcfdeb5d360",
                                "sense_id": "a051585f-63a2-3081-829b-d9ea30292caf",
                                "text": "„Als Einstieg in das Team gibt es eine Kombi aus Lauftrikot und Lauftights für Damen oder Herren.“"
                            },
                            {
                                "example_id": "6b928e31-d109-4c8c-97c1-29f2c0cc34e0",
                                "sense_id": "a051585f-63a2-3081-829b-d9ea30292caf",
                                "text": "„Bisher habe ich zum Wandern nur im Winter die wärmeren Lauftights getragen und bei den Sommertouren die kurze Wanderhose.“"
                            },
                            {
                                "example_id": "e7996049-3e3f-4d01-ab91-6531bfd7cbee",
                                "sense_id": "a051585f-63a2-3081-829b-d9ea30292caf",
                                "text": "„Aber was ist mit der unbegrenzten Recyclebarkeit und wie kann auch aus einer alten Lauftights wieder eine PET-Flasche werden?“"
                            },
                            {
                                "example_id": "c5773972-37a8-4294-8e63-b00d0d5dd0f6",
                                "sense_id": "a051585f-63a2-3081-829b-d9ea30292caf",
                                "text": "„Ehe man sich versieht, trägt man Jogginghose statt Lauftights und holt sich sein Carbo-Loading über Lebkuchen und Stollen.“"
                            },
                            {
                                "example_id": "fe5d8b5b-02ae-47cc-aec5-7a1e8583fc73",
                                "sense_id": "a051585f-63a2-3081-829b-d9ea30292caf",
                                "text": "„Diese gibt es in vielen verschiedenen Variationen wie Lauftights für Männer, Lauftights für Frauen, bunte Lauftights, Tights zum Joggen und so weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
