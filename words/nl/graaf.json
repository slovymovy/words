                                "ru": "Каждую субботу я <w>рою</w> глубокую яму в песочнице вместе с сыном."
                            }
                        },
                        {
                            "text": "Als ik in de tuin <w>graaf</w>, kom ik vaak oude scherven tegen.",
                            "target_lang_translations": {
                                "en": "When I <w>dig</w> in the garden, I often come across old shards.",
                                "ru": "Когда я <w>копаю</w> в саду, мне часто попадаются старые черепки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van graven"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of the verb 'graven' (to dig).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола 'graven' (копать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dig",
                                "target_lang_sense_clarification": "first person singular present"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "копаю",
                                "target_lang_sense_clarification": "1-е лицо ед. ч."
                            },
                            {
                                "target_lang_word": "рою",
                                "target_lang_sense_clarification": "1-е лицо ед. ч."
                            }
                        ]
                    }
                }
            ]
        },
        {
