                ],
                "senses": [
                    {
                        "sense_id": "739b771f-92bc-350e-a163-f7f07885aac4",
                        "entry_id": "6df525b3-608b-37b2-93e3-b7dd889dc768",
                        "glosses": [
                            "Se drainer tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab53ab79-314f-47aa-9a16-9761ae32acbb",
                                "sense_id": "739b771f-92bc-350e-a163-f7f07885aac4",
                                "text": "L'enfant peut donc s'autodrainer, s'aider en poussant sur le gril costal avec ses mains sur le temps expiratoire."
                            },
                            {
                                "example_id": "29b9b651-c234-4a5d-9f00-382c1af34b9a",
                                "sense_id": "739b771f-92bc-350e-a163-f7f07885aac4",
                                "text": "C'est la raison pour laquelle le terrain de foot de Gennecy est régulièrement utilisé car il a l'avantage de s'autodrainer."
                            },
                            {
                                "example_id": "72d004ae-014c-4fb5-a48e-e394fb2dbc52",
                                "sense_id": "739b771f-92bc-350e-a163-f7f07885aac4",
                                "text": "Par contre, il ne faut jamais perdre de vue la capacité de s'autodrainer (s'autonettoyer si l'on veut) qu'un cours d'eau avec un débit aussi fort est énorme."
                            }
                        ]
                    }
