                    {
                        "sense_id": "84694fc6-88ba-3e0f-9b47-0276f326f16d",
                        "entry_id": "cb775af4-94c7-32d8-875a-5d1bdf265852",
                        "glosses": [
                            "for sure, certainly, for certain"
