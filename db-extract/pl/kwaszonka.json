                                                "sense_id": "c2fb6816-cd9c-3bc6-bc62-5c65ff987eee",
                                                "text": "We pickled the remainder of the crop."
                                            },
                                            {
                                                "example_id": "8ed7dd38-57f2-44dc-af62-56364daf4a43",
                                                "sense_id": "c2fb6816-cd9c-3bc6-bc62-5c65ff987eee",
                                                "text": "These cucumbers pickle very well."
