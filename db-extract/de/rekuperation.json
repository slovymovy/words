                ],
                "senses": [
                    {
                        "sense_id": "96fcd8eb-6aa7-3141-ae5d-817efaffbb01",
                        "entry_id": "97a10fbe-8f8e-340f-853d-a3d3e4907db3",
                        "glosses": [
                            "Rückgewinnung von Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26910efc-97bd-4587-8eea-65886372a91f",
                                "sense_id": "96fcd8eb-6aa7-3141-ae5d-817efaffbb01",
                                "text": "Die Bremsleistung und das Maß der Rekuperation sind abhängig von der Leistung der elektrischen Maschinen, der Speicherleistung und der freien Kapazität der Energiespeicher."
                            },
                            {
                                "example_id": "3de01cbd-c8ea-4023-ae9f-2e56fc8a7d3b",
                                "sense_id": "96fcd8eb-6aa7-3141-ae5d-817efaffbb01",
                                "text": "In der Mild-Hybrid-Variante wird der Dynastart den Start-Stopp-Betrieb sowie Rekuperation ermöglichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c20fcd0c-7aff-3e93-9855-1630611d94f7",
                        "entry_id": "97a10fbe-8f8e-340f-853d-a3d3e4907db3",
                        "glosses": [
                            "Rückgewinnung von Territorien"
                        ],
                        "tags": [
                            "Geschichtswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d9e3ef77-fd8f-4cba-b79d-4393c2a83ccc",
                                "sense_id": "c20fcd0c-7aff-3e93-9855-1630611d94f7",
                                "text": "„Gerade die Rekuperation der an eidgenössische Orte gefallenen Besitzungen erwies sich trotz einer durchaus bemühten Politik Friedrichs als nicht durchführbar.“"
                            },
                            {
                                "example_id": "5ac32d3a-a591-44bd-8f56-8ccd7ad09734",
                                "sense_id": "c20fcd0c-7aff-3e93-9855-1630611d94f7",
                                "text": "„Auch wegen der Rekuperation von Ordensgütern in Italien hatte er vorzusprechen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
