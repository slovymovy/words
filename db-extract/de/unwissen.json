                        ],
                        "form": "dem Unwissen"
                    },
                    {
                        "form_id": "e88db1cf-d54f-42f1-a63d-6961175fb922",
                        "entry_id": "f489e5ef-96aa-3029-bdc7-a9b8d08df93c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Unwissen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98984d60-9bfe-341c-943e-b08cb04af8c3",
                        "entry_id": "f489e5ef-96aa-3029-bdc7-a9b8d08df93c",
                        "glosses": [
                            "mangelnde Kenntnis, mangelndes Wissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55750d87-b823-4ea7-a288-911f798016f3",
                                "sense_id": "98984d60-9bfe-341c-943e-b08cb04af8c3",
                                "text": "„Damals, als junger Mann, beschloss er, etwas gegen das Unwissen zu tun.“"
                            },
                            {
                                "example_id": "8cd13a8f-296b-43a1-97a7-5cbe253780f5",
                                "sense_id": "98984d60-9bfe-341c-943e-b08cb04af8c3",
                                "text": "„Gemäßigtere Bürger vertreten die Auffassung, dass Drogenmissbrauch aus Leichtsinn und Unwissen heraus entsteht, und plädieren für rigorose Aufklärungskampagnen.“"
                            },
                            {
                                "example_id": "ff1e7cbd-03df-4742-970d-92e069325efb",
                                "sense_id": "98984d60-9bfe-341c-943e-b08cb04af8c3",
                                "text": "„Mit nicht nachlassender Geschwätzigkeit predigt Mittelmann auf verschlungenen Wegen sein Unwissen über das Schuldrecht, das Zwangsvollstreckungsrecht, das Erbrecht, zur Schadenfreude und zum Überdruß der anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "233c6511-0755-497d-b0bd-d188d177cf5c",
                        "source_entry_id": "f489e5ef-96aa-3029-bdc7-a9b8d08df93c",
                        "source_sense_id": "98984d60-9bfe-341c-943e-b08cb04af8c3",
                        "source_sense_description": "mangelnde Kenntnis, mangelndes Wissen",
                        "target_lang_word": "ignorance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignorance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                        "entry_id": "c3583fec-304f-3459-9c8c-8dd8107daf30",
                                        "glosses": [
                                            "The condition of being uninformed or uneducated; lack of knowledge or information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f1a81bc-2af1-4cc8-b64c-943987ce0ae5",
                                                "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                                "text": "She shows total ignorance about the topic at hand."
                                            },
                                            {
                                                "example_id": "56583bdd-b471-4065-8e60-25089437c6a7",
                                                "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                                "text": "The guard was paying no attention whatever to the running of his train, in total disregard of rules, and, as the recently-published report of a Ministry of Transport Inspecting Officer of Railways shows, there were other disquieting features in the case, such as ignorance on the part of responsible men of rules and appendix instructions and a lax attitude to regulations of which they professed to be aware, combined with failure to look at staff notice boards."
                                            },
                                            {
                                                "example_id": "f3568ab0-767d-48c1-b8d2-e7d6b8d43ce5",
                                                "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                                "text": "There had been the whisky and Perrier in the morning but, in my ignorance of alcoholics then, I could not imagine one whisky harming anyone who was driving in an open car in the rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d089e8-5bbf-3283-a42b-a29db165d171",
                                        "entry_id": "c3583fec-304f-3459-9c8c-8dd8107daf30",
                                        "glosses": [
                                            "Sins committed through ignorance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "320c5e50-01e0-3ac4-ac25-a5fdf0917199",
                                        "entry_id": "c3583fec-304f-3459-9c8c-8dd8107daf30",
                                        "glosses": [
                                            "Existential blindness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cb9d6f1-04a8-4f09-8876-5753574357e0",
                        "source_entry_id": "f489e5ef-96aa-3029-bdc7-a9b8d08df93c",
                        "source_sense_id": "98984d60-9bfe-341c-943e-b08cb04af8c3",
                        "source_sense_description": "mangelnde Kenntnis, mangelndes Wissen",
                        "target_lang_word": "ignorance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignorance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                        "entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                                        "glosses": [
                                            "État de celui qui est ignorant ; celui qui ne connaît rien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45fc68e4-2abe-4e09-a541-255e7b9b05d6",
                                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                                "text": "Sa connaissance des livres, quoique superficielle, suffisait à imposer à l’ignorance un certain respect pour le savoir qu’on lui supposait."
                                            },
                                            {
                                                "example_id": "fc05d8ea-03cc-4f8a-8ba0-24a96b259495",
                                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                                "text": "Pour un spectateur instruit, ce contraste entre la complète ignorance des uns et la palpitante attention des autres eût été sublime."
                                            },
                                            {
                                                "example_id": "eb7dacdd-6480-4b8e-bbbe-58ca4621b835",
                                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                                "text": "Durandus eut beau exciper de son ignorance, il ne fut libéré qu'après s'être vu condamner à une amende."
                                            },
                                            {
                                                "example_id": "38c615bc-cd86-4871-ad5e-acbf00046613",
                                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                                "text": "L’ignorance d’aujourd’hui est le bon usage de demain."
                                            },
                                            {
                                                "example_id": "d5834eee-300f-4d29-946f-7140cce2bfe9",
                                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                                "text": "La raison d'État n'est le plus souvent qu'un manteau commode pour couvrir l’ignorance, la bêtise ou la scélératesse d'une oligarchie..."
                                            },
                                            {
                                                "example_id": "a443bfcb-a35f-4854-8bf2-f594efbe3380",
                                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                                "text": "Un système aussi injuste ne peut se maintenir qu’en tenant la population dans l’ignorance et la vulnérabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1354bcd2-3896-3bab-9bdb-5aba7af52b93",
                                        "entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                                        "glosses": [
                                            "Fautes qui marquent une ignorance grossière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f18e92c8-ba26-4313-af56-b60bb0424803",
                                                "sense_id": "1354bcd2-3896-3bab-9bdb-5aba7af52b93",
                                                "text": "Ce livre est plein d’ignorances impardonnables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
