                                "target_senses": [
                                    {
                                        "sense_id": "a891a80f-e4f4-3205-b39a-1a2ea9c8307a",
                                        "entry_id": "570f3b5c-e60c-3443-9fb2-ff168a3bcb25",
                                        "glosses": [
                                            "Genre de plantes herbacées de la famille des Apiaceae qui comporte quatre espèces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "178e3e71-c7d7-3434-bdc0-93ff3f0d3a23",
                                        "entry_id": "570f3b5c-e60c-3443-9fb2-ff168a3bcb25",
                                        "glosses": [
                                            "Suc gommeux, résine odoriférante, que l’on tire de la myrrhe douce (Commiphora kataf) et qui est utilisé en parfumerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65cc7f4c-01ce-4c47-a0af-866c7c691e37",
                                                "sense_id": "178e3e71-c7d7-3434-bdc0-93ff3f0d3a23",
                                                "text": "[…] il amenait, à sa suite, une ribambelle de galopins barbus, coiffés en drôlesses et confits dans l’opopanax."
                                            },
                                            {
                                                "example_id": "291256c3-6e5c-4373-bf22-854a85d13cb2",
                                                "sense_id": "178e3e71-c7d7-3434-bdc0-93ff3f0d3a23",
                                                "text": "Je respire un peu de pétrole. L'odeur du pétrole m'est infiniment plus agréable que celle de l'opopanax."
                                            },
                                            {
                                                "example_id": "6b8a6feb-bda6-497a-b392-2fa3dc0ec8fe",
                                                "sense_id": "178e3e71-c7d7-3434-bdc0-93ff3f0d3a23",
                                                "text": "Pendant plus d’une heure on ne parla que de dessous et de parfums. Et c’est au milieu de ces volants, de ces jupons, de ces iris, ces foins coupés et ces opopanax, que tout fut décidé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c780b03-6f92-400d-b979-b8ec58e020e2",
                        "source_entry_id": "cc87f064-6996-304d-9f62-06dfab90b00d",
                        "source_sense_description": "gum from the root of Opopanax chironium or what is equal",
                        "target_lang_word": "opoponax",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opoponax",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "829b857d-00a0-316d-83ad-950062d011f7",
                                        "entry_id": "842def63-aff8-3c7c-876a-84aa188461c9",
                                        "glosses": [
                                            "Variante orthographique de opopanax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa292ee4-9918-45a7-ad50-b30875234c07",
                                                "sense_id": "829b857d-00a0-316d-83ad-950062d011f7",
                                                "text": "Ce satrape, vêtu de bleu turquoise, le cigare à la bouche et « répandant les effluves de son parfum à l'opoponax », « donna là libre cours à son talent de psychologue »."
                                            },
                                            {
                                                "example_id": "fb2f3f11-f23e-4a7b-aebc-078fbed19ff4",
                                                "sense_id": "829b857d-00a0-316d-83ad-950062d011f7",
                                                "text": "Ce dernier, debout devant la fenêtre, parfumait sa barbiche avec une brosse à dents, trempée dans l'extrait d'opoponax."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
