                        "form": "das Oberkiefer"
                    },
                    {
                        "form_id": "087aacd3-52b1-46e1-840e-b78225b6dced",
                        "entry_id": "7fd022d2-4620-30c6-ad5f-d6e90fde1d2b",
                        "tags": [
                            "accusative",
