                "senses": [
                    {
                        "sense_id": "cb45f391-5fe9-3489-8c47-c37f23736ade",
                        "entry_id": "098937f0-a077-3d57-b6bb-7f9c49619228",
                        "glosses": [
                            "met kalk gemarkeerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c004e29-3cbf-4390-81bc-db75e6b8d973",
                                "sense_id": "cb45f391-5fe9-3489-8c47-c37f23736ade",
                                "text": "Overigens had het voorval geen gevolgen voor de wedstrijd: die ging gewoon door met een kersverse en flink wit gekalkte middenstip."
                            }
                        ]
                    },
                    {
                        "sense_id": "68361f00-6a2b-3809-9645-26cc591f7e4a",
                        "entry_id": "098937f0-a077-3d57-b6bb-7f9c49619228",
                        "glosses": [
                            "op een slordige wijze beschreven of van verf voorzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbdfe0c0-71f1-4683-a848-2cbd86a55b0e",
                                "sense_id": "68361f00-6a2b-3809-9645-26cc591f7e4a",
                                "text": "Met gekalkte leuzen als 'Anti-Antifa' geven daders aan dat zij tegen antifascisten zijn. In de dönermoordenzaak gaat het om 10 slachtoffers, voornamelijk Turken."
                            },
                            {
                                "example_id": "66989acc-977c-4ffc-915b-e4146c749f4f",
                                "sense_id": "68361f00-6a2b-3809-9645-26cc591f7e4a",
                                "text": "Zo voert het project Hart van Zuid aan dat een onder gekalkte gevel van natuursteen compleet moest worden vervangen, voor 10.425 euro. De aanklager vindt dat te weinig onderbouwd. Mike S. zegt in zijn laatste woord dat hij het 'laf' vindt om achteraf spijt te betuigen. Vonnis: 26 augustus."
                            }
                        ]
                    }
                ],
