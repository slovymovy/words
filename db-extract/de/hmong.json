                "senses": [
                    {
                        "sense_id": "4d50aa70-0fa0-3184-b9cd-82311cd897ad",
                        "entry_id": "abf0dc1f-9738-3050-aa96-132426ad52ec",
                        "glosses": [
                            "Angehöriger des gleichnamigen Bergvolkes in Ostasien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41c6c2a-8777-4f24-b15a-df0426a66ebc",
                                "sense_id": "4d50aa70-0fa0-3184-b9cd-82311cd897ad",
                                "text": "„Nach dem Sieg der Kommunisten 1975 formierte sich die \"United Lao National Liberation Front\" unter dem Hmong Vang Pao.“"
                            },
                            {
                                "example_id": "6beb6ac6-dbf6-42bd-9e9b-2e6de7f441ae",
                                "sense_id": "4d50aa70-0fa0-3184-b9cd-82311cd897ad",
                                "text": "„Zu den Neujahrsfeierlichkeiten und anderen festlichen Anlässen, aber auch an Markttagen schmücken sich die Frauen mancher Bergvölker, vor allem bei den Hmong, mit zahlreichen Reifen, Ringen, Ketten und Gehängen sowie schweren Glockengürteln und anderem Silberschmuck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
