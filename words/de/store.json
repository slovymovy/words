                },
                {
                    "sense_id": "c591133e-527e-3c58-bb23-339b144bd091",
                    "sense_definition": "Aufrollbares Sonnendach zum Schutz vor Sonne an Fenstern sowie auf Balkonen und Terrassen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fensterschutz",
                    "name_type": "no",
                    "examples": [
