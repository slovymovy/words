                        "sense_id": "843cffe9-3708-3fc0-bf46-32690212458f",
                        "entry_id": "5ecd8b86-0797-34d3-a62e-330d59dde204",
                        "glosses": [
                            "een scheepstype dat wordt voortbewogen door schoepenraderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb29a107-5c9a-41e3-a31d-3c53e5a172c0",
                                "sense_id": "843cffe9-3708-3fc0-bf46-32690212458f",
                                "text": "De eerste door een stoommachine aangedreven raderboot is in 1807 gebouwd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db3977f7-b4c2-4a56-a7d4-d1f444fc783f",
                        "source_entry_id": "5ecd8b86-0797-34d3-a62e-330d59dde204",
                        "source_sense_id": "843cffe9-3708-3fc0-bf46-32690212458f",
                        "source_sense_description": "een scheepstype dat wordt voortbewogen door schoepenraderen",
                        "target_lang_word": "Raddampfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raddampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                        "entry_id": "126268d4-1684-33a2-b601-1d3287f4a9ad",
                                        "glosses": [
                                            "Dampfschiff, das von Schaufelrädern angetrieben wird"
                                        ],
                                        "tags": [
                                            "Schiffswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b697b6c-b185-4b57-9237-f0ea057af1f9",
                                                "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                                "text": "„Raddampfer wurden hauptsächlich im ausgehenden 19. und beginnenden 20. Jahrhundert gebaut, als die Dampfschifffahrt Stand der Technik im Schiffbau war.“"
                                            },
                                            {
                                                "example_id": "941f3757-adb3-4db4-8366-13eb6fef71ba",
                                                "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                                "text": "„Die Flotte der Schifffahrtsgesellschaft des Vierwaldstättersees betreibt fünf nostalgische Raddampfer, von denen jeder seine einzigartige Eigenschaft hat.“"
                                            },
                                            {
                                                "example_id": "8e6442bd-98d3-4a2a-9a22-5fe7f3615a8c",
                                                "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                                "text": "„Ein schönes Erlebnis ist eine Ausflugsfahrt mit dem Raddampfer Freya. Wer eine kurze Reise in die Vergangenheit machen möchte, ist auf dem Raddampfer Freya am richtigen Ort. Dieses Schiff hat nichts von seinem Charme verloren und begeistert seine Gäste immer wieder aufs Neue.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c74112be-b051-4ef6-9254-555aaa96e589",
                        "source_entry_id": "5ecd8b86-0797-34d3-a62e-330d59dde204",
                        "source_sense_id": "843cffe9-3708-3fc0-bf46-32690212458f",
                        "source_sense_description": "een scheepstype dat wordt voortbewogen door schoepenraderen",
                        "target_lang_word": "paddle steamer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paddle steamer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e40f5b4e-e942-352f-8c21-6f5f9ff4aacf",
                                        "entry_id": "1146ab3c-d40e-365b-85f9-1f151b49fecd",
                                        "glosses": [
                                            "A steam-powered vessel propelled by one or two paddle wheels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c1c3b4-7ab9-4fce-832c-c29783173e6e",
                                                "sense_id": "e40f5b4e-e942-352f-8c21-6f5f9ff4aacf",
                                                "text": "In the second volume of his autobiography, he writes of a journey up the Padma by paddle steamer (built, as it happens, on the river outside my window), where the dry season had exposed many sandbanks..."
                                            },
                                            {
                                                "example_id": "8cdfdb06-e09f-4f61-bf9c-2fcf096279d8",
                                                "sense_id": "e40f5b4e-e942-352f-8c21-6f5f9ff4aacf",
                                                "text": "By the 1880s, the pretty harbour village of Lynmouth was enjoying an influx of holidaymakers brought by paddle steamers from the likes of Bristol and Swansea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
