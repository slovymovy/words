                "senses": [
                    {
                        "sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                        "entry_id": "7075d580-5e98-3bb3-91f0-5dcccc658f79",
                        "glosses": [
                            "неодобр. человек, ругающийся матом, любящий употреблять в своей речи неприличные выражения, непристойные, скверные слова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239f0197-0463-434e-b567-defe878bf805",
                                "sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                                "text": "Не выношу сквернословов."
                            },
                            {
                                "example_id": "77cbef48-c257-4a78-89e1-a8e510075241",
                                "sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                                "text": "Твой приятель пошляк и сквернослов."
                            },
                            {
                                "example_id": "eeeb54b4-d224-49b0-b510-56acf2be3246",
                                "sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                                "text": "Да уймите вы этого сквернослова!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91b71690-1044-4b5f-a4cc-0935a796e9bb",
                        "source_entry_id": "7075d580-5e98-3bb3-91f0-5dcccc658f79",
                        "source_sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                        "target_lang_word": "potty mouth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potty mouth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f76e13-149c-370e-ba45-d725b728efa3",
                                        "entry_id": "d56bbcf7-09ac-3e42-8933-073d13e8fe7e",
                                        "glosses": [
                                            "The characteristic of regularly using vulgar language, especially strong profanities."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593589a2-2f0c-48e1-8b5a-565d28ff1b19",
                                                "sense_id": "c1f76e13-149c-370e-ba45-d725b728efa3",
                                                "text": "Enough of my bathroom humour, my potty mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04cfc578-f867-3074-9ea6-e0aade77854c",
                                        "entry_id": "d56bbcf7-09ac-3e42-8933-073d13e8fe7e",
                                        "glosses": [
                                            "A person having this characteristic."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f86e6e3b-5eb2-43ea-aa9a-39ac2ee16d2e",
                                                "sense_id": "04cfc578-f867-3074-9ea6-e0aade77854c",
                                                "text": "I’ve turned myself into a potty mouth. I swear. Too much."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41682b6f-92ad-4b21-be0d-0e69f8a62e2e",
                        "source_entry_id": "7075d580-5e98-3bb3-91f0-5dcccc658f79",
                        "source_sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                        "target_lang_word": "grossier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b8f5afd-6c6c-365b-a76c-4e7a8bf8704b",
                                        "entry_id": "d7d7920a-0acd-31f7-8be8-c6b69fe224eb",
                                        "glosses": [
                                            "Qui n’est pas fin, qui n’est pas délicat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066613eb-bb74-4a1a-8503-fe429e379fa8",
                                                "sense_id": "2b8f5afd-6c6c-365b-a76c-4e7a8bf8704b",
                                                "text": "Les pois mûrs & secs sont un des légumes qui fournissent la purée la plus délicate, & l’aliment le moins grossier."
                                            },
                                            {
                                                "example_id": "09beaf36-327b-4b7b-8a6f-f07a37a594ed",
                                                "sense_id": "2b8f5afd-6c6c-365b-a76c-4e7a8bf8704b",
                                                "text": "Leur costume consistait en une grossière vareuse de laine noire connue dans tous les pays scandinaves sous le nom de « vadmel », un chapeau à vastes bords, un pantalon à lisère rouge et un morceau de cuir replié en manière de chaussure."
                                            },
                                            {
                                                "example_id": "43ebae38-cde6-44e0-8207-09a0f20399a8",
                                                "sense_id": "2b8f5afd-6c6c-365b-a76c-4e7a8bf8704b",
                                                "text": "Des traits grossiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025ba7c6-bcc1-3716-ba70-04852ed12551",
                                        "entry_id": "d7d7920a-0acd-31f7-8be8-c6b69fe224eb",
                                        "glosses": [
                                            "Qui n’est pas fait avec délicatesse, avec soin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8f743a-32ce-49df-a054-ece0394af6af",
                                                "sense_id": "025ba7c6-bcc1-3716-ba70-04852ed12551",
                                                "text": "Coupez les légumes-feuilles en lanières grossières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8676b1-a39c-382f-9f07-92b00c083a3e",
                                        "entry_id": "d7d7920a-0acd-31f7-8be8-c6b69fe224eb",
                                        "glosses": [
                                            "Qui a de la rudesse, qui manque de culture, d’éducation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd9e583-f42a-41ea-9f0d-5f805123f843",
                                                "sense_id": "ed8676b1-a39c-382f-9f07-92b00c083a3e",
                                                "text": "Mœurs grossières."
                                            },
                                            {
                                                "example_id": "f1bcdaa4-76e5-4ba2-9ae8-6d90d030a541",
                                                "sense_id": "ed8676b1-a39c-382f-9f07-92b00c083a3e",
                                                "text": "Langage grossier."
                                            },
                                            {
                                                "example_id": "35f6dd6c-7be1-43bf-a58c-28a526e6757d",
                                                "sense_id": "ed8676b1-a39c-382f-9f07-92b00c083a3e",
                                                "text": "La veille du jour où il arrêta Eugène sur le cours Sauvaire, il avait publié, dans l’Indépendant, un article terrible sur les menées du clergé, en réponse à un entrefilet de Vuillet, qui accusait les républicains de vouloir démolir les églises. Vuillet était la bête noire d’Aristide. Il ne se passait pas de semaine sans que les deux journalistes échangeassent les plus grossières injures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e950265-a686-3135-9643-e3e922897721",
                                        "entry_id": "d7d7920a-0acd-31f7-8be8-c6b69fe224eb",
                                        "glosses": [
                                            "Malhonnête, incivil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2daffe76-c815-4e48-ae80-3441923ed2f1",
                                                "sense_id": "6e950265-a686-3135-9643-e3e922897721",
                                                "text": "Dire à quelqu’un les injures les plus grossières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92d82de-ea83-38ca-97aa-de6d043cc483",
                                        "entry_id": "d7d7920a-0acd-31f7-8be8-c6b69fe224eb",
                                        "glosses": [
                                            "Ce qui suppose beaucoup d’ignorance, de sottise, de déraison ou de maladresse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75247c76-1bc8-476d-873f-936d32f6e137",
                                                "sense_id": "d92d82de-ea83-38ca-97aa-de6d043cc483",
                                                "text": "Erreur grossière."
                                            },
                                            {
                                                "example_id": "1e45a9bf-78f5-48b9-976e-212eda142a3c",
                                                "sense_id": "d92d82de-ea83-38ca-97aa-de6d043cc483",
                                                "text": "N’avoir de quelque chose qu’une idée grossière, que des notions grossières : N’en avoir qu’une idée imparfaite, que des notions vagues et confuses."
                                            },
                                            {
                                                "example_id": "6f6e5c3e-1f34-4c0d-8fee-9dd83787752f",
                                                "sense_id": "d92d82de-ea83-38ca-97aa-de6d043cc483",
                                                "text": "On dit, dans un sens analogue, Ne donner qu’une idée grossière de quelque chose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "208a2846-1539-4645-b6c8-160cb53919a0",
                        "source_entry_id": "7075d580-5e98-3bb3-91f0-5dcccc658f79",
                        "source_sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                        "target_lang_word": "rustre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rustre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4f505e-7dc5-3eae-a9a8-c123b9df7168",
                                        "entry_id": "f0ca6bf2-5894-333f-8292-922c9cd8c762",
                                        "glosses": [
                                            "Qui est très rustique, très grossier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8aa7dcc-5e5f-4a47-b400-647130a552c8",
                                                "sense_id": "7b4f505e-7dc5-3eae-a9a8-c123b9df7168",
                                                "text": "Il a l’air rustre, la mine rustre."
                                            },
                                            {
                                                "example_id": "089c9497-9427-4d64-aef3-f45801c19d2d",
                                                "sense_id": "7b4f505e-7dc5-3eae-a9a8-c123b9df7168",
                                                "text": "Mais Félicité avait de meilleurs yeux. Elle regardait au loin dans l’avenir, et elle se sentait le besoin d’un homme bien portant, un peu rustre même, derrière lequel elle pût se cacher, et dont elle fît aller à son gré les bras et les jambes."
                                            },
                                            {
                                                "example_id": "9ff360ae-ecff-418c-9f31-e1e91f581b00",
                                                "sense_id": "7b4f505e-7dc5-3eae-a9a8-c123b9df7168",
                                                "text": "Après une enfance malheureuse, j'ai fait un mauvais mariage avec un homme rustre dont j'ai eu quatre enfants que j’ai élevés seule, avec tout mon cœur de mère."
                                            },
                                            {
                                                "example_id": "9b940d57-f106-4f1e-a5a0-686657d07bf1",
                                                "sense_id": "7b4f505e-7dc5-3eae-a9a8-c123b9df7168",
                                                "text": "La lettre était aimable. N'y pas répondre par le bonjour qu'elle demandait, ce serait d'un rustre, d'un butor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rustre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09397ff0-2455-312c-aa25-8c9f69eee1f7",
                                        "entry_id": "ed61a1ad-c4f6-3a78-bf58-a9e89d7c4cab",
                                        "glosses": [
                                            "Personne qui manque d’éducation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7106ed27-0b56-4113-b4fe-6c85829de7e3",
                                                "sense_id": "09397ff0-2455-312c-aa25-8c9f69eee1f7",
                                                "text": "Giomo. – Honnête rustre, nous sommes tes amis."
                                            },
                                            {
                                                "example_id": "ccd660dd-609c-4da4-8141-80711c7f35fe",
                                                "sense_id": "09397ff0-2455-312c-aa25-8c9f69eee1f7",
                                                "text": "C'est pas parce que j'ai pas reçu d'éducation qu'il faut en conclure que je suis un rustre et un gougnafier, comme dit Zygo Matix, qui a fait ses études à la Sorbonne."
                                            },
                                            {
                                                "example_id": "249a0912-932c-4bfc-a91f-bcb94e2cb1d3",
                                                "sense_id": "09397ff0-2455-312c-aa25-8c9f69eee1f7",
                                                "text": "On s’aperçoit que les épicuriens était d'une grande culture ; ils n'étaient absolument pas les rustres que les stoïciens aimaient à décrire, ces fameux « pourceaux d’Épicure » comme on a dit pour les discréditer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rustre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfc608ae-3eb4-39b5-a0f5-b900f84a413b",
                                        "entry_id": "21aef56c-5883-367f-ad81-35abf760ca7d",
                                        "glosses": [
                                            "Meuble représentant une forme en losange percée d’un trou circulaire dans les armoiries. Elle ne doit pas être confondue avec la macle qui est une losange évidée. À rapprocher de cadril ou quadril, carré, carreau, carreau de jeu de cartes, fusée, losange et macle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89056d79-5edd-455e-b778-701b40d2e503",
                                                "sense_id": "cfc608ae-3eb4-39b5-a0f5-b900f84a413b",
                                                "text": "D’azur au rustre d’argent, qui est de la commune de Montlaur de Haute-Garonne → voir illustration « armoiries avec un rustre »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c2e82da-cf36-454f-b34d-beb29d60c40b",
                        "source_entry_id": "7075d580-5e98-3bb3-91f0-5dcccc658f79",
                        "source_sense_id": "88a6c3d3-b1fa-3f5a-8735-af6fbbaa4630",
                        "target_lang_word": "malpropre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malpropre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b33bec13-71df-3950-9c3e-e022d119b589",
                                        "entry_id": "9a1dabcb-2771-3e87-aee9-5066cd1de95b",
                                        "glosses": [
                                            "Qui manque de propreté ; qui est sale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b3ae62-f4d9-432b-9dc1-83b2ecf209cc",
                                                "sense_id": "b33bec13-71df-3950-9c3e-e022d119b589",
                                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d'habitation y sont exécrables."
                                            },
                                            {
                                                "example_id": "28f36a3b-d973-46fa-a6cf-09387e5c5b0f",
                                                "sense_id": "b33bec13-71df-3950-9c3e-e022d119b589",
                                                "text": "Elle était hideuse ainsi. On voyait derrière ses lèvres relevées, débarrassées de rouge, décolorées et molles, ses dents malpropres ; un bourrelet de graisse saillait sous le menton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74aa864e-b405-3286-b755-9c8a4316eb7e",
                                        "entry_id": "9a1dabcb-2771-3e87-aee9-5066cd1de95b",
                                        "glosses": [
                                            "Qui est contraire à la morale, à l’honnêteté, à la délicatesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db6aae5-d0c7-496f-965e-9a5050978c17",
                                                "sense_id": "74aa864e-b405-3286-b755-9c8a4316eb7e",
                                                "text": "Un procédé malpropre. — Une action malpropre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "39bc700e-0503-4cad-95d2-bd80ed495b6a",
