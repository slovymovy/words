                "senses": [
                    {
                        "sense_id": "1f3f5b44-ff7d-3c44-8de6-a0c9bfee02ca",
                        "entry_id": "ed18fcf0-151b-3bb5-8fd4-8825d4bb4ca5",
                        "glosses": [
                            "Fourbe et hypocrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d5e84e-a749-41c9-a4d9-399fd74c55af",
                                "sense_id": "1f3f5b44-ff7d-3c44-8de6-a0c9bfee02ca",
                                "text": "Il était un peu faux jeton sur les bords, votre jules."
                            },
                            {
                                "example_id": "111cbe0a-811c-43a7-baa4-8aaa8d1fc065",
                                "sense_id": "1f3f5b44-ff7d-3c44-8de6-a0c9bfee02ca",
                                "text": "Il penche la tête, ça lui donne un air faux-jeton, mais c'est la bonne pâte, il assure la tortore, c'est le seul qui gratte. Il dit qu'il est caissier. Si on le cuisine un peu, on apprend qu'il fabrique des caisses en bois dans une usine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b4f066bc-5d43-31d3-9734-b6a03179ac8a",
                "word": "faux-jeton",
