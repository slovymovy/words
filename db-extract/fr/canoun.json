                "senses": [
                    {
                        "sense_id": "5b254fe4-ffae-3495-b2f4-d1bf32b62184",
                        "entry_id": "5aa479d9-350c-33e3-b16b-57ec7ea753ae",
                        "glosses": [
                            "Petit fourneau en terre cuite fonctionnant au charbon de bois que l’on utilise au Maghreb, il se pose généralement au sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb02551-6e20-4b84-a360-d1f2c1461dd8",
                                "sense_id": "5b254fe4-ffae-3495-b2f4-d1bf32b62184",
                                "text": "Les objets du ménage parsèment ainsi très fréquemment le champ du tapis : on reconnaît, stylisés ou non, de grosses marmites métalliques dressées sur leurs pieds droits, ces petits foyers de terre cuite appelés canoun sur lesquels les femmes accroupies, …"
                            },
                            {
                                "example_id": "8795cc57-d5d2-41e7-9610-875f5c6841ea",
                                "sense_id": "5b254fe4-ffae-3495-b2f4-d1bf32b62184",
                                "text": "L’argile est montée soit au colombin comme au Néolithique, soit au tour, pour produire jarres, tajines et canoun qui seront ensuite vendus au souk."
                            },
                            {
                                "example_id": "616df08a-9297-40fe-a701-c409fd423c86",
                                "sense_id": "5b254fe4-ffae-3495-b2f4-d1bf32b62184",
                                "text": "La maison était froide et humide et Aïcha eut du mal à respirer à cause de la fumée du canoun devant lequel Ito, accroupie, agitait un morceau de carton."
                            }
                        ]
                    }
