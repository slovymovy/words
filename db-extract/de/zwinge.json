                                        "entry_id": "ab5ef59f-bde9-3d9b-a0b8-6830fe21f9cb",
                                        "glosses": [
                                            "To fasten in place or together with (or as if with) a clamp."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbed3b81-9cc9-442a-9cf8-a21927ccf2f7",
                                                "sense_id": "04f85cfe-eccb-3810-80a6-968b96ffeb62",
                                                "text": "As we burst into the room, the Count turned his face, and the hellish look that I had heard described seemed to leap into it. His eyes flamed red with devilish passion. The great nostrils of the white aquiline nose opened wide and quivered at the edge, and the white sharp teeth, behind the full lips of the blood dripping mouth, clamped together like those of a wild beast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd27d235-8495-3294-a66f-b646fcbe492a",
                                        "entry_id": "ab5ef59f-bde9-3d9b-a0b8-6830fe21f9cb",
                                        "glosses": [
                                            "To hold or grip tightly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3cd1496-5919-3309-9255-3d4dcaba2c36",
                                        "entry_id": "ab5ef59f-bde9-3d9b-a0b8-6830fe21f9cb",
                                        "glosses": [
                                            "To modify (a numeric value) so it lies within a specific range by replacing values outside the range with the closest value within the range."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478f7f44-c8dc-4820-8a80-5d54de437fae",
                                                "sense_id": "a3cd1496-5919-3309-9255-3d4dcaba2c36",
                                                "text": "After the depth range is clamped, the depth value is read from the depth stencil buffer, and the two values are compared with a selectable depth-comparison function […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3641ebf8-d8af-3b07-8031-90cf76d5d5a5",
                                        "entry_id": "ab5ef59f-bde9-3d9b-a0b8-6830fe21f9cb",
                                        "glosses": [
                                            "To cover (vegetables, etc.) with earth."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c77025fa-bb26-33ec-a5a1-fa933f8de75f",
                                        "entry_id": "ab5ef59f-bde9-3d9b-a0b8-6830fe21f9cb",
                                        "glosses": [
                                            "To immobilise (a vehicle) by means of a wheel clamp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
