            {
                "entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
                "word": "carry-on",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b13f8527-908c-4cf8-8b8c-b42599ae572a",
                        "entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
                        "tags": [
                            "plural"
                        ],
                        "form": "carry-ons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a773f98-0ac5-3dc7-bf06-039a050b5944",
                        "entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
                        "glosses": [
                            "That luggage or baggage which is taken onto an airplane (or a ferry, etc.) with a passenger, rather than checked."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03d07b8c-d9fb-4523-babf-8ec4ed5ad754",
                                "sense_id": "4a773f98-0ac5-3dc7-bf06-039a050b5944",
                                "text": "Do you think they'll accept my ski poles as carry-on?"
                            }
                        ]
                    },
                    {
                        "sense_id": "646037b2-0c72-3189-8d3f-ee93f7e47874",
                        "entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
                        "glosses": [
                            "That luggage or baggage which is taken onto an airplane (or a ferry, etc.) with a passenger, rather than checked.",
                            "A bag, suitcase, etc., used to carry this luggage or baggage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f3cae6-751c-4f7a-95ce-954e479b0fd3",
                                "sense_id": "646037b2-0c72-3189-8d3f-ee93f7e47874",
                                "text": "\"THAT'S NOT MY CARRY-ON, THOSE WOULD NEVER GET THROUGH SECURITY. ALSO YOU'RE GROUNDED\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2dbdfcb3-72f4-3535-8bc2-aebcf0b48f08",
                        "entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
                        "glosses": [
                            "A palaver; a disorderly or absurd situation."
                        ],
                        "tags": [
                            "British",
                            "New-Zealand",
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "16c9e2b3-2bf3-4445-883a-7a16e15bc106",
                                "sense_id": "2dbdfcb3-72f4-3535-8bc2-aebcf0b48f08",
                                "text": "Sometimes all this carry-on about race, religion and sex seems so petty and silly that I cannot take it seriously."
                            },
                            {
                                "example_id": "126353fb-cfcb-4b8f-9aad-fa54691854ba",
                                "sense_id": "2dbdfcb3-72f4-3535-8bc2-aebcf0b48f08",
                                "text": "\"I love salad\",she dared when it came to the next course, and then inwardly cringed when it seemed that that was actually a special order and there was such a carry-on about what kind of salad she wanted."
                            },
                            {
                                "example_id": "719b35fe-59e7-488e-be97-fdbed5ebc1b7",
                                "sense_id": "2dbdfcb3-72f4-3535-8bc2-aebcf0b48f08",
                                "text": "The stopping, restarting, swearing and routine self-deprecation (\"I'm in trouble with the vicar – eternal trouble,\" quips Martin) is the kind of carry-on that has fans purring with pleasure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "088f8941-c21b-4ca8-bbd3-e6cc4c48d39e",
                        "source_entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
