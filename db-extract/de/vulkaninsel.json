                "senses": [
                    {
                        "sense_id": "3241be89-5f72-3147-9b36-5db8f36e254b",
                        "entry_id": "a19fe6c4-d2eb-388d-95c3-5eea189615ff",
                        "glosses": [
                            "aus einem oder mehreren Vulkanen gebildete Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc46cae0-f46e-4fce-a5bc-88390ab07473",
                                "sense_id": "3241be89-5f72-3147-9b36-5db8f36e254b",
                                "text": "„Yap gehört zum Archipel der Karolinen, das aus über 500 Atollen und Vulkaninseln besteht, die sich halbmondförmig über ein Gebiet verteilen, das doppelt so groß wie die Nordsee ist.“"
                            },
                            {
                                "example_id": "7456513c-6d1c-4e80-9a17-1ca1dda9f14e",
                                "sense_id": "3241be89-5f72-3147-9b36-5db8f36e254b",
                                "text": "„Als 70-Jähriger kaufte Armin T. Wegner auf der Vulkaninsel Stromboli eine zerfallene Mühle und baute sie aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
