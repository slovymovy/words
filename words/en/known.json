{
    "word_family": [
        "know",
        "knowledge",
        "knowledgeable",
        "unknown",
        "knowing",
        "knowingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb57ef2a-8891-303f-9d74-f5b095df89fa",
                    "sense_definition": "Past participle of <w>know</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>known</w> my best friend since we were children.",
                            "target_lang_translations": {
                                "ru": "Я <w>знаю</w> своего лучшего друга с детства.",
                                "zh": "我和我最好的朋友从小就<w>认识</w>了。"
                            }
                        },
                        {
                            "text": "She should have <w>known</w> better than to go out in the storm.",
                            "target_lang_translations": {
                                "ru": "Ей следовало <w>знать</w>, что не стоит выходить на улицу в шторм.",
                                "zh": "她本该<w>知道</w>不应该在暴风雨中出门。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола \"знать\".",
                        "zh": "动词“知道”的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "глагол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知道",
                                "target_lang_sense_clarification": "动词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "070fd171-0226-3417-84b1-56dacb32c7e7",
                    "sense_definition": "Generally accepted, familiar, or understood through research or experience.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>known</w> fact that water boils at one hundred degrees.",
                            "target_lang_translations": {
                                "ru": "Это обще<w>известный</w> факт, что вода кипит при ста градусах.",
                                "zh": "水在一百度沸腾是一个<w>已知</w>事实。"
                            }
                        },
                        {
                            "text": "The cause of the fire is not yet <w>known</w> to the police.",
                            "target_lang_translations": {
                                "ru": "Причина пожара полиции пока не <w>известна</w>.",
                                "zh": "警方目前还不<w>知道</w>起火原因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "familiar",
                        "recognized",
                        "understood"
                    ],
                    "antonyms": [
                        "unknown"
                    ],
                    "common_phrases": [
                        "known fact",
                        "make known",
                        "known as"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятый, знакомый или понятный благодаря исследованию или опыту.",
                        "zh": "通过研究或经验被普遍接受、熟悉或理解的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "известный",
                                "target_lang_sense_clarification": "общепринятый"
                            },
                            {
                                "target_lang_word": "знакомый",
                                "target_lang_sense_clarification": "привычный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已知",
                                "target_lang_sense_clarification": "普遍接受的"
                            },
                            {
                                "target_lang_word": "熟悉",
                                "target_lang_sense_clarification": "了解的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99b06699-f255-30b1-abcb-843e3551bf5e",
                    "sense_definition": "Identified as a specific type; famous or renowned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>known</w> expert in the field of marine biology.",
                            "target_lang_translations": {
                                "ru": "Он <w>известный</w> эксперт в области морской биологии.",
                                "zh": "他是海洋生物学领域一位<w>著名</w>的专家。"
                            }
                        },
                        {
                            "text": "The city is well <w>known</w> for its beautiful historical architecture.",
                            "target_lang_translations": {
                                "ru": "Город хорошо <w>известен</w> своей красивой исторической архитектурой.",
                                "zh": "这座城市以其美丽的古建筑而<w>闻名</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "famous",
                        "renowned",
                        "celebrated",
                        "recognized",
                        "familiar"
                    ],
                    "antonyms": [
                        "unknown"
                    ],
                    "common_phrases": [
                        "well known",
                        "best known",
                        "known for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный как конкретный тип; знаменитый или прославленный.",
                        "zh": "被认定为特定类型；著名的或享有盛誉的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "известный",
                                "target_lang_sense_clarification": "знаменитый"
                            },
                            {
                                "target_lang_word": "признанный",
                                "target_lang_sense_clarification": "авторитетный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "著名",
                                "target_lang_sense_clarification": "有名"
                            },
                            {
                                "target_lang_word": "公认",
                                "target_lang_sense_clarification": "被认可的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76c204d5-159e-3d6b-8dc5-1fb67644dd90",
                    "sense_definition": "Any fact or situation which is already familiar or established.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to separate the <w>knowns</w> from the assumptions in this report.",
                            "target_lang_translations": {
                                "ru": "Нам нужно отделить <w>известное</w> от предположений в этом отчете.",
                                "zh": "我们需要把这份报告中的<w>已知事实</w>与假设区分开来。"
                            }
                        },
                        {
                            "text": "There are several <w>knowns</w> in this case that we can rely on.",
                            "target_lang_translations": {
                                "ru": "В этом деле есть несколько <w>известных фактов</w>, на которые мы можем положиться.",
                                "zh": "在这个案件中，有几个我们可以依赖的<w>已知事实</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certainty",
                        "fact"
                    ],
                    "antonyms": [
                        "unknown"
                    ],
                    "common_phrases": [
                        "knowns and unknowns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой факт или ситуация, которые уже знакомы или установлены.",
                        "zh": "任何已经熟悉或确立的事实或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "известное",
                                "target_lang_sense_clarification": "факт"
                            },
                            {
                                "target_lang_word": "известный факт",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已知事实",
                                "target_lang_sense_clarification": "确定的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35ffdb16-a218-32d8-b8a4-f6d74c8a092b",
                    "sense_definition": "A constant or variable the value of which is already determined.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this equation, we have two <w>knowns</w> and one variable to solve for.",
                            "target_lang_translations": {
                                "ru": "В этом уравнении у нас есть две <w>известные величины</w> и одна переменная, которую нужно найти.",
                                "zh": "在这个方程中，我们有两个<w>已知数</w>和一个需要求解的变量。"
                            }
                        },
                        {
                            "text": "Calculate the final result using the provided <w>knowns</w>.",
                            "target_lang_translations": {
                                "ru": "Рассчитайте конечный результат, используя предоставленные <w>данные</w>.",
                                "zh": "利用提供的<w>已知量</w>计算最终结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "constant"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Константа или переменная, значение которой уже определено.",
                        "zh": "数值已经确定的常数或变量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "известная величина",
                                "target_lang_sense_clarification": "математика"
                            },
                            {
                                "target_lang_word": "данное",
                                "target_lang_sense_clarification": "в условиях задачи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已知量",
                                "target_lang_sense_clarification": "数学"
                            },
                            {
                                "target_lang_word": "已知数",
                                "target_lang_sense_clarification": "数学"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}