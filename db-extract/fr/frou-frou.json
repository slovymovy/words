                ],
                "senses": [
                    {
                        "sense_id": "1390b198-c1d4-3fca-bf69-25a1b5b29ad5",
                        "entry_id": "eabbd1d5-00be-3a2b-96ac-158a67b2ca80",
                        "glosses": [
                            "Léger bruit que produit le frottement des étoffes, particulièrement des étoffes de soie."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "19391fad-b0c2-4fb9-8241-c88d7ebe0b3c",
                                "sense_id": "1390b198-c1d4-3fca-bf69-25a1b5b29ad5",
                                "text": "Dans le silence qui suivit, un léger frou-frou indiqua que Miss Peebles s’était levée, le visage bouleversé"
                            },
                            {
                                "example_id": "ddb98062-5b8d-43f1-8a32-ca6c4c77bf65",
                                "sense_id": "1390b198-c1d4-3fca-bf69-25a1b5b29ad5",
                                "text": "Mais un frou-frou de soie sur les dalles, la bordure d’un chapeau, un camail noir… C’était elle."
                            },
                            {
                                "example_id": "e68d5a5a-d5d2-427d-9d9b-e85ba26d61fe",
                                "sense_id": "1390b198-c1d4-3fca-bf69-25a1b5b29ad5",
                                "text": "Frou-frou, frou-frou par son jupon la femme\n Frou-frou, frou-frou de l'homme trouble l'âme\n Frou-frou, frou-frou certainement la femme\n Séduit surtout par son gentil frou-frou."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bd84ec6-aa7b-3d71-a4a7-4712ff645535",
                        "entry_id": "eabbd1d5-00be-3a2b-96ac-158a67b2ca80",
                        "glosses": [
                            "Bruit produit par le déplacement de certains animaux."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "629a3658-6cff-4c12-ad89-325436cd59b0",
                                "sense_id": "1bd84ec6-aa7b-3d71-a4a7-4712ff645535",
                                "text": "Ce ne fut qu'en entendant le frou-frou d'une bécasse arrivant sous le couvert qu'il tomba en arrêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b98be0a-eb3e-3e5e-9b24-2419f8ae4cb6",
                        "entry_id": "eabbd1d5-00be-3a2b-96ac-158a67b2ca80",
                        "glosses": [
                            "Sensation ressentie par le poète en évoquant le ciel étoilé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c53ce7ee-4a58-4431-a649-0bd3e8bc6e0d",
                                "sense_id": "2b98be0a-eb3e-3e5e-9b24-2419f8ae4cb6",
                                "text": "— Mes étoiles au ciel avaient un doux frou-frou."
                            }
                        ]
                    }
                ],
