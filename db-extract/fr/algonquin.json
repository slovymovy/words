                ],
                "senses": [
                    {
                        "sense_id": "2c59e879-c1bc-3681-a61a-c2451c2d3c61",
                        "entry_id": "21d798b6-5303-3b77-81bf-392129b5f514",
                        "glosses": [
                            "Individu de la tribu amérindienne du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2232cba4-5433-49b5-b04e-01a6aa246a30",
                                "sense_id": "2c59e879-c1bc-3681-a61a-c2451c2d3c61",
                                "text": "L’Institut d’études féministes et de genre de l’Université d’Ottawa, située sur le territoire traditionnel et non cédé du peuple Anishinabé-Algonquin, désire pourvoir un (1) poste régulier de professeur ou de professeure menant à la permanence en études afroféministes."
                            },
                            {
                                "example_id": "9bc9f77e-5062-4413-8ed6-6dc25412d42a",
                                "sense_id": "2c59e879-c1bc-3681-a61a-c2451c2d3c61",
                                "text": "J'ai quitté la Nouvelle-France l'an dernier en compagnie d'une petite bande d'Algonquins qui avaient promis à Champlain en personne de me conduire à bon port chez les Hurons."
                            },
                            {
                                "example_id": "4a433f5c-074c-421a-bc3a-3f3c60bbe4bd",
                                "sense_id": "2c59e879-c1bc-3681-a61a-c2451c2d3c61",
                                "text": "De nos jours, les Algonquins vivent principalement au Québec."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
