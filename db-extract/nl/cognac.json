                "senses": [
                    {
                        "sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                        "entry_id": "2578f223-991d-3fa0-b0cf-272ef525e29d",
                        "glosses": [
                            "Franse brandewijn die in en rond Cognac uit wijn gestookt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51886feb-1ef8-4fcb-bd60-21463ec0d43c",
                                "sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                                "text": "Achter haar ogenschijnlijke vrolijkheid, haar sigaret en haar glas cognac school een diep doorleefd besef van de existentiële tragiek."
                            },
                            {
                                "example_id": "1fbf1424-8589-4b8d-949f-9d026de83f60",
                                "sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                                "text": "En wat kon hij daar in godsnaam op antwoorden? Ze had een grote fles cognac in huis. En wat maakte het uit, het was nog vroeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc1812d-910f-4fa9-9475-9cee8452a511",
                        "source_entry_id": "2578f223-991d-3fa0-b0cf-272ef525e29d",
                        "source_sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                        "target_lang_word": "Kognak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kognak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                        "entry_id": "930627fa-5950-346c-8ddc-985472941f7f",
                                        "glosses": [
                                            "ein aus Wein destilliertes alkoholisches Getränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4cfc0a-070e-40e6-bf47-8b565a5e6eeb",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "Frankreich ist für seine außerordentlichen Kognaks bekannt."
                                            },
                                            {
                                                "example_id": "2ce996e9-8890-4114-bfa4-89bd114e30aa",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "„Er forderte zunächst mit Donnerstimme Kognak und schritt dann, da Bordeaux nicht aufzutreiben war, sogleich zur höchsten Stufe vor.“"
                                            },
                                            {
                                                "example_id": "d2494c25-4c72-463f-8a74-78dd6d88e4e8",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "„Ich brachte es fertig, keinen Kognak mehr zu trinken, ging ins Wohnzimmer und schlug das Telefonbuch auf.“"
                                            },
                                            {
                                                "example_id": "f384bbd9-b033-466b-86f2-c06ebafdb89d",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "„Die Konsulin, konfrontiert mit diesem tragischen Sachverhalt, stürzte einen doppelten costaricanischen Kognak todesmutig in die schöne Kehle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7ebd5bd-adcf-4432-8284-93c5da3228cb",
                        "source_entry_id": "2578f223-991d-3fa0-b0cf-272ef525e29d",
                        "source_sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
