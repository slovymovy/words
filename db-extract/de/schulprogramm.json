                "senses": [
                    {
                        "sense_id": "be647a32-20fe-3b8d-bfc2-c55f3d7d9306",
                        "entry_id": "224445f4-810d-364b-80dc-d7e3f9d31f23",
                        "glosses": [
                            "Leitbild einer Schule, in dem bestimmte Entwicklungsschwerpunkte und -ziele festgelegt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a57030a-1bc1-4e5a-bc19-3c37eabab679",
                                "sense_id": "be647a32-20fe-3b8d-bfc2-c55f3d7d9306",
                                "text": "„Der Ist-Stand und die zukünftigen Vorhaben werden in einem Schulprogramm festgeschrieben.“"
                            },
                            {
                                "example_id": "2e489913-9155-44da-9c14-927db8156bb1",
                                "sense_id": "be647a32-20fe-3b8d-bfc2-c55f3d7d9306",
                                "text": "„Welche Vor‐ und Nachteile weisen die Schulprogramme beim Vergleich miteinander auf?“"
                            },
                            {
                                "example_id": "91a141da-fb23-4485-8488-ae574e1362fe",
                                "sense_id": "be647a32-20fe-3b8d-bfc2-c55f3d7d9306",
                                "text": "„In dem Schulprogramm legt sie in Grundsätzen fest, wie sie den Bildungsauftrag erfüllt.“"
                            },
                            {
                                "example_id": "e8e86040-374c-4c9a-a065-874a51c1e54e",
                                "sense_id": "be647a32-20fe-3b8d-bfc2-c55f3d7d9306",
                                "text": "„Ein Schulprogramm wirkt identitätsstiftend nach innen und imagepflegend nach außen.“"
                            },
                            {
                                "example_id": "950cfff7-6cd5-4e71-b576-e7015e1c41de",
                                "sense_id": "be647a32-20fe-3b8d-bfc2-c55f3d7d9306",
                                "text": "„Die einzelne Schule gibt sich zur Ausgestaltung ihrer pädagogischen Arbeit und des Schullebens ein Schulprogramm, das sie der Schulaufsichtsbehörde vorlegt.“"
                            }
                        ],
