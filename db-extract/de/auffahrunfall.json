                "senses": [
                    {
                        "sense_id": "6dcc0343-a768-37a3-aa88-2ab10e633342",
                        "entry_id": "e73dc9ef-023b-310c-a6c4-3b8e8d05f14c",
                        "glosses": [
                            "Unfall/Zusammenstoß, bei dem ein Fahrzeug auf das vorherfahrende auffährt"
                        ],
                        "tags": [
                            "Unfalltyp"
                        ],
                        "examples": [
                            {
                                "example_id": "74bbe708-bdbf-45af-be4f-46806741da40",
                                "sense_id": "6dcc0343-a768-37a3-aa88-2ab10e633342",
                                "text": "Auffahrunfälle werden meistens von dem Fahrer des nachfolgenden Fahrzeugs verursacht."
                            },
                            {
                                "example_id": "cf71b638-bafc-41b9-a881-d53e273f9443",
                                "sense_id": "6dcc0343-a768-37a3-aa88-2ab10e633342",
                                "text": "„Sein Führerschein war ihm abgenommen worden, weil er auf dem Weg zur Arbeit einen Auffahrunfall verursacht hatte.“"
                            },
                            {
                                "example_id": "43b9e6b6-341a-44df-9c00-02991c2bedbc",
                                "sense_id": "6dcc0343-a768-37a3-aa88-2ab10e633342",
                                "text": "„Auf einer Sommerrodelbahn bei Lienz im österreichischen Bundesland Tirol ist es zu einer Serie von Auffahrunfällen mit 16 Beteiligten und mehreren Verletzten gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
