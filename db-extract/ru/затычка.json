                                "target_senses": [
                                    {
                                        "sense_id": "7d43fa0c-7596-33e5-a0e7-de361a57f991",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A pronged connecting device which fits into a mating socket, especially an electrical one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1377882d-9e13-45f1-8dde-0f8e634b3c3c",
                                                "sense_id": "7d43fa0c-7596-33e5-a0e7-de361a57f991",
                                                "text": "I pushed the plug back into the electrical socket and the lamp began to glow again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1d4953-6ad7-3e57-a1f2-fc08530fc9e6",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A pronged connecting device which fits into a mating socket, especially an electrical one.",
                                            "An electric socket: wall plug."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f9207d5-86a0-358a-9399-31efd2e781d3",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "Any piece of wood, metal, or other substance used to stop or fill a hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f6d71b-f710-43e7-b651-022d79520b10",
                                                "sense_id": "0f9207d5-86a0-358a-9399-31efd2e781d3",
                                                "text": "Pull the plug out of the tub so it can drain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded8b0b7-a73f-36fb-9ff6-f49769b54ad2",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A flat oblong cake of pressed tobacco."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d729b126-8c8f-4330-9201-9ac67b93fdcf",
                                                "sense_id": "ded8b0b7-a73f-36fb-9ff6-f49769b54ad2",
                                                "text": "He preferred a plug of tobacco to loose chaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14195f9f-3809-35e8-a6b2-df212e69ff9f",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A high, tapering silk hat."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42a11146-659b-3bc8-89f4-e58f4c2ecacf",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A worthless horse."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae1b086-3502-450a-bdef-e3fc40cc2884",
                                                "sense_id": "42a11146-659b-3bc8-89f4-e58f4c2ecacf",
                                                "text": "That sorry old plug is ready for the glue factory!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1922f9ad-ba3b-3e6c-b90d-98ab572f4af6",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "Any worn-out or useless article."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A book that fails to sell."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff44510-e711-4eb1-b4be-2c3b2936ae47",
                                                "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                                "text": "Stack all new and fresh, composed of the fast-selling standard books only — no old plugs or unsalable books whatever."
                                            },
                                            {
                                                "example_id": "12d2c89f-028f-4bf0-ba73-6deae2697df6",
                                                "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                                "text": "Many New York booksellers promoted the impression that Quaritch had sent only 'plugs' (i.e. unsaleable books)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67dc52d4-c85c-3ad2-8da0-b6cf16347dff",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A block of wood let into a wall to afford a hold for nails."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A promotion (act of promoting) of a product (such as a book, film or play) or other thing, concept, etc, for example during an interview or a commercial."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44cc37de-bb1a-4e79-a954-2459a4609998",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "During the interview, the author put in a plug for his latest novel."
                                            },
                                            {
                                                "example_id": "cf730a4d-972c-4e6a-88af-7cf613d07fea",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "She used her televised tour of the zoo to work in another plug for conservation."
                                            },
                                            {
                                                "example_id": "d1e51af7-b6a4-4cc7-9990-64a12a1e3ab2",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "Department store decorations up before Thanksgiving, Christmas cards all over the place, TV full of plugs for fifty-dollar toys that inner-city kids watching can never expect to receive, parents spending what they can't afford and deluging their kids with the annual orgy of materialist values […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1034e567-f240-3a62-ac05-36fce5187869",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A body of once molten rock that hardened in a volcanic vent. Usually round or oval in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbdee06-38fe-4756-a16b-a1cb060b6ce4",
                                                "sense_id": "1034e567-f240-3a62-ac05-36fce5187869",
                                                "text": "Pressure built beneath the plug in the caldera, eventually resulting in a catastrophic explosion of pyroclastic shrapnel and ash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e5d4ecb-6f7c-3f81-9082-1e87ffb6be99",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A type of lure consisting of a rigid, buoyant or semi-buoyant body and one or more hooks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7d9e77-a2e0-4c41-9618-76ae4930a58a",
                                                "sense_id": "5e5d4ecb-6f7c-3f81-9082-1e87ffb6be99",
                                                "text": "The fisherman cast the plug into a likely pool, hoping to catch a whopper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ed8cd7-4006-391a-a6b3-b991b28eb203",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A small seedling grown in a tray from expanded polystyrene or polythene filled usually with a peat or compost substrate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
