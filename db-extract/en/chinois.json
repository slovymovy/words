                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chinois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f1f9b6-9e1a-33f4-bbbf-7bbd543534dd",
                                        "entry_id": "7a4e28cc-b431-343e-85d3-843e01ea62c4",
                                        "glosses": [
                                            "Qui se rapporte aux Chinois, à la Chine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f17b332-586e-4a0f-809c-641aa6ffe2ab",
                                                "sense_id": "e2f1f9b6-9e1a-33f4-bbbf-7bbd543534dd",
                                                "text": "À l’égard de la population des autres parties de l’empire chinois, nous croyons que l’on pourrait la porter tout au plus à 20 millions."
                                            },
                                            {
                                                "example_id": "d17bb6f0-6a87-4ab8-9e21-402ad1e1f1a0",
                                                "sense_id": "e2f1f9b6-9e1a-33f4-bbbf-7bbd543534dd",
                                                "text": "La forme de l’esclavage était celle de l’esclavage domestique et le sort des esclaves était certainement moins dur que celui des nègres qui travaillaient dans les plantations d’Amérique ou même les coolies chinois ou canaques qui les ont remplacés."
                                            },
                                            {
                                                "example_id": "0d32028a-3bd2-40e7-82a8-891222b706f4",
                                                "sense_id": "e2f1f9b6-9e1a-33f4-bbbf-7bbd543534dd",
                                                "text": "C’est ce qui explique à la fois le caractère rachitique du secteur commercial créé par les petits colporteurs et boutiquiers chinois, et son développement à pas de tortue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "201c87e9-57ba-3f78-a65e-ab7d3ba9f1b7",
                                        "entry_id": "7a4e28cc-b431-343e-85d3-843e01ea62c4",
                                        "glosses": [
                                            "Relatif à la langue parlée et écrite par les sinophones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71838db5-55c8-4c48-a624-727cc83b49d0",
                                                "sense_id": "201c87e9-57ba-3f78-a65e-ab7d3ba9f1b7",
                                                "text": "Un caractère chinois."
                                            },
                                            {
                                                "example_id": "9e80e6d9-c035-4f39-b189-c39b5cddf1c9",
                                                "sense_id": "201c87e9-57ba-3f78-a65e-ab7d3ba9f1b7",
                                                "text": "L’écriture chinoise est arrivée au Japon vers le quatrième siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0100688f-2a5a-31f2-9e07-dbd38a1c8ae0",
                                        "entry_id": "7a4e28cc-b431-343e-85d3-843e01ea62c4",
                                        "glosses": [
                                            "Compliqué, très difficile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a15dc1-c15f-48f3-a242-1cb73fed52cf",
                                                "sense_id": "0100688f-2a5a-31f2-9e07-dbd38a1c8ae0",
                                                "text": "Un casse-tête chinois."
                                            },
                                            {
                                                "example_id": "73095ef4-b180-4a60-8170-35822034e7ca",
                                                "sense_id": "0100688f-2a5a-31f2-9e07-dbd38a1c8ae0",
                                                "text": "– Pour parler à mes parents, ça va être chinois…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chinois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2aaaf05-8169-31fa-9ea8-164d6145836b",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Langue sinitique principalement parlée par les Hans et correspondant à un système d’écriture à base de sinogrammes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf92fac-e805-41d7-8c38-8543bb4440ea",
                                                "sense_id": "c2aaaf05-8169-31fa-9ea8-164d6145836b",
                                                "text": "Parler chinois."
                                            },
                                            {
                                                "example_id": "4281d39c-2184-4112-82a3-07e4cc384458",
                                                "sense_id": "c2aaaf05-8169-31fa-9ea8-164d6145836b",
                                                "text": "5000 caractères sont couramment employés, représentant chacun un élément du chinois."
                                            },
                                            {
                                                "example_id": "39778a64-bf17-4b8c-9206-25d9afb5051c",
                                                "sense_id": "c2aaaf05-8169-31fa-9ea8-164d6145836b",
                                                "text": "Comme les temps ne sont pas marqués en chinois, c'est à l'imagination de reconstituer cette succession de moments distincts."
                                            },
                                            {
                                                "example_id": "16e8d436-ff65-4532-a702-eeb387dac127",
                                                "sense_id": "c2aaaf05-8169-31fa-9ea8-164d6145836b",
                                                "text": "[…] pour saisir quelque chose de tellement chinois, il faudrait se faire Chinois soi-même, penser et écrire en chinois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90a2d785-2887-3b1d-8277-619f00ab09ee",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Langue sinitique principalement parlée par les Hans et correspondant à un système d’écriture à base de sinogrammes.",
                                            "Chinois classique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b14ed7e4-e646-3946-a17c-ad54bce64df4",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Langue sinitique principalement parlée par les Hans et correspondant à un système d’écriture à base de sinogrammes.",
                                            "Mandarin, langue officielle de la Chine, de Taïwan et de Singapour."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b50934c-f0e3-3766-aa58-fe0fc611ba50",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Passoire de forme conique, utilisée en art culinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096eed13-6e4f-4a1c-a4c0-17a1704542ff",
                                                "sense_id": "6b50934c-f0e3-3766-aa58-fe0fc611ba50",
                                                "text": "D’une certaine manière, ils aimaient tout ce qui niait la cuisine et exaltait l’apparat. Ils aimaient l’abondance et la richesse apparentes ; ils refusaient la lente élaboration qui transforme en mets des produits ingrats et qui implique un univers de sauteuses, de marmites, de hachoirs, de chinois, de fourneaux."
                                            },
                                            {
                                                "example_id": "9e376058-e049-4be8-b034-93280f05ecb8",
                                                "sense_id": "6b50934c-f0e3-3766-aa58-fe0fc611ba50",
                                                "text": "Quand tout est cuit, transvaser dans le mixeur, donner 3 impulsions, en ajoutant un peu d’eau (mais pas de lait) entre chaque impulsion, pour obtenir un velouté, que l’on passera au chinois afin qu’il soit bien lisse…"
                                            },
                                            {
                                                "example_id": "2eb53d16-6724-4617-9457-a754ddf1ec28",
                                                "sense_id": "6b50934c-f0e3-3766-aa58-fe0fc611ba50",
                                                "text": "Il tournait les sauces, les passait au chinois ; des tâches qui lui permettaient de développer sa capacité de concentration et d'exécuter des gestes contrôlés, minutieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc70567-d7e3-3849-80e9-ce80d812bbde",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Restaurant chinois."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edd6992a-283e-4f4a-bf33-a75457bf435e",
                                                "sense_id": "7fc70567-d7e3-3849-80e9-ce80d812bbde",
                                                "text": "Ils déjeunèrent aux Puces de Saint-Ouen, à Saint-Cloud, dans un « chinois » près de la gare de Lyon, dans une crêperie bretonne de la rue Grégoire-de-Tours, ailleurs encore et n’importe où, au fil du vent, libres comme ces pigeons de rencontre à qui Pat jetait du riz porte-chance."
                                            },
                                            {
                                                "example_id": "4cf0aebe-a976-4ed4-9695-139aa67949bc",
                                                "sense_id": "7fc70567-d7e3-3849-80e9-ce80d812bbde",
                                                "text": "Le chinois en bas de chez moi il avait trois spécialités : le travers de porc, les Gambas grillées et l’OUICHE Lorraine, alors tu penses…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2620291a-0649-3c17-a7f7-7109f1e6eda8",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Plat préparé dont la recette est d’origine chinoise."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d56b658-30fc-326e-8784-35da38a0baf2",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Autre nom du schneckenkuchen, viennoiserie d’origine allemande, composée de plusieurs petites brioches enroulées et garnies de crème pâtissière parfumée à la cannelle et au kirsch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1cd4e7-bdcc-4e67-96d7-3e7e981bc74f",
                                                "sense_id": "5d56b658-30fc-326e-8784-35da38a0baf2",
                                                "text": "Quand son confrère venu d’Alsace lui répondit \"Schneckenkuchen\", il dit « C’est du chinois pour moi! ». Ainsi, le mot « chinois » resta pour cette pâtisserie qui s’appelait en fait « gâteau-escargot »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc2bce3-2a7e-367f-a779-55b270e9ee9f",
                                        "entry_id": "92205ac8-ab5f-38c9-b471-9aefde5c646f",
                                        "glosses": [
                                            "Sorte de petit agrume qu’on utilise en confiserie."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d23583a-25c1-4b79-b1bd-5571bf7e26ac",
                                                "sense_id": "4dc2bce3-2a7e-367f-a779-55b270e9ee9f",
                                                "text": "On se mit à le praliner en surface et à le décorer de la moitié d'un chinois (sorte de kumquat confit et à l’eau-de-vie), ou d’une prune. La mode de ce décor passa."
                                            },
                                            {
                                                "example_id": "8e1fabad-aa59-45b8-8e8d-df4dd0ce8113",
                                                "sense_id": "4dc2bce3-2a7e-367f-a779-55b270e9ee9f",
                                                "text": "Le chinois confit est déjà mentionné par Machet dans son Confiseur moderne, au début du XIXᵉ siècle, sous le nom d'« orange de Chine ». Ce fruit n’est confit qu'après un long séjour dans l’eau fraîche, destiné à lui ôter son amertume."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
