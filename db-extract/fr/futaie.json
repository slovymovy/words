        "fr-extract.jsonl": [
            {
                "entry_id": "dd1e6c17-3bfc-3c2b-b831-ba3915f55406",
                "word": "futaie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf1a0f11-e57e-4eb3-a873-7388bfacafa4",
                        "entry_id": "dd1e6c17-3bfc-3c2b-b831-ba3915f55406",
                        "tags": [
                            "plural"
                        ],
                        "form": "futaies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                        "entry_id": "dd1e6c17-3bfc-3c2b-b831-ba3915f55406",
                        "glosses": [
                            "Forêt où l’on n’a conservé que les arbres destinés à atteindre leur pleine croissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc910001-7807-41d3-970a-40fd5924650d",
                                "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                                "text": "La lande descendait en pente douce vers le nord jusqu’à une noble futaie de chênes plantée en quinconce et qui couvrait un large plateau situé à mi-côte."
                            },
                            {
                                "example_id": "693bfc8f-c504-4aa9-99eb-27f1b11d51ea",
                                "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                                "text": "Avant d’exploiter une coupe, on a dû marquer les arbres que l’on veut réserver, tant dans le taillis que dans la futaie ; cette marque se fait ordinairement au pied de l’arbre à l’aide d’un marteau."
                            },
                            {
                                "example_id": "efb8c887-ff36-41da-82d8-f5b7b4f9f469",
                                "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                                "text": "D’importantes coupes de bois furent faites dans la futaie qui bordait la côte orientale du lac Barnett."
                            },
                            {
                                "example_id": "68a59a47-bf99-4b8d-9672-83d01aab227a",
                                "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                                "text": "Sous le couvert épais de la futaie, à luminosité réduite, la fructification devient difficile ; aussi, […], la multiplication végétative par stolons, rhizomes ou bulbes est-elle souvent la règle pour beaucoup d’espèces."
                            },
                            {
                                "example_id": "f521cfd1-ed92-4abc-b097-5c01e6397fc6",
                                "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                                "text": "J’ai maintenant des frênes\nDes arbres de Judée\nTous de bonne graine\nDe haute futaie."
                            },
                            {
                                "example_id": "3dea43a7-0ba6-4695-a903-fde3ffae92a1",
                                "sense_id": "7203f70d-ec84-3f96-bebe-9a3207f4043d",
                                "text": "À titre de comparaison, dans la forêt de Tronçais, exploitée par l’Office national des forêts, dont la plus ancienne futaie a été créée sous Colbert et est aujourd’hui protégée en réserve biologique, on trouve des chênes de seulement... quelque 300 ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a23e200-3810-3268-86e6-9bb424760fc4",
                        "entry_id": "dd1e6c17-3bfc-3c2b-b831-ba3915f55406",
                        "glosses": [
                            "Traitement sylvicole visant à obtenir une futaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8090c1-068c-4e1d-a94f-1fd9908c7a18",
                                "sense_id": "9a23e200-3810-3268-86e6-9bb424760fc4",
                                "text": "Mais il y a plusieurs manières d’exploiter culturalement une forêt, suivant la nature des produits que l’on veut en tirer. La futaie d’abord, pour obtenir des bois de grandes dimensions."
                            },
                            {
                                "example_id": "2c96fdf5-8939-4611-962e-e08d209f5a13",
                                "sense_id": "9a23e200-3810-3268-86e6-9bb424760fc4",
                                "text": "Dans ces conditions écologiques contraignantes, le choix du traitement en futaie par parquets, où la sylviculture s’apparente à la futaie régulière mais où le renouvellement est conduit sur des parquets de taille réduite (1 à 2 ha), est tout aussi envisageable que celui de la futaie irrégulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "8624e439-e995-36df-96f0-93dac812ec32",
                        "entry_id": "dd1e6c17-3bfc-3c2b-b831-ba3915f55406",
                        "glosses": [
                            "Ensemble d’objets évoquant l’aspect des troncs d’une forêt."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d9f26479-59a8-4518-8252-271e98d9447f",
                                "sense_id": "8624e439-e995-36df-96f0-93dac812ec32",
                                "text": "La grêle futaie des mâts, sans cesse balancés par des houles, rayait le ciel ; les beauprés se penchaient vers le large pour cueillir les souffles errants, et les grandes voiles brunes claquaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64d7469a-5e6d-4bed-a625-786ab32d193a",
                        "source_entry_id": "dd1e6c17-3bfc-3c2b-b831-ba3915f55406",
                        "target_lang_word": "Hochwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44783568-bfa2-31b9-b73a-fdf7f98d1889",
                                        "entry_id": "adbbe085-24fb-3cc9-add0-1bdf2f9e2093",
                                        "glosses": [
                                            "eine Betriebsart, bei der der Wald kein Unterholz aufweist und aus hohen Bäumen besteht, die aus Samen gezogen wurden"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed9225f-168e-4a90-af49-df03bbe9e322",
                                                "sense_id": "44783568-bfa2-31b9-b73a-fdf7f98d1889",
                                                "text": "Buchenwälder sind typische Hochwälder."
                                            },
                                            {
                                                "example_id": "3483e73c-4973-4bd0-9efb-e2b959754d7d",
                                                "sense_id": "44783568-bfa2-31b9-b73a-fdf7f98d1889",
                                                "text": "Eine Erzählung von Adalbert Stifter heißt \"Der Hochwald\"."
                                            },
                                            {
                                                "example_id": "e66f5e30-f55d-4d64-babf-4ec53978fd6c",
                                                "sense_id": "44783568-bfa2-31b9-b73a-fdf7f98d1889",
                                                "text": "„Es ging durch den Hochwald.“"
                                            },
                                            {
                                                "example_id": "228f7654-1aab-45eb-94a0-5be49f64ab35",
                                                "sense_id": "44783568-bfa2-31b9-b73a-fdf7f98d1889",
                                                "text": "„Links hin lagen die Häuser und Hütten in der malerischen Einfassung ihrer Gärten, während nach rechts hin, am jenseitigen Ufer der Bode, der Hochwald anstieg, auf dessen Lichtungen das Vieh weidete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hochwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                        "entry_id": "fe0d8b02-5b12-35ca-80ea-15a1e5fd0a8b",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d1ec83d-9d21-49ae-9d2a-cfbb7e7583b6",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Frau Hochwald ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "42d9d9b3-9743-4d25-af47-b0ce7d84652f",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Herr Hochwald wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "66f1c0f3-86a4-4bbd-8ce9-863ba7590691",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Die Hochwalds fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "a5c5da51-6ca9-4c13-876d-30df35458369",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Der Hochwald trägt nie die Schals, die die Hochwald ihm strickt."
                                            },
                                            {
                                                "example_id": "0289df32-740a-466b-adb4-d4f33eaf8ad5",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hochwald kommt, geht der Herr Hochwald.“"
                                            },
                                            {
                                                "example_id": "3ca29f1f-1261-4533-9c09-ebe2075b1f51",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Hochwald kommt und geht."
                                            },
                                            {
                                                "example_id": "30b0c02c-4879-474f-93b1-ee761e59ff0d",
                                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                                "text": "Hochwalds kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
