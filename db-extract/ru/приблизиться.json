                "senses": [
                    {
                        "sense_id": "88ef12c3-50a1-308a-8668-cff2bfdd376f",
                        "entry_id": "ff720db7-d89f-3373-bfb7-e5fd8ba3efac",
                        "glosses": [
                            "переместившись или распространившись, стать ближе к чему-либо, сократить пространственное расстояние до чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "80010197-2d1a-3764-bd45-f780df851431",
                        "entry_id": "ff720db7-d89f-3373-bfb7-e5fd8ba3efac",
                        "glosses": [
                            "стать ближе к какому-либо объекту по мере движения этого объекта"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "619708c3-c1f5-3298-b82d-daa32bc6c789",
                        "entry_id": "ff720db7-d89f-3373-bfb7-e5fd8ba3efac",
                        "glosses": [
                            "перен. стать ближе во времени, наступить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f929890-d4f7-40c9-8e8b-32a122967430",
                                "sense_id": "619708c3-c1f5-3298-b82d-daa32bc6c789",
                                "text": "Последний форум вулканологов показал, что мы лишь приблизились к пониманию крайней сложности, противоречивости и неоднозначности процесса магмообразования."
                            }
                        ]
                    },
                    {
                        "sense_id": "d81af372-686c-3287-affe-3666b62327fe",
                        "entry_id": "ff720db7-d89f-3373-bfb7-e5fd8ba3efac",
                        "glosses": [
                            "вступить в более близкие, доверительные отношения с кем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "077a1873-62c5-368a-a878-5da9c3d6a4fd",
                        "entry_id": "ff720db7-d89f-3373-bfb7-e5fd8ba3efac",
                        "glosses": [
                            "перен. стать более похожим на что-либо, сократить различие с чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f78751e4-4f6f-44d8-a96e-7fe176c24c72",
                        "source_entry_id": "ff720db7-d89f-3373-bfb7-e5fd8ba3efac",
                        "source_sense_description": "переместившись или распространившись, стать ближе к чему-либо",
                        "target_lang_word": "close in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "close in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1eac90c4-22e8-3bb1-94df-a2c53313124d",
                                        "entry_id": "ce7f7d59-2e48-3b6f-b8b2-6ab8d45444ca",
                                        "glosses": [
                                            "To enclose, lock up inside something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eddb323c-69b5-3d79-a19d-db5c2ecb3af7",
                                        "entry_id": "ce7f7d59-2e48-3b6f-b8b2-6ab8d45444ca",
                                        "glosses": [
                                            "To come or approach nearer to someone being pursued."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15d072b-2312-4389-870b-d1fbffdc8567",
                                                "sense_id": "eddb323c-69b5-3d79-a19d-db5c2ecb3af7",
                                                "text": "The police had not yet caught the thieves, but were closing in."
                                            },
                                            {
                                                "example_id": "fa177d84-93aa-4ce4-a472-784de1c37e19",
                                                "sense_id": "eddb323c-69b5-3d79-a19d-db5c2ecb3af7",
                                                "text": "Keep refining your estimate, and you will gradually close in on the right answer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e30b5df0-c518-3e7d-8d70-4dc0da38dd0b",
                                        "entry_id": "ce7f7d59-2e48-3b6f-b8b2-6ab8d45444ca",
                                        "glosses": [
                                            "To become closer, surround."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2feb82b-f045-4a97-9c63-8a681f66c64c",
                                                "sense_id": "e30b5df0-c518-3e7d-8d70-4dc0da38dd0b",
                                                "text": "Then we pass through Bebington station, and, entering a cutting, become aware of the usual signs of approach to an urban area—buildings closing in, an all-round increase in smokiness, and the application of brakes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
