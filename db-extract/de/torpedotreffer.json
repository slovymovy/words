                "senses": [
                    {
                        "sense_id": "22704372-891b-31b9-a95d-d5130c8391e4",
                        "entry_id": "ff05678a-d9fc-3857-a8e0-f53dea65a9e7",
                        "glosses": [
                            "Treffer, der durch einen Torpedo erzielt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eca9f2e-3f59-446d-9601-64d39da0be94",
                                "sense_id": "22704372-891b-31b9-a95d-d5130c8391e4",
                                "text": "„Ein Torpedotreffer genügte, um den größten Flugzeugträger des zweiten Weltkrieges, Japans 59 000 Tonner \"Shinano\", in die Tiefe zu schicken.“"
                            },
                            {
                                "example_id": "26cdfe2b-6a80-4950-9aa8-f2efb8a62f50",
                                "sense_id": "22704372-891b-31b9-a95d-d5130c8391e4",
                                "text": "„Außerdem erhielt das Schlachtschiff zwei Torpedotreffer.“"
                            },
                            {
                                "example_id": "47257dd6-a16f-4a5f-8178-f5638b8d3621",
                                "sense_id": "22704372-891b-31b9-a95d-d5130c8391e4",
                                "text": "„Doch im Augenblick des Untergangs, zweiundsechzig Minuten nach den Torpedotreffern, kroch einzig ich aus dem Loch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
