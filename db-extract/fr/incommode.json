                                    {
                                        "sense_id": "88ec0a74-7036-398e-aaae-f13ff6d33e2f",
                                        "entry_id": "67cc39b0-ae2d-3c8e-975c-63ec6392bc99",
                                        "glosses": [
                                            "Lacking dexterity in the use of the hands, or of instruments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a06436-e65f-479a-89d0-f20e4ad50b9c",
                                                "sense_id": "88ec0a74-7036-398e-aaae-f13ff6d33e2f",
                                                "text": "John was awkward at performing the trick. He'll have to practice to improve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "062e1a12-87e6-37f6-9d36-b7cc7dff16ed",
                                        "entry_id": "67cc39b0-ae2d-3c8e-975c-63ec6392bc99",
                                        "glosses": [
                                            "Not easily managed or effected; embarrassing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ae65e9-2c34-4bdf-9e23-1cedf262ca13",
                                                "sense_id": "062e1a12-87e6-37f6-9d36-b7cc7dff16ed",
                                                "text": "That was an extremely awkward moment. Everyone was watching."
                                            },
                                            {
                                                "example_id": "9428d338-2189-4b04-86dc-46168fce77a5",
                                                "sense_id": "062e1a12-87e6-37f6-9d36-b7cc7dff16ed",
                                                "text": "An awkward silence had fallen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffe10be7-a36c-3c88-bf7a-e3568b7def23",
                                        "entry_id": "67cc39b0-ae2d-3c8e-975c-63ec6392bc99",
                                        "glosses": [
                                            "Lacking social skills, or uncomfortable with social interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e68a1f-8950-419c-9d7e-3b46e422223c",
                                                "sense_id": "ffe10be7-a36c-3c88-bf7a-e3568b7def23",
                                                "text": "I'm very awkward at parties."
                                            },
                                            {
                                                "example_id": "e3399ce9-8d28-48ea-96f4-e55dde9ba83c",
                                                "sense_id": "ffe10be7-a36c-3c88-bf7a-e3568b7def23",
                                                "text": "Things got awkward when my boss tried a cheesy pick-up line on me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1f6b1d5-9d6c-3a87-8f51-4a1e4bfb3968",
                                        "entry_id": "67cc39b0-ae2d-3c8e-975c-63ec6392bc99",
                                        "glosses": [
                                            "Perverse; adverse; difficult to handle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e695cd0-8c2c-4f0d-9cae-31136958b62d",
                                                "sense_id": "c1f6b1d5-9d6c-3a87-8f51-4a1e4bfb3968",
                                                "text": "He's a right awkward chap."
                                            },
                                            {
                                                "example_id": "80ad7611-b75e-4756-8509-f0a4a50ad9bb",
                                                "sense_id": "c1f6b1d5-9d6c-3a87-8f51-4a1e4bfb3968",
                                                "text": "These cabinets are going to be very awkward when we move."
                                            },
                                            {
                                                "example_id": "0b1e13fc-45b8-4507-b9e6-7990dd62d9c2",
                                                "sense_id": "c1f6b1d5-9d6c-3a87-8f51-4a1e4bfb3968",
                                                "text": "Clearing up rock and fallen vegetation at such an awkward site required a team of specialist geoengineers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "awkward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8505a2-5769-311c-aa82-8d8c0b67a7da",
                                        "entry_id": "e6a4b519-e9be-3e41-a979-010f7097861b",
                                        "glosses": [
                                            "Someone or something that is awkward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66cfc5cd-18e8-4253-8b56-480b8b776d8b",
                                                "sense_id": "5b8505a2-5769-311c-aa82-8d8c0b67a7da",
                                                "text": "Another important branch of deportment was to seat the awkwards stiffly on the extreme edge of a chair, fold the hands on the very precarious lap, droop the eyes in a pensive way."
                                            },
                                            {
                                                "example_id": "aeff3968-c591-4076-b334-1c1f34e235d9",
                                                "sense_id": "5b8505a2-5769-311c-aa82-8d8c0b67a7da",
                                                "text": "'What periods are you talking about?' / 'The monthly awkwards. Didn't the girls at Molyneux have them when you were managing director?' / The Rabbit leaned forward, sniffing the air in the immediate vicinity. 'Either you've been drinking or you've got some girl into trouble. Or am I being unfair to you and it's both?'"
                                            },
                                            {
                                                "example_id": "01339e78-9516-48ce-8f13-86d0e2c8bf8e",
                                                "sense_id": "5b8505a2-5769-311c-aa82-8d8c0b67a7da",
                                                "text": "That is a way to make awkwards. And it's not fun to hang out with awkwards more than once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
