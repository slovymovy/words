    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0cbd1a5-186d-3485-900a-815445f012d6",
                    "sense_definition": "Sortir d'un liquide et apparaître au-dessus de sa surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue plongée, le nageur <w>émerge</w> enfin à la surface pour respirer."
                        },
                        {
                            "text": "Plusieurs rochers pointus <w>émergent</w> de l'eau quand la marée commence à descendre."
                        }
                    ],
                    "synonyms": [
                        "remonter",
                        "surgir"
                    ],
                    "antonyms": [
                        "plonger",
                        "s'immerger"
                    ],
                    "common_phrases": [
                        "émerger de l'eau",
                        "émerger à la surface"
                    ]
                },
                {
                    "sense_id": "2a376dfe-5b19-3830-8e87-fc8dc774c7fc",
                    "sense_definition": "Sortir du sommeil et reprendre progressivement ses esprits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il me faut toujours un grand café pour <w>émerger</w> le matin avant de travailler."
                        },
                        {
                            "text": "Paul a beaucoup de mal à <w>émerger</w> quand son réveil sonne très tôt."
                        }
                    ],
                    "synonyms": [
                        "se réveiller"
                    ],
                    "antonyms": [
                        "s'endormir"
                    ],
                    "common_phrases": [
                        "avoir du mal à émerger",
                        "émerger du sommeil"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "b87a73ae-d086-3a9f-bdd1-87a1a62ee27b",
                    "sense_definition": "Commencer à se manifester, à être connu ou à prendre de l'importance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nouvelles idées prometteuses <w>émergent</w> souvent lors des réunions de travail créatives."
                        },
                        {
                            "text": "Une solution commune commence enfin à <w>émerger</w> après plusieurs heures de débat difficile."
                        }
                    ],
                    "synonyms": [
                        "apparaître",
                        "se révéler"
                    ],
                    "antonyms": [
                        "s'effacer",
                        "décliner"
                    ],
                    "common_phrases": [
                        "faire émerger"
                    ]
                },
                {
                    "sense_id": "906a6c8d-82fb-32da-a75a-765fbbd3782d",
                    "sense_definition": "Sortir d'un élément obscur ou opaque pour devenir visible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La silhouette d'un vieux manoir a fini par <w>émerger</w> de la brume épaisse."
                        },
                        {
                            "text": "Les sommets enneigés des montagnes <w>émergeaient</w> fièrement au-dessus de la mer de nuages."
                        }
                    ],
                    "synonyms": [
                        "apparaître",
                        "se détacher"
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "common_phrases": [
                        "émerger de la brume",
                        "émerger du brouillard"
                    ]
                }
            ]
