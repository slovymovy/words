                        "entry_id": "996d9085-d7b1-33dc-a32d-b5a767a263e5",
                        "glosses": [
                            "A river in the United Kingdom; a river in the Scottish Borders area which for part of its length forms the border between Scotland and England. It flows into the North Sea at Berwick-upon-Tweed and Tweedmouth, England."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "53c724b1-cf90-463c-929c-6020bf27212a",
                                "sense_id": "ac918690-f90c-30c9-b56d-d31b57a27990",
                                "text": "The Tweed is a salmon river, and the Blessing of the Nets ceremony heralds the start of the fishing season."
                            }
                        ]
                    },
