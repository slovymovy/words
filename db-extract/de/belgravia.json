                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a3347a0-e1c6-4f2a-99a0-384b82f8c2ec",
                                "sense_id": "8b1054eb-de11-32ae-af5e-8aadba23cda0",
                                "text": "„Sie führte sie nach Belgravia, eins der schönsten und teuersten Viertel Londons, allerdings erschloss sich das nicht unbedingt auf den ersten Blick von der Straße aus.“"
                            }
                        ],
