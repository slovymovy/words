                        "entry_id": "a0887622-dcf3-3a0c-a50d-396775347eba",
                        "glosses": [
                            "Qui présente des bosses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec19ba3-32bc-4dff-b238-1482c15e8a0d",
                                "sense_id": "0dd59739-9549-30cc-96d8-16e2e80445f2",
                                "text": "Les canotiers exposaient à l’ardeur du jour la chair brunie et bosselée de leurs biceps."
                            },
                            {
                                "example_id": "ad927faa-47bb-407b-8fdf-5ef4d7cf7843",
                                "sense_id": "0dd59739-9549-30cc-96d8-16e2e80445f2",
                                "text": "Mettons-nous d’accord : le couvercle d’une boîte saine dont le bord ne serait pas bosselé, un tel couvercle ne devrait avoir d’autre désir que de se trouver sur sa boîte."
                            }
                        ]
                    },
