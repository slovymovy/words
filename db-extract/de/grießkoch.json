                ],
                "senses": [
                    {
                        "sense_id": "d4648049-9efa-3c4e-90d1-8c59e3d2595a",
                        "entry_id": "20ba0d29-e687-3280-8665-bf2f1613c776",
                        "glosses": [
                            "„ein aus Grieß (Weichweizengrieß) gekochter Brei, der mit Milch, leicht gesalzener Milch oder einer Mischung aus Milch und Wasser zubereitet wird“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b32df1-dd8e-4692-9a7e-d1b746e32f83",
                                "sense_id": "d4648049-9efa-3c4e-90d1-8c59e3d2595a",
                                "text": "„In Ihren Köpfen tauchen jetzt sicherlich verklärte Bilder vom dampfenden Grießkoch auf, mit dem die Großmütter so manchen Abend versüßten und das Kranksein zur Wonne machten.“"
                            },
                            {
                                "example_id": "73d985ce-1ae5-4a37-89fb-f02a9f8cbaa1",
                                "sense_id": "d4648049-9efa-3c4e-90d1-8c59e3d2595a",
                                "text": "„Die Mitarbeit des Beklagten im Haushalt habe sich im wesentlichen darauf beschränkt, daß er den Kindern fallweise das von der Klägerin vorbereitete Essen wärmte oder auch einfache Mahlzeiten (Grießkoch) herstellte, insbesondere wenn die Klägerin Inkassogänge machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
