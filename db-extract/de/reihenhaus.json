                    {
                        "form_id": "990fc305-c4f8-478f-8c3f-128b5654ca51",
                        "entry_id": "50a4e2af-286a-3e5c-bbf9-7fad0a3a7cb7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reihenhäuser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                        "entry_id": "50a4e2af-286a-3e5c-bbf9-7fad0a3a7cb7",
                        "glosses": [
                            "eines von mehreren, in einer Reihe aneinandergebauten Häusern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe52fda-5734-4ff3-ac83-e1e95b365990",
                                "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                                "text": "Wir wohnen in einem Reihenhaus."
                            },
                            {
                                "example_id": "9209324b-e266-439a-ad87-7ec3957862a6",
                                "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                                "text": "„Ein kleiner Eisberg in Größe eines mittleren Reihenhauses ist jenseits des Hafens am Kobbefjord gestrandet.“"
                            },
                            {
                                "example_id": "90c47c29-af03-43fe-9c52-47b3f37a6c6d",
                                "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                                "text": "„Unser kleiner Bunker lag hinter unserem Reihenhaus, ganz am Ende des langen, schmalen, handtuchförmigen Gartens.“"
                            },
                            {
                                "example_id": "ee2517ed-03b4-41dc-9d8f-d6588461d787",
                                "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                                "text": "„Der Bauträger hat längst neue Interessenten für das Reihenhaus gefunden.“"
                            },
                            {
                                "example_id": "9a28042d-733f-4037-981b-a1f6e588b1bf",
                                "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                                "text": "„Mit seiner Frau Elsa, den beiden Stieftöchtern und der bewährten Sekretärin Helene Dukas aus Freiburg bewohnten die Einsteins ein Reihenhaus in Princeton.“"
                            },
                            {
                                "example_id": "996c31af-5a52-46ca-aa94-be0ca3d607dd",
                                "sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                                "text": "„Das Viertel mochte jüdisch sein, aber es war kein Weequahic, sondern ein gesichtsloser, aus dem Boden gestampfter Vorort, dessen Reihenhäuser schutzlos und trist an baumlosen Straßen standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd887e27-eff2-4476-8460-dfdf0d93f2d3",
                        "source_entry_id": "50a4e2af-286a-3e5c-bbf9-7fad0a3a7cb7",
                        "source_sense_id": "9501a7dc-9ea4-3639-afd8-c79c3f35c4dd",
                        "source_sense_description": "Architektur: eines von mehreren, in einer Reihe aneinandergebauten Häusern",
                        "target_lang_word": "row house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "row house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7f90099-97eb-3abb-aba8-a2f9b170e961",
                                        "entry_id": "f2231ca4-c7f4-3598-9345-6304d0efd29b",
                                        "glosses": [
                                            "A variety of residential building where the individual houses lining a street share adjacent walls in common and have a continuous stretch of roof"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc2adb1-c88c-417d-8c68-40d2c75bdb5d",
                                                "sense_id": "e7f90099-97eb-3abb-aba8-a2f9b170e961",
                                                "text": "The walls in Eduardo's row house were so thin he could hear the neighbors two houses down."
                                            },
                                            {
                                                "example_id": "bf13dea2-fdac-4dec-9d95-42e1b7fa4116",
                                                "sense_id": "e7f90099-97eb-3abb-aba8-a2f9b170e961",
                                                "text": "When we meet Jess in the early '50s she's seven, living in a row house crammed against other row houses in a working-class Lancaster, all packed in against the steep hills that populate the English Northwest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
