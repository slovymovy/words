                    {
                        "translation_id": "f25d891a-ed38-43a1-b6e0-48126ef63a6d",
                        "source_entry_id": "fbd18154-00be-3acf-b72f-670939132b17",
                        "source_sense_id": "353ede45-ab7b-3145-8ca6-496bec24892f",
                        "target_lang_word": "sunshine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sunshine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "The direct rays, light or warmth of the sun."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d5b82a-dcb2-413a-b063-74a53cbe1dd1",
                                                "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                                                "text": "We were warmed by the bright sunshine."
                                            },
                                            {
                                                "example_id": "6b5a1b01-3def-4e55-8665-c286e3a973a0",
                                                "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                                                "text": "Oft tymes a thinge doth floꝛiſh, and men thynke that it maye abyde the Sonneſhyne: it ſhuteth foꝛth the bꝛaunches in his garden, it taketh many rotes, in ſo moch that it is like an houſe off ſtones."
                                            },
                                            {
                                                "example_id": "bfbf5a42-81e5-4c08-ab8a-94921b85ba89",
                                                "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                                                "text": "And all the ſhrubs, vvith ſparkling ſpangles, ſhevv / Like Morning-Sun-ſhine tinsilling the devv."
                                            },
                                            {
                                                "example_id": "e26f9b3b-8f9b-4bdb-80dd-9457f32e927d",
                                                "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                                                "text": "Sunshine, everybody loves the sunshine / Sunshine, folks get down in the sunshine / Sunshine, folks get brown in the sunshine"
                                            },
                                            {
                                                "example_id": "73c6f4fe-b1c3-4409-b882-c77baf61924f",
                                                "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                                                "text": "If there was no sunshine / Then life on Earth would not survive / Just like I would surely die / Without your love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c0ab1cc-1ffe-31e9-95d1-0fc4e823e2d9",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "A location on which the sun's rays fall."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ab5cac-b02b-4842-a3ee-dca4f51db3f2",
                                                "sense_id": "2c0ab1cc-1ffe-31e9-95d1-0fc4e823e2d9",
                                                "text": "We moved out of the shade and into the sunshine."
                                            },
                                            {
                                                "example_id": "687de68c-a4fa-4dec-b747-56e7b6012b1b",
                                                "sense_id": "2c0ab1cc-1ffe-31e9-95d1-0fc4e823e2d9",
                                                "text": "Out again into the sunshine by the wide mouth of the Green River, as the chart named the brook whose level stream scarce moved into the lake. A streak of blue shot up it between the banks, and a shrill pipe came back as the kingfisher hastened away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3982fb17-9d92-3229-b18c-d072862336c5",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "Geniality or cheerfulness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f13519-ba8d-42a7-b4ec-826549219e4b",
                                                "sense_id": "3982fb17-9d92-3229-b18c-d072862336c5",
                                                "text": "Ain't no sunshine when she's gone / Only darkness every day"
                                            },
                                            {
                                                "example_id": "ae11df39-db3a-47f2-bd97-6dced1e577d9",
                                                "sense_id": "3982fb17-9d92-3229-b18c-d072862336c5",
                                                "text": "I enjoyed the sunshine of her smile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e4a6718-1d2b-325f-b0b6-af9ce7636c9d",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "A source of cheerfulness or joy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2331a0bf-8794-4bdf-9a37-12833fc26191",
                                                "sense_id": "5e4a6718-1d2b-325f-b0b6-af9ce7636c9d",
                                                "text": "You are the sunshine of my life / That's why I'll always be around / You are the apple of my eye / Forever you'll stay in my heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62746901-fb2b-3613-8813-71f473873733",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "The effect which the sun has when it lights and warms some place."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ccafade-7f65-335d-8118-b32e045d9903",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "Friendly form of address often reserved for juniors."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "172c0bae-4c07-42e5-ab4f-584c726b1b7c",
                                                "sense_id": "6ccafade-7f65-335d-8118-b32e045d9903",
                                                "text": "Alright, sunshine, safe to cross now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a7bfd4-8650-35b0-8472-b3d301d8a695",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "Ironic form of address used to an inferior or troublemaker."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15ff3ba6-836e-4598-90d6-f3731b424b47",
                                                "sense_id": "77a7bfd4-8650-35b0-8472-b3d301d8a695",
                                                "text": "OK, sunshine, listen up and listen good. There's five vandalised telephone boxes out there and I know you're responsible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4261fff8-fe4a-3090-915c-60899a13f5f0",
                                        "entry_id": "9c844451-5575-382d-96da-23506f0a2648",
                                        "glosses": [
                                            "Used to address someone who has just woken up and/or is very sleepy."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe04b7a-3ebd-44d0-8e37-b25ed537f3f5",
                                                "sense_id": "4261fff8-fe4a-3090-915c-60899a13f5f0",
                                                "text": "Good morning, sunshine!"
                                            }
                                        ]
                                    },
