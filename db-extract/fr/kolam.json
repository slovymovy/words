                "senses": [
                    {
                        "sense_id": "edeb0402-951a-35f2-ace7-0f2e1659a008",
                        "entry_id": "a9cf2bb8-dbe2-3796-9f27-2c197103deb6",
                        "glosses": [
                            "En Inde, motif géométrique tracé au sol tôt le matin par les femmes avec de la poudre de riz colorée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37cc42d-5e35-4fc3-aab6-a6f66c848d59",
                                "sense_id": "edeb0402-951a-35f2-ace7-0f2e1659a008",
                                "text": "C'est sur un sol humidifié que sera tracé le dessin : la femme qui tracera le kolam prend d'abord soin d'asperger le sol d'eau propre généralement puisée de la main dans un seau."
                            },
                            {
                                "example_id": "9f875a22-0518-4685-98d3-20023d8a8fef",
                                "sense_id": "edeb0402-951a-35f2-ace7-0f2e1659a008",
                                "text": "Un kolam est un motif d'inspiration géométrique tracé à même le sol, avec de la poudre de riz et des poudres de couleur, à l'entrée des maisons de l’Inde."
                            },
                            {
                                "example_id": "5f9401a7-553e-4b85-abd3-c624a916ce32",
                                "sense_id": "edeb0402-951a-35f2-ace7-0f2e1659a008",
                                "text": "Elle a appris à reconnaître ces kolams que les femmes tracent sur le sol devant leur maison, dès le point du jour, à la poudre de riz, selon une tradition antique du sud de l’Inde."
                            }
                        ]
                    }
