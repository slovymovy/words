                            "past"
                        ],
                        "form": "ре́завшись"
                    },
                    {
                        "form_id": "6aa67c38-bf14-4e05-937d-c4e2f191fc77",
                        "entry_id": "62f56722-2a47-34ac-8586-97bdf27b2fc9",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… ре́заться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0fc39be-e1e2-38d7-80f6-d5546c98bff4",
                        "entry_id": "62f56722-2a47-34ac-8586-97bdf27b2fc9",
                        "glosses": [
                            "разделяться на части под действием режущего орудия, инструмента"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24fa367-0c5c-4cdf-9823-ea0e14fe44bf",
                                "sense_id": "a0fc39be-e1e2-38d7-80f6-d5546c98bff4",
                                "text": "Красная рыба мелко режется и обжаривается с зелёным луком."
                            }
                        ]
                    },
                    {
                        "sense_id": "70734be7-85ae-33a7-91b6-97abdf6aefc5",
                        "entry_id": "62f56722-2a47-34ac-8586-97bdf27b2fc9",
                        "glosses": [
                            "ранить или убивать себя острым предметом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5853800-65be-4b17-a2b9-ed5955b86e7c",
                                "sense_id": "70734be7-85ae-33a7-91b6-97abdf6aefc5",
                                "text": "К слову сказать, знамениты эти Васькины валенки: он в них зимою и летом, даже рыбу ловит в них, чтобы не резалась нога в реке о гальку."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a649da3-9b32-38f8-9c66-911a179fb5e5",
                        "entry_id": "62f56722-2a47-34ac-8586-97bdf27b2fc9",
                        "glosses": [
                            "разг. сражаться, драться, применяя холодное оружие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18eb91fd-9403-48d0-a200-f57acc05de33",
                                "sense_id": "4a649da3-9b32-38f8-9c66-911a179fb5e5",
                                "text": "И два часа в струях потока // Бой длился. Резались жестоко // Как звери, молча, с грудью грудь"
                            }
                        ]
                    },
                    {
                        "sense_id": "64f8a91c-d50e-32ac-8a3e-9c1b4c164a65",
                        "entry_id": "62f56722-2a47-34ac-8586-97bdf27b2fc9",
                        "glosses": [
                            "разг. играть во что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e640d89d-1ccb-4771-9670-24de86ebb0fe",
                                "sense_id": "64f8a91c-d50e-32ac-8a3e-9c1b4c164a65",
                                "text": "На берегу речки сидели Лида с Ваней и лениво резались в карты."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f91ae37-d1fd-3bf8-b8e8-26a62ba56b64",
                        "entry_id": "62f56722-2a47-34ac-8586-97bdf27b2fc9",
                        "glosses": [
                            "появиться на поверхности чего-либо"
                        ],
                        "tags": [
                            "о чём-либо растущем."
                        ],
                        "examples": [
                            {
                                "example_id": "c2310f8b-bea3-4bd1-a78c-d93d1be83959",
                                "sense_id": "8f91ae37-d1fd-3bf8-b8e8-26a62ba56b64",
                                "text": "Я никогда не думала, что она будет так малодушна. У Ниночки режутся зубы. Ну понятно, жар, болит животик."
                            },
                            {
                                "example_id": "28fb3762-bff0-4074-9a91-ee49a71f38b5",
                                "sense_id": "8f91ae37-d1fd-3bf8-b8e8-26a62ba56b64",
