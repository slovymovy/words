                    {
                        "translation_id": "ea8f4a70-731c-4598-9e43-bbae1d999b14",
                        "source_entry_id": "eced7de5-b744-309a-b712-345ca386199c",
                        "source_sense_id": "cc8575e4-5e37-3014-8061-c64defebe9e5",
                        "target_lang_word": "robustness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robustness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                        "entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                                        "glosses": [
                                            "The quality of being robust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b75165-7a18-409b-b0b4-5e32c5846dba",
                                                "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                                "text": "Robustness was considered to be an essential feature because of the comparatively high starting effort and the generally rough work for which the locomotives are to be used."
                                            },
                                            {
                                                "example_id": "8bd3cd99-5bae-4b06-a79e-602b1e07f692",
                                                "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                                "text": "The Inspecting Officer draws attention to the remarkable way in which the train held together after the final derailment; this was due in no small measure to the robustness of the buckeye couplings fitted to the coaches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb7f130-b0d2-474d-966f-15103c78fb84",
                        "source_entry_id": "eced7de5-b744-309a-b712-345ca386199c",
                        "source_sense_id": "cc8575e4-5e37-3014-8061-c64defebe9e5",
                        "target_lang_word": "robustesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robustesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea41259-52df-318b-aa3d-78d35c15e437",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Force, vigueur, en parlant d'une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b7ca66-3bf5-40b4-8533-3b1133fda6a0",
                                                "sense_id": "7ea41259-52df-318b-aa3d-78d35c15e437",
                                                "text": "Sa robustesse a triomphé de la maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Solidité, en parlant d’une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e51c7e8e-4bbd-42bc-87ea-d9eb3c857703",
                                                "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                                "text": "Des graines apportées par le vent avaient germé au hasard et se développaient avec cette robustesse vivace, particulière aux mauvaises herbes, à la place qu’avaient occupée les jolies fleurs et les plantes rares."
                                            },
                                            {
                                                "example_id": "348081b5-fab5-4e3c-8141-36d901e1982c",
                                                "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                                "text": "Selon les promoteurs des piles nucléaires multi-usages, leur robustesse serait un gage de sécurité."
                                            },
                                            {
                                                "example_id": "ccc00ade-a2b4-45f1-8f0b-63fba60b191c",
                                                "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                                "text": "Ainsi, la robustesse du protocole RSA, utilisé dans les cartes bancaires, vient du fait qu’il est facile de multiplier des nombres premiers entre eux mais qu’il est difficile de faire l’opération inverse : trouver les deux nombres connaissant leur produit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4054c05-32b8-3eec-8b36-f728c37c8bbb",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Capacité d’un programme informatique à fonctionner dans des conditions non nominales, comme les erreurs de saisie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b6c4fe-c9eb-4de1-9a3f-d79d28bc2027",
                                                "sense_id": "d4054c05-32b8-3eec-8b36-f728c37c8bbb",
                                                "text": "La robustesse du programme face aux retours de ligne en trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fadcf49-f63e-35b4-b2b7-b46e50072aed",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Capacité d’une installation à assurer certaines de ses fonctions de sûreté lorsqu’elle est soumise à des sollicitations plus fortes que celles qui sont prises en compte dans son référentiel de sûreté."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33396b7f-0227-4a74-92c9-8428d78e0bfa",
                        "source_entry_id": "eced7de5-b744-309a-b712-345ca386199c",
                        "source_sense_id": "cc8575e4-5e37-3014-8061-c64defebe9e5",
                        "target_lang_word": "Stärke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stärke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c9a17d-ccbc-34b5-87d8-a3b36254868f",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4442142-94b0-4ebf-84fe-ce6f82dd29e2",
                                                "sense_id": "d3c9a17d-ccbc-34b5-87d8-a3b36254868f",
                                                "text": "[1c] Nicht zuletzt aufgrund der Stärke seines Heeres konnte sich das römische Reich zum Imperium entwickeln."
                                            },
                                            {
                                                "example_id": "17c83991-2ccb-4f12-b1bd-2f1ee4643e4d",
                                                "sense_id": "d3c9a17d-ccbc-34b5-87d8-a3b36254868f",
                                                "text": "[Völkerrecht:] „Gegen das Recht des Stärkeren hilft nur die Stärke des Rechts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "(besonders ausgeprägte) Fähigkeit oder Fertigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c88f6a-6130-4959-879f-b17ceda0aee0",
                                                "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                                "text": "Mathematik war schon immer meine Stärke."
                                            },
                                            {
                                                "example_id": "ca573a76-51e4-45aa-9c5e-5b8d4d9597d9",
                                                "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                                "text": "Die Stärke der Religionen ist, dass sie Halt und Trost spenden können."
                                            },
                                            {
                                                "example_id": "3069859c-387a-40e3-a2b4-2dd2db4058ab",
                                                "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                                "text": "„Eine der Stärken der deutschen Sprache: Im Gegensatz zur französischen ist sie besser geerdet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ac10f7f6-f302-31d4-a46c-d16a3b49638a",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "Intensität einer (physikalischen) Größe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af61dc9a-0227-47ab-8810-264d7ab0d0e3",
                                                "sense_id": "ac10f7f6-f302-31d4-a46c-d16a3b49638a",
                                                "text": "Mit der Nähe zum Epizentrum steigt die Stärke des Erdbebens."
                                            },
                                            {
                                                "example_id": "3dc72eba-ef71-4d3c-aa1a-0a682518889c",
                                                "sense_id": "ac10f7f6-f302-31d4-a46c-d16a3b49638a",
                                                "text": "„Fakt ist: Der Klimawandel beeinflusst die Zahl und Stärke von Wetterextremen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "56719725-5566-37a9-aff7-351086d15a9d",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "zahlenmäßige Größe, Umfang einer Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1502df-56ce-4a7b-b697-3b6c9033738c",
                                                "sense_id": "56719725-5566-37a9-aff7-351086d15a9d",
                                                "text": "Das Korps der freiwilligen Frankfurter Kavallerie hatte eine Stärke von 200 Reitern."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "f86050c1-f883-30c6-8295-910c53bcb563",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "Dicke, (mechanische) Belastbarkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b4b43e-6400-4630-a908-81a6c06f8b8c",
                                                "sense_id": "f86050c1-f883-30c6-8295-910c53bcb563",
                                                "text": "Die Stärke des Bindfadens sollte genügen, um eine reißfeste Naht zu bilden."
                                            },
                                            {
                                                "example_id": "11470eb5-abfb-4367-afe4-b008741543c6",
                                                "sense_id": "f86050c1-f883-30c6-8295-910c53bcb563",
                                                "text": "„Trifft das noch zu im Zeitalter der Weltraumfahrt? Dieses Wort ist eine maßlose Übertreibung, ebenso wie sein Synonym Astronautik. Es gibt eine Reihe von Vergleichen, die das anschaulich machen. Einer mag genügen: Wenn jemand am Alpenrand, etwa bei Grainau unweit Garmisch, in 900 m Höhe über dem Meeresspiegel steht und zum Gipfel der Zugspitze (2000 m über ihm) hinaufblickt, und wenn er seinen Hals reckt, um dort oben etwas zu erkennen, und wenn ihm dann ein hilfsbereiter Freund ein Blatt von 0,2 mm Stärke unter die Schuhe schiebt, »damit du etwas näher dran bist und besser sehen kannst«, so hat sich dieser Jemand damit dem Zugspitzgipfel nur um ein Zehnmillionstel der gegebenen Distanz genähert (1 km = 1 Million mm). Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt. Andere Fixsterne sind millionen- und milliardenmal weiter entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1d\""
                                    },
                                    {
                                        "sense_id": "1d2021ac-1dd5-3b7c-b5ce-defae3b1864b",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "(physikalische) Leistung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a750f49f-cb1b-49a5-b8e8-39d36a6fbe88",
                                                "sense_id": "1d2021ac-1dd5-3b7c-b5ce-defae3b1864b",
                                                "text": "Die Stärke des Motors sorgt für eine hohe Beschleunigung des Wagens."
                                            }
                                        ],
                                        "sense_index_json": "\"1e\""
                                    },
                                    {
                                        "sense_id": "9e891ad4-181a-32e3-9653-f753d3886404",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "Leibesumfang, Beleibtheit"
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8bf0e8-a9b6-4422-823c-77acad18210c",
                                                "sense_id": "9e891ad4-181a-32e3-9653-f753d3886404",
                                                "text": "Während seiner Diät hat der Patient an Stärke abgenommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1f\""
                                    },
                                    {
                                        "sense_id": "2073b6af-0456-3e15-b1e5-52487bb9956c",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "ein Polysaccharid, pflanzlicher Speicherstoff"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273e9bfd-0175-4cbf-ba74-9459a846c477",
                                                "sense_id": "2073b6af-0456-3e15-b1e5-52487bb9956c",
                                                "text": "Die Knolle ist das Organ der Kartoffel, in welchem Stärke gespeichert wird."
                                            },
                                            {
                                                "example_id": "b5e9f541-8692-4092-a59b-c459996ea41e",
                                                "sense_id": "2073b6af-0456-3e15-b1e5-52487bb9956c",
                                                "text": "Da Stärke nicht wasserlöslich ist, wird im Zuge der Photosynthese nicht benötigter Zucker in Stärke umgewandelt, sodass die Energie dauerhaft gespeichert werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a009e2b9-503b-4e82-9085-6bc799b9ae59",
                        "source_entry_id": "eced7de5-b744-309a-b712-345ca386199c",
                        "source_sense_id": "cc8575e4-5e37-3014-8061-c64defebe9e5",
                        "target_lang_word": "Robustheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Robustheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20b5defc-aaef-3a83-acda-76c469fbb971",
                                        "entry_id": "6920d1b2-526a-3cfb-bc4d-c1e504e632c9",
                                        "glosses": [
                                            "von Personen: Unempfindlichkeit gegen fremde Einflüsse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac6eace-d4dd-4623-b667-4f3c68136334",
                                                "sense_id": "20b5defc-aaef-3a83-acda-76c469fbb971",
                                                "text": "Seine körperliche und psychische Robustheit half ihm, die Anstrengungen der Reise zu bewältigen."
                                            },
                                            {
                                                "example_id": "b31b335c-36c0-4237-93be-51f992373513",
                                                "sense_id": "20b5defc-aaef-3a83-acda-76c469fbb971",
                                                "text": "„Es war einmal ein Junge, der in einer kleinen, armen Familie aufwuchs, aber nie die dazu nötige Robustheit erlangte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c518b63-352f-341b-9111-0a20a1534b27",
                                        "entry_id": "6920d1b2-526a-3cfb-bc4d-c1e504e632c9",
                                        "glosses": [
                                            "von Sachen: Stabilität gegenüber Störungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f1024c-9e80-4b41-a601-f31a7942b4e3",
                                                "sense_id": "0c518b63-352f-341b-9111-0a20a1534b27",
                                                "text": "„Ein Mobiltelefon muss aber nicht nur funktionieren, es soll auch hübsch und möglichst aktuell sein, und es darf keinesfalls in Sachen Robustheit den Kampf gegen Schlüsselbund, Parfumfläschchen und Konsorten in der Handtasche verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
