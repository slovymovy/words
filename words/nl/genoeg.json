                {
                    "sense_id": "a89986f4-44bb-37b5-9dc7-a2f83596a2ff",
                    "sense_definition": "Uitroep om aan te geven dat iets moet stoppen of dat de limiet bereikt is.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Genoeg</w> daarmee, ik wil er niets meer over horen!",
                            "target_lang_translations": {
                                "ru": "<w>Хватит</w> об этом, я больше ничего не хочу слышать!",
                                "en": "<w>Enough</w> of that, I don't want to hear anything more about it!",
                                "pl": "<w>Dość</w> tego, nie chcę już o tym słyszeć!",
                                "de": "<w>Genug</w> damit, ich will nichts mehr darüber hören!",
                                "fr": "<w>Assez</w> parlé de ça, je ne veux plus rien entendre à ce sujet !",
                                "it": "<w>Basta</w> così, non voglio più sentirne parlare!",
                                "cs": "Už <w>dost</w> o tom, nechci o tom slyšet ani slovo!",
                                "tr": "Bu konuda bu kadar <w>yeter</w>, artık bunun hakkında hiçbir şey duymak istemiyorum!",
                                "es": "¡<w>Basta</w> de eso, no quiero oír nada más al respecto!"
                            }
                        },
                        {
                            "text": "Nu is het <w>genoeg</w> geweest met dat lawaai.",
                            "target_lang_translations": {
                                "ru": "С этим шумом уже <w>хватит</w>.",
                                "en": "That's <w>enough</w> of that noise now.",
                                "pl": "Teraz już <w>wystarczy</w> tego hałasu.",
                                "de": "Jetzt ist es aber <w>genug</w> mit dem Lärm.",
                                "fr": "Maintenant, <w>ça suffit</w> avec ce bruit.",
                                "it": "Ora <w>basta</w> con questo rumore.",
                                "cs": "S tím hlukem už to teď <w>stačí</w>.",
                                "tr": "Bu gürültü artık <w>yetti</w>.",
                                "es": "Ya ha sido <w>suficiente</w> con ese ruido."
                            }
