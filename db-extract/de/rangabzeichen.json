                "senses": [
                    {
                        "sense_id": "dbce69e4-5468-36af-85d2-e6d0e6a91142",
                        "entry_id": "43eb3c92-ad5d-3713-9f45-b7d775de18e0",
                        "glosses": [
                            "Zeichen an der Kleidung, die die Position (Rang) des Trägers in einer Organisation anzeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "251bb54c-bdb7-48b1-a90d-59a20c0886aa",
                                "sense_id": "dbce69e4-5468-36af-85d2-e6d0e6a91142",
                                "text": "Rangabzeichen werden im Österreichischen Bundesheer jargonartig auch als „Keks“ bezeichnet, da ein Teil der Abzeichen aus sternförmigen Symbolen besteht, welche an die Form von Weihnachtskeksen erinnern."
                            },
                            {
                                "example_id": "ad953ab0-1b9b-403a-8889-3a388a28e6c9",
                                "sense_id": "dbce69e4-5468-36af-85d2-e6d0e6a91142",
                                "text": "„Der Anführer der kleinen Truppe, die uns gefangengenommen hatte, unterschied sich durch keinerlei äußere Rangabzeichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feb53b26-b37d-4373-807a-ab73c349c1ad",
                        "source_entry_id": "43eb3c92-ad5d-3713-9f45-b7d775de18e0",
                        "source_sense_id": "dbce69e4-5468-36af-85d2-e6d0e6a91142",
