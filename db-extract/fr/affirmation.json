                                            {
                                                "example_id": "7a529d20-db9d-4b70-a053-31bf3fdadf96",
                                                "sense_id": "a5987aaa-5cf9-3b39-8f36-19fb6d043fbd",
                                                "text": "„Gleichzeitig aber gibt es eine starke Affirmation der deutschen Kultur, sie gilt als etwas Bewundernswertes.“"
                                            },
                                            {
                                                "example_id": "24ab4766-a9d3-46de-80ea-73a596ea4584",
                                                "sense_id": "a5987aaa-5cf9-3b39-8f36-19fb6d043fbd",
                                                "text": "„Da werden die 12,6 Prozent AfD-Wähler*innen [sic] eben von einer Affirmation völkischen Denkens zu einem Ausdruck politischer Frustration umgedeutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
