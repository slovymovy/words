                                "sense_id": "b331f263-178b-3556-aaf1-1a69ad0a9fd5",
                                "text": "„Der von einer Kernschmelze bedrohte japanische Atomreaktor Fukushima 1 soll mit Meerwasser gekühlt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
