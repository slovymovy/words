                    "frequency": "High",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un gros <w>crapaud</w> traverse lentement le chemin humide du jardin à la tombée de la nuit."
                        },
                        {
                            "text": "Les enfants ont observé un <w>crapaud</w> caché sous les feuilles mortes près de la mare."
                        }
                    ],
                    "common_phrases": [
                        "peau de crapaud",
                        "bave de crapaud"
                    ]
                },
                {
