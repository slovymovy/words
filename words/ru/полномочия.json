                    "frequency": "High",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Президент досрочно сложил свои <w>полномочия</w>.",
                            "target_lang_translations": {
                                "en": "The president relinquished his <w>powers</w> early.",
                                "tr": "Cumhurbaşkanı <w>yetkilerini</w> vaktinden önce devretti.",
                                "de": "Der Präsident legte seine <w>Befugnisse</w> vorzeitig nieder."
