                        "sense_id": "9dc4cedd-c5bb-35b9-8aeb-9fbd463caf52",
                        "entry_id": "be56abad-7d88-3f52-9e10-631be820a606",
                        "glosses": [
                            "Qui est d’une vilaine couleur marron, mal définie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182b4170-5495-498e-a6ed-6504e9b14169",
                                "sense_id": "9dc4cedd-c5bb-35b9-8aeb-9fbd463caf52",
                                "text": "Une brume marronnasse feutrait le ciel."
                            },
                            {
                                "example_id": "36a19e32-5bd9-4048-b29d-0c1df542d9e8",
                                "sense_id": "9dc4cedd-c5bb-35b9-8aeb-9fbd463caf52",
                                "text": "Sur son bureau, un vieux bouquet d’hortensias trempait dans une eau marronnasse."
                            },
                            {
                                "example_id": "6c8cedb8-ca1f-4c69-85b9-094deb558a01",
                                "sense_id": "9dc4cedd-c5bb-35b9-8aeb-9fbd463caf52",
                                "text": "Celui-là n’appartient pas à la ville de Moscou, il a gardé les traces de la vie du couple, depuis les meubles aux teintes marronnasses typiques de l’Union soviétique jusqu’aux vinyles qu’affectionnait le physicien."
                            },
                            {
                                "example_id": "ef7cef5d-b3f4-4366-bbab-8fbaa4aa9e51",
                                "sense_id": "9dc4cedd-c5bb-35b9-8aeb-9fbd463caf52",
                                "text": "Il émergea de sa cachette et s’avança sur le chemin recouvert de flaques d’eau marronnasse. Il contourna la petite case par la droite, s’approcha d’un naco aux lames brisées, et glissa un regard discret au travers."
                            }
                        ]
                    }
