                "senses": [
                    {
                        "sense_id": "bdf7e9c2-b3de-392f-97fd-c0c158ceab65",
                        "entry_id": "f2634f27-f0d4-3d14-b53b-b947780b304a",
                        "glosses": [
                            "allgemein: gestaltete Oberfläche eines Materials"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb189f59-fb8d-4dbf-b25e-87cd13064d55",
                                "sense_id": "bdf7e9c2-b3de-392f-97fd-c0c158ceab65",
                                "text": "Die Oberflächenstruktur von Waschbetonplatten ist ziemlich rau."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f785885-0aef-3f9b-b671-4be0a7470a1c",
                        "entry_id": "f2634f27-f0d4-3d14-b53b-b947780b304a",
                        "glosses": [
                            "im allgemeinen Verständnis die Sprachformen, die man in Texten als grammatisch korrekt gebildete Äußerungen sehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28cf3056-c2d9-4b74-8889-6d799c441a91",
                                "sense_id": "1f785885-0aef-3f9b-b671-4be0a7470a1c",
                                "text": "Als Oberflächenstruktur kann jede korrekt gebildete sprachliche Form in Texten aufgefasst werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5a0503a1-f07b-3168-ac2f-2572cad2eae6",
                        "entry_id": "f2634f27-f0d4-3d14-b53b-b947780b304a",
                        "glosses": [
                            "Begriff aus der generativen Transformationsgrammatik für die Sprachformen, die man in Texten, sozusagen nahe an der \\\"Oberfläche\\\", sehen kann. Oberflächenstrukturen kommen dadurch zustande, dass man auf Sprachformen der Tiefenstruktur Transformationen (Umformungsregeln) anwendet. Um daraus \\\"richtige\\\" Sätze zu erzeugen, müssen noch Interpretationen der Einheiten (zum Beispiel die phonologische Interpretation) erfolgen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a35967b-48c9-4a0a-9f3e-14d9334501fd",
                                "sense_id": "5a0503a1-f07b-3168-ac2f-2572cad2eae6",
                                "text": "Oberflächenstruktur ist ein Begriff für syntaktisch gebildete Sprachformen, die aber noch weiteren Umformungsregeln unterzogen werden müssen, damit \"richtige\" Sätze dabei herauskommen."
                            },
                            {
                                "example_id": "8c817af8-adac-432d-84f6-1c3ed5100f1f",
                                "sense_id": "5a0503a1-f07b-3168-ac2f-2572cad2eae6",
                                "text": "„Die Oberflächenstruktur eines Satzes wird erklärt aus einer zugrundeliegenden (abstrakten) Tiefenstruktur…“"
                            },
                            {
                                "example_id": "0da898e5-1782-4e6a-b525-9f0340a31aaf",
                                "sense_id": "5a0503a1-f07b-3168-ac2f-2572cad2eae6",
                                "text": "„Man unterscheidet also im klassischen Modell der TG zwischen Regeln der Basis, mittels derer dann die sogenannte Oberflächenstruktur abgeleitet wird.“"
                            },
                            {
                                "example_id": "f7a302e4-93d1-4285-8049-b07606a554f4",
                                "sense_id": "5a0503a1-f07b-3168-ac2f-2572cad2eae6",
                                "text": "„Diese syntaktische Oberflächenstruktur dient als Eingabe für die phonologische Komponente.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
