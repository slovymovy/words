                "senses": [
                    {
                        "sense_id": "ed9de617-9a40-3445-81a8-a08699f48fca",
                        "entry_id": "cebada3e-86a5-3f02-b255-21e5bf4515f5",
                        "glosses": [
                            "Medizin, die auf wissenschaftlichen Methoden basiert"
                        ],
                        "tags": [
                            "auch",
                            "pejorativ"
                        ],
                        "examples": [
                            {
                                "example_id": "626bbf34-a1d4-454a-8973-0d4e207cb5a4",
                                "sense_id": "ed9de617-9a40-3445-81a8-a08699f48fca",
                                "text": "Für die Schulmedizin ist vom Gesetzgeber eine umfangreiche Aufklärungspflicht entwickelt worden."
                            },
                            {
                                "example_id": "df49b4bc-3d70-4473-a3f7-f74da5cd3687",
                                "sense_id": "ed9de617-9a40-3445-81a8-a08699f48fca",
                                "text": "Der Begriff \"Schulmedizin\" wird meist dann benutzt, wenn Ärzte und sonstige Heiler ihre vermeintlich oder tatsächlich neuen Methoden gegen die herkömmlichen, die \"alten\" abgrenzen wollen."
                            },
                            {
                                "example_id": "fc7e65ae-faf5-4107-b312-15f9a2914ac7",
                                "sense_id": "ed9de617-9a40-3445-81a8-a08699f48fca",
                                "text": "„Zunächst hatte Bahtawi Gebre-Medhin seine Anhänger in unmittelbarer Nähe der Quelle getauft; doch als immer mehr von der Schulmedizin aufgegebene Heilsuchende kamen, vertrieben andere Priester und Einheimische den Guru aus dem Tal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0ea86d9-0153-3b3b-bad5-5eacce4082e0",
