                    {
                        "sense_id": "22e54a22-d40d-30ad-adf2-37ecac6dd13d",
                        "entry_id": "60b52c5c-f038-32e1-aae2-d94010673975",
                        "glosses": [
                            "Constructeur automobile américain de voitures électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6be15c-39cc-4019-8967-3fed1d9fdced",
                                "sense_id": "22e54a22-d40d-30ad-adf2-37ecac6dd13d",
                                "text": "Parmi elles, le PDG de Tesla, SpaceX et Twitter, Elon Musk, le cofondateur d’Apple, Steve Wozniak, Jaan Tallinn, cofondateur de Skype…"
                            },
                            {
                                "example_id": "d30d49b8-c4de-4c4f-ac27-224277c129c2",
                                "sense_id": "22e54a22-d40d-30ad-adf2-37ecac6dd13d",
                                "text": "Champion des marges dans l'automobile : Tesla !"
                            },
                            {
                                "example_id": "1e9115de-5b2a-44e6-832e-9883b2f80440",
                                "sense_id": "22e54a22-d40d-30ad-adf2-37ecac6dd13d",
                                "text": "Tesla baisse ses prix et met à l'épreuve ses concurrents."
                            },
                            {
                                "example_id": "5b4e99dc-e15b-4c0a-ad0d-001d6e4cab0b",
                                "sense_id": "22e54a22-d40d-30ad-adf2-37ecac6dd13d",
                                "text": "Tesla est prête à contribuer à l’élaboration de critères de test et paramétrés permettant de mesurer la performance du système AEBS dans le monde réel."
                            }
                        ]
                    }
                ],
