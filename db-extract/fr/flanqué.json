                "senses": [
                    {
                        "sense_id": "7df2315d-75ed-3d68-bb8e-1f114c145378",
                        "entry_id": "9e8b8a5c-9dee-3ca8-b96a-43c8b871b9ce",
                        "glosses": [
                            "Se dit d'un écu divisé dont la division est sur un flanc particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6882746f-9f70-4d19-a0c6-780735085b35",
                                "sense_id": "7df2315d-75ed-3d68-bb8e-1f114c145378",
                                "text": "De gueules flanqué en pal à dextre d’argent, à la rivière d’azur mouvant de la pointe brochant sur laquelle est posé un pont de trois arches mouvant du flanc dextre, ne laissant ainsi apparaître que les deux arches senestres, prolongé jusqu’au flanc senestre d’un empierrement, le tout d’or maçonné de sable, sommé d’une colonne aussi d’argent, la base et le chapiteau aussi d’or, le pont surmonté, sur le champ de gueules, de trois lionceaux d’or armés, lampassés et couronnés d’azur, qui est de Petit-Bersac → voir illustration « écu flanqué »"
                            }
                        ]
                    },
                    {
                        "sense_id": "00201268-35dd-3c49-871d-1064e33db700",
                        "entry_id": "9e8b8a5c-9dee-3ca8-b96a-43c8b871b9ce",
                        "glosses": [
                            "Se dit d’un meuble contre lequel est collé un ou plusieurs autres meubles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6e0b71-fb5c-43d7-956b-7a07cc82a1b2",
                                "sense_id": "00201268-35dd-3c49-871d-1064e33db700",
                                "text": "D’or au portail de ville de gueules, maçonné de sable, ouvert du champ et flanqué de deux tours du même, qui est de Petit-Bersac → voir illustration « pont flanqué »"
                            }
                        ]
                    }
