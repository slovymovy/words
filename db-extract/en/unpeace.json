    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "56bb7320-3e4f-3b56-a0af-791e060f89cb",
                "word": "unpeace",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                        "entry_id": "56bb7320-3e4f-3b56-a0af-791e060f89cb",
                        "glosses": [
                            "The absence of peace; peacelessness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a342c97-e2b5-4e48-86e2-7244655ebb02",
                                "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                                "text": "Howe shulde ever goodnesse of peace have ben knowe, but if unpeace somtyme reigne, and mokel yvel wrothe?"
                            },
                            {
                                "example_id": "a80955dd-7948-4cb0-a96e-502cdab13194",
                                "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                                "text": "We held with hym ther he saide leasse, / and therfor haue we all vnpeasse.",
                                "translation": "We joined with him when he told lies, and therefore none of us have any peace.",
                                "english": "We joined with him when he told lies, and therefore none of us have any peace."
                            },
                            {
                                "example_id": "eb1f344f-6b51-459b-8570-45871c294920",
                                "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                                "text": "We were Christians; Christians living in a state of undivorce, yet striving to keep the marriage together while living in great unpeace and disharmony."
                            },
                            {
                                "example_id": "742747d3-3964-459e-9f4e-78397d13b3c5",
                                "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                                "text": "The name signifies 'unpeace, feud'\""
                            },
                            {
                                "example_id": "f3f83b08-ee67-4272-b73b-f3f31ea4b00f",
                                "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                                "text": "The power of love opposes the violence of unpeace."
                            },
                            {
                                "example_id": "cdb7beab-3321-4962-8f34-bdb0db692695",
                                "sense_id": "d8fa34b7-a80a-3b46-8b00-7e630a08dcc0",
                                "text": "Indeed, I readily see \"unpeace\" in myself. I violate peace not only in hasty words or angry attitudes but also in failing to be the reconciler Jesus calls his followers to be. So much of our culture's unpeace arises because of greed, our proliferating needs and wants."
                            }
                        ]
                    }
                ],
