        "ru-extract.jsonl": [
            {
                "entry_id": "1ce30a1d-be6d-30f3-b59b-68050b5413cf",
                "word": "хрена",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7707764e-0fda-33c3-92d7-e2cf54cd12dc",
                        "entry_id": "1ce30a1d-be6d-30f3-b59b-68050b5413cf",
                        "glosses": [
                            "прост., груб. зачем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c70dfccc-0af5-4f5c-bbd7-967767941537",
                                "sense_id": "7707764e-0fda-33c3-92d7-e2cf54cd12dc",
                                "text": "Где твои «Доктор Мартинз»? ― видно было, что он разозлился. ¶ ― В ванной стоят. ¶ ― Хрена ли ты их туда поставил?"
                            },
                            {
                                "example_id": "95423e9e-b982-4471-aba5-4110d87eb4e8",
                                "sense_id": "7707764e-0fda-33c3-92d7-e2cf54cd12dc",
                                "text": "Хрена ты здесь сидишь, тебе за столом надо сидеть, пьесы писать."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f2b0d0e-480a-34e7-a392-86a0f923ac0d",
                        "entry_id": "1ce30a1d-be6d-30f3-b59b-68050b5413cf",
                        "glosses": [
                            "прост., груб. что (в риторических вопросах и восклицательных предложениях, в которых указывается на несущественность, неважность чего-либо)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28078541-aa5d-442d-888b-ac7917462ed5",
                                "sense_id": "1f2b0d0e-480a-34e7-a392-86a0f923ac0d",
                                "text": "«Выясняется… Вопрос выясняется.» Хрена тут выяснять?"
                            }
                        ]
                    },
                    {
                        "sense_id": "81b21623-da79-37be-8bdd-d19be94ccb5c",
                        "entry_id": "1ce30a1d-be6d-30f3-b59b-68050b5413cf",
                        "glosses": [
                            "прост., груб. употребляется для обозначения решительного отказа, отрицания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79afa2be-80c3-4cc4-83d2-37a62335a890",
                                "sense_id": "81b21623-da79-37be-8bdd-d19be94ccb5c",
                                "text": "Думаешь, так просто найти, где поспать? Хрена! Москву всю поделили и переделили, за прописку теперь никого не тягают, бояться перестали, установили свои правила."
                            }
                        ]
                    }
                ],
