                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ac5125-9958-4151-9ea4-cc609c877931",
                                "sense_id": "93f18d62-e1f4-3f33-9b5c-26c0788ef7d1",
                                "text": "Der Jagdpächter hatte vergessen, seinen Vertrag zu verlängern."
                            },
                            {
                                "example_id": "4928a05d-e746-45dc-966e-c4d5a15d0b80",
                                "sense_id": "93f18d62-e1f4-3f33-9b5c-26c0788ef7d1",
                                "text": "„Ich möchte in diesem Zusammenhang auf die Beschwerden der Jagdpächter und auf das Verbot von freilaufenden Hunden in der Gemarkung hinweisen.“"
                            },
                            {
                                "example_id": "fa3f3a57-03c9-4631-b7ca-cab97937d884",
                                "sense_id": "93f18d62-e1f4-3f33-9b5c-26c0788ef7d1",
                                "text": "„Es war ein Julinachmittag des Jahres 2012, als der Polizist und Jagdpächter Fritz B. mit seinen Hunden im Wald bei Heidenheim spazieren ging.“"
                            }
                        ],
