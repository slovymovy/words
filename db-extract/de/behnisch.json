                "senses": [
                    {
                        "sense_id": "b81c09e1-c578-35fe-9117-b063961fc494",
                        "entry_id": "ec16fa85-040b-35fe-bf17-d011a4e20a01",
                        "glosses": [
                            "deutscher Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff12667a-f219-4149-9ff9-92f72c775d78",
                                "sense_id": "b81c09e1-c578-35fe-9117-b063961fc494",
                                "text": "„[Christian Friedrich Gottlieb] Behnisch bekam den Prinzen anvertraut, als dieser drei Jahre alt war. Mit elf Jahren erhielt Friedrich Wilhelm zusätzlich einen militärischen Gouverneur, der Behnisch übergeordnet wurde.“"
                            },
                            {
                                "example_id": "775230e1-7092-4074-9232-06ab9f32cd70",
                                "sense_id": "b81c09e1-c578-35fe-9117-b063961fc494",
                                "text": "„Der so genannte Codex E. B. 1688 war ursprünglich Eigentum von Emanuel Behnisch, von 1679 bis 1695 Organist der Dresdner Frauen- und Sophienkirche und von 1696 bis zu seinem Tod 1725 der Dresdner Kreuzkirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
