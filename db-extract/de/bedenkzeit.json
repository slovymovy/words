                    },
                    {
                        "translation_id": "cfc1ab54-e09a-4f01-82c1-4982f63f0017",
                        "source_entry_id": "662010dd-5524-3274-9aa8-f8770449dcfb",
                        "source_sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
