                                        "glosses": [
                                            "Celui ou celle qui pratique la contorsion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21b6dfa-290a-4f8f-9d9a-215639f806f2",
                                                "sense_id": "06792388-5dc9-3bfe-add4-342d419ef421",
                                                "text": "Le téléphone bourdonna sur les coups de quatre heures du matin, brisant net la passion que nous mettions dans une posture à rendre fou de jalousie un contorsionniste."
                                            }
                                        ]
                                    }
                                ]
