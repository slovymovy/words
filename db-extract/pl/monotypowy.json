                "senses": [
                    {
                        "sense_id": "3f0103e2-272f-32ec-a142-bc624eeaa3a7",
                        "entry_id": "118fe504-ff29-3437-a02a-a3a57387f9cd",
                        "glosses": [
                            "związany z monotypem, dotyczący monotypu"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "068077fc-bafb-4cb5-a5a2-64e5b3b83c54",
                                "sense_id": "3f0103e2-272f-32ec-a142-bc624eeaa3a7",
                                "text": "Kolczatka australijska jest jedynym przedstawicielem monotypowego rodzaju kolczatka."
                            },
                            {
                                "example_id": "34618bc7-dbf5-4d14-8572-7d746d7c7327",
                                "sense_id": "3f0103e2-272f-32ec-a142-bc624eeaa3a7",
                                "text": "Pogląd ten uzasadniany bywa badaniami antropologicznymi wskazującymi, że gatunek Homo sapiens jest monotypowy"
                            },
                            {
                                "example_id": "8a8ae394-5f58-43aa-bdc5-c1d66b8f7142",
                                "sense_id": "3f0103e2-272f-32ec-a142-bc624eeaa3a7",
                                "text": "Matryca – w tradycyjnym zecerstwie służyła do odlewania czcionek lub też mechanicznego składu tekstu"
                            }
                        ],
