                ],
                "senses": [
                    {
                        "sense_id": "46db482e-4c51-3ad8-bc4c-6ff5b27fe9c2",
                        "entry_id": "8d5cf16b-6b00-3b60-afa1-8ecf0c144be7",
                        "glosses": [
                            "in hechtenis genomen, van de vrijheid beroofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf55f8b-078f-40bb-99f3-761a5a340114",
                                "sense_id": "46db482e-4c51-3ad8-bc4c-6ff5b27fe9c2",
                                "text": "De gevangen vis werd weer teruggezet omdat deze ondermaats was."
                            },
                            {
                                "example_id": "ea0f8f5b-d2cb-4d04-9183-6e9855fbc9c7",
                                "sense_id": "46db482e-4c51-3ad8-bc4c-6ff5b27fe9c2",
                                "text": "Ze had bladgoud altijd beschouwd als de droom van een alchemist, een gevangen zonnestraal."
                            },
                            {
                                "example_id": "d9848a9d-f3b4-41fb-be67-33bf3bea2a38",
                                "sense_id": "46db482e-4c51-3ad8-bc4c-6ff5b27fe9c2",
                                "text": "‘Maakt niet uit, we eten slang vanavond.’ Hij wees naar het vuur waarop de vanmiddag gevangen slang lag te bakken. Rattlesnake, de jonge slangenvanger, zat er zwijgend naast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fea88e6e-61af-4b22-bdd9-607a45a05819",
                        "source_entry_id": "8d5cf16b-6b00-3b60-afa1-8ecf0c144be7",
                        "source_sense_id": "46db482e-4c51-3ad8-bc4c-6ff5b27fe9c2",
                        "target_lang_word": "prisoner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prisoner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person incarcerated in a prison, while on trial or serving a sentence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f9c94c-e1e7-45d9-9bda-a7d925cc66c2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "Two other prisoners were staying in the same cell as him."
                                            },
                                            {
                                                "example_id": "ecff8481-0a8a-4356-b99c-a0587a2c82a2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "The evidence disclosed that the three prisoners were in a public-house together with the prosecutor, Abraham Rhodes, and that in concert with the other two prisoners, the prisoner John Dewhirst placed a pencase on the table in the room where they were assembled, and left the room to get writing-paper."
                                            },
                                            {
                                                "example_id": "8a897d78-9989-460d-b0ce-d4b047eff474",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "American journalist Evan Gershkovich and former US Marine Paul Whelan were among the 24 detainees released as part of a complex prisoner swap between Russia, the US and other Western nations. […] Krasikov, a former high-ranking FSB colonel serving a life sentence in a German prison, was on the top of Moscow’s list of Russian prisoners it wanted to exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "Any person held against their will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed10d49-3a6d-461c-93e6-211ea5090a5f",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "And gainſt the General we will lift our ſwords / And either lanch his greedie thirſting throat, / Or take him priſoner, and his chaine ſhall ſerue / For Manackles, till he be ranſom’d home."
                                            },
                                            {
                                                "example_id": "27825753-244a-408d-8e27-06acaa6eed23",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person who is or feels confined or trapped by a situation or a set of circumstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eabbee-6245-4ea3-b0b6-07ce02fdda7d",
                                                "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                                "text": "I am no longer a prisoner to fear, for I am a child of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7fecdf4-f93e-462b-b49b-f1813be327ec",
                        "source_entry_id": "8d5cf16b-6b00-3b60-afa1-8ecf0c144be7",
