                        "source_sense_description": "das alttestamentliche Buch Kohelet; Der Prediger Salomo; Ekklesiastes",
                        "target_lang_word": "Kohelet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohelet",
