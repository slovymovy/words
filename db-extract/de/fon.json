                                "sense_id": "2aabcc9e-fe22-3a56-b2a2-a6af12fd612a",
                                "text": "„Bei den Fon in Benin bedeutet ‚Rote Augen haben‘ ehrgeizig sein.“"
                            },
                            {
                                "example_id": "d32ebc1f-6d49-44ea-a995-b10d7de64a3d",
                                "sense_id": "2aabcc9e-fe22-3a56-b2a2-a6af12fd612a",
                                "text": "„Diese Symbole beziehen sich einerseits auf unterschiedliche Gottheiten, repräsentieren aber auch bestimmte Herrscher der Fon in der Vergangenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
