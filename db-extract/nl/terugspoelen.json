        "nl-extract.jsonl": [
            {
                "entry_id": "94047210-be4c-3d8b-994f-a24ff5c61e21",
                "word": "terugspoelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cd6b827-e71c-3a3e-bcce-e48eee169596",
                        "entry_id": "94047210-be4c-3d8b-994f-a24ff5c61e21",
                        "glosses": [
                            "van een band van een bandrecorder of van een film: de band of weer op de oorspronkelijke haspel draaien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29bb571-3626-4e30-a208-51d21f27cb7d",
                                "sense_id": "1cd6b827-e71c-3a3e-bcce-e48eee169596",
                                "text": "Treurig nieuws van het videofront. Deze week rolde de laatste VHS-recorder van de band bij Funai, het laatste bedrijf dat nog videorecorders maakte. Het bericht roept een golf aan technostalgie op. Net als de meeste gebruikers vervloekte ik de moeilijk te programmeren apparaten en de logge banden die je moest terugspoelen voordat ze naar de videotheek teruggingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e91cff9d-a640-32e6-be54-84be9d8594e1",
                        "entry_id": "94047210-be4c-3d8b-994f-a24ff5c61e21",
                        "glosses": [
                            "iets terugdraaien en weer overnieuw doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd40b55-6982-46f7-a1ae-3eee42da0639",
                                "sense_id": "e91cff9d-a640-32e6-be54-84be9d8594e1",
                                "text": "Helaas kunnen we de gescheidenis niet terugspoelen."
                            },
                            {
                                "example_id": "8459c94d-18f2-4594-bfd3-1b948bf7ffac",
                                "sense_id": "e91cff9d-a640-32e6-be54-84be9d8594e1",
                                "text": "Nu overheerst even de weemoed, want VHS en ik zijn bijna even oud. Ik herinner me mijn favoriete oom Henk; hij was goedlachs én had als eigenaar van een elektronicawinkel steevast de nieuwste gadgets in huis. Al vroeg in de jaren zeventig demonstreerde hij een magische kast waarmee je tv-beelden kon stilzetten en terugspoelen."
                            }
                        ]
                    }
                ],
