                ],
                "senses": [
                    {
                        "sense_id": "568b8740-d575-30f4-9344-945495c944dd",
                        "entry_id": "baf71a95-4d57-3b05-9300-47af95cd86f1",
                        "glosses": [
                            "auf Operationen (Handlungen) beruhend, mit Hilfe von Operationen (Handlungen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3301ee69-841d-4095-a317-0f2d86e308a7",
                                "sense_id": "568b8740-d575-30f4-9344-945495c944dd",
                                "text": "In den Wissenschaften können operationale Definitionen sehr hilfreich sein. Eine sehr einfache operationale Definition für Wort kann man so formulieren: Sieh nach, welche Einheiten im Satz als ununterbrochene Folge von Buchstaben wiedergegeben wird, und du weißt, was in diesem Satz ein Wort ist."
                            },
                            {
                                "example_id": "4ddb5079-025a-4f9c-8816-bfceed6dc23f",
                                "sense_id": "568b8740-d575-30f4-9344-945495c944dd",
                                "text": "„Operationaler Umgang mit Sprache - Einsatz der „Proben“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1d2c5cc8-2555-3d0d-8292-f8e50bb06f94",
                        "entry_id": "baf71a95-4d57-3b05-9300-47af95cd86f1",
                        "glosses": [
                            "„konkret beschrieben, messbar, und damit umsetzbar“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb57826-275d-4288-92d3-c74d6718e3c1",
                                "sense_id": "1d2c5cc8-2555-3d0d-8292-f8e50bb06f94",
                                "text": "„Operationale Ziele sind immer messbare Ziele, die so präzise definiert sind, dass Art und Ausmaß der Zielerreichung eindeutig bestimmt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
