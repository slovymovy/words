                        "examples": [
                            {
                                "example_id": "d4037129-1d99-4369-99b1-ac59cc99128c",
                                "sense_id": "51f05db3-941a-318b-acad-55268a9bbe7d",
                                "text": "Мама разложила на кровати папин габардиновый серый макинтош и своё тёмно-синее шевиотовое пальто с большим котиковым воротником."
                            }
                        ]
                    }
