                                "example_id": "331de009-2cbc-4c79-8ba2-11c01fee2d49",
                                "sense_id": "54e7f932-cd91-3f23-92da-48644190d2f4",
                                "text": "Un petit habillage avec petit panneaux arrondis pour la rondifier...?"
                            },
                            {
                                "example_id": "e4c07071-f5df-4ed0-b3b7-7d437cf3c063",
                                "sense_id": "54e7f932-cd91-3f23-92da-48644190d2f4",
                                "text": "J'ai rondifié un peu les étoiles avec photoshop/calque/obscurcir."
                            },
                            {
                                "example_id": "b708bd5c-a87e-4b49-905d-f9a2f8c11ee4",
                                "sense_id": "54e7f932-cd91-3f23-92da-48644190d2f4",
                                "text": "L'amas est rondifié dans toute sa beauté !"
                            }
                        ]
                    },
                    {
                        "sense_id": "dfeadc8e-4b1a-3cbd-8eac-198a11ca8519",
