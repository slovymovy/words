                    {
                        "sense_id": "7683b3d2-df69-398e-a539-98ffc48b1d90",
                        "entry_id": "44da9c6f-7bce-3502-be71-6ac627cf14ba",
                        "glosses": [
                            "Any transparent marine hydrozoans, of the order Siphonophorae, that float or swim as colonies of polyps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa4673d-229d-426b-8fbb-d04cf618e6be",
                                "sense_id": "7683b3d2-df69-398e-a539-98ffc48b1d90",
                                "text": "Is an individual hydra polyp analogous to an entire siphonophore colony – or is it more like a member of that colony?"
                            },
                            {
                                "example_id": "51203e1c-7b72-4cf2-b9b6-ca631af86d45",
                                "sense_id": "7683b3d2-df69-398e-a539-98ffc48b1d90",
                                "text": "However, two beaches in Tarragona in southern Catalonia were closed in July after Portuguese man o’war (Physalia physalis) were spotted in the water. The sting of this siphonophore (it is not technically a jellyfish, but they are closely related) is especially painful."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "209e075b-a8d8-4afe-bb2d-caaf35ebc22b",
                        "source_entry_id": "44da9c6f-7bce-3502-be71-6ac627cf14ba",
                        "source_sense_id": "7683b3d2-df69-398e-a539-98ffc48b1d90",
                        "source_sense_description": "hydrozoan of the order Siphonophorae",
                        "target_lang_word": "siphonophore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siphonophore",
