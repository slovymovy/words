                                "target_senses": [
                                    {
                                        "sense_id": "33658ddf-9217-31ec-994d-a52d9098c4ed",
                                        "entry_id": "f5f4a2c2-b3e0-32ae-80c4-066da38d5ce0",
                                        "glosses": [
                                            "A light, porous type of pyroclastic igneous rock, formed during explosive volcanic eruptions when liquid lava is ejected into water or air as a froth containing masses of gas bubbles, which are frozen into the rock as the lava solidifies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7763a-9dde-4979-b01c-83e56c20dd93",
                                                "sense_id": "33658ddf-9217-31ec-994d-a52d9098c4ed",
                                                "text": "The wind blew close to the ground - it rooted among the tussock grass - slithered along the road, so that the white pumice dust swirled in our faces - settled and sifted over us and was like a dry-skin itching for growth on our bodies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pumice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c402c32-fa4f-3866-9878-be6b5feb72b7",
                                        "entry_id": "a88d8883-fa7d-3ec1-bad6-0ea82e74deca",
                                        "glosses": [
                                            "To abrade or roughen with pumice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17b11447-e69c-4370-8da9-1ed638dc40d1",
                        "source_entry_id": "5cd692d9-b73d-3705-a663-4c089c67f95f",
                        "target_lang_word": "pierre ponce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pierre ponce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f171a97-24c8-3118-8551-5f6682b0ad60",
                                        "entry_id": "07ad275c-fdfe-3b87-b6b7-1e7fff09d335",
                                        "glosses": [
                                            "Sorte de pierre extrêmement sèche, poreuse et légère, qui est un produit des volcans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83d3db1-0c76-4dcb-9aff-5bf1eb2b09a3",
                                                "sense_id": "6f171a97-24c8-3118-8551-5f6682b0ad60",
                                                "text": "Les élégantes composaient les rosés de leur teint à l'aide d'un vermillon habilement nuancé; le kohl d'Egypte servait à faire ressortir l'éclat des yeux, la pierre ponce calcinée, à blanchir les dents."
                                            },
                                            {
                                                "example_id": "1c8d210b-cd6c-487d-94cc-ede06ac99c9d",
                                                "sense_id": "6f171a97-24c8-3118-8551-5f6682b0ad60",
                                                "text": "On obtient une bonne « clouabilité » par l'addition d’asbeste, de poudre de pierre ponce, de résidus de la combustion de charbon et de coke, de débris épars de mortier de chaux […]."
                                            },
                                            {
                                                "example_id": "23d78eca-8a23-446c-b641-b816b3184a4a",
                                                "sense_id": "6f171a97-24c8-3118-8551-5f6682b0ad60",
                                                "text": "Vers douze ans, j’inventai des mortifications : enfermée dans les cabinets — mon seul refuge — je me frottais au sang avec une pierre ponce, je me fustigeais avec la chaînette d’or que je portais à mon cou."
                                            },
                                            {
                                                "example_id": "cf07735f-80f0-4a7b-a2a8-4a677511da2d",
                                                "sense_id": "6f171a97-24c8-3118-8551-5f6682b0ad60",
                                                "text": "Rincer la fiole et la pierre ponce plusieurs fois avec de l’éther diéthylique (100 ml en tout) et verser l'eau de lavage dans l'ampoule à décanter. Boucher et secouer vigoureusement […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
