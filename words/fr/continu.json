                        "courant continu",
                        "flux continu"
                    ]
                },
                {
                    "sense_id": "1e46eb2e-b855-3e7e-8222-efe32af18dfc",
                    "sense_definition": "Dont les éléments ou les parties ne sont pas séparés dans l'espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est strictement interdit de franchir une ligne blanche <w>continue</w> sur cette route."
                        },
                        {
                            "text": "Le littoral offre une suite <w>continue</w> de plages et de falaises."
