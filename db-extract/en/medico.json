                "translations": [
                    {
                        "translation_id": "3d75c214-7065-409a-afd4-3090735f5f19",
                        "source_entry_id": "4f762fd1-ab59-3771-b6bd-c9296d707c4f",
                        "source_sense_id": "31774d2c-1eba-38a3-ae9f-18c9671cb979",
                        "source_sense_description": "umgangssprachlich: Mediziner, Medikus",
                        "target_lang_word": "Mediziner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mediziner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                        "entry_id": "c11898d1-a635-3aa5-a475-7faa2a581df1",
                                        "glosses": [
                                            "Person, die Medizin studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609c4497-b0d1-4599-a919-ab0c61ecc4eb",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "Der Mediziner verschreibt Tabletten gegen den Husten."
                                            },
                                            {
                                                "example_id": "35975a2d-5661-4fe9-a2d7-b12437ad0ea7",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "Der Mediziner behandelt einen Patienten."
                                            },
                                            {
                                                "example_id": "540d0783-4747-435f-b04d-9af528bb76c9",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„In Österreich führte das Verbot dazu, dass österreichische Mediziner die von ihnen mit herausgegebenen Zeitschriften mit einem Verlagsort im Deutschen Reich nicht mehr beziehen konnten.“"
                                            },
                                            {
                                                "example_id": "513fa2e6-984c-4aa2-866d-0da2764ed524",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Immer, wenn er zum Arzt muss, wird er von Ines begleitet, die sich alles Wichtige merkt, was der Mediziner gesagt hat.“"
                                            },
                                            {
                                                "example_id": "e1872e04-23b7-4f19-9ed2-80818e97c0e5",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Der Mediziner gab den Assistenten ein Zeichen, worauf sie die Kabine betraten und Hohensteins Körper drehten.“"
                                            },
                                            {
                                                "example_id": "8591a3dd-dda4-4afb-a640-d986aee4865a",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Und doch sind seine Fragestellungen in theoretischer und angewandter Hinsicht nicht nur für Linguisten, Psychologen und Pädagogen von Belang, sondern auch für Mediziner und für Verhaltens- und Kommunikationswissenschaftler.“"
                                            },
                                            {
                                                "example_id": "c6b33e88-e83b-4d5b-a3e4-b2ad9f1b7200",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Es fehlen ausreichend Studienplätze für Mediziner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8dce37d-3390-4f3d-9e14-76c1d0f2d0d8",
                        "source_entry_id": "4f762fd1-ab59-3771-b6bd-c9296d707c4f",
