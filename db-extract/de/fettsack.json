                "translations": [
                    {
                        "translation_id": "f36971f4-8fd2-42d7-99f1-1dcfe82405f1",
                        "source_entry_id": "97c7023d-1c5c-3222-b73e-059ce8aeefe8",
                        "source_sense_id": "d8ad1b6d-c8f5-344c-951b-a6de45f4c107",
