                    {
                        "sense_id": "01b35823-c44d-372d-8578-2e63d6beff60",
                        "entry_id": "29ec9e23-d873-3638-887f-410493979f48",
                        "glosses": [
                            "Celui qui travaille dans une zone portuaire et est chargé de l’avitaillement des navires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf8137e-9a04-4422-8d9b-f61390e95614",
                                "sense_id": "01b35823-c44d-372d-8578-2e63d6beff60",
                                "text": "Chartepartie : contrat en vue d’une expédition maritime passé entre l’armateur (celui qui fournit le navire), l’avitailleur (celui qui fournit les vivres, l’armement léger) et l’équipage."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8516dd4-a2c6-3992-80d0-a231a4915c14",
                        "entry_id": "29ec9e23-d873-3638-887f-410493979f48",
                        "glosses": [
                            "Celui qui travaille dans un aéroport et est chargé de l’approvisionnement des aéronefs en carburant."
                        ],
                        "tags": [],
                        "examples": []
                    }
