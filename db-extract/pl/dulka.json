                                                "example_id": "ff1a93e9-d925-4a12-986e-317b4cdfec37",
                                                "sense_id": "da5c99d7-aed4-32cd-8927-d14fe1e3b16e",
                                                "text": "Früher stellte man die Dollen aus einer Bronzelegierung her."
                                            },
