                                        "examples": [
                                            {
                                                "example_id": "01001dd4-5b93-4643-94f6-6371196c146f",
                                                "sense_id": "43e81613-551c-3514-9bf6-aa674be3c182",
                                                "text": "Od czasu do czasu zapuszczałem wzrok w głąb kraju, ciekawy, czy nie ujrzę gdzie czerwonoskórych, których liczne pokolenia żyły jeszcze niedawno koło jeziora, a jedne z nich zostawiło w nazwie Huron wieczną po sobie pamiątkę; ale znikły nawet ich ślady"
                                            }
                                        ],
