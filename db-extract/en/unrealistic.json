                        "entry_id": "a57aba0b-8641-3d9b-a203-a8739389d6e6",
                        "glosses": [
                            "Not realistic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5225bd77-b3f9-4e3c-82f8-85cf3a986342",
                                "sense_id": "eb5f50f8-8165-3a1c-a6bc-493839f50553",
                                "text": "How much of our thinking is based on unrealistic planted scripts of drama, romance and violence?"
                            },
                            {
                                "example_id": "7b813700-6fa0-4e72-ab95-aeb4cefa7ae9",
                                "sense_id": "eb5f50f8-8165-3a1c-a6bc-493839f50553",
                                "text": "It meant all through journeys required at least two changes of train, making commuting to London unrealistic. Passengers on all affected routes were urged not to travel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3437d41a-f409-4536-b9d5-a3cae38a7ba1",
                        "source_entry_id": "a57aba0b-8641-3d9b-a203-a8739389d6e6",
                        "source_sense_id": "eb5f50f8-8165-3a1c-a6bc-493839f50553",
