                            "target_lang_translations": {
                                "ru": "Мистер <w>Хейл</w> примет вас сейчас.",
                                "zh": "<w>黑尔</w>先生现在可以见你了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
