    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e045e55-6d51-3580-af48-e1e528d38a23",
                    "sense_definition": "Causing physical pain or discomfort; painful to the touch or movement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My legs are <w>sore</w> after running for two hours.",
                            "target_lang_translations": {
                                "ru": "Мои ноги <w>болят</w> после двух часов бега.",
                                "zh": "跑了两个小时后，我的腿<w>酸痛</w>。"
                            }
                        },
                        {
                            "text": "She has a <w>sore</w> throat and needs to drink some tea.",
                            "target_lang_translations": {
                                "ru": "У неё <w>больное</w> горло, и ей нужно выпить чаю.",
                                "zh": "她嗓子<w>发炎</w>了，需要喝点茶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "painful",
                        "aching",
                        "tender",
                        "hurting",
                        "raw"
                    ],
                    "antonyms": [
                        "painless"
                    ],
                    "common_phrases": [
