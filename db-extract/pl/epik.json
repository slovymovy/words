                ],
                "senses": [
                    {
                        "sense_id": "44ba3ecc-0790-30cb-9cb8-435b7344de0b",
                        "entry_id": "e7ab5dd5-475a-3986-9a59-d1c09b112872",
                        "glosses": [
                            "twórca epiki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f25f98-4b57-4ec7-907b-504ca2bc37e3",
                                "sense_id": "44ba3ecc-0790-30cb-9cb8-435b7344de0b",
                                "text": "Zdaniem Hezjoda, greckiego epika, Kalipso urodziła Odyseuszowi dwójkę dzieci, Nausitusa i Nausinusa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7dfa594-e35a-44bb-a1ad-87044832c414",
                        "source_entry_id": "e7ab5dd5-475a-3986-9a59-d1c09b112872",
                        "source_sense_id": "44ba3ecc-0790-30cb-9cb8-435b7344de0b",
                        "target_lang_word": "epicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95c194e9-0baa-3cab-83a6-18063f63765a",
                                        "entry_id": "69a52a89-ae44-3d85-be9d-13c334c3e903",
                                        "glosses": [
                                            "One who writes epics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fb7ee3e-700e-4015-9525-1e1378c4fce6",
                        "source_entry_id": "e7ab5dd5-475a-3986-9a59-d1c09b112872",
                        "source_sense_id": "44ba3ecc-0790-30cb-9cb8-435b7344de0b",
                        "target_lang_word": "Epiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0e2711-4363-3866-a48e-2dc66d4fc328",
                                        "entry_id": "ff856d8c-7cca-31fe-ac21-93f07e939110",
                                        "glosses": [
                                            "Verfasser von Werken in epischer Darstellungsweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499f41b5-770c-47fd-a9c9-8240b5a4494a",
                                                "sense_id": "4a0e2711-4363-3866-a48e-2dc66d4fc328",
                                                "text": "„Die Sprachkunst der höfischen Epiker und Minnesänger hörte nicht schlagartig auf, sondern lief langsam aus.“"
                                            },
                                            {
                                                "example_id": "10d5635e-25f8-43b9-87e3-07f90f0a6bae",
                                                "sense_id": "4a0e2711-4363-3866-a48e-2dc66d4fc328",
                                                "text": "„Für uns als Epiker ist das Kapitel und die Zusammenfassung von sieben oder fünf oder drei Kapiteln zu einem Buch genauso ein Formgesetz wie für den Dramatiker der Auftritt und der Akt; aber uns fehlt das Hilfsmittel, welches die Dramatiker haben: daß nämlich der Regisseur kommt und sagt, hören Sie mal, diese Szene ist zu lang, oder daß der Schauspieler kommt und sagt, hören Sie bitte, hier brauche ich noch mindestens zwanzig Verse, denn ich komme ja damit nicht zu Ende — und daß also derart das Zusammenfassende und das Zusammenspiel der Künste auf der Bühne von uns Erzählern ersetzt werden muß durch die Selbstkontrolle und durch die Einfühlung in den Leser, in die Leserschaft, und wenn es gut geht, in die Masse der Leser, denn große Epik überdauert eben Jahrhunderte.“"
                                            },
                                            {
                                                "example_id": "860a72fa-225f-4969-a383-b5eaf8fdf475",
                                                "sense_id": "4a0e2711-4363-3866-a48e-2dc66d4fc328",
                                                "text": "„Jóhann Magnús Bjarnason gleicht keinem anderen isländischen Epiker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc8a871f-a1ec-41c1-8bb0-62ce0ad3dc13",
                        "source_entry_id": "e7ab5dd5-475a-3986-9a59-d1c09b112872",
                        "source_sense_id": "44ba3ecc-0790-30cb-9cb8-435b7344de0b",
                        "target_lang_word": "Erzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Person, die etwas erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                                            },
                                            {
                                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Verfasser einer Erzählung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
