                        "maîtrise de la situation"
                    ]
                },
                {
                    "sense_id": "8cb661f1-0825-3a0a-8b68-91d03e656e8f",
                    "sense_definition": "Capacité à contrôler ses émotions, ses impulsions et ses réactions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut garder une grande <w>maîtrise</w> de soi pour négocier calmement dans ce conflit."
