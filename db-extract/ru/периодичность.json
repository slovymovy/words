                    {
                        "translation_id": "4a6b875d-87ba-46e4-aa0f-90c5079ca975",
                        "source_entry_id": "e9d905d6-c65b-3429-97ac-558263f79bfa",
                        "source_sense_description": "свойство по значению прилагательного периодический",
                        "target_lang_word": "frequency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frequency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eea318c0-037c-309b-81db-44c698a19f02",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "The rate of occurrence of anything; the relationship between incidence and time period."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26072256-7eb1-42d1-b65c-1799abe79a90",
                                                "sense_id": "eea318c0-037c-309b-81db-44c698a19f02",
                                                "text": "With growing confidence, the Viking’s raids increased in frequency."
                                            },
                                            {
                                                "example_id": "b95a0f94-9eff-4ad9-8b0c-2c3be50df356",
                                                "sense_id": "eea318c0-037c-309b-81db-44c698a19f02",
                                                "text": "The frequency of bus service has been improved from one every 15 to one every 12 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f20183d3-c00c-3962-a5f8-6e7356bc072f",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "The property of occurring often rather than infrequently."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3f48bf-3429-4489-89f9-4315fc0c7ce2",
                                                "sense_id": "f20183d3-c00c-3962-a5f8-6e7356bc072f",
                                                "text": "The FAQ addresses questions that come up with some frequency."
                                            },
                                            {
                                                "example_id": "489e45e9-e9a0-4b66-b3af-0f9532d65d55",
                                                "sense_id": "f20183d3-c00c-3962-a5f8-6e7356bc072f",
                                                "text": "The frequency of the visits was what annoyed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "The quotient of the number of times n a periodic phenomenon occurs over the time t in which it occurs: f=n/t."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b4ec6a1-99b2-42d3-a658-a264f9f40cd7",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "The frequency of the musical note A above middle C is 440 oscillations per second."
                                            },
                                            {
                                                "example_id": "2befa359-ee5e-4cc5-9362-d0fd9c54dbb4",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "The frequency of a wave is its velocity v divided by its wavelength #92;lambda: f#61;v#47;#92;lambda."
                                            },
                                            {
                                                "example_id": "1aece17b-b808-47f3-adae-1a9db1d74d7c",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "Broadcasting live at a frequency of 98.3 megahertz, we’re your rock alternative!"
                                            },
                                            {
                                                "example_id": "a7d9f2d3-ed4a-4850-b945-262cad1258b3",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "The frequency for electric power in the Americas is generally 60 Hz rather than 50."
                                            },
                                            {
                                                "example_id": "a15ac354-72e1-4af2-9ea2-ec087ff7fcdc",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "[…] the Plan incorporates in proper combination every available modern technique, including extensive electrification on the new standard high-voltage a.c. system at a frequency of 50 cycles; main-line diesel traction as a half-way house to electrification; lightweight diesel trains for secondary and branch services; and a smaller wagon fleet doing more work by the use of continuous brakes in conjunction with modernised terminals and marshalling yards."
                                            },
                                            {
                                                "example_id": "ea14b92e-ccdb-43a0-90a3-fe3ca6a55421",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "36 MHz transponder providing a pool of 794 reallocatable frequencies."
                                            },
                                            {
                                                "example_id": "fbfe9304-3eab-48a7-bf52-4636466b0f97",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "In this case, a band-pass filter using a range or window of frequencies is appropriate to isolate the frequency or the group of frequencies that characterize a specific cycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de244603-2425-32a8-97ce-5936bd654553",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "A tone, character, mood, or vibe"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bf786a-6d04-478a-86b3-e04e61bfcdf2",
                                                "sense_id": "de244603-2425-32a8-97ce-5936bd654553",
                                                "text": "And if you haven’t picked up on the gay frequencies in her lyrics, her wig choices, and her possible lesbian salutes? Maybe that’s because they weren’t meant for you. IYKYK."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cba6ed6-ed36-3558-b2f5-79109c3a2728",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "number of times an event occurred in an experiment (absolute frequency)"
                                        ],
