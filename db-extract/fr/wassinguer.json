                        "glosses": [
                            "Passer la wassingue (la serpillère) sur une surface."
                        ],
                        "tags": [
                            "Nord-Pas-de-Calais",
                            "Picardie"
                        ],
                        "examples": [
                            {
                                "example_id": "19979c5b-2c47-44ea-a750-a53256d1db37",
                                "sense_id": "b17a479d-e3f6-391c-b873-bf237ad3bbd5",
                                "text": "À quarante et un an passés, j’apprenais enfin à faire le ménage, à lessiver, à wassinguer, de belles dispositions, Alex, même des rudiments, ça n’est pas pour rien qu’il avait porté le pompon pendant six mois."
                            },
                            {
                                "example_id": "b4e6979b-24c9-4d70-8a21-d82f813413da",
                                "sense_id": "b17a479d-e3f6-391c-b873-bf237ad3bbd5",
                                "text": "Les foyers s’étaient employés à « ramoner » , « wassinguer » , « duweller »."
                            },
                            {
                                "example_id": "b6f78e1b-2a75-41c9-873e-75b0898230a1",
                                "sense_id": "b17a479d-e3f6-391c-b873-bf237ad3bbd5",
                                "text": "On a dû surélever tous nos meubles avec des parpaings pour les protéger et puis tout wassinguer."
                            }
                        ]
                    }
