                ],
                "senses": [
                    {
                        "sense_id": "cd68adcc-268f-3654-90a6-3d2ef277bd52",
                        "entry_id": "eb56be35-4c29-39fe-8282-5dfe260fccf2",
                        "glosses": [
                            "mittlerer Teil Italiens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29ee381-c03d-4dc0-9aea-943577d311ce",
                                "sense_id": "cd68adcc-268f-3654-90a6-3d2ef277bd52",
                                "text": "„Das Schwergewicht der Kriegshandlungen lag jedoch in Mittelitalien.“"
                            },
                            {
                                "example_id": "8004a3d0-40f3-432c-be91-0194829a5a80",
                                "sense_id": "cd68adcc-268f-3654-90a6-3d2ef277bd52",
                                "text": "„Zusammen mit anderen Städten Umbriens und der Marken empörte sich Assisi […] Der Erzbischof Christian von Mainz, kaiserlicher Legat für Mittelitalien, belagerte darauf Assisi und eroberte es im Jahre 1174.“"
                            },
                            {
                                "example_id": "8b3de8d8-69a6-4b6a-822f-cbfda5b83002",
                                "sense_id": "cd68adcc-268f-3654-90a6-3d2ef277bd52",
                                "text": "„Die Entstehung einer etruskischen Hochkultur nördlich von Latium und die Gründung griechischer Kolonien in Unteritalien seit dem 8. Jahrhundert waren entscheidend für die zivilisatorische Entwicklung Mittelitaliens und südetruskische Orte, wie Veii, Caere und Tarquinia, sollten für Rom maßgebliche Bedeutung gewinnen.“"
                            },
                            {
                                "example_id": "e1134680-e00d-4cd0-bd47-e808dfc7813d",
                                "sense_id": "cd68adcc-268f-3654-90a6-3d2ef277bd52",
                                "text": "„Die im Frühling 1632 in Mittelitalien waltende Pest verzögerte die schnelle Verbreitung des Buches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
