                "senses": [
                    {
                        "sense_id": "ae2b100f-8306-397c-a498-0e953293d346",
                        "entry_id": "f3ff2444-38eb-30cd-ad17-d6d10bc78c9b",
                        "glosses": [
                            "Donner un caractère diasporique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc3658b-706a-40d3-bbd9-90bab85ed40f",
                                "sense_id": "ae2b100f-8306-397c-a498-0e953293d346",
                                "text": "Sont-elles à l’origine de nouvelles communautés de diasporas ? Ou plutôt un amplificateur de la mondialisation, d'une société elle-même en train de se \"diasporiser\" ?"
                            },
                            {
                                "example_id": "0a915c1a-e4d3-4bd4-9771-a599ffc654ef",
                                "sense_id": "ae2b100f-8306-397c-a498-0e953293d346",
                                "text": "L´Afrique a continué de se diasporiser, ses écrivains se sont mondialisés."
                            },
                            {
                                "example_id": "61a7743b-077e-4392-960b-9bdde9f7caba",
                                "sense_id": "ae2b100f-8306-397c-a498-0e953293d346",
                                "text": "Ça l’avait terriblement excité de croire qu'’il pourrait s’envoyer l’armée israélienne et la diasporiser à foison d’étreintes fougueuses."
                            }
                        ]
                    }
