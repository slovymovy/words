                ],
                "senses": [
                    {
                        "sense_id": "8c890586-24a1-3016-9784-746643244dac",
                        "entry_id": "0f611bb7-ca77-39ea-8dab-b261a81c5cb0",
                        "glosses": [
                            "Frapper violemment."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c21bc2c1-3364-4198-95e9-c9e51636a405",
                                "sense_id": "8c890586-24a1-3016-9784-746643244dac",
                                "text": "Peut-être la valeur de la taule… voir s’ils pouvaient pas me nuire… me faire faire un tour dans la cave… me sataner la gueule…"
                            },
                            {
                                "example_id": "6d69a282-6121-47ef-8cee-da512830b28f",
                                "sense_id": "8c890586-24a1-3016-9784-746643244dac",
                                "text": "Ayant été satané à longueur de journée, pour un oui ou pour un non, toute envie de battre au naïf, ou au discret, semblait avoir quitté Robert."
                            },
                            {
                                "example_id": "58528771-fd8b-4cf9-b2c5-6d02a2fef840",
                                "sense_id": "8c890586-24a1-3016-9784-746643244dac",
                                "text": "Le Dabe qui avait dû se sataner un peu partout dans le monde, l’a cueilli, sur une feinte de tête, d’un formidable coup de latte dans le buffet, et ça a été tout de suite la mêlée."
                            },
                            {
                                "example_id": "dfa1656d-6c2e-43a9-bbbb-37dd007f0666",
                                "sense_id": "8c890586-24a1-3016-9784-746643244dac",
                                "text": "Toute moulue encore des jetons que le grand lui a filés, elle compare. Comme un vrai voyou, il l’a satanée, ce grand hotu chéri, et le Mexicain, qui correctionnait fort pourtant, n'aurait pu mieux faire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eb0cb52-94c4-4e24-ad6f-ecce2a2f6b64",
                        "source_entry_id": "0f611bb7-ca77-39ea-8dab-b261a81c5cb0",
                        "source_sense_id": "8c890586-24a1-3016-9784-746643244dac",
                        "target_lang_word": "lean on",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lean on",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "353324a6-ec26-3304-9f0d-3708ac91af6b",
                                        "entry_id": "96e08ed7-732f-36c6-a6cb-adafa739d762",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see lean, on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f61d2c99-0aad-3b46-bb9e-41084b3b69a9",
                                        "entry_id": "96e08ed7-732f-36c6-a6cb-adafa739d762",
                                        "glosses": [
                                            "To depend upon for support; to require assistance from."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3388551-73ec-4a8c-a3df-29518276df35",
                                                "sense_id": "f61d2c99-0aad-3b46-bb9e-41084b3b69a9",
                                                "text": "I wish to acknowledge my supervisors (including my unofficial supervisors) who I have leaned on greatly to create a thesis (hopefully) worth reading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "993ad737-f14f-3cd7-ae24-d479b097ded3",
                                        "entry_id": "96e08ed7-732f-36c6-a6cb-adafa739d762",
                                        "glosses": [
                                            "To put pressure on; to attempt to compel a person to do something; to exert influence on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd9e925e-32da-4f01-b01c-d0d954c20b5d",
                                                "sense_id": "993ad737-f14f-3cd7-ae24-d479b097ded3",
                                                "text": "[ Scott Gottlieb ] argues that putting dairy and nondairy milks under the same umbrella dupes consumers into thinking the two are nutritional equals, which, according to him, could have potentially dire consequences such as rickets in toddlers. […] Of course, a more cynical read of the situation posits that Big Dairy is leaning on the FDA to discredit plant milks, the industry’s biggest competition, as a viable substitute for cow’s milk."
                                            },
                                            {
                                                "example_id": "a0607e5d-5d39-4dc1-bd82-0ac8cb1fdb4a",
                                                "sense_id": "993ad737-f14f-3cd7-ae24-d479b097ded3",
                                                "text": "He didn't make a donation until some of his customers leaned on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f28cb4e-d355-345f-bd57-1cf3ef26365e",
                                        "entry_id": "96e08ed7-732f-36c6-a6cb-adafa739d762",
                                        "glosses": [
                                            "To criticize or reprimand for the purpose of changing behavior."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
