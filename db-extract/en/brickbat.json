                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81855f6f-2c27-4605-89ca-b315720106a4",
                                                "sense_id": "3cf74f63-497a-33ee-a6b0-2385ececd9d6",
                                                "text": "Значит, когда-то космический булыжник распался на мелкие части."
                                            }
