                    {
                        "translation_id": "871e5cd8-2ac4-46b7-a010-315fc174c78e",
                        "source_entry_id": "c49bd25c-0dcb-308b-9d6f-158e58e89243",
                        "source_sense_description": "raincoat made from treated cotton fabric",
                        "target_lang_word": "ciré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db2c0371-6868-3bdb-aca6-9c3aa34ae05d",
                                        "entry_id": "9e17437a-a685-3d8a-82c4-9e9eca0fff24",
                                        "glosses": [
                                            "Qui est recouvert de cire, de cirage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49d11d1-ec0f-45fd-9fd4-27c8927210fd",
                                                "sense_id": "db2c0371-6868-3bdb-aca6-9c3aa34ae05d",
                                                "text": "Un vieillard svelte entra dans le salon. Ses moustaches cirées et sa barbiche blanche lui donnaient l’apparence d’un vieux militaire."
                                            },
                                            {
                                                "example_id": "4ef9e543-4902-47b4-87c2-2b35e4a7b3fa",
                                                "sense_id": "db2c0371-6868-3bdb-aca6-9c3aa34ae05d",
                                                "text": "Lui-même chaussa en un tournemain ses vieux croquenots mal cirés, avachis et trop grands, puis enfila son pantalon qui lui pendait disgracieusement par derrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ciré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                        "entry_id": "17e4cb79-3b81-3c11-8368-9f988ca2a9c5",
                                        "glosses": [
                                            "Manteau imperméable fait initialement de tissu huilé, à présent fait de tissu plastifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19e0b17-1adc-419e-99d4-750198a4da87",
                                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                                "text": "Habillés déjà en soldats du Gouvernement, ciré sur le dos, les hommes descendaient un à un dans la grande vedette balancée par les remous du Yang-Tsé."
                                            },
                                            {
                                                "example_id": "39977600-e9d3-4a41-beb3-062c1fbe0ed1",
                                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                                "text": "Maëlys s'est pointée, elle avait laissé son ciré rouge qui lui allait si bien ; pourtant, il drachait sacrément, c'est fait pour ça, les cirés."
                                            },
                                            {
                                                "example_id": "af15cd6b-2ff5-4c73-9a79-90c79dec099d",
                                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                                "text": "Dans l’entrée, des cirés jaunes pendaient à un portemanteau."
                                            },
                                            {
                                                "example_id": "2037e247-40c6-44ec-815d-ca65011aa0c5",
                                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                                "text": "Une seule chose importait à présent. S’équiper pour la sortie. Sourd à la mauvaise humeur de Jonas, il trouva des bottes de caoutchouc, des cirés à capuches, des lunettes de plongée, des cannes de marche en aluminium."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ciré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d951550a-e227-3d80-99d3-9227ed9c98c6",
                                        "entry_id": "04ccccb7-60a2-33b1-afce-35ee8e68634e",
                                        "glosses": [
                                            "Participe passé masculin singulier de cirer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
