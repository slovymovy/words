                "senses": [
                    {
                        "sense_id": "dd2b6278-479a-3d26-aaef-8d11cbf94bf8",
                        "entry_id": "52c93633-a8ad-352a-a954-4bd22d9df475",
                        "glosses": [
                            "физ. единица измерения времени, равная одной триллионной доле (10⁻¹²) секунды [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46587ac6-7007-488a-93eb-be75a9f83276",
                                "sense_id": "dd2b6278-479a-3d26-aaef-8d11cbf94bf8",
                                "text": "Дисперсия света в оптическом волокне измеряется в пикосекундах на нанометр длины волны на километр длины волокна."
                            },
                            {
                                "example_id": "663a6b88-c3f2-4b6f-b56f-ef0e15ed7f8c",
                                "sense_id": "dd2b6278-479a-3d26-aaef-8d11cbf94bf8",
                                "text": "Он позволяет учесть одновременно как быстрые (десятки пикосекунд), так и медленные процессы, которые растягиваются на секунды."
                            }
                        ]
                    }
                ],
