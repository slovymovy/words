                                "target_senses": [
                                    {
                                        "sense_id": "8682c8d7-710e-3842-8113-4c4a0fb689a5",
                                        "entry_id": "f03cdb3d-4641-3ff5-8d7f-cf017594effa",
                                        "glosses": [
                                            "Chapeau d’été, large et souple, fabriqué en Équateur et au Pérou, tressé avec les feuilles de Carludovica palmata, une plante palmiforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b97aba-83a2-46bc-8484-10c0029bde07",
                                                "sense_id": "8682c8d7-710e-3842-8113-4c4a0fb689a5",
                                                "text": "Sur les photos de famille prises l’été suivant, on voit de jeunes dames en robes longues, aux chapeaux empanachés de plumes d’autruche, des messieurs coiffés de canotiers et de panamas qui sourient à un bébé : ce sont mes parents, mon grand-père, des oncles, des tantes, et c’est moi."
                                            },
                                            {
                                                "example_id": "e8bb1cff-d137-4f18-8d03-cfbf7ecc65d3",
                                                "sense_id": "8682c8d7-710e-3842-8113-4c4a0fb689a5",
                                                "text": "Son panama rabattu sur les yeux à mesure que la luminosité augmente, il regarde devant lui, répond au lointain bonjour d’un homme du domaine en soulevant son chapeau."
                                            },
                                            {
                                                "example_id": "b1b579d0-ef76-4409-af61-216ef22b48ae",
                                                "sense_id": "8682c8d7-710e-3842-8113-4c4a0fb689a5",
                                                "text": "Le panama est le chapeau star de l’été. Originaire d’Équateur (contrairement à ce qu’indique son nom), ce couvre-chef en paille peut se porter teinté de couleur ou pas, avec ou sans ruban."
                                            },
                                            {
                                                "example_id": "d8bed2b6-456b-4628-8102-b802a48f4682",
                                                "sense_id": "8682c8d7-710e-3842-8113-4c4a0fb689a5",
                                                "text": "Après avoir ôté son panama, Liz conserve son fichu sur la tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
