                ],
                "senses": [
                    {
                        "sense_id": "c592b876-7444-314e-98ee-7c4ac575256a",
                        "entry_id": "645782df-1678-36ca-b78f-4757d06b820c",
                        "glosses": [
                            "однорядная русская гармонь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18a5e2d2-c62f-4d0e-9a39-28c1d47f1c57",
                                "sense_id": "c592b876-7444-314e-98ee-7c4ac575256a",
                                "text": "Я тогда песни пою, // Когда играт тальянка! // Я у мамы — одна дочь, — // Чиста атаманка!"
                            },
                            {
                                "example_id": "bb9b3190-d689-412c-a2ff-957d6692af4c",
                                "sense_id": "c592b876-7444-314e-98ee-7c4ac575256a",
                                "text": "Оттого-то вросла тужиль // В переборы тальянки звонкой."
                            },
                            {
                                "example_id": "b5da00c9-940a-45be-a757-742128374c4b",
                                "sense_id": "c592b876-7444-314e-98ee-7c4ac575256a",
                                "text": "Эх, тальянки, д’ медны планки, // Тонки, звонки голоса!"
                            },
                            {
                                "example_id": "d871e158-7caa-4c18-be4f-abeb2289331a",
                                "sense_id": "c592b876-7444-314e-98ee-7c4ac575256a",
                                "text": "Бражники потянулись к чаркам, зашумели. Гармонисты стали налаживать свои тальянки. — А ну спляшем!"
                            }
                        ]
                    }
                ],
