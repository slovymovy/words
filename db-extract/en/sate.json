            {
                "entry_id": "9dd17fe6-71e6-3c65-877b-e24bdd1e6717",
                "word": "sate",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5b616948-226c-3377-adef-15db75aa7e50",
                        "entry_id": "9dd17fe6-71e6-3c65-877b-e24bdd1e6717",
                        "glosses": [
                            "simple past of sit"
                        ],
                        "tags": [
                            "dated",
                            "form-of",
                            "past",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "a345bf4d-0b7b-4f69-a236-9cf20d14afab",
                                "sense_id": "5b616948-226c-3377-adef-15db75aa7e50",
                                "text": "So saying, she sate down at a little distance upon the bench on which Allan M‘Aulay was placed, and tuning her clairshach, a small harp, about thirty inches in height, she accompanied it with her voice."
                            },
                            {
                                "example_id": "e8f1cf75-c105-4f5a-901a-e451a461beac",
                                "sense_id": "5b616948-226c-3377-adef-15db75aa7e50",
                                "text": "[…] And easy, smiling, seasoned sound, / Sate the king when healths went round."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca3d8aac-6c04-3906-93c5-a0ed27c4b1b2",
                        "entry_id": "9dd17fe6-71e6-3c65-877b-e24bdd1e6717",
                        "glosses": [
                            "past participle of sit"
                        ],
                        "tags": [
                            "dated",
                            "form-of",
                            "participle",
                            "past",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "7e832a24-9ad4-429c-8a52-bd7b115fa2af",
                                "sense_id": "ca3d8aac-6c04-3906-93c5-a0ed27c4b1b2",
                                "text": "[…] and I am old enough to remember how often I have seen the beautiful Duchess of Devonshire, about eight in the morning (when I was at Bath in 91 or 92), returning from the parade, where she had sate up the live-long night with her sister, Lady Duncannon; it can therefore be no disgrace to appear as if you felt for your daughter."
                            }
                        ]
                    }
