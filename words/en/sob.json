{
    "word_family": [
        "sobbing",
        "sobbed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c724e67f-59b3-3c56-a710-73307cc05ba5",
                    "sense_definition": "A cry characterized by short, sudden, and convulsive inhalations of breath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to hide her <w>sob</w> behind a handkerchief.",
                            "target_lang_translations": {
                                "ru": "Она попыталась скрыть своё <w>всхлипывание</w> за платком."
                            }
                        },
                        {
                            "text": "A single <w>sob</w> escaped her as she watched the sad movie.",
                            "target_lang_translations": {
                                "ru": "Один-единственный <w>всхлип</w> вырвался у неё, когда она смотрела грустный фильм."
                            }
                        }
                    ],
                    "synonyms": [
                        "wail",
                        "weep"
                    ],
                    "common_phrases": [
                        "choked sob",
                        "stifled sob"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плач, сопровождающийся короткими, резкими и судорожными вдохами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всхли́пывание",
                                "target_lang_sense_clarification": "звук или процесс прерывистого дыхания при плаче"
                            },
                            {
                                "target_lang_word": "рыда́ние",
                                "target_lang_sense_clarification": "более сильный и глубокий плач с судорожными вдохами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f85da92f-300d-3053-8098-931554d863fc",
                    "sense_definition": "To weep loudly with convulsive gasps of breath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>sob</w> uncontrollably after losing his toy.",
                            "target_lang_translations": {
                                "ru": "Ребёнок начал неудержимо <w>рыдать</w> после того, как потерял свою игрушку."
                            }
                        },
                        {
                            "text": "She could not stop <w>sobbing</w> when she heard the tragic news.",
                            "target_lang_translations": {
                                "ru": "Она не могла перестать <w>рыдать</w>, когда услышала трагические новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep",
                        "cry"
                    ],
                    "common_phrases": [
                        "sob uncontrollably",
                        "sob bitterly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко плакать с судорожными вдохами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всхли́пывать",
                                "target_lang_sense_clarification": "плакать прерывисто, втягивая воздух"
                            },
                            {
                                "target_lang_word": "рыда́ть",
                                "target_lang_sense_clarification": "плакать громко и сильно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa593953-becc-3a8f-9f1e-db6d1e520635",
                    "sense_definition": "To speak while crying with convulsive gasps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I am sorry,\" she <w>sobbed</w> through her tears.",
                            "target_lang_translations": {
                                "ru": "«Прости меня», — <w>прорыдала</w> она сквозь слёзы."
                            }
                        },
                        {
                            "text": "He <w>sobbed</w> out his apology to his parents.",
                            "target_lang_translations": {
                                "ru": "Он <w>выговорил сквозь рыдания</w> свои извинения родителям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sob out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить что-либо во время плача, прерываясь на судорожные вдохи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить сквозь слёзы",
                                "target_lang_sense_clarification": "описание речи, сопровождаемой плачем"
                            },
                            {
                                "target_lang_word": "выговаривать сквозь рыдания",
                                "target_lang_sense_clarification": "произносить слова с трудом из-за сильного плача"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}