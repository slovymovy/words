    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acdfb455-e211-3902-82fe-24abb24566bf",
                    "sense_definition": "The natural process of getting bigger, taller, or more developed over time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor is monitoring the child's <w>growth</w> to ensure they are healthy.",
                            "target_lang_translations": {
                                "ru": "Врач следит за <w>ростом</w> ребенка, чтобы убедиться, что он здоров.",
                                "pl": "Lekarz monitoruje <w>wzrost</w> dziecka, aby upewnić się, że jest ono zdrowe.",
                                "zh": "医生正在监测孩子的<w>生长</w>情况，以确保他们健康。"
                            }
                        },
                        {
                            "text": "Adequate sunlight and water are essential for the rapid <w>growth</w> of these plants.",
                            "target_lang_translations": {
                                "ru": "Достаточное количество солнечного света и воды необходимы для быстрого <w>роста</w> этих растений.",
                                "pl": "Odpowiednia ilość światła słonecznego i wody jest niezbędna do szybkiego <w>rośnięcia</w> tych roślin.",
                                "zh": "充足的阳光和水分对这些植物的快速<w>生长</w>至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "development",
                        "maturation"
                    ],
                    "antonyms": [
                        "nondevelopment"
                    ],
                    "common_phrases": [
                        "rapid growth",
                        "stunted growth",
                        "growth rate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный процесс увеличения размера, высоты или развития с течением времени.",
                        "pl": "Naturalny proces powiększania się, rośnięcia lub rozwoju z biegiem czasu.",
                        "zh": "生物体随时间推移在体型、身高或发育程度上的自然增长过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "физическое увеличение организма"
                            },
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "процесс созревания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wzrost",
                                "target_lang_sense_clarification": "fizyczne zwiększanie rozmiarów ciała lub organizmu"
                            },
                            {
                                "target_lang_word": "rozwój",
                                "target_lang_sense_clarification": "proces dojrzewania i stopniowych zmian"
                            },
                            {
                                "target_lang_word": "rośnięcie",
                                "target_lang_sense_clarification": "sam proces stawania się większym"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生长",
                                "target_lang_sense_clarification": "指生物体发育和体积增大的过程"
