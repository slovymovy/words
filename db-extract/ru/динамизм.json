                                "target_senses": [
                                    {
                                        "sense_id": "a894cf58-0af1-3d73-b088-34586372f9fb",
                                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                                        "glosses": [
                                            "Lehre, nach der sich alle Erscheinungsformen oder die Wirklichkeit durch die Wirkung von Kräften erklären lässt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebed24cc-bfa8-44eb-8bd0-4f6383efd0a9",
                                                "sense_id": "a894cf58-0af1-3d73-b088-34586372f9fb",
                                                "text": "Dynamismus und Mechanismus sind zwei Theorien über die Kräfte in der Naturphilosophie des 17. und des 18. Jahrhunderts. Dynamismus sieht die Form (Idee) als vor der Materie existent an. Im Mechanismus kommt die Materie vor der Form."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95f7c1e8-84b9-3dad-9bc3-dce98accd5f7",
                                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                                        "glosses": [
                                            "Glaube an unpersönliche übernatürliche Kräfte (wie Mana), die eigenständig gedacht werden, jedoch in Dingen, Tieren oder Personen verkörpert erscheinen und übertragen werden können"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7227c425-8e25-33e6-944f-dbeae78b565b",
                                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                                        "glosses": [
                                            "Kraft, die auf Veränderung und/oder Entwicklung gerichtet ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f224cd73-4f9e-421d-83ca-9c1e455b0844",
                                                "sense_id": "7227c425-8e25-33e6-944f-dbeae78b565b",
                                                "text": "Bei allem Dynamismus war sie doch eine Frau der Gegenwart und keine große Visionärin."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4cb9238f-5645-3697-86fd-8bd0f91b12d3",
                                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                                        "glosses": [
                                            "Handlung, die von Tatkraft (Dynamik) zeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf0abfc-6e24-4057-ab26-03d2db4b76d1",
                                                "sense_id": "4cb9238f-5645-3697-86fd-8bd0f91b12d3",
                                                "text": "Abwehrmechanismen sind starke Dynamismen, deren Ziel allerdings in der Bewahrung des Status quo liegt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
