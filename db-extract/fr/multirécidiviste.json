                                        "entry_id": "1e012836-eabd-3862-bd34-85623558597f",
                                        "glosses": [
                                            "(jugendlicher) Krimineller, der oft straffällig geworden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dfd1075-4aa5-4205-aec9-156ab4e70e35",
                                                "sense_id": "63f13774-0c22-3bec-98b5-3e8a25af603d",
                                                "text": "Das Gericht bestrafte den Intensivtäter mit Jugendarrest."
                                            },
                                            {
                                                "example_id": "8250628f-e571-407d-bbc3-b8250081b03a",
                                                "sense_id": "63f13774-0c22-3bec-98b5-3e8a25af603d",
                                                "text": "„Immerhin ist eindeutig bewiesen, dass die meisten Intensivtäter vorher Kinder gewesen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
