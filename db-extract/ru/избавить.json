                "senses": [
                    {
                        "sense_id": "dd898545-76fd-3f53-ac84-87bef45a3a56",
                        "entry_id": "547aaf2e-90a0-30a9-9394-f6f3f5f3797d",
                        "glosses": [
                            "спасти от чего-либо опасного, тягостного, мучительного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd9dccc-79da-4473-96dc-a0c047e4482b",
                                "sense_id": "dd898545-76fd-3f53-ac84-87bef45a3a56",
                                "text": "Делайте что хотите, как хотите, только избавьте, уберите их от нас!"
                            },
                            {
                                "example_id": "c6124a93-9db4-43aa-af2e-e19fa2002919",
                                "sense_id": "dd898545-76fd-3f53-ac84-87bef45a3a56",
                                "text": "А мы надеялись было, что Он есть Тот, Который должен избавить Израиля; но со всем тем, уже третий день ныне, как это произошло."
                            }
                        ]
                    },
                    {
                        "sense_id": "8edc7d55-6a53-3857-b3d4-40a50c99dde8",
                        "entry_id": "547aaf2e-90a0-30a9-9394-f6f3f5f3797d",
                        "glosses": [
                            "помочь, позволить избежать чего-либо нежелательного, обременительного"
                        ],
                        "tags": [],
                        "examples": []
                    }
