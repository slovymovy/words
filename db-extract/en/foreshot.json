                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8800b1af-4d24-4a67-8fa8-b020110b67d0",
                                "sense_id": "5e1a268d-71bb-3611-82e5-3b240547a75b",
                                "text": "Foreshots knock the ball forward."
                            }
                        ]
                    },
                    {
                        "sense_id": "2eea9c9e-46f2-3a7b-82a4-d68b37518faf",
                        "entry_id": "4a7ecbd9-33fb-3dba-8ac6-cfdc94dde02c",
                        "glosses": [
                            "A measurement of the azimuth when sighting to the next point along a path that is being measured with a compass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0ff9f5-2fe3-4f23-9ec0-dcb299f3ceda",
                                "sense_id": "2eea9c9e-46f2-3a7b-82a4-d68b37518faf",
                                "text": "Twelve foreshot and twelve backshot records at varying offsets were acquired for each geophone setup to achieve 24 fold duplicity."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bcef923-2c19-3948-a770-f9dda66307d9",
                        "entry_id": "4a7ecbd9-33fb-3dba-8ac6-cfdc94dde02c",
