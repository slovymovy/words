        "fr-extract.jsonl": [
            {
                "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                "word": "sujétion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "750b9f3e-b338-46d3-b175-a3fab0694f2c",
                        "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "tags": [
                            "plural"
                        ],
                        "form": "sujétions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cea39ba-ca75-330c-8e3c-dd366c7c94cc",
                        "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "glosses": [
                            "Dépendance, état de celui qui est soumis à un pouvoir, à une domination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db761f4c-f33d-479c-bb74-807cdf66d6d4",
                                "sense_id": "3cea39ba-ca75-330c-8e3c-dd366c7c94cc",
                                "text": "Vivre, tenir, dans la sujétion."
                            },
                            {
                                "example_id": "3d927179-b999-4e8a-a8b8-bcdf0548b970",
                                "sense_id": "3cea39ba-ca75-330c-8e3c-dd366c7c94cc",
                                "text": "S’affranchir de la sujétion, demeurer dans la sujétion qu’on doit aux lois."
                            },
                            {
                                "example_id": "86708784-91cf-4d8c-a4ee-411dd92f285e",
                                "sense_id": "3cea39ba-ca75-330c-8e3c-dd366c7c94cc",
                                "text": "« ... la sujétion féminine se vit encore renforcée quand nos ancêtres abandonnèrent leur existence nomade pour se sédentariser et commencèrent à accumuler les biens matériels. »"
                            },
                            {
                                "example_id": "98f8c89e-4673-4c28-a439-a8917eb8c4c5",
                                "sense_id": "3cea39ba-ca75-330c-8e3c-dd366c7c94cc",
                                "text": "[…] le bien fut […] la réalisation de la volonté d’un être supérieur, une sorte de sujétion humiliante pour la dignité humaine […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5338b4af-1b97-3240-8385-33f851671508",
                        "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "glosses": [
                            "État de celui qui est astreint à quelque nécessité, obligé à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427cba41-763a-458c-abdc-d205570441cb",
                                "sense_id": "5338b4af-1b97-3240-8385-33f851671508",
                                "text": "Tous les besoins de la vie sont de grandes sujétions."
                            },
                            {
                                "example_id": "156462f8-8d0b-4181-a93b-8c7b6a0fee03",
                                "sense_id": "5338b4af-1b97-3240-8385-33f851671508",
                                "text": "Il est dangereux de se faire certaines habitudes, elles deviennent ensuite des sujétions."
                            },
                            {
                                "example_id": "b9ce77c1-dc29-41b4-a576-c45dfd519fc8",
                                "sense_id": "5338b4af-1b97-3240-8385-33f851671508",
                                "text": "L’obligation de veiller une partie de la nuit lui est une dure sujétion."
                            }
                        ]
                    },
                    {
                        "sense_id": "10676d2a-9385-36a8-98a2-09015267eba6",
                        "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "glosses": [
                            "Nécessité où l’on est de ne pas s’éloigner d’un endroit, de ne pas quitter une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5174218-f494-48dd-91b2-8cee6611a5b3",
                                "sense_id": "10676d2a-9385-36a8-98a2-09015267eba6",
                                "text": "La surveillance de cet établissement m’a été confiée : c’est pour moi une grande sujétion."
                            },
                            {
                                "example_id": "81a376ab-bcf9-4155-b9ed-e6a2f01cda73",
                                "sense_id": "10676d2a-9385-36a8-98a2-09015267eba6",
                                "text": "Cette mère n’a personne pour s’occuper de ses enfants : c’est pour elle une sujétion de tous les instants."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b80488f-d38f-3b88-be31-636b86e0fe82",
                        "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "glosses": [
                            "Assiduité que demande une charge, un emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f327d67b-4273-4ff5-8920-abff1fa68fd6",
                                "sense_id": "7b80488f-d38f-3b88-be31-636b86e0fe82",
                                "text": "C’est un emploi qui comporte une grande sujétion."
                            },
                            {
                                "example_id": "74506a77-6eab-460f-af4d-e0a4a9818ccd",
                                "sense_id": "7b80488f-d38f-3b88-be31-636b86e0fe82",
                                "text": "Je n’ai pas accepté ce poste en raison de la sujétion à laquelle on y est astreint."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b3e621d-b0a2-37a8-8291-24e9b7484f59",
                        "entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "glosses": [
                            "État de ce qui est sujet à servitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45164f00-c60a-459a-b4d7-6344d6593621",
                                "sense_id": "7b3e621d-b0a2-37a8-8291-24e9b7484f59",
                                "text": "La sujétion la plus importante est constituée par la ligne EDF Bezaumont Vogelgrun qui traverse la forêt sur 5.305 km pour une surface d’emprise de 19.66 ha."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2e21f80-4127-4753-838c-6c6da54d7a96",
                        "source_entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "target_lang_word": "Abhängigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abhängigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                        "entry_id": "68fcce11-fe3d-3e0c-8ad5-a456f8b4e7bb",
                                        "glosses": [
                                            "Zustand, auf jemand oder etwas angewiesen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e796c2c-fb51-4fdf-ba4d-f6e695ea8c92",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "Sie wollte ihre Abhängigkeit nicht mehr ertragen."
                                            },
                                            {
                                                "example_id": "7cacdb64-d8e1-4cdd-89d3-fc70992cdec6",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "Die Abhängigkeit des Ergebnisses vom Einsatz der Mitarbeiter ist für alle erkennbar."
                                            },
                                            {
                                                "example_id": "795e88db-ce86-40c6-a85f-de82b61eb3f1",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "„Die Mährer werden erstmals 822 in einer fränkischen Quelle erwähnt, als sie auf einer Reichsversammlung in Frankfurt am Main erscheinen und Geschenke überbringen, gewiß als Zeichen einer lockeren Abhängigkeit.“"
                                            },
                                            {
                                                "example_id": "c150a356-c1a0-44dd-b53e-cb505e06d0ed",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "„Die Rüstungsindustrie Chinas hat in den vergangen Jahren große Fortschritte gemacht, sodass das Land seine Abhängigkeit von Rüstungsimporten aus dem Ausland deutlich verringern konnte.“"
                                            },
                                            {
                                                "example_id": "df313157-bd8f-4841-9c0e-f61b7a2cc701",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "„Doch musste CERN auch bereits verspüren, dass die vermeintlich günstigen Konditionen oftmals nur als Köder dienten, um eine Abhängigkeit zum Hersteller zu schaffen. Sobald diese Abhängigkeit zementiert war, fielen plötzlich die günstigen Konditionen weg. Genau das passierte CERN dann auch mit Microsoft.“"
                                            },
                                            {
                                                "example_id": "2fc2a69a-977b-4fb3-bdf0-fa897c74a136",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "„Diese Freundschaften mündeten meist in Abhängigkeit.“"
                                            },
                                            {
                                                "example_id": "e3488cd2-80b4-4296-a41f-bd2b9c5ee0e9",
                                                "sense_id": "9f8ab03b-6089-3d25-b2fd-28ee095c7974",
                                                "text": "„Eine Fahrt mit Larroque durch die Gegend offenbart die Abhängigkeit beider Seiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "650da9e3-ba5c-393a-b13a-03a9a21e9139",
                                        "entry_id": "68fcce11-fe3d-3e0c-8ad5-a456f8b4e7bb",
                                        "glosses": [
                                            "Angewiesenheit sprachlicher Ausdrücke auf andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0e9774-6d10-4ceb-ac41-1a0b19fc4ab2",
                                                "sense_id": "650da9e3-ba5c-393a-b13a-03a9a21e9139",
                                                "text": "In der Dependenzgrammatik werden die Abhängigkeiten sprachlicher Ausdrücke voneinander untersucht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b94c970-91d9-4f3a-9685-90ec291edaa8",
                        "source_entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "target_lang_word": "Bürde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b72b263-3457-38c0-8a81-79acd76f38cd",
                                        "entry_id": "104e68cd-5ff1-30f7-a0f9-ce06ef5d3b18",
                                        "glosses": [
                                            "Last mit hohem Gewicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954da8f2-3e71-42da-88fe-4da1a30c2e68",
                                                "sense_id": "1b72b263-3457-38c0-8a81-79acd76f38cd",
                                                "text": "„Zwei Gestalten schleppen eine schwere Bürde über den Hof […].“"
                                            },
                                            {
                                                "example_id": "dc2c40e0-5e7a-42e2-b728-a75c961f3263",
                                                "sense_id": "1b72b263-3457-38c0-8a81-79acd76f38cd",
                                                "text": "„Das Mädchen, statt aller Antwort, faßte die Hand der Indianerin, und die beiden hoben ihre Bürde auf die soeben angezeigte Weise mit verschlungenen Händen und trugen sie der Baumhöhle zu, in welcher sie sich niederließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7d74d89-b713-37eb-87ba-90da4fd9cc41",
                                        "entry_id": "104e68cd-5ff1-30f7-a0f9-ce06ef5d3b18",
                                        "glosses": [
                                            "moralische Last"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b172f80c-dc29-46d2-8383-759f71db9a0b",
                                                "sense_id": "f7d74d89-b713-37eb-87ba-90da4fd9cc41",
                                                "text": "„Talente sind aber auch eine Bürde, weil sie Hingabe, Aufmerksamkeit, Training und Disziplin fordern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "57163e48-ce58-3995-917d-ed1875e42a05",
                                        "entry_id": "104e68cd-5ff1-30f7-a0f9-ce06ef5d3b18",
                                        "glosses": [
                                            "die Leibesfrucht"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4893678e-428f-4cd4-beeb-15510df5b155",
                                                "sense_id": "57163e48-ce58-3995-917d-ed1875e42a05",
                                                "text": "„Vorher ungewohnt, nur wenige Schritte zu der bequemsten Zeit zu Fuße zu gehen, wo dann die vornehmsten Edelleute ihres Hofes sie geleiteten, war sie jetzt genötigt, im heißesten Juli, von der Bürde ihres Leibes bedrückt, über scharfes Gestein zu wandern und, dem ärmsten Geschöpf des Erdbodens gleich, Kummer und Ungemach zu erdulden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8a561955-524c-312f-992e-f9a16ce6e9f8",
                                        "entry_id": "104e68cd-5ff1-30f7-a0f9-ce06ef5d3b18",
                                        "glosses": [
                                            "Belastung eines Messgerätes mit elektrischem Ausgangssignal"
                                        ],
                                        "tags": [
                                            "Messumformer",
                                            "Messwandler"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97338118-ee1c-46b0-98d2-e7a35fce3350",
                                                "sense_id": "8a561955-524c-312f-992e-f9a16ce6e9f8",
                                                "text": "„Die zulässige Bürde hängt von der Spannung der Schleifenversorgung ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62475d8e-7a34-45f9-8b4d-d026ea27b9d5",
                        "source_entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "target_lang_word": "Zwang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                        "entry_id": "3e179eb0-dfc0-3603-9e87-2423a5b58e8d",
                                        "glosses": [
                                            "innerer oder äußerer Druck, etwas zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa67f59-a5db-4af7-a438-1932a270f6ed",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "Es bestand kein Zwang, Mitglied zu sein."
                                            },
                                            {
                                                "example_id": "203a4b87-d70e-4a75-98f2-9791c892d7e5",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "„Der amerikanische Politologe, einer der meistzitierten seines Fachs, hat ein Gelehrtenleben lang Zeugnis abgelegt für all jene, die sich den Zwängen des Staates entziehen.“"
                                            },
                                            {
                                                "example_id": "fc0beeb0-6a7f-4e5b-beb1-804fba8ee83a",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "„Jede Lehre unterliegt nun aber, wie man weiß, auf Seiten der Benutzer solcher Stilbücher dem nicht immer mühelosen Zwang des Lernens.“"
                                            },
                                            {
                                                "example_id": "d52d8f44-5b8c-4daf-89db-6302b67a6172",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "„Jeder von uns sitzt solchen Zwängen und Trugbildern auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64805484-49aa-421c-8d83-a1b97c75c241",
                        "source_entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
