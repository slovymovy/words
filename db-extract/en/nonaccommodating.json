                        "glosses": [
                            "Unaccommodating."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fae9ab5-7a8f-4089-845c-b56de1191fb1",
                                "sense_id": "6ac30dd3-1b45-3b17-ad05-bd3f4c3f9080",
                                "text": "The estimated effects of each proposal, assuming nonaccommodating monetary policy, are shown in Tables 10-18."
                            },
                            {
                                "example_id": "d442dbc5-145c-4b6b-81cd-89faec35c177",
                                "sense_id": "6ac30dd3-1b45-3b17-ad05-bd3f4c3f9080",
                                "text": "The logic is that sheltered unions will exploit their capacity to externalize the costs of militancy in a decentralized system unless they are deterred from doing so by a credible government commitment to a nonaccommodating policy rule."
                            },
                            {
                                "example_id": "3b5c879f-f149-481d-bd76-b252134eacec",
                                "sense_id": "6ac30dd3-1b45-3b17-ad05-bd3f4c3f9080",
                                "text": "Meg dwells on the unreasonableness of her nonaccommodating stance and does not acknowledge that she has successfully looked out for her best interests."
                            },
                            {
                                "example_id": "a17c6d2c-df73-4b6d-a65b-03973cddaa71",
                                "sense_id": "6ac30dd3-1b45-3b17-ad05-bd3f4c3f9080",
                                "text": "The federal funds rate will rise, which is consistent with the horizontalist argument: the central bank will most likely adopt a nonaccommodating policy only when it wants to affect the rate of interest."
                            },
                            {
                                "example_id": "854a34ec-3f03-4d82-ab40-e5440f5ca7d0",
                                "sense_id": "6ac30dd3-1b45-3b17-ad05-bd3f4c3f9080",
                                "text": "We rarely develop or maintain (voluntary) relationships with those who we feel are nonaccommodating, or those with whom we don't feel like we're on the same page."
                            }
                        ]
                    }
