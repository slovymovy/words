{
    "word_family": [
        "небытие",
        "небывалый",
        "небылица"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "0a55df6f-a389-33c9-84e0-875788c10d0c",
                    "sense_definition": "указывает на отсутствие или неимение чего-либо",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом магазине <w>нет</w> свежего хлеба.",
                            "target_lang_translations": {
                                "de": "In diesem Laden <w>gibt es kein</w> frisches Brot."
                            }
                        },
                        {
                            "text": "У меня сейчас <w>нет</w> свободного времени.",
                            "target_lang_translations": {
                                "de": "Ich habe gerade <w>keine</w> freie Zeit."
                            }
                        }
                    ],
                    "synonyms": [
                        "нету"
                    ],
                    "antonyms": [
                        "есть"
                    ],
                    "common_phrases": [
                        "нет времени",
                        "нет возможности"
                    ],
                    "target_lang_definitions": {
                        "de": "drückt das Fehlen oder Nichtvorhandensein von etwas aus"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "es gibt nicht",
                                "target_lang_sense_clarification": "allgemeiner Ausdruck für das Fehlen von Dingen oder Personen"
                            },
                            {
                                "target_lang_word": "nicht vorhanden",
                                "target_lang_sense_clarification": "beschreibt den Zustand, dass etwas nicht existiert oder nicht da ist"
                            },
                            {
                                "target_lang_word": "keine",
                                "target_lang_sense_clarification": "in der Verbindung kein + Substantiv: keine Zeit haben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ed60de4-ea6f-32c7-ae7c-325390da831c",
                    "sense_definition": "отрицательный ответ на вопрос или утверждение",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты пойдёшь сегодня в кино? — <w>Нет</w>, я занят.",
                            "target_lang_translations": {
                                "de": "Gehst du heute ins Kino? — <w>Nein</w>, ich bin beschäftigt."
                            }
                        },
                        {
                            "text": "Это твоя книга? — <w>Нет</w>, не моя.",
                            "target_lang_translations": {
                                "de": "Ist das dein Buch? — <w>Nein</w>, nicht meins."
                            }
                        }
                    ],
                    "synonyms": [
                        "не-а"
                    ],
                    "antonyms": [
                        "да"
                    ],
                    "target_lang_definitions": {
                        "de": "eine ablehnende Antwort auf eine Frage oder eine Aussage"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nein",
                                "target_lang_sense_clarification": "Standardpartikel zur Verneinung oder Ablehnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50373cbc-5d2f-3d32-aec0-7460b3f7538f",
                    "sense_definition": "выражение категорического несогласия или протеста",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Люди вышли на площадь с плакатами: <w>Нет</w> насилию!",
                            "target_lang_translations": {
                                "de": "Die Menschen gingen mit Plakaten auf den Platz: <w>Nein</w> zur Gewalt!"
                            }
                        },
                        {
                            "text": "Я сказал <w>нет</w> и не изменю своего решения.",
                            "target_lang_translations": {
                                "de": "Ich habe <w>nein</w> gesagt und werde meine Entscheidung nicht ändern."
                            }
                        }
                    ],
                    "antonyms": [
                        "да"
                    ],
                    "common_phrases": [
                        "нет войне"
                    ],
                    "target_lang_definitions": {
                        "de": "Ausdruck von kategorischer Ablehnung, Widerspruch oder Protest"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nein",
                                "target_lang_sense_clarification": "nachdrückliche Ablehnung oder Verweigerung"
                            },
                            {
                                "target_lang_word": "keineswegs",
                                "target_lang_sense_clarification": "starke, formelle Verneinung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb66e7be-c11e-3fba-8f51-1381a607da76",
                    "sense_definition": "разговорное название интернета",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я нашел эту интересную статью в <w>нете</w> вчера вечером.",
                            "target_lang_translations": {
                                "de": "Ich habe diesen interessanten Artikel gestern Abend im <w>Netz</w> gefunden."
                            }
                        },
                        {
                            "text": "В <w>нете</w> сейчас очень много полезной информации для учебы.",
                            "target_lang_translations": {
                                "de": "Im <w>Netz</w> gibt es derzeit sehr viele nützliche Informationen für das Studium."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "umgangssprachliche Bezeichnung für das Internet"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Internet",
                                "target_lang_sense_clarification": "Standardbegriff für das weltweite Netzwerk"
                            },
                            {
                                "target_lang_word": "Netz",
                                "target_lang_sense_clarification": "gebräuchliche Kurzform für das Internet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b567311-757b-316e-941e-6bd305496273",
                    "sense_definition": "состояние нехватки или отсутствия чего-либо",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старых документах часто встречалось слово <w>нет</w> для обозначения дефицита.",
                            "target_lang_translations": {
                                "de": "In alten Dokumenten wurde oft das Wort <w>Mangel</w> verwendet, um ein Defizit zu bezeichnen."
                            }
                        },
                        {
                            "text": "Из-за постоянного <w>нета</w> продуктов в магазине начались волнения.",
                            "target_lang_translations": {
                                "de": "Wegen des ständigen <w>Mangels</w> an Produkten begannen im Laden Unruhen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zustand des Mangels oder der Abwesenheit von etwas"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mangel",
                                "target_lang_sense_clarification": "Zustand, in dem etwas nicht in ausreichender Menge vorhanden ist"
                            },
                            {
                                "target_lang_word": "Abwesenheit",
                                "target_lang_sense_clarification": "das Nichtvorhandensein von etwas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}