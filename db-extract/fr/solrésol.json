                                        "glosses": [
                                            "A minor constructed language whose phonemes are based upon the solfège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609fb990-4822-4453-93b9-732543f029b4",
                                                "sense_id": "6a2cd0a0-b720-34f3-ad11-9be4be34f13e",
                                                "text": "Solresol reached a high-water mark in 1902, when Society head Boleslas Gajewski published a brief Grammaire du Solresol, which represented a refinement and expansion of the grammar rules set down in Sudre's 1866 guide."
                                            },
                                            {
                                                "example_id": "3552067f-2812-459f-847e-9910dd05acc0",
                                                "sense_id": "6a2cd0a0-b720-34f3-ad11-9be4be34f13e",
                                                "text": "Now his elderly widow, stringing telegraph wires around their Paris apartment and experimenting for five days solid, quickly developed a telegraphic version of Solresol in time to present it to the Minister of the Interior."
                                            }
                                        ]
                                    }
