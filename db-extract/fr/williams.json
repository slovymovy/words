                                "sense_id": "41338475-5a74-3192-a649-ee2a1e5eb1cf",
                                "text": "Proche de Kobe Bryant, tragiquement décédé en janvier 2020, Williams a de qui tenir."
                            },
                            {
                                "example_id": "40699bee-633e-46f7-8b58-ed2708d03caf",
                                "sense_id": "41338475-5a74-3192-a649-ee2a1e5eb1cf",
                                "text": "L’artiste Pharrell Williams, 49 ans, a été nommé, mardi, pour succéder à Virgil Abloh, décédé en novembre 2021, comme directeur artistique des collections homme de Louis Vuitton."
                            },
                            {
                                "example_id": "07a3141a-3b5d-4134-a0a0-0dd01945a663",
                                "sense_id": "41338475-5a74-3192-a649-ee2a1e5eb1cf",
                                "text": "Allison Williams et Riz Ahmed ont annoncé, mardi, les nommés aux Oscars 2023."
                            }
                        ]
                    }
