{
    "word_family": [
        "невозможный",
        "невозможность",
        "возможность",
        "возможно"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "37894793-14dd-3817-9955-1db93d76a632",
                    "sense_definition": "О ситуации, которая не может произойти, осуществиться или быть выполнена.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "impossibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В такую плохую погоду гулять в парке совершенно <w>невозможно</w>.",
                            "target_lang_translations": {
                                "en": "It is absolutely <w>impossible</w> to walk in the park in such bad weather.",
                                "zh": "在这么糟糕的天气里，去公园散步简直<w>不可能</w>。"
                            }
                        },
                        {
                            "text": "Выучить иностранный язык за один день просто <w>невозможно</w>.",
                            "target_lang_translations": {
                                "en": "It is simply <w>impossible</w> to learn a foreign language in one day.",
                                "zh": "一天之内学会一门外语简直是<w>不可能</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "исключено"
                    ],
                    "antonyms": [
                        "возможно",
                        "можно"
                    ],
                    "common_phrases": [
                        "совершенно невозможно",
                        "практически невозможно",
                        "просто невозможно",
                        "сделать невозможно"
                    ],
                    "target_lang_definitions": {
                        "en": "About a situation that cannot happen, be realized, or be performed.",
                        "zh": "指无法发生、实现或执行的情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible",
                                "target_lang_sense_clarification": "general meaning"
                            },
                            {
                                "target_lang_word": "it is impossible",
                                "target_lang_sense_clarification": "predicative phrase"
                            },
                            {
                                "target_lang_word": "there is no way",
                                "target_lang_sense_clarification": "colloquial"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可能",
                                "target_lang_sense_clarification": "表示无法实现"
                            },
                            {
                                "target_lang_word": "无法",
                                "target_lang_sense_clarification": "表示没有办法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b45d0c-0fee-32ad-b3fe-e9c3d2cb5b0b",
                    "sense_definition": "В высшей степени, чрезвычайно; используется для усиления значения прилагательного или наречия.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот новый фильм оказался <w>невозможно</w> скучным и затянутым.",
                            "target_lang_translations": {
                                "en": "This new movie turned out to be <w>impossibly</w> boring and dragged out.",
                                "zh": "这部新电影<w>极其</w>无聊且拖沓。"
                            }
                        },
                        {
                            "text": "Сегодня на улице <w>невозможно</w> холодно для этого времени года.",
                            "target_lang_translations": {
                                "en": "It is <w>impossibly</w> cold outside today for this time of year.",
                                "zh": "对于这个季节来说，今天外面<w>非常</w>冷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "невыносимо"
                    ],
                    "common_phrases": [
                        "невозможно красивый",
                        "невозможно трудно",
                        "невозможно скучно"
                    ],
                    "target_lang_definitions": {
                        "en": "To an extreme degree; used to intensify the meaning of an adjective or adverb.",
                        "zh": "达到极端程度；用于加强形容词或副词的语气。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossibly",
                                "target_lang_sense_clarification": "intensifier"
                            },
                            {
                                "target_lang_word": "incredibly",
                                "target_lang_sense_clarification": "synonym for emphasis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "程度副词"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "程度副词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36402386-8602-31a2-87e9-a4851222d70a",
                    "sense_definition": "О физическом или эмоциональном состоянии, которое очень трудно или нельзя терпеть.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "unbearable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате было так душно, что дышать стало <w>невозможно</w>.",
                            "target_lang_translations": {
                                "en": "It was so stuffy in the room that it became <w>impossible</w> to breathe.",
                                "zh": "房间里太闷了，让人<w>无法忍受</w>。"
                            }
                        },
                        {
                            "text": "У меня так сильно болела голова, что терпеть было <w>невозможно</w>.",
                            "target_lang_translations": {
                                "en": "My head hurt so much that it was <w>impossible</w> to endure.",
                                "zh": "我头疼得厉害，简直<w>受不了</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "невыносимо"
                    ],
                    "common_phrases": [
                        "терпеть невозможно",
                        "дышать невозможно",
                        "жить невозможно"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding a physical or emotional state that is very difficult or impossible to endure.",
                        "zh": "指难以忍受或无法承受的身体或情感状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible",
                                "target_lang_sense_clarification": "hard to endure or perform"
                            },
                            {
                                "target_lang_word": "unbearable",
                                "target_lang_sense_clarification": "state of suffering"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无法忍受",
                                "target_lang_sense_clarification": "表示难以承受"
                            },
                            {
                                "target_lang_word": "受不了",
                                "target_lang_sense_clarification": "口语表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d745a830-3cc5-31ea-80ef-23744086cd16",
                    "sense_definition": "Не разрешено, запрещено моральными нормами или правилами.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "forbidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вести себя так грубо в общественном месте совершенно <w>невозможно</w>.",
                            "target_lang_translations": {
                                "en": "It is absolutely <w>impossible</w> to behave so rudely in a public place.",
                                "zh": "在公共场合表现得如此粗鲁是完全<w>不可接受</w>的。"
                            }
                        },
                        {
                            "text": "Отрицать право каждого человека на свободу слова <w>невозможно</w>.",
                            "target_lang_translations": {
                                "en": "It is <w>impossible</w> to deny every person's right to freedom of speech.",
                                "zh": "否认每个人享有言论自由的权利是<w>不可接受</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "нельзя",
                        "недопустимо"
                    ],
                    "antonyms": [
                        "можно"
                    ],
                    "common_phrases": [
                        "вести себя невозможно"
                    ],
                    "target_lang_definitions": {
                        "en": "Not permitted; forbidden by moral standards or rules.",
                        "zh": "不被允许；受道德标准或规则禁止。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible",
                                "target_lang_sense_clarification": "socially unacceptable"
                            },
                            {
                                "target_lang_word": "unacceptable",
                                "target_lang_sense_clarification": "forbidden behavior"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可接受",
                                "target_lang_sense_clarification": "指行为不当"
                            },
                            {
                                "target_lang_word": "不应该",
                                "target_lang_sense_clarification": "指违背道德"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3dc46699-cc3c-313c-a92c-0d5ec4cc27d1",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>невозможный</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ваше поведение просто <w>невозможно</w> и возмутительно для всех нас.",
                            "target_lang_translations": {
                                "en": "Your behavior is simply <w>impossible</w> and outrageous to all of us.",
                                "zh": "你的行为对我们所有人来说简直是<w>不可能</w>接受且令人愤慨的。"
                            }
                        },
                        {
                            "text": "Это условие для нас <w>невозможно</w>, мы не можем на него согласиться.",
                            "target_lang_translations": {
                                "en": "This condition is <w>impossible</w> for us; we cannot agree to it.",
                                "zh": "这个条件对我们来说是<w>不可能</w>的，我们无法同意。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter singular form of the adjective 'impossible'.",
                        "zh": "形容词“不可能”的短尾中性单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible",
                                "target_lang_sense_clarification": "adjective"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可能的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}