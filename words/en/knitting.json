{
    "word_family": [
        "knit",
        "knitter",
        "knitwear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f26e534d-99ff-3269-830f-ded2c3b3ca49",
                    "sense_definition": "The activity or process of producing knitted material using yarn and needles.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "knitting_craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I find <w>knitting</w> very relaxing after a long day at work.",
                            "target_lang_translations": {
                                "ru": "Я нахожу <w>вязание</w> очень расслабляющим после долгого рабочего дня."
                            }
                        },
                        {
                            "text": "She joined a local <w>knitting</w> club to meet new people and learn new patterns.",
                            "target_lang_translations": {
                                "ru": "Она вступила в местный клуб <w>вязания</w>, чтобы познакомиться с новыми людьми и освоить новые узоры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knitting needles",
                        "knitting pattern",
                        "knitting club"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или занятие по созданию трикотажного полотна или изделий из пряжи с помощью спиц или крючка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязание",
                                "target_lang_sense_clarification": "процесс создания изделий из пряжи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                    "sense_definition": "Fabric or a garment that is being knitted or has been knitted.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "knitting_craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put down her <w>knitting</w> and went to answer the phone.",
                            "target_lang_translations": {
                                "ru": "Она отложила свое <w>вязание</w> и пошла ответить на телефонный звонок."
                            }
                        },
                        {
                            "text": "He packed his unfinished <w>knitting</w> into his bag before leaving.",
                            "target_lang_translations": {
                                "ru": "Перед уходом он сложил в сумку свое незаконченное <w>вязание</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unfinished knitting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трикотажное полотно или изделие, которое находится в процессе вязания или уже связано."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязание",
                                "target_lang_sense_clarification": "вещь, которую вяжут"
                            },
                            {
                                "target_lang_word": "трикотаж",
                                "target_lang_sense_clarification": "вязаное полотно или изделия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                    "sense_definition": "Overhead electrification wires used to power trains.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train was delayed because a fallen tree damaged the overhead <w>knitting</w>.",
                            "target_lang_translations": {
                                "ru": "Поезд задержался, потому что упавшее дерево повредило воздушную <w>контактную сеть</w>."
                            }
                        },
                        {
                            "text": "They decided to tear down the <w>knitting</w> and use diesel locomotives instead.",
                            "target_lang_translations": {
                                "ru": "Они решили демонтировать <w>контактную сеть</w> и использовать вместо этого тепловозы."
                            }
                        }
                    ],
                    "synonyms": [
                        "catenary"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Railway slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвесные провода электрической сети (контактная сеть), используемые для питания поездов (железнодорожный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паутина",
                                "target_lang_sense_clarification": "контактная сеть, провода (железнодорожный сленг)"
                            },
                            {
                                "target_lang_word": "контактная сеть",
                                "target_lang_sense_clarification": "провода над путями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b90422c6-80fe-3c33-87de-164452ba3ff3",
                    "sense_definition": "Present participle and gerund of <w>knit</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>knitting</w> a warm woollen scarf for her grandfather.",
                            "target_lang_translations": {
                                "ru": "Она <w>вязала</w> теплый шерстяной шарф для своего дедушки."
                            }
                        },
                        {
                            "text": "I enjoy <w>knitting</w> sweaters during the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>вязать</w> свитера в холодные зимние месяцы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола knit (вязать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязание",
                                "target_lang_sense_clarification": "процесс вязания"
                            },
                            {
                                "target_lang_word": "вяжущий",
                                "target_lang_sense_clarification": "причастие от глагола вязать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}