                        "entry_id": "1bcf7929-433b-3335-895d-eafde2254c38",
                        "glosses": [
                            "Verweis vom Platz oder Spielfeld als Strafe für das Nichteinhalten der Spielregeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17ebce8a-c221-4831-884f-4ea5fab17c95",
                                "sense_id": "73509918-434c-367c-bf3a-3008d9467f18",
                                "text": "Nach zwei gelben Karten erhielt der Spieler einen Platzverweis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c8f1c20-1b11-32d7-8878-3974020fc970",
                        "entry_id": "1bcf7929-433b-3335-895d-eafde2254c38",
                        "glosses": [
                            "Standardmaßnahme, durch die einer Person vorübergehend der Aufenthalt an einem Ort oder das Betreten eines Ortes verboten wird"
                        ],
                        "tags": [
                            "Polizeirecht"
                        ],
                        "examples": [
                            {
                                "example_id": "b1537b2d-7943-48d6-87c9-506c8c1a4bc9",
                                "sense_id": "7c8f1c20-1b11-32d7-8878-3974020fc970",
                                "text": "Da die Männer nachts auf dem Marktplatz Alkohol konsumierten, obwohl dort ein Alkoholverbot besteht, erteilten die Polizisten ihnen einen Platzverweis."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
