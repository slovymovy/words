                "senses": [
                    {
                        "sense_id": "d57e352a-110b-35ba-96ea-d741635eb10c",
                        "entry_id": "999b630c-e344-37f9-bb7f-b8ad28328dcf",
                        "glosses": [
                            "Versuch, jemandem mehr Freude, Mut zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbcb7338-e67f-47dd-91fb-ca039239edfa",
                                "sense_id": "d57e352a-110b-35ba-96ea-d741635eb10c",
                                "text": "„Es sei ihm um Ermunterung der Soldaten gegangen, darum, ihr Selbstbewusstsein zu stärken.“"
                            },
                            {
                                "example_id": "361b1488-5c18-4e4c-afae-43e81611fadc",
                                "sense_id": "d57e352a-110b-35ba-96ea-d741635eb10c",
                                "text": "„Ermunterungen aus der Partei und der Bevölkerung hätten eine wesentliche Rolle für seine Kandidatur gespielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "476ef441-6a97-4df0-855a-23c38b90cf02",
                        "source_entry_id": "999b630c-e344-37f9-bb7f-b8ad28328dcf",
                        "source_sense_id": "d57e352a-110b-35ba-96ea-d741635eb10c",
                        "source_sense_description": "Versuch, jemandem mehr Freude, Mut zu geben",
                        "target_lang_word": "encouragement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encouragement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "349feb71-b0fb-3e7c-b623-387b37d5ac64",
                                        "entry_id": "c80fce61-f509-34fe-b839-1823c7109fa1",
                                        "glosses": [
                                            "Ce qui encourage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd2367e-7e1c-4409-a4df-21dd48279300",
                                                "sense_id": "349feb71-b0fb-3e7c-b623-387b37d5ac64",
                                                "text": "Toutefois comme il ne voulait pas abandonner dans les eaux de la tribulation le jeune paroissien de son confrère, il lui donna quelques salutaires encouragements."
                                            },
                                            {
                                                "example_id": "1a6eab1c-4510-4873-a554-2501de02d131",
                                                "sense_id": "349feb71-b0fb-3e7c-b623-387b37d5ac64",
                                                "text": "Les cris des coqs, les sabots des ânes poussés par l’encouragement sonore et monotone des paysans, réveillèrent Elhamy le lendemain."
                                            },
                                            {
                                                "example_id": "f85cc141-dcbe-46ff-a179-aaa0ec4d1102",
                                                "sense_id": "349feb71-b0fb-3e7c-b623-387b37d5ac64",
                                                "text": "Les Hommen interrogés à découvert, de fait, citent tous l’encouragement discret de prêtres « tradis » de Versailles à l’égard de leurs actions."
                                            },
                                            {
                                                "example_id": "a0d79857-db03-4eb6-a3eb-a81e860a500f",
                                                "sense_id": "349feb71-b0fb-3e7c-b623-387b37d5ac64",
                                                "text": "merci pour le encourgement"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
