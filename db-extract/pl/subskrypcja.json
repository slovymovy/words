                    {
                        "translation_id": "1763ab52-80bf-4615-9ccf-6072031fc186",
                        "source_entry_id": "34a8ff8a-8664-34ae-bdca-c55d7e317276",
                        "source_sense_id": "f380ffec-ece6-308c-a968-fa30e35c339a",
