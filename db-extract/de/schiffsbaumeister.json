                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe95cee-778b-4226-a7c9-4bbed16b7aab",
                                "sense_id": "f4b1f3f2-223b-3254-98bd-2c8a6a2f46e9",
                                "text": "„Im Juni, nach seiner vollständigen Fertigstellung, soll das Schiff für kurze Zeit zu Wasser gelassen werden, um mit ihm Testfahrten und Experimente durchzuführen, so Schiffsbaumeister Kees Sars.“"
                            },
