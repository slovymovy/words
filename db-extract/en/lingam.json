                                        "entry_id": "46241a90-2619-3f38-af7d-1d78b627bcec",
                                        "glosses": [
                                            "Symbol des Phallus als Sinnbild Schiwas"
                                        ],
                                        "tags": [
                                            "speziell Hinduismus"
