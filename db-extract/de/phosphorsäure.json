                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5eb8a4fd-688b-4ad4-835b-7d327b0f7c89",
                        "source_entry_id": "36d7be47-27ee-3cf2-bb8b-accce7fadece",
                        "source_sense_id": "4d08bf53-10ba-379e-9a92-d2f5a3adb782",
                        "source_sense_description": "Chemie: schwache, anorganische Säure",
                        "target_lang_word": "acide phosphorique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide phosphorique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "560f010b-a586-3c35-add1-0d47dd25e20b",
                                        "entry_id": "c776da44-77b0-316c-938b-a9eff18c4195",
                                        "glosses": [
                                            "Oxacide, à base de phosphore, de formule H₃PO₄."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3752c62d-4157-403e-8a3d-26c9aa204da5",
                                                "sense_id": "560f010b-a586-3c35-add1-0d47dd25e20b",
                                                "text": "L’échantillon dont on a soumis une partie à l’analyse, contenant du phosphate de plomb, il est très-probable que l’acide phosphorique que l'on a trouvé représente une certaine quantité de phosphate mélangé au plomb-gomme."
                                            },
                                            {
                                                "example_id": "38779005-1192-419d-94de-29a3b1767251",
                                                "sense_id": "560f010b-a586-3c35-add1-0d47dd25e20b",
                                                "text": "Il est impossible, dans cette expérience, qu'en présence du phosphure d'hydrogène solide et sans production d'acide hypophosphoreux, il se forme de l’acide phosphorique; […]."
                                            },
                                            {
                                                "example_id": "ba0a2305-b7fe-44b1-a2af-680eb1f562cc",
                                                "sense_id": "560f010b-a586-3c35-add1-0d47dd25e20b",
                                                "text": "Ce dernier conservera toujours sa valeur pour la culture intensive ; les scories Thomas, grâce au bon marché de leur acide phosphorique, doivent servir seulement à l'amélioration des grandes étendues des sols de minime valeur."
                                            },
                                            {
                                                "example_id": "d93e4465-0785-43e1-ac7b-94fac30e5036",
                                                "sense_id": "560f010b-a586-3c35-add1-0d47dd25e20b",
                                                "text": "L’ajonc n’est pas inférieur aux autres engrais verts cultivés, au point de vue de l’acide phosphorique et de la potasse, et il leur est supérieur en ce qui concerne l’azote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
