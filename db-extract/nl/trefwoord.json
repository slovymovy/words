                ],
                "translations": [
                    {
                        "translation_id": "0a9be232-60d4-4a8e-a9e1-b5e3aa2b3c24",
                        "source_entry_id": "98376e7b-80eb-39d5-a7dc-eac5e564fe42",
                        "source_sense_id": "db846df7-5a05-3f6a-98e0-405cf7f27871",
                        "source_sense_description": "een titelwoord van een stuk tekst in een catalogus, woordenboek of encyclopedie",
                        "target_lang_word": "Stichwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stichwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36d60d39-5818-38f8-ad20-95bd3bfba159",
                                        "entry_id": "5203e7a1-c6ce-3d11-ba8a-29c5e5ccc8f1",
                                        "glosses": [
                                            "Wort, das man in einem Wörterbuch alphabetisch oder nach anderen Kriterien geordnet auffinden kann und erläutert ist oder einen Textverweis enthält"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700a21e9-fd1d-493f-93ae-26c45375b2c9",
                                                "sense_id": "36d60d39-5818-38f8-ad20-95bd3bfba159",
                                                "text": "Ein großes Wörterbuch des Deutschen muss mindestens 200000 Stichwörter haben."
                                            },
                                            {
                                                "example_id": "9115aa36-c0ba-4a87-912b-7fa5d9f66dea",
                                                "sense_id": "36d60d39-5818-38f8-ad20-95bd3bfba159",
                                                "text": "„Merklich voneinander verschiedene Wörter, die nicht ohne weiteres als zusammengehörig erkannt werden können, sind getrennte Stichwörter in getrennten Artikeln…“"
                                            },
                                            {
                                                "example_id": "f5cfe43c-cd58-44a7-ae9e-bf6e4188a734",
                                                "sense_id": "36d60d39-5818-38f8-ad20-95bd3bfba159",
                                                "text": "„Für die Lexikografen entsteht aus der systematischen Unendlichkeit des Wortschatzes das Problem, diejenigen Stichwörter (Lemmata) auszuwählen, deren Behandlung sinnvoll und für das spezielle Wörterbuch, das man plant, gewünscht ist.“"
                                            },
                                            {
                                                "example_id": "96c430bf-400f-4be4-b4e7-e314af3b53f5",
                                                "sense_id": "36d60d39-5818-38f8-ad20-95bd3bfba159",
                                                "text": "„Die Reihenfolge der Stichwörter ist abclich und hält sich an die in den Dudenbänden übliche Alphabetisierungsweise.“"
                                            },
                                            {
                                                "example_id": "6146fd31-b64a-427d-a552-932e8444cb81",
                                                "sense_id": "36d60d39-5818-38f8-ad20-95bd3bfba159",
                                                "text": "„Fachsimpelei, um das Stichwort des letzten Abschnitts aufzugreifen, wird es immer geben, solange es eben auch »Fachleute« gibt – und man hat auch immer schon gefachsimpelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdfd6c55-89bc-3b39-abc3-167cef3a981a",
                                        "entry_id": "5203e7a1-c6ce-3d11-ba8a-29c5e5ccc8f1",
                                        "glosses": [
                                            "Gedächtnishilfe"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7495e85a-8dcb-4f5b-8601-9b6cf5b39df4",
                                                "sense_id": "bdfd6c55-89bc-3b39-abc3-167cef3a981a",
                                                "text": "Es fällt mir gerade nicht ein; kannst du mir mal ein Stichwort geben?"
                                            },
                                            {
                                                "example_id": "73e27720-78b5-4912-b503-3c0b2c618a8f",
                                                "sense_id": "bdfd6c55-89bc-3b39-abc3-167cef3a981a",
                                                "text": "„Wie auf das Stichwort erklangen jetzt alle Glocken.“"
                                            },
                                            {
                                                "example_id": "29a1c50b-e9fb-4fe1-8b5d-58cf94ab2d87",
                                                "sense_id": "bdfd6c55-89bc-3b39-abc3-167cef3a981a",
                                                "text": "„Prüfend ergriff er den Füllhalter und schrieb einige Notizen auf, um sich in Stichworten des Gewesenen zu versichern.“"
                                            },
                                            {
                                                "example_id": "658a9178-b05c-4174-8889-d6b178a323d2",
                                                "sense_id": "bdfd6c55-89bc-3b39-abc3-167cef3a981a",
                                                "text": "„Alle paar Stunden protokolliere ich, wo genau ich mich gerade aufhalte, oder ich notiere Stichworte zu meinen Lektüren, oder ich halte einfach nur fest, was ich als Nächstes vorhabe oder woran ich denke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b65263f1-7181-31de-a1ee-f7e7e9b0bb4b",
                                        "entry_id": "5203e7a1-c6ce-3d11-ba8a-29c5e5ccc8f1",
                                        "glosses": [
                                            "Hinweis für jemanden darauf, dass der Zeitpunkt für eine bestimmte Aktion gekommen ist"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6504a8ef-37ef-4a1f-a28e-be6803eab643",
                                                "sense_id": "b65263f1-7181-31de-a1ee-f7e7e9b0bb4b",
                                                "text": "„Die richtigen Stellen können am Ende einer Rede sein, oder aber bei einzelnen Stichworten.“"
                                            },
                                            {
                                                "example_id": "4c18f551-b81e-4f47-a6e5-b6e6286c5f33",
                                                "sense_id": "b65263f1-7181-31de-a1ee-f7e7e9b0bb4b",
                                                "text": "„Das muß ein Stichwort gewesen sein, alle sehen sich plötzlich an, nur Dr. Hüppchen tanzt weiter.“"
                                            },
                                            {
                                                "example_id": "1bdb47c3-b1d4-436f-b33a-8afb47fe256a",
                                                "sense_id": "b65263f1-7181-31de-a1ee-f7e7e9b0bb4b",
                                                "text": "Obwohl das Stichwort gefallen war, verpatzte er seinen Auftritt."
                                            },
                                            {
                                                "example_id": "1a555b56-91f1-4a36-a87a-25ef906cbb56",
                                                "sense_id": "b65263f1-7181-31de-a1ee-f7e7e9b0bb4b",
                                                "text": "„Das Stichwort ist gefallen, Zlatko erhebt sich von seinem Sitzhocker und dreht an den Reglern.“"
                                            },
                                            {
                                                "example_id": "10f450c9-61a4-4a80-92a7-6f3c4fcbd234",
                                                "sense_id": "b65263f1-7181-31de-a1ee-f7e7e9b0bb4b",
                                                "text": "„Das war das Stichwort für Sandys witzigen Marinekameraden Arnie Goldlieb, er den »wie hypnotisierten« Philip mit seinen fantasievollen Derbheiten begeisterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4d6e448a-6849-3808-92e1-ea0834ac17b5",
                                        "entry_id": "5203e7a1-c6ce-3d11-ba8a-29c5e5ccc8f1",
                                        "glosses": [
                                            "kompakte, einprägsame Form einer Aussage"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3627f74-9804-496f-a19a-674feafcda2b",
                                                "sense_id": "4d6e448a-6849-3808-92e1-ea0834ac17b5",
                                                "text": "„Das Wort constitutionell ist eines der Stichwörter, die in neuester Zeit das Vorrecht haben, an die Stelle jeden Grundes sich einzustellen.“ Bismark (Reden 1, 121 Kohl)"
                                            },
                                            {
                                                "example_id": "83593ff6-f836-44bc-b847-c19b1f6a924d",
                                                "sense_id": "4d6e448a-6849-3808-92e1-ea0834ac17b5",
                                                "text": "„Er beschloß, als Vorarbeit für die Chronik, die zu führen er als eine der ihm von der Präfektur gestellten Aufgaben betrachtete, seine ersten Eindrücke von der Stadt in Stichworten aufzuzeichnen und auch die Zeremonie des Mittagessens genau zu beschreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "43b31283-5294-3d9b-9594-6e0a998d8856",
                                        "entry_id": "5203e7a1-c6ce-3d11-ba8a-29c5e5ccc8f1",
                                        "glosses": [
                                            "spöttische Bemerkung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "439ce362-2038-4bce-9b8c-e90dc091f0a2",
                                                "sense_id": "43b31283-5294-3d9b-9594-6e0a998d8856",
                                                "text": "„antwort auff dein morderische, heimliche, vergiffte stichwort unnd lesterung.“ (Luther 6, 140 W.)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
