{
    "word_family": [
        "mellowness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "12cf0e20-55a6-37b0-b5be-0cc45039b13d",
                    "sense_definition": "Soft or tender due to being fully ripe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer picked the <w>mellow</w> peach from the tree.",
                            "target_lang_translations": {
                                "zh": "农夫从树上摘下了那颗<w>熟透的</w>桃子。"
                            }
                        },
                        {
                            "text": "These pears are <w>mellow</w> enough to eat right now.",
                            "target_lang_translations": {
                                "zh": "这些梨子已经<w>熟透了</w>，现在就可以吃。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ripe",
                        "tender"
                    ],
                    "antonyms": [
                        "unripe",
                        "hard"
                    ],
                    "common_phrases": [
                        "mellow fruit"
                    ],
                    "target_lang_definitions": {
                        "zh": "指果实因完全成熟而变得柔软或鲜嫩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "熟透的",
                                "target_lang_sense_clarification": "形容果实完全成熟，质地变软。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9d734d-3d82-3cd4-a27b-ba7f7038f7d0",
                    "sense_definition": "Pleasantly smooth, soft, or delicate in sound, color, or light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with a <w>mellow</w> golden light at sunset.",
                            "target_lang_translations": {
                                "zh": "日落时分，房间里充满了<w>柔和的</w>金光。"
                            }
                        },
                        {
                            "text": "She enjoyed the <w>mellow</w> sound of the jazz saxophone.",
                            "target_lang_translations": {
                                "zh": "她很享受爵士萨克斯那<w>醇厚的</w>声音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soft",
                        "subdued",
                        "rich"
                    ],
                    "antonyms": [
                        "harsh",
                        "sharp"
                    ],
                    "common_phrases": [
                        "mellow light",
                        "mellow sound"
                    ],
                    "target_lang_definitions": {
                        "zh": "指声音、颜色或光线柔和、悦耳或不刺眼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柔和的",
                                "target_lang_sense_clarification": "形容光线或声音温和，不强烈。"
                            },
                            {
                                "target_lang_word": "醇厚的",
                                "target_lang_sense_clarification": "形容声音圆润、饱满。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e36bb982-f404-3e41-a738-ae5a6de2cbf7",
                    "sense_definition": "Calm, gentle, and wise due to age or experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became much more <w>mellow</w> as he grew older.",
                            "target_lang_translations": {
                                "zh": "随着年龄增长，他变得<w>沉稳</w>多了。"
                            }
                        },
                        {
                            "text": "Her <w>mellow</w> personality makes her a great mentor.",
                            "target_lang_translations": {
                                "zh": "她那<w>温和的</w>性格使她成为了一位出色的导师。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "gentle",
                        "mature"
                    ],
                    "antonyms": [
                        "impetuous",
                        "harsh"
                    ],
                    "common_phrases": [
                        "mellow age"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因年龄或阅历增长而变得沉稳、温和且睿智。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉稳的",
                                "target_lang_sense_clarification": "形容性格成熟、稳重。"
                            },
                            {
                                "target_lang_word": "温和的",
                                "target_lang_sense_clarification": "形容性格平和，不急躁。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a869ea8-4087-3e58-899b-58034b8bf76d",
                    "sense_definition": "Relaxed, easygoing, and cheerful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>mellow</w> afternoon just sitting in the park.",
                            "target_lang_translations": {
                                "zh": "我们坐在公园里，度过了一个<w>放松的</w>下午。"
                            }
                        },
                        {
                            "text": "He is a very <w>mellow</w> guy who never gets angry.",
                            "target_lang_translations": {
                                "zh": "他是个非常<w>随和</w>的人，从不发火。"
                            }
                        }
                    ],
                    "synonyms": [
                        "relaxed",
                        "easygoing",
                        "laid-back"
                    ],
                    "antonyms": [
                        "tense",
                        "stressed"
                    ],
                    "common_phrases": [
                        "mellow mood"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人性格放松、随和且开朗。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "随和的",
                                "target_lang_sense_clarification": "形容人容易相处，不拘小节。"
                            },
                            {
                                "target_lang_word": "放松的",
                                "target_lang_sense_clarification": "形容状态轻松自在。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d248a1d-75b7-3c8d-bf08-eff6f88382a2",
                    "sense_definition": "To make fruit soft or tender by ripening.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm sun helps to <w>mellow</w> the fruit on the vine.",
                            "target_lang_translations": {
                                "zh": "温暖的阳光有助于让藤上的果实<w>催熟</w>。"
                            }
                        },
                        {
                            "text": "Leave the avocados on the counter to <w>mellow</w>.",
                            "target_lang_translations": {
                                "zh": "把牛油果放在台面上让它<w>熟透</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ripen"
                    ],
                    "target_lang_definitions": {
                        "zh": "使果实成熟变软。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "催熟",
                                "target_lang_sense_clarification": "指通过某种方式使果实变熟。"
                            },
                            {
                                "target_lang_word": "变熟",
                                "target_lang_sense_clarification": "不及物：果实自行变软变熟"
                            },
                            {
                                "target_lang_word": "熟透",
                                "target_lang_sense_clarification": "不及物：放到完全成熟变软"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6be64e47-6af0-3059-94c0-acfdd3ddf05f",
                    "sense_definition": "To reduce harshness or make something softer and more pleasant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Time has <w>mellowed</w> his sharp criticism of the project.",
                            "target_lang_translations": {
                                "zh": "时间已经<w>缓和</w>了他对该项目尖锐的批评。"
                            }
                        },
                        {
                            "text": "The sauce needs to simmer to <w>mellow</w> the strong flavors.",
                            "target_lang_translations": {
                                "zh": "酱汁需要慢炖以<w>柔化</w>浓烈的味道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soften",
                        "subdue"
                    ],
                    "antonyms": [
                        "intensify"
                    ],
                    "target_lang_definitions": {
                        "zh": "使事物变得柔和、缓和，减少尖锐感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缓和",
                                "target_lang_sense_clarification": "指减轻某种强烈或尖锐的程度。"
                            },
                            {
                                "target_lang_word": "柔化",
                                "target_lang_sense_clarification": "指使事物变得不那么强烈。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15735c82-f56b-3f48-8880-e467b03edf24",
                    "sense_definition": "To become calmer and more understanding through experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of teaching have <w>mellowed</w> her approach to students.",
                            "target_lang_translations": {
                                "zh": "多年的教学生涯使她对待学生的态度<w>变得温和</w>了。"
                            }
                        },
                        {
                            "text": "He has <w>mellowed</w> significantly since he became a father.",
                            "target_lang_translations": {
                                "zh": "自从当了父亲，他明显<w>变得温和</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soften"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人通过经验积累变得更加平和、通情达理。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变得温和",
                                "target_lang_sense_clarification": "指性格或态度变得不再尖锐。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}