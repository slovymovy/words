    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                    "sense_definition": "In a manner designed to avoid harm, damage, or errors.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please drive <w>carefully</w> because the roads are very icy tonight.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, веди машину <w>осторожно</w>, потому что сегодня вечером дороги очень скользкие.",
                                "zh": "今晚路面结冰，请<w>小心</w>驾驶。"
                            }
                        },
                        {
                            "text": "He held the fragile glass vase <w>carefully</w> to make sure he did not drop it.",
                            "target_lang_translations": {
                                "ru": "Он <w>осторожно</w> держал хрупкую стеклянную вазу, чтобы не уронить её.",
                                "zh": "他<w>小心</w>地捧着易碎的玻璃花瓶，生怕把它摔了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cautiously",
                        "warily",
                        "safely",
                        "gently"
                    ],
                    "antonyms": [
                        "carelessly",
                        "recklessly"
                    ],
                    "common_phrases": [
                        "drive carefully",
                        "tread carefully",
                        "handle carefully"
                    ],
                    "target_lang_definitions": {
                        "ru": "С осторожностью, стараясь избежать вреда, ущерба или ошибок.",
                        "zh": "以避免伤害、损坏或错误的方式进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осторо́жно",
                                "target_lang_sense_clarification": "избегая опасности или неприятностей"
                            },
                            {
                                "target_lang_word": "аккура́тно",
                                "target_lang_sense_clarification": "бережно обращаясь с предметами"
                            },
                            {
                                "target_lang_word": "бе́режно",
                                "target_lang_sense_clarification": "с заботой о сохранности чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小心",
                                "target_lang_sense_clarification": "注意避免危险或损坏"
                            },
                            {
                                "target_lang_word": "谨慎",
                                "target_lang_sense_clarification": "做事慎重，避免出错"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                    "sense_definition": "With close attention to details and precision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thoroughness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should read the instructions <w>carefully</w> before you start building the model.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>внимательно</w> прочитать инструкцию, прежде чем начинать собирать модель.",
                                "zh": "在开始制作模型之前，你应该<w>仔细</w>阅读说明书。"
                            }
                        },
                        {
                            "text": "The detective <w>carefully</w> examined the room for any hidden clues.",
                            "target_lang_translations": {
                                "ru": "Детектив <w>тщательно</w> осмотрел комнату в поисках скрытых улик.",
                                "zh": "侦探<w>仔细</w>搜查了房间，寻找任何隐藏的线索。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thoroughly",
                        "meticulously",
                        "attentively",
                        "painstakingly",
                        "closely"
                    ],
                    "antonyms": [
                        "hastily",
                        "negligently"
                    ],
                    "common_phrases": [
                        "listen carefully",
                        "read carefully",
                        "think carefully",
                        "examine carefully"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосредоточенно, уделяя пристальное внимание деталям.",
                        "zh": "专注细节，精确地进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внима́тельно",
                                "target_lang_sense_clarification": "сосредоточенно (слушать, читать, смотреть)"
                            },
                            {
                                "target_lang_word": "тща́тельно",
                                "target_lang_sense_clarification": "детально, скрупулезно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仔细",
                                "target_lang_sense_clarification": "周密、细致地对待某事"
                            },
                            {
                                "target_lang_word": "认真",
                                "target_lang_sense_clarification": "态度严肃，不马虎"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                    "sense_definition": "In a sorrowful, anxious, or troubled manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary traveler sighed <w>carefully</w> as he thought of the long journey ahead.",
                            "target_lang_translations": {
                                "ru": "Усталый путник <w>горестно</w> вздохнул, думая о предстоящем долгом пути.",
                                "zh": "疲惫的旅人想到前方漫长的旅程，<w>忧虑地</w>叹了口气。"
                            }
                        },
                        {
                            "text": "She looked <w>carefully</w> at the ruins of her old home, remembering better days.",
                            "target_lang_translations": {
                                "ru": "Она <w>с тоской</w> смотрела на руины своего старого дома, вспоминая лучшие дни.",
                                "zh": "她<w>忧虑地</w>看着旧居的废墟，回忆起往昔的美好时光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sorrowfully",
                        "sadly",
                        "anxiously"
                    ],
                    "antonyms": [
                        "joyfully",
                        "happily"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "С тревогой, печалью или беспокойством (устаревшее значение).",
                        "zh": "以忧伤、焦虑或不安的方式（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горестно",
                                "target_lang_sense_clarification": "устар.: с тревогой, печалью, беспокойством"
                            },
                            {
                                "target_lang_word": "тревожно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忧虑地",
                                "target_lang_sense_clarification": "带有忧愁或焦虑的情绪"
                            }
                        ]
                    }
                }
            ]
        }
