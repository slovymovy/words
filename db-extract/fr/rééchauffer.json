                "senses": [
                    {
                        "sense_id": "498e984c-67ff-3977-9d82-bcfce1e6ac95",
                        "entry_id": "4d497571-131d-3b4e-8fa0-790c273608a5",
                        "glosses": [
                            "Échauffer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9702fa11-f1e7-461d-a836-5d3ed45172f0",
                                "sense_id": "498e984c-67ff-3977-9d82-bcfce1e6ac95",
                                "text": "Tout ça parce qu'elle est trop imbue de sa personne pour accepter de prendre à nouveau des cours de chant afin de rééchauffer et retravailler sa voix."
                            },
                            {
                                "example_id": "7ab97350-f062-4fd2-893a-8e987973f98c",
                                "sense_id": "498e984c-67ff-3977-9d82-bcfce1e6ac95",
                                "text": "On ne se déséchauffe pas avant de jouer, c'est le comble de l'absurdité la plus absurde; Bois beaucoup d'eau, échauffe-toi bien et ne fais pas des pauses de 15 minutes toutes les heures -à moins que tu ne veuilles avoir à te rééchauffer-, 5 à la limite."
                            }
                        ]
                    }
