        "fr-extract.jsonl": [
            {
                "entry_id": "c4dc0948-6e67-306e-8963-1fc27e381932",
                "word": "enveloppement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "484617d0-b980-430b-b3ec-f45bd0c2d2d9",
                        "entry_id": "c4dc0948-6e67-306e-8963-1fc27e381932",
                        "tags": [
                            "plural"
                        ],
                        "form": "enveloppements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35bfb647-625f-3481-9b4c-bd6a515e901a",
                        "entry_id": "c4dc0948-6e67-306e-8963-1fc27e381932",
                        "glosses": [
                            "Action d’envelopper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f02e256-413a-44df-9c29-ac61faefcc50",
                                "sense_id": "35bfb647-625f-3481-9b4c-bd6a515e901a",
                                "text": "De toute part, l’enveloppement se resserrait, il croyait sentir les petites mains voleuses qui se glissaient au fond de ses poches, il n’avait plus de tranquillité, même les portes closes, craignant qu’on ne le dévalisât par les fentes."
                            },
                            {
                                "example_id": "11863f61-9340-43d4-9c55-c626c56859e0",
                                "sense_id": "35bfb647-625f-3481-9b4c-bd6a515e901a",
                                "text": "…, et, malgré tout, les Italiens du Gers semblent ne pas être inaccessibles aux enveloppements qui devront conduire à leur assimilation."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d107bdf-e2e6-3a45-988c-87ac11ba5f3c",
                        "entry_id": "c4dc0948-6e67-306e-8963-1fc27e381932",
                        "glosses": [
                            "Linges, compresses appliqués sur le corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d1923a-f4e7-47a8-83f9-d81c77b09ebc",
                                "sense_id": "3d107bdf-e2e6-3a45-988c-87ac11ba5f3c",
                                "text": "Faire des enveloppements d’ouate, des enveloppements froids, des enveloppements sinapisés."
                            },
                            {
                                "example_id": "aa5ed8e2-d73c-449b-b087-f68fb65a4623",
                                "sense_id": "3d107bdf-e2e6-3a45-988c-87ac11ba5f3c",
                                "text": "On fait des enveloppements d’heure en heure."
                            },
                            {
                                "example_id": "ef7df253-9a9e-465d-8ece-1eef09019976",
                                "sense_id": "3d107bdf-e2e6-3a45-988c-87ac11ba5f3c",
                                "text": "Elle me pelotait en me posant mes enveloppements pour ma bronchite…"
                            },
                            {
                                "example_id": "c0f123e4-cbc4-4dfb-a647-e1e80cab11bc",
                                "sense_id": "3d107bdf-e2e6-3a45-988c-87ac11ba5f3c",
                                "text": "Il étouffait. Des chaleurs subites l’assaillaient de toute part. Chaque soir, ma mère entourait sa poitrine d’un grand drap qu’elle avait rafraîchi en l’enfermant, plié, dans le réfrigérateur. Elle appelait ça « faire des enveloppements »."
                            },
                            {
                                "example_id": "8ea7773c-a972-46f9-9720-474209de6a70",
                                "sense_id": "3d107bdf-e2e6-3a45-988c-87ac11ba5f3c",
                                "text": "Près de la photographie un bouquet de violettes artificielles dans un joli vase funéraire semble chargé de subvenir aux menus besoins du mort. Ce bouquet a pleins pouvoirs et s’occupe jour et nuit à un sourd travail d’enveloppement, d’apaisements, d’anesthésie."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc29073c-1a55-352d-aa9d-60d88a1bd584",
                        "entry_id": "c4dc0948-6e67-306e-8963-1fc27e381932",
                        "glosses": [
                            "Action qui consiste à s'emparer de la lame de l'adversaire par un mouvement enveloppant de la lame."
                        ],
                        "tags": [],
                        "examples": []
                    }
