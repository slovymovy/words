                        ],
                        "examples": [
                            {
                                "example_id": "5775011e-7483-4f56-9e2e-7a4be6d051f1",
                                "sense_id": "65780ed8-376a-3c4b-a32d-f1e810951a95",
                                "text": "Zwavelzuur werd geproduceerd door verhitting van de kristallen van groene vitriool (gehydrateerd ijzersulfaat), bekomen door behandeling van het ijzersulfide afkomstig van de destillatie van het pyriet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2414a98d-c86b-3ec8-9b38-2e32817e93d5",
                        "entry_id": "661cf20e-6e5e-3672-ba0c-8cfa2802746c",
                        "glosses": [
                            "zeer bijtende zure oplossing van diwaterstofsulfaat (H₂SO₄)"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0995a1ff-8670-4a6e-8548-0092433e0a6d",
                                "sense_id": "2414a98d-c86b-3ec8-9b38-2e32817e93d5",
                                "text": "Dit interesseert me wel: man begoot zijn vrouw met vitriool omdat hij dacht dat ze hem bedroog..."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e1f2637-5bf4-313f-8898-4e3a89ea308f",
                        "entry_id": "661cf20e-6e5e-3672-ba0c-8cfa2802746c",
                        "glosses": [
                            "getoonde bijtende aggressie"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0faa68ec-4fd4-4d70-ac1e-a44ec173b571",
                                "sense_id": "3e1f2637-5bf4-313f-8898-4e3a89ea308f",
                                "text": "In Bezette Stad rekende de dichter nog met veel vitriool af met het burgerdom, maar tijdens zijn laatste jaren nam hij ook hier een afstandelijker houding aan."
                            }
                        ]
                    }
