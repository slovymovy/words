{
    "word_family": [
        "messy",
        "messily",
        "messiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17e8d5f0-3f45-31e0-8c97-6a1dad5ee071",
                    "sense_definition": "A state of being dirty, untidy, or confused; a chaotic or difficult situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disorder_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please clean up the <w>mess</w> in your bedroom before you go out with your friends.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери <w>беспорядок</w> в своей спальне, прежде чем идти гулять с друзьями.",
                                "tr": "Arkadaşlarınla dışarı çıkmadan önce lütfen yatak odandaki <w>dağınıklığı</w> topla."
                            }
                        },
                        {
                            "text": "The company accounts were in a complete <w>mess</w> when the new manager took over.",
                            "target_lang_translations": {
                                "ru": "Счета компании были в полном <w>беспорядке</w>, когда новый менеджер вступил в должность.",
                                "tr": "Yeni müdür görevi devraldığında şirket hesapları tam bir <w>kargaşa</w> içindeydi."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "disorder",
                        "disarray",
                        "muddle",
                        "shambles",
                        "confusion"
                    ],
                    "common_phrases": [
                        "make a mess",
                        "in a mess",
                        "clean up the mess",
                        "what a mess"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние загрязненности, неопрятности или замешательства; хаотичная или сложная ситуация.",
                        "tr": "Kirli, dağınık veya karmaşık bir durum; kaos veya zor bir hal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядок",
                                "target_lang_sense_clarification": "отсутствие порядка, хаос"
                            },
                            {
                                "target_lang_word": "бардак",
                                "target_lang_sense_clarification": "разговорное; сильный беспорядок, неразбериха"
                            },
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "запутанная ситуация, отсутствие ясности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dağınıklık",
                                "target_lang_sense_clarification": "düzen eksikliği, toplanmamış durum"
                            },
                            {
                                "target_lang_word": "pislik",
                                "target_lang_sense_clarification": "kirlilik"
                            },
                            {
                                "target_lang_word": "kargaşa",
                                "target_lang_sense_clarification": "karmaşa veya zor durum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccb0f9ab-1789-32a0-acf6-a34d34114612",
                    "sense_definition": "A person who is in a state of emotional confusion, distress, or disarray.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a nervous <w>mess</w> while waiting for the results of her medical exam.",
                            "target_lang_translations": {
                                "ru": "Она была нервной <w>развалиной</w> в ожидании результатов медицинского обследования.",
                                "tr": "Sağlık muayenesinin sonuçlarını beklerken sinir krizinin eşiğinde, tam bir <w>enkaz</w> halindeydi."
                            }
                        },
                        {
                            "text": "He has been a total <w>mess</w> ever since he lost his job last month.",
                            "target_lang_translations": {
                                "ru": "Он стал полной <w>развалиной</w> с тех пор, как потерял работу в прошлом месяце.",
                                "tr": "Geçen ay işini kaybettiğinden beri adeta bir <w>enkaz</w> gibi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot mess",
                        "emotional mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe someone falling apart emotionally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся в состоянии эмоционального замешательства, стресса или душевного разлада.",
                        "tr": "Duygusal olarak çökmüş, kafası karışmış veya perişan durumda olan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалина",
                                "target_lang_sense_clarification": "о человеке в плохом физическом или душевном состоянии"
                            },
                            {
                                "target_lang_word": "растяпа",
                                "target_lang_sense_clarification": "неловкий, рассеянный человек"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "enkaz",
                                "target_lang_sense_clarification": "duygusal olarak çökmüş kimse"
                            },
                            {
                                "target_lang_word": "perişan halde",
                                "target_lang_sense_clarification": "ruhen darmadağın olmuş kişi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "664f8288-dfa9-3989-8858-dd97b57fd71a",
                    "sense_definition": "Solid waste matter from the body of an animal; excrement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dirt_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful where you walk because there is dog <w>mess</w> on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда идешь, потому что на тротуаре собачья <w>грязь</w>.",
                                "tr": "Yürüdüğün yere dikkat et çünkü kaldırımda köpek <w>pisliği</w> var."
                            }
                        },
                        {
                            "text": "The puppy made a <w>mess</w> on the carpet while we were sleeping.",
                            "target_lang_translations": {
                                "ru": "Щенок наделал <w>кучу</w> на ковер, пока мы спали.",
                                "tr": "Biz uyurken yavru köpek halıya <w>pisledi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dog mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a polite or euphemistic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердые отходы организма животного; экскременты.",
                        "tr": "Hayvan dışkısı veya pisliği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "эвфемизм для обозначения экскрементов"
                            },
                            {
                                "target_lang_word": "экскременты",
                                "target_lang_sense_clarification": "медицинский/формальный термин"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "pislik",
                                "target_lang_sense_clarification": "hayvan dışkısı anlamında kibar kullanım"
                            },
                            {
                                "target_lang_word": "dışkı",
                                "target_lang_sense_clarification": "daha resmi tanım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b51aeec-70ae-30ed-a7ad-c512ff354601",
                    "sense_definition": "A building or room where military personnel eat and socialize.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers gathered in the <w>mess</w> for dinner after a long day of training.",
                            "target_lang_translations": {
                                "ru": "Солдаты собрались в <w>столовой</w> на ужин после долгого дня тренировок.",
                                "tr": "Askerler uzun bir eğitim gününün ardından akşam yemeği için <w>yemekhanede</w> toplandı."
                            }
                        },
                        {
                            "text": "Officers are expected to wear formal uniforms when dining in the <w>mess</w>.",
                            "target_lang_translations": {
                                "ru": "Офицеры должны носить парадную форму во время обеда в <w>столовой</w>.",
                                "tr": "Subayların <w>gazinoda</w> yemek yerken resmi üniforma giymeleri beklenir."
                            }
                        }
