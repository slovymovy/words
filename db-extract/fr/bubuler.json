                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90378db0-7dc8-41c5-8a77-680b31860524",
                                "sense_id": "3e3b70ce-662b-32a6-a79b-02244e0b30a5",
                                "text": "Il dormait, réveillé seulement de temps à autre, prêtant l’oreille aux battues braconnières du bois, aux cris des hiboux qui bubulaient en face."
                            },
