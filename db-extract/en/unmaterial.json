                        "glosses": [
                            "Not material; lacking tangible physical form."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9f8f67-0ff5-4a3b-89b7-2b03aed8ca2a",
                                "sense_id": "e4417232-73f0-30ec-99a6-c5485adfe400",
                                "text": "Gianluca was a shadow, an unmaterial being, a thought--anything ethereal, but not a man."
                            },
                            {
                                "example_id": "a2d6b2b4-0a43-4cf5-b542-f15cae1df395",
                                "sense_id": "e4417232-73f0-30ec-99a6-c5485adfe400",
                                "text": "Yet whether other beings, other presences, unmaterial, imponderable, intangible, did not walk the streets along with them, is open to doubt."
                            }
                        ]
                    }
