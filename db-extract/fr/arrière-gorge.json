        "fr-extract.jsonl": [
            {
                "entry_id": "d203c60e-b463-3376-abd3-db610c64caf5",
                "word": "arrière-gorge",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7304f7f1-103c-4620-947c-ba34c3c130fc",
                        "entry_id": "d203c60e-b463-3376-abd3-db610c64caf5",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrière-gorges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3016dac8-cca7-30f6-9393-2be18bfcaa0e",
                        "entry_id": "d203c60e-b463-3376-abd3-db610c64caf5",
                        "glosses": [
                            "Pharynx."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "adcdd862-c980-4942-8112-56309e8b1ea4",
                                "sense_id": "3016dac8-cca7-30f6-9393-2be18bfcaa0e",
                                "text": "Le pharynx ou arrière-gorge est une cavité irrégulière, à parois incomplèes et contraciles, qui sert d’orifice commun aux voies digestives, aériennes et auditives."
                            },
                            {
                                "example_id": "58222a95-c85a-4f06-a07e-71e1e89f6e36",
                                "sense_id": "3016dac8-cca7-30f6-9393-2be18bfcaa0e",
                                "text": "En ce moment, Bigua tousse, non qu’il soit enrhumé, mais pour faire savoir une fois de plus à l’enfant qu’il est toujours là près de lui, avec sa gorge et son arrière-gorge véritables."
                            },
                            {
                                "example_id": "335b99f6-310b-4285-9218-4da17503800e",
                                "sense_id": "3016dac8-cca7-30f6-9393-2be18bfcaa0e",
                                "text": "Soudain, après un bruit préparatoire de l’arrière-gorge, des mots s’échappèrent de ses lèvres."
                            }
                        ]
                    },
                    {
                        "sense_id": "76a33f8b-ef5f-3fd9-880d-0a0dbd3e677a",
                        "entry_id": "d203c60e-b463-3376-abd3-db610c64caf5",
                        "glosses": [
                            "Partie buccale du pharynx."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "aef24b32-e5a5-453b-9668-0bced1aec390",
                                "sense_id": "76a33f8b-ef5f-3fd9-880d-0a0dbd3e677a",
                                "text": "Ce procédé repose sur ce principe que, lorsqu’un liquide est lancé brusquement dans les fosses nasales, il provoque aussitôt une contraction énergique du pharynx et du voile du palais, qui ferme la cavité de l’arrière-gorge et s’oppose au passage des liquides."
                            },
                            {
                                "example_id": "640c7b5c-f92e-4ed9-a71b-89ba20b6e2eb",
                                "sense_id": "76a33f8b-ef5f-3fd9-880d-0a0dbd3e677a",
                                "text": "C’était également là que l’hôtesse servait à boire aux chou-fleuristes et aux marins, quand il leur prenait fantaisie de s’humecter l’arrière-gorge."
                            }
                        ]
                    }
                ],
