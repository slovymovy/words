                "senses": [
                    {
                        "sense_id": "8864a98e-30c4-39e0-bae4-7115190ccc5e",
                        "entry_id": "7a95504e-9929-30d8-b7c6-d6739e7b583f",
                        "glosses": [
                            "die Zersetzung von Stoffen durch Hitze"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "679a6115-6be4-468f-8535-7c3f7f8cb36a",
                        "source_entry_id": "7a95504e-9929-30d8-b7c6-d6739e7b583f",
                        "source_sense_id": "8864a98e-30c4-39e0-bae4-7115190ccc5e",
                        "source_sense_description": "Chemie: die Zersetzung von Stoffen durch Hitze",
                        "target_lang_word": "pyrolysis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrolysis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                        "entry_id": "a64d7b64-332b-3b79-9071-d75369bc2e34",
                                        "glosses": [
                                            "The decomposition of a material or compound due to heat, in the absence of oxygen or other reagents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2414c61f-72e2-42eb-ad80-db69ce3593c3",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Techniques that have successfully identified ionic intermediates in solution have been applied to gas-phase pyrolyses."
                                            },
                                            {
                                                "example_id": "ead1661c-c3f8-4221-993e-94884c197ae9",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Twenty years ago our real understanding of the mechanism of alkane pyrolyses was little better than rudimentary."
                                            },
                                            {
                                                "example_id": "2325ac87-759a-41ac-9c13-4dd1609e4b03",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Pyrolysis involves the thermal degradation of the rubber of the tyre to give an oil and gas leaving a residual solid carbon and the steel casing of the tyre."
                                            },
                                            {
                                                "example_id": "a6df86a5-ca5f-4639-b278-5acb400ba7e8",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Traditional pyrolysis of wood relies on low temperatures and long processing time to increase the charcoal yield. In contrast, modern or fast pyrolysis uses moderate temperatures (400-500°C) and very short residence times (typically only a few seconds) to maximize the production of liquids (Diebold and Bridgewater, 1997)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b52a92-fdc6-4149-a247-5226ca70993c",
                        "source_entry_id": "7a95504e-9929-30d8-b7c6-d6739e7b583f",
                        "source_sense_id": "8864a98e-30c4-39e0-bae4-7115190ccc5e",
                        "source_sense_description": "Chemie: die Zersetzung von Stoffen durch Hitze",
                        "target_lang_word": "pyrolyse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrolyse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f04c10-c66a-39e6-af32-d83f87d05357",
                                        "entry_id": "810c78ca-65a1-3b9a-bbdf-e3e7db925a85",
                                        "glosses": [
                                            "Décomposition sans flamme d’un corps organique par la chaleur pour obtenir d'autres produits qu’il ne contenait pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629e2c5f-bf6f-418b-abc3-aa7bf59af21b",
                                                "sense_id": "c0f04c10-c66a-39e6-af32-d83f87d05357",
                                                "text": "Le biochar, charbon produit par pyrolyse et utilisé comme amendement, présente plusieurs avantages et s’avère une avenue prometteuse pour une agriculture durable."
                                            },
                                            {
                                                "example_id": "c2944ada-73bf-4233-8b05-e7109437c51a",
                                                "sense_id": "c0f04c10-c66a-39e6-af32-d83f87d05357",
                                                "text": "« La pyrolyse ne donne pas seulement du biochar, mais aussi un gaz de synthèse qui a l’avantage d’être renouvelable et potentiellement à faible empreinte carbone », indique Claire Chastrusse, directrice générale de cette société créée en 2021."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pyrolyse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b52164d6-6630-35c4-ad7f-6d68f45a3d84",
                                        "entry_id": "52b406f3-c8f2-35b4-ab7b-eb57c6df61a2",
