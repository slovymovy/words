                "senses": [
                    {
                        "sense_id": "40575219-41b5-35bf-8939-7ace16ef58ca",
                        "entry_id": "49781d03-bf95-33ba-84c2-9357d56a0bfa",
                        "glosses": [
                            "Androhung von Gewaltanwendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22212a85-879c-4dd1-8499-d1684cc5944f",
                                "sense_id": "40575219-41b5-35bf-8939-7ace16ef58ca",
                                "text": "„In einer Zeit, in der bei Verhören Schläge und Gewaltandrohung gang und gäbe waren, stellte das höchste Gericht der Vereinigten Staaten in den nach den Klägern Escobedo und Miranda benannten Entscheidungen klar, dass Geständnisse und Äußerungen in Vernehmungen absolut freiwillig zu erfolgen haben.“"
                            },
                            {
                                "example_id": "d6ecde86-7064-4025-8f0c-e9c434724b25",
                                "sense_id": "40575219-41b5-35bf-8939-7ace16ef58ca",
                                "text": "„Eine dauerhafte militärische Präsenz war in den meisten Fällen nicht notwendig, in der Regel genügte schon die Gewaltandrohung, um Gehorsam zu erzielen.“"
                            }
                        ],
