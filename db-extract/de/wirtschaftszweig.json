                        "form": "den Wirtschaftszweig"
                    },
                    {
                        "form_id": "37b359d8-588a-4da8-a501-d486ea3a16d9",
                        "entry_id": "1ecb0e9c-a0f9-340b-b80a-e86c02a4bf65",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wirtschaftszweige"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c896dfda-0f26-3319-b0db-2d81b3a1c9ea",
                        "entry_id": "1ecb0e9c-a0f9-340b-b80a-e86c02a4bf65",
                        "glosses": [
                            "Gruppe von Unternehmen, die nah verwandte Produkte, Güter, Waren und Dienstleistungen herstellen und anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b374cb7e-0cdd-40d8-ae2d-d2f7dd0e1bce",
                                "sense_id": "c896dfda-0f26-3319-b0db-2d81b3a1c9ea",
                                "text": "„Die frühe Eisenzeit fällt in etwa mit der Hallstattzeit zusammen, die nach einem zweiten wichtigen Wirtschaftszweig, dem Salzbergbau, benannt ist – in Anlehnung an Hallstatt im Salzkammergut (Österreich).“"
                            },
                            {
                                "example_id": "7a2a8482-2e7a-4f66-a19b-2d24da20eb21",
                                "sense_id": "c896dfda-0f26-3319-b0db-2d81b3a1c9ea",
                                "text": "„Island denkt angestrengt darüber nach, wie dieses Problem, das gleichzeitig ein wichtiger Wirtschaftszweig ist, gelöst werden kann.“"
                            },
                            {
                                "example_id": "5371c657-e4f9-4343-9e1f-33124726e380",
                                "sense_id": "c896dfda-0f26-3319-b0db-2d81b3a1c9ea",
                                "text": "„Die Holzindustrie ist noch immer ein wichtiger Wirtschaftszweig, während die Fischbestände stark eingebrochen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6b15171-fb28-4bc9-909e-234822856ef2",
                        "source_entry_id": "1ecb0e9c-a0f9-340b-b80a-e86c02a4bf65",
                        "source_sense_id": "c896dfda-0f26-3319-b0db-2d81b3a1c9ea",
                        "target_lang_word": "industry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "industry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa0ae3fa-dfbd-3c36-bea0-bf8a0b0e2fb1",
                                        "entry_id": "706fb250-3c59-3436-a42c-b89644edb961",
                                        "glosses": [
                                            "The tendency to work persistently."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "546c2f1f-2b0a-4914-8620-9246a2975bad",
                                                "sense_id": "fa0ae3fa-dfbd-3c36-bea0-bf8a0b0e2fb1",
                                                "text": "Over the years, their industry and business sense made them wealthy."
                                            },
                                            {
                                                "example_id": "4e1c33c1-87bf-47f6-b26d-fa6209b55b09",
                                                "sense_id": "fa0ae3fa-dfbd-3c36-bea0-bf8a0b0e2fb1",
                                                "text": "The ant has made himself illustrious / Through constant industry industrious. / So what? / Would you be calm and placid / If you were full of formic acid?"
                                            },
                                            {
                                                "example_id": "99b9d581-1883-4a3d-9276-9cfd694fd3ae",
                                                "sense_id": "fa0ae3fa-dfbd-3c36-bea0-bf8a0b0e2fb1",
                                                "text": "The line ends at Narvik. Eight years ago the whole town was in ruins, but the industry of the Norwegian people has rebuilt it entirely."
                                            },
                                            {
                                                "example_id": "e31670aa-be6a-432d-bbed-7039e28e0892",
                                                "sense_id": "fa0ae3fa-dfbd-3c36-bea0-bf8a0b0e2fb1",
                                                "text": "England's win was built on industry and discipline, epitomised by the performances of Manchester City's Joleon Lescott in defence and Scott Parker in midfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba1fb4b-e7c1-3c5b-9220-29db71a3b747",
                                        "entry_id": "706fb250-3c59-3436-a42c-b89644edb961",
                                        "glosses": [
                                            "Businesses of the same type, considered as a whole. Trade."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c0fae5-72f5-468a-abbd-58ad1fee539b",
                                                "sense_id": "2ba1fb4b-e7c1-3c5b-9220-29db71a3b747",
                                                "text": "The software and tourism industries continue to grow, while the steel industry remains troubled."
                                            },
                                            {
                                                "example_id": "be28a70c-5f95-4261-9334-1a050f15cbab",
                                                "sense_id": "2ba1fb4b-e7c1-3c5b-9220-29db71a3b747",
                                                "text": "The steel industry has long used blast furnaces to smelt iron."
                                            },
                                            {
                                                "example_id": "fd44c0cf-68fa-498b-a3b9-490f5945f493",
                                                "sense_id": "2ba1fb4b-e7c1-3c5b-9220-29db71a3b747",
                                                "text": "Long before popular music evolved its many genres and subgenres, the industry was driven by a simple one-size-fits-all philosophy uncomplicated by impassioned debates over the origins of trip hop or the difference between deatchore and screamo."
                                            },
                                            {
                                                "example_id": "65856cef-5362-48a1-9373-9d603f469f6c",
                                                "sense_id": "2ba1fb4b-e7c1-3c5b-9220-29db71a3b747",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f8e930a-1b5e-3971-9d3c-b15cb40783b8",
                                        "entry_id": "706fb250-3c59-3436-a42c-b89644edb961",
                                        "glosses": [
                                            "Businesses that produce goods as opposed to services."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e82048b-056c-49b0-9cdb-0c9885b981a8",
                                                "sense_id": "0f8e930a-1b5e-3971-9d3c-b15cb40783b8",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034289df-e83e-3987-990c-73fb0236e33a",
                                        "entry_id": "706fb250-3c59-3436-a42c-b89644edb961",
                                        "glosses": [
                                            "The sector of the economy consisting of large-scale enterprises."
                                        ],
                                        "tags": [
                                            "countable",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7749be-db5e-46e0-9e5f-785dde1d3095",
                                                "sense_id": "034289df-e83e-3987-990c-73fb0236e33a",
                                                "text": "There used to be a lot of industry around here, but now the economy depends on tourism."
                                            },
                                            {
                                                "example_id": "f2f9404b-6f42-499e-bf09-560ec3269cd9",
                                                "sense_id": "034289df-e83e-3987-990c-73fb0236e33a",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ab5990-76c2-3d88-a1fb-c400cbb2a32d",
                                        "entry_id": "706fb250-3c59-3436-a42c-b89644edb961",
                                        "glosses": [
                                            "Automated production of material goods."
                                        ],
                                        "tags": [
                                            "Europe",
                                            "countable",
                                            "uncountable"
                                        ],
