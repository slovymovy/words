                                                "sense_id": "11ff8ec1-9ca7-328b-804e-46992f269f66",
                                                "text": "Mass tourism damaged the beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d98361e-1921-33ba-94e3-126b1a290539",
                                        "entry_id": "09915574-7fd7-3d6b-9ba9-7439264d2965",
                                        "glosses": [
                                            "The industry in which such travels and sightseeing are organized."
                                        ],
