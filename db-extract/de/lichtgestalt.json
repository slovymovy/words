                ],
                "senses": [
                    {
                        "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                        "entry_id": "be30e9b2-0941-3cb0-ab75-d15694a217ae",
                        "glosses": [
                            "angesehene Person, die das Vorbild vieler ist"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "237d6dc0-e111-4915-92fb-7f1783d8b825",
                                "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                                "text": "Der neue Bundespräsident kommt vielen als eine neue Lichtgestalt vor."
                            },
                            {
                                "example_id": "698234fd-a942-464b-a91a-deb4c8cb89bf",
                                "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                                "text": "Jean Moulin war einer der bedeutendsten französischen Widerstandskämpfer gegen Nazi-Deutschland. […] Er gilt als die Lichtgestalt der Résistance - auch, weil er selbst unter der Gestapo-Folter seine Kameraden nicht verriet."
                            },
                            {
                                "example_id": "25a742b2-411b-4bcf-bd49-11941b7a9982",
                                "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                                "text": "Nelson Mandela zählt zu den großen Lichtgestalten des 20. Jahrhunderts."
                            },
                            {
                                "example_id": "38fad4ea-dfa8-4df7-ba7c-22480e0fc3a7",
                                "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                                "text": "Für viele hat Indien vor allem ein Gesicht: das von Mahatma Gandhi. Doch die Terroranschläge von Bombay zeigen, dass die Vorstellung von der pazifistischen Nation ein Trugbild ist. Es wird Zeit, die historische Lichtgestalt Gandhi zu vergessen und sich ein realistischeres Bild von Indien zu machen."
                            },
                            {
                                "example_id": "7094a4e7-b4a5-4cb2-8bd2-c552c8f23a6c",
                                "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                                "text": "Für viele ist der einstige Über-Fußballer Kult: Franz Beckenbauer - Weltmeister, Macher des Sommermärchens 2006 und Lichtgestalt des deutschen Fußballs. Doch sein Image erhält nun mehr und mehr Kratzer."
                            },
                            {
                                "example_id": "7baa6c0d-fd58-4adc-99b8-2e66b9d65123",
                                "sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                                "text": "Als in Pakistan auch gegen sie, die Ex Ministerpräsidentin [Benazir Bhutto], eine Korruptionsklage lief, verschwand sie 1999 ins \"freiwillige Exil\" nach Dubai. Hatte eine Lichtgestalt aufgehört zu leuchten?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "140f2d55-1a40-4e28-829a-6de233951762",
                        "source_entry_id": "be30e9b2-0941-3cb0-ab75-d15694a217ae",
                        "source_sense_id": "f696ff4c-f9ed-354f-9c39-f6f54b4de1a1",
                        "source_sense_description": "gehoben: angesehene Person, die das Vorbild vieler ist",
                        "target_lang_word": "luminary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luminary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "570fe9b8-2249-36af-9e0d-b19e718440db",
                                        "entry_id": "0651daab-282f-3ed4-9875-80ed9fa4a5e9",
                                        "glosses": [
                                            "One who is an inspiration to others; one who has achieved success in one's chosen field; a leading light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2118f073-d99d-4946-bd95-1a391cfec408",
                                                "sense_id": "570fe9b8-2249-36af-9e0d-b19e718440db",
                                                "text": "For more than a decade, forces on the ideological extremes have torn at the global political fabric. And for just as long, the luminaries at the World Economic Forum have fretted about how dangerous that phenomenon is — for the businesses they lead and the countries they govern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed19541c-cdd2-36c9-991c-1a12de71b9db",
                                        "entry_id": "0651daab-282f-3ed4-9875-80ed9fa4a5e9",
                                        "glosses": [
                                            "A body that gives light; especially, one of the heavenly bodies."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf7db5b-653e-48fb-9b99-0cd08606cc95",
                                                "sense_id": "ed19541c-cdd2-36c9-991c-1a12de71b9db",
                                                "text": "[…] then firſt adornd / With thir bright Luminaries that Set and Roſe, / Glad Evening & glad Morn crownd the fourth day."
                                            },
                                            {
                                                "example_id": "f54ce241-b4f7-407c-911f-d33bc02eb182",
                                                "sense_id": "ed19541c-cdd2-36c9-991c-1a12de71b9db",
                                                "text": "The first eye of consequence (under the invisible Author of all) is the visible luminary of the universe."
                                            },
                                            {
                                                "example_id": "11944160-05c7-4426-a302-eb2e21e10b03",
                                                "sense_id": "ed19541c-cdd2-36c9-991c-1a12de71b9db",
                                                "text": "The Intercourſe between God and his Soul was as conſtant and periodical as the Riſing and Setting of the Great Luminary of Heaven; […]"
                                            },
                                            {
                                                "example_id": "19b44133-6c24-4610-ab3b-f3103e7ea2ed",
                                                "sense_id": "ed19541c-cdd2-36c9-991c-1a12de71b9db",
                                                "text": "For all things, even Celestial Luminaries, much more atmospheric meteors, have their rise, their culmination, their decline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a592b9-e904-33c9-8820-7c58b401ce2f",
                                        "entry_id": "0651daab-282f-3ed4-9875-80ed9fa4a5e9",
                                        "glosses": [
                                            "An artificial light; an illumination."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a4b509c-d53c-4dfe-9b0f-442868557e03",
                                                "sense_id": "22a592b9-e904-33c9-8820-7c58b401ce2f",
                                                "text": "[T]he Sun of Righteouſneſs [Jesus Christ], when, on the nations of thoſe who are ſaved, he ariſes with healing under his wings, ſhall ſcatter by his brightneſs, every cloud which ſat around them. To the diſtant influence of this powerful luminary on the heart, its regeneration is at preſent owing. But, when every intervening object is removed, and the Chriſtian placed in the light of his countenance, all imperfection flies away."
                                            },
                                            {
                                                "example_id": "4d5666d7-7abe-4ea5-a47a-7d29d5b172b3",
                                                "sense_id": "22a592b9-e904-33c9-8820-7c58b401ce2f",
                                                "text": "[page 378] The paper read was on \"The Electric Light applied to Lighthouse Illumination,\" by Mr. J[ames] N[icholas] Douglass, M. Inst. C.E. The author showed the progress of lighthouse luminaries from wood and coal fires to the introduction of tallow candles, fatty oils, mineral oils, coal gas, and electricity. […] [page 381] on more frequent occasions, when the oil luminary would be visible at about eight miles and a-half, the electric light would be visible at the full range of 17 miles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
