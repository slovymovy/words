                "senses": [
                    {
                        "sense_id": "f703008a-e27a-3167-85ee-1f31de655c6a",
                        "entry_id": "317d67ee-c53f-3de5-939e-b708dff571d6",
                        "glosses": [
                            "Donner un caractère de reptile à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50992ee7-3233-41b1-92df-962ac4c09aff",
                                "sense_id": "f703008a-e27a-3167-85ee-1f31de655c6a",
                                "text": "Ainsi, l’Allemagne Nazie, pleine de prévention à l’égard des autres Européens, a voulu les «primitiviser» et les «reptiliser»."
                            },
                            {
                                "example_id": "e152f39d-362f-4bef-8da7-70325b078110",
                                "sense_id": "f703008a-e27a-3167-85ee-1f31de655c6a",
                                "text": "Un nazisme bédouin, dira l’un. L’appellation a le mérite de faire référence à un certain Occident et aux déserts péninsulaires où l’esprit se reptilise."
                            },
                            {
                                "example_id": "e66e0718-ad1c-4545-800c-9ac876bd44e9",
                                "sense_id": "f703008a-e27a-3167-85ee-1f31de655c6a",
                                "text": "Ne vient-il pas en effet de s’aplatir, de se vautrer par terre, de se reptiliser ?"
                            }
                        ]
                    }
