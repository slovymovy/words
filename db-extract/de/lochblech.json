                "senses": [
                    {
                        "sense_id": "846aa6a8-96b0-3e12-b170-f9dbb8c7f338",
                        "entry_id": "9c72b441-ac26-39e0-8a6f-8f37e5e9ba8d",
                        "glosses": [
                            "ein zu dünnen Platten ausgewalztes Metall mit darin symmetrisch eingestanzten Löchern, in runder oder rechteckiger Form. Die verwendeten Materialien sind zum Beispiel Stahl, Edelstahl, Kupfer und Aluminium; aber auch diverse Kunststoffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52aed92c-5630-4fbe-9dc8-ad5d610cda05",
                                "sense_id": "846aa6a8-96b0-3e12-b170-f9dbb8c7f338",
                                "text": "„Der Begriff „Lochplatte“ ist in der DIN 4185-2 und der DIN 24041 enthalten. Er löst den Begriff „Lochblech“ ab. Trotzdem verwenden die Hersteller auch weiterhin die Begriffe „Lochblech“ oder „gelochtes Blech“.“"
                            }
                        ],
