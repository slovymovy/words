                            {
                                "example_id": "4df10d09-ef7f-4d95-ac3f-4ca1d7c495aa",
                                "sense_id": "a1c93ef2-05b3-3d9a-85bd-075e739c5295",
                                "text": "Met dreigementen en zwijggeld slaagde de corrupte bewindsman erin aan de macht te blijven."
                            },
                            {
                                "example_id": "c2ecb554-f012-49e0-9036-4b93703da28c",
                                "sense_id": "a1c93ef2-05b3-3d9a-85bd-075e739c5295",
                                "text": "Janine wilde zwijggeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2062e10-4675-4069-919a-363bf0dc64df",
                        "source_entry_id": "a9cfcd7f-0e79-370c-abb4-6bafa43d0e94",
                        "source_sense_id": "a1c93ef2-05b3-3d9a-85bd-075e739c5295",
                        "target_lang_word": "Schweigegeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweigegeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7badd375-1ecc-3e92-952f-e065786417f0",
                                        "entry_id": "4a4c8453-7a02-32bf-a0c3-c1d0767b5d5e",
                                        "glosses": [
                                            "Gelder oder Geldsumme, die einem gezahlt wird, damit man eine bestimmte Information verschweigt; Bestechungsgeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d986ea42-9889-4dbb-afa1-8b6a94ef7e06",
                                                "sense_id": "7badd375-1ecc-3e92-952f-e065786417f0",
                                                "text": "Neue Dokumente belegen, dass er von den Hingerichteten in seiner Leichenfabrik wusste, sogar Schweigegeld zahlte."
                                            },
                                            {
                                                "example_id": "38d462cb-4088-4b3c-a4a6-1e0711aaea4b",
                                                "sense_id": "7badd375-1ecc-3e92-952f-e065786417f0",
                                                "text": "Nach seinen Sex-Affären soll Golf-Star Tiger Woods einer Geliebten 1 Mio. Dollar Schweigegeld geboten haben…"
                                            },
                                            {
                                                "example_id": "f8d164f5-b82b-465f-8a39-caddeb842fe0",
                                                "sense_id": "7badd375-1ecc-3e92-952f-e065786417f0",
                                                "text": "Siemens geht dem Verdacht nach, ob Schweigegelder zur Vertuschung von Korruption gezahlt worden sind."
                                            },
                                            {
                                                "example_id": "28c43bea-1be0-4639-bcf6-3293bf1a1ae2",
                                                "sense_id": "7badd375-1ecc-3e92-952f-e065786417f0",
                                                "text": "Wenn die Kirche mit Opfern verhandle, dann nur hinter verschlossenen Türen. Wer Glück hat, bekommt ein paar tausend Euro Abfindung - Schweigegeld."
                                            },
                                            {
                                                "example_id": "7257c8d2-6376-4416-bd45-e2719eff6662",
                                                "sense_id": "7badd375-1ecc-3e92-952f-e065786417f0",
                                                "text": "2014 soll er [Prof. Bernhard Stüer] sogar eine Art „Schweigegeld“ an die Bürgerinitiative gegen Bahnlärm gezahlt haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "934b6c8e-cce8-4c26-887b-2a80c89325bc",
                        "source_entry_id": "a9cfcd7f-0e79-370c-abb4-6bafa43d0e94",
                        "source_sense_id": "a1c93ef2-05b3-3d9a-85bd-075e739c5295",
                        "target_lang_word": "hush money",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hush money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15136eb2-c531-3763-9217-0d6f0e871402",
                                        "entry_id": "3afc34fe-66f7-39d8-9bef-7d5837f088da",
                                        "glosses": [
                                            "A bribe to maintain secrecy (to prevent bad publicity or to prevent the discovery of a crime)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73bb9fda-95aa-44c2-915c-b732ac00f3f5",
                                                "sense_id": "15136eb2-c531-3763-9217-0d6f0e871402",
                                                "text": "The scandal was even greater when it was announced that hush money had been paid to keep the faulty products unannounced."
                                            },
                                            {
                                                "example_id": "516cc0f5-bd0e-4e89-aabc-50783ca3fd96",
                                                "sense_id": "15136eb2-c531-3763-9217-0d6f0e871402",
                                                "text": "He holds, I am given to understand, a small official appointment in the colony. If it were known that he had received hush money, he would be ruined."
                                            },
                                            {
                                                "example_id": "e1723517-c2a4-46d4-bca5-cc356ba9f837",
                                                "sense_id": "15136eb2-c531-3763-9217-0d6f0e871402",
                                                "text": "Is paying hush money a crime? In most cases, the answer is no. Hush-money agreements, otherwise known as nondisclosure agreements, have long been used by companies and private individuals to avoid litigation and keep embarrassing information confidential."
                                            },
                                            {
                                                "example_id": "b25f3c77-83a8-4446-bf6d-bded44ced84a",
                                                "sense_id": "15136eb2-c531-3763-9217-0d6f0e871402",
                                                "text": "Lawyers defending Mr. Trump, who denies he had sex with her, will likely argue that his employees were responsible for the paper trail that falsely described the reimbursement of the hush money as legal fees for Mr. Cohen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
