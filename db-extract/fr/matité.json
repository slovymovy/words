            {
                "entry_id": "a2d87629-d00e-3b08-a956-1116e4a424fd",
                "word": "matité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "66520717-c0dc-4cfe-ae30-e4ae6b936531",
                        "entry_id": "a2d87629-d00e-3b08-a956-1116e4a424fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "matités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc8666a9-c779-3d5d-8f77-a522ad1ae0ba",
                        "entry_id": "a2d87629-d00e-3b08-a956-1116e4a424fd",
                        "glosses": [
                            "Qualité de ce qui est mat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8504979e-9068-4bb7-9de1-eae8dc28e12e",
                                "sense_id": "fc8666a9-c779-3d5d-8f77-a522ad1ae0ba",
                                "text": "Il y en avait de plus doucement brunes que certaines nuits d’été et qui ne souhaitaent pas un peu d’or dans leur chevelure, ni de la poudre ocre sur la matité de leur chair."
                            },
                            {
                                "example_id": "e38a60f5-39ca-4856-888a-cf69b1ebe948",
                                "sense_id": "fc8666a9-c779-3d5d-8f77-a522ad1ae0ba",
                                "text": "Sur la matité du cuir, un éclat glacé de métal ; Zag vérifie, du bout de l’index, l’acuité de la lame."
                            },
                            {
                                "example_id": "145728a4-59fb-4450-bc35-8eb4ae74dae2",
                                "sense_id": "fc8666a9-c779-3d5d-8f77-a522ad1ae0ba",
                                "text": "Sur le court, les couleurs ont changé d’un seul coup. La terre orangée a pris une matité rougeâtre, presque brune."
                            },
                            {
                                "example_id": "83867266-31bf-4905-a585-e92de2ef215c",
                                "sense_id": "fc8666a9-c779-3d5d-8f77-a522ad1ae0ba",
                                "text": "Le ciel d'un bleu chinois et d'une matité de laine."
                            }
                        ]
                    },
                    {
                        "sense_id": "96da20e5-7e96-3afc-bdca-eef3f7d2cdfa",
                        "entry_id": "a2d87629-d00e-3b08-a956-1116e4a424fd",
                        "glosses": [
                            "État de ce qui est mat, particulièrement en parlant d’un son."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "c193cb32-d17a-46fd-90f6-a00d05e07dde",
                                "sense_id": "96da20e5-7e96-3afc-bdca-eef3f7d2cdfa",
                                "text": "En effet, au niveau de la région sous-claviculaire gauche, existait une matité absolue à la percussion légère et un skodisme léger à la percussion profonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "d29d5fb3-ca87-3ae2-b592-9afbc4eb3287",
                        "entry_id": "a2d87629-d00e-3b08-a956-1116e4a424fd",
                        "glosses": [
                            "Abaissement de l'intensité et de la fréquence qu'un son obtenu lors de la percussion d'une partie du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8bddf5-aac0-468a-b913-611a62e8e3b4",
                                "sense_id": "d29d5fb3-ca87-3ae2-b592-9afbc4eb3287",
                                "text": "On trouvera, par la percussion, une ligne de matité horizontale qui ne sera autre qu'une section circulaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83b0bf15-805a-4716-8a59-5bd8f5988a69",
                        "source_entry_id": "a2d87629-d00e-3b08-a956-1116e4a424fd",
                        "target_lang_word": "dullness",
