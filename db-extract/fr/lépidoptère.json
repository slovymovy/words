            {
                "entry_id": "f99d1d6e-c27e-36d3-ae67-f3d86fae5360",
                "word": "lépidoptère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6cde7bc-0f45-4ec7-9071-126eec14b65b",
                        "entry_id": "f99d1d6e-c27e-36d3-ae67-f3d86fae5360",
                        "tags": [
                            "plural"
                        ],
                        "form": "lépidoptères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99022123-478c-39ea-b2fb-79e8405e05f1",
                        "entry_id": "f99d1d6e-c27e-36d3-ae67-f3d86fae5360",
                        "glosses": [
                            "Insecte à métamorphose complète dont la forme adulte, appelée papillon, a quatre ailes couvertes d’écailles colorées, dont la larve est appelée chenille et la nymphe chrysalide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c437373e-f8a4-456c-a0b3-b2edb12a9ce5",
                                "sense_id": "99022123-478c-39ea-b2fb-79e8405e05f1",
                                "text": "On avait construit de grands capuchons de gaze claire, avec lesquels on prenait les pauvres lépidoptères."
                            },
                            {
                                "example_id": "1d11a3d4-78e9-47c5-9d7b-9ff007b280cd",
                                "sense_id": "99022123-478c-39ea-b2fb-79e8405e05f1",
                                "text": "Le lépidoptère arrêta son mouvement et resta tranquillement sur son socle."
                            },
                            {
                                "example_id": "a2e3aa16-b86d-4fcd-bd5d-bcea3b9a88a7",
                                "sense_id": "99022123-478c-39ea-b2fb-79e8405e05f1",
                                "text": "Ils savent aussi que le petit mars changeant (de son nom savant apatura ilia) a été observé l’été dernier. C’est une espèce de lépidoptère (papillon) de la famille des nymphalidae qui, jusqu’à présent, n’avait jamais volé dans notre contrée…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aad02ce7-f312-4efd-8bd8-4f3f1c5a0411",
                        "source_entry_id": "f99d1d6e-c27e-36d3-ae67-f3d86fae5360",
                        "source_sense_id": "99022123-478c-39ea-b2fb-79e8405e05f1",
                        "source_sense_description": "Lépidoptère",
                        "target_lang_word": "Falter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1ba709-5f86-3d96-9e1d-4b9f7b65146d",
                                        "entry_id": "fe079124-8ddf-3292-bbae-acd268d58d6c",
                                        "glosses": [
                                            "Vertreter einer artenreichen Ordnung der Insekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b2c63e-2a2e-45f5-beaa-c91868629062",
                                                "sense_id": "7a1ba709-5f86-3d96-9e1d-4b9f7b65146d",
                                                "text": "Dieser Falter ist vor allem im Offenland verbreitet."
                                            },
                                            {
                                                "example_id": "7b72404d-1bdd-42ee-a3e7-fe7412ef250d",
                                                "sense_id": "7a1ba709-5f86-3d96-9e1d-4b9f7b65146d",
                                                "text": "„Der Falter hob sich, glitt unter die Seide und begann, sich die Flügel an der heißen elektrischen Birne zu zerschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0c0378d-9bad-3e71-92f7-bc9e24fe569e",
                                        "entry_id": "fe079124-8ddf-3292-bbae-acd268d58d6c",
                                        "glosses": [
                                            "kleines Schriftstück auf einem mindestens einmal gefalteten (zusammenklappbaren) Stück Papier mit Informationen oder Werbung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41eb67f9-d0aa-4c78-ba47-87a65f55c7fc",
                        "source_entry_id": "f99d1d6e-c27e-36d3-ae67-f3d86fae5360",
                        "source_sense_id": "99022123-478c-39ea-b2fb-79e8405e05f1",
                        "source_sense_description": "Lépidoptère",
                        "target_lang_word": "Schmetterling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmetterling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eae87cb-9c4d-3d6d-a99f-aeb8b82a6310",
                                        "entry_id": "70a63016-1a89-3bd2-b168-c485574d304a",
                                        "glosses": [
                                            "Insekt mit farbig beschuppten Flügeln (Ordnung Lepidoptera)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3cedd7-ea8f-48c9-babf-28453e9b3bd4",
                                                "sense_id": "2eae87cb-9c4d-3d6d-a99f-aeb8b82a6310",
                                                "text": "Admirale, Spinner und Spanner sind Schmetterlinge."
                                            },
                                            {
                                                "example_id": "d50f63ca-7f7b-4a9e-9e3b-913abbd88525",
                                                "sense_id": "2eae87cb-9c4d-3d6d-a99f-aeb8b82a6310",
                                                "text": "„Schmetterlinge taumeln heran, so sehr dem Wind hingegeben, als schwämmen sie auf ihm, weiße und goldene Segel der zärtlichen Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "560050dc-36dc-39bc-b2e2-68c631b1ad7e",
                                        "entry_id": "70a63016-1a89-3bd2-b168-c485574d304a",
                                        "glosses": [
                                            "im engeren Sinne ein Tagfalter (tagaktiver Schmetterling^([1]))"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a032bd2b-f96b-4853-b7aa-763b2fbe8999",
                                                "sense_id": "560050dc-36dc-39bc-b2e2-68c631b1ad7e",
                                                "text": "Der Zitronenfalter ist ein Tagfalter, dieser Schmetterling macht im Winter Winterschlaf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6db08e3f-3134-396d-b9ce-bef5d8e420b2",
                                        "entry_id": "70a63016-1a89-3bd2-b168-c485574d304a",
                                        "glosses": [
                                            "ein Schwimmstil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0e5e9a-17f0-4341-a577-78ca0d3f5410",
                                                "sense_id": "6db08e3f-3134-396d-b9ce-bef5d8e420b2",
                                                "text": "Im Kraulen ist er Mittelfeld, aber im Schmetterling der Beste."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7e4fc05e-a4fa-3efb-87ba-c42f5411b567",
                                        "entry_id": "70a63016-1a89-3bd2-b168-c485574d304a",
                                        "glosses": [
                                            "eine Stellung der Segel"
                                        ],
                                        "tags": [
                                            "Segeln"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efa9826-4f8d-4a28-befc-23612a094bb7",
                                                "sense_id": "7e4fc05e-a4fa-3efb-87ba-c42f5411b567",
                                                "text": "Beim Schmetterling stehen die Segel auf beiden Seiten, so dass sich das Vorsegel nicht im Windschatten des Großsegels befindet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b5288feb-bdf9-3645-9b62-5b655134b718",
                                        "entry_id": "70a63016-1a89-3bd2-b168-c485574d304a",
                                        "glosses": [
                                            "freier Salto mit halber Drehung am höchsten Punkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497b940f-b109-486b-996c-514218307b43",
                                                "sense_id": "b5288feb-bdf9-3645-9b62-5b655134b718",
                                                "text": "Sie zeigte, wie das Radschlagen geht, und auch einen Schmetterling."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f976dea4-4251-3887-9f7b-30c79ff1e82c",
                                        "entry_id": "70a63016-1a89-3bd2-b168-c485574d304a",
                                        "glosses": [
                                            "eine (Kamasutra-)Sexstellung, bei der die Frau oder auch der Mann eine leicht passive Rolle hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3816d9bf-f8b5-4032-9053-e6c70b44f500",
                                                "sense_id": "f976dea4-4251-3887-9f7b-30c79ff1e82c",
                                                "text": "Der Schmetterling gefällt meiner Freundin sehr."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
