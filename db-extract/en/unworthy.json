                "senses": [
                    {
                        "sense_id": "09c223c3-d67c-3e4b-a3c4-8f32dcb15ef4",
                        "entry_id": "dc49b1af-93dd-367f-a813-b65428b62ab9",
                        "glosses": [
                            "Not worthy; lacking value or merit; worthless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad90d48-a355-4031-b68a-de464157e3f2",
                                "sense_id": "09c223c3-d67c-3e4b-a3c4-8f32dcb15ef4",
                                "text": "[…]But alas the while!\nIf Hercules and Lichas play at dice\nWhich is the better man, the greater throw\nMay turn by the fortune from the weaker hand:\nSo is Alcides beaten by his page;\nAnd so may I, blind Fortune leading me,\nMiss that which one unworthier may attain,\nAnd die with grieving."
                            },
                            {
                                "example_id": "f6523ff7-9096-4111-9264-a6d5466120cd",
                                "sense_id": "09c223c3-d67c-3e4b-a3c4-8f32dcb15ef4",
                                "text": "Another place where, from the aesthetic point of view, a long tunnel would have been a real blessing, is East London as viewed from the carriage window on the old Great Eastern line. Despite a vast change from crowded slums to tracts of wasteland, due to its grim wartime experience, this approach still provides a shabby and unworthy introduction to the great capital."
                            },
                            {
                                "example_id": "0139c8a8-f3fe-4c2e-bcb2-558803ec4bd2",
                                "sense_id": "09c223c3-d67c-3e4b-a3c4-8f32dcb15ef4",
                                "text": "AN HISTORICAL GEOGRAPHY OF THE RAILWAYS OF THE BRITISH ISLES. By Ernest F. Carter. Cassell. 63s. [...] Such a disappointing work is embarrassing to the reviewer and unworthy of the great House of Cassell."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f41191e1-088b-474d-90de-c9ae7ad22ba9",
                        "source_entry_id": "dc49b1af-93dd-367f-a813-b65428b62ab9",
                        "source_sense_id": "09c223c3-d67c-3e4b-a3c4-8f32dcb15ef4",
                        "source_sense_description": "not worthy",
                        "target_lang_word": "nehodný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fc031015-7f80-4fae-97fe-9d4895563846",
                        "source_entry_id": "dc49b1af-93dd-367f-a813-b65428b62ab9",
                        "source_sense_id": "09c223c3-d67c-3e4b-a3c4-8f32dcb15ef4",
                        "source_sense_description": "not worthy",
                        "target_lang_word": "indigne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3da47d7-45cf-3fbe-899d-ad2fe90c7d13",
                                        "entry_id": "3d89e7d3-344a-30f2-b493-77a5280a8f36",
                                        "glosses": [
                                            "Qui n’est pas digne de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee02404-ca7f-4c60-bf93-3a6e2e41993a",
                                                "sense_id": "e3da47d7-45cf-3fbe-899d-ad2fe90c7d13",
                                                "text": "Il est indigne des grâces que vous lui faites. — Il est indigne de vivre. — Il s’est rendu indigne de vos bienfaits."
                                            },
                                            {
                                                "example_id": "5c97bf3b-1e75-4b04-bdec-cc6e2ea18893",
                                                "sense_id": "e3da47d7-45cf-3fbe-899d-ad2fe90c7d13",
                                                "text": "Puisque vous le jugez indigne de votre confiance. — Il est indigne de créance, de foi. — Il est indigne du rang qu’il occupe."
                                            },
                                            {
                                                "example_id": "6e669094-0f46-4a94-877b-3020a44c9492",
                                                "sense_id": "e3da47d7-45cf-3fbe-899d-ad2fe90c7d13",
                                                "text": "Il est indigne qu’on lui témoigne le moindre intérêt. — Un fils indigne de son père. — Un crime, une faute indigne de pardon."
                                            },
                                            {
                                                "example_id": "acbf7081-85ef-4a83-94a7-89cc7d87673a",
                                                "sense_id": "e3da47d7-45cf-3fbe-899d-ad2fe90c7d13",
                                                "text": "Cet ouvrage est indigne de votre attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5ca723-dd46-3b24-8263-18c2b67689e6",
                                        "entry_id": "3d89e7d3-344a-30f2-b493-77a5280a8f36",
                                        "glosses": [
                                            "Qualifie ceux qui, pour avoir manqué à quelque devoir essentiel envers une personne, de son vivant ou après sa mort, sont privés de sa succession."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4c7adb-21c9-48dd-9ca6-f82931e76061",
                                                "sense_id": "4f5ca723-dd46-3b24-8263-18c2b67689e6",
                                                "text": "Don Louis — Sache, fils indigne, que la tendresse paternelle est poussée à bout par tes actions, que je saurai, plus tôt que tu ne penses, mettre une borne à tes dérèglements, prévenir sur toi le courroux du Ciel, et laver par ta punition la honte de t'avoir fait naître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e88a476f-ab50-361b-85b7-9afa4a2386cd",
                                        "entry_id": "3d89e7d3-344a-30f2-b493-77a5280a8f36",
                                        "glosses": [
                                            "Qualifiait une personne dans le titre qu'elle se donne par humilité, surtout dans les formules de politesse."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e83e853-2e3d-4c4f-bb45-db3874eb492c",
                                                "sense_id": "e88a476f-ab50-361b-85b7-9afa4a2386cd",
                                                "text": "Serviteur indigne. — J’osai, moi indigne, retoucher son ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d81dc5-7ea9-325c-868a-461961399450",
                                        "entry_id": "3d89e7d3-344a-30f2-b493-77a5280a8f36",
                                        "glosses": [
                                            "Qui n’est pas séant, convenable ; qui est condamnable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ed0dae1-b2b4-45bc-9c6e-0c0a0320b722",
                                                "sense_id": "52d81dc5-7ea9-325c-868a-461961399450",
                                                "text": "Ceux-ci, d’ailleurs, un peu hautains et dédaigneux, affectaient souvent de regarder comme indignes d’eux les amusements habituels des gosses."
                                            },
                                            {
                                                "example_id": "58cd2c4b-21ef-4c5d-b5cd-d8a134fba35b",
                                                "sense_id": "52d81dc5-7ea9-325c-868a-461961399450",
                                                "text": "« Les gens vivent un enfer, sont agressifs… La situation est intenable » a-t-il poursuivi, ajoutant que « c’est aussi un enfer pour les crackers, indigne de la République française »."
                                            },
                                            {
                                                "example_id": "ac8ff403-33b6-4ac9-b807-68dcc85a24d1",
                                                "sense_id": "52d81dc5-7ea9-325c-868a-461961399450",
                                                "text": "Une telle conduite est indigne d’un homme d’honneur. — Ces paroles sont indignes de vous. — Cela est indigne de votre rang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "042ad39f-db29-3ef3-9a64-5e68058d45aa",
                                        "entry_id": "3d89e7d3-344a-30f2-b493-77a5280a8f36",
                                        "glosses": [
                                            "Qualifie le sacrement de communion qui n’est pas faite avec les dispositions requises."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "indigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caf4f8b5-1225-3e55-9504-fb5baf6acdc7",
                                        "entry_id": "f4ab0bad-bcea-3b64-bece-8a52a3de4be0",
                                        "glosses": [
                                            "Personne indigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "763f42d4-bc8b-480b-98a7-89c7188fd5fb",
                                                "sense_id": "caf4f8b5-1225-3e55-9504-fb5baf6acdc7",
                                                "text": "Elles donnent une piètre idée de ces électeurs qui, à les en croire, ont confié la crosse à un indigne pasteur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a486084d-eb6a-3e59-8b63-15bed7451c7c",
                                        "entry_id": "405bb17b-c080-3455-9dd3-7108fe072e3a",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de indigner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e2aba81-0543-35e1-aeac-15a20ee6573a",
                                        "entry_id": "405bb17b-c080-3455-9dd3-7108fe072e3a",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de indigner."
