{
    "word_family": [
        "approach",
        "approachable",
        "approachability",
        "unapproachability",
        "unapproachably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed2783a2-b282-34bb-9bed-39a7f13473da",
                    "sense_definition": "Aloof, distant, and unfriendly in manner, making other people reluctant to talk to or interact with one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although he appeared stern and <w>unapproachable</w>, he was actually very kind and helpful.",
                            "target_lang_translations": {
                                "ru": "Хотя он казался суровым и <w>неприступным</w>, на самом деле он был очень добрым и отзывчивым."
                            }
                        },
                        {
                            "text": "Her cold demeanor made her seem completely <w>unapproachable</w> to the new employees.",
                            "target_lang_translations": {
                                "ru": "Из-за холодного поведения новым сотрудникам она казалась совершенно <w>неприступной</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aloof",
                        "distant",
                        "standoffish",
                        "frosty",
                        "cool",
                        "reserved"
                    ],
                    "antonyms": [
                        "approachable",
                        "friendly",
                        "welcoming"
                    ],
                    "common_phrases": [
                        "seem unapproachable",
                        "appear unapproachable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Холодный, замкнутый и недружелюбный в общении, вызывающий нежелание вступать в контакт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприступный",
                                "target_lang_sense_clarification": "о человеке, к которому трудно подойти или заговорить"
                            },
                            {
                                "target_lang_word": "необщительный",
                                "target_lang_sense_clarification": "замкнутый, избегающий контактов"
                            },
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "дистанцирующийся, держащийся надменно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6610c11-b365-3efc-adca-1281ca4a6811",
                    "sense_definition": "Not able to be reached, approached, or accessed; inaccessible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient fortress was built high upon an <w>unapproachable</w> cliff.",
                            "target_lang_translations": {
                                "ru": "Древняя крепость была возведена высоко на <w>неприступной</w> скале."
                            }
                        },
                        {
                            "text": "Heavy snowstorms rendered the remote mountain villages virtually <w>unapproachable</w> for weeks.",
                            "target_lang_translations": {
                                "ru": "Сильные метели на несколько недель сделали отдалённые горные деревни практически <w>недоступными</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "inaccessible",
                        "remote"
                    ],
                    "antonyms": [
                        "accessible",
                        "approachable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, к которому невозможно подойти или добраться; труднодоступный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприступный",
                                "target_lang_sense_clarification": "о скале, крепости и т. п."
                            },
                            {
                                "target_lang_word": "недоступный",
                                "target_lang_sense_clarification": "о месте, к которому нет доступа"
                            },
                            {
                                "target_lang_word": "труднодоступный",
                                "target_lang_sense_clarification": "о местности, куда трудно добраться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "673fd645-dea2-35a3-9d9c-2f8dd1dc53fa",
                    "sense_definition": "So superior as to be beyond comparison or imitation; peerless or unbeatable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master chef prepared a feast featuring dishes of <w>unapproachable</w> excellence.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил пир с блюдами <w>недосягаемого</w> совершенства."
                            }
                        },
                        {
                            "text": "Her talent as an operatic soloist remains completely <w>unapproachable</w> even today.",
                            "target_lang_translations": {
                                "ru": "Её талант оперной солистки даже сегодня остаётся абсолютно <w>недосягаемым</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to describe unparalleled excellence or perfection"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходящий всё остальное настолько, что не поддаётся сравнению или подражанию; непревзойдённый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недосягаемый",
                                "target_lang_sense_clarification": "о качестве, мастерстве, уровне совершенства"
                            },
                            {
                                "target_lang_word": "непревзойдённый",
                                "target_lang_sense_clarification": "не имеющий равных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}