                    {
                        "sense_id": "655aaaae-af48-36b4-8046-d6169c910800",
                        "entry_id": "a7f8bae4-b538-3b5a-a44d-f9f06603b5d9",
                        "glosses": [
                            "to bury, to dig (into)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69cb0777-5fae-4ed3-85e3-603ed67b5a5f",
                                "sense_id": "655aaaae-af48-36b4-8046-d6169c910800",
                                "text": "закопа́ть в зе́млю свой тала́нт",
                                "translation": "to let one's talent go to waste",
                                "english": "to let one's talent go to waste"
                            },
                            {
                                "example_id": "88575569-1cb9-4708-a5ed-9dbaaabcdadc",
                                "sense_id": "655aaaae-af48-36b4-8046-d6169c910800",
                                "text": "Показа́лось ему́, что кто́-то на той стороне́ спуска́ется с кру́чи. Мо́жет быть, вор хо́чет закопа́ть в гли́не что́-нибудь кра́деное.",
                                "translation": "It seemed to him that somebody was going down the steep slope on the other side. Maybe a thief wanted to bury some stolen thing in the clay.",
                                "english": "It seemed to him that somebody was going down the steep slope on the other side. Maybe a thief wanted to bury some stolen thing in the clay."
                            }
                        ]
                    },
                    {
                        "sense_id": "f436cda6-e618-310e-8f37-767c184ecf6e",
                        "entry_id": "a7f8bae4-b538-3b5a-a44d-f9f06603b5d9",
                        "glosses": [
                            "to fill up (with earth)"
                        ],
