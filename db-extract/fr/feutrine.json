                                                "text": "You'll notice that all the illustrations are done in different media: some with pencil crayons, some with felts, some with paint, some with chalk pastels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6968f7-8b8d-3e3b-a1c0-082472e09b26",
                                        "entry_id": "0ef63074-3284-31f0-bdf6-fba60e5e54aa",
                                        "glosses": [
                                            "A skin or hide; a fell; a pelt."
                                        ],
                                        "tags": [
                                            "countable",
