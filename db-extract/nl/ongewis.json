                                "sense_id": "c402bc43-c66d-3b25-a2d4-8141dbe82f82",
                                "text": "Hij liet ons in het ongewisse.",
                                "translation": "He kept us in the dark.",
                                "english": "He kept us in the dark."
                            }
                        ]
