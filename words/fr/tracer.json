                    "frequency": "High",
                    "semantic_group_id": "dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève utilise une règle graduée pour <w>tracer</w> un triangle rectangle."
                        },
                        {
                            "text": "L'architecte commence à <w>tracer</w> les plans détaillés de la maison."
                        }
                    ],
                    "common_phrases": [
