                        "examples": [
                            {
                                "example_id": "63b00e63-f202-4afa-a017-20cacce60b54",
                                "sense_id": "9daf6921-5949-36f1-9a76-636c5aa58427",
                                "text": "„Das Petermännchen ist der einzige Giftfisch, der in Norddeutschland vorkommt.“"
                            },
                            {
                                "example_id": "8b35180b-e94d-4266-854d-32c01a10b655",
                                "sense_id": "9daf6921-5949-36f1-9a76-636c5aa58427",
                                "text": "„Sie sehen unscheinbar aus und ihr Name klingt putzig, aber die Petermännchen (Trachinidae) gehören zu den gefährlichsten Gifttieren Europas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
