                                        "entry_id": "099ba577-83b6-3370-bd08-eec30cc42331",
                                        "glosses": [
                                            "so, dass man nicht hindurch oder vorbei kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339de108-3301-4493-b505-f6215881369a",
                                                "sense_id": "14b9efea-7a96-33fa-9379-192c35c58a1c",
                                                "text": "Der Eingang in die Höhle ist seit dem Felssturz unpassierbar."
                                            },
                                            {
                                                "example_id": "d74baf9c-d9b4-413f-99e3-854ea2684008",
                                                "sense_id": "14b9efea-7a96-33fa-9379-192c35c58a1c",
                                                "text": "„Offenbar gehörte nicht viel dazu, eine Stadt wie Berlin lahmzulegen. Ein paar unpassierbare Straßen und schon drohte der Kollaps.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e7003e4-cb61-4a9a-afe9-88a317dbba4e",
                        "source_entry_id": "72e7d697-1410-3bd1-b4ab-7bc3e8e16bcb",
                        "source_sense_description": "incapable of being passed over, crossed, or negotiated",
                        "target_lang_word": "unüberwindbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unüberwindbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2beb1c0-a635-300a-964c-60809035e84b",
                                        "entry_id": "fbb18d4e-ecbf-362f-bb84-4d37abe8b117",
                                        "glosses": [
                                            "so, dass es nicht überwunden werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab51b45-4fd0-4e63-82af-ef7f6f4fd062",
                                                "sense_id": "d2beb1c0-a635-300a-964c-60809035e84b",
                                                "text": "„Dennoch scheute er auch jetzt vor offener Empörung zurück. Fehlte dem 75jährigen nur die Jugend? Oder war in ihm die Hemmung des Royalisten unüberwindbar?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed4c8e4-f781-4768-8f30-ae589dd5208e",
                        "source_entry_id": "72e7d697-1410-3bd1-b4ab-7bc3e8e16bcb",
                        "source_sense_description": "incapable of being passed over, crossed, or negotiated",
                        "target_lang_word": "unüberwindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unüberwindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                        "entry_id": "b8859d59-4007-3af5-8122-14e23ac9ff57",
                                        "glosses": [
                                            "so, dass es nicht überwunden werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3773f85-3d3f-4451-953c-0d971250807c",
                                                "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                                "text": "„Eva seufzte. Es war nur noch eine halbe Stunde bis zum Schluß der Nachtschicht, aber diese halbe Stunde schien vollkommen unüberwindlich. Sie dachte an das Bett, an das schöne, warme Bett, an Schlaf und Vergessenheit.“"
                                            },
                                            {
                                                "example_id": "9d7155e1-0e5e-44a5-a19e-ea5673983c0c",
                                                "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                                "text": "„Immer nannte er den Verstand kalt, und nur das Herz wirkend und schaffend. Daher hatte er ein unüberwindliches Mißtrauen gegen jenen, und hingegen ein ebenso unerschütterliches Vertrauen zu diesem gefaßt.“"
                                            },
                                            {
                                                "example_id": "a64c04c9-b793-4bb5-9903-579774fc82e8",
                                                "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                                "text": "„„O!“ rief einer aus der Gesellschaft lachend: „das war in dem finstern Zeitalter guter Ton, als die Fürsten noch böse wurden, wenn man sie nicht die allergnädigsten, großmächtigsten, unüberwindlichsten nannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
