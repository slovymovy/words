                ],
                "senses": [
                    {
                        "sense_id": "f4046e8d-160c-3f68-b443-edad968828c1",
                        "entry_id": "7f443951-c4bb-38c2-97ff-97c942717fd9",
                        "glosses": [
                            "Körperreinigung, Körperpflege und Ankleiden am Morgen"
                        ],
                        "tags": [
                            "gehoben",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2f94ce87-6c29-4c1a-94ff-e292f979020f",
                                "sense_id": "f4046e8d-160c-3f68-b443-edad968828c1",
                                "text": "„Der Vater führt ein pünktlich genaues Leben, in dem vom Zeremoniell der Morgentoilette bis zum täglichen Spaziergang im Kurgarten von Bad Ems alles streng geregelt ist.“"
                            },
                            {
                                "example_id": "63e516e5-4f2b-4f1e-8270-f95e5e56255c",
                                "sense_id": "f4046e8d-160c-3f68-b443-edad968828c1",
                                "text": "„Galilei befindet sich in einem Zimmer und ist gerade mit seiner Morgentoilette beschäftigt.“"
                            },
                            {
                                "example_id": "f1f32844-c44d-4382-84fc-ae0a14245d66",
                                "sense_id": "f4046e8d-160c-3f68-b443-edad968828c1",
                                "text": "„Das detailreiche Zeremoniell der Morgentoilette des Herrschers nimmt seinen Gang, ohne daß die zahlreichen Mitglieder des Hofes das königliche Gemach verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30a1dfea-ee9e-35de-99cc-be9a5a16554b",
                        "entry_id": "7f443951-c4bb-38c2-97ff-97c942717fd9",
                        "glosses": [
                            "Kleidung am Morgen (für die Frau)"
                        ],
                        "tags": [
                            "gehoben",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "b2db7a07-c600-4ac0-8112-422a61b843ba",
                                "sense_id": "30a1dfea-ee9e-35de-99cc-be9a5a16554b",
                                "text": "„Die Regierungsrätin hatte trotz ihrer Kopfschmerzen jedenfalls hinter einem der Rouleaus auf der Lauer gestanden und die Zurückkehrenden erwartet, denn als sie die Hausflur betraten, kam die junge Witwe zwar mit erdfahlen Wangen und eingesunkenen Augen, aber trotzdem in äußerst geschmackvoller Morgentoilette die Treppe herab, um nach dem Ergebnis zu fragen.“"
                            },
                            {
                                "example_id": "335e40ff-ac12-4d7a-a8f3-3ff8c1961431",
                                "sense_id": "30a1dfea-ee9e-35de-99cc-be9a5a16554b",
                                "text": "„Als Morgentoilette wird die Dame ein paar wollene Kleider mit dazu passender Jacke nötig haben.“"
                            },
                            {
                                "example_id": "b440a56d-fddf-43c5-9362-a5499cfe1d24",
                                "sense_id": "30a1dfea-ee9e-35de-99cc-be9a5a16554b",
                                "text": "„Zum Empfange der deutschen Majestäten werden Kaiser Franz Josef und die Erzherzoge in Gala-Uniform und die Erzherzoginnen in Morgentoiletten erscheinen.“"
                            },
                            {
                                "example_id": "df4f1242-ced3-449d-8042-90dc260ca1ca",
                                "sense_id": "30a1dfea-ee9e-35de-99cc-be9a5a16554b",
                                "text": "„Helene sah sehr hübsch aus, wozu nicht nur die kleidsame Morgentoilette, sondern auch eine gewisse Belebtheit in ihren sonst matten und beinah vergißmeinnichtblauen Augen ein Erhebliches beitrug.“"
                            },
                            {
                                "example_id": "29279295-72de-4ab9-b976-65134377cbe2",
                                "sense_id": "30a1dfea-ee9e-35de-99cc-be9a5a16554b",
                                "text": "„Sie sah reizend in der hellen Morgentoilette aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
