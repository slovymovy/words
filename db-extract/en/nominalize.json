                    {
                        "sense_id": "411a3b1f-3e0a-34da-b9ea-e3755e040531",
                        "entry_id": "3358e39b-3864-3ee4-af87-07cd72030ca4",
                        "glosses": [
                            "To use as or change into a noun, often by affixing a morpheme."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "dc991475-dea6-43b3-9737-148ebb10442e",
                                "sense_id": "411a3b1f-3e0a-34da-b9ea-e3755e040531",
                                "text": "To nominalize an adjective that refers to a known noun, the articles el, la, los, and las are used (Unit 11 §59); to nominalize an adjective that does not refer to a known noun, the neuter article lo is used."
                            },
                            {
                                "example_id": "a2e9f773-6913-4eac-b28f-0a1d05ad635c",
                                "sense_id": "411a3b1f-3e0a-34da-b9ea-e3755e040531",
                                "text": "But, Dretske asks, what happens when we nominalize a propositional allomorph?"
                            }
                        ]
                    },
