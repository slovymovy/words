                        "entry_id": "67642a93-a6d8-3a64-9bfa-b8f042cf7db6",
                        "glosses": [
                            "weibliches Fabelwesen mit menschlicher/menschenähnlicher Gestalt"
                        ],
                        "tags": [
                            "Fabelwesen",
                            "nordische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7b2bc7f8-475a-4ff7-865c-f5113a75cf74",
                                "sense_id": "6aab2500-90b7-3202-9c14-bc61d96b23cb",
                                "text": "„Sie ist ein verborgener Mensch, eine Elbin, eine Huldukona, die das Haar scheinen lässt.“"
                            },
                            {
                                "example_id": "29250069-1b89-4a7f-be76-3fb323e94a67",
                                "sense_id": "6aab2500-90b7-3202-9c14-bc61d96b23cb",
                                "text": "„In Laurins Berg, in der Frau Venus Berg rauscht fröhliche, verführerische Musik, Tänze werden darin getreten; der Elbinnen Gesänge locken Jünglinge auf den Berg, und es ist um sie geschehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
