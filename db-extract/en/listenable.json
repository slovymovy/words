                        "entry_id": "8e1dc520-d5f4-3d16-a4ce-97f025b58bce",
                        "glosses": [
                            "Pleasant or easy to listen to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761f9eba-2e65-4f6f-9548-9badf991a4a9",
                                "sense_id": "e0b9b9ee-c6db-3641-8f6b-1e85f87ea5fd",
                                "text": "Mozart's music was popular because he wrote listenable works."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bae2a32-de58-4e71-8352-59f7f55b175e",
                        "source_entry_id": "8e1dc520-d5f4-3d16-a4ce-97f025b58bce",
                        "source_sense_id": "e0b9b9ee-c6db-3641-8f6b-1e85f87ea5fd",
                        "source_sense_description": "pleasant or easy to listen to",
                        "target_lang_word": "écoutable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écoutable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "362f62ce-41a2-3158-b7b6-bd3acd708ada",
                                        "entry_id": "10ac4f83-8b36-3442-baa4-eb294ac1ca32",
                                        "glosses": [
                                            "Qui peut être écouté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412e1334-1122-4063-bef3-aa7fcb73cfd5",
                                                "sense_id": "362f62ce-41a2-3158-b7b6-bd3acd708ada",
                                                "text": "Créer un standard écoutable quel que soit le support (mobile, PC) ou le logiciel (iTunes, Windows Media Player…) utilisés. « Techniquement, c’est faisable, économiquement, c’est un autre problème », explique le SNEP […]."
                                            },
                                            {
                                                "example_id": "5e918554-42c6-4901-adc5-f92c800d83cf",
                                                "sense_id": "362f62ce-41a2-3158-b7b6-bd3acd708ada",
                                                "text": "Le 1ᵉʳ podcast du Repaire des Motards est donc désormais en ligne et disponible et écoutable sur Spotify, Apple Podcasts, Google Podcast, Anchor, Podcast addict dans un premier temps et bientôt sur les autres plateformes de musique comme Deezer... en fonction des délais propres à chaque plate-forme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605c96fb-6209-3e27-a6af-a8473daefe8c",
                                        "entry_id": "10ac4f83-8b36-3442-baa4-eb294ac1ca32",
                                        "glosses": [
                                            "Qui est digne d’être écouté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b324bd8-82a6-40e3-96bf-358837d1fec9",
                                                "sense_id": "605c96fb-6209-3e27-a6af-a8473daefe8c",
                                                "text": "et l’histoire la plus claire, celle que dix millions de martyrs ont écrite avec leur sang, a fait de Jésus-Christ la personne la plus visible, la plus tangible et la plus écoutable, si notre langue veut accepter ce mot, qui figure dans toutes ses annales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16e0c71-9470-3f5c-bd77-970f1fe17e8a",
                                        "entry_id": "10ac4f83-8b36-3442-baa4-eb294ac1ca32",
                                        "glosses": [
                                            "Dont la demande mérite d’être entendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258b705c-5120-4207-a299-2c4e78189d0d",
                                                "sense_id": "e16e0c71-9470-3f5c-bd77-970f1fe17e8a",
                                                "text": "Celui qui par lettre scellée sera trouvé redevable de quelque chose, n’est écoutable dans aucune exception, sinon celle de paiement."
                                            },
                                            {
                                                "example_id": "3042d1ae-567a-48d6-a42d-bc60a747873d",
                                                "sense_id": "e16e0c71-9470-3f5c-bd77-970f1fe17e8a",
                                                "text": "S’il existe une condamnation de dommages-intérêts au profit de la veuve Braem, que ne les a-t-elle fait régler ? Elle en a eu la faculté. Jusques-là, elle n’est pas écoutable dans ses prétentions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a712b4a-ba3c-32cb-99cf-0fa3216ddb9c",
                                        "entry_id": "10ac4f83-8b36-3442-baa4-eb294ac1ca32",
                                        "glosses": [
                                            "Qui mérite passablement d’être écouté."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc6b829-856b-4e58-9e61-ef48e767c3c0",
                                                "sense_id": "1a712b4a-ba3c-32cb-99cf-0fa3216ddb9c",
                                                "text": "Dans d’autres cas, la forme simple peut être plus évidente pragmatiquement : -Ces trois disques, c’est pas essentiel, mais c’est très écoutable-."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
