                                        "entry_id": "a8959bf8-1e46-3d77-9143-7cc39a419b0a",
                                        "glosses": [
                                            "Either of two small woodpeckers, Jynx torquilla and Jynx ruficollis, of the Old World, that turn their heads almost 180 degrees when foraging."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "422eaa5e-dc3f-361a-a515-8099ec945f5f",
                                        "entry_id": "a8959bf8-1e46-3d77-9143-7cc39a419b0a",
                                        "glosses": [
                                            "A twisted or distorted neck; a deformity in which the neck is drawn to one side by a rigid contraction of one of the muscles."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
