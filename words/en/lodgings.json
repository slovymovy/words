    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5bdf01c-489a-33df-9d0f-9acac82de573",
                    "sense_definition": "A room or set of rooms in another person's house where a person lives temporarily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student found affordable <w>lodgings</w> near the university campus for the semester.",
                            "target_lang_translations": {
                                "nl": "De student vond betaalbaar <w>onderdak</w> nabij de universiteitscampus voor het semester."
                            }
                        },
                        {
                            "text": "They moved into their new <w>lodgings</w> while waiting for their permanent house to be ready.",
                            "target_lang_translations": {
                                "nl": "Ze trokken in hun nieuwe <w>onderkomen</w> terwijl ze wachtten tot hun permanente woning klaar was."
                            }
                        }
                    ],
                    "synonyms": [
                        "digs"
                    ],
                    "common_phrases": [
                        "temporary lodgings",
                        "find lodgings"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kamer of set kamers in het huis van iemand anders waar iemand tijdelijk verblijft."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onderdak",
                                "target_lang_sense_clarification": "algemene term voor een tijdelijke verblijfplaats"
                            },
                            {
                                "target_lang_word": "kamer",
                                "target_lang_sense_clarification": "specifiek een gehuurde kamer in een huis"
                            },
                            {
                                "target_lang_word": "kost en inwoning",
                                "target_lang_sense_clarification": "wanneer men ergens verblijft inclusief maaltijden"
                            }
                        ]
