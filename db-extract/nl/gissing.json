                "senses": [
                    {
                        "sense_id": "4100045b-aafd-339c-ac4e-80d84c85df59",
                        "entry_id": "097d3a04-5a92-342e-ace4-0d5c6d7c7626",
                        "glosses": [
                            "gedachte waarvoor men onvoldoende gegevens heeft om de juistheid of onjuistheid ervan te kunnen vaststellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad493074-0844-4614-b945-fbcf70038938",
                                "sense_id": "4100045b-aafd-339c-ac4e-80d84c85df59",
                                "text": "Maar een bedrijf met 1 miljard klanten en 150 miljard euro in kas zal toch wel een goede klantenservice hebben? Nee. Er is Apple Support Communities, en hoewel dat forum keurig is vormgegeven in de huisstijl, komt er geen Apple-medewerker aan te pas. Je kunt je probleem voorleggen aan andere gebruikers! Die óók op zoek zijn naar een oplossing, voor hún probleem! De informatie bestaat voor 90 procent uit gissingen, vermoedens, kletspraat en gekissebis tussen leken die het beter denken te weten dan andere leken. En ergens in die brij zit misschien de oplossing, maar misschien ook niet. Je weet het niet, want het rijkste bedrijf ter wereld is te gierig om zijn klanten te helpen."
                            },
                            {
                                "example_id": "452e87d3-7ad1-4689-a5e8-a394d904d320",
                                "sense_id": "4100045b-aafd-339c-ac4e-80d84c85df59",
                                "text": "Met zo weinig om zeker over te zijn moeten wetenschappers dikwijls hun veronderstellingen baseren op andere objecten die in de omgeving gevonden zijn, en daarbij gaat het misschien om niet meer dan heldhaftige gissingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2832adf7-29ad-4d5e-81ca-f799be1b721c",
                        "source_entry_id": "097d3a04-5a92-342e-ace4-0d5c6d7c7626",
                        "source_sense_id": "4100045b-aafd-339c-ac4e-80d84c85df59",
                        "source_sense_description": "gedachte waarvoor men onvoldoende gegevens heeft om de juistheid of onjuistheid ervan te kunnen vaststellen",
                        "target_lang_word": "guess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b12137c8-5ff9-3bcd-9d15-6d250252490f",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To reach a partly (or totally) unconfirmed conclusion; to engage in conjecture; to speculate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d53f432-f88d-421c-8d0d-2adb7cd15164",
                                                "sense_id": "b12137c8-5ff9-3bcd-9d15-6d250252490f",
                                                "text": "We can only guess at what was going through her mind."
                                            },
                                            {
                                                "example_id": "77c31abe-bd15-410c-b385-45ba3f9e2d30",
                                                "sense_id": "b12137c8-5ff9-3bcd-9d15-6d250252490f",
                                                "text": "She guessed that the delivery driver must have got stuck in traffic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To solve by a correct conjecture; to conjecture rightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f832cca2-142e-4c8b-a80b-ba3724f68cd6",
                                                "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                                "text": "He who guesses the riddle shall have the ring."
                                            },
                                            {
                                                "example_id": "0393150c-c6aa-4e56-aaa4-5e8ab40525af",
                                                "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                                "text": "You guessed the right answer!"
                                            },
                                            {
                                                "example_id": "811df0ec-1c06-4f26-86c9-017f5105ff18",
                                                "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                                "text": "You will never guess what happened next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "to suppose, to imagine (introducing a proposition of uncertain plausibility)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d59b23-7c8e-4af2-8531-ec81945bb415",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "That album is quite hard to find, but I guess you could try ordering it online."
                                            },
                                            {
                                                "example_id": "3580b20e-ecc3-432f-a990-8aed62fca577",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "Not all together; better far, I guess, / That we do make our entrance several ways."
                                            },
                                            {
                                                "example_id": "89c8cb3c-d5d6-41fa-b036-631497c84914",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "But in known images of life I guess / The labour greater."
                                            },
                                            {
                                                "example_id": "d09dc485-6317-4f7f-b834-15340f61415a",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "\"Are you a member of the union?\"\n\"Sure.\"\n\"Then you'll get your job, I guess. Have you any friends?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a187c12-f2bc-3d8a-bc32-a0e492a69e69",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To think, conclude, or decide (without a connotation of uncertainty). Usually in first person: \\\"I guess\\\"."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451fad31-0813-43aa-893a-db9c13a3d9ad",
                                                "sense_id": "4a187c12-f2bc-3d8a-bc32-a0e492a69e69",
                                                "text": "\"I guess you were right.\" \"What did he say?\" \"He guesses you were right.\""
                                            },
                                            {
                                                "example_id": "1a6be814-ffa5-4693-af90-dc3d9b1c17b9",
                                                "sense_id": "4a187c12-f2bc-3d8a-bc32-a0e492a69e69",
                                                "text": "\"I guess I'll go to bed.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d2a2bf7-8a10-35ec-ab82-07f0f7de56ca",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To hit upon or reproduce by memory."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1755362b-d212-4486-88dc-61d4816b08de",
                                                "sense_id": "5d2a2bf7-8a10-35ec-ab82-07f0f7de56ca",
                                                "text": "Tell me their words, as near as thou canst guess them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                        "entry_id": "e0c50fe7-c266-3298-9c14-0ec0c08bf077",
                                        "glosses": [
                                            "A prediction about the outcome of something, typically made without factual evidence or support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbba3d86-fe31-496f-b81b-341d22a60fd3",
                                                "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                                "text": "If you don't know the answer, take a guess."
                                            },
                                            {
                                                "example_id": "22ad0faa-9352-4968-9fa7-065777050031",
                                                "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                                "text": "\"But I shall have eleven guesses,\" answered Ozma. \"Surely I ought to guess one object in eleven correctly; and, if I do, I shall rescue one of the royal family and be safe myself. Then the rest of you may attempt it, and soon we shall free all those who are enslaved.\""
                                            },
                                            {
                                                "example_id": "99aa70a8-d5e0-4e31-8b20-d5b132617cc2",
                                                "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                                "text": "We are twelve billion light years from the edge / That's a guess"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6cdcbc2-5870-472d-8f35-cff924cb6fd0",
                        "source_entry_id": "097d3a04-5a92-342e-ace4-0d5c6d7c7626",
                        "source_sense_id": "4100045b-aafd-339c-ac4e-80d84c85df59",
