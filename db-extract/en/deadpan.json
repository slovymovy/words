                                "example_id": "e1aa5492-1436-4a4d-af2a-4358c30801b6",
                                "sense_id": "ac14143b-55f2-3ee4-88ab-ecf2addd59c6",
                                "text": "The completely deadpan description of the horrible violence left the listeners with a cold feeling in their stomach."
                            }
                        ]
