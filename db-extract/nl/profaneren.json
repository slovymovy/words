                    },
                    {
                        "translation_id": "b478e14e-0f20-4a67-b4ef-b8ff70156af5",
                        "source_entry_id": "82de3ae3-4a4f-351d-ae9b-4e25544ddb37",
                        "source_sense_id": "c0941afe-23ea-339a-84ff-c8c7d169a182",
                        "source_sense_description": "spotten met iets dat heilig is",
                        "target_lang_word": "profane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "319e0ec4-a605-3371-8db1-0ef909fe9a4c",
                                        "entry_id": "3bef4320-e75b-32d4-b3a6-67d660952dd8",
                                        "glosses": [
                                            "Unclean; ritually impure; unholy, desecrating a holy place or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ebf16d-40ce-4bd7-92b8-81146c28fb10",
                                                "sense_id": "319e0ec4-a605-3371-8db1-0ef909fe9a4c",
                                                "text": "Nothing is profane that serveth to the use of holy things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d55da31-67ba-35a8-9311-71d12abf7ee1",
                                        "entry_id": "3bef4320-e75b-32d4-b3a6-67d660952dd8",
                                        "glosses": [
                                            "Not sacred or holy, unconsecrated; relating to non-religious matters, secular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9079e65-f500-4469-b5fe-31e3dd74291a",
                                                "sense_id": "6d55da31-67ba-35a8-9311-71d12abf7ee1",
                                                "text": "profane authors"
                                            },
                                            {
                                                "example_id": "c5eae635-43c3-4ee4-96f0-a50d58051cfd",
                                                "sense_id": "6d55da31-67ba-35a8-9311-71d12abf7ee1",
                                                "text": "A sonnet in praise of Rome was accepted as the effusion of genius and gratitude; and after the whole procession had visited the Vatican, the profane wreath was suspended before the shrine."
                                            },
                                            {
                                                "example_id": "1fb620f7-e399-4c29-b5f1-ed5c1d19a239",
                                                "sense_id": "6d55da31-67ba-35a8-9311-71d12abf7ee1",
                                                "text": "The sacred is the emotional force which connects the part to the whole; the profane or the secular is that which has been broken off from, or has fallen off, its emotional bond to the universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7ec957-e697-30b0-88a2-da21a0aa13b3",
                                        "entry_id": "3bef4320-e75b-32d4-b3a6-67d660952dd8",
                                        "glosses": [
                                            "Treating sacred things with contempt, disrespect, irreverence, or scorn; blasphemous, impious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b15f74a8-f27d-39cc-80c8-054f49c7a29f",
                                        "entry_id": "3bef4320-e75b-32d4-b3a6-67d660952dd8",
                                        "glosses": [
                                            "Irreverent in language; taking the name of God in vain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ba7cb9-7acd-4d53-8174-fd80d82c54b9",
                                                "sense_id": "b15f74a8-f27d-39cc-80c8-054f49c7a29f",
                                                "text": "a profane person, word, oath, or tongue"
                                            },
                                            {
                                                "example_id": "855b7bf0-7dd6-4330-ad22-baecd3dff706",
                                                "sense_id": "b15f74a8-f27d-39cc-80c8-054f49c7a29f",
                                                "text": "the law is not laid down for the just but for the lawless and disobedient, for the ungodly and sinners, for the unholy and profane"
                                            },
                                            {
                                                "example_id": "154b00d5-d8fb-465f-9f3e-dc7fd472b1ac",
                                                "sense_id": "b15f74a8-f27d-39cc-80c8-054f49c7a29f",
                                                "text": "When asked to explain why he became a landlord, he told the Archbishop of York it was so he could close the pub on Sundays, and suppress the profane language and singing that came through the bar windows."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "profane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd317993-3538-3cac-91cf-ae6d906a5b8b",
                                        "entry_id": "7f1118f8-f061-3705-920b-6f7719aacae4",
                                        "glosses": [
                                            "A person or thing that is profane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da64b57-d4fb-413d-b73d-4c8aee2f47d5",
                                                "sense_id": "bd317993-3538-3cac-91cf-ae6d906a5b8b",
                                                "text": "The nuns were employed in religious duties established in honour of St Clare, and to which no profane was ever admitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d19c6ac1-2e36-3a3a-bf17-4ffca0648303",
                                        "entry_id": "7f1118f8-f061-3705-920b-6f7719aacae4",
                                        "glosses": [
                                            "A person not a Mason."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "profane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc17b611-f825-3f42-b533-892d3b4bc6c0",
                                        "entry_id": "60435161-8cff-3685-9814-dcab262453ea",
                                        "glosses": [
                                            "To violate (something sacred); to treat with abuse, irreverence, obloquy, or contempt; to desecrate"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84c33b4-beba-458f-afe9-ec511d109154",
                                                "sense_id": "bc17b611-f825-3f42-b533-892d3b4bc6c0",
                                                "text": "One should not profane the name of God."
                                            },
                                            {
                                                "example_id": "3952e685-e832-45e9-8fd4-78b56ac5ccf4",
                                                "sense_id": "bc17b611-f825-3f42-b533-892d3b4bc6c0",
                                                "text": "to profane the Scriptures"
                                            },
                                            {
                                                "example_id": "f7f2f489-720b-4f86-af14-55aaa0e839ab",
                                                "sense_id": "bc17b611-f825-3f42-b533-892d3b4bc6c0",
                                                "text": "VVhen the vulgar ſort / Sit on their Ale-bench, vvith their cups and kannes, / Matters of ſtate be not their common talke, / Nor pure religion by their lips prophande."
                                            },
                                            {
                                                "example_id": "4fd9e190-199d-4944-8356-9cc6871ecd56",
                                                "sense_id": "bc17b611-f825-3f42-b533-892d3b4bc6c0",
                                                "text": "With one mind, their intent eyes all fastened upon the old man’s knife, as he carved the chief dish before him. I do not suppose that for the world they would have profaned that moment with the slightest observation, even upon so neutral a topic as the weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d98dcc9-8607-352f-9a36-7de169c2bdd6",
                                        "entry_id": "60435161-8cff-3685-9814-dcab262453ea",
                                        "glosses": [
                                            "To put to a wrong or unworthy use; to debase; to abuse; to defile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
