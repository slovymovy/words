                        "examples": [
                            {
                                "example_id": "3dfef2de-fda4-492b-905b-f3868a6c2f26",
                                "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                "text": "„Eine Antwortmöglichkeit »Salafi«, »Salafitin« oder »Salafist«, »Salafistin« war hierbei nicht vorgesehen.“"
                            },
                            {
                                "example_id": "b1ae437d-b85b-4a5c-b3d4-7d6382fab556",
                                "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                "text": "„In einem Missionierungsgespräch im Internet spricht die Salafistin von dem Leid der Muslime und der Pflicht nach Syrien oder nach Afghanistan zu gehen.“"
                            },
                            {
                                "example_id": "f4c281e7-2d74-4ec4-81ee-9f03438e4111",
                                "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                "text": "Sie wäre gerne Salafistin geworden und so wie ihr Bruder missionierend durch die Einkaufsstraßen gezogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
