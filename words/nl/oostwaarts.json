                    "frequency": "Low",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>oostwaartse</w> stroming van de rivier is erg sterk vandaag.",
                            "target_lang_translations": {
                                "en": "The <w>eastward</w> current of the river is very strong today.",
                                "ru": "<w>Восточное</w> течение реки сегодня очень сильное."
                            }
                        },
                        {
                            "text": "Zij volgden een <w>oostwaartse</w> route door de uitgestrekte woestijn.",
                            "target_lang_translations": {
                                "en": "They followed an <w>easterly</w> route through the vast desert.",
                                "ru": "Они следовали <w>восточным</w> маршрутом через бескрайнюю пустыню."
                            }
                        }
