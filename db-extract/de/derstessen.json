                        "form": "haben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a653502d-271c-3f27-aea1-7782c59bb90b",
                        "entry_id": "76604c7a-0961-3880-934a-216fed53e93a",
                        "glosses": [
                            "sich stoßen, an etwas anstoßen, stolpern, stürzen"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "be3628e1-9b52-4565-8d9d-7237cd5ca30e",
                                "sense_id": "a653502d-271c-3f27-aea1-7782c59bb90b",
                                "text": "„Ich dachte eher an den nicht funktionierenden Stiegenlift – und an einen 90-jährigen, der da im Dunkeln eine Stiege zu bezwingen versucht, die (hatten die Stiegenlifteinbauer jedenfalls gesagt) nach heutiger Bauordnung so nie gebaut werden dürfte und über die wir uns als Kinder oft genug derstessen hatten.“"
                            },
                            {
                                "example_id": "2fb6eed3-81b6-4564-981a-b59ea5aafab5",
                                "sense_id": "a653502d-271c-3f27-aea1-7782c59bb90b",
                                "text": "„Ich sehe schon, da haben wir viel zu wenig Platz. Außerdem habe ich meine Patschen an, da derstess ich mich ja in einer Tour.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c9ffde7-4911-3a01-b5e2-ae97dc00f2fa",
                        "entry_id": "76604c7a-0961-3880-934a-216fed53e93a",
                        "glosses": [
                            "scheitern"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "d714cc58-65a6-4fd0-a956-98850fab4528",
                                "sense_id": "2c9ffde7-4911-3a01-b5e2-ae97dc00f2fa",
                                "text": "„Oder ist \"Inklusion\" so zu verstehen: Man hängt sie den Volks- und Mittelschullehrerinnen um, und die sollen sich dann derstessen...?“"
                            },
                            {
                                "example_id": "2581e305-d3c1-4eeb-8489-8ff84856561b",
                                "sense_id": "2c9ffde7-4911-3a01-b5e2-ae97dc00f2fa",
                                "text": "„Da haben einige hinterlistig gemeint: „No, des soll der Kreisky machen!“ Insgeheim hofften sie natürlich, dass ich mich dabei „derstess'n“ werde, wie man auf wienerisch sagt, weil sich dort noch jeder „derstess'n“ hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "07b46fff-8767-3340-9629-36955bcd83b0",
                        "entry_id": "76604c7a-0961-3880-934a-216fed53e93a",
                        "glosses": [
                            "tödlich verunglücken, durch einen Unfall zu Tode kommen"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "caa686b5-4f18-4dc8-95e1-1f6969907a72",
                                "sense_id": "07b46fff-8767-3340-9629-36955bcd83b0",
                                "text": "„Die Autofahrerinnen werden das wieder einmal nicht gerne hören, aber: das hat keine Art, wie sich die Radfahrer auf dem ein Meter breiten Radstreifen, der sich um die Laternenpfähle schlängelt, fast derstessen, während nebenan die Pkw auf sechs Spuren fahren.“"
                            },
                            {
                                "example_id": "b764880d-aa1a-48fa-8025-8b3e81a5f98d",
                                "sense_id": "07b46fff-8767-3340-9629-36955bcd83b0",
                                "text": "„Aufpassen muss man freilich auch am Gratlspitz. Man kann auch da zu Schaden kommen, wenn man stolpert. Es gibt einige Extrembergsteiger, die sich im leichten Gelände derstessen haben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
