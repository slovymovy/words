                                "example_id": "1ea7709d-28da-4a55-93e1-c8a8500fb13c",
                                "sense_id": "30510a0d-511c-3604-b99c-3bb36122c83a",
                                "text": "Neuf Cegetel retarifie et dégroupe en zones non dégroupées."
