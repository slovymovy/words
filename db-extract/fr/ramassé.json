                        "entry_id": "ddd83010-25c0-36e3-b37f-2f90040da747",
                        "glosses": [
                            "Qui est compact, resserré."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "179fe700-4d1c-4990-9f36-43bbee7375f2",
                                "sense_id": "c687b34b-62c4-320f-844a-e176ba66c213",
                                "text": "Et puis voici un populeux village, un village compact, ramassé, aux ruelles étroites et tortueuses, sans jardins, sans courtils, un village serré autour de son antique clocher."
                            }
                        ]
                    }
