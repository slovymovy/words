                ],
                "senses": [
                    {
                        "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                        "entry_id": "d486557c-b2db-3175-ba8f-f2aa5bf12faf",
                        "glosses": [
                            "Vorrichtung (= Filter) zur Aussonderung unerwünschten Rußes aus durchströmendem Abgas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58bac541-5ffb-48c5-be72-2a2b8e04698e",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "[Schlagzeile:] „Diesel-Autos ohne Rußfilter verlieren deutlich an Wert“"
                            },
                            {
                                "example_id": "3a7638d0-2355-4568-84e0-97d61148f9db",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "„Heute werden die meisten Dieselmotoren für Kraftfahrzeuge produziert. Dank Leichtbauweise, Turbolader und Rußfilter ist er heute ein ernsthafter Konkurrent des Otto-Motors.“"
                            },
                            {
                                "example_id": "7b5648f3-7d8c-44b4-adba-62cf3e16fa00",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "„Um einem Fahrverbot für Diesel-Fahrzeuge zu entgehen, rüstet die Stadt Aachen alle ASEAG-Busse um. Sie werden mit modernen Rußfiltern ausgestattet und sollen dadurch deutlich sauberer sein.“"
                            },
                            {
                                "example_id": "41af7c77-9dca-41f7-95dd-9844269a8883",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "Ihr Problem: Je sauberer die Ingenieure den Diesel machen, desto schneller verstopft der Rußfilter."
                            },
                            {
                                "example_id": "d46fb2be-08f0-4671-b537-e6f52d98760a",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "„»Sie [Anmerkung: die Automobilfirmen in Deutschland] waren zum Beispiel gegen den Katalysator, sie waren gegen den Rußfilter, sie waren gegen Hybridfahrzeuge und gegen Elektroautos.«“"
                            },
                            {
                                "example_id": "f1291825-6151-4c40-8e4a-bae51ac39566",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "„Die Bundesregierung fördert es, wenn Autofahrer in die Dieselmotoren ihrer Autos Rußfilter einbauen lassen. Diese finanzielle Unterstützung ist gerade erst verlängert worden.“"
                            },
                            {
                                "example_id": "74c1b815-de4e-410f-a986-4cd562160d52",
                                "sense_id": "6af00bb7-c065-327e-ad67-131d16b85c8d",
                                "text": "„[…] man [kann] je nach Bedarf aus Keramik Hüftknochenimplantate, Rußfilter für den Auspuff, Zahn-Inlays oder Hitzeschilde für \"Space Shuttles\" herstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
