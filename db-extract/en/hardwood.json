                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "6edf1a56-f802-456d-a267-e722cc868a25",
                                "sense_id": "03fa0c22-0bb5-3460-879c-c4dfd46ff4bd",
                                "text": "Ash, hickory and oak are some of the most prominent domestic hardwoods."
                            },
                            {
                                "example_id": "31974cf2-1f8b-4157-b2c9-1fe79d0f5d56",
                                "sense_id": "03fa0c22-0bb5-3460-879c-c4dfd46ff4bd",
                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4db62ab-eee0-3b9d-973f-985bc9b34cc5",
                        "entry_id": "ec4c6a1d-0b93-3d71-ab80-ad15f07b8097",
                        "glosses": [
                            "The tree or tree species that yields the preceding."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d0c36e4-af21-43db-8ff0-0762e2fb74f4",
                                "sense_id": "e4db62ab-eee0-3b9d-973f-985bc9b34cc5",
                                "text": "This hardwood has been planted extensively throughout the hills here."
                            }
                        ]
                    },
                    {
                        "sense_id": "f69d0005-9ffc-3944-8033-8650fecf044e",
                        "entry_id": "ec4c6a1d-0b93-3d71-ab80-ad15f07b8097",
                        "glosses": [
