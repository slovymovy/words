                    "sense_definition": "Helemaal nat of van vocht doordrongen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de langdurige regen was ik helemaal <w>doorweekt</w>.",
