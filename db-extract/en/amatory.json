                        "sense_id": "e5c7932e-0dc0-3558-b62c-d7f1598c0a2a",
                        "entry_id": "0c91e1e9-8b78-301f-b865-6f4d92d7e75b",
                        "glosses": [
                            "Of or relating to love, especially sexual love."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f9b7b0a-8c43-4eb7-8b6f-4d6095c4bd53",
                                "sense_id": "e5c7932e-0dc0-3558-b62c-d7f1598c0a2a",
                                "text": "Eggs, oysters, too, are amatory food; / But who is their purveyor from above / Heaven knows […]"
                            },
                            {
                                "example_id": "48846ef9-2cae-41c2-a6a0-d728b938b3c1",
                                "sense_id": "e5c7932e-0dc0-3558-b62c-d7f1598c0a2a",
                                "text": "In the desperate search for amatory satisfactions, the most monstrous ingredients have throughout the ages, been sought and compounded into electuaries and pastilles, philtres and ointments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67464a29-40e1-412f-94a3-a95711b16c49",
                        "source_entry_id": "0c91e1e9-8b78-301f-b865-6f4d92d7e75b",
                        "source_sense_id": "e5c7932e-0dc0-3558-b62c-d7f1598c0a2a",
                        "source_sense_description": "of or relating to love, especially sexual love",
                        "target_lang_word": "amatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "101ef157-9cfe-33a2-9035-af54f1be0866",
                                        "entry_id": "ca3b40b2-9da0-37b3-80e4-7e1278d64b3b",
                                        "glosses": [
                                            "Relatif à l’amour, qui provoque l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b261a29-f1d5-4b56-95f7-a4af81664e9a",
                                                "sense_id": "101ef157-9cfe-33a2-9035-af54f1be0866",
                                                "text": "Le Diable gratifie ses disciples les plus méritants du souffle amatoire qui permet d’attirer sans la moindre résistance les filles et les femmes mariées dont ils convoitent la jouissance."
                                            },
                                            {
                                                "example_id": "88ccd266-6692-4bbc-9517-727bfcb7f7d3",
                                                "sense_id": "101ef157-9cfe-33a2-9035-af54f1be0866",
                                                "text": "Les recettes amatoires donnent, dit-on, les moyens de posséder une femme ou un homme. Ce sont des recettes d’amour plus que de virilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b19c9cb-7c83-30c4-b056-f43426b02947",
                                        "entry_id": "ca3b40b2-9da0-37b3-80e4-7e1278d64b3b",
                                        "glosses": [
                                            "Pubien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2cc1587-39fa-4171-950a-69417cc5796d",
                                                "sense_id": "5b19c9cb-7c83-30c4-b056-f43426b02947",
                                                "text": "Rien n’échappait à ce traitement : ni les sourcils ni les poils amatoires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
