                "senses": [
                    {
                        "sense_id": "7aa2b1a9-a736-3ee4-83a5-6db885567b78",
                        "entry_id": "1bdfb695-222e-3a48-9a1e-2cc5321730fe",
                        "glosses": [
                            "Mitglied einer sozialistischen oder sozialdemokratischen Partei, von den Grundsätzen des Sozialismus oder der Sozialdemokratie überzeugter Mensch"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "häufig abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "f0bed5f7-65f6-4bd5-a2af-3e1788b08188",
                                "sense_id": "7aa2b1a9-a736-3ee4-83a5-6db885567b78",
                                "text": "„Aber jetzt hätten die meisten Sozen am liebsten ein bewährtes bundesrepublikanisches Modell mit vertrauten Kräften aus FDP und Grünen.“"
                            },
                            {
                                "example_id": "5db45792-c49c-431f-9525-92dfc0645d88",
                                "sense_id": "7aa2b1a9-a736-3ee4-83a5-6db885567b78",
                                "text": "„Die Chefin braucht im Ringen mit den doofen Sozen größtmöglichen Rückhalt.“"
                            },
                            {
                                "example_id": "0ac9ce24-c5b6-4e2c-aa60-4f6d020d2f89",
                                "sense_id": "7aa2b1a9-a736-3ee4-83a5-6db885567b78",
                                "text": "„Doch für die Sozis, die die schwedische Politik wie vergleichsweise wohl keine andere Partei in einem europäischen Land über Jahrzehnte hinweg geprägt haben, war es gleichzeitig das schlechteste Wahlergebnis seit 96 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
