                "senses": [
                    {
                        "sense_id": "1121a67b-62f7-37c7-974a-a2b16ac7723f",
                        "entry_id": "b8126739-eb34-3755-a32d-d895d007fbff",
                        "glosses": [
                            "действие по значению гл. объяснять; растолковывание чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "601f7aae-4a39-4d6e-ad2b-93d31ae9f059",
                                "sense_id": "1121a67b-62f7-37c7-974a-a2b16ac7723f",
                                "text": "Объяснение причин задержки заняло буквально несколько секунд."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f4f60ab-26b0-3f6d-90f2-165566303756",
                        "entry_id": "b8126739-eb34-3755-a32d-d895d007fbff",
                        "glosses": [
                            "результат такого действия; информация, сведения, объясняющие что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ad9a8b-3d39-4066-8ffa-0e9cbda42d13",
                                "sense_id": "6f4f60ab-26b0-3f6d-90f2-165566303756",
                                "text": "Наука до сих пор не нашла объяснения феномену шаровой молнии."
                            }
                        ]
                    },
                    {
                        "sense_id": "82513efe-b1f7-3a1d-9910-0f01e2e28d42",
                        "entry_id": "b8126739-eb34-3755-a32d-d895d007fbff",
                        "glosses": [
                            "разг. то же, что признание в любви"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38ae070-e9ba-4c74-a11b-9c1eef84c3fd",
                                "sense_id": "82513efe-b1f7-3a1d-9910-0f01e2e28d42",
                                "text": "Она счастливо слушала его пылкие объяснения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd4ec6ca-1ee3-45cb-ad62-cd8daace033e",
                        "source_entry_id": "b8126739-eb34-3755-a32d-d895d007fbff",
                        "source_sense_description": "растолковывание",
                        "target_lang_word": "explanation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explanation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "The act or process of explaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60906a1d-055d-4ea9-9831-60470e103713",
                                                "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                                "text": "The explanation was long and drawn-out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "Something that explains or makes understandable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf764402-80f1-4def-944f-8a53943d6e83",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "An explanation for the UFO sightings was easily found."
                                            },
                                            {
                                                "example_id": "cd63b806-2b9c-4ecc-960a-4e7860d0e759",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "The socialist will, of course, see in this merely a proof that the more intelligent person is today bound to become a socialist. But this is far from being the necessary or even the most likely explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "A resolution of disputed points pursuant to discussion; a mutual clarification of disputed points; reconciliation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ace244-1b22-4335-8a9a-4abdf818a43f",
                                                "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                                "text": "This little explanation with Mr. Knightley gave Emma considerable pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73284b94-de1a-400b-b022-16c4cfaa9a4e",
                        "source_entry_id": "b8126739-eb34-3755-a32d-d895d007fbff",
                        "source_sense_description": "растолковывание",
                        "target_lang_word": "Erklärung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erklärung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b409592-2b1a-3306-a3a9-fe7b53e48b61",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "Aufschluss über Zusammenhänge, Sachverhalte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21bb7a45-4756-45d8-9b51-c2675e62a8f6",
                                                "sense_id": "9b409592-2b1a-3306-a3a9-fe7b53e48b61",
                                                "text": "Eine Bedienungsanleitung enthält eine Erklärung der Funktion des Gerätes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d345ad9-5400-364d-9261-f3cca285383c",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "offizielle Mitteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b3c1bb-93fa-4418-8937-f1cf3e5da66b",
                                                "sense_id": "3d345ad9-5400-364d-9261-f3cca285383c",
                                                "text": "In seiner Erklärung teilt der Minister mit, dass er an den bisherigen politischen Zielen festhalten wird."
                                            },
                                            {
                                                "example_id": "8e0d2d6d-5ca6-4fea-9002-d1e9f138acf7",
                                                "sense_id": "3d345ad9-5400-364d-9261-f3cca285383c",
                                                "text": "„Um eine solche Erklärung herbeizuführen, richtete sie es so ein, dass die jungen Leute vor dem Hochamt beim Bischof zusammenkamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "00970a8f-5e83-3ea0-80bf-7c4781ca9d27",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "Erläuterung der Bedeutung eines Wortes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7473706d-0f90-451d-9526-adf71743af4e",
                                                "sense_id": "00970a8f-5e83-3ea0-80bf-7c4781ca9d27",
                                                "text": "In Wörterbüchern findet man auch eine Erklärung der Bedeutung der Wörter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee0785a0-bbbc-30c7-9f15-3decaeb2701e",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "Nachweis, dass ein Sachverhalt oder ein Prozess unter Berücksichtigung von Randbedingungen so sein muss, wie er beobachtet wurde, weil bestimmte Gesetze gelten"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c16a4e7-489d-4c00-b5a2-c5637bbefbfe",
                                                "sense_id": "ee0785a0-bbbc-30c7-9f15-3decaeb2701e",
                                                "text": "Eine Erklärung liegt - grob gesprochen - dann vor, wenn man weiß, warum etwas so ist, wie es ist."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
