                        "target_lang_word": "sècheresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sècheresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62a793da-65a7-3d3e-a516-2148ffcb8d15",
                                        "entry_id": "9dde383e-0a62-3335-a30e-c10a0b58d040",
                                        "glosses": [
                                            "État, caractère de ce qui est sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eefda29-c345-4e11-8221-00b56b6a24f1",
                                                "sense_id": "62a793da-65a7-3d3e-a516-2148ffcb8d15",
                                                "text": "La sècheresse de la terre fait grand tort aux moissons."
                                            },
                                            {
                                                "example_id": "40bfea97-b999-4f9f-bd1f-302753b7afbc",
                                                "sense_id": "62a793da-65a7-3d3e-a516-2148ffcb8d15",
                                                "text": "La sècheresse de la langue est un signe de fièvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8118385-ce8b-38c2-bdad-27c9473f5912",
                                        "entry_id": "9dde383e-0a62-3335-a30e-c10a0b58d040",
                                        "glosses": [
                                            "État atmosphérique sans pluie."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ce6def-fae4-49ec-9ed0-85cf81210ebc",
                                                "sense_id": "d8118385-ce8b-38c2-bdad-27c9473f5912",
                                                "text": "Il fit une grande sècheresse cette année-là."
                                            },
                                            {
                                                "example_id": "cf418999-5388-4f99-91d2-f38782d587c3",
                                                "sense_id": "d8118385-ce8b-38c2-bdad-27c9473f5912",
                                                "text": "La sècheresse a fait fendre cette boiserie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee12790c-dc3a-3be0-aa3e-888a405ce46e",
                                        "entry_id": "9dde383e-0a62-3335-a30e-c10a0b58d040",
                                        "glosses": [
                                            "Absence de douceur, froideur dans les manières, dans le ton, dans les sentiments."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb3eab1-ed56-4b12-b63f-dcf422af6fb6",
                                                "sense_id": "ee12790c-dc3a-3be0-aa3e-888a405ce46e",
                                                "text": "On lui avait parlé avec beaucoup de courtoisie, il a répondu avec sècheresse."
                                            },
                                            {
                                                "example_id": "77ab7c38-41b5-4a3d-919c-78329eb172b5",
                                                "sense_id": "ee12790c-dc3a-3be0-aa3e-888a405ce46e",
                                                "text": "La sècheresse de son cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c0a8ca-2a19-3ee9-bbfa-49f869b5b59f",
                                        "entry_id": "9dde383e-0a62-3335-a30e-c10a0b58d040",
                                        "glosses": [
                                            "Se dit d’une sorte de maigreur, d’indigence, d’aridité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76b3b59-3803-456c-aa5c-9853cf3abe1f",
                                                "sense_id": "96c0a8ca-2a19-3ee9-bbfa-49f869b5b59f",
                                                "text": "Il y a beaucoup de sécheresse dans ce discours, dans cet ouvrage, dans cet auteur."
                                            },
                                            {
                                                "example_id": "ea295031-f8e8-4d5d-bcc4-f98245e00bbb",
                                                "sense_id": "96c0a8ca-2a19-3ee9-bbfa-49f869b5b59f",
                                                "text": "Il y a une grande sécheresse de style dans tout ce qu’il écrit."
                                            },
                                            {
                                                "example_id": "38fe1ec6-8b67-410e-bce5-ea22bd91154a",
                                                "sense_id": "96c0a8ca-2a19-3ee9-bbfa-49f869b5b59f",
                                                "text": "Il écrit avec sécheresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b7b957-e915-31be-a07e-3a815b2c3126",
                                        "entry_id": "9dde383e-0a62-3335-a30e-c10a0b58d040",
                                        "glosses": [
                                            "Se dit de l’absence de moelleux, de souplesse, de la dureté des contours."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ec2f35-9eb9-4f4a-89fc-9eb9f9e43ae1",
                                                "sense_id": "a1b7b957-e915-31be-a07e-3a815b2c3126",
                                                "text": "Ce tableau est peint avec une grande sécheresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e975294b-8dc5-3316-aea5-b4955edac531",
                                        "entry_id": "9dde383e-0a62-3335-a30e-c10a0b58d040",
                                        "glosses": [
                                            "Se dit de l’état de l’âme qui ne sent pas de douceur, pas de consolation dans les exercices de piété."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed52ec9b-188e-4839-8276-0f5fd7b6e771",
                                                "sense_id": "e975294b-8dc5-3316-aea5-b4955edac531",
                                                "text": "Dieu le laissa longtemps dans cette sécheresse pour l’éprouver."
                                            },
                                            {
                                                "example_id": "4ad2325c-087b-4af4-9707-68ec32d329ac",
                                                "sense_id": "e975294b-8dc5-3316-aea5-b4955edac531",
                                                "text": "Il éprouva de grandes sécheresses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f0bce34-cae0-491f-8e1a-9b09dd4ffde3",
                        "source_entry_id": "0d88b953-6eef-320e-81fd-c9676d5a2eaa",
                        "source_sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
                        "source_sense_description": "lange periode zonder of met minder neerslag",
                        "target_lang_word": "sécheresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sécheresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                        "entry_id": "6527a1e4-5733-33b9-98be-c4bed921fa7c",
                                        "glosses": [
                                            "Variante, dans l’orthographe traditionnelle, de sècheresse."
                                        ],
                                        "tags": [
                                            "orthographe rectifiée de 1990"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "669f2c40-1f0d-442f-afb0-8a8606d1f02f",
                                                "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                                "text": "Une végétation arbustive, résistante à la sécheresse occupe les faces exposées au sud."
                                            },
                                            {
                                                "example_id": "ea78a75b-9538-4d50-89c0-651e185d6b7a",
                                                "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                                "text": "La sécheresse de la morale de Confucius, l’absence de toute vitalité dans le sein de cette doctrine, ont porté leurs fruits."
                                            },
                                            {
                                                "example_id": "a337a5c1-07e1-45c8-9d98-a9047cc41971",
                                                "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                                "text": "La charrette s'arrêtait au bord de la gaure. C'était un petit bras de la Garonne, fermé d'un bout, comblé par la vase au temps de la sécheresse estivale, et communiquant, de l'autre, avec le fleuve dont les derniers remous, largement étalés, venaient mourir là, dans la tranquillité de l'eau morte."
                                            },
                                            {
                                                "example_id": "16630832-46e7-4023-a223-0ec1faa43750",
                                                "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                                "text": "Septembre arriva, et la sécheresse bienvenue du temps des foins persista et devint une catastrophe. À en croire les Chapdelaine il n’y avait jamais eu de sécheresse comme celle-là, et chaque jour quelque raison nouvelle était suggérée, qui expliquait la sévérité divine."
                                            },
                                            {
                                                "example_id": "ddcf6998-1d43-44b8-91ca-3a71a5fd6280",
                                                "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                                "text": "Il faut que la gelée ou la sécheresse craquellent la paroi pour que l'embryon puisse sortir."
                                            },
                                            {
                                                "example_id": "1d970bf2-7653-4828-a4b8-db636030895a",
                                                "sense_id": "9e4630c8-4b76-3838-86ad-4da95d4f28db",
                                                "text": "Avec 32 jours sans pluie (ou presque), la France a battu en février son record de sécheresse hivernale de 1989."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4f0547-b6fd-3b77-80aa-cee11005c2c9",
                                        "entry_id": "6527a1e4-5733-33b9-98be-c4bed921fa7c",
                                        "glosses": [
                                            "Absence de douceur, froideur dans les manières, dans le ton, dans les sentiments."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6e2ab4-4ad7-4798-99eb-8eb032b934a9",
                                                "sense_id": "4b4f0547-b6fd-3b77-80aa-cee11005c2c9",
                                                "text": "L'amour de soi, combiné avec l'inévitable pensée d'une fin prochaine, donne nécessairement aux vieillards une grande sécheresse de cœur. C'est une lampe dont on abaisse la mèche, par précaution, en songeant qu'on n'a plus d'huile à y remettre."
                                            },
                                            {
                                                "example_id": "51445724-2557-4b0e-af9d-8036604805ea",
                                                "sense_id": "4b4f0547-b6fd-3b77-80aa-cee11005c2c9",
                                                "text": "La raideur de ce visage n’exprime que sécheresse : la sécheresse de ceux pour qui rien n’a jamais existé que leur ambition de parvenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
