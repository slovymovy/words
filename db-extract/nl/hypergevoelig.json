                        "glosses": [
                            "overmatig gevoelig; overmatig reageren om een normale prikkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb6cdbb-8514-4c25-8e9e-44da18111d3f",
                                "sense_id": "376067a5-7567-3f27-a360-e09b0cd76c3a",
                                "text": "De video van een bijzondere examenuitreiking in het Amerikaanse stadje Carmel gaat de wereld over. De autistische Jack Higgins is hypergevoelig voor geluid en kreeg daarom een stille, staande ovatie van zijn schoolgenoten."
                            },
                            {
                                "example_id": "bf773b61-bbfc-4b08-91e7-236c699cd53c",
                                "sense_id": "376067a5-7567-3f27-a360-e09b0cd76c3a",
                                "text": "\"Saab is in Zweden een hypergevoelig onderwerp. Er wordt van een mug een olifant gemaakt\", zegt een woordvoerder. De Zweedse overheid staat garant voor een belangrijke lening van 400 miljoen bij de Europese Investeringsbank, terwijl het nog niet goed gaat met het bedrijf. Dat bleek vorige week nog uit de jaarcijfers."
                            }
                        ]
                    },
                    {
                        "sense_id": "63000c5e-d7cc-3063-b26d-d77fe1db4945",
                        "entry_id": "e3bec373-0871-37b9-ac7c-a5b4e2f61582",
                        "glosses": [
                            "overmatig omstreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80efe04e-3d5b-479b-bddb-8bd95457e848",
                                "sense_id": "63000c5e-d7cc-3063-b26d-d77fe1db4945",
                                "text": "Ook de verplichte vaccinatie van zorgpersoneel ligt volgens de peiling niet hypergevoelig. Elabe vroeg de Fransen wat ze vinden van een vaccinatieplicht voor iederéén, dus niet alleen zorgmedewerkers. President Macron heeft daar eerder op gezinspeeld. Van de ondervraagden bleek 61 procent voorstander."
                            }
                        ]
                    }
