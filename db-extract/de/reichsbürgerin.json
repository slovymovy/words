                        "form": "die Reichsbürgerin"
                    },
                    {
                        "form_id": "bf808119-c46d-43eb-94b0-355ea7b466c5",
                        "entry_id": "e9c9b978-1786-38dc-91a3-5e8e440c606b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reichsbürgerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80b8c84f-ece3-30a7-99b4-06304e94cefe",
                        "entry_id": "e9c9b978-1786-38dc-91a3-5e8e440c606b",
                        "glosses": [
                            "Angehörige einer Bewegung (der Reichsbürgerbewegung), die den deutschen Staat nicht anerkennen"
                        ],
                        "tags": [
                            "gegenwärtig"
                        ],
                        "examples": [
                            {
                                "example_id": "7df61bb4-a95d-4353-8f9e-b31fd513a24f",
                                "sense_id": "80b8c84f-ece3-30a7-99b4-06304e94cefe",
                                "text": "„Sie wussten, dass die 49-jährige bereits mehrmals ohne Führerschein unterwegs war und hielten sie an, wogegen die Reichsbürgerin sich verbal gewehrt haben will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e96880c5-59a3-334c-8935-3885630ec84c",
                        "entry_id": "e9c9b978-1786-38dc-91a3-5e8e440c606b",
                        "glosses": [
                            "Bürgerin des Kaisertums Österreich oder des Deutschen Reichs"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1960b7f9-7cec-4e68-9396-05153bc6222e",
                                "sense_id": "e96880c5-59a3-334c-8935-3885630ec84c",
                                "text": "„Die Tochter dieser Stadtschultheißin, welche die Mutter Goethes wurde, ‚die Räthin,‘ war Reichsbürgerin mit Leib und Seele, unzertrennlich von ihrem Frankfurt, immer gut ‚borjerlich‘ im Verkehr auch mit Hohen und Höchsten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c8ae0dd7-7cfe-392a-b197-d057ad04e6b7",
                        "entry_id": "e9c9b978-1786-38dc-91a3-5e8e440c606b",
                        "glosses": [
                            "Reichsangehörige mit vollen Bürgerrechten (insbesondere Jüdinnen ausschließend) nach dem Reichsbürgergesetz von 1935"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8acccdbc-6977-4c40-adae-e6008a76f37d",
                                "sense_id": "c8ae0dd7-7cfe-392a-b197-d057ad04e6b7",
                                "text": "„Die Frau, die sich ein Reichsbürger erwählt (und der Mann, dem eine Reichsbürgerin die Hand reicht), muß gesund, vor allem auch erbgesund und rassisch einwandfrei sein.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
