                ],
                "senses": [
                    {
                        "sense_id": "9a1bf1e8-a733-38c1-aba1-d4c5b6df0720",
                        "entry_id": "5a82fd4f-d2bc-368b-9b33-f773bb6a423b",
                        "glosses": [
                            "to doze, to drop off"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6554f5-e359-4bff-b42f-2c6a95c2d83c",
                                "sense_id": "9a1bf1e8-a733-38c1-aba1-d4c5b6df0720",
                                "text": "Он лёг и забы́лся.",
                                "translation": "He lay down and dropped off.",
                                "english": "He lay down and dropped off."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa2beca3-390e-3ec3-a0c2-67072df30f25",
                        "entry_id": "5a82fd4f-d2bc-368b-9b33-f773bb6a423b",
                        "glosses": [
                            "to become oblivious, to lose contact with reality"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79513a9-8260-4a07-aa5b-3c5f54e32767",
                                "sense_id": "fa2beca3-390e-3ec3-a0c2-67072df30f25",
                                "text": "И забыва́юсь, забыва́юсь я в вине́.",
                                "translation": "And I become oblivious in wine. (from a song)",
                                "english": "And I become oblivious in wine. (from a song)"
                            }
                        ]
                    },
                    {
                        "sense_id": "5ed0c740-ae28-3d81-84a6-7d54f20a656b",
                        "entry_id": "5a82fd4f-d2bc-368b-9b33-f773bb6a423b",
                        "glosses": [
                            "to forget oneself, to cross the line of what is allowed or to lose control over oneself"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cb2c7d-25a3-4e30-91de-e7213ab83b4e",
                                "sense_id": "5ed0c740-ae28-3d81-84a6-7d54f20a656b",
                                "text": "Молодо́й челове́к, не забыва́йтесь, вы не до́ма!",
                                "translation": "Young man, don't forget yourself, you are not at home!",
                                "english": "Young man, don't forget yourself, you are not at home!"
                            },
                            {
                                "example_id": "db8d443d-18b6-43b7-a0ec-a44b2e42b026",
                                "sense_id": "5ed0c740-ae28-3d81-84a6-7d54f20a656b",
                                "text": "— Анто́ша, не забыва́йся! Смотри́, за́втра пое́ду в гимна́зию, и е́сли э́то ока́жется пра́вда, отда́м тебя́ ма́тери на исправле́ние.",
                                "translation": "\" Antosha, don't forget yourself ! Don't forget to-morrow. I'm going to the gymnasia, and if it's true I'll hand you over to your mother for a whipping ! \"",
                                "english": "\" Antosha, don't forget yourself ! Don't forget to-morrow. I'm going to the gymnasia, and if it's true I'll hand you over to your mother for a whipping ! \""
                            }
                        ]
                    },
                    {
                        "sense_id": "4b15f5d0-c0a1-358a-bbfa-96577b79580e",
                        "entry_id": "5a82fd4f-d2bc-368b-9b33-f773bb6a423b",
                        "glosses": [
                            "passive of забыва́ть (zabyvátʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "e323544f-0d27-4445-aca5-ec9df7c4e090",
                                "sense_id": "4b15f5d0-c0a1-358a-bbfa-96577b79580e",
                                "text": "Но́вые слова́ бы́стро забыва́ются.",
                                "translation": "New words are/get forgotten quickly.",
                                "english": "New words are/get forgotten quickly."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
