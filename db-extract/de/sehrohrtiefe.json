                "senses": [
                    {
                        "sense_id": "867c1059-ea7b-38e4-bef7-0cb95ef2dc27",
                        "entry_id": "9d60e38a-2ea2-32df-b45a-6e6392ad0896",
                        "glosses": [
                            "Lage eines U-Bootes unter der Wasseroberfläche, so dass es noch mit dem Sehrohr die Umgebung beobachten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4e89f6-6dd7-4d9a-ac6b-ae0b2c2a251b",
                                "sense_id": "867c1059-ea7b-38e4-bef7-0cb95ef2dc27",
                                "text": "„Das Boot war auf Sehrohrtiefe geblieben.“"
                            },
                            {
                                "example_id": "eef0964c-8e87-4641-bc8e-1fc7e63f8406",
                                "sense_id": "867c1059-ea7b-38e4-bef7-0cb95ef2dc27",
                                "text": "„Es kommt die Meldung \"Turmluk ist zu\". Dann der Befehl: \"Fluten. Auf Sehrohrtiefe gehen.\"“"
                            },
                            {
                                "example_id": "55bb421d-00a2-4b57-b33e-f0179f3ecbd0",
                                "sense_id": "867c1059-ea7b-38e4-bef7-0cb95ef2dc27",
                                "text": "„Wir lagen immer noch auf demselben Kurs und immer noch auf Sehrohrtiefe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
