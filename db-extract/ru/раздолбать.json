                        "entry_id": "9a7459cb-625f-3f0f-b0bb-46ba95b80a8b",
                        "glosses": [
                            "прост. испортить что-либо неаккуратным пользованием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a4a8b6-0891-4df4-9f36-4a508cc9e25b",
                                "sense_id": "b196d171-d6c4-3ee4-a131-c448c024f4c2",
                                "text": "Раздолбать клавиатуру."
                            }
                        ]
                    },
                    {
                        "sense_id": "b75f91ff-23a9-3bc4-b6e7-aa8f0631f557",
                        "entry_id": "9a7459cb-625f-3f0f-b0bb-46ba95b80a8b",
                        "glosses": [
                            "прост. разругать, раскритиковать"
