                                    {
                                        "sense_id": "06261a39-72fd-3dd2-817d-76ad02fa8163",
                                        "entry_id": "5680aa04-11e3-3ee4-952d-dca5f1a87d1b",
                                        "glosses": [
                                            "To perform the upper decker prank in the cistern of (a toilet)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80cbeddf-9484-400e-afd0-7680fd728e73",
                                                "sense_id": "06261a39-72fd-3dd2-817d-76ad02fa8163",
                                                "text": "HOW DO I KNOW YOU'RE REALLY YOU AND NOT ANOTHER VOICE?\nYOU UPPER-DECKED THE TOILET BACK IN THE AVENGERS MANSION.\nI FEEL BAD ABOUT THAT, BUT I WAS MAD AT LOGAN."
                                            },
                                            {
                                                "example_id": "6e6e61e8-13e8-406d-9c6c-9b76f0a8f063",
                                                "sense_id": "06261a39-72fd-3dd2-817d-76ad02fa8163",
                                                "text": "I was angry at Cletus, then remembered the time in college when Sal and I picked the lock of Cletoid's bathroom door and took turns upper-decking his toilet. I smiled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8dd5c5-5a5b-3ad8-b5ba-9c3c844f427b",
                                        "entry_id": "5680aa04-11e3-3ee4-952d-dca5f1a87d1b",
                                        "glosses": [
                                            "To place a snus or Zyn pouch under the upper lip."
                                        ],
