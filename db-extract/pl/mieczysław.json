                ],
                "senses": [
                    {
                        "sense_id": "c9271f2e-52f4-35a8-8e96-0c91d4d65635",
                        "entry_id": "a9bf4411-2502-3ca9-abbf-a200c4287b84",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2869625a-a9f8-4c8b-91fd-ae23522b716b",
                                "sense_id": "c9271f2e-52f4-35a8-8e96-0c91d4d65635",
                                "text": "Ojciec Mieczysław ma stułę z San Giovanni Rotondo."
                            },
                            {
                                "example_id": "ef3d4183-d52c-4548-9144-cbd7cd92390a",
                                "sense_id": "c9271f2e-52f4-35a8-8e96-0c91d4d65635",
                                "text": "– Wszystkie nieszczęścia to sprawka szatana! Ja potrafię go wypędzić – a wtedy problemy się skończą – miarowo uderzając dłonią w stół skanduje Mieczysław Bartnik, uzdrowiciel – Nie muszę nawet rozmawiać z człowiekiem, żeby poznać, że jest opętany. Wiem od razu – mam doświadczenie. Uzdrowiciel twierdzi, że wystarczy tylko zlustrować człowieka i zapytać wahadełka. Stawia diagnozę i egzorcyzmuje nawet na podstawie zdjęcia."
                            },
                            {
                                "example_id": "6d9db399-7b13-41e5-8223-1c3dfed2e0ea",
                                "sense_id": "c9271f2e-52f4-35a8-8e96-0c91d4d65635",
                                "text": "Według byłego wiceszefa UOP Mieczysława Tarnowskiego przynajmniej 80 proc. osób podejmujących tajną współpracę ze służbami czyni to z pobudek propaństwowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
