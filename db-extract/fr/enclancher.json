                        "glosses": [
                            "Variante de enclencher."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "724579c3-ff34-4908-966a-dc51e36fa6f6",
                                "sense_id": "50d2c95d-e4f6-3bc6-b1bd-b93739397148",
                                "text": "Il nous faut des changements et c'est maintenant qu'il faut les enclancher."
                            },
                            {
                                "example_id": "44f242dc-1ba9-42a9-851c-f2c80745283e",
                                "sense_id": "50d2c95d-e4f6-3bc6-b1bd-b93739397148",
                                "text": "Il faut réellement enclancher un mouvement pour que le reste suive."
                            },
                            {
                                "example_id": "a116a9a0-a0bf-4ff9-8d3a-e0848dd2e7c2",
                                "sense_id": "50d2c95d-e4f6-3bc6-b1bd-b93739397148",
                                "text": "Il donne un coup-d'œil sur ses fléaux, il voit la position de sa vapeur, il enclanche ses barres de route avec le pied ou avec la main."
