                "senses": [
                    {
                        "sense_id": "5b7e99ee-08cb-3858-af64-a4827f2c6dc9",
                        "entry_id": "97eeff1f-dd62-3054-83c3-91bfb6711471",
                        "glosses": [
                            "mit Wegzeichen markierter Weg, der gezieltes/geführtes Wandern ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10647c48-1839-4927-b07d-3e8bc02a3c0f",
                                "sense_id": "5b7e99ee-08cb-3858-af64-a4827f2c6dc9",
                                "text": "Ein Wanderweg führt auf interessanten Strecken oder zu attraktiven Zielen."
                            },
                            {
                                "example_id": "fc967bcb-6c6b-4ec3-83e8-d4585cb530e7",
                                "sense_id": "5b7e99ee-08cb-3858-af64-a4827f2c6dc9",
                                "text": "„Hinter dem Friedhof folge ich dem Wanderweg in die nasse Tundra.“"
                            },
                            {
                                "example_id": "23833ef0-21fe-4203-bf3b-da184a72e839",
                                "sense_id": "5b7e99ee-08cb-3858-af64-a4827f2c6dc9",
                                "text": "„Sie gingen über einen Wanderweg, der halb unter Wasser stand, bis zum Rand des Dorfes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
