                        ]
                    },
                    {
                        "translation_id": "7aacc9dd-8065-45f3-9ad0-6317550747ce",
                        "source_entry_id": "36a78e5a-dbf7-325d-bd2a-7d4951798b88",
                        "source_sense_id": "07cf8411-3b9d-379a-87e5-75db1d5fc578",
                        "target_lang_word": "речитатив",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "речитатив",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "05916f4c-343a-36bf-8bc6-734359150fc8",
                                        "entry_id": "94570dfd-85d1-3629-8fc8-a4055ecdab3d",
                                        "glosses": [
                                            "род вокальной музыки, приближающийся к естественной речи при сохранении фиксированного музыкального строя и регулярной ритмики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664d638e-3ac7-4af3-9013-e4656d6bd4a4",
                                                "sense_id": "05916f4c-343a-36bf-8bc6-734359150fc8",
                                                "text": "Однообразные речитативы оканчиваются как будто стоном души, и сколько вблизи они неприятны для слуха, столько же в дали отрадны для тоски."
                                            },
                                            {
                                                "example_id": "ef0f3ca3-3156-4a44-af79-76f1412b2326",
                                                "sense_id": "05916f4c-343a-36bf-8bc6-734359150fc8",
                                                "text": "Колибри стала по ту сторону стола и, пробежав несколько раз пальцами по струнам гитары, затянула, к удивлению Кузьмы Васильевича, который ожидал веселого, живого напева, — затянула какой-то медлительный, однообразный речитатив, сопровождая каждый отдельный, как бы с усилием выталкиваемый звук мерным раскачиванием всего тела направо и налево."
                                            },
                                            {
                                                "example_id": "27c757c0-579b-4482-9237-fea1b67a629d",
                                                "sense_id": "05916f4c-343a-36bf-8bc6-734359150fc8",
                                                "text": "Ударяя по лбу ладонью, он пропел тихим речитативом слова скорби, отчасти прозвучавшие как обещание возмездия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
