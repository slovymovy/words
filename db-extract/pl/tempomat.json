                "translations": [
                    {
                        "translation_id": "7e3369df-6520-4261-83fd-a8a82f5f8a4d",
                        "source_entry_id": "3cb61cdb-08b0-3e96-893f-b3944d74c962",
                        "source_sense_id": "ee488532-8611-3661-b283-360e711ffcd6",
                        "target_lang_word": "cruise control",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cruise control",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aab2318-9a59-3124-b659-2bab0bfc6b72",
                                        "entry_id": "88b0c2f0-d74d-3f86-b805-2611fb9d0246",
                                        "glosses": [
                                            "A system that maintains a vehicle at constant set speed, usually until the brake or accelerator is pressed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3515e6db-2b7e-47aa-8b2a-f0404407837f",
                                                "sense_id": "6aab2318-9a59-3124-b659-2bab0bfc6b72",
                                                "text": "The crash-involved truck driver had activated the vehicle’s traditional cruise control, which is only able to maintain a set speed and does not reduce that speed based on vehicles ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a76cac0c-addb-32df-892e-0e12cf11d7c4",
                                        "entry_id": "88b0c2f0-d74d-3f86-b805-2611fb9d0246",
                                        "glosses": [
                                            "A state of being where tasks are completed easily and routinely."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "993980de-5df1-4a8e-a9d2-b4394d4d659f",
                                                "sense_id": "a76cac0c-addb-32df-892e-0e12cf11d7c4",
                                                "text": "Liverpool goalkeeper Pepe Reina was badly at fault as Ramires scored at the near post after 11 minutes and Chelsea looked in cruise control when Drogba continued his love affair with the FA Cup final and Wembley with an angled finish beyond Reina."
                                            },
                                            {
                                                "example_id": "b0097a0e-5c2c-49d6-a9ce-bfa9d7f79b14",
                                                "sense_id": "a76cac0c-addb-32df-892e-0e12cf11d7c4",
                                                "text": "He seemed happy living life in cruise control, which pissed me off."
                                            },
                                            {
                                                "example_id": "ef81fafd-2c1d-45b5-b173-2870a83aff65",
                                                "sense_id": "a76cac0c-addb-32df-892e-0e12cf11d7c4",
                                                "text": "Caps Lock is cruise control for cool; remember that for online conversations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "850125b6-71c9-4815-8e32-048aa5942ab6",
                        "source_entry_id": "3cb61cdb-08b0-3e96-893f-b3944d74c962",
