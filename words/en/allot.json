{
    "word_family": [
        "allotment",
        "allotter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72c6c31d-41f6-3752-8b71-40e5127b01db",
                    "sense_definition": "To assign, designate, or set aside a specific amount of something (such as time, money, or resources) for a particular task or purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assign_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each candidate was <w>allotted</w> five minutes to make a presentation in front of the judges.",
                            "target_lang_translations": {
                                "ru": "Каждому кандидату было <w>выделено</w> пять минут на презентацию перед судьями."
                            }
                        },
                        {
                            "text": "The committee decided to <w>allot</w> funds for the new community park project.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>выделить</w> средства на проект нового общественного парка."
                            }
                        }
                    ],
                    "synonyms": [
                        "earmark"
                    ],
                    "common_phrases": [
                        "allot funds",
                        "allot time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять, назначать или резервировать определенное количество чего-либо (например, времени, денег или ресурсов) для конкретной задачи или цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "время, средства, ресурсы"
                            },
                            {
                                "target_lang_word": "выделить",
                                "target_lang_sense_clarification": "время, средства, ресурсы (сов. вид)"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "время, место"
                            },
                            {
                                "target_lang_word": "отвести",
                                "target_lang_sense_clarification": "время, место (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e1fdc92-80c6-39b5-bb2d-72b1928a4280",
                    "sense_definition": "To distribute or share out portions of something systematically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assign_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government will <w>allot</w> land to the local farmers based on their family size.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>распределит</w> землю между местными фермерами в зависимости от размера их семей."
                            }
                        },
                        {
                            "text": "We must carefully <w>allot</w> the remaining food supplies to ensure they last through the winter.",
                            "target_lang_translations": {
                                "ru": "Мы должны тщательно <w>распределить</w> оставшиеся запасы продовольствия, чтобы их хватило на всю зиму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "allot shares",
                        "allot portions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематически распределять или делить что-либо на части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "землю, ресурсы, порции"
                            },
                            {
                                "target_lang_word": "распределить",
                                "target_lang_sense_clarification": "землю, ресурсы, порции (сов. вид)"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "долю, участок земли"
                            },
                            {
                                "target_lang_word": "выделить",
                                "target_lang_sense_clarification": "долю, участок земли (сов. вид)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71527e71-d166-3a67-9dd8-efed55f9d23d",
