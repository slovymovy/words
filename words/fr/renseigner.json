            "senses": [
                {
                    "sense_id": "11485dad-1e1a-30e8-b6e2-d90322f78414",
                    "sense_definition": "Donner des informations ou des indications utiles à quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé à l'accueil peut vous <w>renseigner</w> sur les horaires des bus."
                        },
                        {
                            "text": "Elle a gentiment accepté de me <w>renseigner</w> pour trouver le bon chemin."
                        }
                    ],
                    "synonyms": [
