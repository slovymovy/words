                                    {
                                        "sense_id": "b2448e6e-0afb-338c-ae1e-73bce7ff75ce",
                                        "entry_id": "99ab116d-02dc-32bc-abd8-7ba3fa4db1d3",
                                        "glosses": [
                                            "To become acquainted with (someone or something); to meet someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1759399-2783-42f1-ad3d-2da800998c8a",
                                                "sense_id": "b2448e6e-0afb-338c-ae1e-73bce7ff75ce",
                                                "text": "I'm not into that one-night thing. I think a person should get to know someone and even be in love with them before you use them and degrade them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31d3808-4bca-3c3a-8e37-aaf3ed5a7eb9",
                                        "entry_id": "99ab116d-02dc-32bc-abd8-7ba3fa4db1d3",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see get, know."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
