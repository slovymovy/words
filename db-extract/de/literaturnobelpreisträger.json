                "senses": [
                    {
                        "sense_id": "6ee81b56-bfcf-319f-835a-e917cda8ba15",
                        "entry_id": "e271954b-ae57-3eb4-aecd-ac8e93b0b804",
                        "glosses": [
                            "Person, die den Literaturnobelpreis erhalten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99632ebe-b8e3-49a7-92a6-a937f711637b",
                                "sense_id": "6ee81b56-bfcf-319f-835a-e917cda8ba15",
                                "text": "Der französische Schriftsteller Sully Prudhomme war der erste Literaturnobelpreisträger."
                            },
                            {
                                "example_id": "61aa9d0b-4a4b-4ecc-8ed5-c7e29cb5aa2c",
                                "sense_id": "6ee81b56-bfcf-319f-835a-e917cda8ba15",
                                "text": "„Selbst die Kindheitsfotos, die bereits beim Jungen die markanten Gesichtszüge verraten, lassen für den heutigen Betrachter den späteren Literaturnobelpreisträger durchscheinen.“"
                            },
                            {
                                "example_id": "1ce6f710-70f1-4e41-84c3-2dc77073be03",
                                "sense_id": "6ee81b56-bfcf-319f-835a-e917cda8ba15",
                                "text": "„Der einzige finnische Literaturnobelpreisträger ist Frans Eemil Silanpää.“"
                            },
                            {
                                "example_id": "94769573-0fdb-4204-8729-e8e762f11a16",
                                "sense_id": "6ee81b56-bfcf-319f-835a-e917cda8ba15",
                                "text": "„Der spätere Literaturnobelpreisträger war im Januar 1945 als Batteriekommandant in Ostpreußen eingerückt und verarbeitete die russische Eroberung später zu irritierender Poesie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
