{
    "word_family": [
        "compréhensible",
        "incompréhensible",
        "compréhension",
        "incompréhension",
        "compréhensif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e9a82f5-cd59-3303-93a3-7c115cf51378",
                    "sense_definition": "Saisir le sens de quelque chose ou la pensée de quelqu'un par l'intelligence.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur parle lentement pour que tous les étudiants puissent bien <w>comprendre</w> la leçon."
                        },
                        {
                            "text": "Je ne <w>comprends</w> pas cette phrase parce qu'elle contient plusieurs mots inconnus."
                        }
                    ],
                    "synonyms": [
                        "saisir",
                        "entendre",
                        "piger"
                    ],
                    "common_phrases": [
                        "se faire comprendre",
                        "facile à comprendre",
                        "difficile à comprendre"
                    ]
                },
                {
                    "sense_id": "8ce73aa2-3443-3523-b0e8-75bf7e24cefe",
                    "sense_definition": "Contenir en soi ou inclure des éléments au sein d'un ensemble.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menu de ce restaurant <w>comprend</w> une entrée, un plat principal et un dessert."
                        },
                        {
                            "text": "Le prix du voyage <w>comprend</w> les billets d'avion et trois nuits à l'hôtel."
                        }
                    ],
                    "common_phrases": [
                        "y compris",
                        "tout compris"
                    ],
                    "synonyms": [
                        "inclure",
                        "comporter"
                    ]
                },
                {
                    "sense_id": "5d99bd67-c7d8-3dbc-b80a-cca7c4b337c9",
                    "sense_definition": "Avoir une affinité mutuelle avec quelqu'un et partager une bonne entente.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même s'ils ne se parlent pas souvent, ces deux amis se <w>comprennent</w> toujours parfaitement."
                        },
                        {
                            "text": "Depuis leur première rencontre, ils se <w>comprennent</w> sans avoir besoin de prononcer un mot."
                        }
                    ],
                    "common_phrases": [
                        "bien se comprendre"
                    ]
                },
                {
                    "sense_id": "1018a18b-5ccd-31d1-a471-32a0e0349e26",
                    "sense_definition": "Être concevable, explicable ou justifiable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa réaction de colère se <w>comprend</w> tout à fait après une telle déception."
                        },
                        {
                            "text": "Leur inquiétude peut se <w>comprendre</w> au vu des mauvaises nouvelles annoncées ce matin."
                        }
                    ],
                    "common_phrases": [
                        "pouvoir se comprendre"
                    ]
                }
            ]
        }
    ]
}