                        "examples": [
                            {
                                "example_id": "1e804899-3f93-4e5c-9cf6-24f053bf6baf",
                                "sense_id": "b0fff3b8-d34e-3d72-9320-05601f9d9568",
                                "text": "Przyniesiono wino, i kapitan wypił naprzód za moje zdrowie stojąc, wyjąknąwszy rodzaj spiczu przed wychyleniem kieliszka."
                            },
                            {
                                "example_id": "716a33ca-0cdf-4e1d-9db6-484babc85a2f",
                                "sense_id": "b0fff3b8-d34e-3d72-9320-05601f9d9568",
                                "text": "W krótką przerwę wdarłem się ze spiczem o Kirku Douglasie, który nie dość, że aktor, to jeszcze znawca sztuki."
                            }
                        ],
