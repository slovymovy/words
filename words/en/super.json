    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                    "sense_definition": "To a very high degree; extremely.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie we watched last night was <w>super</w> exciting from start to finish.",
                            "target_lang_translations": {
                                "ru": "Фильм, который мы смотрели вчера вечером, был <w>супер</w> захватывающим от начала до конца.",
                                "zh": "我们昨晚看的电影从头到尾都<w>超级</w>精彩。"
                            }
                        },
                        {
                            "text": "I am <w>super</w> busy today so I cannot meet you for lunch.",
                            "target_lang_translations": {
                                "ru": "Я <w>очень</w> занят сегодня, поэтому не смогу встретиться с тобой на обед.",
                                "zh": "我今天<w>非常</w>忙，所以没法和你一起吃午饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "awesome"
                    ],
                    "antonyms": [
                        "slightly",
                        "barely"
                    ],
                    "common_phrases": [
                        "super busy",
                        "super excited",
                        "super cool"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень высокой степени; чрезвычайно.",
                        "zh": "在很大程度上；极其。"
                    },
                    "translations": {
