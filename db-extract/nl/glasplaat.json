                                    },
                                    {
                                        "sense_id": "3b7d2bfb-f136-3e82-aca4-4eaef692258b",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "The space in the forward or after part of a boat where there are no rowers."
                                        ],
