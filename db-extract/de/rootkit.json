                                        "entry_id": "d6561b58-6926-3920-bfea-fa49aae284f0",
                                        "glosses": [
                                            "A set of software tools used by a third party to gain unauthorized access to a computer system and control the system while concealing itself from the user."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rootkit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20c981f5-f571-3f28-9f1a-eebc9f4094cc",
                                        "entry_id": "80d6f607-6069-3a57-8c53-eca76f32fc1c",
                                        "glosses": [
                                            "To infect (a computer system) with a rootkit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30850421-ec3f-46b8-b06d-0bb30d89206d",
                                                "sense_id": "20c981f5-f571-3f28-9f1a-eebc9f4094cc",
                                                "text": "Given crackers' propensity for \"rootkitting\" systems — installing altered system binaries to facilitate future access — systematic integrity checks using message digest algorithms or one-way hash functions can be an important detection safeguard."
                                            },
                                            {
                                                "example_id": "dc0bb2ed-f87f-4774-a852-9b6ce7d495dd",
                                                "sense_id": "20c981f5-f571-3f28-9f1a-eebc9f4094cc",
                                                "text": "If not, your system might have been rootkitted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
