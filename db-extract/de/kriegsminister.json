                        ],
                        "form": "die Kriegsminister"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3bc0b25e-daad-34f9-af6e-6bcdab13c296",
                        "entry_id": "54d18f5d-709c-3394-86dd-471e0febd89c",
                        "glosses": [
                            "Leiter eines Kriegsministeriums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4c3e844-3b79-4aa2-b336-325e53543d55",
                                "sense_id": "3bc0b25e-daad-34f9-af6e-6bcdab13c296",
                                "text": "„Zu den bekanntesten Operationen der NfO zählte der vom jungtürkischen Kriegsminister Enver Pascha initiierte Plan, über Afghanistan die britische Herrschaft in Indien ins Wanken zu bringen.“"
                            },
                            {
                                "example_id": "e19d34b9-fa20-41ac-9b90-ffdbbd8e58e5",
                                "sense_id": "3bc0b25e-daad-34f9-af6e-6bcdab13c296",
                                "text": "„Diese Pläne wurden, nachdem sich Aster dazu äußerte, von Rauch vorgelegt, der sie dem Kriegsminister von Boyen samt Gutachten vorlegte.“"
                            },
                            {
                                "example_id": "96b0cb14-8ec6-43e4-83a0-4b4417c26254",
                                "sense_id": "3bc0b25e-daad-34f9-af6e-6bcdab13c296",
                                "text": "„Der Kriegsminister selbst legte sich ziemlich fest: Er glaube das nicht.“"
                            },
                            {
                                "example_id": "4225edcb-d634-4782-a20f-7cf95b7ef45f",
                                "sense_id": "3bc0b25e-daad-34f9-af6e-6bcdab13c296",
                                "text": "„Das Territorium untersteht fortan dem Kriegsminister in Paris, vor Ort vertreten durch einen Generalgouverneur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
