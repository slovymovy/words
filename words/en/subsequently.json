                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book was published in 1990 and <w>subsequently</w> translated into ten languages.",
                            "target_lang_translations": {
                                "ru": "Книга была опубликована в 1990 году и <w>впоследствии</w> переведена на десять языков.",
                                "nl": "Het boek werd gepubliceerd in 1990 en <w>vervolgens</w> vertaald in tien talen.",
                                "pl": "Książka została wydana w 1990 roku i <w>następnie</w> przetłumaczona na dziesięć języków.",
                                "de": "Das Buch wurde 1990 veröffentlicht und <w>anschließend</w> in zehn Sprachen übersetzt.",
                                "fr": "Le livre a été publié en 1990 et <w>ensuite</w> traduit en dix langues.",
                                "it": "Il libro fu pubblicato nel 1990 e <w>successivamente</w> tradotto in dieci lingue.",
                                "cs": "Kniha byla vydána v roce 1990 a <w>následně</w> přeložena do deseti jazyků.",
                                "tr": "Kitap 1990'da yayımlandı ve <w>daha sonra</w> on dile çevrildi.",
                                "es": "El libro fue publicado en 1990 y <w>posteriormente</w> traducido a diez idiomas.",
                                "zh": "这本书出版于1990年，<w>随后</w>被翻译成了十种语言。"
                            }
                        },
                        {
                            "text": "He was arrested by the police and <w>subsequently</w> charged with theft.",
                            "target_lang_translations": {
                                "ru": "Он был арестован полицией и <w>впоследствии</w> обвинен в краже.",
                                "nl": "Hij werd gearresteerd door de politie en <w>vervolgens</w> beschuldigd van diefstal.",
                                "pl": "Został aresztowany przez policję, a <w>później</w> oskarżony o kradzież.",
                                "de": "Er wurde von der Polizei festgenommen und <w>danach</w> wegen Diebstahls angeklagt.",
                                "fr": "Il a été arrêté par la police et <w>par la suite</w> inculpé pour vol.",
                                "it": "È stato arrestato dalla polizia e <w>in seguito</w> accusato di furto.",
                                "cs": "Byl zatčen policií a <w>následně</w> obviněn z krádeže.",
                                "tr": "Polis tarafından tutuklandı ve <w>akabinde</w> hırsızlıkla suçlandı.",
                                "es": "Fue arrestado por la policía y <w>posteriormente</w> acusado de robo.",
                                "zh": "他被警方逮捕，<w>后来</w>被控盗窃罪。"
                            }
                        }
