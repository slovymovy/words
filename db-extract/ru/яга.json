            {
                "entry_id": "376edff7-f7c6-3bb8-9dfd-7a62164f4245",
                "word": "Яга",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70056ec2-1980-357b-aaaa-8770977199e3",
                        "entry_id": "376edff7-f7c6-3bb8-9dfd-7a62164f4245",
                        "glosses": [
                            "река в России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a66a10-9cfd-41e2-b033-54b3676d3816",
                                "sense_id": "70056ec2-1980-357b-aaaa-8770977199e3",
                                "text": "Яга — одна из многочисленных рек, протекающих по территории России."
                            }
                        ]
                    },
                    {
                        "sense_id": "2703c3a2-3f59-3309-84b5-81b185383c54",
                        "entry_id": "376edff7-f7c6-3bb8-9dfd-7a62164f4245",
                        "glosses": [
                            "деревня в Ужурском районе Красноярского края"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7f1ad43a-a9e9-3250-91a2-3c2caff4e3b0",
                        "entry_id": "376edff7-f7c6-3bb8-9dfd-7a62164f4245",
                        "glosses": [
                            "сокр. от Баба-Яга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e08d57e-9125-48a4-ac96-c1bae3754e69",
                                "sense_id": "7f1ad43a-a9e9-3250-91a2-3c2caff4e3b0",
                                "text": "Яга проснулась, Яга осерчала, села Яга в ступу да за беленькой Зайкой мигом в погоню."
                            },
                            {
                                "example_id": "1dd1b491-3b85-4b48-8c7f-acb0bd284bed",
                                "sense_id": "7f1ad43a-a9e9-3250-91a2-3c2caff4e3b0",
                                "text": "Как-то летним теплым вечером, едва солнышко спряталось за горизонтом, Яга вышла на крыльцо своей старенькой избушки и, сложив вместе два пальца, громко свистнула."
                            }
                        ]
                    }
                ],
