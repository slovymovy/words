                ],
                "senses": [
                    {
                        "sense_id": "1e64f78b-3135-34f0-8f18-63956cfc4700",
                        "entry_id": "720c0a33-3670-3f6d-9737-358aaa01a991",
                        "glosses": [
                            "A married female elf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c448ffc-0e8e-4add-9dee-217eb16b4195",
                                "sense_id": "1e64f78b-3135-34f0-8f18-63956cfc4700",
                                "text": "The Spanish Hidalgo loses his Elf-wife by pronouncing a sacred name, and the Metal Boat of the Prince Amrad sinks under the same bann."
                            },
                            {
                                "example_id": "f03b16bf-a1c2-4be9-b9b7-4f0ae8e5d322",
                                "sense_id": "1e64f78b-3135-34f0-8f18-63956cfc4700",
                                "text": "Elidyr, the elf-wife,\nKeeps a small tavern\nIn a moss-carpeted,\nFern-curtained cavern."
                            },
                            {
                                "example_id": "0e96b415-f859-4dee-9d03-0d2a36313186",
                                "sense_id": "1e64f78b-3135-34f0-8f18-63956cfc4700",
                                "text": "An elf wife hung her washing out\nUpon a cobweb line\n(Including socks and handkerchiefs),\nThe articles were nine."
                            }
                        ]
                    },
                    {
                        "sense_id": "42842379-7bac-34d7-97ec-13994a412995",
                        "entry_id": "720c0a33-3670-3f6d-9737-358aaa01a991",
                        "glosses": [
                            "The human wife of a male elf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298e946b-b46d-47e1-b6f4-2c939ce180e0",
                                "sense_id": "42842379-7bac-34d7-97ec-13994a412995",
                                "text": "Here the woman learned that the Elf-wife could not be delivered without the aid of a Christian woman, she being herself a Christian, but had been carried off by the Elf-man."
                            },
                            {
                                "example_id": "65e9f6b3-731f-4bd2-a296-ebdb22d1beea",
                                "sense_id": "42842379-7bac-34d7-97ec-13994a412995",
                                "text": "During his absence the elfwife took the opportunity of instructing her helper as to her conduct when he returned; and the first and chief point of her advice was to eat nothing that was offered her."
                            }
                        ]
                    }
                ],
