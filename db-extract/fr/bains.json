                "word": "bains",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5524a7e5-5b17-3c7f-9875-7fc0787a8409",
                        "entry_id": "5bd6c1e8-abc5-3ad0-b572-d24b4b6d3ab9",
                        "glosses": [
                            "Appartements destinés aux bains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc835356-6fe1-4562-b8a1-80c956b4966f",
                                "sense_id": "5524a7e5-5b17-3c7f-9875-7fc0787a8409",
                                "text": "Les bains du roi, de la reine."
                            },
                            {
                                "example_id": "bb8a446d-99a7-402f-9b87-5045f924980f",
                                "sense_id": "5524a7e5-5b17-3c7f-9875-7fc0787a8409",
                                "text": "Les bains sont dans telle partie de l’édifice."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a117452-b6ed-3b3b-848f-c8c60fbfd68c",
                        "entry_id": "5bd6c1e8-abc5-3ad0-b572-d24b4b6d3ab9",
                        "glosses": [
                            "Établissement public où l’on peut aller prendre des bains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "446ea1da-3897-4c0e-bd05-c7ef46358626",
                                "sense_id": "6a117452-b6ed-3b3b-848f-c8c60fbfd68c",
                                "text": "Érasme écrivait en 1518 à Cologne : Il y a vingt-cinq ans, rien n’était mieux reçu que les bains publics ; aujourd’hui, partout ils refroidissent car la maladie nouvelle, que Jean d’Auton appelle « grosse vérole ou mal de Naples » nous a appris à nous en abstenir."
                            },
                            {
                                "example_id": "dc3d01b8-4a88-4f4f-9319-221697152e3c",
                                "sense_id": "6a117452-b6ed-3b3b-848f-c8c60fbfd68c",
                                "text": "Faire construire, installer des bains."
                            },
                            {
                                "example_id": "f738e2e8-a012-45ec-9f49-4bf011690e36",
                                "sense_id": "6a117452-b6ed-3b3b-848f-c8c60fbfd68c",
                                "text": "Établir des bains sur une rivière."
                            },
                            {
                                "example_id": "753d8176-1222-4cd8-99c2-941e3a5c8586",
                                "sense_id": "6a117452-b6ed-3b3b-848f-c8c60fbfd68c",
                                "text": "Chez les Anciens, les bains ou thermes étaient ordinairement de vastes et somptueux édifices."
                            }
                        ]
                    },
                    {
                        "sense_id": "138ae0a7-8b0c-3bd5-a102-44af4a385e83",
                        "entry_id": "5bd6c1e8-abc5-3ad0-b572-d24b4b6d3ab9",
                        "glosses": [
                            "Stations thermales où l’on va se baigner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b3c8fe7-78f8-44e7-b184-5f37ca977937",
                                "sense_id": "138ae0a7-8b0c-3bd5-a102-44af4a385e83",
                                "text": "Les bains de Bourbonne, de Bagnères, du Dore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84075424-499e-43d5-a859-0ef9bbefb776",
                        "source_entry_id": "5bd6c1e8-abc5-3ad0-b572-d24b4b6d3ab9",
                        "target_lang_word": "bathhouse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
