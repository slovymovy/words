                    "sense_id": "472fc9b5-2a0c-3fea-84f6-dae18a91306e",
                    "sense_definition": "Avoir un prix déterminé ou une valeur marchande ou morale.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "valeur_prix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jolie maison de campagne <w>vaut</w> beaucoup plus cher aujourd'hui."
                        },
                        {
                            "text": "Le tableau ancien retrouvé au grenier <w>vaut</w> une véritable fortune."
                        }
                    ],
                    "synonyms": [
                        "coûter"
                    ],
                    "common_phrases": [
