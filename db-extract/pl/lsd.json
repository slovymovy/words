                    {
                        "translation_id": "16011a3f-610d-488d-91d5-2b7a6e585eb7",
                        "source_entry_id": "ecbd933d-bf56-353c-a7b5-8f3f77319808",
                        "source_sense_id": "12101366-e259-3143-bcf8-b53c0563ae6a",
                        "target_lang_word": "acid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f91bc51f-d57d-365e-876d-c4ac11adada1",
                                        "entry_id": "68cba6a3-fcb3-3b48-8033-c43a8d1f03ab",
                                        "glosses": [
                                            "Sour, sharp, or biting to the taste; tart; having the taste of vinegar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a597d83-e491-4c66-abec-29fca2fa93fa",
                                                "sense_id": "f91bc51f-d57d-365e-876d-c4ac11adada1",
                                                "text": "acid fruits or liquors"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "037d443c-9fd5-3a4b-8eb0-6694116d0031",
                                        "entry_id": "68cba6a3-fcb3-3b48-8033-c43a8d1f03ab",
                                        "glosses": [
                                            "Sour-tempered."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c60a8e-b716-4127-bd8d-7097b992c26c",
                                                "sense_id": "037d443c-9fd5-3a4b-8eb0-6694116d0031",
                                                "text": "His response was harsh and acid."
                                            },
                                            {
                                                "example_id": "74f97db2-95ce-4647-a1b4-13b885f6a09a",
                                                "sense_id": "037d443c-9fd5-3a4b-8eb0-6694116d0031",
                                                "text": "His voice was as stern and his face as acid as ever."
                                            },
                                            {
                                                "example_id": "cae59030-b130-44be-bc06-06aa6e3fa8d0",
                                                "sense_id": "037d443c-9fd5-3a4b-8eb0-6694116d0031",
                                                "text": "It must be admitted that Challenger is provocative in the last degree, but Summerlee has an acid tongue, which makes matters worse."
                                            },
                                            {
                                                "example_id": "05cace83-7bad-44f3-8ca8-463caf7ba94c",
                                                "sense_id": "037d443c-9fd5-3a4b-8eb0-6694116d0031",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fffd61f-361d-3711-a7ac-c0fd0425e72f",
                                        "entry_id": "68cba6a3-fcb3-3b48-8033-c43a8d1f03ab",
                                        "glosses": [
                                            "Of or pertaining to an acid; acidic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80debef1-ff74-49ce-9df4-ad4f2a6c02cc",
                                                "sense_id": "4fffd61f-361d-3711-a7ac-c0fd0425e72f",
                                                "text": "acid soils"
                                            },
                                            {
                                                "example_id": "e53e3cfa-07e4-4ed9-9960-49bb6856e720",
                                                "sense_id": "4fffd61f-361d-3711-a7ac-c0fd0425e72f",
                                                "text": "Like other nyssas, it is in nature a creature of swampy places and looks loveliest where massed close to water and reflected in it, but justifies itself elsewhere if the soil is moist and acid, succeeding in wet clay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc97e7d3-535e-3cad-82a8-03a89d3ae89a",
                                        "entry_id": "68cba6a3-fcb3-3b48-8033-c43a8d1f03ab",
                                        "glosses": [
                                            "Denoting a musical genre that is a distortion (as if hallucinogenic) of an existing genre, as in acid house, acid jazz, acid rock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "acid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "340cbbfd-1f76-3ea6-b55a-e62faecb3a2f",
                                        "entry_id": "77750d2e-73be-38d4-a079-9d6320b8a75d",
                                        "glosses": [
                                            "A sour substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12a26e42-0ed4-39a6-a5fc-8ce3164c7d74",
                                        "entry_id": "77750d2e-73be-38d4-a079-9d6320b8a75d",
                                        "glosses": [
                                            "Any compound which yields H+ ions (protons) when dissolved in water; an Arrhenius acid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb3ef72-91ff-4c5b-ac46-51865037c6c5",
                                                "sense_id": "12a26e42-0ed4-39a6-a5fc-8ce3164c7d74",
                                                "text": "SE onset depends on a complex network of interactions among plant growth regulators, mainly auxins and cytokinins, during the proembryogenic early stages, and ethylene and gibberellic and abscisic acids later in the development of somatic embryos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026b7b9c-9ec4-313b-9c8f-9fd361bea4fb",
                                        "entry_id": "77750d2e-73be-38d4-a079-9d6320b8a75d",
                                        "glosses": [
                                            "Any compound that easily donates protons to a base; a Brønsted acid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3241ede3-e0f0-337a-a0ef-7f9f759b17bd",
                                        "entry_id": "77750d2e-73be-38d4-a079-9d6320b8a75d",
                                        "glosses": [
                                            "Any compound that can accept a pair of electrons to form a covalent bond; a Lewis acid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca8c6fdf-5923-3a43-a879-b626eec9b0d4",
                                        "entry_id": "77750d2e-73be-38d4-a079-9d6320b8a75d",
                                        "glosses": [
                                            "Any corrosive substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900a3822-7a0b-4045-8382-0146b84dc935",
                                                "sense_id": "ca8c6fdf-5923-3a43-a879-b626eec9b0d4",
                                                "text": "You are in error. / This is terror. / This is your banishment. This land is mine. / This is what you earn. / This is the Law of No Return. / This is the sour dough, this the sweet wine. / This is my history, this my race / And this unhappy man threw acid in my face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48120d61-7d65-3d02-81cd-ab3441570041",
                                        "entry_id": "77750d2e-73be-38d4-a079-9d6320b8a75d",
                                        "glosses": [
                                            "LSD, lysergic acid diethylamide."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e24a305b-ca68-481e-b3fe-50d3bd79cd18",
                                                "sense_id": "48120d61-7d65-3d02-81cd-ab3441570041",
                                                "text": "In the end, though, there is one sure way to distinguish a real hippie from his assorted sympathizers: hippies drop acid. That is, real hippies frequently, if irregularly, ingest LSD."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
