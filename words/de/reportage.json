                    "frequency": "Low",
                    "semantic_group_id": "journalismus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Millionen von Fußballfans verfolgten die mitreißende <w>Reportage</w> des Endspiels im Radio."
                        },
                        {
                            "text": "Der Kommentator begann seine <w>Reportage</w> wenige Minuten vor dem Anpfiff."
                        }
                    ],
                    "common_phrases": [
