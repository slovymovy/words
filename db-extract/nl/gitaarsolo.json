                        "entry_id": "3b53cd38-b19b-3359-83b1-97ccdee096b9",
                        "glosses": [
                            "een stuk muziek dat door één gitarist gespeeld wordt"
                        ],
                        "tags": [
                            "gedeelte van"
                        ],
                        "examples": [
                            {
                                "example_id": "0bb85b29-c0d9-4cc9-8cc8-3c21985b9592",
                                "sense_id": "fff37e60-ad75-30fd-9740-5b88684efd84",
                                "text": "Hij was een bescheiden Britse kostschooljongen met een keurig Engels accent die, eenmaal op het podium, in een echte entertainer veranderde en als een kleine Mark Knopfler een weergaloze gitaarsolo neerzette."
                            },
                            {
                                "example_id": "055a1790-47b9-4928-9e05-557842be6372",
                                "sense_id": "fff37e60-ad75-30fd-9740-5b88684efd84",
                                "text": "Alsof dat nog niet genoeg was, verwelkomde McCartney even later ook gitarist en zanger Joe Walsh, van onder meer The Eagles, op het podium. Hij speelde samen met McCartney een gitaarsolo."
                            }
                        ]
                    }
