                        "entry_id": "fb5e6432-f89b-35bb-bc14-3224cfab39cd",
                        "glosses": [
                            "Wissenschaft, die sich mit den präventiven und kurativen therapeutische Maßnahmen rund um den Fuß beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
