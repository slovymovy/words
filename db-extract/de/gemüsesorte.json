                ],
                "senses": [
                    {
                        "sense_id": "5461748e-9f6d-365f-a33e-33733cb2e9fe",
                        "entry_id": "d2ded7d1-9b01-35b8-bf51-efeb510f361f",
                        "glosses": [
                            "bestimmte Art von Gemüse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52717281-05c1-4975-aa52-33bbddc5149f",
                                "sense_id": "5461748e-9f6d-365f-a33e-33733cb2e9fe",
                                "text": "„Der Herbst bringt nicht nur buntes Laub, sondern auch eine Vielzahl interessanter und bekömmlicher Gemüsesorten.“"
                            },
                            {
                                "example_id": "a9557019-004f-4f0b-b512-07120b02c15c",
                                "sense_id": "5461748e-9f6d-365f-a33e-33733cb2e9fe",
                                "text": "„Zahlreiche Bewässerungskanäle durchzogen das Tal und ermöglichten den Anbau von Kürbissen, Bohnen und anderen Gemüsesorten.“"
                            },
                            {
                                "example_id": "ba025897-9a16-4d1a-a8a3-29ac3368eb8f",
                                "sense_id": "5461748e-9f6d-365f-a33e-33733cb2e9fe",
                                "text": "„Leider enthält er vor allem bunte Blumen und nur wenige Gemüsesorten, aber es gibt Zwiebeln, Lauchzwiebeln und normale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
