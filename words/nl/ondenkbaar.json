{
    "word_family": [
        "denken",
        "denkbaar",
        "denker",
        "denkbeeld"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51b7aa75-0432-36a8-b53c-96cd0e041962",
                    "sense_definition": "Niet mogelijk om te bedenken of voor te stellen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onmogelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is voor velen <w>ondenkbaar</w> om zonder internet te leven.",
                            "target_lang_translations": {
                                "zh": "对许多人来说，没有互联网的生活是<w>无法想象</w>的。"
                            }
                        },
                        {
                            "text": "Een wereld zonder vrede is voor mij volkomen <w>ondenkbaar</w>.",
                            "target_lang_translations": {
                                "zh": "对我而言，一个没有和平的世界是完全<w>不可思议</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "onvoorstelbaar"
                    ],
                    "antonyms": [
                        "denkbaar"
                    ],
                    "common_phrases": [
                        "vrijwel ondenkbaar",
                        "bijna ondenkbaar"
                    ],
                    "target_lang_definitions": {
                        "zh": "无法想象或无法构思的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不可思议",
                                "target_lang_sense_clarification": "强调超乎想象，难以理解。"
                            },
                            {
                                "target_lang_word": "无法想象",
                                "target_lang_sense_clarification": "指在认知范围内无法构思。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0c1e1d7-a8ea-3c03-ab6e-e6ab2bc764cc",
                    "sense_definition": "Zeer onwaarschijnlijk of onmogelijk om te geloven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onmogelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>ondenkbaar</w> dat zij dit geheim voor iedereen verborgen houdt.",
                            "target_lang_translations": {
                                "zh": "她能把这个秘密瞒住所有人，这简直<w>难以置信</w>。"
                            }
                        },
                        {
                            "text": "Zonder muziek de reis maken was voor hem volkomen <w>ondenkbaar</w>.",
                            "target_lang_translations": {
                                "zh": "对他来说，不带音乐去旅行是<w>绝无可能</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "onmogelijk",
                        "onwaarschijnlijk"
                    ],
                    "antonyms": [
                        "denkbaar"
                    ],
                    "common_phrases": [
                        "volkomen ondenkbaar"
                    ],
                    "target_lang_definitions": {
                        "zh": "极不可能发生或难以置信的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "难以置信",
                                "target_lang_sense_clarification": "指事情发生的可能性极低，令人难以相信。"
                            },
                            {
                                "target_lang_word": "绝无可能",
                                "target_lang_sense_clarification": "强调事情发生的概率为零。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}