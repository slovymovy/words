                ],
                "senses": [
                    {
                        "sense_id": "602b6b1d-6f6c-3309-b11a-689fea426569",
                        "entry_id": "448c5732-d7ce-3f81-8850-d5e991fd2960",
                        "glosses": [
                            "ein Raum im Eingangsbereich eines Hotels, in dem bequeme Sitzmöbel stehen und sich Gäste ungezwungen aufhalten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd6a2ef-8424-4d97-a8f8-562eedff473f",
                                "sense_id": "602b6b1d-6f6c-3309-b11a-689fea426569",
                                "text": "Lass uns gegen neun Uhr in der Lounge treffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "255b03a0-658e-30ed-8087-6a234ac6722e",
                        "entry_id": "448c5732-d7ce-3f81-8850-d5e991fd2960",
                        "glosses": [
                            "ein Raum mit Sitzmöbeln auf einem Flughafen oder einem Bahnhof, in dem Reisende warten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1af0154-daa5-425d-a034-a5afdb529c60",
                                "sense_id": "255b03a0-658e-30ed-8087-6a234ac6722e",
                                "text": "Ebenfalls stehen in Österreich für Besitzer von Erste-Klasse-Tickets oder der Vorteilscard eigene Lounges der ÖBB an den größten Bahnhöfen zur Verfügung."
                            },
                            {
                                "example_id": "19694c9b-58d8-477a-95d2-e5b637a3a8b9",
                                "sense_id": "255b03a0-658e-30ed-8087-6a234ac6722e",
                                "text": "„Kostenpflichtige Lounges bieten allen Komfort, dazu gibt es nicht ganz so luxuriöse, kostenfreie Lounges mit gepolsterten Bänken, Duschen und sogar Kinderspielplätzen.“"
                            },
                            {
                                "example_id": "7eca02d2-89c4-4cc4-9dec-df1b16d75410",
                                "sense_id": "255b03a0-658e-30ed-8087-6a234ac6722e",
                                "text": "„Duschen und Bäder gehören zur Grundausstattung einer guten Lounge, oft wird aber wesentlich mehr als nur schlichtes Warmwasser geboten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f674110d-db26-3a3c-88d6-5d01f9f7f5ae",
                        "entry_id": "448c5732-d7ce-3f81-8850-d5e991fd2960",
                        "glosses": [
                            "Bar mit ruhiger Atmosphäre und entspannter Hintergrundmusik"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12501b03-ed4d-43fd-9ae9-4d31a42611a0",
                        "source_entry_id": "448c5732-d7ce-3f81-8850-d5e991fd2960",
                        "source_sense_id": "602b6b1d-6f6c-3309-b11a-689fea426569",
                        "target_lang_word": "lounge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lounge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4c0bf88-b3a5-3bec-ba1f-5b79938667b3",
                                        "entry_id": "5d7de0a5-8962-338b-b6bc-6a0d754abf9d",
                                        "glosses": [
                                            "To relax; to spend time lazily; to stand, sit, or recline, in an indolent manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4274cb8-7dc7-4c0b-9415-ca25fe35013f",
                                                "sense_id": "f4c0bf88-b3a5-3bec-ba1f-5b79938667b3",
                                                "text": "We like to spend our Sundays lounging about at home in our pyjamas."
                                            },
                                            {
                                                "example_id": "7a5932ab-e78a-4c9c-a9af-117de17fbd48",
                                                "sense_id": "f4c0bf88-b3a5-3bec-ba1f-5b79938667b3",
                                                "text": "We lounge over the sciences, dawdle through literature, yawn over politics."
                                            },
                                            {
                                                "example_id": "16527da5-875a-4fc5-b65c-096604f70183",
                                                "sense_id": "f4c0bf88-b3a5-3bec-ba1f-5b79938667b3",
                                                "text": "Everybody knows they have times when they wanna just lay back / Kick their feet up, y'know / Listen to some good music and just lounge / That's right, I said lounge"
                                            },
                                            {
                                                "example_id": "f1ad30c8-a9b7-4e37-9767-bfb700ae0bf1",
                                                "sense_id": "f4c0bf88-b3a5-3bec-ba1f-5b79938667b3",
                                                "text": "On Professor Solanka’s street, well-heeled white youths lounged in baggy garments on roseate stoops, stylishly simulating indigence while they waited for the billionairedom that would surely be along sometime soon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da4237b-014f-3afd-a097-05b3e8647f7e",
                                        "entry_id": "5d7de0a5-8962-338b-b6bc-6a0d754abf9d",
                                        "glosses": [
                                            "To walk or go in a leisurely manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ec99f6-f586-438f-8117-fce7e9ebe81e",
                                                "sense_id": "1da4237b-014f-3afd-a097-05b3e8647f7e",
                                                "text": "When this bejewelled exquisite lounged through the streets playing on his flute, puffing at a cigar, and smelling at a nosegay, the people whom he met threw themselves on the earth before him and prayed to him with sighs and tears."
                                            },
                                            {
                                                "example_id": "fb072b34-caa8-431f-8b7e-1db22f66167b",
                                                "sense_id": "1da4237b-014f-3afd-a097-05b3e8647f7e",
                                                "text": "As she lounged past Leila's car she cast an insolent glance at the Irish girl."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lounge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f6ee1e-822e-3dbf-aadf-4ea960b56be4",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "A place where one can lounge; an area, establishment, house etc. where loungers gather and where one can relax and be at ease."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2cf88bc-39dd-4233-92f2-d697f672f86c",
                                                "sense_id": "e6f6ee1e-822e-3dbf-aadf-4ea960b56be4",
                                                "text": "He […] prevailed on Captain Musgrave to introduce him to a family, where he supposed he might find a monstrous good lounge for the rest of the time he was to be quartered in the neighbourhood."
                                            },
                                            {
                                                "example_id": "e35a56de-e9d6-4d6a-876d-4ffda45d638f",
                                                "sense_id": "e6f6ee1e-822e-3dbf-aadf-4ea960b56be4",
                                                "text": "Every search for him was equally unsuccessful, in morning lounges or evening assemblies."
                                            },
                                            {
                                                "example_id": "7709f39e-85ff-42ef-a815-b70baca75876",
                                                "sense_id": "e6f6ee1e-822e-3dbf-aadf-4ea960b56be4",
                                                "text": "One morning she accompanied Madame de Soissons to the fair, then the favourite lounge and amusement. The Comtesse bought every trifle that caught her eye, while Francesca looked on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee1db23-8d7c-3c67-a1cd-96c3630bdd0b",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "A place where one can lounge; an area, establishment, house etc. where loungers gather and where one can relax and be at ease.",
                                            "A couch."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0943fa75-f77e-3181-820b-e96adb83caab",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "The act of someone who lounges; idle reclining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c2ed25-4e55-4bbb-ab0f-38d2b0d34bd0",
                                                "sense_id": "0943fa75-f77e-3181-820b-e96adb83caab",
                                                "text": "That is, he devoted his waking hours to lounges among the habitués of Chestnut-street, and lollings in an arm-chair of 'Squire Coke in Walnut-street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f45d2e4-08de-37e1-b34a-9af193f7a5ac",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "The living room or sitting room of a house."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d968395a-4289-476a-97ea-d746166d230e",
                                                "sense_id": "0f45d2e4-08de-37e1-b34a-9af193f7a5ac",
                                                "text": "Let us adjourn to the lounge."
                                            },
                                            {
                                                "example_id": "be4c460c-bf20-4f67-9475-11957bd45121",
                                                "sense_id": "0f45d2e4-08de-37e1-b34a-9af193f7a5ac",
                                                "text": "The lounge was furnished in old English oak and big Knole settees. There were rugs from Tabriz and Kerman on the highly polished floor. […] A table lamp was fashioned from a silver Egyptian hookah."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3611ebf-6902-32ab-a768-10134b2e872a",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "A large comfortable seat for two or three people or more, a sofa or couch; also called lounge chair."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "011417a0-eba9-3d23-83cc-71b42982f282",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "A waiting room in an office, airport etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "557301b5-822a-3e9e-a9cb-08a2c40a2236",
                                        "entry_id": "733726aa-456a-3212-9ed6-d58afd82bb09",
                                        "glosses": [
                                            "An establishment, similar to a bar, that serves alcohol and often plays background music or shows television."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
