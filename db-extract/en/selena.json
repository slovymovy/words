                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60f71b6c-c79e-4adb-b0d0-bdc55a8535a0",
                                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                                "text": "Dzień dobry, mam na imię Selena i jestem Polką greckiego pochodzenia."
                                            },
                                            {
                                                "example_id": "7dcde51e-cc1e-4527-ac1a-4ef5df07e14e",
                                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                                "text": "Selena to rzadkie imię żeńskie w Polsce."
                                            },
                                            {
                                                "example_id": "d3a6c847-1077-48f1-a5a3-34657959b6f0",
                                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                                "text": "Zeszłoroczne wakacje spędziliśmy z kuzynką Seleną na Cyprze."
                                            },
                                            {
                                                "example_id": "5df5eb5a-6a99-4d9a-8fa1-288e82c05ebe",
                                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                                "text": "Pani Seleno, proszę nas jutro koniecznie odwiedzić."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
