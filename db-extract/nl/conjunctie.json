                ],
                "translations": [
                    {
                        "translation_id": "cdff3181-4c2d-4c4e-9885-dc64a962b590",
                        "source_entry_id": "bc9b298a-e630-3a7a-994d-5d7ef38475e2",
                        "target_lang_word": "Konjunktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konjunktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5e8d91-cffc-34e0-86a8-cca64c43834e",
                                        "entry_id": "53c2e34c-a2fe-3485-8104-eee8031e5a1d",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d851bc33-b4de-4460-8b28-5d4d8e5c19ff",
                                                "sense_id": "5c5e8d91-cffc-34e0-86a8-cca64c43834e",
                                                "text": "Das Wort „und“ ist eine (koordinierende) Konjunktion."
                                            },
                                            {
                                                "example_id": "77b214e4-166a-494e-87d0-d61f9d7aa9f6",
                                                "sense_id": "5c5e8d91-cffc-34e0-86a8-cca64c43834e",
                                                "text": "„Präpositionen wie Konjunktionen können eine Beziehung verallgemeinernd benennen.“"
                                            },
                                            {
                                                "example_id": "a4c3e3ba-6f84-407e-afae-4d046fe8c58b",
                                                "sense_id": "5c5e8d91-cffc-34e0-86a8-cca64c43834e",
                                                "text": "„Die Konjunktionen (Bindewörter) sind wichtige Bausteine, um Wörter, Satzglieder, Sätze und Texte miteinander zu verknüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4739bbf8-3aaa-3bcd-869e-84a0e81f24c1",
                                        "entry_id": "53c2e34c-a2fe-3485-8104-eee8031e5a1d",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft",
                                            "alle nicht flektierbaren, nicht satzgliedfähigen Wörter, die der Verbindung zwischen Wörtern oder Wortgruppen dienen"
                                        ],
                                        "tags": [
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "16e157b9-791d-3217-a44d-9732fbcba8fb",
                                        "entry_id": "53c2e34c-a2fe-3485-8104-eee8031e5a1d",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft",
                                            "im Gegensatz zu Subjunktion sind Konjunktionen Wörter, die syntaktisch gleichrangige Wörter oder Wortgruppen verbinden (= beiordnende, nebenordnende, koordinierende Konjunktion)"
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "2be19d4d-e227-370a-8921-57667884798c",
                                        "entry_id": "53c2e34c-a2fe-3485-8104-eee8031e5a1d",
                                        "glosses": [
                                            "Stellung zweier Gestirne über demselben Längengrad der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f40fd0-c84e-4619-8acd-8b480b2055bc",
                                                "sense_id": "2be19d4d-e227-370a-8921-57667884798c",
                                                "text": "Die Venus steht in Konjunktion zur Sonne."
                                            },
                                            {
                                                "example_id": "571941ac-b1e8-4ed8-ac3a-0a7179884a05",
                                                "sense_id": "2be19d4d-e227-370a-8921-57667884798c",
                                                "text": "Der Stern von Betlehem war vermutlich eine Konjunktion der Planeten Jupiter und Saturn."
                                            },
                                            {
                                                "example_id": "9e0950ba-4a5b-4022-8fa4-9dad91985810",
                                                "sense_id": "2be19d4d-e227-370a-8921-57667884798c",
                                                "text": "„Nicht der geringste Lichtschimmer drang durch die Wolkenmassen, der Mond stand in Konjunktion zur Sonne, es war Neumond.“"
                                            },
                                            {
                                                "example_id": "56aa7212-e8d4-4b50-9551-93805c32de96",
                                                "sense_id": "2be19d4d-e227-370a-8921-57667884798c",
                                                "text": "„Daraus folgerten Wanderprediger und Flugblattpropheten, eine neue Sintflut stehe bevor und die Konjunktion der Planeten werde »ungezweiffelt vil wunderbarlicher ding geperen«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "023f73d3-8026-3e10-b706-670b747a5005",
                                        "entry_id": "53c2e34c-a2fe-3485-8104-eee8031e5a1d",
                                        "glosses": [
                                            "Und-Verknüpfung zweier Teilaussagen"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6a8e225-d573-4519-b7fc-0cca69ef70f8",
                                                "sense_id": "023f73d3-8026-3e10-b706-670b747a5005",
                                                "text": "Die Konjunktion zweier Aussagen ist genau dann wahr, wenn beide verknüpfte Aussagen wahr sind."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2daf45f2-f483-4fca-aaeb-03c68e923552",
                        "source_entry_id": "bc9b298a-e630-3a7a-994d-5d7ef38475e2",
                        "target_lang_word": "conjunction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjunction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "354fb787-29fa-3e60-932b-64edd5534c78",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "The act of joining, or condition of being joined."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf84a36-17bb-41dc-b827-5ea4b810ef98",
                                                "sense_id": "354fb787-29fa-3e60-932b-64edd5534c78",
                                                "text": "[…] Dr. Minchin in return was quite sure that man was not a mere machine or a fortuitous conjunction of atoms; […]"
                                            },
                                            {
                                                "example_id": "995bab94-3b85-4b4c-939e-dfc0d85484e2",
                                                "sense_id": "354fb787-29fa-3e60-932b-64edd5534c78",
                                                "text": "About them all there is that sort of stiff quaint unreality, that conjunction of the grotesque, and even of a certain bourgeois snugness, with passionate contortion and horror, that is so characteristic of Gothic art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9534ee48-899f-3775-807a-1852f887db9a",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "A word used to join other words, phrases, or clauses together into sentences. (The specific conjunction used shows how the two joined parts are related semantically.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c703959c-36ed-404b-b886-f525e460e406",
                                                "sense_id": "9534ee48-899f-3775-807a-1852f887db9a",
                                                "text": "A comma is placed between short members of compound sentences, connected by and, but, for, nor, or, because, whereas, that expressing purpose (so that, in order that), and other conjunctions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ec7f874-eaf2-3259-bde4-e1a7543d260b",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "Cooccurrence; coincidence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949c41c9-8624-4618-bb7d-cde5a689557a",
                                                "sense_id": "0ec7f874-eaf2-3259-bde4-e1a7543d260b",
                                                "text": "[…] the coexistence of one such phenomenon with another; or the succession of one such phenomenon to another: their conjunction, in short, so that where the one is found, we may calculate on finding both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d987ee8-517c-34ab-a481-ef58461d2545",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "The alignment of two bodies in the solar system such that they have the same longitude when seen from Earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82722af4-acd9-4cf4-b7f0-38a5248fff49",
                                                "sense_id": "1d987ee8-517c-34ab-a481-ef58461d2545",
                                                "text": "The spectacular conjunction of Venus and Mars gave rise to a myriad of mythical interpretations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3fcc9b2-cc93-3808-9c3b-1db36ac5b039",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "An aspect in which planets are in close proximity to one another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9340d453-df1d-3163-adce-ca928bedfdec",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "The proposition resulting from the combination of two or more propositions using the ∧ ( and ) operator."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4557b5f9-6dd1-342d-b532-2bf6f35b913f",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "A place where multiple things meet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4807d119-2fbf-4455-85fb-df406c475686",
                                                "sense_id": "4557b5f9-6dd1-342d-b532-2bf6f35b913f",
                                                "text": "Today there is a mountain called Ararat near the conjunction of the Turkish, Armenian, and Iranian borders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e0811d2-6ba5-328b-b645-4049b7c9344a",
                                        "entry_id": "cfa8549f-4269-366c-8e04-06958498d47b",
                                        "glosses": [
                                            "Sexual intercourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f3fcc2b-5ac7-4709-812d-3c93870f79ca",
                                                "sense_id": "8e0811d2-6ba5-328b-b645-4049b7c9344a",
                                                "text": "Certaine Nations (and amongst others, the Mahometane) abhorre Conjunction with women great with childe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b94d8d1-b5d1-4424-8b04-98d1f6c758dd",
                        "source_entry_id": "bc9b298a-e630-3a7a-994d-5d7ef38475e2",
                        "target_lang_word": "conjonction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjonction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a7d040-748e-3329-a664-287a6036ad29",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "Partie du discours qui sert à unir deux mots ou groupes de mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272ac870-2a55-43a4-96f3-46676fa248a5",
                                                "sense_id": "d7a7d040-748e-3329-a664-287a6036ad29",
                                                "text": "– J’y compte bien, quoique...\nIl était écrit là-haut que les confidences de la marquise seraient interrompues encore une fois. Elle n’acheva pas la phrase qu’elle venait de commencer par une conjonction restrictive, ou, si elle l’acheva, le reste se perdit dans le fracas de l’orchestre, subitement déchaîné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000eb475-c892-3ade-a11c-a6b3a1ace711",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "Rencontre apparente de deux planètes dans un même point de quelque signe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077c2960-a8d1-4b68-ae1d-94ae2bc676d6",
                                                "sense_id": "000eb475-c892-3ade-a11c-a6b3a1ace711",
                                                "text": "Nul n’est plus curieux d’apprendre […] à quelle heure de la nuit Mars entre en conjonction avec Vénus."
                                            },
                                            {
                                                "example_id": "6083c9c5-9d34-4a89-8ee6-bae454fd0830",
                                                "sense_id": "000eb475-c892-3ade-a11c-a6b3a1ace711",
                                                "text": "Un jour, dans la faste conjonction des astres, le ciel de sa vie de femme enceinte se mit à gronder d’un vif orage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f52fa8-5cb3-3cbc-94b5-0cb0cbf28bb7",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "La rencontre de la Lune avec le Soleil dans un même point du zodiaque."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d16426-67a6-4593-8fcd-ef5f04533e64",
                                                "sense_id": "92f52fa8-5cb3-3cbc-94b5-0cb0cbf28bb7",
                                                "text": "La conjonction de la Lune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d6564eb-1d21-325a-bf6e-86571a2af071",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "Union, réunion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "526f1db9-2083-3a45-b8c3-3ab5fb8dbcc2",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "Union de deux personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62428a65-1303-4e08-9f2d-c48c77b0d99f",
                                                "sense_id": "526f1db9-2083-3a45-b8c3-3ab5fb8dbcc2",
                                                "text": "Conjonction par mariage."
                                            },
                                            {
                                                "example_id": "2e8f5426-6dda-440b-92e6-c94c749e7d7a",
                                                "sense_id": "526f1db9-2083-3a45-b8c3-3ab5fb8dbcc2",
                                                "text": "« Faites vos provisions d'un plaisir qu'on ne trouve pas au Paradis », conseillait Abou-Nowâs, faisant bien évidemment allusion à la conjonction des imberbes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5fed956-b264-3a9d-bf1b-fff4a2b2ccd6",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "Union de deux choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99e77497-2718-428f-a645-b648fe458a72",
                                                "sense_id": "c5fed956-b264-3a9d-bf1b-fff4a2b2ccd6",
                                                "text": "Composé d’hommes du centre droit (M. Buffet, etc.) et du centre gauche (MM. Dufaure, Léon, Say…) le ministère, dit de conjonction des centres, fit voter la constitution républicaine."
                                            },
                                            {
                                                "example_id": "bf161973-49b6-46f9-b3a3-ca977242e825",
                                                "sense_id": "c5fed956-b264-3a9d-bf1b-fff4a2b2ccd6",
                                                "text": "À partir de 1953, l'année de la mort de Staline, le lyssenkisme connut une éclipse partielle, due à une conjonction de plusieurs facteurs : le décès de son protecteur, le caractère rocambolesque de la métamorphose des espèces […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd4a5bc0-6509-38f0-bfa3-01b64a3b31e1",
                                        "entry_id": "59dbc38d-0025-3ad2-9add-6483bc143bff",
                                        "glosses": [
                                            "Connecteur logique binaire, synonyme de et logique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
