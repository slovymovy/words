                        "sense_id": "c4d41a89-bf95-33e5-9786-1905879624a7",
                        "entry_id": "cb354207-3878-35b9-a16e-87b434f3440e",
                        "glosses": [
                            "Libérer des molécules cytotoxiques antimicrobiennes ou d’autres molécules à partir de vésicules de sécrétion, appelées granules, présentes dans certaines cellules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0abaf13-1299-4e9e-8d82-6883816da552",
                                "sense_id": "c4d41a89-bf95-33e5-9786-1905879624a7",
                                "text": "D’autres agents capables de dégranuler les basophiles à des concentrations « classiques », s’avèrent eux aussi capables de faire dégranuler les basophiles à hautes dilutions."
                            },
                            {
                                "example_id": "a9ea24b1-6a14-400d-b1b4-5ccf71c6c00c",
                                "sense_id": "c4d41a89-bf95-33e5-9786-1905879624a7",
                                "text": "Je savais que les crises d’asthme étaient bien stabilisées avec une molécule, le cromoglycate de sodium qui agissait sur les mastocytes tissulaires en les empêchant de dégranuler."
                            },
                            {
                                "example_id": "afcf4285-4d64-4242-9d0c-9d28f24f04ab",
                                "sense_id": "c4d41a89-bf95-33e5-9786-1905879624a7",
                                "text": "Lors d’une autre rencontre avec ces allergènes, les mastocytes vont se « dégranuler » et libérer ces médiateurs chimiques au potentiel inflammatoire."
                            }
                        ]
                    }
