                                "target_senses": [
                                    {
                                        "sense_id": "0c7891c9-11c5-314d-ba83-77c8d9747624",
                                        "entry_id": "137a6e40-d260-3638-86a8-eec527aa6188",
                                        "glosses": [
                                            "The state of being brutal."
                                        ],
                                        "tags": [
                                            "countable",
