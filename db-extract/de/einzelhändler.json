                "senses": [
                    {
                        "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                        "entry_id": "0042ce6e-977e-3623-aa48-ce9858a2df8d",
                        "glosses": [
                            "Person oder Firma, die Waren ohne weitere Be- oder Verarbeitung an die Verbraucher verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8706bf47-dec6-4c66-83f8-23759ce35ce4",
                                "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                "text": "Der Einzelhändler verkauft die Teppiche an die Endverbraucher."
                            },
                            {
                                "example_id": "265b077b-cace-41aa-a10d-62bf8f044fc0",
                                "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                "text": "„Plötzlich machte er damit ein richtig gutes Geschäft, obwohl er eigentlich nur Einzelhändler war.“"
                            },
                            {
                                "example_id": "5542e0de-c642-4e68-a1d0-6e5ef8d4a208",
                                "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                "text": "„Das neu entwickelte Fachmarktzentrum auf dem früheren Baumax-Standort im Gewerbepark Stadlau ist langfristig an Einzelhändler wie Intersport, TK Maxx, Lidl, dm und ccc shoes vermietet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
