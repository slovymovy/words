                                "target_lang_sense_clarification": "специальный, личный"
                            },
                            {
                                "target_lang_word": "осо́бенный",
                                "target_lang_sense_clarification": "уникальный для кого-то"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "special",
                                "target_lang_sense_clarification": "dear, valued, or of personal significance"
                            },
                            {
