                                "target_senses": [
                                    {
                                        "sense_id": "7308a6d4-eff0-3288-9a63-2cf5dfd3ec1a",
                                        "entry_id": "51ff7991-5e1c-3973-9466-7ef8fa36c547",
                                        "glosses": [
                                            "Able to be represented by a map."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c25529-728e-42b3-a866-7942b8ef873a",
                                                "sense_id": "7308a6d4-eff0-3288-9a63-2cf5dfd3ec1a",
                                                "text": "Satellite imagery has made many inaccessible areas much more mappable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0be633e6-8d90-3ea4-89af-498f4bb383d8",
                                        "entry_id": "51ff7991-5e1c-3973-9466-7ef8fa36c547",
                                        "glosses": [
                                            "Able to be associated with something else by means of a mapping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d98042-72c6-4cae-b547-4d0e48166548",
                                                "sense_id": "0be633e6-8d90-3ea4-89af-498f4bb383d8",
                                                "text": "Computers on the Internet are mappable to IP addresses."
                                            },
                                            {
                                                "example_id": "f2862d46-00f9-4651-8cef-f9fc46936f03",
                                                "sense_id": "0be633e6-8d90-3ea4-89af-498f4bb383d8",
                                                "text": "This analysis suggests that the concept of homosexuality — indeed the whole notion of sexual orientation — is specific to our time and place and cannot be assumed to be mappable onto other cultures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
