                "senses": [
                    {
                        "sense_id": "d6c0442d-c833-3903-ad41-f01fdfc83dbf",
                        "entry_id": "4949a4ea-4277-39d9-bc59-0b5619628734",
                        "glosses": [
                            "boiling water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535f0728-14c4-4b1d-ac5b-aa1ff3e1ae4d",
                                "sense_id": "d6c0442d-c833-3903-ad41-f01fdfc83dbf",
                                "text": "Перепел падал, как ошпаренный кипятком.",
                                "translation": "The quail fell down as if scalded with boiling water.",
                                "english": "The quail fell down as if scalded with boiling water."
                            },
                            {
                                "example_id": "a3ccbe79-2d3c-469b-a3d8-7312986e138a",
                                "sense_id": "d6c0442d-c833-3903-ad41-f01fdfc83dbf",
                                "text": "Я кончаюсь, Горбунок: Царь велит мне в кипяток!",
                                "translation": "I'm going to be ended, Humpback: The king orders me [to dive] into boiling water!",
                                "english": "I'm going to be ended, Humpback: The king orders me [to dive] into boiling water!"
                            }
                        ]
                    },
                    {
                        "sense_id": "aed06ab5-5c06-35b4-aeb4-60bdc84e19ae",
                        "entry_id": "4949a4ea-4277-39d9-bc59-0b5619628734",
                        "glosses": [
                            "hot water served as a hot beverage"
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0071f8cb-139a-3c36-85c4-8d56a3106161",
                        "entry_id": "4949a4ea-4277-39d9-bc59-0b5619628734",
                        "glosses": [
                            "water that was boiled and then cooled to room temperature, as for example to make nonpotable tapwater be potable."
                        ],
