                                        "examples": [
                                            {
                                                "example_id": "247e8fdd-7138-487e-b87a-5afbbab4cb1b",
                                                "sense_id": "c5d00a80-f5bc-3f1d-8be2-cf00bca31c6d",
                                                "text": "Partant de là, Duns Scot déduit très logiquement que la nature humaine en Jésus-Christ non seulement possède l’être essentiel […] mais encore l’être existentiel […] Il semble alors que Duns Scot soit acculé au nestorianisme."
                                            },
                                            {
                                                "example_id": "a88bf9c7-5767-4358-8a44-c498ff44b4ba",
                                                "sense_id": "c5d00a80-f5bc-3f1d-8be2-cf00bca31c6d",
                                                "text": "Le nestorianisme trouve son origine dans une controverse entre le patriarche de Constantinople Nestorius et celui d’Alexandrie Cyrille."
                                            }
                                        ]
                                    }
