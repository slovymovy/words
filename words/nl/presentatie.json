                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij houden een <w>presentatie</w> over hun onderzoek.",
                            "target_lang_translations": {
