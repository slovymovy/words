                        "form": "das Vorfeld"
                    },
                    {
                        "form_id": "b7e9f064-594c-4927-9667-c535c9a19ba7",
                        "entry_id": "4fc93824-43e3-3125-948d-3b3551f76023",
                        "tags": [
                            "accusative",
