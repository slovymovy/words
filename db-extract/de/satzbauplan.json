                "senses": [
                    {
                        "sense_id": "0b79b662-db97-3a56-a3d7-e506bd10e6d9",
                        "entry_id": "fe4c3c3a-42a6-3d40-b8a7-5cef2bea406e",
                        "glosses": [
                            "Strukturmuster, das einer Vielzahl von Sätzen zugrunde liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e15bc9fa-5420-4b4b-b211-1712eb5af21f",
                                "sense_id": "0b79b662-db97-3a56-a3d7-e506bd10e6d9",
                                "text": "Satzbaupläne sind die grammatischen Strukturen, die den einzelnen Sätzen zugrunde liegen. Sätze wie \"Inge liebt Bücher\" und \"Der Junge sucht seinen Ball\" erfüllen den gleichen Satzbauplan."
                            },
                            {
                                "example_id": "8f7f859e-d49d-4732-afd9-a91a88bbcba2",
                                "sense_id": "0b79b662-db97-3a56-a3d7-e506bd10e6d9",
                                "text": "Der Begriff Satzbauplan stammt aus der inhaltbezogenen Grammatik, die einen Zusammenhang zwischen der Form und der zugrundeliegenden Bedeutung der Sätze sah."
                            },
                            {
                                "example_id": "d77b29f6-d33a-430b-a3e5-1bd1b78eb131",
                                "sense_id": "0b79b662-db97-3a56-a3d7-e506bd10e6d9",
                                "text": "In neueren Grammatiken werden Satzbaupläne aus der Valenz der Verben hergeleitet."
                            },
                            {
                                "example_id": "de14cbf9-3dcd-41bf-9aa4-02f5e23ad9ae",
                                "sense_id": "0b79b662-db97-3a56-a3d7-e506bd10e6d9",
                                "text": "„Aus diesem Grund wird nur die Suche nach Verben, die mit einem bestimmten Satzbauplan verwendet werden, ausführlich dargestellt.“"
                            },
                            {
                                "example_id": "6dd82288-eb9e-4a6a-b70e-bbec7210b818",
                                "sense_id": "0b79b662-db97-3a56-a3d7-e506bd10e6d9",
                                "text": "„Das notwendige Auftreten der Ergänzungen im Satzbauplan bezieht sich auf die Grammatikalität, nicht auf die Aussageabsicht oder die subjektive Wichtigkeit der Mitteilung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
