                                    {
                                        "sense_id": "9859153d-62c1-3879-bd30-d860c1b5d7fd",
                                        "entry_id": "d04a019e-8411-3a6a-866a-6bb53616a003",
                                        "glosses": [
                                            "Either of the two organs on the front of a female human's chest, which contain the mammary glands; also the analogous organs in males."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "211ece78-1e25-433b-bd35-67ddbcd0f3e0",
                                                "sense_id": "9859153d-62c1-3879-bd30-d860c1b5d7fd",
                                                "text": "Tanya’s breasts grew remarkably during pregnancy."
                                            },
                                            {
                                                "example_id": "cd25cd5e-bfb3-4d9d-b990-9fd533884aaa",
                                                "sense_id": "9859153d-62c1-3879-bd30-d860c1b5d7fd",
                                                "text": "Biblical criteria of sexual seductiveness include a white skin, black hair, or henna-dyed, scarlet lips, a prominent nose, rosy temples, long straight neck, firm breasts, round thighs, an erect posture."
                                            },
                                            {
                                                "example_id": "489df6cd-d564-4124-bcdb-791124b95bc1",
                                                "sense_id": "9859153d-62c1-3879-bd30-d860c1b5d7fd",
                                                "text": "Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e06bb54f-e4c8-307f-bc7e-2a1fac539837",
                                        "entry_id": "d04a019e-8411-3a6a-866a-6bb53616a003",
                                        "glosses": [
                                            "The chest, or front of the human thorax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ade235-39a5-48b3-bd3d-f2c97dd98640",
                                                "sense_id": "e06bb54f-e4c8-307f-bc7e-2a1fac539837",
                                                "text": "The Wedding-Guest here beat his breast, / For he heard the loud bassoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "481ed065-aa85-3851-8ffb-bddaa9e22409",
                                        "entry_id": "d04a019e-8411-3a6a-866a-6bb53616a003",
                                        "glosses": [
                                            "A section of clothing covering the breast area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff559f0-4dab-4d23-a06f-1e19b65031a3",
                                                "sense_id": "481ed065-aa85-3851-8ffb-bddaa9e22409",
                                                "text": "By the time he reached the War Memorial damp had soaked through the breasts of his shirt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81cdbb5-9d1d-3fb3-85be-29ec41159062",
                                        "entry_id": "d04a019e-8411-3a6a-866a-6bb53616a003",
                                        "glosses": [
                                            "The figurative seat of the emotions, feelings etc.; one’s heart or innermost thoughts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64de5fe8-8687-4f36-aebe-e6936ae1c647",
                                                "sense_id": "b81cdbb5-9d1d-3fb3-85be-29ec41159062",
                                                "text": "She kindled hope in the breast of all who heard her."
                                            },
                                            {
                                                "example_id": "4e39bf39-daae-4878-a06c-8a56b8986685",
                                                "sense_id": "b81cdbb5-9d1d-3fb3-85be-29ec41159062",
                                                "text": "He has a loyal breast."
                                            },
                                            {
                                                "example_id": "528fcf34-7ee6-47fb-a53f-3443532e6904",
                                                "sense_id": "b81cdbb5-9d1d-3fb3-85be-29ec41159062",
                                                "text": "[…]Thou best know’st\nWhat torment I did find thee in. Thy groans\nDid make wolves howl, and penetrate the breasts\nOf ever-angry bears—it was a torment\nTo lay upon the damn’d, which Sycorax\nCould not again undo. It was mine art,\nWhen I arrived and heard thee, that made gape\nThe pine and let thee out."
                                            },
                                            {
                                                "example_id": "8dff6b4f-80f9-4332-ab00-b104e450562e",
                                                "sense_id": "b81cdbb5-9d1d-3fb3-85be-29ec41159062",
                                                "text": "Muſick has Charms to ſooth a ſavage Breaſt, / To ſoften Rocks, or bend a knotted Oak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd06761-4e6e-334a-b596-21d2eea08afa",
                                        "entry_id": "d04a019e-8411-3a6a-866a-6bb53616a003",
                                        "glosses": [
                                            "The ventral portion of an animal’s thorax."
                                        ],
                                        "tags": [],
                                        "examples": [
