                                        "sense_id": "90b6875d-915c-32ea-a041-eb28f1bb399b",
                                        "entry_id": "ca93c5d2-c335-3364-88cf-6862f8ee6b54",
                                        "glosses": [
                                            "A percussive instrument made of metal or other hard material, typically but not always in the shape of an inverted cup with a flared rim, which resonates when struck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9af3f4a-ba44-4264-bef3-4b0be12c7ee2",
                                                "sense_id": "90b6875d-915c-32ea-a041-eb28f1bb399b",
                                                "text": "HEAR the sledges with the bells —\nSilver bells!\nWhat a world of merriment their melody foretells!"
                                            },
                                            {
                                                "example_id": "2c90a145-ac89-46c8-a1a6-bf85ce854bf7",
                                                "sense_id": "90b6875d-915c-32ea-a041-eb28f1bb399b",
                                                "text": "The bell which called the pupils to their lessons can still be seen on the roof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80587233-a158-3316-9bb2-e0b654a080e6",
                                        "entry_id": "ca93c5d2-c335-3364-88cf-6862f8ee6b54",
                                        "glosses": [
                                            "An instrument that emits a ringing sound, situated on a bicycle's handlebar and used by the cyclist to warn of their presence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bf35738-6ba3-3269-b20a-7157fb2eb87f",
                                        "entry_id": "ca93c5d2-c335-3364-88cf-6862f8ee6b54",
                                        "glosses": [
                                            "The sounding of a bell as a signal."
