                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6624d637-7976-42d1-a868-f3e10f9858a9",
                        "entry_id": "82c58c46-5c0b-3eba-897c-dbd13d90828c",
                        "tags": [
                            "plural"
