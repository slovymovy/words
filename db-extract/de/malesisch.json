                ],
                "senses": [
                    {
                        "sense_id": "d9f4ed89-6b7a-32f5-9a8f-62b5b067bbbd",
                        "entry_id": "b73d8329-efe0-3fac-9b57-a7e944095bbf",
                        "glosses": [
                            "in Bezug auf Malesien, einer phytogeographischen Region in Südostasien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "351d2057-be32-447b-8ea2-dcf1c6efe174",
                                "sense_id": "d9f4ed89-6b7a-32f5-9a8f-62b5b067bbbd",
                                "text": "„Die meisten Anklänge sind natürlich in der afrikanischen Flora vorhanden, aber auch die zur indischen und besonders malesischen Flora sind zahlreich, ja sogar solche an die kanarischen Inseln und Südamerika fehlen nicht.“"
                            },
                            {
                                "example_id": "b207db41-6c9d-4fbb-a3da-4ae1e134e322",
                                "sense_id": "d9f4ed89-6b7a-32f5-9a8f-62b5b067bbbd",
                                "text": "„Der Dammarbaum gehört zu den allergrössten Bäumen des malesischen Primärwaldes, der von weitem einer Tanne nicht unähnlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
