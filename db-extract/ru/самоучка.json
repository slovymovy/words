                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7c90307-cac4-3e12-941d-6ac2ed9ef6b1",
                        "entry_id": "2dceba87-c7a7-3b51-942b-ec9aedde81ab",
                        "glosses": [
                            "разг. человек, выучившиеся чему-либо самостоятельно, без систематической подготовки, без руководителя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24185cb2-9583-4848-8210-55b286b40aaa",
                                "sense_id": "e7c90307-cac4-3e12-941d-6ac2ed9ef6b1",
                                "text": "Живой обмен мнениями, совместные научные эксперименты ― эта поездка стала подлинным университетом для Фарадея, гениального самоучки, не получившего никакого системного образования."
                            },
                            {
                                "example_id": "ee388745-ab5e-41d7-b7ae-9fc86fdd1520",
                                "sense_id": "e7c90307-cac4-3e12-941d-6ac2ed9ef6b1",
                                "text": "Самоучка, не получивший в школьные годы даже начального образования, он рано начал писать стихи."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "722061fc-498c-41f8-ab35-32819cc468ba",
                        "source_entry_id": "2dceba87-c7a7-3b51-942b-ec9aedde81ab",
                        "source_sense_id": "e7c90307-cac4-3e12-941d-6ac2ed9ef6b1",
                        "target_lang_word": "self-taught",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-taught",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424180b8-c47f-3f39-ba94-dfb2a1426d62",
                                        "entry_id": "272068e7-6c49-39f0-92a6-e75696641fa6",
                                        "glosses": [
                                            "Educated or trained by oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a162cd-021b-47e2-9512-208d0c8959fc",
                                                "sense_id": "424180b8-c47f-3f39-ba94-dfb2a1426d62",
                                                "text": "It's this understanding of Quality as revealed by stuckness which so often makes self-taught mechanics so superior to institute-trained men who have learned how to handle everything except a new situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63df12b9-6c09-4888-9e93-09a92f4ceef0",
                        "source_entry_id": "2dceba87-c7a7-3b51-942b-ec9aedde81ab",
                        "source_sense_id": "e7c90307-cac4-3e12-941d-6ac2ed9ef6b1",
                        "target_lang_word": "autodidact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodidact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                        "entry_id": "8cac2d64-0285-3b79-b3a9-8fbac9e5a21e",
                                        "glosses": [
                                            "A self-taught person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f618d195-6ca0-4696-8999-0895475c0cc5",
                                                "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                                "text": "Leonardo Da Vinci is one of the greatest autodidacts."
                                            },
                                            {
                                                "example_id": "f12b5784-ec6a-487f-972c-0595ecbbdc6c",
                                                "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                                "text": "For an autodidact, for somebody who plays by ear like me, the ukulele is ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f341a4-915b-4d4c-a5a5-917b2023fd65",
                        "source_entry_id": "2dceba87-c7a7-3b51-942b-ec9aedde81ab",
                        "source_sense_id": "e7c90307-cac4-3e12-941d-6ac2ed9ef6b1",
