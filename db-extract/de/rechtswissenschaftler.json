                    {
                        "sense_id": "c0c44fe8-0a00-370c-ab6a-28830115e19e",
                        "entry_id": "96f84ea1-8045-38b5-95a5-0ed0be017594",
                        "glosses": [
                            "eine Person mit wissenschaftlicher Ausbildung, die sich mit der Rechtswissenschaft beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8bd0cb1-4f06-4518-a155-faf9d95858f8",
                                "sense_id": "c0c44fe8-0a00-370c-ab6a-28830115e19e",
                                "text": "„Vermutlich wäre es nicht so gekommen, hätte es nicht die vielen Zeitungsberichte gegeben, die Empörung im ganzen Land über den Tod des jungen Mannes und die Unterstützung der anderen Rechtswissenschaftler.“"
                            },
                            {
                                "example_id": "1baa6bc6-5ba0-4ba3-b648-c5be2e357757",
                                "sense_id": "c0c44fe8-0a00-370c-ab6a-28830115e19e",
                                "text": "„Ohnehin sei juristische Forschung, wie sie jetzt in Kooperation mit den russischen Strafrechtlern erfolgt […], keine Selbstverständlichkeit, so der Potsdamer Rechtswissenschaftler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
