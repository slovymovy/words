                                "example_id": "5c92a828-e0fc-4c17-8328-4ef892b5b7b0",
                                "sense_id": "73066ff5-1bd4-3fc0-8213-66f11f9578cf",
                                "text": "In the actual sounds of many of the Hebrew letters lies a singular power, unguessed by the majority, undivined especially, of course, by the mere scholar, but available for the pure in heart who may discover how to use their extraordinary values."
                            },
                            {
                                "example_id": "33850f7e-7d47-4d47-ac14-61aa0d4a3b77",
                                "sense_id": "73066ff5-1bd4-3fc0-8213-66f11f9578cf",
                                "text": "He looked up at the sound of the swift step and the sudden stir, and for one instant their eyes met--an inscrutable look, fraught with an undivined meaning."
                            }
                        ]
                    }
