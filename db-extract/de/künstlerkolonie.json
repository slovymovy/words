                        "source_sense_id": "25b673fc-ad7a-3ac0-8963-0ad0163f49d1",
                        "source_sense_description": "Lebens- und Arbeitsgemeinschaft von Künstlern",
                        "target_lang_word": "kunstenaarskolonie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kunstenaarskolonie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb38d31-82c5-3340-b125-1f86f54468c5",
                                        "entry_id": "34dc6133-d95a-33f2-8abf-a47f8ae33e5a",
                                        "glosses": [
                                            "een gesloten gemeenschap van kunstenaars, die zich terug hebben getrokken uit de maatschappij om zich aan de kunst te wijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aea86eb-68e0-47cd-8bbb-f7398ea4a23f",
                                                "sense_id": "9eb38d31-82c5-3340-b125-1f86f54468c5",
                                                "text": "Het oorlogsgebied te Loenen ontvlucht probeerde ik, in godsnaam dan maar, mijn boek af te maken op De Pauwhof, een gedoemde Wassenaarse kunstenaarskolonie, waar je geacht werd thee te drinken met de weduwen van aan de drank gestorven beeldhouwers."
                                            },
                                            {
                                                "example_id": "a23cb910-0a7a-4c6a-ae63-4592571a694f",
                                                "sense_id": "9eb38d31-82c5-3340-b125-1f86f54468c5",
                                                "text": "Othello en Desdemona wordt teruggegeven aan de nabestaanden van het echtpaar Heller. Beiden zijn inmiddels overleden. Het plan is om de Chagall te veilen. De opbrengsten worden gebruikt om de verzekering terug te betalen. De rest van het geld wordt overgemaakt aan goededoelenorganisaties, waaronder een kunstenaarskolonie in New Hampshire."
                                            }
                                        ]
                                    }
                                ]
                            }
