                ],
                "senses": [
                    {
                        "sense_id": "776fc57b-5126-35dd-9c06-e0352b75bda3",
                        "entry_id": "b72d4455-db64-398e-8786-7a89d9a0c6bc",
                        "glosses": [
                            "Faire redevenir beau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46137100-b3c3-481c-9d3a-94c19b11928b",
                                "sense_id": "776fc57b-5126-35dd-9c06-e0352b75bda3",
                                "text": "Le coeur me dit que les émeutes, les bagarres, etc. vous auront rembellie, rengraissée."
                            },
                            {
                                "example_id": "b0de4f20-aefd-4be7-a62b-cb475400bceb",
                                "sense_id": "776fc57b-5126-35dd-9c06-e0352b75bda3",
                                "text": "Enfin, les ans gâtèrent tellement le teint, les traits de mon visage, que la céruse et le vermillon n'étoient pas capables de me rembellir."
                            },
                            {
                                "example_id": "f30665ea-761f-4c53-b471-0026711db380",
                                "sense_id": "776fc57b-5126-35dd-9c06-e0352b75bda3",
                                "text": "Leurs enfants en seraient plus beaux, la noblesse se verrait rembellie."
                            }
                        ]
                    }
                ],
