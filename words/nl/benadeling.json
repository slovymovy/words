{
    "word_family": [
        "benadelen",
        "nadeel",
        "nadelig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c24c8c48-a7a4-3892-b67b-347b5505da83",
                    "sense_definition": "het proces of de handeling waarbij iemand of iets wordt benadeeld",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>benadeling</w> van de consument door misleidende reclame is wettelijk verboden.",
                            "target_lang_translations": {
                                "ru": "<w>Ущемление интересов</w> потребителя посредством вводящей в заблуждение рекламы запрещено законом."
                            }
                        },
                        {
                            "text": "Er was sprake van opzettelijke <w>benadeling</w> van de andere partij tijdens de onderhandelingen.",
                            "target_lang_translations": {
                                "ru": "Во время переговоров имело место преднамеренное <w>нанесение ущерба</w> другой стороне."
                            }
                        }
                    ],
                    "synonyms": [
                        "benadeeling",
                        "schadeberokkening"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс или действие, в результате которого кому-либо или чему-либо наносится ущерб"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущемление",
                                "target_lang_sense_clarification": "процесс нарушения прав или интересов"
                            },
                            {
                                "target_lang_word": "нанесение ущерба",
                                "target_lang_sense_clarification": "действие, причиняющее вред"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83bf5be-d2fa-3a6e-8c02-2a00a32c9821",
                    "sense_definition": "het ondervonden verlies of nadeel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>benadeling</w> van de supporters was niet in goede aarde gevallen.",
                            "target_lang_translations": {
                                "ru": "<w>Ущерб</w>, нанесенный болельщикам, был воспринят крайне негативно."
                            }
                        },
                        {
                            "text": "Hij eiste een schadevergoeding voor de geleden <w>benadeling</w> door de foutieve beslissing.",
                            "target_lang_translations": {
                                "ru": "Он потребовал компенсацию за <w>убытки</w>, понесенные из-за ошибочного решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "nadeel",
                        "verlies"
                    ],
                    "antonyms": [
                        "voordeel"
                    ],
                    "target_lang_definitions": {
                        "ru": "понесенный убыток или невыгодное положение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "понесенные потери или вред"
                            },
                            {
                                "target_lang_word": "убыток",
                                "target_lang_sense_clarification": "материальная или иная потеря"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce5bb59-54e0-3132-b5cb-e36d7fb23138",
                    "sense_definition": "aanzienlijk onevenwicht tussen wederzijdse prestaties in een overeenkomst",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter vernietigde het contract vanwege de enorme <w>benadeling</w> van de koper.",
                            "target_lang_translations": {
                                "ru": "Судья аннулировал контракт из-за серьезного <w>ущемления интересов</w> покупателя."
                            }
                        },
                        {
                            "text": "Juridisch gezien is er bij deze verkoop sprake van een duidelijke <w>benadeling</w> van de verkopende partij.",
                            "target_lang_translations": {
                                "ru": "С юридической точки зрения, в этой сделке купли-продажи имеет место явное <w>ущемление интересов</w> продающей стороны."
                            }
                        }
                    ],
                    "synonyms": [
                        "wanverhouding"
                    ],
                    "target_lang_definitions": {
                        "ru": "значительный дисбаланс между взаимными обязательствами в договоре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущемление интересов",
                                "target_lang_sense_clarification": "юридический контекст неравноправного положения"
                            },
                            {
                                "target_lang_word": "невыгодное положение",
                                "target_lang_sense_clarification": "состояние дисбаланса в сделке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}