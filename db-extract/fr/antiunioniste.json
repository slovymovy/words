                        "entry_id": "5f0372c7-e99d-3c05-a15a-cc4a331efdf3",
                        "glosses": [
                            "(Deuxième quart du XIXᵉ s.) Opposé à l’union du Haut-Canada et du Bas-Canada."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a5efbbe6-4d79-4023-a0ed-7caf458611f4",
                                "sense_id": "8f7ec2b1-9d96-30e3-814a-c7b5b79353ea",
                                "text": "Des comités antiunionistes furent mis sur pied."
                            }
                        ]
                    }
