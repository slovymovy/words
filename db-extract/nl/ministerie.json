                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bc84026-28ea-331b-a0cb-448c438ea211",
                                        "entry_id": "19f2b65b-0402-305f-b518-ed4116bba9f8",
                                        "glosses": [
                                            "ein Gebäude, in dem ^([1]) seinen Sitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea987559-614f-449c-8e10-3f64f624ea32",
                                                "sense_id": "7bc84026-28ea-331b-a0cb-448c438ea211",
                                                "text": "Das Ministerium für Umwelt, Forsten und Verbraucherschutz Rheinland-Pfalz ist in Mainz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
