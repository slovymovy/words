                        "examples": [
                            {
                                "example_id": "8c991395-7e6c-4bc1-824f-02777b93e044",
                                "sense_id": "a9f368ba-b533-3b0c-879a-8308eaf4f50f",
                                "text": "Tegelijk is die onwrikbare zelfzekerheid een van de charmes van Smeets: zo arrogant kan hij zijn dat het haast aandoenlijk wordt, en je het hem bijna zou vergeven. Waarschijnlijk is dat ook de reden waarom Vlamingen na Vive le Vélo vaak nog De Avondetappe meepikken: stiekem genieten we van onze ergernis aan de Spetterende Spraakwaterval genaamd Smeets."
                            },
                            {
                                "example_id": "257c1151-6858-4589-9fae-2398d7c59d00",
                                "sense_id": "a9f368ba-b533-3b0c-879a-8308eaf4f50f",
                                "text": "Scholte speelt de superieure sofist die als geen ander weet dat we in niets moeten geloven, en dat alles schijn en bedrog is. Maar wie deze impasse - én zijn eigen impasse - denkt te kunnen illustreren met de zelfzekerheid van een onheilsprofeet, bedriegt ook nog zichzelf."
                            }
                        ]
                    },
                    {
                        "sense_id": "721b2b4d-f3f2-39e0-80c4-b7258f1b87ac",
                        "entry_id": "f1c86b2b-e3e1-328c-b99b-988a0eb5cded",
                        "glosses": [
                            "bestaanszekerheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8a7fabc-7476-4047-893f-07768248982a",
                                "sense_id": "721b2b4d-f3f2-39e0-80c4-b7258f1b87ac",
                                "text": "De wens macht te hebben over anderen is vermoedelijk terug te voeren tot de truc die zuigelingen uithalen om ouders voor hun kar te spannen ten behoeve van hun eigen zelfzekerheid."
                            }
                        ]
                    }
