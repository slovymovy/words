                        "examples": [
                            {
                                "example_id": "b743bdbc-213d-4a0c-93d8-702444af7501",
                                "sense_id": "9ad050b2-83c8-3955-a61b-635234729ddc",
                                "text": "„Die Tunneldecke zischte über ihr dahin.“"
                            },
                            {
                                "example_id": "1a6e099b-fc38-43c6-b2df-4446eaad69ac",
                                "sense_id": "9ad050b2-83c8-3955-a61b-635234729ddc",
                                "text": "„Aber innerhalb der nächsten dreieinhalb Monate kehrten die russischen Bratwa-Männer dreimal an ihre Baustelle zurück, räumten das Geröll weg, schütteten es in den See und befestigten die Tunnelwände und die Tunneldecke wieder.“"
                            }
                        ],
