                            {
                                "example_id": "c354df3e-c409-4ddb-a09f-655c2d534a85",
                                "sense_id": "324be79d-1d29-3c85-8749-5c6f56a8b1d1",
                                "text": "De politie vond in de auto inbrekersgereedschap en jerrycans met benzine. Bij het fietspad waar de twee reden werd een grondmachine gevonden met daarnaast een doorgesneden brandstofleiding. Ook was de auto van de verdachten waarschijnlijk gestolen."
                            },
                            {
                                "example_id": "44a2a0d0-4d96-41d1-a301-8ee5b9c36b2a",
                                "sense_id": "324be79d-1d29-3c85-8749-5c6f56a8b1d1",
                                "text": "Verder moeten alle VW's met een 7-traps automatische versnellingsbak (DSG) terug, vanwege een probleem met de olie in de versnellingsbak. Ook de pick-up Amarok valt onder de terugroepactie, wegens een mogelijke lekkage van de brandstofleiding."
                            },
                            {
                                "example_id": "b67c8d1a-9e57-4923-a81c-157a2c38b8f6",
                                "sense_id": "324be79d-1d29-3c85-8749-5c6f56a8b1d1",
                                "text": "Het gaat vooral om auto's in thuisland Japan. In de brandstofleiding kunnen kleine scheurtjes ontstaan en die mogelijk lekkages veroorzaken."
                            }
                        ]
