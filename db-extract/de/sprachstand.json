                ],
                "senses": [
                    {
                        "sense_id": "4773f4b2-17eb-3e5a-86bb-92ba165ddb39",
                        "entry_id": "0d7ac9ce-7693-3f5a-9817-d99280a41184",
                        "glosses": [
                            "erreichtes Niveau der Kenntnis einer Sprache"
                        ],
                        "tags": [
                            "speziell Sprachdidaktik"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d0d323-649f-45c2-80e0-3db968fdf331",
                                "sense_id": "4773f4b2-17eb-3e5a-86bb-92ba165ddb39",
                                "text": "„Diese unterschiedlichen Sprachstände sind ein wesentlicher Faktor der didaktischen Planung des Lernens in zwei Sprachen.“"
                            },
                            {
                                "example_id": "8f0ac14a-a499-4a27-8d27-e416e7efc5fa",
                                "sense_id": "4773f4b2-17eb-3e5a-86bb-92ba165ddb39",
                                "text": "„Im Rahmen des Anmeldeverfahrens ist bei allen Kindern der individuelle Sprachstand zu erfassen (§36 Abs. 2 SchG)“"
                            },
                            {
                                "example_id": "46afb1c0-0831-4ec6-b164-6ec9aaf99e9f",
                                "sense_id": "4773f4b2-17eb-3e5a-86bb-92ba165ddb39",
                                "text": "„Deshalb wird der Sprachstand aller Kinder zwei Jahre vor ihrer Einschulung überprüft, sodass Kinder, welche die deutsche Sprache nicht ausreichend beherrschen, frühzeitig erkannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "989f3eba-d58a-3aa3-b651-133d1557c685",
                        "entry_id": "0d7ac9ce-7693-3f5a-9817-d99280a41184",
                        "glosses": [
                            "Zustand, den eine Sprache zu einem bestimmten Zeitpunkt ihrer Entwicklung erreicht hat"
                        ],
                        "tags": [
                            "speziell Historiolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b038d0de-7adb-47d7-bd5b-8e9b128f5d6c",
                                "sense_id": "989f3eba-d58a-3aa3-b651-133d1557c685",
                                "text": "„Der Sprachstand der übrigen Handschriften ist trotz der späten Datierung als (spät)althochdeutsch einzustufen, es wird sich also um Abschriften älterer Handschriften handeln.“"
                            },
                            {
                                "example_id": "34827565-0e81-466b-9644-f060f544a24c",
                                "sense_id": "989f3eba-d58a-3aa3-b651-133d1557c685",
                                "text": "„Richtig sind also Wörterbücher und Grammatiken dann, wenn sie den tatsächlichen Sprachstand widerspiegeln, also zu einer Sprache und Schrift anleiten, die der Norm – dem in einer Sprachgemeinschaft Gewohnten – entspricht.“"
                            },
                            {
                                "example_id": "e7d60531-d323-40b5-b557-254c0e1ae0f4",
                                "sense_id": "989f3eba-d58a-3aa3-b651-133d1557c685",
                                "text": "„Damit lassen sich Sprachwandelphänomene bis zu einem gewissen Punkt zurückverfolgen und damit ältere Sprachstände rekonstruieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
