                ],
                "senses": [
                    {
                        "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                        "entry_id": "3ace7206-685d-3c91-83c2-57b980726b39",
                        "glosses": [
                            "Person, die engagiert gegen die Interessen einer anderen Person arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4613b1bf-2f27-4019-9c98-bc81a4fb65d3",
                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                "text": "„Sie kämpften 424 mit in Nordafrika für den römischen Usurpator Johannes gegen dessen Widersacher, den Feldherrn Bonifatius; …“"
                            },
                            {
                                "example_id": "a63953bc-020a-4392-8080-66adc4a209cd",
                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                "text": "„Für das Treffen haben sich die beiden Widersacher jeweils die Gefolgschaft angesehener Bauern gesichert.“"
                            },
                            {
                                "example_id": "ae9b0fab-ede4-40b3-aefe-d45849aea786",
                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                "text": "„Selbst die Kanzlerin hatte ja lange Zeit Gabriel als ihren potentiellen Widersacher im Wahlkampf gesehen.“"
                            },
                            {
                                "example_id": "c342b4b2-70d2-4a26-a1f5-a4d9abc66605",
                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                "text": "„Gerade auch diese »Volksaufklärung« wurde ihm als revolutionärer Akt von seinen Widersachern sehr übelgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ef62de2-e5a7-458e-acb3-567ca84c5546",
                        "source_entry_id": "3ace7206-685d-3c91-83c2-57b980726b39",
                        "source_sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                        "source_sense_description": "Person, die engagiert gegen die Interessen einer anderen Person arbeitet",
                        "target_lang_word": "adversary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adversary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                        "entry_id": "e2de6575-5579-3f0d-a864-cb51f1f8c98e",
                                        "glosses": [
                                            "An opponent or rival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafa1bbf-c2f7-4657-939c-f44cfc6901ce",
                                                "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                                "text": "He prepared to fight his adversary."
                                            },
                                            {
                                                "example_id": "3f54a002-82d9-4243-a925-6ab67a3bffda",
                                                "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                                "text": "In the political drama that Donald Trump has created in Washington, he could not have dreamed up a more formidable adversary than James Comey."
                                            },
                                            {
                                                "example_id": "85eb58a1-9f0d-43ce-bd83-086fa658f975",
                                                "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                                "text": "The real bombshell it contains is not the confidence of the spy agencies that Russia hoped to subvert American democracy. It is that US intelligence experts effectively confirmed that for the second election in a row, Trump acolytes repeatedly used, knowingly or otherwise, misinformation produced by the spies of one of America’s most sworn foreign adversaries to try to win a US election."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3ff23b7-173f-42d2-a0a7-84a3eb0e864f",
                        "source_entry_id": "3ace7206-685d-3c91-83c2-57b980726b39",
                        "source_sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                        "source_sense_description": "Person, die engagiert gegen die Interessen einer anderen Person arbeitet",
