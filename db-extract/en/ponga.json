                        "glosses": [
                            "A medium-sized tree fern endemic to New Zealand, of species Alsophila tricolor (syns .Alsophila dealbata, Cyathea dealbata et al.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9267f6b2-bb79-4977-9013-f759b45bf3b6",
                                "sense_id": "e9c65976-388c-3cb7-8844-6206cae72492",
                                "text": "Hilltop behind hilltop, / A mile of green pungas / In the grey afternoon / Bow their heads to the slanting spears of rain."
                            },
                            {
                                "example_id": "f4925877-0760-4daa-a781-29b041b5eab9",
                                "sense_id": "e9c65976-388c-3cb7-8844-6206cae72492",
                                "text": "Ponga logs tended to be used vertically for house walls on the mainland and horizontally (a style known as wakawaka) on the Chatham Islands."
                            }
                        ]
