                ],
                "senses": [
                    {
                        "sense_id": "86b6136b-dc26-3190-a5bf-47d98091ff18",
                        "entry_id": "ef4075b3-52b4-3462-bc21-12ff3a4f3612",
                        "glosses": [
                            "Zeitvertreib der höheren Gesellschaftsschichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c05507fb-ed1b-442b-97f2-c1f27b00f484",
                                "sense_id": "86b6136b-dc26-3190-a5bf-47d98091ff18",
                                "text": "„Der politische Charakter seines Kultes der ihn von jeher zum eigentlichsten Fürsten- und Herrengotte gemacht hatte, hat ihn gerade auf dem Wege über die Adelsspiele der Dorer und dann der Griechen allgemein bis zur Unkenntlichkeit seines Ursprunges hellenisiert.“"
                            },
                            {
                                "example_id": "72c31c30-e739-49fb-9306-d51d93d752dd",
                                "sense_id": "86b6136b-dc26-3190-a5bf-47d98091ff18",
                                "text": "„Das ahnungslose Bereitstellen von Freilichtplätzen mit kindergroßen Schachfiguren in zahlreichen Großstadtparks lässt vermuten, dass das Wissen um die einstige blutige Praxis des Adelsspiels verlorengegangen ist.“"
                            },
                            {
                                "example_id": "410ddba4-cfa4-4de1-9820-76fe9a3981fb",
                                "sense_id": "86b6136b-dc26-3190-a5bf-47d98091ff18",
                                "text": "„Aber, zum Adelsspiel gehört auch immer das Volk, d. h. die Bediensteten, also Knechte, Knappen, Zofe und Mägde. D. h. ohne Spieler, die das Gefolge spielen – kein Adelsspiel.“"
                            },
                            {
                                "example_id": "81e4f07d-bc21-476b-a15b-c3efd61b3282",
                                "sense_id": "86b6136b-dc26-3190-a5bf-47d98091ff18",
                                "text": "„Im Larp ist die Minne vor allem auf sogenannten Hofhaltungscons oder bei Cons mit ausgeprägtem Adelsspiel zu finden.“"
                            },
                            {
                                "example_id": "7b5f03e5-e00a-465f-b6d6-ae749b0eba76",
                                "sense_id": "86b6136b-dc26-3190-a5bf-47d98091ff18",
                                "text": "„Vom Adelsspiel zum Bürgervergnügen. Zur sozialen Relevanz des mittelalterlichen Schachspiels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
