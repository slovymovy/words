                "senses": [
                    {
                        "sense_id": "aedba98c-3acc-3577-8c3e-92e670fbab8f",
                        "entry_id": "457fcbfa-b5dd-3248-9e59-de207fe767f4",
                        "glosses": [
                            "karakul sheepskin"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "65f3fc38-86dd-4ffd-9b67-ee34b138ab46",
                                "sense_id": "aedba98c-3acc-3577-8c3e-92e670fbab8f",
                                "text": "Из Афганиста́на же к нам здесь идёт огро́мное коли́чество кара́кулевых шку́рок, доста́вка кото́рых в Росси́ю составля́ет предме́т осо́бого до́говора, заключённого ме́жду афга́нским и буха́рским эми́рами; поэ́тому шку́рки э́ти приво́зятся под наблюде́нием осо́бо назна́ченных для э́той це́ли афга́нских чино́вников."
                            }
                        ]
                    }
