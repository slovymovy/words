                ],
                "senses": [
                    {
                        "sense_id": "c927a515-9216-3af7-8226-db28706e4240",
                        "entry_id": "e01085e3-7037-3ce7-b97d-14c92bbaa475",
                        "glosses": [
                            "Celle qui est chargée par un pays de recueillir clandestinement, dans un autre pays, des informations gardées secrètes ; celle qui espionne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab176ef-05b5-4851-9e21-6ac0b1d75329",
                                "sense_id": "c927a515-9216-3af7-8226-db28706e4240",
                                "text": "Cette nouvelle génération d’espionnes, ultradéterminée, qui a redoublé d’efforts pour s’imposer, challenge aussi fortement les agents à l’ancienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f47de798-b837-3777-a2f2-776f4d5414c7",
                        "entry_id": "e01085e3-7037-3ce7-b97d-14c92bbaa475",
                        "glosses": [
                            "Celle qui observe secrètement les activités d’autrui pour les rapporter à un tiers."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c351f912-d692-491e-afef-fa15055cfe97",
                        "source_entry_id": "e01085e3-7037-3ce7-b97d-14c92bbaa475",
                        "source_sense_description": "Personne qui espionne",
                        "target_lang_word": "Spionin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spionin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                        "entry_id": "cd4dc758-7154-3683-99b9-d64e79a693f3",
                                        "glosses": [
                                            "weibliche Person, die als heimliche, unerkannte Beobachterin die gegnerische Seite auskundschaftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f1512f-f182-47e4-ae82-d49baa36134a",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Selbst Zinat Mahal, die Lieblingsfrau des Großmoguls, betätigte sich als Spionin.“"
                                            },
                                            {
                                                "example_id": "6546f5b8-7d8f-4d23-9194-b33603003690",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Sie galt den finnischen Sicherheitsbehörden zwischenzeitlich als Spionin.“"
                                            },
                                            {
                                                "example_id": "97036bfa-d659-4052-9dff-98cddbcb1262",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Ihre Augen waren die Augen einer Spionin.“"
                                            },
                                            {
                                                "example_id": "27f0f759-d5b9-44fb-8e52-106b64bc8403",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Es gäbe Gerüchte, sie sei eine Spionin, und möglicherweise wolle der Sicherheitsdienst – die Auslandsabteilung der Gestapo – sie demnächst befragen.“"
                                            },
                                            {
                                                "example_id": "026a7cfb-546c-4a7f-9cc8-69cf887295a6",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Für ihn war sie nur noch eine Spionin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
