                ],
                "translations": [
                    {
                        "translation_id": "5cca0d42-9851-4291-bb35-147dc5b76c46",
                        "source_entry_id": "0f5bf93c-1f4a-3ca8-bcc2-81b6b34ecc0b",
                        "source_sense_id": "d6ca77d5-428b-3f40-844e-c576e9d97579",
                        "target_lang_word": "punishing",
                        "target_lang_code": "en",
