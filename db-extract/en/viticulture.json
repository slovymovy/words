                                "target_senses": [
                                    {
                                        "sense_id": "5e915e7c-285b-3159-9d08-aebb821ddf3a",
                                        "entry_id": "cd329693-fa91-328e-9940-a84ea384bb3c",
                                        "glosses": [
                                            "Ensemble des activités de la culture de la vigne et de la fabrication de vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab15b97-14ea-4da4-9553-5d74b94a10f4",
                                                "sense_id": "5e915e7c-285b-3159-9d08-aebb821ddf3a",
                                                "text": "Les Celtes de la cité antique de Lattara (aujourd’hui Lattes), près de Montpellier, produisaient du vin dès le cinquième siècle avant notre ère, selon une étude américaine qui vient de paraître dans la revue Pnas, et qui confirme l’ancienneté de la viniculture en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d64688-a982-38fa-9f96-5cc3e13d1fdf",
                                        "entry_id": "cd329693-fa91-328e-9940-a84ea384bb3c",
                                        "glosses": [
                                            "Ensemble des activités de la fabrication de vin à l’exclusion de la culture de la vigne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
