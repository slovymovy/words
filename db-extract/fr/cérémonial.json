                "senses": [
                    {
                        "sense_id": "d28cf28a-12c3-3216-af79-211006ce05ff",
                        "entry_id": "2d6d4c47-a895-35b5-87e6-6ad21b35a476",
                        "glosses": [
                            "Variante de cérémoniel."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4f0a8e7b-dd6c-42b6-bb1c-0b0788f76291",
                                "sense_id": "d28cf28a-12c3-3216-af79-211006ce05ff",
                                "text": "C’est que Brun avoit augmenté les honneurs cérémoniaux envers les États de cette République, en donnant la main à leurs Députés, lorsqu’ils diminuoient ceux qu’ils avoient accoutumé de rendre aux Ambassadeurs des Couronnes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e7fe0533-c965-39be-9033-14c20b70c34f",
                "word": "cérémonial",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fe66f0c2-09ce-42a8-8abb-f59c496b9920",
                        "entry_id": "e7fe0533-c965-39be-9033-14c20b70c34f",
