                ],
                "senses": [
                    {
                        "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                        "entry_id": "78b50aea-ac1c-3945-b693-42e4fa3d19f6",
                        "glosses": [
                            "Küchengerät zum Frittieren von Speisen mit heißem Fett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ef1b07-6493-4ec1-b440-6631a6b4b703",
                                "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                "text": "Die Anschaffung einer Fritteuse will gut überlegt sein."
                            },
                            {
                                "example_id": "5fb19f63-4881-412b-b713-6646f0378b17",
                                "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                "text": "„An der fehlenden Fritteuse liegt es im Übrigen nicht, dass ich nicht als waschechte Holländerin durchgehen kann.“"
                            },
                            {
                                "example_id": "82ee8f05-bc28-4092-91c6-8b5d9e5f0523",
                                "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                "text": "„Ungeklärtes Gänseschmalz oder Hammelfett dagegen haben in der Fritteuse nichts zu suchen, sie entwickeln ein penetrantes Schweißfußaroma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb898364-7e63-4469-93aa-69b51fc9a756",
                        "source_entry_id": "78b50aea-ac1c-3945-b693-42e4fa3d19f6",
                        "source_sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
