                        "examples": [
                            {
                                "example_id": "fa445767-b1a8-4b35-96fc-2c45944c510b",
                                "sense_id": "5a4029c6-166d-3db0-b055-d03eed67a834",
                                "text": "Guck mal die Stinos, wie die gaffen!"
                            },
                            {
                                "example_id": "0b0910ab-3598-4f35-bef3-ad37fc55b224",
                                "sense_id": "5a4029c6-166d-3db0-b055-d03eed67a834",
                                "text": "Ich glaube, mich als »Stino« zu bezeichnen, wäre sehr gefährlich."
                            },
                            {
                                "example_id": "1dbf4c45-b1cc-46fe-8bb0-907a8148f223",
                                "sense_id": "5a4029c6-166d-3db0-b055-d03eed67a834",
                                "text": "Erstens versteht ein männlicher Stino solche Mädels nicht wirklich, findet sie meist auch nicht attraktiv, kurze Haare, eher maskuline Klamotten und Stil."
                            }
                        ],
