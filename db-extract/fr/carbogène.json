                        "examples": [
                            {
                                "example_id": "790d8cf3-1373-42a3-bf81-36f1f2970a20",
                                "sense_id": "209d053e-e00c-3770-b0c8-030adc303970",
                                "text": "Les poudres employées pendant longtemps ont été l'acide tartrique et le bicarbonate de soude ; on vend depuis quelques années une poudre unique appelée carbogène, qui est d'un prix moins élevé et produit une eau de Seltz aussi bonne."
                            },
                            {
                                "example_id": "24da3a43-1dd9-4658-81af-3acfedd3b53c",
                                "sense_id": "209d053e-e00c-3770-b0c8-030adc303970",
                                "text": "Transporté aussitôt au poste de secours voisin, disposant de sauveteurs qualifiés et d’un matériel complet de réanimation, respiration artificielle immédiate : Carbogène et Pressyl."
                            }
                        ]
                    },
