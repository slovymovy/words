                "senses": [
                    {
                        "sense_id": "4e10c886-7930-3ab7-aed5-d0c3b70e715b",
                        "entry_id": "79e6fce8-c5f7-3760-b1ec-c42c4c451dd5",
                        "glosses": [
                            "An early Christian, one of the earliest Christian disciples in Jerusalem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e4b3af-1f9f-4181-a010-958e3c05d997",
                                "sense_id": "4e10c886-7930-3ab7-aed5-d0c3b70e715b",
                                "text": "And Joses, who by the apostles was surnamed Barnabas, (which is, being interpreted, The son of consolation, ) a Levite, and of the country of Cyprus, having land, sold it, and brought the money, and laid it at the apostles' feet."
                            }
                        ]
                    },
                    {
                        "sense_id": "3304fee3-5029-3ff7-a20e-b7329a228c8c",
                        "entry_id": "79e6fce8-c5f7-3760-b1ec-c42c4c451dd5",
                        "glosses": [
                            "A male given name from Hebrew of biblical origin."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1f5b31a-7b1a-4394-9698-c66f1092063a",
                        "source_entry_id": "79e6fce8-c5f7-3760-b1ec-c42c4c451dd5",
                        "source_sense_description": "An early Christian",
                        "target_lang_word": "Barnabé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
