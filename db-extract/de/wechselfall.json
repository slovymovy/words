                        "glosses": [
                            "Vorgang, bei dem eine bisherige Entwicklung in eine sehr andere/gegensätzliche Richtung bewegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd9fcf5e-aec2-4e72-826c-8d73e186fce1",
                                "sense_id": "412302de-bff0-3b1b-8a65-c3bb02ae8feb",
                                "text": "„In den für mich bedeutsamen Wechselfällen meines Lebens haben sich besondere Umstände verbündet, um meinen armen Geist ein wenig abergläubisch zu machen.“"
                            },
                            {
                                "example_id": "3c34d76a-051e-44d4-8815-43cdc408c275",
                                "sense_id": "412302de-bff0-3b1b-8a65-c3bb02ae8feb",
                                "text": "„Mit dem Reichtum des Ordens nahm aber auch seine Anfälligkeit für politische Wechselfälle zu.“"
                            }
                        ],
