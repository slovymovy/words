                        "examples": [
                            {
                                "example_id": "dae0f2d7-a081-4175-8853-abcb4499aaaa",
                                "sense_id": "fe446438-9208-351d-addb-23ea92ec98d8",
                                "text": "Delen van Roermond hebben last van stankoverlast als gevolg van het rotten van acht miljoen eieren. Die liggen in een onder water gelopen kelder van de voormalige eiermijn in Roermond, liet een woordvoerder van de gemeente donderdag weten."
                            },
                            {
                                "example_id": "24c41e07-a2d6-43e8-96f1-35c386d3e472",
                                "sense_id": "fe446438-9208-351d-addb-23ea92ec98d8",
                                "text": "Het vuur brak uit in de kelders van de voormalige ’Eiermijn’ in Roermond. Om 14.20 uur liep bij de brandweer een eerste oproep binnen over rookontwikkeling op de hoek van de Prins Bernardstraat."
                            }
                        ]
                    }
