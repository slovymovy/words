                        "examples": [
                            {
                                "example_id": "3d6ee8fb-28be-4a98-8043-20491926cf68",
                                "sense_id": "ae0d5642-a3f8-3b58-8abc-d0a5db59148b",
                                "text": "Het alleen zijn maakte me juist wakker. Wellicht was ik door mijn drukke agenda thuis wat mat en ingeslapen geraakt."
                            },
                            {
                                "example_id": "ecadd63c-dc47-4393-a121-a2f1d55fa959",
                                "sense_id": "ae0d5642-a3f8-3b58-8abc-d0a5db59148b",
                                "text": "De Nederlandse minister van Justitie, Van Weel, ontmoette paus Franciscus gisteren nog. \"Een heel bijzonder moment\", schrijft Van Weel op X. Ook hij noemt de dood van de paus verdrietig nieuws. \"Mijn gedachten zijn bij allen die geraakt zijn door zijn overlijden.\""
                            }
                        ]
