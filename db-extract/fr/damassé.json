            {
                "entry_id": "965be6bd-a516-318c-a9ac-1d7ce9f0520e",
                "word": "damassé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2310bb53-7a17-450d-bf00-56a16ce0aca3",
                        "entry_id": "965be6bd-a516-318c-a9ac-1d7ce9f0520e",
                        "tags": [
