                                        "sense_id": "0980a46a-f76a-3d5b-8839-9ed562e96780",
                                        "entry_id": "72677e4f-acf7-322f-8e09-5bef876d37a8",
                                        "glosses": [
                                            "Ohrenrobbe mit schlankem Körperbau, die sich im Gegensatz zur Hundsrobbe auch gut an Land fortbewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be55686e-e05f-4c3d-8cdb-e6cf9ea367b7",
                                                "sense_id": "0980a46a-f76a-3d5b-8839-9ed562e96780",
                                                "text": "„Fischer fangen den Tieren das Futter weg - und immer wieder landen die Seelöwen selbst als Beifang in den Netzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
