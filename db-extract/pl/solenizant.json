                                                "sense_id": "07e76f1c-ba1f-37c7-80dc-e1fdf65dfce0",
                                                "text": "The birthday boy was a 65-year-old man who was half-asleep."
                                            },
                                            {
                                                "example_id": "31656b07-6d7d-481d-9e54-a132d65f181b",
                                                "sense_id": "07e76f1c-ba1f-37c7-80dc-e1fdf65dfce0",
                                                "text": "When they came out of the restaurant, Quinn noticed the birthday boy appeared tipsy but he was twenty-one now, and everyone was having a good time."
                                            }
