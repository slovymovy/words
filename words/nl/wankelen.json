{
    "word_family": [
        "wankel",
        "wankeling",
        "wankelmoedig",
        "wankelbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0b93c29-268a-36a3-9f05-5085b4c9706d",
                    "sense_definition": "onvast op de voeten staan of dreigen te vallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke instabiliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plotselinge windvlaag deed hem <w>wankelen</w> op de smalle brug.",
                            "target_lang_translations": {
                                "en": "The sudden gust of wind made him <w>stagger</w> on the narrow bridge."
                            }
                        },
                        {
                            "text": "Na de harde klap begon de bokser zichtbaar te <w>wankelen</w> in de ring.",
                            "target_lang_translations": {
                                "en": "After the heavy blow, the boxer visibly began to <w>totter</w> in the ring."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiebelen",
                        "zwabberen"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "op de benen wankelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to stand unsteadily on one's feet or be in danger of falling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stagger",
                                "target_lang_sense_clarification": "to move or stand unsteadily as if about to fall"
                            },
                            {
                                "target_lang_word": "totter",
                                "target_lang_sense_clarification": "to be unsteady on one's feet"
                            },
                            {
                                "target_lang_word": "teeter",
                                "target_lang_sense_clarification": "to move unsteadily or tip back and forth"
                            },
                            {
                                "target_lang_word": "wobble",
                                "target_lang_sense_clarification": "to move unsteadily from side to side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84b6eb81-db13-325f-a7af-dc48f87b1c5a",
                    "sense_definition": "op een onvaste of onzekere wijze ergens heen lopen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke instabiliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is gisteravond laat stomdronken naar huis <w>gewankeld</w>.",
                            "target_lang_translations": {
                                "en": "He <w>staggered</w> home dead drunk late last night."
                            }
                        },
                        {
                            "text": "De gewonde man probeerde naar de overkant van de straat te <w>wankelen</w>.",
                            "target_lang_translations": {
                                "en": "The injured man tried to <w>stumble</w> to the other side of the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "stommelen",
                        "struikelen"
                    ],
                    "common_phrases": [
                        "naar huis wankelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to walk somewhere in an unsteady or uncertain manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stagger",
                                "target_lang_sense_clarification": "to walk unsteadily, often due to injury or intoxication"
                            },
                            {
                                "target_lang_word": "stumble",
                                "target_lang_sense_clarification": "to walk in a clumsy way, almost falling"
                            },
                            {
                                "target_lang_word": "totter",
                                "target_lang_sense_clarification": "to walk with shaky steps"
                            },
                            {
                                "target_lang_word": "reel",
                                "target_lang_sense_clarification": "to walk in a dizzy or unbalanced way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b18219fd-f3af-30b6-a96e-49478a85d499",
                    "sense_definition": "in een onzekere positie verkeren of dreigen ten onder te gaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke instabiliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het grote ict-bedrijf <w>wankelt</w> onder de aanhoudende stroom van slechte publiciteit.",
                            "target_lang_translations": {
                                "en": "The large IT company is <w>teetering</w> under the continuous stream of bad publicity."
                            }
                        },
                        {
                            "text": "Door de economische crisis begon de positie van de regering ernstig te <w>wankelen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the economic crisis, the government's position began to <w>waver</w> seriously."
                            }
                        }
                    ],
                    "synonyms": [
                        "beven",
                        "sidderen"
                    ],
                    "antonyms": [
                        "standhouden"
                    ],
                    "common_phrases": [
                        "op zijn grondvesten wankelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be in an uncertain position or be in danger of failing or collapsing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "teeter",
                                "target_lang_sense_clarification": "to be on the edge of a negative situation"
                            },
                            {
                                "target_lang_word": "falter",
                                "target_lang_sense_clarification": "to lose strength or momentum"
                            },
                            {
                                "target_lang_word": "waver",
                                "target_lang_sense_clarification": "to become unsteady or indecisive"
                            },
                            {
                                "target_lang_word": "shake",
                                "target_lang_sense_clarification": "to be unstable or weakened"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}