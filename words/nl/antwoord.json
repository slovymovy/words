                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "command: answer!"
                            },
                            {
                                "target_lang_word": "reply",
                                "target_lang_sense_clarification": "command: reply!"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отвечай",
                                "target_lang_sense_clarification": "приказ или просьба"
                            },
                            {
                                "target_lang_word": "ответь",
                                "target_lang_sense_clarification": "совершенный вид, просьба дать ответ"
                            }
                        ]
                    }
                }
            ]
