                "senses": [
                    {
                        "sense_id": "96a20807-2e8e-388e-ac0d-3a6301c114b6",
                        "entry_id": "8d9c4b0d-3b6e-35c4-9870-78f2cef9bc70",
                        "glosses": [
                            "Jubel über (die Aussicht auf) Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9967fb1e-30f6-4352-98ed-cae12931fef3",
                                "sense_id": "96a20807-2e8e-388e-ac0d-3a6301c114b6",
                                "text": "„Zwar stimmten längst nicht alle Deutschen ein in den Kriegsjubel, aber weil die SPD und ihre Anhänger keinesfalls als Verletzer des Burgfriedens dastehen wollten, als »vaterlandslose Gesellen«, konnte sie nun nicht mehr gegen den vermeintlich unausweichlichen Krieg protestieren.“"
                            },
                            {
                                "example_id": "237c6e02-085e-4967-8baa-a773e83dc386",
                                "sense_id": "96a20807-2e8e-388e-ac0d-3a6301c114b6",
                                "text": "„Ein dunkler Schatten liegt auf Vorwerks Wirken durch sein vorbehaltloses Einstimmen in den Kriegsjubel der Jahre 1914/1915.“"
                            },
                            {
                                "example_id": "92189522-5938-4996-a17c-822ed92b65e5",
                                "sense_id": "96a20807-2e8e-388e-ac0d-3a6301c114b6",
                                "text": "„Alfred Kerr hat, wie viele andere Intellektuelle und Künstler auch, im Sommer 1914 begeistert in den Kriegsjubel eingestimmt.“"
                            },
                            {
                                "example_id": "646e5806-e614-48e8-a003-91bf8bb911ca",
                                "sense_id": "96a20807-2e8e-388e-ac0d-3a6301c114b6",
                                "text": "„Doch sollte die Abscheu vor Kriegsjubel und dem zur Schau gestellten Patriotismus nicht Anlaß sein, uns selber den Spiegel vorzuhalten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
