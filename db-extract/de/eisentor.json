                "senses": [
                    {
                        "sense_id": "b8b422df-e1e8-322a-a2f0-890c688e21a5",
                        "entry_id": "6368935c-1917-329b-b718-03b42344e1dc",
                        "glosses": [
                            "Tor, das aus Eisen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c020e403-da42-441d-976a-3db34a62b84b",
                                "sense_id": "b8b422df-e1e8-322a-a2f0-890c688e21a5",
                                "text": "„Stefan und Elisabeth betraten ihn durch eine Öffnung im Drahtzaun, wo früher zwei hohe Eisentore gehangen hatten.“"
                            },
                            {
                                "example_id": "a0b5675d-de05-45e3-85e6-9abbbbf4c85e",
                                "sense_id": "b8b422df-e1e8-322a-a2f0-890c688e21a5",
                                "text": "„Die Eisentore vor den langen feuchten Gassen, die nach Urin riechen, sind verschlossen.“"
                            },
                            {
                                "example_id": "54619467-3e06-45cf-895d-11ddfb7d45e2",
                                "sense_id": "b8b422df-e1e8-322a-a2f0-890c688e21a5",
                                "text": "„In der Straße gab es viele Lastwagengaragen, deren schwere Eisentore sich jetzt öffneten.“"
                            },
                            {
                                "example_id": "4b059836-7fe6-4611-b0e3-c21c2cd68994",
                                "sense_id": "b8b422df-e1e8-322a-a2f0-890c688e21a5",
                                "text": "„Die hübsch gewundene Straße endet vor einem Eisentor, das mit einem Schloss verriegelt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
