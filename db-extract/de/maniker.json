                "senses": [
                    {
                        "sense_id": "c9cd3f57-d162-3598-983e-c31c4f1c98c4",
                        "entry_id": "79116838-cef4-3af3-9f77-2dd9af0d0b41",
                        "glosses": [
                            "Person, die an der affektiven Störung Manie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155749f1-6129-4c05-bd6b-c04b0e5c1a97",
                                "sense_id": "c9cd3f57-d162-3598-983e-c31c4f1c98c4",
                                "text": "„Der Maniker handelt beständig, schläft wenig, reißt seine Mitmenschen mit, steckt sie an – zumindest für eine gewisse Zeit.“"
                            },
                            {
                                "example_id": "2c50f812-3dfa-483c-9042-80032dc36d78",
                                "sense_id": "c9cd3f57-d162-3598-983e-c31c4f1c98c4",
                                "text": "„Maniker empfinden Schlaf als Zeitverschwendung und Unterbrechung ihres (oft ziellosen) Tatendrangs.“"
                            },
                            {
                                "example_id": "ee79990c-2789-4442-a860-e3d8032c3fd2",
                                "sense_id": "c9cd3f57-d162-3598-983e-c31c4f1c98c4",
                                "text": "„Von bewusst gefährlichen Gewalttaten akut manischer Patienten habe ich jedoch bislang nie gehört, und die Taten aufgeschlossenen Stationen resultieren fast alle aus dem Bemühen, den Maniker zur Raison zu bringen, ihn zu erziehen, körperlich zu überwältigen oder zu fixieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
