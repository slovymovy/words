                        "form": "die Supermacht"
                    },
                    {
                        "form_id": "94009694-37ba-4fd8-a3ca-d2186fecfbe8",
                        "entry_id": "98132006-ca39-3c97-b9a7-a792ba7f601b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Supermächte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                        "entry_id": "98132006-ca39-3c97-b9a7-a792ba7f601b",
                        "glosses": [
                            "„Staat, der globale Entwicklungen aufgrund seiner überragenden Fähigkeiten und Potentiale beeinflussen und bestimmen kann.“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a59769-8de0-4287-aee5-683733cd91b9",
                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                "text": "Die Supermacht kontrollierte das Weltgeschehen."
                            },
                            {
                                "example_id": "2ee7e7ce-6ceb-4be8-8b87-b1dc36070693",
                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                "text": "„Politisch werden die meisten Regierenden von den Supermächten umworben, auch finanziell.“"
                            },
                            {
                                "example_id": "cfc12595-a781-4eed-869e-2972608ceb60",
                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                "text": "„An der Grenze am Ussuri kam es zu kriegerischen Auseinandersetzungen zwischen den roten Supermächten.“"
                            },
                            {
                                "example_id": "d1aeabff-c67b-458f-ac15-f74e2d4f6e05",
                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                "text": "„Das Klima zwichen den beiden Supermächten vereiste, ein alles vernichtender Atomkrieg rückte in den Bereich des Möglichen.“"
                            },
                            {
                                "example_id": "994bead2-67a7-49a7-a268-ee2eb24b06e2",
                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                "text": "„Alles, was Amerika als Supermacht, als Weltpolizei, als mächtige Wirtschaftskraft, als verhasste und geliebte Idee, als Standard, an dem man sich misst und reibt, gegen den man anrennt, in den letzten 70 Jahren hinter sich gebracht hat, steht Deutschland ab jetzt in Europa bevor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22e2d520-69e4-44a5-bb03-dea072b250a8",
                        "source_entry_id": "98132006-ca39-3c97-b9a7-a792ba7f601b",
                        "source_sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
