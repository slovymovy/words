                "senses": [
                    {
                        "sense_id": "e56b6109-a641-3168-90d9-21f2ac25da72",
                        "entry_id": "6f824f17-f269-324a-8d91-31f1912d29d8",
                        "glosses": [
                            "Bart mit hellem, silbrig schimmerndem Grauton"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "c2b9e6fe-0e55-44af-bfd9-b0a19a0df63e",
                                "sense_id": "e56b6109-a641-3168-90d9-21f2ac25da72",
                                "text": "„Ein Mann mit wallendem Silberbart pochte an die Pforte des Bauernhofes und bat um Obdach.“"
                            },
                            {
                                "example_id": "ee7456d2-ec19-49bd-8665-d5e1d08d7f98",
                                "sense_id": "e56b6109-a641-3168-90d9-21f2ac25da72",
                                "text": "„Er ordnet den gelockten Silberbart zwischen den Knien, rückt an der Goldrandbrille, streicht die Weste glatt, kreuzt die Füße in den roten Socken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f60b5027-8873-32c5-97f9-7e300fdec428",
                        "entry_id": "6f824f17-f269-324a-8d91-31f1912d29d8",
                        "glosses": [
                            "jemand mit [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6858089e-f048-4c9c-ae24-4fc3fc5a8375",
                                "sense_id": "f60b5027-8873-32c5-97f9-7e300fdec428",
                                "text": "„Ein schwarzer Schatten fällt auf den gelben Sand und die weißen Knochen des Kalbes, vor dem der alte Silberbart im Winter drei Füchse und einen Marder geschossen hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
