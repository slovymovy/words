                "senses": [
                    {
                        "sense_id": "5c6fab34-6e6c-3e3f-916c-0de3b9f0a892",
                        "entry_id": "c3cccf11-dcf3-3ef0-a5f1-cfc3089fd246",
                        "glosses": [
                            "Wasserfahrzeug, das zur entgeltlichen Personenbeförderung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b46dd6ec-a182-4461-9971-a4cdfcd09186",
                                "sense_id": "5c6fab34-6e6c-3e3f-916c-0de3b9f0a892",
                                "text": "„Der Schiffsverkehr hatte nachgelassen, nur noch ein paar kleine Wassertaxis fuhren noch zwischen Yeniköy und Beykoz hin und her.“"
                            },
                            {
                                "example_id": "18cb1944-2cde-4e33-a69f-027113bb02c4",
                                "sense_id": "5c6fab34-6e6c-3e3f-916c-0de3b9f0a892",
                                "text": "„Private Wassertaxis sausten hin und her, während gleichzeitig alte Dschunken vorüberschaukelten.“"
                            },
                            {
                                "example_id": "6e734c11-1b1a-4e54-ab69-f8b0ef136277",
                                "sense_id": "5c6fab34-6e6c-3e3f-916c-0de3b9f0a892",
                                "text": "„›Tut mit leid, ich bin kein Wassertaxi.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
