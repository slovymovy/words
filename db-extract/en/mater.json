    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b7fbb8a2-9bbd-35d1-a8e1-d00a13f4aba1",
                "word": "mater",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "57e7566e-7e7f-49a5-9085-66ce7bc9a398",
                        "entry_id": "b7fbb8a2-9bbd-35d1-a8e1-d00a13f4aba1",
                        "tags": [
                            "plural"
                        ],
                        "form": "maters"
                    },
                    {
                        "form_id": "4b8e9898-06fa-4863-871a-d7cc8dc75cb6",
                        "entry_id": "b7fbb8a2-9bbd-35d1-a8e1-d00a13f4aba1",
                        "tags": [
                            "plural"
                        ],
                        "form": "matres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63a639bd-69b7-3819-8636-23c0886a5b2a",
                        "entry_id": "b7fbb8a2-9bbd-35d1-a8e1-d00a13f4aba1",
                        "glosses": [
                            "Mother."
                        ],
                        "tags": [
                            "British",
                            "archaic",
                            "humorous",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "29d82552-e8bf-406c-8791-a226d9bfaef8",
                                "sense_id": "63a639bd-69b7-3819-8636-23c0886a5b2a",
                                "text": "Their maters are all pals of my mater’s, and I don’t want to get them into trouble for aiding and abetting my little show, if you understand what I mean."
                            },
                            {
                                "example_id": "4a76e0c8-01e2-48e7-a076-420832b0858d",
                                "sense_id": "63a639bd-69b7-3819-8636-23c0886a5b2a",
                                "text": "“The mater will be delighted to see you again—after all those years,” he added."
                            },
                            {
                                "example_id": "5c29a53d-fa6c-47c1-af3d-1d60b3049d8c",
                                "sense_id": "63a639bd-69b7-3819-8636-23c0886a5b2a",
                                "text": "And then there’s the mater! Poor old mater! She goes about on tiptoe; she’s always watching me and pretending she’s not watching me; I believe she would like to have everything padded with feather beds. All the while she has been wanting me to do the goody book thing, get down on my knees and put my head in her lap and blub."
                            },
                            {
                                "example_id": "d4bb200a-ee2a-48cc-8cb4-4f99e5b7ab2a",
                                "sense_id": "63a639bd-69b7-3819-8636-23c0886a5b2a",
                                "text": "Strangled by the wishes of pater / Hoping for the arms of mater / Get to me the sooner or later"
                            },
                            {
                                "example_id": "de9837c9-fbb2-4204-b9b2-a3c64acbcf9c",
                                "sense_id": "63a639bd-69b7-3819-8636-23c0886a5b2a",
                                "text": "“Mater, you look well.” / “I am well. And you,” she said in that dryly prosaic deep voice of hers, “look healed.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9fa1cfb3-fdaf-3aa0-b277-2f4038387050",
                        "entry_id": "b7fbb8a2-9bbd-35d1-a8e1-d00a13f4aba1",
                        "glosses": [
                            "A meninx; the dura mater, arachnoid mater, or pia mater of the brain."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
