                "senses": [
                    {
                        "sense_id": "c83856b4-720b-34c1-9a60-8415bc87217f",
                        "entry_id": "c837f0fa-4876-313a-a5d5-682101b82623",
                        "glosses": [
                            "Verfahren, um gegen Entscheidungen von Behörden, Unternehmen oder anderen Einrichtungen vorzugehen; Vorgang beim Umgang mit einer Äußerung oder Mitteilung über eine unerwünschte Situation oder ein Fehlverhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa03cdf4-8496-4aca-b211-6063cc6c6e1c",
                                "sense_id": "c83856b4-720b-34c1-9a60-8415bc87217f",
                                "text": "„Auch sollten das Beschwerdeverfahren und das obligatorische Training der Mitarbeiter gegen derartige Übergriffe verbessert werden.“"
                            },
                            {
                                "example_id": "48c72e96-35c0-434d-b3f4-6cc68e216e33",
                                "sense_id": "c83856b4-720b-34c1-9a60-8415bc87217f",
                                "text": "„Auch der verbesserte Schutz von geistigem Eigentum und ein Beschwerdeverfahren sollen ausländischen Investoren Entgegenkommen signalisieren.“"
                            },
                            {
                                "example_id": "117bdf42-2011-4dd2-af8c-ba0ca0ac1d69",
                                "sense_id": "c83856b4-720b-34c1-9a60-8415bc87217f",
                                "text": "„Es gibt aber auch Elemente der Fallbearbeitung, die von den Ländern kommen, etwa die Ausstattung mit juristischem Personal und Verwaltungsrichtern, die Beschwerdeverfahren gegen eventuelle Ablehnungen ebenfalls in den Anker-Zentren führen könnten.“"
                            },
                            {
                                "example_id": "81f5b3c9-0d75-42c4-9447-f21655e044ce",
                                "sense_id": "c83856b4-720b-34c1-9a60-8415bc87217f",
                                "text": "„Aussagen über die Effizienz des Beschwerdeverfahrens sind so nicht möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
