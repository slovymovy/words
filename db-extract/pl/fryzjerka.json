                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b78e030-114b-4429-9392-245664f30cf0",
                                "sense_id": "d38866f3-59a6-3f82-b4d9-5d0e3d0b971f",
                                "text": "Od wielu lat trudnił się fryzjerką."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8845f31-7a77-427a-9273-930057a48f54",
                        "source_entry_id": "7d1e3d9a-a425-389c-a13f-67619cfe07f1",
                        "source_sense_id": "8277e88a-ccf7-33e4-9d17-dc891eeab840",
                        "target_lang_word": "Friseurin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Friseurin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e618662-f933-3bf2-8a12-250691d2672b",
                                        "entry_id": "fde00eaa-c984-3a34-8a50-69a49f343339",
                                        "glosses": [
                                            "eine Fachfrau für die Pflege des Kopfhaares und der Gestaltung der Frisur, ein Handwerksberuf, eine Haarschneiderin, Haarpflegerin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b002ce-27d6-4d1b-a7b9-1accce8aa283",
                                                "sense_id": "9e618662-f933-3bf2-8a12-250691d2672b",
                                                "text": "Gehst du auch immer zur selben Friseurin?"
                                            },
                                            {
                                                "example_id": "93004a88-06e5-4d54-8586-f0bc0eb2c0ff",
                                                "sense_id": "9e618662-f933-3bf2-8a12-250691d2672b",
                                                "text": "„Zunächst beraten Friseure und Friseurinnen ihre Kunden bei der Wahl einer passenden und modischen Frisur.“"
                                            },
                                            {
                                                "example_id": "fba2c577-546e-4f9b-ae42-9c01e7e2f5c3",
                                                "sense_id": "9e618662-f933-3bf2-8a12-250691d2672b",
                                                "text": "„Kosmetische Behandlungen der Gesichtshaut, Hand- und Nagelpflege (Maniküre) einschließlich der Gestaltung von Fingernägeln, führen Friseure und Friseurinnen ebenfalls durch.“"
                                            },
                                            {
                                                "example_id": "eded4e61-1048-4645-a666-f16ff7bf08bb",
                                                "sense_id": "9e618662-f933-3bf2-8a12-250691d2672b",
                                                "text": "„Die Friseurin erklärt mir, dass die Putzfrau jede Woche auf die Leiter steigt und eine neue Lebensweisheit aufhängt.“"
                                            },
                                            {
                                                "example_id": "712ff86c-7aa7-4d48-a0fd-84d3b1b72c84",
                                                "sense_id": "9e618662-f933-3bf2-8a12-250691d2672b",
                                                "text": "„Die nette Friseurin hat mir erzählt, seit die Flüchtlinge da seien, bekäme sie jeden Tag zwanzig Heiratsanträge auf dem Weg zur Arbeit und noch einmal zehn auf dem Weg nach Hause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4d9b633-dad2-4da0-b16e-84ceaf68eadb",
                        "source_entry_id": "7d1e3d9a-a425-389c-a13f-67619cfe07f1",
                        "source_sense_id": "8277e88a-ccf7-33e4-9d17-dc891eeab840",
                        "target_lang_word": "Frisörin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frisörin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4796d25b-9dc0-3628-b90e-5a920684de84",
                                        "entry_id": "a360feae-0d24-3cf2-979f-28ff99c6dafc",
                                        "glosses": [
                                            "eine weibliche Fachkraft für die Pflege des Kopfhaares und die Gestaltung der Frisur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8d1338-b036-4208-9999-0c658b1c9c0e",
                                                "sense_id": "4796d25b-9dc0-3628-b90e-5a920684de84",
                                                "text": "Die gelernte Frisörin eröffnete vor zwei Jahren ihren eigenen Salon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdde17cf-5367-462f-980c-5986b446da98",
                        "source_entry_id": "7d1e3d9a-a425-389c-a13f-67619cfe07f1",
                        "source_sense_id": "8277e88a-ccf7-33e4-9d17-dc891eeab840",
                        "target_lang_word": "Frisöse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frisöse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb0b8ff7-b434-3953-be0a-eec5cbbb602d",
                                        "entry_id": "ffe070b1-2e91-3743-85fd-79e59cfe8295",
                                        "glosses": [
                                            "weibliche Person, die berufsmäßig anderen Haare schneidet, frisiert, wäscht, färbt und pflegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101b5805-7f54-4b71-ba76-7daa15c8bc47",
                                                "sense_id": "cb0b8ff7-b434-3953-be0a-eec5cbbb602d",
                                                "text": "Ich vertraue da voll meiner Frisöse. Auch wenn ich mal mit ausgeflippten Frisurenbildern zu ihr komme, sagt sie mir, ob das mit meinen Haaren überhaupt machbar ist und ob das zu mir passt."
                                            },
                                            {
                                                "example_id": "bd6dc3a3-3629-44b5-b875-008dbd9e5345",
                                                "sense_id": "cb0b8ff7-b434-3953-be0a-eec5cbbb602d",
                                                "text": "Selten wurde, seit Doktor Goebbels' Großregie im deutschen Film, so heroisch gestorben, wie es Hennig Baum als dem Piloten eines abgestürzten Rosinenbombers gelingt, wenige Wochen ehe er der Frisöse Leni Genthin (alias Katharina Wackernagel) als Kriegsbraut das höchste Glück jener Tage bescheren kann: die amerikanische Heirat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "788ae594-944c-4fea-ad44-deaceb52b8fa",
                        "source_entry_id": "7d1e3d9a-a425-389c-a13f-67619cfe07f1",
                        "source_sense_id": "8277e88a-ccf7-33e4-9d17-dc891eeab840",
                        "target_lang_word": "Friseuse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Friseuse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                        "entry_id": "c13e5465-d85f-32fe-8087-1e16adeaf084",
                                        "glosses": [
                                            "eine Fachfrau für die Pflege des Kopfhaares und die Gestaltung der Frisur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f52f588-5045-48ea-b2cc-b1f71885e63f",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "Gehst du auch immer zur selben Friseuse?"
                                            },
                                            {
                                                "example_id": "6ccb79f3-f2d2-4448-81d1-262de091c701",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "„Der Koblenzer Spielleiter, das technische Personal, die Friseuse, die Souffleuse und die Garderobiere fuhren mit uns.“"
                                            },
                                            {
                                                "example_id": "467ce0df-34a2-4333-bc52-abc7f7a44e37",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "„Ich weiß nicht, warum, sie sehen immer so aus, als kämen sie frisch vom Friseur, und ich stelle mir dann vor, daß hier jeder eine so große Verwandtschaft hat, daß mindestens zwei Friseusen darunter sind.“"
                                            },
                                            {
                                                "example_id": "fa066b47-f2b9-4380-880a-0f55726a3006",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "„Bereits im Jahre 1938, als die Antragstellerin ihre Tätigkeit als Friseuse aufnahm, wurde der Frisiersalon in einem innerhalb des Bestandobjektes gelegenen Raum mit einer Nutzfläche von rund 25 m2 betrieben; die übrigen Räumlichkeiten (WC, Küche und zwei Zimmer) wurden als Wohnung genutzt.“"
                                            },
                                            {
                                                "example_id": "f492976c-843c-4476-8d2e-bfc44574541e",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "„Seit den 1950er-Jahren hat sich nicht viel geändert: Die beliebtesten Ausbildungen für junge Frauen sind immer noch die zur Friseuse, zur Sekretärin oder zur Verkäuferin.“"
                                            },
                                            {
                                                "example_id": "53c42084-c419-4433-8bce-8fdcbf066308",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "„So wird von der gelernten Friseuse keine Coverversion von einem oft gehörten Pop-Song präsentiert, sondern das Publikum wird an ihrem etwas außergewöhnlichen Musikgeschmack teilhaben können und ein Lied mit dem Titel ‚Scarborough Fair‘ von Celtic Woman zu hören bekommen.“"
                                            },
                                            {
                                                "example_id": "ab96aead-feba-425c-9548-8a5530b10294",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
                                                "text": "„Das hätte zumindest ihrer knalligen Aufmachung entsprochen: Selber die übliche Vorstadtprinzessin, von Beruf Friseuse oder Angestellte im Sonnenstudio, mit Träumen von Filmstarkarriere und Eigenheim, der beim Anblick von etwas wirklich Geschmack- und Stilvollem – und nicht anders konnte man die etwa zweihundert Jahre alte Gründerzeitarchitektur in Chens Viertel bezeichnen – wegen ihres beschämenden Mangels an Kenntnis und Kultur nur der Rückzug in eine alberne Jugendpose blieb: »Spießergegend!«“"
                                            },
                                            {
                                                "example_id": "3f7ad1ca-c575-4843-a7b3-64af7ca0fbeb",
                                                "sense_id": "44543736-08f0-311a-a3c0-8e7284da5f16",
