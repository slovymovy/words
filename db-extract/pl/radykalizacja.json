                            {
                                "example_id": "7de96362-80c1-4c9b-acce-290234a12d9b",
                                "sense_id": "5309f9b2-ca8d-3de0-a5fc-a135ddb55286",
                                "text": "Proces radykalizacji języka postępuje, a różne okoliczności polityczne powodują, że czasem przyśpiesza, a czasem zwalnia."
                            }
