                    {
                        "form_id": "9cac75a7-dabc-42ad-b97d-d44373a563bb",
                        "entry_id": "7adee4d0-d151-32da-9e17-36d831eb72e0",
                        "tags": [
                            "plural",
                            "dative"
                        ],
                        "form": "den Nacharbeiten"
