                                "target_senses": [
                                    {
                                        "sense_id": "17ffb3b7-9c87-3bec-94c1-fc050e8d8596",
                                        "entry_id": "a38979b0-3805-3137-a0cd-8995dcaaca02",
                                        "glosses": [
                                            "Un des cinquante États des États-Unis d’Amérique (code postal AR), bordé par le Missouri au nord, le Tennessee et le Mississippi à l’est, la Louisiane au sud, le Texas et l’Oklahoma à l’ouest. Sa capitale est Little Rock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fddea9a4-c2f1-4cb8-9f4f-f56ae22943e9",
                                                "sense_id": "17ffb3b7-9c87-3bec-94c1-fc050e8d8596",
                                                "text": "Je vis en Arkansas."
                                            },
                                            {
                                                "example_id": "5df03f93-2abf-4c7c-87ac-863b444ee881",
                                                "sense_id": "17ffb3b7-9c87-3bec-94c1-fc050e8d8596",
                                                "text": "Le Texas est loin de la Virginie mais si l’on veut le faire d’une traite, on le peut, il n’y a que deux États à traverser. Mais on les traverse de part en part, d’est en ouest. Il y a le Tennessee, dessiné comme une poêle avec un long manche, et l’Arkansas, carré et cubique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689b64b4-9160-3437-a556-b2eb859f7279",
                                        "entry_id": "a38979b0-3805-3137-a0cd-8995dcaaca02",
                                        "glosses": [
                                            "Affluent du Mississippi."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192dcd41-5a56-42e3-a403-14cb8a21b6d6",
                                                "sense_id": "689b64b4-9160-3437-a556-b2eb859f7279",
                                                "text": "Parmi les Chérokis, les Criks, les Chîkassas,\nAu milieu des Chactas qui bordent l’Arkansas…"
                                            },
                                            {
                                                "example_id": "16e25391-887d-44bd-ada0-8d6aa8dabd14",
                                                "sense_id": "689b64b4-9160-3437-a556-b2eb859f7279",
                                                "text": "Ce vaste désert, […], est arrosé par de puissants cours d’eau, dont les principaux sont la grande rivière Canadienne, l’Arkansas et la rivière Rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
