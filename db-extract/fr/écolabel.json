                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19c2f9f5-887a-40e0-a805-7b4b65eba5ae",
                        "entry_id": "b515a696-cac5-388b-a11a-fd34e16b7c67",
                        "tags": [
                            "plural"
                        ],
