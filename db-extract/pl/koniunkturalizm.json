                "senses": [
                    {
                        "sense_id": "a6d6fb39-1c8a-394d-94e1-85af4c5e0fad",
                        "entry_id": "a6576118-e382-34d3-906e-488111207a4a",
                        "glosses": [
                            "postawa polegająca na dopasowywaniu się do aktualnej sytuacji w celu osiągania doraźnych korzyści bez względu na konsekwencje natury moralnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164d670f-b267-48c3-84ec-29461cb4501b",
                                "sense_id": "a6d6fb39-1c8a-394d-94e1-85af4c5e0fad",
                                "text": "Koniunkturalizm jest negacją zasady wierności głoszonym ideałom. Koniunkturalista ich nie ma – ma takie poglądy, głosi takie deklaracje, hasła, które mają aktualny zbyt."
                            },
                            {
                                "example_id": "7991cdb5-4108-43ec-ba34-a38d0d626526",
                                "sense_id": "a6d6fb39-1c8a-394d-94e1-85af4c5e0fad",
                                "text": "Była człowiekiem o wielkim charakterze – odważna – niepodatna na koniunkturalizmy, racjonalna, krytycznie patrząca na polskie mistycyzmy, megalomanie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
