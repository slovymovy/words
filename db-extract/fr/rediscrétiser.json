                "senses": [
                    {
                        "sense_id": "811ac80f-c2ca-35dc-ad9e-e77e9e25849f",
                        "entry_id": "c0d59773-74bf-36ab-bd6a-49c991c94a3a",
                        "glosses": [
                            "Discrétiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26da11eb-222e-41dd-84a1-817325dd811a",
                                "sense_id": "811ac80f-c2ca-35dc-ad9e-e77e9e25849f",
                                "text": "Lorsque vous traitez une dimension, un attribut discrétisé n'est rediscrétisé que pendant une mise à jour complète (ProcessFull)."
                            },
                            {
                                "example_id": "0b0c8082-a318-4fbe-8074-0a0b51d5e7ca",
                                "sense_id": "811ac80f-c2ca-35dc-ad9e-e77e9e25849f",
                                "text": "D'une part, on pourrait tout rediscrétiser puis refaire la même méthode sous prétexte que de toute facon, entre les points on ne sait pas ce qu'il y a."
                            },
                            {
                                "example_id": "e1dd0b26-b790-461d-9653-7ba0912d6e9a",
                                "sense_id": "811ac80f-c2ca-35dc-ad9e-e77e9e25849f",
                                "text": "En effet, une solution directe nécessiterait de rediscrétiser le domaine du flux de manière encore plus dense qu’au début du calcul...."
                            }
                        ]
                    }
