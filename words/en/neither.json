        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                    "sense_definition": "Used before the first of two (or more) alternatives to indicate that none of them is true (used with 'nor').",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Neither</w> the blue dress nor the red one fits me.",
                            "target_lang_translations": {
                                "ru": "<w>Ни</w> синее платье, ни красное мне не подходят.",
                                "tr": "Bana <w>ne</w> mavi elbise ne de kırmızı olanı uyuyor.",
                                "zh": "那件蓝裙子<w>既</w>不合身，那件红裙子<w>也</w>不合身。",
                                "nl": "<w>Noch</w> de blauwe jurk, <w>noch</w> de rode past mij.",
                                "pl": "<w>Ani</w> niebieska sukienka, <w>ani</w> czerwona na mnie nie pasują.",
                                "de": "<w>Weder</w> das blaue Kleid noch das rote passt mir.",
                                "fr": "<w>Ni</w> la robe bleue <w>ni</w> la rouge ne me vont.",
                                "it": "<w>Né</w> il vestito blu <w>né</w> quello rosso mi stanno bene.",
