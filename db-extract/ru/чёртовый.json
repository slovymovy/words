                ],
                "senses": [
                    {
                        "sense_id": "f270c446-0d77-300f-94b6-8e128b57f480",
                        "entry_id": "213b1463-b67a-33d6-aaf1-57cd34eb3008",
                        "glosses": [
                            "скверный, отвратительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb1f6b1-a80d-40eb-aab5-fbfb5f078e2f",
                                "sense_id": "f270c446-0d77-300f-94b6-8e128b57f480",
                                "text": "Дело каким-то чёртовым неприличным случаем доходит до суда."
                            },
                            {
                                "example_id": "c5bee396-d66d-4646-ae95-ed3e5dc6be50",
                                "sense_id": "f270c446-0d77-300f-94b6-8e128b57f480",
                                "text": "Бежать! бежать, спотыкаясь по чёртовым этим ухабинам. Да ещё — на подъём."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd266bef-55d7-3646-826a-e173ff1eaf2d",
                        "entry_id": "213b1463-b67a-33d6-aaf1-57cd34eb3008",
                        "glosses": [
                            "прост. груб. то же, что чёртов; проклятый, ненавистный, осточертевший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a584b431-1c30-41c8-8417-a3bc7b98081f",
                                "sense_id": "fd266bef-55d7-3646-826a-e173ff1eaf2d",
                                "text": "Чёртовый народ."
                            },
                            {
                                "example_id": "e2c1b8c5-c23a-40fa-9e50-2e77b7e32daf",
                                "sense_id": "fd266bef-55d7-3646-826a-e173ff1eaf2d",
                                "text": "Чёртовый город."
                            },
                            {
                                "example_id": "3a065700-f435-4b92-b38c-3eb02bd94830",
                                "sense_id": "fd266bef-55d7-3646-826a-e173ff1eaf2d",
                                "text": "Играй свою чёртовую музыку!"
                            }
                        ]
                    }
