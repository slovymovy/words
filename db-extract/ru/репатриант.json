                    {
                        "translation_id": "92d400e2-b3ca-4ffe-a18d-6c95750c27b0",
                        "source_entry_id": "934a5d23-c62f-377a-a083-157e751013d6",
                        "source_sense_id": "f6ca2c94-3728-39a3-a5ee-0f3e328c6d9b",
                        "target_lang_word": "Heimkehrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimkehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af81e26d-bf19-38a2-bcdc-adcf2605aac9",
                                        "entry_id": "6d9281a9-fcb1-34f6-bee6-890a0d98782d",
                                        "glosses": [
                                            "Person, die nach langer Abwesenheit in die Heimat zurückkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0efdcd-83f5-4262-b7b2-08dee7d5a1d2",
                                                "sense_id": "af81e26d-bf19-38a2-bcdc-adcf2605aac9",
                                                "text": "Die aus Frankreich ausgewiesenen 75 Roma sind in Bukarest angekommen. […] Nach französischen Angaben bekam jeder erwachsene Heimkehrer 300 Euro und jedes dazugehörige Kind 100 Euro."
                                            },
                                            {
                                                "example_id": "15824ede-cfd2-495c-83a5-12c0819d32ce",
                                                "sense_id": "af81e26d-bf19-38a2-bcdc-adcf2605aac9",
                                                "text": "„Und ich war ein Heimkehrer in den Augen einer unerwartet großen Zahl von Menschen, die sich an meine Stücke erinnerten, als ob sie nicht zwölf Jahre lang verboten gewesen wären.“"
                                            },
                                            {
                                                "example_id": "1c360c5e-60c8-4ccd-8ff1-1b682109a3d9",
                                                "sense_id": "af81e26d-bf19-38a2-bcdc-adcf2605aac9",
                                                "text": "„Welche Distanz, welches Gefühl des Alleinseins muß der junge Heimkehrer schon so früh empfunden haben und welche Zweifel, da er es fertigbrachte, erst einmal an der Mutter vorüberzugehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2613cd48-0a4c-3b8c-b2d0-dcd7d092d4fb",
                                        "entry_id": "6d9281a9-fcb1-34f6-bee6-890a0d98782d",
                                        "glosses": [
                                            "Person, die aus Kriegsgefangenschaft zurückkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0419c63-1330-499f-8efd-50137566f43b",
                                                "sense_id": "2613cd48-0a4c-3b8c-b2d0-dcd7d092d4fb",
                                                "text": "„Nicht wenige Heimkehrer haben Spuren in den Akten der psychiatrischen Kliniken hinterlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9484d280-f690-434b-8e39-f20a8ecc90d0",
                        "source_entry_id": "934a5d23-c62f-377a-a083-157e751013d6",
