    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "21b8bb9c-169b-3f76-a600-cb1477147e63",
                    "sense_definition": "Iets wat niet duidelijk is, niet scherp omlijnd of moeilijk waarneembaar.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unclear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb slechts een <w>vage</w> herinnering aan mijn kindertijd.",
                            "target_lang_translations": {
                                "en": "I have only a <w>vague</w> memory of my childhood.",
                                "ru": "У меня лишь <w>смутное</w> воспоминание о детстве.",
                                "zh": "我对童年只有一点<w>模糊</w>的记忆。"
                            }
                        },
                        {
                            "text": "Zijn uitleg van het probleem bleef erg <w>vaag</w>.",
                            "target_lang_translations": {
                                "en": "His explanation of the problem remained very <w>vague</w>.",
                                "ru": "Его объяснение проблемы оставалось очень <w>расплывчатым</w>.",
                                "zh": "他对这个问题的解释依然非常<w>不明确</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "onduidelijk",
                        "wazig",
                        "onscherp"
                    ],
                    "antonyms": [
                        "duidelijk",
                        "scherp",
                        "helder"
                    ],
                    "common_phrases": [
                        "een vaag idee",
                        "een vage herinnering",
                        "vaag bekend",
                        "in het vage"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that is not clear, not sharply outlined, or difficult to perceive.",
                        "ru": "Что-то неясное, нечеткое или трудноразличимое.",
                        "zh": "指不清楚、轮廓不分明或难以察觉的事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "general term for lacking clarity or precision"
                            },
                            {
                                "target_lang_word": "unclear",
                                "target_lang_sense_clarification": "not easy to understand or see"
                            },
                            {
                                "target_lang_word": "hazy",
                                "target_lang_sense_clarification": "often used for memories or visual obscurity"
                            },
                            {
                                "target_lang_word": "indistinct",
                                "target_lang_sense_clarification": "not sharply defined to the senses"
                            }
                        ],
                        "ru": [
