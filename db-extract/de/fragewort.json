                                "example_id": "a469fefb-5ecd-4072-ab38-a05dbc4684d3",
                                "sense_id": "fd60ece0-c60b-3d06-9005-6d5acaa1470e",
                                "text": "Der Satz „Wann kommt Peter zu Besuch?“ enthält mit „wann\" ein Frageadverb als Fragewort."
                            },
                            {
                                "example_id": "6c7ae9c4-d979-4c5c-a746-796c08464e19",
                                "sense_id": "fd60ece0-c60b-3d06-9005-6d5acaa1470e",
                                "text": "„Aneinandergereihte Fragen oder Fragewörter können mit Komma verbunden werden.“"
                            },
                            {
                                "example_id": "5847eb8d-3635-4fd2-a40d-f634f724dd82",
                                "sense_id": "fd60ece0-c60b-3d06-9005-6d5acaa1470e",
                                "text": "Der Satz „Wer kommt heute zu Besuch?“ enthält mit „wer“ ein Fragepronomen als Fragewort."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
