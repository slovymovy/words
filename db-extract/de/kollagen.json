                "senses": [
                    {
                        "sense_id": "5731a882-583c-37c0-9fc8-61d8abeab589",
                        "entry_id": "e4b23578-421f-371e-a586-80a05a87d6c1",
                        "glosses": [
                            "tierisches Strukturprotein, häufigstes Protein des menschlichen Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ed0c6b-d6fb-4c55-8b7e-e5bb4a4da70e",
                                "sense_id": "5731a882-583c-37c0-9fc8-61d8abeab589",
                                "text": "Kollagen ist ein Bestandteil des Bindegewebes."
                            },
                            {
                                "example_id": "0883c11e-7461-4e75-9b64-c7cbd4bd1a8b",
                                "sense_id": "5731a882-583c-37c0-9fc8-61d8abeab589",
                                "text": "„Elena Schroeter und ihre Kollegen wiesen im Oberschenkel »MOR 2598« eindeutig die biochemischen Profile von Kollagenen nach.“"
                            },
                            {
                                "example_id": "44017d84-4c6a-4e95-9f53-f6fe212f3b54",
                                "sense_id": "5731a882-583c-37c0-9fc8-61d8abeab589",
                                "text": "„Bei allen Proben bestand die Knochenwand demnach aus langen Strängen mineralisierten Kollagens, die auf charakteristische Weise miteinander verwoben waren […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1dce8dd-a6ff-48fb-88ca-4fefb2d7e6b1",
