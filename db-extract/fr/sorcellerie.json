        "fr-extract.jsonl": [
            {
                "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                "word": "sorcellerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "153beb67-804f-4c55-b4a8-765c41767140",
                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                        "tags": [
                            "plural"
                        ],
                        "form": "sorcelleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                        "glosses": [
                            "Art des sorciers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "726a90ec-1616-4c01-9ff2-f980083af20d",
                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                "text": "On vous dira que le diable seul a pu produire de telles pierres, et l’on vous intentera un procès en sorcellerie."
                            },
                            {
                                "example_id": "3ce2d49a-b41b-473f-b1c0-4c0f16b4eacc",
                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                "text": "Comme Katrina Van Tassel, dans Sleepy Hollow, Mercredi possède un don de sorcellerie qu’elle a hérité de sa mère."
                            },
                            {
                                "example_id": "1e6b1fb3-d755-4bd2-9415-9998b55ae908",
                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                "text": "Dans la logique mentale de leur temps, les magistrats l’accusent et la condamnent de « sorcellerie », crime pour lequel le bourreau l’énuque avec la « hart » de la potence (corde d’infamie)."
                            },
                            {
                                "example_id": "e9644a58-bcc8-49da-aa57-eec850aa5432",
                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                "text": "« J’ai l’impression d’être entré dans une maison hantée de fête foraine. » Kara essuya ses yeux humides et regarda autour d’elle. La minuscule boutique était bourrée d’articles de sorcellerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "c83d2c89-834c-38f5-a246-f0431c161f13",
                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                        "glosses": [
                            "Pratiques des sorciers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f348c27a-5592-4671-9fb5-b1a690248f85",
                                "sense_id": "c83d2c89-834c-38f5-a246-f0431c161f13",
                                "text": "Leur pouvoir était illimité; ils guérissaient les malades abandonnés des médecins, rendaient fécondes les terres stériles, arrêtaient les épidémies de bestiaux, mais ils n’étaient point toujours d’humeur à ces sorcelleries bienfaisantes, et, plus volontiers, ils se servaient de leur puissance magique pour tourmenter les hommes et les bêtes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fa32aad-ed3d-4711-a8ef-db48a270f5ac",
                        "source_entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                        "target_lang_word": "sorcery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55ff9e00-9502-3dbb-b646-321e2e5a1539",
                                        "entry_id": "106800eb-f106-3178-aa99-7cba136c40fb",
                                        "glosses": [
                                            "Magical power; the use of witchcraft or magic arts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52067bfd-7e56-4942-b034-141d53ec33f7",
                                                "sense_id": "55ff9e00-9502-3dbb-b646-321e2e5a1539",
                                                "text": "The tale is full of magic and sorcery."
                                            },
                                            {
                                                "example_id": "1cce1be7-1092-474a-838f-eca8cfcd3e4f",
                                                "sense_id": "55ff9e00-9502-3dbb-b646-321e2e5a1539",
                                                "text": "In the Middle Ages, people were often accused of practicing sorcery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6661dbb-b9ec-3f45-b576-7579814d6b69",
                                        "entry_id": "106800eb-f106-3178-aa99-7cba136c40fb",
                                        "glosses": [
                                            "Black magic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fc9909-c804-4d78-ae26-32fac912940c",
                        "source_entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                        "target_lang_word": "witchcraft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "witchcraft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7944a7f-31ba-336d-86dd-33473b966891",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "The practice of witches; magic, sorcery, or the use of supernatural powers to influence or predict events."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031100e1-0263-460d-a595-01e215d26163",
                                                "sense_id": "a7944a7f-31ba-336d-86dd-33473b966891",
                                                "text": "Wiccans believe in a modernised form of witchcraft."
                                            },
                                            {
                                                "example_id": "a7307344-675b-47f0-89c2-530daa610843",
                                                "sense_id": "a7944a7f-31ba-336d-86dd-33473b966891",
                                                "text": "Such witchcraft has no power now to show itself, because the people don't believe in it any more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb7a9d1-2e0f-3297-9301-688327943c7b",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "Black magic; the use of witchcraft for evil means."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17498fa9-4eb5-4e41-9081-23441a520601",
                                                "sense_id": "9fb7a9d1-2e0f-3297-9301-688327943c7b",
                                                "text": "The Bible warns against the use of witchcraft and sorcery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873f70a4-e1c6-3aa1-9ef2-24e8bd2944f4",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "Something, such as an advanced technology, that seems almost magical."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef02ce52-a674-4133-bfab-44680e503d88",
                                                "sense_id": "873f70a4-e1c6-3aa1-9ef2-24e8bd2944f4",
                                                "text": "There can be no denying that the more than 100 exhibiting companies and divisions also gave full play to examples of their latest technological witchcraft, as befits the foremost US aerospace event."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68351f39-13ad-3355-b787-43614ddf667c",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "An irresistible or seemingly magical influence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
