                        "sense_id": "ed39dc88-4e36-36b7-beaa-994e5def465d",
                        "entry_id": "635e70f1-eb56-3252-92a1-254dbd1d9e6c",
                        "glosses": [
                            "Of or relating to a funeral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f5c728a-b20e-4651-ad3e-5ceab2c791bc",
                                "sense_id": "ed39dc88-4e36-36b7-beaa-994e5def465d",
                                "text": "The team says it has uncovered Bronze Age burnt mounds which heated water from the River Cole, Iron Age houses and funerary remains, plus evidence of Roman salt processing."
                            }
                        ]
                    }
                ],
