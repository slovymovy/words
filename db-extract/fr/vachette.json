                                "target_senses": [
                                    {
                                        "sense_id": "ba909ff7-0b25-3f54-ada5-a775f2332873",
                                        "entry_id": "752187a1-efb2-3924-a569-7773ecfb7bf8",
                                        "glosses": [
                                            "A young female cow, (particularly) one over one year old but which has not calved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3a20ef-998e-43c2-8341-5b462ff2c611",
                                                "sense_id": "ba909ff7-0b25-3f54-ada5-a775f2332873",
                                                "text": "And the Lord ſpake vnto Moſes and vnto Aaron, ſaying, This is the ordinance of the Law, which the Lord hath commaunded, ſaying, Speak vnto the childꝛen of Iſrael, that they bꝛing thee a red heifer without ſpot, wherein is no blemiſh, and vpon which neuer came yoke."
                                            },
                                            {
                                                "example_id": "5746883b-61f2-4508-a208-d33c1603e8ec",
                                                "sense_id": "ba909ff7-0b25-3f54-ada5-a775f2332873",
                                                "text": "We muſt be neat; not neat, but cleanly, Captaine: / And yet the Steere, the Heycfer^([sic]), and the Calfe, / Are all call'd Neat."
                                            },
                                            {
                                                "example_id": "7cc38034-65e7-4c01-b892-918b76b44d4c",
                                                "sense_id": "ba909ff7-0b25-3f54-ada5-a775f2332873",
                                                "text": "The breath of the mountain heifer was fragrant as the gales of Sirendiep, by feeding on ſpicy herbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411b7637-4dd8-3a29-891f-35e904a6aad7",
                                        "entry_id": "752187a1-efb2-3924-a569-7773ecfb7bf8",
                                        "glosses": [
                                            "A wife."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75a33aa-f1b5-49ae-af22-82bce16f7424",
                                                "sense_id": "411b7637-4dd8-3a29-891f-35e904a6aad7",
                                                "text": "Her, whom I shall choose for my heicfar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4089b909-5279-33e9-ba8c-56e63fb881c7",
                                        "entry_id": "752187a1-efb2-3924-a569-7773ecfb7bf8",
                                        "glosses": [
                                            "An unattractive or unpleasant woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd94afeb-b662-4e1a-af06-335c5806a12a",
                                                "sense_id": "4089b909-5279-33e9-ba8c-56e63fb881c7",
                                                "text": "I have half a mind to marry that heifer, tho' wives are bothersome critters when you have too many of them."
                                            },
                                            {
                                                "example_id": "0cb8afd8-319e-468e-8190-b4db271cdaba",
                                                "sense_id": "4089b909-5279-33e9-ba8c-56e63fb881c7",
                                                "text": "Stop your crying, heifer, I don't need all that, I got a job for you, the braided-up pimp is back!"
                                            },
                                            {
                                                "example_id": "afaad7df-7050-457a-bad9-54e4272b9099",
                                                "sense_id": "4089b909-5279-33e9-ba8c-56e63fb881c7",
                                                "text": "My hand was aching to slap that silly heifer. I told her to take her trifling ass down to Burger King and get herself a job flipping burgers..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
