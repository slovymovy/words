                ],
                "senses": [
                    {
                        "sense_id": "3d3558b4-b86b-3620-8a19-b29f09302b39",
                        "entry_id": "7b5c3751-e54c-313c-a11c-83f48d29242c",
                        "glosses": [
                            "To fortify, to make into a stronghold."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c14fc1d1-914e-4955-8983-9933657183f6",
                                "sense_id": "3d3558b4-b86b-3620-8a19-b29f09302b39",
                                "text": "By the time that our troops had taken a little refreshment, a quantity of intrenching tools were brought a-shore, and the regiments were employed in redoubting our ground, and landing some cannon and ammunition."
                            },
                            {
                                "example_id": "41426b75-2a06-46ee-b2c8-6f6247cf3bcb",
                                "sense_id": "3d3558b4-b86b-3620-8a19-b29f09302b39",
                                "text": "I have been employed from the day of action to that of the capitulation, in redoubting our Camp beyond insult"
                            },
                            {
                                "example_id": "2ce974d8-b15e-4fd4-beb0-ac8fb2b9c7e3",
                                "sense_id": "3d3558b4-b86b-3620-8a19-b29f09302b39",
                                "text": "The Commanding Royal Engineer in Canada again brought forward the earlier plan for redoubting the Quebec towers."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
