            {
                "entry_id": "521291a9-2345-3933-a896-79b8a6eb8b3e",
                "word": "Tweeter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f623fb46-4e8a-4e71-a0ec-024d879ac1e5",
                        "entry_id": "521291a9-2345-3933-a896-79b8a6eb8b3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "Tweeters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                        "entry_id": "521291a9-2345-3933-a896-79b8a6eb8b3e",
                        "glosses": [
                            "Alternative letter-case form of tweeter (“Twitter user”)."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d9199c0e-97f1-4a7d-a48e-ccecaeab3c7e",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "Government attempts to hunt down the bloggers and Tweeters were hampered when international supporters changed their Twitter settings to say they were all in Tehran, making it almost impossible for Iranian officials to sort through the traffic."
                            },
                            {
                                "example_id": "a16dbff9-4fdf-4477-a7bd-a7e00e7ec258",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "Jim Irsay, Indy’s top Tweeter"
                            },
                            {
                                "example_id": "701cd9f8-1450-44ec-bbca-e3f6c486f09c",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "For the topic of Haiti … singer Adam Lambert was the most influential Tweeter."
                            },
                            {
                                "example_id": "e3093d6b-fa5a-4f52-832f-b287c88185b7",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "[André Richard] Baldini and his 12-person styling crew have been giving clients shorter looks since late winter, when supermodel Karlie Kloss inspired a slew of Tweeters, Instagrammers and Pinteresters to try a nape-of-the-neck shag featuring a bit of bang."
                            },
                            {
                                "example_id": "5d854325-26a1-4e82-80b1-e69cd4aba404",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "Biegel was so concerned about the military response that he launched something of a charm offensive by reaching out to skeptical military bloggers and Tweeters who judged the promos as troubling, which he says he understands since it stitches together the wackiest elements of the series."
                            },
                            {
                                "example_id": "02108040-46cb-4b2c-8aeb-2b6a43595adb",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "As much as Facebookers, Instagrammers, and Tweeters like to post photos and notes on social media sites from faraway, exotic lands, she [Abbie Thompson Harris] said to resist the urge."
                            },
                            {
                                "example_id": "4ab4552c-996f-4eb9-a226-ffa108856f5e",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "Here is the Big Media Secret: We will generally do what you tell us to do. You, the reader, viewer, Tweeter, Facebooker currently hold more power over what is covered than at any time in history."
                            },
                            {
                                "example_id": "fabfb57c-091d-454f-84eb-ccbfb17e1fd2",
                                "sense_id": "430389e8-9332-3968-956d-d99ffe21d35a",
                                "text": "Her [Jessica Mulroney’s] fabulously fit Pippa Middleton-esque figure, swathed in that satiny cobalt, garnered praise from Tweeters and Instagrammers and Facebookers worldwide, who called it a “Pippa Moment.”"
                            }
                        ]
                    }
                ],
