            "senses": [
                {
                    "sense_id": "5beffd1f-dec3-3ee9-bfaf-074f73fb6362",
                    "sense_definition": "geld inzamelen voor een goed doel door langs de deuren te gaan of in een kerkdienst",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geld inzamelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vrijwilligers gaan deze week langs de deuren om geld te <w>collecteren</w> voor het Rode Kruis.",
                            "target_lang_translations": {
                                "en": "Volunteers are going door-to-door this week to <w>collect</w> money for the Red Cross."
                            }
                        },
                        {
                            "text": "Zij gaat elk jaar voor een goed doel <w>collecteren</w> met een collectebus.",
                            "target_lang_translations": {
                                "en": "Every year she goes out to <w>fundraise</w> for a good cause with a collection box."
                            }
                        }
                    ],
                    "synonyms": [
                        "inzamelen"
                    ],
                    "common_phrases": [
                        "voor een goed doel collecteren",
                        "met een collectebus collecteren",
                        "langs de deuren collecteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to raise money for a charity by going door-to-door or during a church service"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collect",
                                "target_lang_sense_clarification": "to gather money for charity"
                            },
                            {
                                "target_lang_word": "raise money",
                                "target_lang_sense_clarification": "to solicit donations for a cause"
                            },
                            {
                                "target_lang_word": "fundraise",
                                "target_lang_sense_clarification": "to seek financial support for a charity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12284766-e368-3db9-b8d5-3b90d24fc1c4",
                    "sense_definition": "het innen of verzamelen van verschuldigde bedragen zoals belastingen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geld inzamelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid moet effectieve manieren vinden om belastingen te <w>collecteren</w>.",
                            "target_lang_translations": {
                                "en": "The government must find effective ways to <w>collect</w> taxes."
                            }
                        },
                        {
                            "text": "In het verleden was het de taak van de tollenaar om gelden te <w>collecteren</w>.",
                            "target_lang_translations": {
                                "en": "In the past, it was the task of the tax collector to <w>gather</w> funds."
                            }
                        }
                    ],
                    "synonyms": [
                        "innen",
                        "heffen",
                        "inzamelen"
                    ],
                    "common_phrases": [
                        "belastingen collecteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in een formele of administratieve context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the collection or gathering of amounts due, such as taxes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collect",
                                "target_lang_sense_clarification": "to receive payments due"
                            },
                            {
                                "target_lang_word": "levy",
                                "target_lang_sense_clarification": "to impose and collect a tax"
                            },
                            {
                                "target_lang_word": "gather",
