            "senses": [
                {
                    "sense_id": "ef21624a-e687-3541-9b70-ffeb383c6a6e",
                    "sense_definition": "Paroles ou vœux formulés pour exprimer sa joie ou son admiration à l'occasion d'un heureux événement ou d'un succès (surtout employé au pluriel).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "compliment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous adresse toutes mes <w>félicitations</w> pour votre brillante réussite à cet examen difficile."
                        },
                        {
                            "text": "Les collègues lui ont présenté leurs sincères <w>félicitations</w> après l'annonce de son mariage."
                        }
                    ],
                    "synonyms": [
                        "compliment",
                        "congratulation"
                    ],
                    "antonyms": [
                        "condoléance"
                    ],
                    "common_phrases": [
                        "toutes mes félicitations",
                        "adresser ses félicitations"
                    ]
                },
                {
                    "sense_id": "fff70c3c-c44c-3fb0-a6bc-a561ae701965",
                    "sense_definition": "Action de féliciter quelqu'un ; témoignage individuel d'approbation ou compliment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compliment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a envoyé une lettre de <w>félicitation</w> à tous les employés de l'équipe."
                        },
                        {
                            "text": "Ce pompier courageux mérite une <w>félicitation</w> officielle pour avoir sauvé une famille du danger."
                        }
                    ],
                    "synonyms": [
