                "senses": [
                    {
                        "sense_id": "897c715f-424a-3551-b120-b6a943aeaba9",
                        "entry_id": "091d1dc5-202b-3ca4-9bf0-25a66c9341e4",
                        "glosses": [
                            "Henne, die meist eine besonders große Anzahl an Eiern legt, diese aber nicht ausbrütet"
                        ],
                        "tags": [
                            "Nutztierhaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "98e37cd3-c58a-4441-8e11-b29b86013b07",
                                "sense_id": "897c715f-424a-3551-b120-b6a943aeaba9",
                                "text": "Die Käfighaltung von Legehennen ist in der Europäischen Union verboten."
                            },
                            {
                                "example_id": "04a0e11b-4c91-42f0-afef-3af782726055",
                                "sense_id": "897c715f-424a-3551-b120-b6a943aeaba9",
                                "text": "Das ist eine schlechte Legehenne."
                            },
                            {
                                "example_id": "bb017725-b108-44cb-a2a7-919eda87fc52",
                                "sense_id": "897c715f-424a-3551-b120-b6a943aeaba9",
                                "text": "Legehennen, die 300 Eier pro Jahr legen und Mastputen, die mehr Gewicht ansetzen als ihre Beine tragen können - Hochleistungszüchtungen haben unsere alten, weniger effektiven Haustierrassen verdrängt."
                            },
                            {
                                "example_id": "9cc7baee-ac7c-4f73-9c8f-7c5ef233d1ad",
                                "sense_id": "897c715f-424a-3551-b120-b6a943aeaba9",
                                "text": "Marius Tünte, Pressesprecher des Deutschen Tierschutzbundes im Interview mit der Deutschen Welle: \"Es gibt Masthühner, die viel Fleisch ansetzen, und Legehennen, die besonders viele Eier legen. Die männlichen Küken bei den Legehennenrassen haben also keinen wirtschaftlichen Wert. Deswegen ist man irgendwann dazu übergegangen, die männlichen Tiere zu töten.\""
                            },
                            {
                                "example_id": "ead59ab4-40ce-4a61-98c1-e6217303c098",
                                "sense_id": "897c715f-424a-3551-b120-b6a943aeaba9",
                                "text": "Der Biohof kauft sowohl die Legehennen aus der Brüterei als auch die männlichen Tiere, um sie aufzuziehen. Wirtschaftlich ein Drahtseilakt […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
