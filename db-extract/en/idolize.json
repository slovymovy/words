                                    {
                                        "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                        "entry_id": "f4cd5a77-6500-384f-8b85-01d345e3c2fc",
                                        "glosses": [
                                            "Aimer avec excès quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec830db-5e2e-4ccf-97bd-d82e00158a78",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "NÉRON.– J’aime, que dis-je, aimer ? j’idolâtre Junie."
                                            },
                                            {
                                                "example_id": "cc521979-53ac-4287-8fc7-c3fa4a02cef8",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "C’est ainsi que ce mal-là croît et prospère. Sous le masque d’un intellectualisme auto-satisfait. Il se propage comme un cancer. Sanctifié par les miracles de sa propre technologie. S’idolâtrant lui-même !"
                                            },
                                            {
                                                "example_id": "02169ca0-941e-4209-882a-db566e467607",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "Les lois sont les mêmes pour tout le monde, quel que soit le dieu que tu idolâtres, non ?"
                                            },
                                            {
                                                "example_id": "de82abb7-5429-4516-80de-22df606b0bde",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "Il idolâtre cette femme."
                                            },
                                            {
                                                "example_id": "bd4e42b8-4659-4d45-9f09-b7a98ab9ca7a",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "Elle idolâtre ses enfants."
                                            },
                                            {
                                                "example_id": "b2e405bd-853c-4bed-844a-1e548512581c",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "Ces amants s’idolâtrent."
                                            },
                                            {
                                                "example_id": "b73fecbe-20ae-4370-8c80-7727fd116cba",
                                                "sense_id": "61c66660-a508-3ded-8309-07df32472f3a",
                                                "text": "Il idolâtre l’argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
