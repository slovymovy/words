        "fr-extract.jsonl": [
            {
                "entry_id": "8f2d9617-670b-3993-bf1c-4f7caecc6481",
                "word": "hilarité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ce74a2d2-f82d-4cb0-81fa-82c0faecf16d",
                        "entry_id": "8f2d9617-670b-3993-bf1c-4f7caecc6481",
                        "tags": [
                            "plural"
                        ],
                        "form": "hilarités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "618eade0-6316-3b46-85aa-c22bc8027ede",
                        "entry_id": "8f2d9617-670b-3993-bf1c-4f7caecc6481",
                        "glosses": [
                            "Gaieté subite, inattendue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4acca880-2ba0-4942-9858-5e3b279ef565",
                                "sense_id": "618eade0-6316-3b46-85aa-c22bc8027ede",
                                "text": "Il se mit à se trémousser sur sa chaise, secoué d'un accès d’hilarité, des larmes dans les yeux."
                            },
                            {
                                "example_id": "315139fb-c865-42a3-9dbc-fc8e553381cc",
                                "sense_id": "618eade0-6316-3b46-85aa-c22bc8027ede",
                                "text": "Un jour il se présente au Colonel avant un départ en mission : « Mon Colonel, je venais vous prier déféremment d’accepter mes respects ». L'adverbe était si bien dans la note professionnelle que tous les assistants, dont le Colonel, ont éclaté de rire, sans que le type comprenne leur hilarité."
                            }
                        ]
                    },
                    {
                        "sense_id": "7085814d-6415-36d9-afdc-68f72f1ee95e",
                        "entry_id": "8f2d9617-670b-3993-bf1c-4f7caecc6481",
                        "glosses": [
                            "Joie douce et calme."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f96f08cd-d8c9-4eda-9313-ca4973a07933",
                                "sense_id": "7085814d-6415-36d9-afdc-68f72f1ee95e",
                                "text": "Une physionomie pleine d’hilarité."
                            },
                            {
                                "example_id": "4063ea62-3db3-4db5-9b43-e95836f0de54",
                                "sense_id": "7085814d-6415-36d9-afdc-68f72f1ee95e",
                                "text": "Son visage a de l’hilarité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd15c28a-65d2-4921-b489-f2fb9a90738d",
                        "source_entry_id": "8f2d9617-670b-3993-bf1c-4f7caecc6481",
                        "target_lang_word": "hilarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hilarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc84add-2403-3298-ac10-f62bc1b979ba",
                                        "entry_id": "0162fdb7-ce1b-32a2-9c71-c62c1ededd0d",
                                        "glosses": [
                                            "A great amount of amusement, usually accompanied by much laughter."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334273b6-cc6e-4d4f-bc2d-cf99d32a4afa",
                                                "sense_id": "3fc84add-2403-3298-ac10-f62bc1b979ba",
                                                "text": "When the new baby's rubber duck squeaked at the wedding, hilarity ensued."
                                            },
                                            {
                                                "example_id": "f2f43db9-fbe1-4c24-a44e-ce393beee3cd",
                                                "sense_id": "3fc84add-2403-3298-ac10-f62bc1b979ba",
                                                "text": "In the rattle of the box, and of their agreeable conversation, Sir Francis’s spirits rose to their accustomed point of feeble hilarity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e4fee1-cddf-3020-8c3f-1095b8b9fdd0",
                                        "entry_id": "0162fdb7-ce1b-32a2-9c71-c62c1ededd0d",
                                        "glosses": [
                                            "Something that induces much laughter."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad797af8-09fb-4009-ae02-322fedd49aaa",
                                                "sense_id": "05e4fee1-cddf-3020-8c3f-1095b8b9fdd0",
                                                "text": "Think it not curious if we don't seem to be as sidesplittingly impressed with the hilarities in this picture as its promotion might lead you to expect. Hilarity is in it—hilarity at its best—as would be almost mandatory in any film with Miss Holliday."
                                            },
                                            {
                                                "example_id": "b7e6ff05-2cfd-4596-b088-36c8fcba75b6",
                                                "sense_id": "05e4fee1-cddf-3020-8c3f-1095b8b9fdd0",
                                                "text": "Many other Latin imports have become staples of our diet, like the burrito, which in Spanish means \"little donkey.\" What other food-related hilarities are we missing out on?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdad8a82-a54e-432e-9209-c9424eb000a7",
                        "source_entry_id": "8f2d9617-670b-3993-bf1c-4f7caecc6481",
