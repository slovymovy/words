                "senses": [
                    {
                        "sense_id": "5536d663-eee7-33fb-aa37-64ee5c6aed69",
                        "entry_id": "d561ecaa-af41-3946-8c43-ed516ee25ded",
                        "glosses": [
                            "met de eigenschappen van een speelgoedpop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf0411d-3f8c-4d38-88a9-433b9440ba2f",
                                "sense_id": "5536d663-eee7-33fb-aa37-64ee5c6aed69",
                                "text": "De Volkswagen New Beetle RSI kostte meer dan een Porsche 911 en er werden slechts 250 exemplaren van deze extreme Kever gemaakt. Hij moest het poppige imago van de moderne Kever opkrikken. En hoe! Met een dikke VR6-motor, vierwielaandrijving, een waanzinnig uiterlijk en een interieur dat is opgetrokken uit exotische materialen leek hij in niets op de normale New Beetle."
                            },
                            {
                                "example_id": "0f9389b6-2a27-448f-879a-dcde7708e721",
                                "sense_id": "5536d663-eee7-33fb-aa37-64ee5c6aed69",
                                "text": "De kleur van de jurk, de glitterapplicaties, het lossige bovenstuk: het doet allemaal wat oubollig, misschien zelfs oma-achtig aan, en toch kan actrice Claire Foy (we kennen haar allemaal van haar ijzersterke rol in The Crown) het hebben. Met haar bleke huid, zwarte haar en rode lippen is ze in Miu Miu een klein poppig assepoestertje."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a9a0d70-4c8a-31c9-8ec1-3d942cfe8a43",
                        "entry_id": "d561ecaa-af41-3946-8c43-ed516ee25ded",
                        "glosses": [
                            "in de stijl van pop-muziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af17cefe-885e-48b6-8f01-b5c7db618332",
                                "sense_id": "3a9a0d70-4c8a-31c9-8ec1-3d942cfe8a43",
                                "text": "Ook in de soort muziek die van Giersbergen maakt wil ze blijven vernieuwen. Na het uitbrengen van Everything Is Changing had de zangeres een goed beeld van hoe het volgende album moest klinken. 'Het was een soort lappendeken van alle muziek die ik tof vind, moody dingen, ballads, maar ook poppig."
                            }
                        ]
                    }
