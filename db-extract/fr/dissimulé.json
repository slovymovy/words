                                ]
                            },
                            {
                                "target_word": "concealed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b8858d6-1128-35f2-866d-adc1615159fb",
                                        "entry_id": "86127f3f-6c44-3652-9f92-c9d0fb93eeb8",
                                        "glosses": [
                                            "Hidden;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036dba91-7817-47d4-897b-7aeec35712d2",
                                                "sense_id": "3b8858d6-1128-35f2-866d-adc1615159fb",
                                                "text": "Certainly after a very concealed mannner; so concealed that no man has been able to find it."
                                            },
                                            {
                                                "example_id": "1ec09a22-b9c3-4e1e-b7ea-ae5dcf8b5c8b",
                                                "sense_id": "3b8858d6-1128-35f2-866d-adc1615159fb",
                                                "text": "These are to be understood as symbolizing his three-fold brain, of wisdom, understanding, and knowledge, which here appear more plainly; whereas in the supernals they are more concealed."
                                            },
                                            {
                                                "example_id": "891d69f2-8140-4cc5-83a0-ebb5c5b95689",
                                                "sense_id": "3b8858d6-1128-35f2-866d-adc1615159fb",
                                                "text": "The most concealed dwelling type is the underground settlement (e.g., Derinkuyu), and the next most concealed are dwellings carved in the rock faces and in cones;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
