                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructor explained the <w>RID</w> factor to the new lifeguards during the safety seminar.",
                            "target_lang_translations": {
                                "ru": "Инструктор объяснил фактор <w>RID</w> новым спасателям во время семинара по безопасности.",
                                "zh": "在安全研讨会上，教练向新救生员讲解了<w>RID</w>因素。"
                            }
