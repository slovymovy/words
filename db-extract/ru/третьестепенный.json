                "senses": [
                    {
                        "sense_id": "75ff6ccf-3dcc-359c-88a1-24bedb7e76ce",
                        "entry_id": "8c63cde7-cf58-3419-810d-241c2a9cbb9e",
                        "glosses": [
                            "insignificant, of little importance, nonmain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e447f740-07a2-4796-8afa-23cc61ce7223",
                                "sense_id": "75ff6ccf-3dcc-359c-88a1-24bedb7e76ce",
                                "text": "Локонов чу́вствовал, что он явля́ется ча́стью како́й-то карти́ны. Он чу́вствовал, что из э́той карти́ны ему́ не вы́йти, что он впи́сан в неё не по свое́й во́ле, что он явля́ется фигу́рой не гла́вной, а третьестепе́нной, что э́та карти́на со́здана определёнными бытовы́ми усло́виями, определённой полити́ческой обстано́вкой пе́рвой че́тверти двадца́того ве́ка.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
