                    {
                        "translation_id": "88142ce1-1735-444b-8092-b9682e853c59",
                        "source_entry_id": "d8e1b119-f26b-3f50-8252-0d59cd0b7697",
                        "source_sense_description": "great artery",
                        "target_lang_word": "aorta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aorta",
