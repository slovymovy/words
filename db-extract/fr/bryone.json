                        "glosses": [
                            "Cucurbitacée du genre Bryonia, dont les baies sont toxiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07cac8c-a573-4f20-a32b-83eccd409b1d",
                                "sense_id": "c4dd7fc0-b56e-3b3d-87ae-2bc354449063",
                                "text": "De la bryone on extrait la bryonine."
                            },
                            {
                                "example_id": "a05fa2d1-670d-4fdc-8333-24532ceaa17f",
                                "sense_id": "c4dd7fc0-b56e-3b3d-87ae-2bc354449063",
                                "text": "La meilleure méthode pour employer la racine de bryone comme purgatif, c’est de la dessécher avec soin, et d’administrer la poudre qu’on en obtient, en la pulvérisant, à la dose de 1 à 2 grammes."
                            }
                        ]
                    }
