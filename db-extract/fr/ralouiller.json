                        "glosses": [
                            "Râler faiblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abc95dfa-5fbb-4668-b0cb-97eccb9dda4b",
                                "sense_id": "34154e1d-417b-399c-ba11-6900f39ecd0e",
                                "text": "Dans ce cas, et dans l’ordre d’apparition des manifestations sonores à l’écran des journaux télévisés, il ralouille, râle, s’exclame, gronde, tonne, menace fermement, menace avec nuances, tonne, gronde, s’exclame, râle, ralouille et retourne au travail."
                            },
                            {
                                "example_id": "64a9396a-55af-4e76-bff8-4ed3ccb38778",
                                "sense_id": "34154e1d-417b-399c-ba11-6900f39ecd0e",
                                "text": "Parfois il se met à ralouiller en bougeant la tête, les bras dans tous les sens."
                            },
                            {
                                "example_id": "87598e92-e2e0-4399-9831-1dd821050802",
                                "sense_id": "34154e1d-417b-399c-ba11-6900f39ecd0e",
                                "text": "Ah si, s’il fallait ralouiller un peu, je trouve les stacktrace Python2 plus lisibles que leur version Python3."
                            }
                        ]
                    }
