    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01436cd0-9777-3077-b1f0-2ddefce21e4b",
                    "sense_definition": "To strike or hit with the foot or other extremity of the leg.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you <w>kick</w> your brother?",
                            "target_lang_translations": {
                                "ru": "Ты <w>пнул</w> своего брата?",
                                "zh": "你<w>踢</w>你弟弟了吗？"
                            }
                        },
                        {
                            "text": "The player <w>kicked</w> the ball into the goal.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>пнул</w> мяч в ворота.",
                                "zh": "球员把球<w>踢</w>进了球门。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kick the ball",
                        "kick the door",
                        "kick hard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять или бить ногой или ступней.",
                        "zh": "用脚或腿部末端踢或击打。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пинать",
                                "target_lang_sense_clarification": "наносить удары ногой"
