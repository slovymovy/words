                        "examples": [
                            {
                                "example_id": "75abe757-3bcc-4349-bb74-796840ca2e75",
                                "sense_id": "ca746e10-4a73-324d-8357-9a8d3fb54694",
                                "text": "— Une honte ! Comme si c’était pas assez du régiment ! Toute sa vie griveton ! Par force ! C’t’un comble !"
                            },
                            {
                                "example_id": "805db9cb-1ec8-40de-ad16-d6edd2b6e9f2",
                                "sense_id": "ca746e10-4a73-324d-8357-9a8d3fb54694",
                                "text": "– Encore griveton pour longtemps ?\nIl employait des mots d'argot que Louis ne comprenait pas toujours."
                            },
                            {
                                "example_id": "21eb8d0b-17f6-4f04-9af7-433b0f298118",
                                "sense_id": "ca746e10-4a73-324d-8357-9a8d3fb54694",
                                "text": "Il s’agissait d’un griveton que Simon ne retapissait pas et qui lui apportait la graille."
                            }
                        ]
                    }
                ],
