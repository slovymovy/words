                                    {
                                        "sense_id": "3f284e12-2d96-32d5-93c9-176aad7719ca",
                                        "entry_id": "345c436a-9fa8-3c08-90ee-e6af5318c101",
                                        "glosses": [
                                            "Any flying insect of the order Lepidoptera not in the superfamily Papilionoidea, most species of which are nocturnal and can be distinguished from butterflies by feather-like antennae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a47c4c-a413-47d9-802e-1b8a83f2a15a",
                                                "sense_id": "3f284e12-2d96-32d5-93c9-176aad7719ca",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beb1b23-3341-3f50-8aff-e9437463c353",
                                        "entry_id": "345c436a-9fa8-3c08-90ee-e6af5318c101",
                                        "glosses": [
                                            "Anything that gradually and silently eats, consumes, or wastes any other thing."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
