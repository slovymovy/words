                        "sentiment diffus"
                    ]
                },
                {
                    "sense_id": "95fecd16-f0de-3346-9252-132a41b95477",
                    "sense_definition": "Qui manque de concision et d'ordre, en exprimant la pensée avec trop de développements superflus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression_et_discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours était tellement <w>diffus</w> que personne n'a compris le message principal."
                        },
                        {
