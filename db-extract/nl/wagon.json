                        "source_sense_id": "3b74cc1f-9b8e-3995-bf9f-a9468ecbd80b",
                        "source_sense_description": "een voertuig dat deel uitmaakt van een trein",
                        "target_lang_word": "Waggon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waggon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7d143a-1d06-3348-a87e-a4b172159bf4",
                                        "entry_id": "1d6ea095-7100-354c-abc6-5f4dc957b507",
                                        "glosses": [
                                            "Eisenbahnwagen, Eisenbahnanhänger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1539be9c-66fe-4ce8-8c4f-887e5b6e56ea",
                                                "sense_id": "7e7d143a-1d06-3348-a87e-a4b172159bf4",
                                                "text": "Der Zug führte 40 Waggons mit sich."
                                            },
                                            {
                                                "example_id": "52419c3f-8caa-41ab-a8be-5b85f59a16fd",
                                                "sense_id": "7e7d143a-1d06-3348-a87e-a4b172159bf4",
                                                "text": "„Die Waggons sind verschlossen, jeder Waggon hat seinen Aufseher, auf den Trittbrettern stehen bewaffnete Soldaten.“"
                                            },
                                            {
                                                "example_id": "98fa921a-d70b-4137-b9fa-94bd01cd71f9",
                                                "sense_id": "7e7d143a-1d06-3348-a87e-a4b172159bf4",
                                                "text": "„Im ersten Waggon des Güterzugs, gleich hinter dem Tender, liegt ein Mensch auf Stroh.“"
                                            },
                                            {
                                                "example_id": "6d5e3b81-95b7-4ad7-a86e-d2b12863d5ec",
                                                "sense_id": "7e7d143a-1d06-3348-a87e-a4b172159bf4",
                                                "text": "„Zu beiden Seiten zieht sich die lange Linie der Waggons dahin, dunkelgrün, die Farbe so alt, daß sie Blasen wirft.“"
                                            },
                                            {
                                                "example_id": "4accc4de-156b-4671-aa76-e2bde52a0fe4",
                                                "sense_id": "7e7d143a-1d06-3348-a87e-a4b172159bf4",
                                                "text": "„In meinem Waggon waren ein paar Tote.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aff51aaf-e969-3e5d-9134-74c1240e4ac4",
                                        "entry_id": "1d6ea095-7100-354c-abc6-5f4dc957b507",
                                        "glosses": [
                                            "Ladung eines Wagens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b5a8fd0-0364-4744-bf03-23e18f2f452e",
                                                "sense_id": "aff51aaf-e969-3e5d-9134-74c1240e4ac4",
                                                "text": "Ein Waggon Kohle reicht für ein Jahr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b991ad4d-4edb-4574-829f-8113be696d1d",
                        "source_entry_id": "ac5c1763-a309-3443-903f-dd663774e79b",
                        "source_sense_id": "3b74cc1f-9b8e-3995-bf9f-a9468ecbd80b",
                        "source_sense_description": "een voertuig dat deel uitmaakt van een trein",
                        "target_lang_word": "carriage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carriage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bcf8a9f-7082-355b-a8da-2ee78b29a1a5",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "The act of conveying; carrying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0021bf4b-96b5-415b-a05c-bd9bc8a8941c",
                                                "sense_id": "3bcf8a9f-7082-355b-a8da-2ee78b29a1a5",
                                                "text": "The remainder of the men were employed in unbarreling our Pork and stringing it on poles for convenience of carriage, and carrying our Batteaux from the river to the pond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59196c54-d1d4-33e5-8134-349d961b982e",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "A means of conveyance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02096f53-01cb-3a42-9f7d-d78780f42a3f",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "A (mostly four-wheeled) lighter vehicle chiefly designed to transport people, generally drawn by horse power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c8c262b-a5e2-4003-b12a-b5a0ee227449",
                                                "sense_id": "02096f53-01cb-3a42-9f7d-d78780f42a3f",
                                                "text": "The carriage ride was very romantic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e5de10-2d56-305a-b808-020f50717ea8",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "A railroad car."
                                        ],
                                        "tags": [
                                            "British",
                                            "abbreviation",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10966a0b-cd33-4b8d-9c3b-aff1b56ae5f2",
                                                "sense_id": "39e5de10-2d56-305a-b808-020f50717ea8",
                                                "text": "When the long, hot journey drew to its end and the train slowed down for the last time, there was a stir in Jessamy’s carriage. People began to shake crumbs from their laps and tidy themselves up a little."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0059ee69-abf5-380e-b290-0012f850c549",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "The manner or posture in which one holds or positions a body part, such as one's arm or head."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d97c3579-b361-47b8-b949-cb1280084ff8",
                                                "sense_id": "0059ee69-abf5-380e-b290-0012f850c549",
                                                "text": "The runner has a very low arm carriage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11111ed0-392a-34be-b946-90b9e4ceefa2",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "A manner of walking and moving in general; how one carries oneself, bearing, gait."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4397104d-bcf4-4c10-a3c4-8199c35d6a7c",
                                                "sense_id": "11111ed0-392a-34be-b946-90b9e4ceefa2",
                                                "text": "His carriage was full comely and vpright, / His countenaunce demure and temperate [...]."
                                            },
                                            {
                                                "example_id": "736064ff-bb8e-4842-9daa-8a01f73cd34e",
                                                "sense_id": "11111ed0-392a-34be-b946-90b9e4ceefa2",
                                                "text": "In spite of her erect carriage she could flop to her knees to pray as smart as any of us."
                                            },
                                            {
                                                "example_id": "0b487c12-366d-4ceb-b385-d35ce50baae2",
                                                "sense_id": "11111ed0-392a-34be-b946-90b9e4ceefa2",
                                                "text": "Cavett: What would it take – seriously – for a musician to be good enough to play in the Miles Davis bands? Suppose you're looking for a new guy.\nDavis: Well, the first thing he needs do – whoever he is – has to have good carriage, you know.\nCavett: Meaning?\nDavis: Meaning that they have to look like what they're going to play – the instrument."
                                            },
                                            {
                                                "example_id": "b661e58d-c45e-4bd9-b31a-0fa98d295647",
                                                "sense_id": "11111ed0-392a-34be-b946-90b9e4ceefa2",
                                                "text": "She [Maya Angelou] towered over everyone and exuded a power that I had not recognized in anyone other than my mother. It was in her height. It was in her carriage. It was in her voice. And, I said to myself, 'This is woman to be reckoned with.'"
                                            },
                                            {
                                                "example_id": "19f40f8e-f1e8-415f-a87a-9e52d1da1297",
                                                "sense_id": "11111ed0-392a-34be-b946-90b9e4ceefa2",
                                                "text": "He chose to speak largely about Vietnam [...], and his wonderfully sonorous voice was as enthralling to me as his very striking carriage and appearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "573c8ea0-8171-366c-9423-40153df96724",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "One's behavior, or way of conducting oneself towards others."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5807c708-8ba9-4f86-b09a-668d4244d78c",
                                                "sense_id": "573c8ea0-8171-366c-9423-40153df96724",
                                                "text": "I had almoſt forgotten to acquaint your honor, that one major Alford (who was in mr. Love's conſpiracy) was of the graund inqueſt at Saliſbury, and was very zealous in his highneſſe ſervice here, and his good affection and wiſe carriage here, did much advantage the buſſineſe."
                                            },
                                            {
                                                "example_id": "e9262636-b93b-45df-ae54-cfdcc0e0b9f4",
                                                "sense_id": "573c8ea0-8171-366c-9423-40153df96724",
                                                "text": "He now assumed a carriage to me so very different from what he had lately worn, and so nearly resembling his behaviour the first week of our marriage, that […] he might, possibly, have rekindled my fondness for him."
                                            },
                                            {
                                                "example_id": "356bf840-9e7d-4f5f-8521-a0895551ea29",
                                                "sense_id": "573c8ea0-8171-366c-9423-40153df96724",
                                                "text": "Some people whisper but no doubt they lie, / For malice still imputes some private end, / That Inez had, ere Don Alfonso's marriage, / Forgot with him her very prudent carriage [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f200d370-fc38-333b-96f7-07af2d8c55bf",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "The part of a typewriter supporting the paper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c5559fb-8f86-3bca-9937-69f23c7fccdc",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "A shopping cart."
                                        ],
                                        "tags": [
                                            "New-England",
                                            "US",
