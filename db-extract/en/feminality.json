                        "glosses": [
                            "The quality of being feminal; femininity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f392e959-3a95-47a2-add0-ed4dd9b9207a",
                                "sense_id": "443c9b3d-e25e-3d8c-bd67-786d8c980833",
                                "text": "1702, George Farquhar, The Inconstant: Or, The Way to Win Him, Act IV in The Works of Mr. George Farquhar, London: John Rivington et al., 10th edition, 1772, p. 48,\nOriana. But don’t you think there is a great deal of Merit in dedicating a beautiful Face and Person to the Service of Religion?\nBisarre. Not half so much as devoting ’em to a pretty Fellow: If our Feminality had no Business in this World, why was it sent hither?"
                            },
                            {
                                "example_id": "8d06cb02-c3e6-4fa6-9599-21aba643ec7e",
                                "sense_id": "443c9b3d-e25e-3d8c-bd67-786d8c980833",
                                "text": "No one knows better than I do, that woman, in all essential characteristics, is the same yesterday, today, and forever, yet the readiness with which she lends herself to the variations of race, climate, caste, creed, nationality, and conditions of every kind, is the greatest charm of her feminality."
                            }
                        ]
                    }
