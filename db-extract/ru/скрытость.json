                "senses": [
                    {
                        "sense_id": "5f389e30-2de0-338e-89da-ef5699048d5c",
                        "entry_id": "1047ea6d-2fce-3e08-bca4-2106316e9616",
                        "glosses": [
                            "свойство по значению прилагательного скрытый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd47fd3-a5db-4a65-ad96-f9aeaea239a9",
                                "sense_id": "5f389e30-2de0-338e-89da-ef5699048d5c",
                                "text": "Конечно, словосочетание за многие века было для человечества означением некой тайности, скрытости от глаз явления, предмета всем, однако, видимого и находящегося постоянно в поле зрения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "addb5147-2403-4df4-b6d3-2ac2b0073e00",
                        "source_entry_id": "1047ea6d-2fce-3e08-bca4-2106316e9616",
                        "source_sense_id": "5f389e30-2de0-338e-89da-ef5699048d5c",
                        "target_lang_word": "secrecy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secrecy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8a62e6-4630-3efc-adf2-43e78c326623",
                                        "entry_id": "65d1d721-ac62-394d-83cf-8fd16f4d7690",
                                        "glosses": [
                                            "Concealment; the condition of being secret or hidden."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822cbfdd-bed0-489e-baa7-8e6c591328de",
                                                "sense_id": "6e8a62e6-4630-3efc-adf2-43e78c326623",
                                                "text": "I was sworn to secrecy."
                                            },
                                            {
                                                "example_id": "b5f84d7e-de7a-4cec-adf8-812c327e3fd8",
                                                "sense_id": "6e8a62e6-4630-3efc-adf2-43e78c326623",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "ee6de0eb-2e7e-4c17-ae2a-6e9833a670ad",
                                                "sense_id": "6e8a62e6-4630-3efc-adf2-43e78c326623",
                                                "text": "I suspect that this large and complex military railway system, shrouded in official secrecy for most of its operational life, remains unknown to many people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a075bfb4-e245-3c64-b992-dbbe8b6390d1",
                                        "entry_id": "65d1d721-ac62-394d-83cf-8fd16f4d7690",
                                        "glosses": [
                                            "The habit of keeping secrets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
