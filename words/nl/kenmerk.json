        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ec2017d-d3cc-3e0e-87cd-877d4817b945",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kenmerken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kenmerk</w> de belangrijke passages met een gele markeerstift.",
                            "target_lang_translations": {
                                "ru": "Я <w>помечаю</w> важные отрывки желтым маркером.",
                                "en": "I <w>mark</w> the important passages with a yellow highlighter.",
                                "pl": "Ważne fragmenty <w>oznaczam</w> żółtym zakreślaczem."
                            }
                        },
                        {
                            "text": "Als ik de situatie <w>kenmerk</w>, zou ik zeggen dat het complex is.",
                            "target_lang_translations": {
                                "ru": "Если я <w>охарактеризую</w> ситуацию, я бы сказал, что она сложная.",
                                "en": "If I <w>characterize</w> the situation, I would say it is complex.",
                                "pl": "Gdybym miał <w>scharakteryzować</w> tę sytuację, powiedziałbym, że jest skomplikowana."
                            }
                        }
                    ],
