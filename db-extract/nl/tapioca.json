                    {
                        "translation_id": "21c1c01e-4b87-4a69-891c-5432d738408b",
                        "source_entry_id": "fcbdee35-bfec-364b-bf75-7786ccb211a6",
                        "source_sense_id": "f898cf38-b6bd-370a-acc3-9b7a7c89a4e3",
                        "source_sense_description": "zetmeel verkregen uit de wortelknol van Manihot esculenta",
                        "target_lang_word": "tapioca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapioca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b01c654d-0f6c-3713-b542-b88a4237b45f",
                                        "entry_id": "bdafa7ec-c947-3bc2-92fe-9b01f3709c68",
                                        "glosses": [
                                            "A starchy food made from the cassava plant, used in puddings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b9c58b-7230-4758-a10f-4ecc8a676aaf",
                                                "sense_id": "b01c654d-0f6c-3713-b542-b88a4237b45f",
                                                "text": "Fish eyes and glue we used to call the half-cooked, large-grained, starchy tapioca without flavour that we were served every week in our residence at university. How I longed for the creamy pudding Mother used to make."
                                            },
                                            {
                                                "example_id": "5497c929-bbe0-4194-96d2-fdad820c00ff",
                                                "sense_id": "b01c654d-0f6c-3713-b542-b88a4237b45f",
                                                "text": "It happened when beverage aficionados learned that tapioca, the starch used to make the sweet, round, chewy black bubbles — or pearls — that are the featured topping in the popular boba tea drink, was in short supply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0795c58a-0624-3da0-96c3-e8e798039c27",
                                        "entry_id": "bdafa7ec-c947-3bc2-92fe-9b01f3709c68",
                                        "glosses": [
                                            "The cassava plant, Manihot esculenta, from which tapioca is derived; manioc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abcf7d9c-beb7-4454-9761-2f6a50cf2909",
                                                "sense_id": "0795c58a-0624-3da0-96c3-e8e798039c27",
                                                "text": "When the entire coast-line becomes a sea of waving palms, with Chinese and Malay villages fringing the shores, which are at present mere barren wastes of mangroves, with plantations of pepper, of gambier, and of tapioca and rice, the Northern Territory, backed up by the unswerving energy of the Australian squatter, miner, and planter, will present a spectacle almost unknown in the scheme of British colonization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
