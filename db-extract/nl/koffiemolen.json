                    {
                        "translation_id": "6586f397-e3cf-49bc-8c10-82520697ae48",
                        "source_entry_id": "2ceb3f4b-bb47-3c85-82d3-f8f78a35d37b",
                        "source_sense_id": "d6018cd0-8845-3b2a-a9c0-dcc0f34a866c",
                        "source_sense_description": "een huishoudelijk apparaat waarin koffiebonen kunnen worden gemalen",
                        "target_lang_word": "Kaffeemühle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaffeemühle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "190aef59-dde4-3916-aa36-3b08b7af03d0",
                                        "entry_id": "c271e223-55cf-38f5-ab58-9e36702686d5",
                                        "glosses": [
                                            "Haushaltsgerät, um Kaffeebohnen zu mahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d8d729-92e5-44f7-9a44-07f2d16805b2",
                                                "sense_id": "190aef59-dde4-3916-aa36-3b08b7af03d0",
                                                "text": "Zum Geburtstag habe ich exquisiten Kaffee geschenkt bekommen, allerdings in ganzen Bohnen und ich habe gar keine Kaffeemühle."
                                            },
                                            {
                                                "example_id": "637b4b54-1305-41e5-90e5-3ba2480ad05b",
                                                "sense_id": "190aef59-dde4-3916-aa36-3b08b7af03d0",
                                                "text": "Was ist das denn? Das sieht ja aus wie eine alte Kaffeemühle!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "268d7311-8176-4712-bd79-8d259f32510a",
                        "source_entry_id": "2ceb3f4b-bb47-3c85-82d3-f8f78a35d37b",
                        "source_sense_id": "d6018cd0-8845-3b2a-a9c0-dcc0f34a866c",
                        "source_sense_description": "een huishoudelijk apparaat waarin koffiebonen kunnen worden gemalen",
                        "target_lang_word": "coffee mill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffee mill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3dbe13e-3284-3dc3-b143-07526902a0ca",
                                        "entry_id": "0aab64ab-2874-3368-9ac5-05e5373a761f",
                                        "glosses": [
                                            "A mill at which coffee beans are dried, roasted, and ground prior to sale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ce160c-81a3-410a-9487-39480a5bd1dd",
                                                "sense_id": "f3dbe13e-3284-3dc3-b143-07526902a0ca",
                                                "text": "A good road leads to Pohoiki, once the site of a coffee mill and a prosperous village, but now almost deserted."
                                            },
                                            {
                                                "example_id": "f79e70a5-67e0-4114-8395-b075a4be2705",
                                                "sense_id": "f3dbe13e-3284-3dc3-b143-07526902a0ca",
                                                "text": "Mary Goretihas run the Jalamba coffee mill near Kituntu for ten years."
                                            },
                                            {
                                                "example_id": "229232fd-ec55-4d34-8d49-d7cc852e975e",
                                                "sense_id": "f3dbe13e-3284-3dc3-b143-07526902a0ca",
                                                "text": "During the boom period of the early 1890s, he converted his pineapple cannery into a coffee mill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45897cda-713a-3ff4-b5fe-d65e936dc5c1",
                                        "entry_id": "0aab64ab-2874-3368-9ac5-05e5373a761f",
                                        "glosses": [
                                            "A device designed for grinding coffee beans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9921b230-3191-40f0-bcdc-012e222bce4a",
                                                "sense_id": "45897cda-713a-3ff4-b5fe-d65e936dc5c1",
                                                "text": "The best way to do the grinding is in an electric coffee mill, if you happen to have one, but the old mortar-and-pestle routine works well, too."
                                            },
                                            {
                                                "example_id": "3de82052-0888-4bcb-a89d-528e3c6aca4b",
                                                "sense_id": "45897cda-713a-3ff4-b5fe-d65e936dc5c1",
                                                "text": "After drying, put ingredients, small amounts at a time, into a coffee mill and grind to a spice-like consistency."
                                            },
                                            {
                                                "example_id": "7ba8c36b-9632-40a4-9f44-2f6812ec8c0e",
                                                "sense_id": "45897cda-713a-3ff4-b5fe-d65e936dc5c1",
                                                "text": "She held an ornate brass coffee mill under her left arm and used her right hand to grind the freshly toasted beans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aff6824-0e11-4bd9-adf7-0b553accaae6",
                        "source_entry_id": "2ceb3f4b-bb47-3c85-82d3-f8f78a35d37b",
                        "source_sense_id": "d6018cd0-8845-3b2a-a9c0-dcc0f34a866c",
                        "source_sense_description": "een huishoudelijk apparaat waarin koffiebonen kunnen worden gemalen",
                        "target_lang_word": "moulin à café",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moulin à café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                        "entry_id": "b26dc8fc-b753-3fc6-b40c-9e28ccd9bbf6",
                                        "glosses": [
                                            "Objet destiné à broyer les grains de café en conservant au maximum ses arômes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453a39ad-e057-43f9-b53d-3594f78abac1",
                                                "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                                "text": "- Mieux : tu aurais fait un bon moulin à café.\n- Ah ?\n- Puisque tu n’arrêtes pas de broyer du noir."
                                            },
                                            {
                                                "example_id": "5c4bc338-3a2b-44b6-b595-7522f3c4deb7",
                                                "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                                "text": "Il est également intéressant d’observer les réajustements de la structure des grains dans le réservoir d’un moulin à café manuel lorsqu’on actionne celui-ci …"
                                            },
                                            {
                                                "example_id": "59b5c036-cfe0-4a3e-b594-1fe82e3ff441",
                                                "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                                "text": "L’utilisation de l’acier permet l’avènement d’une vraie industrie du moulin à café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efefd995-804a-32a0-a9bc-f82ce46d66c7",
                                        "entry_id": "b26dc8fc-b753-3fc6-b40c-9e28ccd9bbf6",
                                        "glosses": [
                                            "Mitrailleuse."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843a545e-5d2b-4a2b-9d65-6dec670451c8",
                                                "sense_id": "efefd995-804a-32a0-a9bc-f82ce46d66c7",
                                                "text": "La mitrailleuse y est assimilée, à cause de son tric-trac, à une machine à découdre ou à un moulin à café : « Entends-tu ces pieds-là, avec leur sale moulin à café ? » René X, Parisiens à la guerre. — « Avant d’avoir fait cent mètres, nous serons fauchés par les moulins à café comme des tiges de pavot », Galopin, Les Poilus, p. 4"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
