    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc5b2f41-6ce5-3453-94d2-88173589dc07",
                    "sense_definition": "Easily annoyed, angered, or exasperated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He becomes very <w>irritable</w> when he does not get enough sleep at night.",
                            "target_lang_translations": {
                                "ru": "Он становится очень <w>раздражительным</w>, когда не высыпается ночью."
                            }
                        },
                        {
                            "text": "The <w>irritable</w> old man yelled at the children playing near his garden.",
                            "target_lang_translations": {
                                "ru": "<w>Раздражительный</w> старик накричал на детей, игравших возле его сада."
                            }
                        }
                    ],
                    "synonyms": [
                        "bad-tempered",
                        "cranky",
                        "grumpy",
                        "quick-tempered",
                        "short-tempered"
                    ],
                    "antonyms": [
                        "calm",
                        "imperturbable",
                        "serene"
                    ],
                    "common_phrases": [
                        "irritable mood",
                        "become irritable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко раздражающийся, сердитый или выведенный из себя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "о человеке или характере"
                            },
                            {
                                "target_lang_word": "вспыльчивый",
                                "target_lang_sense_clarification": "быстро выходящий из себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa7c744a-d734-309f-915e-aae988f7ba83",
                    "sense_definition": "Capable of being physically irritated, inflamed, or made sensitive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensitivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People with <w>irritable</w> skin should avoid using harsh soaps and perfumes.",
                            "target_lang_translations": {
                                "ru": "Людям с <w>чувствительной</w> кожей следует избегать использования агрессивного мыла и парфюмерии."
                            }
                        },
                        {
                            "text": "The doctor diagnosed him with <w>irritable</w> bowel syndrome after several tests.",
                            "target_lang_translations": {
                                "ru": "После нескольких анализов врач диагностировал у него синдром <w>раздраженного</w> кишечника."
                            }
                        }
                    ],
                    "synonyms": [
                        "sensitive",
                        "tender"
                    ],
                    "common_phrases": [
                        "irritable skin",
                        "irritable bowel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный физически раздражаться, воспаляться или становиться чувствительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "о кишечнике, синдроме"
                            },
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "о коже или органах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "012e4cc1-66fb-3060-a3ce-022097af9abd",
                    "sense_definition": "Responsive to external stimuli, especially in a biological context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sensitivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All living tissues are <w>irritable</w> to some degree, responding to environmental changes.",
                            "target_lang_translations": {
                                "ru": "Все живые ткани в той или иной степени <w>раздражимы</w>, реагируя на изменения окружающей среды."
                            }
                        },
                        {
                            "text": "The experiment demonstrated how <w>irritable</w> plant cells react to sudden light exposure.",
                            "target_lang_translations": {
                                "ru": "Эксперимент продемонстрировал, как <w>чувствительные</w> растительные клетки реагируют на внезапное воздействие света."
                            }
                        }
                    ],
                    "synonyms": [
                        "responsive",
                        "reactive"
                    ],
                    "common_phrases": [
                        "irritable tissue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Реагирующий на внешние раздражители, особенно в биологическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражимый",
                                "target_lang_sense_clarification": "в биологии, способный реагировать на раздражители"
                            },
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "реагирующий на внешние воздействия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}