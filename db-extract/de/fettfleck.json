                "senses": [
                    {
                        "sense_id": "afebad75-d0b4-3f0b-a20e-bc4d1e4eea30",
                        "entry_id": "67a2e543-6947-32fb-a273-047b08afbd10",
                        "glosses": [
                            "sichtbarer, normalerweise unerwünschter Rückstand von Fett (meist auf Textilien, Papier oder Ähnlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf75343-74da-4653-98b0-3bc842aee455",
                                "sense_id": "afebad75-d0b4-3f0b-a20e-bc4d1e4eea30",
                                "text": "Fettflecke gehen nur schwer wieder 'raus."
                            },
                            {
                                "example_id": "ff39b28e-f4f4-4d81-9749-8e14cb712f99",
                                "sense_id": "afebad75-d0b4-3f0b-a20e-bc4d1e4eea30",
                                "text": "Mit Gallseife bekommt der Hausmann auch einen Fettfleck wieder aus der Kleidung."
                            },
                            {
                                "example_id": "8b7ea14e-c3af-4df7-ae2e-ed81ececad34",
                                "sense_id": "afebad75-d0b4-3f0b-a20e-bc4d1e4eea30",
                                "text": "„Die rote Farbe verblich langsam, und einige Fettflecke gingen auch beim Waschen nicht mehr raus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
