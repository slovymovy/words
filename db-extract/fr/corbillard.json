        "fr-extract.jsonl": [
            {
                "entry_id": "26507066-ff7e-302b-a695-527690c7a3b2",
                "word": "corbillard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef8e89dd-24bb-4c4f-a77b-c0f6bc4d5107",
                        "entry_id": "26507066-ff7e-302b-a695-527690c7a3b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "corbillards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e1970a6-bdd0-351f-9137-696b4d37e9e3",
                        "entry_id": "26507066-ff7e-302b-a695-527690c7a3b2",
                        "glosses": [
                            "Véhicule dans lequel sont transportés les morts au lieu de leur sépulture."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "cafb85f8-7207-4c36-b551-e0b15333519a",
                                "sense_id": "7e1970a6-bdd0-351f-9137-696b4d37e9e3",
                                "text": "Lentement, derrière le corbillard des pauvres, qu’avait orgueilleusement revendiqué le poète millionnaire, l’immense défilé se mit en route."
                            },
                            {
                                "example_id": "652ca67a-7a83-4acf-916d-0882e055fcb5",
                                "sense_id": "7e1970a6-bdd0-351f-9137-696b4d37e9e3",
                                "text": "Cet avis mortuaire, avec son laconisme, me parut d’une indicible tristesse et m’imposa la vision d’un de ces mornes corbillards qui, parfois, traversent Paris à vive allure sans personne derrière eux."
                            },
                            {
                                "example_id": "70b3dc47-33ba-4561-a32c-7cc286983740",
                                "sense_id": "7e1970a6-bdd0-351f-9137-696b4d37e9e3",
                                "text": "Mais où sont les funérailles d’antan ?\nLes petits corbillards, corbillards, corbillards, corbillards de nos grands-pères\nQui suivaient la route en cahotant.\n…\nMaintenant, les corbillards à tombeau grand ouvert\nEmportent les trépassés jusqu’au diable vauvert..."
                            },
                            {
                                "example_id": "42377a17-41a7-4598-b5f3-0f7030c470e5",
                                "sense_id": "7e1970a6-bdd0-351f-9137-696b4d37e9e3",
                                "text": "Le corbillard disparaissait sous les fleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a5b520c-4faa-43b1-9e08-8febb6bc32c5",
                        "source_entry_id": "26507066-ff7e-302b-a695-527690c7a3b2",
                        "source_sense_id": "7e1970a6-bdd0-351f-9137-696b4d37e9e3",
                        "target_lang_word": "Leichenwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichenwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                        "entry_id": "df035d04-cfd1-3a0f-94d5-ac69f951efbb",
                                        "glosses": [
                                            "Fahrzeug, das dazu dient, Tote zu transportieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e017257a-0e12-4482-af8f-f4d4338c2021",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Und die Pferde, die den Leichenwagen ziehen, welcher plötzlich vor ihm ist, haben goldene Zügel und schwarzweiße Federbüsche.“"
                                            },
                                            {
                                                "example_id": "b5b02105-bb7c-4561-b9f6-a753445fcf79",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "Leichenwagen sind meist schwarz und länglich."
                                            },
                                            {
                                                "example_id": "0860ab94-36c7-474b-986c-0658ee5fccd0",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Jedes Mal säumen Hundertausende die Straßen, über die der Konvoi der Leichenwagen fährt.“"
                                            },
                                            {
                                                "example_id": "d97a33fd-3d91-4e28-88ec-077b5c7d0d87",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Sie leiht sich einen anderen, verliert den Anschluss an den Leichenwagen, verfährt sich in der Stadt und kommt erst nach dem Ende der Zeremonie an.“"
                                            },
                                            {
                                                "example_id": "639c887c-4986-4ca7-84e5-509fb526924a",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Alle Leichenwagen sind im Einsatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99bd191e-bef2-473b-bbe9-6a94afbeedda",
                        "source_entry_id": "26507066-ff7e-302b-a695-527690c7a3b2",
