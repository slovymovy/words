                "senses": [
                    {
                        "sense_id": "456c89f7-a88f-3892-a0e7-e5a981b0b881",
                        "entry_id": "91091c07-5000-342d-b587-9b2802faf934",
                        "glosses": [
                            "начать змеиться, тянуться, виться извилистой линией, полосой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd6f925-6dc4-413a-b24b-863938006aed",
                                "sense_id": "456c89f7-a88f-3892-a0e7-e5a981b0b881",
                                "text": "Но вот лес кончился, опять зазмеилась пыльная светлая дорога."
                            },
                            {
                                "example_id": "6c16d4ca-081e-440c-aedd-d733c3dfd48e",
                                "sense_id": "456c89f7-a88f-3892-a0e7-e5a981b0b881",
                                "text": "Впереди, между досиня белых сугробов, зазмеились узкие рельсы."
                            }
                        ]
                    },
                    {
                        "sense_id": "02bfa6b3-3f0b-3085-9727-39ecd5d25dfa",
                        "entry_id": "91091c07-5000-342d-b587-9b2802faf934",
                        "glosses": [
                            "перен. начать блуждать, перебегать, скользить (преим. об улыбке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13dd8d09-7f24-47fc-96e5-c1ef33d0388e",
                                "sense_id": "02bfa6b3-3f0b-3085-9727-39ecd5d25dfa",
                                "text": "Прежняя шаловливая улыбка зазмеилась на устах её."
                            },
                            {
                                "example_id": "deed6f5a-6624-48c7-b9b1-91d8cee75dec",
                                "sense_id": "02bfa6b3-3f0b-3085-9727-39ecd5d25dfa",
                                "text": "На тонких губах Левка зазмеилась недобрая усмешка."
                            }
                        ]
                    }
                ],
