                "senses": [
                    {
                        "sense_id": "cadd9764-48ba-3328-9de8-e54c73a122e3",
                        "entry_id": "0f219cce-9929-33d3-8d69-eda3f3a8d060",
                        "glosses": [
                            "D'une manière inexplicable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bd631f-e83c-476f-91a7-c95342c8f986",
                                "sense_id": "cadd9764-48ba-3328-9de8-e54c73a122e3",
                                "text": "J’étais seul, inexprimablement seul, en face de ma mort, et cette mort n’était que la privation de l’être — rien de plus."
                            },
                            {
                                "example_id": "e8340064-8f7b-43b7-93a3-0c6aefba369e",
                                "sense_id": "cadd9764-48ba-3328-9de8-e54c73a122e3",
                                "text": "Sa montre, dont les aiguilles, ainsi qu'il arrive à ceux qui attendent, lui semblaient inexplicablement paresseuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec2ff202-0415-45bf-b063-6777a67d7ebe",
                        "source_entry_id": "0f219cce-9929-33d3-8d69-eda3f3a8d060",
