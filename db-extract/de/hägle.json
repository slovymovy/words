                "senses": [
                    {
                        "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                        "entry_id": "c3466078-8a9a-3a7b-bb44-5f85f1b0ce1f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acc0031-eb59-44c9-a398-01114c565a03",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Frau Hägle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0a396eb3-4add-4949-b753-b6b1570cbc0a",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Herr Hägle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9702ae6f-b469-48c3-a9be-0b1db01c9c08",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Die Hägles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "af4bbff1-59b1-4aaf-bf92-c0079df437ea",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Der Hägle trägt nie die Pullover, die die Hägle ihm strickt."
                            },
                            {
                                "example_id": "7fba68ab-eafa-4df4-a268-67b48c7854f1",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hägle kommt, geht der Herr Hägle.“"
                            },
                            {
                                "example_id": "8383b924-69db-486e-92bd-9f149eea47ae",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Hägle kommt und geht."
                            },
                            {
                                "example_id": "537ea293-124a-4d5f-abf0-fc5414655db4",
                                "sense_id": "880b81e0-5042-35c3-b228-12313e9eb19d",
                                "text": "Hägles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
