                                    {
                                        "sense_id": "1f051a64-fbc6-367e-b4b3-9e6c88259808",
                                        "entry_id": "111fd1bc-9636-3cb0-9746-5ddc3628e088",
                                        "glosses": [
                                            "The heating of a substance above a temperature at which a change of state normally occurs, without it occurring; especially the heating of a liquid above its boiling point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28d60b2-7b5a-4ebc-a078-010df6083aef",
                                                "sense_id": "1f051a64-fbc6-367e-b4b3-9e6c88259808",
                                                "text": "Superheating, first introduced with the \"Abs\", stopped further development in compounding, in New Zealand as elsewhere, and the \"Abs\" succeeded in dealing with the growing traffic unaided for more than a decade."
                                            }
                                        ]
                                    }
                                ]
