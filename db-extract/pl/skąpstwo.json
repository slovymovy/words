                        "entry_id": "db33d634-ee8d-3828-a844-d0449ccd33c3",
                        "glosses": [
                            "niechęć do rozstawania się z pieniędzmi, nadmierna oszczędność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cef05db-a492-48c7-9678-a2acbda35935",
                                "sense_id": "eb4b6258-49f4-3145-b7a8-53271de163bc",
                                "text": "Oskarżono mnie o skąpstwo i chciwość, a przecież byłam tylko oszczędna!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a823ed5b-13e9-4b89-ac4e-c5e1e5b87b62",
                        "source_entry_id": "db33d634-ee8d-3828-a844-d0449ccd33c3",
                        "source_sense_id": "eb4b6258-49f4-3145-b7a8-53271de163bc",
