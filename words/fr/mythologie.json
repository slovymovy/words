                    "frequency": "High",
                    "semantic_group_id": "croyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'école, les élèves découvrent les récits passionnants de la <w>mythologie</w> grecque."
                        },
                        {
                            "text": "Dans la <w>mythologie</w> nordique, Thor est le puissant protecteur des dieux et des hommes."
                        }
                    ],
                    "common_phrases": [
                        "mythologie grecque",
                        "mythologie nordique",
                        "mythologie romaine"
                    ]
                },
                {
                    "sense_id": "2cb57b60-81fa-3bf3-9f7c-0bf5c3b4a65d",
                    "sense_definition": "Discipline ou étude scientifique consacrée aux mythes et à leur interprétation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chercheur universitaire enseigne l'histoire et la <w>mythologie</w> comparée depuis dix ans."
                        },
                        {
                            "text": "Georges Dumézil a renouvelé la <w>mythologie</w> en comparant les dieux des peuples indo-européens."
                        }
                    ],
                    "synonyms": [
                        "mythographie"
                    ],
                    "common_phrases": [
