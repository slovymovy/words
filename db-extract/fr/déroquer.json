                        "examples": [
                            {
                                "example_id": "90f6b23a-7562-4a24-ad2c-89f6f3227eb9",
                                "sense_id": "b30259db-55f5-3f95-9fbb-96e7ca587809",
                                "text": "À côté, et hors l’enceinte des fossés, étaient d’autres bâtimens accessoires, avec un bois d’une certaine étendue, lequel a été déroqué depuis quinze à vingt ans. Le tout est maintenant en labour."
                            },
                            {
                                "example_id": "2107015e-ec9f-4b69-a4b6-7de02870aa24",
                                "sense_id": "b30259db-55f5-3f95-9fbb-96e7ca587809",
                                "text": "L’ajonc se mêle-t-il à la bruyère, la valeur du sol se relève ; si cet ajonc y croît seul, on peut en le déroquant obtenir une terre à blé."
                            }
                        ]
