                                        "examples": [
                                            {
                                                "example_id": "94118036-8bd9-428f-802d-8679a46f77dd",
                                                "sense_id": "775d0e16-5357-38f4-b503-806269b99f17",
                                                "text": "With conventional fuel cells as their model, researchers learned to use similar chemical reactions to make a fuel from microbes in pee.[…]They got to use new, clean toilets lit by the power of their own pee.[…]Microorganisms that feed on nutrients in urine can be used in a microbial fuel cell that generates electricity – or \"pee power,\" as the Sesame girls called it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f1ef42-512b-318f-8f3d-a2a2754c97ff",
                                        "entry_id": "98c70fae-e585-3604-9b94-563fdc865944",
                                        "glosses": [
                                            "An act of urination."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfe4eac-c739-4f98-a178-68cf9c3e7873",
                                                "sense_id": "14f1ef42-512b-318f-8f3d-a2a2754c97ff",
                                                "text": "He was dying for a pee."
                                            },
                                            {
                                                "example_id": "6bf013fe-3c1c-438e-9eb7-c6bc5d5bf05b",
                                                "sense_id": "14f1ef42-512b-318f-8f3d-a2a2754c97ff",
                                                "text": "I have to go for an urgent pee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6faa8124-451a-3416-9af0-4a09a406a438",
                                        "entry_id": "f90ae5b5-7748-3dd2-92ab-b69b8d756821",
                                        "glosses": [
                                            "To urinate."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1119028d-ed8f-4b0d-b669-27af34703d06",
                                                "sense_id": "6faa8124-451a-3416-9af0-4a09a406a438",
                                                "text": "The schoolboy called out to his friend while he was peeing in the urinal."
                                            },
                                            {
                                                "example_id": "b1bdaced-1c4e-4e66-9918-d6c5f6f174c0",
                                                "sense_id": "6faa8124-451a-3416-9af0-4a09a406a438",
                                                "text": "The delivery driver took a minute to pee in the woods between houses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50cf9f28-00f0-3083-8958-dc19ddb04613",
                                        "entry_id": "f90ae5b5-7748-3dd2-92ab-b69b8d756821",
                                        "glosses": [
                                            "To urinate.",
                                            "To urinate on oneself."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef111baf-8a90-4519-b5ac-b2ac128bffd7",
                                                "sense_id": "50cf9f28-00f0-3083-8958-dc19ddb04613",
                                                "text": "See there! A son is born\nAnd we pronounce him fit to fight\nThere are blackheads on his shoulders\nAnd he pees himself in the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8874ba-6644-337c-8430-e73b088ed6b1",
                                        "entry_id": "f90ae5b5-7748-3dd2-92ab-b69b8d756821",
                                        "glosses": [
                                            "To urinate.",
                                            "To urinate in or on something, particularly clothing."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac8ded05-7c69-4c6d-b4bc-c96005d7e3ee",
                                                "sense_id": "4e8874ba-6644-337c-8430-e73b088ed6b1",
                                                "text": "I was so excited, I peed the bed!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c50081d2-2778-3cd1-bf29-ce313a105700",
                                        "entry_id": "f90ae5b5-7748-3dd2-92ab-b69b8d756821",
                                        "glosses": [
                                            "To drizzle."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c5430d4-9077-4a81-aa59-dba657656f6d",
                                                "sense_id": "c50081d2-2778-3cd1-bf29-ce313a105700",
                                                "text": "It's peeing with rain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
