                    "frequency": "Middle",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le matin, le bébé mange une <w>bouillie</w> tiède préparée avec des céréales et du lait."
                        },
                        {
                            "text": "Elle prépare souvent une <w>bouillie</w> d'avoine bien chaude pour le petit déjeuner en hiver."
                        }
                    ],
                    "synonyms": [
                        "panade",
                        "porridge"
                    ],
                    "common_phrases": [
                        "bouillie d'avoine"
                    ]
                },
                {
                    "sense_id": "e70a7ca5-1278-38a9-a165-5a75c92f65c5",
                    "sense_definition": "Parole confuse ou discours embrouillé difficile à comprendre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de l'émotion, ses explications sont devenues une véritable <w>bouillie</w> incompréhensible."
                        },
                        {
                            "text": "Ce texte mal structuré ressemble plus à une <w>bouillie</w> de mots qu'à un véritable discours."
                        }
                    ],
                    "synonyms": [
                        "charabia",
                        "galimatias"
                    ],
                    "common_phrases": [
