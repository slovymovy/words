                        "examples": [
                            {
                                "example_id": "8c99b8af-4e87-4683-9523-d6e896ca75dc",
                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                "text": "In der Bootshalle lagern in den Wintermonaten die Boote und sie werden dort auch instand gesetzt."
                            },
                            {
                                "example_id": "7e8dfd43-e80f-465e-a5ce-8a00ed0ec7ad",
                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                "text": "„Die Bootshalle steht im Gewerbegebiet in Isenbüttel.“"
                            },
                            {
                                "example_id": "179d37d7-d0b7-4885-9d36-8e47e546cf7c",
                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                "text": "„Alle Planungen für eine Bootshalle müssen unveränderbare Maße berücksichtigen, unverzichtbare Räume zur Verfügung stellen und sollten folgenden Ablauf haben:[…]“"
                            },
                            {
                                "example_id": "d67bcf64-e77e-4772-8554-069f0c935253",
                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                "text": "„Der WSC Loga verfügt über eine eigene Bootshalle an der Fährstraße in Loga in unmittelbarer Nähe zur Leda.“"
                            },
                            {
                                "example_id": "c770f41f-ca2f-4409-9199-b9f24f49e239",
                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                "text": "„Die im Jahr 2001 errichtete Bootshalle ist in ihrer Konstruktion an skandinavische Vorbilder angelehnt.“"
                            }
