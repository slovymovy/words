                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "fc50cd6e-b997-4911-9b1c-57c2eba4c03a",
                                "sense_id": "bf4fafc6-c527-345e-a9a0-8433e350caee",
                                "text": "He strook so hard, the bason broke"
                            },
                            {
                                "example_id": "946b2a80-be77-4c0e-bfbc-a046f8ed4a6a",
                                "sense_id": "bf4fafc6-c527-345e-a9a0-8433e350caee",
                                "text": "Then the Romans in Antonia fearing his life, cryed out; but the Jews, many at once, strook him with Swords and Spears."
                            },
                            {
                                "example_id": "b7021ce9-d51d-412e-acb2-14ee60e71082",
                                "sense_id": "bf4fafc6-c527-345e-a9a0-8433e350caee",
                                "text": "The monſter mad with rage, and ſtung with ſmart, / His lance directed at the hero’s heart : / It ſtrook; but bounded from his harden’d breaſt[…]"
                            },
                            {
                                "example_id": "7af4be45-d8b9-4a5c-948a-f2ddb10b8100",
                                "sense_id": "bf4fafc6-c527-345e-a9a0-8433e350caee",
                                "text": "And we sate calmly, though that rocky hill,\nThe waves contending in its caverns strook,\nFor they foreknew the storm, and the grey ruin shook."
                            }
                        ]
                    },
                    {
                        "sense_id": "c74aab98-5238-3582-aa5e-2970cb0be5e6",
                        "entry_id": "5dc3e675-6d5e-336f-b46e-31b4163beb01",
                        "glosses": [
                            "past participle of strike"
                        ],
                        "tags": [
                            "form-of",
                            "obsolete",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "5d942f3e-1317-4315-b232-48954125017b",
                                "sense_id": "c74aab98-5238-3582-aa5e-2970cb0be5e6",
                                "text": "Stoop villaine, ſtoop, ſtoope for ſo he bids,\nThat may commaund thee peecemeale to be torne,\nOr ſcattered like the lofty Cedar trees.\nStrooke with the voice of thundring Iupiter."
                            }
                        ]
                    }
