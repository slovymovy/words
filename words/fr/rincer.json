                {
                    "sense_id": "a88c701a-388e-330e-8350-1d8b48d6cc2a",
                    "sense_definition": "Offrir une boisson ou un repas à quelqu'un en payant pour lui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "payer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour fêter sa promotion, c'est lui qui <w>rince</w> tout le groupe ce soir.",
                            "target_lang_translations": {
                                "en": "To celebrate his promotion, he's the one who's <w>treating</w> the whole group tonight.",
                                "ru": "Чтобы отпраздновать повышение, сегодня всю компанию <w>угощает</w> он.",
                                "de": "Um seine Beförderung zu feiern, <w>lädt</w> er heute Abend die ganze Gruppe <w>ein</w>.",
                                "es": "Para celebrar su ascenso, esta noche es él quien <w>invita</w> a todo el grupo.",
                                "zh": "为庆祝他升职，今晚是他<w>请客</w>，全组的人都不用花钱。"
                            }
                        },
                        {
                            "text": "Ne sors pas ton portefeuille au bar, ce soir c'est moi qui <w>rince</w>.",
                            "target_lang_translations": {
                                "en": "Don't get your wallet out at the bar, tonight I'm the one <w>treating</w>.",
                                "ru": "Не доставай кошелёк в баре, сегодня <w>угощаю</w> я.",
                                "de": "Zieh an der Bar nicht dein Portemonnaie raus, heute Abend <w>lade</w> ich <w>ein</w>.",
                                "es": "No saques la cartera en el bar, esta noche <w>invito</w> yo.",
                                "zh": "别在酒吧里掏钱包了，今晚是我<w>请客</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "payer",
                        "régaler"
                    ],
                    "traits": [
