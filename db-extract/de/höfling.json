                        ],
                        "form": "die Höflinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                        "entry_id": "1b049dbd-f107-34e8-86a8-1624c56f385c",
                        "glosses": [
                            "historisch, heute abwertend: Person, die zum Hofpersonal eines Herrschers gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74619c17-638d-46b6-9447-a6de22a55d9e",
                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                "text": "„Zudem muss Basileios seinen Höflingen misstrauen - etliche seiner Vorgänger sind durch Gift gestorben oder von Verschwörern gestürzt worden.“"
                            },
                            {
                                "example_id": "91fd5362-4a7a-465f-a288-e6b5d1dccc5c",
                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                "text": "„Einige Höflinge spielten den Briten insgeheim Informationen aus der Stadt zu.“"
                            },
                            {
                                "example_id": "36ccb751-1b66-4671-ab37-c1e2b8e7ab1d",
                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                "text": "„Vielleicht 50000 Menschen teilen sich die Hälfte dieser Stadt, die andere ist dem König mit seinem Palast und den wohl etwa 1000 Frauen, Kindern, Eunuchen, Höflingen und Wächtern vorbehalten.“"
                            },
                            {
                                "example_id": "c50a3a54-2b4d-4999-907a-4fa6f6f25d3a",
                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                "text": "„Die Pelliccia hätte gern von einem der vornehmsten Höflinge einen Empfehlungsbrief für diese Stadt erhalten; da sie aber keinen kannte, fragte sie mich, ob sie den venezianischen Gesandten bitten könne, sich ihrer anzunehmen und jemanden um einen Brief zu ersuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
