        "fr-extract.jsonl": [
            {
                "entry_id": "3dee43e3-a1a4-39cc-8ddb-aa446bbe3d39",
                "word": "hibiscus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
                        "entry_id": "3dee43e3-a1a4-39cc-8ddb-aa446bbe3d39",
                        "glosses": [
                            "Plante à fleurs annuelles ou vivaces de la famille des Malvacées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f709dc4f-6b61-4d65-8c66-334885498719",
                                "sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
                                "text": "Mais ce qui, de tous les détours des allées, frappait les regards, c’était un grand Hibiscus de la Chine, dont l’immense nappe de verdure et de fleurs couvrait tout le flanc de l’hôtel."
                            },
                            {
                                "example_id": "c64c34d2-61b1-46e6-b222-50c67261fda5",
                                "sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
                                "text": "J’apprenais à goûter l’exquise saveur des chevrettes d’eau douce enveloppées dans des feuilles d’hibiscus et rôties sur des pierres rougies au feu, un mets digne des dieux."
                            },
                            {
                                "example_id": "7e640977-3e07-4f6c-8fe3-a3453fe70f53",
                                "sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
                                "text": "Mitonné maison, celui de Cédric Grolet, le crack de la pâtisserie, est ensuite réduit avec une infusion d’hibiscus parfumée aux baies de Sancho pour composer le cœur coulant de son époustouflante grenade en trompe-l’œil."
                            },
                            {
                                "example_id": "99682778-0891-4388-8c60-1a9ef8d9188b",
                                "sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
                                "text": "Ces jours-là ses cheveux étaient séparés en deux longues nattes noires très épaisses ; de plus, elle piquait au-dessus de l’oreille (à l’endroit où les vieux greffiers mettent leur plume) une large fleur d’hibiscus, dont le rouge ardent donnait une pâleur transparente à sa joue cuivrée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "432f4b75-d6e8-44c0-8549-0d684588b851",
                        "source_entry_id": "3dee43e3-a1a4-39cc-8ddb-aa446bbe3d39",
                        "source_sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
                        "target_lang_word": "Hibiskus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hibiskus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33be7942-f8be-3f5d-b9f7-242b236ada88",
                                        "entry_id": "3b5d73c4-ff8b-393a-a703-8e31881efb09",
                                        "glosses": [
                                            "Blütenpflanze (Hibiscus) aus der Familie der Malvengewächse (Malvaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ff425c-0582-472f-b9d0-aec089ca2302",
                                                "sense_id": "33be7942-f8be-3f5d-b9f7-242b236ada88",
                                                "text": "Der Hibiskus ist eine unserer schönsten Blütenpflanzen."
                                            },
                                            {
                                                "example_id": "ab86d15b-1988-4ecc-9e26-9132c191930d",
                                                "sense_id": "33be7942-f8be-3f5d-b9f7-242b236ada88",
                                                "text": "Im Wintergarten fühlt sich der Hibiskus sehr wohl."
                                            },
                                            {
                                                "example_id": "958eab9e-5225-4c61-8826-7c108b93a782",
                                                "sense_id": "33be7942-f8be-3f5d-b9f7-242b236ada88",
                                                "text": "In Hawaii wird die Blüte vom Hibiskus als Haarschmuck getragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d494c7d5-529f-4adf-b89d-daf358213424",
                        "source_entry_id": "3dee43e3-a1a4-39cc-8ddb-aa446bbe3d39",
                        "source_sense_id": "7c51369a-446c-343b-955e-83eb575f4ced",
