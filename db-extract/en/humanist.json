                                            {
                                                "example_id": "ea9cd641-7eb9-406f-9fc6-af72a4191e6a",
                                                "sense_id": "9d48c783-7bfc-3680-a4e5-986b7868e0f5",
                                                "text": "Humanisten glauben an die Würde des Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb91b622-cf7f-3305-a90e-4ef65177ae08",
                                        "entry_id": "eeda920c-0ef5-3021-b4b7-d79241d5d61b",
                                        "glosses": [
                                            "Vertreter des Renaissance-Humanismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e813071-ceb7-467c-bb1e-a1e310388462",
                                                "sense_id": "eb91b622-cf7f-3305-a90e-4ef65177ae08",
                                                "text": "Erasmus war ein großer Humanist."
                                            },
                                            {
                                                "example_id": "02b18d21-97da-44f4-8783-39126a28701d",
                                                "sense_id": "eb91b622-cf7f-3305-a90e-4ef65177ae08",
                                                "text": "„Um zu kontrollieren, wie ihre Leser das Geschriebene verstehen sollten, erfanden und formalisierten Humanisten immer weitere Satzzeichen wie das Semikolon, den Apostroph, die Ellipse (...), verschiedene Formen von Klammern (rund, geschweift und eckig), den Gedankenstrich und die Anführungszeichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e328ea94-e4ae-3144-9a65-0300be0377a4",
                                        "entry_id": "eeda920c-0ef5-3021-b4b7-d79241d5d61b",
                                        "glosses": [
                                            "jemand, der über eine humanistische Schulbildung verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a6a15b-fd3a-4059-8875-15ca9bc90958",
                                                "sense_id": "e328ea94-e4ae-3144-9a65-0300be0377a4",
                                                "text": "Viele Humanisten verstehen Altgriechisch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
