                "senses": [
                    {
                        "sense_id": "a71c6c4f-ed9c-3ad3-bda6-629acb9e322d",
                        "entry_id": "136d85e5-342c-3a04-96e2-c5e16488c2b3",
                        "glosses": [
                            "Intime, intérieur."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e673c237-e9b8-43cf-8f00-9ae4844fabf6",
                                "sense_id": "a71c6c4f-ed9c-3ad3-bda6-629acb9e322d",
                                "text": "Il possédait mieux que personne les antiquités de son pays qui se ranimaient et se rajeunissaient dans sa tête comme dans une internelle et spirituelle Jouvence."
                            },
                            {
                                "example_id": "8e617f9a-49f4-44f3-951b-21ad81135314",
                                "sense_id": "a71c6c4f-ed9c-3ad3-bda6-629acb9e322d",
                                "text": "J’ai cessé de lire l’Internelle Consolacion. Cette ancienne langue m’amusait fort, mais me distrayait et la joie quasi païenne que j’y goûte n’a rien à voir avec l’édification que je me proposais d’y chercher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
