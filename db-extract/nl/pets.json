                        "source_entry_id": "5f8f6eeb-83c4-3fb1-9e18-2ccfd0372f43",
                        "source_sense_id": "5ea4e665-70a4-35ec-a9f0-f813d76f4db3",
                        "source_sense_description": "harde klap die men met de blote, platte hand uitdeelt",
                        "target_lang_word": "slap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
