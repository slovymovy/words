                                        "sense_id": "243987c7-3494-3cac-a6ca-4f21039704e0",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "A chain of hills."
                                        ],
