                    {
                        "translation_id": "71836413-b145-43db-94b4-8b5f5e816e2e",
                        "source_entry_id": "ea36a668-aca4-3a58-a905-e40d5b820766",
                        "source_sense_description": "commander of a century of soldiers",
                        "target_lang_word": "honderdman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honderdman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9a767069-3c74-3948-ae63-ecf02cb29ed8",
                                        "entry_id": "717d55a5-d6a4-39f9-8be7-c6ddeab2453b",
                                        "glosses": [
                                            "iemand die leiding geeft aan 100 soldaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c1d2c7-5c97-42ca-a39c-c3e8a7c278a8",
                                                "sense_id": "9a767069-3c74-3948-ae63-ecf02cb29ed8",
                                                "text": "En moet je horen, op dit moment is hun honderdman Goelevoj (de anderen zeiden hem voor hoe de man echt heette, maar hij verstond het niet goed en maakte ervan: (generaal Galejev) onderweg naar deze bossen hierzo."
                                            },
                                            {
                                                "example_id": "75d8cd62-1e80-44f3-b9a9-f64998b583b6",
                                                "sense_id": "9a767069-3c74-3948-ae63-ecf02cb29ed8",
                                                "text": "Aan het Colosseum van Rome heeft een man die verkleed was als 'centurio' (honderdman) twee Amerikaanse toeristen afgeranseld nadat hij lachend voor hun foto had geposeerd. De twee toeristen moesten voor verzorging naar het ziekenhuis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f0c59cc-5f48-4438-abed-1fccf5599c4d",
                        "source_entry_id": "ea36a668-aca4-3a58-a905-e40d5b820766",
                        "source_sense_description": "commander of a century of soldiers",
                        "target_lang_word": "centurio",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centurio",
