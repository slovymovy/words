                "senses": [
                    {
                        "sense_id": "96ad0017-fafd-3fc1-bc1d-ccf673d77f86",
                        "entry_id": "e134693c-1beb-3dbe-ad89-7f3334f2a16d",
                        "glosses": [
                            "Faire sécher (de la viande), afin de pouvoir la conserver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "652c433b-90b9-4284-b31b-34c11eb464c5",
                                "sense_id": "96ad0017-fafd-3fc1-bc1d-ccf673d77f86",
                                "text": "Au lieu donc de jeter à la rivière le corps des bestiaux, on commença à les charquer, c'est-à-dire à les réduire en tranches minces qu'on fait dessécher à la chaleur du soleil."
                            },
                            {
                                "example_id": "1a6243be-31a8-4bc6-9153-d6ea783aeb70",
                                "sense_id": "96ad0017-fafd-3fc1-bc1d-ccf673d77f86",
                                "text": "Un jour prochain arriverait où elle ne pourrait plus charquer la viande, tanner les peaux, chauffer son feu."
                            }
                        ]
                    }
