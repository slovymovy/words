                                "sense_id": "a174ab67-5c0f-3b90-9534-f6729e90d905",
                                "text": "We hebben een snelle motorboot gehuurd voor een dag op het meer.",
                                "translation": "We rented a fast motorboat for a day on the lake.",
                                "english": "We rented a fast motorboat for a day on the lake."
                            },
                            {
                                "example_id": "9614f732-7a8e-43ad-b3f9-e6d46cc57da0",
                                "sense_id": "a174ab67-5c0f-3b90-9534-f6729e90d905",
                                "text": "De motorboot gleed soepel over het water en bracht ons naar de overkant.",
                                "translation": "The motorboat glided smoothly over the water and took us to the other side.",
                                "english": "The motorboat glided smoothly over the water and took us to the other side."
                            },
                            {
                                "example_id": "322f9c81-9bb9-4ccd-92e3-bdb3e98082ea",
                                "sense_id": "a174ab67-5c0f-3b90-9534-f6729e90d905",
                                "text": "Hij is van plan om een nieuwe motorboot te kopen voor zijn vakantie.",
                                "translation": "He plans to buy a new motorboat for his vacation.",
                                "english": "He plans to buy a new motorboat for his vacation."
                            }
                        ]
