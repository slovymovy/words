                "senses": [
                    {
                        "sense_id": "7a94aad2-f903-32b0-a891-8c1f4d16837a",
                        "entry_id": "f0977ef4-8dc7-3f8e-9745-16ffae9fdbf9",
                        "glosses": [
                            "Abschwächen, Verringern der (negativen) Auswirkungen von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc34afd-2872-4ec4-8d0f-657f3f2cd815",
                                "sense_id": "7a94aad2-f903-32b0-a891-8c1f4d16837a",
                                "text": "„Die Abmilderung der sozialen Ungleichheit in Europa besaß freilich auch klare Grenzen.“"
                            },
                            {
                                "example_id": "55e5c03b-caba-49ac-af9b-f2c1fb6bd8de",
                                "sense_id": "7a94aad2-f903-32b0-a891-8c1f4d16837a",
                                "text": "„Die Kirche handelt angemessen, wenn sie die Weisung gibt, eine Abmilderung der Strafen anzustreben, und gleichzeitig einen Weg dazu aufzeigt.“"
                            },
                            {
                                "example_id": "41a06b7c-8b57-4855-8b8d-9a122fbd36bf",
                                "sense_id": "7a94aad2-f903-32b0-a891-8c1f4d16837a",
                                "text": "„Dabei ist den ursprünglich zur Abmilderung des Ausfallrisikos eingeräumten Sicherheiten besondere Aufmerksamkeit zu widmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
