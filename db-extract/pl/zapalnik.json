                                        "glosses": [
                                            "Komponente, die eine Sprengladung zur Explosion bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f9a637e-d67e-4d5f-9fa2-633fa547d1ef",
                                                "sense_id": "61e4978e-11c1-3c1d-9e50-53a17050dc4c",
                                                "text": "„Experten des griechischen Heeres haben in Thessaloniki den Zünder einer Bombe aus dem Zweiten Weltkrieg entfernt.“"
                                            },
                                            {
                                                "example_id": "2d9768cd-b24d-4fd9-872f-41ab263e6b27",
                                                "sense_id": "61e4978e-11c1-3c1d-9e50-53a17050dc4c",
                                                "text": "„Diese explodierten, sobald sie eine bestimmte Wassertiefe erreicht hatten, bei manchen sprach der Zünder auch auf das Magnetfeld des Unterseebootes an.“"
                                            },
                                            {
                                                "example_id": "26c5426f-74c5-4dd0-98d9-bca612548b52",
                                                "sense_id": "61e4978e-11c1-3c1d-9e50-53a17050dc4c",
                                                "text": "„Robert Mugabe wurde für drei Monate in Makwiro inhaftiert, weil Sicherheitskräfte in einem Haus, das ihm gehörte, Bomben und Zünder gefunden hatten.“"
                                            }
                                        ],
