                                        "entry_id": "b239b157-062b-315c-9c48-c88cc51a31fb",
                                        "glosses": [
                                            "Gewebsschaden der Haut, der durch eine Infektion oder mangelnde Durchblutung entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421450e3-9ab2-4d15-950f-5cda04392579",
                                                "sense_id": "e2a10e0b-f220-3a6f-a56b-6bbf560a4898",
                                                "text": "Das Kopfende des Wurmes verursacht durch Abscheidungen ein taubeneigroßes Geschwür."
                                            },
                                            {
                                                "example_id": "5c05ee18-be77-47ea-8207-4f78207e7762",
                                                "sense_id": "e2a10e0b-f220-3a6f-a56b-6bbf560a4898",
                                                "text": "Typisch für die Hautveränderung ist ein linsen- bis münzengroßes, scharfrandiges und relativ oberflächliches Geschwür, das wie ausgestanzt erscheint."
                                            },
                                            {
                                                "example_id": "a0151e53-386e-4da2-adba-7a3cb50a3823",
                                                "sense_id": "e2a10e0b-f220-3a6f-a56b-6bbf560a4898",
                                                "text": "„Er fühle bereits die Verdammnis nahen, die der von mir herabbeschworenen Rache der Heiligen Jungfrau entspringe; er fühle Krämpfe in seinen Eingeweiden wühlen, und seine Zunge sei von Geschwüren bedeckt.“"
                                            },
                                            {
                                                "example_id": "9d96493b-80d5-4570-b828-9e1a9cf0295e",
                                                "sense_id": "e2a10e0b-f220-3a6f-a56b-6bbf560a4898",
                                                "text": "„Es klingt so nach Klicker, klingt auch ein bißchen nach Geschwür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
