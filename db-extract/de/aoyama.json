                                                "text": "青山走犯",
                                                "translation": "精神病人"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "青山",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "caf08b0d-9bce-38df-be7e-36c660b1266a",
                                        "entry_id": "5245a7fa-8960-3e02-898f-3f757d8253e7",
                                        "glosses": [
                                            "山名，又名青林山"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21a246e-cd40-4e0b-904e-9bc2d11248c9",
                                                "sense_id": "caf08b0d-9bce-38df-be7e-36c660b1266a",
                                                "text": "宅近青山同謝朓，門垂碧柳似陶潛。"
                                            },
                                            {
                                                "example_id": "820f3735-5b57-48bd-aff2-b196d8d90358",
                                                "sense_id": "caf08b0d-9bce-38df-be7e-36c660b1266a",
                                                "text": "宅近青山同谢朓，门垂碧柳似陶潜。"
                                            },
                                            {
                                                "example_id": "8fb6dc9b-b409-42a8-a273-e9a8d3d4008a",
                                                "sense_id": "caf08b0d-9bce-38df-be7e-36c660b1266a",
                                                "text": "阿朓青山自一村，州民歲歲與招魂。"
                                            },
                                            {
                                                "example_id": "3603cba2-65e7-4166-b15b-ebb63a3ecc40",
                                                "sense_id": "caf08b0d-9bce-38df-be7e-36c660b1266a",
                                                "text": "阿朓青山自一村，州民岁岁与招魂。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09e65d0-12be-3c7d-9e50-6441d840d360",
