{
    "word_family": [
        "praten",
        "praat",
        "prater",
        "praatje"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d217c9ea-204e-3b17-9b28-cdb79b531e32",
                    "sense_definition": "Zonder ophouden doorgaan met praten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kan uren <w>doorpraten</w> over zijn favoriete hobby.",
                            "target_lang_translations": {
                                "en": "He can <w>talk on</w> for hours about his favorite hobby."
                            }
                        },
                        {
                            "text": "De spreker bleef maar <w>doorpraten</w> terwijl het publiek al wilde vertrekken.",
                            "target_lang_translations": {
                                "en": "The speaker just <w>kept talking</w> while the audience already wanted to leave."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uren doorpraten"
                    ],
                    "target_lang_definitions": {
                        "en": "To continue talking without stopping."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "talk on",
                                "target_lang_sense_clarification": "To continue speaking for a long time."
                            },
                            {
                                "target_lang_word": "keep talking",
                                "target_lang_sense_clarification": "To persist in the act of speaking."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f12fd24-9e7b-3a30-89b5-640274a0541e",
                    "sense_definition": "Iets bespreken met anderen met als doel om tot overeenstemming te komen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De partijen gaan morgen verder <w>doorpraten</w> over de nieuwe plannen.",
                            "target_lang_translations": {
                                "en": "The parties will continue to <w>discuss</w> the new plans tomorrow."
                            }
                        },
                        {
                            "text": "Na een weekend <w>doorpraten</w> kwamen ze eindelijk tot een goede oplossing.",
                            "target_lang_translations": {
                                "en": "After a weekend of <w>deliberating</w>, they finally reached a good solution."
                            }
                        }
                    ],
                    "synonyms": [
                        "overleggen",
                        "bespreken",
                        "beraadslagen"
                    ],
                    "common_phrases": [
                        "samen doorpraten"
                    ],
                    "target_lang_definitions": {
                        "en": "To discuss something with others in order to reach an agreement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "discuss",
                                "target_lang_sense_clarification": "To converse or debate concerning a particular topic."
                            },
                            {
                                "target_lang_word": "deliberate",
                                "target_lang_sense_clarification": "To engage in long and careful consideration."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}