                "senses": [
                    {
                        "sense_id": "cc074a53-324b-3459-b337-e6fcb66f5229",
                        "entry_id": "a13837e5-1141-3cf1-9a41-0f74cbfd92b8",
                        "glosses": [
                            "Titelfigur des gleichnamigen Vampirromans von Bram Stoker ^(→ WP)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e27952ca-d15e-4386-9d83-e3aa21b0110d",
                                "sense_id": "cc074a53-324b-3459-b337-e6fcb66f5229",
                                "text": "„Nein, falls nicht einer von uns mit einem neuen Frankenstein oder Dracula anrückt, wird unsere eigene Geschichte noch sehr viel dramatischer sein müssen, ehe wir sie verkaufen können.“"
                            },
                            {
                                "example_id": "138dd029-2641-48fd-85dc-c2abb63e682a",
                                "sense_id": "cc074a53-324b-3459-b337-e6fcb66f5229",
                                "text": "„Dieses ganze Online-Dating war ein Riesennepp - man konnte zweihundert Kilo wiegen und aussehen wie Draculas Großmutter, aber dann bearbeitete man eben sein Porträt mit Photoshop oder klaute das Bild eines Supermodels.“"
                            },
                            {
                                "example_id": "3b5fb950-70d7-4a24-94c7-8bb4cd7fd95b",
                                "sense_id": "cc074a53-324b-3459-b337-e6fcb66f5229",
                                "text": "„›Howard, loyal sind sie doch bloß gegenüber Geld, Mösen und Flugzeugen, und ich kauf ihnen den guten Kumpel von der amerikanischen Lebensart genauso ab, wie ich’s Dracula abkaufen würde, dasser ’nen Job in der Blutbank ablehnt.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
