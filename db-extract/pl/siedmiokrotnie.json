                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c74930e9-fdcc-3458-9126-40317a903a30",
                                        "entry_id": "47f63413-e5d0-3993-a934-b049d8c63ff0",
                                        "glosses": [
                                            "By a factor of seven."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
