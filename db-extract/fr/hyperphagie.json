                ],
                "senses": [
                    {
                        "sense_id": "28d07763-f4ef-306b-b06a-a00a7b58037c",
                        "entry_id": "c160c368-4c75-3f2d-9f6f-45b7d61bd58a",
                        "glosses": [
                            "Trouble du comportement alimentaire caractérisé par une consommation excessive et non contrôlée de nourriture."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f7e6ac-4641-4198-86c1-ba5755bede94",
                                "sense_id": "28d07763-f4ef-306b-b06a-a00a7b58037c",
                                "text": "Dans un épisode d’hyperphagie, une personne peut, par exemple, prendre un repas complet, suivi d’un litre de crème glacée pour dessert et d’un sac de chips sans être capable de s’arrêter."
                            },
                            {
                                "example_id": "a298c01a-691c-4325-a158-456fd2bb98a8",
                                "sense_id": "28d07763-f4ef-306b-b06a-a00a7b58037c",
                                "text": "Selon la façon dont les anticorps vont se lier à cette hormone et le temps durant lequel ils vont le faire, cela déclenchera soit une sensation de satiété (anorexie), soit l’absence de cette même sensation (boulimie, hyperphagie)."
                            },
                            {
                                "example_id": "a16f9e10-5671-4cc3-ba84-e00680c76906",
                                "sense_id": "28d07763-f4ef-306b-b06a-a00a7b58037c",
                                "text": "Plusieurs explications peuvent rendre compte de la fonction autocalmante de l’hyperphagie."
                            }
                        ]
                    }
                ],
