                "senses": [
                    {
                        "sense_id": "fc821df9-eaca-3323-a599-19dd828519f5",
                        "entry_id": "3b17795b-63e8-3c6a-900e-c6fdd28385c6",
                        "glosses": [
                            "ein durch Gärung hergestelltes Getränk aus Birkensaft; oft gemischt mit Honig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d550e38-f744-4070-821b-d34902b20920",
                                "sense_id": "fc821df9-eaca-3323-a599-19dd828519f5",
                                "text": "„Für die Alten gabs reihum Holundersuppe und für die andern Honig mit Wacholderbeeren und Nachtschatten und vergorenen Birkenmet.“"
                            },
                            {
                                "example_id": "875b0898-8697-4335-b0ce-b25a00c7e078",
                                "sense_id": "fc821df9-eaca-3323-a599-19dd828519f5",
                                "text": "„Birkensaft, der Kambialsaft aus den Stämmen junger Birken (Betula lenta), wird bes. in Skandinavien (Finnland) und Rußland gewonnen, dient dort als Naturheilmittel, wird vergoren als Birkenmet getrunken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
