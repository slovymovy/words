                                        "sense_id": "233a5ce6-bc5b-3475-8161-5d2d02a347c9",
                                        "entry_id": "ba3d8d95-7864-3405-ba59-c95a4d6564ff",
                                        "glosses": [
                                            "złota moneta bita w Anglii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2b1c32-a894-465f-9501-986e73153bcd",
                                                "sense_id": "233a5ce6-bc5b-3475-8161-5d2d02a347c9",
                                                "text": "Lecz pobyt tam drogo kosztuje i po tygodniu, wydawszy dwie z pięciu gwinei, przeraziłem się bardzo co daléj będzie"
                                            },
                                            {
                                                "example_id": "1817bfef-f22a-4551-b5ea-fcda264fdff2",
                                                "sense_id": "233a5ce6-bc5b-3475-8161-5d2d02a347c9",
                                                "text": "Ja widzę rzeczy wielkie, i piękne i śmiałe, / Która ludzkość mizerna, rachityczna, chora, / Chwyta z obrzydliwością w swoje ręce małe / I przerabia na rubla, gwineę, luidora!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
