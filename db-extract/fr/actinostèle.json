                        "glosses": [
                            "Partie centrale de la tige d’une plante, lorsque sa coupe transversale a une forme étoilée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2ff49d-f48e-435f-9faa-056679f406d6",
                                "sense_id": "13369661-59fa-3d02-b741-cbfa85d3c887",
                                "text": "Actinostèle : stèle un peu plus évoluée dans laquelle le xylème dessine une forme étoilée, avec parfois des pointes qui fragmentent l'anneau de phloème."
                            },
                            {
                                "example_id": "af1f5866-326b-4e0e-9bbc-4e7106bad4f4",
                                "sense_id": "13369661-59fa-3d02-b741-cbfa85d3c887",
                                "text": "L’actinostèle, par exemple, est caractéristique des tiges des Psilotum, plantes des régions tropicales."
                            }
                        ]
                    }
                ],
