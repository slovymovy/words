                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d3d2c4-2183-4768-9fdc-d32feb534c95",
                                "sense_id": "4ac84b29-0ce1-3c53-a5ae-43681f2e4130",
                                "text": "Ce n'est pas tout ; ces dessins, arrivés à bon port, il faudra les faire recartonner et revitrer, selon les indications que je vous donnerai, et border d'une simple bande de papier gris."
                            },
                            {
                                "example_id": "9d5c6aa5-0431-4a24-bd05-06ca3a426fd8",
                                "sense_id": "4ac84b29-0ce1-3c53-a5ae-43681f2e4130",
                                "text": "3°- sur la nécessité de produire à l'appui du devis le dessin que propose l'architecte pour revitrer la grande ogive, alors que les fragments anciens en avalent été enlevés."
                            }
                        ]
