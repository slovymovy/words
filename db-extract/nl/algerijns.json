                    {
                        "translation_id": "16486c04-b558-4c27-a403-d97050943b42",
                        "source_entry_id": "29a35be2-fa48-33ec-8713-2c80fb1eacec",
                        "source_sense_id": "52dda7c3-0f43-361a-a45a-57991b0f635c",
