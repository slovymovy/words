                        "cross_references": [
                            {
                                "target_word": "abandonware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91dc4d49-2bc9-3d19-a0a8-0ab34217cbca",
                                        "entry_id": "20cb16c3-7065-3775-b653-b8cf5c84beef",
                                        "glosses": [
                                            "A software product that is no longer updated or maintained, or whose copyright is no longer defended or which is no longer marketed even by the company who made it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24729a94-fe92-49db-b57b-43e37f8dab37",
                                                "sense_id": "91dc4d49-2bc9-3d19-a0a8-0ab34217cbca",
                                                "text": "RR> Never heard of Wildscan. Is it shareware or is there a^([sic]) evaluation\nRR> version available?\nIt's abandonware ala Joe Martin inc.:)"
                                            },
                                            {
                                                "example_id": "1cf1116d-e828-4006-ae85-025f2fd8da27",
                                                "sense_id": "91dc4d49-2bc9-3d19-a0a8-0ab34217cbca",
                                                "text": "Abandonware is software that is no longer being sold or supported by its author, copyright owner, or licensed distributor. Software that is still being sold, but no longer supported, is sometimes also referred to as abandonware."
                                            },
                                            {
                                                "example_id": "e9c4fe4a-1b1c-4a14-8e09-a0b4575ba671",
                                                "sense_id": "91dc4d49-2bc9-3d19-a0a8-0ab34217cbca",
                                                "text": "Such toolkits developed in research projects are deemed to end as abandonware where the authors stop working on it and reported bugs will not get fixed after the associated paper was accepted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
