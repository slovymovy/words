                    {
                        "sense_id": "bb9185b0-44d1-3ca2-9b56-d139a13be670",
                        "entry_id": "3609c5b2-ba5b-3716-af84-9a75b84cda7d",
                        "glosses": [
                            "Dienstgrad eines Soldaten zwischen dem Leutnant und Hauptmann"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "726dbf99-27de-4b11-9865-22bb242c87b4",
                                "sense_id": "bb9185b0-44d1-3ca2-9b56-d139a13be670",
                                "text": "Eine Beförderung zum Oberleutnant ist stets mit einer Solderhöhung verbunden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32eab45d-9d97-37b7-b89a-e3bdf4e7d665",
                        "entry_id": "3609c5b2-ba5b-3716-af84-9a75b84cda7d",
                        "glosses": [
