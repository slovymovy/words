                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "deac8e0c-9220-44fd-b959-732531857855",
                        "entry_id": "7ecbdc2d-86e9-36b0-93d7-6ac755b235da",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ebionites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c11cfe53-1a0a-3078-bc3c-14e3bace790d",
                        "entry_id": "7ecbdc2d-86e9-36b0-93d7-6ac755b235da",
                        "glosses": [
                            "A member of an early Jewish Christian sect that lived in and around Judea and Palestine from the 1st to the 4th century."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "07986f8e-6a1b-445a-931e-fb8977a2d296",
                                "sense_id": "c11cfe53-1a0a-3078-bc3c-14e3bace790d",
                                "text": "And if the pious bishop and martyr, St. Irenaeus, happen to drop any thing pointed against the Doctor's progenitors, the ancient Ebionites, of heretical memory, he gently passes it over as though no such passages occurred in that learned and venerable Father's writings."
                            },
                            {
                                "example_id": "47ff16cd-f0cb-4dfb-92f0-13aa3b87f68c",
                                "sense_id": "c11cfe53-1a0a-3078-bc3c-14e3bace790d",
                                "text": "EBION, the author of the heresy of the Ebionites, was a disciple of Cerinthus and his successor."
                            },
                            {
                                "example_id": "40060f76-7f59-44f8-998b-1c7cf0e34832",
                                "sense_id": "c11cfe53-1a0a-3078-bc3c-14e3bace790d",
                                "text": "The passage was so taken by the Jewish or Ebionite translators, Aquila, Theodotion, and Symmachus."
                            },
                            {
                                "example_id": "04e78877-f086-401a-8586-83c36428b231",
                                "sense_id": "c11cfe53-1a0a-3078-bc3c-14e3bace790d",
                                "text": "* Jesus teaches vegetarianism. Epiphanius describes the Ebionites as vegetarians, and in the Recognitions and Homilies vegetarianism is strongly connected to the rejection of animal sacrifice and is required of all the followers of Jesus. When Epiphanius questions a Jewish Christian as to why he was a vegetarian, the Jewish Christian responds simply: “Christ revealed it to me” (Panarion 30.18.9)."
                            }
                        ]
                    }
                ],
