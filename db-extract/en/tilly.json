                "senses": [
                    {
                        "sense_id": "3a8188d4-e4dd-312d-922f-56b79dc0bbbb",
                        "entry_id": "80c66c1a-237e-3e70-8a13-23ec2c8d4ad0",
                        "glosses": [
                            "A small open-backed truck."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "9aff3112-ece8-4285-befe-043d271dbab1",
                                "sense_id": "3a8188d4-e4dd-312d-922f-56b79dc0bbbb",
                                "text": "After a fortnight's careful nursing my leg healed and I was packed off in a tilly (utility truck) with my kit-bag to join my comrades at Fairmilehead."
                            },
                            {
                                "example_id": "a5882fb4-73e7-4628-89d0-9ab99d33f66a",
                                "sense_id": "3a8188d4-e4dd-312d-922f-56b79dc0bbbb",
                                "text": "One night soon after our arrival in Belgium, four of us set off to a dance in a rest centre, behind the lines, for the forces. We drove across a snowy waste in a tilly truck, singing \"Lilly Marlene\"."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3f110108-33df-487d-b9e1-914e19131a8c",
                        "source_entry_id": "80c66c1a-237e-3e70-8a13-23ec2c8d4ad0",
                        "source_sense_ids": [
                            "3a8188d4-e4dd-312d-922f-56b79dc0bbbb"
                        ],
                        "source_sense_description": "small truck",
                        "linkage_type": "synonyms",
                        "word": "ute"
                    }
                ]
