                    "sense_definition": "plural of <w>arch</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old bridge is supported by several stone <w>arches</w>.",
                            "target_lang_translations": {
                                "ru": "Старый мост поддерживается несколькими каменными <w>арками</w>."
                            }
                        },
                        {
                            "text": "We walked under the beautiful <w>arches</w> of the ancient cathedral.",
                            "target_lang_translations": {
                                "ru": "Мы прошли под красивыми <w>сводами</w> древнего собора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stone arches",
                        "under the arches"
                    ],
                    "target_lang_definitions": {
                        "ru": "множественное число от слова arch (арки, своды)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арки",
                                "target_lang_sense_clarification": "архитектурные конструкции"
                            },
                            {
                                "target_lang_word": "своды",
                                "target_lang_sense_clarification": "дугообразные перекрытия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32af16e2-bae2-3816-95d8-1e2e73d4ac08",
