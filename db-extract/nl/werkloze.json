                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc7ab2a-0a43-4275-8054-21cd09864242",
                                "sense_id": "25ffa704-acb8-37d4-8a3b-1827cffa89f2",
                                "text": "Iemand die vrijwillig afziet van het doen van betaald werk is geen werkloze."
                            },
                            {
                                "example_id": "5c91f9bb-f748-4713-868b-77bad878a848",
                                "sense_id": "25ffa704-acb8-37d4-8a3b-1827cffa89f2",
                                "text": "Mijn jongste zoon vraagt weleens plagend wie toch die werkloze zwerver is die een keer per jaar het vlees komt snijden."
                            }
                        ]
                    }
