                        "cross_references": [
                            {
                                "target_word": "lâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Qui n’est pas tendu, qui n’est pas serré comme il pourrait ou devrait l’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c897413f-37dd-4ca8-bb4f-422586141fa4",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "La traversée jusqu'à Cap Stewart, puis l'entrée dans l'Inlet furent facilitées par l'état très lâche des glaces."
                                            },
                                            {
                                                "example_id": "dd782368-3e1b-4f15-a7de-52e9b5ccbc8a",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Elle n’aimait pas cette fille que Laurent avait épousée quinze jours auparavant et qui, bien que sa grossesse fût à peine visible, portait des robes lâches et se tenait le ventre en avant."
                                            },
                                            {
                                                "example_id": "798d17f1-c4e5-4ad9-a710-00bf4a11d3cf",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Ce nœud, cette ceinture est trop lâche."
                                            },
                                            {
                                                "example_id": "ef5548bc-0071-46cf-817f-d00b176fdbc7",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Il faut tenir cette corde un peu lâche."
                                            },
                                            {
                                                "example_id": "73aeed31-e7ae-49bc-b457-405a67333fd0",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Toile, drap, étoffe lâche, toile, drap, étoffe dont la trame n’est pas assez battue ou la chaîne assez serrée."
                                            },
                                            {
                                                "example_id": "ee480cd6-e9c9-4fbe-ad9f-4d85a1d91596",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Ventre lâche, ventre mou."
                                            },
                                            {
                                                "example_id": "32a75bae-8ba3-421a-8d24-4a223d94d374",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Style lâche, qui manque d’énergie et de concision."
                                            },
                                            {
                                                "example_id": "6ed2f581-14da-473d-8200-812a08fe273e",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Une écriture lâche, dont les caractères sont mal formés et trop espacés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70aa956-6690-3110-9e97-2448cfe2d2a0",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Mou et paresseux."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b0eb2b-833e-4121-ab00-39a240610d0d",
                                                "sense_id": "b70aa956-6690-3110-9e97-2448cfe2d2a0",
                                                "text": "[…] le père ayant essayé d’en garder un toute la journée avec lui, tandis que l’autre restait avec la mère, tous les deux furent si tristes, si pâles et si lâches au travail, qu’on les crut malades."
                                            },
                                            {
                                                "example_id": "405dac88-7ff6-481c-bc60-672a3a389a5e",
                                                "sense_id": "b70aa956-6690-3110-9e97-2448cfe2d2a0",
                                                "text": "Vie lâche et efféminée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90b1f6c-1edd-3d68-8d66-ff9614381920",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Qui manque de courage."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa012302-2c87-47c1-87ac-1cbe33c1acbe",
                                                "sense_id": "e90b1f6c-1edd-3d68-8d66-ff9614381920",
                                                "text": "Ce soldat est lâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32fd051b-41e9-3fb7-a444-238ead29435a",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Vil et méprisable."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab638f8e-4c35-43a2-8fc3-798cf9561c76",
                                                "sense_id": "32fd051b-41e9-3fb7-a444-238ead29435a",
                                                "text": "C’est être bien lâche que de trahir son ami."
                                            },
                                            {
                                                "example_id": "0a140b24-0c1d-4639-8832-91d5d7e0fc80",
                                                "sense_id": "32fd051b-41e9-3fb7-a444-238ead29435a",
                                                "text": "Cette dénonciation est le fait d’une âme lâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Indigne d’un homme d’honneur ou d'une femme d'honneur."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677349b5-1366-4cd4-9a39-7aaaa6328116",
                                                "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                                "text": "Il a fait là une action bien lâche."
                                            },
                                            {
                                                "example_id": "b5ddca0b-b0b6-4279-86e6-125b9b2b8ea4",
                                                "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                                "text": "Son procédé est lâche."
                                            },
                                            {
                                                "example_id": "1bb765e4-65a5-4c45-bfbe-6225f2c1d73b",
                                                "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                                "text": "Que sa conduite est lâche!"
                                            }
