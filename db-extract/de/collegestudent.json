                "senses": [
                    {
                        "sense_id": "7692d579-3890-3b45-8ed1-94145a9a37e1",
                        "entry_id": "f7c61b7b-618a-357c-a687-f78e1f523f50",
                        "glosses": [
                            "Person, die an einem College studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2296c3b3-e4c4-4521-aad7-b1f7a218f1b5",
                                "sense_id": "7692d579-3890-3b45-8ed1-94145a9a37e1",
                                "text": "„Aus der Ferne hätte ich sie für einen Collegestudenten gehalten.“"
                            },
                            {
                                "example_id": "c89f3bb8-021b-4a2e-8596-92e8e4c696f5",
                                "sense_id": "7692d579-3890-3b45-8ed1-94145a9a37e1",
                                "text": "„Dieses Versprechen wurde von vielen, vielen Amerikanern mitgetragen. Aber nicht von allen. Sie wissen, wen ich meine. Die Demokraten. Die Medien. Die Antikriegsbewegung. Die Hippies. Die Collegestudenten.“"
                            },
                            {
                                "example_id": "433f502d-6431-4013-9011-4b5d2e36f614",
                                "sense_id": "7692d579-3890-3b45-8ed1-94145a9a37e1",
                                "text": "„Stattdessen ließ sie sich kalorienreiches Essen aufs Zimmer kommen, trank die ganze Minibar leer und verführte in ihrer zweiten Nacht einen neunzehnjährigen Collegestudenten, der als Hotelpage jobbte.“"
                            },
                            {
                                "example_id": "33410d35-0377-4958-8c82-83903ee3be0b",
                                "sense_id": "7692d579-3890-3b45-8ed1-94145a9a37e1",
                                "text": "„Als ich auf die Bühne ging und vor den christlichen Collegestudenten stand, die diesen Event jeden Donnerstagabend im Freizeitzentrum veranstalteten - und die sich wahrscheinlich alle wunderten, wer zum Teufel dieser Typ da vorn war -, sang ich einen Song, der Just Say Jesus hieß, weil der Titel so kitschig klang.“"
                            },
                            {
                                "example_id": "05572f58-1da4-4252-b81d-7bdb382978b1",
                                "sense_id": "7692d579-3890-3b45-8ed1-94145a9a37e1",
                                "text": "„Im Wonder-Book erzählt ein Collegestudent namens Eustace Bright einer Runde von Kindern im Plauderton die mythischen Geschichten der Antike.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
