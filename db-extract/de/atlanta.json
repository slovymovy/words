                                "example_id": "b8a81dc3-b5fe-41f5-97ce-84daf32f5482",
                                "sense_id": "46af34f0-497c-3777-ac03-e7d22fcfd4a6",
                                "text": "Atlanta Mustermann ist ein schönes Mädchen."
                            },
                            {
                                "example_id": "2716729b-8b3d-4ed8-ac8b-89ef84bc5b26",
                                "sense_id": "46af34f0-497c-3777-ac03-e7d22fcfd4a6",
                                "text": "Atlanta ist 20 Jahre alt."
                            },
                            {
                                "example_id": "52cb588e-38d6-4bc5-970b-d165f605359b",
                                "sense_id": "46af34f0-497c-3777-ac03-e7d22fcfd4a6",
                                "text": "Grüß bitte Atlanta Mustermann herzlich von mir."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c0e4a78-186b-42a7-9dfd-000adc9ff804",
