                        "glosses": [
                            "The quality of being feverish."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3326f4ec-b6f7-4e33-807a-60c38af9fc99",
                                "sense_id": "a5111ab2-0069-3a21-acb9-84893a1d99d3",
                                "text": "One of the party was suffering severely from ophthalmia - he had been seized with it some days before; the pain was so great that he could get no sleep, and when my father met him he was delirious from want of rest and feverishness."
                            }
                        ]
                    }
