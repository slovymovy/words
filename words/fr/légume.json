    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c38bf88f-991c-3d7e-bec6-d430f43fe0b1",
                    "sense_definition": "Plante ou partie de plante potagère comestible, consommée généralement en accompagnement ou dans des plats salés.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est recommandé de manger chaque jour au moins un <w>légume</w> frais pour rester en bonne santé."
                        },
                        {
                            "text": "Elle prépare une soupe délicieuse avec les <w>légumes</w> de saison achetés au marché."
                        }
                    ],
                    "antonyms": [
                        "fruit"
                    ],
                    "common_phrases": [
                        "légume vert",
                        "légumes de saison",
                        "légumes frais"
                    ]
                },
                {
                    "sense_id": "3e044b0f-43f9-3ab0-9167-eb20e7e3952d",
                    "sense_definition": "Personne privée de ses facultés physiques ou mentales, plongée dans un état comateux ou végétatif.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son grave accident de voiture, il est malheureusement resté dans le coma comme un <w>légume</w>."
                        },
                        {
                            "text": "Ce traitement médical est si lourd qu'il se sent vivre comme un <w>légume</w> toute la journée."
                        }
                    ],
                    "common_phrases": [
                        "vivre comme un légume",
                        "rester comme un légume"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "11f2cd13-6a88-39a3-923b-0902ed2a7bb7",
                    "sense_definition": "Fruit sec déhiscent s'ouvrant par deux valves, typique des fabacées ; synonyme botanique de <w>gousse</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chez les fabacées, le fruit est un <w>légume</w> qui s'ouvre par deux valves."
                        },
                        {
                            "text": "À maturité complète, ce <w>légume</w> s'ouvre le long des sutures pour libérer ses graines."
                        }
                    ],
                    "synonyms": [
                        "gousse"
                    ]
                },
                {
                    "sense_id": "2b121146-9451-364b-b777-f6df094a4457",
                    "sense_definition": "Personnage important ou influent occupant une place élevée dans une hiérarchie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs grosses <w>légumes</w> de la direction générale assistaient à cette importante réunion de fin d'année."
                        },
                        {
                            "text": "Depuis qu'il a été promu à ce poste ministériel, il se prend vraiment pour une grosse <w>légume</w>."
                        }
                    ],
                    "common_phrases": [
                        "grosse légume"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                }
            ]
