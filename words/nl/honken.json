                    "sense_id": "93641bf1-2645-39e9-9b70-70a303a8a4cb",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>honk</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De speler rende snel langs alle vier de <w>honken</w> op het veld.",
                            "target_lang_translations": {
                                "ru": "Игрок быстро пробежал мимо всех четырех <w>баз</w> на поле."
                            }
                        },
                        {
                            "text": "Tijdens het spelletje dienden de grote bomen in het park als veilige <w>honken</w>.",
                            "target_lang_translations": {
                                "ru": "Во время игры большие деревья в парке служили безопасными <w>домиками</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de honken bezet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "множественное число от существительного «honk» (базы в бейсболе или домики/убежища в детских играх)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "базы",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "домики",
                                "target_lang_sense_clarification": "в детских играх, убежища"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b8ac63e-677a-3c52-8c0a-0b7ae8299d01",
                    "sense_definition": "veilig op een honk blijven staan tijdens een honkbalwedstrijd",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De slagman besloot te <w>honken</w> omdat de verdediging de bal te snel teruggooide.",
                            "target_lang_translations": {
                                "ru": "Бьющий решил <w>остаться на базе</w>, потому что защита слишком быстро вернула мяч."
                            }
                        },
                        {
                            "text": "Hij zag het gevaar op tijd en bleef rustig <w>honken</w> bij het tweede kussen.",
                            "target_lang_translations": {
                                "ru": "Он вовремя заметил опасность и спокойно продолжил <w>стоять на базе</w> у второй подушки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "оставаться в безопасности на бейсбольной базе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставаться на базе",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "занимать базу",
                                "target_lang_sense_clarification": "в бейсболе"
                            }
                        ]
                    }
                }
            ]
