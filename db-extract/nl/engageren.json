                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7738ad6-31a3-4773-9244-0a1535a1a78e",
                                "sense_id": "dd274777-d483-39da-8e9a-7042b3cce176",
                                "text": "Hij engageerde zich met het lot van straathonden."
                            },
                            {
                                "example_id": "31b8cb1f-9a8b-46a9-a2a6-b91aa250e613",
                                "sense_id": "dd274777-d483-39da-8e9a-7042b3cce176",
                                "text": "De basis daarvan lag waarschijnlijk in de strijd voor het vrouwenkiesrecht, waaraan ze zich hadden geëngageerd sinds ze tieners waren."
                            }
                        ]
                    }
