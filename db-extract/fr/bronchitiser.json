                "senses": [
                    {
                        "sense_id": "fd7ec00a-8165-3d4f-8fcc-8c0d137dd355",
                        "entry_id": "5f9bafd8-953b-3cc8-8442-d6949c4737d5",
                        "glosses": [
                            "Donner un caractère bronchitique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b6c602-71c2-4b18-a50e-ec2c51badd1d",
                                "sense_id": "fd7ec00a-8165-3d4f-8fcc-8c0d137dd355",
                                "text": "En attendant je trachéitise, je bronchitise (à donf !) je sue, en un mot : je suis maaaaalaaaaaade !..."
                            },
                            {
                                "example_id": "46bde881-c148-476b-9811-5b236f87ad22",
                                "sense_id": "fd7ec00a-8165-3d4f-8fcc-8c0d137dd355",
                                "text": "j'ai froid, ça pèle ici! t'as fait un BTS froid toi, tu vas nous grippaliser, nous enrhumiser, nous bronchitiser, nous laringitiser, nous otitiser, (...)"
                            },
                            {
                                "example_id": "73f2dea1-c441-4c01-bf09-21c1cf1634b8",
                                "sense_id": "fd7ec00a-8165-3d4f-8fcc-8c0d137dd355",
                                "text": "Bronchitisé à souhait !"
                            },
                            {
                                "example_id": "d35bac19-21e2-4a4f-817a-c499f321643a",
                                "sense_id": "fd7ec00a-8165-3d4f-8fcc-8c0d137dd355",
                                "text": "La semaine a donc été \"enrhumée\", \"bronchitisée\", fiévreuse et forcément différente de mon quotidien habituel."
                            }
                        ]
                    }
