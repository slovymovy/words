                "senses": [
                    {
                        "sense_id": "323a5e1c-a0c2-39ee-8b42-a0cdad7a36dd",
                        "entry_id": "a26ad5e8-df4a-3d09-a4a3-6c91868f2aee",
                        "glosses": [
                            "Nom usuel de plusieurs arbres de la famille des Lauraceae (lauracées) dont l'écorce est utilisée comme condiment sous le nom de cannelle suivi généralement d'un épithète. → voir cannelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94b78cc-55f3-423d-8918-90649fedf696",
                                "sense_id": "323a5e1c-a0c2-39ee-8b42-a0cdad7a36dd",
                                "text": "L’indigo, la canne à sucre, le poivre rouge, le café, le cannelier et le muscadier n’y réussissent pas moins bien, etc, etc."
                            },
                            {
                                "example_id": "0bdc30d1-1286-4df2-8b6b-73f16f585def",
                                "sense_id": "323a5e1c-a0c2-39ee-8b42-a0cdad7a36dd",
                                "text": "La cannelle, épice aromatique tirée de l’écorce du cannelier, est le secret de nombreux chefs professionnels et amateurs pour relever plats en sauce et pâtisseries."
                            },
                            {
                                "example_id": "49750180-b971-4fd9-ba60-701b12da9540",
                                "sense_id": "323a5e1c-a0c2-39ee-8b42-a0cdad7a36dd",
                                "text": "Les liens de son panier sont de soie verte, Et l'anse d'un rameau de cannelier."
                            }
                        ]
                    }
                ],
