                ],
                "senses": [
                    {
                        "sense_id": "10dfcf65-9055-33bc-8f68-3a397cd928cc",
                        "entry_id": "f3aaf6a7-9ede-301d-b9dd-007f69c04fef",
                        "glosses": [
                            "Défaire (quelque chose qui avait été abouché)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98842039-617c-4894-badf-616b0b0a5087",
                                "sense_id": "10dfcf65-9055-33bc-8f68-3a397cd928cc",
                                "text": "Et l'autre orifice désabouché du tuyau on laisse ouvert, faut rien mettre ou avec la pression aucune poussière peut rentrer ?"
                            },
                            {
                                "example_id": "d480244b-b5c9-4ce2-b969-0acd6d67ff28",
                                "sense_id": "10dfcf65-9055-33bc-8f68-3a397cd928cc",
                                "text": "L'auteur écrit pour se désaboucher du trou commun familial, pour s'extirper du clapier à mépris où on l'oblige à végéter, avec pour seul allié, pour seul levier, un corps sexuel à refaire"
                            },
                            {
                                "example_id": "56e422fa-7545-494f-a118-135a335aa7db",
                                "sense_id": "10dfcf65-9055-33bc-8f68-3a397cd928cc",
                                "text": "Bouche à bouche... que veux-tu On ne pouvait se désaboucher"
                            },
                            {
                                "example_id": "944d45bb-f030-4e16-80c0-3348dae04775",
                                "sense_id": "10dfcf65-9055-33bc-8f68-3a397cd928cc",
                                "text": "La canule d'or se désabouche précautionneusement"
                            }
                        ]
                    }
                ],
