{
    "word_family": [
        "réduire",
        "réduction",
        "réductible",
        "irréductibilité",
        "réducteur"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                    "sense_definition": "Qu'on ne peut vaincre, soumettre ou faire fléchir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opiniâtre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants de cette région opposent une résistance <w>irréductible</w> face aux envahisseurs."
                        },
                        {
                            "text": "Il reste un adversaire <w>irréductible</w> de toute forme de compromis politique."
                        }
                    ],
                    "synonyms": [
                        "invincible"
                    ],
                    "common_phrases": [
                        "adversaire irréductible"
                    ]
                },
                {
                    "sense_id": "ab02b4c7-a304-386e-90ce-c6bfb2da610f",
                    "sense_definition": "Qui ne peut pas être simplifiée, en parlant d'une fraction ou d'une expression mathématique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathématiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande d'écrire le résultat sous la forme d'une fraction <w>irréductible</w>."
                        },
                        {
                            "text": "Cette fraction est déjà <w>irréductible</w> car le numérateur et le dénominateur sont premiers entre eux."
                        }
                    ],
                    "common_phrases": [
                        "fraction irréductible"
                    ]
                },
                {
                    "sense_id": "0ffa8916-9996-3ed3-aef9-bf8e4cb7b3b2",
                    "sense_definition": "Qu'on ne peut pas concilier, assimiler ou ramener l'un à l'autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inconciliable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une divergence <w>irréductible</w> sépare les deux philosophes sur la question de la liberté."
                        },
                        {
                            "text": "Ces deux visions du monde semblent totalement <w>irréductibles</w> l'une à l'autre."
                        }
                    ],
                    "common_phrases": [
                        "différence irréductible"
                    ]
                },
                {
                    "sense_id": "2b9a3eae-9857-3cdf-8bab-cc7447213faf",
                    "sense_definition": "Se dit d'une lésion, d'une fracture ou d'une hernie qui ne peut pas être remise en place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "médecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a dû opérer d'urgence en raison d'une hernie <w>irréductible</w>."
                        },
                        {
                            "text": "Cette luxation <w>irréductible</w> nécessite une intervention sous anesthésie générale."
                        }
                    ],
                    "common_phrases": [
                        "hernie irréductible"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "974db5c9-5d98-3623-915e-1d2e5d94dc26",
                    "sense_definition": "Personne qui refuse tout compromis, qu'on ne peut vaincre ou faire fléchir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opiniâtre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelques <w>irréductibles</w> continuent de manifester malgré les appels au calme."
                        },
                        {
                            "text": "Ce militant est un <w>irréductible</w> qui refuse de négocier avec la direction."
                        }
                    ],
                    "common_phrases": [
                        "noyau d'irréductibles"
                    ]
                }
            ]
        }
    ]
}