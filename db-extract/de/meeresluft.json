                "senses": [
                    {
                        "sense_id": "866fca5d-1ee7-309e-b3eb-d4ee62896edf",
                        "entry_id": "ad29edc8-b694-34ec-a524-b184cf25d8a7",
                        "glosses": [
                            "die Luft an/über dem Meer"
                        ],
                        "tags": [
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a7190b30-6abb-4baf-a570-3bef47f68c7d",
                                "sense_id": "866fca5d-1ee7-309e-b3eb-d4ee62896edf",
                                "text": "„Hier ist die frische Meeresluft mit dem Gestank von Abfällen vermischt.“"
                            },
                            {
                                "example_id": "8c0d5742-a852-4aeb-b899-ca9daa3de29b",
                                "sense_id": "866fca5d-1ee7-309e-b3eb-d4ee62896edf",
                                "text": "„Ein paar wenige Regentropfen fielen zur Erde, und die Meeresluft roch salzig.“"
                            },
                            {
                                "example_id": "646b5b44-0f60-4369-8ed1-a55b7f0e4d4a",
                                "sense_id": "866fca5d-1ee7-309e-b3eb-d4ee62896edf",
                                "text": "„Ari atmete die salzige Meeresluft ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
