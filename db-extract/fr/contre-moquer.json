                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ec0be6-78c7-4b28-8861-9ca5de66d4a2",
                                "sense_id": "edd31677-560d-311a-acdb-d92103502e82",
                                "text": "Comme je ne tiens guère à me justifier, – de quoi me justifierais-je ? – et comme je me contre-moque de ce qu’on peut penser de moi, je ne me plains pas."
                            },
                            {
                                "example_id": "00d9685a-744b-4bfa-bd56-473db960f588",
                                "sense_id": "edd31677-560d-311a-acdb-d92103502e82",
                                "text": "L’impérialiste se contre-moque de la façon dont la population pense ou sent."
                            },
                            {
                                "example_id": "b05581af-b7aa-4805-80e0-79f6e2fe3b1c",
                                "sense_id": "edd31677-560d-311a-acdb-d92103502e82",
                                "text": "L’exemple ?… On s’en moque, remoque, et contre-moque !"
