                                        "entry_id": "4134d77b-4ae7-38e7-be6f-9f685499df5f",
                                        "glosses": [
                                            "zestaw reguł określających budowę poprawnych wyrażeń w języku programowania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6f6e34-fa43-4420-a46e-6459b7d79665",
                                                "sense_id": "f314b03c-26b3-3082-a12d-836ba3002fef",
                                                "text": "Zawsze miałem kłopoty ze składnią języka C."
