        "ru-extract.jsonl": [
            {
                "entry_id": "8c90bbaf-5b1d-3c83-9850-6fb5765c251b",
                "word": "заранее",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "638cb093-807e-351a-91b9-842e00877057",
                        "entry_id": "8c90bbaf-5b1d-3c83-9850-6fb5765c251b",
                        "glosses": [
                            "за некоторое время до чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa9ab0f-f4fd-45a9-be9d-96189833f4fa",
                                "sense_id": "638cb093-807e-351a-91b9-842e00877057",
                                "text": "Его предупредили заранее."
                            },
                            {
                                "example_id": "aa17d8e9-9008-4b2c-80dc-d73fae750ffa",
                                "sense_id": "638cb093-807e-351a-91b9-842e00877057",
                                "text": "Он заранее приготовил документы."
                            },
                            {
                                "example_id": "cda10305-c32e-4c45-a2cf-21809337fde4",
                                "sense_id": "638cb093-807e-351a-91b9-842e00877057",
                                "text": "Заранее благодарю за содействие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e714fe05-9408-4dfb-8ac2-8ec0f5358b10",
                        "source_entry_id": "8c90bbaf-5b1d-3c83-9850-6fb5765c251b",
                        "source_sense_id": "638cb093-807e-351a-91b9-842e00877057",
                        "target_lang_word": "beforehand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beforehand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa36a73-50a7-3bca-bcb4-4cf37b9fa1d9",
                                        "entry_id": "4404d5fb-180a-34b0-b327-2708784e4502",
                                        "glosses": [
                                            "At an earlier or preceding time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44745a77-8c16-4598-9686-9789d6bfb673",
                                                "sense_id": "7aa36a73-50a7-3bca-bcb4-4cf37b9fa1d9",
                                                "text": "Will it be possible to have access to the room beforehand so that we can set up chairs?"
                                            },
                                            {
                                                "example_id": "88f2ae43-980a-457f-9b17-4e4008d674c5",
                                                "sense_id": "7aa36a73-50a7-3bca-bcb4-4cf37b9fa1d9",
                                                "text": "I love playing tennis but I always get so nervous beforehand."
                                            },
                                            {
                                                "example_id": "5071528e-6762-49c4-83a8-70969a27955a",
                                                "sense_id": "7aa36a73-50a7-3bca-bcb4-4cf37b9fa1d9",
                                                "text": "Weeks beforehand, I had bought the tickets for the concert."
                                            },
                                            {
                                                "example_id": "f6a3b90e-a79a-49d1-81a6-6068bd324b00",
                                                "sense_id": "7aa36a73-50a7-3bca-bcb4-4cf37b9fa1d9",
                                                "text": "Prosecutors also said Wednesday their side “does not intend to reference allegations that the defendant violated FARA or improperly coordinated with the Obama Administration,” referring to the Foreign Agents Registration Act, which requires people who lobby on behalf of foreign clients to register beforehand with the US government."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beforehand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24684daf-0002-3c26-83c1-7e985cfdc2bb",
                                        "entry_id": "90e31598-a92d-3f2f-9f26-53b3e06f69ec",
                                        "glosses": [
                                            "In comfortable circumstances as regards property; forehanded."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "771169bf-2aed-478b-a2bd-f90bc27a777e",
                                                "sense_id": "24684daf-0002-3c26-83c1-7e985cfdc2bb",
                                                "text": "rich and much beforehand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee65ba7-0d6e-3593-983a-4f770aee7395",
                                        "entry_id": "90e31598-a92d-3f2f-9f26-53b3e06f69ec",
                                        "glosses": [
                                            "In a state of anticipation or preoccupation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc6857c-9b33-4f56-9c5b-7af3fca39baf",
                                                "sense_id": "cee65ba7-0d6e-3593-983a-4f770aee7395",
                                                "text": "The last cited author has been beforehand with me."
                                            },
                                            {
                                                "example_id": "c853ea33-5c0e-4941-9b4f-72fe2175f208",
                                                "sense_id": "cee65ba7-0d6e-3593-983a-4f770aee7395",
                                                "text": "[…] the medical attendant ought to be rather beforehand with the symptoms of excitement, and to diminish the large quantity of wine before they appear."
                                            },
                                            {
                                                "example_id": "3f621f23-5aa6-4364-a219-b9d0675197f2",
                                                "sense_id": "cee65ba7-0d6e-3593-983a-4f770aee7395",
                                                "text": "Agricola […] resolves to be beforehand with the danger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d935804-57da-4ce5-8574-edae47a0f52c",
                        "source_entry_id": "8c90bbaf-5b1d-3c83-9850-6fb5765c251b",
                        "source_sense_id": "638cb093-807e-351a-91b9-842e00877057",
                        "target_lang_word": "in advance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in advance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                        "entry_id": "a92badd5-6026-377c-9ae6-3a5f4bf5226f",
                                        "glosses": [
                                            "Beforehand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2076563-a104-49bf-b107-7fd92b613595",
                                                "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                                "text": "The money was paid in advance."
                                            },
                                            {
                                                "example_id": "d547f1e6-06c5-4a77-9a8f-979811cb0c9c",
                                                "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                                "text": "To make matters worse, you did not publish the news note until 5 days before the conference — even though we had submitted it enough in advance to have been included in the previous weeks' paper.!"
                                            },
                                            {
                                                "example_id": "bd7f01be-367a-45d4-9acf-f31ecf790e63",
                                                "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                                "text": "The chap opposite seems to be trying to pull a fast one, and having seen the guard is trying to buy a ticket online... but doesn't succeed. The guard helpfully sells him one, but not quite at the price of one purchased in advance. In fairness he doesn't kick off, nor does the guard treat him like some common criminal. It's a fair cop - or should that be a fare cop?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28bfb96d-317d-4eb6-9207-f01d44d4ea69",
