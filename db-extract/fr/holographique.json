                            {
                                "example_id": "75d84e0f-68a9-4a9f-8abc-cba99211b98b",
                                "sense_id": "3d6d0e5b-815e-3e9e-8abc-4142a73d71b0",
                                "text": "Bluffant: ceux-ci apparaissent sous forme d’images holographiques, comme s’ils se trouvaient entre ses mains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82310dd5-bd03-4d11-bee2-d7a41f18d3c4",
                        "source_entry_id": "4994e0e5-99e5-3781-8360-982d7bf6874a",
