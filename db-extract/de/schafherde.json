                ],
                "senses": [
                    {
                        "sense_id": "7b6130e5-d4ad-3a8c-8abd-874eda4da07d",
                        "entry_id": "56531be8-c454-3596-ac4b-b35197411523",
                        "glosses": [
                            "eine Gruppe (Herde) von zusammenlebenden Schafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb68d46-494e-4168-898e-6f86eb7a30c5",
                                "sense_id": "7b6130e5-d4ad-3a8c-8abd-874eda4da07d",
                                "text": "„Schon mit zehn Jahren erkundete Succow als Hütejunge einer großen Schafherde jedes Detail der brandenburgischen Äcker, Wiesen und Feuchtgebiete.“"
                            },
                            {
                                "example_id": "8717abff-c2d3-4b4d-af02-9cb718e17587",
                                "sense_id": "7b6130e5-d4ad-3a8c-8abd-874eda4da07d",
                                "text": "„Vorbei an Korn- und Baumwollfeldern, schattenspendenden Bäumen und großen Schafherden ziehen sie in die Ortschaft Taghelel ein.“"
                            },
                            {
                                "example_id": "9f8279e2-7bc7-41a0-be2b-0e5fe8b85ecc",
                                "sense_id": "7b6130e5-d4ad-3a8c-8abd-874eda4da07d",
                                "text": "„In der Nähe des Stadtrandes, gibt es eine große Schafherde, und zwei schwarze Hunde, mager und endlos kreisend, die sie vorantreiben.“"
                            },
                            {
                                "example_id": "9f537d09-7d13-42db-afd1-cefd2bb9d77a",
                                "sense_id": "7b6130e5-d4ad-3a8c-8abd-874eda4da07d",
                                "text": "„Eine große Schafherde weidet dicht am Weg, vier Hirten mit langen Stöcken sind dabei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
