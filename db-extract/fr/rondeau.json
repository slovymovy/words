        "fr-extract.jsonl": [
            {
                "entry_id": "b011903d-ea14-3fa5-a175-554037bcfc37",
                "word": "Rondeau",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "519c8828-fb77-3a39-9f6a-d97b3b805398",
                        "entry_id": "b011903d-ea14-3fa5-a175-554037bcfc37",
                        "glosses": [
                            "Nom de famille québécois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a27300-393e-4428-a6d2-7341b6f6c062",
                                "sense_id": "519c8828-fb77-3a39-9f6a-d97b3b805398",
                                "text": "Louise Mailloux, l’auteure de la première plainte, remet en question la conduite de la juge en chef de la Cour du Québec, Lucie Rondeau."
                            },
                            {
                                "example_id": "05730118-feef-4e3a-9523-61c492c96806",
                                "sense_id": "519c8828-fb77-3a39-9f6a-d97b3b805398",
                                "text": "Mais Pierre Rondeau rappelle que l’instance a toujours un joker dans sa manche : « Le prochain Mondial, en 2026, [se jouera] à 48 nations. Donc, il y aura plus de matchs au total. Ça pourrait inciter le Fifa à demander que le prix ne baisse pas, malgré un boycott »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                "word": "rondeau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7ecf6cea-1e93-4980-8d74-acfdaf4fd3ff",
                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                        "tags": [
                            "plural"
                        ],
                        "form": "rondeaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f0ac130-a417-3792-9678-aaf1ecdb4887",
                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                        "glosses": [
                            "Petite pièce de poésie composée de treize vers sur deux rimes, avec une pause au cinquième et une au huitième, et dont le premier mot ou les premiers mots appelés clausule se répètent après le huitième vers et après le dernier, sans faire partie des vers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474b9822-267c-45b8-ac1b-24a91ee243bc",
                                "sense_id": "5f0ac130-a417-3792-9678-aaf1ecdb4887",
                                "text": "Vadius.– Peut-on voir rien d’égal aux sonnets que vous faites ?\nTrissotin.– Rien qui soit plus charmant que vos petits rondeaux ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "034c7e7e-b070-3095-bd20-aecdd9ed234e",
                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                        "glosses": [
                            "Forme musicale, vocale au départ, alternant un refrain et plusieurs couplets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b2e1afd-738f-4cb1-aba0-e5cafe17b50e",
                                "sense_id": "034c7e7e-b070-3095-bd20-aecdd9ed234e",
                                "text": "… et, après avoir bien tâtonné, je fus enfin dirigé, par les sons d’un joyeux rondeau, vers un appartement où le digne sacristain disait une messe au diable."
                            },
                            {
                                "example_id": "9365e849-3342-4e91-abe4-980ffad05865",
                                "sense_id": "034c7e7e-b070-3095-bd20-aecdd9ed234e",
                                "text": "Certains genres musicaux étaient même de préférence chantés et dansés par des jeunes femmes (carole, airs de danse tels que rondeau, ductia, estampie, maierolies)."
                            }
                        ]
                    },
                    {
                        "sense_id": "cab596ac-4165-3a68-8cfe-17ebf9c002b5",
                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                        "glosses": [
                            "Grosse marmite."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f7ad0f32-d73f-3780-ba75-23c7e83a203d",
                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                        "glosses": [
                            "Poisson marin du genre Archosargus (famille des sparidés)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
