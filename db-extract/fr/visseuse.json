                    {
                        "sense_id": "f6bf70b2-ce8b-372d-8ba9-93e8e2e63880",
                        "entry_id": "e3439c94-b9b2-3e47-af6d-011eed4e2c01",
                        "glosses": [
                            "Outil motorisé permettant de visser et dévisser tous types de vis et boulons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f63c61-4fc3-4a2b-b999-47e527cda4a8",
                                "sense_id": "f6bf70b2-ce8b-372d-8ba9-93e8e2e63880",
                                "text": "A puissance égale la visseuse électrique est moins bruyante que la visseuse pneumatique."
                            },
                            {
                                "example_id": "17897b16-6972-45ec-84a6-df07f555b611",
                                "sense_id": "f6bf70b2-ce8b-372d-8ba9-93e8e2e63880",
                                "text": "Ils sont en général parfaitement adaptés aux besoins d’un bricoleur moyen. Au-dessous, vous trouverez des perceuses-visseuses légères — qui sont en fait surtout des visseuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "f43118eb-ba55-362b-9a7c-88da180c381c",
                        "entry_id": "e3439c94-b9b2-3e47-af6d-011eed4e2c01",
