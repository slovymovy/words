        "fr-extract.jsonl": [
            {
                "entry_id": "7e135617-413c-359a-b1f1-775c3c249e44",
                "word": "exténuation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2fb4c469-5a25-426c-b0de-6ac9a5f49147",
                        "entry_id": "7e135617-413c-359a-b1f1-775c3c249e44",
                        "tags": [
                            "plural"
                        ],
                        "form": "exténuations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "693334e7-9c4a-3710-b0fd-e8b08c7f531f",
                        "entry_id": "7e135617-413c-359a-b1f1-775c3c249e44",
                        "glosses": [
                            "Action d’exténuer ou résultat de cette action. Affaiblissement des forces physiques."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "097ca173-f318-41c2-abe5-48d33a3e119a",
                                "sense_id": "693334e7-9c4a-3710-b0fd-e8b08c7f531f",
                                "text": "Il est dans un état de grande exténuation."
                            },
                            {
                                "example_id": "c96071ef-64ed-4e44-bbc6-c2747f50f6cd",
                                "sense_id": "693334e7-9c4a-3710-b0fd-e8b08c7f531f",
                                "text": "Ce que je ressens depuis plus de six mois du dépeçage médiatique, systématique, minutieux, professionnel, de ma personne est de même nature. Je pense faire preuve de la même disponibilité, et l’exténuation tient moins au vampirisme des autres qui me viderait de ma substance qu’au contraire à l’effort de me reconstruire chaque fois, avec honnêteté, sous leurs yeux."
                            },
                            {
                                "example_id": "828a72fc-8228-4665-843c-445d0f9dcd70",
                                "sense_id": "693334e7-9c4a-3710-b0fd-e8b08c7f531f",
                                "text": "Nous avons là, soit dans l’immobilité taciturne, soit dans l’excitation et la confiance absolues,quelque chose comme l’exténuation du présent."
                            }
                        ]
                    },
                    {
                        "sense_id": "0da81660-50e2-3ede-a2ef-ea2705ddd1b5",
                        "entry_id": "7e135617-413c-359a-b1f1-775c3c249e44",
                        "glosses": [
                            "Tapinose."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "087f6b58-ab4b-4717-8798-cd4406fa1f17",
                                "sense_id": "0da81660-50e2-3ede-a2ef-ea2705ddd1b5",
                                "text": "D'ailleurs ajoute t'il, le français n'est pas inapte à ce jeu puisqu'il dispose à cet effet de trois mots : exténuation, tapinose et litote, « figures de style qui consistent justement à substituer à la véritable pensée une autre, voisine, mais plus retenue »."
                            },
                            {
                                "example_id": "cb2e064c-0cca-4dd2-a396-479cdd707474",
                                "sense_id": "0da81660-50e2-3ede-a2ef-ea2705ddd1b5",
                                "text": "Il y à bien des façons d’escamoter le mystère : on peut soit intervertir purement et simplement l’ordre d’importance de l’essence et de l’accident, soit faire de l’inconnaissable une simple exténuation quantitative du connaissable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "108c0cb8-05dc-44dc-9618-ad93c3368525",
                        "source_entry_id": "7e135617-413c-359a-b1f1-775c3c249e44",
                        "target_lang_word": "extenuation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extenuation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "The action or process of making or becoming thin; an instance of this; a shrunken condition; leanness, emaciation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1893d586-0ac4-495b-a27e-8e2cf0ae7b93",
                                                "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                                "text": "This mightily helpeth the extenuation of members."
                                            },
                                            {
                                                "example_id": "9fe30088-8fdb-48cd-8345-d7b21bf78a2f",
                                                "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                                "text": "A yong man…had an extenuation for want of nourishment in his Limbs."
                                            },
                                            {
                                                "example_id": "9eec6322-c6fe-467c-a113-b6612354a405",
                                                "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                                "text": "Galen commends tepid Baths for…curing all Extenuations."
                                            },
                                            {
                                                "example_id": "571b05cd-48bc-4d04-9be8-8faad4c5bc89",
                                                "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                                "text": "The extenuation is her only bad symptom."
                                            },
                                            {
                                                "example_id": "cec2f54f-d582-41ee-b792-3f84aed04594",
                                                "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                                "text": "The female…exhibited…some symptoms of extenuation."
                                            },
                                            {
                                                "example_id": "4c9c7af1-85cd-4359-a056-42a67a40b5ed",
                                                "sense_id": "13ed1ca1-dcbf-3a0d-94ce-5efffd33f10a",
                                                "text": "Some pallid from extenuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe1c97ae-ac2e-3523-ae7a-9f3a54a582b9",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "Making less dense; rarefaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ffd4cb-4de5-4f28-8e59-52284b6c6aff",
                                                "sense_id": "fe1c97ae-ac2e-3523-ae7a-9f3a54a582b9",
                                                "text": "Winds proceed from extenuation of the Air, by the Sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808a969a-c41b-33d1-bd77-02cc3c29c710",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "The action or process of making slender or diminishing in bulk; an instance of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386c6c64-83a6-42bf-97a1-7e16176f94fb",
                                                "sense_id": "808a969a-c41b-33d1-bd77-02cc3c29c710",
                                                "text": "All Dilatation is some degree of Extenuation."
                                            },
                                            {
                                                "example_id": "96d0b69d-971f-44a5-8d03-6e92352b893c",
                                                "sense_id": "808a969a-c41b-33d1-bd77-02cc3c29c710",
                                                "text": "The Sea is the same at all seasons; what it gets by Rivers and showers, losing by exhalations and extenuations through the excessive heats…within the Torrid Zone."
                                            },
                                            {
                                                "example_id": "d6828601-fc8e-4fa8-8650-1f951bd65c26",
                                                "sense_id": "808a969a-c41b-33d1-bd77-02cc3c29c710",
                                                "text": "Gregory the Great…says that God penetrates everything without extenuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f2181a-fc12-337c-b43e-d2213b4bec93",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "The action of making less or weak; and instance of this; a weakening, impoverishment. Also, mitigation (of blame or punishment)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f2ac1b7-67db-40a8-8520-98ea105e3df6",
                                                "sense_id": "f0f2181a-fc12-337c-b43e-d2213b4bec93",
                                                "text": "What Deeds of Charity we have to alledge in Extenuation of our Punishment."
                                            },
                                            {
                                                "example_id": "9792e994-784e-4a64-b1c5-e69e711f9ddb",
                                                "sense_id": "f0f2181a-fc12-337c-b43e-d2213b4bec93",
                                                "text": "The saide citie is much decaid…not a little to the extenuacion of that part of this realme."
                                            },
                                            {
                                                "example_id": "7c173112-c0f3-40ed-b017-3e7395d1096c",
                                                "sense_id": "f0f2181a-fc12-337c-b43e-d2213b4bec93",
                                                "text": "Such extenuation let me begge, As in reproofe of many Tales deuis’d…I may…Finde pardon on my true submission."
                                            },
                                            {
                                                "example_id": "bc2a8167-b4eb-4ea2-87f2-bc028ec8eee8",
                                                "sense_id": "f0f2181a-fc12-337c-b43e-d2213b4bec93",
                                                "text": "The gallantry of Henry’s heroique spirit tended somewhat to the…extenuation of Charles his glory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ef039d-c38a-3057-87e8-344fc0cecc91",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "The action of representing (something) as slight and trifling; underrating; an instance of this, a plea to this end; a modification in terms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19dcc3a3-7347-4142-8db7-09a8c9d647cf",
                                                "sense_id": "c2ef039d-c38a-3057-87e8-344fc0cecc91",
                                                "text": "Sometimes…wee humble ourselves lower than there is cause…And no lesse well doth God take these submisse extenuations of our selves."
                                            },
                                            {
                                                "example_id": "c9517954-ac74-4161-97b7-2b0bcd626607",
                                                "sense_id": "c2ef039d-c38a-3057-87e8-344fc0cecc91",
                                                "text": "Through their…extenuation [of their grievance], wretchedness and peevishness they undo themselves."
                                            },
                                            {
                                                "example_id": "3a1ca67f-1cef-4175-b627-d4bda7a8af10",
                                                "sense_id": "c2ef039d-c38a-3057-87e8-344fc0cecc91",
                                                "text": "Many died of it every day, so that now all our extenuations abated."
                                            },
                                            {
                                                "example_id": "7f66124f-8487-45ba-9059-29754c2bab5a",
                                                "sense_id": "c2ef039d-c38a-3057-87e8-344fc0cecc91",
                                                "text": "The utmost they allow is an extenuation of its absolute necessity."
                                            },
                                            {
                                                "example_id": "e090e87e-98a4-4cc2-bbaa-75012f711883",
                                                "sense_id": "c2ef039d-c38a-3057-87e8-344fc0cecc91",
                                                "text": "The simple matter-of-fact style of the narrative is, from its unobtrusive character, more adapted for spiritual reading than the views and generalisations, and prologetic extenuations of more recent biographers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b52fec6-912f-3961-a93c-87ee7c28f878",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "The action of representing (something) as slight and trifling; underrating; an instance of this, a plea to this end; a modification in terms.",
                                            "A figure in which a term is used which, in contrast with the more fitting term it supplants, understates or seeks to diminish the significance of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5adacf-8cf4-4d62-8bd3-c62a69c8ca19",
                                                "sense_id": "0b52fec6-912f-3961-a93c-87ee7c28f878",
                                                "text": "We call him the Disabler or figure of Extenuation."
                                            },
                                            {
                                                "example_id": "550d79de-4ce0-45c8-88d9-6c0c9101b435",
                                                "sense_id": "0b52fec6-912f-3961-a93c-87ee7c28f878",
                                                "text": "When for extenuation sake we use a lighter and more easie word or terme then the matter requires."
                                            },
                                            {
                                                "example_id": "2bd75060-6851-4ef5-93ea-9abf1edb84d8",
                                                "sense_id": "0b52fec6-912f-3961-a93c-87ee7c28f878",
                                                "text": "1823, in Crabb, Technol. Dict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "The action of lessening, or seeking to lessen, the guilt of (an offence or fault) by alleging partial excuses; and instance or means of doing this; a plea in mitigation of censure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cadbbf44-c9d7-43c0-80ad-175271e78bf5",
                                                "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                                "text": "Extenuation, by which the Crime, that seemed great, is made lesse."
                                            },
                                            {
                                                "example_id": "ff5d6e75-f20f-4861-867b-3f62fa0bbd19",
                                                "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                                "text": "He…was to find excuses and extenuations for sins."
                                            },
                                            {
                                                "example_id": "2870027d-cf2c-478c-8b01-3de715e90805",
                                                "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                                "text": "Whatever may be said for the Extenuation of such Defects."
                                            },
                                            {
                                                "example_id": "ad0d54d6-35c0-4ef0-b37e-261cb90a4a52",
                                                "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                                "text": "It may be urged, in extenuation of this crime…that [etc.]."
                                            },
                                            {
                                                "example_id": "7e1cdc54-1df7-477b-b360-c9b1d028da0e",
                                                "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                                "text": "The differences of castes…furnish a copious stock of extenuations…to different classes of offences."
                                            },
                                            {
                                                "example_id": "2727e853-8e46-41bd-ba08-6b90ef946036",
                                                "sense_id": "df8174b5-c10f-3eef-adbd-7c79cd1397ff",
                                                "text": "In extenuation of a noble error."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641acbc3-fa61-32b5-8c5d-403d740e9aa8",
                                        "entry_id": "3b4ddc2d-5a76-3c98-b288-d6e7c67cc42f",
                                        "glosses": [
                                            "The action of extenuating; extenuated condition.",
                                            "Thin garments."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "humorous",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3eb505c-9c58-48aa-9ddc-d46f2ea9d44c",
                                                "sense_id": "641acbc3-fa61-32b5-8c5d-403d740e9aa8",
                                                "text": "They were clad in silken extenuations from the throat to the feet."
                                            },
                                            {
                                                "example_id": "72d21167-42b8-4441-8d0b-e9af244a982e",
                                                "sense_id": "641acbc3-fa61-32b5-8c5d-403d740e9aa8",
                                                "text": "One side wore…extenuations of a…green colour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ac6a9a5-5b23-4423-a396-e956040b15a6",
