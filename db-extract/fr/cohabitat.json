                                "target_senses": [
                                    {
                                        "sense_id": "6864255b-1ce9-3fc1-be9b-752c60e691d6",
                                        "entry_id": "4d6ffdbb-a1d5-3c92-8a4a-0f777ae800a8",
                                        "glosses": [
                                            "Housing in which the residents' private space is supplemented by communal facilities such as a shared kitchen and/or dining room."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca1e5258-b95c-41b5-bca4-65f7db521e43",
                                                "sense_id": "6864255b-1ce9-3fc1-be9b-752c60e691d6",
                                                "text": "There are close to 200 of these cohousing communities across the country – according to The Cohousing Association – designed to facilitate community through shared resources and common spaces. Members admit there are many tradeoffs to living in such close proximity to their neighbors including navigating a shared chore list and mutual financial arrangement. But many also say that they've found a way to conquer the loneliness and isolation that plagues so many Americans — especially today's parents."
                                            }
                                        ]
