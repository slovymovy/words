                    {
                        "form_id": "26af51dc-2fc4-40e0-9848-578cbd7689c0",
                        "entry_id": "20da30ac-7eea-3627-ba03-79eed52417a1",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Geothermie"
                    },
                    {
                        "form_id": "6a180b59-dda0-4650-b412-9fe9e3a03508",
                        "entry_id": "20da30ac-7eea-3627-ba03-79eed52417a1",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Geothermie"
                    },
                    {
                        "form_id": "b666abc7-5b35-4140-9790-9f6bf3343424",
                        "entry_id": "20da30ac-7eea-3627-ba03-79eed52417a1",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Geothermie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                        "entry_id": "20da30ac-7eea-3627-ba03-79eed52417a1",
                        "glosses": [
                            "Nutzung der im oberen (zugänglichen) Teil der Erdkruste gespeicherten Wärme"
                        ],
                        "tags": [
                            "Geowissenschaft",
                            "Umwelttechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "992f7c34-7668-4d47-8c62-340e13c3d66e",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "Geothermie kann als Energiequelle zur Erzeugung von Wärme und Strom genutzt werden."
                            },
                            {
                                "example_id": "d3f23763-a657-4f58-b349-d6eaf3417461",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Um klimaneutral zu werden, benötigt Deutschland emissionsfreie Heizmethoden. Eine Möglichkeit ist die Geothermie, das Nutzen der Erdwärme.“"
                            },
                            {
                                "example_id": "102326cd-324a-4074-8c0d-6abf89fc07ac",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "[Das Potenzial ist] „erstaunlich hoch: Laut der Studie könnte die Geothermie ein Viertel des deutschen Wärmebedarfs decken.“"
                            },
                            {
                                "example_id": "ac392302-29d9-45f6-97af-d20e516ff164",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Wie lange ist Heizen mit Gas noch möglich? Die Preise sind bereits stark gestiegen. Es ist Zeit für andere Wärmequellen – zum Beispiel Geothermie.“"
                            },
                            {
                                "example_id": "8d069477-dcda-44d7-a56a-868ec64240a2",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Allein die hydrothermale Geothermie könnte demnach - \"konservativ geschätzt\" - rund 25 Prozent des deutschen Wärmebedarfs von rund 1400 TWh pro Jahr decken“ […]."
                            },
                            {
                                "example_id": "cddd696d-5e2e-4ebc-b08b-7edcfbef6065",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Die oberflächennahe Geothermie ist eine andere Art der Nutzung von Umgebungstemperatur, die vor allem zum Beheizen, aber auch zum Kühlen kleinerer Gebäude sinnvoll sein kann.“"
                            },
                            {
                                "example_id": "2afd3521-04b1-4d7b-8a74-92f42078b27c",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "Oberflächennahe Geothermie reicht meist ein paar Meter bis zu 100 Meter, maximal 250 Meter, tief."
                            },
                            {
                                "example_id": "d92ccad0-97b2-4915-b151-b49983b48abb",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Was die Wirtschaftlichkeit der Geothermie betrifft, stimmen die Erfahrungen mit den bisherigen Anlagen recht optimistisch: Hier liegen die Erzeugungskosten bei 2,5-3 Cent/kWh, also in der Größenordnung der fossilen Energien.“"
                            },
                            {
                                "example_id": "29a2dfdb-0f26-437d-927a-6a1737ebfcd9",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Doch da die Geothermie nun so zügig ausgebaut werden soll, stehen allein in den kommenden zehn Jahren hohe Investitionen an, geschätzte 50 bis 60 Milliarden Euro.“"
                            },
                            {
                                "example_id": "ee94d6dd-91ca-4036-956b-e005b290863a",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Billiger wäre es Geothermie dort einzusetzen, wo man sowieso in die Erde gräbt – wie beim Bau eines Stadtbahn- oder Autotunnels.“"
                            },
                            {
                                "example_id": "590df1f1-ee11-452f-ad78-a2efc58e4daa",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Eine parallel zur Geothermie installierte Abwärme-Anlage, die sich aus der Betriebszentrale des Tunnels speisen wird, könnte weitere 70 Kilowatt liefern.“"
                            },
                            {
                                "example_id": "370f2b28-f96f-4b49-880a-1a1518fd6ed1",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Doch auch angesichts zumindest bislang vergleichsweise hoher Startkosten ist Moeck von den Vorteilen der Geothermie überzeugt: »Es ist immer noch effizienter und für das Klima deutlich schonender als mit fossilen Brennstoffen zu heizen«.“"
                            },
                            {
                                "example_id": "08d76322-5ece-45cd-99ac-0bd7c8934574",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„In ihrer Roadmap betonen die Autoren aber die wirtschaftliche Seite: »Die Geothermie war schon vor dem Anstieg der Gaspreise wettbewerbsfähig - auch im Vergleich mit fossilen Energieträgern«, betont Bracke.“"
                            },
                            {
                                "example_id": "fc9780ff-a416-4e87-89b2-1001f3a795e7",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Ungarn bezieht Gas und Atomtechnik aus Russland. Dabei hat das Land beste Voraussetzungen für Geothermie.“"
                            },
                            {
                                "example_id": "91ab27de-eefe-4ea8-9ea5-e0053ed4ec0c",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "„Allerdings birgt die Geothermie auch einige Risiken und Nebenwirkungen.“"
                            },
                            {
                                "example_id": "3294aa13-59f9-48f3-b763-1b095359b158",
                                "sense_id": "36742466-bd3d-3650-a6b0-7aa0417005e4",
                                "text": "[Island:] „Mit Geothermie und Wasserkraft erzeugen die staatliche Landsvirkjun und andere Energieunternehmen nahezu 100 Prozent des Stroms der Insel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09de4990-d0ec-4235-a115-7e2a440ffd92",
