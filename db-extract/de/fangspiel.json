                "senses": [
                    {
                        "sense_id": "c6d31845-bc66-362f-85fa-a92c76971fb3",
                        "entry_id": "92d1d4eb-d5d4-31d3-934a-8cdc3feb9928",
                        "glosses": [
                            "Ballspiel, bei dem ein geworfener Gegenstand bzw. Laufspiel, bei dem ein fliehender Spielpartner gefasst und gehalten werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a593f0-bf3b-4818-9f5a-924e97454f2d",
                                "sense_id": "c6d31845-bc66-362f-85fa-a92c76971fb3",
                                "text": "„Als aktive Mitspieler könnten Spielpädagogen auch dafür sorgen, dass traditionelle Bewertungsmuster wie beim Spiel Erde und Paradies oder das Ausscheiden aus dem Spiel wie bei den meisten Lauf- und Fangspielen abgeändert werden zugunsten einer relativ schnellen Beendigung von Spieldurchgängen und eines Wechsels der Rollen- und Spielgruppen.“"
                            },
                            {
                                "example_id": "0842fc6e-20dd-490d-bd3f-ff1b5126999c",
                                "sense_id": "c6d31845-bc66-362f-85fa-a92c76971fb3",
                                "text": "„Diese können z.B. beim Schlafengehen zu ganzen Spielsequenzen mit Versteck- und Fangspielen sowie Vorlesegeschichten in immer gleichen Abläufen ausgebaut werden.“"
                            },
                            {
                                "example_id": "eebc2ef4-2139-4a2a-b11f-4cfbbdbd3ca0",
                                "sense_id": "c6d31845-bc66-362f-85fa-a92c76971fb3",
                                "text": "„Das Fangspiel kann mit Ball durchgeführt werden und dadurch erschwert werden.“"
                            },
                            {
                                "example_id": "01d59fe8-f769-4abd-92f4-da192ab408c7",
                                "sense_id": "c6d31845-bc66-362f-85fa-a92c76971fb3",
                                "text": "„Der Bewegungstrieb verlangt nach Bewegungs- und Sportspielen: er beflügelt körperbezogene Aktivitäten und Interaktionsformen wie Fangspiele, Hüpfspiele, Laufspiele, Staffelspiele oder Ballspiele.“"
                            },
                            {
                                "example_id": "d298be28-3955-4654-bf7b-d64835b1c247",
                                "sense_id": "c6d31845-bc66-362f-85fa-a92c76971fb3",
                                "text": "„Wenn Delilah und Henry nicht die anderen Gäste mit ihren geräuschintensiven Fangspielen terrorisieren würden, könnte man sich im 19. Jahrhundert wähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
