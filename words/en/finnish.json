                            }
                        },
                        {
                            "text": "She is very interested in <w>Finnish</w> culture and history.",
                            "target_lang_translations": {
                                "ru": "Она очень интересуется <w>финской</w> культурой и историей.",
                                "zh": "她对<w>芬兰</w>的文化和历史非常感兴趣。"
                            }
