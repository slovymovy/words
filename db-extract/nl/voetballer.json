                    {
                        "translation_id": "975d7ec8-0dd1-4344-adde-8cb5a27d1e0d",
                        "source_entry_id": "7119a791-13ac-32be-8296-fc80b6587999",
                        "source_sense_id": "c780bbb6-6452-3f66-82cd-b2da7ecd1626",
