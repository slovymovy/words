                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fd8ddb92-d844-46f5-a027-da7bea524162",
                                "sense_id": "880d9faf-b7a1-3f7a-ab31-df78434394ed",
                                "text": "Dewey shrinks back, thinking, This guy's about to come across this desk, beat the everliving shit out of me."
                            },
                            {
                                "example_id": "d01eb1fa-8230-409c-b331-484796c581be",
                                "sense_id": "880d9faf-b7a1-3f7a-ab31-df78434394ed",
                                "text": "What the holy everliving fuck was he talking about?"
                            },
                            {
                                "example_id": "14e0dc6a-68c0-45ad-887a-8e90db996dbe",
                                "sense_id": "880d9faf-b7a1-3f7a-ab31-df78434394ed",
                                "text": "Fight it—fight it with all my might—and I was getting the everliving hell beaten out of me!"
                            }
                        ]
                    }
