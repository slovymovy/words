                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba75ba77-3e92-48b1-8542-db551a168123",
                                "sense_id": "dd37482e-7625-3aae-80f3-560933c82c56",
                                "text": "„Die österreichische Biathletin Lisa Theresa Hauser wird mit dem Fair-Play-Preis des Deutschen Sports 2017 ausgezeichnet.“"
                            },
                            {
                                "example_id": "23d3fdbc-a58d-4e10-834f-2563e95bf00a",
                                "sense_id": "dd37482e-7625-3aae-80f3-560933c82c56",
                                "text": "„Ohne die erkrankte Magdalena Neuner haben die deutschen Biathletinnen den Weltcup-Auftakt im schwedischen Östersund verpatzt.“"
                            }
                        ],
