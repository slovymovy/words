                                            {
                                                "example_id": "1100088e-4877-4c0a-9586-f692a5906e81",
                                                "sense_id": "7a3a4cd0-a7c3-3a64-87e9-daa249040c31",
                                                "text": "In communities with megatheropods, Ms. Schroeder and colleagues found what they call a “carnivore gap”: a large swath of medium-size niches that were empty. For instance, the Hell Creek Formation, a well-studied fossil area that stretches from modern day Utah to Alberta, was once home to 630-pound grown-up dromaeosaurs, 7-ton adult T. rexes — and no mature meat-eaters in between."
                                            }
                                        ]
                                    }
