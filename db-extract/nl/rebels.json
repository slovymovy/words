                        ]
                    },
                    {
                        "translation_id": "bb638c46-0210-4338-a5b6-51c67ae5d4ac",
                        "source_entry_id": "e6a4d41c-75cf-32e8-9cfb-96f3f72cfe33",
                        "source_sense_id": "0c1340a2-d530-310c-8e05-35377e9d91fb",
                        "source_sense_description": "opstandig, balorig, geneigd tot verzet",
                        "target_lang_word": "rebellisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebellisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                        "entry_id": "2475b530-b106-3d1a-928b-cb666232611a",
                                        "glosses": [
                                            "einen Aufstand (gegen einen Machthaber/eine Regierung) beginnend/anzettelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab4e4389-57c5-451c-855d-254e155ea42c",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "„Myanmars Putschisten sind mit neu entfachtem Kampfeswillen rebellischer Minderheiten konfrontiert.“"
                                            },
                                            {
                                                "example_id": "e2f6cec7-75eb-4883-880f-9a0306a7700f",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "[Côte d'Ivoire:] „Blockhauss, auch Blockoso genannt, galt schon vorher als rebellisches Viertel.“"
                                            },
                                            {
                                                "example_id": "e1c47a3c-b2fd-44a5-a49d-8797d8cefd33",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "[Tigray:] „Nach monatelangen Spannungen mit der rebellischen Region will Äthiopiens Regierungschef nun ein Ende in seinem Sinne herbeizwingen.“"
                                            },
                                            {
                                                "example_id": "afb4edde-c4cc-439d-b456-bf21d48f4aac",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "[DDR 1989:] „Die Nachrichten überschlugen sich. Vopos hielten von ihren Autos aus Ansprachen an das rebellische Volk. Man bat um Mäßigung“ […]."
                                            },
                                            {
                                                "example_id": "022167af-3da2-4ab8-aad8-2a5a8f33209a",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "[Ludwig XIV.:] „Daher entschloss er sich, den potentiell rebellischen französischen Adel nicht mehr aus den Augen zu lassen.“ […]."
                                            },
                                            {
                                                "example_id": "2931d4f6-4348-43a0-8b7c-5cc0efcf3c71",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "[Die russische Armee stand] „vorsorglich mit Truppen im rebellischen Polen,“ […]."
                                            },
                                            {
                                                "example_id": "bf3cd915-4f90-4419-a668-4662f8b3a3fe",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "„Herodes war entsetzt über das Wüten der mit ihm verbündeten Soldateska. Je schlimmer die Exzesse, desto schwieriger würde es für ihn werden, die rebellische Provinz Judäa zu regieren.“"
                                            },
                                            {
                                                "example_id": "20648adf-0963-4f2e-86c6-462b2d6ddd13",
                                                "sense_id": "e39c0467-477c-3cc7-8863-d2b288dcb7ae",
                                                "text": "„Nach dem Putsch vor knapp acht Wochen und der brutalen Unterdrückung der anhaltenden Straßenproteste ist das Territorium der rebellischen Volksgruppe zum Auffangbecken für flüchtige Gegner des Militärregimes geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                        "entry_id": "2475b530-b106-3d1a-928b-cb666232611a",
                                        "glosses": [
                                            "offen gegen etwas Widerstand leistend, sich offen gegen jemanden/etwas auflehnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3fc7b73-afc0-40ac-b943-7b54dcb1a266",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "Pipi Langstrumpf ist Astrids Lindgrens Schöpfung einer rebellischen, jungen Göre."
                                            },
                                            {
                                                "example_id": "f311984c-a7b9-42bb-9a3f-d6d69b8b616b",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "[Viele Eltern sind verzweifelt,] „wenn es darum geht mit dem rebellischen Nachwuchs im Teenageralter klarzukommen.“"
                                            },
                                            {
                                                "example_id": "6f93e91d-e6bc-43ac-91dd-ff10dfb75ccc",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„Aber statt die Misshandlung hinzunehmen, verlässt die rebellische Frau ihr Elternhaus, um ihr eigenes Leben zu leben.“"
                                            },
                                            {
                                                "example_id": "5304f7e3-5674-4ad8-ad01-506d6c072b33",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "[Jean-Paul Belmondo] „verkörperte für die jungen Franzosen den Revoluzzer und Freigeist, den rebellischen Außenseiter, der so gut wie keine Regeln akzeptiert.“"
                                            },
                                            {
                                                "example_id": "eb9306e5-59e6-41f5-ad29-ed52278b5a4d",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "[Der amerikanische Schauspieler James Dean in \"...denn sie wissen nicht, was sie tun\" (1955):] „Mit dieser Rolle wird er zur Heldenfigur der rebellischen Jugend der 1950er Jahre - nicht nur in den USA.“"
                                            },
                                            {
                                                "example_id": "df85eb25-4f40-43ed-b351-6bc44fb1e126",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "[Mikis Theodorakis:] „Der rebellische Grieche jedoch reiste um die ganze Welt und gab über 1000 Konzerte, in denen er Diktaturen jeglicher Couleur anprangerte und für den Widerstand gegen die Militärdiktatur in seiner Heimat warb.“"
                                            },
                                            {
                                                "example_id": "e422ff68-4497-426b-9943-94ba5bd26ea0",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„Die drei rebellischen Töchter (von den fünfen) des ehrenwerten Lord David aber fielen aus allen Mustern der Familie heraus“ […]."
                                            },
                                            {
                                                "example_id": "2468d5d9-2e99-48fa-ae07-f55f20504afc",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "[1980er Jahre:] „Einerseits gab es die Hausfrau, die die Familie zusammenhielt und den Haushalt regelte, andererseits die rebellische Frau, die für mehr Macht und Mitsprache plädierte“."
                                            },
                                            {
                                                "example_id": "7a4bd2b7-e11d-49a9-918b-d4a9c63ef38b",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„Beim Parteitag muss die grüne Parteispitze aufpassen, dass die immer mal wieder rebellische Basis ihr nicht unerfüllbare Ziele beim Klimaschutz ins Programm schreibt.“"
                                            },
                                            {
                                                "example_id": "7f14b0b9-f25d-4d93-b135-67c1be892116",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„In seiner Jugend fiel Cassel durch sein rebellisches Verhalten auf und wurde von einem Internat ins andere verwiesen,“ […]."
                                            },
                                            {
                                                "example_id": "76fa34fb-acd6-4ac9-9c9d-19b3d2a7c6b6",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„Man muss ein rebellischer Geist sein, der sich nicht anpasst, manchmal aber nicht drum herumkommt.“"
                                            },
                                            {
                                                "example_id": "8970eccb-746f-4e22-ac84-23da49ae326f",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„Charakteristisch für den Punk sind provozierendes Aussehen, eine rebellische Haltung und nonkonformistisches Verhalten.“"
                                            },
                                            {
                                                "example_id": "6f8ef1ab-3d1c-4d62-942f-064c2d10f345",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„In den 1980er Jahren galt Prince als rebellischer Pionier, der sich nicht scheute, unterschiedliche Musikstile gepaart mit teilweise sehr anzüglichen Texten miteinander zu verknüpfen.“"
                                            },
                                            {
                                                "example_id": "68cdcc59-0a14-4eb3-8fe0-10562e38ab18",
                                                "sense_id": "0626ff4b-11e8-3578-9a01-1ea01da0d403",
                                                "text": "„Für die typische Verwandlung vom rebellischen Juso zum SPD-Establishment brauchten Gerhard Schröder und Andrea Nahles Jahre.“"
                                            },
                                            {
                                                "example_id": "8c02a320-8580-423d-8167-e899d8287b91",
