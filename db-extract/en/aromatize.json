                                        "sense_id": "e0beb684-ff98-3988-982e-03a1d8bfeebc",
                                        "entry_id": "c64f8875-7f65-36c7-9b72-7925a2c2cbdc",
                                        "glosses": [
                                            "gebruiken van kruiden en specerijen om een product op smaak te brengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79d7db9-f810-482a-8375-a6b5e9df11a1",
                                                "sense_id": "e0beb684-ff98-3988-982e-03a1d8bfeebc",
                                                "text": "Als je uit alle aardbeien op de wereld de smaak zou extraheren, zou je nog niet genoeg smaak hebben om de aardbeienkauwgom voor de staat New York te aromatiseren. Dus moet je een natuurlijk aardbei-aroma gebruiken om de smaak te versterken, want een van de hoofdcomponenten van aardbei kun je ook uit iets anders halen.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
