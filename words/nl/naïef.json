{
    "word_family": [
        "naïviteit",
        "naïeveling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea6e5109-e36e-3ce2-80ea-9a17e141ebcc",
                    "sense_definition": "onvoldoende bewust van de mogelijke gevolgen van eigen handelen of de complexiteit van een situatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>naïeve</w> opmerking over de politieke situatie zorgde voor grote hilariteit bij de experts.",
                            "target_lang_translations": {
                                "en": "His <w>naive</w> remark about the political situation caused great hilarity among the experts."
                            }
                        },
                        {
                            "text": "Het is een <w>naïef</w> idee om te denken dat dit probleem zonder geld opgelost kan worden.",
                            "target_lang_translations": {
                                "en": "It is a <w>naive</w> idea to think that this problem can be solved without money."
                            }
                        }
                    ],
                    "synonyms": [
                        "onnozel",
                        "goedgelovig",
                        "argeloos"
                    ],
                    "antonyms": [
                        "achterdochtig",
                        "wereldwijs",
                        "geslepen"
                    ],
                    "common_phrases": [
                        "naïef idee",
                        "naïeve opmerking",
                        "behoorlijk naïef"
                    ],
                    "target_lang_definitions": {
                        "en": "insufficiently aware of the possible consequences of one's own actions or the complexity of a situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naive",
                                "target_lang_sense_clarification": "lacking wisdom or judgement"
                            },
                            {
                                "target_lang_word": "gullible",
                                "target_lang_sense_clarification": "easily persuaded to believe something"
                            },
                            {
                                "target_lang_word": "simplistic",
                                "target_lang_sense_clarification": "treating complex issues as if they were very simple"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7445d6c0-5008-3a7a-802e-234972c738e0",
                    "sense_definition": "getuigend van een kinderlijke onschuld of een gebrek aan levenservaring",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>naïeve</w> politicus vertrouwde de boer op zijn woord zonder enig bewijs te vragen.",
                            "target_lang_translations": {
                                "en": "The <w>naive</w> politician took the farmer at his word without asking for any proof."
                            }
                        },
                        {
                            "text": "Ik was in die tijd weer blij en <w>naïef</w> als een jonge pup.",
                            "target_lang_translations": {
                                "en": "At that time I was happy and <w>naive</w> again, like a young pup."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbevangen",
                        "kinderlijk",
                        "onschuldig"
                    ],
                    "antonyms": [
                        "ervaren",
                        "volwassen"
                    ],
                    "common_phrases": [
                        "naïef vertrouwen",
                        "naïef als een kind"
                    ],
                    "target_lang_definitions": {
                        "en": "showing a childlike innocence or a lack of life experience"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naive",
                                "target_lang_sense_clarification": "lacking worldly experience"
                            },
                            {
                                "target_lang_word": "ingenuous",
                                "target_lang_sense_clarification": "innocent and unsuspecting"
                            },
                            {
                                "target_lang_word": "unsophisticated",
                                "target_lang_sense_clarification": "lacking refined worldly knowledge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}