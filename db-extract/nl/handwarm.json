                                        "glosses": [
                                            "Dicho de una persona, que contiene sus emociones o sus impulsos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727f59d2-ee1a-4956-8c94-cf2c5f8cdecc",
                                                "sense_id": "5b204f0c-884c-38c7-a6e1-8a32e7fbd584",
                                                "text": "por ocultar su gran mezquindad decíame: “Mira, mozo, los sacerdotes han de ser muy templados en su comer y beber, y por esto yo no me desmando como otros.” Mas el lacerado mentía falsamente, porque en cofradías y mortuorios que rezamos, a costa ajena comía como lobo y bebía mas que un saludador."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
