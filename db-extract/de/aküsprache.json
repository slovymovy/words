                        "entry_id": "f36412b8-438b-3f19-a5cd-b62234c8810b",
                        "glosses": [
                            "Bezeichnung für eine Sprachverwendung, die eine Vorliebe für Abkürzungen/Kurzwörter aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c040d8c5-c8fc-4bb7-99a0-3da2dabb7ab1",
                                "sense_id": "cbd956df-ef3f-3abd-ba02-7935f2e0a63e",
                                "text": "„Die Aküsprache (Abkürzungssprache) ist eine internationale Erscheinung, die so stark um sich gegriffen hat, daß seit langem besondere Abkürzungswörterbücher erforderlich sind.“"
                            },
                            {
                                "example_id": "b039a384-1187-4e75-b3e2-1a161c3ce617",
                                "sense_id": "cbd956df-ef3f-3abd-ba02-7935f2e0a63e",
                                "text": "„Aküspra – Aküsprache. Überall herrscht die Abkürzungssprache: keine Zeit, kein Platz!“"
                            },
                            {
                                "example_id": "e3fba7b9-cf46-48ba-95ab-4658e20d165e",
                                "sense_id": "cbd956df-ef3f-3abd-ba02-7935f2e0a63e",
                                "text": "„Selbst das Wort ‚Abkürzungssprache‘ ist zu einem Kurzwort geworden: Aküsprache (…)“."
                            }
                        ],
                        "sense_index_json": "\"1\""
