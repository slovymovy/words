                "senses": [
                    {
                        "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                        "entry_id": "5e94af7a-020d-3280-a5f5-2e304ed22898",
                        "glosses": [
                            "Pflanze aus der Gattung Gladiolus, häufige Zierpflanze, stammt aus dem lateinischen Substantiv gladiolus \\\"kleines Schwert\\\", abgewandelt von gladius, was Schwert bedeutet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f0b3d7-f179-4ba0-b2bc-1690279076c6",
                                "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                                "text": "Gladiolen sind beliebte Schnittblumen."
                            },
                            {
                                "example_id": "d509a404-10c7-4259-83b4-7c5ac1ddca8f",
                                "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                                "text": "Siehst du beim Blumenstand an der Straße die schönen Gladiolen?"
                            },
                            {
                                "example_id": "54ff6e2c-9994-4382-b31b-6c5b9fc99d88",
                                "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                                "text": "„Es blühten Malven und Rittersporn, tränende Herzen, Rosen, Gladiolen und vieles mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c53302eb-6a1a-4504-8ee4-28891f36cc14",
                        "source_entry_id": "5e94af7a-020d-3280-a5f5-2e304ed22898",
                        "source_sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                        "target_lang_word": "gladiolus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gladiolus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15045602-6540-3d85-ab6c-7fe0d94ba010",
                                        "entry_id": "d2cf8c0d-d17b-3017-ab68-786159bb72b0",
                                        "glosses": [
                                            "The center part of the sternum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af3681b1-5449-33be-a6ae-2e647a3bf156",
                                        "entry_id": "d2cf8c0d-d17b-3017-ab68-786159bb72b0",
                                        "glosses": [
                                            "Any of several flowering plants, of the genus Gladiolus, having sword-shaped leaves and showy flowers on spikes; gladiola."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c2da48-f9e9-4aca-8e10-00c8f6e79008",
                                                "sense_id": "af3681b1-5449-33be-a6ae-2e647a3bf156",
                                                "text": "Hester Earle and Violet Wayne were moving about the aisle with bundles of wheat-ears and streamers of ivy, for the harvest thanksgiving was shortly to be celebrated, while the vicar stood waiting for their directions on the chancel steps with a great handful of crimson gladioli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "986198e5-73e5-455d-b156-2a2530d26c41",
                        "source_entry_id": "5e94af7a-020d-3280-a5f5-2e304ed22898",
                        "source_sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                        "target_lang_word": "glaïeul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaïeul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e59e115f-cb01-3f52-acaa-e0c275f02450",
                                        "entry_id": "efcafc23-629e-3469-9aa3-0ff65ce14d48",
                                        "glosses": [
                                            "Plante herbacée de la famille des iridacées dont les feuilles sont longues, étroites et pointues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109eb107-b692-4020-ab99-5c000352ac4c",
                                                "sense_id": "e59e115f-cb01-3f52-acaa-e0c275f02450",
                                                "text": "Sur le bord de la rivière, parmi les joncs et les glaïeuls, le cadavre d'une femme gisait. Ses longs cheveux dénoués s’éparpillaient parmi les herbes aquatiques; […]."
                                            },
                                            {
                                                "example_id": "9d491e76-f5bb-481f-bb22-2621dddd4a31",
                                                "sense_id": "e59e115f-cb01-3f52-acaa-e0c275f02450",
                                                "text": "Le marais prend dès la dernière grange : peu à peu, l'herbe devient plus rêche, des houppes laineuses y floconnent ; il y luit des nappes de joncs; la reine des près, le glaieul d'eau y buissonnent et, lentement, la sphaigne, la mousse décolorée, commence à régner, […]."
                                            },
                                            {
                                                "example_id": "b520c3aa-e783-4335-8657-28b5baf9b8c8",
                                                "sense_id": "e59e115f-cb01-3f52-acaa-e0c275f02450",
                                                "text": "[…] le glaïeul, laissant fléchir ses glaives avec un abandon royal, étendait sur l’eupatoire et la grenouillette au pied mouillé, les fleurs de lis en lambeaux, violettes et jaunes, de son sceptre lacustre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
