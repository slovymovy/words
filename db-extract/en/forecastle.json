                    },
                    {
                        "translation_id": "0b9e0530-0e2b-4e3c-9c24-218a0a3ebe23",
                        "source_entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "source_sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
