{
    "word_family": [
        "strangulation",
        "strangler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d629d1a-f99c-3bb0-af6f-e7bdeaddf584",
                    "sense_definition": "To kill someone by squeezing the throat to stop them from breathing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suffocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal was caught after he tried to <w>strangle</w> his victim.",
                            "target_lang_translations": {
                                "cs": "Zločinec byl dopaden poté, co se pokusil svou oběť <w>uškrtit</w>."
                            }
                        },
                        {
                            "text": "The detective found evidence that the victim had been <w>strangled</w>.",
                            "target_lang_translations": {
                                "cs": "Detektiv našel důkazy, že oběť byla <w>uškrcena</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "choke",
                        "throttle",
                        "suffocate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zabít někoho stisknutím hrdla tak, aby nemohl dýchat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uškrtit",
                                "target_lang_sense_clarification": "úmyslné zabití škrcením"
                            },
                            {
                                "target_lang_word": "rdousit",
                                "target_lang_sense_clarification": "škrtit někoho, často s cílem zabít"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b2be416-1d14-3b83-b151-9e5c56fc3b9c",
                    "sense_definition": "To stop or prevent something from developing or being expressed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High taxes might <w>strangle</w> the growth of small businesses.",
                            "target_lang_translations": {
                                "cs": "Vysoké daně mohou <w>udusit</w> růst malých podniků."
                            }
                        },
                        {
                            "text": "She tried to <w>strangle</w> a laugh during the serious meeting.",
                            "target_lang_translations": {
                                "cs": "Během vážné schůzky se snažila <w>potlačit</w> smích."
                            }
                        }
                    ],
                    "synonyms": [
                        "stifle",
                        "suppress",
                        "smother"
                    ],
                    "antonyms": [
                        "encourage",
                        "foster"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zastavit nebo zabránit něčemu v rozvoji nebo vyjádření."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "potlačit",
                                "target_lang_sense_clarification": "udusit nebo omezit vývoj či emoci"
                            },
                            {
                                "target_lang_word": "dusit",
                                "target_lang_sense_clarification": "bránit rozvoji něčeho (např. podnikání)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "029c55cd-8ee5-3469-a673-eab378916aa1",
                    "sense_definition": "To die or be injured by having the throat squeezed or blocked.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suffocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>strangled</w> when its leash got caught on the fence.",
                            "target_lang_translations": {
                                "cs": "Pes se <w>uškrtil</w>, když se jeho vodítko zachytilo o plot."
                            }
                        },
                        {
                            "text": "The bird <w>strangled</w> in the thick netting.",
                            "target_lang_translations": {
                                "cs": "Pták se <w>udusil</w> v husté síti."
                            }
                        }
                    ],
                    "synonyms": [
                        "choke"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zemřít nebo být zraněn v důsledku stisknutí nebo zablokování hrdla."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "udusit se",
                                "target_lang_sense_clarification": "zemřít v důsledku nedostatku vzduchu"
                            },
                            {
                                "target_lang_word": "uškrtit se",
                                "target_lang_sense_clarification": "zemřít nešťastnou náhodou při zaškrcení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8342a4f-32a2-3427-9ee8-b6f870d39ea8",
                    "sense_definition": "To be unable to breathe due to lack of air or obstruction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suffocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trapped miners felt they were being <w>strangled</w> by the lack of oxygen.",
                            "target_lang_translations": {
                                "cs": "Uvěznění horníci měli pocit, že se <w>dusí</w> nedostatkem kyslíku."
                            }
                        },
                        {
                            "text": "The thick smoke made everyone feel <w>strangled</w> in the small room.",
                            "target_lang_translations": {
                                "cs": "Kvůli hustému kouři se v malé místnosti všichni <w>dusili</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "suffocate",
                        "choke"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or older contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Být neschopný dýchat kvůli nedostatku vzduchu nebo překážce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dusit se",
                                "target_lang_sense_clarification": "mít potíže s dýcháním"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96fe8fac-6612-35f1-a0e4-058169a29325",
                    "sense_definition": "A financial strategy using options to profit from large price movements in either direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investor used a <w>strangle</w> to hedge against market volatility.",
                            "target_lang_translations": {
                                "cs": "Investor použil strategii <w>strangle</w> jako zajištění proti volatilitě trhu."
                            }
                        },
                        {
                            "text": "Buying a <w>strangle</w> is a common tactic before major company announcements.",
                            "target_lang_translations": {
                                "cs": "Nákup <w>strangle</w> je běžná taktika před významnými oznámeními společnosti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Finanční strategie využívající opce k zisku z velkých cenových pohybů oběma směry."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strangle",
                                "target_lang_sense_clarification": "odborný finanční termín pro opční strategii"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}