                        "glosses": [
                            "iemand die met kleine pasjes loopt, geoefende wandelaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a29af688-0fec-4449-8d54-77b3f8971e04",
                                "sense_id": "2c4169ac-f622-33b3-8a68-4bf5f0d2f66e",
                                "text": "Basisschoolkinderen in Breukelen krijgen op 3 oktober al 100 jaar lang een gratis portie poffertjes in de gebakkraam in het dorp. De traktatie is bij testament vastgelegd door L.C. Dudok de Wit, beter bekend als Kees de Tippelaar, die in 1913 in het Utrechtse dorp overleed."
                            }
                        ]
                    },
                    {
                        "sense_id": "67bea087-f1ac-3517-94b9-6e1593acb15c",
                        "entry_id": "6b6d6670-e452-3b25-b09b-59dd45677f2d",
                        "glosses": [
                            "zwerver"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c52c02-1e66-467b-957b-808af4f467eb",
                                "sense_id": "67bea087-f1ac-3517-94b9-6e1593acb15c",
                                "text": "waar de boeren al of niet aan tippelaars (zwervers) toestaan een nacht in den schuur door te brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb9f19b2-0d90-3f2a-b4ff-596fa89ac7ec",
                        "entry_id": "6b6d6670-e452-3b25-b09b-59dd45677f2d",
                        "glosses": [
                            "straatdief"
                        ],
                        "tags": [
