                                    {
                                        "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                        "entry_id": "bf3dee1a-9342-3c4b-bb9b-eb561bd8c0e2",
                                        "glosses": [
                                            "Qui génère de la fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc21521-1c96-4d0a-9536-7ea5a4c3c0fa",
                                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                                "text": "Seize personnes […] auraient été arrêtées par la police qui a utilisé des bombes fumigènes."
                                            },
                                            {
                                                "example_id": "f8e2a5ec-85c8-4ac7-a873-456cba670168",
                                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                                "text": "Les observatoires de la colline de Saint-Walfroy, située à l'est, de l'autre côté de la Chiers, seront aveuglés par des tirs fumigènes qui seront poursuivis jusqu'à la tombée de la nuit."
                                            },
                                            {
                                                "example_id": "32205117-b4d9-43cf-a582-9d3dad8811de",
                                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                                "text": "Elle insulta un piéton qui traversait et se faufila en donnant des coups de klaxon indignés dans l’étroit passage laissé par un taxi et un bus fumigène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fumigène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                                        "entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                                        "glosses": [
                                            "Objet destiné à produire de la fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0726ea76-9e08-4aae-ad0c-fc204eb62a93",
                                                "sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                                                "text": "D’énormes fumigènes rouges et une bombe agricole illuminèrent le virage de Boulogne, et différents projectiles fusèrent en direction du terrain sous les cris de : « CRS marseillais ! » Des agents de sécurité couraient dans tous les sens."
                                            }
                                        ]
                                    }
                                ]
                            }
