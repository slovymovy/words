                        "glosses": [
                            "To win someone over through persuasion; to convince (someone) to do something against their own judgement or wishes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f068966a-63e5-462a-9529-6805cff7ae23",
                                "sense_id": "b3359e5a-c7cc-3346-aded-173443bc7082",
                                "text": "Opportunitie casting him into the company of foure French Gallants well attended [...]; over-perswaded him to goe with them into France, to the Dutchesse of Mercury, from whom they should not only have meanes, but also Letter of favour to her noble Duke [...]."
                            },
                            {
                                "example_id": "392d90d7-6f17-4612-8f6f-5e5b3c7afb98",
                                "sense_id": "b3359e5a-c7cc-3346-aded-173443bc7082",
                                "text": "‘And I let him overpersuade me. He was right, really.’"
                            }
                        ]
                    }
