                ],
                "senses": [
                    {
                        "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                        "entry_id": "a3e05892-32ec-3725-8709-1991e86edde3",
                        "glosses": [
                            "auf der Nordhalbkugel verbreitete, artenreiche, meist sommergrüne Pflanzengattung mit glockenförmigen Kelchblättern"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2ff0fe8d-e3e0-4489-95fa-1cdb51812989",
                                "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                "text": "„Wählen Sie für die Primeln einen halbschattigen Standort.“"
                            },
                            {
                                "example_id": "e7a72dff-004a-4aed-8412-f5ea9012d8cb",
                                "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                "text": "„Bei der Standortwahl für die Primeln im Freien sollte man sich an den Bedingungen orientieren, die die natürlichen Standorte der Wildarten bieten.“"
                            },
                            {
                                "example_id": "dad47e37-6828-46e7-974c-b5886d721a97",
                                "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                "text": "„Ursprünglich hatten die Primeln ihren Platz in den Doppelfenstern, die vor mehr als 100 Jahren gerne gebaut wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                        "entry_id": "a3e05892-32ec-3725-8709-1991e86edde3",
                        "glosses": [
                            "Vertreter der Pflanzengattung [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ceb1ddf-d4bc-4b60-b114-eb7137104aed",
                                "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                "text": "„Ab Januar ist die Primel bereits im Handel zu finden, die Blütezeit beginnt im Februar und reicht bis ins Frühjahr hinein.“"
                            },
                            {
                                "example_id": "3cda03ec-a98a-4799-a78b-890d7892df33",
                                "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                "text": "„Seit die Primel den Gärtnern in die Hände fiel, ist ihre Vielfalt förmlich explodiert.“"
                            },
                            {
                                "example_id": "54dadb00-80bb-4884-aaa0-e9979972b4be",
                                "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                "text": "„An den Rändern blühten Primeln und Veilchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b37a37ff-e00f-440c-bb8b-268098f5e100",
                        "source_entry_id": "a3e05892-32ec-3725-8709-1991e86edde3",
