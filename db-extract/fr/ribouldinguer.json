                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fca7f6c-4e06-4f17-a907-e9d6ab700c10",
                                                "sense_id": "9acfe99c-76ac-3312-b882-01a40901e03b",
                                                "text": "Die Gruppe amüsierte sich bei dem Ausflug köstlich."
                                            },
                                            {
                                                "example_id": "dbaae1ed-3376-4c99-91df-98571fe07df2",
                                                "sense_id": "9acfe99c-76ac-3312-b882-01a40901e03b",
                                                "text": "Amüsiert euch schön!"
