                ],
                "senses": [
                    {
                        "sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                        "entry_id": "edee07a8-e22d-3115-b062-f18ea0b46836",
                        "glosses": [
                            "Relatif au nihilisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f781156a-d585-4bce-8179-388b85ae96a9",
                                "sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                                "text": "Au contraire, elle pêche volontairement dans un conspirationnisme nihiliste qui la rend incapacitante dans le domaine des idées et de l'action métapolitique."
                            },
                            {
                                "example_id": "7fb3399c-f16d-49e3-afc6-4032478067ac",
                                "sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                                "text": "… nous communiquer, par des synopsis des fictions de Henry Miller, son goût pour la dépravation sexuelle (ça te fait des grosses déclarations nihilistes puis cinq minutes après ça croit en Éros, notre Cul Tout-Puissant qui êtes aux Dacieux)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1598f50b-9ac2-4d7c-a6bc-7eed9c8ec1de",
                        "source_entry_id": "edee07a8-e22d-3115-b062-f18ea0b46836",
                        "source_sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                        "target_lang_word": "nihilistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nihilistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f690090-928a-308b-9435-e708da6c2cc7",
                                        "entry_id": "4a092ff0-47a1-348a-bac0-ba896f89c17a",
                                        "glosses": [
                                            "Of or relating to nihilism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56e7a16-1274-4fd1-96bf-01050cd98c3f",
                                                "sense_id": "2f690090-928a-308b-9435-e708da6c2cc7",
                                                "text": "Some of his gloomy judgments have tempted critics to the conclusion that Kazantzakis was even more nihilistic than Nietzsche, and this book can support that view."
                                            },
                                            {
                                                "example_id": "9fc64d66-9288-40a0-8ce0-74d4495858bd",
                                                "sense_id": "2f690090-928a-308b-9435-e708da6c2cc7",
                                                "text": "The bombing comes over a week after ISD released a report about how nihilistic worldviews are fueling violence in the US and Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
