                ],
                "senses": [
                    {
                        "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                        "entry_id": "d6454d24-78ef-3469-8a59-e03acf70006f",
                        "glosses": [
                            "Gesundheit (Funktionalität, Schmerzfreiheit und so weiter) der Füße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "009d5793-8c74-43b6-8429-3990629fbb3a",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Die Fußgesundheit kann in jedem Alter gefördert werden.“"
                            },
                            {
                                "example_id": "9b9796b2-bbeb-4b93-ad29-bf715d884cb5",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Orthopädische Schuhe sind speziell angefertigte Schuhe, die dazu dienen, die Fußgesundheit während des Arbeitsalltags zu erhalten.“"
                            },
                            {
                                "example_id": "8eb4adeb-5385-4817-b257-2d61cb6e41d7",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Die Verwendung orthopädischer Schuhe kann somit dazu beitragen, Schmerzen zu lindern, die Fußgesundheit zu unterstützen und die Arbeitsleistung im Berufsalltag zu verbessern.“"
                            },
                            {
                                "example_id": "a9810293-2023-49e7-8c60-c1fd5258e816",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Jeder Schuh wird individuell an die spezifischen Bedürfnisse angepasst und gewährleistet so eine optimale Fußgesundheit und Tragekomfort im Alltag.“"
                            },
                            {
                                "example_id": "3f9390c0-70b7-43a8-8ae5-388efb4020bc",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Im Folgenden finden Sie fünf einfache Übungen, die Ihnen helfen können, Fußschmerzen zu lindern und Ihre Fußgesundheit zu verbessern.“"
                            },
                            {
                                "example_id": "e653a178-7814-46dc-8ffb-dc173ec2924c",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Wer vorbeugend prophylaktisch etwas für seine Fußgesundheit machen und unternehmen möchte, kann bei uns aus einem vielfältigen Sortiment an Gesundheits- und Komfortschuhen sein Lieblingsmodell wählen.“"
                            },
                            {
                                "example_id": "1c1f3713-2466-4940-b707-20fbfff1fdab",
                                "sense_id": "e10af024-c8bd-3260-a2dc-1fc2d5a8d6f9",
                                "text": "„Es gibt zahlreiche Faktoren, die zur Fußgesundheit beitragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
