                        ],
                        "examples": [
                            {
                                "example_id": "7d5f6dfe-a350-45d9-8445-3e439e60ecd6",
                                "sense_id": "47f456ed-0773-3144-8f4d-d07c84002e41",
                                "text": "La manière de vivre du renard y est la même qu’en Europe; il fréquente comme chez nous les champs dans le voisinage des forêts, et vit dans les terrières qu’il creuse ou dans celles des autres animaux fouisseurs dont il agrandit le gîte, telles que les demeures du Blaireau anakuma et du Nyctéreute viverrin;"
                            },
                            {
                                "example_id": "b50b6fee-b4b7-4a41-a140-a8aae8ad03be",
                                "sense_id": "47f456ed-0773-3144-8f4d-d07c84002e41",
                                "text": "Le terme idoine en français est chien viverrin ou nyctéreute mais pour plus de facilité, nous continuerons à l'appeler tanuki."
                            }
                        ]
                    }
