                        "entry_id": "0bba0bec-9664-3a3a-ab9d-3b16f7010cc8",
                        "glosses": [
                            "Kartenspiel, bei dem Karten des gleichen Wertes oder der gleichen Farbe abgelegt werden müssen, bis ein Spieler alle Karten abgelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13acb479-5556-4332-9958-df33fa0f22df",
                                "sense_id": "78f33c6a-34e3-3dc5-b6e6-41af096ca571",
                                "text": "Spielen wir eine Runde Mau-Mau?"
                            },
                            {
                                "example_id": "f9145749-dd74-42df-9a64-3c7dc6672aab",
                                "sense_id": "78f33c6a-34e3-3dc5-b6e6-41af096ca571",
                                "text": "„Durch die offene Tür konnte ich meine Mutter und meinen Bruder lachen hören, die in der Küche Peter Tripps Hitparade im Radio lauschten oder Mau-Mau spielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
