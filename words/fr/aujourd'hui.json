        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "caff15b2-2f7f-316a-a924-79f56d6c439a",
                    "sense_definition": "Le temps présent, l'époque contemporaine ou la journée actuelle considérée comme une réalité vécue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temps_present",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est souvent difficile d'apprécier pleinement l'<w>aujourd'hui</w> sans penser au lendemain.",
                            "target_lang_translations": {
                                "en": "It is often difficult to fully appreciate the <w>present</w> without thinking about tomorrow.",
                                "ru": "Часто трудно полностью ценить <w>настоящее</w>, не думая о завтрашнем дне.",
                                "nl": "Het is vaak moeilijk om het <w>heden</w> volledig te waarderen zonder aan de volgende dag te denken.",
                                "de": "Es ist oft schwer, die <w>Gegenwart</w> voll zu schätzen, ohne an den nächsten Tag zu denken.",
                                "pl": "Często trudno w pełni docenić <w>teraźniejszość</w>, nie myśląc o jutrze.",
                                "it": "Spesso è difficile apprezzare pienamente il <w>presente</w> senza pensare al domani.",
                                "cs": "Je často těžké plně ocenit <w>přítomnost</w> bez myšlenek na zítřek.",
                                "tr": "Yarını düşünmeden <w>şimdiki anın</w> tadını tam olarak çıkarmak çoğu zaman zordur.",
                                "es": "A menudo es difícil apreciar plenamente el <w>presente</w> sin pensar en el mañana.",
                                "zh": "人们往往很难在惦记明天的同时，充分体会<w>当下</w>。"
                            }
                        },
                        {
                            "text": "Ce philosophe nous invite à savourer l'<w>aujourd'hui</w> sans regretter le passé.",
                            "target_lang_translations": {
                                "en": "This philosopher invites us to savour the <w>present</w> without regretting the past.",
                                "ru": "Этот философ призывает нас наслаждаться <w>настоящим</w>, не сожалея о прошлом.",
                                "nl": "Deze filosoof nodigt ons uit om het <w>heden</w> te koesteren zonder het verleden te betreuren.",
                                "de": "Dieser Philosoph lädt uns ein, die <w>Gegenwart</w> zu genießen, ohne die Vergangenheit zu bedauern.",
                                "pl": "Ten filozof zachęca nas, abyśmy delektowali się <w>teraźniejszością</w>, nie żałując przeszłości.",
                                "it": "Questo filosofo ci invita ad assaporare il <w>presente</w> senza rimpiangere il passato.",
                                "cs": "Tento filozof nás vybízí, abychom si užívali <w>přítomnosti</w> a nelitovali minulosti.",
                                "tr": "Bu filozof, geçmişe hayıflanmadan <w>şimdiki anın</w> tadını çıkarmamızı öneriyor.",
                                "es": "Este filósofo nos invita a saborear el <w>presente</w> sin lamentar el pasado.",
                                "zh": "这位哲学家提醒我们，要珍惜<w>当下</w>，不必为过去懊悔。"
                            }
                        }
                    ],
                    "antonyms": [
                        "passé",
                        "futur"
                    ],
                    "target_lang_definitions": {
                        "en": "The present time, or the current day considered as something lived and experienced.",
                        "ru": "Настоящее время или текущий день как переживаемая реальность.",
                        "nl": "Het huidige moment of de huidige dag als werkelijkheid die men beleeft.",
                        "de": "Die gegenwärtige Zeit oder der heutige Tag, so wie man ihn erlebt.",
                        "pl": "Czas teraźniejszy, obecna chwila lub bieżący dzień postrzegany jako przeżywana rzeczywistość.",
                        "it": "Il tempo presente, l'epoca contemporanea o la giornata attuale vissuta come realtà concreta.",
                        "cs": "Přítomný čas, současná doba nebo dnešní den vnímaný jako prožívaná skutečnost.",
                        "tr": "Yaşadığımız an ve içinde bulunulan gün, gerçek anlamda yaşanan zaman.",
                        "es": "El tiempo presente o el día de hoy, vivido como una realidad concreta.",
                        "zh": "指眼前的时刻，或作为切身经历的当下这一天。"
                    },
