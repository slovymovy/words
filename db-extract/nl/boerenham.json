                        "glosses": [
                            "been- of schouderham; een benaming zonder feitelijke betekenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096effe5-beea-42a3-a1b1-6e7625f49495",
                                "sense_id": "4d3ff410-0576-37c6-85de-b491552e6458",
                                "text": "Verwarm de oven voor op 200°C. Bekleed een bakplaat met bakpapier en leg er de sneetjes boerenham op. Plaats ze in de oven tot ze krokant zijn (ongeveer 5 minuten)."
                            },
                            {
                                "example_id": "f56792dc-4efd-429e-8d87-8f0ecc01c305",
                                "sense_id": "4d3ff410-0576-37c6-85de-b491552e6458",
                                "text": "Bruine bonen met appeltjes: Ingrediënten voor 4 personen: 250 g gedroogde appeltjes, wat citroenschil, een half kaneelpijpje, suiker, 400 g bruine bonen (uit blik), zout, 2 laurierblaadjes, halve ui (in stukken), 200 g boerenham aan één stuk (rauwe ham)."
                            },
                            {
                                "example_id": "92ee3102-fc60-4c8e-b9a1-ea1d8e5c615b",
                                "sense_id": "4d3ff410-0576-37c6-85de-b491552e6458",
                                "text": "Beenham zegt iets over het deel waar de ham van gemaakt is, namelijk het (achter)been van het varken. Boerenham is een benaming voor de verkoop zonder feitelijke betekenis en kan van het been of van de schouder zijn gemaakt."
                            }
                        ]
                    }
