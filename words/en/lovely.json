                    "sense_definition": "Inspiring love or friendship; amiable and kind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "character_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>lovely</w> man who always helps his neighbors.",
