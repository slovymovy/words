        "fr-extract.jsonl": [
            {
                "entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                "word": "intellectuellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d3b4b07-e5bf-3cca-ae94-2af7fa08f2e6",
                        "entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                        "glosses": [
                            "D'une manière intellectuelle ; dans l'intelligence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bb5ea1-8d5b-4c56-a10b-fc3a9145025a",
                                "sense_id": "9d3b4b07-e5bf-3cca-ae94-2af7fa08f2e6",
                                "text": "L’adjoint à la construction et élu communiste, Jacques Baudrier, a suivi tout le programme et peste contre « des bobos qui considèrent que c’est bien de laisser des pauvres dix ans de plus dans leur merde pour se faire plaisir intellectuellement »."
                            }
                        ]
                    },
                    {
                        "sense_id": "58b2878b-c82b-343e-be09-d83e57e58320",
                        "entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                        "glosses": [
                            "En ce qui regarde l’intelligence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1811d5bd-382c-4fac-8e57-db36b9836626",
                                "sense_id": "58b2878b-c82b-343e-be09-d83e57e58320",
                                "text": "Cet enfant n’est pas fort développé intellectuellement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2090e39-cd56-4814-8db2-e45556eedc23",
                        "source_entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                        "target_lang_word": "intellectually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellectually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                                        "entry_id": "2b2d0375-c3c7-34ef-86da-2f1c643ed613",
                                        "glosses": [
                                            "In an intellectual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8d5dee-57d5-4789-896b-6a65e72df6ff",
                                                "sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                                                "text": "And just because the intellectuals are mostly intellectually honest it is inevitable that they should follow their own convictions whenever they have discretion and that they should give a corresponding slant to everything that passes through their hand."
                                            },
                                            {
                                                "example_id": "b399f819-9af4-435e-8d35-5a421324bfc4",
                                                "sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                                                "text": "Nevertheless intellectually, ideologically and politically he identified with industrialists whom he, just like Smith, saw as the usherers of progress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16a525b5-f3fc-4c22-b817-5e7d2c40ce28",
                        "source_entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                        "target_lang_word": "mentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                        "entry_id": "33c40f7b-d9f1-3b07-9b7f-1bb177d58844",
                                        "glosses": [
                                            "In a mental manner; an idea thought out in one's mind, as opposed to an idea spoken orally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be489d8c-91c9-4823-97a2-18d7111ebbf7",
                                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                                "text": "mentally capable"
                                            },
                                            {
                                                "example_id": "da06589a-aa96-4e63-947f-fffd69f99c1a",
                                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                                "text": "mentally ill"
                                            },
                                            {
                                                "example_id": "d795d4ed-f451-4604-8fed-c5c8883891f3",
                                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                                "text": "This is a problem that needs to be solved mentally, not with brute force."
                                            },
                                            {
                                                "example_id": "62a271a4-a2ad-4abd-ba31-4ba5dbff6c8f",
                                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                                "text": "The novel he lends his name to is an account of that life, taking more or less the form of a memoir set down in the years immediately after World War II by an old man mentally preparing for death, not quite at home in the twentieth century (and a little proud of it, stubbornly clinging to his eartrumpet), whose significant memories reach back to the early 1890s and beyond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "158ab984-3489-4119-9cff-88489f501c13",
