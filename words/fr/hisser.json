    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae520137-1eb4-3abd-b7bd-3062fe3eb903",
                    "sense_definition": "Lever, faire monter quelque chose à l'aide d'un cordage ou avec effort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "monter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, les marins doivent <w>hisser</w> les voiles avant de quitter le port."
                        },
                        {
                            "text": "Le garde a décidé de <w>hisser</w> le drapeau en haut du mât."
                        }
                    ],
                    "synonyms": [
                        "lever",
                        "monter"
                    ],
                    "antonyms": [
                        "affaler"
                    ],
                    "common_phrases": [
                        "hisser le drapeau",
                        "hisser les voiles",
                        "hisser les couleurs"
                    ]
                },
                {
                    "sense_id": "45dc3c75-5da0-326a-9d40-2a0a3a136ba8",
                    "sense_definition": "S'élever ou monter physiquement quelque part au prix d'un effort soutenu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "monter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant réussit à se <w>hisser</w> sur la branche la plus basse de l'arbre."
                        },
                        {
                            "text": "Après une longue marche, le randonneur s'arrête pour se <w>hisser</w> au sommet de la falaise."
                        }
                    ],
                    "synonyms": [
                        "grimper"
                    ],
                    "common_phrases": [
                        "se hisser sur",
                        "se hisser au sommet"
                    ]
                },
                {
                    "sense_id": "be20f664-79ad-3009-ad2d-0d08be14da27",
                    "sense_definition": "Atteindre ou faire parvenir à une position sociale, professionnelle ou hiérarchique plus élevée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son travail constant, elle a su se <w>hisser</w> au premier rang de l'entreprise."
                        },
                        {
                            "text": "Cette nouvelle victoire a permis à l'équipe de se <w>hisser</w> en tête du classement."
                        }
                    ],
                    "synonyms": [
                        "accéder",
                        "s'élever"
                    ],
                    "common_phrases": [
                        "se hisser au premier rang",
                        "se hisser au pouvoir"
                    ]
                }
            ]
        }
    ]
