{
    "word_family": [
        "scold"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db021409-bf52-3704-880e-bd445ed28686",
                    "sense_definition": "A series of critical or angry remarks directed at someone for their behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child received a long <w>scolding</w> for breaking the expensive vase.",
                            "target_lang_translations": {
                                "es": "El niño recibió un largo <w>regaño</w> por romper el jarrón caro."
                            }
                        },
                        {
                            "text": "After the <w>scolding</w> from his boss, he decided to be more careful with his work.",
                            "target_lang_translations": {
                                "es": "Después del <w>regaño</w> de su jefe, decidió ser más cuidadoso con su trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "rebuke",
                        "reproach"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "common_phrases": [
                        "receive a scolding",
                        "get a scolding"
                    ],
                    "target_lang_definitions": {
                        "es": "Serie de comentarios críticos o enfadados dirigidos a alguien por su comportamiento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "regaño",
                                "target_lang_sense_clarification": "Acción o efecto de reprender a alguien."
                            },
                            {
                                "target_lang_word": "sermón",
                                "target_lang_sense_clarification": "Amonestación o regaño de carácter moralizante."
                            },
                            {
                                "target_lang_word": "bronca",
                                "target_lang_sense_clarification": "Corrección verbal de marcada vehemencia (común en España)."
                            },
                            {
                                "target_lang_word": "rapapolvo",
                                "target_lang_sense_clarification": "Reprimenda severa o regaño fuerte."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f405b61b-ac8f-397d-8bf0-4979d21637df",
                    "sense_definition": "Present participle and gerund of <w>scold</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>scolding</w> her dog for chewing on the new shoes.",
                            "target_lang_translations": {
                                "es": "Ella estaba <w>regañando</w> a su perro por masticar los zapatos nuevos."
                            }
                        },
                        {
                            "text": "He spent the entire afternoon <w>scolding</w> the students for being noisy.",
                            "target_lang_translations": {
                                "es": "Pasó toda la tarde <w>regañando</w> a los estudiantes por hacer ruido."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimanding",
                        "rebuking",
                        "berating"
                    ],
                    "antonyms": [
                        "praising",
                        "complimenting"
                    ],
                    "common_phrases": [
                        "keep scolding"
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente y gerundio del verbo regañar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "regañando",
                                "target_lang_sense_clarification": "Gerundio del verbo regañar."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}