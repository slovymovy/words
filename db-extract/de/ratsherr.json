                "senses": [
                    {
                        "sense_id": "08a94115-6ac9-3cbb-8d28-9b2c097eb912",
                        "entry_id": "5816312b-de33-31cc-aad1-5210e91f0a07",
                        "glosses": [
                            "Person, die Mitglied in einem Rat (Gemeinderat, Ortsrat, Stadtrat) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6143f40e-ead6-4ded-a2ab-97a05b0f2624",
                                "sense_id": "08a94115-6ac9-3cbb-8d28-9b2c097eb912",
                                "text": "„Otto Brenner war Ratsherr in Hannover und später auch niedersächsischer SPD-Landtagsabgeordneter.“"
                            },
                            {
                                "example_id": "049f4e5b-e1f2-47c8-9833-8ec4e4b7e608",
                                "sense_id": "08a94115-6ac9-3cbb-8d28-9b2c097eb912",
                                "text": "„Die Ratsherren einigen sich dann, weil sie sich nicht auf einen der beiden einigen können, auf einen dritten, der dumm und böse gleichermaßen ist.“"
                            },
                            {
                                "example_id": "7771a480-6e57-4b9f-9b63-b1a66c5fceb2",
                                "sense_id": "08a94115-6ac9-3cbb-8d28-9b2c097eb912",
                                "text": "„Die Ratsherren handelten einig, entschlossen und ohne jede Rücksicht, die Tuchmacher uneins, unentschlossen und mit viel Vorsicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
