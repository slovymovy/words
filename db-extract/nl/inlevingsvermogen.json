                "senses": [
                    {
                        "sense_id": "6b83cc49-568b-3258-8105-5dbb684e8592",
                        "entry_id": "8034e3b7-bdbe-37d4-95d5-57a462138407",
                        "glosses": [
                            "de kunde of vaardigheid om zich in te leven in de situatie en gevoelens van anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a8c27d1-0016-4e7c-a657-79adfe6f0c90",
                                "sense_id": "6b83cc49-568b-3258-8105-5dbb684e8592",
                                "text": ",,Het is vaak lastig feiten en verzinsels van elkaar te onderscheiden. Nuance en inlevingsvermogen lijken bij voorbaat het onderspit te delven en Twitter maakt het debat soms bitter.\""
                            },
                            {
                                "example_id": "4d504a0e-5759-4818-9952-d1cb9c3f597c",
                                "sense_id": "6b83cc49-568b-3258-8105-5dbb684e8592",
                                "text": "Pam merkt op dat iemand met inlevingsvermogen 'geneigd is om bij een conflict niet onmiddellijk de ander de kop in te slaan'. Dat klopt. De hele krijgskunst van Sun Tzu draait om het vermijden van ónmiddellijke'reacties en de manipulatie van de tegenstander tot aan het punt waar die zijn verplettering niet meer kan verhoeden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "821a7e7d-c95e-4bc9-9cc9-6d5fc1262227",
                        "source_entry_id": "8034e3b7-bdbe-37d4-95d5-57a462138407",
                        "source_sense_id": "6b83cc49-568b-3258-8105-5dbb684e8592",
                        "source_sense_description": "de kunde of vaardigheid om zich in te leven in de situatie en gevoelens van anderen",
                        "target_lang_word": "empathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empathy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "274b58a2-0c0a-3777-bba4-adbf8f3bd1e7",
                                        "entry_id": "4df4d881-5819-31cc-bcf2-6f1bf78b2248",
                                        "glosses": [
                                            "Identification with or understanding of the thoughts, feelings, or emotional state of another person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e58018-9c5d-45e5-96f7-540526fe5990",
                                                "sense_id": "274b58a2-0c0a-3777-bba4-adbf8f3bd1e7",
                                                "text": "She had a lot of empathy for her neighbor; she knew what it was like to lose a parent too."
                                            },
                                            {
                                                "example_id": "b0ac60d9-212d-42be-9792-a2061b5fbf04",
                                                "sense_id": "274b58a2-0c0a-3777-bba4-adbf8f3bd1e7",
                                                "text": "Like your body's in the room but you're not really there / Like you have empathy inside but you don't really care / Like you're fresh outta love but it's been in the air / Am I past repair?"
                                            },
                                            {
                                                "example_id": "776a67b7-39dc-41d8-97b1-d745086ef15e",
                                                "sense_id": "274b58a2-0c0a-3777-bba4-adbf8f3bd1e7",
                                                "text": "While Musk said he believes in empathy and that “you should care about other people,” he also thinks it’s destroying society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe54b69c-ed80-33be-ace6-313d1f06e464",
                                        "entry_id": "4df4d881-5819-31cc-bcf2-6f1bf78b2248",
                                        "glosses": [
                                            "The capacity to understand another person's point of view or the result of such understanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8603c169-e647-3233-9092-840398564332",
                                        "entry_id": "4df4d881-5819-31cc-bcf2-6f1bf78b2248",
                                        "glosses": [
                                            "A paranormal ability to psychically read another person's emotions."
