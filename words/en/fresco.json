                            {
                                "target_lang_word": "pittura ad affresco",
                                "target_lang_sense_clarification": "tecnica di pittura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93afc210-7201-38b1-96c7-2b8bc3bac77c",
                    "sense_definition": "Cool, refreshing air or shade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stepped outside into the garden to enjoy the <w>fresco</w> of the evening.",
                            "target_lang_translations": {
                                "it": "Sono usciti in giardino per godersi il <w>fresco</w> della sera."
                            }
                        },
                        {
                            "text": "The cool <w>fresco</w> of the night brought relief after a scorching day.",
                            "target_lang_translations": {
                                "it": "La <w>frescura</w> della notte ha portato sollievo dopo una giornata torrida."
                            }
                        }
