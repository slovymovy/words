                    {
                        "translation_id": "b01f621e-f1ad-447b-a889-57779b8c0eb6",
                        "source_entry_id": "f94af203-2e63-318c-bff9-e643e2a94937",
                        "source_sense_id": "87916793-d652-37c2-97a5-827a9c1f647c",
                        "target_lang_word": "Vorlesung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorlesung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                        "entry_id": "7a132377-ba40-3f2c-918d-0df2ae579889",
                                        "glosses": [
                                            "Lehrveranstaltung oder Unterrichtsstunde an einer Hochschule, bei der ein Dozent über ein bestimmtes Thema spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a3b563-6df1-4881-937a-69e50a0cdd1c",
                                                "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                                "text": "Zu den Vorlesungen komme ich immer pünktlich."
                                            },
                                            {
                                                "example_id": "cf430acd-e8e6-412d-9e57-cbeeadf88382",
                                                "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                                "text": "„Der Hörsaal war besetzt, und die Vorlesung darin war bereits in vollem Gang, während die Interessenten für den Gastvortrag unsicher und unschlüssig draußen warteten.“"
                                            },
                                            {
                                                "example_id": "8ad4bdf7-1b23-4b77-a5eb-0990bd69c0e8",
                                                "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                                "text": "„In einer einflussreichen Vorlesung von 1962 hat der Philosoph Joachim Ritter das mit Petrarca einsetzende Motiv des Blicks vom Berge als Ausdruck neuzeitlicher Subjektivität gedeutet.“"
                                            },
                                            {
                                                "example_id": "89c77461-c8f3-475f-b722-3485bef522bf",
                                                "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                                "text": "„Im Verlauf seiner Vorlesung bedeckte er die Wandtafel bis an den Rand mit Gleichungen.“"
                                            },
                                            {
                                                "example_id": "43e1f4bb-85d0-46de-8fc1-12b72bc0130c",
                                                "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                                "text": "„Für seine Vorlesungen benutzte er seit langem schon alte Manuskripte, die ihm fremd geworden waren, und bisweilen war er sich dabei vorgekommen wie sein eigener Pressesprecher.“"
                                            },
                                            {
                                                "example_id": "77dab901-b847-43fe-ac29-de691472ade1",
                                                "sense_id": "616487ff-8bdd-30c2-a17b-32c8da15b1e0",
                                                "text": "„Er behielt alles, was er gelesen, und jede Vorlesung, die er gehört hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
