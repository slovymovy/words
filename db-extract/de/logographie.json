                "senses": [
                    {
                        "sense_id": "4729dd8d-8c0c-3431-8164-5b644c3800b3",
                        "entry_id": "9719dcb1-761f-3a50-bc4f-cc6b8fa08ca6",
                        "glosses": [
                            "Wiedergabe von Wörtern durch Wortzeichen, das heißt einzelne graphische Zeichen (= Logogramme), die für ein ganzes Wort stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74943f4-d974-47c3-898a-290c4e538516",
                                "sense_id": "4729dd8d-8c0c-3431-8164-5b644c3800b3",
                                "text": "„In der Entwicklung der Schrift ist die Logographie, die Schreibung ganzer Wörter, ein relativ frühes Stadium.“"
                            },
                            {
                                "example_id": "c4f9f45f-0e9e-4312-9824-aea73a49a2e0",
                                "sense_id": "4729dd8d-8c0c-3431-8164-5b644c3800b3",
                                "text": "„Die inhaltorientierte Schreibweise nennt man Logographie (griechisch logos ›Gedanke‹ + graphein ›schreiben‹), die Varianten der Lautschriften werden als Phonographie (griechisch phonē ›schreiben‹) bezeichnet.“"
                            },
                            {
                                "example_id": "31a40b21-00d7-4a6d-9060-b30daee28c67",
                                "sense_id": "4729dd8d-8c0c-3431-8164-5b644c3800b3",
                                "text": "„Logographie“ ist die dritte Art Schrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
