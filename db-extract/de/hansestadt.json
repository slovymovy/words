                    {
                        "form_id": "03cc042a-49fd-4ea2-889a-a7835e6709ef",
                        "entry_id": "ae9b6b99-6a23-3141-92b6-bca2a6e4dbe8",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Hansestadt"
                    },
                    {
                        "form_id": "1aba2f6a-7246-4d87-8271-5ea3ac898480",
                        "entry_id": "ae9b6b99-6a23-3141-92b6-bca2a6e4dbe8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hansestädte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
                        "entry_id": "ae9b6b99-6a23-3141-92b6-bca2a6e4dbe8",
                        "glosses": [
                            "Stadt, die Mitglied im Städtebund der deutschen Hanse war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41be7e1c-2e11-4078-b3e7-1cea4b3e2aa0",
                                "sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
                                "text": "Auch Köln, Osnabrück und Bochum waren einst Hansestädte."
                            },
                            {
                                "example_id": "74458b8b-ac33-4417-9fea-f06ccecf9b66",
                                "sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
                                "text": "„Erst von der Meerseite aus entfalten die Hansestädte an der Ostsee ihre etwas behäbige Pracht.“"
                            },
                            {
                                "example_id": "2af80320-034b-41a1-bc1d-3380ed8942cb",
                                "sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
                                "text": "„Überhaupt Salzwedel. Die Hansestadt mit Fachwerkbauten und Hafenstraße war früher ein Zentrum des Salzhandels.“"
                            },
                            {
                                "example_id": "b8fce991-7607-4ba1-b6fd-4eaa61828a4d",
                                "sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
                                "text": "„Aber dank ihrer Lage an der Schifffahrtsroute zu den mächtigen Hansestädten an Elbe und Weser war die Inselgruppe stets begehrt.“"
                            },
                            {
                                "example_id": "43c4d1c8-d857-44c0-9865-1b66f87182a9",
                                "sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
                                "text": "„Als alte Hansestadt hatte Danzig schon seit dem Mittelalter weitgehende Autonomie genossen, sowohl unter dem Deutschen Orden als auch unter polnisch-litauischer Oberhoheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "377e385f-b9e5-3278-941f-ba4fee31b0a8",
                        "entry_id": "ae9b6b99-6a23-3141-92b6-bca2a6e4dbe8",
                        "glosses": [
                            "offizieller Namenszusatz einiger deutscher Städte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe8e736-093a-4af0-b4c8-a4e5a680a11a",
                                "sense_id": "377e385f-b9e5-3278-941f-ba4fee31b0a8",
                                "text": "In der Hansestadt Bremen spielt der Seehandel bis heute eine herausragende Rolle."
                            },
                            {
                                "example_id": "3eba84fe-78cf-4f6f-867e-87f452b229bc",
                                "sense_id": "377e385f-b9e5-3278-941f-ba4fee31b0a8",
                                "text": "„In Nürnberg war die Oligarchie ebenso schmal und ebenso abgeschlossen wie in Augsburg, anders als etwa in der Hansestadt Lübeck, wo die Fluktuation der Eliten verhinderte, dass sich eine geburtsständische Exklusivität der politischen Macht herausbildete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf4e3e3f-d80b-4fec-90b1-7567b8a09ec1",
                        "source_entry_id": "ae9b6b99-6a23-3141-92b6-bca2a6e4dbe8",
                        "source_sense_id": "c29df0f9-52cc-310f-b6a7-3a6d560294d7",
