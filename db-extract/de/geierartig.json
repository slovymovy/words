                "senses": [
                    {
                        "sense_id": "b23485d5-f390-3c3e-bc08-b035436d78c0",
                        "entry_id": "bc5ab9be-e98d-387c-a909-0620e823842c",
                        "glosses": [
                            "einem Geier ähnelnd, an einen Geier erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8811c36-7a24-434f-9f23-778ccce56a80",
                                "sense_id": "b23485d5-f390-3c3e-bc08-b035436d78c0",
                                "text": "„H’anna rechnete damit, dass sich die Statue vor Schmerzen krümmen, die geierartigen Flügel sich entfalten und wie verrückt am Boden umherschlagen würden ... dass das inzwischen kopflose Monster sich über den Boden tasten würde, um sie mit seinen Klauen zu zerreißen.“"
                            },
                            {
                                "example_id": "061560be-a762-4217-aaf5-c6a97f2b6c63",
                                "sense_id": "b23485d5-f390-3c3e-bc08-b035436d78c0",
                                "text": "„Über uns kreisen irgendwelche geierartigen Vögel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
