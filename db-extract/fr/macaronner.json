                ],
                "senses": [
                    {
                        "sense_id": "46a5ccf9-d18f-3cc2-93bd-a907adc2bfac",
                        "entry_id": "f265c201-f159-32e0-bead-78b07cb43981",
                        "glosses": [
                            "Mélanger la pâte à macarons et la travailler."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "7b916438-d720-44ba-9d98-0ed88f9bc435",
                                "sense_id": "46a5ccf9-d18f-3cc2-93bd-a907adc2bfac",
                                "text": "Pour le macaronnage, justement il ne faut pas trop macaronner, sinon, tu risques d'avoir des macarons très plats sans collerette!"
                            },
                            {
                                "example_id": "3adb2879-8d49-4243-af46-f00bbf3b5ae8",
                                "sense_id": "46a5ccf9-d18f-3cc2-93bd-a907adc2bfac",
                                "text": "Plutôt que de le faire à la maryse, ou comme Stéphane, au fouet, il est possible de macaronner à la feuille du robot en vitesse 1."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bd4d957-fbbc-368d-b74f-a4238acf23b9",
                        "entry_id": "f265c201-f159-32e0-bead-78b07cb43981",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49dfe211-c84d-4dfc-a5b1-b669167a9661",
                                "sense_id": "7bd4d957-fbbc-368d-b74f-a4238acf23b9",
                                "text": "Je devine un dessein venu de plus haut, si tu vois ce que je veux dire, et qu’on va se faire macaronner."
                            }
                        ]
                    }
                ],
