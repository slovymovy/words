                    {
                        "translation_id": "789457b7-e0d4-40ff-9f90-2256818f209c",
                        "source_entry_id": "34911c2b-d6a4-3cb8-9b24-a4e862c140e7",
                        "source_sense_id": "8d5f2582-f898-39b6-ae1f-f99f0116c72d",
                        "source_sense_description": "Fait trop vite et sans soin",
                        "target_lang_word": "schlampig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlampig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa2907d-cbcc-3716-9873-9a85c61ab50e",
                                        "entry_id": "dcbadbf3-6579-3600-908e-0b87d8a5a1b9",
                                        "glosses": [
                                            "ungepflegt, unordentlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e1f7fa-e549-4612-9ff7-5d486b3cd799",
                                                "sense_id": "4fa2907d-cbcc-3716-9873-9a85c61ab50e",
                                                "text": "Sein schlampiges Äußeres lässt nichts Gutes erwarten."
                                            },
                                            {
                                                "example_id": "1cf7bc2b-b370-4f7d-817b-1c46417b1c07",
                                                "sense_id": "4fa2907d-cbcc-3716-9873-9a85c61ab50e",
                                                "text": "„Sie war so unglaublich schillernd und elegant, daß Isabel sich daneben schlampig und langweilig vorkam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                        "entry_id": "dcbadbf3-6579-3600-908e-0b87d8a5a1b9",
                                        "glosses": [
                                            "nachlässig, ohne Sorgfalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b27be1f-1f4f-46d2-9464-f5cb52dd0aaf",
                                                "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                                "text": "Die Arbeit wurde so schlampig ausgeführt, dass sie gleich nochmals getätigt werden musste."
                                            },
                                            {
                                                "example_id": "2af55a17-eb81-498f-9753-b60333b9376b",
                                                "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                                "text": "„Isabel dachte an ihren schlampig geführten Ordner »Auf bessere Zeiten«, der mit keinem Aktensystem in der Kripo verbunden war.“"
                                            },
                                            {
                                                "example_id": "011c03bf-1cb7-4635-8baf-af1aaee87641",
                                                "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                                "text": "„[…] bearbeitete Justus pünktlich und zuverlässig, ganz zur Freude seiner Eltern und zum Nutzen von Jasmin, die in diesem Punkt eher schlampig war und unzuverlässig und so häufig auf Justus zurückgriff und hastig Anfang und Ende der Texte in ihr Aufgabenheft kritzelte, den Mittelteil ließ sie aus Zeitnot meist weg, den Lehrern fiel dies sowieso nur in den seltensten Fällen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6280cdc-a3b4-4b27-8881-438dca8fca1c",
                        "source_entry_id": "34911c2b-d6a4-3cb8-9b24-a4e862c140e7",
                        "source_sense_id": "8d5f2582-f898-39b6-ae1f-f99f0116c72d",
                        "source_sense_description": "Fait trop vite et sans soin",
                        "target_lang_word": "slipshod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slipshod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "678884ae-0a5a-32b1-9378-2eafe9f282af",
                                        "entry_id": "67ae6767-5e4c-344b-b49a-a9335c9b9421",
                                        "glosses": [
                                            "Done poorly or too quickly; slapdash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e670da1-c22a-4224-925f-f4d5dab7c4e8",
                                                "sense_id": "678884ae-0a5a-32b1-9378-2eafe9f282af",
                                                "text": "Surely there is not another language that is so slipshod and systemless, and so slippery and elusive to the grasp."
                                            },
                                            {
                                                "example_id": "4a03e8d9-a1f6-49b5-b358-5fabf1a272ec",
                                                "sense_id": "678884ae-0a5a-32b1-9378-2eafe9f282af",
                                                "text": "Newspapers pointed at greedy contractors who used shoddy materials, slipshod methods and the help of corrupt officials to bypass building codes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2879ee12-7034-30fc-9c5e-b83775ec6b83",
                                        "entry_id": "67ae6767-5e4c-344b-b49a-a9335c9b9421",
                                        "glosses": [
                                            "Wearing slippers or similarly open shoes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbf661f-21e3-474d-9fe0-1009dd6ae51e",
                                                "sense_id": "2879ee12-7034-30fc-9c5e-b83775ec6b83",
                                                "text": "[T]hey wandered up and down hardly remembering the ways untrodden by their feet so long, and crying [...] as they slunk off in their rags, and dragged their slipshod feet along the pavement."
                                            },
                                            {
                                                "example_id": "90e7c1c8-8606-4aa4-b2d3-80e5b4f4f2db",
                                                "sense_id": "2879ee12-7034-30fc-9c5e-b83775ec6b83",
                                                "text": "That glossy, well-brushed individual, who lets himself in with a latch-key at the front door at night, is a very different being from the slipshod wretch who growls of mornings for hot water at the door of the kitchen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75a4e91f-ed21-494c-9e4e-0e8a8c6f21d4",
                        "source_entry_id": "34911c2b-d6a4-3cb8-9b24-a4e862c140e7",
                        "source_sense_id": "8d5f2582-f898-39b6-ae1f-f99f0116c72d",
                        "source_sense_description": "Fait trop vite et sans soin",
                        "target_lang_word": "slapdash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slapdash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb3589a-dc83-3f02-98c6-c537d8e56607",
                                        "entry_id": "b1fde496-b206-3c83-8fb8-6ba0e700012f",
                                        "glosses": [
                                            "Produced or carried out hastily; haphazard; careless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1341cf5e-8f47-4a1d-a4d9-1e3f1de3e24b",
                                                "sense_id": "dbb3589a-dc83-3f02-98c6-c537d8e56607",
                                                "text": "They had seen Poland, and that was the sort of slovenly, slapdash place they were used to, but once across the German frontier they found everything—crops, roads, buildings—uncannily different."
                                            },
                                            {
                                                "example_id": "0a9abd8a-2a75-4763-b35c-793245bfb77a",
                                                "sense_id": "dbb3589a-dc83-3f02-98c6-c537d8e56607",
                                                "text": "When you're in the front entrance, get a feel for what's going on. Tours are never timed to coincide with breaks but if there are any children milling about, see what they're up to. If they're on a dutiful errand, for example delivering registers, the school probably encourages a responsible attitude. If they're play-fighting in the corridor without consequence, it tells a less impressive story and could mean a slapdash approach to discipline."
                                            },
                                            {
                                                "example_id": "18373335-dafc-46d3-929b-954e900e3b80",
                                                "sense_id": "dbb3589a-dc83-3f02-98c6-c537d8e56607",
                                                "text": "Valérie Pisano, the chief executive of Mila – the Quebec Artificial Intelligence Institute – said the slapdash approach to safety in AI systems would not be tolerated in any other field."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slapdash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "650e6260-8db7-342b-a6a0-cb5e969f1e93",
                                        "entry_id": "593471a3-352e-34da-9a9a-15cce2cf94e6",
                                        "glosses": [
                                            "In a hasty or careless manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07bb09fb-f361-3419-bde4-531605d56b1f",
                                        "entry_id": "593471a3-352e-34da-9a9a-15cce2cf94e6",
                                        "glosses": [
                                            "Directly, right there; slap-bang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e491909b-d355-4779-ac4f-7355acb1da78",
                                                "sense_id": "07bb09fb-f361-3419-bde4-531605d56b1f",
                                                "text": "Van Eyck signed his portrait of the Arnolfinis slapdash in the center of the painting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "338ceb11-0e26-3964-9bb1-aa8ea668075a",
                                        "entry_id": "593471a3-352e-34da-9a9a-15cce2cf94e6",
                                        "glosses": [
                                            "With a slap; all at once; slap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff235b8-fcff-4505-b59c-8c52eb4597d2",
                                                "sense_id": "338ceb11-0e26-3964-9bb1-aa8ea668075a",
                                                "text": "And yet, slap dash, is all again\nIn every sinew, nerve, and vein;\nRuns here and there, like Hamlet's ghost"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slapdash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f601cf-6eb0-393b-8b18-9fb06afa2c9d",
                                        "entry_id": "2d7037d3-f076-38bb-91bc-f50f68e24d69",
                                        "glosses": [
                                            "To apply, or apply something to, in a hasty, careless, or rough manner; to roughcast."
