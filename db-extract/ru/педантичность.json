                                        "entry_id": "3c660bec-d08a-38e2-9435-91b00d28a4bb",
                                        "glosses": [
                                            "comportamento eccessivamente preciso e puntiglioso, con un'attenzione quasi maniacale per i dettagli, una sfumatura di pedanteria e una tendenza all'esigere troppo dagli altri."
                                        ],
