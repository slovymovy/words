                                "target_senses": [
                                    {
                                        "sense_id": "89f4d611-90b0-3829-9a41-5120213d55a7",
                                        "entry_id": "262ff26a-5181-38ed-95be-8d8abca84038",
                                        "glosses": [
                                            "Going beyond the partisan; ecumenical, universal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a31a18-fa30-4088-9da5-9f45cb3f1609",
                                                "sense_id": "89f4d611-90b0-3829-9a41-5120213d55a7",
                                                "text": "As a matter of fact, it was national or transpartisan policy and stood outside daily political controversies."
                                            },
                                            {
                                                "example_id": "4954799f-4c48-4066-acce-4d0be8a268ca",
                                                "sense_id": "89f4d611-90b0-3829-9a41-5120213d55a7",
                                                "text": "Through transpartisan dialogue — and simply getting to know each other as human beings — people began to shed their biases and preconceptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
