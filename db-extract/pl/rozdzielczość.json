                "senses": [
                    {
                        "sense_id": "008f7857-1b36-34e4-ba17-a088c6d858c1",
                        "entry_id": "4e3a8ca5-bf76-3c36-b891-13d065ea8e5a",
                        "glosses": [
                            "miara dokładności obrazowania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684ade33-384c-4355-9fdb-6325296f4086",
                                "sense_id": "008f7857-1b36-34e4-ba17-a088c6d858c1",
                                "text": "Pragnę nabyć nową kartę graficzną, aby zwiększyć rozdzielczość obrazu, włączyć antyaliasing i móc podłączyć drugi monitor."
                            },
                            {
                                "example_id": "9635091c-add5-468b-9808-55ff6e73c585",
                                "sense_id": "008f7857-1b36-34e4-ba17-a088c6d858c1",
                                "text": "Na liczbę znaków, przypadającą na jeden kwadrat bieżący komputerowego składu, ma wpływ rozdzielczość wybranego urządzenia drukującego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99588ead-a062-41ef-9501-57cbfa0edb2c",
                        "source_entry_id": "4e3a8ca5-bf76-3c36-b891-13d065ea8e5a",
                        "source_sense_id": "008f7857-1b36-34e4-ba17-a088c6d858c1",
                        "target_lang_word": "resolution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resolution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea7b117-0e60-34b7-959d-13e4b04c8cb3",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "A firm decision or an official decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45e23900-368f-37b9-a649-cc8b590387c8",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "A strong will; the state of being resolute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00473d69-4eb8-4ae2-9157-20d10dfb8105",
                                                "sense_id": "45e23900-368f-37b9-a649-cc8b590387c8",
                                                "text": "His stalwart resolution is perhaps admirable, perhaps foolish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c455fc2f-40ac-34c4-9db4-5515cd120f95",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "A statement of intent, a vow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2eaca0-a0af-48d7-be61-0d2919e77eb0",
                                                "sense_id": "c455fc2f-40ac-34c4-9db4-5515cd120f95",
                                                "text": "By February, most New Year’s resolutions are forgotten."
                                            },
                                            {
                                                "example_id": "7f452541-e537-443b-bf8b-c70f70ebf2d5",
                                                "sense_id": "c455fc2f-40ac-34c4-9db4-5515cd120f95",
                                                "text": "My resolution is to cut back on the fast food this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd70e8f-892d-3603-b4f1-cd6216f70eb1",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "The act of discerning detail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b118d6e6-a2ef-4e25-9963-053ba751ff7a",
                                                "sense_id": "5dd70e8f-892d-3603-b4f1-cd6216f70eb1",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42365fba-6b65-3337-8fe7-6bb7b1262306",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "The degree of fineness with which an image can be recorded or produced, often expressed as the number of pixels per unit of length (typically an inch)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f1b0a91-391d-4e3b-bdfe-b90d2057cb9d",
                                                "sense_id": "42365fba-6b65-3337-8fe7-6bb7b1262306",
                                                "text": "Printing at higher resolution will cause a reduction in performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d5df9c-fa0c-33d1-b72f-c552c8f445a8",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "The number of pixels in an image being stored or displayed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a71252-e4ec-4e56-b64e-8c5ddc4493ad",
                                                "sense_id": "08d5df9c-fa0c-33d1-b72f-c552c8f445a8",
                                                "text": "This monitor's maximum resolution is 1600 × 1200."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c515ea73-66dd-37b1-8705-0a5e9bd8bc7e",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "The process of determining the meaning of a symbol or address; the process of executing a link to it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d95096e4-d78a-4256-800f-1d11baaf4efc",
                                                "sense_id": "c515ea73-66dd-37b1-8705-0a5e9bd8bc7e",
                                                "text": "name resolution"
                                            },
                                            {
                                                "example_id": "493eaf0b-22d4-46e5-b4dd-d799f87fd29d",
                                                "sense_id": "c515ea73-66dd-37b1-8705-0a5e9bd8bc7e",
                                                "text": "link resolution"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a54e1407-3dd7-3d9c-b398-bf7b58e7ebfc",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "The act or process of resolving: solving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede6dccd-8661-4e16-bc6f-c316fa13a6d9",
                                                "sense_id": "a54e1407-3dd7-3d9c-b398-bf7b58e7ebfc",
                                                "text": "the resolution of an equation"
                                            },
                                            {
                                                "example_id": "d04e0552-47e7-4101-bf82-c8a1fa1e4acd",
                                                "sense_id": "a54e1407-3dd7-3d9c-b398-bf7b58e7ebfc",
                                                "text": "Near-synonyms: evaluation, calculation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8de83fab-2a39-3ab3-bbe6-f7b58e74695c",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "An exact sequence of modules (or, objects in the same category as M) either terminating in M or such that M is the homology at degree zero. See Resolution (algebra)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2700158b-7551-361b-b375-ba7b30032c71",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "A formal statement adopted by an assembly, or during any other formal meeting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1773fdef-9f4d-4a74-8ad2-6bc8854f9db1",
                                                "sense_id": "2700158b-7551-361b-b375-ba7b30032c71",
                                                "text": "The resolution was passed by a two-thirds majority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00dc62f4-14ed-3e87-80d5-d8204748ffc7",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "The separation of the constituent parts (of a spectrum etc)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d70671d3-2036-3bb2-af96-f0106155d4f4",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
