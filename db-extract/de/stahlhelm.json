                ],
                "senses": [
                    {
                        "sense_id": "a99fb97d-4402-38f1-ad94-50fa20957649",
                        "entry_id": "f5a8e8a9-4db6-3088-9191-f2fb998abfdf",
                        "glosses": [
                            "Casque d’acier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d703aa-1161-45ed-8951-ed8b5683e0e1",
                                "sense_id": "a99fb97d-4402-38f1-ad94-50fa20957649",
                                "text": "Kein unangenehm schweigsamer Posten mit abweisender Miene und weißem Stahlhelm steht hinter ihm."
                            },
                            {
                                "example_id": "41d6b287-73a3-4f22-8f85-6701f7e34c2d",
                                "sense_id": "a99fb97d-4402-38f1-ad94-50fa20957649",
                                "text": "Les motards se ressemblaient tous : ils étaient vieux, bedonnants, portant un casque rappelant vaguement le Stahlhelm de l'armée allemande et des nazis."
                            }
                        ]
                    },
                    {
                        "sense_id": "850ad7f6-9b2b-3ae7-aec2-03267614396b",
                        "entry_id": "f5a8e8a9-4db6-3088-9191-f2fb998abfdf",
                        "glosses": [
                            "Stahlhelm, organisation paramilitaire allemande sous la République de Weimar."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
