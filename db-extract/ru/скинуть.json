                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4ec3cc-3d09-4307-85c0-35c882b184dc",
                                "sense_id": "4727edee-e6cb-32de-9e19-636291af7c33",
                                "text": "Конь ски́нул седока́.",
                                "translation": "The horse threw off its rider.",
                                "english": "The horse threw off its rider."
                            },
                            {
                                "example_id": "6badda3f-129d-4368-bd15-65c6c8fa2ab6",
                                "sense_id": "4727edee-e6cb-32de-9e19-636291af7c33",
                                "text": "ски́нуть снег с кры́ши",
                                "translation": "to throw the snow off the roof",
                                "english": "to throw the snow off the roof"
                            }
                        ]
                    },
                    {
                        "sense_id": "264fefcf-67eb-3eae-bef4-b8fc23066e16",
