                            {
                                "example_id": "4f990c95-def5-4032-a883-84de3f56ccf7",
                                "sense_id": "b77a9948-36a7-3126-be9a-19c111054dd9",
                                "text": "Entrez dans un monde de terreur surnaturelle et affrontez une horreur sans nom : trouillomètre puissance 10 garanti !"
