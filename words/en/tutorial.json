                            }
                        ]
                    }
                },
                {
                    "sense_id": "032f8322-b4e1-3dba-b7aa-50d25406143a",
                    "sense_definition": "A self-paced learning exercise or interactive lesson, often within software or a game, designed to teach the user how to operate it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should play the <w>tutorial</w> first to learn the game controls.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит сначала пройти <w>обучение</w>, чтобы изучить управление в игре.",
                                "zh": "你应该先玩一下<w>新手引导</w>，熟悉游戏操作。",
                                "es": "Deberías jugar el <w>tutorial</w> primero para aprender los controles del juego."
                            }
                        },
                        {
                            "text": "The app includes a helpful <w>tutorial</w> for new users to get started.",
                            "target_lang_translations": {
                                "ru": "В приложении есть полезное <w>вводное руководство</w> для новых пользователей, чтобы начать работу.",
                                "zh": "这款应用包含一个实用的<w>入门教程</w>，帮助新用户上手。",
                                "es": "La aplicación incluye un <w>tutorial</w> útil para que los nuevos usuarios comiencen."
                            }
                        }
                    ],
                    "synonyms": [
                        "walkthrough",
                        "introduction"
                    ],
                    "common_phrases": [
                        "skip the tutorial",
                        "interactive tutorial",
                        "game tutorial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упражнение для самостоятельного обучения или интерактивный урок, часто внутри программы или игры, предназначенный для обучения пользователя управлению ею.",
                        "zh": "一种自定进度的学习练习或互动课程，通常内置于软件或游戏中，旨在教用户如何操作。",
                        "es": "Ejercicio de aprendizaje a ritmo propio o lección interactiva, a menudo dentro de un software o juego, diseñado para enseñar al usuario cómo utilizarlo."
                    },
                    "translations": {
