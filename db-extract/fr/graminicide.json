                "senses": [
                    {
                        "sense_id": "f7bca8fa-c458-3a8d-b1ed-27a4065d4edf",
                        "entry_id": "08b3618b-9592-352d-a5dc-0fa75d73b813",
                        "glosses": [
                            "Herbicide des graminées"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cd5da5-90e3-479b-a943-b421d7fa5d71",
                                "sense_id": "f7bca8fa-c458-3a8d-b1ed-27a4065d4edf",
                                "text": "Ce graminicide, très sélectif pour le blé et le colza, agit par arrêt de la croissance des cellules déjà formées; la concurrence exercée par la culture entraîne alors la destruction de la mauvaise herbe."
                            },
                            {
                                "example_id": "4e9a6e10-266d-40ca-87b1-a1c7e9ac9bd3",
                                "sense_id": "f7bca8fa-c458-3a8d-b1ed-27a4065d4edf",
                                "text": "S’il paraît clair que la bentazone inhibe la pénétration de divers graminicides, il n’en n'est pas de même pour le 2,4-D qui, selon les études, diminue, n’affecte pas ou augmente la pénétration du diclofop-méthyl chez la folle avoine."
                            }
                        ]
                    }
