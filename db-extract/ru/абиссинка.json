                                        "entry_id": "d5dda3da-5896-3cbf-9506-7160fa8b4416",
                                        "glosses": [
                                            "Bewohnerin des ehemals Abessinien genannten jetzigen Äthiopiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003c12bb-4708-4b19-a05f-fbff43bcfcf0",
                                                "sense_id": "e093c789-70bb-3741-b64d-f645b4cfa7a2",
                                                "text": "Die Äthiopierinnen wurden ehedem Abessinierinnen genannt."
                                            },
                                            {
                                                "example_id": "66bfbb67-cde9-4e03-b3bb-d25750216878",
                                                "sense_id": "e093c789-70bb-3741-b64d-f645b4cfa7a2",
                                                "text": "„Zurück in Aden hat er eine Affäre mit einer Abessinierin, aber auch das geht schief.“"
                                            }
