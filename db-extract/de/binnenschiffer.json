                        "entry_id": "cecd29ee-24cf-33dd-ab3f-4b06a3c31ded",
                        "glosses": [
                            "Person, die ein Schiff auf einem Binnengewässer oder einer Binnenwasserstraße fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feba7415-65f0-42ee-880d-5faa4be9d750",
                                "sense_id": "2976ba6b-2815-3b41-90b4-510b14600e28",
                                "text": "„Die Trockenheit versetzt die Winzer am Rhein in Hochstimmung – und wird für die Binnenschiffer zum Ärgernis.“"
                            },
                            {
                                "example_id": "fe458fb0-66ba-47c9-9568-0ad3cd211a86",
                                "sense_id": "2976ba6b-2815-3b41-90b4-510b14600e28",
                                "text": "„Am Oberrhein müssen Binnenschiffer eine Zwangspause einlegen.“"
                            },
                            {
                                "example_id": "406bb37e-2b8c-4779-99d4-81d3e69e06a5",
                                "sense_id": "2976ba6b-2815-3b41-90b4-510b14600e28",
                                "text": "„Nun haben Binnenschiffer eine Suchaktion nach dem Vermissten gestartet - und sprechen von großer Hoffnung.“"
                            }
                        ],
