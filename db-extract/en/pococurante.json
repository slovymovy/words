                        "glosses": [
                            "Apathetic, indifferent or nonchalant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f5900eb-bdc4-41e6-b740-bb1d7be7b1c1",
                                "sense_id": "2115d370-c573-3177-b272-15edba2805ea",
                                "text": "The Treasury was entrusted to the pococurante capacity of Grafton, the Exchequer to the erratic genius of Charles Townshend."
                            }
                        ]
                    }
                ],
                "translations": [
