                "senses": [
                    {
                        "sense_id": "46b60e60-446d-3a6a-a50e-b55d8d751714",
                        "entry_id": "6524f5fb-848d-3c95-8289-5a23e3cca92a",
                        "glosses": [
                            "Épouse d’un margrave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf2d21f-8733-4c01-b9ba-9248512e6786",
                                "sense_id": "46b60e60-446d-3a6a-a50e-b55d8d751714",
                                "text": "Parmi ses quatorze enfants, dont sept garçons et sept filles, le prince royal, Frédéric, et sa sœur Wilhelmine, la future margravine de Baireuth, étaient surtout en butte à ses mauvais traitements."
                            },
                            {
                                "example_id": "e69e7159-085f-47c6-8bb3-561d4bc332f3",
                                "sense_id": "46b60e60-446d-3a6a-a50e-b55d8d751714",
                                "text": "La belle margravine Ida d’Autriche, qui chevauchait dans l’armée bavaroise, disparut sans qu’on pût connaître son sort : morte ou captive au fond de quelque harem."
                            }
                        ]
                    },
