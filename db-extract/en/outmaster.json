                        "glosses": [
                            "To overcome; to win or prevail in a competition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61cae540-b801-41bc-8e1c-c6df0c1687f4",
                                "sense_id": "190d11fb-c25d-3f25-a3ab-c53ef11e765a",
                                "text": "Pleas'd with the guilt, yet envy-stung at heart To stand outmaster'd in his own black art!"
                            },
                            {
                                "example_id": "30b4ff2d-344f-4615-bda4-639e042ec1b5",
                                "sense_id": "190d11fb-c25d-3f25-a3ab-c53ef11e765a",
                                "text": "He would outmaster, outflank, the mystery of iniquity by the mystery of godliness."
                            },
                            {
                                "example_id": "003745f1-d5e6-4d55-9251-21e6511fe4ad",
                                "sense_id": "190d11fb-c25d-3f25-a3ab-c53ef11e765a",
                                "text": "Don't try to outmaster the master."
                            },
                            {
                                "example_id": "aa53e790-7c73-4246-9f8e-0177e2ecd66b",
                                "sense_id": "190d11fb-c25d-3f25-a3ab-c53ef11e765a",
                                "text": "The great, hulking brute rubbed his jaw and lunged at Keel, but years of the finest royal training only made it easy for the angry merprince to outmaster the human."
                            }
                        ]
                    }
