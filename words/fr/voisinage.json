    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "488e9049-54ac-3972-9910-9f826d4748bb",
                    "sense_definition": "Zone ou espace situé à proximité immédiate d'un lieu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace_proximite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'y a aucun commerce d'alimentation dans le <w>voisinage</w> immédiat de la gare."
                        },
                        {
                            "text": "Les enfants jouent souvent dans le <w>voisinage</w> sans s'éloigner de la maison."
                        }
                    ],
                    "synonyms": [
                        "alentours",
                        "environs",
                        "quartier"
                    ],
                    "common_phrases": [
                        "dans le voisinage"
                    ]
                },
                {
                    "sense_id": "01e6cbd7-8dd6-3bd1-9b13-ae6d322af47c",
                    "sense_definition": "Ensemble des personnes qui habitent à proximité les unes des autres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations_humaines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La musique trop forte pendant la nuit a fini par déranger tout le <w>voisinage</w>."
                        },
                        {
                            "text": "Tout le <w>voisinage</w> s'est réuni dans la cour pour célébrer la fête annuelle."
                        }
                    ],
                    "synonyms": [
                        "entourage"
                    ],
                    "common_phrases": [
                        "déranger le voisinage"
                    ]
                },
                {
                    "sense_id": "75c0f688-0f87-3933-94a6-b9e6610b1163",
                    "sense_definition": "Ensemble des rapports ou des relations existant entre des personnes vivant à proximité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relations_humaines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un conflit de <w>voisinage</w> a éclaté au sujet de la hauteur de la haie mitoyenne."
                        },
                        {
                            "text": "Ils entretiennent de bonnes relations de <w>voisinage</w> depuis leur emménagement dans l'immeuble."
                        }
                    ],
                    "synonyms": [
                        "entente",
                        "fréquentation"
                    ],
                    "common_phrases": [
                        "conflit de voisinage",
                        "relations de voisinage"
                    ]
                },
                {
                    "sense_id": "cf626aeb-e5df-3deb-9584-cc50403cf614",
                    "sense_definition": "État ou fait d'être situé à une faible distance dans l'espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_proximite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La température de l'eau reste fraîche au <w>voisinage</w> des sources de montagne."
                        },
                        {
                            "text": "Le <w>voisinage</w> de l'autoroute provoque des nuisances sonores continuelles pour les résidents."
                        }
                    ],
                    "synonyms": [
                        "approche",
                        "proximité"
                    ],
                    "common_phrases": [
                        "au voisinage de"
                    ]
                },
                {
                    "sense_id": "5d64c223-81ab-3c12-ae19-613e346d01c7",
                    "sense_definition": "En topologie, ensemble contenant un ensemble ouvert qui comprend un point donné.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur étudie la continuité de la fonction dans un <w>voisinage</w> du point zéro."
                        },
                        {
                            "text": "Tout intervalle ouvert contenant cette valeur constitue un <w>voisinage</w> valide dans cet espace."
                        }
                    ],
                    "common_phrases": [
                        "voisinage d'un point"
                    ]
                }
            ]
        }
    ]
