                "senses": [
                    {
                        "sense_id": "0aab1e27-6311-3ab5-a3e5-f5cbe4020597",
                        "entry_id": "57faf846-2db4-323d-bfaa-0d75e83dab9c",
                        "glosses": [
                            "полигр. способ плоской печати с бумажного листа с помощью гектографа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700e9665-b4f6-481f-a5f1-c3d0cb4695e4",
                                "sense_id": "0aab1e27-6311-3ab5-a3e5-f5cbe4020597",
                                "text": "Гектографию используют и в наши дни — в так называемой «оперативной полиграфии»."
                            }
                        ]
                    },
                    {
                        "sense_id": "d55c05bf-1647-383a-a7f1-a9267aa32926",
                        "entry_id": "57faf846-2db4-323d-bfaa-0d75e83dab9c",
                        "glosses": [
                            "разг. отпечаток, полученный с помощью такого способа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a0ccc1-e9f8-4169-b583-d6022eb62684",
                                "sense_id": "d55c05bf-1647-383a-a7f1-a9267aa32926",
                                "text": "Они частию вошли в 12-й том его сочинений, частию разошлись в массе рукописных снимков, литографий, гектографии и т. д."
                            }
                        ]
                    }
