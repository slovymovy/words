{
    "word_family": [
        "имя",
        "именной",
        "именовать"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0412aa8a-2466-34bc-a896-3644fd6f047b",
                    "sense_definition": "Употребляется для выделения и усиления значения слова или фразы, к которым относится.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всё произошло <w>именно</w> так, как я и предполагал.",
                            "target_lang_translations": {
                                "en": "Everything happened <w>exactly</w> as I assumed.",
                                "zh": "事情发生的过程<w>正是</w>我所预料的那样。"
                            }
                        },
                        {
                            "text": "Статья появилась в газете <w>именно</w> в пятницу.",
                            "target_lang_translations": {
                                "en": "The article appeared in the newspaper <w>precisely</w> on Friday.",
                                "zh": "这篇文章<w>恰恰</w>是在周五见报的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как раз",
                        "точно"
                    ],
                    "common_phrases": [
                        "именно так",
                        "именно поэтому",
                        "именно он"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to highlight and emphasize the meaning of a word or phrase.",
                        "zh": "用于强调或突出某个词或短语的含义。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "precise correspondence"
                            },
                            {
                                "target_lang_word": "precisely",
                                "target_lang_sense_clarification": "formal emphasis"
                            },
                            {
                                "target_lang_word": "specifically",
                                "target_lang_sense_clarification": "singling out"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "emphatic exactness"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正是",
                                "target_lang_sense_clarification": "用于强调事实或情况的准确性"
                            },
                            {
                                "target_lang_word": "恰恰",
                                "target_lang_sense_clarification": "用于强调与预期或事实完全吻合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b1cd858-1a38-3e86-8ce1-01468dfc5c7a",
                    "sense_definition": "Употребляется для введения пояснения или перечисления.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В году четыре сезона, а <w>именно</w> — весна, лето, осень и зима.",
                            "target_lang_translations": {
                                "en": "There are four seasons in a year, <w>namely</w> spring, summer, autumn, and winter.",
                                "zh": "一年有四个季节，<w>即</w>春、夏、秋、冬。"
                            }
                        },
                        {
                            "text": "Она живёт в Нью-Йорке, а <w>именно</w> — на Уолл-стрит.",
                            "target_lang_translations": {
                                "en": "She lives in New York, <w>specifically</w> on Wall Street.",
                                "zh": "她住在纽约，<w>也就是</w>华尔街。"
                            }
                        }
                    ],
                    "synonyms": [
                        "то есть",
                        "в частности"
                    ],
                    "common_phrases": [
                        "а именно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to introduce an explanation or enumeration.",
                        "zh": "用于引出解释或列举具体内容。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "namely",
                                "target_lang_sense_clarification": "introducing specific details"
                            },
                            {
                                "target_lang_word": "that is",
                                "target_lang_sense_clarification": "clarification"
                            },
                            {
                                "target_lang_word": "specifically",
                                "target_lang_sense_clarification": "narrowing down"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "即",
                                "target_lang_sense_clarification": "用于引出具体说明"
                            },
                            {
                                "target_lang_word": "也就是",
                                "target_lang_sense_clarification": "用于进一步解释或澄清"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f2d0ed7b-81a0-37ac-9c3c-b8e95154cc6d",
                    "sense_definition": "Выражает подтверждение или полное согласие с собеседником.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Вы мне это говорите? — <w>Именно</w>, Вам!",
                            "target_lang_translations": {
                                "en": "— Are you saying this to me? — <w>Exactly</w>, to you!",
                                "zh": "— 你是在跟我说吗？— <w>没错</w>，就是跟你说！"
                            }
                        },
                        {
                            "text": "— Мы же договорились сделать это. — <w>Именно</w>, поэтому мы это и делаем.",
                            "target_lang_translations": {
                                "en": "— But we agreed to do this. — <w>Precisely</w>, that is why we are doing it.",
                                "zh": "— 我们不是说好要做这件事吗？— <w>正是如此</w>，所以我们才在做。"
                            }
                        }
                    ],
                    "synonyms": [
                        "точно",
                        "есте́ственно",
                        "коне́чно"
                    ],
                    "common_phrases": [
                        "вот именно"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses confirmation or complete agreement with the interlocutor.",
                        "zh": "表示对谈话者的确认或完全同意。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "expressing agreement"
                            },
                            {
                                "target_lang_word": "precisely",
                                "target_lang_sense_clarification": "confirming a statement"
                            },
                            {
                                "target_lang_word": "indeed",
                                "target_lang_sense_clarification": "formal confirmation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没错",
                                "target_lang_sense_clarification": "表示完全同意对方的观点"
                            },
                            {
                                "target_lang_word": "正是如此",
                                "target_lang_sense_clarification": "正式地确认对方所言属实"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}