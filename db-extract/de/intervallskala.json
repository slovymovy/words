                "senses": [
                    {
                        "sense_id": "831fa345-ecad-3149-9d49-47ac8fdbc578",
                        "entry_id": "988e0453-c2f7-3667-a205-acfdcd77185f",
                        "glosses": [
                            "Skala, die Merkmalsausprägungen darstellt, welche geordnet werden können und deren Abstände interpretierbar sind, die aber keinen Nullpunkt aufweisen"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "7cfd8ae7-91eb-4263-a9a4-5580125116e3",
                                "sense_id": "831fa345-ecad-3149-9d49-47ac8fdbc578",
                                "text": "Die Ausprägungen des Merkmals „Temperatur“ in der Einheit Celsius sind nicht mit einer Verhältnisskala, sondern nur mit einer Intervallskala darstellbar, da man zwar zwei Temperaturwerte vergleichen kann, aber auf dieser Grundlage keine Aussage „Es ist doppelt so warm wie gestern“ möglich ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
