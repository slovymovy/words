                    "frequency": "High",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont acheté un bel <w>ornement</w> en verre pour leur sapin de Noël."
                        },
                        {
                            "text": "Cette plante verte sert d'<w>ornement</w> au centre de la table du salon."
                        }
                    ],
                    "common_phrases": [
