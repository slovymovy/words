                                        "examples": [
                                            {
                                                "example_id": "2b347d39-9eb9-416d-b21c-b78d46eaa152",
                                                "sense_id": "77a2eab8-ce99-31ed-a095-a63f67f5846f",
                                                "text": "Und dann musste ich meinen Fuchs noch irgendwie unterbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"17\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fuchs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                        "entry_id": "f0e0d81f-b1b9-3de6-96a1-f91a2e990499",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b925478a-6747-4a20-b816-1ff45e424822",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Frau Fuchs ist nett."
                                            },
                                            {
                                                "example_id": "e647d999-3b38-45a7-bf16-b57339da2021",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Wir sind heute Abend bei Fuchs eingeladen."
                                            },
                                            {
                                                "example_id": "26776a82-8d8c-4d3d-8b31-89722777d7a1",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Frau Fuchs ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "58c3484a-751e-455a-be85-4678f3758b36",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Herr Fuchs wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4843da6f-cb1f-454b-8d28-0f2ef6505ee9",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Die Fuchsens fahren heute nach Reinickendorf."
                                            },
                                            {
                                                "example_id": "1f2ad99e-adc7-4fe3-9c1a-b34133cf096b",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Der Fuchs trägt nie die Schals, die die Fuchs ihm strickt."
                                            },
                                            {
                                                "example_id": "df31b941-de0f-4bab-a66b-e733b9ed5f1a",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fuchs kommt, geht der Herr Fuchs.“"
                                            },
                                            {
                                                "example_id": "91411f38-75cf-4c7a-849e-fa7ec0d5c0fe",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Fuchs kommt und geht."
                                            },
                                            {
                                                "example_id": "e4fd63c6-d79d-4b77-90cf-da1c95e042ee",
                                                "sense_id": "ed2994ed-5c92-3959-aabb-35263ce1be01",
                                                "text": "Fuchs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
