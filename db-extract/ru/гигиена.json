                                        "examples": [
                                            {
                                                "example_id": "5db4f664-387f-43fb-948e-3c013b11cf05",
                                                "sense_id": "2b480a97-a006-315c-940e-970b7629eeb3",
                                                "text": "Krajská hygiena ruší na Karvinsku mimořádná opatření, i když nemocní na Darkově přibývají."
                                            }
