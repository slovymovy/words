{
    "word_family": [
        "parallélisme",
        "parallèlement",
        "parallélogramme",
        "parallélépipède"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9c195f9-6e5a-3273-a8f5-e6d5e5c34614",
                    "sense_definition": "Qui est situé à égale distance d'une autre ligne ou surface et ne la rencontre jamais.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux avenues sont <w>parallèles</w> et traversent toute la ville d'est en ouest."
                        },
                        {
                            "text": "Les rails du train forment deux voies parfaitement <w>parallèles</w>."
                        }
                    ],
                    "antonyms": [
                        "perpendiculaire",
                        "sécant"
                    ],
                    "common_phrases": [
                        "lignes parallèles",
                        "droites parallèles"
                    ]
                },
                {
                    "sense_id": "57b4a53e-1478-35e8-8c08-1108c25369ef",
                    "sense_definition": "Qui se produit en même temps ou de manière analogue ; simultané ou comparable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux chercheurs mènent une enquête <w>parallèle</w> sans communiquer entre eux."
                        },
                        {
                            "text": "La hausse des prix et la baisse du pouvoir d'achat sont des phénomènes <w>parallèles</w>."
                        }
                    ],
                    "common_phrases": [
                        "action parallèle",
                        "vies parallèles"
                    ]
                },
                {
                    "sense_id": "53501905-cb6b-3f82-8ce4-2444b9b0a88e",
                    "sense_definition": "Qui fonctionne en dehors des circuits officiels, de manière alternative ou clandestine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non_officiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux produits de contrebande se vendent sur le marché <w>parallèle</w>."
                        },
                        {
                            "text": "Une économie <w>parallèle</w> s'est développée au fil des années."
                        }
                    ],
                    "common_phrases": [
                        "marché parallèle",
                        "circuit parallèle"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbb09bc2-83e8-30a7-ba8f-dafc05313048",
                    "sense_definition": "Cercle imaginaire tracé sur le globe terrestre, parallèle à l'équateur et servant à mesurer la latitude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le trente-huitième <w>parallèle</w> sépare la péninsule coréenne en deux zones distinctes."
                        },
                        {
                            "text": "Toutes les villes situées sur un même <w>parallèle</w> ont exactement la même latitude."
                        }
                    ],
                    "antonyms": [
                        "méridien"
                    ]
                },
                {
                    "sense_id": "56210de6-0842-37c3-993a-61953eec8d41",
                    "sense_definition": "Ligne droite qui ne coupe jamais une autre ligne donnée dans un plan.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cours de géométrie, les élèves apprennent à tracer une <w>parallèle</w> à la règle."
                        },
                        {
                            "text": "Par un point donné, il ne passe qu'une seule <w>parallèle</w> à cette droite."
                        }
                    ],
                    "common_phrases": [
                        "tracer une parallèle"
                    ]
                },
                {
                    "sense_id": "4459583d-09c2-362c-a09d-03768b13eed7",
                    "sense_definition": "Comparaison méthodique et détaillée entre deux personnes ou deux choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous demande d'établir un <w>parallèle</w> entre ces deux œuvres littéraires."
                        },
                        {
                            "text": "Il est difficile de faire un <w>parallèle</w> entre ces deux événements historiques."
                        }
                    ],
                    "common_phrases": [
                        "faire un parallèle",
                        "établir un parallèle"
                    ]
                }
            ]
        }
    ]
}