                "senses": [
                    {
                        "sense_id": "f826b3fa-1f18-39ce-9fe6-7fb29ecd8456",
                        "entry_id": "e99641ae-7fdf-33f9-8e0e-d65ed29ae674",
                        "glosses": [
                            "Posséder sexuellement, éjaculer sur quelque chose."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "5a3f647d-dbe7-461e-9fd5-ab4b76cd43ad",
                                "sense_id": "f826b3fa-1f18-39ce-9fe6-7fb29ecd8456",
                                "text": "Allez vous y retrouver, quand vous vous êtes laissé enfoutrer."
                            },
                            {
                                "example_id": "ef4205dc-a308-4d33-b039-b21aa6249e53",
                                "sense_id": "f826b3fa-1f18-39ce-9fe6-7fb29ecd8456",
                                "text": "J’enfoutre Dieu menteur et j’enfoutre Hommes Bons ! Sa bouche se tordit en un rictus très laid, empli de rage, ses yeux noirs foudroyèrent Cristo."
                            },
                            {
                                "example_id": "41eb49ff-d645-4a5b-a4e5-3fabf7e52e0b",
                                "sense_id": "f826b3fa-1f18-39ce-9fe6-7fb29ecd8456",
                                "text": "J'ai beau me prendre pour ma mère pour détourner son attention, Nunique me pilonne à grands coups, ce qui m’enfoutre l’arrière-train que j’ai depuis gluant comme patinoire de plein air au printemps."
                            },
                            {
                                "example_id": "ade5b28a-8444-4764-9014-b15f4dfb639c",
                                "sense_id": "f826b3fa-1f18-39ce-9fe6-7fb29ecd8456",
                                "text": "J’ai au même moment un soubresaut et m’enfoutre la main gauche"
                            }
                        ]
                    }
                ],
