                "senses": [
                    {
                        "sense_id": "f7bc1362-5120-3d51-a1cf-d8616fad7c5a",
                        "entry_id": "ef3ca15f-92f5-341a-83e5-47c894e95025",
                        "glosses": [
                            "A contemptible or pretentious person, especially one who gambles for low stakes."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "37b0b6f4-7312-4d3f-acba-7d79cfb6f3cf",
                                "sense_id": "f7bc1362-5120-3d51-a1cf-d8616fad7c5a",
                                "text": "“[…] Them rich fellers, they don't make no bad breaks with their money. They watch it all th' time b'cause they know blame well there ain't hardly room fer their feet fer th' pikers an' tin-horns an' thimble-riggers what are layin' fer 'em. […]”"
                            },
                            {
                                "example_id": "efac8600-af11-47b6-bd80-4f674cb2a3e9",
                                "sense_id": "f7bc1362-5120-3d51-a1cf-d8616fad7c5a",
                                "text": "I'm to deliver this treaty, signed by Secretary General Tanduk Timah himself. Heh. 'Tanduk Timah' in Bahasa Malay means 'Tin Horn.' How apt."
                            }
                        ]
                    }
                ],
