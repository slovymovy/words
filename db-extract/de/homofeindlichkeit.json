                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4e356a-9106-4720-a3d8-6cf9e33bbd8e",
                                "sense_id": "78684786-1649-3bc5-8e62-db61cecd1e48",
                                "text": "„Mittels homogenisierender, oft auch stigmatisierender Zuschreibungen findet eine Kulturalisierung von Homofeindlichkeit statt.“"
                            },
                            {
                                "example_id": "b56fb86d-0295-44aa-a735-0fb3ec8b666d",
                                "sense_id": "78684786-1649-3bc5-8e62-db61cecd1e48",
                                "text": "„Also haben Sie mich nur herbestellt, um mir den Tag mit ein bisschen beiläufiger Homofeindlichkeit zu versüßen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
