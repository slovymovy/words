                                            {
                                                "example_id": "62e4123e-62e4-46ea-9c9e-7e20b1eb293a",
                                                "sense_id": "26ad7f63-866a-393c-a919-da40eb561cd4",
                                                "text": "De theologische bestudering van engelen, de zogenaamde angelologie, is in de periode na de Verlichting nogal in onbruik geraakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
