                                        "entry_id": "7e85fb9a-f81a-3c27-b6e7-a038cd6bb985",
                                        "glosses": [
                                            "Cutting; employing keen wit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6782d93c-cf1c-4ae0-b851-c97b8e4a4bb7",
                                                "sense_id": "b1ced4dd-27b2-3ad3-9af5-9280e619d0eb",
                                                "text": "John is very quick on his feet during interviews by using his rapier responses."
                                            }
                                        ]
                                    }
