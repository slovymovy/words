                "senses": [
                    {
                        "sense_id": "b6b60a27-3072-33c5-90cb-c8f0c1f68d64",
                        "entry_id": "c6ab034c-1c70-339c-985c-2638974e2bac",
                        "glosses": [
                            "Donner un caractère rappelant Walt Disney (ou les personnages qu'il a créés) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a5da64-231d-491a-9957-66495c4a1d37",
                                "sense_id": "b6b60a27-3072-33c5-90cb-c8f0c1f68d64",
                                "text": "Mais la vraie raison de ce projet n'est-elle pas de « blanchir » une célébrité locale, de la « disneyiser », de la rendre présentable ?"
                            },
                            {
                                "example_id": "dcf1561c-1ef8-41f8-b070-5b137d941c6f",
                                "sense_id": "b6b60a27-3072-33c5-90cb-c8f0c1f68d64",
                                "text": "Les amerloques sont capables de disneyiser absolument tout leur patrimoine."
                            },
                            {
                                "example_id": "c0bcafcd-794f-4ea6-a347-f2e99ea4e959",
                                "sense_id": "b6b60a27-3072-33c5-90cb-c8f0c1f68d64",
                                "text": "En quelques clichés postés sur son compte Instagram, le créatif Paperboyo vient « Disneyiser » notre réalité !"
                            }
                        ]
