                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017543cb-7265-4d65-a96b-a4a6fa15fafb",
                                "sense_id": "db6fe06e-7ace-30f2-8daf-5327d728a0f8",
                                "text": "Le motif de la graphie charnelle vise ici à réoriginer l'écriture dans la nature (biologique);"
                            },
                            {
                                "example_id": "748b6edb-e508-468b-afa7-cd01c79f7828",
                                "sense_id": "db6fe06e-7ace-30f2-8daf-5327d728a0f8",
                                "text": "Elle se pose pour une «ouverture indéfinie» de l'identité québécoise qu'elle somme de se « réoriginer », de se réinventer en dehors des schémas traditionnels de la culture qui l'ont définie historiquement (Charron, 1982; Morin, 1982; Morin et Bertrand, 1979)."
                            }
                        ]
