        "fr-extract.jsonl": [
            {
                "entry_id": "3e7ae99f-a97a-344d-b6b6-616b03b4621e",
                "word": "cymbale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "14bec0ed-0426-4ff7-8966-9a08694cf490",
                        "entry_id": "3e7ae99f-a97a-344d-b6b6-616b03b4621e",
                        "tags": [
                            "plural"
                        ],
                        "form": "cymbales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9a4bdc7-d9ed-33ac-8529-09ec545060f4",
                        "entry_id": "3e7ae99f-a97a-344d-b6b6-616b03b4621e",
                        "glosses": [
                            "Instrument de musique de l’Antiquité, fait de deux moitiés de globe en airain."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e83cf77e-3cc2-318c-bfbc-9f3420fb3a3c",
                        "entry_id": "3e7ae99f-a97a-344d-b6b6-616b03b4621e",
                        "glosses": [
                            "Instrument de musique consistant en deux disques ou plateaux de cuivre que l’on frappe en mesure l’un contre l’autre."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fb813780-1890-4a33-89e5-f0f68206e461",
                                "sense_id": "e83cf77e-3cc2-318c-bfbc-9f3420fb3a3c",
                                "text": "Cette musique avait une origine orientale, ayant été importée de la Terre sainte, et le mélange des cymbales et des clochettes semblait en même temps souhaiter la bienvenue et porter le défi aux chevaliers …."
                            },
                            {
                                "example_id": "2a735b55-21ef-4626-a5a8-ee7360ddc4f8",
                                "sense_id": "e83cf77e-3cc2-318c-bfbc-9f3420fb3a3c",
                                "text": "Mais les Flowers of Romance pouvaient aussi se vanter d'être le seul groupe de l'histoire du rock à avoir une batteuse qui n'utilisait jamais les cymbales."
                            },
                            {
                                "example_id": "717756af-f5e8-4b44-9383-f76ef55b4438",
                                "sense_id": "e83cf77e-3cc2-318c-bfbc-9f3420fb3a3c",
                                "text": "Ce sont les cymbales, inventées jadis par un monomane du bruit qui n’avait que deux morceaux de cuivre à sa disposition (…)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c2f0963-ce41-40d5-b159-40aa37122b68",
                        "source_entry_id": "3e7ae99f-a97a-344d-b6b6-616b03b4621e",
                        "source_sense_description": "instrument antique",
                        "target_lang_word": "cymbal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cymbal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                        "entry_id": "96d170b4-f728-34ea-aefc-c91ecebe4039",
                                        "glosses": [
                                            "A concave plate of metal, usually brass or bronze, that produces a sharp, ringing sound when struck: played either in pairs, by striking them together, or singly by striking with a drumstick or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43996ce2-a885-46b6-85e3-e234dd16fc28",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "The trumpets, sackbuts, psalteries and fifes,\nTabours and cymbals and the shouting Romans,\nMake the sun dance."
                                            },
                                            {
                                                "example_id": "7be745e3-b5f3-44ac-9305-8f38e28c7c1c",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "Though I speak with the tongues of men and of angels, and have not charity, I am become as sounding brass, or a tinkling cymbal."
                                            },
                                            {
                                                "example_id": "f6e5d0d6-2f25-42bd-94a3-8ef40533a59b",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "Trumpets and Drums shall fright her from the Throne,\nAs sounding Cymbals aid the lab'ring Moon."
                                            },
                                            {
                                                "example_id": "690eac1e-c7ae-49b7-96fa-8182caa15e44",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "I see the Crusaders' tumultuous armies—hark, how the cymbals clang […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a3c9efa-9603-490f-87a1-cdd9106fcfd6",
                        "source_entry_id": "3e7ae99f-a97a-344d-b6b6-616b03b4621e",
                        "source_sense_description": "instrument moderne",
                        "target_lang_word": "Becken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Becken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4b5804-efa1-3d9b-a60d-3f3349b4e354",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "derjenige Körperabschnitt, der unterhalb des Bauchs und oberhalb der Beine gelegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0739b60-8b6c-4afe-9880-676630896a8d",
                                                "sense_id": "3e4b5804-efa1-3d9b-a60d-3f3349b4e354",
                                                "text": "Bei diesem Sturz hat er sich einen Bruch des Beckens zugezogen."
                                            },
                                            {
                                                "example_id": "a057fe2d-64eb-4551-a7dd-e255abb2022c",
                                                "sense_id": "3e4b5804-efa1-3d9b-a60d-3f3349b4e354",
                                                "text": "„Mit beiden Händen wippte ich sie auf und ab und ließ ihr Becken rotieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bff5085c-df7d-352d-a341-ca3a0ed2f51a",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "flacher, oben offener, oft fest installierter Behälter für Wasser oder eine andere Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b631e3-8b82-4e23-8a46-2085ce45a62d",
                                                "sense_id": "bff5085c-df7d-352d-a341-ca3a0ed2f51a",
                                                "text": "Er sprang vom 1-Meter-Brett ins Becken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "großer natürlicher oder künstlicher Behälter für Wasser in der Landschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9027bdc-5682-4de2-9385-4decab9d2b8a",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "Dieses Becken ist für große Schiffe nicht tief genug."
                                            },
                                            {
                                                "example_id": "abc09e0c-a02f-42e4-a1a7-3f6b2374bcc5",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "„Wir erreichten den Rand des Beckens auf seiner Westseite und wateten durch das Wasser hindurch zu dem Schotterhaufen auf der Leeseite des Felsens.“"
                                            },
                                            {
                                                "example_id": "e1b9a485-f01b-4a32-a3b2-65dd3570b134",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "„Sein Becken mit Hunderten Nebenflüssen und Seitenarmen misst rund 3,5 Millionen Quadratkilometer – ein Gebiet größer als Indien.“"
                                            },
                                            {
                                                "example_id": "8ec32196-dd53-48d1-b374-1db051912b3f",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "„Daneben kommt zuerst ein aus Kalkstein fein gearbeitetes, sechseckiges Becken in Sicht, daneben die Ruinen von mindestens drei Tempeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bb5fb479-62a2-3cfb-91ba-745191643908",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "ausgedehnte landschaftliche Einsenkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ee3845-c9c0-4856-8216-6908d98e5992",
                                                "sense_id": "bb5fb479-62a2-3cfb-91ba-745191643908",
                                                "text": "Am Grund des Beckens hat sich eine typische Flora entwickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0b590346-c492-396e-a9f6-fcc8c1f2129c",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "Musikinstrument, bei dem eine tellerförmige Metallscheibe geschlagen bzw. ein Paar von Metallscheiben gegeneinander geschlagen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37bf3bd-132c-4c48-96d0-33d5cf772d2f",
                                                "sense_id": "0b590346-c492-396e-a9f6-fcc8c1f2129c",
                                                "text": "Das Becken hat einen feinen Riss und muss noch vor dem Konzert ausgetauscht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
