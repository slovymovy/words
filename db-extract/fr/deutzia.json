                        "glosses": [
                            "Arbuste du genre Deutzia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72893171-7055-49a0-b835-a235ce030366",
                                "sense_id": "43014da4-9f8b-3f24-89d0-c587537a314c",
                                "text": "Au centre du jardin, un hibiscus, un deutzia, un potentilla, un althaea mauve, un cotonnéaster, des lavandes, des romarins, des thyms, des bruyères, des millepertuis."
                            },
                            {
                                "example_id": "6ff8c5c3-8ddd-4d72-976a-7827159ae2bf",
                                "sense_id": "43014da4-9f8b-3f24-89d0-c587537a314c",
                                "text": "Et j'ai tellement aimé les feuilles vert pâle, blanches et roses de l'actinidia… que je m'en suis souvenu. Je connaissais déjà les hampes bleues des delphiniums, l'avalanche du deutzia."
                            }
                        ]
                    }
