                    {
                        "sense_id": "ca61ce94-af6b-3aca-b9cd-ae2d0ea5126a",
                        "entry_id": "c811ebc2-7cf6-3e71-8ba5-9ce4cafccd6b",
                        "glosses": [
                            "Instrument dont on se sert pour dévider des fils de lin, de coton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44fb3331-c8cb-4941-ad21-3b50472d7ed0",
                                "sense_id": "ca61ce94-af6b-3aca-b9cd-ae2d0ea5126a",
                                "text": "Des pelotons de fil bis dormaient au fond d’un dévidoir invalide."
                            },
                            {
                                "example_id": "94d14fff-4bb5-45fa-97cf-add7dce48ca7",
                                "sense_id": "ca61ce94-af6b-3aca-b9cd-ae2d0ea5126a",
                                "text": "C’est un produit riche en protéines, facile à digérer. Une fois la chrysalide échaudée, suit le dévidage qui demande beaucoup de travail et occupe des villages entiers dans la région. Cette étape de préparation peut se faire à la main ou avec un dévidoir."
                            },
                            {
                                "example_id": "e1bfa4bb-744a-4ee1-bf81-451a539976d3",
                                "sense_id": "ca61ce94-af6b-3aca-b9cd-ae2d0ea5126a",
                                "text": "Mettre un écheveau sur le dévidoir."
                            },
                            {
                                "example_id": "651c7fc6-0960-44b3-9deb-331c11ae5c28",
                                "sense_id": "ca61ce94-af6b-3aca-b9cd-ae2d0ea5126a",
                                "text": "Une des planches de la suite, qui a pour vignette un éventail vert, représente une femme devant un dévidoir, pour la fabrication du fil de coton."
                            }
                        ]
                    },
