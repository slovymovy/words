                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd7361f2-206c-418f-a8f6-c068884cce5f",
                                "sense_id": "ca573a58-7fe1-3d0e-892e-beee8c1f1a68",
                                "text": "„Er setzt bei der kulturell codierten und hochmoralisch aufgeladenen Signifikanz des Gewaltbildes als Voraussetzung unseres ethischen Selbstverständnisses an.“"
                            },
                            {
                                "example_id": "5e0db6c8-5110-40f8-a914-c64ca81efa16",
                                "sense_id": "ca573a58-7fe1-3d0e-892e-beee8c1f1a68",
                                "text": "„Auf dieses Gewaltbild wird nun, diametral entgegengesetzt, rechts oben im Gemälde, ein kleines Gegenbild bezogen - die Engelgruppe als ein Bild des Himmels, der Gelassenheit, der Ruhe.“"
                            }
                        ],
