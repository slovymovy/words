                        "glosses": [
                            "Petit bonhomme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909b45a4-bf57-4341-8b8a-d1d39f24b6cb",
                                "sense_id": "b2e6396d-6e1a-3b06-973d-3518d014cd84",
                                "text": "Et le bonhommet, en lui faisant de ces adorables sourires d'enfant qui sont pour les cœurs endurcis de si puissants Sésame, gagnait peu à peu ses secrètes bonnes grâces."
                            }
