                ],
                "senses": [
                    {
                        "sense_id": "a9b459bb-c4b9-33a9-b78a-4a1c21f4813f",
                        "entry_id": "e17abf3d-8f5c-3358-9b30-f4808a716452",
                        "glosses": [
                            "Substance médicamenteuse antihistaminique H1 de formule brute C₁₆H₁₉ClN₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edbb646f-aa09-478b-9720-8ebfd7a7cfbd",
                                "sense_id": "a9b459bb-c4b9-33a9-b78a-4a1c21f4813f",
                                "text": "Carlsson, qui avait l’intention de poursuivre les essais cliniques sur la chlorphéniramine pour les patients anxieux et dépressifs, s’en est pourtant abstenu."
                            },
                            {
                                "example_id": "e2895f58-1da3-4a3b-9c85-bf304061816c",
                                "sense_id": "a9b459bb-c4b9-33a9-b78a-4a1c21f4813f",
                                "text": "La chlorphéniramine agit en bloquant les effets de l’histamine, une substance libérée par les cellules qui produisent les symptômes allergiques dans le corps."
                            },
                            {
                                "example_id": "bf1c543a-c0d0-4391-a7ec-ed10020e7aa7",
                                "sense_id": "a9b459bb-c4b9-33a9-b78a-4a1c21f4813f",
                                "text": "Ces médicaments sont composés de comprimés multivitaminés, de comprimés “para+diclo sodique”, de chlorphéniramines, de chlorphéniramine maléate et de flacons « Philco para 100ml » avec dispositif d’accrochage pour perfusion."
                            }
                        ]
                    }
                ],
