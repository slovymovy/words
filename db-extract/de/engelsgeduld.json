                                                "sense_id": "22b82586-f6cb-33e3-af33-2889b1b79fc8",
                                                "text": "You must have had the patience of a saint to sit through that awful film!"
                                            },
                                            {
                                                "example_id": "6b2fe17d-8f3d-45f0-9e7e-eba3d89ebcd2",
                                                "sense_id": "22b82586-f6cb-33e3-af33-2889b1b79fc8",
                                                "text": "I live without restraint / And I would try the patience of a saint"
                                            }
