                "senses": [
                    {
                        "sense_id": "e8d70eae-e25d-3aa8-aac5-7ed85fe6390c",
                        "entry_id": "eab112f1-f120-3ee4-8f2f-6162be3be953",
                        "glosses": [
                            "Synonym of inexperienced."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4ac071-f673-45ae-ab59-588bf59b96d7",
                                "sense_id": "e8d70eae-e25d-3aa8-aac5-7ed85fe6390c",
                                "text": "[A]s my coachman was but an unexperienced driver, I was obliged to make use of my own skill in that exercise, and direct his endeavours the whole way […]."
                            },
                            {
                                "example_id": "db23358f-11f3-4fe0-97f7-da9af7900c34",
                                "sense_id": "e8d70eae-e25d-3aa8-aac5-7ed85fe6390c",
                                "text": "These are not always essential on a CV but in the case of an unexperienced candidate, they can help to give recruiters more insight into your capabilities."
                            }
                        ]
                    },
                    {
                        "sense_id": "473097a6-a7a3-38c1-bfc8-f79766ac35c8",
                        "entry_id": "eab112f1-f120-3ee4-8f2f-6162be3be953",
                        "glosses": [
                            "Not known through experience."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc64600-4e5d-4d1f-99a8-d75449c2f57e",
                                "sense_id": "473097a6-a7a3-38c1-bfc8-f79766ac35c8",
                                "text": "Near-synonyms: unencountered, unprecedented, unrealized"
                            },
                            {
                                "example_id": "f6a565b7-eb65-46fa-9f9d-29aaeda19b02",
                                "sense_id": "473097a6-a7a3-38c1-bfc8-f79766ac35c8",
                                "text": "The team performed well even in previously unexperienced situations."
                            },
                            {
                                "example_id": "d5dc8bda-3032-4864-9054-3a8ef8558f7f",
                                "sense_id": "473097a6-a7a3-38c1-bfc8-f79766ac35c8",
                                "text": "All the wonders that are unimaginable and unspeakable; all these wonders are translated in the mysterious melodiousness of the guitar. […] Sometimes it brings to me the bird-twitterings in the air; and sometimes it strikes up in me rapturous pulsations of legendary delights eternally unexperienced and unknown to me."
                            },
                            {
                                "example_id": "a5dc4af5-825d-4710-b260-7cf2f182671a",
                                "sense_id": "473097a6-a7a3-38c1-bfc8-f79766ac35c8",
                                "text": "Whether material or spiritual, this is not the environment we know; even the most encased of physical beings, and the most unexperienced modes of being spiritual, are present to each other in expectation of experience if in no other way."
                            }
                        ]
                    }
