                                        "entry_id": "dff367c8-ee4c-3179-8bf4-89e39cc2bbb6",
                                        "glosses": [
                                            "die kleinen Hohlräume in der Lunge, in denen der Gasaustausch bei der Atmung stattfindet"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c971e7d1-8fec-46c4-a88b-ab1b0f6d5252",
                                                "sense_id": "c328ee43-5154-3bb6-9082-573d81982d3a",
                                                "text": "„Bevor es in den Alveolen zur Diffusion kommen kann, also zum eigentlichen Gasaustausch, verändern sich im Laufe der Inspiration die Partialdrücke von Sauerstoff und Kohlenstoffdioxid.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fcdca0d-163c-3aa3-96fd-c1a4f8825cc4",
                                        "entry_id": "dff367c8-ee4c-3179-8bf4-89e39cc2bbb6",
                                        "glosses": [
                                            "Zahnfach, in dem sich ein Zahn befindet oder befunden hat"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d312796a-a27d-47e8-ad11-34a311cfac3b",
                                                "sense_id": "1fcdca0d-163c-3aa3-96fd-c1a4f8825cc4",
                                                "text": "Bei der Extraktion eines Zahnes wird die Alveole gedehnt"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
