                        ],
                        "form": "kvasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b824b704-d946-3a7a-900d-e8fbc356e3ad",
                        "entry_id": "1775c036-29a0-352b-9426-46f8edde7f7d",
                        "glosses": [
                            "A fermented cereal-based low alcoholic beverage, often flavored with fruit, honey and herbs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "254082b4-d74d-4440-87e3-75434e11fc78",
                                "sense_id": "b824b704-d946-3a7a-900d-e8fbc356e3ad",
                                "text": "She […] talked constantly, mostly of her childhood, the young ladies’ school she had attended, and the pleasures of Kiev in the summertime.\n“Days are long and hot, but nights are languorous and starlit. People refresh themselves in their flower gardens and some walk in the parks, drink kvass and lemonade, and listen to the symphonies […]”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7fb7935-6f89-4079-b43d-9bbc324d4834",
                        "source_entry_id": "1775c036-29a0-352b-9426-46f8edde7f7d",
                        "source_sense_id": "b824b704-d946-3a7a-900d-e8fbc356e3ad",
                        "source_sense_description": "fermented cereal-based low alcoholic beverage",
                        "target_lang_word": "kvas",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kvas",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7e1a84-9bf0-3aab-b80e-c39fb1640e36",
                                        "entry_id": "4d557fb5-8ba9-3d98-8707-fde08f652323",
                                        "glosses": [
                                            "kvasící směs mouky, vody a kvásku pro přípravu chleba"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdd84fad-925e-3100-912e-aec8c7cdebba",
                                        "entry_id": "4d557fb5-8ba9-3d98-8707-fde08f652323",
                                        "glosses": [
                                            "slabě alkoholický nápoj připravený zkvašením obilovin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6a3878-af9c-40b5-9346-fbc2736cb7c0",
                                                "sense_id": "cdd84fad-925e-3100-912e-aec8c7cdebba",
                                                "text": "V hospodě u Kulhavého poníka jsme podávali koňský guláš a chleba se sádlem a cibulí. Večeři jsme zapili malinovým kvasem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d39c3eec-ce59-3895-bf3c-8aa48b001b0b",
                                        "entry_id": "4d557fb5-8ba9-3d98-8707-fde08f652323",
                                        "glosses": [
                                            "ruch, aktivita, rozvoj"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea708660-9eed-4674-82bc-be3c84edbd0e",
                                                "sense_id": "d39c3eec-ce59-3895-bf3c-8aa48b001b0b",
                                                "text": "Revoluční kvas listopadových dní se v Růžích pro Markétu vlévá do svérázné domácnosti manželů, vysokoškolských pedagogů, Huga (Martin Sláma) a Ireny (Klára Apolenářová)."
                                            },
                                            {
                                                "example_id": "bf2a4282-d304-433a-88ee-a2a6b3b042a6",
                                                "sense_id": "d39c3eec-ce59-3895-bf3c-8aa48b001b0b",
                                                "text": "Společenský a revoluční kvas v některých zemích utichl (Alžírsko), zatímco v jiných dosud trvá. Události jsou „na pochodu“ v Egyptě, Sýrii a Kuvajtu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41795e32-c420-3ef1-8c48-8c0ada290fc7",
                                        "entry_id": "4d557fb5-8ba9-3d98-8707-fde08f652323",
                                        "glosses": [
                                            "hostina, hodokvas"
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kvas",
                                "target_lang_code": "cs",
