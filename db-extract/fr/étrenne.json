                        ],
                        "examples": [
                            {
                                "example_id": "f58cb7ca-b5ec-413d-be75-01cb0ec2ff80",
                                "sense_id": "29004df3-19c1-34eb-b72d-8596ebfabbed",
                                "text": "Et que veux-tu pour tes étrennes?",
                                "translation": "And what would you like for Christmas?",
                                "english": "And what would you like for Christmas?"
                            },
                            {
                                "example_id": "a74bc90f-4c4a-4b2b-a394-baabf51ad21f",
                                "sense_id": "29004df3-19c1-34eb-b72d-8596ebfabbed",
                                "text": "Les gens prévoyants n’ont pas attendu le Ier janvier pour expédier leurs étrennes.",
                                "translation": "The far-sighted did not wait until January 1st to send their New Year's gifts.",
                                "english": "The far-sighted did not wait until January 1st to send their New Year's gifts."
                            }
                        ]
