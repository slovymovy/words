                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35523c1-a0aa-473c-8b78-98b27adcf100",
                                                "sense_id": "c97e0000-2b89-3031-8df0-5ae2ade5322a",
                                                "text": "On m’avertit que madame de Chasteller ne voudra jamais me recevoir à cause de ma cocarde : il faudrait pouvoir y aller en habit bourgeois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
