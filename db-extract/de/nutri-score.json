                    {
                        "form_id": "65398dc5-a3c4-4073-910e-4d139c3be8dd",
                        "entry_id": "0eafc9f3-c3cf-364f-834d-cb659a2d0d94",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nutri-Scores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                        "entry_id": "0eafc9f3-c3cf-364f-834d-cb659a2d0d94",
                        "glosses": [
                            "Kennzeichnungssystem über den Nährwert von Lebensmitteln mit einer fünffarbigen Punkteskala von A bis E und grün bis rot, das auf die Vorderseite einer Lebensmittelverpackung gedruckt wird"
                        ],
                        "tags": [
                            "Ernährung"
                        ],
                        "examples": [
                            {
                                "example_id": "dd19ed69-2590-4c73-955a-5c9ba8b04bbd",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Frankreich hat den Nutri-Score 2017 eingeführt, auf Wunsch der Regierung.“"
                            },
                            {
                                "example_id": "1978c819-c587-478a-ac04-c43a6cdb9086",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "Die Verwendung des Nutri-Scores ist für die Lebensmittelindustrie in Deutschland freiwillig."
                            },
                            {
                                "example_id": "81b15e52-fb2c-435e-9f99-907966a99511",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "Obst und Gemüse werden nicht mit dem Nutri-Score gekennzeichnet, obwohl doch diese Lebensmittel die gesündesten sind."
                            },
                            {
                                "example_id": "51a3d2cc-27f0-4ea7-8245-c3054f4f02fd",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "Laut den Verbraucherzahlen ist es nur sinnvoll, die Nutri-Scores einer Lebensmittelgruppe untereinander zu vergleichen. Der Nutri-Score sagt keineswegs aus, dass Lebensmittel X mit Nutri-Score A gesünder ist, als Lebensmittel Y einer anderen Produktgruppe mit Nutri-Score C."
                            },
                            {
                                "example_id": "a56f128a-31cd-4680-b37c-8076ac84c4a4",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Mithilfe des Nutri-Scores lassen sich nur Lebensmittel innerhalb einer Produktgruppe vergleichen“"
                            },
                            {
                                "example_id": "969fb503-a660-459c-8462-fd19ce45cfcd",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Die Buchstabenfolge des Nutri-Scores von A bis E soll es Kunden einfacher machen, den Nährwert eines Lebensmittels zu erkennen,“ […]."
                            },
                            {
                                "example_id": "f16ba7d2-f1f2-435e-9008-029944f0f4b9",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Rotes E heißt: zu fettig, zu süß und/oder zu salzig – auf jeden Fall zu ungesund. Verbraucherschützer wollen, dass der Nutri-Score auf allen verarbeiteten Lebensmitteln stehen muss. Momentan ist die Nutzung freiwillig.“"
                            },
                            {
                                "example_id": "dbfa9394-6918-4a0c-a358-8d49da489525",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Der Nutri-Score hilft einer Studie zufolge beim Erkennen von zuckerhaltigen Lebensmitteln und trägt so zu einer gesünderen Ernährung bei.“"
                            },
                            {
                                "example_id": "3c81d1c9-a0c6-43b5-a0fd-e6d2e2abff8a",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Unser bundesweiter Marktcheck mit 1451 Lebensmitteln zeigt: Es sind noch zu wenige Produkte mit dem Nutri-Score gekennzeichnet.“"
                            },
                            {
                                "example_id": "de20ec17-5351-4bef-9eed-ea12a635f0ac",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Je schlechter der Nutri-Score beispielsweise bei Brot, desto höher ist der durchschnittliche Gehalt an Salz in den Produkten.“"
                            },
                            {
                                "example_id": "d9753242-3805-43b1-a38d-cd198a95b5ac",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Obwohl die Chips echte Kalorienbomben sind und der Nutri-Score der leckeren Knabberei fast immer im roten Bereich liegt, haben Menschen in Deutschland im Jahr 2018 pro Kopf durchschnittlich 1,5 Kilogramm Kartoffelchips verzehrt.“ […]."
                            },
                            {
                                "example_id": "3dad34e4-c1e0-40b4-8de4-8925c473158a",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Das Grundprinzip der Berechnung des Nutri-Score ist, dass positive und negative Nährstoffe miteinander verrechnet werden.“"
                            },
                            {
                                "example_id": "eb686dd3-3351-41b0-881e-443b9f9dcc9e",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Die Berechnung des Nutri-Scores ist zwar generell bei allen verarbeiteten Lebensmittel gleich, dennoch gibt es drei Ausnahmen:“ […]."
                            },
                            {
                                "example_id": "f9042585-04ae-493a-a96f-ab77fe82d981",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Die Ernährungsindustrie will keine Ampeln auf ihren Produkten. Doch es gibt ein Umdenken: Zwei Hersteller führen jetzt den „Nutri-Score“ ein.“"
                            },
                            {
                                "example_id": "0c8ba901-7d48-4620-9aeb-8869d2d1a2d0",
                                "sense_id": "b1668c96-37bd-3e31-8ce6-f4bf0d6eee08",
                                "text": "„Die zunehmende Digitalisierung sollte dafür genutzt werden, den Verbrauchern mehr Informationen über die Produktionsketten zu geben: »Wenn wir schon über einen Nutri-Score sprechen, warum nicht auch über einen Öko-Score?«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
