                        ],
                        "form": "водеви́ле"
                    },
                    {
                        "form_id": "490bec6c-973c-458b-a6cd-957b1456dd2f",
                        "entry_id": "58091d99-8849-3fb8-91a8-cf8336e30141",
                        "tags": [
                            "plural",
