                                    {
                                        "sense_id": "66662709-f32d-328c-9b1d-d1eb0f2388c6",
                                        "entry_id": "51641a6e-4cf2-310a-bdd6-581c2599c4f5",
                                        "glosses": [
                                            "…naśladujący dźwięk wydawany podczas kichania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c492f5-d4c3-4444-97ae-1c1fcc243ea7",
                                                "sense_id": "66662709-f32d-328c-9b1d-d1eb0f2388c6",
                                                "text": "O zmężniał już i dojrzał mój duch! • Zamiast zapachu róż • Wolę tabaki niuch! • Apsik! Apsik"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "57dc078c-f204-383e-8aeb-b260b9b4ce87",
                                        "entry_id": "51641a6e-4cf2-310a-bdd6-581c2599c4f5",
                                        "glosses": [
                                            "…służący do przeganiania kota"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3617999e-93ec-4aae-a60a-073397082dc3",
                                                "sense_id": "57dc078c-f204-383e-8aeb-b260b9b4ce87",
                                                "text": "Skąd tu koty — krzyknęła staruszka, bała się śmiertelnie kotów. — Wynoś się! Idź stąd! Apsik, apsik"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da82d595-df5c-4d5f-87ec-390555126ad4",
                        "source_entry_id": "1bb75b2b-aaf2-3676-88c9-ff6e69f4ac2f",
