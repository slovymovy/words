            {
                "entry_id": "96289d45-90be-38f6-85a4-3a4a387a8d23",
                "word": "manes",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70602459-d341-3d7d-ac5c-7612ea87dda3",
                        "entry_id": "96289d45-90be-38f6-85a4-3a4a387a8d23",
                        "glosses": [
                            "The souls or spirits of dead ancestors, conceived as deities or the subjects of reverence, or of other deceased relatives."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "89b72167-d476-4ab2-919f-812d15d19945",
                                "sense_id": "70602459-d341-3d7d-ac5c-7612ea87dda3",
                                "text": "this was the Ustrina or place of burning their bodies, or some sacrificing place unto the Manes"
                            },
                            {
                                "example_id": "589c0153-df88-4db9-b6bf-22c60d403044",
                                "sense_id": "70602459-d341-3d7d-ac5c-7612ea87dda3",
                                "text": "Still may the manès of thy children rise\nTo chase calm slumber from thy wearied eyes;\nStill may their voices on the haunted air\nIn fearful whispers tell thee to despair,"
                            },
                            {
                                "example_id": "3a17204c-a635-4e4a-a372-abb8fdee4768",
                                "sense_id": "70602459-d341-3d7d-ac5c-7612ea87dda3",
                                "text": "At this instant the trappings of his attire caught the glaring eye-balls of a dying yeoman, who exerted his wasting strength to sacrifice one more worthy victim to the manes of his countrymen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd29907d-70b7-4698-9eab-dcc6debfaf83",
                        "source_entry_id": "96289d45-90be-38f6-85a4-3a4a387a8d23",
                        "source_sense_id": "70602459-d341-3d7d-ac5c-7612ea87dda3",
