{
    "word_family": [
        "scan",
        "scannable",
        "scanning"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4100fe3e-edaf-3c4e-ac8c-a4de06cb1f45",
                    "sense_definition": "A device that scans documents or photos to convert them into digital files.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the document in the <w>scanner</w> and save it as a PDF.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положите документ в <w>сканер</w> и сохраните его в формате PDF."
                            }
                        },
                        {
                            "text": "The office <w>scanner</w> is broken so I cannot digitize these photos today.",
                            "target_lang_translations": {
                                "ru": "Офисный <w>сканер</w> сломан, поэтому я не могу оцифровать эти фотографии сегодня."
                            }
                        }
                    ],
                    "synonyms": [
                        "image scanner",
                        "optical scanner"
                    ],
                    "common_phrases": [
                        "flatbed scanner",
                        "desktop scanner",
                        "document scanner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, которое сканирует документы или фотографии для преобразования их в цифровые файлы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сканер",
                                "target_lang_sense_clarification": "для документов и фото"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "047d88fb-15ef-34c3-815d-41c78b8cf5f0",
                    "sense_definition": "A device used to read barcodes or QR codes, often for pricing or inventory.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cashier used a handheld <w>scanner</w> to check the price of the milk.",
                            "target_lang_translations": {
                                "ru": "Кассир использовал ручной <w>сканер</w>, чтобы проверить цену молока."
                            }
                        },
                        {
                            "text": "A barcode <w>scanner</w> makes the checkout process much faster for customers.",
                            "target_lang_translations": {
                                "ru": "<w>Сканер</w> штрих-кодов значительно ускоряет процесс оплаты для покупателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "barcode reader",
                        "pricing gun"
                    ],
                    "common_phrases": [
                        "barcode scanner",
                        "handheld scanner",
                        "qr code scanner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое для чтения штрих-кодов или QR-кодов, часто для определения цены или инвентаризации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сканер",
                                "target_lang_sense_clarification": "штрих-кодов"
                            },
                            {
                                "target_lang_word": "считыватель",
                                "target_lang_sense_clarification": "кодов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf07613-66e8-3262-899c-e31cbf76c26f",
                    "sense_definition": "A medical device that uses radiation or ultrasound to create images of the inside of the body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor ordered a brain <w>scanner</w> test to look for any internal injuries.",
                            "target_lang_translations": {
                                "ru": "Врач назначил обследование на <w>сканере</w> головного мозга, чтобы проверить наличие внутренних повреждений."
                            }
                        },
                        {
                            "text": "The hospital recently installed a new MRI <w>scanner</w> in the radiology department.",
                            "target_lang_translations": {
                                "ru": "Больница недавно установила новый МРТ-<w>сканер</w> в отделении радиологии."
                            }
                        }
                    ],
                    "synonyms": [
                        "body scanner",
                        "medical scanner"
                    ],
                    "common_phrases": [
                        "mri scanner",
                        "ct scanner",
                        "ultrasound scanner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский прибор, использующий излучение или ультразвук для создания изображений внутренних органов тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сканер",
                                "target_lang_sense_clarification": "медицинский, например МРТ"
                            },
                            {
                                "target_lang_word": "томограф",
                                "target_lang_sense_clarification": "для детального сканирования тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37e31ce7-d7ed-3452-a454-56e803db1f7e",
                    "sense_definition": "A radio receiver that automatically moves through different frequencies to find a signal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He listened to the local emergency services on his radio <w>scanner</w>.",
                            "target_lang_translations": {
                                "ru": "Он слушал местные службы экстренной помощи через свой радио-<w>сканер</w>."
                            }
                        },
                        {
                            "text": "A digital <w>scanner</w> can monitor hundreds of different channels at once.",
                            "target_lang_translations": {
                                "ru": "Цифровой <w>сканер</w> может отслеживать сотни различных каналов одновременно."
                            }
                        }
                    ],
                    "synonyms": [
                        "radio scanner"
                    ],
                    "common_phrases": [
                        "frequency scanner",
                        "police scanner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радиоприемник, который автоматически переключается между различными частотами для поиска сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сканер",
                                "target_lang_sense_clarification": "радиочастотный"
                            },
                            {
                                "target_lang_word": "сканирующий приемник",
                                "target_lang_sense_clarification": "радиоустройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e407f0f-2752-39ec-adb2-3cfc0f9477a0",
                    "sense_definition": "A person who examines or looks through something quickly but systematically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an eager <w>scanner</w> of magazines, he was always up to date on current trends.",
                            "target_lang_translations": {
                                "ru": "Как заядлый <w>сканер</w> журналов, он всегда был в курсе текущих тенденций."
                            }
                        },
                        {
                            "text": "The editor is a quick <w>scanner</w> of manuscripts and can spot errors instantly.",
                            "target_lang_translations": {
                                "ru": "Редактор очень быстро <w>сканирует</w> рукописи и мгновенно замечает ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "examiner",
                        "inspector"
                    ],
                    "common_phrases": [
                        "eager scanner",
                        "quick scanner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который быстро, но систематически просматривает или изучает что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сканер",
                                "target_lang_sense_clarification": "человек, быстро просматривающий текст"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}