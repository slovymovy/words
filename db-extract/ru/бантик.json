                ],
                "senses": [
                    {
                        "sense_id": "f539eb84-adbb-3d49-9b11-370d1ff65aa3",
                        "entry_id": "9fc88114-d233-3d83-b9ca-356dd0b9ea00",
                        "glosses": [
                            "уменьш. к бант"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97773f36-c708-4118-b27b-6aca86639b66",
                                "sense_id": "f539eb84-adbb-3d49-9b11-370d1ff65aa3",
                                "text": "Наш кивает головой: «Да, бурсука. Хочешь получить на память красный бантик? Если ты рабочий или трудящийся крестьянин... то и ты бурсука, получай». Солдат-японец смеется, радостно пожимает руки партизанам, берет бантик и прикалывает его с обратной стороны шинели на подкладку», — вспоминал П. Постышев"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03ec14be-fc9b-47c8-880e-31bd40ddece0",
                        "source_entry_id": "9fc88114-d233-3d83-b9ca-356dd0b9ea00",
                        "source_sense_id": "f539eb84-adbb-3d49-9b11-370d1ff65aa3",
                        "target_lang_word": "Schleife",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schleife",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "774a63ed-898d-3000-99fb-bcd0fe7900c0",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "Schlinge; Verknüpfung, die leicht lösbar ist; lose, kunstvoll verknüpftes Band; Knoten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f525bc9b-ec5f-4d11-8c96-c66eed491446",
                                                "sense_id": "774a63ed-898d-3000-99fb-bcd0fe7900c0",
                                                "text": "Im Kindesalter lernt man Schleifen binden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85ce6099-a6ef-38b5-857b-a117fdac7e17",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "meistens zu einem Hemd, zu einer Bluse oder im Haar getragenes Schmuckstück (Accessoire)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b099330-5cd0-47a8-a0cf-cbcaf7f74d8e",
                                                "sense_id": "85ce6099-a6ef-38b5-857b-a117fdac7e17",
                                                "text": "Aha, heute trägst du Schleife."
                                            },
                                            {
                                                "example_id": "8315f1ec-28f8-4773-98b8-aa1eb7e67eaa",
                                                "sense_id": "85ce6099-a6ef-38b5-857b-a117fdac7e17",
                                                "text": "„Er trug schwarz-grau gestreifte Hosen, eine blau-weiß gestreifte Hausjacke, ein weißes Hemd und eine weiße Schleife.“"
                                            },
                                            {
                                                "example_id": "407a4e47-34c0-41a2-9c49-4a96b026e313",
                                                "sense_id": "85ce6099-a6ef-38b5-857b-a117fdac7e17",
                                                "text": "„Es hatte keinen Reißverschluss, nur einen Gürtel, der um die Taille gewickelt und zu einer Schleife gebunden werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2ddd2ee0-e55f-33df-b1d1-bb0b1e58c0d5",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "endlos verbundenes Band (Film, Magnetband)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a42524-83fd-4bee-8939-c1ccb0e8ce3c",
                                                "sense_id": "2ddd2ee0-e55f-33df-b1d1-bb0b1e58c0d5",
                                                "text": "Die restliche Musik kam von der Schleife."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af966788-9c54-3458-b367-5b10db1b1b70",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "stark gebogener Verlauf (einer Flugbahn, eines Flusses, einer Straße…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6517a3-15cf-4c69-b7b1-aa7939c1aa3c",
                                                "sense_id": "af966788-9c54-3458-b367-5b10db1b1b70",
                                                "text": "Bei Boppard macht der Rhein eine große Schleife."
                                            },
                                            {
                                                "example_id": "91ab0c51-f1f8-4a5f-b78a-a11c2a4bdcb4",
                                                "sense_id": "af966788-9c54-3458-b367-5b10db1b1b70",
                                                "text": "„Wir wollten an diesem Tag nämlich eine große Schleife der Mosel entlang wandern und mittags eine Rast in Sankt Aldegund machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e8cf59de-cab0-3dbf-b519-d1e280259414",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "eine Kontrollstruktur, mit der wiederholtes Durchlaufen desselben Programmteils möglich wird"
                                        ],
                                        "tags": [
                                            "programming"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8571e3a-2e90-466a-86b0-1355d4ce5c16",
                                                "sense_id": "e8cf59de-cab0-3dbf-b519-d1e280259414",
                                                "text": "Bei Eintritt in eine Repeat-Schleife wird der Inhalt der Schleife wenigstens einmal durchlaufen, bei einer While-Schleife dagegen, abhängig von der Wiederholungsbedingung, womöglich gar nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f0ad2d02-7794-38e6-aaa0-a325b979ba65",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "eine Kante eines Graphen, die einen Knoten mit ihm selbst verbindet"
                                        ],
                                        "tags": [
                                            "Graphentheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a00f554f-bfab-4318-be99-5557d23fbaf5",
                                                "sense_id": "f0ad2d02-7794-38e6-aaa0-a325b979ba65",
                                                "text": "Die reflexiv-transitive Hülle eines ungerichteten Graphen enthält eine Schleife an jedem Knoten."
                                            },
                                            {
                                                "example_id": "95633a10-5973-4b01-83f7-40c15e3cde14",
                                                "sense_id": "f0ad2d02-7794-38e6-aaa0-a325b979ba65",
                                                "text": "Eine Schleife geht von einem Knoten aus und führt zum selben Knoten zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8ff60245-3b54-3714-9a3d-56f4d1fca75b",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "Ort, wo etwas geschleift wird oder wo etwas oder jemand rutschen kann, eine glatte Eisfläche, auf der man schleifen kann"
                                        ],
                                        "tags": [
                                            "speziell mundartlich",
                                            "kindersprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32144df1-3214-48e1-a88e-d1a12a62c636",
                                                "sense_id": "8ff60245-3b54-3714-9a3d-56f4d1fca75b",
                                                "text": "Eine Schneise im Wald dient zuweilen als Schleife für die dort gefällten Bäume."
                                            },
                                            {
                                                "example_id": "4fc02f7d-37be-4068-9c47-70b163c9980d",
                                                "sense_id": "8ff60245-3b54-3714-9a3d-56f4d1fca75b",
                                                "text": "Ihr Lausbuben macht euch hier auf dem Gehsteig eine Schleife, und wir alten Leute rutschen dann darauf aus und brechen uns ein Bein!"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "a78bf089-fc4d-3977-a7e3-0b3001b36dcf",
                                        "entry_id": "cae00ccf-49e9-3167-aff2-7ef9e6d2abec",
                                        "glosses": [
                                            "Schleiferwerkstatt (hier werden oder wurden von Schmieden hergestellte Werkzeuge an Schleifsteinen geschliffen)"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5751d5c3-fcbb-4350-a1ed-e12ed97db9a6",
                                                "sense_id": "a78bf089-fc4d-3977-a7e3-0b3001b36dcf",
                                                "text": "Bis zum Ende des vorigen Jahrhunderts standen hier noch 13 Schleifen und zwei Hammerwerke in Betrieb."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
