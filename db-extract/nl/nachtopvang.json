                        "examples": [
                            {
                                "example_id": "3abb9496-31c9-4c56-98b4-9713347b3c11",
                                "sense_id": "259f58f9-bf6b-3861-bd77-065d067005fe",
                                "text": "Het leek erop dat zo'n vijftig tot zestig asielzoekers buiten moesten slapen omdat het aanmeldcentrum geen plek meer voor ze had in de nachtopvang. Aan hen waren buiten al dekens, eten en drinken uitgedeeld."
                            },
                            {
                                "example_id": "1704320d-b368-41c2-8ef7-3390a1704614",
                                "sense_id": "259f58f9-bf6b-3861-bd77-065d067005fe",
                                "text": "Er was acuut opvang nodig voor ruim 300 asielzoekers, omdat het Centraal Orgaan opvang Asielzoekers (COA) gestart is met het afbreken van de paviljoens van de nachtopvang in Ter Apel. Vanwege die noodsituatie heeft Alkmaar besloten de plekken beschikbaar te stellen."
                            }
