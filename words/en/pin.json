    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10b8b129-6b01-3216-b4ac-5ecc636ddc03",
                    "sense_definition": "A thin, sharp piece of metal with a head, used for fastening clothes or paper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a small <w>pin</w> to hold the two pieces of fabric together while sewing.",
                            "target_lang_translations": {
                                "ru": "Она использовала маленькую <w>булавку</w>, чтобы скрепить два куска ткани во время шитья.",
                                "zh": "她在缝纫时用一枚小<w>大头针</w>把两块布暂时别在一起。"
                            }
                        },
                        {
                            "text": "Be careful not to drop that <w>pin</w> on the floor because someone might step on it.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не урони <w>иголку</w> на пол, иначе кто-нибудь может на нее наступить.",
                                "zh": "小心别把那枚<w>别针</w>掉在地上，因为可能会有人踩到。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "safety pin",
                        "rolling pin",
                        "straight pin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий острый металлический стержень с головкой, используемый для скрепления одежды или бумаги.",
                        "zh": "一种细而尖、带针头的金属针，用来固定衣物、布料或纸张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булавка",
                                "target_lang_sense_clarification": "для шитья или крепления"
                            },
                            {
                                "target_lang_word": "иголка",
                                "target_lang_sense_clarification": "в контексте временного скрепления ткани"
                            },
                            {
                                "target_lang_word": "канцелярская кнопка",
                                "target_lang_sense_clarification": "для бумаги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "别针",
                                "target_lang_sense_clarification": "用于固定衣物、布料等的带头细针"
                            },
                            {
                                "target_lang_word": "大头针",
                                "target_lang_sense_clarification": "缝纫时临时固定布料的细针"
                            },
                            {
                                "target_lang_word": "图钉",
                                "target_lang_sense_clarification": "把纸固定在板上的钉子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34df686f-0fdb-384a-bce0-7045aa7493d1",
                    "sense_definition": "A secret number used to access a bank account or electronic system.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must enter your four-digit <w>pin</w> before you can withdraw any cash from the machine.",
                            "target_lang_translations": {
                                "ru": "Вы должны ввести свой четырехзначный <w>ПИН-код</w>, прежде чем сможете снять наличные в банкомате.",
                                "zh": "你必须先输入四位数的<w>PIN码</w>，才能从机器里取现。"
                            }
                        },
                        {
                            "text": "Never share your <w>pin</w> number with anyone, even if they claim to work for the bank.",
                            "target_lang_translations": {
                                "ru": "Никогда не сообщайте свой <w>ПИН</w> никому, даже если они утверждают, что работают в банке.",
                                "zh": "永远不要把你的<w>PIN码</w>告诉任何人，即使对方声称在银行工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter your pin",
                        "forgot my pin",
                        "pin number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Секретный номер, используемый для доступа к банковскому счету или электронной системе.",
                        "zh": "用于访问银行账户或电子系统的秘密数字号码。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ПИН-код",
                                "target_lang_sense_clarification": "банковской карты"
                            },
                            {
                                "target_lang_word": "ПИН",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "PIN码",
                                "target_lang_sense_clarification": "银行卡或电子系统使用的个人识别号码"
                            },
                            {
                                "target_lang_word": "个人识别码",
                                "target_lang_sense_clarification": "较正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82650569-4505-39eb-80d7-4205f91c70a4",
                    "sense_definition": "A small decorative accessory attached to clothing, often showing a logo or message.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accessory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a colorful <w>pin</w> on his jacket to show his support for the charity.",
                            "target_lang_translations": {
                                "ru": "Он носил яркий <w>значок</w> на пиджаке в знак поддержки благотворительной организации.",
                                "zh": "他在夹克上戴了一枚彩色<w>徽章</w>，以表示对这家慈善机构的支持。"
                            }
                        },
                        {
                            "text": "The collector has hundreds of different lapel <w>pins</w> from every country he has visited.",
                            "target_lang_translations": {
                                "ru": "У коллекционера сотни различных <w>значков</w> из каждой страны, которую он посетил.",
                                "zh": "这位收藏家有几百枚不同的领口<w>徽章</w>，来自他去过的每一个国家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "badge",
                        "lapel pin"
                    ],
                    "common_phrases": [
                        "enamel pin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой декоративный аксессуар, прикрепляемый к одежде, часто с логотипом или сообщением.",
                        "zh": "一种别在衣服上的小型装饰配件，通常带有标志或文字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значок",
                                "target_lang_sense_clarification": "декоративный или памятный"
                            },
                            {
                                "target_lang_word": "брошь",
                                "target_lang_sense_clarification": "ювелирное украшение"
                            },
                            {
                                "target_lang_word": "пиджачный значок",
                                "target_lang_sense_clarification": "на лацкан"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徽章",
                                "target_lang_sense_clarification": "带标志、图案或文字的装饰性佩戴物"
                            },
                            {
                                "target_lang_word": "胸针",
                                "target_lang_sense_clarification": "别在衣服上的装饰针饰"
                            },
                            {
                                "target_lang_word": "领针",
                                "target_lang_sense_clarification": "别在衣领或西装翻领上的小徽章"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3ddc38f-6783-3c55-9607-7245d7292e93",
                    "sense_definition": "One of the wooden targets that you try to knock down in a game of bowling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to knock down every single <w>pin</w> with his very first throw.",
                            "target_lang_translations": {
                                "ru": "Ему удалось сбить каждую <w>кеглю</w> с самого первого броска.",
                                "zh": "他第一投就成功击倒了所有的<w>球瓶</w>。"
                            }
                        },
                        {
                            "text": "The sound of the ball hitting the <w>pins</w> echoed throughout the bowling alley.",
                            "target_lang_translations": {
                                "ru": "Звук удара шара о <w>кегли</w> эхом разнесся по всему боулингу.",
                                "zh": "球撞上<w>球瓶</w>的声音回荡在整个保龄球馆里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skittle"
                    ],
                    "common_phrases": [
                        "bowling pin",
                        "ten pins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из деревянных мишеней, которые нужно сбить в игре в боулинг.",
                        "zh": "保龄球游戏中要设法击倒的木制目标之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кегля",
                                "target_lang_sense_clarification": "в боулинге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球瓶",
                                "target_lang_sense_clarification": "保龄球运动中要被击倒的目标"
                            },
                            {
                                "target_lang_word": "保龄球瓶",
                                "target_lang_sense_clarification": "较完整的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6380ca-58f0-3ccd-829a-725e13af6772",
                    "sense_definition": "One of the metal prongs on an electrical plug that fits into a socket.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plug has a three <w>pin</w> design to ensure it is properly grounded.",
                            "target_lang_translations": {
                                "ru": "Вилка имеет трех<w>штырьковую</w> конструкцию для обеспечения надлежащего заземления.",
                                "zh": "这个插头采用三<w>插脚</w>设计，以确保正确接地。"
                            }
                        },
                        {
                            "text": "One of the <w>pins</w> on the connector was bent, so it wouldn't fit into the computer.",
                            "target_lang_translations": {
                                "ru": "Один из <w>контактов</w> на разъеме был погнут, поэтому он не вставлялся в компьютер.",
                                "zh": "连接器上的一个<w>插针</w>弯了，所以插不进电脑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "three pin plug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из металлических штырей на электрической вилке, который вставляется в розетку.",
                        "zh": "电源插头或连接器上插入插座、接口的金属接触脚之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штырь",
                                "target_lang_sense_clarification": "электрической вилки"
                            },
                            {
                                "target_lang_word": "контакт",
                                "target_lang_sense_clarification": "разъема"
                            },
                            {
                                "target_lang_word": "ножка",
                                "target_lang_sense_clarification": "микросхемы или вилки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插脚",
                                "target_lang_sense_clarification": "插头上插入插座的金属脚"
                            },
                            {
                                "target_lang_word": "插针",
                                "target_lang_sense_clarification": "连接器上的金属针状接点"
                            },
                            {
                                "target_lang_word": "针脚",
                                "target_lang_sense_clarification": "电子元件或芯片的金属引出脚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59460921-989a-3b08-be7b-64c4ce6a63af",
                    "sense_definition": "A cylinder of wood or metal used to join parts together or act as a pivot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must pull the <w>pin</w> out of the grenade before you throw it.",
                            "target_lang_translations": {
                                "ru": "Ты должен выдернуть <w>чеку</w> из гранаты, прежде чем бросить ее.",
                                "zh": "你必须先把手榴弹的<w>插销</w>拔掉，才能扔出去。"
                            }
                        },
                        {
                            "text": "The hinge is held together by a heavy steel <w>pin</w> that allows it to rotate.",
                            "target_lang_translations": {
                                "ru": "Петля держится на тяжелом стальном <w>штифте</w>, который позволяет ей вращаться.",
                                "zh": "这个铰链靠一根沉重的钢<w>销轴</w>连接在一起，使它能够转动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peg"
                    ],
                    "common_phrases": [
                        "hinge pin",
                        "locking pin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цилиндр из дерева или металла, используемый для соединения деталей или в качестве оси.",
                        "zh": "一种木制或金属制的圆柱形部件，用于连接零件或充当转轴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штифт",
                                "target_lang_sense_clarification": "техническая деталь"
                            },
                            {
                                "target_lang_word": "чека",
                                "target_lang_sense_clarification": "гранаты"
                            },
                            {
                                "target_lang_word": "стержень",
                                "target_lang_sense_clarification": "опорный элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "销钉",
                                "target_lang_sense_clarification": "机械中用于连接或定位的圆柱形零件"
                            },
                            {
                                "target_lang_word": "插销",
                                "target_lang_sense_clarification": "手榴弹等装置上可拔出的保险件"
                            },
                            {
                                "target_lang_word": "销轴",
                                "target_lang_sense_clarification": "作为转轴使用的销状零件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8610d80-424c-3bda-bcd4-ca9d514ec7c0",
                    "sense_definition": "A person's leg.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long hike, I was feeling a bit unsteady on my <w>pins</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого похода я чувствовал, что не очень твердо стою на <w>ногах</w>.",
                                "zh": "长途徒步之后，我觉得自己的<w>腿</w>有点发软，站得不太稳。"
                            }
                        },
                        {
                            "text": "The old man was still quite active and fast on his <w>pins</w> for his age.",
                            "target_lang_translations": {
                                "ru": "Старик был еще довольно активен и быстр на <w>ногу</w> для своего возраста.",
                                "zh": "按他的年纪来说，这位老人腿脚还很利索，行动也很快。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on my pins"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нога человека (разговорное).",
                        "zh": "人的腿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноги",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "копыта",
                                "target_lang_sense_clarification": "сленг, иронично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腿",
                                "target_lang_sense_clarification": "口语，指人的腿"
                            },
                            {
                                "target_lang_word": "腿脚",
                                "target_lang_sense_clarification": "口语，强调行动能力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ea88858-1105-3349-aef3-e88b65038b36",
                    "sense_definition": "To fasten or attach something using a pin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>pin</w> the note to the bulletin board so that everyone can see it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>приколите</w> записку к доске объявлений, чтобы все могли ее видеть.",
                                "zh": "请把这张便条<w>钉</w>在布告板上，这样大家都能看到。"
                            }
                        },
                        {
                            "text": "She decided to <w>pin</w> a flower to her dress for the wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>приколоть</w> цветок к платью для свадебной церемонии.",
                                "zh": "为了参加婚礼，她决定在裙子上<w>别上</w>一朵花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peg"
                    ],
                    "antonyms": [
                        "unpin"
                    ],
                    "common_phrases": [
                        "pin it up",
                        "pin to board"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скреплять или прикреплять что-либо с помощью булавки или кнопки.",
                        "zh": "用针、别针或图钉把某物固定或附着起来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикалывать",
                                "target_lang_sense_clarification": "к поверхности"
                            },
                            {
                                "target_lang_word": "скалывать",
                                "target_lang_sense_clarification": "вместе (ткань)"
                            },
                            {
                                "target_lang_word": "пристегивать",
                                "target_lang_sense_clarification": "значок или цветок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钉上",
                                "target_lang_sense_clarification": "用针或钉把东西固定住"
                            },
                            {
                                "target_lang_word": "别上",
                                "target_lang_sense_clarification": "把花、饰物等附在衣物上"
                            },
                            {
                                "target_lang_word": "别住",
                                "target_lang_sense_clarification": "用别针等固定在一起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2803c38-223e-38b7-a4b8-3edf057fd07a",
                    "sense_definition": "To fix an icon or application to a specific place on a computer screen so it stays there.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to <w>pin</w> my most used apps to the taskbar for quick access.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>закреплять</w> наиболее часто используемые приложения на панели задач для быстрого доступа.",
                                "zh": "我喜欢把最常用的应用<w>固定</w>到任务栏上，方便快速打开。"
                            }
                        },
                        {
                            "text": "You can <w>pin</w> a message to the top of the chat so no one misses it.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>закрепить</w> сообщение вверху чата, чтобы никто его не пропустил.",
                                "zh": "你可以把一条消息<w>置顶</w>，这样谁都不会错过。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unpin"
                    ],
                    "common_phrases": [
                        "pin to taskbar",
                        "pin a post"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрепить иконку или приложение в определенном месте на экране компьютера.",
                        "zh": "把图标、应用或消息固定在电脑或软件界面的某个位置，使其保持在那里。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "в интерфейсе"
                            },
                            {
                                "target_lang_word": "прикреплять",
                                "target_lang_sense_clarification": "к панели задач"
                            },
