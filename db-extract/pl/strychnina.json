                                        "entry_id": "fa90619e-e2c2-3d64-9834-4ce24bef3558",
                                        "glosses": [
                                            "хим. индоловый алкалоид; сильный яд, добываемый из растения чилибухи (C₂₁H₂₂N₂O₂)"
                                        ],
