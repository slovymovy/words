{
    "word_family": [
        "survie",
        "survivance",
        "survivre"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "264f8163-0866-395a-b058-bf730e2ce758",
                    "sense_definition": "Personne qui est restée en vie après un accident, une catastrophe, une guerre ou une grave maladie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "catastrophe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les secours recherchent activement d'éventuels <w>survivants</w> sous les décombres de l'immeuble."
                        },
                        {
                            "text": "Ce blessé est le seul <w>survivant</w> du tragique naufrage survenu hier soir."
                        }
                    ],
                    "synonyms": [
                        "rescapé"
                    ],
                    "antonyms": [
                        "victime"
                    ],
                    "common_phrases": [
                        "seul survivant",
                        "recherche de survivants"
                    ]
                },
                {
                    "sense_id": "93e22485-e85b-3de2-acd2-5e5386dfd3e5",
                    "sense_definition": "Personne qui est encore vivante après la mort d'un proche ou d'un conjoint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le testament prévoyait que l'ensemble des biens reviendrait au <w>survivant</w> des deux époux."
                        },
                        {
                            "text": "Après le décès prématuré de sa sœur, il est resté l'unique <w>survivant</w> de la famille."
                        }
                    ],
                    "common_phrases": [
                        "au survivant"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19fc443b-dad1-30b3-b010-5ca7f2b46ca7",
                    "sense_definition": "Qui est resté en vie après un accident, un désastre ou un grave péril.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "catastrophe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les passagers <w>survivants</w> ont été immédiatement transportés vers l'hôpital le plus proche."
                        },
                        {
                            "text": "Quelques arbres <w>survivants</w> bordaient encore la route dévastée par la tempête."
                        }
                    ],
                    "synonyms": [
                        "rescapé"
                    ]
                },
                {
                    "sense_id": "2afa6c3f-c4eb-3453-817a-3ab52bb0703c",
                    "sense_definition": "Qui survit à une personne décédée, en particulier dans un cadre familial ou successoral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conjoint <w>survivant</w> conserve l'usufruit de la maison d'habitation."
                        },
                        {
                            "text": "La loi protège les intérêts du parent <w>survivant</w> lors de la liquidation des biens."
                        }
                    ],
                    "common_phrases": [
                        "conjoint survivant",
                        "époux survivant"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42855f27-6866-3581-9d2f-2a27dffc3bfc",
                    "sense_definition": "Participe présent de <w>survivre</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>survivant</w> à cette terrible épreuve, il a démontré une force mentale remarquable."
                        },
                        {
                            "text": "Tout en <w>survivant</w> avec de faibles ressources, cette communauté préserve fièrement sa culture."
                        }
                    ],
                    "common_phrases": [
                        "en survivant"
                    ]
                }
            ]
        }
    ]
}