                "senses": [
                    {
                        "sense_id": "90a44cd9-48cc-36c0-81a1-ee2e2fd861df",
                        "entry_id": "0ece7096-46d8-3bb7-a036-9d093eb483de",
                        "glosses": [
                            "Donner un caractère amical à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "addfea4f-1005-4d1a-ac80-0f852709f62f",
                                "sense_id": "90a44cd9-48cc-36c0-81a1-ee2e2fd861df",
                                "text": "Il faut lâcher du lest, redéfinir tes rapports aux gens (notamment le sexe convoité), amicaliser un peu tout ça, détendre les attentes, et au final ne plus rien attendre d'aussi \"primordial\", oublier cette attente en tant que \"but\"..."
                            }
                        ]
                    },
                    {
                        "sense_id": "2709039f-9788-39f1-a5c8-272e85ff3e26",
                        "entry_id": "0ece7096-46d8-3bb7-a036-9d093eb483de",
                        "glosses": [
                            "Devenir ami."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f5b20f-1b15-4435-9fd8-c2ee7bf5dd52",
                                "sense_id": "2709039f-9788-39f1-a5c8-272e85ff3e26",
                                "text": "Moi maintenant que mon cœur ne se détache pas du même mec depuis plus de 2 ans je peux amicaliser avec les autres sans danger!"
                            },
                            {
                                "example_id": "12418cdf-eb2f-4a82-805a-33974141cc80",
                                "sense_id": "2709039f-9788-39f1-a5c8-272e85ff3e26",
                                "text": "Je me souviens de mon père qui me répétait souvent que la meilleur façon d'amicaliser avec un peuple est d'adopter leurs coutumes."
                            }
                        ]
                    }
                ],
