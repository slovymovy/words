                                    {
                                        "sense_id": "6502f6de-6c10-35fb-acff-3be3f2dafcfb",
                                        "entry_id": "63993c66-531a-31b0-b807-482d60115c7c",
                                        "glosses": [
                                            "Handlung (und ihr Ergebnis), fremdes Gebiet widerrechtlich in Besitz nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0af5d6-9d28-49d1-9547-2f88dba739e8",
                                                "sense_id": "6502f6de-6c10-35fb-acff-3be3f2dafcfb",
                                                "text": "„Die Kolonisation als Annexion eines fremden Territoriums, das im Interesse der eigenen Nation erschlossen werden sollte, hat die Lebensformen der Deutschen im Kaiserreich mit geprägt.“"
                                            },
                                            {
                                                "example_id": "9532518c-d05d-4546-a7c0-5ef82af64d8d",
                                                "sense_id": "6502f6de-6c10-35fb-acff-3be3f2dafcfb",
                                                "text": "„Er eroberte den Kaiserthron von Abessinien und bewahrte sein Reich mit dem Sieg über die Italiener vor der Kolonisation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16c23a52-21df-30f3-8be4-54288142b52e",
                                        "entry_id": "63993c66-531a-31b0-b807-482d60115c7c",
                                        "glosses": [
