                "senses": [
                    {
                        "sense_id": "37e484d8-dbcf-3fde-9883-f587f9dc9c50",
                        "entry_id": "55c32cd8-b2de-3733-8fda-b39a4f58de6c",
                        "glosses": [
                            "Rolling; having the ability to roll, usually due to wheels attached on the bottom."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2ee5084d-5d1f-418c-9cdd-804794908470",
                                "sense_id": "37e484d8-dbcf-3fde-9883-f587f9dc9c50",
                                "text": "“Back east, eh?” Jogi plucked a rolly bug from a grape. He said in a dry tone, “He didn't like you working for us, did he?”"
                            },
                            {
                                "example_id": "a3efb8ca-a19d-4d22-b1e2-2c5d4826d126",
                                "sense_id": "37e484d8-dbcf-3fde-9883-f587f9dc9c50",
                                "text": "We went inside, with Gayleen taking a little longer than usual due to her walking stick and her portable oxygen tank on a little rolly cart, and got a good table in the smoking section."
                            }
                        ]
                    },
                    {
                        "sense_id": "f533064e-265b-38a2-b42a-0d1d200f5a2a",
                        "entry_id": "55c32cd8-b2de-3733-8fda-b39a4f58de6c",
                        "glosses": [
                            "Rough, turbulent, characterized by large or rapid waves."
                        ],
                        "tags": [
                            "comparable",
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "447e239c-8f15-4485-af19-7b9a29663a09",
                                "sense_id": "f533064e-265b-38a2-b42a-0d1d200f5a2a",
                                "text": "San Diego’s legacy to America’s Cup history has little to do with the light-air, rolly-sea conditions off Point Loma"
                            },
                            {
                                "example_id": "81dd4ddc-1f26-4fce-9f71-5216c9cdde64",
                                "sense_id": "f533064e-265b-38a2-b42a-0d1d200f5a2a",
                                "text": "As soon as the Wave passed by—our earlier complacency had only cost us a few hours of discomfort, but no real danger—we up anchored to see if we could find somewhere in the anchorage that was less rolly."
                            }
                        ]
                    }
                ],
