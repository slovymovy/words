                    "frequency": "High",
                    "semantic_group_id": "exactitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Votre réponse à cette question difficile est tout à fait <w>correcte</w>."
                        },
                        {
                            "text": "Il a écrit une phrase grammaticalement <w>correcte</w> sur le tableau noir."
                        }
                    ],
                    "antonyms": [
                        "erroné",
                        "faux",
                        "incorrect"
                    ],
                    "common_phrases": [
