                    {
                        "sense_id": "7dbc2f74-3033-3558-bc43-7f48aa39799c",
                        "entry_id": "1df6f1d2-ccd3-374d-a077-b5cecfcf7326",
                        "glosses": [
                            "sehr weiß, sehr grau, schneeweiß"
                        ],
