                    },
                    {
                        "form_id": "5eab66dd-ed55-415d-8657-81959f95c461",
                        "entry_id": "2c2f011b-e1da-3e95-9c54-e11370457e74",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
