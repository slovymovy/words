                                "target_senses": [
                                    {
                                        "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                        "entry_id": "8e6824a1-1b17-3954-bfec-9550253a12f2",
                                        "glosses": [
                                            "A commemorative event like an anniversary, but taking place monthly rather than annually."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa137aef-dfea-4dc0-a7a5-9ead52fcc441",
                                                "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                                "text": "I might have expected you to forget. It's our first monthiversary!"
                                            },
                                            {
                                                "example_id": "931c4c27-7c42-4e25-8a3b-a15003a9a13d",
                                                "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                                "text": "The Companies make a monthly deduction from the Policy's cash value on the Policy's effective date and on each monthiversary (the same day of each succeeding month as the Policy's effective date, or, if there is no comparable valuation, the next valuation date)."
                                            },
                                            {
                                                "example_id": "ef94e23a-a242-4827-bd25-19f00a19a89c",
                                                "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                                "text": "“Happy monthiversary.” “Wait... what?” “Today, it's exactly one month since we met. I kept count.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
