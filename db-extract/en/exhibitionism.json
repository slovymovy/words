                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhibitionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b8c924f-233b-3788-a9df-ab33e1cfabba",
                                        "entry_id": "0caac0f9-3681-394e-bbec-eec3cc1559a9",
                                        "glosses": [
                                            "Pulsion qui consiste à exhiber, en public, les parties intimes de son anatomie (fesses ou parties génitales par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbc628bb-9430-464a-a344-4936fdd33c8b",
                                                "sense_id": "9b8c924f-233b-3788-a9df-ab33e1cfabba",
                                                "text": "Il a été arrêté pour exhibitionnisme, il se baladait avec son machin à l’air."
                                            },
                                            {
                                                "example_id": "ad2a38c8-d026-4f79-926d-515d4cf822eb",
                                                "sense_id": "9b8c924f-233b-3788-a9df-ab33e1cfabba",
                                                "text": "Les statistiques de police portaient de jour en jour le témoignage d’un relâchement bizarre de la moralité, et tout particulièrement les cas d’exhibitionnisme et de provocation à la débauche, souvent difficiles à déceler pour la police tellement ils paraissaient bénéficier de la part des témoins d’une complicité tacite, paraissaient se multiplier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07e11551-6b0a-30d0-b8e3-cf6b83fa2027",
                                        "entry_id": "0caac0f9-3681-394e-bbec-eec3cc1559a9",
                                        "glosses": [
                                            "Dans un contexte non sexuel, complaisance à montrer des comportements généralement considérés comme intimes ou secrets."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da170c6-304d-4dda-b82e-b22fa9493862",
                                                "sense_id": "07e11551-6b0a-30d0-b8e3-cf6b83fa2027",
                                                "text": "L’exhibitionnisme de la télévision."
                                            },
                                            {
                                                "example_id": "876833d7-83d6-4ed8-82c6-4ffdc865bea8",
                                                "sense_id": "07e11551-6b0a-30d0-b8e3-cf6b83fa2027",
                                                "text": "S'il est une pathologie qui rassemble les tueurs en série au-delà de leurs techniques et de leurs mobiles, c'est bien l'exhibitionnisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6df23746-0fe8-4449-bcaf-b29f5ed22801",
                        "source_entry_id": "d4e27c63-902b-3772-842d-78e322f68773",
                        "source_sense_description": "practice of drawing attention to oneself",
                        "target_lang_word": "Exhibitionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exhibitionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "Sexualtrieb, bei dem Lustgewinn aus der Zurschaustellung der eigenen Genitalien gezogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40533f1-a6b0-4af2-a779-823312c8e890",
                                                "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                                "text": "Exhibitionismus im klinischen Sinne, bedingt immer auch einen Leidensdruck Betroffener."
                                            },
                                            {
                                                "example_id": "5ae80818-006b-4d0e-ba2b-b001d961ec25",
                                                "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                                "text": "„Freud übrigens führt an, dass es im Verbergen auch ein Aufreizen gibt und dass der weibliche Exhibitionismus sich im Verrücken der Röcke, im Hochdrücken der Büste offenbart.“"
                                            },
                                            {
                                                "example_id": "00bd5320-4849-49a4-a77d-0cd312d1d506",
                                                "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                                "text": "„Zuzusehen, wie Adrienne auf der Party diesen Exhibitionismus beobachtete, weckte in Sylvia die Angst, dass Adrienne Gelüste hegte, die sie nicht befriedigen konnte, was sie wiederum unangenehm an Cyprians Warnung erinnerte, als Suzanne noch gelebt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "der Drang sich selbst oder sein Leben zu präsentieren, in die Öffentlichkeit zu tragen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80641cb6-13b1-476a-9a67-9ddcc4e61ef1",
                                                "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                                "text": "„Was sich mit den sozialen Netzwerken geändert hat, sind die Praktiken und der Kontext von Selbstdarstellung. Das wird von vielen älteren Menschen als Exhibitionismus missverstanden.“"
                                            },
                                            {
                                                "example_id": "12e2a916-2a11-49f2-9a02-1a0f3e1d7392",
                                                "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                                "text": "„Bis dahin war alles beherrscht gewesen von Narzissmus und Exhibitionismus, seltsam leblos, trotz der Kühnheit und der Zurschaustellung von Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "006c829d-1533-3b97-b22c-0b32832f805d",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "Handlung, die von einer männlichen Person verübt wird, bei der durch Zurschaustellung von Genitalien Dritte belästigt werden"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11fb042-6680-4387-a8dc-3e7bdc0dcb69",
                                                "sense_id": "006c829d-1533-3b97-b22c-0b32832f805d",
                                                "text": "„In Schwenningen kam es in der Nacht zu Samstag zu zwei Fällen von Exhibitionismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
