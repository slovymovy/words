                "senses": [
                    {
                        "sense_id": "7c379d0b-3f7f-3256-b7d3-c9f9d2b53cf9",
                        "entry_id": "f16d3b88-51df-3e2d-ac07-51546a5287c2",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de grignoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f57dca-662e-4c15-bffd-5ca11e4f9852",
                                "sense_id": "7c379d0b-3f7f-3256-b7d3-c9f9d2b53cf9",
                                "text": "Personne ne répondant, ils se risquent à lécher les murs : Hansel arrache un gros morceau de la grille, que sa sœur et lui se mettent à grignotter à belles dents…."
                            },
                            {
                                "example_id": "461b787e-2c2e-4ff6-be82-3f57fe559f42",
                                "sense_id": "7c379d0b-3f7f-3256-b7d3-c9f9d2b53cf9",
                                "text": "Des lapins, qu’on ne voyait pas, grignottant le treillage en fil de fer de leur baraque, faisaient entendre un petit bruit métallique, pénétrant et inquiet."
                            },
                            {
                                "example_id": "673be1ea-06a2-478f-a610-0f6acb1a8830",
                                "sense_id": "7c379d0b-3f7f-3256-b7d3-c9f9d2b53cf9",
                                "text": "Entends-tu, une souris qui resille (grignotte) nos bibis ?"
                            }
                        ]
                    }
