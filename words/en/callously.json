                {
                    "sense_id": "7ca180c8-ec3c-3a40-a645-c10c4a7346d3",
                    "sense_definition": "In a cruel, insensitive, or unfeeling manner, showing no regard for the feelings or suffering of others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>callously</w> dismissed dozens of loyal employees without offering any severance pay or explanation.",
                            "target_lang_translations": {
                                "nl": "De manager ontsloeg tientallen trouwe werknemers <w>harteloos</w> zonder enige ontslagvergoeding of uitleg te bieden."
                            }
                        },
                        {
                            "text": "He <w>callously</w> shrugged off their concerns, insisting that personal issues should not affect office productivity.",
                            "target_lang_translations": {
                                "nl": "Hij haalde <w>ongevoelig</w> zijn schouders op over hun zorgen en hield vol dat persoonlijke kwesties de productiviteit op kantoor niet mochten beïnvloeden."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardheartedly",
                        "unfeelingly",
                        "indifferently"
                    ],
                    "antonyms": [
                        "compassionately",
                        "sympathetically",
                        "tenderly"
                    ],
                    "common_phrases": [
                        "callously disregarded",
                        "callously ignored",
                        "treated callously"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een wrede, ongevoelige of kille manier, zonder rekening te houden met de gevoelens of het lijden van anderen."
                    },
