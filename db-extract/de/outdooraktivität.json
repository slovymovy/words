                ],
                "senses": [
                    {
                        "sense_id": "d0da2aa0-9862-3053-b8f7-859e572a740d",
                        "entry_id": "41119b40-92f2-3b2e-84e3-1d2c46955e8a",
                        "glosses": [
                            "sportliche, häufig riskante oder abenteuerliche Aktivität im Freien, meistens in der Natur"
                        ],
                        "tags": [
                            "Freizeit"
                        ],
                        "examples": [
                            {
                                "example_id": "1e8cbfa4-3a97-4336-8343-39946c22ca1c",
                                "sense_id": "d0da2aa0-9862-3053-b8f7-859e572a740d",
                                "text": "„Richtige Männer lieben riskante Outdooraktivitäten, fahren ein schnelles Motorrad und sind imstande ALLES selbst zu reparieren.“"
                            },
                            {
                                "example_id": "f144158c-f4d5-4888-aa04-42bf0307c238",
                                "sense_id": "d0da2aa0-9862-3053-b8f7-859e572a740d",
                                "text": "„Die Gegend ist von majestätischen Bergen umgeben, die optimale Bedingungen für Outdooraktivitäten bieten.“"
                            },
                            {
                                "example_id": "8c9e31f4-d3ee-4acd-b2e6-0f906914b110",
                                "sense_id": "d0da2aa0-9862-3053-b8f7-859e572a740d",
                                "text": "„Wer im Winter nicht auf Outdooraktivitäten verzichten will, ist auf funktionale Winterbekleidung und Skibekleidung angewiesen.“"
                            },
                            {
                                "example_id": "01aebad9-3d5f-48b8-ac90-24c88d0688a8",
                                "sense_id": "d0da2aa0-9862-3053-b8f7-859e572a740d",
                                "text": "„Wer nicht gerade auf Berge klettert oder Höhlen erkundet, hat bisher kein passenderes Kleidungsstück für seine Outdooraktivitäten gefunden.“"
                            },
                            {
                                "example_id": "931954a5-bbad-4ef0-ab54-6f01ea1c2d47",
                                "sense_id": "d0da2aa0-9862-3053-b8f7-859e572a740d",
                                "text": "„Unser Nachbarland hat nämlich beschlossen, zahlreiche Gebiete fürs legale Übernachten im Wald freizugeben und damit auf ein gestiegenes Interesse an Outdooraktivitäten wie Wandern, Radfahren und auch Survival und Bushcrafting reagiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
