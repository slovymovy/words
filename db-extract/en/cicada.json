                                    {
                                        "sense_id": "d5507ec4-a6cc-3719-85a1-892c85db4c86",
                                        "entry_id": "d91f1408-421f-34d3-ae23-ab9805995678",
                                        "glosses": [
                                            "an Pflanzen saugende Insekten der Gruppe der Gleichflügler (Homoptera)"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5499632-2031-48ae-a5ed-88a57683b63f",
                                                "sense_id": "d5507ec4-a6cc-3719-85a1-892c85db4c86",
                                                "text": "Weltweit sind etwa vierzigtausend Arten von Zikaden beschrieben."
                                            },
                                            {
                                                "example_id": "3c391a10-ab8e-4598-a44f-a42913a4f2fa",
                                                "sense_id": "d5507ec4-a6cc-3719-85a1-892c85db4c86",
                                                "text": "„Aus dem grünen schattigen Dickichte tönte das schrille Zirpen der Zikaden, und der Wind verbreitete einen alles überwältigenden Blumen- und Blütenduft.“"
                                            },
                                            {
                                                "example_id": "a024b329-13e7-4a65-8b26-5664fb9b6d3c",
                                                "sense_id": "d5507ec4-a6cc-3719-85a1-892c85db4c86",
                                                "text": "„Ich erinnerte mich daran, wie Amalia uns in unserem ersten gemeinsamen Frankreichurlaub davon erzählt hatte, dass die Gesänge der Zikaden die von Liebenden sind, die ihren Partner verloren haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
