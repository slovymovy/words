                "entry_id": "b9d1da89-07f9-3710-b04e-bd65e202c959",
                "word": "Apennin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54a046f3-cc2e-4bff-aa7b-8a630e534d64",
                        "entry_id": "b9d1da89-07f9-3710-b04e-bd65e202c959",
                        "tags": [
                            "plural"
                        ],
                        "form": "Apennins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                        "entry_id": "b9d1da89-07f9-3710-b04e-bd65e202c959",
                        "glosses": [
                            "Chaîne de montagnes traversant l’Italie du nord au sud. On distingue :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c358373c-ebb9-47be-b585-dc43450af4c0",
                                "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                                "text": "L’Apennin du Nord ou Apennin septentrional, au nord, relié aux Alpes."
                            },
                            {
                                "example_id": "635fc74f-013f-48f4-9d04-0765c7ff8bbf",
                                "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                                "text": "L’Apennin tosco-émilien, entre la Toscane et l’Émilie-Romagne."
                            },
                            {
                                "example_id": "1f27684b-ddab-4860-b201-ce141d34b234",
                                "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                                "text": "L’Apennin central, qui englobe en grande partie la région des Abruzzes, s’étend des monts Sibyllins au nord aux monts du Matese au sud."
                            },
                            {
                                "example_id": "84408311-c7e1-4139-949f-aca78570044d",
                                "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                                "text": "L’Apennin du sud, ou Apennin méridional, divisé en trois zones : Apennin samnite, Apennin lucanien et Apennin calabrais."
                            },
                            {
                                "example_id": "6ba7824a-90f2-4c29-96e4-53e6a962e3f8",
                                "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                                "text": "Entre la mer et le fleuve, il y a l’Apennin ligure, pince de homard hérissée de piquants et boursouflée de boursouflures. Depuis la crête de l’Apennin, au fond de gouffres parallèles, des torrents nombreux dégringolent vers la plaine du Pô. Deux de ces torrents, deux voisins séparés par une mince arête de granit, sont la Trebbia et le Nure."
                            },
                            {
                                "example_id": "7bd9c633-7745-4b88-ab21-a9f13e0a0140",
                                "sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                                "text": "Les Apennins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5d81afa-3af2-44e1-a4c4-7f892d65a407",
                        "source_entry_id": "b9d1da89-07f9-3710-b04e-bd65e202c959",
                        "source_sense_id": "50c59a2e-1378-3cca-8997-228e8290d9fe",
                        "target_lang_word": "Apennin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apennin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a5fbc00-83c4-3247-94e6-02570bb52943",
                                        "entry_id": "11cff404-c551-348b-af32-7fb4f0464e37",
                                        "glosses": [
                                            "Gebirgszug, der weite Teile Italiens längs durchzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dca6b0c-48de-4a4e-b353-cadb4d17070a",
                                                "sense_id": "0a5fbc00-83c4-3247-94e6-02570bb52943",
                                                "text": "„Alpe della Luna, Mondalpen, heißt dieser Gebirgsrücken des Apennins.“"
                                            },
                                            {
                                                "example_id": "219fc08f-743a-4c5e-b7e0-ce4ae5d98a9b",
                                                "sense_id": "0a5fbc00-83c4-3247-94e6-02570bb52943",
                                                "text": "„Der Druck hat den Apennin aufgefaltet, das Gebirge durchzieht das stiefelförmige Italien der Länge nach.“"
                                            },
                                            {
                                                "example_id": "c4c2dbe8-d2c6-4892-afac-6c50c533ff15",
                                                "sense_id": "0a5fbc00-83c4-3247-94e6-02570bb52943",
                                                "text": "„Auf der Höhe des Apennin glaubte ich, der Sturm würde mich forttragen; aber um nichts in der Welt hätte ich länger als die drei oder vier Minuten angehalten, die zum Wechseln der Pferde nötig waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
