                "senses": [
                    {
                        "sense_id": "6dfae2d5-a3d8-3679-b0b7-f780cedba496",
                        "entry_id": "bb855021-875f-3ef7-8ee4-1e2720e3816d",
                        "glosses": [
                            "Changer un tarif, ou la valeur d’une monnaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72dc1f60-a382-479a-8931-6bae6765e3d3",
                                "sense_id": "6dfae2d5-a3d8-3679-b0b7-f780cedba496",
                                "text": "Il fallut retarifer le denier à 16 as."
                            },
                            {
                                "example_id": "d29b7011-96fa-478d-ad26-f2825d028b33",
                                "sense_id": "6dfae2d5-a3d8-3679-b0b7-f780cedba496",
                                "text": "En 209 (Marchetti) ou vers 1 50 (Crawford), le denier, qui valait 10 as, fut « retarifé » à 16 as, le sesterce valant dès lors non plus 2,5 as, mais 4 as — sauf pour le règlement de la solde."
                            }
                        ]
                    }
