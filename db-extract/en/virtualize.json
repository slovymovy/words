                "translations": [
                    {
                        "translation_id": "3f2fa43e-d284-4715-8d93-45002d587034",
                        "source_entry_id": "e565794d-df97-3cd3-bead-e96546baa6fc",
                        "source_sense_description": "run a program in virtual storage",
                        "target_lang_word": "virtualiseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtualiseren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "44138730-0397-38ea-a568-7ff26e310287",
                                        "entry_id": "6cd12860-b216-32b1-8daa-9454ebb3a85a",
                                        "glosses": [
                                            "het gelijktijdig draaien van meerdere besturingssystemen op één computer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a637ca-71ad-44cd-9729-4804c98fe3af",
                                                "sense_id": "44138730-0397-38ea-a568-7ff26e310287",
                                                "text": "Door het virtualiseren van zo’n 10.000 werkplaatsen hebben we ook de levensduur van onze machines kunnen optrekken van 3 tot 5 jaar, een besparing van tonnen CO² per jaar."
                                            },
                                            {
                                                "example_id": "8b8bdc43-98bf-441f-9fd4-850d547788e1",
                                                "sense_id": "44138730-0397-38ea-a568-7ff26e310287",
                                                "text": "Ze kunnen, als ze willen evolueren richting cloud computing, hun servers wel beter gebruiken door die te virtualiseren, zoals dat heet."
                                            },
                                            {
                                                "example_id": "200fcaee-cdee-4264-a816-d08ac29e8a64",
                                                "sense_id": "44138730-0397-38ea-a568-7ff26e310287",
                                                "text": "Tijd nu om wat dieper in te gaan op de HP Workspace-technologie. Wanneer je de gelijknamige applicatie opstart beland je in een gevirtualiseerde Windows-omgeving die vanaf een serverpark naar het toestel wordt gestreamd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc586796-561f-4c28-8b33-8f2b61bb0698",
                        "source_entry_id": "e565794d-df97-3cd3-bead-e96546baa6fc",
                        "source_sense_description": "run a program in virtual storage",
                        "target_lang_word": "virtualisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtualisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fae0a3b4-73ee-38d9-af8d-5e7de2ac8810",
                                        "entry_id": "8bc68c38-0f4d-32bd-bf99-d17e7bf9ffe4",
                                        "glosses": [
                                            "in die virtuelle, nicht körperliche Welt übernehmen, dort stattfinden lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7545c6-2f51-428c-ad55-4c4a063f5113",
                                                "sense_id": "fae0a3b4-73ee-38d9-af8d-5e7de2ac8810",
                                                "text": "„Wir virtualisieren die Wirklichkeit in einem Ausmaß, das unser Beharrungsvermögen in einer relativ fest verfugten Umwelt auf das Äußerste provoziert.“"
                                            },
                                            {
                                                "example_id": "02dd4f93-ec44-48df-a6d2-a2cfebb90c9c",
                                                "sense_id": "fae0a3b4-73ee-38d9-af8d-5e7de2ac8810",
                                                "text": "„Sie ist vielmehr selbst eine besondere Art, Erlebnisse zu virtualisieren oder zu metaphorisieren, also sie in Metaphern mit verallgemeinerbarer Bedeutung zu transformieren, ihrer »Wahrheit« näher zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a06a9b6f-1dd5-316f-9d95-92c5c2b96f55",
                                        "entry_id": "8bc68c38-0f4d-32bd-bf99-d17e7bf9ffe4",
                                        "glosses": [
                                            "simuliert stattfinden (lassen)"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43352749-3c77-4f8b-a34f-fb87ff2159b4",
                                                "sense_id": "a06a9b6f-1dd5-316f-9d95-92c5c2b96f55",
                                                "text": "„Ein anderes Modell ist es, auf der Softwareebene zu virtualisieren ([…]). Das Betriebssystem wird auf eine durch Software simulierte virtuelle Maschine portiert und dort ausgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
