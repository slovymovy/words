                    {
                        "translation_id": "55726186-2a86-43c6-92f8-d2800ce30731",
                        "source_entry_id": "a7617d41-1f4e-35e6-89b3-94908b61e150",
                        "source_sense_id": "a60f14e7-5bbd-38b8-9596-43ab2efa4d29",
