                                "example_id": "568df75a-d663-4cdd-ae80-6513230692cd",
                                "sense_id": "8921d616-8d08-34f4-aff7-af2fe2040afc",
                                "text": "Kunstcentrum Witte de With in Rotterdam heeft een nieuwe naam en gaat verder als Kunstinstituut Melly. Ruim drie maanden geleden was de naam al van de gevel gehaald, nadat die kort daarvoor was beklad door de actiegroep 'Helden van Nooit.'"
                            },
                            {
                                "example_id": "50572904-14d3-4132-8eed-5059256bad6f",
                                "sense_id": "8921d616-8d08-34f4-aff7-af2fe2040afc",
                                "text": "'Dit is het Quartier Latin en Parijs is het kunstcentrum, weet je."
                            }
                        ]
                    }
