                "senses": [
                    {
                        "sense_id": "a8d41885-0c6e-3d6a-837e-c283ee5288e1",
                        "entry_id": "f9b5b3e7-8151-3281-b778-b2467ecdb456",
                        "glosses": [
                            "tie-down, bending, tying down (agr.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d4db10-28ce-455e-9ac8-2488863e7301",
                                "sense_id": "a8d41885-0c6e-3d6a-837e-c283ee5288e1",
                                "text": "Метод отгиба заключается в подвязывании ветвей и выравнивании кроны, чтобы все места цветения получали равное количество света, что повышает урожайность."
                            },
                            {
                                "example_id": "aefaac57-5022-451f-a7ed-69f6c084e6e9",
                                "sense_id": "a8d41885-0c6e-3d6a-837e-c283ee5288e1",
                                "text": "The tie-down method consists of tying down the branches and leveling the canopy so that all flowering sites get equal amounts of light, thus increasing yields."
                            }
                        ]
                    }
                ],
