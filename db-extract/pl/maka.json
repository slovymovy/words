                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40e428ee-d3af-31df-8d0c-1495efa76ef7",
                                        "entry_id": "0864846a-2ea9-317f-a5a0-c8ccacd1e235",
                                        "glosses": [
                                            "Any of species Lepidium meyenii, an Andean medicinal herb, or an extract of the root of this plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bc5c959-3602-426a-9de2-a6a150c4a78c",
                                                "sense_id": "40e428ee-d3af-31df-8d0c-1495efa76ef7",
                                                "text": "The overwhelming majority of maca roots are dried after harvest. In the cold, dry atmosphere of the puna the dried roots remain edible for several years. A minor proportion of the freshly harvested roots are roasted in huatias, earthen ovens […]"
                                            },
                                            {
                                                "example_id": "a6416c31-55ee-4049-88f1-3a27a752befb",
                                                "sense_id": "40e428ee-d3af-31df-8d0c-1495efa76ef7",
                                                "text": "The gap between what the Internet promises and what it delivers is part of the reason that people[…] continue to turn to enhancers from caffeine to maca to virtual reality."
                                            },
                                            {
                                                "example_id": "7685a64d-0248-4252-beab-4cace4ed20dc",
                                                "sense_id": "40e428ee-d3af-31df-8d0c-1495efa76ef7",
                                                "text": "Dried macas are cooked in water or milk and used to prepare a kind of sweet and aromatic porridge, mazamorra. The small macas are preferred, since they are less fibrous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
