                ],
                "senses": [
                    {
                        "sense_id": "862f878f-36e7-3209-bab6-41388ef4597c",
                        "entry_id": "a20ec09b-c94c-3fe2-b5d0-037a6983c284",
                        "glosses": [
                            "Arbeitszeit, Dienst in der Frühe, am Morgen"
                        ],
                        "tags": [
                            "Schichtarbeit"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a14741-f0f0-4198-b8f9-e3d223b48d8e",
                                "sense_id": "862f878f-36e7-3209-bab6-41388ef4597c",
                                "text": "Jeden Dienstag und Donnerstag hatte er Frühschicht und war deshalb am Abend sehr müde."
                            },
                            {
                                "example_id": "d0f8a0d6-bb1e-488d-8334-d2faecdc0fe6",
                                "sense_id": "862f878f-36e7-3209-bab6-41388ef4597c",
                                "text": "„Da der 1. Mai 1916 ein Freitag und damit ein ganz normaler Arbeitstag war, kamen die Arbeiter der Frühschicht in vielen Betrieben zu früh, auch im Berufs- und Lieferverkehr klappte an diesem Tag wenig reibungslos.“"
                            },
                            {
                                "example_id": "6db8dc64-54d6-450b-9056-1f05a0ce7005",
                                "sense_id": "862f878f-36e7-3209-bab6-41388ef4597c",
                                "text": "„Wer am nächsten Morgen zur Frühschicht muss, ist entschuldigt.“"
                            },
                            {
                                "example_id": "57abef84-1b5a-4001-98e6-d5927a001d5d",
                                "sense_id": "862f878f-36e7-3209-bab6-41388ef4597c",
                                "text": "„Der Zeitungsjunge, die Fischerfrauen auf dem Belsunce, die Händlerinnen, die ihre Läden öffneten, die Arbeiter auf dem Weg zur Frühschicht, sie alle gehörten zur Menge derer, die nie abfahren, mag geschehen, was will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "752bb428-5e3a-321a-b581-2d9fd061e6b7",
                        "entry_id": "a20ec09b-c94c-3fe2-b5d0-037a6983c284",
                        "glosses": [
                            "Gruppe der Arbeiter in der Frühschicht"
                        ],
                        "tags": [
                            "Schichtarbeit"
                        ],
                        "examples": [
                            {
                                "example_id": "cddcef33-f43d-4426-b9f5-8a4485ffd44c",
                                "sense_id": "752bb428-5e3a-321a-b581-2d9fd061e6b7",
                                "text": "Die Frühschicht entschied sich gegen einen Streik."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
