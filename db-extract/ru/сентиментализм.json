                    {
                        "translation_id": "ffd16ac3-72a5-4388-8dae-30ccbfd9072b",
                        "source_entry_id": "cd456c6c-33b4-31ad-9ccc-b9a42e285d0b",
                        "source_sense_id": "a3dec3c5-bfba-30a2-8625-1423997206e3",
