        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57b0ce5f-86a7-3d92-9d4f-7178a566594e",
                    "sense_definition": "Clear, definite, and unquestionable; easily noticed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a <w>decided</w> improvement in the weather today compared to yesterday.",
                            "target_lang_translations": {
                                "ru": "Сегодня наблюдается <w>явное</w> улучшение погоды по сравнению со вчерашним днём.",
                                "zh": "与昨天相比，今天的天气有了<w>明显的</w>好转。"
                            }
                        },
                        {
                            "text": "The home team had a <w>decided</w> advantage over their opponents.",
                            "target_lang_translations": {
                                "ru": "У хозяев поля было <w>несомненное</w> преимущество перед соперниками.",
                                "zh": "主队相比对手拥有<w>显著的</w>优势。"
                            }
