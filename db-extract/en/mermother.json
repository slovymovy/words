                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa49893-e761-4334-86df-23e21f80a4f2",
                                "sense_id": "7e968845-0dcd-338a-8d1d-f9ef73680aa5",
                                "text": "\"I shall never see my merfather or my mermother any more, or the mermaids, or the fish-king, or the merry dolphins, or-r-r-r \" —\n\"Never mind!\" cried Elfie, crying too, and she put her arms around the sad little mermaid's neck."
                            },
                            {
                                "example_id": "9ad68b36-ff99-4e1e-9469-fddc3b6a6fb9",
                                "sense_id": "7e968845-0dcd-338a-8d1d-f9ef73680aa5",
                                "text": "Suddenly a lovely sound filled the air. Ariel turned toward it. Nefazia was sitting on the rock, singing. Her song was low and sweet, like a mermother crooning to her baby."
                            },
                            {
                                "example_id": "29e96438-c03b-4c3b-91db-f72d08731d93",
                                "sense_id": "7e968845-0dcd-338a-8d1d-f9ef73680aa5",
                                "text": "A mermother pushed an infant merbaby along the street in an old stroller. Soon Sabrina and the merman reached an enormous palace, nearly five stories high."
                            }
                        ]
                    }
