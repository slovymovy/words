                                "target_senses": [
                                    {
                                        "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                        "entry_id": "9cb1ac51-5b67-3e53-a5ad-bdce81add46c",
                                        "glosses": [
                                            "Focused on audible sound, as opposed to sight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d79bfa-e2d0-4d29-9a9b-88bdc97269df",
                                                "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                                "text": "If you're more audio than visual, tune in on the \"A-V Soap Opera\" (page 375)."
                                            },
                                            {
                                                "example_id": "a0ee5bd2-86dd-4544-9060-1c6a765565ca",
                                                "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                                "text": "I'm very audio, so I hear words."
                                            },
                                            {
                                                "example_id": "9b4a9338-480f-4d80-b070-6adbab77ea9b",
                                                "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                                "text": "For example, if the person uses visual predicates such as “I see” or “I can't picture that,” the most powerful influencers will respond by saying “Let me show you,” as opposed to “let me explain,” the latter predicate being more audio than visual."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "audio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5db7c949-1048-380b-81cd-632751ac32b8",
                                        "entry_id": "0f77786b-755f-3c69-b322-50d5d3289341",
