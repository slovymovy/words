                "senses": [
                    {
                        "sense_id": "75e74dad-afd2-3c30-a307-082f458c8ed2",
                        "entry_id": "28407a61-1296-3b4f-9473-6e90b2677120",
                        "glosses": [
                            "de melding dat iemand gestorven is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ccfb704-594f-482b-807e-c25d2016c294",
                                "sense_id": "75e74dad-afd2-3c30-a307-082f458c8ed2",
                                "text": "Een IJslandse krant heeft een enorme blunder gegaan, door de foto van Ed Sheeran (26) bij een overlijdensbericht van een 82-jarige overleden man te plaatsen."
                            },
                            {
                                "example_id": "67f8e40c-25eb-42b9-b03c-7c0417a4cb1b",
                                "sense_id": "75e74dad-afd2-3c30-a307-082f458c8ed2",
                                "text": "De Belgische terrorist stond ook bekend als de ’nieuwe Abdelhamid Abaaoud’, het Molenbeekse brein achter de aanslagen in Parijs in november 2015. Voor de veiligheidsdiensten is er geen reden voor opluchting. IS heeft wel vaker overlijdensberichten de wereld ingestuurd om de aandacht af te leiden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b67feb9-bdc3-4a69-8def-48389072526e",
                        "source_entry_id": "28407a61-1296-3b4f-9473-6e90b2677120",
                        "source_sense_id": "75e74dad-afd2-3c30-a307-082f458c8ed2",
