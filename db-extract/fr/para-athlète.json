                    {
                        "sense_id": "fac1ac6a-9b80-3b80-9b0b-33c8b1c251db",
                        "entry_id": "76de0a61-b8f9-3aae-a187-cf35a1413d95",
                        "glosses": [
                            "Athlète handicapé participant à des compétitions spécialisées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8edc931c-c178-4ffb-98b8-11dd477e9cd8",
                                "sense_id": "fac1ac6a-9b80-3b80-9b0b-33c8b1c251db",
                                "text": "Comme lui, d’autres para-athlètes sont devenus leur propre communicant."
                            },
                            {
                                "example_id": "2ff0521c-7078-403a-8fce-056f16513ed6",
                                "sense_id": "fac1ac6a-9b80-3b80-9b0b-33c8b1c251db",
                                "text": "En cause : « Une trop faible diffusion. Le handisport n’est pas assez valorisé en France, et c’est dommage », constate Yasser Musanganya, para-athlète en fauteuil roulant."
                            },
                            {
                                "example_id": "6bce8f05-46ff-4c4c-bcab-3e3856c02a6d",
                                "sense_id": "fac1ac6a-9b80-3b80-9b0b-33c8b1c251db",
                                "text": "Parmi les 138 para-athlètes de la délégation française, huit sont originaires de la région Provence Alpes Côte-d'Azur."
                            }
                        ]
                    }
                ],
