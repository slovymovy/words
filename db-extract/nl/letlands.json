                "translations": [
                    {
                        "translation_id": "bcf506aa-54d5-435e-81eb-e9db386ab523",
                        "source_entry_id": "4d7b4e43-6109-3463-92fe-09895edc3f78",
                        "source_sense_id": "600c085c-e039-3dee-ae98-91028c6ef373",
