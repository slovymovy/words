                "forms": [],
                "senses": [
                    {
                        "sense_id": "85484e7c-bcda-3c4f-960a-52544739660e",
                        "entry_id": "e6d779e1-1330-3102-b86a-413cccd56f4b",
                        "glosses": [
                            "das Spiel mit offenen Karten beim Skat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d8fe291-d225-4ceb-b93b-0ed38ea7a2e5",
                                "sense_id": "85484e7c-bcda-3c4f-960a-52544739660e",
                                "text": "Null ouvert ist angesagt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3814628f-cd07-4807-bb27-7dfa24a09fb2",
                        "source_entry_id": "e6d779e1-1330-3102-b86a-413cccd56f4b",
                        "source_sense_id": "85484e7c-bcda-3c4f-960a-52544739660e",
                        "source_sense_description": "das Spiel mit offenen Karten beim Skat",
                        "target_lang_word": "ouvert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6209f1-44a8-3007-ab3a-de00f57b2218",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
                                            "Qui n’est pas fermé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97f2f78-8b67-4b05-84c4-6c7a1c9c3cbd",
                                                "sense_id": "3f6209f1-44a8-3007-ab3a-de00f57b2218",
                                                "text": "Seul, Delcassé s'est rendu à l’Étoile en auto ouverte. Il espérait une ovation, mais la foule resta muette."
                                            },
                                            {
                                                "example_id": "7aab0fc1-954a-4ad5-9f37-0db1ba7a3016",
                                                "sense_id": "3f6209f1-44a8-3007-ab3a-de00f57b2218",
                                                "text": "Entrez ! C’est ouvert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b178f26-b84d-39d0-a084-09799ad65bb4",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
                                            "Qui est écarté, en parlant des membres ou d’un organe du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b8326e-07d0-422e-8553-103773b870fd",
                                                "sense_id": "8b178f26-b84d-39d0-a084-09799ad65bb4",
                                                "text": "Il se carre d’aplomb, les pieds à l’équerre, les jambes mi-fléchies et bien ouvertes. D’un coup d’un seul, il s’agit d’égobeler ce hêtre."
                                            },
                                            {
                                                "example_id": "5d2c5b68-4396-419d-bcf8-8da3e913ace8",
                                                "sense_id": "8b178f26-b84d-39d0-a084-09799ad65bb4",
                                                "text": "Et, laissant échapper le rideau, il s’approcha du lit. Flossie continuait de ronfler, la bouche ouverte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3ce11af-83cb-3e6d-a244-2062cb676dcf",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
                                            "Qui dénote une personne affable , qui ne discrimine pas."
