                                        "sense_id": "c8da28eb-f937-31e4-a523-216c7ea29c94",
                                        "entry_id": "f3d9be5c-d247-3690-b7d7-accbd8c321ee",
                                        "glosses": [
                                            "A café in which customers may access the Internet, play video games etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8e6be44-17bb-43d0-96a6-eed2c406ee0c",
                                                "sense_id": "c8da28eb-f937-31e4-a523-216c7ea29c94",
                                                "text": "The notion of a cybercafe—a place for Net surfers to socialize on a tide of gourmet coffee—is at odds with how most people want to use computers, even in their leisure time."
                                            },
                                            {
                                                "example_id": "d5fb25f4-cc8b-4762-845e-c5f12879e5a1",
                                                "sense_id": "c8da28eb-f937-31e4-a523-216c7ea29c94",
                                                "text": "Most recently, the rattiest old cybercafes in Queens have been shut down, following too-frequent fights among hotheaded video-game patrons. And the once-glamorous @Cafe in Manhattan was already boarded up by 1998!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
