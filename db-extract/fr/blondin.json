                                        "entry_id": "695b31bf-aa84-38d3-b691-d58d0b1662f1",
                                        "glosses": [
                                            "seilbahnähnliche Krananlage, bei der die Laufkatze auf einem Drahtseil läuft, geeignet zum Heben und Transportieren von Lasten über größere Distanzen, eingesetzt beim Staumauerbau, Brückenbau, Schiffsbau, in der Forstwirtschaft und in Steinbrüchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b08da075-7651-479c-935f-25f0181b511f",
                                                "sense_id": "5cc4046b-95c7-318f-a79f-3dd86c8d3c24",
                                                "text": "Zwei Kabelkrane von 1000 Meter Länge und 30 t Tragkraft kommen beim Bau des Staudammes zum Einsatz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ffe4921-7ec8-4edd-97d8-ab4a5c71bd3f",
                        "source_entry_id": "2e103bba-72ea-39f4-9884-cdfdda87cc14",
                        "source_sense_id": "95bb1dcb-8c41-3bc6-ada9-9ece7d0607d4",
                        "target_lang_word": "blondin",
