{
    "word_family": [
        "bumpy",
        "bumper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e072cb93-941f-339b-9a7f-433bb09f21e0",
                    "sense_definition": "A light blow or a collision that causes a jolt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "collision_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a loud <w>bump</w> coming from the room upstairs.",
                            "target_lang_translations": {
                                "ru": "Я услышал громкий <w>стук</w>, доносящийся из комнаты наверху.",
                                "tr": "Yukarıdaki odadan yüksek bir <w>gümleme</w> sesi duydum.",
                                "zh": "我听到楼上房间传来一声巨大的<w>撞击声</w>。"
                            }
                        },
                        {
                            "text": "The car had a small <w>bump</w> with a delivery truck.",
                            "target_lang_translations": {
                                "ru": "У машины было небольшое <w>столкновение</w> с грузовиком доставки.",
                                "tr": "Araba bir teslimat kamyonuyla küçük bir <w>çarpışma</w> yaşadı.",
                                "zh": "那辆车和一辆送货卡车发生了轻微的<w>碰撞</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "loud bump",
                        "bump on the head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий удар или столкновение, вызывающее толчок.",
                        "tr": "Sarsıntıya neden olan hafif bir darbe veya çarpışma.",
                        "zh": "指轻微的碰撞或由此产生的震动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́р",
                                "target_lang_sense_clarification": "резкое соприкосновение"
                            },
                            {
                                "target_lang_word": "столкнове́ние",
                                "target_lang_sense_clarification": "авария, конфликт"
                            },
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "звук удара"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çarpma",
                                "target_lang_sense_clarification": "hafif darbe veya temas"
                            },
                            {
                                "target_lang_word": "vuruş",
                                "target_lang_sense_clarification": "darbe sesi veya etkisi"
                            },
                            {
                                "target_lang_word": "çarpışma",
                                "target_lang_sense_clarification": "araç veya cisimlerin toslaması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碰撞",
                                "target_lang_sense_clarification": "物体间的撞击"
                            },
                            {
                                "target_lang_word": "撞击声",
                                "target_lang_sense_clarification": "碰撞发出的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14494a4c-457e-3c6f-83f7-6c3fd6208316",
                    "sense_definition": "A small swelling on the skin caused by an injury or an insect bite.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protuberance_swelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a nasty <w>bump</w> on his forehead from the fall.",
                            "target_lang_translations": {
                                "ru": "У него на лбу ужасная <w>шишка</w> от падения.",
                                "tr": "Düşme nedeniyle alnında kötü bir <w>şişlik</w> var.",
                                "zh": "他摔倒后额头上起了一个难看的<w>包</w>。"
                            }
                        },
                        {
                            "text": "Put some ice on that <w>bump</w> to reduce the swelling.",
                            "target_lang_translations": {
                                "ru": "Приложи лёд к этой <w>шишке</w>, чтобы уменьшить отек.",
                                "tr": "Şişliği azaltmak için o <w>şişin</w> üzerine biraz buz koy.",
                                "zh": "在那个<w>肿块</w>上敷点冰块以消肿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nasty bump",
                        "goose bumps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая припухлость на коже от ушиба или укуса насекомого.",
                        "tr": "Yaralanma veya böcek ısırması nedeniyle ciltte oluşan küçük şişlik.",
                        "zh": "因受伤或昆虫叮咬而在皮肤上形成的肿块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ши́шка",
                                "target_lang_sense_clarification": "припухлость на теле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şişlik",
                                "target_lang_sense_clarification": "derideki kabarıklık"
                            },
                            {
                                "target_lang_word": "şiş",
                                "target_lang_sense_clarification": "darbe veya ısırık sonucu oluşan kabarık alan"
                            },
                            {
                                "target_lang_word": "yumru",
                                "target_lang_sense_clarification": "vücuttaki küçük kabartı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肿块",
                                "target_lang_sense_clarification": "皮肤上的隆起"
                            },
                            {
                                "target_lang_word": "包",
                                "target_lang_sense_clarification": "受撞击后隆起的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "946604d1-bb7b-37d6-94e6-6e809d772a46",
                    "sense_definition": "A raised, uneven part on a flat surface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protuberance_swelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car slowed down to go over the speed <w>bump</w>.",
                            "target_lang_translations": {
                                "ru": "Машина притормозила, чтобы переехать через <w>лежачий полицейский</w>.",
                                "tr": "Araba hız <w>kasisinden</w> geçmek için yavaşladı.",
                                "zh": "汽车减速以通过<w>减速带</w>。"
                            }
                        },
                        {
                            "text": "Be careful not to trip over the <w>bump</w> in the rug.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не споткнись о <w>бугор</w> на ковре.",
                                "tr": "Halıdaki <w>tümseğe</w> takılıp düşmemeye dikkat et.",
                                "zh": "小心别被地毯上的<w>凸起</w>绊倒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speed bump",
                        "road bump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпуклая, неровная часть на плоской поверхности.",
                        "tr": "Düz bir yüzeydeki yüksek, engebeli kısım.",
                        "zh": "平坦表面上隆起或不平整的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уха́б",
                                "target_lang_sense_clarification": "неровность на дороге"
                            },
                            {
                                "target_lang_word": "колдо́бина",
                                "target_lang_sense_clarification": "яма или бугор на дороге"
                            },
                            {
                                "target_lang_word": "вы́пуклость",
                                "target_lang_sense_clarification": "выступающая часть"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tümsek",
                                "target_lang_sense_clarification": "yoldaki veya yüzeydeki çıkıntı"
                            },
                            {
                                "target_lang_word": "kasis",
                                "target_lang_sense_clarification": "araç yavaşlatma kasisi"
                            },
                            {
                                "target_lang_word": "engebe",
                                "target_lang_sense_clarification": "yüzeydeki pürüz veya yükselti"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凸起",
                                "target_lang_sense_clarification": "表面隆起的部分"
                            },
                            {
                                "target_lang_word": "减速带",
                                "target_lang_sense_clarification": "道路上的凸起物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c41e2a7-bd97-3afd-8e39-5f8c29ff9a0d",
                    "sense_definition": "The swollen abdomen of a pregnant woman.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protuberance_swelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She proudly showed off her baby <w>bump</w> in the photograph.",
                            "target_lang_translations": {
                                "ru": "Она с гордостью демонстрировала свой <w>животик</w> на фотографии.",
                                "tr": "Fotoğrafta hamilelik <w>karnını</w> gururla sergiledi.",
                                "zh": "她在照片中自豪地展示着自己的<w>孕肚</w>。"
                            }
                        },
                        {
                            "text": "Her <w>bump</w> is starting to show now that she is five months pregnant.",
                            "target_lang_translations": {
                                "ru": "Её <w>живот</w> начинает быть заметным, так как она на пятом месяце беременности.",
                                "tr": "Beş aylık hamile olduğu için artık <w>göbeği</w> belirginleşmeye başlıyor.",
                                "zh": "她怀孕五个月了，现在<w>孕肚</w>已经开始显现了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baby bump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличившийся живот беременной женщины.",
                        "tr": "Hamile bir kadının belirginleşmiş karnı.",
                        "zh": "孕妇隆起的腹部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живо́тик",
                                "target_lang_sense_clarification": "у беременной"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göbek",
                                "target_lang_sense_clarification": "hamilelik karnı"
                            },
                            {
                                "target_lang_word": "karın",
                                "target_lang_sense_clarification": "gebelikte büyüyen karın"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孕肚",
                                "target_lang_sense_clarification": "怀孕时隆起的肚子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b23e60-c140-3d05-a338-e9d9f662c027",
                    "sense_definition": "A sudden or temporary increase in amount, level, or popularity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "increase_shift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a significant <w>bump</w> in profits this quarter.",
                            "target_lang_translations": {
                                "ru": "Компания сообщила о значительном <w>росте</w> прибыли в этом квартале.",
                                "tr": "Şirket bu çeyrekte kârda önemli bir <w>artış</w> bildirdi.",
                                "zh": "公司报告称本季度利润有显著<w>增长</w>。"
                            }
                        },
                        {
                            "text": "He received a small pay <w>bump</w> after his promotion.",
                            "target_lang_translations": {
                                "ru": "Он получил небольшую <w>прибавку</w> к зарплате после повышения.",
                                "tr": "Terfisinden sonra maaşına küçük bir <w>zam</w> aldı.",
                                "zh": "他升职后工资有了小幅<w>提高</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bump in sales",
                        "pay bump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное или временное увеличение количества, уровня или популярности.",
                        "tr": "Miktar, seviye veya popülerlikte ani veya geçici bir artış.",
                        "zh": "数量、水平或受欢迎程度的突然或暂时性增长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачо́к",
                                "target_lang_sense_clarification": "резкое увеличение"
                            },
                            {
                                "target_lang_word": "повыше́ние",
                                "target_lang_sense_clarification": "рост уровня"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "artış",
                                "target_lang_sense_clarification": "seviye veya miktardaki yükselme"
                            },
                            {
                                "target_lang_word": "sıçrama",
                                "target_lang_sense_clarification": "ani yükseliş"
                            },
                            {
                                "target_lang_word": "zam",
                                "target_lang_sense_clarification": "maaş veya fiyattaki artış"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增长",
                                "target_lang_sense_clarification": "数值上的提升"
                            },
                            {
                                "target_lang_word": "涨幅",
                                "target_lang_sense_clarification": "增长的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cbdfbe3-61cb-375b-b130-58b7c0ab5499",
                    "sense_definition": "A minor difficulty or obstacle that delays progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hit a small <w>bump</w> in our plans, but we are back on track now.",
                            "target_lang_translations": {
                                "ru": "Мы столкнулись с небольшой <w>заминкой</w> в наших планах, но теперь снова в строю.",
                                "tr": "Planlarımızda küçük bir <w>pürüzle</w> karşılaştık ama şimdi tekrar yoluna girdik.",
                                "zh": "我们的计划遇到了一点<w>小波折</w>，但现在已经恢复正常了。"
                            }
                        },
                        {
                            "text": "It is just a little <w>bump</w> in the road to success.",
                            "target_lang_translations": {
                                "ru": "Это всего лишь небольшое <w>препятствие</w> на пути к успеху.",
                                "tr": "Bu sadece başarı yolundaki küçük bir <w>engel</w>.",
                                "zh": "这只是成功道路上的一个小<w>障碍</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bump in the road"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительная трудность или препятствие, задерживающее прогресс.",
                        "tr": "İlerlemeyi geciktiren küçük bir zorluk veya engel.",
                        "zh": "延误进展的小困难或障碍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зами́нка",
                                "target_lang_sense_clarification": "временная задержка"
                            },
                            {
                                "target_lang_word": "препя́тствие",
                                "target_lang_sense_clarification": "помеха"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "pürüz",
                                "target_lang_sense_clarification": "küçük engel veya aksaklık"
                            },
                            {
                                "target_lang_word": "aksaklık",
                                "target_lang_sense_clarification": "planlardaki küçük gecikme"
                            },
                            {
                                "target_lang_word": "engel",
                                "target_lang_sense_clarification": "geçici zorluk"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小波折",
                                "target_lang_sense_clarification": "进展中的小阻碍"
                            },
                            {
                                "target_lang_word": "障碍",
                                "target_lang_sense_clarification": "阻碍事物发展的因素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c56c93b-35b6-3d9e-827e-473fcf37ac43",
                    "sense_definition": "A post in an Internet forum thread made to move the thread to the top of the list.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "internet_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He added a quick <w>bump</w> to the thread to get more replies.",
                            "target_lang_translations": {
                                "ru": "Он добавил быстрый <w>бамп</w> в тему, чтобы получить больше ответов.",
                                "tr": "Daha fazla yanıt almak için konuyu <w>öne çıkaran</w> hızlı bir mesaj ekledi.",
                                "zh": "他给帖子发了一个快速的<w>顶帖</w>以获得更多回复。"
                            }
                        },
                        {
                            "text": "Please do not post a <w>bump</w> unless you have new information.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не пишите <w>бамп</w>, если у вас нет новой информации.",
                                "tr": "Yeni bir bilginiz yoksa lütfen konuyu <w>üste taşıyan</w> bir mesaj yazmayın.",
                                "zh": "除非有新信息，否则请不要<w>顶帖</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение на интернет-форуме, поднимающее тему в начало списка.",
                        "tr": "İnternet forumlarında bir konuyu listenin en üstüne taşımak için yazılan mesaj.",
                        "zh": "在网络论坛中为了将帖子顶到列表最上方而发布的回复。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бамп",
                                "target_lang_sense_clarification": "интернет-сленг"
                            },
                            {
                                "target_lang_word": "подня́тие те́мы",
                                "target_lang_sense_clarification": "действие на форуме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bump",
                                "target_lang_sense_clarification": "forumu üste taşıma mesajı"
                            },
                            {
                                "target_lang_word": "öne çıkarma",
                                "target_lang_sense_clarification": "konuyu yukarı taşıma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶帖",
                                "target_lang_sense_clarification": "使帖子排在前面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "041ceb05-f9c3-3242-a797-c1794669000f",
                    "sense_definition": "To hit or knock against something or someone, usually by accident.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "collision_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally <w>bumped</w> my knee on the sharp corner of the table.",
                            "target_lang_translations": {
                                "ru": "Я случайно <w>ударился</w> коленом об острый угол стола.",
                                "tr": "Kazara dizimi masanın keskin köşesine <w>çarptım</w>.",
                                "zh": "我不小心把膝盖<w>磕</w>在桌子的尖角上了。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>bump</w> into the other dancers on the floor.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не <w>столкнись</w> с другими танцорами на паркете.",
                                "tr": "Pistteki diğer dansçılara <w>çarpmamaya</w> dikkat edin.",
                                "zh": "小心别在舞池里<w>撞</w>到其他舞者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bump into",
                        "bump against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить или задеть что-то или кого-то, обычно случайно.",
                        "tr": "Genellikle kazara bir şeye veya birine çarpmak, toslamak.",
                        "zh": "通常指意外地撞到某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́риться",
                                "target_lang_sense_clarification": "обо что-то"
                            },
                            {
                                "target_lang_word": "натолкну́ться",
                                "target_lang_sense_clarification": "на кого-то/что-то"
                            },
                            {
                                "target_lang_word": "вре́заться",
                                "target_lang_sense_clarification": "сильно столкнуться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çarpmak",
                                "target_lang_sense_clarification": "kazara bir yere veya birine vurmak"
                            },
                            {
                                "target_lang_word": "toslamak",
                                "target_lang_sense_clarification": "kafa veya vücutla vurmak"
                            },
                            {
                                "target_lang_word": "çarpmak (birine)",
