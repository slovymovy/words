            {
                "entry_id": "3770a1fb-437a-3931-a21d-b3c0e0272b9e",
                "word": "inapplication",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a805422b-2158-4ed1-b93e-cf578049292e",
                        "entry_id": "3770a1fb-437a-3931-a21d-b3c0e0272b9e",
                        "tags": [
                            "plural"
                        ],
                        "form": "inapplications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4880bb8f-6bb7-3f55-8246-57f6d403ff78",
                        "entry_id": "3770a1fb-437a-3931-a21d-b3c0e0272b9e",
                        "glosses": [
                            "Manque d’application, inattention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554ea164-25cd-4971-8bed-9000daca77a5",
                                "sense_id": "4880bb8f-6bb7-3f55-8246-57f6d403ff78",
                                "text": "Il est d’une inapplication que rien ne peut corriger."
                            },
                            {
                                "example_id": "72e9405b-b45b-4a39-920e-6efe4941c308",
                                "sense_id": "4880bb8f-6bb7-3f55-8246-57f6d403ff78",
                                "text": "Son inapplication est cause qu’il ne fera jamais rien."
                            },
                            {
                                "example_id": "8bf40f83-cd32-426e-bb07-dd5a6ce7f4a2",
                                "sense_id": "4880bb8f-6bb7-3f55-8246-57f6d403ff78",
                                "text": "Ce n’était qu’une boutade. Le capitaine n’eût pas permis qu’on menât dix mauvais élèves au théâtre afin de punir leur inapplication."
                            },
                            {
                                "example_id": "efb6ef74-03ee-471f-a1a9-20fed7a809b2",
                                "sense_id": "4880bb8f-6bb7-3f55-8246-57f6d403ff78",
                                "text": "Ce n’était pas donc pas l’inexistence de lois qui créait le problème de la pénurie des subsistances, mais très précisément l’inapplication des lois."
                            }
                        ]
                    }
                ],
