                            },
                            {
                                "target_lang_word": "дорожные знаки",
                                "target_lang_sense_clarification": "совокупность знаков дорожного движения"
                            },
                            {
                                "target_lang_word": "вывески",
                                "target_lang_sense_clarification": "совокупность рекламных или информационных табличек"
