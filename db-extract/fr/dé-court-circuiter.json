                ],
                "senses": [
                    {
                        "sense_id": "66e1713d-a091-3a15-959e-be29bd4b31f3",
                        "entry_id": "9124e492-9ea3-3965-b4a0-dabd9ecb534a",
                        "glosses": [
                            "Annuler l’effet d’un court-circuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82609e57-f7c7-4135-9acd-79d48ce99cb8",
                                "sense_id": "66e1713d-a091-3a15-959e-be29bd4b31f3",
                                "text": "Les instituteurs, loin de jouer sur cette demande, la dé-court-circuitent en remettant au premier plan la base hiérarchique, se tenir bien dans la classe, alors qu’on est si exubérant par ailleurs."
                            },
                            {
                                "example_id": "e1ec3da2-e79d-4e51-9519-84af4a53378a",
                                "sense_id": "66e1713d-a091-3a15-959e-be29bd4b31f3",
                                "text": "Les entrées A, B et C devront être dé-court-circuitées pour être connectées sur les sorties des compteurs."
                            },
                            {
                                "example_id": "e34f3490-f99a-44a6-81aa-051a1596d1dc",
                                "sense_id": "66e1713d-a091-3a15-959e-be29bd4b31f3",
                                "text": "Je voulais dire, quand tu vas dé-court-circuiter les pins 2 et 3, il ne va pas y avoir un 'ploc' lors de la ré-alimentation?"
                            }
                        ]
                    }
                ],
