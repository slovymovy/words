                        "sense_id": "f6ce1559-aecc-33cb-b1c1-876bbc89dc3b",
                        "entry_id": "14f834b0-1637-3420-8637-8437f8ad0ebe",
                        "glosses": [
                            "Qui a la forme ou les propriétés du sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f12032ac-b527-4989-a957-51696abe7a25",
                                "sense_id": "f6ce1559-aecc-33cb-b1c1-876bbc89dc3b",
                                "text": "En descendant à Landrichamps par un ravin, on constate, entre deux masses de grès blanc taunusien, des couches assez épaisses de schistes compacts arénacés verdâtres."
                            },
                            {
                                "example_id": "88136e00-f24a-4ea1-aad0-8d982886fea8",
                                "sense_id": "f6ce1559-aecc-33cb-b1c1-876bbc89dc3b",
                                "text": "Les phosphates arénacés, ou sables phosphatés, se rencontrent dans des poches à la partie supérieure de la craie à bélemnites, sur la limite des départements de la Somme et du Pas-de-Calais."
                            }
                        ]
                    }
