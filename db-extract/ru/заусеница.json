                ],
                "senses": [
                    {
                        "sense_id": "c68b2332-0636-3d3b-a053-8c105e933ed5",
                        "entry_id": "6c83caf3-0c07-3129-bd72-7eb1dfe71176",
                        "glosses": [
                            "задравшаяся кожица у основания ногтя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3766e854-30aa-4a4a-a597-495735853e87",
                                "sense_id": "c68b2332-0636-3d3b-a053-8c105e933ed5",
                                "text": "Ничтожный прыщик на лице повергал её в уныние, так же как заусеницы или укус комара."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab2e1e2a-afd1-335e-bc81-7064e3df4f8f",
                        "entry_id": "6c83caf3-0c07-3129-bd72-7eb1dfe71176",
                        "glosses": [
                            "что-либо задравшееся, загнувшееся, представляющее собою острый выступ на поверхности чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7f8da6c-bfb6-4b47-8fe1-c60f0a899ed6",
                        "source_entry_id": "6c83caf3-0c07-3129-bd72-7eb1dfe71176",
                        "target_lang_word": "Niednagel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niednagel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f19a280-5075-3c63-b8d8-c05e251ad595",
                                        "entry_id": "b77a3eb7-d3a1-3d39-83f5-69e9d56ebcd9",
                                        "glosses": [
                                            "ein Stückchen von dem Nagel eines Fingers oder Zehs, welches sich vom Rest des Nagels abgespalten hat, unten aber weiterhin angewachsen ist, und Schmerzen verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556f78c1-82c9-4409-bd20-a7f4f2fc6870",
                                                "sense_id": "1f19a280-5075-3c63-b8d8-c05e251ad595",
                                                "text": "Ich habe mir einen Niednagel gerissen, hast du vielleicht ein Pflaster dabei? Ich will nicht, dass er noch weiter einreißt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "add8c75b-edbe-3053-b999-95fdc46f16b9",
                                        "entry_id": "b77a3eb7-d3a1-3d39-83f5-69e9d56ebcd9",
                                        "glosses": [
                                            "ein Stückchen aufgesprungene Haut am Nagelbett eines Fingers oder Zehs, welches oft weiter einreißt und dann Schmerzen verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2f8379-2390-40b5-99af-c937ea73cfd4",
                                                "sense_id": "add8c75b-edbe-3053-b999-95fdc46f16b9",
                                                "text": "Man kann Niednägeln vorbeugen, indem man die Haut geschmeidig hält."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
