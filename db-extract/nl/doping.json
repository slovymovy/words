                    },
                    {
                        "sense_id": "074a99ec-eeeb-3abf-bb0c-04287d439fc8",
                        "entry_id": "bee76a09-9f87-3741-a033-d1149360ab44",
                        "glosses": [
                            "het gebruiken van stimulerende middelen die de sportprestaties oneerlijk beïnvloeden en daarom verboden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c691da3d-cf02-41e2-b473-1f0d7a713cac",
                                "sense_id": "074a99ec-eeeb-3abf-bb0c-04287d439fc8",
                                "text": "Een aantal renners zijn betrapt op het gebruik van doping."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a468b06-4608-4772-8eb2-8dfca9b5888a",
                        "source_entry_id": "bee76a09-9f87-3741-a033-d1149360ab44",
                        "source_sense_id": "f59649ce-0ff1-32ae-a2c8-3838f172fa9b",
                        "source_sense_description": "stimulerende (genees)middelen",
