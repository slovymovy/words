                    {
                        "sense_id": "ea711af9-8d9c-38f0-8bee-b64af4946078",
                        "entry_id": "4772592b-4d35-3dc1-8e20-791dc91dd008",
                        "glosses": [
                            "Gebäude, das Aufenthaltsräume für Feuerwehrleute besitzt und in dem Feuerwehrfahrzeuge untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380a43e2-e0f0-47ac-95a0-aa11b4cd148e",
                                "sense_id": "ea711af9-8d9c-38f0-8bee-b64af4946078",
                                "text": "Die Feuerwache hat Aufenthaltsräume für die Feuerwehrleute und Garagen für ihre Fahrzeuge."
                            },
                            {
                                "example_id": "5404df40-52c7-4b31-a8ad-7bb697c604b8",
                                "sense_id": "ea711af9-8d9c-38f0-8bee-b64af4946078",
                                "text": "„Hinter der Feuerwache, an der wir gerade vorbeirannten, zweigte eine Straße nach links ab, eine Sackgasse, die an einem Metallzaun endete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
