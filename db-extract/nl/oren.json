                        "examples": [
                            {
                                "example_id": "38c07dd0-dbed-40b6-a44b-67baecbf8d59",
                                "sense_id": "13839a12-e984-3bac-b7b5-80b06a0bf29f",
                                "text": "Na een tijdje merkte ik duidelijk aan mijn oren dat we van zeeniveau naar duizend meter hoogte aan het klimmen waren."
                            },
                            {
                                "example_id": "b771e32d-f859-49e3-8c43-d68e7c79d52a",
                                "sense_id": "13839a12-e984-3bac-b7b5-80b06a0bf29f",
                                "text": "De pareltjes aan Thea's oren wiegelen als ze zich opgetogen weer naar het verhaal op de planken richt."
                            },
                            {
                                "example_id": "6c861f97-ddc3-4c9e-a787-cc7e355a5a9e",
                                "sense_id": "13839a12-e984-3bac-b7b5-80b06a0bf29f",
                                "text": "Maar daar komt Becker, met zijn glimmende domineesgezicht en zijn uitstaande oren, zijn blik strak op haar gericht."
                            }
                        ]
                    }
