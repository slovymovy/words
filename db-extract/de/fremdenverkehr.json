                                        "sense_id": "11ff8ec1-9ca7-328b-804e-46992f269f66",
                                        "entry_id": "09915574-7fd7-3d6b-9ba9-7439264d2965",
                                        "glosses": [
                                            "The act of travelling or sightseeing, particularly away from one's home."
                                        ],
