            "senses": [
                {
                    "sense_id": "8c79f97a-dd45-3b30-9f59-60190c1e68b5",
                    "sense_definition": "Feeling nervous, worried, or uneasy about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could tell she was <w>anxious</w> as she was biting her nails.",
                            "target_lang_translations": {
                                "ru": "Я видел, что она <w>нервничала</w>, так как она грызла ногти.",
                                "nl": "Ik kon zien dat ze <w>bezorgd</w> was, want ze beet op haar nagels.",
                                "pl": "Widziałem, że jest <w>zaniepokojona</w>, bo obgryzała paznokcie.",
                                "de": "Ich konnte sehen, dass sie <w>nervös</w> war, da sie an ihren Fingernägeln kaute."
                            }
                        },
                        {
                            "text": "Many students feel <w>anxious</w> about exams and their future careers.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>беспокоятся</w> из-за экзаменов и своей будущей карьеры.",
                                "nl": "Veel studenten voelen zich <w>nerveus</w> over examens en hun toekomstige carrière.",
                                "pl": "Wielu studentów <w>denerwuje się</w> egzaminami i swoją przyszłą karierą.",
                                "de": "Viele Studenten sind <w>besorgt</w> wegen Prüfungen und ihrer zukünftigen Karriere."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneasy",
                        "worrisome",
                        "unquiet",
                        "concerned",
                        "fraught"
                    ],
                    "antonyms": [
                        "calm",
                        "relaxed",
                        "confident"
                    ],
                    "common_phrases": [
                        "feel anxious",
                        "anxious about"
                    ],
                    "target_lang_definitions": {
