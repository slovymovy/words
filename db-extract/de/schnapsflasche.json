                "senses": [
                    {
                        "sense_id": "dbcf0ba1-2588-387c-a236-db8db0907b4d",
                        "entry_id": "5c062464-5c5b-3170-ae52-4e90adb32667",
                        "glosses": [
                            "Flasche, in der Schnaps aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289dcd8c-d448-4182-a768-92634fe48ea8",
                                "sense_id": "dbcf0ba1-2588-387c-a236-db8db0907b4d",
                                "text": "In einem Spirituosengeschäft kann man viele Schnapsflaschen sehen."
                            },
                            {
                                "example_id": "015d95e5-b4ac-4bf7-916a-85b10540f3e8",
                                "sense_id": "dbcf0ba1-2588-387c-a236-db8db0907b4d",
                                "text": "„Er stolpert, die Schnapsflasche in seiner Hand zerbricht, sein Mund füllt sich mit Sand.“"
                            },
                            {
                                "example_id": "25e6f9e6-3acd-4d92-a38a-e66ea1b95f98",
                                "sense_id": "dbcf0ba1-2588-387c-a236-db8db0907b4d",
                                "text": "„Horst Kumpel rutschte behende hin und her, machte Feuer im Kanonenofen, kochte ein Süppchen für uns beide, zauberte eine Schnapsflasche hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
