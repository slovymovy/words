            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff4db0b4-e7e7-3373-80ce-5d22ca75bcf9",
                    "sense_definition": "One who arrives or attends; a visitor or participant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community center is open to all <w>comers</w> who wish to participate in the activities.",
                            "target_lang_translations": {
                                "ru": "Местный общественный центр открыт для всех <w>желающих</w>, кто хочет принять участие в мероприятиях."
                            }
                        },
                        {
                            "text": "The champion was confident and ready to take on all <w>comers</w> in the tournament.",
                            "target_lang_translations": {
                                "ru": "Чемпион был уверен в себе и готов сразиться со всеми <w>претендентами</w> на турнире."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrival",
                        "attendee",
                        "visitor"
                    ],
                    "common_phrases": [
                        "take on all comers",
                        "open to all comers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто приходит, прибывает или участвует в чём-либо; посетитель или участник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибывший",
                                "target_lang_sense_clarification": "тот, кто приехал или пришел"
                            },
                            {
                                "target_lang_word": "пришедший",
                                "target_lang_sense_clarification": "тот, кто явился или пришел"
                            },
                            {
                                "target_lang_word": "желающий",
                                "target_lang_sense_clarification": "в контексте «все желающие»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "263289a1-20cc-39a4-b558-7134ad31faf0",
                    "sense_definition": "A person who is making rapid progress or showing great promise of success in a field or contest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "promising_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young tech entrepreneur was widely regarded as a promising <w>comer</w> in the industry.",
                            "target_lang_translations": {
                                "ru": "Молодого технологического предпринимателя многие считали многообещающим, <w>подающим надежды</w> новичком в этой индустрии."
                            }
                        },
                        {
                            "text": "The transition from a rising <w>comer</w> to an also-ran can be incredibly quick in professional sports.",
                            "target_lang_translations": {
                                "ru": "В профессиональном спорте переход от восходящей <w>звезды</w> к аутсайдеру может произойти невероятно быстро."
                            }
                        }
                    ],
                    "synonyms": [
                        "up-and-comer",
                        "rising star"
                    ],
                    "antonyms": [
                        "also-ran"
                    ],
                    "common_phrases": [
                        "promising comer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который быстро прогрессирует или подает большие надежды на успех в какой-либо области или соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подающий надежды",
                                "target_lang_sense_clarification": "перспективный человек"
                            },
                            {
                                "target_lang_word": "восходящая звезда",
                                "target_lang_sense_clarification": "быстро развивающийся и успешный человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
