                "senses": [
                    {
                        "sense_id": "bfccbbc2-14d8-34b3-8dea-1aa54fe69920",
                        "entry_id": "d5c3df6e-ffc9-345b-b969-c471a65d6deb",
                        "glosses": [
                            "Pâte alimentaire préparée soit avec de la farine de blé, des pommes de terre pochées à l’eau, soit une préparation à base de semoule de blé dur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881ed72d-d557-4330-bc05-bb22b582cc02",
                                "sense_id": "bfccbbc2-14d8-34b3-8dea-1aa54fe69920",
                                "text": "Dans les cuisines, Martha, sa vieille nourrice, roulait des gnocchis sur une grande table recouverte de lave émaillée."
                            },
                            {
                                "example_id": "6a1082eb-b3db-47b1-913b-de607fe97400",
                                "sense_id": "bfccbbc2-14d8-34b3-8dea-1aa54fe69920",
                                "text": "Avec une fourchette appuyez sur chaque bout de pâte et décollez le gnocchi en le faisant rouler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3141bac6-6af3-48cf-bf80-efc7d51bee60",
                        "source_entry_id": "d5c3df6e-ffc9-345b-b969-c471a65d6deb",
                        "source_sense_id": "bfccbbc2-14d8-34b3-8dea-1aa54fe69920",
                        "target_lang_word": "Gnocchi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
