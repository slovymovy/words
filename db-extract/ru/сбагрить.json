                    }
                ],
                "senses": [
                    {
                        "sense_id": "49a970c2-5af6-38aa-afe7-249465cdb0f9",
                        "entry_id": "3774d1f0-6370-36a5-9b3b-fa636a5dde6b",
                        "glosses": [
                            "разг. избавиться, отделаться от чего-либо, отдав или продав кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae6a103-27c0-4a1c-aaff-279c38f0f20f",
                                "sense_id": "49a970c2-5af6-38aa-afe7-249465cdb0f9",
                                "text": "И хозяева просто счастливы, если им удаётся сбагрить эти лежалые запасы третьего сорта по десять-пятнадцать долларов за тонну, а то и за пятёрку."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0288061-7c16-399e-95b5-9447fa75afa9",
                        "entry_id": "3774d1f0-6370-36a5-9b3b-fa636a5dde6b",
                        "glosses": [
                            "разг. устар. стянуть, стащить, стибрить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225c05fa-8901-441d-94e5-e3d2def542be",
                                "sense_id": "e0288061-7c16-399e-95b5-9447fa75afa9",
                                "text": "Пока мамы не было дома, Лёша успел сбагрить пряник."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bad4fc9-cd01-47a7-8caa-e264928d9025",
                        "source_entry_id": "3774d1f0-6370-36a5-9b3b-fa636a5dde6b",
                        "source_sense_description": "избавиться, отделаться от чего-либо, отдав или продав кому-либо",
                        "target_lang_word": "get rid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "da021a20-15f0-4f6b-860c-db6e3f3a2781",
                        "source_entry_id": "3774d1f0-6370-36a5-9b3b-fa636a5dde6b",
                        "source_sense_description": "избавиться, отделаться от чего-либо, отдав или продав кому-либо",
                        "target_lang_word": "shake off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shake off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d15d726d-4641-3e8e-9718-7e7f48443101",
                                        "entry_id": "4708a14f-7fb3-3745-a563-51d2b1e0b3a6",
                                        "glosses": [
                                            "To remove (something attached to, on or clinging to an object) by shaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2e2b961-9a7b-40c2-852d-301d77db61d4",
                                                "sense_id": "d15d726d-4641-3e8e-9718-7e7f48443101",
                                                "text": "The archaeologists shook off the dust that had fallen from the roof, and promptly continued their work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e69d2da7-df41-3b3f-b669-eeb4ab9ef489",
                                        "entry_id": "4708a14f-7fb3-3745-a563-51d2b1e0b3a6",
                                        "glosses": [
                                            "To dissociate oneself from (an allegation or rumour)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf0ee40-9d32-4e32-813e-7789906b2653",
                                                "sense_id": "e69d2da7-df41-3b3f-b669-eeb4ab9ef489",
                                                "text": "Dozens of foreigners have been jailed for child sex crimes or deported to face trial in their home countries since Cambodia launched an anti-pedophilia push in 2003, to try to shake off its reputation as a haven for sex predators."
                                            },
                                            {
                                                "example_id": "d345e99a-d613-41b5-b9f1-f3c7f2ba260d",
                                                "sense_id": "e69d2da7-df41-3b3f-b669-eeb4ab9ef489",
                                                "text": "The 21st century's spectacular reimagined transport hub \"set out to shake off the old image of stations. I think it's successfully done that, and it's great that others are following suit,\" Spinks continues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35952af-09ca-3495-87d1-0f83e15c24bf",
                                        "entry_id": "4708a14f-7fb3-3745-a563-51d2b1e0b3a6",
                                        "glosses": [
                                            "To lose someone who is tracking you."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f423b3db-3c1a-4468-9561-a7915ee3ac6c",
                                                "sense_id": "d35952af-09ca-3495-87d1-0f83e15c24bf",
                                                "text": "The police are chasing us! Quick, turn into that side street! We've got to shake them off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f960b49-3be9-344a-bb83-876c8a3aeb18",
                                        "entry_id": "4708a14f-7fb3-3745-a563-51d2b1e0b3a6",
                                        "glosses": [
                                            "To rid oneself of a malady or its symptoms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd769826-c2e1-404d-a966-b743f7267d7f",
                                                "sense_id": "4f960b49-3be9-344a-bb83-876c8a3aeb18",
                                                "text": "I just can't shake off this cold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
