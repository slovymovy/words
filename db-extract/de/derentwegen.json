                "entry_id": "1699208b-f2b9-317e-b1ab-0c83fa93f578",
                "word": "derentwegen",
                "pos": "adv",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "76d4d0c1-10d8-4030-9030-a41ee1ca2ab5",
                        "entry_id": "1699208b-f2b9-317e-b1ab-0c83fa93f578",
                        "tags": [
                            "variant"
                        ],
                        "form": "deretwegen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f72d432-b32b-35ca-83e0-80649ed6f7a8",
                        "entry_id": "1699208b-f2b9-317e-b1ab-0c83fa93f578",
                        "glosses": [
                            "wegen der oder wegen denen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "301a42b8-a300-4ec2-bc35-48b0c3f10610",
                                "sense_id": "7f72d432-b32b-35ca-83e0-80649ed6f7a8",
                                "text": "„»Das ist die Frau, derentwegen ich hier bin!«“"
                            },
                            {
                                "example_id": "47baadd6-e3e8-4fd9-acb3-8c6299c9170f",
                                "sense_id": "7f72d432-b32b-35ca-83e0-80649ed6f7a8",
                                "text": "„Nicht verwunderlich aber, dass schon bald nach dem Mauerfall der verlorene Sohn wieder in sein Heimatdörfchen zurückfand und solche Zeichen im Ort setzte, derentwegen sich an den Wochenenden immer mehr Menschen auf Pilgerfahrt ins schöne Eichsfeld begeben.“"
                            },
                            {
                                "example_id": "0d369296-fec5-4376-bde9-69a317fe5882",
                                "sense_id": "7f72d432-b32b-35ca-83e0-80649ed6f7a8",
                                "text": "Jede Vertragspartei, die von dem in Absatz 3 vorgesehenen Recht Gebrauch machen will, notifiziert dem Generalsekretär des Europarats bei der Hinterlegung ihrer Ratifikations- oder Beitrittsurkunde entweder eine Liste der strafbaren Handlungen, derentwegen die Auslieferung zulässig ist, oder eine Liste der strafbaren Handlungen, derentwegen die Auslieferung ausgeschlossen ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9b608fc7-50ff-3d00-87f6-c9d5bfca6f44",
                        "entry_id": "1699208b-f2b9-317e-b1ab-0c83fa93f578",
                        "glosses": [
                            "wegen der oder wegen denen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "649dd6fb-1564-44d4-83f6-0b6bd6d6ca09",
                                "sense_id": "9b608fc7-50ff-3d00-87f6-c9d5bfca6f44",
                                "text": "Schade, dass die Kirche komplett eingerüstet war. Nur derentwegen haben wir den Abstecher gemacht."
                            },
                            {
                                "example_id": "edb9bd21-68c3-4291-ba32-26166cfc7a47",
                                "sense_id": "9b608fc7-50ff-3d00-87f6-c9d5bfca6f44",
                                "text": "Es standen viele Schaulustige herum. Derentwegen musste die Polizei Verstärkung holen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
