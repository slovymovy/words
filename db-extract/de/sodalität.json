                ],
                "senses": [
                    {
                        "sense_id": "857dc3bb-0e96-39ff-a518-1226a4622209",
                        "entry_id": "a753fef4-53ef-3c3a-aa46-45db53e606c5",
                        "glosses": [
                            "Zusammenschluss einer Gruppe Geistlicher/Klöster/Gleichgesinnter"
                        ],
                        "tags": [
                            "Katholizismus",
                            "auch allgemein"
                        ],
                        "examples": [
                            {
                                "example_id": "ec00e74c-1759-429f-baa1-ca5300fb5f0d",
                                "sense_id": "857dc3bb-0e96-39ff-a518-1226a4622209",
                                "text": "„Es wurde gesagt, der Adel solle alle Stände zu einer Sodalität des h. Johann von Jerusalem vereinigen.“ (1864)"
                            },
                            {
                                "example_id": "e63b176e-63c3-4707-98fe-32fabc3a3ed7",
                                "sense_id": "857dc3bb-0e96-39ff-a518-1226a4622209",
                                "text": "„Die Mitglieder der Sodalität waren zum großen Teil junge Stahlarbeiter und Bergleute, die sich nicht nur am kirchlichen Leben beteiligten, sondern sich auch sportlich betätigten, zunächst beim Turnen und in der Leichtathletik. Aber spätestens seit 1906 wurde auf den Feldern und Wiesen rund um den Borsigplatz auch regelmäßig Fußball gespielt.“"
                            },
                            {
                                "example_id": "6ab2034d-3ecb-44f5-9d58-4124a349754f",
                                "sense_id": "857dc3bb-0e96-39ff-a518-1226a4622209",
                                "text": "„Alle Mitglieder der Sodalitäten, die zur Durchführung des Kultes der divi in Rom eingerichtet wurden, waren selbstverständlich Senatoren.“"
                            },
                            {
                                "example_id": "af8f7a4e-6130-4877-a4ac-4a27ddb495c5",
                                "sense_id": "857dc3bb-0e96-39ff-a518-1226a4622209",
                                "text": "„Ein sich außerhalb von Kirche und Universität konstituierender Gelehrtenstand gab sich in den sog. Sodalitäten eine neue, von zünftischen, monastischen und korporativen Bindungen unabhängige, freie Kommunikationsform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
