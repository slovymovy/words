                ],
                "senses": [
                    {
                        "sense_id": "86947c85-b5be-37f2-bcc8-c2a42a17b60e",
                        "entry_id": "81c5d0c6-1442-35b1-9129-990480dd6844",
                        "glosses": [
                            "Spécialiste de l’Histoire, comme science historique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d918512a-07f0-426d-a30c-f62bdd71947a",
                                "sense_id": "86947c85-b5be-37f2-bcc8-c2a42a17b60e",
                                "text": "« Au XVIIIᵉ siècle, des festivités avaient déjà lieu sur la Seine, avec toutes les populations invitées », approuve l’historienne Isabelle Backouche."
                            },
                            {
                                "example_id": "920832bb-71c6-4f26-9c3e-015ae976c103",
                                "sense_id": "86947c85-b5be-37f2-bcc8-c2a42a17b60e",
                                "text": "Pour réussir cette prouesse « exceptionnelle », six mois de travail ont été nécessaires à des cryptographes, associés à une historienne de l’université de Picardie, Camille Desenclos."
                            },
                            {
                                "example_id": "a078e7c5-1aea-4812-9c29-489ab58ee10d",
                                "sense_id": "86947c85-b5be-37f2-bcc8-c2a42a17b60e",
                                "text": "Et « Damas n’a aucune considération humanitaire pour l’opposition », martèle Marie Peltier, historienne spécialiste de la propagande en Syrie."
                            }
                        ]
                    },
                    {
                        "sense_id": "562366f8-1b2e-379b-8d2f-1988609af6af",
                        "entry_id": "81c5d0c6-1442-35b1-9129-990480dd6844",
                        "glosses": [
                            "Chroniqueuse qui écrit ou qui a écrit une histoire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b2ea43ff-71c0-3e47-a818-f73335e2b477",
                        "entry_id": "81c5d0c6-1442-35b1-9129-990480dd6844",
                        "glosses": [
                            "Celle qui se borne à raconter des faits sans les accompagner d’engagement ou de réflexions."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cc6d18f-6de4-4428-abd5-37767475f6bf",
                        "source_entry_id": "81c5d0c6-1442-35b1-9129-990480dd6844",
                        "target_lang_word": "Historikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Historikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                        "entry_id": "16aeedd9-aa19-34b9-8f19-b0007dcb6de3",
                                        "glosses": [
                                            "Wissenschaftlerin, die sich mit der Erforschung und Darstellung der Geschichte beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3702486-ad27-4c72-a2e0-dd7077a84ab9",
                                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                                "text": "Zur Beurteilung des Wertes der Fundgegenstände wurde eine Historikerin hinzugezogen."
                                            },
                                            {
                                                "example_id": "9933b7f8-b211-4849-9603-c9ee046553e8",
                                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                                "text": "„Mehr als 200 Porträts solcher »Hofmohren« hat ein Forscherteam um die Bremer Historikerin Rebekka von Mallinckrodt für ein Projekt zu Sklaven im Heiligen Römischen Reich in Archiven entdeckt.“"
                                            },
                                            {
                                                "example_id": "7e09fab9-3d85-4e04-bde3-d1e208e2643e",
                                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                                "text": "„Die pakistanische Historikerin Ayesha Jalal verwies zutreffend darauf, dass Pakistan zwar für eine Minderheit (die Muslime Südasiens) Britisch-Indiens geschaffen wurde, seinen eigenen religiösen Minderheiten jedoch keinen Schutz vor Verfolgung gewährt.“"
                                            },
                                            {
                                                "example_id": "db5cb8cf-fd69-48e7-8f45-425fc38adaab",
                                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                                "text": "„Im Januar 1932 wählte die Abteilung Heinrich Mann, den Großschriftsteller der bürgerlichen Linken, zum Vorsitzenden und die geschätzte Dichterin, Historikerin und Philosophin Ricarda Huch zu seiner Stellvertreterin, obgleich sie mit ihm inhaltlich und persönlich wenig gemein hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "440fa51a-dba9-4710-a608-e8a884820ef3",
