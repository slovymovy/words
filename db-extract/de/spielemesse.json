                "senses": [
                    {
                        "sense_id": "48e5d0c4-d55b-3c08-8f66-d97bd00484b3",
                        "entry_id": "480fc5f0-0f5d-3a2a-998c-2cabef93e293",
                        "glosses": [
                            "Präsentations- und Handelsforum für Neuerscheinungen auf dem Spielwarenmarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614ba714-fc65-4081-b434-257557b55932",
                                "sense_id": "48e5d0c4-d55b-3c08-8f66-d97bd00484b3",
                                "text": "„Besucher der Kölner Spielemesse Gamescom konnten bereits testen, wie sich die Tanz-, Sport und Abenteuerspiele im Ganzkörpereinsatz anfühlen.“"
                            },
                            {
                                "example_id": "e017034d-922c-4cad-b03a-5f12c7f8c59f",
                                "sense_id": "48e5d0c4-d55b-3c08-8f66-d97bd00484b3",
                                "text": "„Bereits vor drei Jahren warnte das Sicherheitsunternehmen Eset in einem Bericht zur Spielemesse Gamescom vor möglichen Angriffsszenarien.“"
                            },
                            {
                                "example_id": "b01b033e-9907-4156-ae51-7615a369bfbd",
                                "sense_id": "48e5d0c4-d55b-3c08-8f66-d97bd00484b3",
                                "text": "„Auf der Spielemesse präsentieren mehr als 700 Aussteller auf 193000 Quadratmetern ihre Neuigkeiten für Konsole, PC und mobile Plattformen.“"
                            },
                            {
                                "example_id": "f3ef75c2-2fde-470f-9e47-852143d10f21",
                                "sense_id": "48e5d0c4-d55b-3c08-8f66-d97bd00484b3",
                                "text": "„Die große Spielemesse erwartet in diesem Jahr mehr als 600 Aussteller aus über 40 Ländern.“"
                            },
                            {
                                "example_id": "869ba58e-f785-431f-b26e-c98d6d223cd3",
                                "sense_id": "48e5d0c4-d55b-3c08-8f66-d97bd00484b3",
                                "text": "„Microsoft hat zum Auftakt der Spielemesse E3 in Los Angeles ein aufgerüstetes Modell seiner Spielekonsole Xbox One vorgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
