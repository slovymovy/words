                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e602c4c7-14bc-4c0d-930b-ebb7d80e7c4a",
                                "sense_id": "d7b48e14-2be3-312b-8b9e-2a163db30915",
                                "text": "8,3 procent van cyberaanvallen wordt verstuurd vanuit Nederland"
                            },
                            {
                                "example_id": "b6aae54b-a6b3-42fa-a866-69add05145ba",
                                "sense_id": "d7b48e14-2be3-312b-8b9e-2a163db30915",
                                "text": "Hackersgroep Anonymous heeft vrijdag nieuwe cyberaanvallen op de Russische regering uitgevoerd. Daarbij werden gegevens van het Russische ministerie van defensie online gezet."
                            },
                            {
                                "example_id": "e7da208e-0931-48c0-be87-1f9ec99c27a7",
                                "sense_id": "d7b48e14-2be3-312b-8b9e-2a163db30915",
                                "text": "Twee grote telescopen in Chili en Hawaï zijn al ruim een maand uitgeschakeld door een cyberaanval. Enkele kleinere telescopen in Chili zijn uit voorzorg offline gehaald. Astronomen lopen hierdoor waardevolle observatietijd mis."
                            }
                        ]
