                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musicien a commencé à <w>improviser</w> sur son piano devant un public attentif."
                        },
                        {
                            "text": "Ayant égaré ses notes avant d'entrer sur scène, l'orateur a préféré <w>improviser</w> son discours."
