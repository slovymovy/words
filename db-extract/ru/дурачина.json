                "senses": [
                    {
                        "sense_id": "bf5d3b83-f22a-32fa-8afd-909e5844eb55",
                        "entry_id": "d321cb0c-b5d2-3761-92d4-96d1f45f3b41",
                        "glosses": [
                            "прост., пренебр. глупый человек, дурак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ca643d-7e5d-4372-94e1-b9b09345f892",
                                "sense_id": "bf5d3b83-f22a-32fa-8afd-909e5844eb55",
                                "text": "Через Волгу переезжал в рыбачьей лодке, да у острова дурачина рыбак сослепа в тину попал: надо было выскочить и стащить лодку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3144966c-5b90-452c-966d-d56ae1cb3857",
                        "source_entry_id": "d321cb0c-b5d2-3761-92d4-96d1f45f3b41",
                        "source_sense_id": "bf5d3b83-f22a-32fa-8afd-909e5844eb55",
                        "target_lang_word": "głupek",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "głupek",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "94b7a4aa-0e20-32cb-aecb-6b915d60b653",
                                        "entry_id": "d65f06b5-0dc4-3c3c-b5b3-4219f29dd1bc",
                                        "glosses": [
                                            "ktoś głupi"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54149c43-7135-427e-824c-d23d47d46688",
                                                "sense_id": "94b7a4aa-0e20-32cb-aecb-6b915d60b653",
                                                "text": "Tylko głupek nie rozumie takich prostych rzeczy."
                                            },
                                            {
                                                "example_id": "f2e8aa30-7ff1-43f7-8218-993c5f9cb881",
                                                "sense_id": "94b7a4aa-0e20-32cb-aecb-6b915d60b653",
                                                "text": "Trzeba być głupkiem, żeby uwierzyć temu oszustowi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7f117910-953d-3ec1-beab-5016ede6b5ec",
                                        "entry_id": "d65f06b5-0dc4-3c3c-b5b3-4219f29dd1bc",
                                        "glosses": [
                                            "osoba niepoważna"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b543781-6ffb-428c-957b-fd0fd5b4332c",
                                                "sense_id": "7f117910-953d-3ec1-beab-5016ede6b5ec",
                                                "text": "Dzieci śmiały się, gdy klasowy głupek wyszedł na środek sali i zaczął głośno bekać."
                                            },
                                            {
                                                "example_id": "59c53392-c053-4f2a-beef-6238536907ae",
                                                "sense_id": "7f117910-953d-3ec1-beab-5016ede6b5ec",
                                                "text": "Wszyscy przejmowali się chorobą Anny i nie mogli już znieść głupka, który wciąż opowiadał żarty o schizofrenikach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c36ef7b-1650-4b9c-995c-63479b6d7ff6",
