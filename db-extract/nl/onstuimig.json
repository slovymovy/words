                                "target_senses": [
                                    {
                                        "sense_id": "7601cd17-36fb-3c18-a0a2-7e38646a8b89",
                                        "entry_id": "c632b375-f835-38ef-bea9-15ca489819b5",
                                        "glosses": [
                                            "Dont la course est violente et rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7063492c-2226-444f-b387-e7f2309fd1c8",
                                                "sense_id": "7601cd17-36fb-3c18-a0a2-7e38646a8b89",
                                                "text": "Des courses impétueuses lançaient les officiers zélés à la poursuite des soldats qui s’égaraient dans les fermes voisines, trouvant drôle « de cueillir çà et là » des lapins et des poules."
                                            },
                                            {
                                                "example_id": "4c282c69-3f9e-419a-bbc9-8e6647227afe",
                                                "sense_id": "7601cd17-36fb-3c18-a0a2-7e38646a8b89",
                                                "text": "Un vent impétueux sorti du couchant, roule les nuages sur les nuages ; les forêts plient ; le ciel s’ouvre coup sur coup, et à travers ses crevasses, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b84e754-46fd-312b-ae86-6d34bc23bdf0",
                                        "entry_id": "c632b375-f835-38ef-bea9-15ca489819b5",
                                        "glosses": [
                                            "Qui ne sait pas se refréner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc8b919-339c-49fa-8adc-05941331d086",
                                                "sense_id": "4b84e754-46fd-312b-ae86-6d34bc23bdf0",
                                                "text": "Les charmes quelque peu fanés de la descendante des Pignon-Mouillet n’étaient plus tels qu’ils attirassent encore irrésistiblement le mâle impétueux qu’était resté le vieux militaire."
                                            },
                                            {
                                                "example_id": "c377e7ec-f206-41c6-a014-fe7930090f94",
                                                "sense_id": "4b84e754-46fd-312b-ae86-6d34bc23bdf0",
                                                "text": "Il était visible, à la contenance du maître, qu’il était d’un caractère franc mais impétueux et irascible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
