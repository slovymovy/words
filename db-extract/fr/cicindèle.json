                                        "glosses": [
                                            "Any active, carnivorous beetle (species) of the subfamily Cicindelinae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a899a33-c08d-4006-88de-14c2976e446e",
                                                "sense_id": "f3e58e9c-cb50-36e7-a5d3-6a01c3360c14",
                                                "text": "Most tiger beetle larvae tunnel in the soil."
                                            },
                                            {
                                                "example_id": "c002798b-e2fd-4b00-a3f9-2e3314cbb071",
                                                "sense_id": "f3e58e9c-cb50-36e7-a5d3-6a01c3360c14",
                                                "text": "I also noticed a couple of tiger beetle larval burrows in the hard-packed sandy soil and found a long, thin plant stem to “fish” the larvae out."
                                            }
