                        "glosses": [
                            "Commune au centre de la capitale chilienne de Santiago du Chili."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "81c717d5-fa20-45fc-8402-5b2ca2c27f88",
                                "sense_id": "109f0b9b-3eac-306c-8a0d-c8887167eac5",
                                "text": "En 1540, une troupe d’Espagnols conduite par Pedro de Valdivia quitte Cuzco, atteint le centre du Chili et y fonde Santiago, mais les Mapuches – que les Espagnols nomment « Araucans » – les harcèlent : Valdivia meurt au combat en 1553."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b42092-a6e2-3202-aa6a-a051a8a97433",
                        "entry_id": "3b0b4f03-ac4c-3def-9ed1-f69d18b570a4",
                        "glosses": [
                            "Île du Cap-Vert."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ffd0f6-de75-4b73-a1ab-d2e3a5ab8a4e",
                                "sense_id": "89b42092-a6e2-3202-aa6a-a051a8a97433",
                                "text": "Les montagnes volcaniques de l’île de Santiago cernaient la capitale du Cap-Vert, où régnait une chaleur humide et étouffante."
                            }
                        ]
                    }
