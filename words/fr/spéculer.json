                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux investisseurs choisissent de <w>spéculer</w> en bourse pour réaliser des gains rapides."
                        },
                        {
                            "text": "L'entreprise a perdu beaucoup d'argent en voulant <w>spéculer</w> sur les devises étrangères."
                        }
                    ],
                    "synonyms": [
                        "agioter"
                    ],
                    "antonyms": [
                        "investir"
                    ],
                    "common_phrases": [
                        "spéculer en bourse",
                        "spéculer sur l'immobilier",
                        "spéculer sur les devises"
                    ]
                },
                {
                    "sense_id": "0e39d4b0-60b4-3672-af88-372e84f50998",
                    "sense_definition": "Faire des suppositions ou des conjectures sur un sujet sans disposer de preuves certaines.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est inutile de <w>spéculer</w> sur l'avenir tant que nous n'avons pas les résultats définitifs."
                        },
                        {
                            "text": "Les journalistes continuent de <w>spéculer</w> sur les raisons de cette démission soudaine."
                        }
                    ],
                    "synonyms": [
                        "conjecturer",
                        "supposer",
                        "théoriser"
                    ],
                    "common_phrases": [
