                        "glosses": [
                            "Relatif à l’alexie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fade6b7-2e92-4ae8-b346-df39d472baa2",
                                "sense_id": "6324b0df-045d-3383-af92-fc4319a2deea",
                                "text": "Un patient alexique pourrait donc être capable d’écrire mais sans être capable de lire ce qu’il a écrit."
                            },
                            {
                                "example_id": "ae514d5e-786b-4bb0-8c02-659f61ef3159",
                                "sense_id": "6324b0df-045d-3383-af92-fc4319a2deea",
                                "text": "Un malade neurologique dont cette région est détruite devient d’ailleurs alexique, c’est-à-dire qu’il a perdu la capacité de lire normalement le moindre des mots de sa langue. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 300)"
                            }
                        ]
                    }
