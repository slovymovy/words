                        ],
                        "form": "хороше́вши"
                    },
                    {
                        "form_id": "67cab155-39a5-43ab-9be7-ec3fb10c63d3",
                        "entry_id": "b5f88a43-0c2a-31e7-ba63-1ad2524db8d0",
