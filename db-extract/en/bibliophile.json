                "senses": [
                    {
                        "sense_id": "e38cb6e6-be5e-315a-b3a4-b96587435f9e",
                        "entry_id": "cea777fa-e297-3bce-a877-88a90d7e8689",
                        "glosses": [
                            "One who loves books."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23c9ff1-c974-4931-a2d7-efb259fa3b1a",
                                "sense_id": "e38cb6e6-be5e-315a-b3a4-b96587435f9e",
                                "text": "A bad example often finds imitators, and every season there crop up for public sale one or two such collections formed by bibliomaniacs who, although calling themselves bibliophiles, ought really to be ranked among the worst enemies of books."
                            },
                            {
                                "example_id": "cfdb168d-1011-4ea5-871d-0c2406528363",
                                "sense_id": "e38cb6e6-be5e-315a-b3a4-b96587435f9e",
                                "text": "[A] savage passage of 14th-century invective about the text-obsessed nerdiness of the Florentine bibliophile and friend of Petrarch, Niccolò Niccoli ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "b228a0ab-c254-306a-8d68-144409dffa4f",
                        "entry_id": "cea777fa-e297-3bce-a877-88a90d7e8689",
                        "glosses": [
                            "One who collects books, not necessarily due to any interest in reading them."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
