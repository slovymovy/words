                                                "text": "Глубокая старуха."
                                            },
                                            {
                                                "example_id": "45a9d4de-553b-46fb-8c79-4b75374e4df8",
                                                "sense_id": "33776e86-fe4c-3cff-b174-58e7f183efd8",
                                                "text": "Жил старик со своею старухой у самого синего моря."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dd55660-4cab-3e03-a446-3be2510f302f",
                                        "entry_id": "ce2cd31d-9556-3e95-a427-701a8b60c147",
                                        "glosses": [
                                            "фам., ирон. жена или близкая женщина, девушка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01dbe1bb-7e2a-41e0-bdc5-e5f5a7dc6e91",
                                                "sense_id": "3dd55660-4cab-3e03-a446-3be2510f302f",
                                                "text": "Эй, старуха, куда направляешься?"
                                            },
                                            {
                                                "example_id": "82b5fd44-aafe-43b5-ad22-266102d5459f",
                                                "sense_id": "3dd55660-4cab-3e03-a446-3be2510f302f",
                                                "text": "Моя старуха на кухне копошится."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
