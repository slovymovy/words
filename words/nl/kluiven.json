{
    "word_family": [
        "kluif",
        "afkluiven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9b63b5d-2ee4-3aea-9c6c-50e2925b4a99",
                    "sense_definition": "Het afknabbelen of afhappen van vleesresten die nog aan een bot zitten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen het eten op tafel stond, begon hij meteen aan het bot te <w>kluiven</w>.",
                            "target_lang_translations": {
                                "en": "When the food was on the table, he immediately started to <w>gnaw</w> on the bone."
                            }
                        },
                        {
                            "text": "De hond lag rustig in de hoek van de kamer op een groot bot te <w>kluiven</w>.",
                            "target_lang_translations": {
                                "en": "The dog lay quietly in the corner of the room, <w>gnawing</w> on a large bone."
                            }
                        }
                    ],
                    "synonyms": [
                        "knabbelen",
                        "kluiven"
                    ],
                    "common_phrases": [
                        "aan een bot kluiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To nibble or bite off meat scraps that are still attached to a bone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gnaw",
                                "target_lang_sense_clarification": "to bite persistently at a bone to remove meat"
                            },
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "to take small bites from a bone"
                            },
                            {
                                "target_lang_word": "pick",
                                "target_lang_sense_clarification": "to clean meat off a bone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03d38f4f-51d8-365d-a95e-59616bb11a13",
                    "sense_definition": "Kleine beetjes ergens van afbijten of knabbelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zat zenuwachtig op haar nagels te <w>kluiven</w> tijdens het spannende examen.",
                            "target_lang_translations": {
                                "en": "She sat nervously <w>biting</w> her nails during the tense exam."
                            }
                        },
                        {
                            "text": "De muis zat stilletjes aan een stukje oude kaas te <w>kluiven</w>.",
                            "target_lang_translations": {
                                "en": "The mouse sat quietly <w>nibbling</w> on a piece of old cheese."
                            }
                        }
                    ],
                    "synonyms": [
                        "knabbelen",
                        "knagen"
                    ],
                    "common_phrases": [
                        "op je nagels kluiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To bite or nibble small pieces off of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "to take small bites of food or objects"
                            },
                            {
                                "target_lang_word": "gnaw",
                                "target_lang_sense_clarification": "to bite persistently on something"
                            },
                            {
                                "target_lang_word": "chew",
                                "target_lang_sense_clarification": "to bite on something repeatedly, like nails"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75d7c4ed-2b7d-32f3-80bc-4c97cd33b8cd",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>kluif</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De slager gaf de honden een paar lekkere <w>kluiven</w> om op te kauwen.",
                            "target_lang_translations": {
                                "en": "The butcher gave the dogs a few tasty <w>bones</w> to chew on."
                            }
                        },
                        {
                            "text": "Deze moeilijke opgaven waren flinke <w>kluiven</w> voor de studenten.",
                            "target_lang_translations": {
                                "en": "These difficult problems were real <w>handfuls</w> for the students."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'kluif' (bone with meat, or a tough task/handful)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bones",
                                "target_lang_sense_clarification": "bones with meat on them for chewing"
                            },
                            {
                                "target_lang_word": "tough tasks",
                                "target_lang_sense_clarification": "difficult challenges or handfuls"
                            },
                            {
                                "target_lang_word": "handfuls",
                                "target_lang_sense_clarification": "difficult things to deal with"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}