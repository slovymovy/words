                },
                {
                    "sense_id": "584fdffe-e5f0-3d2e-ba5e-2c3b4e0a983d",
                    "sense_definition": "Grandeur physique scalaire mesurant la capacité d'un système à modifier son état ou à produire un travail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique_et_industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cours de physique, nous apprenons à calculer l'<w>énergie</w> cinétique d'un objet en mouvement."
