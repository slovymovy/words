                "senses": [
                    {
                        "sense_id": "6551267f-3c65-3f6d-8998-cbc42752a858",
                        "entry_id": "668e5d4e-7d4c-3921-a815-5458f30d0044",
                        "glosses": [
                            "Coulée de lave à Hawaï, qui a une surface constituée de blocs chaotiques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9bb23eb5-eb74-3499-bb1e-56dfbdb8febc",
                        "entry_id": "668e5d4e-7d4c-3921-a815-5458f30d0044",
                        "glosses": [
                            "Forme de coulée de lave, rugueuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0f0e9b-a1d8-4816-8092-010d5582bdd5",
                                "sense_id": "9bb23eb5-eb74-3499-bb1e-56dfbdb8febc",
                                "text": "La surface des coulées de lave peut se présenter sous trois formes différentes, le pahoehoe, le aa, le plan uni."
                            },
                            {
                                "example_id": "ada53dfc-5e54-444b-81b1-106044397215",
                                "sense_id": "9bb23eb5-eb74-3499-bb1e-56dfbdb8febc",
                                "text": "[La coulée] se compose de deux branches, l’une de pahoehoe (lave unie) et l’autre d’aa (lave rugueuse)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bb6cae5-8466-4af3-85d6-38aa1ecb401d",
                        "source_entry_id": "668e5d4e-7d4c-3921-a815-5458f30d0044",
                        "target_lang_word": "aa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                        "entry_id": "0b78ab37-9d3b-3920-b428-b910b1f53d8b",
                                        "glosses": [
                                            "A form of lava flow associated with Hawaiian-type volcanoes, consisting of basaltic rock, usually dark-colored with a jagged and loose, clinkery surface. Compare pahoehoe."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71225b6-1874-4872-86c2-3959099b07b1",
                                                "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                                "text": "We...saw ‘pahoihoi’ or solid lava forming, and also ‘aa’ or clinkers."
                                            },
                                            {
                                                "example_id": "9c1a91bf-8d6a-4b01-bfa7-b2424b2c8817",
                                                "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                                "text": "Cooling and solidification frequently takes a different course [...] in lava flows, producing the clinker-like ‘aa’ lava."
                                            },
                                            {
                                                "example_id": "ea4846df-c11f-44d8-936b-8b49ee5f3aa1",
                                                "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                                "text": "Both pahoehoe and aa lava flows are common on the upper slopes of Mauna Loa with a preponderance of aa flows found at the lower elevations."
                                            }
                                        ]
                                    }
                                ]
                            },
