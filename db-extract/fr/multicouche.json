                                    {
                                        "sense_id": "0bd7cef4-42e3-3be5-96a5-a4fa7c889d7b",
                                        "entry_id": "bcce2360-4f14-3822-a63b-0691056c4516",
                                        "glosses": [
                                            "aus mehreren Schichten bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50713c01-6a59-4b68-a1d9-c00ec118e746",
                                                "sense_id": "0bd7cef4-42e3-3be5-96a5-a4fa7c889d7b",
                                                "text": "Der Zellaufbau der Haut ist mehrschichtig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68a420e9-190b-4066-b518-a641d91d19fd",
                        "source_entry_id": "e36f1113-c90e-398d-a772-73db8f7780d3",
                        "source_sense_id": "2b6b9d13-d591-376b-ae51-3a329ab2036b",
                        "target_lang_word": "mehrlagig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mehrlagig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a54406-7764-3a6c-a029-98464eb8629b",
                                        "entry_id": "ccebf22d-b166-38ca-aa58-4ed222b64df8",
                                        "glosses": [
                                            "aus mehreren Lagen bestehend; mehrere Lagen aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8363cf-d22b-460b-aa68-36283d20b0d5",
                                                "sense_id": "b5a54406-7764-3a6c-a029-98464eb8629b",
                                                "text": "„Die Wände bestehen aus Trockenmauern, die noch mehrlagig erhalten sind, an einer Seite sind große Steine senkrecht in den Boden gesetzt und mit kleinen Steinen verkeilt worden.“"
                                            },
                                            {
                                                "example_id": "5a90d091-c394-43c1-83ce-209d4c1c7081",
                                                "sense_id": "b5a54406-7764-3a6c-a029-98464eb8629b",
                                                "text": "„Werden bei herkömmlichen, mehrlagigen Heizkörpern alle Platten parallel durchströmt, verfügt der Therm X2 über eine serielle Durchströmung.“"
                                            },
                                            {
                                                "example_id": "53b5a5a8-070a-4cab-91cb-d648d1e2f1e5",
                                                "sense_id": "b5a54406-7764-3a6c-a029-98464eb8629b",
                                                "text": "„Eine mineralische Dichtung ist eine künstlich aufgebaute, aus ein- oder mehrlagig verdichteten Schichten aus anorganischen (mineralischen) Böden bestehende Dichtung, allenfalls unter Beigabe von Zusatzstoffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d90af7b-fcaf-4c11-990d-312df6140a68",
                        "source_entry_id": "e36f1113-c90e-398d-a772-73db8f7780d3",
                        "source_sense_id": "2b6b9d13-d591-376b-ae51-3a329ab2036b",
                        "target_lang_word": "vielschichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielschichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe9874f-5a3b-31a8-bb8f-33a914286eec",
                                        "entry_id": "431ddb1b-973d-357d-a610-c27b786a580f",
                                        "glosses": [
                                            "in verschiedenen Arten und Weisen, mit vielen Seiten, vielen Aspekten, vielen Facetten, vielen Varianten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fe3eea-173a-4606-b828-767fc2a7bfe8",
                                                "sense_id": "bfe9874f-5a3b-31a8-bb8f-33a914286eec",
                                                "text": "„Der Gegenstand, wie vielschichtig und wichtig er auch sein mag, ist mittlerweile so oft, so kompetent und so fruchtbar diskutiert worden, dass er dem Leser inzwischen vertraut und dem Verfasser deshalb problematisch geworden ist.“"
                                            },
                                            {
                                                "example_id": "650fabcd-d820-48c1-a4e3-8799582eb4a2",
                                                "sense_id": "bfe9874f-5a3b-31a8-bb8f-33a914286eec",
                                                "text": "„Das Material ist ungemein dicht und wiewohl meist privater Art, äußerst vielschichtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
