                                    {
                                        "sense_id": "8169c311-295a-364d-8403-fe493c4e5a79",
                                        "entry_id": "79b385a3-ebe9-37cd-9a4d-9e1192a236fd",
                                        "glosses": [
                                            "Kampf um die beste Leistung unter mehreren Personen oder Gruppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e79c181-53b3-43d6-afad-2fd52e597065",
                                                "sense_id": "8169c311-295a-364d-8403-fe493c4e5a79",
                                                "text": "Es tobt ein spannender Wettkampf zwischen den Kontrahenten."
                                            },
                                            {
                                                "example_id": "f87e1715-2314-4cdf-ab61-ceb205fba3de",
                                                "sense_id": "8169c311-295a-364d-8403-fe493c4e5a79",
                                                "text": "„Einer der Ringer bricht sich im Wettkampf nämlich das Genick.“"
                                            },
                                            {
                                                "example_id": "f747362f-f3f7-4388-9843-43fe4daa9349",
                                                "sense_id": "8169c311-295a-364d-8403-fe493c4e5a79",
                                                "text": "„Damit es nicht zu langweilig wird, müssen die Probanden regelmäßig Matches und Challenges über sich ergehen lassen, Wettkämpfe und Herausforderungen also.“"
                                            },
                                            {
                                                "example_id": "750c5a6a-bc4b-4811-b0f7-b331ffc6dc46",
                                                "sense_id": "8169c311-295a-364d-8403-fe493c4e5a79",
                                                "text": "„Er ist einer der besten Gleitschirmpiloten der Welt, war 2004 Gesamtsieger im Worldcup, viermal deutscher Meister, ist bei Wettkämpfen in Südafrika, Brasilien und Australien angetreten.“"
                                            },
                                            {
                                                "example_id": "caa8241b-44a9-4178-ab94-4867bef77446",
                                                "sense_id": "8169c311-295a-364d-8403-fe493c4e5a79",
                                                "text": "„Diese Logik beherrschte den gesamten Kalten Krieg in ihrem Wettkampf um die führende Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
