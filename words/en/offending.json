            "senses": [
                {
                    "sense_id": "3d8fbc01-d3c8-3d4b-8b72-a0da912d2ca4",
                    "sense_definition": "Responsible for causing displeasure, damage, or a problem; to be blamed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Something in the fridge smelled terrible, but the <w>offending</w> article was soon identified and removed.",
                            "target_lang_translations": {
                                "ru": "Что-то в холодильнике ужасно пахло, но <w>проблемный</w> предмет вскоре был найден и убран."
                            }
                        },
                        {
                            "text": "If you want to stop the pop-ups, you must find and delete the <w>offending</w> program from your computer.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите остановить всплывающие окна, вам нужно найти и удалить <w>виновную</w> программу с вашего компьютера."
                            }
