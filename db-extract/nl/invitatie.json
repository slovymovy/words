                        "cross_references": [
                            {
                                "target_word": "invitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "The act of inviting; solicitation; the requesting of a person's company."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8a0be5-ff1d-4df0-ad73-c63d32a691bc",
                                                "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                                                "text": "an invitation to a party, to a dinner, or to visit a friend"
                                            },
                                            {
                                                "example_id": "3df9fe4d-0e32-448e-9973-a295396129db",
                                                "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e0d995-ddda-3539-932d-4997e72d78bb",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "A document or verbal message conveying an invitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db65b92a-ebd3-4ff6-944d-e111cf9d4cb2",
                                                "sense_id": "c4e0d995-ddda-3539-932d-4997e72d78bb",
                                                "text": "We need to print off fifty invitations for the party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e9b326-2c3f-3f1c-b88b-eec992e0b401",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "Allurement; enticement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d3e307-cd03-39eb-8bdb-3f0dc0777830",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "A line that is intentionally left open to encourage the opponent to attack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a385a878-72ba-3c05-86ac-24126eb36f36",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "The brief exhortation introducing the confession in the Anglican communion-office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "A bid that tells one's partner that game or slam is likely if their hand is at the strong end of what they have indicated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5964b8d1-679b-454a-9b4c-ae3d8d4bca12",
                                                "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                                                "text": "I assume also that opener would have shown no interest in slam by either bidding 4NT or 50 after the slam invitation of 46."
                                            },
                                            {
                                                "example_id": "2d0144c0-d914-4513-b5ca-d6b324c3f51b",
                                                "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                                                "text": "To any other invitation made by the captain, acceptance or refusal of the invitation is exclusively a question of points within the range advertised in the opening statement, and the invitation is always in the last called suit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7725612f-5af2-433c-b3d6-64f7b682608b",
                        "source_entry_id": "d3a0074b-1100-3d6f-a345-fd32ed7789a4",
                        "source_sense_id": "d04408ae-ff65-34b3-8131-80ae7387c583",
                        "target_lang_word": "invitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2844ab-6c20-32ae-bd5c-ca369a63c5b5",
                                        "entry_id": "8a449414-f9a1-3bab-b8b3-3340ccf85251",
                                        "glosses": [
                                            "Action d’inviter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9de5cf-1fed-49cd-b011-8afbe78b2af4",
                                                "sense_id": "3f2844ab-6c20-32ae-bd5c-ca369a63c5b5",
                                                "text": "Au mois de janvier de cette année, me trouvant à Paris, […], je reçus de Maxime Du Camp l’invitation tout à fait inattendue d'assister à l'exécution de Troppmann."
                                            },
                                            {
                                                "example_id": "63e08db9-a604-4146-953b-657c0c866cd7",
                                                "sense_id": "3f2844ab-6c20-32ae-bd5c-ca369a63c5b5",
                                                "text": "On se figure sans peine l’empressement que je mis à me rendre à une invitation qui me permettait de voir le Sultan, sa cour, son armée et une région à peu près inexplorée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691eb239-f424-3be6-bcc7-3e95dd4b56e9",
                                        "entry_id": "8a449414-f9a1-3bab-b8b3-3340ccf85251",
                                        "glosses": [
                                            "La lettre, le billet, le carton que l'on fait parvenir pour inviter."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64dbcabd-58b6-40f1-ae2e-155405b7166c",
                                                "sense_id": "691eb239-f424-3be6-bcc7-3e95dd4b56e9",
                                                "text": "C’est sur votre invitation que je suis venu."
                                            },
                                            {
                                                "example_id": "65778bfb-51fa-4d6c-829c-72e146216cb7",
                                                "sense_id": "691eb239-f424-3be6-bcc7-3e95dd4b56e9",
                                                "text": "Il a reçu une invitation pour se rendre à cette soirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f91f9d6-5e5e-3a30-80c4-e6287b9f6d0c",
                                        "entry_id": "8a449414-f9a1-3bab-b8b3-3340ccf85251",
                                        "glosses": [
                                            "Conseil, prescription, demande, incitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db557c8-82e9-42b6-924a-f0171ddfa994",
                                                "sense_id": "5f91f9d6-5e5e-3a30-80c4-e6287b9f6d0c",
                                                "text": "La prescription des directions est donc une invitation non déguisée au massacre de ces soldats, invitation qui a d’ailleurs été suivie à la lettre par la troupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a07249f-7709-3238-8e88-2c3af88635a4",
                                        "entry_id": "8a449414-f9a1-3bab-b8b3-3340ccf85251",
                                        "glosses": [
                                            "Convocation."
                                        ],
                                        "tags": [
                                            "Parfois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00545ece-fbf6-461e-b7d4-0f3f8abf9da2",
                                                "sense_id": "8a07249f-7709-3238-8e88-2c3af88635a4",
                                                "text": "Sur une invitation du commissaire, ils s’étaient présentés au poste de la rue de la Gaîté où on les avait longuement interrogés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
