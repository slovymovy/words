                        "entry_id": "a88acde6-6df7-3e19-8c4c-766fa4c14428",
                        "glosses": [
                            "доверху полный и ещё не начатый, нетронутый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fc506f-c89e-4330-ada8-d1b5a28b5a1f",
                                "sense_id": "97483998-7b63-3f04-91f8-c37be65896c7",
                                "text": "Непочатая бочка масла."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb9d89f5-a7c8-4873-a0d7-13219668ea76",
                        "source_entry_id": "a88acde6-6df7-3e19-8c4c-766fa4c14428",
                        "source_sense_id": "97483998-7b63-3f04-91f8-c37be65896c7",
                        "target_lang_word": "entire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "021b4526-b57e-383d-aad8-dddfe19771ab",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Whole; complete."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "postpositional",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1017a6ee-74c0-4623-bb3a-526cc5a04425",
                                                "sense_id": "021b4526-b57e-383d-aad8-dddfe19771ab",
                                                "text": "We had the entire building to ourselves for the evening."
                                            },
                                            {
                                                "example_id": "1ae8f075-9a25-4910-957d-04a75a55f5df",
                                                "sense_id": "021b4526-b57e-383d-aad8-dddfe19771ab",
                                                "text": "No man is an Iland, intire of it ſelfe; euery man is a peece of the Continent, a part of the maine; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38459cf0-92ba-37d6-bc1d-b10867b789f8",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Having a smooth margin without any indentation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633cf373-c33f-41d8-9d10-6342550d5679",
                                                "sense_id": "38459cf0-92ba-37d6-bc1d-b10867b789f8",
                                                "text": "Spores tetrahedral, paraphyses mastoid-claviform, scales smooth, entire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a230eff-807d-35b0-945b-b6b6fc6f3df9",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Consisting of a single piece, as a corolla."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b626fe7c-7968-398b-a7ed-10af58cc661e",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Complex-differentiable on all of ℂ."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40877b54-2ca3-3076-a615-1d631d01bd31",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Not gelded."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8454a1-ba2c-44dd-ab5a-f20153fc768c",
                                                "sense_id": "40877b54-2ca3-3076-a615-1d631d01bd31",
                                                "text": "On top of that, he was entire, which meant his bloodline could carry on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5469e291-0495-349e-87de-a091a60399b4",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Morally whole; pure; sheer."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "639d1b94-316c-4d9a-8762-d8c16cd40484",
                                                "sense_id": "5469e291-0495-349e-87de-a091a60399b4",
                                                "text": "See now, whether pure fear and entire cowardice doth not make thee / wrong this virtuous gentlewoman to close with us."
                                            },
                                            {
                                                "example_id": "53fa837f-c44a-4e5a-86d9-fa172198f74a",
                                                "sense_id": "5469e291-0495-349e-87de-a091a60399b4",
                                                "text": "No man had ever a heart more entire to the king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a09ab59c-f128-3519-a694-17f7ec0ed017",
                                        "entry_id": "41ed0a06-e3f9-3ede-a84c-6d08a2ad5bba",
                                        "glosses": [
                                            "Internal; interior."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd586d08-ee02-4d2c-aaaf-d3e1eb47fe6c",
                                                "sense_id": "a09ab59c-f128-3519-a694-17f7ec0ed017",
                                                "text": "Depp is the wound, that dints the parts entire"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f77bf382-e962-39c5-bb11-99003417845d",
                                        "entry_id": "651a0620-c3ea-31f9-adb3-849ee463e16b",
                                        "glosses": [
                                            "The whole of something; the entirety."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a60eab4d-cfb5-482f-9fd9-9fe9adb97a44",
                                                "sense_id": "f77bf382-e962-39c5-bb11-99003417845d",
                                                "text": "In the entire of the Poems we never hear of a merchant ship of the Greeks."
                                            },
                                            {
                                                "example_id": "06385a3a-2f34-4eb4-b23c-64b9d8eea955",
                                                "sense_id": "f77bf382-e962-39c5-bb11-99003417845d",
                                                "text": "‘Then is the City Magistrate the entire of your family now?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc811da-1e6a-3cf2-b9a2-37bfdc4f49a1",
                                        "entry_id": "651a0620-c3ea-31f9-adb3-849ee463e16b",
                                        "glosses": [
                                            "An uncastrated horse; a stallion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da59ddc7-8385-4196-9aef-b6f9ced7a0ad",
                                                "sense_id": "9fc811da-1e6a-3cf2-b9a2-37bfdc4f49a1",
                                                "text": "He asked why Hijaz was an entire. You know what an entire is, do you not, Anna? A stallion which has not been castrated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f852498-c297-3374-b0be-54803dde8ddb",
                                        "entry_id": "651a0620-c3ea-31f9-adb3-849ee463e16b",
                                        "glosses": [
                                            "A complete envelope with stamps and all official markings: (prior to the use of envelopes) a page folded and posted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9882b20a-964f-3329-8dbc-f55bd872f2fd",
                                        "entry_id": "651a0620-c3ea-31f9-adb3-849ee463e16b",
                                        "glosses": [
                                            "Porter or stout as delivered from the brewery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
