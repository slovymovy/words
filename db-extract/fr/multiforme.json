        "fr-extract.jsonl": [
            {
                "entry_id": "00986b47-9b27-3b91-96c0-f4bd5bcff634",
                "word": "multiforme",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb6bed52-1ca7-4e30-a43d-7f8bcb9fcce4",
                        "entry_id": "00986b47-9b27-3b91-96c0-f4bd5bcff634",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "multiformes"
