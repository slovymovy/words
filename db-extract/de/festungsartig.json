                ],
                "senses": [
                    {
                        "sense_id": "553a2ba3-bf1c-3c89-945d-5115f75cedd6",
                        "entry_id": "73e39244-2904-310d-9eb4-94b18d748c1b",
                        "glosses": [
                            "einer Festung ähnelnd, wie eine Festung aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4282b6-90c9-440d-82fe-b3e0838c3202",
                                "sense_id": "553a2ba3-bf1c-3c89-945d-5115f75cedd6",
                                "text": "„Ferris parkte den Wagen am Straßenrand und ging zu Fuß in das festungsartige Gebäude der Geheimpolizei, wo ihn zwei Unteroffiziere in die Mitte nahmen und die Treppe hinaufgeleiteten.“"
                            },
                            {
                                "example_id": "b7b4f9d4-7bfb-4dc7-b327-b854c74060bb",
                                "sense_id": "553a2ba3-bf1c-3c89-945d-5115f75cedd6",
                                "text": "„›Hab 'n bisschen Football gespielt‹, meinte Joe Lon kurz angebunden und richtete den Blick auf die dunkle festungsartige Wand aus Bäumen, die seinen kleinen Campingplatz umgab.“"
                            },
                            {
                                "example_id": "ff8da62a-48fd-4da2-a44c-dd7942818d62",
                                "sense_id": "553a2ba3-bf1c-3c89-945d-5115f75cedd6",
                                "text": "„Er geht um einen festungsartigen Felsblock herum und betrachtet seine Knöchel vor den Sprüngen im Stein, dann blickt er auf, und ihm stockt der Atem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
