                        "examples": [
                            {
                                "example_id": "07c1f1f1-42be-4e29-8195-f56acacdabc2",
                                "sense_id": "0afc9eff-f015-363c-9757-0846aa556db5",
                                "text": "Эта лиственница ― современница Ивана Грозного и Ермака."
                            },
                            {
                                "example_id": "4b230a58-faed-4107-83f5-82a18590146d",
                                "sense_id": "0afc9eff-f015-363c-9757-0846aa556db5",
                                "text": "А вот другая девочка, возросшая в провинциальной глуши, \"в тиши задумчивых селений\", сверстница Марии и современница ее, она этот выбор осуществляет."
                            }
                        ]
                    }
