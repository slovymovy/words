                ],
                "senses": [
                    {
                        "sense_id": "133736aa-b3e0-3eb2-a889-05e6e127389e",
                        "entry_id": "ce14c0ea-5665-3ae8-94ce-bdc4d849787a",
                        "glosses": [
                            "Catherine; Catherine's"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "55c92b5b-f610-45c2-9a10-ff5ad7100856",
                                "sense_id": "133736aa-b3e0-3eb2-a889-05e6e127389e",
                                "text": "Я ника́к не был в состоя́нии себе́ предста́вить, каки́м о́бразом э́тот убо́гий старичо́к мог когда́-то быть вое́нным челове́ком, кома́ндовать, распоряжа́ться — да ещё в екатери́нинские суро́вые времена́!",
                                "translation": "I could not conceive how this forlorn old man could once have been an officer, could have maintained discipline, have given his commands—and that, too, in the stern days of Catherine!",
                                "english": "I could not conceive how this forlorn old man could once have been an officer, could have maintained discipline, have given his commands—and that, too, in the stern days of Catherine!"
                            }
                        ]
                    }
                ],
