                            {
                                "example_id": "a628e871-3be5-4ad8-9fd9-681bace9380d",
                                "sense_id": "6a99b302-1c1d-3470-9d7b-742f0bf308e2",
                                "text": "„Das Ludwig-Erhard-Haus befindet sich in der Berliner Fasanenstraße, unweit vom Theater des Westens und dem Turmhaus am Kant-Dreieck und wurde 1994-1997 von Nicholas Grimshaw und Partner errichtet.“"
                            },
                            {
                                "example_id": "91e72a3d-1415-46d8-8c88-0660b93fb94f",
                                "sense_id": "6a99b302-1c1d-3470-9d7b-742f0bf308e2",
                                "text": "„Das Ludwig-Erhard-Haus als Landesgeschäftsstelle ist der Organisations- und Kommunikationsmittelpunkt der Hamburger CDU.“"
                            },
                            {
                                "example_id": "2059178f-e622-4e3d-98e1-35bea631015b",
                                "sense_id": "6a99b302-1c1d-3470-9d7b-742f0bf308e2",
                                "text": "„Diese Internetseiten des Studentenwohnheims Ludwig-Erhard-Haus in Erlangen werden inhaltlich vom WebTeam und technisch vom NetzTeam betreut.“"
                            },
                            {
                                "example_id": "b95e3a9f-2454-4d62-9a92-a8208285303e",
                                "sense_id": "6a99b302-1c1d-3470-9d7b-742f0bf308e2",
                                "text": "„Besonders hob der bayerische Bauminister auch den außergewöhnlichen Einsatz der Unterstützer des Ludwig-Erhard-Hauses hervor“"
                            }
