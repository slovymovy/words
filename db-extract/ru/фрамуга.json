                                    },
                                    {
                                        "sense_id": "63d81640-7437-3630-84cf-2cd6346ceabe",
                                        "entry_id": "4412c44c-75d9-3b4e-92c2-e965ea134f54",
                                        "glosses": [
                                            "Items that have arrived over the transom."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745019eb-c596-46a5-a7da-d853c2ab0c0c",
                                                "sense_id": "63d81640-7437-3630-84cf-2cd6346ceabe",
                                                "text": "We are overwhelmed with transom resumes."
                                            },
                                            {
                                                "example_id": "6739e587-35e9-45ee-a35b-8bfd9f9c5bc8",
                                                "sense_id": "63d81640-7437-3630-84cf-2cd6346ceabe",
                                                "text": "They only met the deadline by working most of the night and making a transom filing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b2b6d91-4147-4562-8579-14b2fcb31f1e",
                        "source_entry_id": "f15ecb88-09f5-3194-baaf-ea4f6e9c770c",
                        "source_sense_id": "6a2d40e6-171f-3845-8fe1-8cf695c50316",
                        "target_lang_word": "fanlight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0ac359-13d3-3825-87d4-a5dafd02aa91",
                                        "entry_id": "5a05c0ef-2683-35bc-96d2-7bf95e4e141e",
                                        "glosses": [
                                            "A semicircular or semioval window over a door or other window, normally having a fan-like structure of ribs; sometimes hinged to the transom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dacada6-8505-4ef4-8b8e-954e4954bb59",
                                                "sense_id": "2f0ac359-13d3-3825-87d4-a5dafd02aa91",
                                                "text": "One house, however, second from the corner, was still occupied entire; and at the door of this, which wore a great air of wealth and comfort, though it was now plunged in darkness except for the fanlight, Mr. Utterson stopped and knocked. A well-dressed, elderly servant opened the door."
                                            },
                                            {
                                                "example_id": "dacae38b-d568-4e96-8c48-8c4c2b815e5e",
                                                "sense_id": "2f0ac359-13d3-3825-87d4-a5dafd02aa91",
                                                "text": "Flutings also adorn the short architraves each side of the fanlight, and the abacus of the pilaster columns which is carried across a supplementary lintel in front of the lintel proper, the latter being several inches to the rear because of the deeply recessed arrangement of the door."
                                            },
                                            {
                                                "example_id": "7ff31a8f-5cdd-4cc5-b911-457aadaf882e",
                                                "sense_id": "2f0ac359-13d3-3825-87d4-a5dafd02aa91",
                                                "text": "This street is Summer. Faces of brick run together to make a single block-long face. The house numbers are set in fanlights of stained glass above the doors."
                                            },
                                            {
                                                "example_id": "cab52d5f-8f4b-4e39-b249-de316ba89512",
                                                "sense_id": "2f0ac359-13d3-3825-87d4-a5dafd02aa91",
                                                "text": "It turned out to be a big gloomy pile with ivy and peeling walls and a smashed fanlight over the door, the kind of place where you picture a mad stepdaughter locked up in the attic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab8593a-98bd-3538-aea6-77b278836aa5",
                                        "entry_id": "5a05c0ef-2683-35bc-96d2-7bf95e4e141e",
                                        "glosses": [
                                            "An electric fan, usually a ceiling fan, that is also a light fixture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
