                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5777be-33a6-43ad-aec9-2c9cb8e36781",
                                                "sense_id": "52be047c-09d1-373a-9385-e1e86711e6da",
                                                "text": "'Maar,' zegt Coyle, 'ook met die beperkte omvang hebben we al interessante resultaten geboekt."
                                            },
                                            {
                                                "example_id": "8c6cbe49-68dc-4731-a32d-afb35afdf846",
                                                "sense_id": "52be047c-09d1-373a-9385-e1e86711e6da",
                                                "text": "Door de vragen die Pamela me tijdens onze lunchpauzes stelde over het leven op Trinidad, ontdekte ik hoe weinig ze op school of daarna had geleerd over de omvang van het Britse Rijk."
                                            }
