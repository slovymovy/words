                                    {
                                        "sense_id": "ec5e1dc8-2a40-32a6-b4cf-5063a07bc35e",
                                        "entry_id": "7e2ea1c4-b43c-3b87-8487-915e48137949",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 5, das zu den Halbmetallen gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d591f7ad-405e-40d1-b82a-36988d994e42",
                                                "sense_id": "ec5e1dc8-2a40-32a6-b4cf-5063a07bc35e",
                                                "text": "Bor kommt natürlich nur in sauerstoffhaltigen Verbindungen vor."
                                            },
                                            {
                                                "example_id": "6c427e67-398b-4968-bcd4-57d717bd3f44",
                                                "sense_id": "ec5e1dc8-2a40-32a6-b4cf-5063a07bc35e",
                                                "text": "„Ein weiterer Vertreter dieser Familie ist einschichtiges hexagonales Bornitrid, das aus den Elementen Bor und Stickstoff besteht und genau wie Graphen wabenförmig gebaut ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f02a1ff-6443-4171-8b10-ac0a67abca6f",
                        "source_entry_id": "c18da1f4-0683-3530-9aaa-d87a7a39aa67",
                        "source_sense_id": "57908319-75ea-3184-b7aa-caa46211a97d",
                        "source_sense_description": "een chemisch element en een zwart metalloïde",
