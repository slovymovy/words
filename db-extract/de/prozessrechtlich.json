                    }
                ],
                "senses": [
                    {
                        "sense_id": "b529bcb6-a9ce-3576-a398-97f625672d07",
                        "entry_id": "36046ba8-7341-3573-a54e-587e072e4592",
                        "glosses": [
                            "das Prozessrecht betreffend"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "e0d59552-7f97-4a42-a8f1-f6949de31681",
                                "sense_id": "b529bcb6-a9ce-3576-a398-97f625672d07",
                                "text": "„Wegen einer prozessrechtlichen Besonderheit könnte der Mann im neuen Prozess sogar frei kommen.“"
                            },
                            {
                                "example_id": "cd2f4476-1d36-4026-ba37-cb4bc778f848",
                                "sense_id": "b529bcb6-a9ce-3576-a398-97f625672d07",
                                "text": "„Diese Erstberatung leistet Hilfestellung hinsichtlich prozessrechtlicher Vorgehensweisen, Einschätzung konkreter juristischer Fragestellungen im Hinblick auf mögliche prozessrechtliche Schritte, Überblick über eine konkrete rechtliche Situation, Vorschlagsunterbreitung für außergerichtliche Vereinbarungen, Erklärung juristischer Fachausdrücke.“"
                            },
                            {
                                "example_id": "c43f3edb-9924-4438-944d-3b607d8da856",
                                "sense_id": "b529bcb6-a9ce-3576-a398-97f625672d07",
                                "text": "„Die Kammer wies neben der vor allem auf prozessrechtliche Fehler abzielenden Verteidigungsstrategie auch auf ein nun anlaufendes Strafverfahren in Karlsruhe hin, in dem sich zwei mutmaßliche Mittäter des Mannes wegen der Karlsruher Sprengung zu verantworten haben werden.“"
                            },
                            {
                                "example_id": "75f7de88-f204-409e-8e1b-c449d0ecc38a",
                                "sense_id": "b529bcb6-a9ce-3576-a398-97f625672d07",
                                "text": "„Das Einreichen eines Schriftstücks bei Gericht kann also auf einem beliebigen anderen prozessrechtlich vorgesehenen Wege erfolgen – per Post, per Telefax oder per Bote.“"
                            },
                            {
                                "example_id": "f8f2c02e-2869-48d3-b5f8-d2cc51a24bf9",
                                "sense_id": "b529bcb6-a9ce-3576-a398-97f625672d07",
                                "text": "„Bei der Hinterlegung kann die Registrierung des Werkes beantragt werden, wodurch gewisse prozessrechtliche Vorteile erlangt werden können.“"
                            }
