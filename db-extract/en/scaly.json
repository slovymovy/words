                                "sense_id": "53bc1ef6-9275-3a5a-a566-0569475d3463",
                                "text": "a scaly fish  a scaly stem"
                            },
                            {
                                "example_id": "8cb69061-8878-40fa-b661-b3c47b93982b",
                                "sense_id": "53bc1ef6-9275-3a5a-a566-0569475d3463",
                                "text": "Like scaly carp and feathered swan\nTo nature's world we do belong."
                            }
                        ]
                    },
