                    "frequency": "Low",
                    "semantic_group_id": "persimmon_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A mature <w>persimmon</w> stood at the back of the garden, laden with bright orange fruit.",
                            "target_lang_translations": {
