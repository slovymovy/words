            {
                "entry_id": "1dc3e06f-6438-36c8-b56d-0c372f1f934c",
                "word": "nina",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f18d3900-348d-4497-9a1e-1abfc8b02d25",
