                "translations": [
                    {
                        "translation_id": "ec15b3b1-13bc-42c3-a616-22307019233b",
                        "source_entry_id": "b3565437-7eec-325a-8be0-25c818dc5c4a",
                        "source_sense_id": "8bacdfe0-638b-3245-b528-65de3bc00688",
                        "target_lang_word": "enamelled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enamelled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b46e039-6abf-3768-8ef6-23b94f043d34",
                                        "entry_id": "d1abb7f4-5c16-32a0-b45b-8c854c1fc5fb",
                                        "glosses": [
                                            "Alternative form of enameled."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5933fc-4d72-4b09-9875-09cd7c5efb8d",
                                                "sense_id": "8b46e039-6abf-3768-8ef6-23b94f043d34",
                                                "text": "The enamelled cup, which has been designated as a chalice, was the relique of greatest interest brought to light in these explorations."
                                            },
                                            {
                                                "example_id": "b6ff369c-0597-4c75-b68c-1beee33ff678",
                                                "sense_id": "8b46e039-6abf-3768-8ef6-23b94f043d34",
                                                "text": "Queen Alexandra was there looking very beautiful but very enamelled."
                                            },
                                            {
                                                "example_id": "cd8d4c32-2038-4817-84eb-0415d27c950f",
                                                "sense_id": "8b46e039-6abf-3768-8ef6-23b94f043d34",
                                                "text": "When a wall is faced with white enamelled bricks, a little yellow or pink tinting to the pointing adds much to the effect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enamelled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d86555c-92c3-3fe2-899d-edd8334c56b4",
                                        "entry_id": "40fdb269-ccad-39e4-9c1c-7240976a3f37",
                                        "glosses": [
                                            "simple past and past participle of enamel"
                                        ],
                                        "tags": [
                                            "UK",
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f44a6c21-4235-40aa-bd97-afedecf3f178",
                                                "sense_id": "8d86555c-92c3-3fe2-899d-edd8334c56b4",
                                                "text": "In recent issues two replies have been given to correspondents concerning the function of the diamond-shaped enamelled white plates fixed to signalposts, which are to indicate to enginemen that the section of line is track-circuited, so that action under Rule 55 of the Rule Book is unnecessary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
