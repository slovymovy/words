                "senses": [
                    {
                        "sense_id": "2ad97922-9505-34fe-9519-827551cee683",
                        "entry_id": "4049982d-88c4-3dfb-8ff4-9babfe70adbf",
                        "glosses": [
                            "Couper (un métal) par oxydation localisée mais continue, à l'aide d'un jet d'oxygène pur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d7ac4f-14c8-4e93-b1d9-f7a81c42ad79",
                                "sense_id": "2ad97922-9505-34fe-9519-827551cee683",
                                "text": "De tous les métaux non ferreux, le cuivre paraissait le plus certainement impossible à oxycouper."
                            },
                            {
                                "example_id": "c7ef77d8-576e-4fa2-8950-507b61e9df70",
                                "sense_id": "2ad97922-9505-34fe-9519-827551cee683",
                                "text": "Ces produits doivent donc être tels que l'on puisse oxycouper et souder sans danger pour la qualité du travail et la santé du personnel."
                            }
                        ]
                    }
