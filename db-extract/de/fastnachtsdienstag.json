                    {
                        "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                        "entry_id": "57d33ed3-05ef-3f7f-89cf-d54f8a0ce630",
                        "glosses": [
                            "der Tag vor dem Aschermittwoch (als letzter Tag der Fastnacht/des Karneval)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3d5ff8-b115-449b-b414-8e71b0d1ffec",
                                "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                "text": "Am Fastnachtsdienstag findet der letzte Fastnachtsumzug statt."
                            },
                            {
                                "example_id": "b4e38039-2b9a-4d87-acac-9366fad94d90",
                                "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                "text": "Am Abend des Fastnachtsdienstag wird das Ende der fünften Jahreszeit mit einer symbolischen Beerdigung der Fastnacht begangen."
                            },
                            {
                                "example_id": "fb3f208d-1611-462e-ad23-4beed1922577",
                                "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                "text": "Der frühestmögliche Termin für den Fastnachtsdienstag ist der 3. Februar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c3e2dea-4647-4df9-a984-a608fb65e953",
                        "source_entry_id": "57d33ed3-05ef-3f7f-89cf-d54f8a0ce630",
                        "source_sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                        "source_sense_description": "der Tag vor dem Aschermittwoch (als letzter Tag der Fastnacht/des Karneval)",
                        "target_lang_word": "Shrove Tuesday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shrove Tuesday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9697cfa7-0e43-330c-bc83-d619d852a9d6",
                                        "entry_id": "01336316-95b2-380b-b147-336ebc426c7f",
                                        "glosses": [
                                            "The day before the beginning of Lent on Ash Wednesday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3e5003-f901-40bd-aaf4-42651da4038b",
                                                "sense_id": "9697cfa7-0e43-330c-bc83-d619d852a9d6",
                                                "text": "Observe when the Moon is new in February, the next Tuesday after is Shrove-tuesday: but if it change on Tuesday, then the next Tuesday following is Shrove-tuesday"
                                            },
                                            {
                                                "example_id": "490fbe8b-e2e7-43f0-9283-a9513f935724",
                                                "sense_id": "9697cfa7-0e43-330c-bc83-d619d852a9d6",
                                                "text": "The day appointed for this extraordinary hunting-party was Shrove Tuesday. The Protestants of Paisley, in whose neighbourhood this story may be said to have originated, cannot discern the difference betwixt Shrove Tuesday and any other Tuesday; but if a Roman Catholic Princess, even in our free times, should be invited to a hunting-match on Shrove Tuesday, she would be shocked at the profane invitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
