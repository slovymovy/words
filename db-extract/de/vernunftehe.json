                "senses": [
                    {
                        "sense_id": "25df5409-a0f7-324a-a682-d86700e0553f",
                        "entry_id": "08aee191-624c-3724-8426-029276313591",
                        "glosses": [
                            "Eheschließung, die eher aus sachlichen, objektiven Gründen und Interessen – statt aus Liebe – erfolgte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2027e119-71fb-4467-873b-6275fcdeec24",
                                "sense_id": "25df5409-a0f7-324a-a682-d86700e0553f",
                                "text": "„Was zunächst eine Vernunftehe war, ist nach meinem Empfinden inzwischen mit mehr Gefühl und Liebe zum Verein unterlegt.“"
                            },
                            {
                                "example_id": "2ca01ecf-c906-4823-b32c-3846d0bee404",
                                "sense_id": "25df5409-a0f7-324a-a682-d86700e0553f",
                                "text": "„Obwohl eine reine Vernunftehe, gebar die Gräfin ihm 9 Kinder, von denen jedoch 5 vorzeitig starben.“"
                            },
                            {
                                "example_id": "27256289-ade0-46be-a0f4-09a7ec389d93",
                                "sense_id": "25df5409-a0f7-324a-a682-d86700e0553f",
                                "text": "„Die Vernunftehe mit Dr. Lasker zerbricht, wird aber erst im Jahre 1903 geschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
