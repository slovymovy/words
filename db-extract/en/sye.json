                "senses": [
                    {
                        "sense_id": "63c940c3-8bad-3460-9edb-d1c48bc91451",
                        "entry_id": "02be174c-0dfb-316a-ac58-c0bbfe1211ce",
                        "glosses": [
                            "To say."
                        ],
                        "tags": [
                            "UK",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e5c0b32d-a498-4054-ae19-a29d3e71b2c9",
                                "sense_id": "63c940c3-8bad-3460-9edb-d1c48bc91451",
                                "text": "hinkin' of whort yer'd liked ter sye, but whort yer 'aven't said,"
                            },
                            {
                                "example_id": "0fd4952b-6c90-406e-8e34-e71979361740",
                                "sense_id": "63c940c3-8bad-3460-9edb-d1c48bc91451",
                                "text": "Thank yer kindly for mi comfortable tea. That's what you was about to sye, eh'!\nNo, 'tain't."
                            },
                            {
                                "example_id": "225a0f01-d8fd-4881-b020-1eab95d21722",
                                "sense_id": "63c940c3-8bad-3460-9edb-d1c48bc91451",
                                "text": "[…] is nicely depicted in the following literary picture of Sir Douglas Haig by a London Tommy: “Aig, 'e don't sye much, 'e don't; 'e don't, so to sye, sye nothink, sye nothink; but what 'e don't sye don't mean nothink, not 'arf; and when 'e do sye anythink—my Gawd!\""
                            },
                            {
                                "example_id": "3d899099-73dd-4099-a8b0-b1b4d3908df6",
                                "sense_id": "63c940c3-8bad-3460-9edb-d1c48bc91451",
                                "text": "It was a terrible thing to sye of one that's everythink in the world to me, but seein' 'im there, all crumpled up, with one leg one wye, and the other leg another wye, […]"
                            }
                        ]
                    }
