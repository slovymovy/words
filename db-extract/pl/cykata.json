                                    {
                                        "sense_id": "0fd3d732-34ac-3799-83ce-5141272e63e1",
                                        "entry_id": "e6684579-59f4-3b23-80e0-d4a916a082cc",
                                        "glosses": [
                                            "Candied citrus peel (or, less commonly, other preserves)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfcfd42-269f-4892-bc9d-4186d02c9d76",
                                                "sense_id": "0fd3d732-34ac-3799-83ce-5141272e63e1",
                                                "text": "He rootes of Borage and Buglosse soden tender , and made in a succade , doth ingender good blode"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb49449-3edc-3f03-b803-76649aef4ae1",
                                        "entry_id": "e6684579-59f4-3b23-80e0-d4a916a082cc",
                                        "glosses": [
                                            "A sweetmeat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1356d66-002e-4ba1-981c-bd59272ecbe0",
                                                "sense_id": "efb49449-3edc-3f03-b803-76649aef4ae1",
                                                "text": "I found two Pots of very good Succades, or Sweet-meats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2782f7d-4b60-4c97-b7a5-a2ad65b5713d",
                        "source_entry_id": "6a39b074-0d5d-38b3-991f-c548177c7ce9",
                        "source_sense_id": "043b050f-9439-340a-99a9-0ee65d603902",
                        "target_lang_word": "Sukkade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sukkade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                        "entry_id": "2ab64b64-1e19-3c83-86dc-247814737ad0",
                                        "glosses": [
                                            "in Zucker gelegte/kandierte, gewürfelte Schale einer Zitrusfrucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebaee99-7861-438b-bddc-929b70f702e2",
                                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                                "text": "„Stinknormaler Rosinenkuchen wäre genießbar gewesen, aber mit Sukkade darin mochte ich ihn noch nie.“"
                                            },
                                            {
                                                "example_id": "46c8b260-d18b-460c-837d-70ec8bef3113",
                                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                                "text": "„Alois trabte mit einem riesigen Napfkuchen herbei, der gespickt war mit Rosinen, Mandeln und grüner Sukkade.“"
                                            },
                                            {
                                                "example_id": "b0a57ac2-7a02-48b4-bd31-1de42b8f5896",
                                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                                "text": "„Bekanntlich ist in einer Reihe von Ländern die Herstellung von Sukkaden (kandierte Zitrusfrüchte) gut organisiert. In unserer Industrie fand dies zunächst nicht die erforderliche Entwicklung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb6b1051-7441-4c39-a6fe-21142295f6be",
                        "source_entry_id": "6a39b074-0d5d-38b3-991f-c548177c7ce9",
