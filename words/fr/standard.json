                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons choisi une porte de dimension <w>standard</w> pour limiter les frais de rénovation."
                        },
                        {
                            "text": "Les chambres de cet hôtel sont toutes <w>standards</w> et disposent du même équipement moderne."
                        }
                    ],
                    "synonyms": [
