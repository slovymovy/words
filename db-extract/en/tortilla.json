                                                "sense_id": "ca4cc933-5788-3b19-bc64-7aa65838f6b2",
                                                "text": "Tortillas werden gerne mit Hackfleisch und anderen Zutaten gefüllt."
                                            },
                                            {
                                                "example_id": "e8c7a5c8-6061-4fb8-a971-e7e216795529",
                                                "sense_id": "ca4cc933-5788-3b19-bc64-7aa65838f6b2",
                                                "text": "„Eine Frau brachte ihnen angekokelte Tortillas auf einer Platte aus ungebranntem Ton, dazu Schüsseln mit Bohnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6a53f89-1c0d-323b-8a1f-a3fd49eff4eb",
                                        "entry_id": "d84eb6ff-4c1c-3836-b763-4422da4e3af0",
                                        "glosses": [
                                            "einem Omelett ähnliche Eierspeise"
                                        ],
                                        "tags": [
                                            "Spanien"
                                        ],
                                        "examples": [
                                            {
