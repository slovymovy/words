                ],
                "translations": [
                    {
                        "translation_id": "54a556ba-6ea0-4732-b376-630b2c98b460",
                        "source_entry_id": "dc4ee6eb-1c54-35c4-b789-49cc45e41b2c",
                        "source_sense_id": "d86c51e1-47d6-3cac-b693-11ba02526ab2",
                        "target_lang_word": "крышка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крышка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5f10b37a-ac11-375d-a7b0-cbb430383bf1",
                                        "entry_id": "54920b7b-be2b-34a5-b687-2ce6935bec78",
                                        "glosses": [
                                            "верхняя часть какого-либо сосуда, ящика и т. п., закрывающая его"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaceff6d-26d4-4399-874c-d7122d44c83b",
                                                "sense_id": "5f10b37a-ac11-375d-a7b0-cbb430383bf1",
                                                "text": "Вдруг… среди тишины… с треском лопнула железная крышка гроба, и поднялся мертвец."
                                            },
                                            {
                                                "example_id": "0757e2c8-3350-49dd-8c17-94e6f9fcd209",
                                                "sense_id": "5f10b37a-ac11-375d-a7b0-cbb430383bf1",
                                                "text": "Крышка на чайнике начала подпрыгивать."
                                            },
                                            {
                                                "example_id": "c02c1570-ea27-4848-b25f-5bb50b0dc2e4",
                                                "sense_id": "5f10b37a-ac11-375d-a7b0-cbb430383bf1",
                                                "text": "Вся крышка сундука залеплена картинками с изображениями святых отцов."
                                            },
                                            {
                                                "example_id": "616c7e33-089c-4df8-9fc0-7875edaed28f",
                                                "sense_id": "5f10b37a-ac11-375d-a7b0-cbb430383bf1",
                                                "text": "С пушечным выстрелом захлопнулась крышка рояля."
                                            },
                                            {
                                                "example_id": "47131f51-7d39-4663-bc52-73a57b10e4b8",
                                                "sense_id": "5f10b37a-ac11-375d-a7b0-cbb430383bf1",
                                                "text": "Кастрюля (в ней и готовится пища) закрывается крышкой, с внутренней стороны которой расположены электронагреватель (ТЭН) и вентилятор, а с внешней — панель управления для выбора режима приготовления."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66b0435-64f2-36c2-bec3-606238a0af64",
                                        "entry_id": "54920b7b-be2b-34a5-b687-2ce6935bec78",
                                        "glosses": [
                                            "о верхней части, покрывающей основание какого-либо предмета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fee16c-6db8-4166-ab29-463281c7418d",
                                                "sense_id": "a66b0435-64f2-36c2-bec3-606238a0af64",
                                                "text": "Не заперт погреб. Крышку приподнял, ёжась спустился по лестнице."
                                            },
                                            {
                                                "example_id": "e99cfbb3-0032-4e6e-9614-2e1c1801045f",
                                                "sense_id": "a66b0435-64f2-36c2-bec3-606238a0af64",
                                                "text": "Крепится соковыжималка к крышке стола или к доске прижимным винтом 11."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d644446b-3d4b-33c6-a09d-e7390752651f",
                                        "entry_id": "54920b7b-be2b-34a5-b687-2ce6935bec78",
                                        "glosses": [
                                            "предик. разг. гибель, конец"
                                        ],
                                        "tags": [
                                            "неизм."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ef1cc1-eb3b-4f2e-b83b-7580dec6d1a2",
                                                "sense_id": "d644446b-3d4b-33c6-a09d-e7390752651f",
                                                "text": "— Послушайте, — взволнованно сказал инвалид, — говорят, есть какая-то надежда? — А мы думали всё, крышка! — пробасил верзила."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
