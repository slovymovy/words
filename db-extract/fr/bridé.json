                        "tags": [
                            "of an eye"
                        ],
                        "examples": [
                            {
                                "example_id": "229362c5-ae84-4aa6-a944-677c2ea85da2",
                                "sense_id": "acb81a37-9a96-3b70-8471-6fe3f4966123",
                                "text": "11 février 2015, Pierre Joo, La Règle du jeu, \"Identité coréenne\"",
                                "translation": "I am grateful that France accepts me as one of its own because I went to the school of the Republic and, in spite of my Asian eyes, I love its land.",
                                "english": "I am grateful that France accepts me as one of its own because I went to the school of the Republic and, in spite of my Asian eyes, I love its land."
                            },
                            {
                                "example_id": "07a1bea3-9718-476c-a9c0-04adeddbe162",
                                "sense_id": "acb81a37-9a96-3b70-8471-6fe3f4966123",
                                "text": "3 avril 2020, France Info, \"Miss France : comment les candidates noires, arabes ou asiatiques ont vécu leur sacre\"",
                                "translation": "On LCI, Evelyne de Larichaudy explains that she uses her \"Asian eyes\" as her \"little extra\".",
                                "english": "On LCI, Evelyne de Larichaudy explains that she uses her \"Asian eyes\" as her \"little extra\"."
                            }
                        ]
                    }
                ],
