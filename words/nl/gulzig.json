{
    "word_family": [
        "gulzigheid",
        "gulziglijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6012010-dd93-35d2-a448-2dcdbd97032b",
                    "sense_definition": "Met overmatige en haastige verlangen veel willen eten of drinken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gulzige</w> hond at zijn voer binnen enkele seconden helemaal op. Nederlandse honden zijn vaak erg enthousiast.",
                            "target_lang_translations": {
                                "en": "The <w>greedy</w> dog ate all of his food within a few seconds. Dutch dogs are often very enthusiastic."
                            }
                        },
                        {
                            "text": "Na de lange fietstocht nam hij een paar <w>gulzige</w> slokken water uit zijn fles.",
                            "target_lang_translations": {
                                "en": "After the long bike ride he took a few <w>greedy</w> gulps of water from his bottle."
                            }
                        }
                    ],
                    "synonyms": [
                        "gretig",
                        "schrokkerig",
                        "vraatzuchtig"
                    ],
                    "common_phrases": [
                        "gulzige slokken"
                    ],
                    "target_lang_definitions": {
                        "en": "Desiring to eat or drink a lot with excessive and hasty desire."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "greedy",
                                "target_lang_sense_clarification": "eating or drinking excessively"
                            },
                            {
                                "target_lang_word": "gluttonous",
                                "target_lang_sense_clarification": "excessively greedy with food"
                            },
                            {
                                "target_lang_word": "voracious",
                                "target_lang_sense_clarification": "wanting or devouring great quantities of food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3a3d14a-c43a-3583-b1ee-3a4ca4970387",
                    "sense_definition": "Sterk verlangend naar meer bezit, geld of succes dan nodig is.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gulzige</w> zakenman wilde al het geld voor zichzelf houden.",
                            "target_lang_translations": {
                                "en": "The <w>greedy</w> businessman wanted to keep all the money for himself."
                            }
                        },
                        {
                            "text": "Zij keken met <w>gulzige</w> ogen naar de grote stapel cadeaus op de tafel.",
                            "target_lang_translations": {
                                "en": "They looked with <w>greedy</w> eyes at the large pile of presents on the table."
                            }
                        }
                    ],
                    "synonyms": [
                        "gretig"
                    ],
                    "common_phrases": [
                        "gulzige ogen"
                    ],
                    "target_lang_definitions": {
                        "en": "Strongly desiring more possessions, money, or success than is necessary."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "greedy",
                                "target_lang_sense_clarification": "desiring wealth or possessions excessively"
                            },
                            {
                                "target_lang_word": "covetous",
                                "target_lang_sense_clarification": "having a strong desire for riches or property"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8e0e90f8-a20e-35f9-a7fb-cb760ed8e70a",
                    "sense_definition": "Op een schrokkerige of overmatig haastige manier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij at het lekkere gebakje <w>gulzig</w> op voordat iemand anders het kon vragen.",
                            "target_lang_translations": {
                                "en": "He ate the tasty pastry <w>greedily</w> before anyone else could ask for it."
                            }
                        },
                        {
                            "text": "De kinderen begonnen direct <w>gulzig</w> aan de warme maaltijd te eten.",
                            "target_lang_translations": {
                                "en": "The children immediately began eating the hot meal <w>greedily</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gulzig eten"
                    ],
                    "target_lang_definitions": {
                        "en": "In a gluttonous or excessively hasty manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "greedily",
                                "target_lang_sense_clarification": "eating or taking in a hasty, eager manner"
                            },
                            {
                                "target_lang_word": "voraciously",
                                "target_lang_sense_clarification": "devouring in large amounts or eagerly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}