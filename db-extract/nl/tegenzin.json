        "nl-extract.jsonl": [
            {
                "entry_id": "943db151-d3f3-32f5-8e6b-f138575b70d9",
                "word": "tegenzin",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                        "entry_id": "943db151-d3f3-32f5-8e6b-f138575b70d9",
                        "glosses": [
                            "het geen zin hebben in iets, het iets niet willen doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5251df3-a346-42fb-a68a-36c179c64409",
                                "sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                                "text": "Het was met grote tegenzin dat ze na de vakantie weer naar huis gingen."
                            },
                            {
                                "example_id": "05c4e2da-836a-4210-96e0-e20d1137b3d9",
                                "sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                                "text": "Ze had een hautaine, zowel gekwetste als neerbuigende blik, alsof ze een dichteres was die zich met tegenzin onder het ongevoelige gepeupel begaf. `Frarwaise; fluisterde de grote Griek en hij keek mij aan met een veelbetekenende blik, waarvan ik niet goed wist wat die betekende."
                            },
                            {
                                "example_id": "924aecf5-568c-4e36-85c9-cf602eb04d9f",
                                "sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                                "text": "'Maar ik hoop toch echt dat u me wat over dat muiltje wilt vertellen,'zei hij, mijn tegenzin negerend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d67af56-5062-4094-b6b2-7033e5fe21a4",
                        "source_entry_id": "943db151-d3f3-32f5-8e6b-f138575b70d9",
                        "source_sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                        "source_sense_description": "het geen zin hebben in iets",
                        "target_lang_word": "Abneigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abneigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                        "entry_id": "6bc95e84-9464-31ba-b609-95a693d2ee47",
                                        "glosses": [
                                            "leichter Widerwille gegen etwas oder eine Person, oft ohne das genau begründen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "007e3645-b387-4017-8f48-a553e18fcbc3",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung der Polen gegen ihre Neureichen steht der der Westeuropäer in nichts nach.“"
                                            },
                                            {
                                                "example_id": "9e908d4a-da7f-44fc-92d3-6dc694654ec1",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "Ich hatte sofort eine Abneigung gegen den neuen Mitschüler, obwohl er mir angeboten hatte, mir bei den Hausaufgaben zu helfen."
                                            },
                                            {
                                                "example_id": "1e632a8c-d46a-4e41-93fd-f561aec769d6",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Daher waren Christenfeinde in der frühen Kaiserzeit weniger von Hass gegen die neue Lehre erfüllt; ihre Abneigung entsprang vielmehr ihrer affirmativen Haltung zum Imperium.“"
                                            },
                                            {
                                                "example_id": "ae6664e8-23bf-4e40-9bf1-6dfe833af7af",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung gegen alles Nützliche verdichtete sich von Tag zu Tag.“"
                                            },
                                            {
                                                "example_id": "2222c42d-22a3-4082-80dc-1e21e8fa2f1e",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Vom ersten Augenblick des Kennenlernens an faßte er gegen diesen glatten Hübschling Abneigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ace11cc8-b873-4ded-a6c7-c9aa23f14ed5",
                        "source_entry_id": "943db151-d3f3-32f5-8e6b-f138575b70d9",
                        "source_sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                        "source_sense_description": "het geen zin hebben in iets",
                        "target_lang_word": "Widerwille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerwille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                        "entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                                        "glosses": [
                                            "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e41a167-d759-42fb-9fe4-0efe9d2dd08b",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„In diesem Augenblick fühlte er nichts anderes als einen unbestimmten Zorn, einen tiefen Widerwillen und den Beginn einer grenzenlosen Hoffnungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "4683c385-5f0b-40c3-ba52-8b951cdf2261",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„Sie hatte sich bei der Arbeit niemals wohl gefühlt, aber jetzt trat zum Unbehagen plötzlich noch Widerwille hinzu.“"
                                            },
                                            {
                                                "example_id": "743e4064-8626-4897-a82e-44f12cf8a682",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„Aber gerade in diesem Widerwillen gegen alles fand Pierre einen seltsam erregenden Reiz.“"
                                            },
                                            {
                                                "example_id": "097630bc-a125-4db5-8669-2ddd5a23adf9",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„Ich tat es mit Widerwillen und stand Höllenqualen aus, nicht aus Verlangen, an seine Stelle zu treten, denn bei mir rührte sich nichts, sondern aus Wut darüber, daß sich eine so schöne Frau einem Mann hingab, der seinen einzigen Vorzug mit dem Esel gemeinsam hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab500728-6a33-4cd9-b21d-3fe449b7d5f2",
                        "source_entry_id": "943db151-d3f3-32f5-8e6b-f138575b70d9",
                        "source_sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                        "source_sense_description": "het geen zin hebben in iets",
                        "target_lang_word": "reluctance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reluctance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b53d575b-2a45-367f-ba17-78c0ad0334d6",
                                        "entry_id": "2fe9c340-bf03-32ae-b949-77bc6a77710a",
                                        "glosses": [
                                            "Unwillingness to do something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b1b00e-20f9-4cfb-8b42-aedc958da58d",
                                                "sense_id": "b53d575b-2a45-367f-ba17-78c0ad0334d6",
                                                "text": "Our new dog shows reluctance to go on walks, preferring to be indoors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af6e6dcb-6cca-359f-b153-0ec87d64d6c4",
                                        "entry_id": "2fe9c340-bf03-32ae-b949-77bc6a77710a",
                                        "glosses": [
                                            "Hesitancy in taking some action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "375a1ffe-ffac-39fc-b665-b33b7dc10df8",
                                        "entry_id": "2fe9c340-bf03-32ae-b949-77bc6a77710a",
                                        "glosses": [
                                            "Defiance, disobedience."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "704eb547-1109-4bc5-abd7-d5a4b44e5a62",
                                                "sense_id": "375a1ffe-ffac-39fc-b665-b33b7dc10df8",
                                                "text": "No more be mention’d then of violence / Against our selves, and wilful barrenness, / That cuts us off fom hope, and favours onely / Rancor and pride, impatience and despite, / Reluctance against God and his just yoke / Laid on our Necks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd31a16c-2cb1-3a6f-ae7a-9e92ccf5398f",
                                        "entry_id": "2fe9c340-bf03-32ae-b949-77bc6a77710a",
                                        "glosses": [
                                            "That property of a magnetic circuit analogous to resistance in an electric circuit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cc2905f-576a-4c5d-813b-fba3a6f6e879",
                                                "sense_id": "cd31a16c-2cb1-3a6f-ae7a-9e92ccf5398f",
                                                "text": "That is to say, the total number of ampere-hours, including the drop of gilbertage, due to magnetic flux traversing the reluctance of the circuit, must be equal to zero."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b23a4d05-61a2-4739-bdb1-dfd200e4067c",
                        "source_entry_id": "943db151-d3f3-32f5-8e6b-f138575b70d9",
                        "source_sense_id": "b0354485-3e6e-3fde-bebb-a0e59b4669db",
                        "source_sense_description": "het geen zin hebben in iets",
                        "target_lang_word": "répugnance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répugnance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                        "entry_id": "f78927c8-aca3-3f12-85f1-320fcf12b9fc",
                                        "glosses": [
                                            "Opposition naturelle, éloignement ou répulsion pour quelqu’un ou pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743684c0-c589-4226-a0d4-5dd99093d3bd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Alors Athos tira de sa poche un petit papier sur lequel étaient écrites deux lignes accompagnées d’une signature et d’un sceau, et le présenta à celui qui donnait trop prématurément ces signes de répugnance."
                                            },
                                            {
                                                "example_id": "0000f741-1e5c-4492-b10a-20e8145feddd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Ce fut donc le clergé qui, à Plassans, mena la réaction. La noblesse devint son prête-nom, rien de plus ; il se cacha derrière elle, il la gourmanda, la dirigea, parvint même à lui rendre une vie factice. Quand il l’eut amenée à vaincre ses répugnances au point de faire cause commune avec la bourgeoisie, il se crut certain de la victoire."
                                            },
                                            {
                                                "example_id": "bcbfb70a-38fe-44b1-a0b0-b4a0742b2caa",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "L’iguane est un plat médiocre, disent les uns, cela sent le reptile. Mais si l'on peut vaincre sa répugnance, cela constitue un plat de résistance et qui vaut bien le singe rouge. Quant à moi, j'en suis très friand ; […]."
                                            },
                                            {
                                                "example_id": "a3dffe78-fedb-4abf-8145-0033419d4024",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Il est vrai, […], que le juifs, plus versés que les prêtres chrétiens dans la connaissance des Écritures, étaient de redoutables controversistes, à ce point que Saint Louis manifesta sa répugnance pour les discussions entre les juifs et les chrétiens insuffisamment instruits : […]."
                                            },
                                            {
                                                "example_id": "d45a7b05-e12a-41fd-a1a5-8660ca6455b0",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Sa nuit de noce n'avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            },
                                            {
                                                "example_id": "e7c6a1b3-82a1-4914-8204-6555e31967be",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Un problème d’incontinence peut ne pas être reconnu étant donné la répugnance de la personne à parler de quelque chose d’aussi privé et d’aussi intime que la fonction urinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
