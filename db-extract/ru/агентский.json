                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1471da12-9f7d-37f2-9c82-de04de9ad20a",
                                        "entry_id": "c260022f-e72f-304d-bb96-2114a30d0551",
                                        "glosses": [
                                            "Of or pertaining to an agent or an agency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f2ddd6-a827-4a30-ae73-a46dee2d1779",
                                                "sense_id": "1471da12-9f7d-37f2-9c82-de04de9ad20a",
                                                "text": "Becoming more aware of the progress that scientists have made on behavioral fronts can reduce the risk that other natural scientists will resort to mystical agential accounts when they exceed the limits of their own disciplinary training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa080c5-24fa-3d2a-87cd-417a8908a5b9",
                                        "entry_id": "c260022f-e72f-304d-bb96-2114a30d0551",
                                        "glosses": [
                                            "That forms agent nouns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d799eb96-7374-4fe4-a645-c5c3c6c45a6d",
                                                "sense_id": "1aa080c5-24fa-3d2a-87cd-417a8908a5b9",
                                                "text": "Even if the suffix be formally identical with the agential suffix, it has not the same function."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
