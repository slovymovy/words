                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "71a4596c-c835-4ad1-91fe-5fa79602cd5b",
                                "sense_id": "c7d4f6f0-96b8-3825-8341-3751aa54dd94",
                                "text": "Nach einem hässlichen Streit mit dem Damenkomitee der Philharmonic Society, die seine fürstlichen Gagen finanzierte, war der Tonkünstler Gustav Mahler mit Schüttelfrost in sein Hotel am Central Park zurückgekehrt."
                            },
                            {
                                "example_id": "3982158c-7fee-4435-b81d-0461ba5cc18b",
                                "sense_id": "c7d4f6f0-96b8-3825-8341-3751aa54dd94",
                                "text": "Just mit Beginn des 19. Jahrhunderts wird der Komponist vom \"Tonsetzer\" zum \"Tonkünstler\" oder \"Tondichter\" nobilitiert."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebb013b3-1d02-3092-9255-782fbc78ea1d",
