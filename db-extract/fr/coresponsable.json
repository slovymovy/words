                "senses": [
                    {
                        "sense_id": "1017a02d-b53c-3388-9b00-08024ab68571",
                        "entry_id": "84ad3161-3fc4-34bd-8dc9-38e8364b27df",
                        "glosses": [
                            "Qualité de répondre de ses actions, de celles des autres, ou d’en être garant, à même niveau qu’une autre personne, un autre groupe, une autre communauté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5475964f-c49e-436f-8fc6-fb404e47ad4f",
                                "sense_id": "1017a02d-b53c-3388-9b00-08024ab68571",
                                "text": "Nous sommes coresponsables, nous partageons les responsabilités, les engagements."
                            },
                            {
                                "example_id": "db649a54-8b52-4abe-b8c9-b053b4644a1c",
                                "sense_id": "1017a02d-b53c-3388-9b00-08024ab68571",
                                "text": "Les parents sont coresponsables, ils garantissent à deux à leur enfant le respect de son droit et de ses besoins."
                            },
                            {
                                "example_id": "e279e635-ae62-465a-b564-254893518237",
                                "sense_id": "1017a02d-b53c-3388-9b00-08024ab68571",
                                "text": "La coresponsabilité est l’ensemble des actes posés par deux entités coresponsables."
                            }
                        ]
                    }
                ],
