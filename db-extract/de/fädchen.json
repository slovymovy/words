                        "examples": [
                            {
                                "example_id": "3c9cfe9b-0f2e-43d2-b386-773eaed31360",
                                "sense_id": "988f988b-e0b9-336a-8599-a22c0ee1e74c",
                                "text": "„Als sein Blick auf ein rotes Fädchen fiel, das noch von dem Zeichen am Stoffe hing, lief ein Zucken um seine Mundwinkel, als hätte er auf eine bittere Frucht gebissen.“"
                            },
                            {
                                "example_id": "8503dfec-5c6f-4048-be09-03a0ce41d131",
                                "sense_id": "988f988b-e0b9-336a-8599-a22c0ee1e74c",
                                "text": "„Der Geschäftsführer stäubte mit dem Fingernagel ein Fädchen von seinem Ärmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
