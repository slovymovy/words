                "senses": [
                    {
                        "sense_id": "dc2d8fd2-c3a2-3640-ba27-706936ecb4fe",
                        "entry_id": "05f99bc1-83b6-3eeb-983d-752b6fd4798b",
                        "glosses": [
                            "разг. человек или животное с короткими ногами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8efca2a6-823b-4f39-8fc8-b0f8adc1c162",
                                "sense_id": "dc2d8fd2-c3a2-3640-ba27-706936ecb4fe",
                                "text": "Сорокалетняя вдова какого-то подпоручика, коротконожка, короткоручка, с подмазанными дряблыми щеками."
                            },
                            {
                                "example_id": "208a9220-618e-4572-8250-8180bc2bdcb7",
                                "sense_id": "dc2d8fd2-c3a2-3640-ba27-706936ecb4fe",
                                "text": "Он был коротконожка, румяный, с крепким, моложавым лицом, волосы подстрижены бобриком, совсем седые."
                            }
                        ]
                    }
