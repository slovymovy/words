        "ru-extract.jsonl": [
            {
                "entry_id": "c443f5b7-f7d4-32f5-b1b1-67f62400f13b",
                "word": "втихаря",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "161bd282-ebdc-35de-8fac-1e46ec8f662f",
                        "entry_id": "c443f5b7-f7d4-32f5-b1b1-67f62400f13b",
                        "glosses": [
                            "разг., сниж. никому ничего не говоря"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c6ae57-9d16-4786-9659-2ed9cbcc9035",
                                "sense_id": "161bd282-ebdc-35de-8fac-1e46ec8f662f",
                                "text": "А вернулся домой, взял втихаря деньги и сбежал в город."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1f5034e-cedf-383d-81f7-fd2601a0f74d",
                        "entry_id": "c443f5b7-f7d4-32f5-b1b1-67f62400f13b",
                        "glosses": [
                            "перен., разг., сниж. тайком, втайне, скрытно, незаметно от кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a362d54-a3f9-43cb-abe1-42818c9a357c",
                                "sense_id": "e1f5034e-cedf-383d-81f7-fd2601a0f74d",
                                "text": "— Теперь, которые прочие, слухай. Главное, — втихаря, потаюхой."
                            },
                            {
                                "example_id": "016acf3c-9957-4966-9a95-dbb125680fd1",
                                "sense_id": "e1f5034e-cedf-383d-81f7-fd2601a0f74d",
                                "text": "Всё равно же приносят и распивают, только не честь по чести, а вытащат из-под полы и разливают втихаря под столиком, как будто контрабанду пьют или краденое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d36a4492-4628-456c-b3b2-292362fde6d4",
                        "source_entry_id": "c443f5b7-f7d4-32f5-b1b1-67f62400f13b",
                        "source_sense_description": "никому ничего не говоря",
                        "target_lang_word": "heimlich, still und leise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
