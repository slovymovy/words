            "senses": [
                {
                    "sense_id": "ef1bd376-f81e-3d38-bbc8-fd69c16f38a2",
                    "sense_definition": "Een jongen of jongeman, vaak in de tienerleeftijd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge <knaap> fietste snel naar school om niet te laat te komen.",
                            "target_lang_translations": {
                                "en": "The young <w>lad</w> cycled quickly to school so as not to be late.",
                                "ru": "Молодой <w>парнишка</w> быстро ехал на велосипеде в школу, чтобы не опоздать.",
                                "fr": "Le jeune <w>garçon</w> pédalait rapidement vers l'école pour ne pas être en retard."
                            }
                        },
                        {
                            "text": "Die twee <knapen> hebben gisteren de hele middag buiten gespeeld.",
                            "target_lang_translations": {
                                "en": "Those two <w>boys</w> played outside all afternoon yesterday.",
                                "ru": "Те два <w>парня</w> вчера весь день играли на улице.",
                                "fr": "Ces deux <w>gamins</w> ont joué dehors tout l'après-midi hier."
                            }
                        }
                    ],
                    "synonyms": [
                        "jongen",
                        "knul"
                    ],
                    "common_phrases": [
                        "jonge knaap",
                        "stoere knaap"
                    ],
                    "target_lang_definitions": {
                        "en": "A boy or young man, often in his teenage years.",
                        "ru": "Мальчик или молодой человек, часто подросткового возраста.",
                        "fr": "Un garçon ou un jeune homme, souvent à l'adolescence."
                    },
                    "translations": {
