                ],
                "senses": [
                    {
                        "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                        "entry_id": "66cc3fca-1edb-3419-b3b8-9c344c0c1fc3",
                        "glosses": [
                            "Unternehmen, das Erdöl fördert und verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c483a1c3-8e31-490c-b9c0-402e9c43702e",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Wussten Sie, dass die Erdölfirmen den Klimawandel leugneten, obwohl ihre eigenen Wissenschaftler ihn exakt berechnet hatten?“"
                            },
                            {
                                "example_id": "e05ba54a-5cca-4e2a-b795-74fcff33bc1e",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Die Erdölfirmen folgten damit dem Modell der Tabakindustrie, die jahrzehntelang behauptete, Rauchen verursache keinen Lungenkrebs.“"
                            },
                            {
                                "example_id": "0e355346-3832-4f61-90d5-57f247401c2b",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Damit retteten die Erdölfirmen ihr Geschäftsmodell: An der Durchsetzung von Umweltnormen verdient niemand, an ihrer Verschleppung jedoch sehr wohl.“"
                            },
                            {
                                "example_id": "f35a312c-4a80-4eef-8e07-0760a0ccb80d",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„2014 wurde die Korruptionsaffäre um die halbstaatliche Erdölfirma Petrobras von den Untersuchungsbehörden aufgerollt“ […]."
                            },
                            {
                                "example_id": "23f55b08-f93e-4cdd-9a40-8913482aae5c",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„2015 wurden 23 Ölquellen entdeckt und eine Förderung für Ende 2016 avisiert. Die staatliche nigerianische Erdölfirma NNPC wiederholt nun in regelmäßigen Abständen, dass die Förderung demnächst aufgenommen werde.“"
                            },
                            {
                                "example_id": "da697f4c-2301-4746-8067-15ea12833025",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Doch die staatliche venezolanische Erdölfirma PDVSA ist so marode, dass das Land vor einigen Wochen sogar Öl importieren musste, zum ersten Mal in seiner Geschichte.“"
                            },
                            {
                                "example_id": "c22f7f10-3289-4dc0-9bf9-efccaecd0742",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Am Mittwoch ging die 28. Weltklimakonferenz in den Vereinigten Arabischen Emiraten zu Ende. Geleitet hat sie ausgerechnet der Chef einer Erdölfirma, Sultan al-Jaber.“"
                            },
                            {
                                "example_id": "c99d37eb-15f9-4f18-9c24-20154a07f2ea",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Aserbaidschans Umweltminister Muchtar Babajew machte einst Karriere in Aserbaidschans staatlicher Erdölfirma SOCAR. Jetzt wird er Präsident der COP29.“"
                            },
                            {
                                "example_id": "1f8bac18-2fff-48f5-8109-c87b3145042a",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Viele der an Leukämie erkrankten Dorfbewohner leben oder lebten in der Nähe eines ehemaligen Betriebsplatzes der Erdölfirma BEB Erdgas und Erdöl GmbH & Co. Nachfolgeunternehmen ist heute ExxonMobil.“"
                            },
                            {
                                "example_id": "bfeb3246-41f1-4c64-ac7e-cbe5e7fe52d6",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Französische Konzerne, wie der Atomkonzern Areva, die Erdölfirma Total oder der Telekom-Konzern Orange, hatten und haben noch immer großen Einfluss in den ehemaligen Kolonien.“"
                            },
                            {
                                "example_id": "8233f147-f858-4294-94eb-0f3e46f72b4d",
                                "sense_id": "d885e488-a77e-3624-99d6-484232021df2",
                                "text": "„Er war ein erfahrener Tiefseetaucher und arbeitete auf Bohrinseln für Erdölfirmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
