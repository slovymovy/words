                    },
                    {
                        "translation_id": "e8c4b9c7-b818-4621-8be5-7e6b954df1fb",
                        "source_entry_id": "289d804c-c3b2-3a47-9715-828e224ad7be",
                        "source_sense_id": "3b9a3197-1f75-3aa3-84e9-36e06dda7f34",
                        "target_lang_word": "Prosaschriftsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prosaschriftsteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                        "entry_id": "e2319528-c181-342a-bc30-b7e9a727c971",
                                        "glosses": [
                                            "Schriftsteller, der seine Werke bevorzugt in Prosa verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd29eb0-0ad3-4e73-93d8-ff249482206a",
                                                "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                                "text": "„Pückler ist ein glänzender Beobachter, was ihn zum vorzüglichen Prosaschriftsteller macht.“"
                                            },
                                            {
                                                "example_id": "b38e9966-6a17-4e60-9ee2-d0a3cec1280a",
                                                "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                                "text": "„Im Prinzip gleich zu lesen sind die Kurvenbilder der Philosophen und der Prosaschriftsteller.“"
                                            },
                                            {
                                                "example_id": "ebaf8c61-342e-4c2e-a81d-248eb2ba7c89",
                                                "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                                "text": "„Immer wieder setzte er sich tatkräftig für Dichter, Maler, Bildhauer und Prosaschriftsteller ein, an die er glaubte, und half allen, die in Schwierigkeiten waren, ob er an sie glaubte oder nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5658112-b32e-4850-8ddb-fb1e3cfb00c9",
                        "source_entry_id": "289d804c-c3b2-3a47-9715-828e224ad7be",
                        "source_sense_id": "3b9a3197-1f75-3aa3-84e9-36e06dda7f34",
                        "target_lang_word": "prozaïst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prozaïst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5fec8ce9-a869-3491-b250-4e27408c66a4",
                                        "entry_id": "e7c2036c-669d-33e4-a596-621a81318a22",
                                        "glosses": [
                                            "schrijver van proza"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "479acd8d-3404-49bb-9bc8-992f9205620f",
                                                "sense_id": "5fec8ce9-a869-3491-b250-4e27408c66a4",
                                                "text": "De bekende Haagse dichter en prozaïst Adriaan Bontebal is in de nacht van vrijdag op zaterdag overleden, zo meldt Omroep West. De dichter was 59 jaar."
                                            },
                                            {
                                                "example_id": "26814889-c30d-4a7e-9c17-0dd2cb643f69",
                                                "sense_id": "5fec8ce9-a869-3491-b250-4e27408c66a4",
                                                "text": "Herman Hendrik ter Balkt, geboren in Usselo in 1938, was ook prozaïst, toneelschrijver en vertaler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78e2a8c5-55fa-4cb0-b829-8a1e3dcf26c6",
                        "source_entry_id": "289d804c-c3b2-3a47-9715-828e224ad7be",
