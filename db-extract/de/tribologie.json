                        "glosses": [
                            "interdisziplinäres Fachgebiet zur Erforschung von Wirkflächen in Relativbewegung (Reibungsphänomene)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecea644-3e77-4f24-8a43-d6b5637fedc1",
                                "sense_id": "bf082f91-d04f-38d5-afe3-515207ee5f25",
                                "text": "„Die Anwendung der Tribologie in der Technik erstreckt sich auf alle Bereiche der Entwicklung, Konstruktion, Fertigung und Instandhaltung mechanischer Bewegungssysteme in den verschiedenen Industriezweigen und Wirtschaftsbereichen, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
