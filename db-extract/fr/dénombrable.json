                "senses": [
                    {
                        "sense_id": "10068b09-e73e-39b9-99fb-a6b7876fa85e",
                        "entry_id": "9c30c9d6-a2ec-3f1f-9448-b244b1922ad2",
                        "glosses": [
                            "Que l’on peut compter, dénombrer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ed069941-4f70-3748-b5b5-d60abaebce08",
                        "entry_id": "9c30c9d6-a2ec-3f1f-9448-b244b1922ad2",
                        "glosses": [
                            "Se dit d’un ensemble infini qui peut être mis en relation bijective avec l’ensemble des nombres entiers naturels. Se dit parfois également d'un ensemble fini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a575c45-b588-4422-9a0d-a9bb50dfaf7a",
                                "sense_id": "ed069941-4f70-3748-b5b5-d60abaebce08",
                                "text": "Le fait qu'un ensemble soit dénombrable ne signifie pas forcément qu'on puisse en compter tous les éléments, ni en terminer le décompte. L'ensemble N des nombres entiers naturels, quoique dénombrable, n'en est pas moins infini : on peut compter ses éléments — il n'est donc pas “innombrable” ni indénombrable comme l'ensemble R des nombres réels — mais ce dénombrement n'a pas de fin."
                            }
                        ]
                    }
                ],
