                ],
                "senses": [
                    {
                        "sense_id": "f26598dc-b47d-3cc3-9e36-bed808eec202",
                        "entry_id": "b84a0d89-b056-38a0-a855-9a238867c9dd",
                        "glosses": [
                            "Teleskop, das im Weltraum stationiert wurde um seine Beobachtungen ohne Störungen durch die Erdatmosphäre durchführen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f71864-d679-4ab6-b821-860ae93e2cff",
                                "sense_id": "f26598dc-b47d-3cc3-9e36-bed808eec202",
                                "text": "„Vier Jahre lang starrte das Weltraumteleskop Kepler in den Himmel, rund 150.000 Sterne wanderten seit 2009 durch sein Blickfeld.“"
                            },
                            {
                                "example_id": "f795dcd2-cc2f-4379-adda-f3c0c71a23fb",
                                "sense_id": "f26598dc-b47d-3cc3-9e36-bed808eec202",
                                "text": "„Es ist etwa so groß wie eine Telefonzelle und sieht eher unscheinbar aus: das neue \"Superauge\" für den Nachfolger des Weltraumteleskops \"Hubble\".“"
                            },
                            {
                                "example_id": "1a2aee03-4873-4c79-b9a2-e8b751a3f957",
                                "sense_id": "f26598dc-b47d-3cc3-9e36-bed808eec202",
                                "text": "„Mit dem Weltraumteleskop Hubble haben die Astronomen die zentrale Region des Krebsnebels um den rotierenden Neutronenstern - hier der rechte der beiden Sterne nahe der Bildmitte - immer wieder ins Visier genommen und in verschiedenen Wellenlängenbereichen fotografiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
