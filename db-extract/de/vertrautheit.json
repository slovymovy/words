                        "form": "der Vertrautheit"
                    },
                    {
                        "form_id": "2886b956-d974-4329-b876-5dc8adcd3200",
                        "entry_id": "b6c6d0f0-95ef-324c-b443-d6ae09b205b6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Vertrautheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                        "entry_id": "b6c6d0f0-95ef-324c-b443-d6ae09b205b6",
                        "glosses": [
                            "Befindlichkeit, die sich daraus ergibt, dass man sich mit etwas auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41fbc921-7990-4003-a3e2-9cf18a8fc518",
                                "sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                                "text": "„Über Nacht wurde ich aus der Vertrautheit des Dorfes in die Anonymität des Molochs entlassen.“"
                            },
                            {
                                "example_id": "9da684a3-a339-4619-913e-b64bb67d209d",
                                "sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                                "text": "„Meine Kriterien für die Aufnahme von Texten resultierten aus meiner Eigenschaft als Erzählforscher und einer durch Lehre und Forschung erzielten langen Vertrautheit mit den humoristischen Gattungen der Volksliteratur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                        "entry_id": "b6c6d0f0-95ef-324c-b443-d6ae09b205b6",
                        "glosses": [
                            "enge persönliche Beziehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4df783f-00f6-4dc0-b7e1-b4661c8a2ede",
                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                "text": "Ihre Vertrautheit ging so weit, dass sie sich ohne Worte verständigen konnten."
                            },
                            {
                                "example_id": "c19d4c30-abf1-44a4-8ed0-1c906c974e2c",
                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                "text": "„Schon bald bestand ein großes Gefühl der Vertrautheit zwischen Lothar und Geneviève.“"
                            },
                            {
                                "example_id": "05376f4b-9bc3-4d3b-92cc-16f40f2565d7",
                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                "text": "„Für mich persönlich war bislang das Knie einer Dame Gegenstand zarter Vertrautheit, und ich sehe allen modernen Umwälzungen auf diesem Gebiet mit größter Besorgnis entgegen.“"
                            },
                            {
                                "example_id": "c956eb8b-d906-405f-b948-0b6526a4153f",
                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                "text": "„Das wiederum setzt eigentlich nach alter Regel Vertrautheit voraus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72db7b6f-bf68-4b29-b556-062c1a61b0f0",
                        "source_entry_id": "b6c6d0f0-95ef-324c-b443-d6ae09b205b6",
                        "source_sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                        "source_sense_description": "Befindlichkeit, die sich daraus ergibt, dass man sich mit etwas auskennt",
                        "target_lang_word": "familiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "The state of being extremely friendly; intimacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f0d17c-ef13-4be7-a394-20a1f33e2916",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "It is also folly and injustice to deprive children[…]of their fathers familiaritie, and ever to shew them a surly, austere, grim, and disdainefull countenance, hoping thereby to keepe them in awfull feare and duteous obedience."
                                            },
                                            {
                                                "example_id": "33017085-5850-4476-b7b9-d10d253785c4",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "Do not keep familiarity with any but those, with whom you may improve your time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Undue intimacy; inappropriate informality, impertinence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c51bd8-d78f-4038-8cbb-c77a80483460",
                                                "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                                "text": "Murrel did not in the least object to being called a monkey, yet he always felt a slight distaste when Julian Archer called him one.[…]It had to do with a fine shade between familiarity and intimacy which men like Murrel are never ready to disregard, however ready they may be to black their faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1831a8ab-fa15-3e6b-ad73-7cec0ddae30c",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "An instance of familiar behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Close or habitual acquaintance with someone or something; understanding or recognition acquired from experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5d50aa-18f9-4532-b768-46d8774eff90",
                                                "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                                "text": "The objects around have been seen so often, that they have at last become, as it were, unseen; their familiarity does not carry us out of ourselves, for all their associations are our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
