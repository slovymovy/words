                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liste de lecture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12b63078-a584-3f9b-8fe3-f299e1f30d22",
                                        "entry_id": "8b762094-7541-3c84-b348-177734e5ad90",
                                        "glosses": [
                                            "Liste de morceaux de musique, ou de vidéos, qu’on peut écouter ou visionner dans l’ordre ou aléatoirement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e540ff0c-a0cb-4fbf-9932-b59614a734cc",
                                                "sense_id": "12b63078-a584-3f9b-8fe3-f299e1f30d22",
                                                "text": "La liste de lecture de Safari est une des fonctionnalités très appréciables des derniers iOS. Elle permet de remettre à plus tard la lecture d’une page web avec Safari."
                                            },
                                            {
                                                "example_id": "e339f80b-914c-4fa9-8c77-710db6a7bd2f",
                                                "sense_id": "12b63078-a584-3f9b-8fe3-f299e1f30d22",
                                                "text": "Sur la route, le temps prend une autre dimension. Imaginez un peu, le vent dans les cheveux et l’esprit des vacances qui vous porte loin, loin, loin… […] Voilà une petite sélection qui vous invitera à rouler jusqu’au bout de votre liste de lecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642472f0-296c-3615-8295-ff7995c73970",
                                        "entry_id": "8b762094-7541-3c84-b348-177734e5ad90",
                                        "glosses": [
                                            "Ensemble de morceaux de musique sélectionnés par une station de radio pour les diffuser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
