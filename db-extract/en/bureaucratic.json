                    }
                ],
                "senses": [
                    {
                        "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                        "entry_id": "75688055-0839-3f5a-8026-e638a1669d15",
                        "glosses": [
                            "Of or pertaining to bureaucracy or the actions of bureaucrats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acef5151-f851-430e-88ae-8e60e77a6edd",
                                "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                "text": "[T. E.] Lawrence said that in the end he felt himself to be fighting not for the imperial British but for the rebellious Arabs. All too often he conflicted with British bureaucratic fustiness."
                            },
                            {
                                "example_id": "42d68f74-b216-4f6a-b341-bdc282f0e3b9",
                                "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                "text": "European Union is legalistic, bureaucratic and runs by precedent."
                            },
                            {
                                "example_id": "9da9fdf1-ab64-4e9e-98eb-f22c0dc9efc7",
                                "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                "text": "“We aren’t just reducing bureaucratic sprawl. We are realigning the organization with its core mission and our new priorities in reversing the chronic disease epidemic,” Kennedy said on Thursday morning."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ddf45fe-b74d-4c53-a080-b4e926621890",
                        "source_entry_id": "75688055-0839-3f5a-8026-e638a1669d15",
                        "source_sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
