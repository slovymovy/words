        "fr-extract.jsonl": [
            {
                "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                "word": "caillasse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3a848e2c-41da-43b7-8057-6534cd9ae6ff",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "caillasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d741107a-07ac-32df-b51a-13d1fc757797",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "glosses": [
                            "Couche de marne caillouteuse que l’on trouve dans les carrières de pierres."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3889d4ea-82ea-391a-9e08-6516db55767f",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "glosses": [
                            "Pierre meulière cassée et utilisée entre autres pour l'empierrement des routes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e15a67b-a3ea-47f1-a620-a7b767d52b16",
                                "sense_id": "3889d4ea-82ea-391a-9e08-6516db55767f",
                                "text": "Les ombres barraient de raies noires le sol en plâtre sur lequel des caillasses scintillaient ainsi que des éclats d’assiettes."
                            },
                            {
                                "example_id": "30cf92a2-6f2b-4492-8f76-01e748b22803",
                                "sense_id": "3889d4ea-82ea-391a-9e08-6516db55767f",
                                "text": "Pinglet. — Tu veux que je mette de la pierre meulière pour supporter un édifice pareil ! Tu es fou.\nPaillardin. — Quoi, l’édifice… il ne dépasse pas les proportions ordinaires !… Qu’est-ce que tu veux donc mettre, toi ?\nPinglet. — Je ne sais pas, de la caillasse\nPaillardin, haussant les épaules. — Ah ! de la caillasse !… Comment feras-tu tenir le mortier, avec ta caillasse ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b885624-2a50-3a6b-b92e-3d0ebab9de66",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "glosses": [
                            "Amas de cailloux (au féminin)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3f111cab-e064-48fb-af79-2dcc24b48598",
                                "sense_id": "5b885624-2a50-3a6b-b92e-3d0ebab9de66",
                                "text": "Ils avaient tamisé du sable pour recueillir le plus fin qui servirait à faire le mortier. Les débris étaient retamisés sur un tamis aux mailles plus grosses qui laissaient passer les gravillons. Il ne restait plus que la caillasse qui servirait à faire le béton."
                            },
                            {
                                "example_id": "6ffb4437-5365-477e-94bf-c5926c9482b5",
                                "sense_id": "5b885624-2a50-3a6b-b92e-3d0ebab9de66",
                                "text": "La caillasse solitaire de La Forclaz s’ébauche sur le bitume surpeuplé de l’Alpe-d’Huez."
                            },
                            {
                                "example_id": "ee04c48c-1a19-4b27-9dfe-f6b302c7564a",
                                "sense_id": "5b885624-2a50-3a6b-b92e-3d0ebab9de66",
                                "text": "– Eh bien moi je commence à en avoir marre de fouiller dans l’eau, j’ai les doigts en charpie à force de retourner de la caillasse. Et puis j’ai besoin de voir des femmes, de danser et de rire ! Encore deux semaines et je m’en vais avec ma part !"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a0b06ee-fac0-3061-831b-d076435c3cac",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "glosses": [
                            "Caillou (au masculin)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "bc30a8e6-d25b-44db-bc1f-fc9d7febfef0",
                                "sense_id": "6a0b06ee-fac0-3061-831b-d076435c3cac",
                                "text": "Pourquoi les enfants d'Belfast\net d'tous les ghettos\nquand y balancent un caillasse\non leur fait la peau , Marchand de caillloux, 1991"
                            }
                        ]
                    },
                    {
                        "sense_id": "07906ab6-d20f-3e67-84f2-df84734c3bcd",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "glosses": [
                            "Monnaie."
                        ],
                        "tags": [
                            "figuratively",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "77ee70e2-2656-3070-88c7-fa80b3b62a0d",
                        "entry_id": "972ace60-460a-393b-979d-ddccf78254e0",
                        "glosses": [
                            "Monnaie.",
                            "Argent."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b3abc650-914d-46ed-bb56-3761817ec0a1",
                                "sense_id": "77ee70e2-2656-3070-88c7-fa80b3b62a0d",
                                "text": "Il s’achète des tas de choses ; apparemment il a de la caillasse."
                            }
                        ]
                    }
