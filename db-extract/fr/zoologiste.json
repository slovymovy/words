                    {
                        "sense_id": "f85c18a9-b348-3dd0-a351-d22e57828ba5",
                        "entry_id": "f8bb3234-ee5f-35f6-9b58-b9e1579fb3a4",
                        "glosses": [
                            "Personne qui s’adonne à la zoologie, qui en traite."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "7cd730f8-4601-4710-993e-837da90cd2a8",
                                "sense_id": "f85c18a9-b348-3dd0-a351-d22e57828ba5",
                                "text": "On voit dès lors qu'il n'est point indifférent de représenter une coquille d'une manière ou d'une autre, et qu'il importe au zoologiste ou au paléontologue de donner aux géologues des points de comparaison sur lesquels ceux-ci puissent s'appuyer pour reconnaître l'état des couches à l'instant où les êtres qui y sont enfermés ont été recouvert de nouveaux dépôts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fec08e57-9f21-494f-8654-36101c98c4ea",
                        "source_entry_id": "f8bb3234-ee5f-35f6-9b58-b9e1579fb3a4",
                        "source_sense_id": "f85c18a9-b348-3dd0-a351-d22e57828ba5",
                        "target_lang_word": "Zoologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zoologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab5fd647-4cc6-3958-8cfd-0e2ae509d1e5",
                                        "entry_id": "7a94120d-1bf5-31aa-a044-ab489d6dbfd6",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit der Anatomie, der Physiologie und dem Verhalten der Tiere also mit der Zoologie beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4db228f-9208-4258-be53-358cf395002c",
                                                "sense_id": "ab5fd647-4cc6-3958-8cfd-0e2ae509d1e5",
                                                "text": "Ich würde gerne als Zoologe arbeiten."
                                            },
                                            {
                                                "example_id": "4694df21-3683-443b-aff3-6c1ed0f246f4",
                                                "sense_id": "ab5fd647-4cc6-3958-8cfd-0e2ae509d1e5",
                                                "text": "„Er entdeckte bzw. beschrieb erstmals etliche Pflanzenarten, untersuchte Tiere und Pflanzen auf dem Balkan, dem Kaukasus, in Südrussland und war in seinen späteren Jahren als Zoologe und Naturgeschichtler an der Universität Helsinki.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
