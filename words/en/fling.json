{
    "word_family": [
        "flinger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebb8de9d-a3ff-38d9-9ada-dfb952d3228b",
                    "sense_definition": "To throw something with force, violence, or a quick movement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>fling</w> the door open and confront the intruder immediately.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>распахнуть</w> дверь и немедленно встретиться с незваным гостем.",
                                "zh": "他决定<w>猛地推开</w>门，立即与闯入者对峙。"
                            }
                        },
                        {
                            "text": "The angry athlete <w>flung</w> his racket across the court after losing the final point.",
                            "target_lang_translations": {
                                "ru": "Разгневанный атлет <w>швырнул</w> свою ракетку через весь корт после проигрыша последнего очка.",
                                "zh": "愤怒的运动员在输掉最后一分后，将球拍<w>摔</w>到了球场对面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hurl",
                        "toss",
                        "pitch",
                        "cast",
                        "sling"
                    ],
                    "antonyms": [
                        "catch",
                        "hold",
                        "keep"
                    ],
                    "common_phrases": [
                        "fling the door open",
                        "fling aside",
                        "fling away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать что-либо с силой, яростью или резким движением.",
                        "zh": "用力、猛烈或快速地投掷某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "резко и с силой бросать"
                            },
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "заставлять перемещаться по воздуху"
                            },
                            {
                                "target_lang_word": "метнуть",
                                "target_lang_sense_clarification": "с силой бросить, обычно в цель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛掷",
                                "target_lang_sense_clarification": "用力地扔"
                            },
                            {
                                "target_lang_word": "摔",
                                "target_lang_sense_clarification": "用力扔向地面或某处"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "投掷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c36c9490-ba9c-3168-97af-431c18bd54e1",
                    "sense_definition": "To move oneself abruptly or violently, often in a state of anger or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>flung</w> herself onto the bed and began to cry uncontrollably.",
                            "target_lang_translations": {
                                "ru": "Она <w>бросилась</w> на кровать и начала безутешно рыдать.",
                                "zh": "她<w>扑</w>到床上，开始失声痛哭。"
                            }
                        },
                        {
                            "text": "After the argument, he <w>flung</w> out of the room without saying another word.",
                            "target_lang_translations": {
                                "ru": "После спора он <w>выскочил</w> из комнаты, не сказав больше ни слова.",
                                "zh": "争吵过后，他一言不发地<w>冲</w>出了房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "rush"
                    ],
                    "common_phrases": [
                        "fling oneself into",
                        "fling out of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко или бурно переместиться, часто в состоянии гнева или возбуждения.",
                        "zh": "突然或猛烈地移动，通常处于愤怒或兴奋状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "броситься",
                                "target_lang_sense_clarification": "быстро устремиться"
                            },
                            {
                                "target_lang_word": "кинуться",
                                "target_lang_sense_clarification": "резко двинуться"
                            },
                            {
                                "target_lang_word": "выскочить",
                                "target_lang_sense_clarification": "стремительно выйти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲",
                                "target_lang_sense_clarification": "猛烈地移动"
                            },
                            {
                                "target_lang_word": "扑",
                                "target_lang_sense_clarification": "猛然向前移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d3b71a3-fc7d-35bc-a743-89fe5e802cb1",
                    "sense_definition": "To kick or jerk the limbs out violently, especially of a horse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startled horse began to <w>fling</w> its heels into the air.",
                            "target_lang_translations": {
                                "ru": "Испуганная лошадь начала <w>вскидывать</w> копыта в воздух.",
                                "zh": "受惊的马开始向空中<w>尥蹶子</w>。"
                            }
                        },
                        {
                            "text": "Be careful behind that mule, as it might <w>fling</w> at any moment.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен позади этого мула, так как он может <w>лягнуть</w> в любой момент.",
                                "zh": "在那头骡子后面要小心，因为它随时可能会<w>踢</w>人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kick",
                        "flounce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко лягаться или дергать конечностями, особенно о лошади.",
                        "zh": "猛烈地踢或甩动四肢，尤指马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лягаться",
                                "target_lang_sense_clarification": "бить копытами"
                            },
                            {
                                "target_lang_word": "брыкаться",
                                "target_lang_sense_clarification": "резко вскидывать ноги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踢",
                                "target_lang_sense_clarification": "用脚猛击"
                            },
                            {
                                "target_lang_word": "尥蹶子",
                                "target_lang_sense_clarification": "马向后踢腿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e85409f9-8ec6-362d-8da6-b487a7c913e0",
                    "sense_definition": "To utter abusive language or sarcastic remarks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two rivals began to <w>fling</w> insults at each other across the hall.",
                            "target_lang_translations": {
                                "ru": "Двое соперников начали <w>осыпать</w> друг друга оскорблениями через весь зал.",
                                "zh": "两名竞争对手开始在大厅里互相<w>辱骂</w>。"
                            }
                        },
                        {
                            "text": "It is unprofessional to <w>fling</w> such accusations without any proof.",
                            "target_lang_translations": {
                                "ru": "Непрофессионально <w>бросаться</w> такими обвинениями без каких-либо доказательств.",
                                "zh": "在没有任何证据的情况下<w>抛出</w>此类指控是不专业的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sneer",
                        "scoff",
                        "jeer"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "common_phrases": [
                        "fling insults"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the context of verbal outbursts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высказывать оскорбления или саркастические замечания.",
                        "zh": "说出侮辱性或讽刺的话语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросаться",
                                "target_lang_sense_clarification": "говорить резкие слова, например, оскорбления"
                            },
                            {
                                "target_lang_word": "сыпать",
                                "target_lang_sense_clarification": "обильно высказывать упреки или колкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辱骂",
                                "target_lang_sense_clarification": "用恶毒语言攻击"
                            },
                            {
                                "target_lang_word": "抛出",
                                "target_lang_sense_clarification": "指责或言论"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99b80048-6eba-3f46-bd24-9d473c10a913",
                    "sense_definition": "A short, casual romantic or sexual relationship.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had a brief summer <w>fling</w> while they were both working at the resort.",
                            "target_lang_translations": {
                                "ru": "У них была короткая летняя <w>интрижка</w>, пока они оба работали на курорте.",
                                "zh": "他们在度假村工作时有过一段短暂的夏季<w>露水情缘</w>。"
                            }
                        },
                        {
                            "text": "She realized that what she thought was love was actually just a temporary <w>fling</w>.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что то, что она считала любовью, на самом деле было лишь временным <w>увлечением</w>.",
                                "zh": "她意识到她以为的爱情其实只是一段暂时的<w>风流韵事</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affair",
                        "dalliance",
                        "liaison",
                        "hookup"
                    ],
                    "antonyms": [
                        "commitment",
                        "marriage"
                    ],
                    "common_phrases": [
                        "summer fling",
                        "brief fling",
                        "casual fling"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткие, ни к чему не обязывающие романтические или сексуальные отношения.",
                        "zh": "一段短暂、随意的浪漫或性关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интрижка",
                                "target_lang_sense_clarification": "непродолжительная любовная связь"
                            },
                            {
                                "target_lang_word": "любовное увлечение",
                                "target_lang_sense_clarification": "краткосрочный роман"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "露水情缘",
                                "target_lang_sense_clarification": "短暂的感情"
                            },
                            {
                                "target_lang_word": "风流韵事",
                                "target_lang_sense_clarification": "非正式的恋爱关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "721d7121-acb9-300c-9c7a-c286ea986ae1",
                    "sense_definition": "The act of throwing something with force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one powerful <w>fling</w>, he sent the stone skipping across the lake.",
                            "target_lang_translations": {
                                "ru": "Одним мощным <w>броском</w> он заставил камень прыгать по поверхности озера.",
                                "zh": "他用力一<w>掷</w>，石头便在湖面上跳跃起来。"
                            }
                        },
                        {
                            "text": "The <w>fling</w> of the dice determined who would go first in the game.",
                            "target_lang_translations": {
                                "ru": "<w>Бросок</w> костей определил, кто пойдет первым в игре.",
                                "zh": "骰子的<w>投掷</w>决定了谁在游戏中先走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss",
                        "cast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт бросания чего-либо с силой.",
                        "zh": "用力投掷某物的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "действие по глаголу бросать"
                            },
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "резкое движение рукой при броске"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投掷",
                                "target_lang_sense_clarification": "扔的动作"
                            },
                            {
                                "target_lang_word": "猛甩",
                                "target_lang_sense_clarification": "用力的甩动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c187a185-2500-323c-a737-05dc6bdf2f07",
                    "sense_definition": "A period of unrestrained indulgence in pleasure or wild behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indulgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before starting his serious career, he wanted to have one last <w>fling</w> in Europe.",
                            "target_lang_translations": {
                                "ru": "Перед началом серьезной карьеры он хотел в последний раз <w>повеселиться</w> в Европе.",
                                "zh": "在开始正式职业生涯之前，他想在欧洲进行最后一次<w>狂欢</w>。"
                            }
                        },
                        {
                            "text": "The retired couple decided to have a final <w>fling</w> and spend their savings on a luxury cruise.",
                            "target_lang_translations": {
                                "ru": "Пара пенсионеров решила устроить себе прощальный <w>загул</w> и потратить свои сбережения на роскошный круиз.",
                                "zh": "这对退休夫妇决定最后<w>放纵</w>一次，把积蓄花在豪华游轮上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spree",
                        "binge"
                    ],
                    "common_phrases": [
                        "have a fling",
                        "one last fling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период безудержного веселья, развлечений или дикого поведения.",
                        "zh": "一段放纵享乐或疯狂行为的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загул",
                                "target_lang_sense_clarification": "период безудержного веселья"
                            },
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "короткий период удовольствий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂欢",
                                "target_lang_sense_clarification": "放纵的娱乐"
                            },
                            {
                                "target_lang_word": "放纵",
                                "target_lang_sense_clarification": "不受约束的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db04de46-57dc-3fbc-ae0e-57d302f4d310",
                    "sense_definition": "An attempt or a try at doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though he had never painted before, he decided to give it a <w>fling</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя он никогда раньше не рисовал, он решил <w>попробовать</w> свои силы.",
                                "zh": "尽管他以前从未画过画，但他决定<w>尝试</w>一下。"
                            }
                        },
                        {
                            "text": "I'm not sure if I can win, but I'll have a <w>fling</w> at the competition anyway.",
                            "target_lang_translations": {
                                "ru": "Я не уверен, что смогу победить, но все равно <w>попытаюсь</w> поучаствовать в соревновании.",
                                "zh": "我不确定能否获胜，但无论如何我都会<w>尝试</w>参加比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "try",
                        "attempt",
                        "go",
                        "shot"
                    ],
                    "common_phrases": [
                        "give it a fling"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal way to say 'try'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка или проба сделать что-либо.",
                        "zh": "尝试做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "проба сил в чем-то новом"
                            },
                            {
                                "target_lang_word": "шанс",
                                "target_lang_sense_clarification": "возможность попробовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尝试",
                                "target_lang_sense_clarification": "试一试"
                            },
                            {
                                "target_lang_word": "试水",
                                "target_lang_sense_clarification": "初步尝试"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d14118-1190-384e-84ae-6dcc1e1adc83",
                    "sense_definition": "A lively type of traditional Scottish dance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers performed a traditional Highland <w>fling</w> at the cultural festival.",
                            "target_lang_translations": {
                                "ru": "Танцоры исполнили традиционный хайленд-<w>флинг</w> на культурном фестивале.",
                                "zh": "舞者们在文化节上表演了传统的苏格兰<w>弗林舞</w>。"
                            }
                        },
                        {
                            "text": "She practiced the steps of the <w>fling</w> until her legs were tired.",
                            "target_lang_translations": {
                                "ru": "Она практиковала шаги <w>флинга</w>, пока ее ноги не устали.",
                                "zh": "她练习<w>弗林舞</w>的舞步，直到双腿疲惫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Highland fling"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifically Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Живой традиционный шотландский танец.",
                        "zh": "一种活泼的传统苏格兰舞蹈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флинг",
                                "target_lang_sense_clarification": "название шотландского танца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弗林舞",
                                "target_lang_sense_clarification": "苏格兰舞蹈名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e229181-f210-398d-b5f8-aa1ed4a43bd6",
                    "sense_definition": "A contemptuous or sarcastic remark; a taunt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He couldn't resist taking a <w>fling</w> at his opponent's lack of experience.",
                            "target_lang_translations": {
                                "ru": "Он не удержался от <w>выпада</w> по поводу неопытности своего оппонента.",
                                "zh": "他忍不住对对手缺乏经验进行了<w>挖苦</w>。"
                            }
                        },
                        {
                            "text": "Her speech was full of subtle <w>flings</w> directed at the management.",
                            "target_lang_translations": {
                                "ru": "Ее речь была полна тонких <w>насмешек</w> в адрес руководства.",
                                "zh": "她的演讲中充满了针对管理层的微妙<w>嘲讽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gibe",
                        "taunt",
                        "sneer",
                        "dig"
                    ],
                    "antonyms": [
                        "compliment"
                    ],
                    "common_phrases": [
