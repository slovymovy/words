                                "sense_id": "75af51b5-88ed-3a7c-877a-6760f67d8740",
                                "text": "„Während Infraschall teilweise über Körperschall als Vibration wahrgenommen werden kann, ist Ultraschall für den Menschen nicht wahrnehmbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
