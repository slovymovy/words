                        "sense_id": "8d43c771-af5d-31e3-8669-6af433a51d2c",
                        "entry_id": "a9d759fb-8b7a-3a2f-b182-8e868afe2e2f",
                        "glosses": [
                            "telegram przesyłany za pomocą kabla podmorskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ada891f-ecc9-4b3d-a019-c0724a8696e9",
                                "sense_id": "8d43c771-af5d-31e3-8669-6af433a51d2c",
                                "text": "Dowództwo alianckie czekało na ważny kablogram z Waszyngtonu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "068dca03-b7f1-4e25-be80-78fb2c0f4280",
                        "source_entry_id": "a9d759fb-8b7a-3a2f-b182-8e868afe2e2f",
                        "source_sense_id": "8d43c771-af5d-31e3-8669-6af433a51d2c",
                        "target_lang_word": "câblogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "câblogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6f949c-84d9-3593-b989-f432203f406b",
                                        "entry_id": "4b747e96-b7ad-3cbd-946d-e676c7665574",
                                        "glosses": [
                                            "Télégramme transmis par câble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8b84c1-cc6e-425c-a37f-8d7677b4ced2",
                                                "sense_id": "0f6f949c-84d9-3593-b989-f432203f406b",
                                                "text": "Le câblogramme était un télégramme, texte écrit en clair ou en code, transmis de son expéditeur au destinataire par le moyen essentiel d'un câble électrique enterré, sous-marin ou aérien."
                                            },
                                            {
                                                "example_id": "e530fe00-7dfb-45ad-a99d-6fe70e32282d",
                                                "sense_id": "0f6f949c-84d9-3593-b989-f432203f406b",
                                                "text": "J’ai reçu votre câblogramme hier à onze heures. À une heure je filai via Douvres et Vlissingen… Et me voilà…"
                                            },
                                            {
                                                "example_id": "2cf661a9-3abc-4525-851e-bad80e0de8a1",
                                                "sense_id": "0f6f949c-84d9-3593-b989-f432203f406b",
                                                "text": "Dans son opiniâtre préoccupation d'isoler la colonie [de la Tripolitaine], le gouvernement turc maintient les tarifs les plus exorbitants pour les câblogrammes, et ne transmet jamais les dépêches en langage conventionnel ; aussi, les négociants préfèrent-ils employer le bureau français de Djerba, sur la frontière tunisienne."
                                            },
                                            {
                                                "example_id": "5678a499-21a2-4336-b911-fd4d36aaa729",
                                                "sense_id": "0f6f949c-84d9-3593-b989-f432203f406b",
                                                "text": "Le 10 mai, le capitaine rend compte du combat par un câblogramme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
