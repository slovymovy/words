                "senses": [
                    {
                        "sense_id": "b3a761cf-1fc2-3f68-b652-64c92e7111ff",
                        "entry_id": "6e61c6f2-8d9f-37ee-98e1-b0e7148fb561",
                        "glosses": [
                            "напильник с редкой крупной и острой насечкой для обработки мягких металлов, кости, кожи, дерева и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65fce7c1-b45e-4ea5-a540-223767120bf4",
                                "sense_id": "b3a761cf-1fc2-3f68-b652-64c92e7111ff",
                                "text": "Обычные напильники насекаются рядами наклонных зубцов, а рашпиль — лунками с выступающим острым краем."
                            },
                            {
                                "example_id": "b2c70741-ca90-45ea-bc23-d0e86dcdb02f",
                                "sense_id": "b3a761cf-1fc2-3f68-b652-64c92e7111ff",
                                "text": "Придайте поверхности шероховатость рашпилем для резины или проволочной щеткой."
                            }
                        ]
                    }
                ],
                "translations": [
