                "translations": [
                    {
                        "translation_id": "9a16f85b-2fda-4cad-b99e-407a1c23f249",
                        "source_entry_id": "e5d021b6-517c-3b87-90ca-4016c78b6f16",
                        "source_sense_id": "6d174261-2eec-3677-aaa1-9f85ad7697f4",
                        "source_sense_description": "Mathematik, Mengenlehre: Menge aller Teilmengen einer Menge",
                        "target_lang_word": "power set",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "power set",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc68fb51-6a0b-3e2d-ac27-cd22f2c59dfc",
                                        "entry_id": "6e81da76-193b-3dc8-b4a2-727eff4e6447",
                                        "glosses": [
                                            "The set whose elements comprise all the subsets of S (including the empty set and S itself)."
                                        ],
                                        "tags": [
                                            "of a set S"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acbdb4cb-f5ae-4203-8ce2-3ddf5116292a",
                                                "sense_id": "fc68fb51-6a0b-3e2d-ac27-cd22f2c59dfc",
                                                "text": "The power set of #92;#123;1,2#92;#125; is #92;left#92;#123;#92;empty,#92;#123;1#92;#125;,#92;#123;2#92;#125;,#92;#123;1,2#92;#125;#92;right#92;#125;."
                                            },
                                            {
                                                "example_id": "2111ca9b-2b1d-4466-acd9-108eaa94cc31",
                                                "sense_id": "fc68fb51-6a0b-3e2d-ac27-cd22f2c59dfc",
                                                "text": "Moreover, for notational convenience, we write the cardinality of a denumerable set as #92;aleph#95;0. Cardinality of the power set of a denumerable set is written as #92;aleph#95;1. We may thus extend this notation further by taking cardinality of the power set of the power set of a denumerable set as #92;aleph#95;2, etc. but we do not have the need for it right now."
                                            },
                                            {
                                                "example_id": "c8cd9a61-668a-49d8-a50e-bcf415b4da4a",
                                                "sense_id": "fc68fb51-6a0b-3e2d-ac27-cd22f2c59dfc",
                                                "text": "Theorem 4.1. A complete Boolean algebra B has a set of (complete and atomic) ca-free generators iff B is isomorphic to the power set of a power set."
                                            },
                                            {
                                                "example_id": "705b3a1a-0261-4a99-ad4c-77cbc64b9979",
                                                "sense_id": "fc68fb51-6a0b-3e2d-ac27-cd22f2c59dfc",
                                                "text": "Exponentiation is essentially a move to the power set—the set of all subsets of a given set. This is one of the reasons why Bertrand Russell's paradox is indeed a paradox: We cannot find a universal set because no set can contain its own power set!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
