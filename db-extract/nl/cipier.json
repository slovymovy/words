                "senses": [
                    {
                        "sense_id": "6b0c378c-44d1-357e-aa4a-8ad9d080b18a",
                        "entry_id": "f82ced59-f29e-3477-895f-dca11f3f55f2",
                        "glosses": [
                            "iemand die gevangenen bewaakt en verzorgt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "06ca9b96-be41-4fe3-a89c-6887d452406c",
                                "sense_id": "6b0c378c-44d1-357e-aa4a-8ad9d080b18a",
                                "text": "Die cipier staat niet bekend om zijn zachtaardigheid."
                            },
                            {
                                "example_id": "4a05298d-99ae-4647-8cc0-674d94411959",
                                "sense_id": "6b0c378c-44d1-357e-aa4a-8ad9d080b18a",
                                "text": "The Daily Mirror ging al langs bij een gevangenis in Marseille. De boodschap van de anonieme cipier: hier wil je niet vastzitten. „Niemand spreekt Engels.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9865c2b5-c0c3-416b-8531-a25c51578680",
                        "source_entry_id": "f82ced59-f29e-3477-895f-dca11f3f55f2",
                        "source_sense_id": "6b0c378c-44d1-357e-aa4a-8ad9d080b18a",
                        "source_sense_description": "iemand die gevangenen bewaakt en verzorgt",
                        "target_lang_word": "Gefängniswärter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefängniswärter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                        "entry_id": "48bb14e2-7643-3760-824e-ee62d3377e24",
                                        "glosses": [
                                            "Mitglied des Sicherheitspersonals eines Gefängnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b14b04-2af4-494d-93c1-f06b475ad81c",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "Sie überwältigten die Gefängniswärter und letztendlich gelang ihnen die Flucht."
                                            },
                                            {
                                                "example_id": "3388ac2d-507a-4e0f-8594-a0a39b194461",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "„Nie im Leben hätte ich der Zärtlichkeit, die sich in meinem Herzen angesammelt hatte, vor diesem Gorilla von einem Gefängniswärter, der hinter uns stand, Ausdruck verleihen können.“"
                                            },
                                            {
                                                "example_id": "14f8d788-3c7b-4c30-bd54-da35bb60c673",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "„Den Grund für all diese Veränderungen kann ich nicht nennen, aber ich weiß, dass der Gefängniswärter, als er das Tor hinter uns schloss, sagte, dass dies bis zum Ende des Krieges unser Zuhause sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02dc3c85-9f88-41f5-8ac5-14998684d335",
                        "source_entry_id": "f82ced59-f29e-3477-895f-dca11f3f55f2",
                        "source_sense_id": "6b0c378c-44d1-357e-aa4a-8ad9d080b18a",
