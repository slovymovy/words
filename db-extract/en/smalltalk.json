                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c9866df-2638-42be-9f9a-270482050cef",
                                "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                "text": "It’s a bit difficult making smalltalk with a teacher, especially when they have to crane their neck to look up at you."
                            },
                            {
                                "example_id": "cd3ebb2d-31a3-4002-9148-3b263c9679a8",
                                "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                "text": "Hannah pictured Mark and herself sitting smiling over a stiff white tablecloth and single, interview-appropriate glasses of wine, making smalltalk and pretending everything was fine, that they were an ordinary happy couple, no stolen savings or hidden killer brothers to muddy the crystalline marital waters."
                            },
                            {
                                "example_id": "54da2bf5-5064-4454-85fa-ee012fb17314",
                                "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                "text": "“Don,” she said, and pushed the hair back from her eyes with an irritated sweep of her hand, “if the health of my toads is your idea of smalltalk while we work then I think I’d rather you just kept quiet, if it’s all the same to you.”"
                            }
                        ]
                    }
                ],
