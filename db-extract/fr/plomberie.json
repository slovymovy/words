                    {
                        "sense_id": "bc7935f9-fb90-3afb-8528-0b0652b715db",
                        "entry_id": "627be8c9-7d59-3ff6-a321-76e208a146e5",
                        "glosses": [
                            "Lieu où l’on coule et où l’on travaille le plomb."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "087878b7-ff2a-3970-8754-196eb9f29a2f",
                        "entry_id": "627be8c9-7d59-3ff6-a321-76e208a146e5",
                        "glosses": [
                            "Métier consistant à réaliser les canalisations dans les bâtiments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11e4a3a1-9c9b-4dd4-836a-a209230880ec",
                                "sense_id": "087878b7-ff2a-3970-8754-196eb9f29a2f",
                                "text": "Ramond n’était pas avec nous au lycée ; il travaillait avec son père, qui avait une entreprise de plomberie. Avec lui, nous pratiquions notre espagnol et surtout on faisait la fête."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8daf2b7-ac03-3fdd-aa82-842e272b3fb3",
                        "entry_id": "627be8c9-7d59-3ff6-a321-76e208a146e5",
                        "glosses": [
                            "Ensemble des canalisations d’un bâtiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dfeb718-9ebd-433f-830c-2e56d764adfd",
                                "sense_id": "c8daf2b7-ac03-3fdd-aa82-842e272b3fb3",
                                "text": "Je vais refaire la plomberie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf730525-e66c-4b99-b281-edcb12110d37",
                        "source_entry_id": "627be8c9-7d59-3ff6-a321-76e208a146e5",
                        "source_sense_id": "087878b7-ff2a-3970-8754-196eb9f29a2f",
                        "source_sense_description": "Métier consistant à réaliser les canalisations dans les bâtiments.",
                        "target_lang_word": "Klempnerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klempnerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db9bcf8e-e52f-3d2f-ab0f-c0f66fc24a63",
                                        "entry_id": "7170c301-50c7-30f2-b137-e5cbe7a0af99",
                                        "glosses": [
                                            "berufliche Tätigkeit eines Klempners"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b099fb6f-d9c2-4f34-bad3-bc02635e61f0",
                                                "sense_id": "db9bcf8e-e52f-3d2f-ab0f-c0f66fc24a63",
                                                "text": "„Vor allem im Westen werden Spezialisten für Energietechnik sowie im Bereich Klempnerei, Sanitär, Heizung und Klimatechnik gesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                        "entry_id": "7170c301-50c7-30f2-b137-e5cbe7a0af99",
                                        "glosses": [
                                            "Arbeitsstätte eines Klempners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b97710-1f17-4ef8-8e09-962d284cc6fb",
                                                "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                                "text": "„In seiner Klempnerei in der Bramfelder Straße züchtete er vor allem Drogen-Hanf!“"
                                            },
                                            {
                                                "example_id": "32363dbb-1d30-429f-98b4-960e4e8a7c0b",
                                                "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                                "text": "„In der alten Klempnerei stellt sich Florian Haver einen Indoorspielplatz vor.“"
                                            },
                                            {
                                                "example_id": "16c7ed43-fafd-420f-bb3d-a396523e58d1",
                                                "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                                "text": "„Die Klempnerei, die in den vergangenen Jahrzehnten das Dach der Philharmonie mitbaute und das der Akademie der Künste, hat heute noch sieben Beschäftigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e9bc3df-d835-455a-90c9-0c39e4b22bbf",
                        "source_entry_id": "627be8c9-7d59-3ff6-a321-76e208a146e5",
                        "source_sense_id": "087878b7-ff2a-3970-8754-196eb9f29a2f",
                        "source_sense_description": "Métier consistant à réaliser les canalisations dans les bâtiments.",
                        "target_lang_word": "plumbing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plumbing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68d89c2-fb3a-3af0-a0cf-2bbffaf4bccc",
                                        "entry_id": "eaa40b4e-03b7-347c-a339-8b193bfe1041",
                                        "glosses": [
                                            "The pipes, together with the joints, tanks, stopcocks, taps, and other fixtures of a water, gas, or sewage system in a house or other building."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce876fc-1fc1-49ba-96e7-cab9bfaa6d98",
                                                "sense_id": "b68d89c2-fb3a-3af0-a0cf-2bbffaf4bccc",
                                                "text": "Water was dripping from the ceiling, so we figured there was a problem with the plumbing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0cd0af1-d0d6-31a0-b839-2ef139bc7deb",
                                        "entry_id": "eaa40b4e-03b7-347c-a339-8b193bfe1041",
                                        "glosses": [
                                            "The trade or occupation of a plumber."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4972dda-d38a-3420-9795-f165751e6208",
                                        "entry_id": "eaa40b4e-03b7-347c-a339-8b193bfe1041",
                                        "glosses": [
                                            "A system of vessels or ducts in the human body, especially the genitourinary system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b005d51f-ef0c-4d33-88d8-3c0fa9d30d07",
                                                "sense_id": "d4972dda-d38a-3420-9795-f165751e6208",
                                                "text": "My plumbing was playing up, so I had to see the doctor."
                                            },
                                            {
                                                "example_id": "0d2bf33d-6e62-4dc7-9982-7e293b633263",
                                                "sense_id": "d4972dda-d38a-3420-9795-f165751e6208",
                                                "text": "I am sure that there are those who dislike me […] but as a person, not for the sake of my plumbing."
                                            },
                                            {
                                                "example_id": "ac3628a7-7cad-47af-85bd-39391dd0e660",
                                                "sense_id": "d4972dda-d38a-3420-9795-f165751e6208",
                                                "text": "‹Why did I always think the ladies' room would be less gross? How do you girls freaking miss with your plumbing!?›"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c18184-7f22-3795-9d8b-8a12ac9499fb",
                                        "entry_id": "eaa40b4e-03b7-347c-a339-8b193bfe1041",
                                        "glosses": [
                                            "Practical, concrete work serving to support other work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c6cb93-a5f4-48fa-a23c-916e9dd2f10b",
                                                "sense_id": "f9c18184-7f22-3795-9d8b-8a12ac9499fb",
                                                "text": "This is not scientific research as such: it's just plumbing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "519c6497-9b81-364f-84c4-82e106f89a54",
                                        "entry_id": "eaa40b4e-03b7-347c-a339-8b193bfe1041",
                                        "glosses": [
                                            "A Murasugi sum where each disk summed along has its boundary subdivided into four segments."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3d2dcce-d0b6-3c36-8733-1404e3f0bc37",
                                        "entry_id": "eaa40b4e-03b7-347c-a339-8b193bfe1041",
