                                        "glosses": [
                                            "ein Forscher, der sich wissenschaftlich mit Bakterien beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25a0811-b99d-4ace-8bc9-6d1930009d11",
                                                "sense_id": "75d35a60-0d2b-321f-8650-a4ff334ff2bc",
                                                "text": "„Charles Nicolle (1866 bis 1936), französischer Mediziner und Bakteriologe, leitete in Tunis das Institut Pasteur.“"
                                            },
                                            {
                                                "example_id": "b0587f4d-98f4-452f-a8de-3652a7edf494",
                                                "sense_id": "75d35a60-0d2b-321f-8650-a4ff334ff2bc",
                                                "text": "„Dieser herausragende Bakteriologe wurde zur populärsten Gestalt neben Hitler, der Gute neben dem Bösen sozusagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
