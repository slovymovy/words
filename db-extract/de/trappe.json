                "translations": [
                    {
                        "translation_id": "4823bf91-5ecb-4e4d-8ee6-1271e9fe7b11",
                        "source_entry_id": "0bbc07c4-78c7-3bbd-a8b3-31c69bdeb1f2",
                        "source_sense_id": "9a259275-310e-34e2-9db3-71d02811b409",
                        "source_sense_description": "Vogel aus der Familie Otididae",
                        "target_lang_word": "bustard",
