                                        "examples": [
                                            {
                                                "example_id": "aa75f2bb-63a1-46a5-ae81-79473783d87b",
                                                "sense_id": "acacc8ae-bd57-3150-9e2a-45bea4d0c8fb",
                                                "text": "„Das internationale Hockey wurde lange Zeit von den ehemaligen britischen Kolonien Indien und Pakistan dominiert.“"
