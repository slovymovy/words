                        "entry_id": "50db9fce-faf1-3c5a-a538-23c7e20f5f6c",
                        "glosses": [
                            "przyrząd do zwiększania natężenia lub amplitudy drgań elektrycznych zbudowany z wykorzystaniem tranzystorów lub lamp elektronowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc29edb9-5bf0-4232-9f4a-091280feeae0",
                                "sense_id": "4dd273c0-6ad3-3518-a4cf-9cd6bfb5b625",
                                "text": "Dźwięki zamienione w mikrofonie na słaby sygnał elektryczny docierają następnie do wzmacniacza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6ce0dc18-f99e-3242-a2fc-755c1b17c4e2",
                        "entry_id": "50db9fce-faf1-3c5a-a538-23c7e20f5f6c",
                        "glosses": [
                            "część składowa wielu instrumentów muzycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b15596-b28b-4a23-98a1-028e2d66ab40",
                                "sense_id": "6ce0dc18-f99e-3242-a2fc-755c1b17c4e2",
                                "text": "Elementem instrumentu często najbardziej rzucającym się w oczy jest pudło rezonansowe stanowiące wzmacniacz jego dźwięku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
