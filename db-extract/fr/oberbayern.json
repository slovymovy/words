                                    },
                                    {
                                        "sense_id": "b3742493-4165-3f6d-8db7-8a312b63bf24",
                                        "entry_id": "cbb9ca7a-00e6-3ec3-8004-8611e7ff7a0c",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90324db9-ab6b-4737-87df-9191610522de",
                                                "sense_id": "b3742493-4165-3f6d-8db7-8a312b63bf24",
                                                "text": "„Geboren ward ich den 20. Februar 1812 zu Aichach in Oberbayern, einem freundlichen Städtchen in der Nähe des Stammschlosses Wittelsbach, mit vielen Brauereien und wenigstens einer Schule.“"
                                            },
                                            {
                                                "example_id": "5f2c493c-c965-42ca-97df-5d1eb9f93eed",
                                                "sense_id": "b3742493-4165-3f6d-8db7-8a312b63bf24",
                                                "text": "München ist die größte Stadt Oberbayerns."
                                            },
                                            {
                                                "example_id": "027b9da9-2ebc-4b71-a12b-448676f232ff",
                                                "sense_id": "b3742493-4165-3f6d-8db7-8a312b63bf24",
                                                "text": "„Doch all dies reicht noch nicht, um Oberbayern zu vermiesen. Mehr als seine Kommerzialisierung abschreckt, zieht immer noch die Qualität seines Lebens und seiner Kultur an – vorausgesetzt, man nimmt die Ferien nicht in den Remmi-Demmi-Sommermonaten.“"
                                            },
                                            {
                                                "example_id": "55358921-1082-456c-b358-10d25a9d0c4c",
                                                "sense_id": "b3742493-4165-3f6d-8db7-8a312b63bf24",
                                                "text": "„Zur Abreise füllt sich der Kofferraum: Brände, Biere, Bauernbrot – fränkische Viktualien sind in Oberbayern als Mitbringsel begehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
