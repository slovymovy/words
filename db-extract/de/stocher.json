                "senses": [
                    {
                        "sense_id": "44dad87f-436e-3ff4-9141-8d6ae7505664",
                        "entry_id": "1aa2ef00-0639-3fa5-8e2d-f3f48f786159",
                        "glosses": [
                            "einfaches Werkzeug zum Herumbohren (Stochern) in etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b298f274-bdf9-4c53-a7d6-27aafb41c5d2",
                                "sense_id": "44dad87f-436e-3ff4-9141-8d6ae7505664",
                                "text": "Für die Zahnzwischenräume kann man einen Holzspan als Stocher benutzen."
                            },
                            {
                                "example_id": "1336dbaf-4515-48ec-9167-09bd8edd90ea",
                                "sense_id": "44dad87f-436e-3ff4-9141-8d6ae7505664",
                                "text": "„Er nahm einen neuen Stocher und beschäftigte sich ein bißchen mit seinen Zähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "052797ad-410f-39c5-9a33-2b0a47c25750",
                        "entry_id": "1aa2ef00-0639-3fa5-8e2d-f3f48f786159",
                        "glosses": [
                            "eine Art von Heizer, Feuerschürer"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4f8fc6c3-a229-4212-b42a-e156df855a65",
                                "sense_id": "052797ad-410f-39c5-9a33-2b0a47c25750",
                                "text": "„Die Walzmeister haben hier zirka 1,35 Mk. pro Schicht mehr als die Vor- und Fertigwalzer, der erste Ofenmann verdient zirka 90 Pf. pro Schicht mehr als der zweite und zirka 2 Mk. mehr als Stocher und Chargierer.“ (1912)"
                            }
                        ],
