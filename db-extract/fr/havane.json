                ],
                "senses": [
                    {
                        "sense_id": "18ccf6e0-2a7e-31b7-8eb1-5493cb9f41d1",
                        "entry_id": "78bb1f53-68d2-331e-99ba-5bce52de7050",
                        "glosses": [
                            "Cigare cubain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13aee1e4-a223-47fa-a892-b95cf19a8638",
                                "sense_id": "18ccf6e0-2a7e-31b7-8eb1-5493cb9f41d1",
                                "text": "Je ne fume que le cigare. Et uniquement des havanes."
                            },
                            {
                                "example_id": "a4054aa7-c656-41a9-bfcd-80dbbb459232",
                                "sense_id": "18ccf6e0-2a7e-31b7-8eb1-5493cb9f41d1",
                                "text": "Les contrats tomberaient à la pelle et ils allumeraient leurs havanes avec des billets de mille."
                            },
                            {
                                "example_id": "b4046bc2-5171-47f2-8233-42e6a44d04b1",
                                "sense_id": "18ccf6e0-2a7e-31b7-8eb1-5493cb9f41d1",
                                "text": "« Mussolini et Staline sont interchangeables. Tous deux éprouvent la même joie : la joie du pouvoir. C'est comme s'ils fumaient un même havane ! »"
                            },
                            {
                                "example_id": "b976fbcf-eb44-4229-809c-16cfa4091bad",
                                "sense_id": "18ccf6e0-2a7e-31b7-8eb1-5493cb9f41d1",
                                "text": "Il alluma un havane, but un cognac, et refeuilleta pour la troisième fois ses revues."
                            },
                            {
                                "example_id": "109cf46e-7445-4d51-b00f-91dacc919e16",
                                "sense_id": "18ccf6e0-2a7e-31b7-8eb1-5493cb9f41d1",
                                "text": "Au pied de la croix de 1812, on fuma un havane Robusto."
                            }
                        ]
                    },
                    {
                        "sense_id": "31ac12eb-3e6c-37be-8375-79bbb24ee1d0",
                        "entry_id": "78bb1f53-68d2-331e-99ba-5bce52de7050",
                        "glosses": [
                            "Couleur marron clair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19889b14-417a-495d-b8fb-6c100e4125e4",
                                "sense_id": "31ac12eb-3e6c-37be-8375-79bbb24ee1d0",
                                "text": "— Bonjour, Camille… Ah ! cette robe havane ! C’est étonnant comme les couleurs un peu sombres vous habillent !"
                            }
                        ]
                    }
