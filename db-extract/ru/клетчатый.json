                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a20e828-8ce9-3569-889b-ad21a20062f4",
                                        "entry_id": "c14f19e0-9f50-37f1-9416-f8cc16c60766",
                                        "glosses": [
                                            "Papier quadrillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55d7d71-65c2-4814-8904-b3ed1fdf1d2d",
                                                "sense_id": "9a20e828-8ce9-3569-889b-ad21a20062f4",
                                                "text": "La bicoque de Mme Daigne a été baptisée villa, quand ce n’était encore qu’un plan de maçon sur une feuille de quadrillé."
                                            }
                                        ]
                                    }
                                ]
                            },
