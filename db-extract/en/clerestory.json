                    },
                    {
                        "translation_id": "cee11c0a-7287-4e21-a27c-2fcb9479f22c",
                        "source_entry_id": "cfb23e06-af6a-34e4-8408-bd3e33a59ecf",
                        "source_sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                        "source_sense_description": "upper part of a wall containing windows",
                        "target_lang_word": "clair-étage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clair-étage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40d6d56e-bb8a-3fc3-bfa1-e536654554fa",
                                        "entry_id": "8724e1b0-1571-39fb-b2e7-19d76738bf27",
                                        "glosses": [
                                            "Rangée de fenêtres placées aux étages supérieurs de la nef des édifices gothiques, claire-voie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbd578e3-1a9e-4d96-9f69-4a460385eaee",
                                                "sense_id": "40d6d56e-bb8a-3fc3-bfa1-e536654554fa",
                                                "text": "Les vitraux du clair-étage du chœur de la collégiale de Saint-Quentin sont l’œuvre d'Hector de Pétigny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed673f5a-f0cf-4b60-ac3d-214e8c1db190",
                        "source_entry_id": "cfb23e06-af6a-34e4-8408-bd3e33a59ecf",
                        "source_sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                        "source_sense_description": "upper part of a wall containing windows",
                        "target_lang_word": "claire-voie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claire-voie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b41b622-8eae-354e-994e-ef59ecd65227",
                                        "entry_id": "e1e65021-bb5c-3fd4-b52e-ea65e8bd668a",
                                        "glosses": [
                                            "Clôture ou paroi ajourée, faite de pièces disjointes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f774a339-fba3-4fc3-8285-7a568e2c9464",
                                                "sense_id": "4b41b622-8eae-354e-994e-ef59ecd65227",
                                                "text": "Le taureau avait acculé Félicité contre une claire-voie ; sa bave lui rejaillissait à la figure ; une seconde de plus il l’éventrait."
                                            },
                                            {
                                                "example_id": "bba23bf9-bb2d-40ec-a77b-24915344057f",
                                                "sense_id": "4b41b622-8eae-354e-994e-ef59ecd65227",
                                                "text": "Il les fit entrer l’une après l’autre dans la cage. Par son ordre, elles s’y accroupirent, les genoux aux dents ; il les pria instamment d’être sages, de ne pas bouger, de ne passer au travers des montants de la claire-voie ni le bras, ni la main, et la descente commença..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f826db1-da8d-3867-997c-f6dbf908a80d",
                                        "entry_id": "e1e65021-bb5c-3fd4-b52e-ea65e8bd668a",
                                        "glosses": [
                                            "Ouverture faite à rez-de-chaussée dans le mur d’un parc ou d’un jardin et qui n’est fermée que par une grille ou par une espèce de fossé appelé saut de loup."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2eee43c6-cccc-3cf6-b77a-676b8ffda1f0",
                                        "entry_id": "e1e65021-bb5c-3fd4-b52e-ea65e8bd668a",
                                        "glosses": [
                                            "Fenêtre percée en hauteur dans un bâtiment, où l'on préfère ne pas donner de vue aux occupants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d547f0b-bc54-330d-9243-1cf6d80152aa",
                                        "entry_id": "e1e65021-bb5c-3fd4-b52e-ea65e8bd668a",
                                        "glosses": [
                                            "Panneau vitré, souvent articulé, recouvrant une écoutille et permettant ainsi l'entrée d'air et de lumière du jour sous le pont d'un bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8793a79f-5a92-411f-80db-6c77b03464ec",
                                                "sense_id": "3d547f0b-bc54-330d-9243-1cf6d80152aa",
                                                "text": "Le pont était tellement balayé par les vagues que je devais garder toutes les claires-voies et panneaux fermés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6ea8ae-b533-3472-af9f-8a98271b9617",
                                        "entry_id": "e1e65021-bb5c-3fd4-b52e-ea65e8bd668a",
                                        "glosses": [
                                            "Désigne dans un meuble des trous régulièrement espacés."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4e564ff-8c63-4b71-a78d-3a3e2166c9a4",
                                                "sense_id": "5c6ea8ae-b533-3472-af9f-8a98271b9617",
                                                "text": "D’argent, à un arbre (nard) de sinople, terrassé du même, une haie à claire-voie de sable posée en fasce, mouvant de la terrasse et brochant sur l’arbre, qui est de la famille Aynard → voir illustration « Haie à claire-voie »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
