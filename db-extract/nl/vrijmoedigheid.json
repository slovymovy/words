                "senses": [
                    {
                        "sense_id": "a300b650-ac1b-36f6-b4da-972f582ff352",
                        "entry_id": "b05011b3-4451-36df-845a-fca2d6046888",
                        "glosses": [
                            "het niet al te angstig zijn; het hebben van een gezonde hoeveelheid durf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a174a9bb-91c8-4bfe-858f-a483639d3282",
                                "sense_id": "a300b650-ac1b-36f6-b4da-972f582ff352",
                                "text": "Haar vrijmoedigheid bracht een glimlach teweeg op mijn gezicht."
                            },
                            {
                                "example_id": "18c8f416-195e-4f70-93d5-32fbbf15db55",
                                "sense_id": "a300b650-ac1b-36f6-b4da-972f582ff352",
                                "text": ",,Dat was zeker nodig om uiteindelijk de vrijmoedigheid te hebben het examen door te laten gaan. Ik hoor overigens dat veel leerlingen het ook gehaald hebben zonder die steuntjes in de rug, dat is prima.”"
                            },
                            {
                                "example_id": "481b03d9-0793-4010-9553-c49fec174587",
                                "sense_id": "a300b650-ac1b-36f6-b4da-972f582ff352",
                                "text": "Ze werden verwelkomd door artsen met stickers van ‘Dracula-hoektanden’ op hun beschermende kleding, ontvingen na de prik een certificaat waarin hun ‘vrijmoedigheid en verantwoordelijkheid’ werd geprezen met de belofte dat ze ‘de komende honderd jaar’ welkom zijn in het kasteel én kregen gratis toegang tot een tentoonstelling over middeleeuwse martelwerktuigen."
                            }
                        ]
                    }
                ],
