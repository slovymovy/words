                "translations": [
                    {
                        "translation_id": "21739eac-e55d-489e-8391-a770d6f82b46",
                        "source_entry_id": "363f6b68-cde9-3d0a-8ae9-b1e62ee52ba2",
                        "source_sense_id": "6ab30f39-6e7c-3dad-9acf-fad4bb5fa3b0",
                        "target_lang_word": "Plato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plato",
