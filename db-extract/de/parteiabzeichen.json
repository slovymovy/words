                            {
                                "example_id": "fe55f3bc-5fe2-44a5-996b-cbd4602f5069",
                                "sense_id": "89fd14f6-7af2-3cdf-893d-2d93a6135415",
                                "text": "„Das farblose Haar hatte sie zu einem Knoten hochgenommen, an der Uniformjacke saß das goldene Parteiabzeichen, am Verschluß der Bluse saß eine schwarze, gehämmerte Brosche.“"
                            },
                            {
                                "example_id": "162381c8-b396-44fb-bb6a-8e1fa4992f48",
                                "sense_id": "89fd14f6-7af2-3cdf-893d-2d93a6135415",
                                "text": "„Da hat sich doch eine in Feldgrau gekleidete hochbusige Tucke tatsächlich das Parteiabzeichen angesteckt.“"
                            }
                        ],
