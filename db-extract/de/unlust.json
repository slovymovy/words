                "senses": [
                    {
                        "sense_id": "72944fda-b7f2-30aa-a9a0-6cc2a79ded90",
                        "entry_id": "750884a8-e6da-377e-b3fd-594a7ed39b02",
                        "glosses": [
                            "nicht vorhandene Lust, Motivation"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e4a5f2ce-5990-4bbb-9e38-52cf02fb1413",
                                "sense_id": "72944fda-b7f2-30aa-a9a0-6cc2a79ded90",
                                "text": "Meine Unlust hinderte mich daran, heute Morgen aufzustehen."
                            },
                            {
                                "example_id": "45e0875f-2a52-4818-afd9-c08f308fd6cd",
                                "sense_id": "72944fda-b7f2-30aa-a9a0-6cc2a79ded90",
                                "text": "Oft findet aufgrund sexueller Unlust kein Geschlechtsverkehr statt."
                            },
                            {
                                "example_id": "ae1afdf5-62f4-46c3-8bd3-27756ad39313",
                                "sense_id": "72944fda-b7f2-30aa-a9a0-6cc2a79ded90",
                                "text": "„Da der mühevolle Anstieg zunächst eher Unlust und sogar Qual bereitet, als dass er vergnüglich wäre, drängt Petrarca in seinem Steigverhalten unwillkürlich immer wieder auf den flacheren Weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b3d4fc61-7212-325c-b53e-6df4776fa038",
                        "entry_id": "750884a8-e6da-377e-b3fd-594a7ed39b02",
                        "glosses": [
                            "leichte Abneigung gegenüber etwas/jemanden"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
