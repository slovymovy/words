                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Szczęk</w> jest znaną lekarką w tym mieście.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Щенк</w> — известный врач в этом городе."
                            }
                        },
                        {
                            "text": "Rozmawiałem wczoraj z panią <w>Szczęk</w> o nowym projekcie.",
                            "target_lang_translations": {
                                "ru": "Я вчера разговаривал с госпожой <w>Щенк</w> о новом проекте."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "żeńskie nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
