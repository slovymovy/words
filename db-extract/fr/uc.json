                                        "glosses": [
                                            "To be silly, act stupid or mess around."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7372d73b-acb9-4e43-b02c-97ba9fef84cb",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "Stop arsing around!"
                                            },
                                            {
                                                "example_id": "73c62d3d-1428-44cc-90b0-95c44bc77e51",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "He was university material, just arsing about as a rigger, arsing about, killing time with bohunks like me[…]."
                                            },
                                            {
                                                "example_id": "0e7bf93e-60ca-4e11-ad39-83c6b1bad774",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "Pi, upset, roars, \"Quit arsing around there and get cracking,\" and a dozen heads turn their way."
                                            },
                                            {
                                                "example_id": "cc706419-e5d6-4706-a073-5a6caad639f6",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "He was half-expecting a call from the lingua, telling him to stop arsing around, but his com stayed silent, so it looked like a certain amount of arsing around was allowed."
                                            }
                                        ]
                                    }
