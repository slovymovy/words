                    {
                        "translation_id": "561c3e51-eda4-46e1-8995-d8a6091dd991",
                        "source_entry_id": "8b450c59-b6c8-304f-b561-10183fd146c9",
                        "source_sense_id": "5ca8eac2-cf79-3344-99b3-c8eefedf4133",
