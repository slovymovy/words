                ],
                "senses": [
                    {
                        "sense_id": "53185e6b-7bff-3162-857f-f563e441ffdf",
                        "entry_id": "8b412861-e670-3bf3-a0e9-4560c8641021",
                        "glosses": [
                            "Bereich der Lithosphäre, in dem eine schwerere tektonische Platte unter eine andere Platte, zumeist eine Kontinentalplatte, in den zähen Erdmantel abtaucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19e7b00-3f75-4d33-870c-1a38094a2d43",
                                "sense_id": "53185e6b-7bff-3162-857f-f563e441ffdf",
                                "text": "Der junge Ozeanboden […] wird beim Auskühlen dicker, bis er an einen Kontinentalrand stößt und - an einer sogenannten Subduktionszone - wieder ins Erdinnere abtaucht."
                            },
                            {
                                "example_id": "332c7d9d-6383-45af-b9ea-b52aa8e41fb3",
                                "sense_id": "53185e6b-7bff-3162-857f-f563e441ffdf",
                                "text": "Kavachi liegt jedoch 30 Kilometer hinter einer so genannten Subduktionszone, an der die Indo-Australische Platte unter die Pazifische Platte abtaucht."
                            },
                            {
                                "example_id": "571848f5-39cb-4bdd-8b0b-a17c4a14c718",
                                "sense_id": "53185e6b-7bff-3162-857f-f563e441ffdf",
                                "text": "44 Grad Nord, 125 Grad West, Cascadia-Subduktionszone: Am Hydratrücken, einem Unterwassergebirge vor der Küste Oregons, ragen bizarre Kalkschlote mehrere Meter auf, an manchen Stellen sprudeln Methanblasen aus dem Boden, die sich erst 400 Meter weiter oben im Wasser auflösen."
                            },
                            {
                                "example_id": "3a261ee0-8c8c-4608-81d1-06de340f6033",
                                "sense_id": "53185e6b-7bff-3162-857f-f563e441ffdf",
                                "text": "Immer wieder verhaken sich in dieser Subduktionszone die Platten ineinander – Energie wird aufgestaut."
                            },
                            {
                                "example_id": "cad7723c-4fc3-4178-9130-3ebc4d81a48f",
                                "sense_id": "53185e6b-7bff-3162-857f-f563e441ffdf",
                                "text": "Der gesamte japanische Inselbogen hat so seinen Ursprung in der Philippinischen Platte, die in einer ausgeprägten Subduktionszone unter die kontinentale Platte im Osten Asiens abtaucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
