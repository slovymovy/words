                ],
                "senses": [
                    {
                        "sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                        "entry_id": "548d3db4-aa58-316a-a3a6-11acf465b4e9",
                        "glosses": [
                            "Qui provoque, qui cause le sommeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33398630-0013-416e-870d-fc7e410b3680",
                                "sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                                "text": "Le pavot est somnifère."
                            },
                            {
                                "example_id": "d40f90bf-a0cc-4ea5-9c60-b51ff5d74d37",
                                "sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                                "text": "Nous pensions également offrir à Lady Hurf des fleurs somnifères (en prenant garde de ne pas les respirer) pour lui subtiliser ses perles dès qu’elle dormirait !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb635115-31f4-4a10-8ff9-6e1b52b97675",
                        "source_entry_id": "548d3db4-aa58-316a-a3a6-11acf465b4e9",
                        "source_sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                        "target_lang_word": "einschläferrnd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7562792b-92a1-47a2-a9ca-19376bf6aef9",
                        "source_entry_id": "548d3db4-aa58-316a-a3a6-11acf465b4e9",
                        "source_sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                        "target_lang_word": "soporific",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soporific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34ba98c8-afb3-3c13-bd2a-3b8a2c2438e7",
                                        "entry_id": "41564ff6-70f3-3351-b053-87e0aee0bc69",
                                        "glosses": [
                                            "Something inducing sleep, especially a drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3d369d-f648-4aa5-9114-4c52be451fd3",
                                                "sense_id": "34ba98c8-afb3-3c13-bd2a-3b8a2c2438e7",
                                                "text": "The doctor prescribed a soporific to help the patient sleep."
                                            },
                                            {
                                                "example_id": "36c94706-a2d5-42bd-996b-b7f4f98106ec",
                                                "sense_id": "34ba98c8-afb3-3c13-bd2a-3b8a2c2438e7",
                                                "text": "And ancient soporifics—such as poisonous leaves and various opiate concoctions—were roughly as likely to kill you as they were to induce REM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acfeaeca-5326-349d-a7e0-b6d9100eeed7",
                                        "entry_id": "41564ff6-70f3-3351-b053-87e0aee0bc69",
                                        "glosses": [
                                            "Something boring or dull."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "soporific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec4d045-e7ee-3c53-b763-8f7abff84bb9",
                                        "entry_id": "5c03340e-9c96-32e9-be3f-703efb8d8a44",
                                        "glosses": [
                                            "Tending to induce sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928125b3-d620-4911-878e-84cf32cdce00",
                                                "sense_id": "4ec4d045-e7ee-3c53-b763-8f7abff84bb9",
                                                "text": "For we are not here to understand, as perhaps some have, that an author actually falls asleep while he is writing. It is true, that readers are too apt to be so overtaken; […]To say the truth, these soporific parts are so many scenes of serious artfully interwoven, in order to contrast and set off the rest;"
                                            },
                                            {
                                                "example_id": "9a2983e5-394d-403e-b027-8be236c51328",
                                                "sense_id": "4ec4d045-e7ee-3c53-b763-8f7abff84bb9",
                                                "text": "It is said that the effect of eating too much lettuce is “soporific.” I have never felt sleepy after eating lettuces; but then I am not a rabbit. They certainly had a very soporific effect upon the Flopsy Bunnies!"
                                            },
                                            {
                                                "example_id": "89204037-67a6-4a92-bd7f-70d282abad68",
                                                "sense_id": "4ec4d045-e7ee-3c53-b763-8f7abff84bb9",
                                                "text": "I should imagine that the smooth riding and the quietness of the diesel or electric cab, coupled with the effect on the eyes of endless successions of sleepers disappearing from sight immediately under the driver's eyes, might in time have a soporific effect, so that the company of a second man, who can assist in signal observations when he is not at work in the engine cab, seems highly desirable in such conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8462dbf5-ad40-3d1f-a730-46238f60db9a",
                                        "entry_id": "5c03340e-9c96-32e9-be3f-703efb8d8a44",
                                        "glosses": [
                                            "Boring, dull."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7153c99c-daff-442c-ac77-2daceb5550af",
                                                "sense_id": "8462dbf5-ad40-3d1f-a730-46238f60db9a",
                                                "text": "COP stands for conference of the parties under the UNFCCC, and the annual meetings have swung between fractious and soporific, interspersed with moments of high drama and the occasional triumph (the Paris agreement in 2015) and disaster (Copenhagen in 2009)."
                                            },
                                            {
                                                "example_id": "b758e61e-679f-4fac-a216-c131de609b42",
                                                "sense_id": "8462dbf5-ad40-3d1f-a730-46238f60db9a",
                                                "text": "The professor delivered a soporific lecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1146e6df-cd63-4d44-8fa1-6468d48523c8",
                        "source_entry_id": "548d3db4-aa58-316a-a3a6-11acf465b4e9",
