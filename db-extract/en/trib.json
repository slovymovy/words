                        ],
                        "examples": [
                            {
                                "example_id": "b8ea0598-57a1-4ea9-b0b7-05df82449edb",
                                "sense_id": "718211da-d64b-3d43-9162-50b4af46bd57",
                                "text": "They had tribbed often in the past, but never in this particular position, though Laura came slowly to realize that this was a natural for them"
                            },
