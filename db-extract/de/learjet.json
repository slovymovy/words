                ],
                "senses": [
                    {
                        "sense_id": "90eea394-3bdf-3510-ac65-77a4319dca39",
                        "entry_id": "d40f67b3-f48a-348d-a7af-7726e605c604",
                        "glosses": [
                            "Geschäftsreiseflugzeug der gleichnamigen Marke des Herstellers Bombardier Inc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9d3905b-f237-46f6-9a34-87e58e8ce6b0",
                                "sense_id": "90eea394-3bdf-3510-ac65-77a4319dca39",
                                "text": "„Um nur einmal mit Isadora Duncan plaudern zu können, würde meine Mom auf Reiseflughöhe den Notausstieg aufstoßen und aus unserem Learjet springen.“"
                            },
                            {
                                "example_id": "cf71b2e0-3e6c-4620-baa0-f629b6f1ae01",
                                "sense_id": "90eea394-3bdf-3510-ac65-77a4319dca39",
                                "text": "„Im Augenblick befand er sich auf einer Flughöhe von viertausenddreihundert Metern an Bord eines nicht mehr ganz jungen Learjets, der immer noch zuverlässig seinen Dienst verrichtete.“"
                            },
                            {
                                "example_id": "20e38d92-50dc-46ff-a453-e0a631cbbc88",
                                "sense_id": "90eea394-3bdf-3510-ac65-77a4319dca39",
                                "text": "„Eine dürftige Spur. Extrem dürftig, aber nicht zu dürftig für Langley, um den dicken CIA-Mann anzurufen, ihn aus dem Bett zu holen, in einen Learjet zu schubsen und mit ihm nach Mexiko zu düsen.“"
                            },
                            {
                                "example_id": "e9a0590f-502f-4546-83cb-c52e97b9a1af",
                                "sense_id": "90eea394-3bdf-3510-ac65-77a4319dca39",
                                "text": "„Er springt lautlos zu Boden, schleicht vorsichtig um ein paar Flugzeuge herum, bleibt alle paar Schritte stehen, um zu lauschen, und schließlich sieht er es: einer seiner Soldaten ist mit einem langen Speer aus Holz an den Rumpf eines Learjet genagelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
