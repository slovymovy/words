                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "юридическая охрана прав несовершеннолетних или недееспособных"
                            },
                            {
                                "target_lang_word": "попечительство",
                                "target_lang_sense_clarification": "форма правовой защиты несовершеннолетних старше 14 лет или ограниченно дееспособных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c5dd670-234a-3157-a4c5-74281eead060",
                    "sense_definition": "potocznie: instytucja lub urząd zajmujący się pomocą socjalną i wspieraniem potrzebujących",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instytucja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Franek chodzi co miesiąc do <w>opieki</w> po zasiłek dla bezrobotnych.",
                            "target_lang_translations": {
                                "ru": "Франек каждый месяц ходит в <w>собес</w> за пособием по безработице."
                            }
