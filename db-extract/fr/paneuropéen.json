                                        "glosses": [
                                            "das gesamte Europa betreffend, im gesamten Europa vorkommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100a7026-9754-4b30-bb61-cef0ac4b58f3",
                                                "sense_id": "acad56b8-8c99-3bce-9250-781f4e39047d",
                                                "text": "„Nach den Erfahrungen zweier verheerender Kriege in Europa lag es nahe, paneuropäische Gedanken aus den zwanziger Jahren wieder aufzugreifen, um eine Ordnung zu schaffen, die künftig Sicherheit, Frieden und Wohlstand garantiert.“"
                                            }
