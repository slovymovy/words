                                                "example_id": "68377965-7c3c-4f14-b138-cde94830a2b1",
                                                "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                                "text": "irritability of temper"
                                            },
                                            {
                                                "example_id": "e08ccc36-3a93-40a6-b0fd-7b7059eddddf",
                                                "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                                "text": "Blue No. 1 and yellow No. 6 may also be toxic to some human cells. And as little as 1 milligram of yellow dye No. 5 may cause irritability, restlessness and sleep disturbances for sensitive children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                                        "glosses": [
                                            "A natural susceptibility, characteristic of all living organisms, tissues, and cells, to the influence of certain stimuli, response being manifested in a variety of ways."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f0b6d0c-eaa6-47c6-87d3-8c8efe97b192",
                                                "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                                "text": "We find a renitency in ourselves to ascribe life and irritability to the cold and motionless fibres of plants."
                                            },
                                            {
                                                "example_id": "67512995-dc4c-47a9-99ac-90a1e34da714",
                                                "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                                "text": "There is growth only in plants; but there is irritability, or, a better word, instinctivity, in insects."
                                            }
                                        ]
