                    "sense_definition": "Versterkt een dreigement of waarschuwing",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wee</w> je gebeente als je dat nog eens durft te doen!",
                            "target_lang_translations": {
