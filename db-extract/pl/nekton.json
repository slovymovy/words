                                "target_senses": [
                                    {
                                        "sense_id": "880997ab-03d4-3c9f-95ce-bd7fb620b640",
                                        "entry_id": "c1672b6b-93e9-3b3f-8531-cb0f6570d303",
                                        "glosses": [
                                            "Faune marine qui nage, par opposition au plancton qui se laisse dériver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9541794d-ab9c-44bf-830a-8788b0e14f4f",
                                                "sense_id": "880997ab-03d4-3c9f-95ce-bd7fb620b640",
                                                "text": "Mais il convient encore de faire une discrimination, selon leur nature, entre les éléments habitant la masse des eaux ; on réserve en général le terme de plancton s. str. aux organismes flottant passivement ou à déplacements limités par rapport à ceux qui nagent et se déplacent sensiblement : Necton et aussi à ceux qui flottent à la surface même constituant le Neuston."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921af701-03fa-43a7-9ad4-12e86f089040",
                        "source_entry_id": "ff8a422a-b303-34f2-aae5-3ef9e41dd38e",
                        "source_sense_id": "687c66f2-fc36-383e-97d6-befdaf3625c0",
