                "translations": [
                    {
                        "translation_id": "1987c457-757a-41ec-81c4-02bbd2797d4e",
                        "source_entry_id": "3617884b-029c-36be-a48d-093fa87cf614",
                        "source_sense_id": "eb665739-0a71-3b99-affc-eb2364ff846a",
                        "source_sense_description": "het vermogen om het leven in te richten zonder hulp van anderen",
                        "target_lang_word": "Eigenständigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenständigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                        "entry_id": "d0ecc8fd-f814-3064-a03d-84e7a47a19bf",
                                        "glosses": [
                                            "Unabhängigkeit/Widerständigkeit gegen Einflüsse/Einwirkungen anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b12fae19-d32e-4ec9-99fa-461478a88d36",
                                                "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                                "text": "„Auch dort haben sich die Bewohner eine Eigenständigkeit bewahrt, die schon fast an Starrsinn erinnert.“."
                                            },
                                            {
                                                "example_id": "b4e8723e-2def-4fd5-af60-e33b73b405b2",
                                                "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                                "text": "„Gleichwohl aber wurde bis zu einem gewissen Grade eine Eigenständigkeit des Privaten und damit auch des privat-zwischenmenschlichen Diskurses bewahrt.“"
                                            },
                                            {
                                                "example_id": "b1741d92-6135-4332-8032-a5b7416ff208",
                                                "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                                "text": "„An ihrer kostbaren Eigenständigkeit halten sie fest, die reichen Nationen, wie ein Ertrinkender an seinem Goldbarren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ca7b7e4-3f66-445c-b20c-d48512090df1",
                        "source_entry_id": "3617884b-029c-36be-a48d-093fa87cf614",
                        "source_sense_id": "eb665739-0a71-3b99-affc-eb2364ff846a",
                        "source_sense_description": "het vermogen om het leven in te richten zonder hulp van anderen",
                        "target_lang_word": "Selbständigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbständigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5819929-3c3d-3728-864a-810db015a9b4",
                                        "entry_id": "40d7ade8-c80a-3e07-8dbd-fa4e12e9a5a5",
                                        "glosses": [
                                            "Möglichkeit, gewerbliche Arbeit hinsichtlich Art, Umfang und Zeit selbst bestimmen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f49897bb-84ca-462e-9e15-79a5bc42d009",
                                                "sense_id": "f5819929-3c3d-3728-864a-810db015a9b4",
                                                "text": "„Eine weitere Hilfe in der Gründungsphase bieten Fortbildungen, bei denen der Gründer das nötige Know-How für den Start in die Selbständigkeit vermittelt bekommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a660710-ea3c-3d3d-b68f-a3c8200988d1",
                                        "entry_id": "40d7ade8-c80a-3e07-8dbd-fa4e12e9a5a5",
                                        "glosses": [
                                            "Möglichkeit, eigenes Handeln selbst bestimmen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b453fa-b72f-4738-9066-69236c2df54b",
                                                "sense_id": "3a660710-ea3c-3d3d-b68f-a3c8200988d1",
                                                "text": "„Noch wichtiger aber ist, sein Kind von vornherein zur Selbständigkeit zu erziehen.“"
                                            },
                                            {
                                                "example_id": "4b517271-2757-44d9-9f1b-13e5ada69953",
                                                "sense_id": "3a660710-ea3c-3d3d-b68f-a3c8200988d1",
                                                "text": "„England, wie auch die anderen Kolonialmächte Europas, dachte ja auch nicht im entferntesten daran, seinen Kolonien Selbständigkeit zu gewähren, und widersetzte sich dieser Entwicklung mit allen seinen militärischen Mitteln.“"
                                            },
                                            {
                                                "example_id": "9d116849-72e8-4dcb-8306-f0573f3f1487",
                                                "sense_id": "3a660710-ea3c-3d3d-b68f-a3c8200988d1",
                                                "text": "„Das widerspricht eigentlich der Naturauffassung der modernen Naturwissenschaft, die die Natur als ein gesetzmäßiges Ganzes haben will, das keine endlichen Selbständigkeiten kennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6096834c-70c8-4809-af45-d5abf69058c1",
                        "source_entry_id": "3617884b-029c-36be-a48d-093fa87cf614",
                        "source_sense_id": "eb665739-0a71-3b99-affc-eb2364ff846a",
