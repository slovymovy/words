                                            {
                                                "example_id": "55886a3f-e62f-4d6d-8754-556b6ea46459",
                                                "sense_id": "d4e496c0-9001-3a7e-8622-2a1abd6c70c4",
                                                "text": "De as van sigaretten wordt opgevangen in een asbak."
                                            },
                                            {
                                                "example_id": "41d48e72-b0cb-4bcd-a582-89b3b7ff8bbd",
                                                "sense_id": "d4e496c0-9001-3a7e-8622-2a1abd6c70c4",
                                                "text": "As is verbrande turf zei oma altijd."
                                            },
                                            {
                                                "example_id": "a78826fa-f692-449d-bc53-5e500e3e9814",
                                                "sense_id": "d4e496c0-9001-3a7e-8622-2a1abd6c70c4",
                                                "text": "' Hij zuchtte en tikte de as van zijn sigaret in de asbak."
                                            },
                                            {
                                                "example_id": "e8efce54-24c1-4e25-8246-4efd56bb2c9b",
                                                "sense_id": "d4e496c0-9001-3a7e-8622-2a1abd6c70c4",
                                                "text": "Hij legt de klemtoon op het woord 'gebeurtenissen' want 'Arabische Lente' smaakt als as in zijn mond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f14260d-488c-371b-b1af-31fd12c1a7c2",
                                        "entry_id": "b30e489e-5f9b-3974-9741-f9f74be820c3",
                                        "glosses": [
                                            "overblijfsel van iets dat verbrand is",
                                            "verbrandingsresidu b.v. vliegas, potas, loodas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42df440-6258-412f-a89e-acb05a60aba1",
                                                "sense_id": "0f14260d-488c-371b-b1af-31fd12c1a7c2",
                                                "text": "De as van sigaretten wordt opgevangen in een asbak."
                                            },
                                            {
                                                "example_id": "b5bb5d86-1763-41fc-ad11-ef7301d8a8d9",
