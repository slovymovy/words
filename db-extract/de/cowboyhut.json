                "senses": [
                    {
                        "sense_id": "5e426a3e-d344-308c-a362-18c5e8c2c0ae",
                        "entry_id": "93bc6b7a-1567-34a7-be0d-832e6c1b91cc",
                        "glosses": [
                            "Hut mit weiter Krempe, wie er traditionell von Cowboys getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f5d4a4e-b4f2-4ca8-abce-4dcdb7ee0db1",
                                "sense_id": "5e426a3e-d344-308c-a362-18c5e8c2c0ae",
                                "text": "„Ein geschickter Schachzug, denn so wurde nicht nur die Bluesszene, sondern gleich auch die Rock- und Popwelt auf diesen jungen Gitarristen mit Cowboyhut, Schlangenlederschuhen, schnellen Fingern und markantem Gitarrenton aufmerksam.“"
                            },
                            {
                                "example_id": "f41d6f57-c0d8-4074-89d3-46b94509ec81",
                                "sense_id": "5e426a3e-d344-308c-a362-18c5e8c2c0ae",
                                "text": "„Auf dem einen hatte ich die rote Cowboyweste an und den Cowboyhut auf und zielte mit der Pistole an die Decke, das fand ich am besten.“"
                            },
                            {
                                "example_id": "113e3ee4-9398-41a3-819b-bd64c01c5643",
                                "sense_id": "5e426a3e-d344-308c-a362-18c5e8c2c0ae",
                                "text": "„Viele von ihnen tragen Cowboyhüte, Sheriffsterne, Spielzeugpistolen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
