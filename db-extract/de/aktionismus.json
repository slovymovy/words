                ],
                "senses": [
                    {
                        "sense_id": "cecabf62-ddbb-33ff-ad25-2e08adf32dda",
                        "entry_id": "773dbed6-1200-3012-9f78-29d9736d322b",
                        "glosses": [
                            "Entfaltung unangemessen vieler Aktivitäten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73e2ce6-ce09-4d9c-b8d2-e05f67b40d24",
                                "sense_id": "cecabf62-ddbb-33ff-ad25-2e08adf32dda",
                                "text": "„Er sagte, der Islam eigne sich nicht für politischen Aktionismus, und dass die Muslimbrüder den Begriff Dschihad zu eng interpretierten, denn Dschihad bedeute in erster Linie persönliche Anstrengung.“"
                            },
                            {
                                "example_id": "e1aceab5-9b91-48ec-9775-88e47cbe5e72",
                                "sense_id": "cecabf62-ddbb-33ff-ad25-2e08adf32dda",
                                "text": "„Solche Aktionismen gehören zu den rituellen Praxen des Übergangs von der Pause zum Unterricht, d.h. zu dem allen vertrauten Möglichkeitshorizont dieser Phase.“"
                            },
                            {
                                "example_id": "d10eecd4-402e-47e2-91d1-e818787f66d9",
                                "sense_id": "cecabf62-ddbb-33ff-ad25-2e08adf32dda",
                                "text": "„Seit Trumps öffentlicher Richterschelte fragen sich nicht nur politische Gegner, ob der rücksichtslose Aktionismus des neuen Präsidenten zu einer ernsthaften Krise der US-Verfassung führen könnte.“"
                            },
                            {
                                "example_id": "02d0ce6f-03ee-4be4-a401-df0f3df2f396",
                                "sense_id": "cecabf62-ddbb-33ff-ad25-2e08adf32dda",
                                "text": "„Das Handeln des Militärs gegenüber militanten Islamisten schwankt zwischen einer Laissez-faire-Politik und einem zur Schau gestellten Aktionismus.“"
                            },
                            {
                                "example_id": "30c0613e-e7b2-45f1-92bd-3beef550ad4c",
                                "sense_id": "cecabf62-ddbb-33ff-ad25-2e08adf32dda",
                                "text": "„Die Manie ist von Aktionismus geprägt: Der Erkrankte kann kaum einen Moment still sitzen, die Sprechgeschwindigkeit nimmt zu und es kommt zu schnellen Gedankensprüngen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
