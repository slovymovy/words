                        "target_lang_word": "superviser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superviser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4360e9-ee1e-3fc6-afbb-0e5d465f9b6e",
                                        "entry_id": "a40ed50a-1417-3a10-a8c0-a120d7a17299",
                                        "glosses": [
                                            "Effectuer un contrôle sur l’activité d’une ou de plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa2f097-5dea-483d-9790-0017c3f47b2f",
                                                "sense_id": "2a4360e9-ee1e-3fc6-afbb-0e5d465f9b6e",
                                                "text": "Alors que les employés travaillaient au projet, leur supérieur les supervisait."
                                            },
                                            {
                                                "example_id": "6163f227-7737-4885-9f4b-0961b9f87c58",
                                                "sense_id": "2a4360e9-ee1e-3fc6-afbb-0e5d465f9b6e",
                                                "text": "Koromindé s’était levé et il jetait un œil par-dessus mon épaule pour superviser ce que j’écrivais."
                                            },
                                            {
                                                "example_id": "4f26d8ab-3483-40de-bfbe-a857fdb2daa6",
                                                "sense_id": "2a4360e9-ee1e-3fc6-afbb-0e5d465f9b6e",
                                                "text": "Une bonne façon de superviser le travail de nos élèves est de circuler dans la classe parmi eux."
                                            },
                                            {
                                                "example_id": "9ea9f01f-9fb0-4adf-9a8a-2c002c67359d",
                                                "sense_id": "2a4360e9-ee1e-3fc6-afbb-0e5d465f9b6e",
                                                "text": "Le « New York Times » révèle que le président des États-Unis a même supervisé, la semaine dernière, une visite privée de la Maison-Blanche avec pour invités les responsables de la puissante association professionnelle du golf PGA Of America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e738a5d-8ecf-3593-a567-069bf37e21ea",
                                        "entry_id": "a40ed50a-1417-3a10-a8c0-a120d7a17299",
                                        "glosses": [
                                            "Effectuer un contrôle sur l’activité d’une machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7548d0-4899-4052-8520-0ab1dee492d8",
                                                "sense_id": "9e738a5d-8ecf-3593-a567-069bf37e21ea",
                                                "text": "Personne dans la voiture. Le conducteur est à l’extérieur, index posé sur son écran de téléphone pour signifier qu’il supervise l’opération et peut l’interrompre, au besoin, en soulevant son doigt. Simple question de responsabilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
