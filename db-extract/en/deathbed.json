    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                "word": "deathbed",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1dba3fe5-bd89-45c9-805f-107a3d29fc6f",
                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "tags": [
                            "plural"
                        ],
                        "form": "deathbeds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6af5f18-c886-3025-995b-02395dd56e30",
                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "glosses": [
                            "The bed on which someone dies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10e9a52-aad7-44c3-99c8-456381959225",
                                "sense_id": "b6af5f18-c886-3025-995b-02395dd56e30",
                                "text": "He was once on his way to an old woman, who was on her death-bed and who had led a wicked life."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ab84120-852d-30ab-b9a0-305fd8555564",
                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "glosses": [
                            "The last hours before death."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5a7f1e99-94cf-30ac-a574-bca876fb7985",
                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "glosses": [
                            "A grave; the site of a burial or entombment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deccc329-d850-4f6b-a423-3ff62422cde9",
                                "sense_id": "5a7f1e99-94cf-30ac-a574-bca876fb7985",
                                "text": "“Will you ask our oldest warriors to build me a barrow? Ask them to climb this headland and build me a death pile high on its top. Let my deathbed rise high above Hronesnesse.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08458ce1-ae8e-4277-a1ee-d23330ad3ff1",
                        "source_entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "source_sense_description": "the bed on which someone dies",
                        "target_lang_word": "sterfbed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sterfbed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e33145-a8be-33ec-9754-481e3173f715",
                                        "entry_id": "550e29e1-9d01-3b6f-825e-7bc19eba4c40",
                                        "glosses": [
                                            "het bed waarin / waarop men sterft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72bd137a-bf60-4a18-b82c-746095606a8e",
                                                "sense_id": "a9e33145-a8be-33ec-9754-481e3173f715",
                                                "text": "Op zijn sterfbed sprak hij zijn laatste woorden."
                                            },
                                            {
                                                "example_id": "8a163967-df44-4a7d-aa1e-8eae351b50c1",
                                                "sense_id": "a9e33145-a8be-33ec-9754-481e3173f715",
                                                "text": "Ik weet niet waar ik was gedurende die drie dagen dat ze op het bed lag dat uiteindelijk haar sterfbed zou worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f31506ab-2948-42f9-b0d6-8c863c30bae5",
                        "source_entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "source_sense_description": "the bed on which someone dies",
                        "target_lang_word": "doodsbed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doodsbed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a3935e35-583e-3a19-9abe-1b4d88e6e07f",
                                        "entry_id": "e550de0c-a111-3027-9b7a-0516a4463b5b",
                                        "glosses": [
                                            "het bed waarop / waarin iemand gestorven is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f6594d-9b66-4a52-b7d8-8c49fec46bd0",
                                                "sense_id": "a3935e35-583e-3a19-9abe-1b4d88e6e07f",
                                                "text": "Misschien wekte het beeld van haar doodsbed zo'n afschuw op dat mijn herinnering daaraan zich heeft losgerukt uit mijn geest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b525c369-e6b1-4fce-8c86-8775a597f783",
                        "source_entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "source_sense_description": "the bed on which someone dies",
                        "target_lang_word": "lit de mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lit de mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30707aa3-e584-3bed-a803-ae4817afbb98",
                                        "entry_id": "aa70445f-93b3-30e6-b178-0af5b5a8482e",
                                        "glosses": [
                                            "Lit sur lequel une personne meurt."
                                        ],
                                        "tags": [],
                                        "note": "Signifie le temps immédiatement avant la mort d’une personne, très souvent avec un adjectif possessif, non pas le lit lui-même",
                                        "examples": [
                                            {
                                                "example_id": "cb8ddc2a-d67c-4b5f-8b65-effcd9c4d837",
                                                "sense_id": "30707aa3-e584-3bed-a803-ae4817afbb98",
                                                "text": "Tu ne mourras pas en paix, répéta la voix ; même à ton lit de mort, tu te représenteras tes meurtres, les gémissements qui ont retenti dans ce château et le sang qui en rougit encore les murs."
                                            },
                                            {
                                                "example_id": "de1aab48-a815-42f8-8f3e-82f226f5ac60",
                                                "sense_id": "30707aa3-e584-3bed-a803-ae4817afbb98",
                                                "text": "Il y songeait dans ses victoires, dans ses harangues, dans ses discours, dans tous ses actes. À son lit de mort il y songeait encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f946b3d1-d813-4bcc-b061-81d362b35c27",
                        "source_entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "source_sense_description": "the bed on which someone dies",
                        "target_lang_word": "Sterbebett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sterbebett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                        "entry_id": "4a0e3e9e-e052-3aad-a2a5-150955113af5",
                                        "glosses": [
                                            "Bett eines Versterbenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af8b96e-8905-4034-8488-99cbbda75701",
                                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                                "text": "„Sein Schwager hielt bereits in der Kirche eine schöne Rede, in der er einen Wunsch des Verstorbenen erwähnte, den dieser noch auf dem Sterbebett zu Papier gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "f0cc0c90-4cb5-4cfc-a442-75990ef18253",
                                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                                "text": "„Sein Ziel war es, sich auf dem Sterbebett taufen zu lassen und als reines Christenkind gen Himmel zu fahren.“"
                                            },
                                            {
                                                "example_id": "c9e51594-fea8-41f0-a579-829ab0b4746a",
                                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                                "text": "„Und es ist nicht zu verwundern, daß ein eindrucksfähiger Kollege sogar noch auf dem Sterbebett um mehr solche Werke bittet.“"
                                            },
                                            {
                                                "example_id": "40b8f6ca-a91a-4d29-9bbb-00efceb0d8c8",
                                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                                "text": "„Klaus, mein Vater, war keine sechs Jahre alt, als er im Juni 1942 zusammen mit seiner zwei Jahre älteren Schwester am Sterbebett Abschied von ihm nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6a2d523-303c-4804-a516-455d33239804",
                        "source_entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                        "source_sense_description": "the bed on which someone dies",
                        "target_lang_word": "Totenbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totenbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9b89b1a-99d5-3451-adf5-112f9d92f477",
                                        "entry_id": "618e9520-2aca-3e2c-92a1-1bd8422ca9f9",
                                        "glosses": [
                                            "das Bett, auf dem ein Mensch im Sterben liegt oder auf dem ein Mensch bereits verstorben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ddc8395-e385-4b0c-b5af-45416e680b22",
                                                "sense_id": "b9b89b1a-99d5-3451-adf5-112f9d92f477",
                                                "text": "„Vier hatte noch nie einen Mann sterben sehen, aber Neun sah fast genauso aus wie die Fotos, die er von Männern auf dem Totenbett gesehen hatte, mit Augen, die sich in den Schädel zurückzogen wie eigenständige Wesen, die aufgaben, ehe der größere Kampf verloren war.“"
                                            },
                                            {
                                                "example_id": "0fee8a0b-4a6e-4c06-a8d5-0fec065f5b6e",
                                                "sense_id": "b9b89b1a-99d5-3451-adf5-112f9d92f477",
                                                "text": "„Tatsächlich heiratete er sie während des Karnevals und erhielt eine glänzende Mitgift; aber nach kaum einem Jahr starb das genasführte Fräulein an Kummer, und erst auf dem Totenbett verriet die Arme den Grund.“"
                                            },
                                            {
                                                "example_id": "fcab8bb0-01f5-4701-af87-99d1d6919599",
                                                "sense_id": "b9b89b1a-99d5-3451-adf5-112f9d92f477",
                                                "text": "„Im letzten Absatz des Romans sitzt Lohkamp am Totenbett der verlorenen Geliebten.“"
                                            },
                                            {
                                                "example_id": "290573fd-ec72-4867-b28a-34d86b2f6a8f",
                                                "sense_id": "b9b89b1a-99d5-3451-adf5-112f9d92f477",
                                                "text": "„Der Nachfolger Heinrichs VIII., König Eduard VI., ist gestorben, Heinrichs Testament verfügt, auf Eduard solle im Todesfalle Maria, die Katholische, folgen, aber Eduard, so sagt man, habe auf dem Totenbett seine Schwester Johanna zur Nachfolgerin bestimmt .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
