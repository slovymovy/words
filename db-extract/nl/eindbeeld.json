                        "entry_id": "986f04b2-36ba-354c-b1b7-6385bf25e63e",
                        "glosses": [
                            "van een park: hoe het park eruit ziet als de beplanting volwassen is"
                        ],
                        "tags": [],
                        "examples": []
                    }
