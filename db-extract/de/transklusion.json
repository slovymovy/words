                "senses": [
                    {
                        "sense_id": "45c9600a-b6c2-3601-9b9e-a5bbe7da899e",
                        "entry_id": "2d2070df-6e2e-351b-8dc4-bee0e83a33a1",
                        "glosses": [
                            "„Übernahme von einem elektronischen Dokument oder Teilen davon in ein oder mehrere andere Dokumente durch einen Hypertext-Verweis“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a52deb-b9ff-45b8-9858-5c70e65b4d68",
                                "sense_id": "45c9600a-b6c2-3601-9b9e-a5bbe7da899e",
                                "text": "„In der Repräsentation kann ein Client Links zur Navigation und Transklusion erkennen.“"
                            },
                            {
                                "example_id": "c2d0c6d8-91be-4ba5-b861-3979e61fe34c",
                                "sense_id": "45c9600a-b6c2-3601-9b9e-a5bbe7da899e",
                                "text": "„Gibt es ein monolithisches Frontend, das sich an allen Services bedient, oder werden verschiedene Oberflächen miteinander über Transklusion verbunden?“"
                            },
                            {
                                "example_id": "b01562b3-c790-4500-8bf5-762bd690e4b8",
                                "sense_id": "45c9600a-b6c2-3601-9b9e-a5bbe7da899e",
                                "text": "„Bei clientseitiger Integration wird die Transklusion nicht ausgeführt, wenn der andere Server nicht zur Verfügung steht.“"
                            },
                            {
                                "example_id": "8f589085-4141-4727-8af4-8854f5af48e7",
                                "sense_id": "45c9600a-b6c2-3601-9b9e-a5bbe7da899e",
                                "text": "„Die übergebene Funktion nimmt das Ergebnis der Transklusion entgegen und platziert ihn innerhalb des Templates mit den Möglichkeiten von jqLite bzw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "955d03a7-f5cf-4136-b00c-63007d660f5e",
                        "source_entry_id": "2d2070df-6e2e-351b-8dc4-bee0e83a33a1",
                        "source_sense_id": "45c9600a-b6c2-3601-9b9e-a5bbe7da899e",
                        "target_lang_word": "transclusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transclusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "416e4912-2c6e-38e5-aa7f-76f1e1541074",
                                        "entry_id": "3a2791b1-c73e-39d1-820a-b273c958eb62",
                                        "glosses": [
                                            "The inclusion of part of one hypertext document in another one by means of reference rather than copying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b1ebf5-d6ad-44c4-890a-1dac45fac821",
                                                "sense_id": "416e4912-2c6e-38e5-aa7f-76f1e1541074",
                                                "text": "Transclusion means that a thing can be in two places at once."
                                            },
                                            {
                                                "example_id": "f7cce2d9-49f7-474b-b9c7-3ddf24a00a86",
                                                "sense_id": "416e4912-2c6e-38e5-aa7f-76f1e1541074",
                                                "text": "The MediaWiki parser processes an article in two stages. The first stage is called preprocessing and is mainly involved with the transclusion of templates and the expansion of the Wikitext."
                                            },
                                            {
                                                "example_id": "e6aa431a-3eb7-4325-868e-6f76bdd138ce",
                                                "sense_id": "416e4912-2c6e-38e5-aa7f-76f1e1541074",
                                                "text": "Transclusion has always been a key component of the vision of hypermedia, ever since its earliest days (Nelson 1965). The term was originally used to denote the inclusion, by referential addressing, of part of one document within another; […]"
                                            },
                                            {
                                                "example_id": "a950cc4e-e4a7-418d-9fa2-38efd8761814",
                                                "sense_id": "416e4912-2c6e-38e5-aa7f-76f1e1541074",
                                                "text": "Directives that use transclusion are treated specially by the compiler in that the contents of the directive's elements are removed and provided via a transclusion function before their compile function is called."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
