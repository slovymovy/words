                "senses": [
                    {
                        "sense_id": "a5954b96-170f-3ef3-a24a-84a2dfcd3a95",
                        "entry_id": "d501743a-acb3-34a3-82f5-4b0a51f49ffb",
                        "glosses": [
                            "Provoquer l’ubiquitinylation (modification post-traductionnelle biochimique nécessitant plusieurs étapes pour aboutir in fine à la fixation covalente d’une ou de plusieurs protéines d’ubiquitine (8 kDa) sur une ou plusieurs lysines acceptrices de la protéine substrat)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02823ba1-b062-49aa-9cc6-d6235d63a536",
                                "sense_id": "a5954b96-170f-3ef3-a24a-84a2dfcd3a95",
                                "text": "La présente invention concerne l’utilisation et la détection de PCNA sumoylé et/ou ubiquitinylé dans la détection et la canalisation des voies de transaction de l’ADN à l’intérieur de cellules et de systèmes de type cellulaire."
                            },
                            {
                                "example_id": "4485fd56-e12e-4ecf-b16d-b01326af1d08",
                                "sense_id": "a5954b96-170f-3ef3-a24a-84a2dfcd3a95",
                                "text": "L’APC/C a la capacité d’ubiquitinyler des substrats variés à différentes phases de la mitose."
                            }
                        ]
                    }
