{
    "word_family": [
        "ensure",
        "ensurance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "171f7e0f-c3af-3731-a3e3-49831377e0a6",
                    "sense_definition": "A person or entity that makes sure or guarantees that something happens or is done.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "guarantor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager acts as an <w>ensurer</w> of quality standards across all departments.",
                            "target_lang_translations": {
                                "ru": "Менеджер выступает в качестве <w>гаранта</w> стандартов качества во всех отделах."
                            }
                        },
                        {
                            "text": "As an <w>ensurer</w> of safety, the inspector checks every piece of equipment daily.",
                            "target_lang_translations": {
                                "ru": "Как <w>обеспечитель</w> безопасности, инспектор ежедневно проверяет каждую единицу оборудования."
                            }
                        }
                    ],
                    "synonyms": [
                        "guarantor",
                        "warrantor"
                    ],
                    "common_phrases": [
                        "ensurer of safety",
                        "ensurer of quality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или организация, которые гарантируют, что что-либо произойдет или будет выполнено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарант",
                                "target_lang_sense_clarification": "лицо или организация, выступающие поручителем"
                            },
                            {
                                "target_lang_word": "обеспечитель",
                                "target_lang_sense_clarification": "тот, кто обеспечивает выполнение чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a69527c7-b07d-351b-a9fd-0a9f4af60da8",
                    "sense_definition": "An obsolete form of <w>insurer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older legal documents, the company is referred to as the <w>ensurer</w> of the property.",
                            "target_lang_translations": {
                                "ru": "В старых юридических документах компания упоминается как <w>страховщик</w> имущества."
                            }
                        },
                        {
                            "text": "The term <w>ensurer</w> was once commonly used to describe an insurer in maritime contracts.",
                            "target_lang_translations": {
                                "ru": "Термин <w>страховщик</w> когда-то часто использовался для описания страховой компании в морских контрактах."
                            }
                        }
                    ],
                    "synonyms": [
                        "insurer"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This spelling is no longer in standard use for this meaning."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова «страховщик»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страховщик",
                                "target_lang_sense_clarification": "устаревшее написание в юридическом контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}