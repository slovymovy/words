                                        "glosses": [
                                            "Boîte en carton mince servant à la protection des marchandises pendant la manutention, le transport et le stockage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64661625-eeb4-40c9-9438-b16e79643401",
                                                "sense_id": "7420965d-ee15-35f7-a284-ba8d897e0ed2",
                                                "text": "Le remplissage des cartonnages."
