                "senses": [
                    {
                        "sense_id": "b6a32e1f-21bb-3e7d-beff-2e3adc577f8b",
                        "entry_id": "1dee242e-beb6-3ff7-b56b-74267050b4ee",
                        "glosses": [
                            "Attribuer à quelqu’un (en particulier un enfant) un rôle dévolu aux parents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75cd710c-705f-4840-82d6-c25b0c52eed0",
                                "sense_id": "b6a32e1f-21bb-3e7d-beff-2e3adc577f8b",
                                "text": "Nous avons tous accumulé une certaine mesure de légitimité destructive. Il est donc compréhensible que nous ayons tendance à parentifier nos enfants."
                            },
                            {
                                "example_id": "bb54917a-7b4d-4881-8019-53924c6db713",
                                "sense_id": "b6a32e1f-21bb-3e7d-beff-2e3adc577f8b",
                                "text": "Encouragé de la sorte, l’enfant risque de mettre de côté ses propres besoins de soutien affectif et de se « parentifier », en vue de remplacer l’absent."
                            },
                            {
                                "example_id": "0eacdbc3-cd9b-4f5a-9806-3714373650aa",
                                "sense_id": "b6a32e1f-21bb-3e7d-beff-2e3adc577f8b",
                                "text": "Enfant, quand j'appelais les secours en préparant ses sacs pour l'hôpital, les intervenants jugeaient que j'étais parentifié. Quels cons!"
                            }
                        ]
                    }
