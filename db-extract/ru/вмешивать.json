                        "cross_references": [
                            {
                                "target_word": "mix up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d103f88-de8d-3711-a01e-3a869ece9690",
                                        "entry_id": "dc28f6fc-a03b-36fb-9944-04b6c3dd44a0",
                                        "glosses": [
                                            "To mix or blend thoroughly and completely."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8c2a64-c731-4ac1-adc2-631aafd3ffe4",
                                                "sense_id": "0d103f88-de8d-3711-a01e-3a869ece9690",
                                                "text": "She mixed up peat moss, humus, and compost to make potting soil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ee77e7e-0808-35da-8533-71d9b73ad886",
                                        "entry_id": "dc28f6fc-a03b-36fb-9944-04b6c3dd44a0",
                                        "glosses": [
                                            "To combine thoroughly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3100edf-8caf-496b-ae8e-962d74d89285",
                                                "sense_id": "7ee77e7e-0808-35da-8533-71d9b73ad886",
                                                "text": "All the smells of the food had mixed up together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0fbf1ae-e325-3612-b875-119e9b1bfa73",
                                        "entry_id": "dc28f6fc-a03b-36fb-9944-04b6c3dd44a0",
                                        "glosses": [
                                            "To prepare something from ingredients that are mixed."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b216ee09-1eed-417d-9f39-eb3e6e4d7f9a",
                                                "sense_id": "f0fbf1ae-e325-3612-b875-119e9b1bfa73",
                                                "text": "She mixed up a batch of her own potting soil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c00322-7175-3f4d-b62c-df11308f52cf",
                                        "entry_id": "dc28f6fc-a03b-36fb-9944-04b6c3dd44a0",
                                        "glosses": [
                                            "To confuse or reverse."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d5d637c-84c7-4819-a381-ed3d73952c52",
                                                "sense_id": "b7c00322-7175-3f4d-b62c-df11308f52cf",
                                                "text": "I always mix up Vermont and New Hampshire on a map."
                                            },
                                            {
                                                "example_id": "37ce8f44-4923-4b41-937f-bf44fc79909c",
                                                "sense_id": "b7c00322-7175-3f4d-b62c-df11308f52cf",
                                                "text": "I always mix up Jack with Jake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf852ef-9d6c-3f0c-a3c9-42848fd1691f",
                                        "entry_id": "dc28f6fc-a03b-36fb-9944-04b6c3dd44a0",
                                        "glosses": [
                                            "To become involved with, especially socially or romantically."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fef838-a6fc-4e5f-948f-b016f6b0b790",
                                                "sense_id": "edf852ef-9d6c-3f0c-a3c9-42848fd1691f",
                                                "text": "He got mixed up with a bad crowd."
                                            },
                                            {
                                                "example_id": "382ee634-a2d3-41f4-bcbc-c96c9f39d57b",
                                                "sense_id": "edf852ef-9d6c-3f0c-a3c9-42848fd1691f",
                                                "text": "Then he got mixed up with an older woman."
                                            },
                                            {
                                                "example_id": "19e1de4e-8644-4f99-bb5b-d7677905c69e",
                                                "sense_id": "edf852ef-9d6c-3f0c-a3c9-42848fd1691f",
                                                "text": "Now, he's mixed up with some half-baked religion."
                                            },
                                            {
                                                "example_id": "979b5300-c555-4c37-a9f5-e23d41f58599",
                                                "sense_id": "edf852ef-9d6c-3f0c-a3c9-42848fd1691f",
                                                "text": "Hey! What're you gonna do? Nice college boy, huh? Didn't want to get mixed up in the family business. Now you want to gun down a police captain. Why? 'Cause he slapped you in the face a little bit?"
                                            },
                                            {
                                                "example_id": "432c3bb7-972c-41e2-9fe3-a9e50ece37e2",
                                                "sense_id": "edf852ef-9d6c-3f0c-a3c9-42848fd1691f",
                                                "text": "KEELHAUL KEY!? That's that cursed island! Don't get mixed up with that place, for your own sake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e6d3f1-2c17-353e-9e5e-66b76879d93b",
                                        "entry_id": "dc28f6fc-a03b-36fb-9944-04b6c3dd44a0",
                                        "glosses": [
                                            "To shuffle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1efbee8-d792-489b-8fe1-d7e0c0a55a92",
                                                "sense_id": "29e6d3f1-2c17-353e-9e5e-66b76879d93b",
                                                "text": "mix up this Rubik's cube"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mix up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4b5bec-0094-358f-aa99-e5aa78c1d560",
                                        "entry_id": "1b0733c4-a735-3b79-9bd6-a77b128df3ef",
                                        "glosses": [
                                            "A mix, blend, or variety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdede8a4-bf89-4957-aa65-6bb511d356bc",
                                                "sense_id": "5e4b5bec-0094-358f-aa99-e5aa78c1d560",
                                                "text": "Next time, let's ask a group with a different mix up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f29f0775-a8c0-3194-849e-b26ede971875",
                                        "entry_id": "1b0733c4-a735-3b79-9bd6-a77b128df3ef",
                                        "glosses": [
                                            "A confusion or reversal."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61b0bc06-999a-4f5f-b954-c7e7ee66cc44",
                                                "sense_id": "f29f0775-a8c0-3194-849e-b26ede971875",
                                                "text": "I refuse to send them any more money until they fix this mix up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d92c650d-283b-4237-ac4a-f4134754bd1c",
                        "source_entry_id": "dcf01959-1260-3357-9b4c-f29d94878d71",
                        "source_sense_description": "заставлять участвовать",
                        "target_lang_word": "implicate",
