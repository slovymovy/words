                "senses": [
                    {
                        "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                        "entry_id": "ee34e7b3-68fa-33e3-bbeb-cec03c965afe",
                        "glosses": [
                            "Schnaps, hergestellt unter Verwendung von Anis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8acb1aa-8c23-4868-9e91-83751044ed9b",
                                "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                "text": "Komm doch mal auf ein Gläschen Anisschnaps vorbei."
                            },
                            {
                                "example_id": "f0d722ff-3b8f-40c1-af19-679fbc5e371c",
                                "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                "text": "„Diese leichte Konversation unterhielt uns bis zum Nachtisch, einer katalanischen Creme mit Zimt; dann tranken wir einen Anisschnaps.“"
                            },
                            {
                                "example_id": "cccc7081-bd6d-41f7-9b18-a3075004230f",
                                "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                "text": "„Seine Geschichten beendete er gerne mit einer Runde Anisschnaps für alle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
