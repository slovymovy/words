                    },
                    {
                        "translation_id": "90b5be66-603b-4fdd-ad4c-154d7b33f2d2",
                        "source_entry_id": "6eb46c3e-a7e9-3513-9a22-c40cdda7bd40",
                        "source_sense_description": "dance",
                        "target_lang_word": "по́лька",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "по́лька",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3b7e93-85d2-38b9-88a2-ce4dd7fafe11",
                                        "entry_id": "5fc68f86-71d3-3fa2-84c4-a1298b4ca297",
                                        "glosses": [
                                            "женск. к поляк; жительница или уроженка Польши"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14d75a3-5c32-4d9c-afee-9582a7bad5fd",
                                                "sense_id": "bd3b7e93-85d2-38b9-88a2-ce4dd7fafe11",
                                                "text": "Гостиница довольно чистая, содержала её вдова, полька, пани Янжвецкая."
                                            },
                                            {
                                                "example_id": "d33d3a14-7c42-477f-a141-0fca07635d24",
                                                "sense_id": "bd3b7e93-85d2-38b9-88a2-ce4dd7fafe11",
                                                "text": "Властная полька, католичка \"полесская ведьма\" прокляла сына, променявшего Польшу на советскую девушку, с которой ключик даже не был обвенчан или, в крайнем случае, зарегистрирован."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "по́лька",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f339eb05-75eb-361b-b344-8e1f59151933",
                                        "entry_id": "f7f747ba-7952-3c97-966e-0c5969016683",
                                        "glosses": [
                                            "хореогр. быстрый танец с прыжками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb5fd21-2463-4969-8407-b4750d2a0ba9",
                                                "sense_id": "f339eb05-75eb-361b-b344-8e1f59151933",
                                                "text": "Танцевать польку."
                                            },
                                            {
                                                "example_id": "9997060b-d749-4ce5-af08-e1f83c4052e5",
                                                "sense_id": "f339eb05-75eb-361b-b344-8e1f59151933",
                                                "text": "Краковяк, зародившийся в Кракове XIV века, мог включать как шаги мазурки, так и вальса, польки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256e96fe-6c3f-387e-9e20-449343303fcc",
                                        "entry_id": "f7f747ba-7952-3c97-966e-0c5969016683",
                                        "glosses": [
                                            "муз. музыка для такого танца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4647ef-948e-4536-8237-af297e32e2a4",
                                                "sense_id": "256e96fe-6c3f-387e-9e20-449343303fcc",
                                                "text": "Композитор написал красивую польку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f80f118-70db-3648-a757-cec68428ba6d",
                                        "entry_id": "f7f747ba-7952-3c97-966e-0c5969016683",
                                        "glosses": [
                                            "парикмах. короткая мужская стрижка с выбритыми висками и затылком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40ae304-2024-4d79-946b-d144c755d225",
                                                "sense_id": "4f80f118-70db-3648-a757-cec68428ba6d",
                                                "text": "Мужские причёски подверглись влиянию армейских стрижек различных стран и начинаясь с «ноля», но постепенно удлинялся верх к затылку, — причёска называлась «полька». Между «боксом» и «полькой» располагается «полубокс»."
                                            },
                                            {
                                                "example_id": "379a0242-e635-4a70-8f54-b6d98a491a9e",
                                                "sense_id": "4f80f118-70db-3648-a757-cec68428ba6d",
                                                "text": "Довольно часто пожилые мужчины прибегают к давно известным несложным стрижкам «Бокс», «Полубокс», «Полька»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fd29819-dbef-3b7e-be6f-e39753f7b056",
                                        "entry_id": "f7f747ba-7952-3c97-966e-0c5969016683",
                                        "glosses": [
                                            "воен. жарг. 60-мм малошумный миномёт или мина к такому миномёту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc94f47-d0b7-4410-8e93-c318bee59cfb",
                                                "sense_id": "9fd29819-dbef-3b7e-be6f-e39753f7b056",
                                                "text": "Это ни с чем несравнимое чувство, когда тебя сначала обстреливает танк, далее передышка 15 минут, начинает бить полька (миномет 60 мм, не слышно вылет снаряда, а лишь свист и взрыв прилета), СПГ, работает 120-мм миномет, и все по новой."
                                            },
                                            {
                                                "example_id": "e2d0fc44-649c-4b25-a02a-81e74f95552e",
                                                "sense_id": "9fd29819-dbef-3b7e-be6f-e39753f7b056",
