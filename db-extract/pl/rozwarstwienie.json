                            {
                                "example_id": "929f203a-03d3-4337-b2b1-bb4e48204af5",
                                "sense_id": "c1d140fe-26c1-32d2-a7a8-d8c5a7934dfa",
                                "text": "Na to odmienne rozwarstwienie polszczyzny i czeszczyzny wpłynęła inna historia obu języków."
                            },
                            {
                                "example_id": "c654b87b-ac89-4173-9526-512ae3517fd4",
                                "sense_id": "c1d140fe-26c1-32d2-a7a8-d8c5a7934dfa",
                                "text": "Owszem, bardzo szybkie przemiany zrodziły napięcia, rozwarstwienie społeczne i kult sukcesu finansowego, wyrażanego pojęciem „mamonizm”."
                            }
