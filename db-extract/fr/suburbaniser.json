                "senses": [
                    {
                        "sense_id": "d69e31ef-14e8-365d-b110-00bf9bbbd75a",
                        "entry_id": "b519670b-74f3-3fc0-b386-01577eb906c0",
                        "glosses": [
                            "Donner un caractère suburbain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76c896f-d79b-46c3-b2cd-027263770365",
                                "sense_id": "d69e31ef-14e8-365d-b110-00bf9bbbd75a",
                                "text": "Chez Carol Aronovici, par exemple, la pastorale se transforme ainsi en argument de combat contre les anciennes méthodes de la réforme : le tenement n’est pas réformable, affirment-ils, il faut tout simplement l’éliminer et «suburbaniser les ouvriers»."
                            },
                            {
                                "example_id": "b1d71d95-59b4-4fb0-ad07-93cc237d7d45",
                                "sense_id": "d69e31ef-14e8-365d-b110-00bf9bbbd75a",
                                "text": "En effet, il ne demeure, au sein de la ville qu’une partie de la minorité noire, celle qui n’a pu se suburbaniser et à laquelle ne restent que des emplois peu qualifiés et les moins bien rémunérés."
                            }
                        ]
                    }
