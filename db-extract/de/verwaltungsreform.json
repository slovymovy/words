                "senses": [
                    {
                        "sense_id": "f4c2d48e-8225-3871-bbc5-4ce5956ba15d",
                        "entry_id": "7b86ceaa-1f73-32ca-9868-ac78be332cb6",
                        "glosses": [
                            "Umgestaltung der Verwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba3e1ada-688b-4528-9f54-d982c52ad6a7",
                                "sense_id": "f4c2d48e-8225-3871-bbc5-4ce5956ba15d",
                                "text": "„Im Frühjahr 1810 erhält das Bamberger Theater eine neue Verwaltungsreform; es wird von einer Aktiengesellschaft geleitet, die die Direktion an Franz von Holbein übergibt, einem alten Bekannten Hoffmanns aus seinem ersten Berliner Aufenthalt.“"
                            },
                            {
                                "example_id": "d4e5845c-6d97-4a73-91ec-5197a86b8469",
                                "sense_id": "f4c2d48e-8225-3871-bbc5-4ce5956ba15d",
                                "text": "„Friedrich Wilhelm I. war es auch, der das Land durch Verwaltungs- und Militärreformen modernisierte.“"
                            },
                            {
                                "example_id": "5d27d272-a53f-4aaa-b849-c59942d41990",
                                "sense_id": "f4c2d48e-8225-3871-bbc5-4ce5956ba15d",
                                "text": "„Gawan hatte mit gewissem Erfolg eine zentrale Verwaltungsreform eingeführt, aber gerade dadurch den Widerstand der Großen des Reichs erregt, die an seiner Hinrichtung nicht unschuldig waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
