                "senses": [
                    {
                        "sense_id": "2e1751df-7362-327a-9c43-4195e687da78",
                        "entry_id": "e47e6728-b9f7-3fb0-b7ac-bb11bcd71b64",
                        "glosses": [
                            "teveel beheerst worden door seksuele lustgevoelens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61ea3f8-edc1-49c5-b47b-55d17b00cadb",
                                "sense_id": "2e1751df-7362-327a-9c43-4195e687da78",
                                "text": "Uw tuin is één oversekste toestand, zeker als er mezen wonen, de grootste schuinsmarcheerders van het vogelrijk. En die merel die daar zo verleidelijk fluit: let op, straks zet zijn wijfje de scheiding in."
                            }
                        ]
                    },
                    {
                        "sense_id": "eebb681d-944a-38bd-965f-44214a145fc8",
                        "entry_id": "e47e6728-b9f7-3fb0-b7ac-bb11bcd71b64",
                        "glosses": [
                            "met teveel veel aandacht voor seks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edf8182a-3e49-4068-a3da-b3758e68be19",
                                "sense_id": "eebb681d-944a-38bd-965f-44214a145fc8",
                                "text": "Sterker nog, Nederland is eerder nog te bekrompen als het om seks gaat, dan ‘oversekst’. Immers, er zijn nog altijd meer kerken dan sekspaleizen. Serieuze media kennen wel kunst- maar geen seksbijlagen. Scholen geven meer sport- dan sekslessen. En allochtonen worden meestal op een religieuze, maar nooit op hun seksuele burgerschap aangesproken. Hoezo oversekst?"
                            }
                        ]
                    }
