                                "target_senses": [
                                    {
                                        "sense_id": "bade7a5e-7824-36fd-ac59-7b712fb3865e",
                                        "entry_id": "28797128-0bbd-386a-987b-b36e596f6e07",
                                        "glosses": [
                                            "kleines Haar an den Augenlidern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eeeef56-c6ff-434d-9310-e59b356148a7",
                                                "sense_id": "bade7a5e-7824-36fd-ac59-7b712fb3865e",
                                                "text": "Ich glaube, ich hab eine Wimper im Auge."
                                            },
                                            {
                                                "example_id": "18875ea6-e9d8-4b70-b6bd-7d072585e274",
                                                "sense_id": "bade7a5e-7824-36fd-ac59-7b712fb3865e",
                                                "text": "„Mascara betont die Wimpern, indem es sie länger und voluminöser erscheinen lässt, die Wimpernzange zaubert einen verführerischen Schwung hinein, der Millionizer macht aus einer Wimper eine Million davon und künstliche Wimpern (Fake Lashes) erlauben Formen, wie sie trotz aller Hilfsmittel mit der natürlichen Ausstattung nicht zu erreichen sind.“"
                                            },
                                            {
                                                "example_id": "d9f3894f-e2d4-4f5b-bab1-2d5061834d7e",
                                                "sense_id": "bade7a5e-7824-36fd-ac59-7b712fb3865e",
                                                "text": "„Ihre Wimpern waren vor lauter Wimperntusche verklebt.“"
                                            },
                                            {
                                                "example_id": "e95b49c1-6753-4e77-b86b-e2c389df76c5",
                                                "sense_id": "bade7a5e-7824-36fd-ac59-7b712fb3865e",
                                                "text": "„Große dunkelbraune Augen waren es gewesen, mit so dichten schwarzen Wimpern, dass jede Frau darauf hätte neidisch werden können.“"
                                            },
                                            {
                                                "example_id": "e32156c3-b916-43b1-b73f-9dabdea1dd83",
                                                "sense_id": "bade7a5e-7824-36fd-ac59-7b712fb3865e",
                                                "text": "„Den Kopf hatte sie zurückgeworfen, und unter den gesenkten Wimpern hervor schaute sie ihn an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f08d6b75-f356-3859-91f3-1e5959b13aee",
                                        "entry_id": "28797128-0bbd-386a-987b-b36e596f6e07",
                                        "glosses": [
                                            "bei einigen Protozoa bewegliche Fortsätze zur Fortbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f365cfc-499f-4bb1-ac71-4072ee23302e",
                                                "sense_id": "f08d6b75-f356-3859-91f3-1e5959b13aee",
                                                "text": "„Jede Wimper einer Zilienreihe schlägt gegenüber der vorhergehenden um einen Bruchteil später.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
