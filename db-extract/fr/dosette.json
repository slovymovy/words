                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d5bbf4-8b83-4651-bbe8-c8173cf36b20",
                                                "sense_id": "b431b321-da9f-3a34-80c2-2124ed8a9cdb",
                                                "text": "A sleeping, silver-haired man, probably about fifty, couldn’t close his legs because of the size of his packet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a337ec-8ede-37f3-b7f1-7869360ed0fe",
                                        "entry_id": "1262f47d-8e89-30f8-9044-2a67cdde80aa",
                                        "glosses": [
                                            "A large amount of money."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
