                "senses": [
                    {
                        "sense_id": "730ae9d2-f95f-3045-8e23-9004d219a3e3",
                        "entry_id": "b621db3d-ab63-3ccb-b49e-4e861751b9ce",
                        "glosses": [
                            "Action d’emmagasiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093d83f0-04f4-428b-bf11-828f0807303e",
                                "sense_id": "730ae9d2-f95f-3045-8e23-9004d219a3e3",
                                "text": "L’approvisionnement de fourrures était considérable, et il devenait nécessaire d’établir un local spécialement destiné à l’emmagasinage des pelleteries."
                            },
                            {
                                "example_id": "f4794296-8721-4ea5-9cee-cba4b6bab37a",
                                "sense_id": "730ae9d2-f95f-3045-8e23-9004d219a3e3",
                                "text": "De là, on le renvoya aider à l’emmagasinage des bombes dans les soutes du Zeppelin , — besogne qui exigeait un soin minutieux."
                            },
                            {
                                "example_id": "efcb0b3e-437a-4bdf-98a8-268f831dac6e",
                                "sense_id": "730ae9d2-f95f-3045-8e23-9004d219a3e3",
                                "text": "On peut munir le châssis d’une poignée, si on veut se servir de l’appareil pour un emmagasinage horizontal dans un meuble spécial."
                            }
                        ]
                    }
                ],
