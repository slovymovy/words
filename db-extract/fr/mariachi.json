                "senses": [
                    {
                        "sense_id": "c53a5e10-14e2-3583-8ceb-d60db72cc8b2",
                        "entry_id": "720523d4-84b4-3722-b940-a3f5c2679bab",
                        "glosses": [
                            "Formation musicale originaire du Mexique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2d5930da-00e1-3d12-8c4e-0cd000604617",
                        "entry_id": "720523d4-84b4-3722-b940-a3f5c2679bab",
                        "glosses": [
                            "Style de musique et culture musicale associés à ce type de formations musicales."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "651fedef-1a07-40db-9679-f2050007dfcf",
                                "sense_id": "2d5930da-00e1-3d12-8c4e-0cd000604617",
                                "text": "Un groupe de mariachis est constitué au moins de deux violons, deux trompettes, un joueur de guitare espagnole, un vihuela et d’un guitarron. Certaines formations comportent plusieurs dizaines de musiciens."
                            },
                            {
                                "example_id": "7a298fbc-e42a-4fc1-9dd8-ee9482548f2f",
                                "sense_id": "2d5930da-00e1-3d12-8c4e-0cd000604617",
                                "text": "Le « pays de naissance » des mariachis est la ville de Guadalajara au Mexique."
                            },
                            {
                                "example_id": "a4037deb-4dde-4088-96e8-3c270e2177f6",
                                "sense_id": "2d5930da-00e1-3d12-8c4e-0cd000604617",
                                "text": "Plus qu’un simple style musical, il existe une véritable culture du mariachi ayant ses racines dans la culture « charro », les « cow-boys » mexicains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
