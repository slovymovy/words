                                        "glosses": [
                                            "An abrupt, high-pitched noise or utterance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c56610-9ce6-4230-9321-7abea8463740",
                                                "sense_id": "a627efc1-b4f2-308e-9687-d9f1e5296004",
                                                "text": "The puppy let out a yelp when I stepped on her tail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2e4e59-679b-3416-bef3-bf470534c333",
