                        "examples": [
                            {
                                "example_id": "f771bcc7-62f0-4acf-a87f-e65995410e70",
                                "sense_id": "00b1cf21-a3cc-3f20-b7d6-dd7743d9c126",
                                "text": "Gdy jednakże wchodził już do pokoju pana swego, pułkownikowa wyszła drzwiami bocznemi, a opiekun wraz z wychowańcem pozostał sam na sam"
                            },
                            {
                                "example_id": "035a8b8f-08ee-4221-9643-7b5141059356",
                                "sense_id": "00b1cf21-a3cc-3f20-b7d6-dd7743d9c126",
                                "text": "Wczoraj miało miejsce spotkanie się b. wychowańców b. Szkoły Głównej, którzy 10 lat temu, a zatem w r. 1870, ukończyli wydział medyczny"
                            }
