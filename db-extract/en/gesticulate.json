                "senses": [
                    {
                        "sense_id": "d529b48a-026d-3b06-831b-cc10bc942401",
                        "entry_id": "d045c931-e340-3eaf-905e-caae3a9a962f",
                        "glosses": [
                            "To make gestures or motions, as in speaking."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0f3b524-b143-4477-93fe-532c2161ed66",
                                "sense_id": "d529b48a-026d-3b06-831b-cc10bc942401",
                                "text": "A \"Haka\" is the native dance, answering to the corroboree of the Australian aboriginals, and we were anxious to see it. […] Later in the evening, however, the complaisant Herekiekie entertained a small and select party at a \"Haka\" in his \"whare\" or house (pronounced wharry). It was exactly what I expected. The performers, all male, stood in a row, one, slightly advanced, acting as fugleman. They shouted and gesticulated with the most hideous and revolting gestures, grimaces, and yells."
                            },
                            {
                                "example_id": "6e38a5b2-d647-4aed-8592-03ea82551374",
                                "sense_id": "d529b48a-026d-3b06-831b-cc10bc942401",
                                "text": "... groups of dancers were wheeling, plunging, and gesticulating while the ogre, more aphasic than before, mumbled at full strength ..."
                            },
                            {
                                "example_id": "bc54105d-01fb-4f83-b1fa-9227ace09296",
                                "sense_id": "d529b48a-026d-3b06-831b-cc10bc942401",
                                "text": "He's delusional, and obsessed with a girl named Claire, and he says such things as: \"I know she loves me, she just doesn't know it yet.\" And he gesticulates wildly, as though he were a fop in the court of Louis XIV."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0058262-6cb7-38b6-9ea4-7d59a0ee2e73",
                        "entry_id": "d045c931-e340-3eaf-905e-caae3a9a962f",
                        "glosses": [
                            "To say or express through gestures."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1b2b7b1d-0f8e-4d08-8057-b67ee97950e6",
                                "sense_id": "f0058262-6cb7-38b6-9ea4-7d59a0ee2e73",
                                "text": "[…]the TV programme Friends is influencing not only the way Irish people speak but also how they gesticulate. Now almost every utterance is accompanied by arms outstretched and palms turned upwards.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "314dd0dc-5e09-4650-aabd-a50fec4af1be",
                        "source_entry_id": "d045c931-e340-3eaf-905e-caae3a9a962f",
                        "source_sense_description": "to make gestures",
                        "target_lang_word": "gesticuler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gesticuler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13c3f597-c14c-3d5e-871e-29696e1cfd66",
                                        "entry_id": "fbea5827-e298-303c-b4bd-973cf0147468",
                                        "glosses": [
                                            "Faire trop de gestes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d30cf7-5ddd-4597-8dad-889b33868fa4",
                                                "sense_id": "13c3f597-c14c-3d5e-871e-29696e1cfd66",
                                                "text": "Oui, tenez, celui qui gesticule en parlant, et dont la voix est un peu criarde, c’est M. d’Alembert, le secrétaire perpétuel de l’Académie française."
                                            },
                                            {
                                                "example_id": "2bd649f5-9f0e-4f40-9076-3e87dc3070cc",
                                                "sense_id": "13c3f597-c14c-3d5e-871e-29696e1cfd66",
                                                "text": "En arrivant en face du parapluie, [le cheval] eut peur, se cabra et voulut revenir sur ses pas ; mais il me vit, gesticulant comme un télégraphe et criant comme un sauvage. Se voyant pris entre deux feux, il s’échappa en bondissant sur la rampe qui l’avait tant effrayé."
                                            },
                                            {
                                                "example_id": "f4377b7d-d943-43f2-8ba5-3283ab42dcc6",
                                                "sense_id": "13c3f597-c14c-3d5e-871e-29696e1cfd66",
                                                "text": "Les machinistes prenaient leurs postes, les figurants se massaient en reculant vers le troisième plan, et le régisseur gesticulait pour accélérer la manoeuvre."
                                            },
                                            {
                                                "example_id": "c4b936d4-9397-4141-b57a-44eb1b124c44",
                                                "sense_id": "13c3f597-c14c-3d5e-871e-29696e1cfd66",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            },
                                            {
                                                "example_id": "96b55ed4-c113-4a2a-bb06-246e25c88ba2",
                                                "sense_id": "13c3f597-c14c-3d5e-871e-29696e1cfd66",
                                                "text": "Ah! cette ville imbécile et mortelle […]. Elle prend des aspects de nécropole où les macchabées folâtres auraient licence de grimacer et de gesticuler sous un ciel putride, gonflé comme un égout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae514244-190b-4320-8552-f81d639e1926",
                        "source_entry_id": "d045c931-e340-3eaf-905e-caae3a9a962f",
