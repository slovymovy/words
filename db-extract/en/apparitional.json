                        "glosses": [
                            "Of or pertaining to an apparition or apparitions"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4517fa2-1968-45d9-a989-c744c7e67a65",
                                "sense_id": "07c05e63-a836-321c-be93-e85946f08cc6",
                                "text": "People enough, first and last, had been in terror of apparitions, but who had ever before so turned the tables and become himself, in the apparitional world, an incalculable terror?"
                            },
                            {
                                "example_id": "e2041a94-1e88-42b2-801f-e330cf36566f",
                                "sense_id": "07c05e63-a836-321c-be93-e85946f08cc6",
                                "text": "Since the people of this period carved innumerable vulvas on the walls of the caves, it is natural to assume that the monthly rhythms of the vulva were closely attended to, and that ovulation was no invisible event but was a subtle tidal pulse that seemed to be drawn by the apparitional light of the full moon."
                            }
                        ]
                    }
