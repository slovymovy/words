                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adf8a85-0bf3-404f-8eb2-28c0ab793bc7",
                                "sense_id": "500a39b6-0ab5-36bd-a630-0a21ec4e6b0a",
                                "text": "Les jours et les nuits s’entre-suivent."
                            },
                            {
                                "example_id": "e8b7e5a9-e165-4c68-8b03-62aff3380a1c",
                                "sense_id": "500a39b6-0ab5-36bd-a630-0a21ec4e6b0a",
                                "text": "La course entre-suivie des biens et des maux."
                            },
                            {
                                "example_id": "2f3dc17b-abd2-4ec1-898e-1d13472aea47",
                                "sense_id": "500a39b6-0ab5-36bd-a630-0a21ec4e6b0a",
                                "text": "D'une entre-suivante suite\nIl ajourne, et puis ennuyte,\nL'an d'un mutuel retour\nSes quatre saisons rameine\nEt apres la lune pleine\nLe croissant luit a son tour."
                            }
                        ]
