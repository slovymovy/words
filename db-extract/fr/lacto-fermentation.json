                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d134710-1ab4-4554-8d54-b21f2c47bef7",
                                "sense_id": "aed91dd8-67ca-3208-8ecd-461941a0e1df",
                                "text": "Vous maîtriserez bientôt différentes méthodes de conservation : stérilisation, lacto-fermentation, salage, séchage…"
                            },
                            {
                                "example_id": "1d4a0d17-2c0c-4767-a5bc-75c7ca409d7f",
                                "sense_id": "aed91dd8-67ca-3208-8ecd-461941a0e1df",
                                "text": "Précisons que le préfixe « lacto » fait référence à l’acide lactique, libéré lors de la fermentation, et non pas à un support laitier qui serait indispensable au phénomène de lacto-fermentation."
                            },
                            {
                                "example_id": "bc6de1da-056d-49a2-913d-88dbf7b5cd5e",
                                "sense_id": "aed91dd8-67ca-3208-8ecd-461941a0e1df",
                                "text": "En revanche, la vulnérabilité de la vitamine C n’est pas un problème au cours du processus de lacto-fermentation."
                            }
                        ]
                    }
