                    {
                        "sense_id": "04dad1c5-6f19-3823-a959-e579c0cffb70",
                        "entry_id": "41989d01-057e-3d5d-b1c9-b56962d9774c",
                        "glosses": [
                            "eine Kwa-Sprache, die in Benin und Togo gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb7ab2bd-6ab1-43eb-94af-8ff77e22a81f",
                                "sense_id": "04dad1c5-6f19-3823-a959-e579c0cffb70",
                                "text": "„Aus der Tatsache seines prozentualen Anteils und seiner relativ weiten Verbreitung resultiert auch, daß bereits seit längerem eine Reihe von Arbeiten zum Fon existiert.“"
                            },
                            {
                                "example_id": "4c02dede-18a9-4ded-aba8-4c631f5d60f5",
                                "sense_id": "04dad1c5-6f19-3823-a959-e579c0cffb70",
                                "text": "„›Tchan‹ ist die Bezeichnung auf Fon; im Yoruba spricht man von ›mariwu‹, was gleichzeitig als Name für die Initiierten verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
