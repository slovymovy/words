                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a2efcde-f81a-42c1-8f3c-2931b4038dd1",
                        "source_entry_id": "47177eee-2378-3bef-ac85-77d56da3f755",
                        "source_sense_id": "2dfc1d7b-161a-36e7-9ece-77ea6d3fba7c",
                        "target_lang_word": "bezwingen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezwingen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "173fa894-410f-3514-a7c9-957e0404f925",
                                        "entry_id": "1164aa36-b3e8-366b-b8cc-ddc1a6aa8585",
                                        "glosses": [
                                            "jemand oder etwas überwältigen; in einem Kampf besiegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871b0ccd-8ec8-4752-8d9b-700b06171ecc",
                                                "sense_id": "173fa894-410f-3514-a7c9-957e0404f925",
                                                "text": "Er konnte seinen Gegner mit seiner Kraft bezwingen."
                                            },
                                            {
                                                "example_id": "002e1d6c-1b3d-4ad0-9e62-8d7dced7d547",
                                                "sense_id": "173fa894-410f-3514-a7c9-957e0404f925",
                                                "text": "„Daniil Medwedew […] hat die US Open gewonnen […]. Der 25-jährige Russe bezwang den Weltranglistenersten aus Serbien am Sonntag (Ortszeit) in New York mit 6:4, 6:4 und 6:4 […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f647d4f-ee97-3681-8b4b-2363f7d7a41e",
                                        "entry_id": "1164aa36-b3e8-366b-b8cc-ddc1a6aa8585",
                                        "glosses": [
                                            "ein Hindernis überwinden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62127b70-394d-4f2a-84e2-aa2baf71d846",
                                                "sense_id": "9f647d4f-ee97-3681-8b4b-2363f7d7a41e",
                                                "text": "Sie haben den Berg bezwungen und den Gipfel erreicht."
                                            },
                                            {
                                                "example_id": "b1195bd5-968e-4b7e-9453-a4b8d202302c",
                                                "sense_id": "9f647d4f-ee97-3681-8b4b-2363f7d7a41e",
                                                "text": "„Ganz ohne technische Hilfsmittel, nur durch ein Seil gesichert, bezwingen Freikletterer den Berg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89be3290-f085-4063-8215-7825c0211366",
                        "source_entry_id": "47177eee-2378-3bef-ac85-77d56da3f755",
                        "source_sense_id": "2dfc1d7b-161a-36e7-9ece-77ea6d3fba7c",
                        "target_lang_word": "surmonter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surmonter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Monter au-dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea1591e-1041-4ce8-9fcb-2dac551d5319",
                                                "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                                                "text": "Il supprima de plus les cygnes de support et la couronne de comte surmontant l’écu ; mais il commit en même temps l’erreur d’armer et lampasser le lion d'argent au lieu d’azur."
                                            },
                                            {
                                                "example_id": "a118a173-a428-4c39-8828-210b0b7183cf",
                                                "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                                                "text": "Au déluge, l’eau surmonta de quinze coudées les plus hautes montagnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Se placer, s’élever, régner au sommet, au-dessus."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens on l’emploie surtout en termes d’architecture et de décoration",
                                        "examples": [
                                            {
                                                "example_id": "5b9d34a8-3914-4310-9cde-500303804f4f",
                                                "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                                "text": "Les grandes cornes qui surmontent la tète du bouc, et la longue barbe qui est suspendue à son menton, lui donnent un air bizarre et équivoque : […]."
                                            },
                                            {
                                                "example_id": "a2b479b7-fc27-4f36-ac60-cb0359698138",
                                                "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                                "text": "De là l'importance décorative donnée dans les églises baroques à la chaire, aux confessionnaux et à l'autel que surmonte un baldaquin."
                                            },
                                            {
                                                "example_id": "60909ed5-b13a-451a-8930-1a0fb56f74dc",
                                                "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                                "text": "C'était une brasserie animée, refaite à neuf il y a longtemps, avec de grands miroirs muraux et un comptoir en pacfung, brillant et lustré, que surmontaient des étagères où étaient alignées toutes sortes de bouteilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Vaincre ; dompter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4bd30d-bf07-4f05-8f45-2f6516b1083f",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Dans le domaine de la Parémiologie contrastive, un des principaux obstacles à surmonter est d’obtenir une équivalence parémiologique en vue d’analyser les parémies dans différentes langues de travail."
                                            },
                                            {
                                                "example_id": "9ce89d8f-80b2-4169-8608-9a94e3d5a38f",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Surmonter sa colère, sa haine, son amour."
                                            },
                                            {
                                                "example_id": "baef9bc6-8a8e-4f2d-a69d-49b5b15dc28a",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Surmonter tous les obstacles, toutes les difficultés."
                                            },
                                            {
                                                "example_id": "48e2e912-43d2-4847-92a5-00f363d895cd",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Il faut se surmonter, Il faut se dominer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Surpasser."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens il ne se dit que quand il y a une sorte de concurrence, d’émulation, de lutte",
                                        "examples": [
                                            {
                                                "example_id": "896d6b4e-fc55-4be6-934a-e0e4d40107db",
                                                "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                                                "text": "Il a surmonté tous ses concurrents."
                                            },
                                            {
                                                "example_id": "1faa6816-b326-44f1-9a5f-5101d92b0376",
                                                "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                                                "text": "Surmonter quelqu’un en générosité, en science, en éloquence, en valeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72ba9102-fa95-4fcf-a8cd-6ab6b75f47d8",
                        "source_entry_id": "47177eee-2378-3bef-ac85-77d56da3f755",
                        "source_sense_id": "2dfc1d7b-161a-36e7-9ece-77ea6d3fba7c",
                        "target_lang_word": "dompter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dompter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1fbb0d-61bf-3ca0-ab08-a0cb50124aca",
                                        "entry_id": "da35cb38-81d4-3cd0-87bb-c87f10e8353d",
                                        "glosses": [
                                            "Réduire sous son obéissance un animal sauvage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf116f0a-342a-4734-bc32-13137249da90",
                                                "sense_id": "0a1fbb0d-61bf-3ca0-ab08-a0cb50124aca",
                                                "text": "Dompter un cheval, un taureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "221d0383-ed78-3851-9cff-59fabb511249",
                                        "entry_id": "da35cb38-81d4-3cd0-87bb-c87f10e8353d",
                                        "glosses": [
                                            "Faire obéir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae20307-5826-4bd5-89d7-e8a307935df5",
                                                "sense_id": "221d0383-ed78-3851-9cff-59fabb511249",
                                                "text": "Dompter un enfant rebelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e528dbf6-da06-33f1-a4b5-5084d221e96f",
                                        "entry_id": "da35cb38-81d4-3cd0-87bb-c87f10e8353d",
                                        "glosses": [
                                            "Dominer, maitriser, soumettre ou vaincre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b4e5ae-15f1-4e95-98de-946553a73838",
                                                "sense_id": "e528dbf6-da06-33f1-a4b5-5084d221e96f",
                                                "text": "Mais il a vu, aussi, quelle force mentale habite le Maillot jaune, décramponné de deux longueurs, mais capable, sur les dix derniers mètres, de venir dompter son assaillant à l’arraché."
                                            },
                                            {
                                                "example_id": "0ec0a817-3ef9-4c8e-8dce-fd1158b16753",
                                                "sense_id": "e528dbf6-da06-33f1-a4b5-5084d221e96f",
                                                "text": "On sentait une puissante individualité, que la foi s’était assujettie, mais que la règle ecclésiastique n’avait pas domptée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
