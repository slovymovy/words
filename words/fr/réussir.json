{
    "word_family": [
        "réussite"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80178a69-2a6f-3668-8e60-fbf1a4c29345",
                    "sense_definition": "Accomplir quelque chose avec succès, être reçu à une épreuve ou confectionner un objet ou un plat de manière satisfaisante.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accomplissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a révisé tous les soirs pour <w>réussir</w> un examen très important."
                        },
                        {
                            "text": "Le jeune pâtissier a parfaitement <w>réussi</w> ce délicieux gâteau d'anniversaire."
                        }
                    ],
                    "synonyms": [
                        "accomplir"
                    ],
                    "antonyms": [
                        "rater",
                        "échouer"
                    ],
                    "common_phrases": [
                        "réussir un examen",
                        "réussir un coup"
                    ]
                },
                {
                    "sense_id": "44dcfc16-c3f7-3e58-b75f-41b67fef89ef",
                    "sense_definition": "Parvenir à faire quelque chose après des efforts ou malgré les difficultés.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accomplissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs essais infructueux, nous avons enfin <w>réussi</w> à réparer le vélo."
                        },
                        {
                            "text": "Malgré la pluie et le vent, elle a <w>réussi</w> à arriver avant la nuit."
                        }
                    ],
                    "synonyms": [
                        "parvenir",
                        "arriver"
                    ],
                    "antonyms": [
                        "échouer"
                    ],
                    "common_phrases": [
                        "réussir à faire",
                        "réussir à convaincre"
                    ]
                },
                {
                    "sense_id": "2e0d0255-a5b5-3afc-9305-5688faaa8338",
                    "sense_definition": "Connaître le succès social, professionnel ou financier et faire une belle carrière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "succes_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son travail assidu, ce jeune diplômé espère <w>réussir</w> dans la vie."
                        },
                        {
                            "text": "Tout le monde pensait que cette brillante avocate allait <w>réussir</w> rapidement au barreau."
                        }
                    ],
                    "synonyms": [
                        "prospérer",
                        "percer"
                    ],
                    "antonyms": [
                        "échouer"
                    ],
                    "common_phrases": [
                        "réussir dans la vie",
                        "réussir brillamment"
                    ]
                },
                {
                    "sense_id": "278b255e-01d7-33c9-9e58-a0b6517fd06e",
                    "sense_definition": "Avoir une issue favorable ou fonctionner comme prévu, en parlant d'un projet ou d'une entreprise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "succes_projet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle stratégie de communication a bien <w>réussi</w> auprès du public visé."
                        },
                        {
                            "text": "Si leur entreprise <w>réussit</w>, ils ouvriront une deuxième boutique dès l'année prochaine."
                        }
                    ],
                    "synonyms": [
                        "marcher",
                        "fonctionner"
                    ],
                    "antonyms": [
                        "avorter",
                        "échouer"
                    ]
                },
                {
                    "sense_id": "3190890e-c169-3bb8-bdfe-7577a3419a0d",
                    "sense_definition": "Être bénéfique ou convenir à quelqu'un, en parlant d'un climat, d'une habitude ou d'un aliment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "convenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce séjour au grand air de la montagne semble lui avoir parfaitement <w>réussi</w>."
                        },
                        {
                            "text": "Le stress permanent et le manque de sommeil ne lui <w>réussissent</w> pas du tout."
                        }
                    ],
                    "synonyms": [
                        "convenir",
                        "profiter"
                    ],
                    "antonyms": [
                        "nuire"
                    ]
                },
                {
                    "sense_id": "a51f78e3-4e09-3fff-ba03-146163244193",
                    "sense_definition": "Croître vigoureusement et produire une récolte abondante, en parlant de plantes ou de cultures.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pommiers et les poiriers <w>réussissent</w> très bien dans ce sol humide et fertile."
                        },
                        {
                            "text": "Ces fleurs délicates ne <w>réussissent</w> guère dans les climats trop froids en hiver."
                        }
                    ],
                    "synonyms": [
                        "prospérer",
                        "croître"
                    ],
                    "antonyms": [
                        "dépérir"
                    ]
                }
            ]
        }
    ]
