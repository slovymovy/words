                },
                {
                    "sense_id": "3b4b64e6-eb0e-3cc8-84ea-f9c8f85b1956",
                    "sense_definition": "Corps céleste envisagé dans ses prétendues influences sur le destin ou le caractère des êtres humains.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astrologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines personnes pensent que les <w>astres</w> déterminent le cours de leur existence."
                        },
                        {
                            "text": "Elle consulte régulièrement son horoscope pour connaître l'influence des <w>astres</w>."
