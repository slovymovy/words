                    {
                        "sense_id": "d1f0da4c-3f79-312a-bf36-a5cb090075d5",
                        "entry_id": "d44c8fa9-41d7-3d24-a507-a3cb66598926",
                        "glosses": [
                            "dag waarop feest gevierd wordt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eaf399f1-9de3-32ba-915c-fc865105867c",
                        "entry_id": "d44c8fa9-41d7-3d24-a507-a3cb66598926",
                        "glosses": [
                            "jaarlijks terugkerende erkende gedenkdag die gevierd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd6ef9d-80da-41de-9fce-4bfb6b8e1dbb",
                                "sense_id": "eaf399f1-9de3-32ba-915c-fc865105867c",
                                "text": "En men stelde zich voor hoe de machtige Nicolaas, ieder jaar op zijn feestdag, de duivel in ketenen sloeg en geboeid met zich meevoerde."
                            },
                            {
                                "example_id": "9dbe8c39-c14e-4f92-86f6-8ccf06000493",
                                "sense_id": "eaf399f1-9de3-32ba-915c-fc865105867c",
                                "text": "Onder het koken vertelde Barbie mij over zijn werk als hotelmanager en hoe zwaar het was om jarenlang voor dag en dauw op te moeten staan en op alle feestdagen te moeten werken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44a60b80-ec69-4b33-b223-a2e85445cec9",
                        "source_entry_id": "d44c8fa9-41d7-3d24-a507-a3cb66598926",
                        "target_lang_word": "Feiertag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feiertag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2fd55cf-9ab9-34f7-9d12-bc3e2c39fc31",
                                        "entry_id": "ba2c5f59-04e1-3ab2-bf4c-75fe838af325",
                                        "glosses": [
                                            "ein vom Alltag besonders abgesetzter Tag, der dem Gedenken an ein Ereignis, eine Person oder einen besonderen Umstand gewidmet ist"
                                        ],
                                        "tags": [
                                            "Kalender"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf7ee60-f534-4e21-8f78-e1fee78f9469",
                                                "sense_id": "d2fd55cf-9ab9-34f7-9d12-bc3e2c39fc31",
                                                "text": "Heiligabend ist ein christlicher Feiertag."
                                            },
                                            {
                                                "example_id": "9a815c75-0d9c-4170-8e02-b97fbc7a1b81",
                                                "sense_id": "d2fd55cf-9ab9-34f7-9d12-bc3e2c39fc31",
                                                "text": "„Bayram als Feiertag wäre ein Zeichen, dass die Konkurrenz der Religionen letztendlich ohne Sinn ist.“"
                                            },
                                            {
                                                "example_id": "ea3e963a-17b8-4473-a772-c1a4a82b2469",
                                                "sense_id": "d2fd55cf-9ab9-34f7-9d12-bc3e2c39fc31",
                                                "text": "„Am dritten Feiertage waren alle Hausgenossen nach dem Mittagesssen auf ihre Zimmer gegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db15c7b0-73bf-4a54-ab72-6cf7d439d7cf",
                        "source_entry_id": "d44c8fa9-41d7-3d24-a507-a3cb66598926",
                        "target_lang_word": "holiday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holiday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9baa7816-f635-3aea-b15e-6a0dc48c9893",
                                        "entry_id": "40f58289-ab8d-3125-b67a-c2617810544d",
                                        "glosses": [
                                            "A day on which a festival, religious event, or national celebration is traditionally observed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e24c53-862d-4938-b940-54eaae827d4f",
                                                "sense_id": "9baa7816-f635-3aea-b15e-6a0dc48c9893",
                                                "text": "Today is a Wiccan holiday!"
                                            },
                                            {
                                                "example_id": "b6752516-608e-4641-8983-b5e9f8b33354",
                                                "sense_id": "9baa7816-f635-3aea-b15e-6a0dc48c9893",
                                                "text": "Monday, January 18, was the holiday celebrating Martin Luther King Jr.'s birthday. In the morning I held a reception for the diplomatic representatives of other nations in the inner quadrangle at Georgetown, addressing them from the steps of Old North Building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5811527b-3fb3-354a-abb0-7b84c224b4b7",
                                        "entry_id": "40f58289-ab8d-3125-b67a-c2617810544d",
                                        "glosses": [
                                            "A day declared free from work by the state or government."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2202129c-a4b4-3341-8be6-359573236fbf",
                                        "entry_id": "40f58289-ab8d-3125-b67a-c2617810544d",
                                        "glosses": [
                                            "A period of one or more days taken off work for leisure and often travel; often plural."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a49578-9cf2-46ad-89c1-1f9c7c988767",
                                                "sense_id": "2202129c-a4b4-3341-8be6-359573236fbf",
                                                "text": "How much holiday are you allowed?"
                                            },
                                            {
                                                "example_id": "c0aae050-3eb0-4ba1-ade3-d08bfb5d6005",
                                                "sense_id": "2202129c-a4b4-3341-8be6-359573236fbf",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or[…]. And at last I began to realize in my harassed soul that all elusion was futile, and to take such holidays as I could get, when he was off with a girl, in a spirit of thankfulness."
                                            },
                                            {
                                                "example_id": "84c09007-257d-4c7f-b5ea-6b1b4de1841f",
                                                "sense_id": "2202129c-a4b4-3341-8be6-359573236fbf",
                                                "text": "Climb aboard a butterfly and take off in the breeze. Let your worries flutter by and do the things you please. In the land where dollar bills are falling off the trees. On a dreamer’s holiday.[…]Make it a long vacation. Time, there is plenty of. You need no reservation. Just bring along the one you love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bace317b-16b2-3430-ad4f-2ab32a4d68fd",
                                        "entry_id": "40f58289-ab8d-3125-b67a-c2617810544d",
                                        "glosses": [
                                            "A period during which pupils do not attend their school; often plural; rarely used for students at university (usually: vacation)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9874eebe-29f1-4fe5-a92b-3b5e41289244",
                                                "sense_id": "bace317b-16b2-3430-ad4f-2ab32a4d68fd",
                                                "text": "I want to take a French course this summer holiday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43b58761-dea2-3cc3-96f3-e972033b513d",
                                        "entry_id": "40f58289-ab8d-3125-b67a-c2617810544d",
                                        "glosses": [
                                            "A period during which, by agreement, the usual payments are not made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff8ea51-ec33-4123-9ac9-f96c4009b828",
                                                "sense_id": "43b58761-dea2-3cc3-96f3-e972033b513d",
                                                "text": "a mortgage payment holiday"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae0acccc-76e4-38a7-8a15-271299bd7bf3",
                                        "entry_id": "40f58289-ab8d-3125-b67a-c2617810544d",
                                        "glosses": [
                                            "A gap in coverage, e.g. of paint on a surface, or sonar imagery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
