    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d78d459-b586-3ee2-9da4-ffc44a574418",
                    "sense_definition": "Ouvrir ou consacrer solennellement un lieu, un édifice ou un monument par une cérémonie officielle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire va <w>inaugurer</w> la nouvelle bibliothèque municipale demain matin."
                        },
                        {
                            "text": "Ils ont <w>inauguré</w> ce monument en présence de nombreux citoyens."
                        }
                    ],
                    "common_phrases": [
                        "inaugurer un monument",
                        "inaugurer un musée",
                        "inaugurer une exposition"
                    ]
                },
                {
                    "sense_id": "95f6354c-5d25-36ad-ab93-c1fb99e5ea8d",
                    "sense_definition": "Marquer le début de quelque chose, commencer ou ouvrir une nouvelle étape.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette découverte va <w>inaugurer</w> une nouvelle ère pour la recherche médicale."
                        },
                        {
                            "text": "Le premier discours a <w>inauguré</w> la saison des débats politiques."
                        }
                    ],
                    "synonyms": [
                        "amorcer",
                        "commencer",
                        "entamer",
                        "ouvrir"
                    ],
                    "antonyms": [
                        "achever",
                        "clore",
                        "terminer"
                    ],
                    "common_phrases": [
                        "inaugurer une ère",
                        "inaugurer une nouvelle période"
                    ]
                },
                {
                    "sense_id": "c40c6086-068e-3d88-a0d5-c1749d0226d1",
                    "sense_definition": "Installer solennellement une personnalité politique dans ses fonctions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau président sera officiellement <w>inauguré</w> au début du mois prochain."
                        },
                        {
                            "text": "Le protocole prévoit d'<w>inaugurer</w> le chef de l'État dans la salle des fêtes."
