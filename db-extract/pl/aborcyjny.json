                ],
                "senses": [
                    {
                        "sense_id": "9d6991fd-8d58-3df0-b9c7-247be8e15aa3",
                        "entry_id": "81dedf97-43bc-3165-874a-34e9da0146a5",
                        "glosses": [
                            "Abtreibungs-"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3366ac-ea91-4481-a149-1ade6317d2e7",
                                "sense_id": "9d6991fd-8d58-3df0-b9c7-247be8e15aa3",
                                "text": "Obecnie obowiązująca w Polsce, restrykcyjna ustawa dotycząca aborcji nazywana jest eufemistycznie kompromisem aborcyjnym, który w rzeczywistości został zawarty z pominięciem głosu kobiet, co poskutkowało odebraniem brzemiennym Polkom prawa do samostanowienia o swoim ciele.",
                                "translation": "Das gegenwärtig in Polen geltende, restriktive Gesetz bezüglich der Abtreibung wird euphemistisch Abtreibungskompromiss genannt, der in Wirklichkeit unter Nichtbeachtung der Stimme der Frauen geschlossen wurde, was einen für Polinnen folgenschweren Entzug des Rechtes auf Selsbtbestimmung über ihren Körper nach sich zog."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc33f1e1-0c6c-4cbc-908b-2362fe0eb883",
                        "source_entry_id": "81dedf97-43bc-3165-874a-34e9da0146a5",
                        "source_sense_id": "9d6991fd-8d58-3df0-b9c7-247be8e15aa3",
                        "source_sense_description": "Medizin: Abtreibungs-",
                        "target_lang_word": "Abtreibung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abtreibung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                        "entry_id": "8d6d81f5-3a85-367a-9d28-f2610ebe036c",
                                        "glosses": [
                                            "Eingriff zur gezielten Abtötung und Entfernung eines Embryos beziehungsweise Fötus aus der Gebärmutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41bb27b-867f-4730-833e-c2fd24e7c43a",
                                                "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                                "text": "Die Abtreibung verlief ohne Komplikationen für die junge Frau."
                                            },
                                            {
                                                "example_id": "c6980b29-574b-4c5a-811a-1c95f5932776",
                                                "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                                "text": "„Sie erstellte Horoskope, las die Karten und nahm ab und zu illegale Abtreibungen vor.“"
                                            },
                                            {
                                                "example_id": "70826e77-d364-4663-979f-2aa85d93760c",
                                                "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                                "text": "„Sie erzählte, dass sie schon einmal eine Abtreibung gehabt habe, versteckt und illegal.“"
                                            },
                                            {
                                                "example_id": "a707fd42-e11d-435c-98dd-b76b72515904",
                                                "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                                "text": "„An eine Abtreibung dachte sie keinen Augenblick, nicht an diesem Tag und nicht an den Tagen und in den Wochen danach, in denen sie sich wirklich schwanger fühlte.“"
                                            },
                                            {
                                                "example_id": "49a1aaca-0e92-4cbd-86c8-61e9bdf2bcb7",
                                                "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                                "text": "„Hier erlebte sie traurige Tage, als sie Gretel, ihrer besten Freundin, zur Abtreibung verhalf, und sie dann verlor, an Gott, ans Klosterleben.“"
                                            },
                                            {
                                                "example_id": "4479d1a8-23a0-481c-85a4-4721b81f83cb",
                                                "sense_id": "c410ae5d-97a3-3946-84bd-b3dee4081eff",
                                                "text": "„Die Partei will das Recht auf Abtreibungen deutlich einschränken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
