                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagłe <w>zaskoczenie</w> przeciwnika pozwoliło drużynie wygrać mecz.",
