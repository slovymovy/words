    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a12dca0-5315-3046-8780-64b06661c8e5",
                    "sense_definition": "Action de réunir ou d'introduire un élément dans un tout pour former un mélange homogène ou un ensemble complet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>incorporation</w> progressive des œufs permet d'obtenir une crème parfaitement homogène."
                        },
                        {
                            "text": "Le nouveau texte de loi prévoit l'<w>incorporation</w> immédiate de ces directives européennes."
                        }
                    ],
                    "synonyms": [
                        "intégration",
                        "assimilation",
                        "insertion"
                    ],
                    "antonyms": [
                        "exclusion",
                        "séparation",
                        "extraction"
                    ],
                    "common_phrases": [
                        "incorporation des ingrédients"
                    ]
                },
                {
                    "sense_id": "473b5924-2e0e-3ea1-bc41-d33111dc2c93",
                    "sense_definition": "Entrée officielle et admission de recrues ou de réservistes au sein d'une unité militaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme a reçu son ordre d'<w>incorporation</w> pour la base aérienne."
                        },
                        {
                            "text": "La date de son <w>incorporation</w> dans l'armée a été reportée de deux mois."
                        }
                    ],
                    "synonyms": [
                        "enrôlement",
                        "recrutement"
                    ],
                    "antonyms": [
                        "démobilisation",
                        "réforme"
                    ],
                    "common_phrases": [
                        "ordre d'incorporation",
                        "date d'incorporation"
                    ]
                },
                {
                    "sense_id": "fa40a9a5-32b4-3fb2-9e71-aa781dd1c3f6",
                    "sense_definition": "Pénétration et fixation de substances toxiques ou radioactives dans l'organisme par inhalation, ingestion ou voie cutanée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les experts surveillent l'<w>incorporation</w> de poussières radioactives chez les ouvriers de la centrale."
                        },
                        {
                            "text": "Le port d'un masque réduit le risque d'<w>incorporation</w> de contaminants par les voies respiratoires."
                        }
                    ],
                    "synonyms": [
                        "absorption",
                        "imprégnation"
                    ],
                    "antonyms": [
                        "élimination",
                        "excrétion"
                    ],
                    "common_phrases": [
                        "incorporation de radionucléides"
                    ]
                },
                {
                    "sense_id": "5857220d-ac8a-326d-a7d7-c00639314382",
                    "sense_definition": "Procédé linguistique par lequel un élément lexical, généralement un nom complément, est intégré dans le verbe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>incorporation</w> nominale caractérise la grammaire de nombreuses langues autochtones d'Amérique du Nord."
                        },
                        {
                            "text": "Ce linguiste étudie les cas d'<w>incorporation</w> du pronom réfléchi dans la forme verbale."
                        }
                    ],
                    "common_phrases": [
                        "incorporation nominale"
                    ]
                },
                {
                    "sense_id": "10944d5f-7c84-35ae-b929-b1fa1ec60a0d",
                    "sense_definition": "Adjonction ou admission officielle accordée par un évêque à un ecclésiastique pour faire partie de son diocèse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>incorporation</w> du prêtre dans son nouveau diocèse a été confirmée par décret épiscopal."
                        },
                        {
                            "text": "Le prélat a finalisé les actes d'<w>incorporation</w> pour deux clercs venus de la région voisine."
                        }
                    ],
                    "synonyms": [
                        "incardination"
                    ],
                    "antonyms": [
                        "excardination"
                    ]
                }
            ]
        }
    ]
}