                    {
                        "sense_id": "6f31b013-4783-3e4f-b2eb-254e5ea7a0ea",
                        "entry_id": "975aa5e4-3806-32d9-a3dc-f6c90cd52286",
                        "glosses": [
                            "van iets dat het niet meer gebruikt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf6e750-f10b-4732-b0e5-9eb2233985c5",
                                "sense_id": "6f31b013-4783-3e4f-b2eb-254e5ea7a0ea",
                                "text": "Een reeds lang geleden gesloten hotel met een verschoten lichtbak die de reiziger een zwembad en kamer met tv belooft."
                            }
                        ]
                    }
                ],
                "translations": [],
