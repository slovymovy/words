                        "cross_references": [
                            {
                                "target_word": "grand cordon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e523a71-7a00-3d9f-ad6f-44250cee8341",
                                        "entry_id": "92759c38-9bd1-323a-a47e-14bef8b5aab8",
                                        "glosses": [
                                            "Type de décoration, d’un haut rang."
                                        ],
                                        "tags": [
                                            "Distinction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f13dea-2e22-420a-8055-73892c641a72",
                                                "sense_id": "5e523a71-7a00-3d9f-ad6f-44250cee8341",
                                                "text": "Mon roi, qui, aujourd’hui, brûle de me faire pendre, et qui, avant la révolte, me tutoyait, m’eût donné le grand cordon de son ordre si j’avais fait tomber ces trois têtes."
                                            },
                                            {
                                                "example_id": "a7687d8e-4634-43e9-98ef-fa9e96af80d0",
                                                "sense_id": "5e523a71-7a00-3d9f-ad6f-44250cee8341",
                                                "text": "— Quel dommage qu’un homme d’une si large intelligence, affranchi de toutes les superstitions, résolu à toutes les vérités, ait consenti à se laisser classer, étiqueter, enfermer dans des titres et dans des Académies ! Et combien nous l’aimerions davantage, s’il émargeait moins au budget et s’il avait les membres moins liés de grands cordons !"
                                            },
                                            {
                                                "example_id": "a2fb9990-97be-453d-b717-df284cacc775",
                                                "sense_id": "5e523a71-7a00-3d9f-ad6f-44250cee8341",
                                                "text": "Le Président de l’O.N.U. essuie discrètement avec son mouchoir son grand cordon d’or sur lequel le nouveau-né a vomi une goutte de lait caillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63572531-722f-33bc-ade5-f65e84ba2b15",
                                        "entry_id": "92759c38-9bd1-323a-a47e-14bef8b5aab8",
                                        "glosses": [
                                            "Ancienne appellation de la grand-croix de la Légion d’honneur."
                                        ],
