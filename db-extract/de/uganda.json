                "senses": [
                    {
                        "sense_id": "f762fad6-04ea-3245-b6f4-90263262f6dd",
                        "entry_id": "96b5564c-a864-3beb-8397-92728956a0f0",
                        "glosses": [
                            "Land in Ostafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447c403c-5e1d-45b2-b6ca-c67ed6c9decc",
                                "sense_id": "f762fad6-04ea-3245-b6f4-90263262f6dd",
                                "text": "Das Klima Ugandas ist tropisch, jedoch durch die Höhenlage relativ kühl."
                            },
                            {
                                "example_id": "65f2eb1c-4b76-42f8-b270-9bc6dd996da3",
                                "sense_id": "f762fad6-04ea-3245-b6f4-90263262f6dd",
                                "text": "Ich habe einen interessanten Film über das heutige Uganda gesehen."
                            },
                            {
                                "example_id": "4ad6d19f-f245-4b48-a1cb-1aadf0780ee3",
                                "sense_id": "f762fad6-04ea-3245-b6f4-90263262f6dd",
                                "text": "Kampala ist die Hauptstadt von Uganda."
                            },
                            {
                                "example_id": "2e22be40-d594-465c-8198-1d990b0c1480",
                                "sense_id": "f762fad6-04ea-3245-b6f4-90263262f6dd",
                                "text": "„In Uganda heiratete ich, und mein erstes Kind wurde geboren.“"
                            },
                            {
                                "example_id": "b7b8947a-e69f-49b7-8518-2b3130b025d6",
                                "sense_id": "f762fad6-04ea-3245-b6f4-90263262f6dd",
                                "text": "„Aus Uganda trafen Schreckensbotschaften ein, die Briten meldeten Hunderttausende von Toten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
