                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a préparé une solide <w>réplique</w> pour démonter les arguments présentés par l'accusation."
                        },
                        {
                            "text": "Le juge a accordé un droit de <w>réplique</w> à la défense avant de clore les débats."
                        }
                    ],
                    "common_phrases": [
                        "droit de réplique"
                    ]
                }
            ]
        },
        {
