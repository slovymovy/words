                        "sense_id": "5bd6eb4b-a7ad-3df7-af92-33d685517541",
                        "entry_id": "c148f7a4-d3d6-319f-892a-5a162c0968e9",
                        "glosses": [
                            "Véhicule terrestre monté sur chenilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da7f8d6f-a780-4bb2-877d-01bc817e8d48",
                                "sense_id": "5bd6eb4b-a7ad-3df7-af92-33d685517541",
                                "text": "André Citroën lançait les autochenilles de la Croisière noire à travers les déserts, à la recherche de mondes mal connus ou ignorés. C’était encore pour nous de la géographie vivante et exemplaire."
                            },
                            {
                                "example_id": "9fbe3cde-2727-44c2-bd85-96bad00cd9c0",
                                "sense_id": "5bd6eb4b-a7ad-3df7-af92-33d685517541",
                                "text": "Ces [bûcherons] cordent le bois qu’ils ont abattu sur des châssis (racks) en fer qui sont tirés avec l’autochenille au chemin de charroyage."
                            }
                        ]
                    }
                ],
