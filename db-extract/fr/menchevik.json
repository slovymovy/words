                    {
                        "form_id": "0d0fe25c-ac62-4446-a43f-02f2d86ac6fd",
                        "entry_id": "86fca395-0b5a-3e0a-99be-55cbf885a168",
                        "tags": [],
                        "form": "menchévik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbf09140-571c-3a06-b210-759707c4afb7",
                        "entry_id": "86fca395-0b5a-3e0a-99be-55cbf885a168",
                        "glosses": [
                            "Partisan de donner la priorité au patriotisme par rapport à l’internationalisme, dans le Parti ouvrier social-démocrate de Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e61e9e2f-0071-4fa9-baf9-d699a998c6fc",
                                "sense_id": "dbf09140-571c-3a06-b210-759707c4afb7",
                                "text": "La situation qu’il occupe en Russie, c’est à moi qu’il la doit. Sans moi, il serait encore menchevik, c’est-à-dire mort ou emprisonné."
                            },
                            {
                                "example_id": "883e15a5-ec7b-4c0d-8cdc-4484fbe69255",
                                "sense_id": "dbf09140-571c-3a06-b210-759707c4afb7",
                                "text": "– C’est du baratin ! s’exclama Michael. De la propagande défaitiste de ces foutus mencheviks planqués dans les kolkhozes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3f1453e-c51c-420b-b796-3d0270c354bb",
                        "source_entry_id": "86fca395-0b5a-3e0a-99be-55cbf885a168",
                        "source_sense_id": "dbf09140-571c-3a06-b210-759707c4afb7",
                        "target_lang_word": "Menshevik",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menshevik",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e99d7c-3a55-38d3-8f9b-16f4c595d80f",
                                        "entry_id": "f1a391bc-898b-3672-be94-a70d28e1f7f0",
                                        "glosses": [
                                            "A member of the gradualist or moderate wing of the Russian Social Democratic Labour Party during the years preceding the Russian Revolution, when they split with the Bolsheviks; or a member of a later independent moderate-Marxist party formed in 1917."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3b7590-b814-4ebe-b6ea-6c84f85cb417",
                                                "sense_id": "b5e99d7c-3a55-38d3-8f9b-16f4c595d80f",
                                                "text": "В одном районе в последние 5—6 месяцев представителем был «меньшевик». Благодаря оторванности от общей работы этот район страшно ослаб.",
                                                "translation": "Vladimir Lenin",
                                                "english": "Vladimir Lenin"
                                            },
                                            {
                                                "example_id": "540de4df-de02-496f-91f1-84c26298bda4",
                                                "sense_id": "b5e99d7c-3a55-38d3-8f9b-16f4c595d80f",
                                                "text": "‘Better an ultra-leftist than a Menshevik,’ said Rosa Kaletsky."
                                            },
                                            {
                                                "example_id": "118fc822-b53e-44d8-b268-843ac5e85d46",
                                                "sense_id": "b5e99d7c-3a55-38d3-8f9b-16f4c595d80f",
                                                "text": "Let me be clear. The men and women on this stage have more ideas, more experience, more common sense than every participant in the Democratic debate. That debate reflected a debate between the Bolsheviks and the Mensheviks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
