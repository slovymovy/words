                ],
                "senses": [
                    {
                        "sense_id": "3bd302a8-ae96-39ba-b218-f17aaa94de3f",
                        "entry_id": "f4ced519-7169-3581-9bda-25c9140c37e0",
                        "glosses": [
                            "das Verwenden von Polymeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506c27fe-737c-4b4b-8d64-32e0910d00be",
                                "sense_id": "3bd302a8-ae96-39ba-b218-f17aaa94de3f",
                                "text": "„Hinsichtlich der Forcierung der Kunststoffverwertung vor allem aus mittellebigen (z. B. Elektronikanwendungen) und langlebigen Anwendungen (Hoch- und Tiefbau, Fahrzeuge etc.) ist – vergleichbar mit Stahl – eine genauere Kenntnis des Kunststoffinventars in den Materiallagern notwendig.“"
                            },
                            {
                                "example_id": "ba398167-c407-4e53-a9cc-4d5fdc4d52a3",
                                "sense_id": "3bd302a8-ae96-39ba-b218-f17aaa94de3f",
                                "text": "„Der europäische Verband der Kunststofferzeuger, Plastics Europe, erkennt gerade in Deutschland noch großes Potenzial für den Ausbau der Kunststoffverwendung.“"
                            },
                            {
                                "example_id": "35260496-5638-4469-acfe-5e7f0aeaeaf2",
                                "sense_id": "3bd302a8-ae96-39ba-b218-f17aaa94de3f",
                                "text": "„Die Möglichkeiten der Kunststoffverwendung zur Interieurgestaltung wurden vor allem im Italien der 60er Jahre forciert entwickelt, als große Möbelunternehmen, wie beispielsweise die Firma Kartell, in eigens eingerichteten Untersuchungslabors, zusammen mit Designern und der chemischen Industrie experimentierten.“"
                            },
                            {
                                "example_id": "7229d128-10c9-4048-b211-c41b3d6bc8fb",
                                "sense_id": "3bd302a8-ae96-39ba-b218-f17aaa94de3f",
                                "text": "„Neueste Hochleistungs - Hochtemperatur – und LNP- Werkstoffe und Werkstoffkombinationen ermöglichen Kunststoffverwendung wo bisher nur hochwertige Metalle zugelassen waren.“"
                            },
                            {
                                "example_id": "64eb0b26-d8b9-4544-b56a-85e3349ffe53",
                                "sense_id": "3bd302a8-ae96-39ba-b218-f17aaa94de3f",
                                "text": "„Eine Kunststoffverwendung in Wärmeträgeranlagen ist auf Grund der relativ niedrigen Temperaturbeständigkeit nahezu ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
