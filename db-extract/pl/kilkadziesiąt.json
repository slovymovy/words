                        "entry_id": "bf5bd442-9152-3728-a057-5452f87799a6",
                        "glosses": [
                            "oznaczenie w sposób przybliżony liczby od dwudziestu do dziewięćdziesięciu dziewięciu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd33d10-b2ac-455d-a1c7-446deefa4a3e",
                                "sense_id": "f436fdd5-3111-3d1f-b646-729c1ac87336",
                                "text": "Kilkadziesiąt matek i dzieci wzięło udział w konkursie."
                            },
                            {
                                "example_id": "13274152-66ff-4297-9b8a-9d6190df7bd5",
                                "sense_id": "f436fdd5-3111-3d1f-b646-729c1ac87336",
                                "text": "Kilkudziesięciu pracowników firmy zrezygnowało ze swoich posad z powodu zbyt niskich płac."
                            },
                            {
                                "example_id": "42db4655-4a4e-487f-b535-db21594ba169",
                                "sense_id": "f436fdd5-3111-3d1f-b646-729c1ac87336",
                                "text": "Na zdjęciu widać kilkudziesięciu chłopców w mundurach."
                            },
                            {
                                "example_id": "9698553d-7e03-439b-a195-9a9aa243500b",
                                "sense_id": "f436fdd5-3111-3d1f-b646-729c1ac87336",
                                "text": "Na zdjęciu widać kilkadziesiąt dziewczynek w mundurach."
                            },
                            {
                                "example_id": "a0fe1b85-108a-4449-b808-d48b92c72495",
                                "sense_id": "f436fdd5-3111-3d1f-b646-729c1ac87336",
                                "text": "Drwal ściął kilkadziesiąt drzew w ciągu tygodnia."
                            }
                        ],
