                    {
                        "translation_id": "4d82ff6b-61fa-433a-8280-7f809f18e452",
                        "source_entry_id": "c75b5198-f802-33f3-a668-9c257cee6b0a",
                        "source_sense_id": "6df5953d-cc66-3823-8982-805b700d3460",
                        "target_lang_word": "hight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fea6ea4-f535-3232-b0eb-247cbd502af5",
                                        "entry_id": "6e2c207e-91e3-3754-88dd-59f078d34d74",
                                        "glosses": [
                                            "To call, name."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a598fcfc-f8f8-48cd-acb7-3928bbf063ef",
                                                "sense_id": "4fea6ea4-f535-3232-b0eb-247cbd502af5",
                                                "text": "King Arthur's court was hight Camelot."
                                            },
                                            {
                                                "example_id": "d82d297a-c34d-431c-9b7b-cc7569f7fa85",
                                                "sense_id": "4fea6ea4-f535-3232-b0eb-247cbd502af5",
                                                "text": "He that made loue vnto the eldeſt Dame, Was hight Sir Huddibras, an hardy man[…]"
                                            },
                                            {
                                                "example_id": "5d9e9080-c926-46f8-8e9c-7a7b767e98a3",
                                                "sense_id": "4fea6ea4-f535-3232-b0eb-247cbd502af5",
                                                "text": "Childe Harold was he hight."
                                            },
                                            {
                                                "example_id": "b7b7c888-c112-40d1-8d07-0315597473b9",
                                                "sense_id": "4fea6ea4-f535-3232-b0eb-247cbd502af5",
                                                "text": "“Lord,” said Sir Launcelot, “I am hight Launcelot, and am surnamed ‘He of the Lake.’”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86576665-1ed2-3dcd-a9c7-dc62519327fe",
                                        "entry_id": "6e2c207e-91e3-3754-88dd-59f078d34d74",
                                        "glosses": [
                                            "To be called or named."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b617a6df-728c-45e8-960b-891c63029f0e",
                                                "sense_id": "86576665-1ed2-3dcd-a9c7-dc62519327fe",
                                                "text": "I hight Sir Galahad."
                                            },
                                            {
                                                "example_id": "f3f428ac-2e9b-4633-ba96-592dede520a4",
                                                "sense_id": "86576665-1ed2-3dcd-a9c7-dc62519327fe",
                                                "text": "Bright was her hue, and Geraldine she hight."
                                            },
                                            {
                                                "example_id": "6abe8350-c3a7-4ec0-857e-e2ba62debd9c",
                                                "sense_id": "86576665-1ed2-3dcd-a9c7-dc62519327fe",
                                                "text": "In all the worlde one onely face of nature did abide, which Chaos hight"
                                            },
                                            {
                                                "example_id": "8f8018df-3b46-4cf6-be09-82dc9df8b6a0",
                                                "sense_id": "86576665-1ed2-3dcd-a9c7-dc62519327fe",
                                                "text": "There did I ſee that low ſpirited Swaine […] which as I remember, hight Coſtard […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c017a58-c531-3e1d-9847-4d1d87a80fad",
                                        "entry_id": "6e2c207e-91e3-3754-88dd-59f078d34d74",
                                        "glosses": [
                                            "To command; to enjoin."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bfcee42-6d35-4f5d-ac2b-0ff772f0dad4",
                                                "sense_id": "8c017a58-c531-3e1d-9847-4d1d87a80fad",
                                                "text": "Malaise priest of Innishmurry / Hights me go, and I obey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88fccd97-e0b4-3def-9729-58601ff750de",
                                        "entry_id": "5f8bb748-1c23-3eb1-bd4f-0e3895e69f89",
                                        "glosses": [
