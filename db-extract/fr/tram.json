                        "examples": [
                            {
                                "example_id": "bb5768b8-9b18-44c0-b7ce-db06669a6aed",
                                "sense_id": "54c436f2-7acd-3c30-a64d-1a2f6047fb79",
                                "text": "On ne s’entendait pas, à cause du tram à chevaux du cours d’Alsace."
                            },
                            {
                                "example_id": "c6dd3331-42fe-4de5-a5be-60a22ce6f3a1",
                                "sense_id": "54c436f2-7acd-3c30-a64d-1a2f6047fb79",
                                "text": "Je laissai tomber mes sacs dans la neige, m’assis sur le marchepied d’un tram pour regretter amèrement d’avoir quitté trop tôt la camionnette."
                            },
                            {
                                "example_id": "3c8aba6c-9310-40b5-842d-884bf786a8fa",
                                "sense_id": "54c436f2-7acd-3c30-a64d-1a2f6047fb79",
                                "text": "Ce soir j’attends Madeleine\nOn prendra le tram trente-trois… — (Jacques Brel, chanson Madeleine)"
                            }
                        ]
                    }
