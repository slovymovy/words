                "senses": [
                    {
                        "sense_id": "cfde90a6-598c-37d7-8e43-2e585126d3b8",
                        "entry_id": "5ba8fa80-2df5-3a41-a7cb-f3a0a7cc0543",
                        "glosses": [
                            "Expressing mild emotion, such as exasperation or frustration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3818dcd-08a8-4768-b565-5661ad379f36",
                                "sense_id": "cfde90a6-598c-37d7-8e43-2e585126d3b8",
                                "text": "Lordy! Where's he off to now?"
                            },
                            {
                                "example_id": "38f98c95-3ba3-4a54-8a54-5f4c05ba3ddf",
                                "sense_id": "cfde90a6-598c-37d7-8e43-2e585126d3b8",
                                "text": "Aunt Betty graciously permitted this. She always did; but if the forgetful old man wandered for a moment away from his theme she brought him back with a surreptitious: “Lordy! yo' ole head done filled wid me yit.\""
                            },
                            {
                                "example_id": "715de59e-1df4-4a54-8788-cee182241722",
                                "sense_id": "cfde90a6-598c-37d7-8e43-2e585126d3b8",
                                "text": "“I said, ‘Lordy, we have to put tops on bottoms. Let’s get something done,’ ” Comey recalled."
                            },
                            {
                                "example_id": "757acb91-2728-47b8-8e62-4f1da44643fd",
                                "sense_id": "cfde90a6-598c-37d7-8e43-2e585126d3b8",
                                "text": "In 2021, the Times described you as an “avuncular public intellectual.” How do you feel about that label?\n[Stephen Fry:] Oh my lordy lord. Avuncular gives me great pleasure."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ff9564a-ba9d-3028-b766-4412e115e931",
                        "entry_id": "5ba8fa80-2df5-3a41-a7cb-f3a0a7cc0543",
                        "glosses": [
                            "Expressing strong emotion, such as amazement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab91a81-d279-4198-9bfb-a11a0399319a",
                                "sense_id": "7ff9564a-ba9d-3028-b766-4412e115e931",
                                "text": "Lordy! Call your dogs off, call your dogs off! Oh! Lordy! call em off quick! quick!"
                            },
                            {
                                "example_id": "efc306ea-0304-40b7-87c6-d931a043bc13",
                                "sense_id": "7ff9564a-ba9d-3028-b766-4412e115e931",
                                "text": "It can only be AC/DC: black black black! with the first single from their first new album in eight years, Black Ice. It's blues-metal heaviosity in exelcis^([sic]). Not clever but, oh lordy, it's big."
                            }
                        ]
                    }
