                        "glosses": [
                            "Person, die ein Konzept, einen Entwurf zu etwas entwickelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05653ef4-c76b-4e98-94d0-127aeec34481",
                                "sense_id": "7a947ee9-2838-3f96-93d9-7cc47aef8470",
                                "text": "„Und mag der auch kein Konzeptionist sein, keiner, der langwellig plant, weiß er doch, dass es ihm nicht gelingen kann, über anderthalb Jahre hinweg ohne Bewegung zum Ziel zu kommen, zur Wiederwahl.“"
                            },
                            {
                                "example_id": "2439af33-9714-435c-9ca1-87616652117d",
                                "sense_id": "7a947ee9-2838-3f96-93d9-7cc47aef8470",
                                "text": "„Der Grandseigneur des Pferdesports gilt als Visionär, Konzeptionist hanseatisch-kaufmännischer Prägung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
