        "fr-extract.jsonl": [
            {
                "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                "word": "columelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f8cb778-008e-4629-b9d1-de6d4d0395c5",
                        "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                        "tags": [
                            "plural"
                        ],
                        "form": "columelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b947ad10-d96a-3d64-a066-e4359d39d390",
                        "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                        "glosses": [
                            "Organe animal ou végétal en forme de petite colonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d59c886-b5b4-4458-9e8b-1d11a6f4783e",
                                "sense_id": "b947ad10-d96a-3d64-a066-e4359d39d390",
                                "text": "La columelle de l’oreille moyenne des oiseaux a la même fonction que la chaîne des osselets des mammifères."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7805db9-ea2e-310a-af20-be856ed4e4f1",
                        "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                        "glosses": [
                            "Axe osseux central de la cochlée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ab1eb1-da3f-4534-9d27-042495e5d940",
                                "sense_id": "a7805db9-ea2e-310a-af20-be856ed4e4f1",
                                "text": "À l'intérieur de la columelle se trouve le ganglion cochléaire (spiral) qui s'enroule autour de la face interne de la cochlée."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3a3c658-b693-34fa-8a3f-70a29eb6f003",
                        "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                        "glosses": [
                            "Zone séparant les deux narines."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c087985e-c151-30bc-8496-65065f36360a",
                        "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                        "glosses": [
                            "Axe le long duquel est enroulée la coquille des gastéropodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24f4a12-ee31-499b-94b0-9f900d49bd4b",
                                "sense_id": "c087985e-c151-30bc-8496-65065f36360a",
                                "text": "Vue de côté, ma coquille ressemble à un donjon. Un escalier s’y enroule en colimaçon autour d’un gros pilier central, appelé columelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "b76cf340-1883-3bf0-8fcd-a1e73a174a06",
                        "entry_id": "7040074b-eefd-3d94-bab8-9d6a5bb062da",
                        "glosses": [
                            "Tissu central formant une tige au centre du bulbe d’un gastéroïde qui a quasi avorté, comme chez les Chamonixia."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
