                                "target_senses": [
                                    {
                                        "sense_id": "58a2f0c9-f352-37d9-beb9-5fabed55f06b",
                                        "entry_id": "0989e95b-8ef1-31cc-b6c7-f207b3da553b",
                                        "glosses": [
                                            "The part of milk that coagulates when it sours or is treated with enzymes; used to make cottage cheese, dahi, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c2cae4-c67f-49a4-9ae9-394f134514ad",
                                                "sense_id": "58a2f0c9-f352-37d9-beb9-5fabed55f06b",
                                                "text": "Little Miss Muffet, She sat on a tuffet, Eating of curds and whey; There came a little spider, Who sat down beside her, And frighted Miss Muffet away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec3bc05-ccec-3b77-9efc-d2cfad4182ec",
                                        "entry_id": "0989e95b-8ef1-31cc-b6c7-f207b3da553b",
                                        "glosses": [
                                            "dahi"
                                        ],
                                        "tags": [
                                            "India",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63f33e7f-e5d9-33ce-9952-d51e8f23966a",
                                        "entry_id": "0989e95b-8ef1-31cc-b6c7-f207b3da553b",
                                        "glosses": [
                                            "The coagulated part of any liquid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f030f7e0-c4c6-3e73-a24a-ca85431d396b",
                                        "entry_id": "0989e95b-8ef1-31cc-b6c7-f207b3da553b",
                                        "glosses": [
                                            "The edible flower head of certain brassicaceous plants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fe07ed4-05c1-40b8-828e-faf75ecab45c",
                                                "sense_id": "f030f7e0-c4c6-3e73-a24a-ca85431d396b",
                                                "text": "Broccoli should not be allowed to remain till the compactness of the head is broken, but should always be cut while the 'curd,' as the flowering mass is termed, is entire"
                                            },
                                            {
                                                "example_id": "9f727ef6-6266-4c7d-a6fd-45509461f41b",
                                                "sense_id": "f030f7e0-c4c6-3e73-a24a-ca85431d396b",
                                                "text": "This beautiful vegetable [Romanesco broccoli] looks rather like a green cauliflower designed by a mathematician and has lime-green 'spiralled' curds. The curds are nutty and tasty, and romanesco is worth growing just for its good looks. You can use romanesco in the same ways that you would normally use cauliflower but the flavour is sweeter and they look far more impressive. I try to leave them in large pieces when serving them because they're so beautiful."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "curd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "229ead06-2e66-3b64-9953-3cebb972694f",
                                        "entry_id": "8b7cea46-43d2-302d-84d7-d697ea169a93",
                                        "glosses": [
                                            "To form curd; to curdle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d1cab60-5d8b-3d47-b2f2-e8187aa2c1c5",
                                        "entry_id": "8b7cea46-43d2-302d-84d7-d697ea169a93",
                                        "glosses": [
                                            "To cause to coagulate or thicken; to cause to congeal; to curdle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253ffb4b-d95c-4319-9eb9-19fed1fde1d0",
                                                "sense_id": "2d1cab60-5d8b-3d47-b2f2-e8187aa2c1c5",
                                                "text": "Does it curd thy blood\n To say I am thy mother?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e42057fe-fafc-4357-a52c-35561b82bb63",
                        "source_entry_id": "e536d07b-3e39-3b9e-9a36-f1531242d7ed",
                        "source_sense_id": "c7eb7324-57bf-3822-a2bd-b5d16c0f710c",
                        "target_lang_word": "cailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "207f9db1-1d6d-3e40-827f-7f416812df2d",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Solidifier, coaguler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87292286-6fa4-4258-ac64-a072afa18921",
                                                "sense_id": "207f9db1-1d6d-3e40-827f-7f416812df2d",
                                                "text": "Le lait caille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b49bad7-4c66-3306-9746-baed139f674e",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Provoquer la coagulation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed86dd9-e21e-41f4-ba40-5e317ca22c17",
                                                "sense_id": "0b49bad7-4c66-3306-9746-baed139f674e",
                                                "text": "On utilise de la présure pour cailler le lait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20997010-66d0-373a-a13c-6a5f3264fe02",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Faire froid."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157add59-a036-4ec2-b571-4701e28703c0",
                                                "sense_id": "20997010-66d0-373a-a13c-6a5f3264fe02",
                                                "text": "Ça caille en ce moment. Moi, j’étais en vacances dans les Caraïbes, 30°C à l’ombre… C’est toujours agréable quand on a très chaud de savoir que les autres se les pèlent… On profite mieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Avoir froid."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746802cc-645e-4105-b61f-a02a93f8ae57",
                                                "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                                "text": "Par contre on gèle, on caille, on a l’onglée, les balloches ratatinées, les pieds glacés."
                                            },
                                            {
                                                "example_id": "ca821185-f553-4415-82f1-5f5e20015221",
                                                "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                                "text": "Cesse de rêver à Mulligan et ferme la porte, on caille!"
                                            },
                                            {
                                                "example_id": "ca831548-e327-4c5c-9ebd-472fc0e4dc5e",
                                                "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                                "text": "J’aurais dû mettre mon manteau, je caille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5691772-aa47-379e-b2ba-acbcb04981b0",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Produire des crottes (volatiles)."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8bec23-68cb-4c7a-b5bd-540d62b34b63",
                                                "sense_id": "d5691772-aa47-379e-b2ba-acbcb04981b0",
                                                "text": "Je dois nettoyer la table, les moineaux ont caillé partout."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c60cfa1b-3157-35a3-b116-c63d0e6d7164",
                                        "entry_id": "23916ada-e2c4-3970-bb83-28803d71ccdd",
                                        "glosses": [
                                            "S’endormir."
