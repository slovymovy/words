                ],
                "senses": [
                    {
                        "sense_id": "b34ff420-5bbe-3353-95a6-78e6f79f0bbc",
                        "entry_id": "ddfd3127-602a-3b79-8841-67fac57374ab",
                        "glosses": [
                            "Rauch, der aus einem Schornstein steigt und vom Wind in eine Richtung getrieben wird, so dass er eine fahnenähnliche Wolke bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dae4f4f3-23e2-4836-a3af-7c5c074b56b5",
                                "sense_id": "b34ff420-5bbe-3353-95a6-78e6f79f0bbc",
                                "text": "„Aus einem einsamen, baufälligen Schornstein stiegen graue Rauchfahnen in die Luft.“"
                            },
                            {
                                "example_id": "a4098ac8-e71f-4d9c-b70b-6238d67e1f5b",
                                "sense_id": "b34ff420-5bbe-3353-95a6-78e6f79f0bbc",
                                "text": "„Die Rauchfahne aus Feuerungsanlagen für feste Brennstoffe muß während der ersten fünf Minuten beim Anheizen heller sein als der Grauwert 3, danach heller als der Grauwert 2 der Ringelmann-Skala.“"
                            },
                            {
                                "example_id": "b161f666-8c41-4dbd-9389-8641fda17bf2",
                                "sense_id": "b34ff420-5bbe-3353-95a6-78e6f79f0bbc",
                                "text": "„Mit gewaltigen Rauchfahnen zog es davon, der Ferne und der Fremde entgegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
