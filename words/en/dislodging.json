{
    "word_family": [
        "dislodge",
        "dislodgement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0f66ce2-0305-3634-8646-05bc5410f85d",
                    "sense_definition": "The present participle and gerund of <w>dislodge</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain was <w>dislodging</w> rocks from the cliff side.",
                            "target_lang_translations": {
                                "cs": "Silný déšť <w>uvolňoval</w> kameny ze srázu."
                            }
                        },
                        {
                            "text": "He succeeded in <w>dislodging</w> the stuck key from the lock.",
                            "target_lang_translations": {
                                "cs": "Podařilo se mu <w>vytlačit</w> zaseknutý klíč ze zámku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost spočívající ve vytlačení, uvolnění nebo odstranění něčeho z místa, kde to pevně drželo."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uvolňování",
                                "target_lang_sense_clarification": "proces, při kterém se něco stává volným"
                            },
                            {
                                "target_lang_word": "vytlačování",
                                "target_lang_sense_clarification": "fyzické vytlačení předmětu z jeho pozice"
                            },
                            {
                                "target_lang_word": "odstraňování",
                                "target_lang_sense_clarification": "obecný proces vyjmutí něčeho z daného místa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbf3a9d4-f930-3c05-ba98-89b0272654a8",
                    "sense_definition": "The act of removing or forcing something out of its place.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dislodging</w> of the debris took several hours of hard work.",
                            "target_lang_translations": {
                                "cs": "<w>Odstraňování</w> trosek zabralo několik hodin tvrdé práce."
                            }
                        },
                        {
                            "text": "The sudden <w>dislodging</w> of the stone caused a small landslide.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>uvolnění</w> kamene způsobilo malý sesuv půdy."
                            }
                        }
                    ],
                    "synonyms": [
                        "removal",
                        "displacement"
                    ],
                    "antonyms": [
                        "installation",
                        "placement"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt vyjmutí nebo násilného vytlačení něčeho z jeho původního místa."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uvolnění",
                                "target_lang_sense_clarification": "jednorázový akt vyproštění předmětu"
                            },
                            {
                                "target_lang_word": "vytlačení",
                                "target_lang_sense_clarification": "akt násilného posunutí předmětu z jeho pozice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}