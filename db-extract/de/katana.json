                    {
                        "translation_id": "5a647440-7ab0-47d9-8da0-f4e2a543f5de",
                        "source_entry_id": "134151d4-1f92-3abf-b735-26cb3b18fb01",
                        "source_sense_id": "4a903fa8-f08d-32bb-8060-1d0a9b881895",
