                                                "example_id": "6f8377b5-3219-43e0-8366-30b84991f210",
                                                "sense_id": "6bb87daa-cd43-3e10-9857-eaaf8865c9cd",
                                                "text": "Der überwiegende Teil der Bevölkerung ist dagegen."
                                            }
