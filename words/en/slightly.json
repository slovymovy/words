                {
                    "sense_id": "ac3a0cf1-ec45-3980-8d39-f6d4a7833f69",
                    "sense_definition": "To a small extent or degree",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The price of milk is <w>slightly</w> higher this week than it was last month.",
                            "target_lang_translations": {
                                "ru": "Цена на молоко на этой неделе <w>немного</w> выше, чем в прошлом месяце.",
                                "es": "El precio de la leche es <w>ligeramente</w> más alto esta semana que el mes pasado."
                            }
                        },
                        {
                            "text": "I feel <w>slightly</w> better today after taking the medicine and resting all afternoon.",
                            "target_lang_translations": {
                                "ru": "Сегодня я чувствую себя <w>чуть</w> лучше после приема лекарства и отдыха в течение всего дня.",
                                "es": "Hoy me siento <w>levemente</w> mejor después de tomar la medicina y descansar toda la tarde."
                            }
                        }
                    ],
                    "synonyms": [
                        "a little",
                        "a bit",
                        "somewhat",
                        "marginally"
                    ],
                    "antonyms": [
