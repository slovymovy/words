        "nl-extract.jsonl": [
            {
                "entry_id": "908fb607-3fee-3f36-99f5-41829d363b39",
                "word": "opkikkeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7dbc31f5-767f-3153-9ef7-4d2c86b71db3",
                        "entry_id": "908fb607-3fee-3f36-99f5-41829d363b39",
                        "glosses": [
                            "zorgen dat iemands stemming verbetert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1088e786-6978-4c09-98ec-f3d01fa48d22",
                                "sense_id": "7dbc31f5-767f-3153-9ef7-4d2c86b71db3",
                                "text": "In Nederlandse supermarkten staan doosjes van Honig op het schap met zakjes poeder erin. Opkikker staat er op. Eerst maakte Unilever reclame voor Cup-a-Soup die een uitgeteld mens op kantoor tegen vieren in de middag zou opkikkeren. Toen bijna iedereen geloofde dat we om vier uur zijn uitgeteld en een bekertje oplossoep helpt, ging Honig het ook maken. Er zijn er meer. Ze hebben een typisch soepluchtje, direct te herkennen, blind. En je ruikt dat de fabriek er zijn best niet op gedaan heeft. Snel tevreden."
                            }
                        ]
                    },
                    {
                        "sense_id": "37011027-1635-3356-802d-e059baf358e5",
                        "entry_id": "908fb607-3fee-3f36-99f5-41829d363b39",
                        "glosses": [
                            "weer gezond worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef32640-3eb4-4bec-b32e-52a61a352c65",
                                "sense_id": "37011027-1635-3356-802d-e059baf358e5",
                                "text": "Een depressiepatiënt kan van hardlopen zo goed opkikkeren dat mensen met een lichte depressie waarschijnlijk beter eerst kunnen gaan hardlopen dan antidepressiva slikken of in therapie gaan. Dat staat in de nieuwste behandelrichtlijn depressie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8afaf2c2-d786-4b09-bc52-b4263db5b3aa",
                        "source_entry_id": "908fb607-3fee-3f36-99f5-41829d363b39",
                        "source_sense_id": "7dbc31f5-767f-3153-9ef7-4d2c86b71db3",
                        "source_sense_description": "zorgen dat iemands stemming verbeterd",
                        "target_lang_word": "stimulate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e29b5471-8acd-3b64-9312-000ee00308c1",
                                        "entry_id": "3dddd3d5-4bdd-3457-8a72-6978028a7507",
                                        "glosses": [
                                            "To encourage into action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9fe81f5-183c-4ad5-8f3f-b200aa650d0b",
                                                "sense_id": "e29b5471-8acd-3b64-9312-000ee00308c1",
                                                "text": "stimulate the economy"
                                            },
                                            {
                                                "example_id": "cebdcf9f-a956-436b-91a8-b4ba4181ef75",
                                                "sense_id": "e29b5471-8acd-3b64-9312-000ee00308c1",
                                                "text": "To most others Lord Allerton's obvious preference for Mary would have been an insuperable obstacle; it only served to stimulate her ladyship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "308a673b-3555-3f42-a583-772aca4c699d",
                                        "entry_id": "3dddd3d5-4bdd-3457-8a72-6978028a7507",
                                        "glosses": [
                                            "To arouse an organism to functional activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3137630-c396-4489-8b40-17fa82bcd458",
                                                "sense_id": "308a673b-3555-3f42-a583-772aca4c699d",
                                                "text": "stimulate my mind"
                                            },
                                            {
                                                "example_id": "70ad0ecd-02a4-4bdd-9a9d-74846461658c",
                                                "sense_id": "308a673b-3555-3f42-a583-772aca4c699d",
                                                "text": "He was sexually stimulated by the dancer's moves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae5fcb0f-1a70-45da-a65d-568986ce10da",
                        "source_entry_id": "908fb607-3fee-3f36-99f5-41829d363b39",
                        "source_sense_id": "7dbc31f5-767f-3153-9ef7-4d2c86b71db3",
                        "source_sense_description": "zorgen dat iemands stemming verbeterd",
                        "target_lang_word": "encourage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encourage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                        "entry_id": "53091342-1b8d-3b40-9e02-eab547d0ecba",
                                        "glosses": [
                                            "To mentally support; to motivate, give courage, hope or spirit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e08683-9cc4-4404-bac0-edea0ea6c88d",
                                                "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                                "text": "I encouraged him during his race."
                                            },
                                            {
                                                "example_id": "12cfc985-ee1d-49ab-9bff-cef5b69fde60",
                                                "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                                "text": "Delia's coach encouraged her to focus on the positives."
                                            },
                                            {
                                                "example_id": "3894ab6d-fad8-4d91-8fc5-863569c5f23e",
                                                "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                                "text": "\"It's a lose-lose situation. It can be turned into a win-win. We should be encouraging and supporting expensive bi-mode freight locomotives, especially where capacity is constrained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf1a855-0811-352d-9f5a-3a7369f707e6",
                                        "entry_id": "53091342-1b8d-3b40-9e02-eab547d0ecba",
                                        "glosses": [
                                            "To spur on, strongly recommend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec46539-2e73-4300-a73f-1ebc534fdd6d",
                                                "sense_id": "fbf1a855-0811-352d-9f5a-3a7369f707e6",
                                                "text": "We encourage the use of bicycles in the town centre."
                                            },
                                            {
                                                "example_id": "acb76fd3-edcd-4d49-84ae-26168d466ee5",
                                                "sense_id": "fbf1a855-0811-352d-9f5a-3a7369f707e6",
                                                "text": "We encourage you to cycle instead of taking the car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                        "entry_id": "53091342-1b8d-3b40-9e02-eab547d0ecba",
                                        "glosses": [
                                            "To foster, give help or patronage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3945341a-b694-4e47-bc20-6d372b2a3454",
                                                "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                                "text": "The royal family has always encouraged the arts in word and deed."
                                            },
                                            {
                                                "example_id": "3162e6a8-4747-4592-935c-ab3ff6958224",
                                                "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                                "text": "They remove all sense of self-responsibility from us prisoners. We have virtually no control over any aspect of our lives. This does not encourage our ability to return to community life outside."
                                            },
                                            {
                                                "example_id": "63a2dfe9-2427-4bf0-896d-f3123ecedd83",
                                                "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                                "text": "And this is where the larger problem lies: when states try to enforce impossible bans, everyone loses. 3D printing farragoes have all the hallmarks of the absolute worst kind of ineffectual ban: one which encourages overly draconian laws that carry huge side effects, and that ultimately to have little to no effect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b7905ec-e7de-4fc0-9e64-303bdbc58491",
                        "source_entry_id": "908fb607-3fee-3f36-99f5-41829d363b39",
                        "source_sense_id": "7dbc31f5-767f-3153-9ef7-4d2c86b71db3",
                        "source_sense_description": "zorgen dat iemands stemming verbeterd",
                        "target_lang_word": "brighten",
