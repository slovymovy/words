{
    "word_family": [
        "accumulateur",
        "accumulatif",
        "accumulation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bd2204a-5285-3423-817e-9da0185e0d1a",
                    "sense_definition": "Amasser et entasser des choses matérielles en grande quantité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accumulation_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendance à <w>accumuler</w> de vieux journaux dans son garage sans jamais rien jeter."
                        },
                        {
                            "text": "Les enfants adorent <w>accumuler</w> des coquillages ramassés sur la plage pendant les vacances."
                        }
                    ],
                    "synonyms": [
                        "amasser",
                        "empiler",
                        "entasser"
                    ],
                    "antonyms": [
                        "disperser",
                        "éparpiller"
                    ],
                    "common_phrases": [
                        "accumuler des objets",
                        "accumuler des richesses",
                        "accumuler des déchets"
                    ]
                },
                {
                    "sense_id": "619da990-fced-36be-9edc-18b7969dcec3",
                    "sense_definition": "Rassembler ou voir se succéder en grand nombre des éléments abstraits comme des preuves, des retards ou des erreurs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "accumulation_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat de la défense cherche à <w>accumuler</w> les preuves pour innocenter son client."
                        },
                        {
                            "text": "À force de veiller tard chaque soir, vous allez <w>accumuler</w> de la fatigue inutilement."
                        }
                    ],
                    "synonyms": [
                        "enchaîner",
                        "multiplier"
                    ],
                    "common_phrases": [
                        "accumuler les preuves",
                        "accumuler les erreurs",
                        "accumuler du retard",
                        "accumuler de la fatigue"
                    ]
                },
                {
                    "sense_id": "dea50fc2-0eed-3a83-8a1a-45e508b22f99",
                    "sense_definition": "S'amasser, se former en tas ou augmenter progressivement avec le temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accumulation_reflexive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'épais nuages gris s'<w>accumulent</w> à l'horizon avant l'arrivée du violent orage."
                        },
                        {
                            "text": "Les dossiers urgents s'<w>accumulent</w> rapidement sur son bureau depuis le début de la semaine."
                        }
                    ],
                    "synonyms": [
                        "s'amonceler",
                        "s'entasser"
                    ],
                    "antonyms": [
                        "se dissiper"
                    ]
                },
                {
                    "sense_id": "0629a633-08bc-39ec-ac81-3ca2fd0fd8cc",
                    "sense_definition": "Thésauriser, amasser de l'argent ou des biens par avidité sans chercher à les utiliser.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thesaurisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieil avare ne pensait qu'à <w>accumuler</w> sans jamais profiter de sa fortune."
                        },
                        {
                            "text": "Plutôt que d'investir utilement dans l'entreprise, le dirigeant préfère simplement <w>accumuler</w>."
                        }
                    ],
                    "synonyms": [
                        "thésauriser"
                    ],
                    "antonyms": [
                        "dépenser",
                        "dilapider"
                    ]
                }
            ]
        }
    ]
}