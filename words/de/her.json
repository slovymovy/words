                        "eine Weile her"
                    ]
                },
                {
                    "sense_id": "85cb40e0-fe06-3820-8d3d-d4123a98f025",
                    "sense_definition": "verstärkend in Verbindung mit Präpositionen oder Adverbien zur Kennzeichnung einer begleitenden Bewegung",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "begleitend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der kleine Hund lief während des gesamten Spaziergangs ruhig neben mir <w>her</w>."
                        },
