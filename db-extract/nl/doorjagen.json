        "nl-extract.jsonl": [
            {
                "entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                "word": "doorjagen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d6e7fb8-e51d-30f0-831c-33f2d6ad1814",
                        "entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                        "glosses": [
                            "heel snel iets verbruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f016d97-0e4b-4eac-b862-8a3ce92f8bdf",
                                "sense_id": "3d6e7fb8-e51d-30f0-831c-33f2d6ad1814",
                                "text": "Ik vrees dat hij al zijn geld er doorgejaagd heeft."
                            }
                        ]
                    },
                    {
                        "sense_id": "58595e89-d76c-37b4-9829-55c991bb194f",
                        "entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                        "glosses": [
                            "met (te) grote haast iets afwerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb747d5-0e8e-41c4-9120-87d5b2e97fa6",
                                "sense_id": "58595e89-d76c-37b4-9829-55c991bb194f",
                                "text": "Ze wil af van het „rendementsdenken” als dat inhoudt dat de universiteit een leerfabriek is waar je zoveel mogelijk studenten zo snel mogelijk doorjaagt en van een diploma voorziet."
                            }
                        ]
                    },
                    {
                        "sense_id": "b59d12ce-d370-3f9c-bb41-f038b06fc907",
                        "entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                        "glosses": [
                            "doorgaan met jagen en haasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cfeddb4-88cc-42b3-b5ca-f0fab595f904",
                                "sense_id": "b59d12ce-d370-3f9c-bb41-f038b06fc907",
                                "text": "In de haar kenmerkende stijl, met aandoenlijke en expressieve stokpoppetjes in collagevorm, schetst Hartjes een situatie die al te herkenbaar is: een overvolle agenda, een hoofd dat overloopt en vooral doorjagen."
                            },
                            {
                                "example_id": "0ca3f571-d181-4590-87b2-39b7b5d73740",
                                "sense_id": "b59d12ce-d370-3f9c-bb41-f038b06fc907",
                                "text": "Kadioglu zorgde vlak voor rust weer voor lachende gezichten bij NEC door voor de 2-1 te zorgen, een paar minuten na de rust kopte Jari Schuurman de 3-1 binnen. Achahbar zorgde na een uur spelen met een intikker voor de 4-1 en direct na de aftrap, na goed doorjagen, voor de 5-1 en zijn hattrick."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d137d4d-4831-4ab7-bac8-cbda9f76ab64",
                        "source_entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                        "source_sense_id": "3d6e7fb8-e51d-30f0-831c-33f2d6ad1814",
                        "source_sense_description": "heel snel iets verbruiken",
                        "target_lang_word": "use up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "use up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8976c574-1be3-31bd-bfca-a83aef76efae",
                                        "entry_id": "c1574cff-cae1-33f5-8aa7-1f4800671a51",
                                        "glosses": [
                                            "To consume, deplete, expend, or exhaust."
                                        ],
                                        "tags": [
                                            "of a resource"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3332498-86f2-416e-adc8-b2d5fd9b0c7a",
                                                "sense_id": "8976c574-1be3-31bd-bfca-a83aef76efae",
                                                "text": "\"My third command to the Winged Monkeys,\" said Glinda, \"shall be to carry you to your forest. Then, having used up the powers of the Golden Cap, I shall give it to the King of the Monkeys, that he and his band may thereafter be free for evermore.\""
                                            },
                                            {
                                                "example_id": "1695c7e6-32f0-42bb-a186-039f50bdba34",
                                                "sense_id": "8976c574-1be3-31bd-bfca-a83aef76efae",
                                                "text": "The All Blacks drove upfield, using up the remaining moments, and when Joubert blew for another French infringement, the biggest party in New Zealand's history was under way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eef2df8d-1e18-34d2-aed8-05b02a90d381",
                                        "entry_id": "c1574cff-cae1-33f5-8aa7-1f4800671a51",
                                        "glosses": [
                                            "To take or occupy."
                                        ],
                                        "tags": [
                                            "of time or space"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0705e17-c44e-4c29-93b1-4b68a8019d8d",
                        "source_entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                        "source_sense_id": "3d6e7fb8-e51d-30f0-831c-33f2d6ad1814",
                        "source_sense_description": "heel snel iets verbruiken",
                        "target_lang_word": "consume",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consume",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfe8e0cf-d15f-3652-b53c-a22a3bcac169",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To use up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4f7fd2-bcbc-4c4c-9823-4b08e06288ba",
                                                "sense_id": "dfe8e0cf-d15f-3652-b53c-a22a3bcac169",
                                                "text": "The power plant consumes 30 tons of coal per hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88ba2f22-a601-3b03-8802-1d103d0a192b",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To eat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22b57a8a-342e-4c5f-9e15-661ae9e7c763",
                                                "sense_id": "88ba2f22-a601-3b03-8802-1d103d0a192b",
                                                "text": "Baby birds consume their own weight in food each day."
                                            },
                                            {
                                                "example_id": "649c6fe6-a59b-4bb7-a059-ad09e9416731",
                                                "sense_id": "88ba2f22-a601-3b03-8802-1d103d0a192b",
                                                "text": "Concerns were raised around the ability of Milky Way species to consume proteins from Andromeda, so seed banks formed a significant part of the arks' cargo. We now know it is safe to consume food grown or hunted here, though enzyme supplements are recommended and have become a social norm at mealtimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761476f4-773a-33c9-ab20-d42c541e372b",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To completely occupy the thoughts or attention of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "502fb033-6e14-456b-ba20-4ee05aa48bba",
                                                "sense_id": "761476f4-773a-33c9-ab20-d42c541e372b",
                                                "text": "Desire consumed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d212f2-f644-3586-809b-0af34111b894",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To destroy completely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db9498f4-537c-45ad-b780-d1dc1ae00621",
                                                "sense_id": "76d212f2-f644-3586-809b-0af34111b894",
                                                "text": "The building was consumed by fire."
                                            },
                                            {
                                                "example_id": "8cf48946-cc5b-4db5-9d9a-5267e5f6794c",
                                                "sense_id": "76d212f2-f644-3586-809b-0af34111b894",
                                                "text": "If he were putting to my house the brand / That shall consume it."
                                            },
                                            {
                                                "example_id": "7465e9ea-56cd-4846-adef-8b384276827f",
                                                "sense_id": "76d212f2-f644-3586-809b-0af34111b894",
                                                "text": "Lay not up for yourselves treasures upon the earth, where moth and rust consume, and where thieves break through and steal: but lay up for yourselves treasures in heaven, where neither moth nor rust doth consume, and where thieves do not break through to steal: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8389fd94-234f-30cc-be21-0e95a7bc902e",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To waste away slowly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48313d0a-6fe4-4e01-91f3-d40e3a67025d",
                                                "sense_id": "8389fd94-234f-30cc-be21-0e95a7bc902e",
                                                "text": "Therefore, let Benedick, like cover'd fire, / Consume away in sighs."
                                            },
                                            {
                                                "example_id": "f3dce5a8-5ff9-46e1-91f6-6131e568f1e4",
                                                "sense_id": "8389fd94-234f-30cc-be21-0e95a7bc902e",
                                                "text": "But, sir, you see how weak I am. You must see that I have been consuming from day to day […]."
                                            },
                                            {
                                                "example_id": "38af82a7-ad21-4a16-80b1-58b7b7c93aa3",
                                                "sense_id": "8389fd94-234f-30cc-be21-0e95a7bc902e",
                                                "text": "He assured her the child was consuming at that moment in the next room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f51a40-965d-3bd6-8d9c-df9b25afc0d3",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To trade money for good or services as an individual."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33161876-2eea-46c1-b561-f0209f817156",
                                                "sense_id": "c6f51a40-965d-3bd6-8d9c-df9b25afc0d3",
                                                "text": "In a materialistic society, individuals are taught to consume, consume, consume."
                                            },
                                            {
                                                "example_id": "024b5965-d7d8-42e2-8291-cb3d1309cbe6",
                                                "sense_id": "c6f51a40-965d-3bd6-8d9c-df9b25afc0d3",
                                                "text": "If you consume this product while in Japan, you may be subject to consumption tax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a68ff4f-2f9c-3b4f-a748-074ab339699b",
                                        "entry_id": "592f8cc3-9fb7-3e56-b4d2-d6471d1db254",
                                        "glosses": [
                                            "To absorb information, especially through the mass media."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd8f7d09-bc33-4a35-bc39-c2e27f39260f",
                                                "sense_id": "7a68ff4f-2f9c-3b4f-a748-074ab339699b",
                                                "text": "The Internet has changed the way we consume news."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3a9a830-c364-4a24-bb73-416a77615ed4",
                        "source_entry_id": "6b42b1e8-f235-3d8d-8787-7668f33d1ff0",
                        "source_sense_id": "3d6e7fb8-e51d-30f0-831c-33f2d6ad1814",
                        "source_sense_description": "heel snel iets verbruiken",
                        "target_lang_word": "spend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cbb5c5d-e47e-3164-b833-a690b9ae12f0",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To pay out (money)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c38490-ff49-4034-98e0-15c6c772fc27",
                                                "sense_id": "2cbb5c5d-e47e-3164-b833-a690b9ae12f0",
                                                "text": "He spends far more on gambling than he does on living proper."
                                            },
                                            {
                                                "example_id": "f62019af-aef8-4875-9b5d-15d2ab75f472",
                                                "sense_id": "2cbb5c5d-e47e-3164-b833-a690b9ae12f0",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            },
                                            {
                                                "example_id": "4a8aa1a6-4552-4e0c-b8a2-1ec868ab14ca",
                                                "sense_id": "2cbb5c5d-e47e-3164-b833-a690b9ae12f0",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c60d2c8-d180-3914-9036-10ea8619a18a",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To bestow; to employ; often with on or upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf0fe7a-95ca-460c-b494-3bda0dcc0983",
                                                "sense_id": "2c60d2c8-d180-3914-9036-10ea8619a18a",
                                                "text": "I […] am never loath / To spend my judgment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb13ea23-632a-3ae9-b4e0-70591ad47282",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To squander."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b245c6f-e0e4-4c8a-b66f-ab60b2c02f8c",
                                                "sense_id": "fb13ea23-632a-3ae9-b4e0-70591ad47282",
                                                "text": "to spend an estate in gambling"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d936ed-368d-3f34-8c5f-bdee22a45b16",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To exhaust, to wear out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629415fe-f806-47c1-af75-66e70da400fa",
                                                "sense_id": "83d936ed-368d-3f34-8c5f-bdee22a45b16",
                                                "text": "The violence of the waves was spent."
                                            },
                                            {
                                                "example_id": "28f6d826-65eb-4866-a76d-7ede7766346e",
                                                "sense_id": "83d936ed-368d-3f34-8c5f-bdee22a45b16",
                                                "text": "their bodies spent with long labour and thirst"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To consume, to use up (time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4793e2f-19ae-4613-83bb-ff8ff9fe5340",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "My sister usually spends her free time in nightclubs."
                                            },
                                            {
                                                "example_id": "be4ff810-fdfe-477c-8574-367d82e05619",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "We spent the winter in the south of France."
                                            },
                                            {
                                                "example_id": "5ec7d97f-f6e6-4160-8014-252d2cdbde76",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "752c6762-4f97-4d91-99cb-f00bbffe1d4e",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time."
                                            },
                                            {
                                                "example_id": "a6313c8c-c5dc-473b-ba28-bd8725d64111",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "The last occasion on which the Kaiser [Wilhelm II] used this train was for an inglorious journey into Holland towards the end of the 1914 war. He spent the night in it at Eysden [Eijsden], while the Queen of the Netherlands and a hastily summoned Cabinet debated what to do with him."
                                            },
                                            {
                                                "example_id": "9265c60e-d1bf-4ba9-94fb-5a8eeb463593",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "Clara's father, a trollish ne'er-do-well who spent most of his time in brothels and saloons, would disappear for days and weeks at a stretch, leaving Clara and her mother to fend for themselves."
                                            },
                                            {
                                                "example_id": "8e6247c2-c304-4008-bfde-dae3e636fdf1",
                                                "sense_id": "c4e79361-f663-3c6f-8c0f-d8c3e13ad041",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304949f7-87eb-38d1-b2a0-b6511a83b951",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To have an orgasm; to ejaculate sexually."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ea4f0f3-21a9-4e26-b4cd-418df96f2abb",
                                                "sense_id": "304949f7-87eb-38d1-b2a0-b6511a83b951",
                                                "text": "The fish spends his semen on eggs which he finds floating and whose mother he has never seen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feace929-c668-3838-ab95-6662d3af2873",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To waste or wear away; to be consumed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d9ced54-09cc-4664-844e-2161e938cff9",
                                                "sense_id": "feace929-c668-3838-ab95-6662d3af2873",
                                                "text": "Energy spends in the using of it."
                                            },
                                            {
                                                "example_id": "2710c50e-19c4-4799-ae7f-ac787f17b191",
                                                "sense_id": "feace929-c668-3838-ab95-6662d3af2873",
                                                "text": "The sound spendeth and is dissipated in the open air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9355db6e-7480-3502-ada4-09f8656b7e52",
                                        "entry_id": "f7d8993f-a4ae-3fca-9ff1-6c1da7062ba1",
                                        "glosses": [
                                            "To be diffused; to spread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4254e6-bed2-4983-aa16-e73ffb1ae1c4",
                                                "sense_id": "9355db6e-7480-3502-ada4-09f8656b7e52",
                                                "text": "The vines that they use for wine are so often cut, that their sap spendeth into the grapes."
                                            }
                                        ]
