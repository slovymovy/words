                "senses": [
                    {
                        "sense_id": "eb03322c-b3a2-3976-a80b-0daf2a87c1ea",
                        "entry_id": "eb4ca020-f081-3fc3-a360-2cda1aa4c428",
                        "glosses": [
                            "auf etwas verzichten/aufgeben"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "63e208b2-3684-4346-8ffc-8dd8f3fdc4bf",
                                "sense_id": "eb03322c-b3a2-3976-a80b-0daf2a87c1ea",
                                "text": "\"Many of these might seem ingrate and unkind children, that will no better acknowledge and recognize their parents in words and outward pretense but abrenounce and cast them off, as though they hated them as dogs and serpents.\""
                            },
                            {
                                "example_id": "3f02c5b4-18c8-418d-9961-9db091db7eb6",
                                "sense_id": "eb03322c-b3a2-3976-a80b-0daf2a87c1ea",
                                "text": "\"First, That he willed him, being a priest, to abrenounce matrimony. \""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "598efa47-26d4-4d5f-b875-af07f05d3838",
                        "source_entry_id": "eb4ca020-f081-3fc3-a360-2cda1aa4c428",
                        "source_sense_id": "eb03322c-b3a2-3976-a80b-0daf2a87c1ea",
                        "source_sense_description": "veraltet: auf etwas verzichten/aufgeben",
                        "target_lang_word": "verzichten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzichten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                        "entry_id": "09db8cea-70a6-35bc-9b1f-bcdccef84466",
                                        "glosses": [
                                            "Ansprüche auf etwas freiwillig aufgeben; etwas aus seiner freien Entscheidung heraus nicht tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83567dbd-11f1-4f9d-8efd-12b2128570fb",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "Ich verzichte auf eine Antwort."
                                            },
                                            {
                                                "example_id": "0c54378a-4335-4cd5-bc55-2a2838007e92",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "Möchtest denn du die Jubiläumsrede halten? Nein, ich verzichte dankend."
                                            },
                                            {
                                                "example_id": "25d6ec1e-c64a-403d-a6ab-cdff49634cc3",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "„Wie kein anderen Herrscher machte Tiberius wenig Aufhebens von seiner Person und verzichtete auf Populismus und übertriebene Selbstdarstellung.“"
                                            },
                                            {
                                                "example_id": "c7f4265b-2b87-4217-87b8-03c0f76dbadf",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "Weil […] die Lagerhallen Geld kosten, versucht man, so weit wie möglich darauf zu verzichten […]"
                                            },
                                            {
                                                "example_id": "bdc0aba4-242e-4dab-b3bb-d437879ba2e6",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "„Jako aber, der sich bereits als Mann fühlte und ein echtes Jagdmesser am Gürtel trug, verzichtete zugunsten von Bruder und Schwester auf die Leckerei.“"
                                            },
                                            {
                                                "example_id": "b0602950-2e39-4f4c-b001-e86481c6db59",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "Das Friedensforschungsinstitut Sipri sieht keine Bereitschaft unter den Atommächten weltweit, in Zukunft auf Nuklearwaffen zu verzichten."
                                            },
                                            {
                                                "example_id": "53726936-f618-45d5-bc14-b8c2a4c06b10",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "„Im Flugsport kann sich z.B. eine Ordalsituation andeuten, wenn ein Pilot auf seinen Gerät- und Startcheck verzichtet, wenn ein Paragleiter bei Föhn oder aufziehender Gewitterfront einen Flug wagt, wenn ein Drachenflieger in ein Wolkenfenster startet, […].“"
                                            },
                                            {
                                                "example_id": "e73286f4-8b5d-4641-8c3f-b164ca87949e",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "[COVID-19-Pandemie:] „Die Regierungschefin [Anmerkung: Neuseelands Jacina Adern] verzichtet parallel für ein halbes Jahr auf einen Teil ihres Gehalts.“"
                                            },
                                            {
                                                "example_id": "11aff740-67fa-464e-95d3-edcead8f9f46",
                                                "sense_id": "1d63f19c-d3b2-3325-8626-9e027ea3a09e",
                                                "text": "[Klimaschutz:] „Wir können und wir müssen auf russisches Gas und Öl und Kohle verzichten.““"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18490c59-9916-4922-87d7-2743989508ab",
                        "source_entry_id": "eb4ca020-f081-3fc3-a360-2cda1aa4c428",
                        "source_sense_id": "eb03322c-b3a2-3976-a80b-0daf2a87c1ea",
                        "source_sense_description": "veraltet: auf etwas verzichten/aufgeben",
                        "target_lang_word": "aufgeben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufgeben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "etwas Sinnloses beenden, aufhören, einstellen; etwas beenden, obwohl der Sinn im Weitermachen besteht"
                                        ],
                                        "tags": [
                                            "auch intransitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddbbf4d9-8410-4f74-af65-6436ac533a12",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Der Läufer gab nach einem Sturz auf."
                                            },
                                            {
                                                "example_id": "8e1324eb-a2fb-4754-884b-8509e64f648c",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Verneinung: Obwohl sie seit drei Jahren verschwunden ist, haben Meiers ihre kleine Tochter noch nicht aufgegeben."
                                            },
                                            {
                                                "example_id": "d2339fa9-e25a-42c5-8a17-b7dfcdd52348",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "„[…] die Brexit-Gegner werden nicht einfach aufgeben, nur weil es jetzt einen neuen Premierminister [B. Johnson] gibt.“"
                                            },
                                            {
                                                "example_id": "449fad34-cb48-4cd5-b986-f8ca0ec76a81",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Die Mannschaft gab das sinkende Schiff auf."
                                            },
                                            {
                                                "example_id": "ad867060-8588-4459-b8b4-160140595932",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Wegen mangelnder Aufträge musste ich meinen Betrieb aufgeben, nachdem die Bank meine Kreditlinie nicht weiter erhöhen wollte."
                                            },
                                            {
                                                "example_id": "c922114d-a226-4314-b0ad-ba7e02633367",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Diese Mühle wurde schon vor Jahren aufgegeben."
                                            },
                                            {
                                                "example_id": "613c8a01-96a7-4834-82a7-c077f3c65602",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "„Sie war eine der wenigen, die noch nicht aufgegeben hatten. Sie würde nie aufgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "jemandem (etwas) aufgeben: etwas zur Erledigung auftragen, zur Aufgabe machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886fa2d7-25ff-4336-8afd-67423aefdf61",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Ich hatte Ihnen doch aufgegeben, den Rasen zu mähen!"
                                            },
                                            {
                                                "example_id": "4b1895b0-1c9c-41b9-863c-9e6ba3aecad1",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Ab Morgen sind Ferien, deswegen gebe ich euch keine Hausaufgaben auf."
                                            },
                                            {
                                                "example_id": "fefa65c2-461a-4218-a536-fa5c74c5935c",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Die Mathelehrerin gibt den Kindern viel zu viel auf."
                                            },
                                            {
                                                "example_id": "586a1834-8571-4de4-ac5d-4f7884c322b0",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Ihr Verschwinden gab uns viele Rätsel auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "jemandem etwas zur Beförderung oder Bearbeitung übergeben"
                                        ],
                                        "tags": [
                                            "etwas bei jemandem aufgeben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29bda046-7634-476b-8820-12bd88fa8e88",
                                                "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                                "text": "Ich werde zur Zeitung gehen und ein Inserat aufgeben."
                                            },
                                            {
                                                "example_id": "124acc7f-7895-49f8-99e6-c5c657adcdfe",
                                                "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                                "text": "Bitte geben Sie diesen Brief noch bei der Post auf."
                                            },
                                            {
                                                "example_id": "c8f409c7-4dfb-4bf9-9ede-b5e289d4b6b5",
                                                "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                                "text": "Nachdem wir unsere Bestellungen aufgegeben hatten, konnten wir uns in Ruhe unterhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a8f7c929-cbdb-3bcd-a79e-4e759dcb929a",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "keine Hoffnung mehr auf Genesung/Rettung von jemandem haben, jemanden als tot/verloren betrachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668fdedd-0607-4c06-81b5-24ae4bc9a7a8",
                                                "sense_id": "a8f7c929-cbdb-3bcd-a79e-4e759dcb929a",
                                                "text": "„Am Aschermittwoch erhielt ich in der Frühe einen Brief von C. C., daß der Arzt ihre Freundin aufgegeben hätte; diese könne höchstens noch etwa vierzehn Tage leben. “"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
