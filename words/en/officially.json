{
    "word_family": [
        "official",
        "officer",
        "officiate"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "06fda80d-e398-3392-85f9-00ec85b21618",
                    "sense_definition": "In a formal and public way, or according to official rules and regulations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new city library was <w>officially</w> opened by the mayor yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мэр <w>официально</w> открыл новую городскую библиотеку.",
                                "zh": "市长昨天<w>正式</w>为新市图书馆揭幕。"
                            }
                        },
                        {
                            "text": "Although the couple has separated, they are not <w>officially</w> divorced yet.",
                            "target_lang_translations": {
                                "ru": "Хотя супруги разъехались, они ещё <w>официально</w> не разведены.",
                                "zh": "尽管这对夫妇已经分居，但他们还没有<w>正式</w>离婚。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unofficially"
                    ],
                    "common_phrases": [
                        "officially announced",
                        "officially recognized",
                        "officially opened"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично, от лица властей или в соответствии с установленными правилами и нормами.",
                        "zh": "以正式、公开的方式，或按照官方的规则和条例。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официально",
                                "target_lang_sense_clarification": "в установленном порядке"
                            },
                            {
                                "target_lang_word": "формально",
                                "target_lang_sense_clarification": "с соблюдением формальностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正式",
                                "target_lang_sense_clarification": "指符合规定或程序"
                            },
                            {
                                "target_lang_word": "官方",
                                "target_lang_sense_clarification": "指由政府或权威机构发布"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a443be1e-91cd-3ef1-9b87-3f59915b01c6",
                    "sense_definition": "Completely or clearly; often used to emphasize a strong feeling or a definitive state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking for five hours, I am <w>officially</w> exhausted.",
                            "target_lang_translations": {
                                "ru": "После пяти часов ходьбы я <w>официально</w> выбился из сил.",
                                "zh": "走了五个小时后，我<w>彻底</w>累坏了。"
                            }
                        },
                        {
                            "text": "Now that the exams are finished, the summer is <w>officially</w> over.",
                            "target_lang_translations": {
                                "ru": "Теперь, когда экзамены позади, лето <w>официально</w> закончилось.",
                                "zh": "既然考试已经结束，夏天也就<w>彻底</w>过去了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "officially over",
                        "officially dead"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for emphasis or humor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно, окончательно; часто используется для придания высказыванию шутливой важности или усиления.",
                        "zh": "彻底地或明确地；常用于强调某种强烈的感受或确定的状态，有时带有幽默色彩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официально",
                                "target_lang_sense_clarification": "в шутку или для усиления"
                            },
                            {
                                "target_lang_word": "окончательно",
                                "target_lang_sense_clarification": "бесповоротно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "完全地，强调程度"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "用于强调状态的确定性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}