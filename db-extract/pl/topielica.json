                        "cross_references": [
                            {
                                "target_word": "noyée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5f5609-971b-36e1-8efb-2d931fd4913e",
                                        "entry_id": "ea53df30-9805-3d2c-9018-a65747b9d15b",
                                        "glosses": [
                                            "Femme ou fille noyée."
                                        ],
                                        "tags": [
                                            "Mort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9ddf13-d218-4828-8b42-eb25788373b7",
                                                "sense_id": "2e5f5609-971b-36e1-8efb-2d931fd4913e",
                                                "text": "Nous avons commandé des liserons en gerbes, blancs, mauves et roses, et nous avons pleuré la noyée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "noyée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d31275f4-0236-3b25-b5f4-83fd7c6bcfca",
                                        "entry_id": "c05c69f5-d3c0-317d-ad0c-4e80d862fa89",
                                        "glosses": [
                                            "Féminin singulier de noyé."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d44c9bc-9b1d-4be8-8305-09ecbce97bd5",
                                                "sense_id": "d31275f4-0236-3b25-b5f4-83fd7c6bcfca",
                                                "text": "Maumariée, oh maumariée\nQuand ils t’ont trouvée\nSi blanche et dorée\nBlonde blonde blonde\nMaumariée, oh maumariée\nQuand ils t’ont trouvée noyée"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "noyée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45a1f63a-e497-393d-9e2d-12232d526f8d",
                                        "entry_id": "635d24f9-8e28-3c4c-b1ce-0eead2d8b520",
                                        "glosses": [
                                            "Participe passé féminin singulier de noyer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03923d4-cb2d-4fc2-af67-6fa7fb9dc2f2",
                                                "sense_id": "45a1f63a-e497-393d-9e2d-12232d526f8d",
                                                "text": "Malgré le feu des bougies, le cri des passions, l’aspect des vases d’or et d'argent, la fumée des vins, malgré la contemplation des femmes les plus ravissantes, peut-être y avait-il encore, au fond des cœurs, un peu de cette vergogne pour les choses humaines et divines qui lutte jusqu’à ce que l’orgie l’ait noyée dans les derniers flots d’un vin pétillant ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
