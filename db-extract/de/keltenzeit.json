                        "sense_id": "efcd3428-88c0-3558-9159-de4113656c05",
                        "entry_id": "f57aa3b5-22d7-34d7-9304-bff94a342da6",
                        "glosses": [
                            "Zeitraum, in dem die Kelten in einer Region dominierten"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "3306f311-b2e0-4549-9481-dc85bab2ece1",
                                "sense_id": "efcd3428-88c0-3558-9159-de4113656c05",
                                "text": "„Nach einer Einleitung über das, was man unter »keltisch« heute versteht, will der Band eine Übersicht über mehrere Kategorien von heiligen Orten der Keltenzeit geben, wobei der Begriff so breit wie möglich gefächert ist.“"
                            },
                            {
                                "example_id": "74d43bfa-bf5d-4b40-a1a9-83bdda75783d",
                                "sense_id": "efcd3428-88c0-3558-9159-de4113656c05",
                                "text": "„Die Archäologen finden am Glauberg tatsächlich ein Grab, wahrscheinlich aus der Keltenzeit.“"
                            }
                        ],
