{
    "word_family": [
        "tradition",
        "traditionally",
        "traditionalist",
        "traditionalism",
        "traditionalize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "887cb027-c124-38d7-abc2-e55cdf0c1d8c",
                    "sense_definition": "Relating to customs, beliefs, or methods that have existed for a long time without changing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "customs_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers still wear <w>traditional</w> costumes during the annual festival.",
                            "target_lang_translations": {
                                "ru": "Жители деревни всё ещё носят <w>традиционные</w> костюмы во время ежегодного фестиваля.",
                                "zh": "村民们在年度节日期间仍然穿着<w>传统</w>服饰。"
                            }
                        },
                        {
                            "text": "It is <w>traditional</w> in this country to offer guests tea when they arrive.",
                            "target_lang_translations": {
                                "ru": "В этой стране считается <w>традиционным</w> предлагать гостям чай по прибытии.",
                                "zh": "在这个国家，客人到达时敬茶是一种<w>传统</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "time-honored",
                        "conventional",
                        "customary"
                    ],
                    "antonyms": [
                        "nontraditional",
                        "non-traditional",
                        "untraditional"
                    ],
                    "common_phrases": [
                        "traditional food",
                        "traditional culture",
                        "traditional values",
                        "traditional method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к обычаям, верованиям или методам, которые существуют долгое время без изменений.",
                        "zh": "指长期存在且未发生改变的习俗、信仰或方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "основанный на обычае"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传统的",
                                "target_lang_sense_clarification": "指代长期沿袭的习惯或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f499966-95b8-36bc-b5b6-e4fadac1496d",
                    "sense_definition": "Preferring established customs and ways of behaving rather than modern ones.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "customs_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather is very <w>traditional</w> and dislikes using modern technology.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка очень <w>консервативен</w> и не любит использовать современные технологии.",
                                "zh": "我祖父非常<w>保守</w>，不喜欢使用现代科技。"
                            }
                        },
                        {
                            "text": "She holds a <w>traditional</w> view on how a business should be run.",
                            "target_lang_translations": {
                                "ru": "Она придерживается <w>традиционного</w> взгляда на то, как следует вести бизнес.",
                                "zh": "她对如何经营企业持有<w>传统</w>的看法。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nontraditional",
                        "non-traditional"
                    ],
                    "common_phrases": [
                        "traditional view",
                        "traditional approach",
                        "very traditional"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предпочитающий устоявшиеся обычаи и нормы поведения современным.",
                        "zh": "倾向于遵循既定习俗和行为方式，而非现代方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервативный",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "о взглядах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保守的",
                                "target_lang_sense_clarification": "形容人思想守旧"
                            },
                            {
                                "target_lang_word": "传统的",
                                "target_lang_sense_clarification": "形容观点或做法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eaddce2-851e-35b8-9907-83d80f4cda92",
                    "sense_definition": "Describing a piece of music, especially folk music, whose original composer is unknown.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band performed a <w>traditional</w> ballad from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "Группа исполнила <w>традиционную</w> балладу восемнадцатого века.",
                                "zh": "乐队演奏了一首十八世纪的<w>传统</w>民谣。"
                            }
                        },
                        {
                            "text": "This melody is <w>traditional</w> and has been played for generations.",
                            "target_lang_translations": {
                                "ru": "Эта мелодия — <w>народная</w>, и её играют уже несколько поколений.",
                                "zh": "这首曲子是<w>民间</w>流传的，已经演奏了许多代。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "traditional song",
                        "traditional music",
                        "traditional folk song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий музыкальное произведение, особенно народное, автор которого неизвестен.",
                        "zh": "指作者不详的音乐作品，尤指民间音乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народный",
                                "target_lang_sense_clarification": "фольклорный"
                            },
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "о музыке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民间的",
                                "target_lang_sense_clarification": "指代民间流传的音乐"
                            },
                            {
                                "target_lang_word": "传统的",
                                "target_lang_sense_clarification": "指代流传已久的曲目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d31a1522-13ea-3a4c-bcf3-1d4bc384bf3a",
                    "sense_definition": "Relating to the standard form of Chinese characters used before the simplification reform.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students must learn to recognize <w>traditional</w> characters to read older texts.",
                            "target_lang_translations": {
                                "ru": "Студенты должны научиться распознавать <w>традиционные</w> иероглифы, чтобы читать старые тексты.",
                                "zh": "学生必须学会辨认<w>繁体</w>字才能阅读古籍。"
                            }
                        },
                        {
                            "text": "The shop sign was written in <w>traditional</w> Chinese rather than simplified.",
                            "target_lang_translations": {
                                "ru": "Вывеска магазина была написана на <w>традиционном</w> китайском, а не на упрощённом.",
                                "zh": "商店招牌是用<w>繁体</w>中文而不是简体中文写的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "traditional characters",
                        "traditional Chinese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к стандартной форме китайских иероглифов, использовавшейся до реформы упрощения.",
                        "zh": "指汉字简化改革之前使用的标准汉字形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "о письменности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "繁体",
                                "target_lang_sense_clarification": "指代汉字书写形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19a60854-9cc7-30b5-9bc5-47b083b7fe04",
                    "sense_definition": "A song, name, or custom that is conventional or has existed for a long time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir's repertoire includes several spirituals and <w>traditionals</w>.",
                            "target_lang_translations": {
                                "ru": "Репертуар хора включает несколько спиричуэлс и <w>народных песен</w>.",
                                "zh": "合唱团的曲目包括几首灵歌和<w>民歌</w>。"
                            }
                        },
                        {
                            "text": "They decided to name their children <w>traditionals</w> like John and Mary.",
                            "target_lang_translations": {
                                "ru": "Они решили дать детям <w>традиционные имена</w>, такие как Джон и Мэри.",
                                "zh": "他们决定给孩子起约翰、玛丽这样的<w>传统名字</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sing a traditional"
                    ],
                    "target_lang_definitions": {
                        "ru": "Песня, имя или обычай, которые являются общепринятыми или существуют долгое время.",
                        "zh": "指长期存在或被广泛接受的歌曲、名字或习俗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народная песня",
                                "target_lang_sense_clarification": "музыкальное произведение"
                            },
                            {
                                "target_lang_word": "традиционное имя",
                                "target_lang_sense_clarification": "об имени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民歌",
                                "target_lang_sense_clarification": "指代音乐作品"
                            },
                            {
                                "target_lang_word": "传统名字",
                                "target_lang_sense_clarification": "指代人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}