            {
                "entry_id": "20973c9e-c7a8-36a0-9dc3-3d331bd3d2fc",
                "word": "Palmyrene",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf0df6b0-1477-3812-b6ec-3002e5f7f179",
                        "entry_id": "20973c9e-c7a8-36a0-9dc3-3d331bd3d2fc",
                        "glosses": [
                            "Alternative form of Palmyrena."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "8bb4e310-cd87-48d0-8eb7-55782f3f5bbc",
                                "sense_id": "bf0df6b0-1477-3812-b6ec-3002e5f7f179",
                                "text": "..., scituated between Palmyrene and Cœlosiria, in that Country or Province known to the Romans, ..."
                            },
                            {
                                "example_id": "1b6b1446-0308-4d08-8503-59ce7571694c",
                                "sense_id": "bf0df6b0-1477-3812-b6ec-3002e5f7f179",
                                "text": "... the capital of Acabene, a province or district of Mesopotamia, a region separated from Palmyrene by the Euphrates."
                            },
                            {
                                "example_id": "12f8b6ed-8fb2-4bad-895c-ded65b24c53e",
                                "sense_id": "bf0df6b0-1477-3812-b6ec-3002e5f7f179",
                                "text": "This is proved by two inscriptions from Palmyrene, ..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a97c0eed-1581-3345-a7e1-490d98c5573a",
                "word": "Palmyrene",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9267d40e-637f-4743-aefb-3c70b9ae41f7",
                        "entry_id": "a97c0eed-1581-3345-a7e1-490d98c5573a",
                        "tags": [
                            "plural"
                        ],
                        "form": "Palmyrenes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96fd8807-0157-381a-8216-b14ecba63a1e",
                        "entry_id": "a97c0eed-1581-3345-a7e1-490d98c5573a",
                        "glosses": [
                            "A native or inhabitant of ancient Palmyra or Palmyrena."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "864c8467-49a1-4b1b-8be4-df628855ea95",
                                "sense_id": "96fd8807-0157-381a-8216-b14ecba63a1e",
                                "text": "The importance of the Palmyrenes was as merchants, and it is as merchants that they become known to us in our earliest Roman reference."
                            },
                            {
                                "example_id": "89595091-3dc8-4594-b0fb-42134aa25e6a",
                                "sense_id": "96fd8807-0157-381a-8216-b14ecba63a1e",
                                "text": "For in the course of the campaign the Roman provincial capital of Bostra fell to the Palmyrenes – whether by accident or design - along with a Roman force."
                            },
                            {
                                "example_id": "afa156d1-4635-4c47-95bf-fb394d04b693",
                                "sense_id": "96fd8807-0157-381a-8216-b14ecba63a1e",
                                "text": "There is no surviving contemporary account of the war between the Palmyrenes and the Emperor Aurelian."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36626c1e-8c8d-45a6-a479-6edc358868a7",
                        "source_entry_id": "a97c0eed-1581-3345-a7e1-490d98c5573a",
