{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "17f98a10-fcfa-36a7-ac23-2baebbd98a53",
                    "sense_definition": "Soon; in a short while; shortly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have much to discuss regarding the contract, of which more <w>anon</w>.",
                            "target_lang_translations": {
                                "nl": "We hebben veel te bespreken over het contract, waarover <w>weldra</w> meer."
                            }
                        },
                        {
                            "text": "Farewell for now, my good friend, but I shall return <w>anon</w> to hear the rest of your story.",
                            "target_lang_translations": {
                                "nl": "Vaarwel voor nu, mijn goede vriend, maar ik zal <w>spoedig</w> terugkeren om de rest van je verhaal te horen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "more anon"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Binnenkort; weldra; over een korte tijd (archaïsch of literair)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "weldra",
                                "target_lang_sense_clarification": "binnenkort, over korte tijd"
                            },
                            {
                                "target_lang_word": "spoedig",
                                "target_lang_sense_clarification": "snel, binnenkort"
                            },
                            {
                                "target_lang_word": "straks",
                                "target_lang_sense_clarification": "zo meteen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e35d373-83f9-3f64-ab62-ed515aa87be3",
                    "sense_definition": "Immediately; straight away; at once.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Upon hearing the herald's command, the guards obeyed <w>anon</w> without hesitation.",
                            "target_lang_translations": {
                                "nl": "Bij het horen van het bevel van de heraut gehoorzaamden de wachters <w>terstond</w> zonder aarzeling."
                            }
                        },
                        {
                            "text": "He took the medicine, and <w>anon</w> his fever began to subside.",
                            "target_lang_translations": {
                                "nl": "Hij nam het medicijn in, en <w>meteen</w> begon zijn koorts te zakken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onmiddellijk; terstond; dadelijk (archaïsch)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "terstond",
                                "target_lang_sense_clarification": "meteen, onmiddellijk"
                            },
                            {
                                "target_lang_word": "meteen",
                                "target_lang_sense_clarification": "direct, ogenblikkelijk"
                            },
                            {
                                "target_lang_word": "dadelijk",
                                "target_lang_sense_clarification": "zonder uitstel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d77808c9-4060-3853-903c-766b7f6c6487",
                    "sense_definition": "At another time; again; alternately.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind howled fiercely at times, and <w>anon</w> fell into a dead silence.",
                            "target_lang_translations": {
                                "nl": "De wind huilde soms hevig en viel <w>dan weer</w> doodstil."
                            }
                        },
                        {
                            "text": "Ever and <w>anon</w> a bright flash of lightning would illuminate the dark forest.",
                            "target_lang_translations": {
                                "nl": "<w>Nu en dan</w> verlichtte een felle bliksemflits het donkere bos."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ever and anon"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een ander moment; af en toe; beurtelings (archaïsch)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dan weer",
                                "target_lang_sense_clarification": "afwisselend, af en toe"
                            },
                            {
                                "target_lang_word": "af en toe",
                                "target_lang_sense_clarification": "met tussenpozen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffaa6c01-8a59-3676-8a88-61fcbe2b44d0",
                    "sense_definition": "An anonymous internet user or poster on an online forum or imageboard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anonymous person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An inquisitive <w>anon</w> asked several personal questions on the open discussion board.",
                            "target_lang_translations": {
                                "nl": "Een nieuwsgierig <w>anoniempje</w> stelde verschillende persoonlijke vragen op het open discussieforum."
                            }
                        },
                        {
                            "text": "The website allows any <w>anon</w> to leave comments without creating an account first.",
                            "target_lang_translations": {
                                "nl": "De website staat iedere <w>anonieme gebruiker</w> toe om reacties achter te laten zonder eerst een account aan te maken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een anonieme internetgebruiker of plaatser op een online forum (straattaal/internetjargon)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "anoniem",
                                "target_lang_sense_clarification": "anonieme gebruiker"
                            },
                            {
                                "target_lang_word": "anoniempje",
                                "target_lang_sense_clarification": "informele benaming voor een anonieme poster"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e989588e-3c90-3758-a09c-74dbf8725a78",
                    "sense_definition": "An anonymous person, especially an unnamed author.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anonymous person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher hid the identities of several controversial writers behind asterisks and <w>anons</w>.",
                            "target_lang_translations": {
                                "nl": "De uitgever verborg de identiteit van verscheidene controversiële schrijvers achter sterretjes en <w>anoniemen</w>."
                            }
                        },
                        {
                            "text": "Many of the finest medieval ballads were composed by an unknown <w>anon</w>.",
                            "target_lang_translations": {
                                "nl": "Veel van de mooiste middeleeuwse ballades werden gecomponeerd door een onbekende <w>anonymus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "anonym"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een anonieme persoon, in het bijzonder een onbekende auteur."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "anonymus",
                                "target_lang_sense_clarification": "onbekende auteur"
                            },
                            {
                                "target_lang_word": "onbekende",
                                "target_lang_sense_clarification": "naamloze persoon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6124c51-b71c-38fe-8fa1-522f86d84a63",
                    "sense_definition": "A published work or text whose author is not known.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anonymous work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library catalogue contained several fascinating <w>anons</w> from the nineteenth century.",
                            "target_lang_translations": {
                                "nl": "De bibliotheekcatalogus bevatte verschillende fascinerende <w>anonieme werken</w> uit de negentiende eeuw."
                            }
                        },
                        {
                            "text": "She collected early English poetry, including a few well-preserved <w>anons</w> from the Tudor period.",
                            "target_lang_translations": {
                                "nl": "Ze verzamelde vroege Engelse poëzie, waaronder een paar goed bewaarde <w>anonieme werken</w> uit de Tudor-periode."
                            }
                        }
                    ],
                    "synonyms": [
                        "anonym"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gepubliceerd werk waarvan de schrijver of maker niet bekend is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "anoniem werk",
                                "target_lang_sense_clarification": "werk zonder bekende auteur"
                            },
                            {
                                "target_lang_word": "anonymum",
                                "target_lang_sense_clarification": "naamloos of anoniem geschrift"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542faa69-cd31-347c-b87d-ccd4c46a92ca",
                    "sense_definition": "A piece of work without a title.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anonymous work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archive contained an untitled <w>anon</w> that scholars struggled to date.",
                            "target_lang_translations": {
                                "nl": "Het archief bevatte een titelloos <w>anoniem stuk</w> dat wetenschappers moeilijk konden dateren."
                            }
                        },
                        {
                            "text": "He catalogued every manuscript fragment, listing each nameless text as an <w>anon</w>.",
                            "target_lang_translations": {
                                "nl": "Hij catalogiseerde elk manuscriptfragment en vermeldde elke naamloze tekst als een <w>titelloos werk</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een tekst of werkstuk zonder titel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "titelloos werk",
                                "target_lang_sense_clarification": "tekst zonder titel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7d8afbe-60d2-34d3-8979-8908c9c5bf11",
                    "sense_definition": "Anonymous; not identified by name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anonymous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The message was left by an <w>anon</w> user who refused to share their details.",
                            "target_lang_translations": {
                                "nl": "Het bericht werd achtergelaten door een <w>anonieme</w> gebruiker die weigerde zijn gegevens te delen."
                            }
                        },
                        {
                            "text": "She preferred to stay <w>anon</w> while donating money to the charity.",
                            "target_lang_translations": {
                                "nl": "Ze gaf er de voorkeur aan <w>anoniem</w> te blijven toen ze geld aan het goede doel schonk."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Anoniem; niet bij naam genoemd (informele verkorting)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "anoniem",
                                "target_lang_sense_clarification": "zonder naamsvermelding"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "379bc53e-a809-35bd-8b57-31ed45540259",
                    "sense_definition": "The conventional designation used when the true name of an author or creator is unknown.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anonymous name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The traditional folk song was credited simply to <w>Anon</w> in the anthology.",
                            "target_lang_translations": {
                                "nl": "Het traditionele volksliedje werd in de bloemlezing simpelweg toegeschreven aan <w>Anoniem</w>."
                            }
                        },
                        {
                            "text": "Many of the best quotes in the collection were written by <w>Anon</w>.",
                            "target_lang_translations": {
                                "nl": "Veel van de beste citaten in de collectie werden geschreven door <w>Anon.</w>"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De aanduiding die gebruikt wordt wanneer de echte naam van een maker of auteur onbekend is (afkorting van Anoniem)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Anon.",
                                "target_lang_sense_clarification": "afkorting voor Anoniem als auteursnaam"
                            },
                            {
                                "target_lang_word": "Anoniem",
                                "target_lang_sense_clarification": "als auteursvermelding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}