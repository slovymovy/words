                    {
                        "translation_id": "688e3ada-7ebc-4769-a23b-95159e50458e",
                        "source_entry_id": "a88b9eb2-dd1f-3465-92c5-e23afcfb20fe",
                        "source_sense_description": "act of hybridizing",
