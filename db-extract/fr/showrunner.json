                "senses": [
                    {
                        "sense_id": "31e0e743-6ff6-3b3b-bb87-d8f2450fda0d",
                        "entry_id": "5d3e41b2-6860-34a5-8a04-173fc42baf38",
                        "glosses": [
                            "Celui qui supervise tous les aspects créatifs d’une série télévisée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "8e3f0bca-9b22-45cb-9c37-fa11bd6fe29c",
                                "sense_id": "31e0e743-6ff6-3b3b-bb87-d8f2450fda0d",
                                "text": "L’industrie audiovisuelle mise donc sur ces adaptations et les confie à des personnalités reconnues à Hollywood, à l’image de Craig Mazin, le showrunner de Chernobyl pour The Last of Us ou Jonathan Nolan et Lisa Joy, les créateurs de Westworld pour Fallout."
                            },
                            {
                                "example_id": "8579e2fe-b0e2-4c04-9230-c51535e86e3f",
                                "sense_id": "31e0e743-6ff6-3b3b-bb87-d8f2450fda0d",
                                "text": "Parce qu’ils avaient envie de mettre dans la lumière des personnages découverts au cours de leurs longues recherches, les auteurs planchent également sur deux séries, produites par Pathé, Dimitri Rassam, Disney et dont ils seront les showrunners : une sur la genèse de Milady, l’autre sur le premier mousquetaire noir de l’histoire de France."
                            },
                            {
                                "example_id": "16371d9c-da74-4139-8be0-c53edc6247b7",
                                "sense_id": "31e0e743-6ff6-3b3b-bb87-d8f2450fda0d",
                                "text": "Le sexe est primordial pour Hawkins Fuller, explique le showrunner et scénariste Ron Nyswaner au LA Times."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f71686b7-36dc-4b71-a0ab-7644aeabbbb1",
                        "source_entry_id": "5d3e41b2-6860-34a5-8a04-173fc42baf38",
