                                        "entry_id": "28d987b9-592c-3693-affa-975997ffb3be",
                                        "glosses": [
                                            "present participle and gerund of navel-gaze"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "035283c0-bdca-4ce5-b1e2-38c114b9e5ee",
                        "source_entry_id": "6797559b-57d8-30fe-948d-2a3b1e0ef220",
                        "source_sense_id": "a094bcce-408a-3658-bc58-a80e40f6564d",
