                                            {
                                                "example_id": "09032112-cd5c-4075-8db7-f45ea7271ed2",
                                                "sense_id": "dbb91b09-fd04-3883-b7d7-d41da4cf097a",
                                                "text": "mascara smudges"
                                            },
                                            {
                                                "example_id": "700ca7c9-fb1a-46c3-8dc4-19b435a80281",
                                                "sense_id": "dbb91b09-fd04-3883-b7d7-d41da4cf097a",
                                                "text": "With her rouged cheeks, silver lipcoat and mascara she might have been any girl after an hour at her mother's dressing table."
                                            },
                                            {
                                                "example_id": "a0dbf933-620e-4808-a3d4-082ce93d3554",
                                                "sense_id": "dbb91b09-fd04-3883-b7d7-d41da4cf097a",
                                                "text": "There were a lot of young girls, in their early-twenties she guessed, many of them either Gothed up in thick black mascara and black lip stick, others looking like stereotypical Beat Girls in black rollnecks and jeans."
                                            }
                                        ]
                                    }
                                ]
