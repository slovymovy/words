                "senses": [
                    {
                        "sense_id": "fe866705-34a1-335c-bc18-cbfa65c94f71",
                        "entry_id": "676e7763-0045-3467-844e-e98ed1f7a420",
                        "glosses": [
                            "Marktplatz, an dem Energie gegen Gebot gehandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bd3eae-2e09-4250-819b-bf6dd7efd819",
                                "sense_id": "fe866705-34a1-335c-bc18-cbfa65c94f71",
                                "text": "An den Energiebörsen rund um die Welt handeln Stromanbieter ihren, aus sehr unterschiedlichen Stromerzeugern hergestellten Strom, rund um die Welt und es ist einerlei, welche Farbe oder Gesinnung dieser hat; nur der Bedarf und der Preis zählt."
                            },
                            {
                                "example_id": "c21517d1-39ba-4ea4-8a03-e4239c4594b1",
                                "sense_id": "fe866705-34a1-335c-bc18-cbfa65c94f71",
                                "text": "„Deutschlands einzige Energiebörse EEX startet den Handel mit grünem Strom. Handelsbeginn solle am 6. Juni sein, sagte Börsen-Chef Peter Reiz am Mittwoch bei der Vorstellung der Jahresbilanz 2012 in Leipzig.“"
                            },
                            {
                                "example_id": "76aa576a-4ca2-4f9e-99d5-ca0fbba5ca08",
                                "sense_id": "fe866705-34a1-335c-bc18-cbfa65c94f71",
                                "text": "„Bis einschliesslich Freitag, den 5. April 2002, sind an der EXAA, der österreichischen Energiebörse, 34,608 Megawattstunden (MWh) gehandelt worden.“"
                            },
                            {
                                "example_id": "f7ad0ac9-dffd-4c67-a7bb-a20d4ad233eb",
                                "sense_id": "fe866705-34a1-335c-bc18-cbfa65c94f71",
                                "text": "„Die Republik Polen hat sich für die Leipziger Energiebörse EEX als übergangsmäßige Versteigerungsplattform in der bereits laufenden dritten Handelsperiode entschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
