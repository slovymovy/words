                                        "entry_id": "4c79af52-473d-3c40-9582-cf440373e6a4",
                                        "glosses": [
                                            "Initialism of lesbian, gay, bisexual, transgender, queer."
                                        ],
                                        "tags": [
                                            "abbreviation",
