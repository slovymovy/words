            {
                "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                "word": "calot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b899772-e1b2-437b-ac69-eca2be282ca0",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "tags": [
                            "plural"
                        ],
                        "form": "calots"
                    },
                    {
                        "form_id": "6b018ec4-9a67-4d7b-916e-2f72f7321d44",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "tags": [],
                        "form": "callot"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2216e8d5-64e8-35c7-9ac0-92f0dd9c88ce",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "glosses": [
                            "Petite calotte."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a8982189-f73a-4122-a8da-1735c0ebd8e9",
                                "sense_id": "2216e8d5-64e8-35c7-9ac0-92f0dd9c88ce",
                                "text": "Calot d’enfant de chœur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b723e16c-588c-31ee-bf75-aff89e18e640",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "glosses": [
                            "Coiffure des soldats, de forme allongée, sans bords."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f1d16b-a975-4a68-852e-5b6514465a10",
                                "sense_id": "b723e16c-588c-31ee-bf75-aff89e18e640",
                                "text": "Or j’eus comme voisin de lit un aumônier du genre fier et silencieux, qui s’équipait en musulman pour les tirailleurs marocains. Le croissant sur son calot était un beau sujet de plaisanterie."
                            },
                            {
                                "example_id": "fb90f462-1ab1-4c09-b7ad-94edd07dcd47",
                                "sense_id": "b723e16c-588c-31ee-bf75-aff89e18e640",
                                "text": "Un edelweiss séché glissa d’une des enveloppes de rhodoïd et M. Abel le replaça avec des gestes précautionneux sur la photo aux vilaines couleurs qui lui servait de support : sur un vague fond de mosquée, trois militaires en calot et treillis se tenaient par l’épaule."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d82715-3677-3421-ac85-ab83f349f1be",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "glosses": [
                            "Coiffure plate de drap portée par les étudiants, les conscrits, les anciens combattants, les membres de divers corps ou de diverses associations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50022c15-c350-4370-ab07-5cfa4d3a47ca",
                                "sense_id": "f1d82715-3677-3421-ac85-ab83f349f1be",
                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l’air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                            }
                        ]
                    },
                    {
                        "sense_id": "b536d605-bb91-337b-a230-bbb4eb9cc4f1",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "glosses": [
                            "Coiffe féminine en forme de bonnet ou de toque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a725f0-3564-4473-af83-1a241492afa9",
                                "sense_id": "b536d605-bb91-337b-a230-bbb4eb9cc4f1",
                                "text": "Sa petite silhouette de gargouille, coiffée jusqu’aux sourcils d’un de ces calots « à la mode »."
                            },
                            {
                                "example_id": "f6ec2cb1-5b4b-433a-9813-7b2c998f722c",
                                "sense_id": "b536d605-bb91-337b-a230-bbb4eb9cc4f1",
                                "text": "Dans la cour, Madame Ruby en imperméable et en calot blanc, gantée, agile, sans chair superflue, chargeait sur sa voiture cageots et sacs vides."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb70f5c0-fcd8-32c6-8333-926ab1da7c1b",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "glosses": [
                            "Teigneux."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c907dad8-f48e-45c0-b85d-57e984f3d94f",
                                "sense_id": "fb70f5c0-fcd8-32c6-8333-926ab1da7c1b",
                                "text": "Callots sont ceux qui sont teigneux, véritables ou contrefaits."
                            },
                            {
                                "example_id": "911a7cd5-e8f3-4db4-97c6-265081d96144",
                                "sense_id": "fb70f5c0-fcd8-32c6-8333-926ab1da7c1b",
                                "text": "Daignez me recevoir au moins en qualité de monstre, de phénomène, de calot propre à faire amasser la foule."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a5b4f26-04a1-3610-86d5-c717f5eceadd",
                        "entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "glosses": [
                            "Testicule."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea62141f-063e-4bce-90b7-e97d91f0afeb",
                        "source_entry_id": "88b70210-843c-32fc-94a3-f0538f6c6109",
                        "source_sense_description": "Coiffure des soldats",
                        "target_lang_word": "пилотка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пилотка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1efb612a-446b-3aee-a4a1-fa8b9c79b931",
                                        "entry_id": "47395fb5-dd1d-36fd-8b94-138395c4aab9",
                                        "glosses": [
                                            "летний матерчатый форменный головной убор в виде сплюснутой с боков лёгкой шапочки (первоначально только у пилотов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e6695b-9efc-42d9-8c2f-5969f258641b",
                                                "sense_id": "1efb612a-446b-3aee-a4a1-fa8b9c79b931",
                                                "text": "В сторону оперативного отдела прошла девушка в пилотке, в шинели."
                                            },
                                            {
                                                "example_id": "f0b54945-5abd-4338-bd56-9a7b6ee9dc28",
                                                "sense_id": "1efb612a-446b-3aee-a4a1-fa8b9c79b931",
                                                "text": "Перед тележкой лежала перевёрнутая пилотка со звёздочкой, а в ней всегда были монеты и даже бумажные рубли — Михаська не раз видел тут этого инвалида."
                                            },
                                            {
                                                "example_id": "81943231-3869-45ca-a137-f91a114004e1",
                                                "sense_id": "1efb612a-446b-3aee-a4a1-fa8b9c79b931",
                                                "text": "За стойкой суетятся рыжие парни в сдвинутых набок белых пилотках."
                                            },
                                            {
                                                "example_id": "30526bc8-1cea-4c37-8ae6-eac25b1d2fcd",
                                                "sense_id": "1efb612a-446b-3aee-a4a1-fa8b9c79b931",
                                                "text": "Если роба из рогожи // И мазут на грязной роже, // Если в масле вся пилотка, — // Значит наш, с подводной лодки!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75db9b36-93ad-31a9-a8df-e947ad77dd63",
                                        "entry_id": "47395fb5-dd1d-36fd-8b94-138395c4aab9",
                                        "glosses": [
                                            "вообще головной убор такой формы (из бумаги, материи и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a453c68-6c54-4a0b-a77e-dbdd606a262e",
                                                "sense_id": "75db9b36-93ad-31a9-a8df-e947ad77dd63",
                                                "text": "Все ребята были в одинаковых красных пилотках."
                                            },
                                            {
                                                "example_id": "fe11411b-dbdd-457f-82d9-27ef0b0544b1",
                                                "sense_id": "75db9b36-93ad-31a9-a8df-e947ad77dd63",
                                                "text": "И девятнадцатого июня — тронулись: тридцать гавриков в красных испанских пилотках, по полной пионерской форме, пионервожатая Соня и Яков Исакыч."
                                            },
                                            {
                                                "example_id": "6e8f9a25-c558-4be9-a256-b484f0be4520",
                                                "sense_id": "75db9b36-93ad-31a9-a8df-e947ad77dd63",
                                                "text": "Все они почему-то, как сговорившись, начинали совместную жизнь с ремонта на кухне, так они мне все и запомнились — под потолком в газетных пилотках, с кистью в руках, перекрашивающие стены то из белого в оранжевый, то из оранжевого в салатовый."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пилотка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "52ef3bfb-e82d-3b77-b90d-b4669d4a2ff0",
                                        "entry_id": "0dcf0820-ad0d-3aa7-b0dd-b5adaa3e82aa",
                                        "glosses": [
                                            "вульг., пренебр. женский половой орган"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb12d35f-ca01-407b-af1d-16990b5091eb",
                                                "sense_id": "52ef3bfb-e82d-3b77-b90d-b4669d4a2ff0",
                                                "text": "— А у неё пилотка не бритая."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пилотка",
                                "target_lang_code": "ru",
