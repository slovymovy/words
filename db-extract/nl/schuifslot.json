                "senses": [
                    {
                        "sense_id": "731d046d-d76b-31d8-a149-d0d636589007",
                        "entry_id": "b686efd9-5da2-36f3-88a2-9f1c1dc4746b",
                        "glosses": [
                            "een slot dat men met een schuif of een schuivende beweging opent en sluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b29b32-fbfb-4738-be6a-ee75b6fe3f8a",
                                "sense_id": "731d046d-d76b-31d8-a149-d0d636589007",
                                "text": "De spaken waartussen het schuifslot stak, sloegen met een tikkend geluid tegen de metalen beugel."
                            },
                            {
                                "example_id": "0195c209-6600-45b0-8ced-b97d50a4f19c",
                                "sense_id": "731d046d-d76b-31d8-a149-d0d636589007",
                                "text": ",,De krakers wisten heel goed hoe ze te werk moesten gaan. Ze hebben een schuifslot geïnstalleerd op de deur, zodat ze van binnen naar buiten kunnen, maar niemand zomaar binnen kan. Niemand kan ze raken. Dat is toch ongelofelijk?“"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54c1c21a-b7f3-4665-ba97-b99d8acc9f31",
                        "source_entry_id": "b686efd9-5da2-36f3-88a2-9f1c1dc4746b",
                        "source_sense_id": "731d046d-d76b-31d8-a149-d0d636589007",
                        "source_sense_description": "een slot dat men met een schuif of een schuivende beweging opent en sluit",
                        "target_lang_word": "bolt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "113a635a-3183-358a-99b0-6b4410e6e3a5",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A (usually) metal fastener consisting of a cylindrical body that is threaded, with a larger head on one end. It can be inserted into an unthreaded hole up to the head, with a nut then threaded on the other end; a heavy machine screw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "255be4c2-797c-30d5-b379-8b4889a5aab4",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A sliding pin or bar in a lock or latch mechanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff2d92ca-bd0d-44ea-907f-dfb3a76b301d",
                                                "sense_id": "255be4c2-797c-30d5-b379-8b4889a5aab4",
                                                "text": "There was the noise of a bolt shot back, and the door opened a few inches, enough to show a long snout and a pair of sleepy blinking eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8bf9d0b-e16f-33be-85bd-4f798ec4f8ba",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A bar of wood or metal dropped in horizontal hooks on a door and adjoining wall or between the two sides of a double door, to prevent the door(s) from being forced open."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "425dcd89-6767-34fb-82ad-3ab23ce0273e",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A sliding mechanism to chamber and unchamber a cartridge in a firearm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f868091-06da-3725-8a53-f49094ffda7b",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A small personal-armour-piercing missile for short-range use, or (in common usage though deprecated by experts) a short arrow, intended to be shot from a crossbow or a catapult."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d699dd69-cd5a-355f-839a-b3f5ca17d44e",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A lightning spark, i.e., a lightning bolt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7356f529-913d-46c3-92fb-0b884e07e0c7",
                                                "sense_id": "d699dd69-cd5a-355f-839a-b3f5ca17d44e",
                                                "text": "He had seen lightning bolts yesterday night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28bd719c-0269-35d5-8778-4a1cf21614f1",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A sudden event, action or emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77012004-a0db-42c9-8a80-6c08c56ee2c0",
                                                "sense_id": "28bd719c-0269-35d5-8778-4a1cf21614f1",
                                                "text": "The problem's solution struck him like a bolt from the blue."
                                            },
                                            {
                                                "example_id": "71091c5e-86ff-41af-9ec1-95c333243bfd",
                                                "sense_id": "28bd719c-0269-35d5-8778-4a1cf21614f1",
                                                "text": "With a bolt of fright he remembered that there was no bathroom in the Hobhouse Room. He leapt along the corridor in a panic, stopping by the long-case clock at the end where he flattened himself against the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c98f5ca-939d-33a2-a7ec-3bf3187683f9",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A large roll of fabric or similar material, as a bolt of cloth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d6ef40-27de-4072-b737-dbfcd7f82af8",
                                                "sense_id": "4c98f5ca-939d-33a2-a7ec-3bf3187683f9",
                                                "text": "Mr. Cole, Basket-maker...has lost near 300 boults of rods"
                                            },
                                            {
                                                "example_id": "472596b1-38b4-401d-b84d-cc620f5d7dfa",
                                                "sense_id": "4c98f5ca-939d-33a2-a7ec-3bf3187683f9",
                                                "text": "Not only were the old sails being mended, but new sails were coming on board, and bolts of canvas, and coils of rigging; in short, everything betokened that the ship's preparations were hurrying to a close."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2da7ce9-7c2c-3765-9828-f1a12f4970db",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A large roll of fabric or similar material, as a bolt of cloth.",
                                            "The standard linear measurement of canvas for use at sea: 39 yards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e9d57af-ce18-3eb2-8969-54d35d390be8",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A sudden spring or start; a sudden leap aside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8172f8c-1673-46ff-a616-e3fbae9fa729",
                                                "sense_id": "0e9d57af-ce18-3eb2-8969-54d35d390be8",
                                                "text": "The horse made a bolt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49915a7-0bb9-381f-965c-fb304ec8a594",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A sudden flight, as to escape creditors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c40ecb2-90be-4221-aa05-92d0c8564f84",
                                                "sense_id": "e49915a7-0bb9-381f-965c-fb304ec8a594",
                                                "text": "This gentleman was so hopelessly involved that he contemplated a bolt to America — or anywhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a64430cf-0e10-314e-869a-d55dffdc32e7",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A refusal to support a nomination made by the party with which one has been connected; a breaking away from one's party."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44d260ab-9bb2-34c6-b9ef-abb8b2d3f63b",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "An iron to fasten the legs of a prisoner; a shackle; a fetter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbf7235b-b4d7-46d4-af71-0eab1a6e7492",
                                                "sense_id": "44d260ab-9bb2-34c6-b9ef-abb8b2d3f63b",
                                                "text": "He shall to prison, and there die in boults."
                                            },
                                            {
                                                "example_id": "a1aebaf5-b857-4179-9dcd-c753050f0af6",
                                                "sense_id": "44d260ab-9bb2-34c6-b9ef-abb8b2d3f63b",
                                                "text": "Away with him to prison! Lay bolts enough upon him:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04bfe6bf-ed1a-323d-94fe-0c9b4e81f941",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A burst of speed or efficiency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019816c8-7817-40ea-8402-1156730b20ee",
                                                "sense_id": "04bfe6bf-ed1a-323d-94fe-0c9b4e81f941",
                                                "text": "In the event they lacked a proper midfield bolt, with Toni Kroos and Sami Khedira huffing around in pursuit of the whizzing green machine. The centre-backs looked flustered, left to deal with three on two as Mexico broke. Löw’s 4-2-3-1 seemed antiquated and creaky, with the old World Cup shark Thomas Müller flat-footed in a wide position."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66be620-df66-33b0-ab14-d00ecb519107",
                                        "entry_id": "50412e58-0c08-3ace-8257-5ce07486f0cd",
                                        "glosses": [
                                            "A stalk or scape (of garlic, onion, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2038d56-311f-4be4-8f1f-3a2cadffa8c0",
                                                "sense_id": "c66be620-df66-33b0-ab14-d00ecb519107",
                                                "text": "All kinds of vegetables may be used as a topping, but the best are strongly flavoured ones without too much moisture, such as celery, garlic bolts, chives, scallions, or various beans (long beans, green beans etc.) ..."
                                            },
                                            {
                                                "example_id": "7c3b1508-f50b-4977-bc41-1e829a3e1a49",
                                                "sense_id": "c66be620-df66-33b0-ab14-d00ecb519107",
                                                "text": "She ordered Cat's Ear Noodles heaped with garlic bolts and tomatoes, the broth thick with cumin, laced with black vinegar. The girl caught her accent, the sibilant sing-song of the south, and smiled, tilting her head questioningly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c930f802-0377-3e6a-8b5d-fde677679e30",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To connect or assemble pieces using a bolt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f98d04f-3bb9-4436-a3de-c094999391f3",
                                                "sense_id": "c930f802-0377-3e6a-8b5d-fde677679e30",
                                                "text": "Bolt the vice to the bench."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430fe000-e428-34c0-877e-c47ae661ceeb",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To affix in a crude or unnatural manner."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e75a9f7-2448-4d7d-84aa-3b4622135957",
                                                "sense_id": "430fe000-e428-34c0-877e-c47ae661ceeb",
                                                "text": "Most languages are *not* based on C++. C++ is a complicated mess. It's C with object oriented features bolted on as an afterthought and no-one in their right mind would want to base another language on it."
                                            },
                                            {
                                                "example_id": "fd9c9941-1fed-41a7-b9de-ef55f4ea44ad",
                                                "sense_id": "430fe000-e428-34c0-877e-c47ae661ceeb",
                                                "text": "Going through the motions with an empty smile bolted on my face"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffe0382d-6c34-34fa-8c3a-8b0cdce0ed32",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To secure a door by locking or barring it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40e995f4-41b5-410e-ab44-611c78a55ee8",
                                                "sense_id": "ffe0382d-6c34-34fa-8c3a-8b0cdce0ed32",
                                                "text": "Bolt the door."
                                            },
                                            {
                                                "example_id": "fc8bfd45-a4cf-4e52-b13f-7ce9ccabd654",
                                                "sense_id": "ffe0382d-6c34-34fa-8c3a-8b0cdce0ed32",
                                                "text": "If that double-bolted land, Japan, is ever to become hospitable, it is the whale-ship alone to whom the credit will be due; for already she is on the threshold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f62bf9-a11e-36c0-8942-b85807596add",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To flee, to depart, to accelerate away suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b359c64-dd14-4fd9-8233-1de60bce19c6",
                                                "sense_id": "10f62bf9-a11e-36c0-8942-b85807596add",
                                                "text": "Seeing the snake, the horse bolted."
                                            },
                                            {
                                                "example_id": "6f0e8c16-b61c-4250-b635-854252913069",
                                                "sense_id": "10f62bf9-a11e-36c0-8942-b85807596add",
                                                "text": "The actor forgot his line and bolted from the stage."
                                            },
                                            {
                                                "example_id": "33fbf8dc-cf45-4f5d-b820-ef31b3a0d8e5",
                                                "sense_id": "10f62bf9-a11e-36c0-8942-b85807596add",
                                                "text": "This Pucke ſeems but a dreaming dolt, / Still vvalking like a ragged Colt, / And oft out of a buſh doth bolt, / Of purpoſe to deceiue vs, / And leading vs makes vs to ſtray."
                                            },
                                            {
                                                "example_id": "97136372-cf1b-4718-9fdf-2862b0b6d300",
                                                "sense_id": "10f62bf9-a11e-36c0-8942-b85807596add",
                                                "text": "Bradly was embarrassed, detected in the character of a snooper. But he had to come on, short of bolting back in his tracks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "580a679e-18bc-336f-9ba5-b68fbf10270e",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To escape."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea888fc-efa3-3e13-8769-8703960e49bf",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To cause to start or spring forth; to dislodge (an animal being hunted)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0dc446-79eb-4126-a9d7-634dc25ae0a6",
                                                "sense_id": "6ea888fc-efa3-3e13-8769-8703960e49bf",
                                                "text": "to bolt a rabbit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f805b270-d16f-37af-a6d0-d39e6b9b596c",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To strike or fall suddenly like a bolt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "986fb5f0-c229-475d-a7c8-69f20aea3c72",
                                                "sense_id": "f805b270-d16f-37af-a6d0-d39e6b9b596c",
                                                "text": "His cloudleſs thunder bolted on thir heads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7c3d52-7079-395d-b99f-90de1d9e7196",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To produce flower stalks and flowers or seeds quickly or prematurely; to form a bolt (stalk or scape); to go to seed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f43164-fb3c-45fb-975e-701783ee33a4",
                                                "sense_id": "2b7c3d52-7079-395d-b99f-90de1d9e7196",
                                                "text": "Lettuce and spinach will bolt as the weather warms up."
                                            },
                                            {
                                                "example_id": "cab9a012-8978-4764-9602-64999fc656e8",
                                                "sense_id": "2b7c3d52-7079-395d-b99f-90de1d9e7196",
                                                "text": "When an onion bolts and forms a flower stalk, the stem grows right up through the neck, forming a tough, fibrous tube that pierces the center of the bulb. The plant channels all its energy into this flower stalk, so no more fleshy […]"
                                            },
                                            {
                                                "example_id": "c3003a64-a0e8-44f5-ab5e-f405010cc80f",
                                                "sense_id": "2b7c3d52-7079-395d-b99f-90de1d9e7196",
                                                "text": "To be honest, this hasn't been my Garden of Eden year. […] The lettuce turned bitter and bolted. The Green Comet broccoli was good, but my coveted Romanescos never headed up."
                                            },
                                            {
                                                "example_id": "41b41cda-6a91-419c-8da6-1f09d4db4087",
                                                "sense_id": "2b7c3d52-7079-395d-b99f-90de1d9e7196",
                                                "text": "Hardneck garlic bolts, which means it produces a single flower stalk, also known as a scape. It is considered to be far tastier and “gourmet.” You can find hardneck garlic mainly at farmers' markets […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a44b0c38-8b4c-3a85-bc6b-7ff96f1d6c02",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To swallow food without chewing it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55e63457-f4b2-4bbd-8d72-6855308ef459",
                                                "sense_id": "a44b0c38-8b4c-3a85-bc6b-7ff96f1d6c02",
                                                "text": "Though amid all the smoking horror and diabolism of a sea-fight, sharks will be seen longingly gazing up to the ship’s decks, like hungry dogs round a table where red meat is being carved, ready to bolt down every killed man that is tossed to them;"
                                            },
                                            {
                                                "example_id": "276dad10-c9c0-4d84-bd04-6e1e7ac7aac9",
                                                "sense_id": "a44b0c38-8b4c-3a85-bc6b-7ff96f1d6c02",
                                                "text": "Some hawks and owls bolt their prey whole, and after an interval of from twelve to twenty hours, disgorge pellets, which, as I know from experiments made in the Zoological Gardens, include seeds capable of germination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d87eff11-3259-31e9-8e0e-72060c3bc08e",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To drink one's drink very quickly; to down a drink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98d455f-5f1b-4c81-b52e-a0bfad4982fd",
                                                "sense_id": "d87eff11-3259-31e9-8e0e-72060c3bc08e",
                                                "text": "Come on, everyone, bolt your drinks; I want to go to the next pub!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cccf0d25-25c5-3f25-8474-9e7e1061cff8",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To refuse to support a nomination made by a party or caucus with which one has been connected; to break away from a party."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2aab48-9000-4810-b2f5-a56b7b06a549",
                                                "sense_id": "cccf0d25-25c5-3f25-8474-9e7e1061cff8",
                                                "text": "John Silber charged that people who bolted the Democratic Party in this election are \"Kamakaze ^([sic]) liberals\", beneath contempt and clearly too stupid to deserve to vote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af2b1c1a-e406-3705-865b-9ab8351a417b",
                                        "entry_id": "1269cb95-332a-3e4f-8369-6b0467d82841",
                                        "glosses": [
                                            "To utter precipitately; to blurt or throw out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f1335a-87c5-4e79-8e5a-343b384099f5",
                                                "sense_id": "af2b1c1a-e406-3705-865b-9ab8351a417b",
                                                "text": "I hate when vice can bolt her arguments.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    }
                                ]
                            },
