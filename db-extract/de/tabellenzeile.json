                "senses": [
                    {
                        "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                        "entry_id": "1cde439c-05a6-38d8-ad78-db10f7905b88",
                        "glosses": [
                            "horizontale Einträge (Zeile) einer Tabelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a5f241f-48d0-4a7f-a492-e3a9b79a9ffb",
                                "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                                "text": "„Drücken Sie am Ende der Tabellenzeile die Tab-Taste.“"
                            },
                            {
                                "example_id": "d0bffb26-369a-4e22-9798-594b3b346e5c",
                                "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                                "text": "„ Es wird geprüft, ob die Tabellenzeile das abgetastete Symbol enthält (das abgetastete Symbol steht im B-Register).“"
                            },
                            {
                                "example_id": "0bf8f1e8-b61d-4867-aa33-39038dcbb6e0",
                                "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                                "text": "„Es ist damit jedoch nicht möglich, dass ein Fremdschlüsselwert in einer Tabellenzeile auf mehrere andere Tabellenzeilen verweist.“"
                            },
                            {
                                "example_id": "f8e86414-02c1-460a-930b-b6154b111046",
                                "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                                "text": "„Tabellenzeilen werden innerhalb eines Knotens als Zeile dargestellt, wobei die Tabstopps durch Leerzeichen ersetzt werden.“"
                            },
                            {
                                "example_id": "e7d5d90a-08bc-445e-9b6f-6bb7055928b7",
                                "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                                "text": "„Betrachten wir den Fall des Event-Listeners, der die markierte Tabellenzeile hervorhebt.“"
                            },
                            {
                                "example_id": "1fb8b73a-d1f3-4636-98f2-ec553ee9ddfa",
                                "sense_id": "25ccd91b-92a6-39de-9abd-ba58df18ce5f",
                                "text": "„Zellenstile festlegen Zellenstil erste Zeile: Definieren Sie den Stil für die Zellen der ersten Tabellenzeile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
