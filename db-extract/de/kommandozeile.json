                "senses": [
                    {
                        "sense_id": "1edb0a0c-a932-3996-b6a6-c6df8b01f133",
                        "entry_id": "ddeaa332-1430-32ea-a13d-28bb005b7800",
                        "glosses": [
                            "Eingabebereich für die Steuerung einer Software"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52604c08-6163-4ce0-8ff4-85806e114c5f",
                                "sense_id": "1edb0a0c-a932-3996-b6a6-c6df8b01f133",
                                "text": "„Linux enthält zahlreiche Werkzeuge zur Bearbeitung von Textdateien auf der Kommandozeile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cadaa3e-3c5e-4447-b4c5-0ddfd5a21d50",
                        "source_entry_id": "ddeaa332-1430-32ea-a13d-28bb005b7800",
                        "source_sense_id": "1edb0a0c-a932-3996-b6a6-c6df8b01f133",
                        "source_sense_description": "Eingabebereich für die Steuerung einer Software",
                        "target_lang_word": "command line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "command line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80d5b741-a903-3729-818a-94c5ac962a4a",
                                        "entry_id": "4ba67edd-19e4-3ea0-b776-d162027f236c",
                                        "glosses": [
                                            "A shell, a command line interface; usually used with the definite article."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63bb568c-fda9-4b3b-80ef-99cd1282f1fe",
                                                "sense_id": "80d5b741-a903-3729-818a-94c5ac962a4a",
                                                "text": "I'm so used to the command line that I don't even know how to find things in the GUI."
                                            },
                                            {
                                                "example_id": "2b5775a0-6243-4faa-ac2b-3b73acc0b8e0",
                                                "sense_id": "80d5b741-a903-3729-818a-94c5ac962a4a",
                                                "text": "The command line offers a lot of helpful features, such as tab completion and wildcard expansion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f9dc52-0ec6-3a93-a066-474ddc9ee65c",
                                        "entry_id": "4ba67edd-19e4-3ea0-b776-d162027f236c",
                                        "glosses": [
                                            "The text prompt presented to the user in a command line interface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e243fd9b-441f-4849-a80c-8b23549ac0e9",
                                                "sense_id": "06f9dc52-0ec6-3a93-a066-474ddc9ee65c",
                                                "text": "Type the following at the command line: du -s -h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118bb202-71c9-3b2d-8d95-f9e39ada1921",
                                        "entry_id": "4ba67edd-19e4-3ea0-b776-d162027f236c",
                                        "glosses": [
                                            "A line of text that is entered at such a prompt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e35bdbd-81d1-42fe-8c4d-f46bee26af0e",
                                                "sense_id": "118bb202-71c9-3b2d-8d95-f9e39ada1921",
                                                "text": "Use the following command line to compile a file without linking: gcc -c main.c -o main.o"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e43305f-11ef-4f1d-b554-2cd5ba8e6fe8",
                        "source_entry_id": "ddeaa332-1430-32ea-a13d-28bb005b7800",
                        "source_sense_id": "1edb0a0c-a932-3996-b6a6-c6df8b01f133",
                        "source_sense_description": "Eingabebereich für die Steuerung einer Software",
                        "target_lang_word": "ligne de commande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligne de commande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0d08e7-c309-33e3-8b34-d598a6e0ba78",
                                        "entry_id": "bcb01afb-c514-3725-b5be-95fdd9b3d558",
                                        "glosses": [
                                            "Séquence de texte entrée par l’utilisateur via un terminal ou une console qui pourra être interprétée par le shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b80c424-f35d-4db7-9dca-98c0cdcece36",
                                                "sense_id": "1d0d08e7-c309-33e3-8b34-d598a6e0ba78",
                                                "text": "Avant l’émergence des PC, l’informatique était encore faite de lignes de commande."
                                            },
                                            {
                                                "example_id": "5b1af3a0-51fb-4f05-b127-447457bd6624",
                                                "sense_id": "1d0d08e7-c309-33e3-8b34-d598a6e0ba78",
                                                "text": "Le shell interprète les lignes de commande que vous saisissez, exécute les programmes que vous avez demandé et plus généralement, coordonne toutes les interactions entre vous et le système d’exploitation Unix."
                                            },
                                            {
                                                "example_id": "ce9f39ba-1d29-4251-866f-95dd1253ac80",
                                                "sense_id": "1d0d08e7-c309-33e3-8b34-d598a6e0ba78",
                                                "text": "Lorsqu’une application est lancée par un shell, la ligne de commande est analysée et découpée en arguments en utilisant comme séparateurs certains caractères spéciaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15e4e501-38cd-4b6a-90e5-e951d1054d3e",
