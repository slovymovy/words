                ],
                "senses": [
                    {
                        "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                        "entry_id": "fdd7bda0-4be6-3757-be8c-867c489d742b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0f684e-5062-456e-bc3f-b0e5e587fee1",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Frau Rohloff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "87541243-fa5c-4895-afbf-b4bfc3c8c314",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Herr Rohloff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7b4d1f52-1325-41cb-8fbd-e370bf4a984d",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Die Rohloffs kommen heute aus dem Unwettergebiet."
                            },
                            {
                                "example_id": "97663d39-b28c-4104-86e4-551cfc33cd4c",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Der Rohloff trägt nie die Schals, die die Rohloff ihm strickt."
                            },
                            {
                                "example_id": "a427b17a-6e21-4d18-9e0f-d3f30dc01887",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rohloff kommt, geht der Herr Rohloff.“"
                            },
                            {
                                "example_id": "ed36c0b2-9bcd-4b6b-9987-b668cb267863",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Rohloff kommt und geht."
                            },
                            {
                                "example_id": "7be6397c-efea-4b2e-8f9f-28e2c03ba533",
                                "sense_id": "260a212f-47e5-3618-b5c3-2f82f93fb664",
                                "text": "Rohloffs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
