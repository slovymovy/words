                "senses": [
                    {
                        "sense_id": "3bdc7941-818f-3788-9201-250a0f6afc06",
                        "entry_id": "5f4678a2-f445-3a4f-b1d7-eb0fdc08f304",
                        "glosses": [
                            "Wahl der Mitglieder des Nationalrats"
