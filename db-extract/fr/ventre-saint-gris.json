                "senses": [
                    {
                        "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                        "entry_id": "e11f1285-21c8-33fa-a5c4-8ee7c14ba030",
                        "glosses": [
                            "Sorte de juron familier d’Henri IV."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d6c0dcb3-4d2b-4746-987e-645744b611b2",
                                "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                                "text": "Ventre-saint-gris ! vous le direz donc, car cela est, baronne."
                            },
                            {
                                "example_id": "650d4397-b2de-489c-a258-d412b28aeb37",
                                "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                                "text": "Saint Gris, c’est, dit-on, saint François; Ventre-Saint-Gris, c’est un Franciscain, plaisanterie de Protestants, qu’on avoit apprise à Henri IV, dans son enfance."
                            },
                            {
                                "example_id": "4a998497-b4c1-4971-ad59-b7410f62f347",
                                "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                                "text": "— Mais c’est donc un véritable démon, que ce Béarnais, ventre saint gris !"
                            },
                            {
                                "example_id": "b5b696b1-b12b-4c80-9ca5-d15236b9b8d1",
                                "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                                "text": "Est-ce que par aventure ma fille aimerait le hussard ? Qu’elle l’épouse, passe encore ; mais qu’elle l’aime… ventre-saint-gris !"
                            },
                            {
                                "example_id": "e7ea46c7-d733-4887-9ffc-60b89b88e506",
                                "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                                "text": "Le juron de Henri IV met la sainteté entre la ripaille et l’ivresse. Ventre-saint-gris ! Je ne suis pas de la religion de ce juron-là."
                            },
                            {
                                "example_id": "87f72d64-074a-4dc6-a781-035b7a53a63d",
                                "sense_id": "137e7eb8-916b-3925-b154-8f827031564c",
                                "text": "Ventre-saint-gris, on va voir ce qu'on va voir !"
                            }
                        ]
                    }
                ],
