                        "examples": [
                            {
                                "example_id": "6e6d89a3-07f3-4fc3-ad2c-3bdd16d5f389",
                                "sense_id": "7cf9d2b1-1fee-34cc-8c3b-25b048ab75b2",
                                "text": "Et quelles tantimolles on faisait cuire dans l'huile de faînes bouillante !"
                            },
                            {
                                "example_id": "9fcbb792-f72b-41cb-b3f6-0cbb6bb5696f",
                                "sense_id": "7cf9d2b1-1fee-34cc-8c3b-25b048ab75b2",
                                "text": "Adèle garnit un grand panier d'osier avec de grosses tranches de jambon cru, avec les tantimolles confectionnées par sa sœur Mariette et une bonne bouteille de vin de la vallée de la Marne."
                            },
                            {
                                "example_id": "eb08345d-8f14-4e82-b361-761f8381ec4e",
                                "sense_id": "7cf9d2b1-1fee-34cc-8c3b-25b048ab75b2",
                                "text": "A moins que vous ne succombiez à la tantimolle, qui bien que molle, saura vous emplir l'estomac : cette douceur, qui prend la forme d'une crêpe ardennaise, utilise du beurre, et se suffit à elle-même, avec un peu de sucre."
                            }
                        ]
                    }
