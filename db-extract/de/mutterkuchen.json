                ],
                "senses": [
                    {
                        "sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                        "entry_id": "e4772c34-f03a-3cb0-9d80-f1ab8f87ee21",
                        "glosses": [
                            "Organ zur Versorgung des Kindes im Mutterleib"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b80445-f696-4082-a072-11c174fd068b",
                                "sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                                "text": "Der Mutterkuchen versorgt den Fetus über die Nabelschnur."
                            },
                            {
                                "example_id": "8a57f0d2-0726-4884-8033-287f69cf62be",
                                "sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                                "text": "Etwa eine halbe Stunde nach der Austreibungsphase beginnt die Nachgeburt, in der der Mutterkuchen ausgestoßen wird."
                            },
                            {
                                "example_id": "94e3f3dd-8333-454e-8c45-03f8404daba0",
                                "sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                                "text": "In vielen Kliniken werden die Mutterkuchen den Frauen auf Wunsch mitgegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8b3ca67-52ea-4d98-a593-fd00c07e80f5",
                        "source_entry_id": "e4772c34-f03a-3cb0-9d80-f1ab8f87ee21",
                        "source_sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                        "source_sense_description": "Organ zur Versorgung des Kindes im Mutterleib",
                        "target_lang_word": "placenta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placenta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e7c8b6f-555a-3b52-884b-b0444665f5e2",
                                        "entry_id": "4424bc10-275f-3d44-89f6-85e4ad2e2981",
                                        "glosses": [
                                            "An organ in most mammals during gestation that supplies food and oxygen to the foetus and passes back waste. It is on the wall of the uterus and links to the foetus through the umbilical cord. It is expelled after birth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f32f15fc-c2d6-3742-a5e2-45df2b7a1e72",
                                        "entry_id": "4424bc10-275f-3d44-89f6-85e4ad2e2981",
                                        "glosses": [
                                            "In flowering plants, the part of the ovary where ovules develop; in non-flowering plants where the spores develop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfe26bd8-8749-4bb4-83d3-60fc5b38c03f",
                        "source_entry_id": "e4772c34-f03a-3cb0-9d80-f1ab8f87ee21",
                        "source_sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                        "source_sense_description": "Organ zur Versorgung des Kindes im Mutterleib",
                        "target_lang_word": "placenta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placenta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1d903aa-8544-36ec-a0e9-8cfd131c1029",
                                        "entry_id": "603eeb2d-4f8e-38f0-bf45-8bd1eafc9789",
                                        "glosses": [
                                            "Organe charnu et spongieux qui est à l’extrémité du cordon ombilical, et par lequel le fœtus s’attache à l’utérus et reçoit les nutriments que lui fournit le corps de sa mère, formé par le chorion du fœtus et la décidue de l'utérus maternel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43fc1e02-2d6b-475b-b81a-3f559970b582",
                                                "sense_id": "f1d903aa-8544-36ec-a0e9-8cfd131c1029",
                                                "text": "Ma petite vieille vivait encore, nous devions aller souper chez elle la semaine prochaine, tu te rappelles, mais il y a eu cet accident, il y a vingt ans, elle est loin, mais à la fois si intime, passée dans mes placentas, dans mon lait, mes chansons, dans mes veilles […]…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ff4c89-f500-3287-b2ee-b0a66753cd80",
                                        "entry_id": "603eeb2d-4f8e-38f0-bf45-8bd1eafc9789",
                                        "glosses": [
                                            "Partie interne de l’ovaire à laquelle sont attachés les ovules."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33257ee4-d564-4efb-8c83-eb5113c187b9",
                                                "sense_id": "58ff4c89-f500-3287-b2ee-b0a66753cd80",
                                                "text": "On nous apporta ensuite des ananas et des pacaïs. Ce dernier fruit [l’inga], qui a la forme d'un fourreau de sabre, est une gousse d’un mètre et demi de long dont les graines sont enveloppées d'un placenta blanc et filandreux, mais extrêmement sucré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
