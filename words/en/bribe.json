{
    "word_family": [
        "bribery",
        "briber",
        "bribable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                    "sense_definition": "To give money or a gift to someone to persuade them to do something, often illegally or dishonestly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bribe_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal tried to <w>bribe</w> the police officer to let him go.",
                            "target_lang_translations": {
                                "ru": "Преступник пытался <w>подкупить</w> полицейского, чтобы тот его отпустил.",
                                "zh": "那名罪犯企图<w>贿赂</w>警官放他走。"
                            }
                        },
                        {
                            "text": "They attempted to <w>bribe</w> the judge into dropping the charges.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>подкупить</w> судью, чтобы он снял обвинения.",
                                "zh": "他们试图<w>买通</w>法官以撤销指控。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buy off",
                        "pay off"
                    ],
                    "common_phrases": [
                        "bribe officials",
                        "try to bribe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать деньги или подарок кому-либо, чтобы убедить сделать что-то, часто незаконно или нечестно.",
                        "zh": "（尤指非法或不道德地）向某人行贿、收买，以使其做某事"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкупать",
                                "target_lang_sense_clarification": "склонять на свою сторону деньгами"
                            },
                            {
                                "target_lang_word": "давать взятку",
                                "target_lang_sense_clarification": "совершать коррупционное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贿赂",
                                "target_lang_sense_clarification": "以财物买通他人"
                            },
                            {
                                "target_lang_word": "买通",
                                "target_lang_sense_clarification": "用金钱等收买人以求达到目的"
                            },
                            {
                                "target_lang_word": "收买",
                                "target_lang_sense_clarification": "用利益拉拢人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11d09284-a10e-344a-a522-5214e7b4b8e0",
                    "sense_definition": "To offer a treat or reward to someone, especially a child, to encourage them to behave or do a task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bribe_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>bribe</w> my son with ice cream to get him to clean his room.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>подкупить</w> сына мороженым, чтобы он убрал свою комнату.",
                                "zh": "我不得不拿冰淇淋来<w>哄</w>儿子收拾房间。"
                            }
                        },
                        {
                            "text": "She used chocolate to <w>bribe</w> the children into sitting quietly.",
                            "target_lang_translations": {
                                "ru": "Она использовала шоколад, чтобы <w>подкупить</w> детей и заставить их сидеть тихо.",
                                "zh": "她用巧克力来<w>收买</w>孩子们，让他们安静地坐着。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать угощение или награду кому-либо (особенно ребенку), чтобы побудить к хорошему поведению или выполнению задачи.",
                        "zh": "（尤指对孩子）用好吃的东西或好处来诱导、哄劝其听话或做事"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкупать",
                                "target_lang_sense_clarification": "задабривать, уговаривать наградой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哄",
                                "target_lang_sense_clarification": "用好处哄劝"
                            },
                            {
                                "target_lang_word": "收买",
                                "target_lang_sense_clarification": "用小恩小惠引诱"
                            },
                            {
                                "target_lang_word": "利诱",
                                "target_lang_sense_clarification": "以利益引诱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                    "sense_definition": "Money or a gift given to someone in exchange for using their influence or doing something dishonest.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bribe_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official was arrested for accepting a large <w>bribe</w> from a construction company.",
                            "target_lang_translations": {
                                "ru": "Чиновник был арестован за получение крупной <w>взятки</w> от строительной компании.",
                                "zh": "该官员因收受一家建筑公司巨额<w>贿赂</w>而被捕。"
                            }
                        },
                        {
                            "text": "He offered a cash <w>bribe</w> to avoid getting a speeding ticket.",
                            "target_lang_translations": {
                                "ru": "Он предложил денежную <w>взятку</w>, чтобы избежать штрафа за превышение скорости.",
                                "zh": "他拿出违规现金作为<w>贿赂</w>，以避免吃到超速罚单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inducement",
                        "pay-off",
                        "backhander",
                        "bung",
                        "sweetener"
                    ],
                    "common_phrases": [
                        "accept a bribe",
                        "take a bribe",
                        "offer a bribe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги или подарок, передаваемые кому-либо в обмен на использование влияния или совершение нечестного поступка.",
                        "zh": "为换取对方利用影响力或做出不正当行为而给予的金钱或财物（贿赂物）"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взятка",
                                "target_lang_sense_clarification": "незаконное вознаграждение должностному лицу"
                            },
                            {
                                "target_lang_word": "подкуп",
                                "target_lang_sense_clarification": "средство подкупа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贿赂",
                                "target_lang_sense_clarification": "指用于行贿的财物"
                            },
                            {
                                "target_lang_word": "赃款",
                                "target_lang_sense_clarification": "非法收受的金钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                    "sense_definition": "Something attractive offered to persuade someone to do something, often used playfully.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bribe_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The promise of extra vacation time was a <w>bribe</w> to keep the employees happy.",
                            "target_lang_translations": {
                                "ru": "Обещание дополнительного отпуска было своего рода <w>взяткой</w>, чтобы сотрудники были довольны.",
                                "zh": "提供额外假期的承诺，是用来让员工安心工作的<w>好处</w>。"
                            }
                        },
                        {
                            "text": "I used a cookie as a <w>bribe</w> to stop the toddler from crying.",
                            "target_lang_translations": {
                                "ru": "Я использовал печенье как <w>взятку</w>, чтобы малыш перестал плакать.",
                                "zh": "我拿饼干当<w>诱饵</w>，好让那个幼儿别再哭闹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inducement",
                        "sweetener"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то привлекательное, предлагаемое для убеждения кого-либо сделать что-то (часто используется в шутливом смысле).",
                        "zh": "用来劝诱或安抚某人的诱饵或好处（常用于戏谑语境）"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взятка",
                                "target_lang_sense_clarification": "шутл. угощение или награда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱饵",
                                "target_lang_sense_clarification": "用来引诱人的小好处"
                            },
                            {
                                "target_lang_word": "好处",
                                "target_lang_sense_clarification": "用以劝诱的利益或奖励"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}