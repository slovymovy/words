                "senses": [
                    {
                        "sense_id": "2f19b3b1-fe1f-3aac-82db-fcfb5cb5b510",
                        "entry_id": "31fbd1cf-a725-3654-b2c6-ec36819adebe",
                        "glosses": [
                            "Schwierigkeiten mit Geruchsbildnern; störende Geruchswahrnehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8cdfe3-5591-4638-9546-21f62cc0e452",
                                "sense_id": "2f19b3b1-fe1f-3aac-82db-fcfb5cb5b510",
                                "text": "„Nicht ordnungsgemäße entsorgte gebrauchte Speiseöle und Speisefette landen oft im Abwasser und führen somit zu Geruchsproblemen und in weiterer Folge zu Verstopfungen in der Kanalisation und belasten die Kläranlage.“"
                            },
                            {
                                "example_id": "51153257-2925-47c6-bcbd-d2b7b3d69a8e",
                                "sense_id": "2f19b3b1-fe1f-3aac-82db-fcfb5cb5b510",
                                "text": "„Zudem unterlassen viele Pkw-Besitzer die empfohlene Wartung und Reinigung, sodass sich bei diesen Fahrzeugen häufiger intensive Geruchsprobleme einstellen, die oft nur noch durch den Austausch von Bauteilen beseitigt werden können.“"
                            },
                            {
                                "example_id": "e465145f-7b89-4aff-8dfd-d46dfa473dec",
                                "sense_id": "2f19b3b1-fe1f-3aac-82db-fcfb5cb5b510",
                                "text": "„Die Geruchsprobleme waren beim Pumpwerk Maurach immer noch vorhanden.“"
                            },
                            {
                                "example_id": "44921636-1bcb-4048-88f3-d471449aa9af",
                                "sense_id": "2f19b3b1-fe1f-3aac-82db-fcfb5cb5b510",
                                "text": "„Geruchsprobleme sind bedingt durch Tierhaltung, Hofdüngerlagerung und Hofdüngeranwendung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
