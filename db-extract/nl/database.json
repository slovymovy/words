                        "target_lang_word": "base de données",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "base de données",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9069b202-d8a9-34c7-91b6-1564092bc784",
                                        "entry_id": "799c0ff5-db2c-331c-9db9-e62737e8aa94",
                                        "glosses": [
                                            "Ensemble de données se rapportant à un même sujet, de façon ordonnée, généralement géré par un système spécialisé permettant leur entretien et leur utilisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b45f10a-5df2-4d49-b896-071724213c6e",
                                                "sense_id": "9069b202-d8a9-34c7-91b6-1564092bc784",
                                                "text": "Une base de données spécifique au hooliganisme recense les actes violents et racistes et mettent régulièrement à jour les fichiers concernant leurs perpétrateurs."
                                            },
                                            {
                                                "example_id": "b37f2496-4403-42a5-b25b-1b49fe21345a",
                                                "sense_id": "9069b202-d8a9-34c7-91b6-1564092bc784",
                                                "text": "Les bases de données informatiques sont un moyen d’organiser cette base personnelle que nous avons dans la tête, de la rationaliser, de ne retenir que les éléments pertinents pour la poursuite d’un but donné et aussi, évidemment, de la partager avec des collaborateurs, collègues, clients, etc."
                                            },
                                            {
                                                "example_id": "6ecdaea6-6d6a-498d-9f67-488cb965c6ee",
                                                "sense_id": "9069b202-d8a9-34c7-91b6-1564092bc784",
                                                "text": "C’est notamment le chantier colossal qu’a entamé Google avec sa base de données spécifique baptisée \"Google Books\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
