{
    "word_family": [
        "tainted",
        "tainting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d2ee00f-159d-370c-ba1b-358ae5ad5179",
                    "sense_definition": "To contaminate or corrupt something with an external agent, either physically or morally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "contaminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal served to <w>taint</w> his reputation for many years."
                        },
                        {
                            "text": "Chemical waste can <w>taint</w> the local water supply."
                        }
                    ],
                    "common_phrases": [
                        "taint reputation",
                        "taint water supply"
                    ]
                },
                {
                    "sense_id": "7cf53ce7-9fb1-3a62-a045-fd968b9572d5",
                    "sense_definition": "To spoil food by contamination.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contaminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bacteria can quickly <w>taint</w> raw meat if it is left out."
                        },
                        {
                            "text": "Improper storage will <w>taint</w> the food."
                        }
                    ],
                    "common_phrases": [
                        "taint food"
                    ]
                },
                {
                    "sense_id": "0d62dfda-e6c8-3888-81bb-569b94d82b38",
                    "sense_definition": "To be affected with the beginning of decay or rot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contaminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meat will <w>taint</w> quickly in the summer heat."
                        },
                        {
                            "text": "The fish began to <w>taint</w> after hours in the sun."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b9fe47b-b518-3eaf-97d4-b51f2e1178da",
                    "sense_definition": "A mark of disgrace or blemish on one's character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corruption scandal left a permanent <w>taint</w> on his political career."
                        },
                        {
                            "text": "He tried to remove the <w>taint</w> of dishonesty from his name."
                        }
                    ],
                    "common_phrases": [
                        "taint on character"
                    ]
                },
                {
                    "sense_id": "978ca573-49a2-3f9b-9db9-59cbdd6f5438",
                    "sense_definition": "A contamination or decay, especially in food.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a slight <w>taint</w> in the milk that made it taste sour."
                        },
                        {
                            "text": "The <w>taint</w> in the water made it unsafe to drink."
                        }
                    ],
                    "common_phrases": [
                        "taint in food"
                    ]
                },
                {
                    "sense_id": "84625d57-9707-3533-b16b-d7afa4fe1274",
                    "sense_definition": "A small trace or touch of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>taint</w> of sadness in her voice."
                        },
                        {
                            "text": "The wine had a faint <w>taint</w> of oak."
                        }
                    ]
                }
            ]
        }
    ]
}