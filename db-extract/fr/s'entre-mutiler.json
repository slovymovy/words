                ],
                "senses": [
                    {
                        "sense_id": "c6bdf575-3b7a-3dc7-b236-7c5608386963",
                        "entry_id": "1e336c3d-237c-3b40-9de0-9616d0742112",
                        "glosses": [
                            "Se mutiler mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df2b355-63ba-4ed1-94f5-cf43a1690b24",
                                "sense_id": "c6bdf575-3b7a-3dc7-b236-7c5608386963",
                                "text": "Les passifs contre les actifs s’entre-blessent, s’entre-mutilent et beaucoup sont ainsi menés à leur destruction."
                            },
                            {
                                "example_id": "f0e28b8a-6617-4680-a59c-5859f95b9d66",
                                "sense_id": "c6bdf575-3b7a-3dc7-b236-7c5608386963",
                                "text": "Non que les Somalis nourrissent pour les Danakil une affection démesurée : leurs relations, depuis des millénaires, se bornent à s’entre-mutiler d’un couteau diligent, le fruit de ces mutilations étant pour tout guerrier de l’une ou de l’autre race le gage de virilité requis pour obtenir la tendre main de celle qu’il convoite."
                            }
                        ]
                    }
                ],
