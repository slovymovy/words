                "senses": [
                    {
                        "sense_id": "59b743ba-972e-31d1-b2f7-0f311eb25878",
                        "entry_id": "0d427586-c312-3ee9-a168-95b6256b30ce",
                        "glosses": [
                            "starker Wind in einem kleinen Gebiet, in dem sonst nur schwache oder anders gerichtete Winde vorherrschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4fdab19-78fb-48aa-a93c-68033b221e39",
                                "sense_id": "59b743ba-972e-31d1-b2f7-0f311eb25878",
                                "text": "„Obwohl im Arabischen Meer die natürlichen Bedingungen gegeben wären, entwickeln sich dort meist nur zwei bis drei Wirbelstürme pro Jahr. Der Grund dafür ist, dass starke vertikale Scherwinde die Stürme bereits im Ansatz regelrecht auseinanderreißen oder zumindest eine Zunahme der Intensität verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
