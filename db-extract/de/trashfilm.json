                "senses": [
                    {
                        "sense_id": "5836662b-79ff-3168-b021-c7693eb6dbf1",
                        "entry_id": "f6a67e20-f26d-39c9-9dbf-f1b6b96d17fd",
                        "glosses": [
                            "Abfolge von verschiedenen Bildern von qualitativ schlechter Machart und für die ein geringes Budget verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d66c353-e101-451c-98bd-c2c0cb56a94f",
                                "sense_id": "5836662b-79ff-3168-b021-c7693eb6dbf1",
                                "text": "Ich kenne viele Trashfilme."
                            },
                            {
                                "example_id": "38d087a7-4158-4039-bb8e-57a00322deee",
                                "sense_id": "5836662b-79ff-3168-b021-c7693eb6dbf1",
                                "text": "Sie stellt sich ewig lang unter die Dusche, sie reibt sich mit einer pappigen ErdnussbutterCreme ein, sie zappt sich durch Trash-Filme, sie widersteht der doppelten Versuchung, sich auf einen Sitz die gesamte zweite Staffel von Lost und einen Doppelzentner Eis einzuverleiben, das noch im Tiefkühler liegt."
                            },
                            {
                                "example_id": "9388f24f-e12f-412f-a2b9-a942f64bb4eb",
                                "sense_id": "5836662b-79ff-3168-b021-c7693eb6dbf1",
                                "text": "In der Postmoderne der 1980er Jahre erreichten rückblickend dann auch sog. dilettantische Trashfilme vergangener Jahrzehnte einen Kultstatus, z. B. die Filme von Ed Wood."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
