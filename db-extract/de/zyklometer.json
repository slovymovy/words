                    {
                        "sense_id": "febd398c-b9cb-3f49-ba68-cbc254c34320",
                        "entry_id": "d6399468-d0e3-3a81-a257-5ea94ac73489",
                        "glosses": [
                            "Vorrichtung zum Messen der zurückgelegten Wegstrecke bei Fahrrädern"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "93f63d44-14c9-4a4b-85a9-214f74707c5b",
                                "sense_id": "febd398c-b9cb-3f49-ba68-cbc254c34320",
                                "text": "„Der Zyklometer bietet dem Radler außerdem den Vorteil, daß er stets die Kilometerzahl der Einzeltouren und des ganzen Jahres kontrollieren kann.“"
                            },
                            {
                                "example_id": "a153ca7a-44d6-4050-ab68-0ed7121a8699",
                                "sense_id": "febd398c-b9cb-3f49-ba68-cbc254c34320",
                                "text": "„Zur Ablesung der durchlaufenen Distanzen sind an diesen Rädern Zyklometer angebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
