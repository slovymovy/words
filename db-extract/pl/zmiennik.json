                "senses": [
                    {
                        "sense_id": "9c76c4cb-b587-3f6c-8220-6d1df946909e",
                        "entry_id": "6ed5ce78-2f12-3344-bcb4-0e57e6884bd6",
                        "glosses": [
                            "osoba pełniąca jakąś funkcję na zmianę z kimś innym (np. na boisku), wymieniająca się z kimś na stanowisku w pracy (np. za kółkiem, w stróżówce)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "208e5be1-4e56-44c5-beec-8b329fac40e7",
                                "sense_id": "9c76c4cb-b587-3f6c-8220-6d1df946909e",
                                "text": "Mój zmiennik się spóźnia, muszę na niego poczekać."
                            },
                            {
                                "example_id": "e7f253d0-b36f-470c-a530-df768ae48e68",
                                "sense_id": "9c76c4cb-b587-3f6c-8220-6d1df946909e",
                                "text": "Jak na koła samochodu • nawijamy życia wstęgę, • gaz do dechy i do przodu • ze zmiennikiem ręka w rękę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
