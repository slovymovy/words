                            {
                                "example_id": "35235b50-71e1-4955-922e-6683ef4f18cd",
                                "sense_id": "86abdc86-dc58-32cd-b019-fd564ebff186",
                                "text": "„Der hierfür erforderliche Großraumtransport ist mit hohen Anforderungen verbunden, um den aufrechten Stand der Tiere zu ermöglichen.“"
                            },
                            {
