        "fr-extract.jsonl": [
            {
                "entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
                "word": "skaï",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93534667-b2aa-404a-a2a2-1729f06086f4",
                        "entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
                        "tags": [
                            "plural"
                        ],
                        "form": "skaïs"
                    },
                    {
                        "form_id": "4c8b8da4-a0a8-4251-905c-284005057725",
                        "entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
                        "tags": [],
                        "form": "skai"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                        "entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
                        "glosses": [
                            "Tissu enduit qui imite le cuir, même s’il n’est pas de la marque Skaï®/Skai®."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a1a477-1089-4a9c-9868-1f3c4ec9ed55",
                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                "text": "Un bustier en skaï."
                            },
                            {
                                "example_id": "379efe48-611b-4846-a3ca-26b19b4aeabf",
                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                "text": "Elle m’a fait penser à une fleur étrange, munie d’antennes translucides et d’un cœur en skaï mauve…"
                            },
                            {
                                "example_id": "cbaef321-b8e1-4922-86c6-a11b02e2ec59",
                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                "text": "Devant l’entrée d’Auchan au niveau 1, au bas du grand tapis roulant central à double sens, il y a un espace agencé comme un petit salon d’attente, avec des sièges en skaï marron, inversés comme des causeuses. Ils sont rarement vides, occupés souvent le matin par des chibanis."
                            },
                            {
                                "example_id": "e21ae7da-8c09-4b49-9f85-2ad88c3618c3",
                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                "text": "C'était une Honda Twin TII 125 cm3 bicylindre d’occasion, achetée 4 500 francs (700 €) à un boucher de la rue Pierre Legrand à Fives. Elle me servait jusque-là pour aller au lycée, et je m'étais équipé pour le voyage avec ce qui existait de moins cher : une sacoche de réservoir en skaï noir, deux sacoches arrières en skaï noir munies d'une structure rigide, mi-carton, mi-métal et un blouson - en skaï noir, pardi !"
                            },
                            {
                                "example_id": "4493bc05-0c9e-4acc-b297-d8f47306e3e7",
                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                "text": "Il soupait à 18h30 & s’affaissait dans le fauteuil en skaï marron clair, enchaînait le jeu avec le journal, s’endormait devant le film."
                            },
                            {
                                "example_id": "3dd97096-c3b9-447e-921f-e7cb221af6d4",
                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                "text": "La jeune femme frappait méthodiquement les pattes d'ours de skaï rouge que le jeune homme brandissait à hauteur d'épaule. Jambes ﬂéchies il accueillait les coups. chocs brefs et sans écho, skaï contre skaï […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a2a335-b0f3-4a60-8cca-88baa9498e4e",
                        "source_entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
                        "source_sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                        "target_lang_word": "leatherette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leatherette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                        "entry_id": "716cf87a-0660-3791-bfa4-2abb4a0ed66c",
                                        "glosses": [
                                            "A type of fabric, often plastic, made to imitate the appearance of leather."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfcf7018-304a-4c7a-b042-fd482623f289",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "Many attempts have been made to supply a material to take the place of leather on cheap books, but hitherto nothing has been quite successful. [...] Such a material has apparently appeared in the form of \"Leatherette,\" which is a kind of felted paper, very tough, the same colour throughout, and which may be grained to imitate leather; indeed, the imitation is so close, both in appearance and in feel, that only a practised eye can perceive that it is not leather."
                                            },
                                            {
                                                "example_id": "b6651525-de2f-48e7-8d85-511c8df4400a",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "Material.—A rather stiff quality of jute board or tar board, similar to that used by bookbinders. Straw board is not serviceable, being too brittle. Also leatherette for covering and some figured paper for lining. Also some muslin or sateen for hinges. This should match the leatherette as nearly as possible in color. (Leatherette is an imitation leather, very durable, obtained at a paper house.)"
                                            },
                                            {
                                                "example_id": "70f85804-be7d-4c48-825e-9e16f83e48f6",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "The present bound book will be changed to a loose-leaf one, by shearing off the back and punching the leaves to fit an up-to-date cover. We have obtained a neat, classy, leatherette cover for this purpose, using imitation leather because it is neater than cloth, and cheaper and more durable than real leather."
                                            },
                                            {
                                                "example_id": "ef7c301f-33bd-4ae1-86fd-668d77c456bf",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "[T]he pink throats of gramophones opened their giant convolutions in a soundless chorus; or bicycles shining in neat ranks seemed to await the signal of an invisible starter; or tiers of fancy-goods in leatherette and paste and celluloid dangled their insidious graces; [...]"
                                            },
                                            {
                                                "example_id": "7c369a08-1573-44f8-801a-eb02e47edd0a",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "[H]e proceeded to a very hard seat in Block J. and, having forced his way into it, was immediately ordered to force his way out again for the purpose of hiring two small leatherette pads from the Kumfy Kushion Company—who, however, had only one small leatherette pad left, so that Chunks Rivers found himself in considerable torment long before the downfall of England began."
                                            },
                                            {
                                                "example_id": "6ce4419c-1d5a-4fd3-9a1d-f45fdd0b9db8",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "Beside the wallet and its contents there were three gaily colored silk handkerchiefs fragrant of chypre; a platinum Longines watch on a platinum and red gold chain, attached at the other end to a small pear-shaped pendant of some white metal; a handful of United States, British, French, and Chinese coins; a ring holding half a dozen keys; a silver and onyx fountain-pen; a metal comb in a leatherette case; a nail-file in a leatherette case; [...]"
                                            },
                                            {
                                                "example_id": "6600b97d-1449-4e56-bba4-843a21017ab1",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "Quick let's make love, / Before we die. / On Warm Leatherette, / Join the carcrash set."
                                            },
                                            {
                                                "example_id": "aab95bbb-651c-4802-8d8a-743b65e57b5b",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "Fishnet leatherette / Pussy Galore / Pseudo Sumo wrestler / On the door"
                                            },
                                            {
                                                "example_id": "8c4fa223-00bd-4d54-8fa0-a2d47200a4fa",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "We returned to the old leatherette couches with the bottom cushions covered in cloth."
                                            },
                                            {
                                                "example_id": "ddb86fe5-3b43-4467-9e68-efc4627ed6c0",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "There many covering papers, through generally in the rigid box industry, there are a number of standard types in use. These include enamels, flints, tints, leatherettes, and many others."
                                            },
                                            {
                                                "example_id": "1062554d-e30e-49e1-9d9b-b75bccff317f",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "Today, four of Barberton's old-line chicken dinner restaurants survive: Belgrade Gardens, Hopocan Gardens, Village Inn, and White House Chicken. With the possible exception of Belgrade Gardens, all are best appreciated as linoleum-and-leatherette warhorses, glorified cafeterias that are long on value but short on decor."
                                            },
                                            {
                                                "example_id": "2ae48aba-44e6-48f5-a11c-8a67ba379f4b",
                                                "sense_id": "54dcd18d-7731-3ca8-a74e-789c5eca13c2",
                                                "text": "He weighed the camera in his hands, running his thumb over its leatherette sides, the worn nickel fittings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b01b9577-89cb-39cd-b8eb-92a4ac8cfc8c",
                                        "entry_id": "716cf87a-0660-3791-bfa4-2abb4a0ed66c",
                                        "glosses": [
                                            "A person who dresses in leather or imitation leather."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d675a97e-1ad2-4b1f-b292-1691c30e48d9",
                                                "sense_id": "b01b9577-89cb-39cd-b8eb-92a4ac8cfc8c",
                                                "text": "The NYU tarts and the club slime, the art holes and the once-a-week bridge-and-tunnel leatherettes, the spikes and the usual dregs and walking garbage, Eel was giving them all the hiss."
                                            },
                                            {
                                                "example_id": "c6d7ca64-4158-42a5-bec4-38e8f4267047",
                                                "sense_id": "b01b9577-89cb-39cd-b8eb-92a4ac8cfc8c",
                                                "text": "Since I seemed to know some of the leatherettes, I was a magnet for fellow Jews wanting to know what was going on."
                                            },
                                            {
                                                "example_id": "f95b1162-058d-489d-859d-1672d4e1494f",
                                                "sense_id": "b01b9577-89cb-39cd-b8eb-92a4ac8cfc8c",
                                                "text": "I could tell in advance if they were screamers, or leatherettes, or buggers, or great head-givers, or into toys and ticklers – I had it down to an art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "a9b09bed-a0b1-452a-afa2-d47511f29f4c",
                        "source_entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
