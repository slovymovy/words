                        "glosses": [
                            "Fruit comestible du sapotier ou sapotillier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a04bc411-77aa-496e-a0c1-cb42ed2c1a4a",
                                "sense_id": "6f49a5ee-4fa6-349c-9b75-d5a5c257d43b",
                                "text": "Madame Sésostris croisa les jambes, dévoilant des cuisses magnifiques, couleur de sapotille mûre, qui faillirent me faire tomber du haut mal."
                            },
                            {
                                "example_id": "0bbc985a-2b84-4237-bf04-bd56458d3480",
                                "sense_id": "6f49a5ee-4fa6-349c-9b75-d5a5c257d43b",
                                "text": "Comme il a fait un beau coup sur les sapotilles\n Ou les pommes-cannelle avec un revendeur,\n Il est descendu par de petits chemins bleus\n Ombreux de galbas et de lianes à vanille\n Pour causer avec les « ti filles » de la ville."
                            }
                        ]
                    }
