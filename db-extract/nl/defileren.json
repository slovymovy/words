                "senses": [
                    {
                        "sense_id": "a7334e26-ec62-373c-b257-d9b53b4d3a40",
                        "entry_id": "58095161-9b1f-3fff-9602-7e4e81029bff",
                        "glosses": [
                            "in een smalle formatie voorbij trekken aan iets of iemand zodat iedereen kan groeten en gegroet kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c11395-fd62-4dd1-8346-ef3b25ddceeb",
                                "sense_id": "a7334e26-ec62-373c-b257-d9b53b4d3a40",
                                "text": "Na de officiële kranslegging houdt leerling Iris Taal van het Vrijzinnig Christelijk Lyceum in Den Haag een voordracht. De aanwezigen kunnen tot slot langs het monument defileren."
                            },
                            {
                                "example_id": "7ec66d8f-b475-4e38-93a5-2cc306a39f48",
                                "sense_id": "a7334e26-ec62-373c-b257-d9b53b4d3a40",
                                "text": "Nicolae en Alina, met wie hij afgelopen zomer in alle stilte voor de wet was getrouwd, woonden de uitvaart wel bij, en werden enthousiast begroet door de Roemenen die als laatste eerbetoon langs de baar defileerden."
                            }
                        ]
                    }
