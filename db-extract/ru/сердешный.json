                ],
                "senses": [
                    {
                        "sense_id": "5c15afe5-e968-3523-8f6f-29bcf2a097b2",
                        "entry_id": "4fd36227-6b25-3ca1-9c62-c8b5d9c68130",
                        "glosses": [
                            "устар. родной, родимый, любимый, милый"
                        ],
                        "tags": [
                            "может также быть и субстантивир."
                        ],
                        "examples": [
                            {
                                "example_id": "3529a3de-1b1f-41d9-a164-45eea3a6caad",
                                "sense_id": "5c15afe5-e968-3523-8f6f-29bcf2a097b2",
                                "text": "Что тебя доконало, сердешного?"
                            },
                            {
                                "example_id": "5efe90ac-21fa-4937-953c-079e3e342060",
                                "sense_id": "5c15afe5-e968-3523-8f6f-29bcf2a097b2",
                                "text": "Матвеевна говорит: ослобонят, а я говорю: нет, говорю, касатка, чует моё сердце, заедят они её, сердешную, так и вышло, ― говорила она, с удовольствием слушая звук своего голоса."
                            },
                            {
                                "example_id": "08508bda-38c2-41b1-aa5d-f15ac71ffea3",
                                "sense_id": "5c15afe5-e968-3523-8f6f-29bcf2a097b2",
                                "text": "— Грозу-то какую — бог послал! — говорила она. — А наши в степу ночуют, то-то натерпятся сердешные!"
                            }
                        ]
                    }
                ],
