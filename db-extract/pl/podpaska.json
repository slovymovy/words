                    {
                        "sense_id": "3d3126c7-ab2e-3576-a986-2405707d6a3f",
                        "entry_id": "a54d968a-76d2-399d-969c-ca71133189ae",
                        "glosses": [
                            "chłonny wkład zewnętrznie pochłaniający krew menstruacyjną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a218319-2cb7-456c-8204-d7782a1d5dd1",
                                "sense_id": "3d3126c7-ab2e-3576-a986-2405707d6a3f",
                                "text": "Zapas darmowych podpasek higienicznych w toalecie urzędu rozdrapano w dwie godziny."
                            },
                            {
                                "example_id": "5da2c7d5-163f-466d-9ae5-5baaa6aada60",
                                "sense_id": "3d3126c7-ab2e-3576-a986-2405707d6a3f",
                                "text": "Ewa używa podpasek ze skrzydełkami."
                            },
                            {
                                "example_id": "14c51332-11f9-4800-938e-20b317ed0ee8",
                                "sense_id": "3d3126c7-ab2e-3576-a986-2405707d6a3f",
                                "text": "Kupiłam znów worek podpasek (…) Strasznie nie lubię wystawać w sklepach po ten artykuł pierwszej potrzeby."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
