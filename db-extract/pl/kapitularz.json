                "translations": [
                    {
                        "translation_id": "a49b0e61-2870-4c76-85ec-cde86694a815",
                        "source_entry_id": "4505df3f-3361-3bf6-96a0-4b633299164c",
                        "source_sense_id": "ed24fed7-7a80-3a46-8cda-f715b38ce11e",
                        "target_lang_word": "chapter house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapter house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec97682-6e3e-3e03-b1f8-ea2ec8baeae3",
                                        "entry_id": "72b1396e-75c8-38ba-af16-50b94b650b38",
                                        "glosses": [
                                            "A building attached to a cathedral, church, or monastery and used as a meeting place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b2bf03-7d27-4586-a445-fa0c74b67122",
                                                "sense_id": "6ec97682-6e3e-3e03-b1f8-ea2ec8baeae3",
                                                "text": "The cloister, and the chapter-house adjoining to the church, are the finest here of any I have seen in England; the latter is octagon, or eight-square, and is 150 feet in its circumference."
                                            },
                                            {
                                                "example_id": "477c68be-da93-4a4f-8c67-7349f87c652a",
                                                "sense_id": "6ec97682-6e3e-3e03-b1f8-ea2ec8baeae3",
                                                "text": "In the center lay the broad Abbey buildings, with church and cloisters, hospitium, chapter-house and frater-house, all buzzing with a busy life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b985c7b7-363b-37e7-9324-7f1b209675af",
                                        "entry_id": "72b1396e-75c8-38ba-af16-50b94b650b38",
                                        "glosses": [
                                            "A building used by a sorority or fraternity as a residence or meeting place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12beb6bc-ef80-4a03-aa54-692734858034",
                                                "sense_id": "b985c7b7-363b-37e7-9324-7f1b209675af",
                                                "text": "At the house-party herein represented a murder is done, and the locale of the deed is a chapter house on the pleasant campus at Williamston, Mass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55323d4b-4dbd-4936-98f3-5e02b1fbe5ae",
                        "source_entry_id": "4505df3f-3361-3bf6-96a0-4b633299164c",
