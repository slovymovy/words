                "senses": [
                    {
                        "sense_id": "948af8b4-3fc0-3b5e-b731-2637e82918dd",
                        "entry_id": "2ed668d2-99f2-3c87-b68b-8c2d6900b315",
                        "glosses": [
                            "lautes Brüllen vor Schmerzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005455eb-2b41-468d-9522-89c2c353658f",
                                "sense_id": "948af8b4-3fc0-3b5e-b731-2637e82918dd",
                                "text": "„Ein fürchterliches Schmerzgebrüll antwortete dem Donner des Schusses, und gleich darauf plumpste der schwere Körper des Silberlöwen durch niederprasselnde Äste hindurch zu Boden.“"
                            },
                            {
                                "example_id": "2e494da8-f784-403a-af5f-0bc6b0121096",
                                "sense_id": "948af8b4-3fc0-3b5e-b731-2637e82918dd",
                                "text": "Dumpfes Vorsichhindämmern wechselte sich mit schauerlichem Stöhnen ab, das sich, wenn die Spritze nicht rechtzeitig verabreicht wurde, zu Schmerzgebrüll steigerte."
                            },
                            {
                                "example_id": "f99b46e3-6208-406b-9e1e-7200870bdea8",
                                "sense_id": "948af8b4-3fc0-3b5e-b731-2637e82918dd",
                                "text": "„In der Schulstube, wo ich neben dem Ofen lag, sah es wie in einer Metzgerei aus, so lagen die amputirten menschlichen Gliedmaßen umher, dazu das gräßliche Schmerzgebrüll und Todesächzen […].“ [1866]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
