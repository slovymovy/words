                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "572006cf-1182-4d61-8f81-15ef681db030",
                                "sense_id": "a5592ee1-b7cf-3645-b4d6-8036164abe9a",
                                "text": "Локализация лесного пожара"
                            }
                        ]
