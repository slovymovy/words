                                        "entry_id": "5ba0ee4f-cf4e-34cf-a459-3fd0f4772522",
                                        "glosses": [
                                            "An idiot; a fool."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e1494c4-c09a-4aae-98a3-f7075228629e",
                                                "sense_id": "d722c894-0e8d-3772-8b8a-e068484474fa",
                                                "text": "You fathead! You forgot to put the milk in the fridge and now it's spoiled!"
                                            },
                                            {
                                                "example_id": "7e282b2c-c144-4849-8f08-63f1d8b49fc2",
                                                "sense_id": "d722c894-0e8d-3772-8b8a-e068484474fa",
                                                "text": "‘We were getting a grand shot of a charging rhino when the cameraman got scared and bolted. The fathead!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c32455-822a-33a5-885c-d9ecbc10a21b",
                                        "entry_id": "5ba0ee4f-cf4e-34cf-a459-3fd0f4772522",
