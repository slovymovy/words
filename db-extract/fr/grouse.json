                "senses": [
                    {
                        "sense_id": "879ba0fb-e444-326c-8dc6-4fd85d10a378",
                        "entry_id": "dbed5619-6198-3fef-801e-3493ccb0b24c",
                        "glosses": [
                            "Petit coq de bruyère originaire d’Écosse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e06341-db31-4c94-99c7-20e2d237f68e",
                                "sense_id": "879ba0fb-e444-326c-8dc6-4fd85d10a378",
                                "text": "Je commence à avoir par-dessus la tête des grouses et de la venaison."
                            },
                            {
                                "example_id": "cfc05667-add1-4b27-8d7e-f884ebe4d9f3",
                                "sense_id": "879ba0fb-e444-326c-8dc6-4fd85d10a378",
                                "text": "Tous les mois, les revues mondaines publient des photographies d’art où l’on voit Lady Diana Wynham jouant au golf, baisant la bajoue d’un bull de six semaines, pilotant une Rolls-Royce, tirant des grouses sur les moors d’Écosse, ou arpentant, en sweater blanc, les terrasses de Monte-Carlo."
                            },
                            {
                                "example_id": "515594ef-40e8-4e5d-908b-612061e822bb",
                                "sense_id": "879ba0fb-e444-326c-8dc6-4fd85d10a378",
                                "text": "Ils trouvaient encore dans les plaines […] ces succulentes poules des prairies, avec lesquelles nos faisans ou nos grouses peuvent à peine rivaliser."
                            },
                            {
                                "example_id": "98339b21-a46c-4821-826e-cef530199282",
                                "sense_id": "879ba0fb-e444-326c-8dc6-4fd85d10a378",
                                "text": "Quelle joie d’entendre à nouveau la grouse écarlate et le chant mélodieux du macareux moqueur !"
                            },
                            {
                                "example_id": "12321e96-472d-4e58-8fc2-121b2ced9ec8",
                                "sense_id": "879ba0fb-e444-326c-8dc6-4fd85d10a378",
                                "text": "On était le dix-huit août - juste après le Douze Glorieux, jour de l’ouverture de la chasse au lagopède d’Écosse. Ils chassaient la grouse."
                            }
                        ]
                    }
