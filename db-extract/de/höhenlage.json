                        "examples": [
                            {
                                "example_id": "7de02033-0c9f-4cb4-8fba-47b7070a5361",
                                "sense_id": "12d6007d-2749-3cc9-ba6a-94124b918e12",
                                "text": "„Thomas horchte auf den Wind, der in diesen Höhenlagen oft die Bäume und Häuser umweht.“"
                            },
                            {
                                "example_id": "c6459b14-40ad-439a-a826-31189f45b536",
                                "sense_id": "12d6007d-2749-3cc9-ba6a-94124b918e12",
                                "text": "„Grundlegend ausgelöst wurde die Schmelze durch den Klimawandel, der in den Höhenlagen für deutlich gestiegene Temperaturen sorgt.“"
                            }
                        ],
