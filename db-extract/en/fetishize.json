                                "target_senses": [
                                    {
                                        "sense_id": "39ad0f29-7cd6-3c6c-a53f-d672eafb2b41",
                                        "entry_id": "86e57c93-790f-3d5a-84c9-36e6b31de5ff",
                                        "glosses": [
                                            "Considérer comme un fétiche quelque chose qui ne l’est pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e27994-250a-4141-9c48-e65ba70a416b",
                                                "sense_id": "39ad0f29-7cd6-3c6c-a53f-d672eafb2b41",
                                                "text": "Quel bénéfice y a-t-il à ressusciter, pour la fétichiser, cette mère archaïque, dont l'image ne peut que terrifier ?"
                                            },
                                            {
                                                "example_id": "14457ac9-90dd-4ce1-bda8-82557e20164c",
                                                "sense_id": "39ad0f29-7cd6-3c6c-a53f-d672eafb2b41",
                                                "text": "De même, cela nous permet d'éviter de fétichiser notre lecture ou de fétichiser l'identité de l'auteure."
                                            },
                                            {
                                                "example_id": "85a0f3d0-adec-4feb-90a4-c39ade0269c0",
                                                "sense_id": "39ad0f29-7cd6-3c6c-a53f-d672eafb2b41",
                                                "text": "Les comptes nationaux sont une construction sociale, en perpétuelle évolution, reflétant toujours les préoccupations d'une époque. Les chiffres qui en sont issus ne doivent pas être fétichisés."
                                            }
                                        ]
                                    }
                                ]
                            }
