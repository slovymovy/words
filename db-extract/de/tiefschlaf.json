                "senses": [
                    {
                        "sense_id": "76700f9f-b0f2-3f15-8ba7-b139ca61e27c",
                        "entry_id": "3652aafe-7cad-3d5f-be71-0e88d04dadc9",
                        "glosses": [
                            "besonders tiefer und fester Schlaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce7ebb1-9b16-44b2-9179-18ebf45c2480",
                                "sense_id": "76700f9f-b0f2-3f15-8ba7-b139ca61e27c",
                                "text": "„Von der Behandlung nehmen unsere Patienten im Tiefschlaf nichts wahr […].“"
                            },
                            {
                                "example_id": "bf07954a-df90-4153-8083-cee25f8fce4d",
                                "sense_id": "76700f9f-b0f2-3f15-8ba7-b139ca61e27c",
                                "text": "„In der Nacht fällt sie binnen weniger Minuten in den Tiefschlaf - normale Menschen brauchen 90 Minuten -, nach spätestens drei Stunden ist sie wieder fit.“"
                            },
                            {
                                "example_id": "13624a84-f9f5-44eb-af5b-06a74fb032a3",
                                "sense_id": "76700f9f-b0f2-3f15-8ba7-b139ca61e27c",
                                "text": "„Diesmal, in Freiheit, ließen mich das Rattern der Räder und das Schaukeln der Waggons in den Tiefschlaf verfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de8edaa1-078c-4458-b2dc-8dc940c507de",
                        "source_entry_id": "3652aafe-7cad-3d5f-be71-0e88d04dadc9",
                        "source_sense_id": "76700f9f-b0f2-3f15-8ba7-b139ca61e27c",
                        "source_sense_description": "besonders tiefer und fester Schlaf",
                        "target_lang_word": "deep sleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deep sleep",
