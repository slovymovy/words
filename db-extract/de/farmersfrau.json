                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9510ca9c-40d5-4456-af8b-8cdb542a0dfe",
                                "sense_id": "e427658a-9689-36d8-936e-93a2c7f39848",
                                "text": "„Die Fremden waren allein, da sich nur die Farmersfrau daheim befand und jetzt in dem kleinen Stalle war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
