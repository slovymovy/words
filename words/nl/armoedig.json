{
    "word_family": [
        "armoede",
        "arm"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71e76c47-89fa-3f8a-8c80-eab55d0ccb48",
                    "sense_definition": "Kenmerkend voor armoede; arm of weinig welvarend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "armoede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is een <w>armoedige</w> streek waar veel mensen moeite hebben om rond te komen.",
                            "target_lang_translations": {
                                "en": "This is a <w>poor</w> region where many people struggle to make ends meet."
                            }
                        },
                        {
                            "text": "Zij groeide op in een <w>armoedige</w> buurt aan de rand van de stad.",
                            "target_lang_translations": {
                                "en": "She grew up in an <w>impoverished</w> neighborhood on the outskirts of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "arm",
                        "behoeftig",
                        "armlastig"
                    ],
                    "antonyms": [
                        "rijk",
                        "welvarend"
                    ],
                    "common_phrases": [
                        "armoedige streek",
                        "armoedige buurt"
                    ],
                    "target_lang_definitions": {
                        "en": "Characteristic of poverty; poor or lacking prosperity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poor",
                                "target_lang_sense_clarification": "lacking money or resources"
                            },
                            {
                                "target_lang_word": "impoverished",
                                "target_lang_sense_clarification": "reduced to poverty"
                            },
                            {
                                "target_lang_word": "poverty-stricken",
                                "target_lang_sense_clarification": "suffering from poverty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0114a1fd-1674-344a-9592-87a23faad116",
                    "sense_definition": "Er kaal, versleten of verwaarloosd uitzien; getuigend van een gebrek aan kwaliteit of zorg.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kamer oogt erg <w>armoedig</w> met die oude, versleten meubels.",
                            "target_lang_translations": {
                                "en": "That room looks very <w>shabby</w> with those old, worn-out pieces of furniture."
                            }
                        },
                        {
                            "text": "Trek die <w>armoedige</w> kleren toch eens uit en trek wat leuks aan.",
                            "target_lang_translations": {
                                "en": "Take off those <w>scruffy</w> clothes and put on something nice."
                            }
                        }
                    ],
                    "synonyms": [
                        "schamel",
                        "kaal",
                        "versleten",
                        "sjofel"
                    ],
                    "antonyms": [
                        "luxueus",
                        "degelijk",
                        "netjes"
                    ],
                    "common_phrases": [
                        "armoedige kleren",
                        "armoedig interieur"
                    ],
                    "target_lang_definitions": {
                        "en": "Looking bare, worn out, or neglected; showing a lack of quality or care."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shabby",
                                "target_lang_sense_clarification": "worn out and in poor condition"
                            },
                            {
                                "target_lang_word": "scruffy",
                                "target_lang_sense_clarification": "untidy and dirty"
                            },
                            {
                                "target_lang_word": "run-down",
                                "target_lang_sense_clarification": "neglected and in a bad state"
                            },
                            {
                                "target_lang_word": "seedy",
                                "target_lang_sense_clarification": "shabby and untidy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}