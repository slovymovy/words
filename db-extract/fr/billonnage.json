                "senses": [
                    {
                        "sense_id": "37b41b0a-90cf-30d1-9230-801e617db415",
                        "entry_id": "edc71be6-0364-3c3f-bea9-6aa91c89effd",
                        "glosses": [
                            "Action de faire des billons dans un champ ou résultat de cette action ^([1])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a9266d-9633-4f7b-bf33-428a0067e435",
                                "sense_id": "37b41b0a-90cf-30d1-9230-801e617db415",
                                "text": "Le billonnage est réalisé, soit sur des sols labourés, soit sur des sols non préparés. Ce travail consiste à accoler deux à deux les bandes retournées pour former un ados ou billon et une dérayure."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b89a469-c126-3914-a780-430ccc5263b2",
                        "entry_id": "edc71be6-0364-3c3f-bea9-6aa91c89effd",
                        "glosses": [
                            "Action de tronçonner les arbres en billon."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": [
                            {
                                "example_id": "61077109-d19a-4fc1-b109-b03a3c65d951",
                                "sense_id": "1b89a469-c126-3914-a780-430ccc5263b2",
                                "text": "La coopérative s’engage à satisfaire les besoins qualitatifs (dimensions, calibres, rectitude) de ses clients, souvent équipés de combinés de billonnage/fendage, en triant les bois en forêt, sur coupe, en lots homogènes pour répondre à chaque cahier des charges."
                            }
                        ]
                    },
                    {
                        "sense_id": "6323f6ae-1838-35d5-b3de-7d681d02edd9",
                        "entry_id": "edc71be6-0364-3c3f-bea9-6aa91c89effd",
                        "glosses": [
                            "Altération de la monnaie, trafic de cette fausse monnaie ^([2])."
                        ],
