                    ]
                },
                {
                    "sense_id": "3f6e4dd1-f8b5-3c75-ac4c-66b1db440c19",
                    "sense_definition": "Dispositif ou programme informatique intermédiaire relayant les requêtes réseau entre des clients et des serveurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'administrateur système a configuré un serveur <w>mandataire</w> pour filtrer les connexions Internet."
                        },
                        {
                            "text": "Les requêtes de navigation passent obligatoirement par un <w>mandataire</w> sécurisé."
