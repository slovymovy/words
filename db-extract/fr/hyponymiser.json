                "senses": [
                    {
                        "sense_id": "50fde63c-35b9-3f2d-977e-6ae7ff1e4d71",
                        "entry_id": "2b0bd342-ad11-3762-ba48-ae0b11c429c4",
                        "glosses": [
                            "Choisir d’utiliser un hyponyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda6730a-4bef-4e15-a4c8-95472198cc9e",
                                "sense_id": "50fde63c-35b9-3f2d-977e-6ae7ff1e4d71",
                                "text": "D’ailleurs, on est souvent amené, lors du passage de l’anglais au français, à rechercher le mot juste, précis, autrement dit à hyponymiser."
                            },
                            {
                                "example_id": "4649b1f6-6efc-4caf-9e1e-9b7efe08508c",
                                "sense_id": "50fde63c-35b9-3f2d-977e-6ae7ff1e4d71",
                                "text": "Dans cette phrase, en choisissant d’hyponymiser room en cachot, il devient superflu de traduire sooty, mess et filthy, ces traits sémantiques étant présents dans le terme cachot."
                            }
                        ]
                    }
                ],
