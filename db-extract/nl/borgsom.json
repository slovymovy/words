                            },
                            {
                                "target_word": "bail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf6a12c-1214-3302-933d-9e431d4b338c",
                                        "entry_id": "70839278-b15b-3cac-9f51-0dce399d9889",
                                        "glosses": [
                                            "To leave or exit abruptly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812e9731-b00c-4482-913e-80e8799bf05b",
                                                "sense_id": "eaf6a12c-1214-3302-933d-9e431d4b338c",
                                                "text": "With his engine in flames, the pilot had no choice but to bail."
                                            },
                                            {
                                                "example_id": "9df90427-9416-4532-8193-2ea2f83f04b8",
                                                "sense_id": "eaf6a12c-1214-3302-933d-9e431d4b338c",
                                                "text": "The Teacher Home Visit Program takes a huge commitment—time, energy, patience, diplomacy. Quite a few schools […] have tried it and bailed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1bd123-7662-3947-9b16-b4934b61df3d",
                                        "entry_id": "70839278-b15b-3cac-9f51-0dce399d9889",
                                        "glosses": [
                                            "To fail to meet a commitment (to a person)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8262c14f-fab3-4aae-b810-1e4310f0bf5b",
                                                "sense_id": "af1bd123-7662-3947-9b16-b4934b61df3d",
                                                "text": "\"No one bails on Bennie Milagros. No one, comprende? I'm gonna hold you to that midnight run — \""
                                            },
                                            {
                                                "example_id": "88abb271-1b8e-435e-843a-a41b1103063d",
                                                "sense_id": "af1bd123-7662-3947-9b16-b4934b61df3d",
                                                "text": "And I ain't got no help. Goddamn Fitch bails on me, scrambles over to Finance."
                                            },
                                            {
                                                "example_id": "e039a5af-61c0-40c5-9ba7-0cd7761eda88",
                                                "sense_id": "af1bd123-7662-3947-9b16-b4934b61df3d",
                                                "text": "A guy who bails on his young wife and son the way he did. Leaving us to fend for ourselves."
                                            },
                                            {
                                                "example_id": "ce3c8186-6f70-47e6-8b53-6949bcb10c2c",
                                                "sense_id": "af1bd123-7662-3947-9b16-b4934b61df3d",
                                                "text": "\"We'll just tell Peter that you got called back to work. He bails on vacations all the time for that reason.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2644b17d-aa16-3734-be69-94e0a1339988",
                                        "entry_id": "740518af-e17b-366a-9e90-a5c782f15c1d",
                                        "glosses": [
                                            "A hoop, ring or handle (especially of a kettle or bucket)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a5810f-94b2-49fe-94e0-8bf851954ce4",
                                                "sense_id": "2644b17d-aa16-3734-be69-94e0a1339988",
                                                "text": "I reached across beneath the cow to attach a metal bail to each end of the strap so that the bail hung about 5 inches below the cow's belly.[…]While stroking and talking to the cow, I reached under and suspended the machine on the bail beneath the cow, with its four suction cups dangling to one side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17af587d-6cb0-3b96-8cc5-8f96f49df76b",
                                        "entry_id": "740518af-e17b-366a-9e90-a5c782f15c1d",
                                        "glosses": [
                                            "A stall for a cow (or other animal) (usually tethered with a semi-circular hoop)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ab721c-cd7c-4349-9ac2-d9d9b3edb7d0",
                                                "sense_id": "17af587d-6cb0-3b96-8cc5-8f96f49df76b",
                                                "text": "1953, British Institute of Management, Centre for Farm Management, Farm Management Association, Farm Managememt, 1960, John Wiley, page 160,\nMore recently, the fixed bail, sometimes called the ‘milking parlour’, with either covered or open yards, has had a certain vogue and some very enthusiastic claims have been made for this method of housing."
                                            },
                                            {
                                                "example_id": "ff47fcfb-8c09-4d79-8a49-affc785a8758",
                                                "sense_id": "17af587d-6cb0-3b96-8cc5-8f96f49df76b",
                                                "text": "2011, Edith H. Whetham, Joan Thirsk, The Agrarian History of England and Wales, Volume 8: Volumes 1914-1939, page 191,\nTen men thus sufficed for the milking of three hundred cows in five bails, instead of the thirty men who would normally have been employed by conventional methods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461afe80-a957-30cb-ac23-21fc4da99d91",
                                        "entry_id": "740518af-e17b-366a-9e90-a5c782f15c1d",
                                        "glosses": [
                                            "A hinged bar as a restraint for animals, or on a typewriter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e627d8d6-80b2-3e0d-87bc-7fdb58ea1000",
                                        "entry_id": "740518af-e17b-366a-9e90-a5c782f15c1d",
                                        "glosses": [
                                            "A frame to restrain a cow during milking or feeding."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c48ebff-2d0b-4d59-a5c9-f694607b76d9",
                                                "sense_id": "e627d8d6-80b2-3e0d-87bc-7fdb58ea1000",
                                                "text": "But until he had poured enough milk into the vat above the separator, I drove unmilked cows into the bail where he had previously milked and released one. He moved from one bail to the other to milk the next one I had readied. I drove each cow into the empty bail, chained her in, roped the outer hind leg then washed and massaged the udder and teats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf68d315-c7b4-3774-88b9-0b0a07d129de",
                                        "entry_id": "740518af-e17b-366a-9e90-a5c782f15c1d",
                                        "glosses": [
                                            "A hoop, ring, or other object used to connect a pendant to a necklace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3b81a7e-c874-3a60-9b4f-9107bf13fc73",
                                        "entry_id": "740518af-e17b-366a-9e90-a5c782f15c1d",
                                        "glosses": [
                                            "One of the two wooden crosspieces that rest on top of the stumps to form a wicket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07cdf75-89cd-40cb-97cb-7f5302a82450",
                                                "sense_id": "f3b81a7e-c874-3a60-9b4f-9107bf13fc73",
                                                "text": "As Jason Roy's throw came in from deep mid-wicket, a diving Guptill was short when Buttler removed the bails, sending England and the whole of Lord's into delirious celebrations."
                                            }
                                        ]
                                    },
                                    {
