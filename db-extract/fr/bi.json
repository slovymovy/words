                                "target_senses": [
                                    {
                                        "sense_id": "3f9947cb-06df-3e0b-8264-0995be916372",
                                        "entry_id": "48968d3d-c2c6-3450-aacd-79a324369a20",
                                        "glosses": [
                                            "A contest, especially for spelling; see spelling bee."
                                        ],
