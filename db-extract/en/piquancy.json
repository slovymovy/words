                    {
                        "sense_id": "e9262f21-c973-3560-9c7a-0b053b916738",
                        "entry_id": "401d8a1e-7d0d-384a-80ec-216bc33d1fcc",
                        "glosses": [
                            "The degree to which something is piquant, stimulating or exciting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b4c9f6ed-37d3-4b77-9556-45002c8c9002",
                                "sense_id": "e9262f21-c973-3560-9c7a-0b053b916738",
                                "text": "At fifteen, her poetry of feeling (you see I do my best to please you with a phrase) would just give piquancy and freshness to her entry into life; but at twenty,..."
                            },
                            {
                                "example_id": "f1514a82-9a95-4dc9-ba82-cf3fe9aed4d0",
                                "sense_id": "e9262f21-c973-3560-9c7a-0b053b916738",
                                "text": "There was a certain playfulness about her too, such a piquancy or ironic suggestion, such an untouched reserve."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45bc56f9-86b5-4950-9ced-94c273cc9000",
                        "source_entry_id": "401d8a1e-7d0d-384a-80ec-216bc33d1fcc",
                        "source_sense_id": "e9262f21-c973-3560-9c7a-0b053b916738",
                        "source_sense_description": "degree to which something is piquant",
                        "target_lang_word": "Pikanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pikanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6bd7fd0-5b31-3730-aaa6-1d48218873dc",
                                        "entry_id": "3616e26c-d0f2-373a-aa19-db9d51dda2b6",
                                        "glosses": [
                                            "Reiz im Sinne von: anregend und/oder erregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb3ea86-e9df-4d16-817c-81971f8574f3",
                                                "sense_id": "e6bd7fd0-5b31-3730-aaa6-1d48218873dc",
                                                "text": "Die Pikanterie an der Sache war, dass niemand oberhalb bekleidet sein durfte."
                                            },
                                            {
                                                "example_id": "cfbd03f7-76ac-45f8-bd6b-c657bf58451e",
                                                "sense_id": "e6bd7fd0-5b31-3730-aaa6-1d48218873dc",
                                                "text": "„St. Arnaud applaudierte der Malerin, und selbst Cécile, die beim Beginn des Wortgefechtes ein leises Unbehagen nicht unterdrücken konnte, hatte sich, als ihr das harmlos Unbeabsichtigte dieser kleinen Pikanterien zur Gewißheit geworden war, ihrer allerbesten Laune rückhaltlos hingegeben.“"
                                            },
                                            {
                                                "example_id": "e9e47d5f-be48-46a9-89c4-9cc2cd2568c7",
                                                "sense_id": "e6bd7fd0-5b31-3730-aaa6-1d48218873dc",
                                                "text": "„Uns skandalisieren die Pikanterien der Geschichten nicht mehr.“"
                                            },
                                            {
                                                "example_id": "601f6dfc-797d-4bab-8d72-4d47e8289770",
                                                "sense_id": "e6bd7fd0-5b31-3730-aaa6-1d48218873dc",
                                                "text": "„Eine zweite Pikanterie bestand darin, daß der Vorsitzende bereits am ersten Verhandlungstag die Öffentlichkeit ausschloß, und zwar nachdem der Angeklagte Lieven angekündigt hatte, im Detail den Trick erklären zu wollen, mit dem er die Sperrmark freibekommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
