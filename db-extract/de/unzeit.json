                "senses": [
                    {
                        "sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                        "entry_id": "8d0af2e5-dc0f-3008-9f48-f27c00c5c0ab",
                        "glosses": [
                            "ungeeigneter, ungünstiger Zeitpunkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aaf9d30-f7b2-4f1e-be48-44743bfe7d23",
                                "sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                                "text": "Der Besuch erschien bei uns leider zur Unzeit."
                            },
                            {
                                "example_id": "3050e93b-1428-4806-bdd8-013e2a6c185e",
                                "sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                                "text": "„Die Klägerin machte eine treu- und sittenwidrige Kündigung zu \"Unzeiten\" geltend, was das Bundesarbeitsgericht jedoch ablehnte.“"
                            },
                            {
                                "example_id": "51a9a5c2-4549-4e52-aeb7-f504b6d533ab",
                                "sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                                "text": "„Er brachte mir das Ende nahe, an das ich nicht zur Unzeit erinnert sein wollte.“"
                            },
                            {
                                "example_id": "45d7e265-2843-4126-a558-3ff4ec1e4c88",
                                "sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                                "text": "„Fach als erstes Wortglied bedeutet Fachgelehrsamkeit; brachte ein Fuchs zur Unzeit seine junge Fuchsweisheit an, so zog er sich die Schelte Fachsimpel zu.“"
                            },
                            {
                                "example_id": "cc30dea7-a644-4c34-bb68-8ef989a1cd94",
                                "sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                                "text": "„Ein stolzer Erzeuger war er nun nicht gerade, und so wie schon meine Halbschweser zur Unzeit geboren wurde, empfand er auch meine Existenz anfangs eher als zusätzliche Belastung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2dbcbc0-4b2c-4997-b3a6-020ee539244b",
                        "source_entry_id": "8d0af2e5-dc0f-3008-9f48-f27c00c5c0ab",
                        "source_sense_id": "8a3ab459-23b8-3ac7-8b27-7105fb81e931",
                        "source_sense_description": "ungeeigneter, ungünstiger Zeitpunkt",
                        "target_lang_word": "ongelegen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongelegen",
