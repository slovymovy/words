                        "glosses": [
                            "Heiliger, der um für die Landwirtschaft günstiges Wetter zu erbitten oder Hungersnot abzuwenden angerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b0ac12-de14-416b-8085-34f86d80959f",
                                "sense_id": "943d8bb5-4a10-36c5-946c-588c3c52bb05",
                                "text": "Die Wetterheiligen werden in allen Kulturen für eine erfolgreiche Ernte angerufen."
                            },
                            {
                                "example_id": "b95851a3-2547-43c5-9fc8-95500fad3006",
                                "sense_id": "943d8bb5-4a10-36c5-946c-588c3c52bb05",
                                "text": "Der Bildstock des hl. Christophorus an der Entschlafungskirche in Trepcza stellt einen Wetterheiligen dar."
                            }
                        ],
