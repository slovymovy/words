                ],
                "senses": [
                    {
                        "sense_id": "c1b92e6d-bd62-359e-91ec-0c22fbca0c2a",
                        "entry_id": "5c9d853d-bef9-3e82-96c3-05c9a941d622",
                        "glosses": [
                            "die Beziehung von Klängen, Tönen und Akkorden zueinander auf der Basis eines zugrunde liegenden Tonsystems"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ca72bf61-d1a6-416f-884a-820d9e287efa",
                                "sense_id": "c1b92e6d-bd62-359e-91ec-0c22fbca0c2a",
                                "text": "Das zugrundeliegende Tonsystem „mag wie immer beschaffen sein – ohne eine Bezogenheit der Töne aufeinander kann Musik nicht gedacht werden. Es gibt also im Grunde keine Musik ohne Tonalität, im strengen Sinne also auch keine atonale Musik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39757bf4-003b-3584-92de-7923b7a2d91a",
                        "entry_id": "5c9d853d-bef9-3e82-96c3-05c9a941d622",
                        "glosses": [
                            "Eigenschaft eines Farbtons, einen speziellen Ton aus dem Farbspektrum wiederzugeben"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "76e81077-84db-4176-9d1b-6bd2923e32b4",
                                "sense_id": "39757bf4-003b-3584-92de-7923b7a2d91a",
                                "text": "„Die Physiologie des Sehens erklärt ihrerseits die Strukturen und die Funktionsmechanismen des Sehorgans, daher können diese Informationen und Phänomene nur durch die Untersuchung der menschlichen Perzeptionsprozesse verstanden werden, und zuletzt hat die chemische „colorométrie“ mehr als 50.000 Nuancen der Tonalität der Farben identifiziert, die auf numerischer Basis differenziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2f215149-eaae-3455-86cd-8b726f5aaad1",
                        "entry_id": "5c9d853d-bef9-3e82-96c3-05c9a941d622",
                        "glosses": [
                            "die signifikante, bedeutungsrelevante Variation von Tonhöhen in einer Sprache (wie z.B. in der chinesischen Sprache)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727871be-f3ad-497b-96ac-d0d1b624ca31",
                                "sense_id": "2f215149-eaae-3455-86cd-8b726f5aaad1",
                                "text": "„Charakteristische Merkmale des Chinesischen sind Tonalität, Einsilbigkeit, Nicht-Flektierbarkeit und die Schriftzeichen. Im Chinesischen kann jede Silbe in vier verschiedenen sogenannten „Tönen“ ausgesprochen werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "d31b426e-782f-3ddd-90e6-37986dbd902e",
                        "entry_id": "5c9d853d-bef9-3e82-96c3-05c9a941d622",
                        "glosses": [
                            "Art und Weise der Ansprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb67a568-9d01-41f9-9d3b-3e3e7d77340f",
                                "sense_id": "d31b426e-782f-3ddd-90e6-37986dbd902e",
                                "text": "„Hinsichtlich der Tonalität kann z. B. aufgrund des Alters der Zielgruppe (Lehrlinge/Berufseinsteiger vs. Berufserfahrene) eine unterschiedliche Ansprache zweckmäßig sein.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac3820a4-b963-4163-bcc7-0030a44595bd",
                        "source_entry_id": "5c9d853d-bef9-3e82-96c3-05c9a941d622",
                        "source_sense_id": "c1b92e6d-bd62-359e-91ec-0c22fbca0c2a",
                        "target_lang_word": "tonalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tonalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0bf006-7e81-3c69-9eb4-f267dfa1f0db",
                                        "entry_id": "461cdb2d-53fb-3994-b42f-610ce9941ec1",
                                        "glosses": [
                                            "Caractère d’un ton, d’un morceau écrit dans un ton déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54319a6c-1c87-4e54-a65f-dc367d43175d",
                                                "sense_id": "aa0bf006-7e81-3c69-9eb4-f267dfa1f0db",
                                                "text": "Ce dernier peut ainsi obtenir à volonté, suivant la nature du radio-concert ou de la reproduction phonographique, une audition de tonalité générale plus grave ou plus aiguë. Des systèmes réglables de variation de tonalité sont montés, comme on le sait, sur la plupart des radio-récepteurs actuels."
                                            },
                                            {
                                                "example_id": "dea890c2-49f5-4cba-8d3e-81bd66034da0",
                                                "sense_id": "aa0bf006-7e81-3c69-9eb4-f267dfa1f0db",
                                                "text": "La note sensible et l’accord parfait déterminent la tonalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6259269f-85d2-30ff-b159-65162ca8bfc9",
                                        "entry_id": "461cdb2d-53fb-3994-b42f-610ce9941ec1",
                                        "glosses": [
                                            "Nuance de couleur."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae35aed-ecac-4a46-bcce-ad0e36cc1e32",
                                                "sense_id": "6259269f-85d2-30ff-b159-65162ca8bfc9",
                                                "text": "Dès l'automne, la Fougère Aigle aux frondes desséchées attriste de sa teinte rouille la tonalité déjà grise de l'ensemble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6548bdff-0594-3ad8-9588-1f760aee1b7e",
                                        "entry_id": "461cdb2d-53fb-3994-b42f-610ce9941ec1",
                                        "glosses": [
                                            "Nuance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af7bdad-4a7b-431d-a0c0-2f7823d7d65b",
                                                "sense_id": "6548bdff-0594-3ad8-9588-1f760aee1b7e",
                                                "text": "Il n'en demeure pas moins que la substitution des archives judiciaires aux archives notariales amène un changement de tonalité dans l'éclairage : à une vision « lisse » se substitue une vision « rugueuse » des relations sociales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97971050-4e99-3414-9056-65dcf81582bc",
                                        "entry_id": "461cdb2d-53fb-3994-b42f-610ce9941ec1",
                                        "glosses": [
                                            "Signal sonore qu’un central téléphonique émet à l’attention de l’utilisateur du téléphone pour fournir au correspondant une information."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61e8d4d0-65c8-380e-af36-f61b9f619025",
                                        "entry_id": "461cdb2d-53fb-3994-b42f-610ce9941ec1",
                                        "glosses": [
                                            "Caractère d’une couleur associé à la couleur qui produit sur l’œil une sensation lumineuse de niveau élevé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
