                    "sense_definition": "A short form of the male given name Herbert.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Herb</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Херб</w> приедет навестить нас в эти выходные.",
                                "pl": "Mój wujek <w>Herb</w> odwiedzi nas w ten weekend."
                            }
                        },
                        {
                            "text": "<w>Herb</w> and his wife have lived in this neighborhood for forty years.",
                            "target_lang_translations": {
                                "ru": "<w>Херб</w> с женой живут в этом районе уже сорок лет.",
                                "pl": "<w>Herb</w> i jego żona mieszkają w tej okolicy od czterdziestu lat."
                            }
