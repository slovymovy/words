                "senses": [
                    {
                        "sense_id": "ece7221a-e467-31f8-bfa3-a6b3e752015d",
                        "entry_id": "c1215877-6997-3aeb-afc8-5b1afd6f4cfd",
                        "glosses": [
                            "Vorstadt (meist einer mittelalterlichen Stadt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe147f3-6839-44e5-930b-4ff9c9f65021",
                                "sense_id": "ece7221a-e467-31f8-bfa3-a6b3e752015d",
                                "text": "„Archäologisch ist ein Suburbium an diesem Ufer der Havel nicht nachgewiesen.“"
                            },
                            {
                                "example_id": "8a749c22-d492-412b-96c1-883ca6512095",
                                "sense_id": "ece7221a-e467-31f8-bfa3-a6b3e752015d",
                                "text": "„Die Handwerker in den Suburbien waren keine freien Leute, die gegen Lohn und für den Absatz auf einem Markt arbeiteten.“"
                            },
                            {
                                "example_id": "0658c6fd-36ea-418c-9c05-6396916b2bd6",
                                "sense_id": "ece7221a-e467-31f8-bfa3-a6b3e752015d",
                                "text": "„Schon in der hohen Kaiserzeit war das römische Suburbium ein Raum, in dem Agrar- und Wirtschaftsflächen mit dichter Besiedlung wechselten und damit eine ähnliche lockere Siedlungsstruktur aufwiesen wie die Gartenanlagen der aristokratischen Wohnbezirke an der städtischen Peripherie.“"
                            },
                            {
                                "example_id": "f9280805-5ab3-462a-8703-6ae7cd4f8b96",
                                "sense_id": "ece7221a-e467-31f8-bfa3-a6b3e752015d",
                                "text": "„Seit der augusteischen Zeit ändert sich nach Meinung des vielleicht besten Kenners des Suburbiums, Lorenzo Quilici, das Verhältnis zwischen Stadt und Suburbium substantiell, und zwar im Sinne einer Urbanisierung des letzteren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
