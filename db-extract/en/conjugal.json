                        "source_sense_id": "6f6e2b4e-a7e3-3d70-afc6-fbadb4c79314",
                        "source_sense_description": "of, or relating to marriage, or the relationship of spouses",
                        "target_lang_word": "manželský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manželský",
