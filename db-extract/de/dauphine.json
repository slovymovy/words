                                "target_senses": [
                                    {
                                        "sense_id": "da49f237-5414-3fcf-b165-56ed0cec895f",
                                        "entry_id": "cadc5252-8fb8-386b-a41a-6bae87288ee6",
                                        "glosses": [
                                            "Épouse du dauphin : future reine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ab6359-a528-4132-bd55-50e6f0baa11e",
                                                "sense_id": "da49f237-5414-3fcf-b165-56ed0cec895f",
                                                "text": "La plupart de ceux qui ont cru ou feint de croire à l'empoisonnement du dauphin et de la dauphine"
                                            },
                                            {
                                                "example_id": "bc6ba564-2c83-43de-82b0-57aa003c57ee",
                                                "sense_id": "da49f237-5414-3fcf-b165-56ed0cec895f",
                                                "text": "Antonia ou « l’Antoine » doit d’abord être un parfait petit soldat, qui écrira à sa mère (une première chez les dauphines ou reines de France) et qui tentera d’influencer son époux ou d’infléchir sa politique en faveur de l’empire d’Autriche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eef6b6f-b8a0-387c-92f3-af5aada18d1d",
                                        "entry_id": "cadc5252-8fb8-386b-a41a-6bae87288ee6",
                                        "glosses": [
                                            "Héritière d’un personnage important."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01b02b1-970c-40fa-a885-f6665bed3d33",
                                                "sense_id": "2eef6b6f-b8a0-387c-92f3-af5aada18d1d",
                                                "text": "Quant à représenter l’héritage de M. Labeaume, sa dauphine fait le bon calcul en ne sentant pas le besoin de prendre ses distances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f1fb253-5aec-3bcd-9ca2-3337d9bec7ab",
                                        "entry_id": "cadc5252-8fb8-386b-a41a-6bae87288ee6",
                                        "glosses": [
                                            "Seconde d'un concours ou d'une compétition féminine, notamment d'un concours de beauté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "238f5aa1-637d-477b-8bb8-42c4245e459c",
                                                "sense_id": "7f1fb253-5aec-3bcd-9ca2-3337d9bec7ab",
                                                "text": "Marine Lorphelin, Miss France 2013, a été élue samedi première dauphine de Miss Monde au cours d'une cérémonie sur l'île indonésienne de Bali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fcd0933-c9fc-39af-b298-aa9d738c5d12",
                                        "entry_id": "cadc5252-8fb8-386b-a41a-6bae87288ee6",
                                        "glosses": [
                                            "Femelle du dauphin."
                                        ],
                                        "tags": [
                                            "Cétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b45b122-0b14-4626-a155-1b621da8233b",
                                                "sense_id": "3fcd0933-c9fc-39af-b298-aa9d738c5d12",
                                                "text": "Une dauphine du parc animalier Marineland, à Antibes, a donné naissance à son bébé, vendredi dernier."
                                            }
                                        ]
                                    }
                                ]
