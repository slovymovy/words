                "senses": [
                    {
                        "sense_id": "7a6ce7f7-dc8e-3895-997b-21a51f89d3c2",
                        "entry_id": "5b3e3cb5-4385-32da-a73e-4781703c208e",
                        "glosses": [
                            "Camail d’ecclésiastique catholique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047ceba2-e955-4e7f-a24b-e7c522ad2f0b",
                                "sense_id": "7a6ce7f7-dc8e-3895-997b-21a51f89d3c2",
                                "text": "Je ne parle pas ici, bien entendu, des chanoines honoraires ou des chanoines d’honneur. Ceux-là n’ont aucune obligation à remplir ; ils sont pourvus d’un simple titre honorifique qui leur permet de porter la mosette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ba35a32-b94a-4063-9dcd-bc6165fc5b98",
                        "source_entry_id": "5b3e3cb5-4385-32da-a73e-4781703c208e",
                        "source_sense_id": "7a6ce7f7-dc8e-3895-997b-21a51f89d3c2",
                        "target_lang_word": "mozzetta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mozzetta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5528b38-3fd4-33ff-9434-f0eaf89a9ed5",
                                        "entry_id": "6bb7a0da-9cc6-3932-83ca-f1161dc7fbc3",
                                        "glosses": [
                                            "A short cape covering the shoulders and buttoned in front, with a hood, which is worn by the pope, cardinals, bishops, and other senior clergy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c03a147-36b7-45b2-a054-f91e9a946c80",
                                                "sense_id": "b5528b38-3fd4-33ff-9434-f0eaf89a9ed5",
                                                "text": "Benedict [XVI], the first pope to resign voluntarily in six centuries, will dress in a simple white cassock, forgoing the mozzetta, the elbow-length cape worn by some Catholic clergymen, the Vatican spokesman, the Rev. Federico Lombardi, told reporters at a news briefing."
                                            },
                                            {
                                                "example_id": "3ab4a360-48bc-4249-980e-424f52b2d30a",
                                                "sense_id": "b5528b38-3fd4-33ff-9434-f0eaf89a9ed5",
                                                "text": "On that night of his election he [Pope Francis] stepped out on to the balcony overlooking Saint Peter's Square in simple white robes, refusing the fancy red mozzetta or cape that Benedict [XVI] had sported when he had been announced as pope. When told to put on white trousers, he later remembered in his autobiography, he replied: \"I don't want to be an ice-cream seller.\""
                                            },
                                            {
                                                "example_id": "2d796c36-d2bc-4777-8399-e3b8cb05a98c",
                                                "sense_id": "b5528b38-3fd4-33ff-9434-f0eaf89a9ed5",
                                                "text": "The most notable figure in the room is Irish-American Cardinal Kevin Farrell, who is the Pope [Francis]'s \"camerlengo\" or chamberlain and runs the Vatican until a new Pope is chosen. The cardinal – in red mozzetta and cassock – is shown blessing the body of the late Pope during the rite of the declaration of death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
