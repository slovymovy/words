                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lumière <w>aveuglante</w> des phares de la voiture m'a obligé à ralentir immédiatement."
                        },
                        {
                            "text": "En sortant du tunnel, le soleil <w>aveuglant</w> a surpris tous les conducteurs sur l'autoroute."
                        }
                    ],
                    "synonyms": [
                        "éblouissant"
                    ],
                    "common_phrases": [
