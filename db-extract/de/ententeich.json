                "senses": [
                    {
                        "sense_id": "9e8897a2-2cb9-3a09-b3ad-6f54b264626c",
                        "entry_id": "cac5e178-439c-3911-9d79-fa733b6932f4",
                        "glosses": [
                            "von Enten bewohntes kleines Gewässer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df78c87c-e8e9-463c-8901-27f8da3fb99e",
                                "sense_id": "9e8897a2-2cb9-3a09-b3ad-6f54b264626c",
                                "text": "Mitten im Park befand sich ein großer Ententeich."
                            },
                            {
                                "example_id": "14c93de7-2a88-4327-b938-59183b052fa0",
                                "sense_id": "9e8897a2-2cb9-3a09-b3ad-6f54b264626c",
                                "text": "„Am nächsten Morgen um zehn Uhr schwammen im Ententeich wieder Enten statt Puppen.“"
                            },
                            {
                                "example_id": "0bd807c8-c1f7-4b6a-8128-520d8c0fa3f2",
                                "sense_id": "9e8897a2-2cb9-3a09-b3ad-6f54b264626c",
                                "text": "„Der Park war eingeschneit, der Ententeich lag wie jeden Winter unter dickem Eis, als eine Frau, die nicht mehr jung war, aber auch noch nicht alt, die Tür des Gartenhauses aufstieß, um sich in letztes Mal auf den Weg durch Götzlack zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "187091c6-ee3c-45af-9421-ee21c943da27",
                        "source_entry_id": "cac5e178-439c-3911-9d79-fa733b6932f4",
