                    {
                        "translation_id": "8ddf6041-1619-4953-8b4c-3d72acf02900",
                        "source_entry_id": "0e4b888e-e3e4-3e6d-998d-8c37557cd4ce",
                        "source_sense_description": "profession de foi chrétienne",
                        "target_lang_word": "creed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "933a3fa6-7b0e-3fc5-812b-b094c92ca772",
                                        "entry_id": "f34929c5-f4fe-3b78-bf9a-722712f22cd9",
                                        "glosses": [
                                            "That which is believed; accepted doctrine, especially religious doctrine; a particular set of beliefs; any summary of principles or opinions professed or adhered to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec7477e-321a-411e-92ef-76536ffe1a60",
                                                "sense_id": "933a3fa6-7b0e-3fc5-812b-b094c92ca772",
                                                "text": "Oh! who young Leila's glance could read / And keep that portion of his creed / Which saith, that woman is but dust, / A soulless toy for tyrant's lust?"
                                            },
                                            {
                                                "example_id": "bd3fe2de-b1aa-4124-9bb0-466e50667326",
                                                "sense_id": "933a3fa6-7b0e-3fc5-812b-b094c92ca772",
                                                "text": "Man, being the child of imitation, has a general tendency in life and in religion to follow the creed and tastes of his fathers, whether in the ways of wisdom or folly—perhaps more readily in the latter."
                                            },
                                            {
                                                "example_id": "e2091881-d071-4a40-8af2-386ac92ed7b8",
                                                "sense_id": "933a3fa6-7b0e-3fc5-812b-b094c92ca772",
                                                "text": "For three successive years, thereafter, as the anniversary of the War [i.e., World War I] came round, equally large assemblies of British subjects of all races and creeds came together in the [Victoria] Theatre to reaffirm the resolution to carry on the war to a victorious end, until at last, after many vicissitudes, victory was secured to the Allies."
                                            },
                                            {
                                                "example_id": "d52b0541-3825-4b73-b548-5582348fe7fd",
                                                "sense_id": "933a3fa6-7b0e-3fc5-812b-b094c92ca772",
                                                "text": "He killed our tribes he killed our creed. / He took our game for his own need"
                                            },
                                            {
                                                "example_id": "31482b8a-185f-44af-a433-2e0513604332",
                                                "sense_id": "933a3fa6-7b0e-3fc5-812b-b094c92ca772",
                                                "text": "Pakistan is a conservative, religious state. The Edhi Foundation is unusual in its ignoring of caste, creed, religion and sect. This strict stance has led to some criticism from religious groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42472e7b-15f6-3ef0-8942-ce4048e3adad",
                                        "entry_id": "f34929c5-f4fe-3b78-bf9a-722712f22cd9",
                                        "glosses": [
                                            "A reading or statement of belief that summarizes the faith it represents; a confession of faith for public use, especially one which is brief and comprehensive."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1236d7ba-adcb-4f88-8da7-89211d35f0ea",
                                                "sense_id": "42472e7b-15f6-3ef0-8942-ce4048e3adad",
                                                "text": "A creed is a manifesto of religious or spiritual beliefs"
                                            },
                                            {
                                                "example_id": "1308c953-e2a5-488d-9907-1bdc30afe988",
                                                "sense_id": "42472e7b-15f6-3ef0-8942-ce4048e3adad",
                                                "text": "[N]ow ſuch a liue vngodly, vvithout a care of doing the wil of the Lord (though they profeſſe him in their mouths, yea though they beleeue and acknowledge all the Articles of the Creed, yea haue knowledge of the Scripturs) yet if they liue vngodly, they deny God, and therefore ſhal be denied, […]"
                                            },
                                            {
                                                "example_id": "c28dfb4e-ee7d-4255-94b2-2bc9f933b670",
                                                "sense_id": "42472e7b-15f6-3ef0-8942-ce4048e3adad",
                                                "text": "The Apostles' Creed was not the only creed to come into existence in the period of the early church. However, it is the oldest and simplest creed of the church. All Christian traditions recognize its authority and its importance as a standard of doctrine. To study the Apostles' Creed is to investigate a central element of our common Christian heritage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bdf3ff6-7f77-325e-9f09-b25f3f10e398",
                                        "entry_id": "f34929c5-f4fe-3b78-bf9a-722712f22cd9",
                                        "glosses": [
                                            "The fact of believing; belief, faith."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bfa07cf-b0ae-4e47-9c77-88970c780d34",
                                                "sense_id": "5bdf3ff6-7f77-325e-9f09-b25f3f10e398",
                                                "text": "Oh love! how perfect is thy mystic art, / Strengthening the weak, and trampling on the strong, / How self-deceitful is the sagest part / Of mortals whom thy lure hath led along— / The precipice she stood on was immense, / So was her creed in her own innocence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "creed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ff8f5c-bb3d-3def-bce9-dd49f49b61ce",
                                        "entry_id": "b69f63bf-1ba4-3046-baa2-ff32d46fda0e",
                                        "glosses": [
                                            "To believe; to credit."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f760330b-c801-4b1a-9331-a91f04519498",
                                                "sense_id": "93ff8f5c-bb3d-3def-bce9-dd49f49b61ce",
                                                "text": "Only this I marvelled, and other men have since, whenas I, in a ſubject ſo new to this age, and ſo hazardous to pleaſe, concealed not my name, why this author, defending that part which is ſo creeded by the people, would conceal his."
                                            },
                                            {
                                                "example_id": "a283028b-dce4-442e-a92a-91f50b31cbe5",
                                                "sense_id": "93ff8f5c-bb3d-3def-bce9-dd49f49b61ce",
                                                "text": "And ſo, no doubt, were his other Preferments as acceptable, which did require ſuch Athanaſsian Subſcriptions, &c. and which he in an Athanaſian Form ſubſcrib'd, creeded, and worſhip'd for till his dying-day."
                                            },
                                            {
                                                "example_id": "80521df7-f3bb-4658-92a2-963bac333349",
                                                "sense_id": "93ff8f5c-bb3d-3def-bce9-dd49f49b61ce",
                                                "text": "'I was n't for creeding me awn e'en,' believing my own eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee730dc0-296b-3fea-b78e-a082ec05b9bc",
                                        "entry_id": "b69f63bf-1ba4-3046-baa2-ff32d46fda0e",
                                        "glosses": [
                                            "To provide with a creed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd67c487-88e9-4dc1-802e-99c086b0cb20",
                                                "sense_id": "ee730dc0-296b-3fea-b78e-a082ec05b9bc",
                                                "text": "The poor like Priests—Priests utilise the poor; / High Church the common people feeding / Exclaims—\"You Low Church indolents observe / How we go about leavening and creeding!\""
                                            },
                                            {
                                                "example_id": "593afba4-6d14-4cf6-b2b5-912502ccc3e3",
                                                "sense_id": "ee730dc0-296b-3fea-b78e-a082ec05b9bc",
                                                "text": "Especially in the studies of religions less creeded than Christianity scholars have long insisted on the importance in religion of sacred stories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
