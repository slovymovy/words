                "senses": [
                    {
                        "sense_id": "b15e5a46-b984-377e-8a9d-d9a86e2bb1e1",
                        "entry_id": "fda43abb-d310-3bf2-b45d-04312c8ea577",
                        "glosses": [
                            "истор., советск. наименование органов, ведающих в центре и на местах начальной военной подготовкой трудящихся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376577e5-bb6e-4da9-a417-61a14202507e",
                                "sense_id": "b15e5a46-b984-377e-8a9d-d9a86e2bb1e1",
                                "text": "Начальник районного Всевобуча сидел в чудом уцелевшем кокетливом кресле."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9aa642e-8246-321d-bf06-12bcf958fee6",
                        "entry_id": "fda43abb-d310-3bf2-b45d-04312c8ea577",
                        "glosses": [
                            "истор., советск. подразделение для начальной военной подготовки трудящихся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81ee511-69a6-437a-adca-443f90d04520",
                                "sense_id": "a9aa642e-8246-321d-bf06-12bcf958fee6",
                                "text": "Шляпу крепче нахлобучь да иди во Всевобу́ч."
                            },
                            {
                                "example_id": "d3471c3f-f0bd-4210-9d06-d82184a85c12",
                                "sense_id": "a9aa642e-8246-321d-bf06-12bcf958fee6",
                                "text": "Прикреплённые к заводским дружинам и районным отрядам должны быть на месте, прикреплённые к нашему кружку Всевобуча должны будут выделить дежурных по клубу и быть на месте, как только будет дан приказ."
                            }
                        ]
                    }
