                    },
                    {
                        "translation_id": "292078a9-332f-44a8-8731-124cb9c7ff2f",
                        "source_entry_id": "f6f0687c-3081-3cfc-bc96-edd495e6de2d",
                        "source_sense_id": "f6e8ad16-0e44-36db-9fe9-6db01e5a86c0",
                        "source_sense_description": "expression of exasperation",
                        "target_lang_word": "блин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc63addb-9024-37f5-aee1-575c9d4090bf",
                                        "entry_id": "a87cfec7-e6ec-30cc-9ad8-073046ebe054",
                                        "glosses": [
                                            "кулин., гастрон. плоская тонкая лепёшка, испечённая из жидкого теста на сковороде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab81cc4-f061-4651-b3f7-8f4a8185aca3",
                                                "sense_id": "dc63addb-9024-37f5-aee1-575c9d4090bf",
                                                "text": "Что делать, если уже далеко не первый, а десятый блин продолжает прилипать к сковородке и выходит натуральным комом?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78f7125-e916-3a58-a687-553a0db82ee5",
                                        "entry_id": "a87cfec7-e6ec-30cc-9ad8-073046ebe054",
                                        "glosses": [
                                            "перен. плоский круглый предмет; диск"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dfa9ab7-b720-47c5-a251-d78c46e61623",
                                                "sense_id": "b78f7125-e916-3a58-a687-553a0db82ee5",
                                                "text": "Штангист установил на штангу дополнительные блины."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "блин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "137bd8ea-fb5d-3d2d-9ddf-9ab7013ebec7",
                                        "entry_id": "b6e218fc-7e75-30a7-9be8-a846ae0ca35f",
                                        "glosses": [
                                            "эвф. то же, что блядь;"
                                        ],
                                        "tags": [
                                            "выражает любую сильную эмоцию"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a31834-81db-48cd-861b-cb332fc6bfe0",
                                                "sense_id": "137bd8ea-fb5d-3d2d-9ddf-9ab7013ebec7",
                                                "text": "Где-где, в автосалоне. Шутник, блин. Тарапунька и Штепсель."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b508e16-8847-4ef7-8b0c-ee69ac15ba40",
                        "source_entry_id": "f6f0687c-3081-3cfc-bc96-edd495e6de2d",
                        "source_sense_id": "f6e8ad16-0e44-36db-9fe9-6db01e5a86c0",
                        "source_sense_description": "expression of exasperation",
                        "target_lang_word": "чёрт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чёрт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b6ef09-8ee3-3293-9e45-f3efbcd5fda2",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "мифол., религ., : злой дух низкого ранга, адское зловредное существо с рогами, хвостом и копытами на ногах"
                                        ],
                                        "tags": [
                                            "в ряде верований"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce59da4d-8f71-41cf-b6a5-8b9d725507ad",
                                                "sense_id": "c8b6ef09-8ee3-3293-9e45-f3efbcd5fda2",
                                                "text": "— Нос, мой собственный нос пропал неизвестно куда. Чёрт хотел подшутить надо мною!"
                                            },
                                            {
                                                "example_id": "16cf58fc-22b0-4960-8880-0da1f30a25f6",
                                                "sense_id": "c8b6ef09-8ee3-3293-9e45-f3efbcd5fda2",
                                                "text": "Смотрите в глаза чёрту прямо, и если он чёрт, то и говорите, что это чёрт, а не лезьте к Канту или к Гегелю за объяснениями."
                                            },
                                            {
                                                "example_id": "bff5051a-34a4-4dfd-8d0a-388f044a6450",
                                                "sense_id": "c8b6ef09-8ee3-3293-9e45-f3efbcd5fda2",
                                                "text": "Солдаты фыркали в кулак, а между тем со своими домовыми они были так же наивны, как и Дерсу со своим чёртом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b48f4a8f-d6a7-3872-b699-3e9e32d7ef37",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "ед. ч., : то же, что сатана, дьявол; может писаться с прописной, как имя собственное"
                                        ],
                                        "tags": [
                                            "в авраамических религиях"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cda4054-45db-43f3-9738-e96a4e50974d",
                                                "sense_id": "b48f4a8f-d6a7-3872-b699-3e9e32d7ef37",
                                                "text": "Дербентцы судят свой город с гораздо большею справедливостью: они говорят, что их город построен чёртом."
                                            },
                                            {
                                                "example_id": "ab5071d0-d37d-4e4c-b730-df120be33f25",
                                                "sense_id": "b48f4a8f-d6a7-3872-b699-3e9e32d7ef37",
                                                "text": "Содержание сказки такое: когда Господь создал прародителей, чёрт создал из того же материала волка, но оживить не умел: как ни дул в него до изнеможения, ничего не сделал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "перен., прост. используется в качестве ругательства (обычно беззлобного) в отношении того, с кем или чем трудно совладать: о норовистом животном, упрямом или непонятливом человеке и т. д.; тж. в качестве самоиронии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59abd5e9-3e37-472c-bbf0-9475facd5dd4",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "Ружьём учиться тебе не советую: ты малый молодой, нежного воспитания — тебе вертеть этаким чёртом фунтов в пятнадцать!.. Да и зачем? Ведь ты не солдатский сын."
                                            },
                                            {
                                                "example_id": "97cf8a53-cd02-450e-a439-a95fc20a4982",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "Жаль, что Ио́хим не́ дал напрокат кареты, а хорошо бы, чёрт побери, приехать домой в карете, подкатить этаким чёртом к какому-нибудь соседу-помещику под крыльцо, с фонарями, а Осипа сзади, одеть в ливрею."
                                            },
                                            {
                                                "example_id": "72852931-6bd2-4edf-ad1d-6953cf104069",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "Аксютка переменил тон. Он стал ругаться: — Цепка, чёрт, дай же хлеба! Жалко, что ли, тебе куска какого-нибудь?"
                                            },
                                            {
                                                "example_id": "d2a0fd74-2b0d-41f2-8f75-3b2971f790b5",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "— А слышь, Лука, опять нас в секрет пошлёт чёрт-то, — прибавил он, поднимая фазана и под чёртом разумея урядника."
                                            },
                                            {
                                                "example_id": "932d3ac1-8625-4a11-b02d-c96079372e7d",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "Муж называл жену «ведьмою» и «чёртом», жена называла мужа — «ветряною мельницей» и «бесструнной балалайкой»."
                                            },
                                            {
                                                "example_id": "dc971439-b8c9-49ca-a793-ec22fe058c0b",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "А ты ходишь этаким чёртом без валенок, в одних портках, и дышишь."
                                            },
                                            {
                                                "example_id": "5d72ccdd-ef42-413b-ab52-de7c3355d41e",
                                                "sense_id": "ee7f1f8b-ea0f-3913-b3ed-78cc2442bb04",
                                                "text": "— Разве я с ним, с таким чёртом, справлюсь?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "533726ef-9399-368d-a74c-2d9cb4d862b4",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "перен., разг.-сниж. о том, кто обнаруживает, проявляет умение, силу, сноровку, ловкость и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba12572-1bad-4e6e-9938-e1d70f5ffa1c",
                                                "sense_id": "533726ef-9399-368d-a74c-2d9cb4d862b4",
                                                "text": "В своём деле он просто чёрт!"
                                            },
                                            {
                                                "example_id": "7a15a13b-ba8f-4646-8afd-6011b9fcaf74",
                                                "sense_id": "533726ef-9399-368d-a74c-2d9cb4d862b4",
                                                "text": "Здорово рисует, чёрт!"
                                            },
                                            {
                                                "example_id": "0be70d07-bcdf-4f9d-8ec4-1be9c7b3d0b9",
                                                "sense_id": "533726ef-9399-368d-a74c-2d9cb4d862b4",
                                                "text": "Чу́дное ожерелье, умеют же делать, черти!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95973808-a989-35c2-9ee6-112758e65535",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "перен., прост., : чёртом: лихо, молодцевато"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5db24d4d-75f4-4d8a-9590-a746c886a0b9",
                                                "sense_id": "95973808-a989-35c2-9ee6-112758e65535",
                                                "text": "Сам себя атаманом называл; да он же и мне тогда чёртом на шею вскочил."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eabff27e-5afd-3087-9bfd-f0e9bf593b89",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "сокращение от чёрт возьми! или чёрт побери!, чёрт подери!"
                                        ],
                                        "tags": [
                                            "в роли междометия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e462eedb-1fba-4509-bb44-8f6e42493007",
                                                "sense_id": "eabff27e-5afd-3087-9bfd-f0e9bf593b89",
                                                "text": "Потом глянул на часы. Чёрт! Оказывается, я уже двенадцать минут дома."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b58734-be90-3514-9b30-8eb22b346356",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "крим. жарг. то же, что чёрт мутной воды; фраер, выдающий себя за блатного"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fabd17b4-aea8-3477-89fe-211a1df7d24d",
                                        "entry_id": "0b596f12-2f25-3242-8e91-7f3f920ae462",
                                        "glosses": [
                                            "крим. жарг. работник правоохранительных органов"
                                        ],
