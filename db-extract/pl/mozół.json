                "translations": [
                    {
                        "translation_id": "2cf6381e-3c6c-425f-ba99-17f1a7031955",
                        "source_entry_id": "249731c6-b47a-3849-9e2b-ea33069c778e",
                        "source_sense_id": "d548b2ba-6d2d-347e-8269-ad6f5fa15c63",
                        "target_lang_word": "toil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd11e06c-7010-3941-b35c-6897bb5847c0",
                                        "entry_id": "4168530d-27e1-3b1f-8e37-627404f0980e",
                                        "glosses": [
                                            "Labour, work, especially of a grueling nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b1b8c1-6a0b-422c-80c1-65ab3f93e173",
                                                "sense_id": "bd11e06c-7010-3941-b35c-6897bb5847c0",
                                                "text": "[…] he set to work again and made the snow fly in all directions around him. After some further toil his efforts were rewarded, and a very shabby door-mat lay exposed to view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470a89ec-3146-3cf5-90f7-dedc78f15674",
                                        "entry_id": "4168530d-27e1-3b1f-8e37-627404f0980e",
                                        "glosses": [
                                            "Trouble, strife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                        "entry_id": "4168530d-27e1-3b1f-8e37-627404f0980e",
                                        "glosses": [
                                            "A net or snare; any thread, web, or string spread for taking prey."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "549fbc00-ec9f-4de4-b8aa-e8d763f9d39f",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "Then toils for beasts, and lime for birds, were found."
                                            },
                                            {
                                                "example_id": "d75a8840-160f-4a4b-8bc8-00b4fe7c98b0",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "I was like a wild beast that had broken the toils, destroying the objects that obstructed me and ranging through the wood with a stag-like swiftness."
                                            },
                                            {
                                                "example_id": "b3c10d57-b630-41f0-9ed1-adbf37b5ea72",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "That I was going to sit still, and let you sulk, while mademoiselle walked blindfold into the toils?"
                                            },
                                            {
                                                "example_id": "ce45d6d8-e2e4-4821-9537-a9c4d5623e3d",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "She had waited overlong, and now it was like that Ailie would escape her toils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0a7a53-56a3-39fe-9835-541d0ea9f4cf",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To labour; work."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "638b5d34-706d-3dc0-860c-98398bf9e418",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To struggle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2497641-b18d-352b-84e5-a19a1fb0d6c3",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To work (something); often with out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc3d81d-91be-4485-9944-4f9a3d15ac9a",
                                                "sense_id": "a2497641-b18d-352b-84e5-a19a1fb0d6c3",
                                                "text": "places well toiled and husbanded"
                                            },
                                            {
                                                "example_id": "9d5fcecd-b146-4d53-ac8b-3592612d1be4",
                                                "sense_id": "a2497641-b18d-352b-84e5-a19a1fb0d6c3",
                                                "text": "[I] toiled out my uncouth passage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06bc1a5d-cb8c-33a1-a7a0-ded6990ff11c",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To weary through excessive labour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53448ee9-dd10-49f6-b3f3-e44722a5c268",
                                                "sense_id": "06bc1a5d-cb8c-33a1-a7a0-ded6990ff11c",
                                                "text": "toiled with works of war"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c5bb2a2-d0cc-4025-ad64-209a3e6c5790",
                        "source_entry_id": "249731c6-b47a-3849-9e2b-ea33069c778e",
                        "source_sense_id": "d548b2ba-6d2d-347e-8269-ad6f5fa15c63",
                        "target_lang_word": "Mühe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mühe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                        "entry_id": "1284be3e-709c-3116-9fff-895ba9322401",
                                        "glosses": [
                                            "körperliche oder geistige Anstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62147a17-1767-4a83-ba50-003688c8cbbc",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "Sie erledigte ihre Aufgabe mit viel Mühe und es war dennoch zu wenig."
                                            },
                                            {
                                                "example_id": "b743ade3-f0f7-4525-ac27-ec1b1f13ec7a",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "Mit viel Mühe fanden sie den richtigen Weg."
                                            },
                                            {
                                                "example_id": "fba9e893-eb83-4fa1-b566-a2dc02670276",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "Vielen Dank für deine Mühen."
                                            },
                                            {
                                                "example_id": "5100fc46-462d-433a-864b-e758f0c38dab",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "„[Der Entwickler Michael] Stapelberg [schreibt], dass technische Veränderungen in Debian nur sehr langsam und mit großer Mühe umsetzbar seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mühe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                        "entry_id": "80290248-517b-3144-af58-7d465277a65f",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5429fbff-aee4-4d0b-8292-7e0cdde26737",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Herr Mühe war mir vom ersten Moment an sympathisch."
                                            },
                                            {
                                                "example_id": "80cf710e-2acd-40e8-8c30-7b413e5cb567",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Frau Mühe ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "93301224-4850-4fa1-9222-8c7c127e95d7",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Herr Mühe wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "559c500d-56c0-4a62-bd2f-3a13c05bfee0",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Die Mühes fliegen heute nach Boston."
                                            },
                                            {
                                                "example_id": "1d5af4c1-e775-4587-b849-6894a4db85a8",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Der Mühe trägt nie die Pullover, die die Mühe ihm strickt."
                                            },
                                            {
                                                "example_id": "94955646-9824-41f0-912b-912d3e535161",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mühe kommt, geht der Herr Mühe.“"
                                            },
                                            {
                                                "example_id": "953f27b6-f831-45d6-95a7-875af045b62e",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Mühe kommt und geht."
                                            },
                                            {
                                                "example_id": "9dd201ee-8f68-4b68-8434-0a2cba34716f",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Mühes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52492750-8b53-424e-b8f9-1315a9cada7e",
                        "source_entry_id": "249731c6-b47a-3849-9e2b-ea33069c778e",
                        "source_sense_id": "d548b2ba-6d2d-347e-8269-ad6f5fa15c63",
                        "target_lang_word": "Mühsal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mühsal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66b6ef25-dbd5-38d4-8f87-3428a5c89b4d",
                                        "entry_id": "28f1e5bd-2c55-3285-82b6-e47d7a9c0652",
                                        "glosses": [
                                            "große Anstrengung, die mit der Durchführung einer Tat verbunden ist"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef0ca89-478a-469b-b45e-0f18640d5c48",
                                                "sense_id": "66b6ef25-dbd5-38d4-8f87-3428a5c89b4d",
                                                "text": "Die Heuernte einzufahren, ist die reinste Mühsal gewesen."
                                            },
                                            {
                                                "example_id": "a1314ca0-50f7-4795-ba4c-57060b6ee59f",
                                                "sense_id": "66b6ef25-dbd5-38d4-8f87-3428a5c89b4d",
                                                "text": "„Ihr Enthusiasmus ward bald Chimäre und Fanatismus: er endigte in Thorheit und tadelnswürdige Verbindung; denn das Gute als solches muß sich in einem wirklichen Gegenstände einigen, sich mit diesem und mit Kenntnissen, oft scheinbar oberflächlichen, durchdringen, das Mühsal vielfältiger Arbeit, die Langeweile lästiger Kleinigkeiten nicht scheuen, um das Gute zu bleiben und als Nützliches hervorzutreten.“"
                                            },
                                            {
                                                "example_id": "f8a4fb31-7277-451d-93a9-a56482de2226",
                                                "sense_id": "66b6ef25-dbd5-38d4-8f87-3428a5c89b4d",
                                                "text": "„Nun sag' ich Dir es nicht schon längst? Doch Du hast dumpfe Ohren,\n Es verheißet mein Gebieter Euch, es sollt hinfort Ihr Alle,\n Der Armuth und des Mühsals quitt, ein frohes Leben führen.“"
                                            },
                                            {
                                                "example_id": "bb34bb5e-7133-498d-b753-a8c0a4c242e0",
                                                "sense_id": "66b6ef25-dbd5-38d4-8f87-3428a5c89b4d",
                                                "text": "Mit unendlicher Mühsal gelang es uns schließlich, den Stein den Berg hinaufzurollen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
