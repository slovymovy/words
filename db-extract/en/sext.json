                ],
                "senses": [
                    {
                        "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                        "entry_id": "708a06f4-e3fe-30cf-a953-28729481604d",
                        "glosses": [
                            "To send a sext."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "10f76e88-e2f2-4a9d-8a50-7a02baa90d53",
                                "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                                "text": "Rebecca Loos claimed she was 'sexted' by Beckham"
                            },
                            {
                                "example_id": "22afb36c-521c-43e9-a540-3aab6f0c9871",
                                "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                                "text": "[…] trying to get into the swing of things by texting my husband (I was a little tipsy, I will admit): \"How do you sext someone?\" hoping to engage in the latest trend. All I got was, \"What!\" in reply."
                            },
                            {
                                "example_id": "14f434d8-2f9b-42d2-a54a-a98b458a9d15",
                                "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                                "text": "The next day, Greg sexted me a few pictures of his package."
                            },
                            {
                                "example_id": "09e72dc0-b8a5-477e-b934-f53d1eee1c77",
                                "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                                "text": "We would talk on the phone for hours and then text and sext the rest of the day."
                            },
                            {
                                "example_id": "7f90a887-19e3-4ed1-bf4b-2ebcf4d47c40",
                                "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                                "text": "Sexting sonnets / Under the tables"
                            },
                            {
                                "example_id": "f9a6c261-ee35-43bd-8c33-dba6e6dfe566",
                                "sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
                                "text": "She describes her content as “Valentine’s Day style” and says that for people who have grown up sexting friends, posting bikini shots of themselves on Instagram and becoming influencers, OnlyFans can feel like a “natural progression”."
                            }
                        ]
                    }
                ],
