            "senses": [
                {
                    "sense_id": "b27858f1-ec6a-3001-9ba7-42511d52db4b",
                    "sense_definition": "Refusing to change one's mind or to be persuaded; stubborn or inflexible.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stubbornness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager remained <w>unyielding</w> in his decision to reject the new proposal.",
                            "target_lang_translations": {
                                "ru": "Управляющий остался <w>непреклонен</w> в своем решении отклонить новое предложение."
                            }
                        },
                        {
                            "text": "Despite the intense pressure from the public, the politician stayed <w>unyielding</w> on the issue.",
                            "target_lang_translations": {
                                "ru": "Несмотря на сильное давление со стороны общественности, политик остался <w>непреклонным</w> в этом вопросе."
                            }
                        }
                    ],
                    "synonyms": [
                        "stubborn",
                        "inflexible",
                        "obstinate",
                        "unbending",
                        "uncompromising"
                    ],
                    "common_phrases": [
                        "unyielding support",
                        "unyielding pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказывающийся менять свое мнение или уступать; упрямый, непреклонный или несгибаемый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непреклонный",
                                "target_lang_sense_clarification": "о человеке, позиции или решении, не поддающемся уговорам"
                            },
                            {
                                "target_lang_word": "несгибаемый",
                                "target_lang_sense_clarification": "обладающий твердой волей, не отступающий перед трудностями"
                            },
                            {
                                "target_lang_word": "неуступчивый",
                                "target_lang_sense_clarification": "склонный стоять на своем, не идущий на компромиссы"
                            },
                            {
                                "target_lang_word": "бескомпромиссный",
                                "target_lang_sense_clarification": "отвергающий компромиссы, жестко держащийся своей позиции"
                            }
                        ]
