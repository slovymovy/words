                        "entry_id": "49648e95-99f5-369c-add5-6987a48f88ee",
                        "glosses": [
                            "vrouwelijke leraar die op de basisschool zorg draagt voor de gymnastieklessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85beb332-a551-45f1-8bd6-8cad73b7e45f",
                                "sense_id": "1142f617-d5e6-3262-9280-b6f0904442ec",
                                "text": "Deze gediplomeerde gymjuf of –meester is verantwoordelijk voor de organisatie en coördinatie van het sportaanbod tijdens en na schooltijd."
                            },
                            {
                                "example_id": "43023618-22d1-49ad-b2c9-90ba36a9a8d5",
                                "sense_id": "1142f617-d5e6-3262-9280-b6f0904442ec",
                                "text": "Op een school voor speciaal onderwijs kregen de leerlingen nooit voetbal tijdens de gymles. Dat deed de gymjuf niet."
                            },
                            {
                                "example_id": "beff33e3-0c9e-435e-b968-d2bb217e575e",
                                "sense_id": "1142f617-d5e6-3262-9280-b6f0904442ec",
                                "text": "De hordenloopster wil fulltime sporten en niet aan haar portemonnee verplicht zijn een baan te hebben. Ze hoopt bij de WK indoor in Istanbul over twee weken haar A-status te verwerven, waarna ze eindelijk haar baan als gymjuf op een basisschool in IJmuiden kan opzeggen."
                            }
                        ]
                    }
