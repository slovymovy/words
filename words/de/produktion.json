                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Produktion</w> der neuen Elektroautos beginnt im nächsten Monat im Hauptwerk."
                        },
                        {
                            "text": "Wegen des Streiks musste die gesamte <w>Produktion</w> für mehrere Tage unterbrochen werden."
                        }
                    ],
                    "synonyms": [
