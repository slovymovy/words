    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc4463bc-eead-345a-a87e-5c3283297832",
                    "sense_definition": "Een stuk speelgoed, meestal kegelvormig, dat men snel om zijn as laat draaien en dat op een punt balanceert",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "toy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen speelden buiten met een houten <w>tol</w>.",
                            "target_lang_translations": {
                                "en": "The children played outside with a wooden <w>spinning top</w>.",
                                "ru": "Дети играли на улице с деревянным <w>волчком</w>."
                            }
                        },
                        {
                            "text": "Hij liet de <w>tol</w> zo hard draaien dat hij over de tafel zoemde.",
                            "target_lang_translations": {
                                "en": "He spun the <w>top</w> so fast that it buzzed across the table.",
                                "ru": "Он так сильно раскрутил <w>волчок</w>, что тот зажужжал по столу."
                            }
                        }
                    ],
                    "synonyms": [
                        "draaitol"
                    ],
                    "common_phrases": [
                        "een draaiende tol",
                        "met een tol spelen"
                    ],
                    "target_lang_definitions": {
                        "en": "A toy, usually cone-shaped, that is made to spin rapidly on its axis and balances on a point.",
                        "ru": "Игрушка, обычно конусообразной формы, которая быстро вращается вокруг своей оси и балансирует на острие"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spinning top",
                                "target_lang_sense_clarification": "toy"
                            },
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "toy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "волчок",
                                "target_lang_sense_clarification": "игрушка"
                            },
                            {
                                "target_lang_word": "юла",
                                "target_lang_sense_clarification": "игрушка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f68486f-7d82-3194-8393-e2c4de9f1b60",
                    "sense_definition": "Geld dat betaald moet worden voor het gebruik van bepaalde wegen, bruggen of tunnels",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moesten vijf euro <w>tol</w> betalen om door de tunnel te mogen rijden.",
                            "target_lang_translations": {
                                "en": "We had to pay five euros <w>toll</w> to be allowed to drive through the tunnel.",
                                "ru": "Нам пришлось заплатить пять евро <w>дорожного сбора</w>, чтобы проехать через туннель."
                            }
                        },
                        {
                            "text": "In Frankrijk moet je op veel snelwegen <w>tol</w> betalen.",
                            "target_lang_translations": {
                                "en": "In France, you have to pay <w>toll</w> on many highways.",
                                "ru": "Во Франции на многих автомагистралях нужно платить <w>пошлину</w> за проезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolgeld"
                    ],
                    "common_phrases": [
                        "tol betalen",
                        "tol heffen"
                    ],
                    "target_lang_definitions": {
                        "en": "Money that must be paid for the use of certain roads, bridges, or tunnels.",
                        "ru": "Плата за пользование определенными дорогами, мостами или туннелями"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "toll",
                                "target_lang_sense_clarification": "fee for road use"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дорожный сбор",
                                "target_lang_sense_clarification": "плата за проезд"
                            },
                            {
                                "target_lang_word": "пошлина",
                                "target_lang_sense_clarification": "плата за пользование инфраструктурой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb2e44de-a141-3307-832d-019127ad60ae",
                    "sense_definition": "Een zware prijs, verlies of nadelig gevolg dat door een bepaalde situatie wordt veroorzaakt",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jaren van zwaar werk eisen nu hun <w>tol</w> op zijn gezondheid.",
                            "target_lang_translations": {
                                "en": "The years of hard work are now taking their <w>toll</w> on his health.",
                                "ru": "Годы тяжелой работы теперь собирают свою <w>дань</w> с его здоровья."
                            }
                        },
                        {
                            "text": "De oorlog eiste een zware <w>tol</w> van de burgerbevolking.",
                            "target_lang_translations": {
                                "en": "The war took a heavy <w>toll</w> on the civilian population.",
                                "ru": "Война наложила тяжелый <w>отпечаток</w> на гражданское население."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zijn tol eisen",
                        "een zware tol"
                    ],
                    "target_lang_definitions": {
                        "en": "A heavy price, loss, or negative consequence caused by a particular situation.",
                        "ru": "Тяжелая цена, потеря или негативное последствие, вызванное определенной ситуацией"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "toll",
                                "target_lang_sense_clarification": "adverse consequence or burden"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "в переносном смысле, негативные последствия"
                            },
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "негативное влияние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a75c4c49-3274-3a39-bb53-26d242edaa7f",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>tollen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>tol</w> op mijn benen van de duizeligheid.",
                            "target_lang_translations": {
                                "en": "I <w>reel</w> on my legs from dizziness.",
                                "ru": "Я <w>шатаюсь</w> на ногах от головокружения."
                            }
                        },
                        {
                            "text": "Als ik te snel opsta, <w>tol</w> ik even en moet ik gaan zitten.",
                            "target_lang_translations": {
                                "en": "If I stand up too quickly, I <w>spin</w> for a moment and have to sit down.",
                                "ru": "Если я слишком быстро встаю, у меня на мгновение <w>кружится</w> голова, и мне приходится сесть."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of <w>tollen</w> (to spin, to reel).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола 'tollen' (кружиться, шататься)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reel",
                                "target_lang_sense_clarification": "to stagger or feel dizzy"
                            },
                            {
                                "target_lang_word": "spin",
                                "target_lang_sense_clarification": "to turn around quickly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кружусь",
                                "target_lang_sense_clarification": "о голове или теле"
                            },
                            {
                                "target_lang_word": "шатаюсь",
                                "target_lang_sense_clarification": "от головокружения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
