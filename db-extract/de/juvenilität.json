                "senses": [
                    {
                        "sense_id": "46bdd2dd-1c0b-31fa-bb76-298ee145aa64",
                        "entry_id": "b382d012-67b4-31e9-a31e-57073a0c1d36",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße jugendliches, nicht erwachsenes (juveniles) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0e8c70-5319-4862-9cbf-5c388f49c359",
                                "sense_id": "46bdd2dd-1c0b-31fa-bb76-298ee145aa64",
                                "text": "„Allerdings spricht grundsätzlich nichts gegen die Abwendung vom Bild des passiven, senilen alten Menschen und die Orientierung am Leitbild der Juvenilität.“"
                            },
                            {
                                "example_id": "54dadf71-7688-46e2-aa41-557007bb3ab8",
                                "sense_id": "46bdd2dd-1c0b-31fa-bb76-298ee145aa64",
                                "text": "„Die jugendliche Begeisterung erfüllt die meisten seiner Schriften, und Gervinus hat aus dieser ‚Juvenilität‘ ganz meisterhaft den Gesamtcharakter seiner Dichtung entwickelt.“ (1904)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
