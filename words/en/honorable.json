{
    "word_family": [
        "honor",
        "honorary",
        "honorably",
        "honoree",
        "honorarium"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bbe01ac-d6a1-3a75-990c-30c8d1350e60",
                    "sense_definition": "Behaving in a manner that shows honor; decent, having integrity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is an <w>honorable</w> man who always keeps his promises to his family.",
                            "target_lang_translations": {
                                "ru": "Он <w>благородный</w> человек, который всегда сдерживает обещания, данные семье.",
                                "zh": "他是一个<w>高尚</w>的人，总是信守对家人的承诺。"
                            }
                        },
                        {
                            "text": "It was not an <w>honorable</w> thing to lie to your friends about the accident.",
                            "target_lang_translations": {
                                "ru": "Лгать друзьям о происшествии было <w>непорядочным</w> поступком.",
                                "zh": "因为事故的事对朋友撒谎，这并不是一件<w>体面</w>的事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "noble"
                    ],
                    "antonyms": [
                        "contemptible",
                        "despicable",
                        "mean"
                    ],
                    "common_phrases": [
                        "honorable man",
                        "honorable intentions",
                        "honorable conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий высокими моральными качествами; честный, имеющий принципы.",
                        "zh": "指行为表现出荣誉感；正直、有诚信。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "высокоморальный, великодушный"
                            },
                            {
                                "target_lang_word": "порядочный",
                                "target_lang_sense_clarification": "честный, неспособный на низкие поступки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高尚",
                                "target_lang_sense_clarification": "道德品质高尚"
                            },
                            {
                                "target_lang_word": "正派",
                                "target_lang_sense_clarification": "为人正直、诚实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b9e50ed-5ea8-3245-8eed-8e722957af48",
                    "sense_definition": "Worthy of respect; respectable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teaching is widely considered an <w>honorable</w> profession that benefits society.",
                            "target_lang_translations": {
                                "ru": "Преподавание широко считается <w>почётной</w> профессией, приносящей пользу обществу.",
                                "zh": "教师被广泛认为是一项造福社会的<w>光荣</w>职业。"
                            }
                        },
                        {
                            "text": "After twenty years in the army, he received an <w>honorable</w> discharge.",
                            "target_lang_translations": {
                                "ru": "После двадцати лет службы в армии он получил <w>почётную</w> отставку.",
                                "zh": "在军队服役二十年后，他获得了<w>光荣</w>退伍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "venerable"
                    ],
                    "common_phrases": [
                        "honorable profession",
                        "honorable mention",
                        "honorable discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий уважения и почёта.",
                        "zh": "值得尊敬的；体面的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почётный",
                                "target_lang_sense_clarification": "выражающий или оказывающий почёт"
                            },
                            {
                                "target_lang_word": "уважаемый",
                                "target_lang_sense_clarification": "пользующийся уважением"
                            },
                            {
                                "target_lang_word": "достойный",
                                "target_lang_sense_clarification": "заслуживающий признания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光荣",
                                "target_lang_sense_clarification": "值得尊敬的"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "受人尊重的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f03f850-6191-3864-989b-a5824b33648a",
                    "sense_definition": "Complying with cultural rules regarding honor; not provoking shame or disgrace.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two knights engaged in <w>honorable</w> combat to settle their dispute.",
                            "target_lang_translations": {
                                "ru": "Два рыцаря вступили в <w>честный</w> бой, чтобы разрешить свой спор.",
                                "zh": "两位骑士进行了<w>正当</w>的决斗以解决他们的争端。"
                            }
                        },
                        {
                            "text": "They managed to reach an <w>honorable</w> peace after years of conflict.",
                            "target_lang_translations": {
                                "ru": "Им удалось заключить <w>достойный</w> мир после многих лет конфликта.",
                                "zh": "经过多年的冲突，他们最终达成了<w>体面</w>的和平。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "honorable combat",
                        "honorable peace",
                        "honorable defeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий правилам чести; не вызывающий стыда или позора.",
                        "zh": "符合荣誉准则的；不丢脸或不蒙羞的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "справедливый, по правилам"
                            },
                            {
                                "target_lang_word": "достойный",
                                "target_lang_sense_clarification": "приемлемый, не унизительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正当",
                                "target_lang_sense_clarification": "合乎情理或规则的"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "不失尊严的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62e3d100-424a-3f10-ab43-08b117a2e45b",
                    "sense_definition": "A courtesy title given to certain government officials, judges, or politicians.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Honorable</w> Jane Doe presided over the court session this morning.",
                            "target_lang_translations": {
                                "ru": "<w>Достопочтенная</w> Джейн Доу председательствовала на утреннем заседании суда.",
                                "zh": "<w>尊敬的</w>简·多伊法官今天上午主持了庭审。"
                            }
                        },
                        {
                            "text": "We are pleased to welcome the <w>honorable</w> member of parliament to our school.",
                            "target_lang_translations": {
                                "ru": "Мы рады приветствовать <w>достопочтенного</w> члена парламента в нашей школе.",
                                "zh": "我们很高兴欢迎<w>尊敬的</w>国会议员来到我们学校。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Hon.",
                        "Hon'ble"
                    ],
                    "common_phrases": [
                        "the honorable member",
                        "the honorable judge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул вежливости, присваиваемый определенным государственным чиновникам или судьям.",
                        "zh": "对政府官员、法官或政客使用的尊称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достопочтенный",
                                "target_lang_sense_clarification": "официальный титул в переводе"
                            },
                            {
                                "target_lang_word": "уважаемый",
                                "target_lang_sense_clarification": "форма вежливого обращения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尊敬的",
                                "target_lang_sense_clarification": "用于正式场合的尊称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a29be87-be8a-3d8c-90b4-445ceaa21bbc",
                    "sense_definition": "A politician or other person who bears the title of \"honorable\".",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor and other <w>honorables</w> gathered for the annual city banquet.",
                            "target_lang_translations": {
                                "ru": "Мэр и другие <w>высокопоставленные лица</w> собрались на ежегодный городской банкет.",
                                "zh": "市长和其他<w>显贵</w>们齐聚一堂，参加年度城市宴会。"
                            }
                        },
                        {
                            "text": "Several local <w>honorables</w> were invited to speak at the opening ceremony.",
                            "target_lang_translations": {
                                "ru": "Несколько местных <w>высокопоставленных лиц</w> были приглашены выступить на церемонии открытия.",
                                "zh": "几位当地的<w>要人</w>受邀在开幕式上发言。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Политик или другое лицо, носящее титул «достопочтенный».",
                        "zh": "拥有“尊敬的”这一头衔的政客或其他人士。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокопоставленное лицо",
                                "target_lang_sense_clarification": "чиновник высокого ранга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显贵",
                                "target_lang_sense_clarification": "地位高贵的人"
                            },
                            {
                                "target_lang_word": "要人",
                                "target_lang_sense_clarification": "重要人物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}