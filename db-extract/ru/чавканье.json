                                        "examples": [
                                            {
                                                "example_id": "4d7aed3b-a9ef-44cc-881a-40f3fcfc54af",
                                                "sense_id": "df7a4889-2837-3655-b2a1-082d09b4cb8d",
                                                "text": "„Wenn er einen Arm oder ein Bein verzehrt hat, wirft der Gehörnte die blanken Knochen in den Käfig des Footballmanns zurück. Sein saftiges Schmatzen und Kauen übertönt sogar das Geschrei der anderen.“"
                                            },
                                            {
                                                "example_id": "a9e91463-3492-4ea0-930a-78af4b24779b",
                                                "sense_id": "df7a4889-2837-3655-b2a1-082d09b4cb8d",
                                                "text": "„Als die Köder nach oben kamen, streifte er sie von den Haken, fuhr hinüber zum anderen Ufer und kappte die Leine. Sie schlingerte mit sanftem Schmatzen ins Wasser und verschwand aus dem Blickfeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
