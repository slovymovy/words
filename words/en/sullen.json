{
    "word_family": [
        "sullenness",
        "sullenly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c84a08bc-265e-3423-8822-71e03e3ad82c",
                    "sense_definition": "Having a brooding ill temper or being sulky.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenager sat in the corner with a <w>sullen</w> expression after the argument.",
                            "target_lang_translations": {
                                "de": "Der Teenager saß nach dem Streit mit einem <w>mürrischen</w> Gesichtsausdruck in der Ecke.",
                                "cs": "Teenager seděl po hádce v koutě s <w>mrzutým</w> výrazem."
                            }
                        },
                        {
                            "text": "He remained <w>sullen</w> and bored throughout the entire meeting.",
                            "target_lang_translations": {
                                "de": "Er blieb während des gesamten Meetings <w>missmutig</w> und gelangweilt.",
                                "cs": "Během celé schůzky zůstal <w>nevrlý</w> a znuděný."
                            }
                        }
                    ],
                    "synonyms": [
                        "sulky",
                        "morose",
                        "moody"
                    ],
                    "antonyms": [
                        "cheerful",
                        "content",
                        "lighthearted",
                        "pleased"
                    ],
                    "common_phrases": [
                        "sullen expression",
                        "sullen mood"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine mürrische, schlecht gelaunte oder verschlossene Art habend.",
                        "cs": "Mít mrzutou, špatnou náladu nebo být uraženě mlčenlivý."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mürrisch",
                                "target_lang_sense_clarification": "beschreibt eine Person, die schlecht gelaunt und abweisend wirkt"
                            },
                            {
                                "target_lang_word": "missmutig",
                                "target_lang_sense_clarification": "drückt eine anhaltende schlechte Stimmung aus"
                            },
                            {
                                "target_lang_word": "übellaunig",
                                "target_lang_sense_clarification": "bezeichnet jemanden, der sich in einer schlechten Stimmung befindet"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "mrzutý",
                                "target_lang_sense_clarification": "člověk, který projevuje nelibost a špatnou náladu"
                            },
                            {
                                "target_lang_word": "nevrlý",
                                "target_lang_sense_clarification": "osoba, která je nepříjemná a podrážděná"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1ca9a54-8d1b-3247-981a-d86fe73b371a",
                    "sense_definition": "Gloomy, dismal, or foreboding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>sullen</w> atmosphere filled the room as the storm clouds gathered outside.",
                            "target_lang_translations": {
                                "de": "Eine <w>düstere</w> Atmosphäre erfüllte den Raum, während sich draußen die Gewitterwolken zusammenbrauten.",
                                "cs": "Místnost naplnila <w>pochmurná</w> atmosféra, zatímco se venku stahovala bouřková mračna."
                            }
                        },
                        {
                            "text": "The <w>sullen</w> sky seemed to warn of the coming winter.",
                            "target_lang_translations": {
                                "de": "Der <w>trübe</w> Himmel schien vor dem kommenden Winter zu warnen.",
                                "cs": "Ten <w>bezútěšný</w> obzor jako by varoval před přicházející zimou."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "dismal",
                        "somber"
                    ],
                    "common_phrases": [
                        "sullen atmosphere",
                        "sullen sky"
                    ],
                    "target_lang_definitions": {
                        "de": "Düster, trostlos oder eine bedrohliche Stimmung verbreitend.",
                        "cs": "Pochmurný, deprimující nebo vyvolávající tísnivý pocit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "düster",
                                "target_lang_sense_clarification": "beschreibt eine bedrohliche oder lichtarme Atmosphäre"
                            },
                            {
                                "target_lang_word": "trostlos",
                                "target_lang_sense_clarification": "beschreibt eine deprimierende, freudlose Umgebung"
                            },
                            {
                                "target_lang_word": "trist",
                                "target_lang_sense_clarification": "bezeichnet eine öde und wenig anregende Stimmung"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pochmurný",
                                "target_lang_sense_clarification": "neradostný, plný chmur a zasmušilosti"
                            },
                            {
                                "target_lang_word": "bezútěšný",
                                "target_lang_sense_clarification": "působící deprimujícím a prázdným dojmem"
                            },
                            {
                                "target_lang_word": "zasmušilý",
                                "target_lang_sense_clarification": "působící vážně, smutně a uzavřeně"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "113ceeb6-c3fc-345d-a300-fc30cd3f470f",
                    "sense_definition": "Sullen feelings or manners; moroseness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She seemed to be suffering from a fit of the <w>sullens</w> all afternoon.",
                            "target_lang_translations": {
                                "de": "Sie schien den ganzen Nachmittag unter einem Anfall von <w>Trübsinn</w> zu leiden.",
                                "cs": "Zdálo se, že celé odpoledne trpí záchvatem <w>trübsinnu</w>."
                            }
                        },
                        {
                            "text": "He finally shook off the <w>sullens</w> and joined the rest of the group.",
                            "target_lang_translations": {
                                "de": "Er schüttelte schließlich seinen <w>Missmut</w> ab und schloss sich dem Rest der Gruppe an.",
                                "cs": "Konečně setřásl svou <w>mrzutost</w> a připojil se ke zbytku skupiny."
                            }
                        }
                    ],
                    "synonyms": [
                        "moroseness",
                        "gloom"
                    ],
                    "common_phrases": [
                        "the sullens"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in the phrase 'the sullens'."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Gefühle von Missmut oder eine mürrische Gemütsverfassung.",
                        "cs": "Pocity mrzutosti nebo zasmušilé chování."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Trübsinn",
                                "target_lang_sense_clarification": "bezeichnet eine melancholische oder niedergeschlagene Stimmung"
                            },
                            {
                                "target_lang_word": "Missmut",
                                "target_lang_sense_clarification": "bezeichnet eine verärgerte oder unzufriedene Gemütsverfassung"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "trübsinn",
                                "target_lang_sense_clarification": "melancholická nebo sklíčená nálada"
                            },
                            {
                                "target_lang_word": "mrzutost",
                                "target_lang_sense_clarification": "stav podráždění nebo nespokojenosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b397ab3-4f15-3c87-aad1-c50c071ec0ad",
                    "sense_definition": "To make someone or something sullen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant complaining served only to <w>sullen</w> the mood of the entire team.",
                            "target_lang_translations": {
                                "de": "Sein ständiges Klagen trug nur dazu bei, die Stimmung des gesamten Teams zu <w>verstimmen</w>.",
                                "cs": "Jeho neustálé stěžování jen <w>rozladilo</w> náladu celého týmu."
                            }
                        },
                        {
                            "text": "The bad news <w>sullened</w> his usually bright disposition.",
                            "target_lang_translations": {
                                "de": "Die schlechten Nachrichten <w>trübten</w> sein normalerweise fröhliches Wesen.",
                                "cs": "Špatné zprávy <w>zatemnily</w> jeho obvykle veselou povahu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas mürrisch oder düster machen.",
                        "cs": "Učinit někoho nebo něco mrzutým či pochmurným."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstimmen",
                                "target_lang_sense_clarification": "jemanden in eine schlechte Stimmung versetzen"
                            },
                            {
                                "target_lang_word": "trüben",
                                "target_lang_sense_clarification": "die Stimmung oder Atmosphäre negativ beeinflussen"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozladit",
                                "target_lang_sense_clarification": "narušit něčí dobrou náladu"
                            },
                            {
                                "target_lang_word": "zatemnit",
                                "target_lang_sense_clarification": "negativně ovlivnit atmosféru nebo náladu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}