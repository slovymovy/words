            {
                "entry_id": "7eee6fb4-e76c-3357-82a0-fb0bdc878db9",
                "word": "lampion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e47b6d5-5586-4cb2-a528-773d8b7918f8",
                        "entry_id": "7eee6fb4-e76c-3357-82a0-fb0bdc878db9",
                        "tags": [
                            "plural"
                        ],
                        "form": "lampions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7909ba1f-8de6-3851-9aa0-084994079e3a",
                        "entry_id": "7eee6fb4-e76c-3357-82a0-fb0bdc878db9",
                        "glosses": [
                            "Coiffure tricorne, notamment portée lors des chasses à courre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7e72ec57-264c-3c08-84d1-d8b99def4a78",
                        "entry_id": "7eee6fb4-e76c-3357-82a0-fb0bdc878db9",
                        "glosses": [
                            "Coiffure bicorne de feutre noir porté par les écuyers du Cadre noir"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f15e8b-17b4-456d-8bd9-a636651ccde5",
                                "sense_id": "7e72ec57-264c-3c08-84d1-d8b99def4a78",
                                "text": "Les officiers du célèbre cadre noir de Saumur, lorsqu’ils sont en grande tenue, coiffent un chapeau à deux cornes qu’on a coutume d’appeler un lampion."
                            },
                            {
                                "example_id": "fd91acf1-77fa-4d83-be58-52770611e08c",
                                "sense_id": "7e72ec57-264c-3c08-84d1-d8b99def4a78",
                                "text": "Revêtus de leur tenue traditionnelle, coiffés du célèbre lampion à cocarde tricolore et bandeau d'or, conduits par monsieur l’écuyer en chef, les écuyers vont entrer pour la reprise du manège."
                            },
                            {
                                "example_id": "da3963b0-69f7-436f-8ba9-23b664d54e56",
                                "sense_id": "7e72ec57-264c-3c08-84d1-d8b99def4a78",
                                "text": "Les hommes en tunique noire et en gants blancs, coiffés du « chapeau de manège » appelé lampion ou bicorne et leurs chevaux de race selle français, nattés avec des rubans rouge amarante, la couleur de la fleur d’automne qui symbolise l’éternité, offriront dans leur ballet équestre des tableaux comme le saut d’obstacle et les quadrilles, accompagnés par l’Orchestre de la Garde républicaine et le Chœur de l’armée française."
                            }
                        ]
                    }
