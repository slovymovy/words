                "senses": [
                    {
                        "sense_id": "c1481fc9-2bdc-326f-9f62-39efb701096c",
                        "entry_id": "3fda9085-3115-3613-91ca-2d82d03e647b",
                        "glosses": [
                            "Combler les jours (de quelque chose qui avait été ajouré)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8595c1ec-2a14-4b99-a305-d0b07aae642c",
                                "sense_id": "c1481fc9-2bdc-326f-9f62-39efb701096c",
                                "text": "Eh bien ! récemment l’on a découvert que cette dernière arcature avait été désajourée par un remplissage de seconde main, et l’on s’est empressé de restituer l’ordonnance primitive."
                            },
                            {
                                "example_id": "30d05551-a251-407f-9d5a-ecb019f21d57",
                                "sense_id": "c1481fc9-2bdc-326f-9f62-39efb701096c",
                                "text": "Un temps désajouré la traverse, où nul instant ne saurait servir pour personne de refuge éternel."
                            }
                        ]
                    }
