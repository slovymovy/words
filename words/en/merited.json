{
    "word_family": [
        "merit",
        "meritorious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "925c95af-7363-37dc-a446-e6ffdb655011",
                    "sense_definition": "Deserving of something, especially praise, reward, or attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deserved",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team received a <w>merited</w> reward for their hard work throughout the season.",
                            "target_lang_translations": {
                                "nl": "Het team ontving een <w>verdiende</w> beloning voor hun harde werk gedurende het seizoen."
                            }
                        },
                        {
                            "text": "The victory was a <w>merited</w> outcome after such a dominant performance on the field.",
                            "target_lang_translations": {
                                "nl": "De overwinning was een <w>terecht</w> resultaat na zo'n dominante prestatie op het veld."
                            }
                        }
                    ],
                    "synonyms": [
                        "deserved",
                        "justified",
                        "warranted"
                    ],
                    "antonyms": [
                        "undeserved",
                        "unjustified"
                    ],
                    "common_phrases": [
                        "merited reward",
                        "merited outcome"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat verdiend is, in het bijzonder lof, een beloning of aandacht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verdiend",
                                "target_lang_sense_clarification": "Iets dat iemand toekomt op basis van inspanning of kwaliteit."
                            },
                            {
                                "target_lang_word": "terecht",
                                "target_lang_sense_clarification": "Iets dat gerechtvaardigd of logisch is."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "720de00f-e876-33aa-9ba8-4bcc3d9d4f3f",
                    "sense_definition": "Simple past and past participle of <w>merit</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deserved",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project <w>merited</w> further investigation due to the unexpected results.",
                            "target_lang_translations": {
                                "nl": "Het project <w>verdiende</w> nader onderzoek vanwege de onverwachte resultaten."
                            }
                        },
                        {
                            "text": "His brave actions <w>merited</w> a formal commendation from the department.",
                            "target_lang_translations": {
                                "nl": "Zijn dappere acties <w>verdienden</w> een formele onderscheiding van de afdeling."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van verdienen; recht hebben op iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verdiende",
                                "target_lang_sense_clarification": "Enkelvoud verleden tijd van verdienen."
                            },
                            {
                                "target_lang_word": "verdiend",
                                "target_lang_sense_clarification": "Voltooid deelwoord van verdienen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}