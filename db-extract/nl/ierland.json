                                            {
                                                "example_id": "f6db4a02-29d4-4219-bd9f-de1014795bef",
                                                "sense_id": "c950f252-e1f7-3a96-91f0-c7c36f1f1369",
                                                "text": "Dublin ist die Hauptstadt von Irland."
                                            },
                                            {
                                                "example_id": "78bf3a0f-f4ef-4a94-ad14-5dccb7d12d03",
                                                "sense_id": "c950f252-e1f7-3a96-91f0-c7c36f1f1369",
                                                "text": "Die Republik Irland heißt in der Landessprache Poblacht na hÉireann."
                                            },
                                            {
                                                "example_id": "904f494d-bf41-4eb9-9eb1-3018adbdf9c0",
                                                "sense_id": "c950f252-e1f7-3a96-91f0-c7c36f1f1369",
                                                "text": "„In den Jahren 1845 bis 1849 verfaulten in Irland die Kartoffeln auf den Äckern und zerstörten damit die Lebensgrundlage vieler Menschen. Eine gewaltige Hungersnot folgte, Hunderttausende Menschen starben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73e5b61e-c714-33d1-b38e-b3a2e948cd73",
                                        "entry_id": "fd5c05c0-9d8a-3d61-8100-5c929be099c3",
                                        "glosses": [
                                            "eine nordwesteuropäische Insel im Atlantik, Bezeichnung für die gesamte Insel"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b026096d-9fa9-4208-8425-f1b31c4758b7",
                                                "sense_id": "73e5b61e-c714-33d1-b38e-b3a2e948cd73",
                                                "text": "Irland wird oft mit Kelten, Magie und Aberglaube assoziiert."
                                            },
                                            {
                                                "example_id": "422b86ab-21aa-41cf-bcb2-efb1e66961cd",
                                                "sense_id": "73e5b61e-c714-33d1-b38e-b3a2e948cd73",
                                                "text": "„Im Alter von 16 Jahren wurde er von Seeräubern nach Irland entführt und musste dort als Sklave leben, bis er auf einem Schiff fliehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
