                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc8f8d1f-106a-346d-abae-83bcb94540f9",
                        "entry_id": "b350ec6e-c0d4-330e-bc6c-99ab464d1c2f",
                        "glosses": [
                            "to accept, to put up (with), to reconcile oneself (to), to resign oneself (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fbee261-9d59-4a7f-a130-09fc2cd54b78",
                                "sense_id": "fc8f8d1f-106a-346d-abae-83bcb94540f9",
                                "text": "мири́ться со свои́м положе́нием",
                                "translation": "to accept one's situation",
                                "english": "to accept one's situation"
                            },
                            {
                                "example_id": "c9168bc2-690c-486f-8f13-37f4e5b94d72",
                                "sense_id": "fc8f8d1f-106a-346d-abae-83bcb94540f9",
                                "text": "мири́ться с лише́ниями",
                                "translation": "to put up with hardships; rough it",
                                "english": "to put up with hardships; rough it"
                            },
                            {
                                "example_id": "d49533fb-0d55-4b7d-8faa-4a62424aa187",
                                "sense_id": "fc8f8d1f-106a-346d-abae-83bcb94540f9",
                                "text": "мири́ться с недоста́тками",
                                "translation": "to condone shortcomings",
                                "english": "to condone shortcomings"
                            },
                            {
                                "example_id": "3664c272-dff7-4316-93df-59c283e41781",
                                "sense_id": "fc8f8d1f-106a-346d-abae-83bcb94540f9",
                                "text": "нельзя́ мири́ться с э́тим",
                                "translation": "this cannot be tolerated",
                                "english": "this cannot be tolerated"
                            }
                        ]
