                                        "sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                                        "entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                                        "glosses": [
                                            "An electronic measuring instrument that combines multiple functions; a combined voltmeter, ammeter and ohmmeter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d68841f-fa22-4828-912d-074fc0472c80",
                                                "sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                                                "text": "This meter is a 3½ digit digital multimeter that is rugged, reliable and convenient to use, while providing all of the accuracy and features needed for any application."
                                            },
                                            {
                                                "example_id": "cc765334-b645-4a02-864b-75f4a7197d8c",
                                                "sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                                                "text": "A basic hands-on kit that introduces you to good soldering techniques while working on state-of-the-art printed circuit board circuits. You will learn the basics of digital multimeters and circuit troubleshooting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
