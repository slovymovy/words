                        "glosses": [
                            "overdekte plaats waar men kan wachten op de bus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b1f643-cf82-4dae-bab4-ee9f76529ccb",
                                "sense_id": "03a3c5b6-01f0-343a-8b10-edbda160b494",
                                "text": ",,Een jaar of tien jaar geleden was Ajax kampioen en ik had geen vrienden bij me om het te vieren. Ik ben naar buiten gegaan en heb een bushok gesloopt. Ik stond erbij te huilen, omdat ik met niemand mijn vreugde kon delen. Daar ben ik blijven wachten tot de politie kwam, die me naar een instelling verwees."
                            }
                        ]
                    }
