                "senses": [
                    {
                        "sense_id": "7e80fa04-a5bc-3140-9092-168006cf7a8f",
                        "entry_id": "9c554cc1-86f7-3f7c-8189-d0220cf4bd52",
                        "glosses": [
                            "jemand, der eine Kolonie erobert oder erwirbt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "b411143d-0565-42a8-916b-0e87303ca614",
                                "sense_id": "7e80fa04-a5bc-3140-9092-168006cf7a8f",
                                "text": "„Den Entdeckern folgten schnell die Eroberer und Kolonisatoren, die die europäische Vorherrschaft in der Welt für Jahrhunderte festschrieben.“"
                            },
                            {
                                "example_id": "a2d5d4af-3c63-4487-a061-3d58160fcbb1",
                                "sense_id": "7e80fa04-a5bc-3140-9092-168006cf7a8f",
                                "text": "„Den Gepflogenheiten der Indianer Nordamerikas begegnen die europäischen Kolonisatoren meist mit Unverständnis.“"
                            },
                            {
                                "example_id": "b27b0468-ea7d-4d48-b9b1-5ebb6b74b75b",
                                "sense_id": "7e80fa04-a5bc-3140-9092-168006cf7a8f",
                                "text": "„Die Singhalesen zeichneten sich als Kolonisatoren und Städtebauer aus.“"
                            },
                            {
                                "example_id": "1d64ea21-095d-4d85-aa00-d6ced3815387",
                                "sense_id": "7e80fa04-a5bc-3140-9092-168006cf7a8f",
                                "text": "„Kolonisatoren und Sklavenhändler sahen in den Schwarzen primitive, den Weißen unterlegene, minderwertige Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
