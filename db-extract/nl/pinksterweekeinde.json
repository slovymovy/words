                        "examples": [
                            {
                                "example_id": "7511afe6-f7d6-4657-a3de-d3892811339d",
                                "sense_id": "1fb2f7db-77f0-305d-acfb-28ed84823e94",
                                "text": "Wie het lange pinksterweekeinde elders wilde doorbrengen, was op vrijdag of zaterdag de stad al uit gegaan."
                            },
                            {
                                "example_id": "065f6abe-7860-4619-90d2-9b8248fe738a",
                                "sense_id": "1fb2f7db-77f0-305d-acfb-28ed84823e94",
                                "text": "Hij verklaart de drukte door het aanstaande Pinksterweekeinde. \"Veel mensen gaan dan op een korte vakantie. Aan het einde van de middag mengt het recreatieverkeer zich met het reguliere woon-werkverkeer en dan wordt het druk op de weg.\""
                            }
                        ]
