        "fr-extract.jsonl": [
            {
                "entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                "word": "bizarrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "glosses": [
                            "D'une façon bizarre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "396823b9-3d03-49e3-a12f-9a0ab146d001",
                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                "text": "De notre amour bizarrement jaloux, Il veut, peut-être, en se jouant de nous, Nous effrayer […]"
                            },
                            {
                                "example_id": "17df3a76-617b-4f96-9fbe-baf843100fef",
                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                "text": "Mais que les lois soient bizarrement faites, ça regarde, après tout, les peuples qui sont assez bêtes pour se les laisser faire."
                            },
                            {
                                "example_id": "91053eee-be74-41ef-ba22-a1c1d4580868",
                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                "text": "Je notai qu’elle avait un début de double menton. Bizarrement, ce défaut m’émut."
                            },
                            {
                                "example_id": "c0442c8b-98eb-4420-9a13-bfac0b2bb45d",
                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                "text": "J'avais pourtant cru voir le mot « ÉCOLE » sur la devanture de l'établissement juste après « auto ». Au temps pour moi, ma dyslexie passagère a encore frappé... Enfin... bizarrement, je crois ne pas être la seule à avoir souffert de ce syndrome ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cda328bf-8636-48ba-b51a-11e3c6764b0d",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "merkwürdigerweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merkwürdigerweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55e27d13-5d3d-31c8-bebd-f5df65f4918a",
                                        "entry_id": "a376b004-d1f9-37e9-8ce0-9de1d9c3ec3c",
                                        "glosses": [
                                            "merkwürdig erscheinend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c95262c-0dce-44c3-8a5c-b627b1cf040c",
                                                "sense_id": "55e27d13-5d3d-31c8-bebd-f5df65f4918a",
                                                "text": "„Das Geräusch wiederholte sich nicht, und merkwürdigerweise war er froh darüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f491d925-7bcc-4bf4-97a7-626430515233",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "seltsamerweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seltsamerweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
                                        "entry_id": "8b805d22-ce3d-36a4-afe5-75c3ff813843",
                                        "glosses": [
                                            "seltsam, eigenartig erscheinend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7ea6d08-062a-46ee-9d35-acc7e2f96af9",
                                                "sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
                                                "text": "Seltsamerweise hat er sich nicht mehr gemeldet."
                                            },
                                            {
                                                "example_id": "bf07815e-863d-4a2e-9aec-38ca0fe712ee",
                                                "sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
                                                "text": "Dann hat das Geräusch seltsamerweise wieder aufgehört."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84b65336-8f84-44ce-996b-c139a61675c5",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "bizarrely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bizarrely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                        "entry_id": "fe91e4fe-e306-3bd1-8674-442c3e2d9486",
                                        "glosses": [
                                            "In a bizarre manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e272a523-4bd2-4cf1-8619-540875f4e09e",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "And, placed discreetly among these commonplaces, a few pieces of genuine quality, bizarrely distinguished by craftsmanship from the vulgar products of the machine."
                                            },
                                            {
                                                "example_id": "9e614c58-225f-4d12-af2d-979dd7cdda78",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "The forms can be bizarrely funny when blown up to fill a canvas, as in \"Supergastrico Compensado\" (the artist prefers that his often punning titles remain untranslated), whose eroticized digestive systems have an appealing decorative flair."
                                            },
                                            {
                                                "example_id": "e6cb6d3b-cf38-4651-8987-aa7e606d37c9",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "The White House said Wednesday that President Obama had dismissed a government agency’s internal watchdog because he was incompetent and had behaved bizarrely, disputing accusations that he was fired because he had uncovered embarrassing problems in the AmeriCorps program."
                                            },
                                            {
                                                "example_id": "732c90be-be21-4d18-9f66-06eb1ed074c0",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "[...] his 'crime' was discovered, was summoned to see the headmaster, Sir Arthur fforde. It could potentially have been a flogging offence, but the headmaster, bizarrely, offered him a glass of nonalcoholic sherry. It no doubt helped that fforde, like [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aac83648-8f6d-4f11-85ce-f87caab36926",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "eccentrically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eccentrically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43c6ad24-ec3a-365c-9fd8-70969323099d",
                                        "entry_id": "8066f926-f373-3c72-8f90-c0a22ea4f83a",
                                        "glosses": [
                                            "In an eccentric manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e7e4e9-56ad-4c8f-aa6a-64f579e5763b",
                                                "sense_id": "43c6ad24-ec3a-365c-9fd8-70969323099d",
                                                "text": "The face which emerged was not reassuring.[…]. He was not a mongol but there was a deficiency of a sort there, and it was not made more pretty by a latter-day hair cut which involved eccentrically long elf-locks and oiled black curls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94376231-3e3f-4b8b-b13e-5e9ef55d9e73",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "oddly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oddly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                                        "glosses": [
                                            "In a peculiar manner; strangely; unusually."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96541df5-ae55-4169-bb0c-197733ba4364",
                                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                                "text": "For December, it was oddly warm."
                                            },
                                            {
                                                "example_id": "a2973025-3eb2-4e20-8bf8-8e04bdc917b5",
                                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                                "text": "Novv, Sir, vvhen my Time comes, leſt they ſhou'd think it vvorth vvhile to handle my Memory vvith the ſame Freedom, I am vvilling to prevent its being ſo odly beſmear'd (or at beſt but flatly vvhite-vvash'd) by taking upon me to give the Publick This, as true a Picture of myſelf as natural Vanity vvill permit me to dravv; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                                        "glosses": [
                                            "In a manner measured by an odd number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb800333-ec5f-44d7-ae79-27174e2fa8d8",
                                                "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                                "text": "The oddly counted lords are always out of sync with at least one other evenly counted cycle. These two strange counts assured that at no single moment could all cycles end at the same time for an extraordinarily long time, for at least one odd count threw off all the even ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87c81695-aec0-4a1a-b0ac-7b56716ac058",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "weirdly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weirdly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb5b0cf9-ce1a-34fa-a204-5ad9b07ef838",
                                        "entry_id": "e3c85466-a5fd-3332-8084-389309c9a8e2",
                                        "glosses": [
                                            "In a weird manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be64be4-bf06-42fe-875b-47effeec5234",
                                                "sense_id": "bb5b0cf9-ce1a-34fa-a204-5ad9b07ef838",
                                                "text": "The teacher suspected he was on drugs because he was behaving weirdly."
                                            },
                                            {
                                                "example_id": "d8a46e5a-1069-4ce3-b249-2a06265d88bf",
                                                "sense_id": "bb5b0cf9-ce1a-34fa-a204-5ad9b07ef838",
                                                "text": "She wore a necklace strung with weirdly-shaped pearls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7af3f56-a23e-3e4e-8fb7-e386439ee6e8",
                                        "entry_id": "e3c85466-a5fd-3332-8084-389309c9a8e2",
                                        "glosses": [
                                            "Contrary to expectations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c87e8f-f97b-435d-b06e-a00379bbabc8",
                                                "sense_id": "c7af3f56-a23e-3e4e-8fb7-e386439ee6e8",
                                                "text": "Weirdly, Alice showed up 10 minutes early. She was usually late for everything."
                                            },
                                            {
                                                "example_id": "edded16b-00e9-46ac-86ae-1a74530d2983",
                                                "sense_id": "c7af3f56-a23e-3e4e-8fb7-e386439ee6e8",
                                                "text": "The roughness of the wool was weirdly pleasant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a3076a1-2026-49d6-b11c-b9a1b468943d",
                        "source_entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                        "source_sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                        "target_lang_word": "strangely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strangely",
