                                    {
                                        "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                        "entry_id": "8b5818aa-c899-3cb8-8e6e-30e6ff009662",
                                        "glosses": [
                                            "Mensch mit einem schwarzen und einem weißen Elternteil"
                                        ],
                                        "tags": [
                                            "teilweise als diskriminierend wahrgenommen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bfbad97-6c0b-4b7d-a944-23281cc201b1",
                                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                                "text": "In der Karibik gibt es sehr viele Mulatten."
                                            },
                                            {
                                                "example_id": "03ce1a5b-271f-4c2e-99ff-b7f485e3e721",
                                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                                "text": "„Mulatten waren schon von Anfang an zugelassen gewesen und hatten dieses Gremium sehr schnell dominiert; Menschen jedoch, in deren Adern kein Tropfen portugiesisches Blut floss, hatten hart um ihre Aufnahme kämpfen müssen.“"
                                            },
                                            {
                                                "example_id": "320b8c74-f14f-497e-9bec-1b7c7438dceb",
                                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                                "text": "„Hallo und Mintzlaff waren aus dem Kurhaus in eine Bar übersiedelt, die ›Chez nous‹ hieß und in der eine aus Negern und Mulatten bestehende Tanzkapelle am Werke war.“"
                                            },
                                            {
                                                "example_id": "1cdbb361-099e-453c-b033-af60d9f80776",
                                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                                "text": "„In der Wissenschaft kennt man die einfache Rassenmischung zwischen Weiß und Schwarz, siehe die Mulatten und Mischlinge der Antillen.“"
                                            },
                                            {
                                                "example_id": "9b6b38f5-5dde-454e-b76c-630155a4e46f",
                                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                                "text": "„Dennoch bekamen wir nur zwei Bediente zu Gesicht, und zwar einen jungen Mulatten und eine Mulattin gleichen Alters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0d8db19-14d1-4300-88ce-ad5a576fe570",
                        "source_entry_id": "a62c0223-798d-3e32-b954-d769ac6492af",
                        "source_sense_id": "e67b561a-b205-3476-8e84-bfe51bfa8d64",
                        "target_lang_word": "mulâtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mulâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c04c29f2-fb21-3acc-96ef-1d51a31944d2",
                                        "entry_id": "85e70df7-8dfc-333b-af1e-adc27a8e8cae",
                                        "glosses": [
                                            "Métis né d’un parent noir et d’un parent blanc ou de deux parents mulâtres."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51d6d91-a55f-4263-a6fb-10f8a6a9bda9",
                                                "sense_id": "c04c29f2-fb21-3acc-96ef-1d51a31944d2",
                                                "text": "« Nous n’avons qu’une belle mulâtre, une jolie femme, bien faite; mais elle est stérile.»"
                                            },
                                            {
                                                "example_id": "61ccbb05-08d1-42fe-a4f6-db6acbb10b1b",
                                                "sense_id": "c04c29f2-fb21-3acc-96ef-1d51a31944d2",
                                                "text": "Si Dris Ben-Aâlem, le caïd el-mechouar, gouverneur de la cour, commandant de la garde chérifienne, porte-parole du Sultan, était un mulâtre gigantesque à voix stentorienne."
                                            },
                                            {
                                                "example_id": "8abb4711-8871-47c1-9d3d-f444fb19c12d",
                                                "sense_id": "c04c29f2-fb21-3acc-96ef-1d51a31944d2",
                                                "text": "J’ai oublié ma réserve habituelle : parodiant cette boutade célèbre d’un pamphlétaire qui reprochait à un mulâtre de ne pas avoir eu le courage d’être nègre tout à fait, je me suis mise à persifler :\n— M. le délégué n’a pas eu la simplicité de s’appeler communément Dubois. Il a poussé le sens de la distinction, l’effort imaginatif et précieux jusqu’à se nommer Libois."
                                            },
                                            {
                                                "example_id": "1521b1f0-b36f-4e30-b2a7-07d0a417ee0e",
                                                "sense_id": "c04c29f2-fb21-3acc-96ef-1d51a31944d2",
                                                "text": "Un mulâtre en chandail chiné de rouge et vert, en casquette de toile blanche, était entré derrière elle et refermait la porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d00e8f64-0e2f-3ec3-a507-34c95d98a02f",
                                        "entry_id": "85e70df7-8dfc-333b-af1e-adc27a8e8cae",
                                        "glosses": [
                                            "Afrodescendant liotrique à la peau jaune ou café au lait et aux traits europoïdes."
                                        ],
                                        "tags": [
                                            "Haïti"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
