                                "target_senses": [
                                    {
                                        "sense_id": "07f9c173-4b7e-34f8-bf75-d94cf0bc576d",
                                        "entry_id": "1fa8478c-dd25-33d2-872b-ac24e98d090c",
                                        "glosses": [
