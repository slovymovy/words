                "senses": [
                    {
                        "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                        "entry_id": "bdf58115-664c-3813-a493-99e2dcae21bf",
                        "glosses": [
                            "Teilnehmer im Semifinale eines Wettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278189a0-d16f-49d6-8d99-809cd7d57cde",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„Der Semifinalist des Vorjahrs tat sich gegen die Nummer 30, die ihn in der 2. Runde der US Open sang- und klanglos verabschiedet hatte, alles andere als leicht, verzeichnete etwa 61 unerzwungene Fehler, darunter 15 Doppelfehler.“"
                            },
                            {
                                "example_id": "ff3092e9-aa6a-4239-8c7e-370519e3fb07",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„In der Premier League finden von Samstag bis Montag nur sechs Spiele statt, das erste davon am frühen Samstagnachmittag (13.30 MESZ), wenn der Tabellendritte und Champions-League-Semifinalist Liverpool beim Tabellenschlusslicht West Bromwich gastiert.“"
                            },
                            {
                                "example_id": "68fe5de7-c304-4caf-922a-7c9f6c6f2d2a",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„Als erster Semifinalist steht seit Dezember vorigen Jahres der TSV Bützow nach einem 4:2 über den Verbandsliga-Rivalen Aufbau Boizenburg fest.“"
                            },
                            {
                                "example_id": "3437354d-8939-45ea-b8a9-c5857c08464b",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„Europa-League-Semifinalist Red Bull Salzburg gewann als erstes Team im österreichischen Fußball fünf Meistertitel in Folge.“"
                            },
                            {
                                "example_id": "dc768bd8-3e6a-40ad-b1e3-324868e4c54b",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„2013 war er Semifinalist im Linzer Opernwettbewerb, darüber hinaus sang er Tybalt in Romeo et Juliette in Santiago de Chile und beim Castleton Festival in Virginia (USA).“"
                            },
                            {
                                "example_id": "8aa7e3d5-b563-485e-bef9-c824bbf2cbd8",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„Der vierte Semifinalist wird nach der Spielabsage vom Dienstag erst am 14. März zwischen den Sportfreunden Lotte und Borussia Dortmund ermittelt - gelost wird dennoch wie geplant.“"
                            },
                            {
                                "example_id": "438967c8-f3e4-4d81-80df-c23e7c7b2082",
                                "sense_id": "dac50655-7ed3-3169-9d43-9cf71e8be77f",
                                "text": "„Der Tabellendritte und Champions-League-Semifinalist Liverpool vergab dabei eine 2:0-Führung beim Tabellenschlusslicht West Bromwich und musste sich mit einem 2:2 begnügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
