                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64cebff1-0fcc-48dc-bde7-9e60cc660889",
                                "sense_id": "519bd4ea-cf50-3b0f-850c-baa492cf0bd9",
                                "text": "Warum ich nicht mitgehen will? Erstens habe ich keine Lust, zweitens habe ich keine Zeit und drittens und letztens habe ich kein Interesse."
                            }
                        ],
                        "sense_index_json": "\"2\""
