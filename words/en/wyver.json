                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian discovered that the <w>Wyver</w> family had lived in the village for centuries.",
                            "target_lang_translations": {
                                "es": "El historiador descubrió que la familia <w>Wyver</w> había vivido en el pueblo durante siglos."
