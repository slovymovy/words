                "senses": [
                    {
                        "sense_id": "4ac67da1-0632-3b60-a2f4-4dfaaea083d4",
                        "entry_id": "bcda3a9d-16a8-3f11-b93f-640abab0dcbe",
                        "glosses": [
                            "Rendre huguenot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1071ba94-2e58-4088-8b6d-0ff11ce11036",
                                "sense_id": "4ac67da1-0632-3b60-a2f4-4dfaaea083d4",
                                "text": "Marguerite de Valois, mère de la reine Jeanne d’Albret ayant installé un mauvais prêtre huguenot Gérard Roussel comme évêque d’Oloron, ce malheureux empoisonna de sa doctrine le Béarn entier et il crut qu’il ne trouverait pas davantage d’obstacles à « huguenotiser » le Pays Basque."
                            },
                            {
                                "example_id": "19546210-f702-48cd-9469-2a3a742d7544",
                                "sense_id": "4ac67da1-0632-3b60-a2f4-4dfaaea083d4",
                                "text": "Vouloir du même coup laïciser et huguenotiser, c'est se rendre coupable d'une double mauvaise action."
                            }
                        ]
                    }
                ],
