                ],
                "senses": [
                    {
                        "sense_id": "5e4633a1-4a8b-305d-b593-1da78618aec3",
                        "entry_id": "6581736e-5245-3417-897a-e1aa53294cb1",
                        "glosses": [
                            "Schülerin eines Lyzeums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276b1bc0-7169-4b3c-bf0d-b975e99ecb78",
                                "sense_id": "5e4633a1-4a8b-305d-b593-1da78618aec3",
                                "text": "„Schülerinnen, Lyzeistinnen, gehen dort Arm in Arm auf und ab, die Gymnasiasten fehlen nicht, und auch ältere Mädchen sind da, Mädchen von zwanzig, einundzwanzig Jahren.“"
                            },
                            {
                                "example_id": "fc536de9-9844-4ab1-9701-be514a8fdb42",
                                "sense_id": "5e4633a1-4a8b-305d-b593-1da78618aec3",
                                "text": "„Als Lyzeistin schrieb Kudrjaschewa eine Schularbeit über die Sagen der nordischen Völker, in denen dieses Tier figurierte.“"
                            },
                            {
                                "example_id": "fb938c60-f1fa-4088-a0fd-f932e2771c30",
                                "sense_id": "5e4633a1-4a8b-305d-b593-1da78618aec3",
                                "text": "„Unterzieht sich die Lyzeistin nach der Reifeprüfung einer Prüfung aus dem Latein der ersten sechs Klassen an einem öffentlichen Gymnasium, so wird sie zum Apothekerberufe zugelassen;…“"
                            },
                            {
                                "example_id": "f9d93a8a-9a43-4b72-96cc-2f1099f44d7d",
                                "sense_id": "5e4633a1-4a8b-305d-b593-1da78618aec3",
                                "text": "„Die Filmkünstler entwickelten zusammen mit den Lyzeistinnen und Lyzeisten sowie deren Deutschlehrern ein Thema aus ihrer Alltagswelt und konnten dazu ihre eigenen kurzen Filme drehen.“"
                            },
                            {
                                "example_id": "4b2434fa-d5d0-4502-aa84-47dfdfc579b3",
                                "sense_id": "5e4633a1-4a8b-305d-b593-1da78618aec3",
                                "text": "„Der Akt setzt in einer Konditorei ein, wo sich mehrere Lyzeistinnen während ihrer Freistunden mit Gymnasiasten treffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
