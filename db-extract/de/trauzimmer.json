                        "glosses": [
                            "Raum, in dem standesamtliche Trauungen durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26474ffb-4278-4721-86f6-778c96b16ead",
                                "sense_id": "f6afa6e0-db04-3ad3-a7bd-81850d2f9512",
                                "text": "Neben offiziellen Trauzimmern im Standesamt, gibt es die Möglichkeit, dass das Standesamt außerhalb des Dienstgebäudes liegende Orte bestimmt, an denen die Eheschließung möglich ist."
                            },
                            {
                                "example_id": "7fa2b353-df28-4e27-a180-c6d08b65e004",
                                "sense_id": "f6afa6e0-db04-3ad3-a7bd-81850d2f9512",
                                "text": "Das kleinste Trauzimmer Deutschlands befindet sich in Triberg im Schwarzwald."
                            }
                        ],
