                        "glosses": [
                            "Donner un caractère interprofessionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a03b88-134b-4173-bba7-a03bbae18fbf",
                                "sense_id": "ec26f199-1ab9-3f48-9cb0-04b37e816213",
                                "text": "Il faut interprofessionnaliser la syndicalisation."
                            },
                            {
                                "example_id": "8aeeae02-66c5-4ef5-b1b0-1ca3a04b8379",
                                "sense_id": "ec26f199-1ab9-3f48-9cb0-04b37e816213",
                                "text": "Nous devons, partout où cela est possible, dans l'unité la plus large, interprofessionnaliser notre action."
                            },
                            {
                                "example_id": "48ca42fc-00ec-4556-860b-43d49a49f3f7",
                                "sense_id": "ec26f199-1ab9-3f48-9cb0-04b37e816213",
                                "text": "Pourtant, cette lutte a eu ses limites : nous n'avons pas su l'interprofessionnaliser."
                            }
                        ]
