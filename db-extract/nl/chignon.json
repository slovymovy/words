                "senses": [
                    {
                        "sense_id": "d07eec69-f8e1-372e-b9c5-56651b166703",
                        "entry_id": "7953eebe-6628-3f33-a754-8ca5d77a62af",
                        "glosses": [
                            "gedraaide haarwrong achter op het hoofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e44d666a-c9b1-4975-bae6-0fe934560420",
                                "sense_id": "d07eec69-f8e1-372e-b9c5-56651b166703",
                                "text": "Big hair was ook trending bij Just Cavalli en Marc by Marc Jacobs terwijl de Amerikaan voor zijn hoofdlijn voor korte plukken ging. Dolce & Gabbana pasten de kapsels aan op hun byzantijnse collectie en lieten haarstylist Guido Palau opgekamde chignons creëren."
                            },
                            {
                                "example_id": "59aa190f-63af-4ee1-b89d-7a4486e343d1",
                                "sense_id": "d07eec69-f8e1-372e-b9c5-56651b166703",
                                "text": "De protocolchef moest de koning en koningin ook een paar keer te hulp schieten. Zo was Warnauts drie jaar geleden ineens kapper. \"Ik zag koningin Mathilde de hele tijd haar haren aanraken. Toen ik dichterbij kwam, merkte ik dat de speld uit haar chignon was.” Warnauts wees Mathilde op de losse speld en vroeg of hij die weer vast moest zetten. \"Ik ben wel een beetje bang. Wat als ik te hard duw?”, fluisterde hij in Mathildes oor. \"Duw maar!”, kreeg hij vervolgens te horen van de koningin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "575c5f25-1c94-4ea7-bcd9-c81ab0f3ec36",
                        "source_entry_id": "7953eebe-6628-3f33-a754-8ca5d77a62af",
                        "source_sense_id": "d07eec69-f8e1-372e-b9c5-56651b166703",
                        "source_sense_description": "gedraaide haarwrong achter op het hoofd",
                        "target_lang_word": "chignon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chignon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                        "entry_id": "bdd8a135-d383-3a31-945a-b49941d0b469",
                                        "glosses": [
                                            "A roll or twist of hair worn at the nape of the neck; a bun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13aed2eb-1a1f-4e9a-ad03-c1512b1d5b64",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "The chignon cannot be confounded with other artificialities which ladies put on and off."
                                            },
                                            {
                                                "example_id": "967cc9ee-bc5b-4c8d-be36-aad85d14fbd8",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "Madame du Barry could not merely be credited with inventing the chignons which bear her name."
                                            },
                                            {
                                                "example_id": "e94d5193-5b8d-4c4d-a521-cb5811f807ba",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "If I close my eyes I can see Marie today as I saw her then. Round, rosy face, snub nose, dark hair piled up in a chignon."
                                            },
                                            {
                                                "example_id": "c7497ce1-b9d6-4145-9666-9d1ee0baf4c2",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "The physician should evaluate for a history of tight ponytails, buns, chignons, braids, twists, weaves, cornrows, dreadlocks, sisterlocks, and hair wefts in addition to the usage of religious hair coverings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1d0384-fae4-3c47-b29f-88734409effb",
                                        "entry_id": "bdd8a135-d383-3a31-945a-b49941d0b469",
                                        "glosses": [
                                            "A temporary swelling on a neonate's head after a ventouse-assisted delivery."
                                        ],
