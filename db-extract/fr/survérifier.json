                ],
                "senses": [
                    {
                        "sense_id": "c9766a27-b6e7-3b5e-83eb-792d17476a60",
                        "entry_id": "49414f2b-599a-318c-b5e4-d9db3e069718",
                        "glosses": [
                            "Vérifier plus que la normale, plus qu’on ne le fait habituellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dfee05f-b747-4205-9b06-87adc1de2d08",
                                "sense_id": "c9766a27-b6e7-3b5e-83eb-792d17476a60",
                                "text": "Lorsque l’expert-comptable se sert uniquement de son jugement pour fixer la taille des échantillons, il est porté habituellement à survérifier, c’est-à-dire à examiner beaucoup plus d’opérations qu’il ne le devrait."
                            },
                            {
                                "example_id": "3d9a57af-f5c4-40d4-9997-bf7e45b5c9f6",
                                "sense_id": "c9766a27-b6e7-3b5e-83eb-792d17476a60",
                                "text": "J’ai jugé bon de survérifier : l’original, joint à une lettre d’Elisabeth à William Cecil, chancelier de Cambridge, ainsi que trois copies se trouvent dans un fonds d’archives indiscutable, Ipswich, et leur existence est enregistrée dans le Calendar of State Papers pour le 9 août 1561."
                            }
                        ]
                    }
                ],
