                        ],
                        "examples": [
                            {
                                "example_id": "3bab92bf-63ad-4d0c-b7df-47a4541aeeac",
                                "sense_id": "2a944e6c-bd55-3403-b60a-e95bb44c00ed",
                                "text": "„Der Vizeregierungschef ist in der Regel ein Spitzenpolitiker des größten Koalitionspartners.“"
                            },
                            {
                                "example_id": "e4c957b0-0de7-49bb-b992-ad2b5977271c",
                                "sense_id": "2a944e6c-bd55-3403-b60a-e95bb44c00ed",
                                "text": "„Gestern las Vizeregierungschef Boris Nemzow das endgültige Gutachten über die Echtheit.“"
                            },
                            {
                                "example_id": "2272c179-2906-4b3c-b4be-dc097968833c",
                                "sense_id": "2a944e6c-bd55-3403-b60a-e95bb44c00ed",
                                "text": "„Eher zufällig begegnete Vater, während wir auf den Fernreisebus warteten, Vizeregierungschef Xi Zhongxun, der einer Inspektionsreise nach Xinjiang gekommen war.“"
                            },
                            {
                                "example_id": "e1a84858-bb51-4a52-9e62-6b6611a2a9a2",
                                "sense_id": "2a944e6c-bd55-3403-b60a-e95bb44c00ed",
                                "text": "„Lächelnd reichte sie ihm einen Speicherstick mit Dateien, die Agenten des Vizeregierungschefs Timur Sawasin sorgfältig für ihn zusammengestellt hatten.“"
                            },
                            {
                                "example_id": "44ac9d70-60d9-44d4-8f4d-6633a05cca80",
                                "sense_id": "2a944e6c-bd55-3403-b60a-e95bb44c00ed",
                                "text": "[COVID-19-Pandemie:] „Zum Drängen des bayerischen Vizeregierungschefs und Wirtschaftsministers Hubert Aiwanger (Freie Wähler) auf eine raschere Lockerung etwa für die Gastronomie, sagte Söder: Ein Wirtschaftsminister habe primär die Wirtschaft im Blick, das sei selbstverständlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
