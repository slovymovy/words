                                        "entry_id": "0983e183-f793-3e7d-b07b-412b8a530fcb",
                                        "glosses": [
                                            "Celui qui examine, qui observe avec attention."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "015c43ad-3e1e-3323-9077-5e87056dd1c3",
                                        "entry_id": "0983e183-f793-3e7d-b07b-412b8a530fcb",
                                        "glosses": [
                                            "Celui qui juge le degré de connaissances de quelqu’un dans un examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2765885-b2f2-4fab-97d3-f19c50ddf7f5",
                                                "sense_id": "015c43ad-3e1e-3323-9077-5e87056dd1c3",
                                                "text": "Une prof de français passait le permis de conduire avec comme examinateur le père d'un élève qu'elle venait de faire redoubler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c18a23f-db8a-448e-bb57-5a3f7bc5e11b",
                        "source_entry_id": "f7dd5cd0-88dd-3ff9-b1c9-c3041fbb7636",
                        "source_sense_description": "person who investigates someone or something",
                        "target_lang_word": "examinatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "examinatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "221533e4-d3f0-3a5b-a349-e76e68edbcd3",
                                        "entry_id": "64b89ff9-7679-36e7-934a-afaee6460ed8",
                                        "glosses": [
                                            "Celle qui évalue les capacités d’autrui dans un domaine précis, lors d’un examen."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f78b00-0806-41d8-b666-b56e20fbe3b4",
                                                "sense_id": "221533e4-d3f0-3a5b-a349-e76e68edbcd3",
                                                "text": "Toutes les Églises ont droit d’être Examinatrices, mais l’usage de ce droit est limité dans le cercle des Églises qui sont Synodales."
                                            },
                                            {
                                                "example_id": "ab489c80-15c2-4c27-a2d0-288f0db5bb4a",
                                                "sense_id": "221533e4-d3f0-3a5b-a349-e76e68edbcd3",
                                                "text": "Après avoir suivi un cours d’histoire sur l’antiquité romaine, il subit un examen oral. Sur la base de certaines réponses de Pascal, l’examinatrice conclut que Pascal sait que Cicéron était un orateur romain qui a dénoncé Catilina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5681576a-7fa1-30fd-81f2-5daada99be85",
                                        "entry_id": "64b89ff9-7679-36e7-934a-afaee6460ed8",
                                        "glosses": [
                                            "Celle qui examine, qui observe avec attention."
                                        ],
                                        "tags": [
                                            "Moins courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fa581c-42fa-4725-a90f-fbebad6bfdb3",
                                                "sense_id": "5681576a-7fa1-30fd-81f2-5daada99be85",
                                                "text": "Mademoiselle P., outre un talent inégalé pour la béarnaise, cuisine avec discernement et est une examinatrice attentive de tous les plats que nous dégustons ensemble à l’occasion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "examinatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7a7eb8-12e7-30a5-b2f7-0667a3d5e4b5",
                                        "entry_id": "4c885f1b-90fd-3955-9274-26f37a0584d4",
                                        "glosses": [
                                            "Féminin singulier de examinateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec7430ca-559e-4a99-94d2-2e9cff6c95ff",
                                                "sense_id": "eb7a7eb8-12e7-30a5-b2f7-0667a3d5e4b5",
                                                "text": "Il ajoute que les âmes des animaux ont une certaine force examinatrice, à l’aide de laquelle, comme avec le secours d’un instinct, elles jugent rapidement ce qui leur est convenable ou nuisible, et le désirent ou le fuient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
