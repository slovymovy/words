                "senses": [
                    {
                        "sense_id": "9274c0cb-1975-319a-9d55-9683b79f60e6",
                        "entry_id": "5879fe94-7803-3919-88ea-8ac732032b99",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным Христос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa7d25f-be2d-4fba-95d0-f78e29690697",
                                "sense_id": "9274c0cb-1975-319a-9d55-9683b79f60e6",
                                "text": "― Свету, как в церкви в Христовую заутреню."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3b9dc99-a80b-3ecd-84c9-e4b4364a5f92",
                        "entry_id": "5879fe94-7803-3919-88ea-8ac732032b99",
                        "glosses": [
                            "божий, господний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c89863b-ee68-4bda-8fca-212438c4de39",
                                "sense_id": "a3b9dc99-a80b-3ecd-84c9-e4b4364a5f92",
                                "text": "Ты как хочешь ругайся, ― язык-то не на привязи, глотку-то не заткнешь, ― а скотина христовая чем виновата?.."
                            }
                        ]
                    }
