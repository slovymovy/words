                "senses": [
                    {
                        "sense_id": "a3d8b77a-841f-3105-b57b-fe318e1a2b87",
                        "entry_id": "b0d76db3-95f1-3d96-9e53-597905177f45",
                        "glosses": [
                            "Maßnahmen, die der Erhaltung der Sauberkeit der Nase / des Naseninnenraumes dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8153c377-bcda-42bb-b07d-3749eb261446",
                                "sense_id": "a3d8b77a-841f-3105-b57b-fe318e1a2b87",
                                "text": "„Das Ziel der Nasenpflege ist eine saubere, borkenfreie Nase mit intakter Mikrozirkulation und gesunder, rosiger sowie feuchter Schleimhaut.“"
                            },
                            {
                                "example_id": "231abcdf-674f-46c3-aac9-a0da92e1606a",
                                "sense_id": "a3d8b77a-841f-3105-b57b-fe318e1a2b87",
                                "text": "„Nasenpflege ist nur bei verstärkter Sekretion und Schleimhautreizungen/-erkrankungen erforderlich.“"
                            },
                            {
                                "example_id": "7c6912f7-b302-4df5-b751-309b26a15c90",
                                "sense_id": "a3d8b77a-841f-3105-b57b-fe318e1a2b87",
                                "text": "„Daher ist ausreichende Flüssigkeitsversorgung sinnvoll, aber auch Nasenpflege durch Salben und Öle ist wirksam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
