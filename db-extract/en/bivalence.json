                    },
                    {
                        "translation_id": "7221f467-bb54-48ac-8aa9-0c628a89442a",
                        "source_entry_id": "026af652-37ee-37a9-9b11-4f2cfed7943a",
                        "source_sense_id": "9df8aeac-a94b-38be-9fb2-08922b894ab3",
                        "source_sense_description": "state or quality of being bivalent",
                        "target_lang_word": "Bivalenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bivalenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                        "entry_id": "40b44a98-b6cf-3869-9569-f1fc5310e62f",
                                        "glosses": [
                                            "Eigenschaft, in zwei Zustände/Möglichkeiten eingeteilt zu sein, wie etwa „wahr“ und „falsch“"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d92bc06-e156-490c-a11a-fc179eb03de3",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Mehrwertige Logiken stellen das für die klassische Logik konstitutive Prinzip der Bivalenz in Frage und verwenden mehr als zwei Wahrheitswerte.“"
                                            },
                                            {
                                                "example_id": "a1af5f75-adbf-4a75-9514-d960b6a53c65",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Kant nimmt hier Unterscheidungen auf, mit denen etwa Cicero den Problemen begegnet, die sich auftun, wenn man weder das logische Prinzip der Bivalenz, mit dem häufig »das Fatum« resp. ein Determinismus verbunden wurde, noch die Freiheit des Willens aufgeben will.“"
                                            },
                                            {
                                                "example_id": "7f17054e-19a5-454e-8df2-d43ff57ce69b",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Gibt man das Prinzip der Bivalenz auf, dann ist eine kontingente Aussage über die Zukunft nicht wahr oder falsch, sondern unbestimmt […].“"
                                            },
                                            {
                                                "example_id": "4d51b323-d5ff-4c0d-bbfc-f00d2eb23eb9",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Die Erde wird sich in rechtem Glauben in dessen Bivalenz auch letzten Endes harmonisieren und zusammenstreben.“"
                                            },
                                            {
                                                "example_id": "61fcfed5-ad89-48ac-ac35-26eb81aec86e",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Die Bivalenz der Leistungsträgerschaft von Mediengütern liegt darin begründet, dass sie einerseits Inhalte (Bedeutungen, Wissen etc.) transportieren und andererseits durch ihre Herstellung Kosten verursachen.“"
                                            },
                                            {
                                                "example_id": "e6b04412-1eda-4aad-9c98-ba8e372520a1",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Auch wenn in dem Konzept der »Krise« stets die Bivalenz ihres Ausgangs mitgedacht war, hat es in der empirischen Forschung lange gedauert, bis der Blick sich entsprechend geweitet hat.“"
                                            },
                                            {
                                                "example_id": "b299cd90-3ff2-4932-9d31-4ecc144afbdd",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Die Bivalenz thermischer Kraftwerke gestattet bei längeren Versorgungskrisen die Umstellung von Öl auf Kohle.“"
                                            },
                                            {
                                                "example_id": "e7f25d20-97dd-4cde-bac8-0fec9d638308",
                                                "sense_id": "16260574-abc0-3c30-a930-335bb18348fa",
                                                "text": "„Man kann auch so formulieren: nicht Operationen erzeugen Paradoxien, sondern Beobachtungen, weil Beobachtungen die Bivalenz zweier differenter Werte umfaßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "085ccf4b-9b2b-32e4-b3ac-dee45f8b9521",
                                        "entry_id": "40b44a98-b6cf-3869-9569-f1fc5310e62f",
                                        "glosses": [
                                            "Eigenschaft, mit zwei anderen Atomen eine chemische Bindung eingehen zu können"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd1be33-b0d3-449d-834a-15724d37fa1b",
                                                "sense_id": "085ccf4b-9b2b-32e4-b3ac-dee45f8b9521",
                                                "text": "„Wenn Sauerstoff in dieser Verbindung bivalent enthalten ist, so muss dem Kohlenstoff ebenfalls Bivalenz zuerkannt werden.“"
                                            },
                                            {
                                                "example_id": "6b9b7a32-c1d9-48ff-bbe3-96f1156a0ff6",
                                                "sense_id": "085ccf4b-9b2b-32e4-b3ac-dee45f8b9521",
                                                "text": "„Eine andere Frage ist natürlich, ob der Zirkoniumwasserstoff wirklich eine chemische Verbindung darstellt, oder ob vielleicht eine feste Lösung vorliegt. Mit der Beantwortung dieser Frage hängt die eventuelle Bivalenz des Zirkoniums auf das engste zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
