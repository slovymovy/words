                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inigualable",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "af7fe1f5-2fe2-37c0-bfa7-eab0b986e643",
                                        "entry_id": "f7a58be1-b529-3faa-8245-bf6a619c87b6",
                                        "glosses": [
                                            "Que no se puede igualar (poner un mismo nivel o en igualdad con otro; hacer igual a otro en categoría, condición o características). Que no tiene igual: que no hay otro ser de la misma condición o las mismas características."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96bdaac2-074b-4b39-85ab-c107ddd6234f",
                                                "sense_id": "af7fe1f5-2fe2-37c0-bfa7-eab0b986e643",
                                                "text": "Con respecto a las cualidades preeminentes de sus enseñanzas, Yhe Tsongkhapa es inigualable entre todos los eruditos tibetanos"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2510dc34-8092-3b46-8d33-8d1c5e29507a",
                                        "entry_id": "f7a58be1-b529-3faa-8245-bf6a619c87b6",
                                        "glosses": [
                                            "Que no puede juzgar o estimar en la misma opinión o aprecio que a otro."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "25815934-eab2-3bea-af28-a953d38387c7",
