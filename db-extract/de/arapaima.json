                "senses": [
                    {
                        "sense_id": "2b15dfe3-24bd-3ddc-a9f1-cc94e15d6334",
                        "entry_id": "dab43beb-742e-30ce-ae38-ceff3a51d706",
                        "glosses": [
                            "Fisch der Familie Arapaimidae, speziell der Art Arapaima gigas"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1441b6-9274-4280-9f4c-2da8af2f27c4",
                                "sense_id": "2b15dfe3-24bd-3ddc-a9f1-cc94e15d6334",
                                "text": "Der Arapaima ist der größte schuppentragende Süßwasserfisch der Welt."
                            },
                            {
                                "example_id": "d61ad05f-8270-4dda-905f-220022d45f48",
                                "sense_id": "2b15dfe3-24bd-3ddc-a9f1-cc94e15d6334",
                                "text": "Der Arapaima kann eine Gesamtlänge von drei Metern und ein Gewicht von 200 kg erreichen."
                            },
                            {
                                "example_id": "93f269cd-29e2-4fe5-aa07-1d0142d3ea33",
                                "sense_id": "2b15dfe3-24bd-3ddc-a9f1-cc94e15d6334",
                                "text": "Der Arapaima lebt in dicht mit Wasser- und Uferpflanzen bewachsenen Gewässern periodisch überschwemmter Gebiete des Amazonas und Orinokos sowie deren Nebenflüssen."
                            }
                        ],
