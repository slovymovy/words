                "senses": [
                    {
                        "sense_id": "9672ca66-4ba8-323a-a9af-60af66c9f6d2",
                        "entry_id": "388c8e5a-be5b-3184-a0a3-9b7ed820003c",
                        "glosses": [
                            "het niet van plaats of standpunt kunnen of willen veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966ac2a6-ff5d-43e7-93e3-f5d6911f406b",
                                "sense_id": "9672ca66-4ba8-323a-a9af-60af66c9f6d2",
                                "text": "Het ontdekken van deze wetten is slechts mogelijk wanneer wij afzien van iedere poging de oorzaken te zoeken in de wil van een enkele persoon, net zoals het ontdekken van de wetten van de beweging der planeten pas mogelijk was toen de mensen afstand deden van het begrip van de onbeweeglijkheid van de aarde."
                            },
                            {
                                "example_id": "eed8dce0-8805-4032-b00a-d4372bc918fe",
                                "sense_id": "9672ca66-4ba8-323a-a9af-60af66c9f6d2",
                                "text": "De verwachtingen over de driedaagse top in Bonn zijn laaggespannen. Het geruzie tussen rijk en arm is al weer begonnen. Een woordvoerder voor de arme landen zei dat zij best bereid zijn om verder te gaan dan de eisen van Kyoto, maar dat het probleem vooral de onbeweeglijkheid van de rijke landen is."
                            }
                        ]
                    }
