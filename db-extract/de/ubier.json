                "senses": [
                    {
                        "sense_id": "af5ee05b-96e5-3744-91af-74bf68091f5f",
                        "entry_id": "cab02f78-e32e-326d-8904-5aa1975d89ac",
                        "glosses": [
                            "Angehöriger des gleichnamigen antiken Germanenstammes, der zuletzt im Gebiet der heutigen Stadt Köln siedelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45aca7f3-f0cd-4263-bc76-5810d3760004",
                                "sense_id": "af5ee05b-96e5-3744-91af-74bf68091f5f",
                                "text": "„Später überschreitet Agrippa den Fluss, auch um die feindlichen Germanenstämme abzuschrecken, und siedelt einen mit Rom verbündeten Volksstamm, die Ubier, zur Verteidigung um.“"
                            },
                            {
                                "example_id": "05fb401d-10ef-4daf-8928-f37f86f1fffc",
                                "sense_id": "af5ee05b-96e5-3744-91af-74bf68091f5f",
                                "text": "„Die meisten von ihnen waren Bataver und Ubier und stammten vom Niederrhein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
