                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "milk pail",
                                "target_lang_sense_clarification": "wooden vessel for milking"
                            },
                            {
                                "target_lang_word": "milk bucket",
                                "target_lang_sense_clarification": "wooden vessel for milking"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13ec71ef-7252-3e84-819c-5674da9799a6",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>staren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "staren_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>staar</w> uit het raam en denk na over mijn toekomst.",
                            "target_lang_translations": {
                                "en": "I <w>stare</w> out the window and think about my future."
                            }
                        },
                        {
                            "text": "Soms <w>staar</w> ik urenlang naar de sterrenhemel zonder aan iets speciaals te denken.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>stare</w> at the starry sky for hours without thinking of anything in particular."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik staar"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'staren' (to stare)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stare",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
