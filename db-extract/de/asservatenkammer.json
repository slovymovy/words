                "senses": [
                    {
                        "sense_id": "7800f244-fcbc-36ec-9204-d18c66a8337e",
                        "entry_id": "1b16fd39-5d4f-3654-9a82-47fc318fec37",
                        "glosses": [
                            "ein zumeist speziell gesicherter Raum bei der Polizei, dem Zoll und der Staatsanwaltschaft, in dem sichergestellte oder beschlagnahmte Gegenstände verwahrt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e6e078-ab72-4da2-8003-bb72e4043083",
                                "sense_id": "7800f244-fcbc-36ec-9204-d18c66a8337e",
                                "text": "Nach der Beschlagnahmung durch die Polizei werden die Tatwerkzeuge bis zur Verhandlung in der Asservatenkammer aufbewahrt."
                            },
                            {
                                "example_id": "f3ecb9cb-d1a6-42ce-ac90-f71f544134c1",
                                "sense_id": "7800f244-fcbc-36ec-9204-d18c66a8337e",
                                "text": "Statt die Geräte während der oft jahrelangen Ermittlungen und Verfahren in der Asservatenkammer vergammeln zu lassen, wurden sie von der Kriminalpolizei genutzt."
                            },
                            {
                                "example_id": "d5063c4a-ef92-45c8-be79-dc154c432418",
                                "sense_id": "7800f244-fcbc-36ec-9204-d18c66a8337e",
                                "text": "Die Computer sollten unverzüglich in die Asservatenkammer gebracht werden, die Dateien auf einen \"dienstlich zugewiesenen PC\" übertragen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
