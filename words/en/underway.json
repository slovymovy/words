{
    "word_family": [
        "under"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "efd669fa-2c08-32c4-9ba3-d3ce899dee6d",
                    "sense_definition": "In motion, in progress; being done or carried out.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is now well <w>underway</w> and showing positive results.",
                            "target_lang_translations": {
                                "ru": "Проект сейчас идет <w>полным ходом</w> и показывает положительные результаты.",
                                "pl": "Projekt idzie już <w>pełną parą</w> i przynosi pozytywne rezultaty."
                            }
                        },
                        {
                            "text": "Preparations for the annual festival are already <w>underway</w>.",
                            "target_lang_translations": {
                                "ru": "Подготовка к ежегодному фестивалю уже <w>ведётся</w>.",
                                "pl": "Przygotowania do dorocznego festiwalu są już <w>w toku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "in progress",
                        "ongoing",
                        "started",
                        "begun",
                        "afoot"
                    ],
                    "antonyms": [
                        "finished",
                        "halted",
                        "stopped"
                    ],
                    "common_phrases": [
                        "get underway",
                        "well underway",
                        "be underway"
                    ],
                    "target_lang_definitions": {
                        "ru": "В процессе движения, развития или выполнения; происходящий в данный момент",
                        "pl": "W trakcie trwania lub realizacji; w toku, odbywający się w danej chwili."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в процессе",
                                "target_lang_sense_clarification": "о действии или работе"
                            },
                            {
                                "target_lang_word": "полным ходом",
                                "target_lang_sense_clarification": "идиома: активно, интенсивно"
                            },
                            {
                                "target_lang_word": "ведётся",
                                "target_lang_sense_clarification": "осуществляется (о подготовке, работе)"
                            },
                            {
                                "target_lang_word": "в движении",
                                "target_lang_sense_clarification": "буквально: перемещающийся"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "w toku",
                                "target_lang_sense_clarification": "w trakcie trwania, realizacji"
                            },
                            {
                                "target_lang_word": "w trakcie",
                                "target_lang_sense_clarification": "podczas realizacji"
                            },
                            {
                                "target_lang_word": "pełną parą",
                                "target_lang_sense_clarification": "o intensywnie trwającym procesie (well underway)"
                            },
                            {
                                "target_lang_word": "trwać",
                                "target_lang_sense_clarification": "być realizowanym (używane w formie czasownikowej)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9aacf9c-2c37-3e8d-b756-4a5adc1f954e",
                    "sense_definition": "A road, track, or path for going under another way or obstacle; an underpass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "underground_passage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city planners designed a new <w>underway</w> to relieve traffic congestion.",
                            "target_lang_translations": {
                                "ru": "Городские планировщики спроектировали новый <w>подземный проезд</w>, чтобы разгрузить движение.",
                                "pl": "Urbaniści zaprojektowali nowy <w>przejazd podziemny</w>, aby rozładować zatory drogowe."
                            }
                        },
                        {
                            "text": "Pedestrians used the <w>underway</w> to cross safely beneath the busy highway.",
                            "target_lang_translations": {
                                "ru": "Пешеходы использовали <w>подземный переход</w>, чтобы безопасно пересечь оживленное шоссе.",
                                "pl": "Piesi skorzystali z <w>przejścia podziemnego</w>, aby bezpiecznie przedostać się pod ruchliwą autostradą."
                            }
                        }
                    ],
                    "synonyms": [
                        "underpass",
                        "subway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дорога или путь, проходящие под другим путем или препятствием; подземный проезд",
                        "pl": "Droga, ścieżka lub przejście biegnące pod inną trasą lub przeszkodą; przejście podziemne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подземный проезд",
                                "target_lang_sense_clarification": "для транспорта"
                            },
                            {
                                "target_lang_word": "подземный переход",
                                "target_lang_sense_clarification": "для пешеходов"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przejście podziemne",
                                "target_lang_sense_clarification": "dla pieszych"
                            },
                            {
                                "target_lang_word": "przejazd podziemny",
                                "target_lang_sense_clarification": "dla pojazdów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6242efce-d1fc-3061-a8a6-fa5a8ad294aa",
                    "sense_definition": "An underground passage, subway, or tunnel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "underground_passage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They explored the dark <w>underway</w> that ran beneath the old castle.",
                            "target_lang_translations": {
                                "ru": "Они исследовали темный <w>подземный ход</w>, который проходил под старым замком.",
                                "pl": "Eksplorowali ciemny <w>tunel</w>, który biegł pod starym zamkiem."
                            }
                        },
                        {
                            "text": "The train sped through the <w>underway</w> connecting the two stations.",
                            "target_lang_translations": {
                                "ru": "Поезд мчался через <w>туннель</w>, соединяющий две станции.",
                                "pl": "Pociąg pędził przez <w>tunel</w> łączący obie stacje."
                            }
                        }
                    ],
                    "synonyms": [
                        "tunnel",
                        "subway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подземный проход или туннель",
                        "pl": "Podziemne przejście, korytarz lub tunel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подземный ход",
                                "target_lang_sense_clarification": "скрытый или старинный проход"
                            },
                            {
                                "target_lang_word": "туннель",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "tunel",
                                "target_lang_sense_clarification": "ogólne określenie korytarza pod ziemią"
                            },
                            {
                                "target_lang_word": "przejście podziemne",
                                "target_lang_sense_clarification": "podziemny korytarz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71da4248-dd52-365a-9878-ea01b6e14443",
                    "sense_definition": "A voyage, especially one taken underwater or by a naval vessel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine crew prepared themselves for a long <w>underway</w>.",
                            "target_lang_translations": {
                                "ru": "Экипаж подводной лодки готовился к длительному <w>походу</w>.",
                                "pl": "Załoga okrętu podwodnego przygotowywała się na długi <w>rejs</w>."
                            }
                        },
                        {
                            "text": "He recalled his first <w>underway</w> as a young naval officer.",
                            "target_lang_translations": {
                                "ru": "Он вспоминал свой первый <w>выход в море</w> в качестве молодого морского офицера.",
                                "pl": "Wspominał swój pierwszy <w>rejs</w> w roli młodego oficera marynarki wojennej."
                            }
                        }
                    ],
                    "synonyms": [
                        "voyage",
                        "journey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морское путешествие или поход, особенно на военном корабле или подводной лодке",
                        "pl": "Rejs morski, szczególnie podwodny lub realizowany przez okręt wojenny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поход",
                                "target_lang_sense_clarification": "военно-морской термин"
                            },
                            {
                                "target_lang_word": "плавание",
                                "target_lang_sense_clarification": "путешествие по воде"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rejs",
                                "target_lang_sense_clarification": "wyprawa morska lub podwodna"
                            },
                            {
                                "target_lang_word": "rejs bojowy",
                                "target_lang_sense_clarification": "rejs okrętu marynarki wojennej"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}