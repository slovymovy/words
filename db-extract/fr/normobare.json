                        "entry_id": "f51a25c1-26db-3648-91b0-37d4ef19a3a5",
                        "glosses": [
                            "Qualifiant un mélange gazeux dont la pression est égale à une atmosphère (l'atmosphère ici étant l'unité de mesure de la pression atmosphérique au niveau de la mer)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9627c2e2-443b-485e-b54d-10a76f32f79e",
                                "sense_id": "46821ac9-97ef-357f-9ae8-61c88c1c66df",
                                "text": "À domicile, l'oxygénothérapie normobare (bouteilles, obus, extracteurs) se fait à la pression atmosphérique qui est, par définition, d'une atmosphère (1 atm) ou de 760 mmHg, par inhalation avec canule nasale, lunettes, ou masque."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb8973c1-fa2b-36e5-bd69-cc93b496f18a",
                        "entry_id": "f51a25c1-26db-3648-91b0-37d4ef19a3a5",
                        "glosses": [
                            "Qualifiant un mélange gazeux dont la composition se différencie de l'air atmosphérique par modification du poids des différents corps gazeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949939a1-4849-4ed6-a545-7ed4fe14913b",
                                "sense_id": "bb8973c1-fa2b-36e5-bd69-cc93b496f18a",
                                "text": "Les sujets spécialistes de sport d'endurance (cyclisme, triathlon, ski de fond) ont pendant 23 jours dormi 8 à 10 heures dans une chambre hypoxique (hypoxie normobare)."
                            },
                            {
                                "example_id": "cef17dd9-dace-40a6-9df9-cef41be0f826",
                                "sense_id": "bb8973c1-fa2b-36e5-bd69-cc93b496f18a",
                                "text": "... les sujets du groupe expérimental participent à quatre séances d'IHE normobare d'une durée de 5 min chacune (concentration moyenne d'oxygène de 12,6%, à savoir une altitude simulée de 4000 m)..."
                            }
                        ]
                    }
