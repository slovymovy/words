                "senses": [
                    {
                        "sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                        "entry_id": "a2a1625e-8ada-3e7f-8388-d2380cc9ea8e",
                        "glosses": [
                            "besonders stabiler, tiefreichender Teil der Erdkruste, der bei tektonischer Beanspruchung nicht mit Faltung, sondern nur noch mit Bruchbildung reagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a905f583-7390-40c5-a698-a133612d44de",
                                "sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                                "text": "Gegenüber tektonischen Spannungen erweisen sich Kratone als sehr stabil, es kommt dort meist nur zu weitgespannten Verbiegungen der Erdkruste (Epirogenese)."
                            },
                            {
                                "example_id": "c6cd3717-b978-4d87-bad1-5314e16f13e7",
                                "sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                                "text": "Kratone gliedern sich geologisch in Schilde und Tafeln."
                            },
                            {
                                "example_id": "68122558-2f14-4dca-9d07-3d23e011ae2e",
                                "sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                                "text": "Das offen zutageliegende Kraton des Baltischen Schildes – die Halbinsel Kola – ist wichtiger Rohstofflieferant Russlands."
                            },
                            {
                                "example_id": "9cebb0ed-c6d7-4030-af36-8a603cc1e6fc",
                                "sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                                "text": "Die „Brutstätte“ der Diamanten sind die Kratone, die tiefen Wurzeln der Kontinente."
                            },
                            {
                                "example_id": "6e77e769-b95d-4fa5-98f4-e129671ebe8f",
                                "sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                                "text": "In den zu diesem Kraton gehörenden Narryer- und Jack-Hill-Gneisen wurden im Jahr 1986 mikroskopisch kleine Einschlüsse von Zirkonkristallen entdeckt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b0e1528-1248-46d3-bac7-16f14e81c7cb",
                        "source_entry_id": "a2a1625e-8ada-3e7f-8388-d2380cc9ea8e",
                        "source_sense_id": "0d5999e6-8eab-354b-8d96-ed4fb02293bb",
                        "target_lang_word": "craton",
