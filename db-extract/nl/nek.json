                ],
                "senses": [
                    {
                        "sense_id": "53ef6817-30b3-3cea-80b7-e1ebe3e652e0",
                        "entry_id": "37461b7f-012c-3931-bbc0-ec4346e8ca88",
                        "glosses": [
                            "achterste gedeelte van de hals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf30ef0-2080-4798-b3d9-0929eb804ab3",
                                "sense_id": "53ef6817-30b3-3cea-80b7-e1ebe3e652e0",
                                "text": "Haar nek deed pijn en haar hoofd bonkte."
                            },
                            {
                                "example_id": "dab3931f-99f3-4230-8f76-2ca49224fc66",
                                "sense_id": "53ef6817-30b3-3cea-80b7-e1ebe3e652e0",
                                "text": "Ik droeg een pet met een lange achterflap om mijn nek te beschermen tegen de zon."
                            },
                            {
                                "example_id": "07c2ee20-a723-4400-adb8-d19f2a9d2d9b",
                                "sense_id": "53ef6817-30b3-3cea-80b7-e1ebe3e652e0",
                                "text": "Maar Teresa zweeg, met haar blik nog steeds op de uitgebrande kerk gericht, en het was alsof Olive de harde, donkere haarpunten in haar eigen nek voelde vallen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11af18a5-9ba7-48a5-b33a-54d01f281c5a",
                        "source_entry_id": "37461b7f-012c-3931-bbc0-ec4346e8ca88",
                        "source_sense_id": "53ef6817-30b3-3cea-80b7-e1ebe3e652e0",
                        "source_sense_description": "achterste gedeelte van de hals",
                        "target_lang_word": "Nacken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nacken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "294db349-ac08-3522-b5e3-067698d88eae",
                                        "entry_id": "b394db34-c1cf-353c-b02b-fc0fe593d56f",
                                        "glosses": [
                                            "der dorsale (rückseitige) Teil des Halses, das Genick"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debd2cf6-fe7d-49b2-9970-fe8574c8646a",
                                                "sense_id": "294db349-ac08-3522-b5e3-067698d88eae",
                                                "text": "Er bekam einen Schlag in den Nacken."
                                            },
                                            {
                                                "example_id": "fa7547ad-13b1-4b3e-9625-c97b3934e09c",
                                                "sense_id": "294db349-ac08-3522-b5e3-067698d88eae",
                                                "text": "„Die junge Frau mit dem ausrasierten Nacken erwiderte etwas im Flüsterton, worauf beide losprusteten.“"
                                            },
                                            {
                                                "example_id": "ce24cb5a-2adb-48da-beb7-6ffefe362c1b",
                                                "sense_id": "294db349-ac08-3522-b5e3-067698d88eae",
                                                "text": "„Drei geflochtene Zöpfe hingen über den schlanken Nacken der Frau.“"
                                            },
                                            {
                                                "example_id": "0fb7aa1f-19fd-455e-b765-91b602ad2dbe",
                                                "sense_id": "294db349-ac08-3522-b5e3-067698d88eae",
                                                "text": "„Er sah sich an, wie er dort unten lag: hingestreckt, die beiden Hände neben sich, den Kopf im Nacken und die Beine leicht angewinkelt.“"
                                            },
                                            {
                                                "example_id": "40a59bb8-3faa-48d8-9657-28841b0d10ed",
                                                "sense_id": "294db349-ac08-3522-b5e3-067698d88eae",
                                                "text": "„Auch er zitterte stark, war blau angelaufen und legte bereits den Kopf in den Nacken, um knapp über der Wasseroberfläche noch Luft holen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a4cab6-35f6-4fd3-b2ff-d8284843289e",
