                        "examples": [
                            {
                                "example_id": "64e943fa-851c-48ff-b71b-004702ff9224",
                                "sense_id": "af8cfaac-13e5-379b-9bf5-c81d7f983e3f",
                                "text": "Blowproof water has given the Navy the weapon it needed to fight fires with helicopters. Previously, the downwash from the rotor blades blew the foam, or whatever agent was being used, off the fire, nullifying its effect."
                            },
                            {
                                "example_id": "137815b7-ff86-4c06-9758-3a287af1da59",
                                "sense_id": "af8cfaac-13e5-379b-9bf5-c81d7f983e3f",
                                "text": "Besides, the candles are blowproof—they can't be blown out."
                            }
                        ]
                    }
