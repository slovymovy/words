        "pl-extract.jsonl": [
            {
                "entry_id": "18342a01-a7f0-3987-860e-f5afec3b4040",
                "word": "ofiarny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26c011ed-6e38-354c-8092-fd1e8e33e21b",
                        "entry_id": "18342a01-a7f0-3987-860e-f5afec3b4040",
                        "glosses": [
                            "gotowy do poświęceń, oddany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7481e499-c0f1-46dd-af8a-a75e6b07b62e",
                                "sense_id": "26c011ed-6e38-354c-8092-fd1e8e33e21b",
                                "text": "…Legiony to żołnierska buta, • Legiony to ofiarny stos"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "21463f7c-8bfe-387d-a5b3-c9dfdd2dd84b",
                        "entry_id": "18342a01-a7f0-3987-860e-f5afec3b4040",
                        "glosses": [
                            "związany ze składaniem ofiar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4961db-711c-489a-a067-436c01495fda",
                                "sense_id": "21463f7c-8bfe-387d-a5b3-c9dfdd2dd84b",
                                "text": "Diokles (…) bił czołem w marmur, a modlitwa płynęła mu tak z głębin duszy, jak dym ofiarny płynie z kadzielnicy"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be015674-0e9f-4650-86d5-79a214a4bb94",
                        "source_entry_id": "18342a01-a7f0-3987-860e-f5afec3b4040",
                        "source_sense_id": "26c011ed-6e38-354c-8092-fd1e8e33e21b",
                        "target_lang_word": "sacrificial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrificial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ad58ee-ecd8-36e6-a984-34a1fdfeda60",
                                        "entry_id": "ccd6da9a-7252-3d64-99e1-81403bed6857",
                                        "glosses": [
                                            "Relating to sacrifice"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebb1570-2aed-4e64-999b-b736c6e27874",
                                                "sense_id": "d6ad58ee-ecd8-36e6-a984-34a1fdfeda60",
                                                "text": "The old sacrificial well is still there, but animals aren't thrown into it to appease monsters anymore."
                                            },
                                            {
                                                "example_id": "d451a3ec-f5fc-4b53-9b58-44f3537c7dbf",
                                                "sense_id": "d6ad58ee-ecd8-36e6-a984-34a1fdfeda60",
                                                "text": "Rabban Yoḥanan could have succumbed to despair like many at that time. Instead, he looked for alternatives to the sacrificial system, because he understood that it would take a long time to rebuild the Temple and the Jewish people needed other ways to worship God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb1ed86-4c41-3213-a992-a512e94d624f",
                                        "entry_id": "ccd6da9a-7252-3d64-99e1-81403bed6857",
                                        "glosses": [
                                            "Used as a sacrifice."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71d78fc-afaf-4fe7-b8fa-a5a695300bc8",
                                                "sense_id": "8fb1ed86-4c41-3213-a992-a512e94d624f",
                                                "text": "The ceremony involves the ritual slaying of a sacrificial lamb."
                                            },
                                            {
                                                "example_id": "bebfe0be-4c54-4ca5-9826-198fd417f96a",
                                                "sense_id": "8fb1ed86-4c41-3213-a992-a512e94d624f",
                                                "text": "The sacrificial coating protects the hull, but because it takes the damage the hull doesn't, we must replace it annually."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69424c7a-b79d-4fa2-a845-28e69e52ad8d",
                        "source_entry_id": "18342a01-a7f0-3987-860e-f5afec3b4040",
                        "source_sense_id": "26c011ed-6e38-354c-8092-fd1e8e33e21b",
                        "target_lang_word": "беззаветный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беззаветный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "949b1418-3790-32b4-8fb0-07b29171ac9b",
                                        "entry_id": "7a29c198-3bd6-3a00-bc37-9a293f9ac04e",
                                        "glosses": [
                                            "чуждый расчёта, корысти, доходящий до самозабвения, искренний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7e7415-53e7-4afa-8fc2-04b1927c93d8",
                                                "sense_id": "949b1418-3790-32b4-8fb0-07b29171ac9b",
                                                "text": "Нелли всё ещё стыдилась слишком прямого, слишком беззаветного проявления своего чувства…"
                                            },
                                            {
                                                "example_id": "71661735-2edd-484a-b217-d28033d106c7",
                                                "sense_id": "949b1418-3790-32b4-8fb0-07b29171ac9b",
                                                "text": "Замечательно то, что именно эти люди с особенной беззаветностью преданы литературе и для нее готовы пожертвовать всем."
                                            },
                                            {
                                                "example_id": "34a50f05-1eeb-4748-b6f4-f277b355c139",
                                                "sense_id": "949b1418-3790-32b4-8fb0-07b29171ac9b",
                                                "text": "Дело, однако, вот в чём: в личности Керенского демократизм и борьба за революцию, не в пример многим другим политическим фигурам, были далеки от той беззаветности, которая граничит с отрешением деятеля от самого себя."
                                            },
                                            {
                                                "example_id": "6ba57767-2a58-4116-8557-a3dcf271f45d",
                                                "sense_id": "949b1418-3790-32b4-8fb0-07b29171ac9b",
                                                "text": "Я всегда замечал, что перед всем, что носит печать любви, искреннего увлечения, беззаветности, коммунисты или умолкают, или стервенеют."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2db62a22-98e8-4093-b0ec-cbffe9f1e52b",
                        "source_entry_id": "18342a01-a7f0-3987-860e-f5afec3b4040",
