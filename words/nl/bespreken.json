                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "изучать вопрос в ходе беседы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5b3c6c2-399d-3cf3-a334-a2e3e6cdab98",
                    "sense_definition": "vooruit bestellen of reserveren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reserveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilden voor de voorstelling twee plaatsen <w>bespreken</w> bij de kassa.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>reserve</w> two seats for the performance at the box office.",
                                "ru": "Они хотели <w>забронировать</w> два места на представление в кассе."
                            }
                        },
                        {
                            "text": "Ik wil graag een tafel <w>bespreken</w> voor vier personen vanavond.",
                            "target_lang_translations": {
                                "en": "I would like to <w>book</w> a table for four people tonight.",
                                "ru": "Я бы хотел <w>заказать</w> столик на четверых на сегодня."
                            }
                        }
