                                "example_id": "965881f0-a910-4e04-a32c-023e7a45b792",
                                "sense_id": "796863bb-0131-3e0d-b02e-a09eaa2f703c",
                                "text": "„Das Aitel ist sehr anpassungsfähig und lebt in allen fließenden und auch stehenden Gewässern von der Forellen- bis zur Brachsenregion.“"
                            }
                        ],
