                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surround",
                                "target_lang_sense_clarification": "to enclose from all sides"
                            },
                            {
                                "target_lang_word": "encircle",
                                "target_lang_sense_clarification": "to form a circle around"
                            },
                            {
                                "target_lang_word": "hem in",
                                "target_lang_sense_clarification": "to trap by surrounding"
                            }
                        ]
