                    {
                        "translation_id": "89043303-193f-4f22-9a93-67fe661e0f05",
                        "source_entry_id": "a5d2429d-a01f-3416-9648-63b9dce6db85",
                        "source_sense_description": "unable to decide",
                        "target_lang_word": "hin- und hergerissen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hin- und hergerissen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                        "entry_id": "2a600aba-9185-315e-aae7-012541d8136a",
                                        "glosses": [
                                            "aus zwei Alternativen sich nicht entscheiden könnend; nicht wissend, welche Wahl man treffen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5303304a-b43e-41af-8e79-d355db1208cf",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "„Ich bin hin- und hergerissen, ob ich den Job in München annehmen oder zu meiner Freundin nach Berlin ziehen soll.“"
                                            },
                                            {
                                                "example_id": "a1a2aceb-87d0-451e-8582-b89c3cde2bf2",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "„Was soll ich bloß studieren, Kunst oder Architektur? Ich bin hin- und hergerissen.“"
                                            },
                                            {
                                                "example_id": "6adde7a5-5e4d-48bf-9882-817fd0e99ab8",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "A: „Ich habe mich gerade von meinem Freund getrennt.“ B: „Und, wie geht es Dir dabei?“ A: „Ich bin hin- und hergerissen: einerseits vermisse ich ihn ein wenig, andererseits bin ich froh, dass ich ihn nicht mehr sehen muss.“"
                                            },
                                            {
                                                "example_id": "58a6d916-f8d4-4fef-ad7a-c7b2859f4768",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "Als Flüchtling ist man, das ist doch klar, hin- und hergerissen: auf der einen Seite hat man seine Muttersprache und seine Erinnerungen an das Land, aus dem man kommt, auf der anderen Seite hat man seine Zukunft in dem Land, in das man geflüchtet ist."
                                            },
                                            {
                                                "example_id": "0a7db29b-2df0-42a4-9540-e87f8f612ff5",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "„Ich war hin- und hergerissen zwischen der Frage: Finde ich das jetzt gut, was hier passiert? Oder ist das nicht total furchtbar? Ich kam zurück und musste feststellen, ich habe überhaupt keine Antwort darauf gefunden.“"
                                            },
                                            {
                                                "example_id": "2f1a6763-9926-40c5-917d-3b7b15e00e9e",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "Pierre Kretz hat sich intensiv mit der Geschichte des deutsch-französischen Grenzgebiets beschäftigt und einen Roman geschrieben über die unglückliche ambivalente Lage des Elsass, hin- und hergerissen zwischen Deutschland und Frankreich."
                                            },
                                            {
                                                "example_id": "1c0f68a4-f78b-421f-89f4-96d29a27d87a",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "Hin- und hergerissen zwischen Optimismus und Skepsis [sind] auch die Vertreter der SPD."
                                            },
                                            {
                                                "example_id": "65ce37ab-c58d-4e38-8a94-2b92b863deb6",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "Deutschlandradio: „[…] Wünschen Sie sich eine Neuauflage dieser Koalition? Finden Sie das gut?“ F. Merz: „Ich bin da, offen gestanden, ziemlich hin- und hergerissen. […]“"
                                            },
                                            {
                                                "example_id": "3f66050a-df84-45c6-aedc-41894bb9e928",
                                                "sense_id": "7ce2092b-16c4-32cb-92f4-a1b6323be6fe",
                                                "text": "„In dem zwischen Archias Geleitern und dem Melissos und seinen Freunden und Nachbaren darüber entstandenen Handgemenge gab der von beiden Seiten hin und hergerissene Knabe den Geist auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
