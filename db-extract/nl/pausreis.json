                        "glosses": [
                            "officiële reis gemaakt door het hoofd van de Rooms-Katholieke Kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1525ee0d-c9bf-4728-b649-66e7c0b87dc5",
                                "sense_id": "29146bd4-f398-3c61-a86b-6303e739ef61",
                                "text": "Paus Benedictus XVI brengt volgende week tijdens zijn reis naar de VS een bezoek aan Ground Zero in New York, de plaats waar op 11 september 2001 de Twin Towers na terroristische aanslagen tegen de vlakte gingen. Het wordt het aangrijpendste moment van de pausreis, meldt de Vlaamse nieuwsdienst KerkNet."
                            },
                            {
                                "example_id": "e8615ca5-5364-4ccf-afea-e14fa156e657",
                                "sense_id": "29146bd4-f398-3c61-a86b-6303e739ef61",
                                "text": "Dat is gebleken uit het officiële programma voor het pausbezoek, dat het Vaticaan traditioneel een maand voor het bezoek bekendmaakt en waarover de nieuwsdienst Kerknet donderdagmorgen berichtte. De pausreis staat in het teken van onder andere de zaligverklaring van de Britse kardinaal John Henry Newman."
                            }
                        ]
                    }
