{
    "word_family": [
        "образование",
        "образованный",
        "образовательный",
        "образ",
        "образный",
        "образовывать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10ada06f-81f2-35a3-8a2d-1654209edd12",
                    "sense_definition": "Возникнуть, появиться в результате какого-либо процесса.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за сильного мороза на окнах <w>образовались</w> красивые узоры.",
                            "target_lang_translations": {
                                "tr": "Şiddetli soğuk yüzünden pencerelerde güzel desenler <w>oluştu</w>."
                            }
                        },
                        {
                            "text": "В результате химической реакции <w>образовалось</w> новое вещество.",
                            "target_lang_translations": {
                                "tr": "Kimyasal reaksiyon sonucunda yeni bir madde <w>meydana geldi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "возникнуть",
                        "появиться",
                        "сформироваться"
                    ],
                    "antonyms": [
                        "исчезнуть",
                        "пропасть"
                    ],
                    "common_phrases": [
                        "образовалась трещина",
                        "образовалась пробка"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir süreç sonucunda meydana gelmek, oluşmak veya ortaya çıkmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "oluşmak",
                                "target_lang_sense_clarification": "Bir şeyin meydana gelmesi veya şekillenmesi anlamında en genel kullanım."
                            },
                            {
                                "target_lang_word": "meydana gelmek",
                                "target_lang_sense_clarification": "Bir olayın veya durumun ortaya çıkması."
                            },
                            {
                                "target_lang_word": "belirmek",
                                "target_lang_sense_clarification": "Görünür hale gelmek, ortaya çıkmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abfa7c8a-dce1-341c-8871-fe66e39b7490",
                    "sense_definition": "Сформироваться как группа, организация или сообщество.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новая научная группа <w>образовалась</w> в прошлом году.",
                            "target_lang_translations": {
                                "tr": "Yeni bir bilim grubu geçen yıl <w>kuruldu</w>."
                            }
                        },
                        {
                            "text": "Вокруг известного профессора <w>образовался</w> круг талантливых студентов.",
                            "target_lang_translations": {
                                "tr": "Ünlü profesörün etrafında yetenekli öğrencilerden oluşan bir çevre <w>oluştu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сформироваться",
                        "организоваться",
                        "создаться"
                    ],
                    "common_phrases": [
                        "образовалась группа",
                        "образовалась компания"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir grup, organizasyon veya topluluk olarak şekillenmek veya kurulmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kurulmak",
                                "target_lang_sense_clarification": "Bir organizasyonun veya grubun resmi olarak oluşturulması."
                            },
                            {
                                "target_lang_word": "oluşmak",
                                "target_lang_sense_clarification": "Bir topluluğun bir araya gelerek bir yapı oluşturması."
                            },
                            {
                                "target_lang_word": "teşekkül etmek",
                                "target_lang_sense_clarification": "Resmi veya yapısal bir oluşumun meydana gelmesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8adf6ec-31e1-3b58-9404-1e832d294f3d",
                    "sense_definition": "Благополучно устроиться, разрешиться (о ситуации).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не волнуйся, всё <w>образуется</w> само собой.",
                            "target_lang_translations": {
                                "tr": "Endişelenme, her şey kendiliğinden <w>yoluna girecek</w>."
                            }
                        },
                        {
                            "text": "Я уверен, что эта сложная ситуация скоро <w>образуется</w>.",
                            "target_lang_translations": {
                                "tr": "Bu karmaşık durumun yakında <w>hallolacağından</w> eminim."
                            }
                        }
                    ],
                    "synonyms": [
                        "уладиться",
                        "устроиться"
                    ],
                    "common_phrases": [
                        "всё образуется"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Часто используется в разговорной речи для успокоения."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir durumun veya sorunun kendiliğinden çözülmesi, yoluna girmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yoluna girmek",
                                "target_lang_sense_clarification": "Sorunlu bir durumun düzelmesi."
                            },
                            {
                                "target_lang_word": "hallolmak",
                                "target_lang_sense_clarification": "Bir meselenin çözüme kavuşması."
                            },
                            {
                                "target_lang_word": "düzelmek",
                                "target_lang_sense_clarification": "Kötü giden bir durumun iyiye dönmesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d244e68a-a2b2-32c2-964f-a99f75bb2714",
                    "sense_definition": "Получить образование, стать просвещенным человеком.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он много читал, чтобы <w>образоваться</w> и стать полезным обществу.",
                            "target_lang_translations": {
                                "tr": "Topluma faydalı biri olmak ve <w>eğitimini tamamlamak</w> için çok okudu."
                            }
                        },
                        {
                            "text": "В то время каждый дворянин стремился <w>образоваться</w> в лучших университетах.",
                            "target_lang_translations": {
                                "tr": "O dönemde her soylu, en iyi üniversitelerde <w>eğitim görmeye</w> çalışırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "просветиться",
                        "обучиться"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Употребляется реже в современном языке."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Eğitim almak, bilgilenmek ve aydınlanmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "eğitim almak",
                                "target_lang_sense_clarification": "Okul veya benzeri bir kurumda öğrenim görmek."
                            },
                            {
                                "target_lang_word": "aydınlanmak",
                                "target_lang_sense_clarification": "Bilgi edinerek zihinsel olarak gelişmek."
                            },
                            {
                                "target_lang_word": "öğrenim görmek",
                                "target_lang_sense_clarification": "Bilgi ve beceri kazanma süreci."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}