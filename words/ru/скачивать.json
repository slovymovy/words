{
    "word_family": [
        "качка",
        "качалка",
        "качание",
        "качатель",
        "качательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28201924-071c-3c9a-a170-a2c137960ddd",
                    "sense_definition": "Получать или переносить цифровую информацию из сети на компьютер или другое устройство.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я часто <w>скачиваю</w> музыку из интернета для прослушивания в дороге.",
                            "target_lang_translations": {
                                "en": "I often <w>download</w> music from the internet to listen to on the go."
                            }
                        },
                        {
                            "text": "Пользователи могут <w>скачивать</w> <w>файлы</w> бесплатно с этого сайта.",
                            "target_lang_translations": {
                                "en": "Users can <w>download</w> files for free from this site."
                            }
                        }
                    ],
                    "synonyms": [
                        "загружа́ть"
                    ],
                    "antonyms": [
                        "зака́чивать"
                    ],
                    "common_phrases": [
                        "скачивать файлы",
                        "скачивать музыку",
                        "скачивать программу"
                    ],
                    "target_lang_definitions": {
                        "en": "To transfer digital information from a network to a computer or other device."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "download",
                                "target_lang_sense_clarification": "to transfer data from a remote system to a local device"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "101410a8-f343-3076-a619-3769df10aa2c",
                    "sense_definition": "Извлекать жидкость из какого-либо резервуара или места с помощью насоса.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие начали <w>скачивать</w> воду из затопленного подвала дома.",
                            "target_lang_translations": {
                                "en": "Workers began to <w>pump out</w> water from the flooded basement of the house."
                            }
                        },
                        {
                            "text": "Насос позволяет быстро <w>скачивать</w> <w>нефть</w> из резервуара в цистерну.",
                            "target_lang_translations": {
                                "en": "The pump allows for quickly <w>pumping out</w> oil from the reservoir into the tanker."
                            }
                        }
                    ],
                    "synonyms": [
                        "сливать"
                    ],
                    "antonyms": [
                        "зака́чивать"
                    ],
                    "common_phrases": [
                        "скачивать воду",
                        "скачивать нефть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To extract liquid from a container or area using a pump."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pump out",
                                "target_lang_sense_clarification": "to remove liquid from a space using a pump"
                            },
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "to remove liquid from a container or area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b7a01b5-26ad-3bf8-a996-a2fb57a84557",
                    "sense_definition": "Очищать поверхность, поливая её водой из шланга.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Матросы вышли на палубу, чтобы <w>скачивать</w> её перед утренним осмотром.",
                            "target_lang_translations": {
                                "en": "The sailors went out onto the deck to <w>hose it down</w> before the morning inspection."
                            }
                        },
                        {
                            "text": "Нужно <w>скачивать</w> <w>палубу</w> водой, чтобы убрать всю пыль и грязь.",
                            "target_lang_translations": {
                                "en": "You need to <w>hose down</w> the deck with water to remove all the dust and dirt."
                            }
                        }
                    ],
                    "synonyms": [
                        "смывать"
                    ],
                    "common_phrases": [
                        "скачивать палубу"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To clean a surface by spraying it with water from a hose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hose down",
                                "target_lang_sense_clarification": "to clean something by spraying it with water from a hose"
                            },
                            {
                                "target_lang_word": "wash down",
                                "target_lang_sense_clarification": "to clean a surface thoroughly with water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}