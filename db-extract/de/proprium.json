                "senses": [
                    {
                        "sense_id": "1467cbca-177d-3b3b-af3d-b7d33fc4d6d5",
                        "entry_id": "e57ebf1d-e38a-3214-8234-01cc62806531",
                        "glosses": [
                            "die identitätsbildende Eigenschaft eines Dings"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3199bdf4-569d-4c2c-a9c5-0fcad6507ce7",
                                "sense_id": "1467cbca-177d-3b3b-af3d-b7d33fc4d6d5",
                                "text": "Das Proprium ist im Gegensatz zu jeglichem Akzidens essentiell für die Definition."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2cbbfb4-9f37-3734-99af-6408327b9929",
                        "entry_id": "e57ebf1d-e38a-3214-8234-01cc62806531",
                        "glosses": [
                            "Gesamtheit der Aspekte, die die innere Einheit der Persönlichkeit ausweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd201346-7878-44bb-8807-7658de240bd0",
                                "sense_id": "b2cbbfb4-9f37-3734-99af-6408327b9929",
                                "text": "„Das Proprium ist nicht ein Ding; es läßt sich nicht trennen von der Person als Ganzes. Vor allem ist es nicht ein Homunculus. Das Proprium ist ein Begriff, der diejenigen Funktionen umfassen soll, welche die eigentümliche Einheit und Unterschiedenheit der Persönlichkeit ausmachen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6ae5fb4a-90e0-3df2-a165-099eae58de71",
                        "entry_id": "e57ebf1d-e38a-3214-8234-01cc62806531",
                        "glosses": [
                            "Gesamtheit der Elemente (Gesang oder Text) des christlichen Gottesdiensts, die entsprechend dem Tag im Kirchenjahr oder nach Anlass wechseln"
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "45da604e-8883-4cac-83ff-8317e68b0161",
                                "sense_id": "6ae5fb4a-90e0-3df2-a165-099eae58de71",
                                "text": "„Zuerst aber sollte ich mich darüber informieren: Welches ist das Proprium, welches ist das eigene Profil und was ist der Grundgedanke des bevorstehenden Sonn- oder Feiertages?“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c39315ec-b51d-4a4b-99f1-827b54867f25",
                        "source_entry_id": "e57ebf1d-e38a-3214-8234-01cc62806531",
                        "source_sense_id": "6ae5fb4a-90e0-3df2-a165-099eae58de71",
                        "target_lang_word": "proper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ebaeea9-61be-3512-8cfb-91dfcb292120",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Suited or acceptable to the purpose or circumstances; fit, suitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5058b7a9-0d61-4ad4-bff6-3f94d6931c5e",
                                                "sense_id": "1ebaeea9-61be-3512-8cfb-91dfcb292120",
                                                "text": "the proper time to plant potatoes"
                                            },
                                            {
                                                "example_id": "bce0a821-424f-4e20-9227-384dd624ee3a",
                                                "sense_id": "1ebaeea9-61be-3512-8cfb-91dfcb292120",
                                                "text": "The proper study of mankind is man."
                                            },
                                            {
                                                "example_id": "12667588-ae30-4b6c-a420-fd1cc60bad44",
                                                "sense_id": "1ebaeea9-61be-3512-8cfb-91dfcb292120",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7134bfad-78c4-3a29-b5e7-6644e7938fa6",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Following the established standards of behavior or manners; correct or decorous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b381cf4c-f6c4-4c34-a784-f269400ee35b",
                                                "sense_id": "7134bfad-78c4-3a29-b5e7-6644e7938fa6",
                                                "text": "a very proper young lady"
                                            },
                                            {
                                                "example_id": "0d8a68c2-ffc8-4f10-86db-77f542487aa4",
                                                "sense_id": "7134bfad-78c4-3a29-b5e7-6644e7938fa6",
                                                "text": "This new-comer was a man who in any company would have seemed striking.[…]Indeed, all his features were in large mold, like the man himself, as though he had come from a day when skin garments made the proper garb of men."
                                            },
                                            {
                                                "example_id": "2b391158-20a3-4e7e-b6fd-480ebd255772",
                                                "sense_id": "7134bfad-78c4-3a29-b5e7-6644e7938fa6",
                                                "text": "The Nippy became a national icon, symbolic of the girl next door, always approachable and proper; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd65369-f98d-34a8-9390-594d6027bbd8",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Such that the preimage of every compact set is compact."
                                        ],
                                        "tags": [
                                            "of a function"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2df86d9d-0f7b-30ef-bf67-d83407093242",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Continuous, mapping closed sets to closed sets, and such that the preimage of every point is compact."
                                        ],
                                        "tags": [
                                            "of a function"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5419d107-4491-3d5b-8756-e57cf41862f6",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Separated, of finite type, and universally closed."
                                        ],
                                        "tags": [
                                            "of a morphism of schemes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fada0740-b3d2-3c93-a1f3-880e885797a0",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Such that unique morphism from the variety to k is proper (as above)."
                                        ],
                                        "tags": [
                                            "of a variety over a field k"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f45e527-bc1a-322a-8b21-5c5915e01a79",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Suitable.",
                                            "Such that every closed ball is compact."
                                        ],
                                        "tags": [
                                            "of a metric space"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19c25fdc-8db4-3851-97bb-708631de3d76",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "Used to designate a particular person, place, or thing. Proper nouns are usually written with an initial capital letter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c141c10-b757-30a0-9135-13936fd3de60",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "Pertaining exclusively to a specific thing or person; particular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb34cbe-ff9c-4cc7-9fef-b1978eac0a59",
                                                "sense_id": "0c141c10-b757-30a0-9135-13936fd3de60",
                                                "text": "They have a proper saint almost for every peculiar infirmity: for poison, gouts, agues […]."
                                            },
                                            {
                                                "example_id": "87753a54-bca6-4984-b5c5-8b4fe71c5b7e",
                                                "sense_id": "0c141c10-b757-30a0-9135-13936fd3de60",
                                                "text": "1829, James Marsh, Preliminary Essay to Samuel Taylor Coleridge's Aids to Reflection\nthose higher and peculiar attributes […] which constitute our proper humanity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f306e1e-97df-3cc3-82c3-5b3985ccd66a",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "In the strict sense; within the strict definition or core (of a specified place, taxonomic order, idea, etc)."
                                        ],
                                        "tags": [
                                            "postpositional",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710471fe-f924-4236-835a-bec5953278cb",
                                                "sense_id": "5f306e1e-97df-3cc3-82c3-5b3985ccd66a",
                                                "text": "These are divided into two great families, the vipers proper (Viperidae) and the pit-vipers (Crotalidae)."
                                            },
                                            {
                                                "example_id": "7612cc0d-3721-4d2b-9279-7aef8c44811b",
                                                "sense_id": "5f306e1e-97df-3cc3-82c3-5b3985ccd66a",
                                                "text": "Siberia, though it stands outside the territorial confines of Russia proper, constitutes an essentially component part […]. Outer Mongolia, [so called] to distinguish it from Inner Mongolia, which lies nearer to China proper, revolted and declared its independence."
                                            },
                                            {
                                                "example_id": "f0fc670b-1bf2-4c30-a973-6f2ad3a8c82c",
                                                "sense_id": "5f306e1e-97df-3cc3-82c3-5b3985ccd66a",
                                                "text": "Hence, this border is still blurred, raising the question whether traumatic life events induce sadness/distress – which is self-evident – or depression proper and, secondly, whether sadness/distress is a precursor or pacemaker of depression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "538c9c00-4340-3426-ba47-c19bbfb196f3",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "Belonging to oneself or itself; own."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1017fbbf-5d3c-46f0-8c22-ea394407ae74",
                                                "sense_id": "538c9c00-4340-3426-ba47-c19bbfb196f3",
                                                "text": "every country, and more than that, every private place, hath his proper remedies growing in it, particular almost to the domineering and most frequent maladies of it."
                                            },
                                            {
                                                "example_id": "c0d41702-7d1d-41e6-beec-bb39c3dec380",
                                                "sense_id": "538c9c00-4340-3426-ba47-c19bbfb196f3",
                                                "text": "proper motion — proper left — proper right"
                                            },
                                            {
                                                "example_id": "8514ac83-d6a2-4766-8de7-d07cc5ecd0c0",
                                                "sense_id": "538c9c00-4340-3426-ba47-c19bbfb196f3",
                                                "text": "a man so bold\nThat dares do justice on my proper son"
                                            },
                                            {
                                                "example_id": "6b5a57c1-aa7d-4d52-b6c4-a02e3209421f",
                                                "sense_id": "538c9c00-4340-3426-ba47-c19bbfb196f3",
                                                "text": "Now learn the difference, at your proper cost, / Betwixt true valour and an empty boast."
                                            },
                                            {
                                                "example_id": "c0d61548-83fa-4409-9b48-dd070714214a",
                                                "sense_id": "538c9c00-4340-3426-ba47-c19bbfb196f3",
                                                "text": "Each animal has its proper pleasure, and the proper pleasure of man is connected with reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840fd5dd-24be-3a10-85d4-d722462ff464",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "Portrayed in natural or usual coloration, as opposed to conventional tinctures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c7eefe6-9217-3b99-8a83-c7a478143740",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "Being strictly part of some other thing (not necessarily explicitly mentioned, but of definitional importance), and not being the thing itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3cafed-27eb-432b-9fd0-b7ed6f5c5d7a",
                                                "sense_id": "0c7eefe6-9217-3b99-8a83-c7a478143740",
                                                "text": "proper subset — proper ideal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6cb925-1e85-3063-884e-428bc49962a2",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Possessed, related.",
                                            "Eigen-; designating a function or value which is an eigenfunction or eigenvalue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25cb5b63-fb3e-3627-8180-b4c224ca2e68",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Excellent, of high quality; such as the specific person or thing should ideally be. (Now often merged with later senses.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44e473f-5f71-4097-b5f2-4a073a2779aa",
                                                "sense_id": "25cb5b63-fb3e-3627-8180-b4c224ca2e68",
                                                "text": "Now that was a proper breakfast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a5946a0-a2b7-32ed-be53-ce6687706fd7",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Attractive, elegant."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30a5b79-ad8b-41df-bbe5-96f9983b1019",
                                                "sense_id": "0a5946a0-a2b7-32ed-be53-ce6687706fd7",
                                                "text": "The same tyme was Moses borne, and was a propper [translating ἀστεῖος (asteîos)] childe in the sight of God, which was norisshed up in his fathers housse thre monethes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fa0194-23a9-3040-a7f3-ce3b2ad77d5a",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "In the very strictest sense of the word."
                                        ],
                                        "tags": [
                                            "often",
                                            "postpositional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c1bbad-0c0e-45f2-8715-fd5af7f40903",
                                                "sense_id": "45fa0194-23a9-3040-a7f3-ce3b2ad77d5a",
                                                "text": "Though unusual in the Dublin area he knew that it was not by any means unknown for desperadoes who had next to nothing to live on to be abroad waylaying and generally terrorising peaceable pedestrians by placing a pistol at their head in some secluded spot outside the city proper[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4c63af-bb6c-3029-a012-bbaaa00e243c",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Utter, complete."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04738965-fe61-4b53-9388-772457e23cb1",
                                                "sense_id": "dd4c63af-bb6c-3029-a012-bbaaa00e243c",
                                                "text": "When I realized I was wearing my shirt inside out, I felt a proper fool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063a4894-cb23-39b3-a538-bf5f7fd08a59",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Not being a set."
                                        ],
                                        "tags": [
                                            "of a class"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "proper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                        "entry_id": "409130b1-6677-324b-9b7f-9b2dbbc66440",
                                        "glosses": [
                                            "properly; thoroughly; completely."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "730b2034-a35c-45cc-86f1-e4566e3b5fdd",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "'I thought it was the American Associated Press.' 'Oh, they are on the track, are they?' 'They to-day, and the Times yesterday. Oh, they are buzzing round proper.'"
                                            },
                                            {
                                                "example_id": "644724c3-3af5-42a6-b97d-add5d35af5af",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "“Christmas Eve,” said Nabby Adams. “I used to pump the bloody organ for the carols, proper pissed usually.”"
                                            },
                                            {
                                                "example_id": "31990aa5-e05a-48af-b30e-3815cd36aaca",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "The kid towelled him up proper."
                                            },
                                            {
                                                "example_id": "b4e857f7-12eb-4057-bbfc-6fcdd2090384",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "Don't you think you must have looked proper daft?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40ba4d6-a582-3d58-a34b-f54c5011664a",
                                        "entry_id": "409130b1-6677-324b-9b7f-9b2dbbc66440",
                                        "glosses": [
                                            "properly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "nonstandard",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2355832b-aa7e-4fa9-b385-6406672c70b8",
                                                "sense_id": "c40ba4d6-a582-3d58-a34b-f54c5011664a",
                                                "text": "\"But it's not many of us as can make 'em proper.\""
                                            },
                                            {
