                    },
                    {
                        "form_id": "d4ccfb4e-c1fc-4439-ab13-698687640cef",
                        "entry_id": "a90be149-5259-32bb-8091-1cf2d2600b6a",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "autoritairders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                        "entry_id": "a90be149-5259-32bb-8091-1cf2d2600b6a",
                        "glosses": [
                            "gebaseerd op, of gebruikmakend van macht als eerste beginsel; dwingend met macht en gezag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9769a2d2-b365-4a1d-8d33-8e653e151dfd",
                                "sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                                "text": "De autoritaire leraar gaf op iedere vraag van de leerlingen als antwoord: \"Omdat ik het zeg!\"."
                            },
                            {
                                "example_id": "fabb880e-30a4-4c0e-99ea-1a60f05c9a9c",
                                "sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                                "text": "De autoritaire heerser moest steeds meer geweld gebruiken om zijn onderdanen tot gehoorzaamheid te dwingen."
                            },
                            {
                                "example_id": "9f44400b-7e4b-4c26-becf-b8da635690ab",
                                "sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                                "text": "In hun idealisme ontkennen de pacifisten het gevaar van de autoritaire agressie."
                            },
                            {
                                "example_id": "025b0272-eb9a-4219-be16-1e10087d9e30",
                                "sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                                "text": "Hij sprak beleefd, dwingend, autoritair en verzoenend tegelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2357fe9-1a1a-4a25-b9c4-a99b38c4b176",
                        "source_entry_id": "a90be149-5259-32bb-8091-1cf2d2600b6a",
                        "source_sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                        "target_lang_word": "authoritarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authoritarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88e64a05-c112-3d36-b519-259fddfa3f99",
                                        "entry_id": "54e43d26-0de9-3328-beda-be49fa53094b",
                                        "glosses": [
                                            "Of, or relating to, or exhibiting strict obedience to an authority; favoring authoritarianism over civic and individual liberties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ddcd6a3-4ec5-4ad8-8c91-7f907938ef44",
                                                "sense_id": "88e64a05-c112-3d36-b519-259fddfa3f99",
                                                "text": "the authoritarian personality"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                        "entry_id": "54e43d26-0de9-3328-beda-be49fa53094b",
                                        "glosses": [
                                            "Demanding obedience to authority; marked by authoritarianism; dictatorial, tyrannical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30319338-f8a0-409e-bb3d-ff444712fef4",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "The authoritarian government was demanding stricter laws for low-wage peasants."
                                            },
                                            {
                                                "example_id": "9bd764c6-0b46-44b0-a4ff-3b76b6f9e9c6",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "Una rivoluzione è certamente la cosa più autoritaria che ci sia: è l'atto per il quale una parte della popolazione impone la sua volontà all'altra parte per mezzo di fucili, baionette e cannoni; mezzi autoritari, se ce ne sono; e il partito vittorioso, se non vuole aver combattuto invano, deve continuare questo dominio col terrore che le sue armi inspirano ai reazionari."
                                            },
                                            {
                                                "example_id": "91dbadb3-1ad1-4cdb-bb2d-1cfddce6d25e",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "[…] (selling one’s personal activity under another’s direction and supervision encourages dependency and authoritarian relationships);[…]"
                                            },
                                            {
                                                "example_id": "554a69e8-1fc8-40a7-b65f-70f2f719855d",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "It may be that precisely due to its weak nature, an authoritarian dictatorship needs rampant violence and lies to maintain its rule."
                                            },
                                            {
                                                "example_id": "fba48196-f37b-45e8-b46e-b88c3bad8090",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "Wang Yi blatantly intimidates the world at the UNGA. He is a cheat and bully on the global stage in fundamental violation of the facts. Democratic countries should clearly recognize and unify against the challenge of authoritarian intervention. The Republic of China is a sovereign state. Taiwan has never been part of the People's Republic of China in historical fact, international law, or reality."
                                            },
                                            {
                                                "example_id": "020495af-8dd8-41ed-b6ac-2189875e92f6",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "Of course, in China everything is determined by the state. So many times, when I asked how China had managed to build this network so quickly, I was told that it was because the government had backed it. And, of course, there are fewer Nimbys in an authoritarian state."
                                            },
                                            {
                                                "example_id": "6c7cc9f5-decd-4dd2-be6c-1b9c247c4ae6",
                                                "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                                                "text": "But amid all the disruption and norm-breaking, it’s Mr. Trump’s apparently keen interest in shaping American culture that may be most intriguing. To critics, it’s nothing less than a sign of his authoritarian bent – reminiscent of the Stalin-esque playbook that made government diktats over artistic expression a feature of the old Soviet Union."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a01d0cb9-8241-3304-a001-094b5a4ae058",
                                        "entry_id": "54e43d26-0de9-3328-beda-be49fa53094b",
                                        "glosses": [
                                            "Tending to impose one's demands upon others as if one were an authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "authoritarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c0e5e1-a244-3ade-a863-b990cf8285be",
                                        "entry_id": "ea9e6ec1-54ef-33f2-956c-990e6a6b07b7",
                                        "glosses": [
                                            "One who commands absolute obedience to his or her authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7080defe-a995-45d3-8204-37ba7ba7079a",
                                                "sense_id": "e0c0e5e1-a244-3ade-a863-b990cf8285be",
                                                "text": "The dictator was an authoritarian."
                                            },
                                            {
                                                "example_id": "828014e6-41a0-4184-a792-be7e56824b19",
                                                "sense_id": "e0c0e5e1-a244-3ade-a863-b990cf8285be",
                                                "text": "Trump may be a Schmittian by instinct and aspiration, but he’s a fair-weather Schmittian only. A true authoritarian, confronted by limits on his power, might have ripped through them in service of establishing his authority."
                                            },
                                            {
                                                "example_id": "b90f44c0-9b40-4237-a527-f8a504cb6a1e",
                                                "sense_id": "e0c0e5e1-a244-3ade-a863-b990cf8285be",
                                                "text": "While his two predecessors had been authoritarians – they knew what they thought on the most contentious matters within Catholicism and imposed that view on the church regardless of dissenters – Francis preferred to work away patiently at building consensus and accommodating a variety of perspectives. To that end, he breathed new life into the system of regular gatherings – or synods – of bishops in Rome to debate pressing matters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22dfc5d0-c501-35c5-9997-4a841bf0de32",
                                        "entry_id": "ea9e6ec1-54ef-33f2-956c-990e6a6b07b7",
                                        "glosses": [
                                            "One who follows and is excessively obedient to authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d11f443-0562-4a95-8c73-1bfaa314260d",
                        "source_entry_id": "a90be149-5259-32bb-8091-1cf2d2600b6a",
                        "source_sense_id": "15397e26-367a-3ef1-b143-a01c6098fb1b",
                        "target_lang_word": "autoritaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autoritaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b26bf12-c033-3f5d-ac37-e98187cc5c91",
                                        "entry_id": "35ca3404-ca3b-3290-8f36-804180d2b145",
                                        "glosses": [
                                            "Associé à une personne qui use ou montre de l’autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9092d23-3bbc-4027-b6c1-9154b2bef4fc",
                                                "sense_id": "0b26bf12-c033-3f5d-ac37-e98187cc5c91",
                                                "text": "Avec beaucoup de tact, ce vieillard, qui savait n’être ni autoritaire ni égoïste, s’efforçait de gagner l’affection de Nazira et de se faire pardonner d’être vieux."
                                            },
                                            {
                                                "example_id": "d114939f-d2e1-4101-af0d-093619cba475",
                                                "sense_id": "0b26bf12-c033-3f5d-ac37-e98187cc5c91",
                                                "text": "Rabalan se sentit troublé. Du moment que le maire affirmait d’une façon aussi autoritaire qu’il était sorcier, il fallait le croire… Ça l’étonnait pourtant."
                                            },
                                            {
                                                "example_id": "0098c1ce-6d8c-4357-9339-49c10710ad28",
                                                "sense_id": "0b26bf12-c033-3f5d-ac37-e98187cc5c91",
                                                "text": "Agrégé d'histoire du droit et de droit romain, autoritaire et un rien coléreux, il est fasciné par les méthodes policières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689a16c6-5cd0-3d2e-b09b-ec5c318fe9b1",
                                        "entry_id": "35ca3404-ca3b-3290-8f36-804180d2b145",
                                        "glosses": [
                                            "Associé à une personne qui est partisane de l’autorité comme valeur prédominante d’un régime, d’un système, d’une institution."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4779258b-35e5-4641-846d-742863f01037",
                                                "sense_id": "689a16c6-5cd0-3d2e-b09b-ec5c318fe9b1",
                                                "text": "Actuellement le jeu chiraqien, malgré son ineptie, a le mérite d'empêcher le glissement d'une fraction de l’électorat « autoritaire » vers le PCF."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25e94fe-64c9-34bf-a4d4-a1c70ea7d28b",
                                        "entry_id": "35ca3404-ca3b-3290-8f36-804180d2b145",
                                        "glosses": [
                                            "Associé à un concept, une idée, une chose qui manifestent de l’autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8a7603-b135-4c99-866b-17be61699d25",
                                                "sense_id": "a25e94fe-64c9-34bf-a4d4-a1c70ea7d28b",
                                                "text": "C'est la structure du couple qui apparaît en revanche comme un facteur décisif : une structure autoritaire dans le cas indien avec fort écart d'âge qui ne donne guère aux conjoints le moyen de discuter librement et de décider ensemble ; une large autonomie de la femme dans le ménage portoricain matricentré, où le partenaire, par principe provisoire, n'a aucun pouvoir de décision."
                                            }
                                        ]
