                        "entry_id": "25ca13d6-bdd5-3dcd-8502-b6fe5964edf9",
                        "glosses": [
                            "(männliche) Person, die jemanden liebt, also eine sehr starke emotionale Bindung zu diesem Menschen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62641a0e-06f8-4656-873c-4aa63fcbb908",
                                "sense_id": "6329ab35-0ade-31c4-9133-9fa2a81e3bd2",
                                "text": "Susie ist umgeben von Liebenden und fühlt sich als Single immer unwohler."
                            },
                            {
                                "example_id": "851da7a4-3669-49e3-90f2-65e804794b40",
                                "sense_id": "6329ab35-0ade-31c4-9133-9fa2a81e3bd2",
                                "text": "Er ist ein Liebender, dessen Liebe unerwidert bleiben wird."
                            },
                            {
                                "example_id": "fb33d98a-ea47-45e2-bdba-1d453f6656f7",
                                "sense_id": "6329ab35-0ade-31c4-9133-9fa2a81e3bd2",
                                "text": "„Die großen Liebenden schmoren in der Hölle, sagt der Dichter.“"
                            }
                        ],
