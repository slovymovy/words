                        "glosses": [
                            "Salutation ou désignation adressée à un ou plusieurs hommes et femmes présents ensemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8987e4ef-ac90-4ce9-8de8-a8ff1349a4ba",
                                "sense_id": "20e1eaaf-b87d-3237-9dc0-e43325a71275",
                                "text": "J’ai faim, m’sieurs-dames, j’ai faim, j’ai faim !"
                            },
                            {
                                "example_id": "c27f6cac-df55-49e5-abe2-5b0bd1fdf4c7",
                                "sense_id": "20e1eaaf-b87d-3237-9dc0-e43325a71275",
                                "text": "Le fantôme opalin du garçon interrompit à propos ce questionnaire embarrassant.\n— Ça s’ra, ces m’sieurs-dames ?"
                            },
                            {
                                "example_id": "e9f724ef-668f-4658-891f-be9c348e933b",
                                "sense_id": "20e1eaaf-b87d-3237-9dc0-e43325a71275",
                                "text": "Le vieux attend d’avoir fini sa chanson, il ramasse toutes les papillottes, il compte posément les sous, il dit bien poliment « Merci beaucoup, M’sieurs-Dames ! À vot’ bon cœur, M’sieurs-Dames ! »"
                            }
                        ]
                    }
