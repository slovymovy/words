                "senses": [
                    {
                        "sense_id": "d7c0f26f-8299-34d2-9efe-f6c5bd0249c4",
                        "entry_id": "de52fcf2-c289-3617-ba0b-1621e42d1347",
                        "glosses": [
                            "Relatif à un hypothétique groupement de langues constitué par les langues altaïques et ouraliennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fca5d35-91b9-4d80-9832-f3f6d7a11372",
                                "sense_id": "d7c0f26f-8299-34d2-9efe-f6c5bd0249c4",
                                "text": "Les langues ouralo-altaïques."
                            },
                            {
                                "example_id": "59643c86-c207-4d13-bd88-db85722bdbb2",
                                "sense_id": "d7c0f26f-8299-34d2-9efe-f6c5bd0249c4",
                                "text": "Langues ouralo-altaïques, langues comprenant le groupe samoyède, le groupe finnois, le groupe turc ou tatar, le groupe mongol et le groupe tongouse."
                            },
                            {
                                "example_id": "e76c3d0f-59d6-4866-b318-d18f0590e0d1",
                                "sense_id": "d7c0f26f-8299-34d2-9efe-f6c5bd0249c4",
                                "text": "Dans l’intérieur de ce trop vaste groupe qui, du Pacifique à la Hongrie, embrasse tant de familles humaines, les Finnois sont le plus souvent rattachés à une branche désignée sous le nom d’ouralo-altaïque, l’espace compris entre les chaînes de l’Oural et de l’Altaï paraissant le point de départ des peuples de cette famille. Les Mongols proprement dits sont, avec les Tatars, rangés d’ordinaire à côté des Finnois dans ce groupe ouralo-altaïque, qui laisse au contraire en dehors de lui les Chinois et les nations de l’Asie orientale."
                            }
                        ]
                    }
