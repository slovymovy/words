                        "glosses": [
                            "The quality of being slabby; sliminess, muddiness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a15c2527-755b-437d-a27c-92cd0a4ffba5",
                                "sense_id": "f3dc71e7-af9c-3e18-a865-e58d03aafb0b",
                                "text": "1678, John Bunyan, The Pilgrim’s Progress, London: Nath. Ponder, Facsimile reproduction, London: Elliot Stock, 1875, Part 2, p. 183,\nThe Way also was here very wearysom thorow Dirt and Slabbiness."
                            },
                            {
                                "example_id": "8fbf07a6-259a-4fa2-b4ae-7af2d06a16e3",
                                "sense_id": "f3dc71e7-af9c-3e18-a865-e58d03aafb0b",
                                "text": "[…] we took our courage in both hands and started at the first break in the downpour. The valley was choked with mist, and the road in a state of unutterable slabbiness: yet our enterprise was soon rewarded, for the weather had done its worst in the darkness, and the sunshine brought the vapours steaming up out of the meadows and banished them with the clouds across the summits of the hills."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd3f0d8c-5def-3815-b3ee-4a1725afa034",
                        "entry_id": "e1bcfd30-8042-3eba-81b3-23637df62b3f",
                        "glosses": [
                            "The quality of being composed of or resembling slabs."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c482c645-6adf-4c4b-8b00-6a48f2ce2b2a",
                                "sense_id": "dd3f0d8c-5def-3815-b3ee-4a1725afa034",
                                "text": "1895, W. P. Haskett Smith, “Wales” in Climbing in the British Isles, London: Longmans, Green, and Co., “The Arans,”\nLooking up from the lake the crag, which is a high dependence of Aran Benllyn, shows on the right an almost unrelieved slabbiness at an easy angle, which gives good practice in small footholds."
                            }
                        ]
