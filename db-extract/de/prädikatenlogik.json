                "senses": [
                    {
                        "sense_id": "1cecb0f0-328b-3384-a219-6ba914f54c4a",
                        "entry_id": "6b5b7ab3-d503-3a77-9293-321f3567f183",
                        "glosses": [
                            "System zur Darstellung von Aussagen, welches auf Prädikaten und Quantoren aufbaut; die generellen Termini einer Aussage werden in der Prädikatenlogik durch Variablen ersetzt und formalisiert"
                        ],
                        "tags": [
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "5ccbeedf-cf33-491b-9321-37cafdd3ecec",
                                "sense_id": "1cecb0f0-328b-3384-a219-6ba914f54c4a",
                                "text": "„Da es sich hierbei um Beziehungszahlen handelt, reicht die bisherige Prädikatenlogik zu ihrer Definition nicht aus.“"
                            },
                            {
                                "example_id": "62193f34-e833-4519-8367-95a3bb8a0264",
                                "sense_id": "1cecb0f0-328b-3384-a219-6ba914f54c4a",
                                "text": "„Ansonsten ist das Büchlein allgemeinverständlich und es erklärt – was die beiden anderen erwähnten Bücher versäumen – viel von dem, was hinter der Programmsprache steht, zum Beispiel die Prädikatenlogik oder die Beziehungen zwischen PROLOG und anderen logischen Programmiersprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
