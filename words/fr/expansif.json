            "senses": [
                {
                    "sense_id": "8c560dd2-e3e8-31c0-bd2d-01a00644043a",
                    "sense_definition": "Qui communique facilement et manifeste ouvertement ses émotions ou ses pensées, en parlant d'une personne.",
