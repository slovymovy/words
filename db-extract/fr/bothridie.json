                    {
                        "sense_id": "0f9e6dd9-d2e4-3eae-aff9-43eb272c96ef",
                        "entry_id": "3869a273-5437-3d1c-8a7b-7a1d2fd7d284",
                        "glosses": [
                            "Ventouse fendue longitudinalement chez les cestodes de l’ordre des Tetraphyllidea, présente en paires et servant d'organe de fixation franc du scolex ou tête de ces vers plats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c48c244-7ec7-49ff-9e91-5e8c5203f4d2",
                                "sense_id": "0f9e6dd9-d2e4-3eae-aff9-43eb272c96ef",
                                "text": "La bothridie se distingue de la bothrie en ce que la première est une ventouse véritable effectuant une suction permettant la fixation du ver à son hôte, présente chez l'ordre des Tetraphyllidea, tandis que la seconde n'exerce pas de suction, mais plutôt un pincement du point d'ancrage sur l'hôte des cestodes qui en sont pourvus, lesquels appartiennent à l'ordre des Pseudophyllidea."
                            },
                            {
                                "example_id": "a71cac5a-419f-4bfd-b6e1-9d392993dec1",
                                "sense_id": "0f9e6dd9-d2e4-3eae-aff9-43eb272c96ef",
                                "text": "L’orientation dorsale symétrique est défavorable parce que les dents pendent sous la bothridie, presque verticalement."
                            }
                        ]
                    }
                ],
