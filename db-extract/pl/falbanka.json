                ],
                "translations": [
                    {
                        "translation_id": "18171a8f-0e1d-4491-b18f-8ba70d8ef09a",
                        "source_entry_id": "9f77dc60-d527-348c-9267-1d6f1778783f",
                        "source_sense_id": "b93126c4-d9cd-3e2c-b9e3-8f1934c39ad4",
                        "target_lang_word": "frill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "A strip of pleated fabric or paper used as decoration or trim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287474ef-1150-484f-8635-092d49237f50",
                                                "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                                "text": "1777, Samuel Jackson Pratt (as Courtney Melmoth), Liberal Opinions, upon Animals, Man, and Providence, London: G. Robinson and J. Bew, Volume 5, Chapter 114, p. 163,\n[…] one of her husband Jeffery’s shirts (with frills to the bosom) […]"
                                            },
                                            {
                                                "example_id": "0f26bad8-832a-41ea-b897-d24964c0f5b1",
                                                "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                                "text": "His face had fallen in, and was unshorn; his frill and neckcloth hung limp under his bagging waistcoat."
                                            },
                                            {
                                                "example_id": "f0230d41-5e1b-4b01-b6ba-08c9e5bbfe8b",
                                                "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "A substance or material on the edge of something, resembling such a strip of fabric."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a10d5e8e-b1c9-45e2-8345-2404221d130b",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "[T]he bright frills of the winter fungi on the blotched trunks of the trees;"
                                            },
                                            {
                                                "example_id": "9712842b-33e6-48ea-a79f-e0c4e99c218a",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "‘Isn’t it a shame!’ Mrs Ayres said softly, now and then pausing to brush aside a frill of snow and examine the plant beneath […]"
                                            },
                                            {
                                                "example_id": "233f29f0-e496-48ac-a44b-52d12dddd284",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "Nothing moved in sky, land, or sea, except a frill of milkwhite foam along the nearer angles of the shore, shreds of which licked the contiguous stones like tongues."
                                            },
                                            {
                                                "example_id": "58ffa91b-cfe8-4962-9d13-b867a7e95a1f",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "She had noticed yesterday that a few tiny corkscrew tendrils had come right through some cracks in the scullery ceiling and all the windows of the lean-to had a thick frill of ruffled green."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d57e385-a316-3a14-9965-e91e4c3c87e1",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "A wrinkled edge to a film."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "Something extraneous or not essential; something purely for show or effect; a luxury."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff1b837-d302-4a52-aad1-f120f123e372",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "My name is Sammy Carleton. Not ‘Mr.’ Carleton, but just plain Sammy. I’m a regular no-nonsense man with no fancy frills about me. I want you to call me Sammy."
                                            },
                                            {
                                                "example_id": "b30fb3be-f97b-42d2-8afe-1841050e2866",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "Every possible economy was carefully investigated and unnecessary expense, however small, eliminated. The company had no money to spare on \"frills.\""
                                            },
                                            {
                                                "example_id": "48e43c28-6d8e-4b45-b27b-16cdde41bcdb",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "Falling in love, I said. Falling into it, we all did then, one way or another. How could he have made such light of it? Sneered even. As if it was trivial for us, a frill, a whim."
                                            },
                                            {
                                                "example_id": "4a854f2e-2a4d-4b2d-9873-8c75bc430a40",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "Torontonians clutter their brick and stone houses with too much trim, or with window trim and shutters—and they also carve their shutters with hearts or maple leaves—but the snow conceals these frills;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "The relatively extensive margin seen on the back of the heads of reptiles, with either a bony support or a cartilaginous one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f15c4d-d070-426d-ba80-c1be7a306bf9",
                                                "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                                                "text": "A large admiral lizard leapt up on a rail, stood on hind legs with fore legs raised like hands and watched for a moment […], then loped down the cess-path with arms swinging and iridescent frill flying out like a cape […]"
                                            },
                                            {
                                                "example_id": "95739ad2-8fd6-4d79-a575-d2e2c2fbf422",
                                                "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                                                "text": "She reminded Bojan of a desert lizard throwing up its frill to frighten predators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb605095-6f5b-36d4-bd53-9a7ffaba44f0",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "Synonym of armilla."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8788ec99-901c-3b9d-84b2-234a8838bc82",
                                        "entry_id": "64b8e785-1a39-30b5-8db9-1f4d4f9e62ad",
                                        "glosses": [
                                            "To make into a frill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6c081e5-5f9b-378e-9350-f5d14abfe1d2",
                                        "entry_id": "64b8e785-1a39-30b5-8db9-1f4d4f9e62ad",
                                        "glosses": [
                                            "To become wrinkled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5b9449c-ba29-3506-b727-eaf4c81e6afe",
                                        "entry_id": "64b8e785-1a39-30b5-8db9-1f4d4f9e62ad",
                                        "glosses": [
                                            "To provide or decorate with a frill or frills; to turn back in crimped plaits."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64fca9ad-4889-477a-b2d2-757efefa97a1",
                                                "sense_id": "c5b9449c-ba29-3506-b727-eaf4c81e6afe",
                                                "text": "And I will be bold to ſay my two girls have had a pretty good education, and capacity, [...] they underſtand their needle, breadſtitch, croſs and change, and all manner of plain-work; they can pink, point, and frill; [...]"
                                            },
                                            {
                                                "example_id": "dbcf4eb8-e634-42e1-882d-0d2e2ddb3cb0",
                                                "sense_id": "c5b9449c-ba29-3506-b727-eaf4c81e6afe",
                                                "text": "1863, Charles Dickens, Mrs. Lirriper’s Lodgings, Chapter 4, in All the Year Round, Volume 10, Extra Christmas Number, 3 December, 1863, p. 35,\nMrs. Sandham, formerly Kate Barford, is working at a baby’s frock, and asking now and then the advice of her sister, who is frilling a little cap."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a74754c8-d483-3b1c-9f2f-802e82fdc38e",
                                        "entry_id": "7d170458-c990-3321-b366-a7f8f073dc29",
                                        "glosses": [
                                            "To shake or shiver as with cold (with reference to a hawk)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a367c8e-b45a-31de-a291-19d76f5a5bb1",
                                        "entry_id": "7d170458-c990-3321-b366-a7f8f073dc29",
                                        "glosses": [
                                            "To cry (with reference to a bird of prey)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd1abb69-a948-4742-aec4-9afe77c572e6",
                                                "sense_id": "2a367c8e-b45a-31de-a291-19d76f5a5bb1",
                                                "text": "1688, Randle Holme, The Academy of Armory, Chester: for the author, Book 2, Chapter 13, “Of the Voices of Birds,” p. 310,\nThe Eagle Frilleth, or Scriketh\nThe Hawk, as Falcon, Gawshawk, and all such Birds of Prey, cryeth, peepeth, or frilleth."
                                            }
                                        ]
                                    }
                                ]
                            }
