                "senses": [
                    {
                        "sense_id": "d8ef8e5c-200e-3da9-ae51-7f97df9ea397",
                        "entry_id": "80f2358b-5a19-3a75-9237-e71e55d107d7",
                        "glosses": [
                            "Radical d’un composé cyclique de dix atomes de carbone."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "817b179b-f6ef-44db-b17d-f43fad36f392",
                                "sense_id": "d8ef8e5c-200e-3da9-ae51-7f97df9ea397",
                                "text": "Les glandes mandibulaires des reines produisent l'acide céto-9 décène-2 trans oïque, et non pas l'acide de la gelée royale. L'acide hydroxy-10 décène-2 oïque, existe dans les larves de reines sous forme estérifiée."
                            },
                            {
                                "example_id": "e10fa81a-6bf1-4a1c-a963-67d21c7a3d70",
                                "sense_id": "d8ef8e5c-200e-3da9-ae51-7f97df9ea397",
                                "text": "Les PAO sont fabriquées selon un procédé complexe à partir de l'éthylène transformé en α-décène, lui-même oligomérisé et hydrogéné."
                            }
                        ]
                    },
                    {
                        "sense_id": "9164a53f-cba8-3b43-9da9-545625a09fef",
                        "entry_id": "80f2358b-5a19-3a75-9237-e71e55d107d7",
                        "glosses": [
                            "Molécule de dix atomes de carbone."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e7cc063b-1edf-4714-b991-785fbb58be57",
                                "sense_id": "9164a53f-cba8-3b43-9da9-545625a09fef",
                                "text": "Au contraire de l'octène-1, la dismutation de l'heptène-2 est beaucoup plus sélective. A part le catalyseur non traité, ceux renfermant de l'oxyde de sodium ou de l'oxyde de potassium favorisent sélectivement la formation des décènes."
                            }
                        ]
                    }
