                            "singular"
                        ],
                        "form": "(dem) Nubien"
                    },
                    {
                        "form_id": "f28673ee-9128-414b-bbea-d5a0eef045c0",
                        "entry_id": "47900c85-9696-3b53-898d-0311f4988f05",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "(das) Nubien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                        "entry_id": "47900c85-9696-3b53-898d-0311f4988f05",
                        "glosses": [
                            "das Gebiet zwischen dem 1. und 4. Katarakt des Nils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac231c74-f653-48ef-ac3e-533ef1e838c7",
                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                "text": "„Nubien gilt als Schnittstelle zwischen dem eher dem Mittelmeerraum zuzurechnenden Ägypten und Schwarzafrika.“"
                            },
                            {
                                "example_id": "9ebf1da1-2bc7-436e-a881-94abc453a076",
                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                "text": "Im antiken Nubien wurden nicht nur Könige in Pyramiden begraben."
                            },
                            {
                                "example_id": "552de951-fe79-447f-b636-278c8c61ebc9",
                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                "text": "„Die Herrschaft der Pharaonen des Neuen Reiches hinterließ in Nubien zahlreiche ägyptische Bauwerke.“"
                            },
                            {
                                "example_id": "e0d228c4-1032-4377-ba98-fbf158928454",
                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                "text": "„Nubien verfügte über große Goldvorkommen und zog Gewinn aus seinen Handelswegen nach Zentralafrika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3503b36-5dad-429b-87f9-ac4bc1a1406e",
                        "source_entry_id": "47900c85-9696-3b53-898d-0311f4988f05",
                        "source_sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                        "target_lang_word": "Nubia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nubia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a4d5e0-61e1-3f3a-937f-fd9581b5308d",
                                        "entry_id": "cddae967-e2c5-345e-abf3-37822a24a1d1",
                                        "glosses": [
                                            "The region of the upper Nile valley now part of Sudan and far-southern Egypt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8455f262-eaea-3323-a997-9ae2b6053134",
                                        "entry_id": "cddae967-e2c5-345e-abf3-37822a24a1d1",
                                        "glosses": [
                                            "The former polity ruling that region."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16705e0d-b5b8-4300-b8f9-136aac5b433b",
                                                "sense_id": "8455f262-eaea-3323-a997-9ae2b6053134",
                                                "text": "Except date trees, and a few grape vines which I saw at Derr, there are no fruit-trees in Nubia.\nThe climate of Nubia, though intensely hot in summer, particularly in the narrow rocky parts of the country, is very healthy, owing perhaps to the extreme aridity of the atmosphere."
                                            },
                                            {
                                                "example_id": "8dd6c43e-bd69-41b0-bc2e-07999a4c0859",
                                                "sense_id": "8455f262-eaea-3323-a997-9ae2b6053134",
                                                "text": "Our knowledge of Nubia at the end of the 19th dynasty gradually becomes sparser. It appears that the Egyptians withdrew to the north, while the local population emigrated to the south."
                                            },
                                            {
                                                "example_id": "93e1d9b5-bfcb-417c-ae60-0fea56da76a9",
                                                "sense_id": "8455f262-eaea-3323-a997-9ae2b6053134",
                                                "text": "Nubia is part of this landscape, created, formed and sustained by the Nile in complex interplays of geology and river hydrology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4ddb793-2e6a-4fa7-855f-2dd2039c7e3f",
                        "source_entry_id": "47900c85-9696-3b53-898d-0311f4988f05",
                        "source_sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                        "target_lang_word": "Nubie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nubie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                        "entry_id": "cc04e58c-0a67-3b11-95d4-60d605bba755",
                                        "glosses": [
                                            "Région du nord du Soudan et du sud de l’Égypte, longeant le Nil."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4ff606-dfd2-434c-b1b5-3218dd6aedba",
                                                "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                                "text": "Le sanctuaire d’Isis fait partie des biens de Nubie qui ont été inscrits au patrimoine mondial de l’Unesco en 1979."
                                            },
                                            {
                                                "example_id": "72df8f5f-8432-4ba7-87c8-0382a3ac5d73",
                                                "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                                "text": "Vu que ces mines n’étaient pas suffisantes, les pharaons obtenaient les quantités voulues d’or des pays voisins comme la Nubie, la Syrie et d’autres pays que l’Égypte dominait, sous la forme de tribut."
                                            },
                                            {
                                                "example_id": "7f3b21ed-184a-4889-8736-9f2009e37219",
                                                "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                                "text": "Elle portait le pagne étriqué et collant que les Égyptiennes du temps des Pharaons léguèrent à la Nubie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1defe52d-1098-4c0b-a50b-06734507c10e",
                        "source_entry_id": "47900c85-9696-3b53-898d-0311f4988f05",
