                "senses": [
                    {
                        "sense_id": "0d73b487-92e5-3ad9-8bc2-8608d14eac80",
                        "entry_id": "3e5a0113-521b-3c67-b34a-e70182fd36c7",
                        "glosses": [
                            "A male nanny (for children)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "9c86d57a-4a60-4429-be58-13e9c5ca8206",
                                "sense_id": "0d73b487-92e5-3ad9-8bc2-8608d14eac80",
                                "text": "2006 [Perry Taylor] has popped up in supermarket tabloids as the male nanny – or \"manny\" – for Britney Spears, who has a 9-month-old son, Sean Preston and is pregnant. — CBS News, 9 June 2006"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cff47d01-57bf-4085-bddc-80829ae9bc58",
                        "source_entry_id": "3e5a0113-521b-3c67-b34a-e70182fd36c7",
                        "source_sense_id": "0d73b487-92e5-3ad9-8bc2-8608d14eac80",
                        "source_sense_description": "male nanny",
                        "target_lang_word": "assistant maternel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assistant maternel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c052e820-638d-3acb-ba9d-60dce91b3580",
                                        "entry_id": "3b82465e-4f47-3e8f-a1c3-8f085569f7a0",
                                        "glosses": [
                                            "Terme générique pour désigner une personne qui s’occupe contre rémunération d’un ou plusieurs jeunes enfants, et qui recouvre le plus souvent les assistantes maternelles (femmes) mais aussi les hommes (Voir le néologisme ci-dessous). Dans les trois exemples qui suivent, assistant maternel ne veut pas dire que ce sont spécialement des hommes (malgré l’emploi du masculin) car il s’agit ici du terme générique."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bac3a01-61b8-49cb-a589-cfc1e2b22c4a",
                                                "sense_id": "c052e820-638d-3acb-ba9d-60dce91b3580",
                                                "text": "Bien plus qu’une simple surveillance, l’assistant maternel s’occupe d’enfants en l’absence de leurs parents. Il veille à leur hygiène, à leur sécurité comme à leur bien-être et à leur éducation."
                                            },
                                            {
                                                "example_id": "e1c2df83-b09e-4ba5-82b9-c9d39dd2464f",
                                                "sense_id": "c052e820-638d-3acb-ba9d-60dce91b3580",
                                                "text": "En outre, l’assistant maternel recevant délégation ne pourra effectuer plus d'heures que celles figurant dans son contrat."
                                            },
                                            {
                                                "example_id": "a059673c-cbfb-49d8-9f32-636a54e4ce94",
                                                "sense_id": "c052e820-638d-3acb-ba9d-60dce91b3580",
                                                "text": "L'« assistant maternel » est la personne qui accueille de jeunes enfants confiés par leurs parents à son domicile tandis que l'« assistant familial » est chargé d'enfants placés au sein d'une famille d'accueil, dans la grande majorité des cas, par le service départemental de l'aide sociale à l'enfance (ASE)."
                                            },
                                            {
                                                "example_id": "e50fc427-bcef-40ab-a1a3-5d2b8614cd2c",
                                                "sense_id": "c052e820-638d-3acb-ba9d-60dce91b3580",
                                                "text": "Toutefois, dans les établissements et services mentionnés au I de l'article 32, dans les écoles maternelles ainsi que pour les assistants maternels, dès lors que le maintien de la distanciation physique entre le professionnel et l'enfant et entre enfants n'est par nature pas possible, l'établissement ou le professionnel concerné met en œuvre les mesures sanitaires de nature à prévenir la propagation du virus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704574d5-e33d-3d3f-a167-4125b707b355",
                                        "entry_id": "3b82465e-4f47-3e8f-a1c3-8f085569f7a0",
                                        "glosses": [
                                            "Professionnel qui garde un ou plusieurs jeunes enfants dans la journée."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9383c1a-663b-47a7-a24c-6cfe312d68b0",
                                                "sense_id": "704574d5-e33d-3d3f-a167-4125b707b355",
                                                "text": "Un document certifiant que la formation remplit les conditions prévues par la présente section est délivré sur la présentation de cette attestation par le directeur régional des affaires sanitaires et sociales de la région du domicile du demandeur à tout assistant maternel ou assistante maternelle qui en fait la demande."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
