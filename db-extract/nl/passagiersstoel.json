                        "entry_id": "9d09ffa5-feac-3977-8e28-b18f98470eab",
                        "glosses": [
                            "stoel in een vervoersmiddel voor iemand die het voertuig niet bestuurt; stoel naast de chauffeur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d819dcb6-76b2-4559-9f96-24b55c4d793d",
                                "sense_id": "a807c6ef-8ab8-3f76-8be6-696073c26255",
                                "text": "De bestuurder is aangehouden. Degene die op de passagiersstoel zat, is op de vlucht geslagen."
                            },
                            {
                                "example_id": "5b97b28c-118b-4f9f-8563-fe6c3e99e22d",
                                "sense_id": "a807c6ef-8ab8-3f76-8be6-696073c26255",
                                "text": "Ik ben van plan om een kijk-onderwerp te maken. Zonder voice-over; gewoon kijken en genieten. Daar hoort muziek bij. Met een stapel klassieke cd's op de passagiersstoel rijd ik naar het noorden. Om precies te zijn: naar mijn roots. Dat maakt deze dag voor mij extra bijzonder."
                            }
                        ]
                    }
