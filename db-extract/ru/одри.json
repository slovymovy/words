                                        "examples": [
                                            {
                                                "example_id": "58e6e33c-ad6e-42b3-9214-d49205d997f7",
                                                "sense_id": "750cd1e4-3cfd-3316-a643-c83898aee1bf",
                                                "text": "Touchstone. Come, sweet Audrey, / We must be married, or we must live in bawdry."
                                            },
                                            {
                                                "example_id": "0a0d3c28-446a-4b62-8eaf-a824dd6b75ef",
                                                "sense_id": "750cd1e4-3cfd-3316-a643-c83898aee1bf",
                                                "text": "She hates her name. What was wrong with the name Audrey? It may not have been something Elise would choose now, but she'd been eighteen when her daughter was born, and the name had seemed pretty damn cool."
                                            }
                                        ]
