{
    "word_family": [
        "frank",
        "frankness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7181f7f2-cb33-31b1-8809-f554251adbb1",
                    "sense_definition": "Used to indicate that the speaker is stating their honest opinion, especially when it might be unpleasant, critical, or surprising.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quite <w>frankly</w>, I am too tired to go out tonight.",
                            "target_lang_translations": {
                                "ru": "<w>Честно говоря</w>, я слишком устал, чтобы идти куда-то сегодня вечером.",
                                "zh": "<w>坦白说</w>，我太累了，今晚不想出门。",
                                "es": "<w>Francamente</w>, estoy demasiado cansado para salir esta noche."
                            }
                        },
                        {
                            "text": "Most of what they said was, <w>frankly</w>, a pack of lies.",
                            "target_lang_translations": {
                                "ru": "Большая часть того, что они сказали, была, <w>откровенно</w>, сплошной ложью.",
                                "zh": "他们说的大部分内容，<w>坦白讲</w>，全是谎话。",
                                "es": "La mayor parte de lo que dijeron era, <w>francamente</w>, un montón de mentiras."
                            }
                        }
                    ],
                    "synonyms": [
                        "honestly",
                        "truthfully",
                        "to be honest",
                        "candidly",
                        "plainly"
                    ],
                    "common_phrases": [
                        "quite frankly",
                        "frankly speaking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы показать, что говорящий высказывает свое честное мнение, особенно если оно может быть неприятным, критическим или неожиданным.",
                        "zh": "用于表示说话人正在表达其真实观点，尤其是在该观点可能令人不快、具有批判性或令人惊讶时。",
                        "es": "Se utiliza para indicar que el hablante expresa su opinión honesta, especialmente cuando esta puede resultar desagradable, crítica o sorprendente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честно говоря",
                                "target_lang_sense_clarification": "вводная фраза для выражения откровенного мнения"
                            },
                            {
                                "target_lang_word": "откровенно",
                                "target_lang_sense_clarification": "вводное слово, часто в сочетании с «говоря»"
                            },
                            {
                                "target_lang_word": "честно",
                                "target_lang_sense_clarification": "разговорный вариант вводного слова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦白说",
                                "target_lang_sense_clarification": "用于引出真实想法的常用插入语"
                            },
                            {
                                "target_lang_word": "老实说",
                                "target_lang_sense_clarification": "用于表达诚恳意见的口语化表达"
                            },
                            {
                                "target_lang_word": "说实话",
                                "target_lang_sense_clarification": "强调所言属实的插入语"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "francamente",
                                "target_lang_sense_clarification": "expresión introductoria para dar una opinión sincera"
                            },
                            {
                                "target_lang_word": "siendo sincero",
                                "target_lang_sense_clarification": "frase hecha para indicar honestidad"
                            },
                            {
                                "target_lang_word": "la verdad es que",
                                "target_lang_sense_clarification": "forma natural de introducir una opinión honesta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c91877a8-dfc8-3eed-b73e-9f133ae51c5e",
                    "sense_definition": "In an open, honest, and direct manner, sometimes to the point of being blunt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke <w>frankly</w> about the difficulties facing the economy.",
                            "target_lang_translations": {
                                "ru": "Он <w>откровенно</w> говорил о трудностях, стоящих перед экономикой.",
                                "zh": "他<w>坦率地</w>谈到了经济面临的困难。",
                                "es": "Habló <w>francamente</w> sobre las dificultades que enfrenta la economía."
                            }
                        },
                        {
                            "text": "She answered the interviewer's questions <w>frankly</w> and without hesitation.",
                            "target_lang_translations": {
                                "ru": "Она отвечала на вопросы интервьюера <w>прямо</w> и без колебаний.",
                                "zh": "她<w>直截了当地</w>回答了面试官的问题，没有丝毫犹豫。",
                                "es": "Respondió a las preguntas del entrevistador <w>francamente</w> y sin dudar."
                            }
                        }
                    ],
                    "synonyms": [
                        "candidly",
                        "openly",
                        "bluntly",
                        "directly",
                        "sincerely"
                    ],
                    "antonyms": [
                        "deceitfully",
                        "evasively"
                    ],
                    "common_phrases": [
                        "speak frankly",
                        "discuss frankly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыто, честно и прямо, иногда до резкости.",
                        "zh": "以公开、诚实和直接的方式，有时甚至直言不讳。",
                        "es": "De una manera abierta, honesta y directa, a veces hasta el punto de ser brusco."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенно",
                                "target_lang_sense_clarification": "искренне, не скрывая мыслей"
                            },
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "непосредственно, без увиливаний"
                            },
                            {
                                "target_lang_word": "открыто",
                                "target_lang_sense_clarification": "не таясь, публично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦率地",
                                "target_lang_sense_clarification": "形容说话态度真诚、不隐瞒"
                            },
                            {
                                "target_lang_word": "直截了当地",
                                "target_lang_sense_clarification": "形容说话直接、不绕弯子"
                            },
                            {
                                "target_lang_word": "开诚布公地",
                                "target_lang_sense_clarification": "形容态度诚恳、公开透明"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "francamente",
                                "target_lang_sense_clarification": "de manera abierta y sin rodeos"
                            },
                            {
                                "target_lang_word": "abiertamente",
                                "target_lang_sense_clarification": "sin ocultar nada"
                            },
                            {
                                "target_lang_word": "directamente",
                                "target_lang_sense_clarification": "sin rodeos ni evasivas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6736cd47-898e-3ebb-a9da-65d9c81555b1",
                    "sense_definition": "To a degree that is clearly evident or unmistakable; often used to emphasize a negative quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suggestion that we should give up now is <w>frankly</w> absurd.",
                            "target_lang_translations": {
                                "ru": "Предложение о том, что нам следует сдаться сейчас, <w>откровенно</w> абсурдно.",
                                "zh": "现在就放弃的建议<w>简直</w>荒谬。",
                                "es": "La sugerencia de que deberíamos rendirnos ahora es <w>francamente</w> absurda."
                            }
                        },
                        {
                            "text": "His behavior during the meeting was <w>frankly</w> bizarre.",
                            "target_lang_translations": {
                                "ru": "Его поведение во время встречи было <w>прямо</w> странным.",
                                "zh": "他在会议期间的表现<w>简直</w>古怪透顶。",
                                "es": "Su comportamiento durante la reunión fue <w>francamente</w> extraño."
                            }
                        }
                    ],
                    "synonyms": [
                        "clearly",
                        "obviously",
                        "plainly",
                        "unmistakably"
                    ],
                    "common_phrases": [
                        "frankly absurd",
                        "frankly impossible",
                        "frankly ridiculous"
                    ],
                    "target_lang_definitions": {
                        "ru": "В степени, которая совершенно очевидна; часто используется для усиления отрицательного качества.",
                        "zh": "达到一种显而易见或毋庸置疑的程度；常用于强调负面特质。",
                        "es": "En un grado que es claramente evidente o inconfundible; a menudo se usa para enfatizar una cualidad negativa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенно",
                                "target_lang_sense_clarification": "явно, несомненно (как усилитель)"
                            },
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "разг. усилительная частица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简直",
                                "target_lang_sense_clarification": "用于强调程度，常带负面色彩"
                            },
                            {
                                "target_lang_word": "简直是",
                                "target_lang_sense_clarification": "用于强调某种性质的极端性"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "用于加强语气，表示程度之深"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "francamente",
                                "target_lang_sense_clarification": "usado como intensificador de un adjetivo"
                            },
                            {
                                "target_lang_word": "claramente",
                                "target_lang_sense_clarification": "de forma evidente"
                            },
                            {
                                "target_lang_word": "sencillamente",
                                "target_lang_sense_clarification": "usado para enfatizar algo obvio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}