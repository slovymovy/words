                                                "sense_id": "e8288e67-80f7-3eb4-b54e-9ab6af416e73",
                                                "text": "it might be advisable to permit the temporary cessation of the papal inquisition"
                                            },
                                            {
                                                "example_id": "ab39c6d7-e518-48ae-975d-c5cc5ba8eba0",
                                                "sense_id": "e8288e67-80f7-3eb4-b54e-9ab6af416e73",
