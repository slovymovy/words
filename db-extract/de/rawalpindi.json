                "senses": [
                    {
                        "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                        "entry_id": "1bd0c100-e98b-35db-a60c-283fe681d84b",
                        "glosses": [
                            "Großstadt in der pakistanischen Provinz Punjab"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5041d388-5804-4fce-ab25-4eae842325ac",
                                "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                                "text": "„Da in Potwar auch die nationalen militärischen (Rawalpindi) und politischen Zentren (Islamabad) des Landes liegen, gilt die Region als vergleichsweise prosperierend und strategisch wichtig.“"
                            },
                            {
                                "example_id": "33f7c5fc-9977-4651-b2ba-332ec9d9b378",
                                "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                                "text": "„Ihr Mann hatte einmal von einem seiner Brüder erzählt, der, wie zu hören war, im Haus des Präsidenten in Rawalpindi angestellt sei.“"
                            },
                            {
                                "example_id": "a957da54-db1c-4b72-a306-e8fb08eb37fe",
                                "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                                "text": "„In Rawalpindi brach ein Toyota Corolla ohne Kennzeichen in Richtung Bahawalpur auf.“"
                            },
                            {
                                "example_id": "40b80a39-66b7-4323-8118-89032cec673a",
                                "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                                "text": "„Es gehörte zu dem Ruf, den General Malik bei seinen Kollegen in Rawalpindi genoss, dass er wusste, wie man mit den Amerikanern umgeht.“"
                            },
                            {
                                "example_id": "9c1b5ce4-245e-4cb6-8f86-9ffd188fec84",
                                "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                                "text": "„Die beiden Mörder, Haq Nawaz und Salim aus Rawalpindi, die von den Taliban festgenommen und ins Gefängnis gebracht wurden, waren beide pakistanische militant-islamische Anhänger der Harkat-ul-Ansar-Gruppe.“"
                            },
                            {
                                "example_id": "73edb64e-d76d-4462-9ee4-7f72ed40324f",
                                "sense_id": "8b89b8cb-1fc6-33ea-9f5c-991f217f67d3",
                                "text": "„Um exakt 14:16 Uhr rauschte ein F-7-Kampfjet chinesischer Bauart, der in den hellgrünen Farben der pakistanischen Luftwaffe gestrichen war, die drei Kilometer lange Rollbahn des Luftstützpunkts Chaklala in Rawalpindi entlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
