                "senses": [
                    {
                        "sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                        "entry_id": "bfe7dcf6-e363-3f06-8272-1939dc14ca15",
                        "glosses": [
                            "buitensporig groot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f09a6245-e770-4fd6-8447-e106ba506265",
                                "sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                                "text": "Hij behaalde er een enorme overwinnig."
                            },
                            {
                                "example_id": "bd22ea9f-fb1e-459a-a05e-2e51d5e16e95",
                                "sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                                "text": "'Op drukke dagen hadden we hier enorme files. Er stond zelfs een gendarme op een rond podiumpje het verkeer te regelen', zegt ze, wijzend op een totaal verlaten kruispunt. Velen hebben zowaar heimwee naar die legendarische files van volgepakte auto's die zich door smalle dorpsstraten wurmden."
                            },
                            {
                                "example_id": "7d09f178-efcb-4959-a286-062d98f7ed26",
                                "sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                                "text": "Het idee om een lange tijd alleen door te brengen trok mij enorm aan, maar vond ik tegelijkertijd doodeng omdat ik geen ervaring had met langdurig alleen zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b01dd4e-887d-4939-9fa0-f0d7d722aa5c",
                        "source_entry_id": "bfe7dcf6-e363-3f06-8272-1939dc14ca15",
                        "source_sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                        "source_sense_description": "buitensporig groot",
                        "target_lang_word": "enorm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enorm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b3a132-3144-3858-8a3d-41db1f1934fd",
                                        "entry_id": "0b8449b1-245d-3fba-851d-24aa34bb8f7a",
                                        "glosses": [
                                            "bedeutend, weitaus mehr als durchschnittlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a902d9a7-c076-4476-84d4-5def149afaa1",
                                                "sense_id": "e8b3a132-3144-3858-8a3d-41db1f1934fd",
                                                "text": "Ihr Vorsprung war enorm."
                                            },
                                            {
                                                "example_id": "7d81f075-2b52-493d-9321-bcf05541e99d",
                                                "sense_id": "e8b3a132-3144-3858-8a3d-41db1f1934fd",
                                                "text": "„Es ist eiskalt, vollkommen dunkel und es herrscht ein enormer Druck von bis zu einer Tonne pro Quadratzentimeter — die Tiefsee scheint ein unwirtlicher Lebensraum zu sein.“"
                                            },
                                            {
                                                "example_id": "c101e525-a10d-4186-be7a-deb5b971ba01",
                                                "sense_id": "e8b3a132-3144-3858-8a3d-41db1f1934fd",
                                                "text": "Der Preisdruck in der Automobilbranche ist enorm. Bei jeder Schraube wird gespart."
                                            },
                                            {
                                                "example_id": "8c355baf-475c-47e1-950e-e0eec89ee654",
                                                "sense_id": "e8b3a132-3144-3858-8a3d-41db1f1934fd",
                                                "text": "„Damit begründete er einen landeseigenen politischen Heiligenkult, der nicht nur Einheit und Identifikation stiftete, die herausgehobene Stellung Prags festigte, ja die Stadt zum Symbol der Herrschaft über Böhmen schlechthin erhob, sondern die Dynastie der Přemysliden, der Wenzel entstammte, auch einen enormen Zuwachs an Prestige und Machtlegitimation verlieh.“"
                                            },
                                            {
                                                "example_id": "825e7bc5-343c-41cd-9dcf-934124816a55",
                                                "sense_id": "e8b3a132-3144-3858-8a3d-41db1f1934fd",
                                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8af3f0a6-1ef2-3a4f-a09c-21e51b160cc7",
                                        "entry_id": "0b8449b1-245d-3fba-851d-24aa34bb8f7a",
                                        "glosses": [
                                            "sehr, über die Maßen"
                                        ],
                                        "tags": [
                                            "adverbielle Verwendung",
                                            "Verstärkung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f89c20f-8284-41b2-ba61-1ce19f78f515",
                                                "sense_id": "8af3f0a6-1ef2-3a4f-a09c-21e51b160cc7",
                                                "text": "Bitte sag die Wahrheit. Für mich ist das enorm wichtig!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fbdc996-0062-47d3-81a2-f4b0e1098426",
                        "source_entry_id": "bfe7dcf6-e363-3f06-8272-1939dc14ca15",
                        "source_sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                        "source_sense_description": "buitensporig groot",
                        "target_lang_word": "enormous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enormous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50d264bd-a8f6-3794-8469-ba634863cb23",
                                        "entry_id": "03455229-bbb1-339a-aba5-93cb37ca45e4",
                                        "glosses": [
                                            "Deviating from the norm; unusual, extraordinary."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba4fcfa-daab-4ff3-a1fe-0fca4f3f3872",
                                                "sense_id": "50d264bd-a8f6-3794-8469-ba634863cb23",
                                                "text": "all shall be rather enforced than hindered, except they be dismembered, or grievously deformed, infirm, or visited with some enormous hereditary disease is body or mind […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                        "entry_id": "03455229-bbb1-339a-aba5-93cb37ca45e4",
                                        "glosses": [
                                            "Exceedingly wicked; atrocious or outrageous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30ea444-7a73-466e-832f-76ab4ef2e955",
                                                "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                                "text": "how apt wee are to receive all impressions, and chiefly the most wicked and enormous."
                                            },
                                            {
                                                "example_id": "95e12722-1d98-4085-8e67-fde0b375b990",
                                                "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                                "text": "Men would prove wolves and vipers; tigers and dragons mixt in one and the same person to each other. O bless God for this great gift of Princes and Judges to rule the wicked and enormous world and to sway the scepter of righteousness […]"
                                            },
                                            {
                                                "example_id": "fee4edf7-5ac7-4a08-8fc2-11029f20ebb3",
                                                "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                                "text": "Protestant Christian people are largely ignorant or indifferent to the wicked and enormous religious claims of Romanism. As a so-called religious organization, Romanism is not only the foe of Protestantism, but […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                        "entry_id": "03455229-bbb1-339a-aba5-93cb37ca45e4",
                                        "glosses": [
                                            "Extremely large; greatly exceeding the common size, extent, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22feedd0-7795-48d9-b718-deff175a2749",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "The enormous Jupiter is the largest planet in the Solar System."
                                            },
                                            {
                                                "example_id": "f912bb4c-8cff-451b-8668-8ced9fdeb3cf",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            },
                                            {
                                                "example_id": "9da9c2c8-a564-4ecd-8078-7a0f79fe74b5",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            },
                                            {
                                                "example_id": "ffab86d3-ae28-4772-a35b-2edb691097ed",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "Piecing together Corbynomics is difficult, not least because it has evolved during Mr Corbyn’s time in charge of Labour. The gulf between the Labour leadership’s past positions and the milder proposals in the manifesto means that enormous uncertainty hangs over what a Corbyn-led government would do in office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a3a91ab-33cf-4da1-867f-89f725d80889",
                        "source_entry_id": "bfe7dcf6-e363-3f06-8272-1939dc14ca15",
                        "source_sense_id": "93da8bfb-7509-3c85-9596-82c7bb599afb",
                        "source_sense_description": "buitensporig groot",
                        "target_lang_word": "énorme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "énorme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4f66a32-41c8-3c63-9cb1-8784bb78251d",
                                        "entry_id": "87392760-dc7d-3439-bca6-34e44692f740",
                                        "glosses": [
                                            "Très grand; qui excède de beaucoup la grandeur ou la grosseur habituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58281a4-b230-4cef-a3a8-3afafe2cb046",
                                                "sense_id": "f4f66a32-41c8-3c63-9cb1-8784bb78251d",
                                                "text": "Sous un ciel fuligineux et sur une mer furieuse, un voilier démâté fuyait la tempête, donnant fortement de la bande, luttant désespérément contre l’assaut d’énormes vagues bondissantes qui se ruaient, secouant leurs crinières écumantes."
                                            },
                                            {
                                                "example_id": "3e37401b-b34b-4e4c-9c7c-3f799dca1789",
                                                "sense_id": "f4f66a32-41c8-3c63-9cb1-8784bb78251d",
                                                "text": "L’énorme rouf construit sur l’embarcation et son gréement, démontraient l’inexpérience totale que son propriétaire avait des choses de la mer."
                                            },
                                            {
                                                "example_id": "f9ebd5c1-e06f-4be6-9b01-09b2307b0dd7",
                                                "sense_id": "f4f66a32-41c8-3c63-9cb1-8784bb78251d",
                                                "text": "Je fourre l’énorme pistolet dans mon froc et voilà le canon qui glisse dans mon slip. Je n'arrive pas, assis, à l’extirper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48637283-818b-3e62-8947-67f81c1e9509",
                                        "entry_id": "87392760-dc7d-3439-bca6-34e44692f740",
                                        "glosses": [
                                            "Qui dépasse la mesure commune."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "note": "Se dit tant au sens physique qu’au sens moral",
                                        "examples": [
                                            {
                                                "example_id": "d7146698-19a5-490e-8f25-adaf4c9d19e7",
                                                "sense_id": "48637283-818b-3e62-8947-67f81c1e9509",
                                                "text": "Les assaillants, amplement pourvus d’explosifs, causèrent, tant à Berlin qu’en Franconie, des dommages énormes."
                                            },
                                            {
                                                "example_id": "e2b8cbc5-2a7f-46fe-8c81-902f1e5b9274",
                                                "sense_id": "48637283-818b-3e62-8947-67f81c1e9509",
                                                "text": "Mais Lili achevait de parler et modulait des mots énormes comme une flûte angélique."
                                            },
                                            {
                                                "example_id": "74bf6e7e-4a04-46cc-b478-e6393328d70d",
                                                "sense_id": "48637283-818b-3e62-8947-67f81c1e9509",
                                                "text": "Il m'introduisit ensuite dans le bureau où siégeait son supérieur, monsieur Omochi, qui était énorme et effrayant, ce qui prouvait qu'il était le vice-président. aka randy"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
