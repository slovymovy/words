                        ],
                        "examples": [
                            {
                                "example_id": "a8ba687b-2fd9-49c9-9695-f5dddcb6afbe",
                                "sense_id": "44d281dc-34c2-32f3-a56b-13265ecf37c8",
                                "text": "So excellent a king, that was to this / Hyperion to a satyr, so loving to my mother / That he might not beteem the winds of heaven / Visit her face too roughly."
                            }
                        ]
                    },
                    {
                        "sense_id": "3399f43b-be6b-3b93-a0ba-27dccd0c5d36",
