                },
                {
                    "sense_id": "10edcf8a-177b-3ee8-bca9-eb5dd022840e",
                    "sense_definition": "Iemand die zich vies, onbeschaafd of moreel verwerpelijk gedraagt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ruim je kamer eens op, je leeft hier echt als een <w>zwijn</w>!",
                            "target_lang_translations": {
                                "en": "Clean up your room for once, you really live like a <w>pig</w> here!"
                            }
                        },
                        {
                            "text": "Die onbeleefde man gedroeg zich als een echt <w>zwijn</w> tegenover de serveerster.",
                            "target_lang_translations": {
                                "en": "That rude man behaved like a real <w>swine</w> towards the waitress."
                            }
