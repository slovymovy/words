                    {
                        "sense_id": "6939a7c6-de6f-3b0b-b5c1-9ee748cbbae8",
                        "entry_id": "5554573b-ffc1-3115-9a27-b50f9623e2ba",
                        "glosses": [
                            "een beschadiging in of aan het lichaam"
                        ],
                        "tags": [
                            "Vlaanderen en Limburg"
                        ],
                        "examples": [
                            {
                                "example_id": "5799bc9c-f487-42a6-a03b-2e7c50db3a33",
                                "sense_id": "6939a7c6-de6f-3b0b-b5c1-9ee748cbbae8",
                                "text": "Door zijn val had hij een diepe wonde in zijn been."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae0556ae-7b52-434d-b764-b0fc77ef605d",
                        "source_entry_id": "5554573b-ffc1-3115-9a27-b50f9623e2ba",
                        "source_sense_id": "6939a7c6-de6f-3b0b-b5c1-9ee748cbbae8",
                        "source_sense_description": "een beschadiging in of aan het lichaam",
                        "target_lang_word": "Wunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                        "entry_id": "30d35b71-61ef-3f33-a959-52c1bc3bfd02",
                                        "glosses": [
                                            "offene Verletzung in der Haut oder im tieferliegenden Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7411c44-db25-4e9a-8bbc-8590c907dd3a",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "Die Kontrahenten fügten sich mit dem Schwert gegenseitig tiefe Wunden zu."
                                            },
                                            {
                                                "example_id": "f730ab40-ca88-4060-af5a-0b630dd8a9b7",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Was er eine ernste Wunde nannte, wußte sie aus seiner Vergangenheit.“"
                                            },
                                            {
                                                "example_id": "6f0bbbdd-4766-4025-adaf-3db081c4b871",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Die Wunde schlug eine Gürtelschnalle.“"
                                            },
                                            {
                                                "example_id": "62734791-d925-4f2e-94e8-b16e6837d955",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Und der Geruch aus seinen Wunden lockte zahllose Fliegen herbei.“"
                                            },
                                            {
                                                "example_id": "7bda8dd9-571d-484b-a8b7-1236c97540bd",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Auch in dieser Situation hatte er eine gute Figur gemacht, hatte die Wunde gereinigt, einbalsamiert und verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53ff5459-82fc-336b-bc11-04ef172b7f74",
                                        "entry_id": "30d35b71-61ef-3f33-a959-52c1bc3bfd02",
                                        "glosses": [
                                            "psychische Verletzung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc8fe59-65b5-425a-ae32-86ff893645db",
                                                "sense_id": "53ff5459-82fc-336b-bc11-04ef172b7f74",
                                                "text": "Die Zeit im Krisengebiet hatte Wunden in ihrer Seele hinterlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
