                                                "example_id": "897e8601-1b03-428e-93ed-7a2677c31b73",
                                                "sense_id": "44363682-de96-3e13-a916-361e98b8431a",
                                                "text": "threads soy asf ngl"
                                            },
                                            {
                                                "example_id": "8392b009-0cd7-4b45-a6a1-93cf734389af",
                                                "sense_id": "44363682-de96-3e13-a916-361e98b8431a",
                                                "text": "\"I want a bad bitch bpd art hoe to RUIN MY LIFE\" typed by the soyest man alive"
                                            },
                                            {
                                                "example_id": "321576b0-0809-4d36-b4b3-e4a967acae4e",
                                                "sense_id": "44363682-de96-3e13-a916-361e98b8431a",
                                                "text": "Seething about beer and football is objectively far soyer than enjoying yourself like a normal person. If they stop following their team they're not going to automatically manifest as the Anglo Atatürk, they're just going to waste their time some other way"
                                            }
                                        ]
                                    }
