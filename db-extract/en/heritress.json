                        "entry_id": "3f8b1d0e-3ab2-397d-bc40-592f3b333cf4",
                        "glosses": [
                            "A female heritor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ba1dc4-2fd5-4358-80a3-452c32f0cd12",
                                "sense_id": "803ac595-bc3c-38e7-a226-dbc494994189",
                                "text": "The mightiest monarch of his age, Sovereign of England—as his proud grandsire made his vaunt of yore—by right of the sword’s edge; Grand Duke of Normandy, by privilege of blood; and liege-lord of Guienne, by marriage with its powerful Heritress;"
                            },
                            {
                                "example_id": "7319aecc-e6af-494f-ad9e-b5e0104d607b",
                                "sense_id": "803ac595-bc3c-38e7-a226-dbc494994189",
                                "text": "One of those archdukes married the Heritress of the Netherlands."
                            },
                            {
                                "example_id": "705f374a-61a9-482d-bf33-6cf67b659ac0",
                                "sense_id": "803ac595-bc3c-38e7-a226-dbc494994189",
                                "text": "M. and Madame Chateauneuf were delighted with the child, observing that ‘she spoke Latin, French, and Italian well, sufficiently handsome in the face, and without doubt the lawful heritress of the kingdom, if James of Scotland be excluded.’"
                            }
                        ]
                    }
