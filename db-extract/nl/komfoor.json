                "senses": [
                    {
                        "sense_id": "c1a191f0-8ef7-3a07-8fd5-437549b2b72d",
                        "entry_id": "eed00f9b-59cf-3acb-8b3f-9afb7279a9d7",
                        "glosses": [
                            "een toestel om iets in warm te maken of te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3909e3c5-cbf8-4cda-92f1-f6a965d794d0",
                                "sense_id": "c1a191f0-8ef7-3a07-8fd5-437549b2b72d",
                                "text": "Pak het komfoor even als je wilt."
                            }
                        ]
                    },
                    {
                        "sense_id": "aec011ce-6a91-334e-ad3f-603010180015",
                        "entry_id": "eed00f9b-59cf-3acb-8b3f-9afb7279a9d7",
                        "glosses": [
                            "een kooktoestel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b94dff-1f32-4b5a-9536-9c7c21f8eaec",
                                "sense_id": "aec011ce-6a91-334e-ad3f-603010180015",
                                "text": "We moeten nog even een nieuw komfoor kopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f25e4cf0-e3f8-472a-bc64-330361133794",
                        "source_entry_id": "eed00f9b-59cf-3acb-8b3f-9afb7279a9d7",
                        "target_lang_word": "stove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85df5616-af52-3dac-b619-e45fe1ab571d",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A heater, a closed apparatus to burn fuel for the warming of a room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d53f0fe-6ee1-4985-aac1-13bfe8f44e72",
                                                "sense_id": "85df5616-af52-3dac-b619-e45fe1ab571d",
                                                "text": "1815 Robertson Buchanan, Appendix to A Treatise on the Economy of Fuel, and Management of Heat, Especially as it Relates to Heating and Drying by Means of Steam. p. 309.\n[I]n the countries of modern Europe, the use of stoves prevail throughout the north; while in France and Great Britain, open fires are used. In the warm countries of Italy and Spain, there are very few chimneys, and the only method usually practised of tempering the cold... is to burn charcoal in portable brasiers."
                                            },
                                            {
                                                "example_id": "881a5568-9eb9-4e85-ad79-87b9a1bf7abe",
                                                "sense_id": "85df5616-af52-3dac-b619-e45fe1ab571d",
                                                "text": "We toted in the wood and got the fire going nice and comfortable. Lord James still set in one of the chairs and Applegate had cabbaged the other and was hugging the stove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e11f74-3a8f-3bc0-a402-83606d292c45",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A device for heating food, (UK) a cooker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cce6a5a4-8f7b-3726-8114-6ea2782f6f55",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A stovetop, with hotplates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c26ae48-3e52-32e0-a1dc-f964b9479737",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A hothouse (heated greenhouse)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca8e21e-2e21-47f9-9e7e-1059d9b7795b",
                                                "sense_id": "8c26ae48-3e52-32e0-a1dc-f964b9479737",
                                                "text": "There existed only one specimen of this sacred tree in all Mexico, at least to the knowledge of the Mexicans; […] In spite, however, of the firmest convictions of the indivisibility of this tree — the Manitas, as it is commonly called — it has been propagated by cuttings, some of which are at this moment thriving in some of the larger stoves of our modern collectors."
                                            },
                                            {
                                                "example_id": "9d1beaae-5282-4f89-8125-0707ffd7daf8",
                                                "sense_id": "8c26ae48-3e52-32e0-a1dc-f964b9479737",
                                                "text": "Let but these facts lie contrasted with the treatment they usually receive in the stoves of this country, and the reason why they never grow to any considerable size, attain to any degree of perfection, or flourish to any extent […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f9835d-92e3-3865-85b2-b2043dd59c4c",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A house or room artificially warmed or heated."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8b455d6-4488-4695-83d1-8625a303b89b",
                                                "sense_id": "42f9835d-92e3-3865-85b2-b2043dd59c4c",
                                                "text": "April 1, 1634, Thomas Wentworth, 1st Earl of Strafford, letter to the Lord Deputy\nWhen most of the waiters were commanded away to their supper, the Parlour or Stove being near emptied, in came a Company of Musketeers."
                                            },
                                            {
                                                "example_id": "85f89fba-efb3-4edc-9d6d-6f0039e8cfda",
                                                "sense_id": "42f9835d-92e3-3865-85b2-b2043dd59c4c",
                                                "text": "How tedious is it to them that live in stoves and caves half a year together, as in Iceland, Muscovy, or under the pole!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f271c2e6-e0fb-30b8-b473-78d69973f241",
                                        "entry_id": "e22e043c-b7be-3070-b441-47def955c1af",
                                        "glosses": [
                                            "To heat or dry, as in a stove."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a06ae63-d088-4e10-a98a-39ff83158ee9",
                                                "sense_id": "f271c2e6-e0fb-30b8-b473-78d69973f241",
                                                "text": "to stove feathers"
                                            },
                                            {
                                                "example_id": "5674cd82-2f27-4d26-9fe8-3bc6f1db1bac",
                                                "sense_id": "f271c2e6-e0fb-30b8-b473-78d69973f241",
                                                "text": "The wide use of amine-cured epoxy paints is mostly due to their providing many of the properties of stoved epoxy films from an ambient temperature-cured system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e22781e5-8271-380f-88a0-2085d905c0ae",
                                        "entry_id": "e22e043c-b7be-3070-b441-47def955c1af",
                                        "glosses": [
                                            "To keep warm, in a house or room, by artificial heat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec0f495-75bc-4105-be2f-4614bb6548fc",
                                                "sense_id": "e22781e5-8271-380f-88a0-2085d905c0ae",
                                                "text": "to stove orange trees"
                                            },
                                            {
                                                "example_id": "92cd43f1-147d-498a-8e66-12121597eec3",
                                                "sense_id": "e22781e5-8271-380f-88a0-2085d905c0ae",
                                                "text": "orange-trees , lemon-trees , and myrtles , if they be stoved"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739afdaa-deaa-369a-9dcc-71122558ff55",
                                        "entry_id": "e22e043c-b7be-3070-b441-47def955c1af",
                                        "glosses": [
                                            "To jam; to sprain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2750b7a6-df9c-4c9c-8963-a1b22dfb7ab2",
                                                "sense_id": "739afdaa-deaa-369a-9dcc-71122558ff55",
                                                "text": "to stove a finger"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                        "entry_id": "68f391c4-8836-35bd-a7df-42cafc6e1cd2",
                                        "glosses": [
                                            "simple past and past participle of stave"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6609bac9-91dc-437b-844c-bbbfa310295a",
                                                "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                                "text": "[A]ye, a stove boat will make me an immortal by brevet."
                                            },
                                            {
                                                "example_id": "b65e469f-527b-4487-b7b5-80e5d8e8e273",
                                                "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                                "text": "\"A dead whale or a stove boat!\""
                                            },
                                            {
                                                "example_id": "931701ea-685e-4957-97f8-85cb70f6f50c",
                                                "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                                "text": "\"Our cracked four-pounders made an awful din / but with one fat ball, the Yank stove us in.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "093cb57d-772f-42fe-b17a-63b268afcad5",
                        "source_entry_id": "eed00f9b-59cf-3acb-8b3f-9afb7279a9d7",
                        "target_lang_word": "cooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1636de1c-b2ef-3b2f-a802-08fdf545c70f",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "A cookstove."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc82f8e6-33b8-39cf-92e3-4a29bbbc6fd0",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "An appliance or utensil for cooking food."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "One who cooks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc0b434-0b8e-4a4d-92d7-6f967961d1e0",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "[…] I am a true † cooker of men, that is to ſay, I not only dreſs and prepare ſuch vile eatables as theſe, but that green creature, called man, I kill, and cut in pieces, aye, and devour him too, heart and all."
                                            },
                                            {
                                                "example_id": "fdc81988-d99a-47fa-821b-f528521f742b",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "And, if we may believe the tale, / Her canny hand will ſcarcely fail, / Whate’er ſhe tries, to help or heal, / She’ll ſeldom blunder; / If ſhe be cooker of the kail, / She’ll gar us wonder."
                                            },
                                            {
                                                "example_id": "edd0fc09-4f80-48c1-b7d4-1d8f631e829e",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "She was, in sooth, a most delicious cooker of delicious tit-bits."
                                            },
                                            {
                                                "example_id": "6ea606c2-4a0e-4e0b-b7c6-fcb4597261c7",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "“A most excellent cooker of eggs, is Mrs. J.,” I said to my companion (silent companions are often the best of company); “most excellent. Few people can be relied upon to always cook one’s eggs properly, but Mrs. J. is one of the few.”"
                                            },
                                            {
                                                "example_id": "486c8b3e-8491-4cab-9f4b-45283fa0139b",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "As the hon. Provincial Treasurer knows, he is the greatest cooker of the books, and when he leaves here he can get a job as a chef at the King Edward hotel—"
                                            },
                                            {
                                                "example_id": "4095fc2b-7e03-418d-89d5-8397f1e6e8a7",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "“[…] I know how to cook a steak, if you don’t.” “I am, sir, one of the world’s great cookers of steak,” Charley said."
                                            },
                                            {
                                                "example_id": "c2378be7-b446-4fca-be4c-e13e75cc41e6",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "The question was asked by a guy named Ernie, who lives on the South Side and believes he is the greatest cooker of ribs in the land. […] Besides the admiration and envy of the nation’s rib cookers, the winner will receive a trophy and a special license plate indicating big achievement."
                                            },
                                            {
                                                "example_id": "d938e17b-a9f7-49f7-990d-eb0efe783b97",
                                                "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                                                "text": "Duke Ellington, the royal man of jazz, claimed he was the “world’s greatest cooker of eggs” and also swore by the stimulating nature of caviar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a6f474-3520-3d46-a0db-75bb3c9164a4",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "Ellipsis of cooking apple."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43046d86-7bc7-43bc-8595-789c08375bd6",
                                                "sense_id": "e7a6f474-3520-3d46-a0db-75bb3c9164a4",
                                                "text": "For the British market, apples are classed as early, mid-season, or late, and subdivided into eaters or cookers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd91fc3-cffe-3919-89bd-38ca58f57013",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "A person who makes or uses illicit drugs, especially methamphetamine or cannabis."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31f61a21-05c5-335b-a74e-133249f7bcb0",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "The container in which recreational drugs are prepared."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7125235-2e9e-4f42-90da-ad104f7087fa",
                                                "sense_id": "31f61a21-05c5-335b-a74e-133249f7bcb0",
                                                "text": "[…] does not know how to pick up the liquid from the cooker, and he asks someone else to use his rig to put his part in his rig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b05a4656-cbba-3880-bf08-64ba01ef1ea8",
