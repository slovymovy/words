                        "target_lang_word": "spationaut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spationaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df8d9c48-43a1-3920-a062-c13bf8777fbc",
                                        "entry_id": "2ba5ed91-aaff-3a06-a2bd-f51f44780481",
                                        "glosses": [
                                            "An astronaut, regardless of nationality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2819d37e-8250-4593-aa7e-19261f6a2cd7",
                                                "sense_id": "df8d9c48-43a1-3920-a062-c13bf8777fbc",
                                                "text": "How many spationauts are there?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8938174-fff5-3878-8e38-6849d2c4b3ed",
                                        "entry_id": "2ba5ed91-aaff-3a06-a2bd-f51f44780481",
                                        "glosses": [
                                            "A French spationaut or astronaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c6d04d-9b70-4ea4-9a7b-363762006e3a",
                                                "sense_id": "d8938174-fff5-3878-8e38-6849d2c4b3ed",
                                                "text": "Long term cosmonauts Gennadiy Manakov and Aleksandr Polishchuk, who arrived at Mir on Jan. 24th, will be flying French Spationaut Jean-Pierre Haignere in the older Soyuz TM-16 capsule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8918f2f-6dfb-31b1-94de-c561879d0b18",
                                        "entry_id": "2ba5ed91-aaff-3a06-a2bd-f51f44780481",
                                        "glosses": [
                                            "A European astronaut, specifically one representing ESA."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81020088-9bc9-4556-82cf-806c101f64bd",
                                                "sense_id": "b8918f2f-6dfb-31b1-94de-c561879d0b18",
                                                "text": "The next flight to the ISS is scheduled for April 19th and will be composed of Russian cosmonaut Guennady Padalka, American astronaut Michael Fincke and ESA Dutch spationaut André Kuipers. [ESA, AFP 04/02/2004, Air & Cosmos 04/09/2004]"
                                            },
                                            {
                                                "example_id": "e9ed1c28-fa8b-49b6-8040-d182f462442e",
                                                "sense_id": "b8918f2f-6dfb-31b1-94de-c561879d0b18",
                                                "text": "Considering the weight problems that Hermes ran into, the astronauts probably thought that they were lucky to have seats, much less ejection seats, rather than slings to sit in. Something about an ESA spationaut putting their ass into a sling is unappealing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a27f8b-ba87-4379-b95b-37d8a96a6df5",
                        "source_entry_id": "808a17ce-3237-35d5-b53d-9c3b649a3af2",
                        "source_sense_id": "0bb3807b-6dd6-3eb3-ba24-0e51aca948e1",
                        "source_sense_description": "französischer Weltraumfahrer",
                        "target_lang_word": "spationaute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spationaute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85de734e-b9c3-3921-8c11-2ea73beb562c",
                                        "entry_id": "44d92235-7bcc-3f39-9b25-73bbf47fcc60",
                                        "glosses": [
                                            "Astronaute français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c251492-ae73-4f31-b01e-c610b1ddc658",
                                                "sense_id": "85de734e-b9c3-3921-8c11-2ea73beb562c",
                                                "text": "Première spationaute française de l’histoire, elle avait effectué en 1996 un séjour à bord de la station spatiale russe Mir et en 2001 à bord de la station spatiale internationale (ISS)."
                                            },
                                            {
                                                "example_id": "2fe0c040-4c66-4381-8e8a-21fff5585d03",
                                                "sense_id": "85de734e-b9c3-3921-8c11-2ea73beb562c",
                                                "text": "Le président est accompagné de Thomas Pesquet et de la nouvelle spationaute française, Sophie Adenot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3401d93-67f4-334f-ad1a-d5f52598b2be",
                                        "entry_id": "44d92235-7bcc-3f39-9b25-73bbf47fcc60",
                                        "glosses": [
                                            "Astronaute quelle que soit sa nationalité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
