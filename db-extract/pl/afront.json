                "senses": [
                    {
                        "sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                        "entry_id": "fa9fcc75-ebd0-383f-a291-27583d1b496d",
                        "glosses": [
                            "zniewaga, lekceważące zachowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0256a1a7-a484-4603-b527-3da9b9b0e130",
                                "sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                                "text": "Zrobiła mi dziś afront, komentując przy wszystkich moją nadwagę."
                            },
                            {
                                "example_id": "fdc955e6-fa43-4af5-8b97-b0be0b1bf897",
                                "sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                                "text": "Musi on za ten afront odpokutować, bo to całego stanu szlacheckiego krzywda."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ff484b-3bbf-4708-87c6-742a05b91d50",
                        "source_entry_id": "fa9fcc75-ebd0-383f-a291-27583d1b496d",
                        "source_sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                        "target_lang_word": "affront",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affront",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                        "entry_id": "8f30f099-2833-3d40-a2ba-f5d4b8f0bd19",
                                        "glosses": [
                                            "Outrage fait en face, soit en paroles, soit en action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "404e9152-61c7-4d44-b2e8-f2a6b0bf06d1",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Ensuite, il se fâcha, força le docteur à accepter un verre de quelque chose. La demoiselle ne lui ferait pas l’affront de refuser du sirop."
                                            },
                                            {
                                                "example_id": "f2f22cd3-8117-4391-93c3-cd4874fd7243",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Par une inconcevable mansuétude, Elle avait toléré l’affront des fêtes décadaires, l’outrage de la déesse Raison vautrée sur l’autel à sa place […]"
                                            },
                                            {
                                                "example_id": "9a6bbb03-5098-4e6b-be04-489810668a6a",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Vous n’allez pas me faire l’affront de me refuser le logement que je vous offre."
                                            },
                                            {
                                                "example_id": "b37ae458-db98-4a14-b9f7-4be7b0fcf293",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Il a reçu un grand affront."
                                            },
                                            {
                                                "example_id": "f35f68fd-e2d0-4b69-a169-766162e74cbf",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Endurer, venger un affront."
                                            },
                                            {
                                                "example_id": "bdbe005f-6808-42ad-b0b4-c2723321445f",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Essuyer un affront : Recevoir un affront."
                                            },
                                            {
                                                "example_id": "4def4d1f-d3fb-40cb-9640-f7e5744c1409",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Boire un affront, avaler un affront, dévorer un affront : Ne pas laisser paraître les sentiments qu’on éprouve en recevant un affront."
                                            },
                                            {
                                                "example_id": "e93e787d-7d6c-4368-95e5-070dc6594404",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Ne pouvoir digérer un affront : Avoir toujours sur le cœur un affront qu’on a reçu."
                                            },
                                            {
                                                "example_id": "eb4376a3-5ca4-4f25-a0d3-040d43496abf",
                                                "sense_id": "c4715c8c-7274-3169-a6fb-cf6617a11655",
                                                "text": "Il ne saurait digérer cet affront."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0c70a1-7504-3f86-9181-e474b7dc63f2",
                                        "entry_id": "8f30f099-2833-3d40-a2ba-f5d4b8f0bd19",
                                        "glosses": [
                                            "Honte, déshonneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74885514-5782-473e-97e6-c73ee44436a4",
                                                "sense_id": "5f0c70a1-7504-3f86-9181-e474b7dc63f2",
                                                "text": "Il fait affront à ses parents."
                                            },
                                            {
                                                "example_id": "80a5be4f-cd42-4e13-83d3-716d3f361c84",
                                                "sense_id": "5f0c70a1-7504-3f86-9181-e474b7dc63f2",
                                                "text": "Vous pouvez répondre hardiment de lui, il est honnête homme, il ne vous fera point affront."
                                            },
                                            {
                                                "example_id": "97ff3eca-8065-4f5d-ac3b-df95ffba215e",
                                                "sense_id": "5f0c70a1-7504-3f86-9181-e474b7dc63f2",
                                                "text": "Les armes de ce prince reçurent un affront devant cette place."
                                            },
                                            {
                                                "example_id": "bfee2d03-4df9-400f-972f-43aa1e8804ac",
                                                "sense_id": "5f0c70a1-7504-3f86-9181-e474b7dc63f2",
                                                "text": "Si vous entreprenez cette affaire, l’affront vous en demeurera, vous en restera. Il vieillit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faaec32c-ce25-4771-a05f-0fed42bc02a9",
                        "source_entry_id": "fa9fcc75-ebd0-383f-a291-27583d1b496d",
