                    {
                        "sense_id": "10e26ffd-6ba4-3efe-bf56-286912b7e56d",
                        "entry_id": "7b2565d0-93e8-35d5-ac69-0df25b7ce4ab",
                        "glosses": [
                            "Teil eines Militärs, der über Chemiewaffen verfügt, Chemiewaffen entwickelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37addd9e-47db-4624-86c7-5d5cc8f5a50a",
                                "sense_id": "10e26ffd-6ba4-3efe-bf56-286912b7e56d",
                                "text": "„Aber der kanadische Inspekteur und sein Team entdeckten keine Anzeichen eines Chemiewaffenprogramms.“"
                            },
                            {
                                "example_id": "34a79c6e-f0ff-4d92-a805-f3627fe3b731",
                                "sense_id": "10e26ffd-6ba4-3efe-bf56-286912b7e56d",
                                "text": "„Analog zu den berüchtigten Khan-Labors, in denen Pakistans staatlich gefördertes Atomprogramm entstanden war und dann an Kunden in aller Welt exportiert wurde, begann Einstein seine Laufbahn im noch jungen Chemiewaffenprogramm seines Landes.“"
                            }
                        ],
