                        "glosses": [
                            "In a classical manner; according to the manner of classical authors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ffaa4a6-01ce-46e1-9e89-57db0d6f525b",
                                "sense_id": "634df902-9d1c-3698-9dac-96c681776198",
                                "text": "In the derivation of novel no-signaling monogamies, we uncover a new feature, namely that two-party Bell expressions that are trivially classically saturated can become non-trivial upon the addition of an expression involving a third party with a single measurement input."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ed40ddc-89a6-3b2d-95ad-9a5a1952af6b",
                        "entry_id": "e3558d4a-f3eb-37a2-8eea-ae586118cd6c",
                        "glosses": [
                            "In the manner of classes; according to a regular order of classes or sets."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fcea63e-42a9-4ed2-aa98-80749ebee68a",
                        "source_entry_id": "e3558d4a-f3eb-37a2-8eea-ae586118cd6c",
                        "source_sense_description": "in a classical manner",
                        "target_lang_word": "classiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
