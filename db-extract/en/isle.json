                "senses": [
                    {
                        "sense_id": "b5b158c1-8439-351e-aa14-ccac9f7a3650",
                        "entry_id": "ae81461f-7372-3fc3-a6d5-beccac6f1bde",
                        "glosses": [
                            "die Insel oder kleine Insel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8741ef07-095e-427e-9ee3-0af2eb42ebd2",
                        "source_entry_id": "ae81461f-7372-3fc3-a6d5-beccac6f1bde",
                        "source_sense_id": "b5b158c1-8439-351e-aa14-ccac9f7a3650",
                        "source_sense_description": "die Insel oder kleine Insel",
                        "target_lang_word": "Insel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac927a15-d104-3bca-bd4b-f15c22c2d540",
                                        "entry_id": "f645724d-40bc-3a34-9b77-13e68354f52d",
                                        "glosses": [
                                            "vollständig von Wasser umgebenes Stück Land, das nicht als Kontinent gilt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e29884-7c29-4607-8ad3-5129c4cca075",
                                                "sense_id": "ac927a15-d104-3bca-bd4b-f15c22c2d540",
                                                "text": "Guernsey ist eine Insel."
                                            },
                                            {
                                                "example_id": "08dde612-224f-4627-a1eb-f938be6e4d64",
                                                "sense_id": "ac927a15-d104-3bca-bd4b-f15c22c2d540",
                                                "text": "„Die Affenbrücke, die von der metallenen Einzäunung des Teichs zur Insel gespannt wurde, war die erste, die in dieser Stadt 24 Stunden überdauerte.“"
                                            },
                                            {
                                                "example_id": "013353c9-8ceb-4402-871e-46cf2dc8b3a6",
                                                "sense_id": "ac927a15-d104-3bca-bd4b-f15c22c2d540",
                                                "text": "„Kolumbus war überzeugt, dass er an einer kleinen Insel vor der Küste Ostasiens angelangt war, und dass die Menschen, denen er am Strand begegnete, Inder waren (weshalb die Ureinwohner bis heute als »Indios« oder »Indianer« bezeichnet werden).“"
                                            },
                                            {
                                                "example_id": "9079998c-4201-4fa7-9d21-966e35f7aa7d",
                                                "sense_id": "ac927a15-d104-3bca-bd4b-f15c22c2d540",
                                                "text": "„Jamaika, eine Insel der Sonne, des Meeres. Wer denkt dabei nicht an Bob Marley, an Reggae und gute Laune?“"
                                            },
                                            {
                                                "example_id": "adbddfae-92f0-498f-a1c5-e999c3c049bf",
                                                "sense_id": "ac927a15-d104-3bca-bd4b-f15c22c2d540",
                                                "text": "„Was meint ihr, wo die Insel des Glücks liege! Überall, wo Heimat ist! Überall, wo ihr wollt! Wo eure Sehnsucht Anker warf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b828903-e95c-4809-9beb-4af4db7db01b",
                        "source_entry_id": "ae81461f-7372-3fc3-a6d5-beccac6f1bde",
                        "source_sense_id": "b5b158c1-8439-351e-aa14-ccac9f7a3650",
                        "source_sense_description": "die Insel oder kleine Insel",
                        "target_lang_word": "Eiland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eiland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4eefc59-95e2-3a83-8b3a-6afff49e2553",
                                        "entry_id": "b79697aa-28b3-3e77-a11e-3c8ec62a27d0",
                                        "glosses": [
                                            "Insel"
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f556ef3d-df3e-4e0b-98a3-4131a9ae33c3",
                                                "sense_id": "c4eefc59-95e2-3a83-8b3a-6afff49e2553",
                                                "text": "Rottum ist nur ein Eiland."
                                            },
                                            {
                                                "example_id": "b23779a0-a4de-468c-94fe-2894404c5932",
                                                "sense_id": "c4eefc59-95e2-3a83-8b3a-6afff49e2553",
                                                "text": "„Das Eiland war unbewohnt gewesen, als portugiesische Seefahrer es 1470 entdeckten.“"
                                            },
                                            {
                                                "example_id": "2a288eb9-acc1-433f-98ce-ba9e47b32331",
                                                "sense_id": "c4eefc59-95e2-3a83-8b3a-6afff49e2553",
                                                "text": "„Die Auswanderer wissen nur ungefähr, wo sich das verheißungsvolle Eiland befindet, denn Kompass und Seekarten kennen sie nicht.“"
                                            },
                                            {
                                                "example_id": "f6107ccc-b3db-46dd-a387-89ea3a0af088",
                                                "sense_id": "c4eefc59-95e2-3a83-8b3a-6afff49e2553",
                                                "text": "„Das Eiland würde dadurch nicht schöner, die Welfare aber größer.“"
                                            },
                                            {
                                                "example_id": "64a207b6-cd05-40cd-8afe-f9933dc674b6",
                                                "sense_id": "c4eefc59-95e2-3a83-8b3a-6afff49e2553",
                                                "text": "„Wir brechen am frühen Morgen zu den Eilanden auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
