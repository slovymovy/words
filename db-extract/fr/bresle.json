                    {
                        "sense_id": "3d7b08a1-f199-3399-a902-b09d66eb162e",
                        "entry_id": "74ae4071-d503-3c57-878e-2c88eff5579b",
                        "glosses": [
                            "Fleuve côtier du nord de la France et qui marque la limite entre la Picardie et la Haute-Normandie."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "174e8890-2855-4170-806b-2659b0426225",
                                "sense_id": "3d7b08a1-f199-3399-a902-b09d66eb162e",
                                "text": "La tourbe existe, mais seulement par places, dans la vallée que forme la Bresle, surtout à Blangy, à Bouafles, le long de la rivière de Cailly […]."
                            },
                            {
                                "example_id": "a4a9c714-2301-4285-b48e-1eebee2f23bd",
                                "sense_id": "3d7b08a1-f199-3399-a902-b09d66eb162e",
                                "text": "La chapelle qu'avait bâtie Senard, sur le tombeau de saint Germain, devint au moyen âge un pèlerinage très-fréquenté des riverains de la Bresle."
                            },
                            {
                                "example_id": "0ea14249-2ffd-4077-bc76-d6ecf9371bdc",
                                "sense_id": "3d7b08a1-f199-3399-a902-b09d66eb162e",
                                "text": "Les ravins dont la réunion forme la vallée de la Bresle qui s’ouvre dans la Manche, au-dessous de la ville d’Eu , commencent par des plis de terrain dans les bois de Formerie et à Secqueville , dépendance contiguë de Bouvresse […]"
                            },
                            {
                                "example_id": "48dfb440-4a2a-4d93-88c8-7f55387e3170",
                                "sense_id": "3d7b08a1-f199-3399-a902-b09d66eb162e",
                                "text": "Situé au confluent de la Bresle et de la Méline, Guémicourt comme Beaucamps-le-Jeune était en Normandie et fut rattaché au district d’Amiens en 1790."
                            }
                        ]
