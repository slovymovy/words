                    {
                        "sense_id": "122f42b7-1786-3059-8ebb-f9569365e030",
                        "entry_id": "153f58ce-7994-3a46-9c20-2bb9a96fd09d",
                        "glosses": [
                            "Espèce de poisson osseux serpentiforme marin, carnassier, proche de l’anguille et de la murène, à nageoires rayonnées réduites, ayant des nageoires pectorales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192d2832-3dc0-4821-ba33-552e7e598de2",
                                "sense_id": "122f42b7-1786-3059-8ebb-f9569365e030",
                                "text": "D'autres, armées d'un bâton que termine un fort hameçon, fouillent sous les pierres, dans les creux du rocher, et en retirent soit le congre à la peau glissante, soit le poulpe aux huit bras, la sèche ou l'encornet, qui tentent vainement d'échapper en s'entourant d'un nuage coloré."
                            },
                            {
                                "example_id": "45193155-793e-4d0a-8446-46a278406514",
                                "sense_id": "122f42b7-1786-3059-8ebb-f9569365e030",
                                "text": "Si vous aimez mieux une bonne soupe au congre, je vous ferai une bonne soupe au congre…"
                            }
                        ]
                    }
                ],
