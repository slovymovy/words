    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b9203344-1e85-316b-9f21-a146147be077",
                    "sense_definition": "Harshly or bitterly critical; vitriolic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "critical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic wrote a <w>scathing</w> review of the new movie.",
                            "target_lang_translations": {
                                "ru": "Критик написал <w>разгромную</w> рецензию на новый фильм."
                            }
                        },
                        {
                            "text": "She delivered a <w>scathing</w> attack on the government's recent policy changes.",
                            "target_lang_translations": {
                                "ru": "Она выступила с <w>едкой</w> критикой недавних изменений в политике правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "vitriolic",
                        "acerbic",
                        "caustic"
                    ],
                    "antonyms": [
                        "complimentary",
                        "praising"
                    ],
                    "common_phrases": [
                        "scathing review",
                        "scathing attack",
                        "scathing criticism"
                    ],
                    "target_lang_definitions": {
                        "ru": "резко или язвительно критикующий; беспощадный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "е́дкий",
                                "target_lang_sense_clarification": "о критике, словах или замечаниях, отличающихся язвительностью"
                            },
                            {
                                "target_lang_word": "хлёсткий",
                                "target_lang_sense_clarification": "о резкой, выразительной и язвительной критике"
                            },
                            {
                                "target_lang_word": "разгро́мный",
                                "target_lang_sense_clarification": "о крайне негативной, уничтожающей критике (часто о рецензиях)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb743421-9da4-376d-82a7-54d2609cf65a",
                    "sense_definition": "Harmful or painful; acerbic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "critical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scathing</w> wind cut through his thin jacket during the winter storm.",
                            "target_lang_translations": {
                                "ru": "<w>Пронизывающий</w> ветер пробирал до костей сквозь его тонкую куртку во время зимней бури."
                            }
                        },
                        {
                            "text": "He felt the <w>scathing</w> effects of the harsh chemicals on his skin.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>жгучее</w> воздействие агрессивных химикатов на свою кожу."
                            }
                        }
                    ],
                    "synonyms": [
                        "acerbic",
                        "biting"
                    ],
                    "target_lang_definitions": {
                        "ru": "причиняющий вред или боль; жгучий, пронизывающий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прони́зывающий",
                                "target_lang_sense_clarification": "о холодном ветре, который ощущается как болезненный"
                            },
                            {
                                "target_lang_word": "жгу́чий",
                                "target_lang_sense_clarification": "о воздействии химических веществ или холода на кожу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
