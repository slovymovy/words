                        "entry_id": "9fc69dda-5178-3b64-93d0-e60e393f93f4",
                        "glosses": [
                            "The basic dot (‧) used to end a sentence in medieval punctuation (ancestral to the full stop/period)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f775b0c-a20e-41a4-9b7e-3ad8cb8b204d",
                                "sense_id": "8ed123a0-54b2-3e84-8392-c7fb5912bf27",
                                "text": "In the sacerdotal prayers in col. a the punctuation is by punctus flexus, punctus elevatus and punctus."
                            },
                            {
                                "example_id": "ee4d5588-4766-4263-a1c3-cc326ecc69b3",
                                "sense_id": "8ed123a0-54b2-3e84-8392-c7fb5912bf27",
                                "text": "The most common item of punctuation was the punctus or point."
                            },
                            {
                                "example_id": "52b495b9-39f7-4158-8dd5-0aa3e67d7f19",
                                "sense_id": "8ed123a0-54b2-3e84-8392-c7fb5912bf27",
                                "text": "Curiously, the punctus versus was largely replaced with a punctus by ca.1100."
                            }
                        ]
                    }
