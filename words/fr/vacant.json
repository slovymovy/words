{
    "word_family": [
        "vacance",
        "vacancier",
        "vacataire",
        "vacation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99fb2de0-a57d-3078-ad84-d8a7d00f5b94",
                    "sense_definition": "Qui n'est pas occupé, qui est libre ou vide, en parlant d'un lieu, d'un logement ou d'un siège.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "non_occupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'appartement est resté <w>vacant</w> pendant plusieurs mois avant d'être finalement loué."
                        },
                        {
                            "text": "Le siège <w>vacant</w> à côté de moi a été pris par un voyageur pressé."
                        }
                    ],
                    "synonyms": [
                        "inoccupé",
                        "libre",
                        "vide"
                    ],
                    "antonyms": [
                        "occupé",
                        "pris"
                    ],
                    "common_phrases": [
                        "logement vacant",
                        "chambre vacante"
                    ]
                },
                {
                    "sense_id": "d28bda43-b732-3e7f-b341-00a8cfa3b432",
                    "sense_definition": "Qui n'a pas de titulaire, qui est à pourvoir, en parlant d'un emploi, d'un poste ou d'une fonction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non_occupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise recherche un candidat qualifié pour combler ce poste <w>vacant</w>."
                        },
                        {
                            "text": "Après le départ inattendu du directeur, la place est restée <w>vacante</w>."
                        }
                    ],
                    "synonyms": [
                        "disponible",
                        "libre"
                    ],
                    "antonyms": [
                        "pourvu"
                    ],
                    "common_phrases": [
                        "poste vacant",
                        "siège vacant"
                    ]
                },
                {
                    "sense_id": "90b25ce0-f095-37bc-aa42-6c54c09cf73a",
                    "sense_definition": "Qualifie une succession ouverte que personne ne réclame ou à laquelle les héritiers ont renoncé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a désigné un administrateur pour gérer cette succession <w>vacante</w>."
                        },
                        {
                            "text": "En l'absence d'héritiers connus, l'héritage a été déclaré succession <w>vacante</w>."
                        }
                    ],
                    "synonyms": [
                        "en déshérence"
                    ],
                    "common_phrases": [
                        "succession vacante"
                    ]
                },
                {
                    "sense_id": "c8545afe-0ff3-309c-8389-20ad5162287e",
                    "sense_definition": "Qualifie des biens qui n'ont point de propriétaire certain ou identifié.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'État s'approprie les biens <w>vacants</w> et sans maître après un délai légal."
                        },
                        {
                            "text": "Un curateur a été nommé afin d'administrer ces biens <w>vacants</w>."
                        }
                    ],
                    "synonyms": [
                        "sans maître"
                    ],
                    "common_phrases": [
                        "biens vacants"
                    ]
                }
            ]
        }
    ]
}