                    {
                        "translation_id": "0a6449ce-c3b0-4f60-91bb-372c74162226",
                        "source_entry_id": "83d903d4-4934-381c-9080-2ffe96e0b689",
                        "source_sense_description": "advocacy of a revision of some view",
                        "target_lang_word": "revisionisme",
