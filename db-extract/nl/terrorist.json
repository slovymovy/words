                    {
                        "translation_id": "b9bfc063-7630-40cb-b766-704aa04662f8",
                        "source_entry_id": "39f51f12-054b-3844-9bc4-039e228810dc",
                        "source_sense_id": "18983525-8aa3-3968-b543-400651df155c",
                        "source_sense_description": "iemand die terroristische aanslagen beraamt, pleegt of wil plegen met een godsdienstig of politiek doel",
                        "target_lang_word": "Terrorist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrorist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7ae6f10-751e-37ac-b960-6186d75fb797",
                                        "entry_id": "3549392e-6ad7-3f9e-8600-1390bbf0d516",
                                        "glosses": [
                                            "eine Person, die entschieden und überzeugt für den Terrorismus eintritt, um mit dessen Hilfe politische Ziele versucht durchzusetzen; eine Person, die einen Terroranschlag plant und/oder durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b39065d8-0085-4f1e-b794-8e840589f4f7",
                                                "sense_id": "d7ae6f10-751e-37ac-b960-6186d75fb797",
                                                "text": "Terroristen entführten mehrere Politiker und drohten sie zu töten, wenn ihre Forderungen nicht erfüllt würden."
                                            },
                                            {
                                                "example_id": "e300287c-80d1-4d38-be3f-4a15e64b5511",
                                                "sense_id": "d7ae6f10-751e-37ac-b960-6186d75fb797",
                                                "text": "„‚Wir sehen diese Leute etwa so, wie ihr die Oppositionellen in den Ostblock-Staaten‘, erklärte ein algerischer Diplomat einem deutschen Kritiker, ‚des einen Terrorist ist meist des anderen Freiheitskämpfer.‘“"
                                            },
                                            {
                                                "example_id": "4918a282-cedf-4db4-8b1b-741e2b07ec07",
                                                "sense_id": "d7ae6f10-751e-37ac-b960-6186d75fb797",
                                                "text": "„Auch Terroristen hatten im ansonsten so friedlichen Land am Nil Fuß gefasst, und mehrere blutige Anschläge erschütterten die Ägypter und schadeten der Tourismusindustrie, dem Haupterwerbszweig des Landes.“"
                                            },
                                            {
                                                "example_id": "d809f7b7-73f0-4bec-98b8-413e159072a8",
                                                "sense_id": "d7ae6f10-751e-37ac-b960-6186d75fb797",
                                                "text": "„Nach Feierabend wurden aus besorgten Bürgern Terroristen.“"
                                            },
                                            {
                                                "example_id": "87bf802d-3d59-4be9-a4c5-e71fb2b37663",
                                                "sense_id": "d7ae6f10-751e-37ac-b960-6186d75fb797",
                                                "text": "„Keine der Forderungen der Terroristen wurde erfüllt, doch die niederländischen Behörden begriffen, dass der einzige Ausweg die erfolgreiche Integration der Molukker war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b59b56a2-2fb6-486e-969d-962f7d4af936",
                        "source_entry_id": "39f51f12-054b-3844-9bc4-039e228810dc",
                        "source_sense_id": "18983525-8aa3-3968-b543-400651df155c",
                        "source_sense_description": "iemand die terroristische aanslagen beraamt, pleegt of wil plegen met een godsdienstig of politiek doel",
                        "target_lang_word": "terrorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae192882-a76e-3791-8d8f-2b00fc5f934b",
                                        "entry_id": "1e409b19-3f2a-3d38-bcb1-2c7aa7969be7",
                                        "glosses": [
                                            "A person, group, or organization that uses violent action, or the threat of violent action, to further political goals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad9895b1-5de2-419a-9ac9-d05aa6f3cfa5",
                                                "sense_id": "ae192882-a76e-3791-8d8f-2b00fc5f934b",
                                                "text": "Hooooly shit! That is terrible, because (1), he is not a terrorist, and (2), I do hope we have a better strategy for dealing with terrorists than flagging their credit reports and denying them their dream apartments! Hey, not in America! Not in America!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e185dc7-7be6-36d3-853e-5776e2e3b513",
                                        "entry_id": "1e409b19-3f2a-3d38-bcb1-2c7aa7969be7",
                                        "glosses": [
                                            "An agent or partisan of the revolutionary tribunal during the Reign of Terror in France."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terrorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7bd5ee3-b8a9-31ec-b85e-7710b65a348b",
                                        "entry_id": "6839d4b8-843d-33ed-b244-4e6504059391",
                                        "glosses": [
                                            "Of or relating to terrorism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3af60617-ebea-4390-958a-eb47ffb3d1ff",
                                                "sense_id": "b7bd5ee3-b8a9-31ec-b85e-7710b65a348b",
                                                "text": "2002 January 29, George Walker Bush, \"2002 State of the Union Address\".\nStates like these, and their terrorist allies, constitute an axis of evil, arming to threaten the peace of the world."
                                            },
                                            {
                                                "example_id": "f54fb9c0-8037-48a1-a18b-935c06e33ced",
                                                "sense_id": "b7bd5ee3-b8a9-31ec-b85e-7710b65a348b",
                                                "text": "This controversy is quite similar to the red-tagging brouhaha exploded against me by Gabriela and its ilk in the CPP-NPA-NDF legal front. In a Facebook post, I had warned Liza Soberano of the deceptive tactics of the group in recruiting showbiz icons into the communist terrorist insurgency. I was very specific in that post, saying the advice is being issued by a father, a brother or an uncle not wanting to have his daughter, sister or niece led down the road to perdition. The seeming mouthpieces of the CPP hiding in Rappler, Inquirer and Philippine Star suddenly had a heyday slamming me for allegedly red tagging the actress as well as Miss Universe Catriona Gray."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52270a77-502d-41ae-82fc-5dece8eeb0db",
                        "source_entry_id": "39f51f12-054b-3844-9bc4-039e228810dc",
                        "source_sense_id": "18983525-8aa3-3968-b543-400651df155c",
                        "source_sense_description": "iemand die terroristische aanslagen beraamt, pleegt of wil plegen met een godsdienstig of politiek doel",
                        "target_lang_word": "terroriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terroriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1005c14c-f136-34c9-8afb-cda8c4606f91",
                                        "entry_id": "e3551a21-2de3-3f55-a388-f9265e43d0ef",
                                        "glosses": [
                                            "Relatif à la Terreur et à ses partisans et activistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809cb44f-b10a-420a-b4c7-64198621a719",
                                                "sense_id": "1005c14c-f136-34c9-8afb-cda8c4606f91",
                                                "text": "Les blanquistes, qui se regardent comme les légitimes propriétaires de la tradition terroriste, estiment qu'ils sont, par cela même, appelés à diriger le mouvement prolétarien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f0ff592-215b-3b5a-ad85-9fa68d0e7151",
                                        "entry_id": "e3551a21-2de3-3f55-a388-f9265e43d0ef",
                                        "glosses": [
                                            "Relatif à un régime de terreur."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terroriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76caf967-4480-3fd7-9402-cda9c9d14a19",
                                        "entry_id": "09e235dd-06c8-3cef-b8f6-53b64ce83a0f",
                                        "glosses": [
                                            "Partisan ou agent d’un régime de terreur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24375420-c579-4fa9-9321-bf46114b6582",
                                                "sense_id": "76caf967-4480-3fd7-9402-cda9c9d14a19",
                                                "text": "Nos terroristes du quinzième et du seizième siècle ont été des moines. Les prisons monastiques furent toujours les plus cruelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06f580d-d402-3630-9a7e-d1c3714c084f",
                                        "entry_id": "09e235dd-06c8-3cef-b8f6-53b64ce83a0f",
                                        "glosses": [
                                            "Activiste révolutionnaire durant la Terreur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6dfacff-feb7-490e-a6ef-30bda74cf71b",
                                                "sense_id": "c06f580d-d402-3630-9a7e-d1c3714c084f",
                                                "text": "Ce faux terroriste disparut au Neuf Thermidor et fut alors inscrit sur la liste des émigrés."
                                            },
                                            {
                                                "example_id": "a94004a2-52d9-4c40-8e01-e2fa7bbbf193",
                                                "sense_id": "c06f580d-d402-3630-9a7e-d1c3714c084f",
                                                "text": "Lorsque Maximilien demandait un comité de justice, le principe de la terreur était triomphant, et le parti de l'indulgence en très-faible minorité : […]. Au contraire Tallien se prononçait pour la justice, à une époque où les terroristes avaient perdu leur ancien pouvoir, et où presque tous les esprits étaient portés à l'indulgence."
                                            },
                                            {
                                                "example_id": "f508936a-f282-499d-944e-003687e075aa",
                                                "sense_id": "c06f580d-d402-3630-9a7e-d1c3714c084f",
                                                "text": "Les Thermidoriens, qui avaient été en partie cause de la chute de Robespierre, étaient pour la plupart des terroristes convaincus ; ils furent battus le 9 thermidor et ne survécurent pas à cette défaite. la Terreur ne pouvait durer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24f08112-7a8f-3417-9503-ac9944a3880c",
                                        "entry_id": "09e235dd-06c8-3cef-b8f6-53b64ce83a0f",
                                        "glosses": [
                                            "Personne employant le terrorisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15969f3c-b6c8-445a-8fa7-6b44eb790d0a",
                                                "sense_id": "24f08112-7a8f-3417-9503-ac9944a3880c",
                                                "text": "J'ai besoin d'écrire ceci à ma propre intention : je ne suis pas un terroriste. Un terroriste agit au nom d'une revendication. Je n'en ai aucune. Je ne suis pas mécontent de me distinguer radicalement de cette pègre qui cherche un prétexte à sa haine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
