                                        "sense_id": "b28f4a27-5b3d-3d85-a110-752741cce05f",
                                        "entry_id": "8256a790-34a7-34f0-b605-9a9c855e941f",
                                        "glosses": [
                                            "Hypocrite."
                                        ],
