                        "licht"
                    ],
                    "antonyms": [
                        "gewichtig"
                    ],
                    "common_phrases": [
                        "luchtige toon",
                        "luchtig gesprek",
                        "luchtig onderwerp"
                    ],
                    "target_lang_definitions": {
                        "en": "Not serious or gloomy; cheerful and carefree in nature or tone."
                    },
                    "translations": {
