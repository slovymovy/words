                                        "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                                        "glosses": [
                                            "Remorque agencée pour accueillir une personne et s'accrochant latéralement sur une motocyclette ou un vélo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "071a1edf-756f-4589-8c14-1104fcd2ef44",
                                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                                "text": "Ça alors! Une Glory de 1948!! Avec un side-car!"
                                            },
                                            {
                                                "example_id": "36fa65f0-f0f7-40d1-b8aa-0645e7aa0bac",
                                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                                "text": "Après 15 000 euros de travaux, le musée a rouvert le 1ᵉʳ juillet, doté d’une nouvelle scénographie, lors d’une inauguration en grande pompe, avec déploiement d’une moto allemande avec side-car et d’une jeep dehors."
                                            },
                                            {
                                                "example_id": "fb446e7e-8f85-47c7-98ed-1273a886ac15",
                                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                                "text": "La Clodoaldienne Élisabeth Gelin - comédienne et auteure de pièces de théâtre - a publié son premier roman l’an dernier, La passagère du side-car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                                        "glosses": [
                                            "Attelage comprenant la motocyclette et le side-car."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af393e57-3ccc-44e8-88a6-8182bab3410a",
                                                "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                                "text": "Les mains dans les poches, la pipe à la bouche, je n'avais pas fini de contempler le défilé qu'une moto side-car s'arrêta devant moi."
                                            },
                                            {
                                                "example_id": "721bc1ee-271b-4a17-954d-2302cba5dc4b",
                                                "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                                "text": "Un side-car est donc un véhicule à trois roues."
                                            }
                                        ]
                                    },
