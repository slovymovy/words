                "senses": [
                    {
                        "sense_id": "25eb8c89-0a4a-3324-916f-7f146e794d2a",
                        "entry_id": "a5af3a4f-83b8-351e-856d-9fcff7b2b64c",
                        "glosses": [
                            "Auftrag, der durch zwei oder auch mehr Beteiligte zusammen (eine Gemeinschaft) gelöst werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92bec9e8-9536-40bd-91ea-75d0fe9c9a90",
                                "sense_id": "25eb8c89-0a4a-3324-916f-7f146e794d2a",
                                "text": "Nach der Pause könnt ihr dann mit eurer Gemeinschaftsaufgabe beginnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f01af0e-e2dd-3484-abce-d8b7ff6f97b2",
                        "entry_id": "a5af3a4f-83b8-351e-856d-9fcff7b2b64c",
                        "glosses": [
                            "Vorhaben, das für eine kleinere politische Einheit (ein Bundesland) zu umfangreich ist, weshalb der Bund sich beteiligt (wenn dieses Vorhaben zusätzlich gewisse Kriterien erfüllt)"
                        ],
                        "tags": [
                            "Staatswissenschaften",
                            "Grundgesetz"
                        ],
                        "examples": [
                            {
                                "example_id": "96e37cc2-bba2-4656-9355-6b0efb4ec56f",
                                "sense_id": "4f01af0e-e2dd-3484-abce-d8b7ff6f97b2",
                                "text": "Im Grundgesetz wird zu den Gemeinschaftsaufgaben Stellung genommen."
                            },
                            {
                                "example_id": "4717a0d1-d4e9-40fe-8358-e40092d536e1",
                                "sense_id": "4f01af0e-e2dd-3484-abce-d8b7ff6f97b2",
                                "text": "Eine Gemeinschaftsaufgabe ist durch die Mischfinanzierung von Land und Bund gekennzeichnet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
