                    }
                ],
                "translations": [
                    {
                        "translation_id": "29c082c7-b99c-4eda-b726-111fd8e6935b",
                        "source_entry_id": "7283500e-b9f5-3769-a862-693ebb6033b9",
                        "target_lang_word": "Diskriminierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diskriminierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05f31380-9373-3132-97bf-59425653d81f",
                                        "entry_id": "4d75418f-93ed-3dbf-8a34-65d519960c0b",
                                        "glosses": [
                                            "die Trennung oder unterschiedliche Behandlung von Objekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79cc854b-daf3-468b-9d8b-8605bd24a949",
                                                "sense_id": "05f31380-9373-3132-97bf-59425653d81f",
                                                "text": "Bei den Begriffen Atheist und Agnostiker ist eine saubere Diskriminierung unerlässlich."
                                            },
                                            {
                                                "example_id": "1fdec2e6-69c7-4354-bfc8-0c06108e8054",
                                                "sense_id": "05f31380-9373-3132-97bf-59425653d81f",
                                                "text": "Die Diskriminierung von reifen und unreifen Äpfeln kann man anhand ihrer Farbe vornehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f5f4b71-1aee-381a-9141-836d0ec7fed3",
                                        "entry_id": "4d75418f-93ed-3dbf-8a34-65d519960c0b",
                                        "glosses": [
                                            "die Ungleichbehandlung von Individuen oder Gruppen; im strengen Wortsinn („Unterscheidung“) umfasst das Wort negative Diskriminierung (relative Benachteiligung) und positive Diskriminierung (relative Bevorzugung))"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fcc1b5-b093-40a5-8c37-4483029c670f",
                                                "sense_id": "0f5f4b71-1aee-381a-9141-836d0ec7fed3",
                                                "text": "In Deutschland wird darüber gestritten, ob die Förderung von Eliten eine zulässige positive Diskriminierung darstellt."
                                            },
                                            {
                                                "example_id": "3d369123-31cb-472b-ac45-2746ca8c7a6a",
                                                "sense_id": "0f5f4b71-1aee-381a-9141-836d0ec7fed3",
                                                "text": "Rassismus stellt heutzutage eindeutig eine negative Diskriminierung dar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                                        "entry_id": "4d75418f-93ed-3dbf-8a34-65d519960c0b",
                                        "glosses": [
                                            "überwiegend eine Herabsetzung gegenüber anderen (der Mehrzahl), eine Herabwürdigung in der Geltung, im Wert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fd2f8a-133b-4718-bef5-2c877e73013d",
                                                "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                                                "text": "So genannte Krüppel leiden seelisch stark an ihrer Diskriminierung durch diese Bezeichnung."
                                            },
                                            {
                                                "example_id": "062bd287-7687-4dec-93e0-22472286beed",
                                                "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                                                "text": "„Die ganze Band stellt sich geschlossen hinter Billie, damit sie nicht unter Diskriminierungen zu leiden hat, und Artie Shaw wird des Öfteren deutlich, wenn er auf hartnäckige Anhänger der Rassentrennung trifft.“"
                                            },
                                            {
                                                "example_id": "a5813938-bb26-47c8-ba10-ee7462591794",
                                                "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                                                "text": "„Außerdem schreckt die Jugendlichen eine mögliche Diskriminierung in Deutschland ab.“"
                                            },
                                            {
                                                "example_id": "c03c8e22-3b1f-4a9e-a3a2-956d5dab8073",
                                                "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                                                "text": "„Meine Integration in den Arbeitsmarkt fand übrigens ohne jedwede Diskriminierung durch meine Herkunft statt.“"
                                            },
                                            {
                                                "example_id": "7a2228c5-2ef9-4ced-ae22-d0879583c572",
                                                "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                                                "text": "„Miles war zwar als ein wohlbehütetes Kind einer Mittelstandsfamilie aufgewachsen, sein Vater war Zahnarzt, aber die Diskriminierungen aufgrund der Hautfarbe waren unausweichlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c39c4a4d-b9e4-3c45-81ab-d12c2763a180",
                                        "entry_id": "4d75418f-93ed-3dbf-8a34-65d519960c0b",
                                        "glosses": [
                                            "eine unterschiedliche wirtschaftliche Behandlung von Staaten (zum Beispiel mittels Einfuhrzöllen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4624b3de-3c1b-42b4-be14-b42daf542921",
                                                "sense_id": "c39c4a4d-b9e4-3c45-81ab-d12c2763a180",
                                                "text": "Es stellt eine Diskriminierung für Deutschland dar, wenn Bier nach dem Deutschen Reinheitsgebot im Ausland besteuert wird, ausländisches aber nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "24fc9c9f-3836-3feb-8e44-4d9bd98e817f",
                                        "entry_id": "4d75418f-93ed-3dbf-8a34-65d519960c0b",
                                        "glosses": [
                                            "die Fähigkeit, Unterschiede zwischen verschiedenen Stimuli wahrzunehmen sowie auf sie zu antworten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876ef8ba-ccd7-45cf-ac13-50705ac62e38",
                                                "sense_id": "24fc9c9f-3836-3feb-8e44-4d9bd98e817f",
                                                "text": "Er beherrscht die Diskriminierung von berechtigtem Zorn und reiner Gereiztheit seiner Frau gegenüber."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c05684a6-548d-31cb-8b4b-5c16144e5549",
                                        "entry_id": "4d75418f-93ed-3dbf-8a34-65d519960c0b",
                                        "glosses": [
                                            "die Unterscheidung von Messergebnissen oder von Untersuchungsgegenständen"
                                        ],
                                        "tags": [
                                            "Naturwissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783d5b62-481b-4cd3-a8df-f1112796e3fd",
                                                "sense_id": "c05684a6-548d-31cb-8b4b-5c16144e5549",
                                                "text": "Diskriminierung (Auflösung, engl. Discrimination/Repeatability) bedeutet, dass das Messsystem fähig ist, vorhandene Ausprägungsunterschiede zwischen unterschiedlichen Teilen aufzudecken."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e15d24e5-bb57-4029-a4e1-9c26017e3580",
                        "source_entry_id": "7283500e-b9f5-3769-a862-693ebb6033b9",
                        "target_lang_word": "discrimination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discrimination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7557efc-66e9-31ec-843d-969bb3def72b",
                                        "entry_id": "bfefcdbb-71a0-3859-93de-f3485d088172",
                                        "glosses": [
                                            "Discernment, the act of discriminating, discerning, distinguishing, noting or perceiving differences between things, with the intent to understand rightly and make correct decisions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820644cd-5ed8-4518-8901-bad05a63cb79",
                                                "sense_id": "e7557efc-66e9-31ec-843d-969bb3def72b",
                                                "text": "Have you felt the weight of the considerations which have been presented, in order to show the importance of discrimination on the subject of revealed truth?"
                                            },
                                            {
                                                "example_id": "d5c7e0be-e102-4206-b40f-36743f90ba2a",
                                                "sense_id": "e7557efc-66e9-31ec-843d-969bb3def72b",
                                                "text": "An earthquake here rolls harmless through the land, And Thou art good because the chimneys stand— There templed cities sink into the sea, And damp survivors, howling as they flee, Skip to the hills and hold a celebration In honor of Thy wise discrimination."
                                            },
                                            {
                                                "example_id": "55cfe0e4-1b6f-4cb3-99ae-1f7f6603c0e6",
                                                "sense_id": "e7557efc-66e9-31ec-843d-969bb3def72b",
                                                "text": "In place of a discrimination box a jumping apparatus was used, and apparently this required performance less foreign to the natural response repertory of the bird."
                                            },
                                            {
                                                "example_id": "42f4cba4-c975-4221-9e8b-821dc5de2155",
                                                "sense_id": "e7557efc-66e9-31ec-843d-969bb3def72b",
                                                "text": "The 'pretraining' for the two-choice discrimination involved a discrimination between angles differing by 19° (6° versus 25°) in which the smaller angle was marked with a 2 cm Plexiglas square that the bats had previously detected in a simple one-choice discrimination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                        "entry_id": "bfefcdbb-71a0-3859-93de-f3485d088172",
                                        "glosses": [
                                            "Differential treatment of an individual or group to their disadvantage; treatment or consideration based on class or category rather than individual merit; partiality; prejudice; bigotry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb424af-33da-416d-8f83-1f21195e08fd",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "sexual or racial discrimination"
                                            },
                                            {
                                                "example_id": "8efdcfcf-1373-401f-8b12-673ab8b7b31a",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "reverse discrimination"
                                            },
                                            {
                                                "example_id": "d2faf7f2-0623-4a6c-9a21-47c0ae77150c",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "The same arguments, however, which have effectually in this State [Rhode Island] maintained the disfranchisement of naturalized citizens, may prevail in those cases in which the State Constitution makes the discrimination against colored persons, as long as those State Constitutions remain in force."
                                            },
                                            {
                                                "example_id": "efd415c0-d590-4713-b3e8-057917f7077f",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "The state, in the exercise of its general power to prescribe rules of evidence, may provide that proof of a particular fact, or of several facts taken collectively, shall be prima facie evidence of another fact when there is some rational connection between the fact proved and the ultimate fact presumed. The legislative presumption is invalid when it is entirely arbitrary, or creates an invidious discrimination, or operates to deprive a party of a reasonable opportunity to present the pertinent facts in his defense."
                                            },
                                            {
                                                "example_id": "de7ba3ec-84ed-40d5-bc96-b666089b2d0c",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "However, is it not true that within the preferred or official territory there are certain discriminations? For instance, are there not certain States in New England that suffer from certain discriminations, in comparison with other States in that official territory?"
                                            },
                                            {
                                                "example_id": "5389f3ea-ac27-4ceb-a098-9059175216a2",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "Many sincere white people in the South privately oppose segregation and discrimination, but they are apprehensive lest they be publicly condemned."
                                            },
                                            {
                                                "example_id": "28b26bc7-fe28-48cf-aec9-b7afe3c2b74a",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "Due to severe and pervasive discrimination, people dared not be open about their homosexuality, and because no one would be open, social prejudice and discrimination became even stronger."
                                            },
                                            {
                                                "example_id": "935bf30a-fc9b-4e53-ae65-3465d67ddb29",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "The four Gospels were written by men, but they never report any instance of Jesus’ condoning sexual discrimination or the implied subservience or inferiority of women."
                                            },
                                            {
                                                "example_id": "66c23cca-e7a5-4183-b4f8-7aeef8812ece",
                                                "sense_id": "3ed46cb3-6b32-3852-92be-ae3bab0544cd",
                                                "text": "The book also presents empirical results from studies of discrimination across the world to show the magnitude of the problem and the difficulties of comparison across national borders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                        "entry_id": "bfefcdbb-71a0-3859-93de-f3485d088172",
                                        "glosses": [
                                            "The quality of being discriminating; acute discernment, especially in matters of good taste."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d68939-b695-4623-9191-9a37f2b9fd54",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "Near-synonym: tastefulness"
                                            },
                                            {
                                                "example_id": "bd8f8356-5ed4-4e0f-a01d-47b67facf105",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "You are a man of discrimination,” said Qunk, “I admire that girl a little myself, and, entre nous, I think that I'm a bit of a favourite in that quarter.”"
                                            },
                                            {
                                                "example_id": "c4c6e5f2-d6a0-4816-a6ea-27eac799421d",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "Take heed, then, lest, while you plume yourselves on your superior wisdom and discrimination, the Great Captain does not arraign you before his court-martial on the charge of blood-guiltiness."
                                            },
                                            {
                                                "example_id": "5d681fa7-46c7-4bd2-86a1-a7830182fbfe",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "These differences amount to a discrimination by the animal in favour of calcium and against strontium and barium."
                                            },
                                            {
                                                "example_id": "f2eed67e-8a95-42cb-8652-479d9f5af59f",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "In the vocabulary of Madison Avenue, the man of discrimination is one who knows a fine set of luggage when he sees it."
                                            },
                                            {
                                                "example_id": "0bb5c1d5-152e-440c-8aca-3a58d8e5d5a5",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "Furthermore, holding the view that the jhānas are in conflict with discrimination and wisdom, one might argue that this quality cannot be developed and sustained when one attains the jhānas."
                                            },
                                            {
                                                "example_id": "0db08092-9d76-4d1d-94b6-37bb4ba82b18",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "If taste is, in Sibleyan terms, an ability involving perceptiveness, sensitivity, discrimination and appreciation, this suggests that it should be directed towards a certain set of objects, and that there is clear room for error and critical debate: about which objects—and which responses—are in fact correct, and which provide evidence of the presence of tasteful discrimination."
                                            },
                                            {
                                                "example_id": "38f18222-842f-4a64-99b2-494f3fee561b",
                                                "sense_id": "25abb1a0-6f9f-3185-8152-3a93d4837266",
                                                "text": "Among those who are purified by their good deeds, there are four kinds of men who worship me: the world-weary, the seeker for knowledge, the seeker for happiness and the man of spiritual discrimination. The man of discrimination is the highest of these."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f93c67-3b33-382a-ae76-7a139c98efc9",
                                        "entry_id": "bfefcdbb-71a0-3859-93de-f3485d088172",
                                        "glosses": [
                                            "That which discriminates; a distinguishing mark, a characteristic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88299133-cf4b-46c5-b714-7ca8deb12bab",
                                                "sense_id": "c0f93c67-3b33-382a-ae76-7a139c98efc9",
                                                "text": "He who has not made the experiment, or who is not accustomed to require rigorous accuracy from himself, will scarcely believe how much a few hours take from certainty of knowledge, and distinctness of imagery; how the succession of objects will be broken, how separate parts will be confused, and how many particular features and discriminations will be compressed and conglobated into one gross and general idea."
                                            },
                                            {
                                                "example_id": "0422f7c3-9d4f-4a39-976a-d0bf0d667ff1",
                                                "sense_id": "c0f93c67-3b33-382a-ae76-7a139c98efc9",
                                                "text": "But even if this difference should be still greater, it could never be admitted as forming a specific distinction. For the horns not only differ in individuals of the same species, but in the same individuals at different ages. If we were to attempt to arrange animals solely by their horns, the discriminations would be as endless as uncertain."
                                            },
                                            {
                                                "example_id": "351dacec-2ee7-4fe4-9391-d3914f2b5177",
                                                "sense_id": "c0f93c67-3b33-382a-ae76-7a139c98efc9",
                                                "text": "These seem to me their most obvious and striking causes, and certainly sufficient to distinguish them from each other: but let the most acute metaphysician, place in one point of view whatever may, in any way, mark the nice boundaries which separate them from each other, and then let his discriminations be compared, for clear, and strongly marked difference and opposition, with those I have stated to exist between the beautiful, and the picturesque; and if his discriminations are not more clear, and more strongly marked, but on the contrary much less so, why should they have a power, which is denied to mine?"
                                            },
                                            {
                                                "example_id": "7c0e1d21-81ca-44ad-b5cd-95573f63a01e",
                                                "sense_id": "c0f93c67-3b33-382a-ae76-7a139c98efc9",
                                                "text": "The great discriminations of land are three, and it concerns us to know whether it is poor, or rich, or in a middle state."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef0048dc-cac1-40e7-830e-438effacfccd",
                        "source_entry_id": "7283500e-b9f5-3769-a862-693ebb6033b9",
                        "target_lang_word": "discrimination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discrimination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Distinction précise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e361716-767e-420f-8f60-9043f4a5edb3",
                                                "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                                "text": "La substitution du Saarmark au Reichsmark était une opération délicate, car il fallait opérer une discrimination entre les capitaux sarrois et les capitaux allemands réfugiés en Sarre en 1945-1946 ; […]."
                                            },
                                            {
                                                "example_id": "1f214d9c-e7e5-4d5d-adec-84f998feefbe",
                                                "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                                "text": "Faire la discrimination de telles ou telles choses mêlées."
                                            },
                                            {
                                                "example_id": "111b3c7f-1492-4eb3-9e2b-3d40b60beec6",
                                                "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                                "text": "Il y a là une discrimination difficile à opérer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c911bc-92b3-30c1-986d-680ba4ec100d",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué.",
                                            "Traitement défavorable de certains groupes humains via la réduction arbitraire de leurs droits et contraire au principe de l'égalité en droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68651c6d-e7d1-4c56-a60a-72f8be39f3de",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "14 mai. - On apprend que le haut clergé bouddhique a commencé une grève de la faim pour protester contre la discrimination dont il s'estime victime."
                                            },
                                            {
                                                "example_id": "d73e6d88-78c9-4630-954c-b7e2c91ef99c",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "L'attention est ainsi également attirée sur les positions sociales qui précisément ne subissent pas de marginalisation ni de discrimination ; un travail qui a été systématiquement entamé ces dernières années par les études critiques de la masculinité, celles de la blanchitude (whiteness) et la critique de l’hétéronormativité."
                                            },
                                            {
                                                "example_id": "423d462c-5cba-481e-9b69-b76a7bb9b634",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "Un arrêt de la Cour d’appel de Paris du 5 mai 2010 offre un exemple particulièrement éclairant à ce sujet en matière de discrimination homme/femme."
                                            },
                                            {
                                                "example_id": "60410e46-6f17-4bfd-b89c-72ffbd39ea79",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "C'est ainsi que Cooper aborde l'environnement grossophobe ambiant (notamment concernant l’infrastructure des transports publics), mais aussi la discrimination dans le milieu du travail (une personne grosse aurait ainsi moins de chance de se faire engager ou de recevoir une promotion)."
                                            },
                                            {
                                                "example_id": "101d7757-c33c-45df-bff5-e3d008d2bf0d",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "A cette époque, aux États Unis, les Blancs qui militent aux côtés des Noirs contre les discriminations raciales, sont progressivement exclus de toute alliance de long terme avec les Noirs. La lutte contre le racisme devient un monopole Noir."
                                            },
                                            {
                                                "example_id": "0c4dc8e9-52c2-486a-8b4b-c3646f62fd30",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "Le racisme apparaît ainsi comme un système généralisé de discriminations qui s’alimentent ou s’informent les unes les autres : il existe un cercle vicieux, déjà repéré dans les années quarante par l’économiste Günnar Myrdal dans son ouvrage classique An American Dilemma [1944], qui assure la reproduction quasi automatique de la discrimination des Noirs dans le logement, dans l’école ou sur le marché du travail."
                                            },
                                            {
                                                "example_id": "a2018ab4-32b4-46bc-99c8-e44b4b04da4a",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "Même après les débuts de la diffusion du tennis, les Anglais comme les Français maintinrent la discrimination à l’égard des classes populaires en n’acceptant dans leurs clubs que les gens issus de la meilleure société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6913a674-2f66-3363-8899-b495f32ca5d5",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué.",
                                            "Modulation d'une offre de travail, de biens ou de services en fonction des caractéristiques connues ou supposées du marché."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26aabb82-09d8-3f7e-a6aa-271494fe4a49",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué.",
                                            "Principe selon lequel un moyen ou un mode de guerre doit discriminer entre civil et combattant afin d'éviter, dans la mesure du possible, des pertes collatérales civiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
