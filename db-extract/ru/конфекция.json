                        "glosses": [
                            "спец. готовое платье и бельё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd24c4b-7b40-4f2f-b9c1-4d1d4c29ea6d",
                                "sense_id": "a190ed3a-9a38-331d-af4c-a1bc3b99022d",
                                "text": "Брала она обычно алкогольными напитками, парфюмерией, предметами одежды и ювелирными украшениями, но не брезговала также обувью, конфекцией и бижутерией."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ef556c2-8108-3919-b000-68064ae271d0",
                        "entry_id": "a15d578d-8b39-3980-94cf-9d48a072a92b",
                        "glosses": [
                            "магазин или отдел магазина, торгующий одеждой и бельём"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ddfb54-75cf-4b62-81a0-69d1fe4176bd",
                                "sense_id": "3ef556c2-8108-3919-b000-68064ae271d0",
                                "text": "К тому времени в Париже около пяти лет работала конфекция Ла Бель Жардиньер."
                            }
                        ]
                    }
                ],
