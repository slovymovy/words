                                "target_senses": [
                                    {
                                        "sense_id": "3ff6325e-b68c-32f7-b0ed-dfedbfea7110",
                                        "entry_id": "3f192adf-d35c-321b-9106-e472035aae60",
                                        "glosses": [
                                            "Salirse, quitarse o apartarse del camino, del carril."
                                        ],
                                        "tags": [
                                            "se emplea también como transitivo: descarriar"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f4b00d8-88d1-3a24-afe0-d7054662ae90",
                                        "entry_id": "3f192adf-d35c-321b-9106-e472035aae60",
                                        "glosses": [
                                            "Separarse o perderse del grupo que lo acompañaba a uno, perder su ayuda, apoyo o protección."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1dce519-2c3a-4da9-a053-f630a12dc7b7",
                                                "sense_id": "6f4b00d8-88d1-3a24-afe0-d7054662ae90",
                                                "text": "Si, además, es menester conceder favores a quienes más nos los reclaman, conviene mostrar benevolencia no a los satisfechos, sino a los descarriados."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "965892cc-4bd6-393a-a6f1-c4902656360c",
                                        "entry_id": "3f192adf-d35c-321b-9106-e472035aae60",
                                        "glosses": [
                                            "Salirse del camino recto en el sentido moral o ético; obrar de modo no razonable, correcto o justo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4ffb6f5-001d-4e12-84e2-e49e927b2273",
                        "source_entry_id": "68395e85-be35-3ed6-bfaa-643494c2fcdf",
                        "source_sense_id": "0a444aad-ed6f-39b8-8803-66162efbc17e",
                        "target_lang_word": "perderse",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perderse",
