                "senses": [
                    {
                        "sense_id": "fc0d7dd8-eb4f-3903-b9e1-ff51b7249549",
                        "entry_id": "5628e0c3-cca0-324e-a118-0d851da867b2",
                        "glosses": [
                            "Pirat, der auf Flüssen fährt, Flussschiffe überfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d948125-52f9-412f-aee2-e742f653ede8",
                                "sense_id": "fc0d7dd8-eb4f-3903-b9e1-ff51b7249549",
                                "text": "„In diesem Augenblick waren seine Gesichtszüge deutlich zu sehen und ich erkannte ihn - er war ein berüchtigter Flusspirat, der seit Langem wegen Raubs und Mordes gesucht wurde.“"
                            },
                            {
                                "example_id": "326cc63b-2132-47cc-b478-2f9caa06de6a",
                                "sense_id": "fc0d7dd8-eb4f-3903-b9e1-ff51b7249549",
                                "text": "„Fan Jiang konnte er nicht mehr sehen, der befand sich nun allein in der Gewalt der Flusspiraten, und er hatte bestimmt den Eindruck gewonnen, Court würde ihn schmählich im Stich lassen, und das kurz nachdem er ihm ausdrücklich versichert hatte, ihn aus allem rauszuholen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
