                        "entry_id": "6129a851-3ef6-34c4-bc41-e51915fd4e1b",
                        "glosses": [
                            "Qui concerne la communication ou l’expression ne passant pas par la parole, mais par des gestes, des postures, des mimiques, des regards, des intonations, etc."
                        ],
                        "tags": [
                            "Communication"
                        ],
