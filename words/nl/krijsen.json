                    "sense_id": "841d726d-8bb7-33e1-8951-a4732c5b245d",
                    "sense_definition": "een hard en hoog geluid maken met de stem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluidsproductie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby begon hard te <w>krijsen</w> toen hij zijn speelgoed verloor.",
                            "target_lang_translations": {
                                "en": "The baby started to <w>shriek</w> loudly when he lost his toy.",
                                "ru": "Ребёнок начал громко <w>визжать</w>, когда потерял свою игрушку."
                            }
                        },
                        {
                            "text": "De meeuwen boven het strand bleven de hele middag <w>krijsen</w> om eten.",
                            "target_lang_translations": {
                                "en": "The seagulls above the beach kept <w>screeching</w> for food all afternoon.",
                                "ru": "Чайки над пляжем весь день продолжали <w>кричать</w>, выпрашивая еду."
                            }
                        }
                    ],
                    "synonyms": [
                        "schreeuwen",
                        "gillen",
                        "blèren"
                    ],
                    "antonyms": [
                        "fluisteren",
                        "zwijgen"
                    ],
                    "common_phrases": [
                        "om hulp krijsen",
                        "van angst krijsen"
                    ],
                    "target_lang_definitions": {
