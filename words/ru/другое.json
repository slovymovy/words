            "senses": [
                {
                    "sense_id": "39aa8eb7-5dc3-3f5c-a4d1-2b82c2c8b460",
                    "sense_definition": "Форма именительного или винительного падежа единственного числа среднего рода прилагательного <w>другой</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это совсем <w>другое</w> дело.",
                            "target_lang_translations": {
                                "en": "That is a completely <w>different</w> matter.",
                                "zh": "这完全是<w>另一回事</w>。"
                            }
                        },
                        {
                            "text": "Мы решили пойти в <w>другое</w> место.",
                            "target_lang_translations": {
                                "en": "We decided to go to <w>another</w> place.",
                                "zh": "我们决定去<w>另外的</w>地方。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "другое дело",
                        "в другое время",
                        "другое место"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Neuter singular form of the adjective meaning other, another, or different.",
                        "zh": "形容词“另一个”或“不同的”的中性单数形式。"
                    },
                    "translations": {
