                "senses": [
                    {
                        "sense_id": "54cbfab7-0abf-38c4-8e8e-2d406228ff16",
                        "entry_id": "51887676-73d4-3bb7-a6c1-5fba50396127",
                        "glosses": [
                            "Plan zur zivilen oder militärischen Nutzung von Atomkraft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8446499-6c2c-4fa3-af58-feb9ddbfb8c8",
                                "sense_id": "54cbfab7-0abf-38c4-8e8e-2d406228ff16",
                                "text": "„Die beiden schienen mehr über das israelische Atomprogramm zu wissen als die meisten Israelis, und dieses Wissen stürzte sie in ein ernstes Dilemma.“"
                            },
                            {
                                "example_id": "bf562a09-db1b-4147-9161-c81b3cb7667e",
                                "sense_id": "54cbfab7-0abf-38c4-8e8e-2d406228ff16",
                                "text": "„›Wenn Sie mich also direkt fragen, dann sage ich: Ja, er ist wohl Mitarbeiter beim iranischen Atomprogramm.‹“"
                            },
                            {
                                "example_id": "7a314a06-3b8c-436d-aa80-a1b2f7517cf7",
                                "sense_id": "54cbfab7-0abf-38c4-8e8e-2d406228ff16",
                                "text": "„Präsident Mahmoud Ahmadinedschad arbeitet mit Nachdruck an seinem Atomprogramm und ruft gleichzeitig dazu auf, Israel von der Landkarte zu tilgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
