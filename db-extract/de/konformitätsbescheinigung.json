                ],
                "senses": [
                    {
                        "sense_id": "7fafc490-b1ce-311f-bada-0a7f1bd4fc79",
                        "entry_id": "3d2e22cf-5d3f-34bc-bbda-3aebdc95febf",
                        "glosses": [
                            "Beleg, Anerkennungszeugnis zur Gleichwertigkeit mit europäischen, nationalen Normen und nicht gegen geltendes europäisches, nationales Recht verstößt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "e9360c7a-91ae-40fc-802e-6935bf7471a5",
                                "sense_id": "7fafc490-b1ce-311f-bada-0a7f1bd4fc79",
                                "text": "„Wenn Ihre Berufsbezeichnung dort nicht aufgeführt wurde, aber trotzdem die Mindestanforderungen der Art. 31 und 40 der Richtlinie 2005/36/EG erfüllt sind, ist eine Konformitätsbescheinigung des Ausbildungsstaates erforderlich.“"
                            },
                            {
                                "example_id": "629322e7-a220-4ee9-89f8-b7015cf52fca",
                                "sense_id": "7fafc490-b1ce-311f-bada-0a7f1bd4fc79",
                                "text": "„Allgemeine Informationen zur Gültigkeitsdauer von Konformitätsbescheinigungen nach der Richtlinie 96/98/EG des Rates vom 20. Dezember 1996 über Schiffsausrüstung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "423ef815-71c0-3095-8aa5-abbce7a88857",
                        "entry_id": "3d2e22cf-5d3f-34bc-bbda-3aebdc95febf",
                        "glosses": [
                            "Bescheinigung einer Firma, dass ein bestimmtes Erzeugnis oder ein bestimmter Dienst mit Normen oder ganz bestimmten technischen Spezifikationen übereinstimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7700e6ff-9e24-457c-986b-8e877130c460",
                                "sense_id": "423ef815-71c0-3095-8aa5-abbce7a88857",
                                "text": "„Allgemeine Informationen zur Gültigkeitsdauer von Konformitätsbescheinigungen nach der Richtlinie 96/98/EG des Rates vom 20. Dezember 1996 über Schiffsausrüstung.“"
                            },
                            {
                                "example_id": "0be78785-862f-4c2c-b2bf-b654b21967cd",
                                "sense_id": "423ef815-71c0-3095-8aa5-abbce7a88857",
                                "text": "Die Konformitätsbescheinigung eines Herstellers ist eine selbstschuldnerisch Verpflichtung, die bestätigt, dass die Konformität der getesteten Produktprobe mit einschlägigen Normen gegeben ist, und als Typgenehmigung bezeichnet wird."
                            },
                            {
                                "example_id": "e4b7f9ab-a289-47ed-a834-74bba916e8f3",
                                "sense_id": "423ef815-71c0-3095-8aa5-abbce7a88857",
                                "text": "„Die Einhaltung dieser Qualitätsnormen wird von der Bundesanstalt für Landwirtschaft und Ernährung (BLE) stichprobenweise durch Kontrollen der Waren, die eingeführt werden sollen, geprüft und dem Einführer mit einer Konformitätsbescheinigung bestätigt.“"
                            },
                            {
                                "example_id": "7520520a-420d-401d-acc1-afbf74f71402",
                                "sense_id": "423ef815-71c0-3095-8aa5-abbce7a88857",
                                "text": "Beispiel einer Konformitätsbescheinigung von LeeN GmbH, geprüft vom TÜV Rheinland Cert GmbH."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
