                ],
                "senses": [
                    {
                        "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                        "entry_id": "2125bac1-b4b1-37fa-accc-75e7548b92a2",
                        "glosses": [
                            "kurze, lineare Abfolge verschiedener Bilder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df86f02-8932-4eca-beb8-9f572385d1e6",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "Nachdem ich mir das Filmchen angeschaut habe, können wir fahren."
                            },
                            {
                                "example_id": "62050dc7-a7be-4c9b-8a1c-7b45abdb605d",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "„Ich habe mich verliebt. In diese Musik und in dieses kleine Filmchen, […]“"
                            },
                            {
                                "example_id": "8ecfd58b-5309-43c4-8164-afb419ff7a68",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "„Ich möchte dann auch nicht auf dem Balkon sitzen, sondern lieber Radio hören, Filmchen gucken, im Internet rumsurfen.“"
                            },
                            {
                                "example_id": "0916df4d-dc94-4c9a-bdc2-c35935cbdbe9",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "„Mein Sohn hatte längst andere Filmchen angeklickt und war bei sprechenden Hunden gelandet, die in eine Zentrale beordert wurden.“"
                            },
                            {
                                "example_id": "0fa68640-c5ca-406b-8e26-4888cb4352ab",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "„Als die schwulen- und frauenfeindlichen Filmchen ins Internet gelangten, ging der Kapitän baden. […] Die Clips wurden […] wöchentlich zur Belustigung der Mannschaft gezeigt.“"
                            },
                            {
                                "example_id": "4b1b913c-9b21-44b3-a7e9-6f98fda70e2e",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "„Irgendeine Art Motiv hätte das kleine, schmutzige Filmchen sein können.“"
                            },
                            {
                                "example_id": "df475139-c6bb-4cc0-b3fe-79ea925796ca",
                                "sense_id": "ad5e4860-813f-38a4-a7c9-835d07eb981a",
                                "text": "„In der Hoffnung auf ein Ende der Mobbing-Attacken lässt Nik sich schließlich auf diesen folgenreichen ‚Deal‘ mit seinen Peinigern ein. Auch sein Avatar Salokin meint ‚ist doch nur ein kleines Filmchen‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2ee5068-99cf-37ac-8e48-bda8c4cbb2c1",
                        "entry_id": "2125bac1-b4b1-37fa-accc-75e7548b92a2",
                        "glosses": [
                            "als minderwertig/negativ oder belanglos beurteilte lineare Abfolge verschiedener Bilder"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "cc998687-a285-429c-88be-09ac73d13f1f",
                                "sense_id": "a2ee5068-99cf-37ac-8e48-bda8c4cbb2c1",
                                "text": "„Mein Sohn hatte längst andere Filmchen angeklickt und war bei sprechenden Hunden gelandet, die in eine Zentrale beordert wurden.“"
                            },
                            {
                                "example_id": "ce6f4b9d-1a43-42a8-8563-e926a850c059",
                                "sense_id": "a2ee5068-99cf-37ac-8e48-bda8c4cbb2c1",
                                "text": "„Als die schwulen- und frauenfeindlichen Filmchen ins Internet gelangten, ging der Kapitän baden. […] Die Clips wurden […] wöchentlich zur Belustigung der Mannschaft gezeigt.“"
                            },
                            {
                                "example_id": "73c5d84c-0b08-4c78-89c1-1dbe195c6845",
                                "sense_id": "a2ee5068-99cf-37ac-8e48-bda8c4cbb2c1",
                                "text": "„Irgendeine Art Motiv hätte das kleine, schmutzige Filmchen sein können.“"
                            },
                            {
                                "example_id": "80e07fe4-10da-4663-be3b-2135252ffba3",
                                "sense_id": "a2ee5068-99cf-37ac-8e48-bda8c4cbb2c1",
                                "text": "„In der Hoffnung auf ein Ende der Mobbing-Attacken lässt Nik sich schließlich auf diesen folgenreichen ‚Deal‘ mit seinen Peinigern ein. Auch sein Avatar Salokin meint ‚ist doch nur ein kleines Filmchen‘.“"
                            }
                        ],
