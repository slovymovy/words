                "senses": [
                    {
                        "sense_id": "335677cf-7c18-3ba5-9300-89ab996d5b7e",
                        "entry_id": "c8ec763e-2077-312a-a85b-c0aeec72499a",
                        "glosses": [
                            "Beignet sucré et toroïdal, d’origine nord-américaine."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "951899d9-db48-46ed-a57c-ef2b151871ca",
                                "sense_id": "335677cf-7c18-3ba5-9300-89ab996d5b7e",
                                "text": "Nous devons aussi apporter des donuts aux plus anciens de l’équipe avant certains entrainements."
                            },
                            {
                                "example_id": "1d602fc4-40eb-47f2-8d28-7134f195e06a",
                                "sense_id": "335677cf-7c18-3ba5-9300-89ab996d5b7e",
                                "text": "Un donut bien carré rappelle les fameux beignets poudrés de la Nouvelle Orléans, en plus bourratif."
                            },
                            {
                                "example_id": "b1da166f-4dc8-493d-95b2-c065075716c7",
                                "sense_id": "335677cf-7c18-3ba5-9300-89ab996d5b7e",
                                "text": "Et comble du ridicule, une espèce de cinglée était en train d'engloutir un gros donut bien gras sur son siège passager."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbbcf9db-753c-3339-8cb3-a3a518c9722d",
                        "entry_id": "c8ec763e-2077-312a-a85b-c0aeec72499a",
                        "glosses": [
                            "Beignet."
                        ],
                        "tags": [
                            "Anglicism",
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a225b69c-b841-3475-939b-f6beaaa60324",
                        "entry_id": "c8ec763e-2077-312a-a85b-c0aeec72499a",
                        "glosses": [
                            "Figure consistant à faire patiner le ou les pneus arrière d’un véhicule en dessinant des cercles de gommes sur le sol ; burn circulaire."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "62fbfc66-1b47-4956-a9ac-2716d0cb0b5a",
                                "sense_id": "a225b69c-b841-3475-939b-f6beaaa60324",
                                "text": "Les mecs sont les rois du pétrole. Ils privatisent le parking public pour des rodéos en scooter, font des donuts à fond avec des caisses de sport et agressent les sans-abri qui vivent sur le terrain vague."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec43a6d6-d0f9-479a-b8e0-692c94abcca4",
