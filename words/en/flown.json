    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bca4ce2a-5b34-3bec-aac8-f11e34a7e5a6",
                    "sense_definition": "past participle of <w>fly</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never <w>flown</w> in a helicopter before today.",
                            "target_lang_translations": {
                                "ru": "До сегодняшнего дня я никогда не <w>летал</w> на вертолете."
                            }
                        },
                        {
                            "text": "The birds have already <w>flown</w> south for the winter.",
                            "target_lang_translations": {
                                "ru": "Птицы уже <w>улетели</w> на юг на зиму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have flown",
                        "flown home",
                        "flown away"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие прошедшего времени от глагола fly (летать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "летал",
                                "target_lang_sense_clarification": "в составе перфектных форм"
                            },
                            {
                                "target_lang_word": "улетел",
                                "target_lang_sense_clarification": "о птицах или самолетах"
                            },
                            {
                                "target_lang_word": "совершил полет",
                                "target_lang_sense_clarification": "официальный или технический контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24a4f32-20f2-3ece-b107-814aa6a23451",
                    "sense_definition": "past participle of <w>flow</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river has <w>flown</w> through this valley for centuries.",
                            "target_lang_translations": {
                                "ru": "Река <w>протекала</w> через эту долину на протяжении веков."
                            }
                        },
                        {
                            "text": "Much water has <w>flown</w> under the bridge since we last met.",
                            "target_lang_translations": {
                                "ru": "Много воды <w>утекло</w> с тех пор, как мы виделись в последний раз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "has flown"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие прошедшего времени от глагола flow (течь)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протекал",
                                "target_lang_sense_clarification": "о реке или жидкости"
                            },
                            {
                                "target_lang_word": "утекло",
                                "target_lang_sense_clarification": "в переносном смысле о времени или воде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5adece79-0550-39f1-b20b-4516990164ca",
                    "sense_definition": "Describing scenery or equipment that is suspended in the space above a theater stage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stagehands quickly lowered the <w>flown</w> scenery during the intermission.",
                            "target_lang_translations": {
                                "ru": "Рабочие сцены быстро опустили <w>подвесные</w> декорации во время антракта."
                            }
                        },
                        {
                            "text": "We need to check the safety cables for all <w>flown</w> elements before the show.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проверить страховочные тросы для всех <w>подвешенных</w> элементов перед началом шоу."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspended",
                        "hanging"
                    ],
                    "common_phrases": [
                        "flown scenery"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical theater term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "описание декораций или оборудования, подвешенных в пространстве над театральной сценой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвесной",
                                "target_lang_sense_clarification": "о театральных декорациях"
                            },
                            {
                                "target_lang_word": "поднятый на штанкеты",
                                "target_lang_sense_clarification": "профессиональный театральный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
