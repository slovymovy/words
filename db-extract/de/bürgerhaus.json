                                        "sense_id": "20dec89f-0388-3df7-8877-7b44525f0462",
                                        "entry_id": "71f14357-2dee-3c4e-ab2e-0361add3333b",
                                        "glosses": [
                                            "An individual habitation or apartment within a large house or group of buildings. (Now chiefly in allusion to John 14:2.)"
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b24707c8-d04a-4517-aac3-4fe4f14ec60d",
                                                "sense_id": "20dec89f-0388-3df7-8877-7b44525f0462",
                                                "text": "In my Father's house are many mansions [translating μοναὶ (monaì)]: if it were not so, I would have told you."
                                            },
                                            {
                                                "example_id": "70f1c779-6ff9-4cbe-be98-f43d2a2f0e3e",
                                                "sense_id": "20dec89f-0388-3df7-8877-7b44525f0462",
                                                "text": "These poets near our princes sleep, / And in one grave their mansion keep."
                                            },
                                            {
                                                "example_id": "f2c7a0f5-a5bd-4aa4-8d59-d4fc7a297a1b",
                                                "sense_id": "20dec89f-0388-3df7-8877-7b44525f0462",
                                                "text": "The many mansions in one east London house of God."
