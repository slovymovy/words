                        "target_lang_word": "Diashow",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diashow",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aab10be7-f3cf-3c95-9ae5-df84a5c97272",
                                        "entry_id": "ecc9285c-6d6d-3725-bc2f-24fbc31face7",
                                        "glosses": [
                                            "Präsentation von Dias beispielsweise zu einem speziellen Thema oder zu einem bestimmten Anlass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dffaff30-1472-4239-8ed8-fdb703a79c5f",
                                                "sense_id": "aab10be7-f3cf-3c95-9ae5-df84a5c97272",
                                                "text": "Beim 800-jährigen Stadtjubiläum konnte man mehrere Diashows besuchen, bei denen die historischen Ansichten der Stadt im Mittelpunkt standen."
                                            },
                                            {
                                                "example_id": "ec697492-3954-4d15-b630-b056aecd4e11",
                                                "sense_id": "aab10be7-f3cf-3c95-9ae5-df84a5c97272",
                                                "text": "Auf dem Geburtstag von Tante Ilse nutzte Onkel Sepp die Gelegenheit, seinen neuen Diaprojektor im Rahmen einer spontanen Diashow vorzuführen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f907c6c-c4e7-38f8-beac-dfe69936d8cc",
                                        "entry_id": "ecc9285c-6d6d-3725-bc2f-24fbc31face7",
                                        "glosses": [
                                            "selbstständig ablaufende Folge von Digitalbildern auf einem Bildschirm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92bda12c-8eac-462e-bf52-578526a19cbe",
                                                "sense_id": "9f907c6c-c4e7-38f8-beac-dfe69936d8cc",
                                                "text": "Sie ließ ihre Urlaubsfotos für ihre Freundinnen auf dem Laptop als Diashow anzeigen."
                                            },
                                            {
                                                "example_id": "ba21275c-6f29-4261-b150-f2935e3335b5",
                                                "sense_id": "9f907c6c-c4e7-38f8-beac-dfe69936d8cc",
                                                "text": "Simeon hat sich als Desktophintergrund eine Diashow mit Bildern seines Lebenspartners eingerichtet, bei der das Motiv alle halbe Stunde wechselt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
