                "senses": [
                    {
                        "sense_id": "1ca84ab3-4b86-3e24-bcca-e75ec7366337",
                        "entry_id": "a8fc6b02-60ba-3046-b0e8-919af15666ad",
                        "glosses": [
                            "Versprechen eines Kandidaten, im Falle eines Wahlsieges, etwas Bestimmtes für eine Wählergruppe zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99ac430-6797-40b5-b8ba-069f7153bedd",
                                "sense_id": "1ca84ab3-4b86-3e24-bcca-e75ec7366337",
                                "text": "\"Neun gute Gründe\" nannte der Kanzlerkandidat Gerhard Schröder 1998 auf einer kleinen Wahlkampfkarte den Wählern dafür, die SPD zu wählen. SPIEGEL ONLINE hat die Karte aufbewahrt und beschreibt, was aus den Wahlversprechen wurde."
                            },
                            {
                                "example_id": "6e231a62-7262-4e00-9574-84ade7c8c9c6",
                                "sense_id": "1ca84ab3-4b86-3e24-bcca-e75ec7366337",
                                "text": "Zehn Prozent der Bürger, die 2005 CDU/CSU gewählt haben, glauben den Wahlversprechen, acht Prozent der SPD- und elf Prozent der FDP-Wähler."
                            },
                            {
                                "example_id": "b142402e-e856-4bee-b750-662436a1bcbe",
                                "sense_id": "1ca84ab3-4b86-3e24-bcca-e75ec7366337",
                                "text": "„Donald Trump aber hält weiter an seinen Wahlversprechen fest, elf Millionen illegale Immigranten aus dem Land zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
