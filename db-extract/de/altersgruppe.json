                        "form": "die Altersgruppen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "479a87cb-6936-3290-a73e-399c0122745f",
                        "entry_id": "7af3c751-4909-3f33-b1cd-152d41d3587d",
                        "glosses": [
                            "Gruppe von Personen gleichen Alters/gleicher Altersspanne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc25088-8515-42a8-94d8-70d689c7e895",
                                "sense_id": "479a87cb-6936-3290-a73e-399c0122745f",
                                "text": "„Im Bereich des passiven Wortschatzes lagen die Werte für Jungen, zusammengefaßt in den untersuchten Altersgruppen von drei bis acht Jahren, höher.“"
                            },
                            {
                                "example_id": "f777b511-da61-47cd-98d2-9cf0a11ae740",
                                "sense_id": "479a87cb-6936-3290-a73e-399c0122745f",
                                "text": "„Er präsentiert in dem ausführlichen Wanderführer zum Niederrhein 50 Wanderungen, die für jede Altersgruppe geeignet sind.“"
                            },
                            {
                                "example_id": "83e95e48-40b3-4e4e-aa01-8f1fb7cdbaa0",
                                "sense_id": "479a87cb-6936-3290-a73e-399c0122745f",
                                "text": "„Die jungen Altersgruppen seien zudem fast vollständig vor einem tödlichen Verlauf der Krankheit geschützt.“"
                            },
                            {
                                "example_id": "97714e77-8b6e-463c-9dfb-2bca4f7958dc",
                                "sense_id": "479a87cb-6936-3290-a73e-399c0122745f",
                                "text": "„Die Zahl der Menschen dieser Altersgruppe in Einpersonenhaushalten stieg binnen 20 Jahren um 17 Prozent von 5,1 auf 5,9 Millionen, wie das Statistische Bundesamt am Mittwoch in Wiesbaden mitteilte.“"
                            },
                            {
                                "example_id": "8428023c-dbfc-4c46-8d46-67214a1c96ab",
                                "sense_id": "479a87cb-6936-3290-a73e-399c0122745f",
                                "text": "„Die britische Impfkommission hatte sich unlängst gegen ein routinemäßiges Impfangebot an diese Altersgruppe ausgesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
