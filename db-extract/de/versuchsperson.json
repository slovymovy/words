                "senses": [
                    {
                        "sense_id": "915448ff-dc07-333f-bb01-806e114bed2f",
                        "entry_id": "30344cc5-9066-3345-8a4f-d8a2ada10b39",
                        "glosses": [
                            "Person, an oder mit der ein Versuch durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4a4bde-90fd-4fe5-89b6-425b87cf36b0",
                                "sense_id": "915448ff-dc07-333f-bb01-806e114bed2f",
                                "text": "„Die Arzneimittelprüfung gliedert sich in mehrere Phasen: In der Vorphase testen wenige gesunde Versuchspersonen vor allem die Verträglichkeit des Mittels, in Phase II und III verwenden kranke Personen das Mittel, um die Wirksamkeit zu prüfen.“"
                            },
                            {
                                "example_id": "a5f3844a-9ae4-4caf-994a-36feb93cec31",
                                "sense_id": "915448ff-dc07-333f-bb01-806e114bed2f",
                                "text": "„Die Versuchspersonen – mehrheitlich Chinesen und russische Kriegsgefangene – wurden als Holzklötze bezeichnet.“"
                            },
                            {
                                "example_id": "186fe2b5-a800-44a4-b151-28b77045a989",
                                "sense_id": "915448ff-dc07-333f-bb01-806e114bed2f",
                                "text": "„Dazu schob er seine Versuchspersonen in einen Computertomographen und forderte sie auf, bestimmte Worträtsel zu lösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b13a4a90-0fc9-4ef4-a849-664d69acf7f8",
