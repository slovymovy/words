                "senses": [
                    {
                        "sense_id": "52d3894a-d6d8-3688-b077-2a3a263cc150",
                        "entry_id": "d134a0ed-819f-3b45-a0ba-c1168f6363ba",
                        "glosses": [
                            "de zachte maar duurdere wol van een jong schaap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbae3aa-1910-4c20-95fe-0dde97c70373",
                                "sense_id": "52d3894a-d6d8-3688-b077-2a3a263cc150",
                                "text": "Om de kou door te komen, bood Melbostad flink wat jassen aan. Van een kort zwart leren motorjack met een schuine rits tot hooggesloten driekwart jassen met een prince de galles ruit en parka's met lamswol."
                            },
                            {
                                "example_id": "9885ca76-ee88-4b57-b046-b3d10797b76b",
                                "sense_id": "52d3894a-d6d8-3688-b077-2a3a263cc150",
                                "text": "Op het hoofd van de superster prijkt een alpinopet die wellicht moet verwijzen naar de Franse sfeer van By the sea, dat zich afspeelt aan de Côte DÁzur in 1973. Verder: een duidelijk getraind lichaam onder de donkergrijze lamswollen trui, zongebruind gezicht en bril met lichtblauwe glazen."
                            },
                            {
                                "example_id": "2d5ac874-611c-4cfa-b914-345822663f8a",
                                "sense_id": "52d3894a-d6d8-3688-b077-2a3a263cc150",
                                "text": "Hoogwaardige eikenhouten meubelen, lederen fauteuils, tapijt van hetzelfde lamswol dat ook in auto's van Bentley is te vinden: het is allemaal te vinden in de CW1-showroom (CW refereert aan de postcode van het merk). Zelfs aan een koffie- en champagnebar is gedacht. Volgens Bentley biedt het CW1 House een 'visualisatie voor 'de meest exclusieve klantenbeleving'."
                            }
                        ]
                    }
