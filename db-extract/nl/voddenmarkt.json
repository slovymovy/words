                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19bdcb6-bd07-4ebc-ac59-64e70aea1c19",
                                "sense_id": "3fea80a9-b8ab-31cb-aae2-26e13a2af336",
                                "text": "De transacties ontstegen niet de nering van uitdragers op een voddenmarkt."
                            },
                            {
                                "example_id": "c67227ef-897a-4c22-866b-246b4133a66f",
                                "sense_id": "3fea80a9-b8ab-31cb-aae2-26e13a2af336",
                                "text": "Loop gerust eens binnen, de mensen bij Didden zijn uitermate vriendelijk en zullen u zeker niet scheef bekijken zo u geen tapijt koopt en alleen komt om het werk van Didden & Spark te bekijken. Profiteer van uw bezoek om even verder te slenteren en de voddenmarkt verderop te bezoeken (elke dag tot 13u, het leukst op zaterdag en zondag) of de brocante- en antiekmarkt op de Zavel (zaterdag en zondag)."
                            }
                        ]
