                "senses": [
                    {
                        "sense_id": "056ef280-7061-3a21-a25f-b2dd922a8ffc",
                        "entry_id": "0e5baf1b-4463-319a-bf67-8f35c6878be4",
                        "glosses": [
                            "Stadt in der chinesischen Provinz Fujian"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3d7f5d-044b-446f-b818-751ad0fe9687",
                                "sense_id": "056ef280-7061-3a21-a25f-b2dd922a8ffc",
                                "text": "„Chabukswar und Mukherjee haben auch die längstmögliche Route an Land berechnet, die man laufen könnte, ohne nasse Füße zu bekommen. Sie beginnt in Jinjiang auf dem chinesischen Festland gegenüber der Insel Taiwan - und führt dann durch China, die Mongolei, Kasachstan, Russland, Weißrussland, die Ukraine, Polen, Tschechien, Österreich, Deutschland, Liechtenstein, die Schweiz, Frankreich und Spanien bis in die Nähe von Sagres in Portugal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ce00543a-f48f-3a4a-b7ba-16cebf75f5b8",
                        "entry_id": "0e5baf1b-4463-319a-bf67-8f35c6878be4",
                        "glosses": [
                            "Stadtbezirk im Verwaltungsgebiet der Stadt Chengdu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35b20c8-68c7-4c9a-9cde-060d6bc08bb6",
                                "sense_id": "ce00543a-f48f-3a4a-b7ba-16cebf75f5b8",
                                "text": "„Wenn Wanderarbeiter in China einen Job suchen, probieren sie ihr Glück oft auf sogenannten Arbeitermärkten. Einer davon befindet sich im Bezirk Jinjiang der Neun-Millionen-Metropole Chengdu, der Hauptstadt der Provinz Sichuan.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
