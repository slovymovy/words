                        "glosses": [
                            "Personne qui ne peut pas être soignée, bénéficier de soins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733fe1c2-1135-4b13-9c1d-eeec228fb523",
                                "sense_id": "4e7dc573-843e-3d7d-9c66-c25daaa0cb3e",
                                "text": "Seigneur, nous le savons, cela coûte cher en temps, en intelligence, en argent, de sauver de la misère les sans-logis et les sans-pain, les sans-école, les sans-soins et les sans-emploi."
                            },
                            {
                                "example_id": "45c19fbe-a93b-4ef5-937f-e7859069bbfd",
                                "sense_id": "4e7dc573-843e-3d7d-9c66-c25daaa0cb3e",
                                "text": "Par compassion avec les sans-soins, j’ai parfois refusé de faire usage des anti-douleurs."
                            },
                            {
                                "example_id": "10fa1a60-34b9-4335-a438-babaee62d67e",
                                "sense_id": "4e7dc573-843e-3d7d-9c66-c25daaa0cb3e",
                                "text": "Foi dans un idéal plus grand que soi, fidélité à la mission dont on s’est investi pour les siens, les sans-voix, les sans-soins."
                            }
                        ]
                    }
