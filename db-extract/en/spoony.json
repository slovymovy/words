                    },
                    {
                        "form_id": "17d8189b-ed65-47b4-8d4c-0b0eae2ff148",
                        "entry_id": "13d4b6dd-2051-3070-9d36-17a358272f23",
                        "tags": [
                            "superlative"
                        ],
                        "form": "spooniest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58a934cc-f754-3c10-a66a-4e6982324772",
                        "entry_id": "13d4b6dd-2051-3070-9d36-17a358272f23",
                        "glosses": [
                            "Enamored in a silly or sentimental way; having a crush (on someone)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093277cc-9713-4170-ab83-51c1773dbbf6",
                                "sense_id": "58a934cc-f754-3c10-a66a-4e6982324772",
                                "text": "\"She—silly child—is spoony, I think, on that cousin of her's, Dalrymple—he, I believe, is spoony on her.\""
                            },
                            {
                                "example_id": "c6dd6eac-b8a6-4e97-9e73-c52c075f9580",
                                "sense_id": "58a934cc-f754-3c10-a66a-4e6982324772",
                                "text": "‘They all laugh at you, you know. They say you're spoony on me.’"
                            },
                            {
                                "example_id": "be1306db-93bc-4ab0-93d3-7b2da3d99910",
                                "sense_id": "58a934cc-f754-3c10-a66a-4e6982324772",
                                "text": "Even if they were absolutely spoony for each other it was difficult to imagine either of them taking that first scary step toward romance."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b5abd96-9656-343f-ad85-8943c4d1a5ed",
                        "entry_id": "13d4b6dd-2051-3070-9d36-17a358272f23",
                        "glosses": [
                            "Feebly sentimental; gushy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8717aeba-ecdd-4955-bb03-fd84faa49b1a",
                                "sense_id": "0b5abd96-9656-343f-ad85-8943c4d1a5ed",
                                "text": "That is why we decline to publish any of the letters and verses which Mr. Pen wrote at this period of his life, out of mere regard for the young fellow’s character. They are too spooney and wild."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9c635f1-2057-3659-a40a-36ae40997f80",
                        "entry_id": "13d4b6dd-2051-3070-9d36-17a358272f23",
                        "glosses": [
                            "Similar to a spoon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65f89eba-b798-46b5-b28d-cc67810296d8",
                                "sense_id": "b9c635f1-2057-3659-a40a-36ae40997f80",
                                "text": "That's a very spoony fork."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8a50d265-2dd9-3d9d-ba5a-a49d166cc8bd",
                "word": "spoony",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "39052f2c-d4fb-4a0e-a7e7-201197add9fe",
                        "entry_id": "8a50d265-2dd9-3d9d-ba5a-a49d166cc8bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "spoonies"
