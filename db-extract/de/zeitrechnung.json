                        "form": "die Zeitrechnungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c7384b2-48d1-3fa5-9eea-2b15b2f360d6",
                        "entry_id": "da9ad35c-27e5-35cf-9fba-78abbe215110",
                        "glosses": [
                            "Aufbau des Kalenders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d32f0e-f94b-4441-9f2b-d018bacd533c",
                                "sense_id": "8c7384b2-48d1-3fa5-9eea-2b15b2f360d6",
                                "text": "„Befragt nach seinem Alter gab der [Beschwerdeführer] wie im bisherigen Verfahren an, 16 Jahre alt zu sein, nannte jedoch als Geburtsjahr verschiedene Jahre und zwar jeweils nach der islamischen Zeitrechnung.“"
                            },
                            {
                                "example_id": "b7d04be9-b78c-4cd8-94c4-10527f48459e",
                                "sense_id": "8c7384b2-48d1-3fa5-9eea-2b15b2f360d6",
                                "text": "„Als sie im zehnten Jahrhundert unserer Zeitrechnung aus dem islamischen Arabien nach Europa kam, stieß sie dementsprechend auf große Ablehnung, aber auch auf große Faszination.“"
                            },
                            {
                                "example_id": "945c4bc9-531f-4384-903d-957730e17ff7",
                                "sense_id": "8c7384b2-48d1-3fa5-9eea-2b15b2f360d6",
                                "text": "„Schon lange vor unserer Zeitrechnung wurde sie von Seeräubern besetzt, später von den Großmächten Türkei, Griechenland und England, und wiederholte Male auch von Italien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1d8f2f9d-6f50-358e-830c-2f223a918ac8",
                        "entry_id": "da9ad35c-27e5-35cf-9fba-78abbe215110",
                        "glosses": [
                            "Berechnung der Uhrzeit"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "06ff4317-52cc-34d9-811b-c5ac4a95c559",
                        "entry_id": "da9ad35c-27e5-35cf-9fba-78abbe215110",
                        "glosses": [
                            "Aufbruch zu einer neuen Ära"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "422e92f6-0b4f-4733-8268-d68df91ec39e",
                                "sense_id": "06ff4317-52cc-34d9-811b-c5ac4a95c559",
                                "text": "„Die Neuausstattung ist ein Hinweis darauf, dass eine neue Zeitrechnung noch auf sich warten lässt.“"
                            },
                            {
                                "example_id": "17749250-287a-447b-8f35-0acf758ee766",
                                "sense_id": "06ff4317-52cc-34d9-811b-c5ac4a95c559",
                                "text": "„Eine neue Zeitrechnung begann für mich.“"
                            },
                            {
                                "example_id": "0f415e32-a64e-4f75-9f95-7e103693a935",
                                "sense_id": "06ff4317-52cc-34d9-811b-c5ac4a95c559",
                                "text": "„Sie hatte eine eigene Zeitrechnung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "cdedc61b-19a0-31a5-b84d-abf7ff0bc177",
                        "entry_id": "da9ad35c-27e5-35cf-9fba-78abbe215110",
                        "glosses": [
                            "Beginn einer Jahreszählung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aecbaa00-792a-4f85-8ade-4394e84c7742",
                                "sense_id": "cdedc61b-19a0-31a5-b84d-abf7ff0bc177",
                                "text": "„600 Jahre vor unserer Zeitrechnung gelangten Hühner zum ersten Mal über die Alpen.“"
                            },
                            {
                                "example_id": "1f74dcbb-3b96-401a-8238-bc4f0ceb80dd",
                                "sense_id": "cdedc61b-19a0-31a5-b84d-abf7ff0bc177",
                                "text": "„Die Tabakpflanze, die in Süd- und Mittelamerika bereits vor unserer Zeitrechnung angepflanzt und zu religiösen sowie medizinischen Zwecken verwendet wurde, kam durch die spanischen Eroberer nach Europa.“"
                            },
                            {
                                "example_id": "5ddb41cd-6959-4177-82f9-74874078657a",
                                "sense_id": "cdedc61b-19a0-31a5-b84d-abf7ff0bc177",
                                "text": "„Als in den ersten Jahrhunderten unserer Zeitrechnung in Ägypten, das mittlerweile zu einer Provinz des römischen Imperiums hinabgesunken war, das Christentum Einzug hielt, geriet mit der alten Religion auch die Hieroglyphenschrift in Vergessenheit.“"
                            },
                            {
                                "example_id": "827db6ff-d44d-454d-ac2f-9a8251c767eb",
                                "sense_id": "cdedc61b-19a0-31a5-b84d-abf7ff0bc177",
                                "text": "„Denn spätestens seit der Eroberung Ägyptens durch die Araber im Jahr 639 unserer Zeitrechnung war die Sprache der Hieroglyphen gänzlich verstummt.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3babcc54-3459-4155-917b-fd79b3206f9a",
                        "source_entry_id": "da9ad35c-27e5-35cf-9fba-78abbe215110",
                        "source_sense_id": "8c7384b2-48d1-3fa5-9eea-2b15b2f360d6",
