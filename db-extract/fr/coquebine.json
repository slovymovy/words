                        "glosses": [
                            "Jeune fille niaise, innocente."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "16424e7c-4723-4122-a5b0-2faadb3cbe89",
                                "sense_id": "d43c7157-9721-3d59-85d1-d527e427ebdf",
                                "text": "Cette coquebine a le nez un peu carré ; mais la fraîcheur de sa peau, et aussi sa dot, qui monte à cent mille écus, lui ont composé les plus furieux attraits."
                            },
                            {
                                "example_id": "56cd61c2-1cc3-4e8a-a844-5b6e3c0bb9cb",
                                "sense_id": "d43c7157-9721-3d59-85d1-d527e427ebdf",
                                "text": "La vérité, c’est que le capitaine Vifargent ne lui déplaisait point, répondait assez exactement à l’idéal que cette coquebine se faisait d’un mari - d’un vrai, commandant une admiration sans réserve pour son activité, soit dit sans jeu de mot."
                            }
                        ]
                    }
