                        ],
                        "form": "die Ordination"
                    },
                    {
                        "form_id": "67b63295-2b00-42d9-8fa1-433c50d0b58d",
                        "entry_id": "8483941d-2a92-32fe-874f-56da1e5dbac3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ordinationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f934c28-85bb-34c3-bab6-51455e149bd0",
                        "entry_id": "8483941d-2a92-32fe-874f-56da1e5dbac3",
                        "glosses": [
                            "religiöses Ritual, in der ein Gläubiger zu einem geistlichen Amt (zum Beispiel Priester oder Rabbiner) gesegnet und beauftragt wird (meist durch Handauflegung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83d66a7-e5b8-4363-902a-1e11e0db7c3f",
                                "sense_id": "4f934c28-85bb-34c3-bab6-51455e149bd0",
                                "text": "„Die Praxis der Ordination ist in den einzelnen evangelischen Landeskirchen der EKD und Bekenntnistraditionen unterschiedlich.“"
                            },
                            {
                                "example_id": "75399f8a-919a-4846-9b70-d2341f6114ba",
                                "sense_id": "4f934c28-85bb-34c3-bab6-51455e149bd0",
                                "text": "„Ordination (lat: Anordnung) wird im Judentum und im Neuen Testament (1. Timotheus 4,14; 2. Timotheus 1,6) die Amtseinführung von Rabbinern bzw. Gemeindeleitern unter Handauflegung genannt. In der evangelischen Kirche bedeutet Ordination die Berufung, Segnung und Sendung zum Dienst der öffentlichen Wortverkündigung und Sakramentsverwaltung.“"
                            },
                            {
                                "example_id": "abddfb16-f42d-4759-99c8-6cd041c08c9b",
                                "sense_id": "4f934c28-85bb-34c3-bab6-51455e149bd0",
                                "text": "„Die Ordination ist die kirchliche Beauftragung zum öffentlichen Dienst an Wort und Sakrament und zur damit verbundenen Seelsorge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2b06a3d4-499a-3541-83e6-9234ac38297e",
                        "entry_id": "8483941d-2a92-32fe-874f-56da1e5dbac3",
                        "glosses": [
                            "ärztliche Verordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f26438fc-d393-4548-ae12-6312c16d0326",
                                "sense_id": "2b06a3d4-499a-3541-83e6-9234ac38297e",
                                "text": "Keiner unserer Kurärzte wird gleich zur Ordination kommen, sondern einjeder wird zunächst reichlich über Diagnose und Therapie nachdenken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e1a39a59-f05a-3f25-a39c-39b39bc4edab",
                        "entry_id": "8483941d-2a92-32fe-874f-56da1e5dbac3",
                        "glosses": [
                            "Arztpraxis; Untersuchungs- und Behandlungszimmer eines Arztes"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "4394fcbc-de1a-4a2b-b337-5bcfa5735818",
                                "sense_id": "e1a39a59-f05a-3f25-a39c-39b39bc4edab",
                                "text": "„Nach dem Studium an der Universität Wien (Dr. med. 1841) war Heider zunächst kurze Zeit beim Physiker Johann Baptist Wisgrill tätig, wurde 1842 Assistent bei dem Zahnarzt Georg Carabelli und übernahm später dessen Ordination.“"
                            },
                            {
                                "example_id": "9c6d2fa3-4081-44aa-8122-0330ffe0faee",
                                "sense_id": "e1a39a59-f05a-3f25-a39c-39b39bc4edab",
                                "text": "„Die Ordination sei außerdem gar nicht weit von ihrer Wiener Wohnung entfernt.“"
                            },
                            {
                                "example_id": "835f086c-0758-4dbc-bb0c-db987138d903",
                                "sense_id": "e1a39a59-f05a-3f25-a39c-39b39bc4edab",
                                "text": "„Sie arbeitete in der Nähe, in der Ordination enes gewissen Dr. Mason.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "2dd04047-eaeb-3457-adb6-67846835574a",
                        "entry_id": "8483941d-2a92-32fe-874f-56da1e5dbac3",
                        "glosses": [
                            "Sprechstunde eines Arztes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3867cc-7f54-45fb-b169-527815e215b7",
                                "sense_id": "2dd04047-eaeb-3457-adb6-67846835574a",
                                "text": "Während der Ordination assistiert die Schwester dem Arzt."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
