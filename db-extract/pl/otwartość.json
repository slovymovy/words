                "senses": [
                    {
                        "sense_id": "6619e383-5b25-3a5a-97c0-2a710461530b",
                        "entry_id": "d72a5645-2b6f-3e7c-94d8-862062651454",
                        "glosses": [
                            "cecha tego, co jest otwarte, skierowane do wszystkich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4437b24d-05c4-48ce-bd42-88e17940b9cf",
                                "sense_id": "6619e383-5b25-3a5a-97c0-2a710461530b",
                                "text": "Otwartość projektu związana jest również z tym, że jej oferta jest skierowana nie tylko do młodzieży, która została rekrutowana, ale i ich zainteresowanych kolegów, włączanych w tryb klubowego działania, i rodziców"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5ba7efb0-76d1-3a22-8368-19d69382eed6",
                        "entry_id": "d72a5645-2b6f-3e7c-94d8-862062651454",
                        "glosses": [
                            "cecha tego, kto jest otwarty: gotowy na przyjęcie nowych idei lub nieskrywający swoich uczuć lub myśli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f728de1-007f-49d0-a3b0-c2714ccc9217",
                                "sense_id": "5ba7efb0-76d1-3a22-8368-19d69382eed6",
                                "text": "Dlatego ważną, a zarazem trudną cechą doradcy jest autentyczna otwartość i chęć poznania, a nie zaklasyfikowania"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6eac714e-f2a2-379d-8993-c5d0b6660645",
                        "entry_id": "d72a5645-2b6f-3e7c-94d8-862062651454",
                        "glosses": [
                            "szczerość, bezpośredniość"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
