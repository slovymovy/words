                    {
                        "translation_id": "09755a15-9960-46c1-94d7-0e182bda3a7e",
                        "source_entry_id": "e20b8b29-dea3-393b-a3e7-f3039cd669df",
                        "source_sense_id": "2f3aaf9e-0f3b-3f43-8eb5-1ba4ff74e4b8",
                        "target_lang_word": "lithosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lithosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e850d68-039b-30b6-a63a-67c2b7a223c4",
                                        "entry_id": "a0306a94-c891-3550-bed6-a1e25c0bcb16",
                                        "glosses": [
                                            "Partie superficielle et solide du matériau dont sont faites les planètes telluriques comme la Terre ou Mars et qui constitue les plaques tectoniques."
                                        ],
                                        "tags": [
                                            "Géographie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df684d85-8401-44f9-8d5e-96e5a2368cc5",
                                                "sense_id": "4e850d68-039b-30b6-a63a-67c2b7a223c4",
                                                "text": "Une plaque peut être formée par une lithosphère à croûte océanique mais elle peut également comporter une partie lithosphérique à croûte continentale."
                                            },
                                            {
                                                "example_id": "5191387e-dbb7-4f8a-83f9-c6ef2b09041b",
                                                "sense_id": "4e850d68-039b-30b6-a63a-67c2b7a223c4",
                                                "text": "Les continents sont incorporés à la lithosphère comme des morceaux de bois sont pris dans la banquise."
                                            },
                                            {
                                                "example_id": "2ed80646-bc1d-4bf9-8fd2-bad4793280ba",
                                                "sense_id": "4e850d68-039b-30b6-a63a-67c2b7a223c4",
                                                "text": "Le sol est un milieu qui se trouve à la croisée de la biosphère, de l'atmosphère, de l'eau (hydrosphère) et des roches-mères sous-jacentes (lithosphère)."
                                            },
                                            {
                                                "example_id": "b3f950e7-c293-4783-9f0e-fca2d21078c5",
                                                "sense_id": "4e850d68-039b-30b6-a63a-67c2b7a223c4",
                                                "text": "C’est ainsi qu’en 1959, le sismologue allemand Beno Gutenberg a identifié la zone de moindre vitesse (low velocity zone ou LVZ, en anglais) qui marque la séparation entre la lithosphère et l’asthénosphère."
                                            },
                                            {
                                                "example_id": "12e682df-68bd-43a7-aa28-fd5de45d4ca6",
                                                "sense_id": "4e850d68-039b-30b6-a63a-67c2b7a223c4",
                                                "text": "Le système climatique est constitué de l’atmosphère (couche gazeuse enveloppant la Terre), la lithosphère (sol, croûte terrestre), l’hydrosphère (mers et océans, rivières, nappes et réservoirs profonds), la cryosphère (banquise, neige, glaciers continentaux, calottes polaires, lacs et rivières gelés, sols gelés ou pergélisol*) et la biosphère (organismes vivants)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
