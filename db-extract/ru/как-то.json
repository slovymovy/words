                        ],
                        "examples": [
                            {
                                "example_id": "506cf973-0c08-464e-b5da-6b62aa947398",
                                "sense_id": "b391c68a-6b03-3c14-a977-51d59667b513",
                                "text": "Мне ста́ло любопы́тно, ка́к-то он на э́тот раз вы́крутится?",
                                "translation": "I became curious, how will he get out this time?",
                                "english": "I became curious, how will he get out this time?"
                            }
                        ]
                    }
