                    }
                ],
                "senses": [
                    {
                        "sense_id": "392f0a2d-d5b1-3de7-8055-713f3683cf52",
                        "entry_id": "3e2d587b-35f8-36f3-9af4-3b17d0610500",
                        "glosses": [
                            "The delegation of a task to a large diffuse group in order to introduce new or more developed skill sets and improve efficiency. There is usually no substantial monetary compensation involved."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dfc31e8d-6307-4c97-8f31-4047cf7d22e8",
                                "sense_id": "392f0a2d-d5b1-3de7-8055-713f3683cf52",
                                "text": "P&G is one of InnoCentive’s earliest and best customers, but the company works with other crowdsourcing networks as well."
                            },
                            {
                                "example_id": "135268b5-3ca1-4a56-a7bd-8e7d488118c0",
                                "sense_id": "392f0a2d-d5b1-3de7-8055-713f3683cf52",
                                "text": "While not a new phenomenon, crowdsourcing is really growing as a business trend."
                            },
                            {
                                "example_id": "f1e7bfb0-6372-47db-9e10-0c112ad06cd4",
                                "sense_id": "392f0a2d-d5b1-3de7-8055-713f3683cf52",
                                "text": "Costs can be reduced by crowdsourcing more content."
                            }
                        ]
                    }
                ],
