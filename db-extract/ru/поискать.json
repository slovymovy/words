                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf7f6dbd-fe46-3da4-806a-b752d7abc589",
                        "entry_id": "56b5da01-4c3d-3b98-b6de-0262212daeff",
                        "glosses": [
                            "совершить действие, выраженное гл. искать; провести некоторое время, совершая такое действие"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e69e7e6f-beae-3c07-a952-ed38057f3b41",
                        "entry_id": "56b5da01-4c3d-3b98-b6de-0262212daeff",
                        "glosses": [
                            "устар., прост. наградить чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a5a8a58-3027-4268-a146-622c0887e830",
                        "source_entry_id": "56b5da01-4c3d-3b98-b6de-0262212daeff",
                        "target_lang_word": "search",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "search",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2838c1c2-d2e9-38c2-902c-ef616b361404",
                                        "entry_id": "066f3bb1-3430-32d8-b72e-4807d72c9eef",
                                        "glosses": [
                                            "An attempt to find something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11e24ea-aae2-45e5-8c3f-62c09a6ea5df",
                                                "sense_id": "2838c1c2-d2e9-38c2-902c-ef616b361404",
                                                "text": "With only five minutes until we were meant to leave, the search for the keys started in earnest."
                                            },
                                            {
                                                "example_id": "cb4982d1-1be0-4b12-9af8-5873d24c102c",
                                                "sense_id": "2838c1c2-d2e9-38c2-902c-ef616b361404",
                                                "text": "At least eight people died, and officials expressed deep concerns that the toll would rise as more searches of homes were carried out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0859c68a-aeb9-3343-bdcf-486c29c129e3",
                                        "entry_id": "066f3bb1-3430-32d8-b72e-4807d72c9eef",
                                        "glosses": [
                                            "The act of searching in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce708fa-77b7-4560-9e7f-2bcd6a4b0995",
                                                "sense_id": "0859c68a-aeb9-3343-bdcf-486c29c129e3",
                                                "text": "Search is a hard problem for computers to solve efficiently."
                                            },
                                            {
                                                "example_id": "9074042e-06d8-4698-bc87-0f952f864b78",
                                                "sense_id": "0859c68a-aeb9-3343-bdcf-486c29c129e3",
                                                "text": "Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet. Perhaps we assume that our name, address and search preferences will be viewed by some unseen pair of corporate eyes, probably not human, and don't mind that much."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "search",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87e476e1-cda1-3a13-aa33-e7d374c550a7",
                                        "entry_id": "d5503eca-c2d8-3a7d-85ea-d6749d0fe72b",
                                        "glosses": [
                                            "To look in (a place) for something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfdd44a2-d367-4ae4-adfb-bf305d91f511",
                                                "sense_id": "87e476e1-cda1-3a13-aa33-e7d374c550a7",
                                                "text": "I searched the garden for the keys and found them in the vegetable patch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd86412a-1cfc-36b1-a1ff-9acd8bed8db8",
                                        "entry_id": "d5503eca-c2d8-3a7d-85ea-d6749d0fe72b",
                                        "glosses": [
                                            "To look thoroughly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16946a77-2886-4225-94dd-6fe27355bbca",
                                                "sense_id": "cd86412a-1cfc-36b1-a1ff-9acd8bed8db8",
                                                "text": "The police are searching for evidence in his flat."
                                            },
                                            {
                                                "example_id": "22b8dde7-44d7-4761-9dde-72d4bcd8ab96",
                                                "sense_id": "cd86412a-1cfc-36b1-a1ff-9acd8bed8db8",
                                                "text": "It sufficeth that they have once with care and fairness sifted the matter as far as they could, and searched into all the particulars."
                                            },
                                            {
                                                "example_id": "75169566-c335-4ca3-86da-88a1c9505b26",
                                                "sense_id": "cd86412a-1cfc-36b1-a1ff-9acd8bed8db8",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance.[…]But she said she must go back, and when they joined the crowd again[…]she found her mother standing up before the seat on which she had sat all the evening searching anxiously for her with her eyes, and her father by her side."
                                            },
                                            {
                                                "example_id": "033f71f2-79bf-40d6-8db1-f29f2a6aecd8",
                                                "sense_id": "cd86412a-1cfc-36b1-a1ff-9acd8bed8db8",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21edcfb-1b3e-3f36-a32a-9e38947c2693",
                                        "entry_id": "d5503eca-c2d8-3a7d-85ea-d6749d0fe72b",
                                        "glosses": [
                                            "To look for, seek."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f5a6d5-e426-42a9-a8e8-315772be4292",
                                                "sense_id": "a21edcfb-1b3e-3f36-a32a-9e38947c2693",
                                                "text": "To search the God of loue, her Nymphes she sent / Throughout the wandring forrest euery where[…]."
                                            },
                                            {
                                                "example_id": "8722c357-e8a5-4e7a-bb16-0b5e952e876b",
                                                "sense_id": "a21edcfb-1b3e-3f36-a32a-9e38947c2693",
                                                "text": "For thus saith the Lord God; Behold, I, even I, will both search my sheep, and seek them out."
                                            },
                                            {
                                                "example_id": "223404cb-2b93-40e9-b7f4-3d91e626294e",
                                                "sense_id": "a21edcfb-1b3e-3f36-a32a-9e38947c2693",
                                                "text": "Anough is left besides to search and know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169ecd52-e3ed-3e2d-8216-410dd0ba0441",
                                        "entry_id": "d5503eca-c2d8-3a7d-85ea-d6749d0fe72b",
                                        "glosses": [
                                            "To put a phrase into a search engine, especially one besides Google."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4dd0fb-3c65-46b0-a3fc-f667a9d45718",
                                                "sense_id": "169ecd52-e3ed-3e2d-8216-410dd0ba0441",
                                                "text": "I searched \"Paris Hilton\" and found lots of unflattering stories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91db2e7-66da-3e8a-bd7b-689bd6d57872",
                                        "entry_id": "d5503eca-c2d8-3a7d-85ea-d6749d0fe72b",
                                        "glosses": [
                                            "To probe or examine (a wound)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089a4fbc-2bf2-4ae5-8910-00f037e712e5",
                                                "sense_id": "b91db2e7-66da-3e8a-bd7b-689bd6d57872",
                                                "text": "Now torne we to the xj kynges that retorned vnto a cyte that hyghte Sorhaute / the whiche cyte was within kynge Vryens / and ther they refresshed hem as wel as they myght / and made leches serche theyr woundys and sorowed gretely for the dethe of her peple"
                                            },
                                            {
                                                "example_id": "61e7c7d6-e147-4c76-bbd2-d9ee82e822b0",
                                                "sense_id": "b91db2e7-66da-3e8a-bd7b-689bd6d57872",
                                                "text": "Now to the bottome dost thou search my wound."
                                            },
                                            {
                                                "example_id": "91d435bb-960e-43ef-b2bf-a6cae9594051",
                                                "sense_id": "b91db2e7-66da-3e8a-bd7b-689bd6d57872",
                                                "text": "Thus when they all had sorowed their fill, / They softly gan to search his griesly wownd[…]."
                                            },
                                            {
                                                "example_id": "06716128-5602-4f7a-8ce4-c9c3abe39dd5",
                                                "sense_id": "b91db2e7-66da-3e8a-bd7b-689bd6d57872",
                                                "text": "His wife perceiving him to droope and languish away, entreated him she might leasurely search and neerely view the quality of his disease[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d148a62f-6bf5-3b7b-9aa5-5a4e973f6954",
                                        "entry_id": "d5503eca-c2d8-3a7d-85ea-d6749d0fe72b",
                                        "glosses": [
                                            "To examine; to try; to put to the test."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
