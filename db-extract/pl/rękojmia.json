                ],
                "translations": [
                    {
                        "translation_id": "0f4eace1-9c37-4ff0-831e-487f7a48f304",
                        "source_entry_id": "08e1b806-f06b-332d-955b-d30c2280b31b",
                        "source_sense_id": "a82e110c-0272-30b6-be22-a0b4adcba4d2",
                        "target_lang_word": "Bürgschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                        "entry_id": "d921a281-56f1-3e74-8c86-0a1feeace73f",
                                        "glosses": [
                                            "als akzessorische, persönliche Sicherheit für eine Forderung dienender einseitig verpflichtender Vertrag zwischen Gläubiger und Bürgen darüber, dass der Bürge sich gegenüber dem Gläubiger dazu verpflichtet, (subsidiär) für eine Verbindlichkeit des Schuldners einzustehen"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591232cb-1281-4ef0-b2b3-46aa8530c57f",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "Diese Forderung ist durch eine Bürgschaft gesichert."
                                            },
                                            {
                                                "example_id": "2579629e-b3e8-4c57-a05d-e0c2d0fab84f",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "„Die angeschlagene Reederei braucht dringend eine Bürgschaft - und die Bundesregierung will sie unbedingt gewähren, trotz Bedenken unter den Haushältern des Bundestags.“"
                                            },
                                            {
                                                "example_id": "5269fcbf-ae96-47d8-a7a9-4e90d59c4b33",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "Für den Kredit verlangte die Bank eine Bürgschaft."
                                            },
                                            {
                                                "example_id": "f850b9ef-632b-4623-8cac-bdebc4aa3d44",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "„Aber, wir wissen es aus dem BGB, dass eine Bürgschaft etwas Ehernes ist, das man bezahlen muss.“"
                                            },
                                            {
                                                "example_id": "0d0d86a6-8d9f-4c28-9fee-c9e9b30437a6",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "„In Grudshöfchen begann sie zu schreiben, und führte das auch fort, als die Familie Grudshöfchen wegen einer unvorsichtigen Bürgschaft verkaufen musste und ein neues Leben in Kukehnen begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                        "entry_id": "d921a281-56f1-3e74-8c86-0a1feeace73f",
                                        "glosses": [
                                            "Betrag, über den eine Bürgschaft^([1]) geleistet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b29667-2342-4663-a2b1-f213830aac9b",
                                                "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                                "text": "Ich musste für meine Schwester eine hohe Bürgschaft übernehmen."
                                            },
                                            {
                                                "example_id": "11bc9e33-a86c-48fb-bb62-110255fdad04",
                                                "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                                "text": "„An-tung konnte gegen Bürgschaft frei kommen.“"
                                            },
                                            {
                                                "example_id": "2a70d296-beac-4841-b2ad-8d03b7781d31",
                                                "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                                "text": "„Im Betrugsprozess gegen Donald Trump in New York hat der ehemalige US-Präsident eine Bürgschaft von 175 Millionen Dollar (etwa 160 Millionen Euro) hinterlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a2dc53d4-596a-3509-a941-5f3b3bf03c1d",
                                        "entry_id": "d921a281-56f1-3e74-8c86-0a1feeace73f",
                                        "glosses": [
                                            "Garantie, Gewähr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5034d6e9-2bf0-4881-aa52-2d8f28ae3897",
                                                "sense_id": "a2dc53d4-596a-3509-a941-5f3b3bf03c1d",
                                                "text": "Diese Ähren sind eine Bürgschaft für eine gute Ernte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a433909-cf5b-40d5-9421-cdcb043ee2fa",
                        "source_entry_id": "08e1b806-f06b-332d-955b-d30c2280b31b",
                        "source_sense_id": "21695ff6-e02d-3989-b07e-1744007515a5",
                        "target_lang_word": "Gewähr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewähr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34b6f7aa-11d4-3dfa-9126-c442bb477a0a",
                                        "entry_id": "113c4cec-9e10-3ed9-8818-7aa441e7a883",
                                        "glosses": [
                                            "Sicherheit, Bürgschaft, Garantie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68c4c83-7642-4132-a802-ce01179b2547",
                                                "sense_id": "34b6f7aa-11d4-3dfa-9126-c442bb477a0a",
                                                "text": "Es gab keine Gewähr, dass das Seil hält."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f29cc39a-7b14-4137-83ce-563d35183d89",
                        "source_entry_id": "08e1b806-f06b-332d-955b-d30c2280b31b",
                        "source_sense_id": "21695ff6-e02d-3989-b07e-1744007515a5",
                        "target_lang_word": "Zusicherung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                        "entry_id": "c6a9facb-bdaa-3a99-80f3-3bc4ef3d43e3",
                                        "glosses": [
                                            "verbindliches Versprechen; das Bekräftigen, Zusagen von etwas, das gilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b1ab37-74a3-48c6-a8c5-271222e9fcc1",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Die Zusicherung einer bestimmten Grundstücksgröße gilt als Zusicherung einer Eigenschaft.“"
                                            },
                                            {
                                                "example_id": "f0198812-497c-4435-a317-92f5fc7792cd",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Für eine Kraftmaschine ist besonders die Zusicherung wichtig, daß sie für eine bestimmte Drehzahl die garantierte Leistung dauernd (ohne Betriebsstörung) abzugeben imstande ist.“"
                                            },
                                            {
                                                "example_id": "cc41919d-4de4-4476-bc44-278022488411",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Lucia beruhigt die Patientin mit der Zusicherung, bis jener Tag eintreffe, werde zuvor reichlich viel Zeit vergehen.“"
                                            },
                                            {
                                                "example_id": "1266376c-3ea0-4a7d-8247-aba71a64cc62",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Im Verlauf dieses Verfahrens hat die Kommission von den Ausführern der fraglichen Waren befriedigende Zusicherungen erhalten, die es ihr ermöglichen von der Einführung von Schutzmaßnahmen abzusehen.“"
                                            },
                                            {
                                                "example_id": "a932cf13-1979-4bf4-bce1-b2deb544afe8",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Eine Nichterfüllung der Informationspflicht liegt auch bei Zusicherung des Verkäufers über eine Eigenschaft der Kaufsache vor, die tatsächlich nicht vorhanden ist.“"
                                            },
                                            {
                                                "example_id": "a2163136-dd40-4d0f-aac9-6bcfe2c834ed",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Eine Zusicherung liegt vor, wenn der Verpächter zu erkennen gibt, dass er für den Bestand der betreffenden Eigenschaft und die Folgen ihres Fehlens einstehen will […].“"
                                            },
                                            {
                                                "example_id": "31336045-202f-4bb1-adec-9de2a5f37984",
                                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                                "text": "„Waschanlagen sind austauschbar, die Zusicherung, ein sauberes Auto zu erhalten, allerdings nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5060173-6b25-4c73-b5c5-57327d79bb7f",
                        "source_entry_id": "08e1b806-f06b-332d-955b-d30c2280b31b",
                        "source_sense_id": "5ce827ac-a4a2-3dd7-bf56-669ad88d04d0",
                        "target_lang_word": "Gewährleistung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewährleistung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c18dc98e-04d6-357f-9b75-798a310c4c23",
                                        "entry_id": "528c09cc-d4c9-3423-9712-41345f920a3c",
                                        "glosses": [
                                            "Maßnahme zur Absicherung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6497b1ca-36b4-410d-9244-a8fdbeede271",
                                                "sense_id": "c18dc98e-04d6-357f-9b75-798a310c4c23",
                                                "text": "Die Gewährleistung der Sicherheit der Bevölkerung verursacht in Krisengebieten große Probleme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e4f9d68-1fd8-3853-8fd1-e135d60727c8",
                                        "entry_id": "528c09cc-d4c9-3423-9712-41345f920a3c",
                                        "glosses": [
                                            "verschuldensunabhängiges Einstehenmüssen seitens des Verkäufers für einen Mangel an einer verkauften Sache oder Dienstleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac093d3-7205-4343-aff1-132323293dce",
                                                "sense_id": "2e4f9d68-1fd8-3853-8fd1-e135d60727c8",
                                                "text": "Die gesetzliche Gewährleistung für Kraftfahrzeuge beträgt 2 Jahre."
                                            },
                                            {
                                                "example_id": "5c2482cf-e2bf-49c0-b374-0fde6273654b",
                                                "sense_id": "2e4f9d68-1fd8-3853-8fd1-e135d60727c8",
                                                "text": "Kaufleute sind von Rechts wegen grundsätzlich zur Gewährleistung verpflichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
