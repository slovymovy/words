                                        "entry_id": "50a9ea1e-337e-3b5a-b829-dbdc4a455c5a",
                                        "glosses": [
                                            "die Pflanzengattung der Atriplex (deutsch: Melden) in der Familie der Fuchsschwanzgewächse"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
