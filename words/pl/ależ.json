{
    "word_family": [
        "ale",
        "aż"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a252a507-ebee-35cc-884b-2cb9d7f7576e",
                    "sense_definition": "Wykrzyknik wyrażający protest, zaprzeczenie, oburzenie lub brak zgody wobec czyichś słów.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emocjonalne_wypowiedzi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ależ</w> skąd, wcale nie miałem zamiaru cię urazić tym komentarzem!",
                            "target_lang_translations": {
                                "ru": "<w>Да</w> что вы, я вовсе не собирался обидеть вас этим комментарием!"
                            }
                        },
                        {
                            "text": "<w>Ależ</w> nie ma za co dziękować, zrobiłem to z wielką przyjemnością.",
                            "target_lang_translations": {
                                "ru": "<w>Да</w> не за что благодарить, я сделал это с огромным удовольствием."
                            }
                        }
                    ],
                    "synonyms": [
                        "ale"
                    ],
                    "common_phrases": [
                        "ależ skąd",
                        "ależ nie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Междометие, выражающее протест, отрицание, возмущение или несогласие со сказанным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да что вы",
                                "target_lang_sense_clarification": "выражение протеста или возражения"
                            },
                            {
                                "target_lang_word": "да нет же",
                                "target_lang_sense_clarification": "эмоциональное отрицание"
                            },
                            {
                                "target_lang_word": "но",
                                "target_lang_sense_clarification": "в начале реплики-возражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6943a20d-dfd0-339a-b360-8a014db18826",
                    "sense_definition": "Wykrzyknik wyrażający silne zdumienie, podziw lub zaskoczenie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emocjonalne_wypowiedzi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ależ</w> ten widok z tarasu robi ogromne wrażenie na każdym turyście!",
                            "target_lang_translations": {
                                "ru": "<w>Ну и</w> сильное же впечатление производит на каждого туриста этот вид с террасы!"
                            }
                        },
                        {
                            "text": "<w>Ależ</w> ty szybko rośniesz, nie widzieliśmy się tylko rok!",
                            "target_lang_translations": {
                                "ru": "<w>Как же</w> быстро ты растёшь, мы ведь не виделись всего год!"
                            }
                        }
                    ],
                    "synonyms": [
                        "ale"
                    ],
                    "common_phrases": [
                        "ależ oczywiście"
                    ],
                    "target_lang_definitions": {
                        "ru": "Междометие, выражающее сильное удивление, восхищение или изумление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ну и",
                                "target_lang_sense_clarification": "выражение восхищения или изумления"
                            },
                            {
                                "target_lang_word": "как же",
                                "target_lang_sense_clarification": "усилительная частица удивления"
                            },
                            {
                                "target_lang_word": "до чего же",
                                "target_lang_sense_clarification": "выражение высокой степени признака"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "ae241f8f-b3f4-383b-a8f8-e33da3689ea0",
                    "sense_definition": "Spójnik wprowadzający zdanie podrzędne czasu oznaczające granicę czasową; dopóki, aż.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "granica_czasowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czekał cierpliwie przed zamkniętą bramą, <w>ależ</w> otworzono mu przejście na dziedziniec zamku.",
                            "target_lang_translations": {
                                "ru": "Он терпеливо ждал перед закрытыми воротами, <w>пока не</w> открыли ему проход во внутренний двор замка."
                            }
                        },
                        {
                            "text": "Nie przestawał biec przed siebie, <w>ależ</w> zabrakło mu sił w gęstym lesie.",
                            "target_lang_translations": {
                                "ru": "Он не переставал бежать вперёд, <w>до тех пор пока не</w> кончились у него силы в густом лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "aż",
                        "dopóki nie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaiczne użycie spójnika"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, вводящий придаточное предложение времени со значением временного предела; пока не, до тех пор пока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пока не",
                                "target_lang_sense_clarification": "до наступления момента"
                            },
                            {
                                "target_lang_word": "до тех пор пока",
                                "target_lang_sense_clarification": "временная граница действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4ae95d2-29cf-32f2-86b9-07add47c305d",
                    "sense_definition": "Spójnik wprowadzający warunek wykluczający; chyba że, jeśli nie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "warunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nikt nie wejdzie do tej starej komnaty, <w>ależ</w> sam król wyda taki rozkaz.",
                            "target_lang_translations": {
                                "ru": "Никто не войдёт в этот старый покой, <w>разве что</w> сам король отдаст такой приказ."
                            }
                        },
                        {
                            "text": "Nie podpiszemy tej niekorzystnej umowy handlowej, <w>ależ</w> zmienią się jej podstawowe warunki.",
                            "target_lang_translations": {
                                "ru": "Мы не подпишем этот невыгодный торговый договор, <w>если только не</w> изменятся его основные условия."
                            }
                        }
                    ],
                    "synonyms": [
                        "chyba że"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaiczne znaczenie warunkowe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, вводящий исключающее условие; разве что, если только не."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разве что",
                                "target_lang_sense_clarification": "исключающее условие"
                            },
                            {
                                "target_lang_word": "если только не",
                                "target_lang_sense_clarification": "условие исключения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}