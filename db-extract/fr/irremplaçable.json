                                "target_senses": [
                                    {
                                        "sense_id": "e7b6e60f-11bd-3aec-8d1c-4f976669626a",
                                        "entry_id": "1377ad26-d996-3593-91bb-9aa015e1bf31",
                                        "glosses": [
                                            "Incapable of being replaced, especially because of uniqueness or finiteness."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0880d7-4ee6-48b3-8c5d-1286d12d50a1",
                                                "sense_id": "e7b6e60f-11bd-3aec-8d1c-4f976669626a",
                                                "text": "For some purposes lead is unique and, apparently, irreplaceable. Battery plates may be an example of this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "210c411d-7139-4934-998a-58261ffa0d6b",
                        "source_entry_id": "8960d3c1-f2fc-3e5b-a2cb-ef04cb40f21f",
