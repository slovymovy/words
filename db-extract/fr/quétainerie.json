                        "entry_id": "0b1d6754-6838-310d-8fb8-a75efd59f8b8",
                        "glosses": [
                            "Objet ou coutume qui manque de raffinement, de mauvais goût, démodé, etc."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
