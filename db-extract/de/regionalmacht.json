                ],
                "senses": [
                    {
                        "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                        "entry_id": "c29da023-cea3-3446-ab27-68cb534cc9ac",
                        "glosses": [
                            "Staat, der gegenüber seinen Nachbarn eine Vormachtstellung einnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee4997a-9adc-43ad-8be7-1a38567516cb",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Etwa 10 Jahre später entsteht im Südosten des Kontinents aus der Verbindung einer Viehzüchter- mit einer Ackerbauern-Zivilisation das Reich von Groß-Simbabwe, dessen Aufstieg zur Regionalmacht durch die Ausbeutung lokaler Goldvorkommen begünstigt wird.“"
                            },
                            {
                                "example_id": "96d9f7a0-8ade-4bbb-a88d-71bf2bc2a69e",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "[Mohammed bin Sajid/Vereinigte Arabische Emirate:] „Unter seiner Führung entwickelte sich das Land in den vergangenen Jahren zu einer wichtigen Regionalmacht.“"
                            },
                            {
                                "example_id": "906952c6-9159-4efb-a917-62a423879f59",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Ungarns Premier will sein Land zu einer Regionalmacht und zu einem Gegenpol Brüssels in Mittel- und Südosteuropa ausbauen.“"
                            },
                            {
                                "example_id": "ce77b5f7-963b-4351-9325-81eb5929608b",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„An den Kaukasus grenzt jedoch noch die Regionalmacht Iran“ […]."
                            },
                            {
                                "example_id": "d904c8c1-a5f6-4001-89bc-027e503ff7d0",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "[Schlagzeile:] „Der Iran - Regionalmacht in Nahost“"
                            },
                            {
                                "example_id": "941fae67-2ffc-4a55-b545-7460a9512d7b",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Die Regionalmächte Türkei und Ägypten wollen ihre jüngst turbulenten Beziehungen hinter sich lassen,“ […]."
                            },
                            {
                                "example_id": "10994c06-bbbd-439c-ba7f-c8940735cbc0",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Die Europäer ihrerseits dürften auf absehbare Zeit über eine Regionalmacht ohne wirklichen militärischen Interventionswillen nicht hinauskommen.“"
                            },
                            {
                                "example_id": "c73af29f-fe12-4f7b-a1d8-52d877f649bc",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Chinas Aufstieg zur bedeutsamsten Regionalmacht betrachten die ASEAN-Staaten je nach Wetterlage mal als Chance und mal als Bedrohung.“"
                            },
                            {
                                "example_id": "cca7da5f-e19f-476e-9903-02a1dcab7df9",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Wer Afghanistan befrieden will, muss Pakistans Interessen einpreisen und auch die Regionalmacht Indien entsprechend zügeln.“"
                            },
                            {
                                "example_id": "b9a3dc8d-40ee-45e6-b2d4-d506fdc9f48a",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Deeskalation sieht anders aus: In der Krim-Krise verspottet US-Präsident Obama Russland - er nennt das größte Land der Welt eine Regionalmacht.“"
                            },
                            {
                                "example_id": "b20b252c-cd5f-41be-a5c2-93e8f677fa5f",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Russland ist eine Regionalmacht und will Supermacht spielen. Das macht Wladimir Putin so gefährlich.“"
                            },
                            {
                                "example_id": "d1cbc9b7-2461-4240-9858-a2183f638e6f",
                                "sense_id": "c2f29e59-cbf2-3f34-8695-276c94a8f8c9",
                                "text": "„Dass Barack Obama Russland eine Regionalmacht nannte, war nicht bloß Ausdruck von Spott, sondern auch eine realistische Einschätzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
