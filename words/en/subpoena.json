            "senses": [
                {
                    "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                    "sense_definition": "A formal legal document ordering someone to attend court as a witness or to provide evidence, subject to a penalty for failure to comply.",
