    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a4b6223f-7063-3a9b-bbaa-f838412a2865",
                "word": "jackrabbit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f81ce894-5aed-4242-81f0-516198e84fc2",
                        "entry_id": "a4b6223f-7063-3a9b-bbaa-f838412a2865",
                        "tags": [
                            "plural"
                        ],
                        "form": "jackrabbits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90c6ea93-f011-3a2b-9e9a-7fddeb271104",
                        "entry_id": "a4b6223f-7063-3a9b-bbaa-f838412a2865",
                        "glosses": [
                            "Any of several large North American hares of the genus Lepus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83a3b2e8-1075-4d47-9f32-2bb5ac7e2e21",
                        "source_entry_id": "a4b6223f-7063-3a9b-bbaa-f838412a2865",
                        "source_sense_id": "90c6ea93-f011-3a2b-9e9a-7fddeb271104",
                        "source_sense_description": "large rabbit",
                        "target_lang_word": "lièvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lièvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b217ee6c-7005-344b-8121-26bc2673d6d0",
                                        "entry_id": "fbcd745e-a273-3df4-8d46-51bbdf08fed9",
                                        "glosses": [
                                            "Quadrupède mammifère, à longues oreilles, de la famille des léporidés, qui a les pattes de derrière plus longues que celles de devant, ce qui le rend très rapide à la course."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d9c65f4-6dfd-44a5-adbd-63ac5d0d5f5e",
                                                "sense_id": "b217ee6c-7005-344b-8121-26bc2673d6d0",
                                                "text": "Les amateurs de la chasse prétendent que le lièvre est en proie à une agonie plus terrible pendant la poursuite des lévriers que lorsqu’il se débat entre leurs griffes."
                                            },
                                            {
                                                "example_id": "98d99a58-8229-4741-8307-1eb091a85a42",
                                                "sense_id": "b217ee6c-7005-344b-8121-26bc2673d6d0",
                                                "text": "Les lièvres de plaines ont les membres postérieurs très-longs, bien plus longs que les lièvres de montagne, or il est notoire que ces derniers sont moins vite forcés par les chiens que les lièvres des plaines."
                                            },
                                            {
                                                "example_id": "59cee787-9cbe-47b8-a07f-21cb53dc799b",
                                                "sense_id": "b217ee6c-7005-344b-8121-26bc2673d6d0",
                                                "text": "La carnassière, maintenant bien remplie, pesait à ses épaules le poids de deux forts lièvres."
                                            },
                                            {
                                                "example_id": "f8990608-085d-481b-9410-d8abc87addd4",
                                                "sense_id": "b217ee6c-7005-344b-8121-26bc2673d6d0",
                                                "text": "Plus loin, une vision rapide de chevaux lancés à toute vitesse, de selles rouges et de vêtements blancs envolés dans un nuage de poussière : des chasseurs à la poursuite de quelque gibier, lièvre ou gazelle probablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f00d51-0522-36af-a56d-e1485dbbff90",
                                        "entry_id": "fbcd745e-a273-3df4-8d46-51bbdf08fed9",
                                        "glosses": [
                                            "Quadrupède mammifère, à longues oreilles, de la famille des léporidés, qui a les pattes de derrière plus longues que celles de devant, ce qui le rend très rapide à la course.",
                                            "Variante de lièvre d’Europe."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4840f29-c503-3f77-93d1-e31d65249278",
                                        "entry_id": "fbcd745e-a273-3df4-8d46-51bbdf08fed9",
                                        "glosses": [
                                            "La chair de cet animal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c2c1bf-c14e-48d7-8cf8-b576e4383e15",
                                                "sense_id": "c4840f29-c503-3f77-93d1-e31d65249278",
                                                "text": "Pâté de lièvre."
                                            },
                                            {
                                                "example_id": "1ee70692-a5dd-4dbb-85ba-d2ca83b17360",
                                                "sense_id": "c4840f29-c503-3f77-93d1-e31d65249278",
                                                "text": "Civet de lièvre."
                                            },
                                            {
                                                "example_id": "d4a49967-6baa-488f-a27c-7b07320b3b23",
                                                "sense_id": "c4840f29-c503-3f77-93d1-e31d65249278",
                                                "text": "Un râble de lièvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f211942-4d5b-35b6-95ef-564532377838",
                                        "entry_id": "fbcd745e-a273-3df4-8d46-51bbdf08fed9",
                                        "glosses": [
                                            "Coureur chargé de donner un rythme soutenu lors d'une course de fond ou demi-fond, de manière à favoriser un ou plusieurs concurrents ou, plus généralement, coureur qui peut servir de cible pour motiver d’autres coureurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5684b429-62e3-449d-b88a-af77834b8268",
                                                "sense_id": "0f211942-4d5b-35b6-95ef-564532377838",
                                                "text": "Cette année encore, Dorian Louvet aura un lièvre de luxe : Jimmy Gressier, néorecordman d’Europe du 5 km sur route."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b46d176-1559-365e-bb8f-f27d58248d39",
                                        "entry_id": "fbcd745e-a273-3df4-8d46-51bbdf08fed9",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il est normalement représenté comme le lapin, mais il est plutôt utilisé sous sa forme courante ou en forme. À rapprocher de bièvre, castor, connil, écureuil et lapin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193c699d-b4b9-4dea-8286-8475a5f19b05",
                                                "sense_id": "1b46d176-1559-365e-bb8f-f27d58248d39",
                                                "text": "Écartelé : au premier et au quatrième de gueules plain, au deuxième d’argent à la branche de cornouiller tigée et feuillée de sinople, fruitée de gueules, en bande, au troisième d’argent au brin de sarriette de sinople fleuri de gueules en bande ; sur le tout de sinople au lièvre en forme d’argent, qui est de Cunelières → voir illustration « armoiries avec un lièvre »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "facd35a7-dcd3-42ca-9576-220156eab78d",
                        "source_entry_id": "a4b6223f-7063-3a9b-bbaa-f838412a2865",
                        "source_sense_id": "90c6ea93-f011-3a2b-9e9a-7fddeb271104",
                        "source_sense_description": "large rabbit",
                        "target_lang_word": "за́яц",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "за́яц",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98efc37a-b4d7-3a02-8883-4a5fecb0364f",
                                        "entry_id": "a6b449ee-c704-31ed-8567-2cc101a3a92d",
                                        "glosses": [
                                            "зоол. пушистое длинноухое растительноядное млекопитающее из отряда зайцеобразных (Lepus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e821bdc6-b541-4bfc-a8b0-6487b7140e70",
                                                "sense_id": "98efc37a-b4d7-3a02-8883-4a5fecb0364f",
                                                "text": "Это значит, что зайцы встали с лёжки и начали ходить."
                                            },
                                            {
                                                "example_id": "7125882e-19b7-45a8-ae04-22f84b86c02b",
                                                "sense_id": "98efc37a-b4d7-3a02-8883-4a5fecb0364f",
                                                "text": "Зато у зайца глаза расположены так, что он замечает почти всё, что творится вокруг."
                                            },
                                            {
                                                "example_id": "5f282c0f-cfb9-4e80-b04d-d2f2a3216621",
                                                "sense_id": "98efc37a-b4d7-3a02-8883-4a5fecb0364f",
                                                "text": "В ту же минуту большой, серый заяц вскочил перед нами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25df1178-dbbd-3145-9077-c389caa0ac5b",
                                        "entry_id": "a6b449ee-c704-31ed-8567-2cc101a3a92d",
                                        "glosses": [
                                            "кулин. мясо этого животного, употребляемое в пищу; также блюдо из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73b37ab-ebdc-4400-bf5c-9a4b68649f85",
                                                "sense_id": "25df1178-dbbd-3145-9077-c389caa0ac5b",
                                                "text": "В жаровочном шкафу у него томились рагу из зайца и курник."
                                            },
                                            {
                                                "example_id": "6a7f217b-8b56-4502-8f5b-1bbee94cb084",
                                                "sense_id": "25df1178-dbbd-3145-9077-c389caa0ac5b",
                                                "text": "Подготовленного зайца залить пивом и выдержать 2 дня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64cd2c58-3395-3700-9b94-704ed98b4bd1",
                                        "entry_id": "a6b449ee-c704-31ed-8567-2cc101a3a92d",
                                        "glosses": [
                                            "мех этого животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "917b3396-1bee-4168-9213-c49feab1818f",
                                                "sense_id": "64cd2c58-3395-3700-9b94-704ed98b4bd1",
                                                "text": "Я вошёл через крылечко в сени, толкнулся направо: низенькая дверь завизжала на ржавых петлях, и я увидел перед собою толстую старушку в коричневой, зайцем подбитой кацавейке и пёстром платочке на голове."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c629c708-d67a-3265-aed6-65d2f3f31c76",
                                        "entry_id": "a6b449ee-c704-31ed-8567-2cc101a3a92d",
                                        "glosses": [
                                            "перен., разг. безбилетный пассажир общественного транспорта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5642f4c7-ea2d-4444-9c7c-eaf268cb4e36",
                                                "sense_id": "c629c708-d67a-3265-aed6-65d2f3f31c76",
                                                "text": "На железных дорогах зайцами называются гг. пассажиры, затрудняющие разменом денег не кассиров, а кондукторов. Хорошо, читатель, ездить зайцем! Зайцам полагается, по нигде ещё не напечатанному тарифу, 75 % уступки, им не нужно толпиться около кассы, вынимать ежеминутно из кармана билет, с ними кондуктора вежливее и… всё что хотите, одним словом!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
