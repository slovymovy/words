                "entry_id": "12ae215f-4696-38fd-b9dc-0a4949515f93",
                "word": "misluck",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7967eb37-734f-37e6-846a-0cfeec3bcd8e",
                        "entry_id": "12ae215f-4696-38fd-b9dc-0a4949515f93",
                        "glosses": [
                            "Ill luck; misfortune."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e3c47fc2-3bca-4d64-b617-b91a3ded8501",
                                "sense_id": "7967eb37-734f-37e6-846a-0cfeec3bcd8e",
                                "text": "[...] misluck would have it, however, that this emperor reigned no longer than half a year."
                            },
                            {
                                "example_id": "054bc4d0-19d4-4dfd-9f19-a598fbb503a1",
                                "sense_id": "7967eb37-734f-37e6-846a-0cfeec3bcd8e",
                                "text": "If Good- for-little had been buried, it had been my Tommy, Who by misluck was placed to drive in."
                            },
                            {
                                "example_id": "7cdb6150-ba0b-47b9-b151-66edb1400db9",
                                "sense_id": "7967eb37-734f-37e6-846a-0cfeec3bcd8e",
                                "text": "Your belief is true and justified, but not knowledge. In this case you're unlucky enough to be driving through a neighborhood beset by deceptive appearances, but this misluck is corrected by your just."
                            }
                        ]
                    }
                ],
