                    },
                    {
                        "translation_id": "c193f3fc-121e-4413-9e01-6117d7a72478",
                        "source_entry_id": "afcff9eb-9620-3c4c-a0f5-6af7319191b8",
                        "source_sense_id": "73401e43-9ab6-3dd9-89c2-17f70b0addf2",
                        "target_lang_word": "térébinthe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "térébinthe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                        "entry_id": "431a7357-c0dc-3db1-b16a-f44e7127f549",
                                        "glosses": [
                                            "Arbuste résineux au bois dur, à feuilles imparipennées caduques, à petites fleurs en grappes serrées, dont les petits fruits sont blancs, puis roses, rouges et enfin bruns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9728645c-f522-4ddf-a13c-45ad250d7370",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "On fait au tronc et aux grosses branches du térébinthe des incisions d’où coule une résine appelée térébenthine."
                                            },
                                            {
                                                "example_id": "5e23aba2-7bfa-4700-9a20-e91a257d2aca",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "Le térébinthe présente souvent des galles en forme de corne dues surtout à des pucerons et qui ont servi à faire une teinture rouge."
                                            },
                                            {
                                                "example_id": "c8ce81a0-38b9-40a0-aed3-366d3544495b",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "Dans chaque maison, il trouva le même spectacle de cadavres, de grimaces, de chairs bleues, de déjections laiteuses et cette odeur abominable, sucrée et putride, semblable à l’odeur des calices de térébinthes mangeurs de mouches."
                                            },
                                            {
                                                "example_id": "3feff3e7-dce4-426b-b99c-dec29f4fbb4c",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "Autour de moi sont les ébènes aux troncs lisses, les térébinthes, les colophanes, les figuiers sauvages, les sycomores."
                                            },
                                            {
                                                "example_id": "af95b99d-a820-493c-bd66-11f757c320a1",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "Le soir, seul avec elle, il passait son temps à dresser la liste des plantes indigènes de l’Éden, térébinthe et grenade, hysope et coriandre."
                                            },
                                            {
                                                "example_id": "f59d7d9b-8e20-4c9a-80c6-d6e71f93c238",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "Alors qu’aucun bruit ne s’élevait encore des places ou des rues, déjà, sur les chemins qui serpentaient vers les remparts, arrivaient les chameliers de Damas, les femmes portant sur leurs têtes des panières de raisins, au bras des roses de Jéricho qu’elles allaient vendre, sous les térébinthes, aux portes de la ville. Tout convergeait déjà vers Jérusalem."
                                            },
                                            {
                                                "example_id": "4b624ffd-6075-411b-9ee4-0ae6587e8463",
                                                "sense_id": "6629da34-18fe-3018-bf95-12cf5fc415b7",
                                                "text": "Parce que j’ai dressé, sous le noir térébinthe,\nL’image de baal, une escarboucle au front."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
