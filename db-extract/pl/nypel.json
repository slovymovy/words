                                    },
                                    {
                                        "sense_id": "a6d9be70-4aef-36df-9ead-92fa17f66dcd",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "Any small physical protrusion, such as the lumps on the F and J keys on computer keyboards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a4ccd35-c229-357a-a87b-24a35af13771",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "Any small physical protrusion on an automotive, a machine part or any other part that fits into a groove on another part."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "243ac29c-e184-3a75-89d0-e6af740bc323",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "A perforated segment that fits into part of the breech of a muzzle-loading gun, on which the percussion cap is fixed."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57bb070e-4702-475a-a7d6-e084fb8ad4ab",
                                                "sense_id": "243ac29c-e184-3a75-89d0-e6af740bc323",
                                                "text": "I could tell he didn't agree but he went to the corner and took up his squirrel gun, feeling the nipple for a percussion cap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1813951-7216-3b46-acbe-175daeac1a7c",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "A short tube threaded at both ends, used as a connector."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21a83dd0-262c-3c3d-87c4-e70da05dcad7",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "An internally threaded piece which holds a bicycle spoke in place on the rim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb86f141-5d79-43cf-aad1-7b79903a723c",
                                                "sense_id": "21a83dd0-262c-3c3d-87c4-e70da05dcad7",
                                                "text": "Turn the nipples on to the bicycle spokes only one turn, for each spoke on the new wheel all the way around until they are all snug, then check alignment."
                                            },
                                            {
                                                "example_id": "44f87516-f129-4fa9-a5b7-2a0f7ea682d6",
                                                "sense_id": "21a83dd0-262c-3c3d-87c4-e70da05dcad7",
                                                "text": "These were first constructed by heading the spokes, threading them through a steel felloe or rim and inserting them into screwed nipples which were in their turn screwed into the flanges of the hub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ae789d-5d38-399a-96f9-7aa223565730",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "A pointing stick."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
