        "fr-extract.jsonl": [
            {
                "entry_id": "9a6dc7ae-407c-39b8-a1e7-7d9507d04298",
                "word": "distraitement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                        "entry_id": "9a6dc7ae-407c-39b8-a1e7-7d9507d04298",
                        "glosses": [
                            "D’une manière distraite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "025c5b97-6162-4562-abce-53980bbcedf6",
                                "sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                                "text": "Le garde lui dit quelque chose à l’oreille, d’un air qui n'est pas effrayant ; elle regarde sa serpe qu’elle balance distraitement entre ses doigts ; l’affaire peut s’arranger."
                            },
                            {
                                "example_id": "12771111-cb9a-49c3-8f38-64f1947d8c6e",
                                "sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                                "text": "Le volume entr'ouvert distraitement, il le savait, et il gardait dans sa mémoire une photographie ineffaçable d’une ville ou d’un site traversés au galop."
                            },
                            {
                                "example_id": "64e35cf9-20e1-41d7-a7d3-093ac8bf273c",
                                "sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                                "text": "Quoique sa tête fût inclinée, elle regardait fixement et distraitement devant elle."
                            },
                            {
                                "example_id": "8b910484-075e-4c37-9264-8e67567c7eed",
                                "sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                                "text": "Pendant un long moment, Nazira regarda distraitement les bijoux que lui désignait sa mère. Ces breloques, ces bracelets, ces pendentifs, la laissait froide."
                            },
                            {
                                "example_id": "3b6b6330-81f3-45e5-b27a-accee9a64d5b",
                                "sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                                "text": "Elle regardait distraitement la femme à ses côtés et se demandait si elle était réellement compatissante ou si elle lui jouait la comédie, car pour l'instant, il n'y avait aucun moyen de le savoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2712b0f7-51ff-46e9-8d23-c8ce19b1e5ba",
                        "source_entry_id": "9a6dc7ae-407c-39b8-a1e7-7d9507d04298",
                        "source_sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                        "target_lang_word": "absent-mindedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absent-mindedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2478ead4-7b35-3f03-9fd4-30d489f046f8",
                                        "entry_id": "1d62d5e8-ce20-3940-87e0-9c47598684b7",
                                        "glosses": [
                                            "Preoccupiedly; in an absent-minded manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9768fc4c-fb89-4124-93ff-d53e20342abc",
                                                "sense_id": "2478ead4-7b35-3f03-9fd4-30d489f046f8",
                                                "text": "Professor Archimedes Q. Porter, his hands clasped beneath the tails of his long coat, paces back and forth under the ever-watchful eye of his faithful secretary, Mr. Samuel T. Philander. Twice within the past few minutes he has started absent-mindedly across the tracks in the direction of a near-by swamp, only to be rescued and dragged back by the tireless Mr. Philander."
                                            },
                                            {
                                                "example_id": "142f558e-c59f-4ad9-a284-94831609e272",
                                                "sense_id": "2478ead4-7b35-3f03-9fd4-30d489f046f8",
                                                "text": "On the same highway, I once absent-mindedly cut in front of this enormous jacked-up pickup truck."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bda128f-60b3-43ae-9424-feaa8a8e2fb5",
                        "source_entry_id": "9a6dc7ae-407c-39b8-a1e7-7d9507d04298",
                        "source_sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                        "target_lang_word": "absently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa70743-315c-3209-bbd7-79af860ddf82",
                                        "entry_id": "52bbcebb-c568-3a2e-aed2-3308bede0735",
                                        "glosses": [
                                            "In an absent-minded or abstracted manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44107c56-d35c-4f35-b22c-3ebea451d4e3",
                                                "sense_id": "6aa70743-315c-3209-bbd7-79af860ddf82",
                                                "text": "When he is in company he will sit absently muttering over a heap of Arabick, or in a Ciceronian attitude, declaim with all the vehemency of eloquence […]"
                                            },
                                            {
                                                "example_id": "9ddea733-ac8e-41ca-a571-20ee262c8062",
                                                "sense_id": "6aa70743-315c-3209-bbd7-79af860ddf82",
                                                "text": "1891, Thomas Hardy, Tess of the d’Urbervilles, Phase the Fourth, Chapter 34,\n[…] his wife, flinging a shawl round her, had come to the outer room and was listening to the man's narrative, her eyes resting absently on the luggage and the drops of rain glistening upon it."
                                            },
                                            {
                                                "example_id": "055e72d0-c192-443f-8c10-4d2e08ebfda0",
                                                "sense_id": "6aa70743-315c-3209-bbd7-79af860ddf82",
                                                "text": "Absently, he picked a dew-wet leaf from the hibiscus shrub, crushed it in his palm, put it in his mouth and came towards her, chewing."
                                            },
                                            {
                                                "example_id": "90157bfe-50ed-4761-bcd3-3b6f2953e44e",
                                                "sense_id": "6aa70743-315c-3209-bbd7-79af860ddf82",
                                                "text": "The ordeal is a world away from Kira now as she plays games on her new iPad while absently talking about downloading more apps to play music, and voicing her excitement over reuniting soon with her grandfather’s girlfriend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "599f46d2-275f-442e-84b2-55e3c1adfa06",
                        "source_entry_id": "9a6dc7ae-407c-39b8-a1e7-7d9507d04298",
                        "source_sense_id": "0c863eb4-62f5-35be-8ba7-1ccec6e68e1a",
                        "target_lang_word": "abstractedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstractedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5796454b-0500-39f3-95c8-26dc1d74b63f",
                                        "entry_id": "5bf29f1f-d9ce-39d2-8e52-ac19a788cfa1",
                                        "glosses": [
                                            "In an abstracted manner; separately; in the abstract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7176ba70-9f6f-48e6-81d4-079fac7f4cd3",
                                                "sense_id": "5796454b-0500-39f3-95c8-26dc1d74b63f",
                                                "text": "Doubtlesse, in the Idaea, or mentall shape before it come as it were into act, by beeing painted, cut, or carued, those terminating, and truly Mathematical lines, abstractedly considered, are manifest, adhering (or inhering rather) without any possibility of separation from the conceaued Image."
                                            },
                                            {
                                                "example_id": "7c9013fd-c18e-4609-9786-b3a9b28180f2",
                                                "sense_id": "5796454b-0500-39f3-95c8-26dc1d74b63f",
                                                "text": "[I]t is abundant ſatisfaction to them if they ſee their children do vvell; their chief delight and contentment is in their childrens good abſolutely and abſtractedly, vvithout indirect regards to their ovvn advantage."
                                            },
                                            {
                                                "example_id": "32336bf1-bbea-4a83-9fb7-27f5a0028d68",
                                                "sense_id": "5796454b-0500-39f3-95c8-26dc1d74b63f",
                                                "text": "Qu[estion] 8. VVhether the Notions of abſolute Time, abſolute Place, and abſolute Motion be not moſt abſtractedly Metaphyſical? VVhether it be poſſible for us to meaſure, compute, or knovv them?"
                                            },
                                            {
                                                "example_id": "8cbb35e1-c639-4bb7-bfb0-e9c04988647b",
                                                "sense_id": "5796454b-0500-39f3-95c8-26dc1d74b63f",
                                                "text": "You remember the gentleman in “The Spectator,” who had a commission of lunacy taken out against him for his extreme singularity, such as never wearing a wig, but a night-cap. Now, Sir, abstractedly, the night-cap was best; but, relatively, the advantage was overbalanced by his making the boys run after him."
                                            },
                                            {
                                                "example_id": "2531834d-35a0-4115-9152-db6dd6515fb0",
                                                "sense_id": "5796454b-0500-39f3-95c8-26dc1d74b63f",
                                                "text": "[…] as the head of a beast is to be placed only upon its shoulders, so neither is a plant, however abstractedly treated, to be placed root uppermost […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                        "entry_id": "5bf29f1f-d9ce-39d2-8e52-ac19a788cfa1",
                                        "glosses": [
                                            "With absence of mind ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a5a7fe-d067-4a23-a756-1e107a622f37",
                                                "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                                "text": "Leaning abstractedly over a hogshead of tallow, her dark dishevelled tresses waved in opposite directions, and a Muse (as she was) appeared to vulgar eyes, a Fury!"
                                            },
                                            {
                                                "example_id": "48eac9bb-6255-4c14-b2c2-73511b490935",
                                                "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                                "text": "He is a man of the meditative claſs:—he walks the ſtreets abſtractedly:—as he goes he digeſts enterpriſes, fraught with world-wide benefits."
                                            },
                                            {
                                                "example_id": "5982d76a-cb79-4654-b536-0e1d8f674cb8",
                                                "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                                "text": "The farmer had never turned his head once, but with eyes fixed on the most advanced point along the road, passed as unconsciously and abstractedly as if Bathsheba and her charms were thin air."
                                            },
                                            {
                                                "example_id": "9a9a0679-dbb6-4dcb-9acf-0f36c9248dee",
                                                "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                                "text": "He rose from his knees, and walked slowly across to the mantelpiece, where he stood abstractedly fingering the ornaments, and straightening them—a trick of his when he was agitated."
                                            },
                                            {
                                                "example_id": "315b4307-ddf4-4632-803b-491840f55b13",
                                                "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                                "text": "In Montreal, George Stephen was also thinking about money while he walked in sober mood from the Bank to the Canadian Pacific offices; one of the best-known figures in the city […] his passage along St. James Street was noted by many, and he nodded abstractedly to innumerable acquaintances."
                                            },
                                            {
                                                "example_id": "80740e38-a66e-46d8-afc6-364938529111",
                                                "sense_id": "0e97c2b9-0008-3f35-9dd1-47d83b80403f",
                                                "text": "She looked up over the page, ran her eye abstractedly across the room, but gave no sign at all of seeing him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0440cc4b-95fd-48a3-9e1b-ae1302a2a903",
                        "source_entry_id": "9a6dc7ae-407c-39b8-a1e7-7d9507d04298",
