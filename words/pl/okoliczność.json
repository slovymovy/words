                    "semantic_group_id": "przestrzeń",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach cała ta <w>okoliczność</w> porośnięta była gęstym lasem dębowym.",
                            "target_lang_translations": {
                                "ru": "В былые времена вся эта <w>окрестность</w> поросла густым дубовым лесом."
                            }
