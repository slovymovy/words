                        "source_sense_description": "een verwarmingsinstallatie die via mechanische arbeid warmte onttrekt aan een koude omgeving en deze toevoert aan een warmere omgeving",
                        "target_lang_word": "pompe à chaleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
