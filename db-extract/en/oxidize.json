                "translations": [
                    {
                        "translation_id": "a14cd4b6-f744-44e5-9f6c-1b53d1c9422e",
                        "source_entry_id": "3a4ae7aa-265f-33e7-8a78-887eb11265eb",
                        "source_sense_description": "to combine with oxygen",
                        "target_lang_word": "oxidovat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oxidovat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "74c8f953-16d9-37fa-a258-cfe746521867",
                                        "entry_id": "a8790d4d-b6e8-32b8-acf7-f6ab83f60a90",
                                        "glosses": [
                                            "slučovat se s kyslíkem / ztrácet elektrony"
                                        ],
                                        "tags": [
                                            "odborně"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d211f7c6-efea-3df7-b940-d2435b0f479a",
                                        "entry_id": "a8790d4d-b6e8-32b8-acf7-f6ab83f60a90",
                                        "glosses": [
                                            "být někde, přičemž se to mluvčímu nelíbí; obtěžovat někoho svou přítomností"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2abebb1f-0113-41ec-befa-a6b7c2f41565",
                                                "sense_id": "d211f7c6-efea-3df7-b940-d2435b0f479a",
                                                "text": "Hostinská věděla, že když toho norka pustí do hospody, tak tam bude zas jenom oxidovat a nic z toho."
                                            },
                                            {
                                                "example_id": "c2b87edf-ecc9-4a9a-b219-20af695a9ca4",
                                                "sense_id": "d211f7c6-efea-3df7-b940-d2435b0f479a",
                                                "text": "Jenom tady oxiduje!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ecef4de-5717-4fb6-8490-236d8e740ad7",
                        "source_entry_id": "3a4ae7aa-265f-33e7-8a78-887eb11265eb",
                        "source_sense_description": "to combine with oxygen",
                        "target_lang_word": "oxyder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oxyder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5459aeb-b936-3c9f-a7ba-44f79fcb8f69",
                                        "entry_id": "993a5943-8a67-378c-a874-d1b7ea7ccf57",
                                        "glosses": [
                                            "Appliquer une oxydation. C’est à dire arracher au moins un électron à un composé ou une espèce chimique considérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9bbd68f-9279-4d9f-a220-67aedd2a56e4",
                                                "sense_id": "d5459aeb-b936-3c9f-a7ba-44f79fcb8f69",
                                                "text": "Alors que, dans les mitochondries, la respiration réduit l’oxygène en eau, dans le chloroplaste, la photosynthèse oxyde l’eau et produit de l’oxygène."
                                            },
                                            {
                                                "example_id": "05835382-b321-4379-8bb5-33a5844a6cc2",
                                                "sense_id": "d5459aeb-b936-3c9f-a7ba-44f79fcb8f69",
                                                "text": "En 1890, [ Sergueï Winogradsky ] a isolé les deux bactéries nitrifiantes les plus importantes dans le sol : Nitrosomonas, qui oxyde l’ion ammonium en nitrite et Nitrobacter, qui oxyde le nitrite en nitrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f39336d-b5ac-3ce5-8a9d-887b3653e1a6",
                                        "entry_id": "993a5943-8a67-378c-a874-d1b7ea7ccf57",
                                        "glosses": [
                                            "Transformer un corps simple ou composé, par combinaison avec l’oxygène."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58945c4-19c5-48c0-ad17-8a2dcfabbe26",
                                                "sense_id": "1f39336d-b5ac-3ce5-8a9d-887b3653e1a6",
                                                "text": "L'acide nitrique concentré et chaud oxyde la soie avec formation d'acide oxalique et d'une petite quantité d'acide picrique."
                                            },
                                            {
                                                "example_id": "d7b6ce56-7bf3-4fe5-8b5a-b25b03f20bf1",
                                                "sense_id": "1f39336d-b5ac-3ce5-8a9d-887b3653e1a6",
                                                "text": "On souffle rapidement, la charge ne projette pas et on peut accélérer l’affinage; la disparition du silicium et du carbone prend 5'30”, la déphosphoration est très rapide à cause de l'allure froide et de l’excès de chaux ; on sursouffle quelques secondes pour oxyder le bain ; tout cela dure 1’45 ’’, soit 7’15’’ jusqu'au rabattement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "730b6d56-85d2-3f13-9770-318a65347cad",
                                        "entry_id": "993a5943-8a67-378c-a874-d1b7ea7ccf57",
                                        "glosses": [
                                            "Être transformé en oxyde ou subir une oxydation."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f1f52a7-7292-431b-8103-840eb30f119c",
                                                "sense_id": "730b6d56-85d2-3f13-9770-318a65347cad",
                                                "text": "Et à deux lieues, dans les hangars de la douane de Mazagan, les matériaux d'un pont en fer, dont la construction avait été décidée il y a une cinquantaine d'années par Sidi Mohammed, s’oxydent et s’écaillent."
                                            },
                                            {
                                                "example_id": "d9232f62-d0a0-473c-adad-ac6b3eacea98",
                                                "sense_id": "730b6d56-85d2-3f13-9770-318a65347cad",
                                                "text": "Les graisses qui s’oxydent le plus dans les viandes sont les phospholipides composant les membranes cellulaires : ces molécules comportent des « insaturations », c’est-à-dire des parties où les atomes de carbone du squelette moléculaire sont liés par des doubles liaisons. Ces insaturations déterminent leur oxydabilité, laquelle augmente, pour les tissus animaux, de l’agneau au poisson, en passant, dans cet ordre, par le bœuf, le porc, les volailles."
                                            },
                                            {
                                                "example_id": "aa34f67e-7620-4865-87c5-fde0d6de34f9",
                                                "sense_id": "730b6d56-85d2-3f13-9770-318a65347cad",
                                                "text": "La constitution d’oxydes en surface est un phénomène courant. Les métaux nobles tels que le platine et l’or sont de rares exemples de métaux qui ne s’oxydent pratiquement jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9f3f0a-4f4f-34dd-8b54-6d3043af8efe",
                                        "entry_id": "993a5943-8a67-378c-a874-d1b7ea7ccf57",
                                        "glosses": [
                                            "Se dégrader lentement sans rémission."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfc3daa5-dead-4ed4-ba67-0c467ab5d0f9",
                                                "sense_id": "6a9f3f0a-4f4f-34dd-8b54-6d3043af8efe",
                                                "text": "Bonmariage menait une vie de statue. Défait une fois pour toutes, rien ne le ravageait; tout au plus, le temps l'oxydait. Mort à la naissance, il méconnaissait la peur du danger et les promesses du frisson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
