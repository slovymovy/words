            {
                "entry_id": "25897c2c-19b7-398d-9fb1-4c9295b615c2",
                "word": "whitey",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2e7b85bc-6fb9-463f-b0fc-b4ae9ff80ed9",
                        "entry_id": "25897c2c-19b7-398d-9fb1-4c9295b615c2",
                        "tags": [
                            "plural"
                        ],
                        "form": "whiteys"
                    },
                    {
                        "form_id": "24fa4cfa-9028-486f-a82c-4acbef18bf7c",
                        "entry_id": "25897c2c-19b7-398d-9fb1-4c9295b615c2",
                        "tags": [
                            "plural"
                        ],
                        "form": "whities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b227183-f942-3a64-bbb7-f3fb2785495a",
                        "entry_id": "25897c2c-19b7-398d-9fb1-4c9295b615c2",
                        "glosses": [
                            "A white person, a person of Western European descent."
                        ],
                        "tags": [
                            "derogatory",
                            "ethnic",
                            "offensive",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a9c2fe-de39-41c2-95e0-92264da7df36",
                                "sense_id": "6b227183-f942-3a64-bbb7-f3fb2785495a",
                                "text": "Touché, honky. So, whitey, what did you do today? Oppress a new land and make the people there Christians against their will?"
                            },
                            {
                                "example_id": "c0088bbe-f704-40dd-a306-c948bc5c20cf",
                                "sense_id": "6b227183-f942-3a64-bbb7-f3fb2785495a",
                                "text": "I can't pay no doctor bills / But whitey’s on the moon / Ten years from now I'll be payin' still / While whitey’s on the moon"
                            },
                            {
                                "example_id": "58717580-3d2f-4087-9300-f84f22cd74e4",
                                "sense_id": "6b227183-f942-3a64-bbb7-f3fb2785495a",
                                "text": "She's a whitey in jeans / She's an outlaw"
                            },
                            {
                                "example_id": "18704b11-e8f6-4cf1-80bb-e16b83e0a732",
                                "sense_id": "6b227183-f942-3a64-bbb7-f3fb2785495a",
                                "text": "\"Whites don't like us because they think we're niggies. And blacks don't like us because they think we're whiteys. We don't fit anywhere. That's why we've gone off alone, created a totally separate thing.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "449aaaff-d7aa-3a0c-b834-4d2300b977b7",
                        "entry_id": "25897c2c-19b7-398d-9fb1-4c9295b615c2",
                        "glosses": [
                            "A state or bout of sickness, especially induced by cannabis use."
                        ],
                        "tags": [
                            "British",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "04c2a42a-17a2-4512-a14e-88de34e38fc9",
                                "sense_id": "449aaaff-d7aa-3a0c-b834-4d2300b977b7",
                                "text": "(Drug users consuming this much alcohol are either slumpped in the corner having a whitey or already on their way to casualty in an ambulance.)"
                            },
                            {
                                "example_id": "3fc96d44-7baa-41fb-af3a-1eb4e9254756",
                                "sense_id": "449aaaff-d7aa-3a0c-b834-4d2300b977b7",
                                "text": "'Youths' happily do both and they're almost seen as weird if they don't smoke themselves into a whitey with their mates."
                            },
                            {
                                "example_id": "474bda49-3bbb-4232-8516-83c6285b8c0e",
                                "sense_id": "449aaaff-d7aa-3a0c-b834-4d2300b977b7",
                                "text": "Ocasionaly^([sic]) things don't work quite as expected but seriously i can't remeber^([sic]) last time i had a \"whitey\" not for many years that a certainty."
                            },
                            {
                                "example_id": "fd33f8eb-40d6-45b1-b71f-8c4afef718c0",
                                "sense_id": "449aaaff-d7aa-3a0c-b834-4d2300b977b7",
                                "text": "'Dead bodies. Up in trees,' I said.\nI handed him the crisps.\n'I'm gonnae have a whitey,' he said and fucked off up to the toilet to be sick."
                            },
                            {
                                "example_id": "0b5890ee-a1f1-477a-8dd4-f226c4daacb6",
                                "sense_id": "449aaaff-d7aa-3a0c-b834-4d2300b977b7",
                                "text": "Tristan: I'm having a whitey.\n He seems about to be sick.\n Connie: You're on a placebo, Tristan, you're not on the drug."
                            }
                        ]
                    }
                ],
