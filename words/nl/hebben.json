                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "иметь симптомы или болезнь"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "souffrir d'un mal ou d'une maladie"
                            },
                            {
                                "target_lang_word": "souffrir de",
                                "target_lang_sense_clarification": "être atteint par une maladie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8b01006-ab63-3510-ba30-9db49d33f5da",
                    "sense_definition": "Spreken over een bepaald onderwerp.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waar <heeft> u het eigenlijk over?",
