                        "entry_id": "0d92c447-6ed7-3899-b715-5dbf8edc915d",
                        "glosses": [
                            "Propice au sommeil ou, tout au moins, où dormir est possible."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0b2e6951-bb5d-441f-ad6a-6fc3a4ecdbf3",
                                "sense_id": "75972067-e28d-317f-9e82-7cbb93cd2f9f",
                                "text": "Cette tranquille nuit est très dormable."
                            },
                            {
                                "example_id": "dc414dc0-c51d-4bbb-b70e-aa6934af7fdb",
                                "sense_id": "75972067-e28d-317f-9e82-7cbb93cd2f9f",
                                "text": "Il se décida en septembre, la grosse chaleur passée, les nuits devenues dormables."
                            },
                            {
                                "example_id": "71b4d247-fe5f-4c92-9522-62e057c22e8d",
                                "sense_id": "75972067-e28d-317f-9e82-7cbb93cd2f9f",
                                "text": "Ça reste dormable bien sûr, mais avec boule quies ou dose massive d'alcool dans le sang pour les sommeils les plus légers."
                            }
                        ]
                    }
                ],
