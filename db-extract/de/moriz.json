                ],
                "senses": [
                    {
                        "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                        "entry_id": "a8b92597-8b96-327b-a74e-5af5450f18d3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e239f4-5709-4ad1-ac93-5faf3c6f7098",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Frau Moriz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "38b886bb-3878-430f-9217-e474edf6c303",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Herr Moriz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7af09827-5924-4e79-8dd5-37b7683b924b",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Die Moriz fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2eb8a938-3175-4565-88c6-6269f07e5395",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Der Moriz trägt nie die Schals, die die Moriz ihm strickt."
                            },
                            {
                                "example_id": "945938fc-def6-4400-b1bd-6f43dcf89557",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Moriz kommt, geht der Herr Moriz.“"
                            },
                            {
                                "example_id": "3813313f-07b6-4dcb-a34e-8afcee7a8cce",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Moriz kommt und geht."
                            },
                            {
                                "example_id": "06dcc288-52fe-4ac7-b1fe-e3b5d7ed8a7b",
                                "sense_id": "eb2eca58-ac78-3d29-a52b-d4e896629756",
                                "text": "Morizens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
