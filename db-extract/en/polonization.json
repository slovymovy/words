                                    {
                                        "sense_id": "9f43de7b-f760-3627-87cd-b53b62d22734",
                                        "entry_id": "23da7062-e3e7-3379-94b9-5bc231475e4c",
                                        "glosses": [
                                            "Durchsetzung der polnischen Kultur bei Personen, die anderssprachig sind und/oder einer anderen Kultur/Nation angehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e8015a-2770-466a-aca6-af5aff3670e0",
                                                "sense_id": "9f43de7b-f760-3627-87cd-b53b62d22734",
                                                "text": "„Noch vor der Polonisierung der Erwachsenen beginnt in Groß Döbern die Polonisierung der Kinder.“"
                                            },
                                            {
                                                "example_id": "8c7bd0da-ac6b-49b8-b095-4321a60fce1a",
                                                "sense_id": "9f43de7b-f760-3627-87cd-b53b62d22734",
                                                "text": "„Nur widerwillig ließen die Ostpreußen die Polonisierung ihrer Namen über sich ergehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
