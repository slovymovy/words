                "senses": [
                    {
                        "sense_id": "8d2d7068-4997-3542-93c9-1d308de5b414",
                        "entry_id": "8e4fba42-3e69-339f-971c-65680c22d682",
                        "glosses": [
                            "Bilanz eines Unternehmens, die nach steuerlichen Vorschriften und ausschließlich für steuerliche Zwecke (Ermittlung des steuerlichen Ergebnisses) erstellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a871a92d-b832-459f-8b66-0e8d4f153db6",
                                "sense_id": "8d2d7068-4997-3542-93c9-1d308de5b414",
                                "text": "Der Gewinn laut Steuerbilanz ist niedriger als der Handelsbilanzgewinn, wenn das Unternehmen ein steuerliches Bilanzierungswahlrecht ausgeübt hat."
                            },
                            {
                                "example_id": "107bf500-a6c8-42ce-9374-528f40757a59",
                                "sense_id": "8d2d7068-4997-3542-93c9-1d308de5b414",
                                "text": "Die Steuerbilanz muss zusammen mit der Steuererklärung beim Finanzamt eingereicht werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
