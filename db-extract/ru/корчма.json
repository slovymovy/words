                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594e9201-2c66-4008-82d9-7d9e8cd454a7",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "But where do you intend to inn to-night?"
                                            },
                                            {
                                                "example_id": "16b0042b-5424-4dda-a23d-d1934d2d7bdd",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "We inned at the signe of the Swan."
                                            },
                                            {
                                                "example_id": "a4376afb-8265-43e1-8ea1-f205748581ef",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "I never innd in the Towne but once."
                                            },
                                            {
                                                "example_id": "3a2db932-abc2-45be-b540-0bb1c2fce781",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "John Welch, Cornish Carrier, who formerly Inn'd at the Mermaid in Exon, is now removed to the Bear-Inn."
                                            },
                                            {
                                                "example_id": "51932b44-7ade-4d5b-b055-9408c15dafbb",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "I inned at the best house, the Star and Garter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2e2c45-f3f2-3855-80c4-afa23817eae7",
                                        "entry_id": "e7384850-63b7-3f5a-bda7-dcd0cf01b8d2",
                                        "glosses": [
                                            "To lodge or house (someone or something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c201cc-3c2d-4061-a84f-5304d130de24",
                                                "sense_id": "ec2e2c45-f3f2-3855-80c4-afa23817eae7",
                                                "text": "I have but Inn'd my horse since, master Cockstone."
                                            },
                                            {
                                                "example_id": "52788e95-914b-4be8-9829-9f961fc6d09b",
                                                "sense_id": "ec2e2c45-f3f2-3855-80c4-afa23817eae7",
                                                "text": "These Inn'd themselves all Night in Knights-bridge Fields."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ff4e939-6aa8-4124-aa5f-ff790930e2fb",
                        "source_entry_id": "bd890e0d-823f-3f12-81e9-20d5c8633aa1",
                        "source_sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                        "target_lang_word": "tavern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tavern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d908740a-0dae-3114-899f-66fff910f105",
                                        "entry_id": "b7c1f76c-1c6f-3139-86d7-e6560696fb73",
                                        "glosses": [
                                            "A restaurant or bar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52a8afc9-48a4-37e1-a5b8-c334cc0e19ce",
                                        "entry_id": "b7c1f76c-1c6f-3139-86d7-e6560696fb73",
                                        "glosses": [
                                            "A building containing a bar licensed to sell alcoholic drinks, and offering sleeping accommodations for travelers."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43f2f1e-4abf-44fb-8631-8bb4ebd4726a",
                                                "sense_id": "52a8afc9-48a4-37e1-a5b8-c334cc0e19ce",
                                                "text": "I maruell I heare no nevves of Dromio, either hee ſlackes the matter, or betraies his Maiſter, I dare not motion anie thing to Stellio, till I knovv vvhat my boy hath don, Ile hunt him out, if the loiterſacke be gone ſpringing into a Tauerne, Ile fetch him reeling out."
                                            },
                                            {
                                                "example_id": "c328dc87-cacf-4c41-b96f-91e021262f3f",
                                                "sense_id": "52a8afc9-48a4-37e1-a5b8-c334cc0e19ce",
                                                "text": "Dreaming when Dawn's Left Hand was in the Sky / I heard a Voice within the Tavern cry, / \"Awake, my Little ones, and fill the Cup / Before Life's Liquor in its Cup be dry.\""
                                            },
                                            {
                                                "example_id": "d37e62d6-f9bb-40e2-b97e-b78a45bf16ad",
                                                "sense_id": "52a8afc9-48a4-37e1-a5b8-c334cc0e19ce",
                                                "text": "At half-past nine on this Saturday evening the parlor of the Salutation Inn, High Holborn, contained most of its customary visitors. […] In former days every tavern of repute kept such a room for the select circle—a club, or society, of habitués, who met every evening for a pipe and a cheerful glass."
                                            },
                                            {
                                                "example_id": "c3ad9408-028d-4f08-8277-53b7d75b8e5b",
                                                "sense_id": "52a8afc9-48a4-37e1-a5b8-c334cc0e19ce",
                                                "text": "At one of the way-stations on his long journey a barmaid at a tavern speaks to Gilgamesh and tries to give him common sense on the human condition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
