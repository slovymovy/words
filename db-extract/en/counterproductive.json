                                            {
                                                "example_id": "532e991a-fca0-4950-baae-f74dcaaf3f2b",
                                                "sense_id": "69288dfd-a62f-34d3-9b63-f03c317b0a8b",
                                                "text": "Des effets contreproductifs."
                                            },
                                            {
                                                "example_id": "5909ccdd-25cf-4923-8023-00c64c64fa96",
                                                "sense_id": "69288dfd-a62f-34d3-9b63-f03c317b0a8b",
                                                "text": "« La transformation par la décroissance brutale peut être contreproductive en enrayant les ressources qui permettent de faire avancer les propositions, estime, par exemple, Aurélien Véron, porte-parole du groupe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33256ead-f499-4515-a26e-571ea346a2a1",
                        "source_entry_id": "b2747a15-4615-383b-8db4-84202bb74102",
                        "source_sense_id": "a5e62b00-b3b3-35ff-b46e-2f0b9e59f688",
                        "source_sense_description": "more of a hindrance than a help",
