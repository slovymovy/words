                "word": "mélipone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7157d51-5e35-463e-b987-a9ee89900b8b",
                        "entry_id": "5cf51a37-8c1c-352a-899c-0d6d8a88a2f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "mélipones"
