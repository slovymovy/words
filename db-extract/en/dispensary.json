                    {
                        "translation_id": "401f1b37-f88e-4625-ac0e-2b6b96cf2192",
                        "source_entry_id": "4149d0be-ee36-3ac7-be0a-67acb977d5f8",
                        "source_sense_description": "office for dispensing drugs",
                        "target_lang_word": "apotheek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apotheek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "830d25e5-b500-394a-bd0e-b3fa7f578491",
                                        "entry_id": "0870bb14-d178-3dda-8fd2-9ac36ec3d76b",
                                        "glosses": [
                                            "plaats waar men geneesmiddelen en andere gezondheidsproducten kan kopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261462dc-5c12-4e53-835f-dc6e2cb10b02",
                                                "sense_id": "830d25e5-b500-394a-bd0e-b3fa7f578491",
                                                "text": "Medicijnen die voorgeschreven zijn door de arts kun je ophalen bij de apotheek."
                                            },
                                            {
                                                "example_id": "2edd68de-956d-4cf1-96c2-0951d30aa477",
                                                "sense_id": "830d25e5-b500-394a-bd0e-b3fa7f578491",
                                                "text": "Een bezoek aan haar huisarts en de apotheek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f02371-d212-3fc2-9c7a-09d5fd5bf46d",
                                        "entry_id": "0870bb14-d178-3dda-8fd2-9ac36ec3d76b",
                                        "glosses": [
                                            "voorraad medicamenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07196f09-3a20-43e7-9cb9-e5cdff803976",
                                                "sense_id": "c0f02371-d212-3fc2-9c7a-09d5fd5bf46d",
                                                "text": "Op vakantie heb ik een reisapotheek bij me."
                                            },
                                            {
                                                "example_id": "d2abae83-7a47-4a8f-93ed-e9120cdb65e7",
                                                "sense_id": "c0f02371-d212-3fc2-9c7a-09d5fd5bf46d",
                                                "text": "Die vrouw heeft een behoorlijke apotheek bij zich: pijnstillers, slaapmiddelen, antidepressiva, maagzuurremmers. Ik druk heel voorzichtig een ibuprofen uit de strip in de hoop dat ze het niet zal merken. Dan slik ik hem door met water en hoop op het beste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "990d48df-ff77-4137-a42d-867e5a2f1604",
                        "source_entry_id": "4149d0be-ee36-3ac7-be0a-67acb977d5f8",
                        "source_sense_description": "office for dispensing drugs",
                        "target_lang_word": "Apotheke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apotheke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                        "entry_id": "3e65e723-7a90-3f9a-b367-e7f078f9c0f5",
                                        "glosses": [
                                            "Geschäft, in dem Medikamente und Heilmittel verkauft werden, die ursprünglich fast vollständig nach Rezept selbst hergestellt wurden"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e238b2-1e24-4e87-bb72-ad9270e16721",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "Fünfhundert Meter weiter auf der rechten Seite befindet sich eine Apotheke."
                                            },
                                            {
                                                "example_id": "21ab06a9-6f48-489f-b816-8a5464a05933",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "Die Apotheke am Rathausplatz hat Bereitschaft."
                                            },
                                            {
                                                "example_id": "8a3301c4-cdb1-4b89-8e6f-bd32b52e459d",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "Weißt du, welche Apotheke heute Nachtdienst hat?"
                                            },
                                            {
                                                "example_id": "7531bd77-0734-4ddd-9ae0-5d9c4a971620",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "„Ein paar Schritt vor der nächsten Apotheke läßt Wolf den Wagen halten und hinkt krank und elend los.“"
                                            },
                                            {
                                                "example_id": "4a9fe905-bb0d-48ef-b385-e51d2be9ffac",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "„Das Klischee der sogenannten Männergrippe bedienen selbst Pharmafirmen und Apotheken.“"
                                            },
                                            {
                                                "example_id": "10d052f9-7712-4a6e-9204-13ecb300a385",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "„Als der Kellner die zwei Gläser frischgepressten Zitronensaft mit Eis, die zwei Whisky und die Flasche Perrier brachte, erklärt er mir, die Apotheke habe geschlossen und er könne kein Thermometer besorgen.“"
                                            },
                                            {
                                                "example_id": "ce32883b-dc48-474c-82d4-df64a5657747",
                                                "sense_id": "7c632864-3e30-3658-ba7f-2c60948e549e",
                                                "text": "„Barberou schickte es und gab in seinem Brief eine Apotheke für die Arzneimittel an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18cab620-4579-3de3-8fe1-511e87f8d2ca",
                                        "entry_id": "3e65e723-7a90-3f9a-b367-e7f078f9c0f5",
                                        "glosses": [
                                            "Geschäft, das hohe Preise für seine Waren fordert"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4222eb4f-4beb-467e-9043-1187a573eb37",
                                                "sense_id": "18cab620-4579-3de3-8fe1-511e87f8d2ca",
                                                "text": "Dieses Kaufhaus ist eine Apotheke!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9fb063e7-7acf-33e8-b6db-aa7b24e779ba",
                                        "entry_id": "3e65e723-7a90-3f9a-b367-e7f078f9c0f5",
                                        "glosses": [
                                            "Tasche oder Schränkchen als Aufbewahrungsort für Medikamente oder Heilmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216c8c19-ee87-47f7-984f-89749e3bbde3",
                                                "sense_id": "9fb063e7-7acf-33e8-b6db-aa7b24e779ba",
                                                "text": "Hast du in deiner Apotheke zu Hause Tabletten gegen Halsschmerzen parat?"
                                            },
                                            {
                                                "example_id": "a94cd2fa-bbfc-491e-a69d-0a32bd0b92a1",
                                                "sense_id": "9fb063e7-7acf-33e8-b6db-aa7b24e779ba",
                                                "text": "Er suchte in seiner Apotheke nach Kopfschmerztabletten."
                                            },
                                            {
                                                "example_id": "e675f64e-ae06-4fcc-b1d5-9aec9d2bdfdf",
                                                "sense_id": "9fb063e7-7acf-33e8-b6db-aa7b24e779ba",
                                                "text": "Unsere Apotheke steht im Badezimmer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
