                        "source_entry_id": "66fbfa73-c003-30bb-bd2f-44670597dfd9",
                        "source_sense_id": "b761c204-ee93-3f70-82d5-64f69d07284b",
                        "target_lang_word": "СДПГ",
                        "target_lang_code": "ru",
