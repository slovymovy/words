                        "target_lang_word": "seizure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seizure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d76a9a6a-3efc-3ebf-a546-e71643a9d95f",
                                        "entry_id": "1dd8c447-c711-32fe-9bf8-df64bba7490e",
                                        "glosses": [
                                            "The act of taking possession, as by force or right of law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c67cacbd-89ea-41bb-89db-72eaae9d88f1",
                                                "sense_id": "d76a9a6a-3efc-3ebf-a546-e71643a9d95f",
                                                "text": "the seizure of a thief, a property, a throne, etc."
                                            },
                                            {
                                                "example_id": "9476bc0f-7183-4aa7-bea1-5b3f646d7655",
                                                "sense_id": "d76a9a6a-3efc-3ebf-a546-e71643a9d95f",
                                                "text": "The search warrant permitted the seizure of evidence."
                                            },
                                            {
                                                "example_id": "02a4d1c0-9c8d-4600-9103-ec02b3ee64f7",
                                                "sense_id": "d76a9a6a-3efc-3ebf-a546-e71643a9d95f",
                                                "text": "As yet there had been no alarm of fever. The three seizures had excited some comment, however, and had it not been for the counter-excitement of the burning ship, it is possible that Pine's precaution would have been thrown away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8566eec-5edb-3144-98a0-d6f22523afb9",
                                        "entry_id": "1dd8c447-c711-32fe-9bf8-df64bba7490e",
                                        "glosses": [
                                            "A sudden attack or convulsion, (e.g. an epileptic seizure)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1734f9d7-da34-4c3d-b2d5-4f729baf4ad3",
                                                "sense_id": "d8566eec-5edb-3144-98a0-d6f22523afb9",
                                                "text": "He fell to the floor and convulsed when the epileptic seizure occurred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5585a1cf-f7c5-3237-bbb1-6d82c4f2f87d",
                                        "entry_id": "1dd8c447-c711-32fe-9bf8-df64bba7490e",
                                        "glosses": [
                                            "A sudden onset of pain or emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b0d675-76ea-4611-a3eb-a3fb10111ae5",
                                                "sense_id": "5585a1cf-f7c5-3237-bbb1-6d82c4f2f87d",
                                                "text": "He felt the sudden seizure of pain as the heart attack began."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb713246-83bc-3f83-ba47-8a399c87b39c",
                                        "entry_id": "1dd8c447-c711-32fe-9bf8-df64bba7490e",
                                        "glosses": [
                                            "That which is seized, or taken possession of; a thing laid hold of, or possessed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be63b6f2-79e5-3093-bcd0-15f0d5fa1317",
                                        "entry_id": "1dd8c447-c711-32fe-9bf8-df64bba7490e",
                                        "glosses": [
                                            "Retention within one's grasp or power; possession; ownership."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c58833-2333-40ed-853e-eff4594c6847",
                                                "sense_id": "be63b6f2-79e5-3093-bcd0-15f0d5fa1317",
                                                "text": "Make o'er thy honour by a deed of trust, / And give me seizure of the mighty wealth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seizure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcc2c4d8-1d2d-3bfe-9722-c4393032fbca",
                                        "entry_id": "496718f3-42fb-3acd-9a6f-6866abfb172f",
                                        "glosses": [
                                            "To undergo an epileptic seizure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9aa2ad2-354a-4485-bc0b-51df1de13e63",
                                                "sense_id": "bcc2c4d8-1d2d-3bfe-9722-c4393032fbca",
                                                "text": "My doctor prescribed Namility. It made my vision blurry, I told him. He said keep taking it, it'll stop. Next day at work I seizured in the middle of an order."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3292e786-a5b6-42aa-bc49-dace096b80e7",
                        "source_entry_id": "52aa78be-9819-35c0-9226-8e6e5d279d30",
                        "source_sense_id": "fe1acb2f-8869-3e53-a6a6-f050701c7c7e",
                        "source_sense_description": "een epileptische aanval, een toeval",
                        "target_lang_word": "convulsion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convulsion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff9c9e6-cfe8-3a6d-ad04-90b93e867496",
                                        "entry_id": "b0449185-6465-306a-866f-15d087300b6e",
                                        "glosses": [
                                            "Contraction violente et involontaire d’un ou plusieurs muscles, d’un ou plusieurs membres, voire de tout le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3bd5d12-5002-43b3-af62-6ca2bcbeeb2d",
                                                "sense_id": "9ff9c9e6-cfe8-3a6d-ad04-90b93e867496",
                                                "text": "Ses lèvres pâles comme son teint indiquèrent une convulsion domptée par l’énergie bretonne."
                                            },
                                            {
                                                "example_id": "32b241ed-5917-45c8-9c92-86a872c923f2",
                                                "sense_id": "9ff9c9e6-cfe8-3a6d-ad04-90b93e867496",
                                                "text": "— Tu crois, mon garçon, que je vais prendre à mon service un vilain animal comme toi, qui fera mourir de peur ma femme et mes servantes, tomber en convulsions mes enfants !"
                                            },
                                            {
                                                "example_id": "39a7f4a4-663b-47e8-aff1-04d9c6ab85d6",
                                                "sense_id": "9ff9c9e6-cfe8-3a6d-ad04-90b93e867496",
                                                "text": "M. Vulpian a vu que, chez des animaux empoisonnés par la strychnine, lorsque la dose de poison n’était pas trop forte, les convulsions trop énergiques, l’appareil respiratoire échappait à l’action convulsivante du poison."
                                            },
                                            {
                                                "example_id": "7f5b6ab6-f91a-4f40-ac58-b196dfe28ef0",
                                                "sense_id": "9ff9c9e6-cfe8-3a6d-ad04-90b93e867496",
                                                "text": "Le rire dégénere quelquefois en convulsion ; cela n’est pas surprenant, puisqu’il n’est lui-même qu’une espèce de convulsion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d74705e-08cf-3d27-be3c-5b031060cf07",
                                        "entry_id": "b0449185-6465-306a-866f-15d087300b6e",
                                        "glosses": [
                                            "Grands troubles qui agitent les États."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df286583-823d-4ce8-9f94-717ec85aba01",
                                                "sense_id": "5d74705e-08cf-3d27-be3c-5b031060cf07",
                                                "text": "Les seigneurs, […], avaient maintenant repris leur ancienne licence dans toute son étendue, […] s’efforçant, par tous les moyens possibles, de se mettre chacun à la tête de forces suffisantes pour jouer un rôle dans les convulsions nationales qui semblaient imminentes."
                                            },
                                            {
                                                "example_id": "aa5fa8c4-22a2-46df-98df-b3b8c38491da",
                                                "sense_id": "5d74705e-08cf-3d27-be3c-5b031060cf07",
                                                "text": "Le XIVᵉ siècle […] s’achève, ainsi qu’il a préludé, se tord dans des convulsions religieuses atroces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "266815a8-9f15-323f-bd56-a6547f62a755",
                                        "entry_id": "b0449185-6465-306a-866f-15d087300b6e",
                                        "glosses": [
                                            "Secousse sismique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e844fcb-92ae-46d0-996b-4d547dcddcae",
                                                "sense_id": "266815a8-9f15-323f-bd56-a6547f62a755",
                                                "text": "D'énormes blocs de corail éblouissants de blancheur sortaient de l'eau et semblaient les débris d'une gigantesque convulsion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
