{
    "word_family": [
        "forgive",
        "forgiving",
        "unforgivingly",
        "unforgiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8af0e2c-2f15-3d7c-978f-a905b687345a",
                    "sense_definition": "Unwilling or unable to forgive or show mercy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public was in an <w>unforgiving</w> mood after the scandal was revealed.",
                            "target_lang_translations": {
                                "ru": "После того как скандал вскрылся, общество было настроено <w>беспощадно</w>."
                            }
                        },
                        {
                            "text": "He remained <w>unforgiving</w> toward his former partner, refusing every apology.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>непреклонен</w> по отношению к своему бывшему партнёру, отвергая любые извинения."
                            }
                        }
                    ],
                    "synonyms": [
                        "relentless",
                        "merciless",
                        "implacable"
                    ],
                    "antonyms": [
                        "forgiving",
                        "lenient",
                        "merciful"
                    ],
                    "common_phrases": [
                        "unforgiving mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не склонный прощать или проявлять милосердие; злопамятный, беспощадный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрощающий",
                                "target_lang_sense_clarification": "не готовый простить"
                            },
                            {
                                "target_lang_word": "неумолимый",
                                "target_lang_sense_clarification": "не поддающийся мольбам, непреклонный"
                            },
                            {
                                "target_lang_word": "беспощадный",
                                "target_lang_sense_clarification": "безжалостный, не знающий пощады"
                            },
                            {
                                "target_lang_word": "злопамятный",
                                "target_lang_sense_clarification": "помнящий обиды и не прощающий их"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ed29371-be13-3b1a-a010-618b1b6c29df",
                    "sense_definition": "Harsh, difficult, and offering no allowance for weakness or error.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harshness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert is an <w>unforgiving</w> environment where mistakes can cost you your life.",
                            "target_lang_translations": {
                                "ru": "Пустыня — это <w>беспощадная</w> среда, где ошибки могут стоить жизни."
                            }
                        },
                        {
                            "text": "Surviving in such an <w>unforgiving</w> climate requires careful preparation and extreme caution.",
                            "target_lang_translations": {
                                "ru": "Выживание в столь <w>суровом</w> климате требует тщательной подготовки и предельной осторожности."
                            }
                        }
                    ],
                    "synonyms": [
                        "harsh",
                        "punishing",
                        "severe",
                        "relentless"
                    ],
                    "antonyms": [
                        "forgiving",
                        "gentle",
                        "mild"
                    ],
                    "common_phrases": [
                        "unforgiving climate",
                        "unforgiving terrain",
                        "unforgiving environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровый, беспощадный и не прощающий ошибок или слабостей (об условиях, климате и т. д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "тяжёлый, строгий, опасный"
                            },
                            {
                                "target_lang_word": "беспощадный",
                                "target_lang_sense_clarification": "не дающий поблажек или второго шанса"
                            },
                            {
                                "target_lang_word": "не прощающий ошибок",
                                "target_lang_sense_clarification": "требующий абсолютной точности и осторожности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8dfbd597-44ca-3bbe-9675-c0840f338ea9",
                    "sense_definition": "Present participle and gerund of <w>unforgive</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She regretted <w>unforgiving</w> him after realizing it only prolonged her own bitterness.",
                            "target_lang_translations": {
                                "ru": "Она пожалела о том, что <w>взяла своё прощение назад</w>, поняв, что это лишь продлило её собственную горечь."
                            }
                        },
                        {
                            "text": "By actively <w>unforgiving</w> those who wronged her, she felt in control again.",
                            "target_lang_translations": {
                                "ru": "Активно <w>отказываясь прощать</w> обидчиков, она снова почувствовала контроль над ситуацией."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола unforgive (отменять или забирать назад своё прощение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменяющий прощение",
                                "target_lang_sense_clarification": "действие по отмене ранее данного прощения"
                            },
                            {
                                "target_lang_word": "отказ от прощения",
                                "target_lang_sense_clarification": "герундий: возвращение к непрощению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}