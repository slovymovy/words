                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spojrzał w naszą stronę, ale przeszedł <w>mimo</w> bez słowa.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел в нашу сторону, но молча прошел <w>мимо</w>."
