                    {
                        "sense_id": "375a76b4-4d9f-3eeb-8f70-88aaaff08c50",
                        "entry_id": "08ac6f71-66fd-33b6-9022-2ef74363c7e5",
                        "glosses": [
                            "eine Angehörige des eingeborenen Volkes der Lappen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac6d121-79f8-4c32-93db-f3d92ab6db99",
                                "sense_id": "375a76b4-4d9f-3eeb-8f70-88aaaff08c50",
                                "text": "„Zuletzt muß ich den guten Lappen und Lappinnen noch eine Schutzrede halten wegen des gewöhnlichen Geschreis von Häßlichkeit und Schmutz, worin sie sind.“"
                            },
                            {
                                "example_id": "b2325e85-04c3-4e5e-af8a-ab7f284e31d8",
                                "sense_id": "375a76b4-4d9f-3eeb-8f70-88aaaff08c50",
                                "text": "„In eine hölzerne Schüssel, die vorhin mit Rennthiermilch gefüllt im Kreise gegangen war […], wurde, ohne daß man erst für nöthig befunden, sie auszuspülen, das fast rohe Fleisch von der Lappin in mundrechte Bissen geschnitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
