            {
                "entry_id": "bc5b4ee9-39c2-368b-aa77-255995fa352e",
                "word": "oualou",
                "pos": "pron",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c27cec8-7fe4-3761-94a3-61f8f859325f",
                        "entry_id": "bc5b4ee9-39c2-368b-aa77-255995fa352e",
                        "glosses": [
                            "Autre orthographe de walou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bc65fc-0bd8-4d7b-93f7-e0b3b29937c2",
                                "sense_id": "4c27cec8-7fe4-3761-94a3-61f8f859325f",
                                "text": "A l’échelle du grand tout\nOn est que dalle, on est des clous\nOn est oualou\nOn est oualou\nOn est macash\nOn est nada\nRien du tout"
                            },
                            {
                                "example_id": "4b4aba97-4c0a-425e-b4f9-4365a00f4c84",
                                "sense_id": "4c27cec8-7fe4-3761-94a3-61f8f859325f",
                                "text": "J’actionne la poignée en bec-de-cane. Oualou ! La lourde branligote mais ne s’évase point."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
