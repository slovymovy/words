                                        "glosses": [
                                            "In an innocent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e211e5-042a-4711-b8ae-beb60eb5232b",
                                                "sense_id": "8c8d8a63-b943-308f-aee1-3693aea345d9",
                                                "text": "[M]en lyued ſimplye and innocentlye without inforcement of lawes, without quarellinge Judges and libelles, contente onely to ſatiſfie nature, without further vexation for knowledge of thinges to come."
                                            }
