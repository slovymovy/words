{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                    "sense_definition": "Slightly open, especially of a door.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slightly_open",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She left the bedroom door <w>ajar</w> so she could hear the baby if he cried.",
                            "target_lang_translations": {
                                "de": "Sie ließ die Schlafzimmertür <w>angelehnt</w>, damit sie das Baby hören konnte, falls es weinte."
                            }
                        },
                        {
                            "text": "Through the <w>ajar</w> window, a cool breeze entered the warm room.",
                            "target_lang_translations": {
                                "de": "Durch das <w>gekippte</w> Fenster drang eine kühle Brise in das warme Zimmer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "door left ajar",
                        "standing ajar"
                    ],
                    "target_lang_definitions": {
                        "de": "Leicht geöffnet, insbesondere von einer Tür."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "angelehnt",
                                "target_lang_sense_clarification": "von Türen oder Fenstern"
                            },
                            {
                                "target_lang_word": "halboffen",
                                "target_lang_sense_clarification": "nicht ganz geschlossen"
                            },
                            {
                                "target_lang_word": "einen Spalt breit offen",
                                "target_lang_sense_clarification": "nur ein wenig geöffnet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bfd5413a-cd4a-3ef8-b9a3-1d40e3969a9b",
                    "sense_definition": "In a slightly open position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slightly_open",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The front door was standing <w>ajar</w> when we arrived home.",
                            "target_lang_translations": {
                                "de": "Die Haustür stand <w>angelehnt</w>, als wir nach Hause kamen."
                            }
                        },
                        {
                            "text": "He noticed the safe had been left <w>ajar</w> and immediately called security.",
                            "target_lang_translations": {
                                "de": "Er bemerkte, dass der Safe <w>offenstehend</w> gelassen worden war, und rief sofort den Sicherheitsdienst."
                            }
                        }
                    ],
                    "common_phrases": [
                        "standing ajar"
                    ],
                    "target_lang_definitions": {
                        "de": "In einer leicht geöffneten Position."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "angelehnt",
                                "target_lang_sense_clarification": "von Türen oder Fenstern"
                            },
                            {
                                "target_lang_word": "halboffen",
                                "target_lang_sense_clarification": "nicht ganz geschlossen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "672f66e7-d34a-34e9-b4fb-f25533ec9132",
                    "sense_definition": "Out of harmony; in a state of discord or disagreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their opinions on the matter were completely <w>ajar</w> with the rest of the committee.",
                            "target_lang_translations": {
                                "de": "Ihre Meinungen zu dieser Angelegenheit waren völlig <w>uneins</w> mit dem Rest des Ausschusses."
                            }
                        },
                        {
                            "text": "The sudden noise set his nerves <w>ajar</w> for the rest of the evening.",
                            "target_lang_translations": {
                                "de": "Das plötzliche Geräusch brachte seine Nerven für den Rest des Abends <w>aus dem Konzept</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht in Harmonie; in einem Zustand der Uneinigkeit oder des Missklangs."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "uneins",
                                "target_lang_sense_clarification": "nicht übereinstimmend"
                            },
                            {
                                "target_lang_word": "im Zwiespalt",
                                "target_lang_sense_clarification": "im Widerspruch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff9f730a-ca69-3fa4-a2c0-88600d295f62",
                    "sense_definition": "Being at variance or in contradiction to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness's testimony was <w>ajar</w> with the physical evidence presented.",
                            "target_lang_translations": {
                                "de": "Die Aussage des Zeugen stand <w>im Widerspruch</w> zu den vorgelegten physischen Beweisen."
                            }
                        },
                        {
                            "text": "There is a sort of unexpressed concern that sets one's heart <w>ajar</w>.",
                            "target_lang_translations": {
                                "de": "Es gibt eine Art unausgesprochene Sorge, die das Herz <w>aus dem Takt bringt</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Im Widerspruch oder Gegensatz zu etwas stehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "im Widerspruch",
                                "target_lang_sense_clarification": "nicht übereinstimmend"
                            },
                            {
                                "target_lang_word": "unvereinbar",
                                "target_lang_sense_clarification": "im Gegensatz stehend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "398e86e7-7748-31b3-abad-22ab7cf8a1c0",
                    "sense_definition": "A member of an ethnic group living in Adjara, an autonomous republic of Georgia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Ajars</w> are Muslim Georgians who have their own autonomous republic.",
                            "target_lang_translations": {
                                "de": "Die <w>Adscharen</w> sind muslimische Georgier, die ihre eigene autonome Republik haben."
                            }
                        },
                        {
                            "text": "Historically, the <w>Ajars</w> faced many challenges during regional conflicts.",
                            "target_lang_translations": {
                                "de": "Historisch gesehen sahen sich die <w>Adscharen</w> während regionaler Konflikte vielen Herausforderungen gegenüber."
                            }
                        }
                    ],
                    "synonyms": [
                        "Adjaran"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Mitglied einer ethnischen Gruppe, die in Adscharien lebt, einer autonomen Republik in Georgien."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Adschare",
                                "target_lang_sense_clarification": "männliches Mitglied der Volksgruppe"
                            },
                            {
                                "target_lang_word": "Adscharin",
                                "target_lang_sense_clarification": "weibliches Mitglied der Volksgruppe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                    "sense_definition": "To turn or open slightly; to become slightly open.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "open_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He watched the heavy wooden gates slowly <w>ajar</w> as the mechanism turned.",
                            "target_lang_translations": {
                                "de": "Er sah zu, wie sich die schweren Holztore langsam <w>einen Spalt öffneten</w>, als sich der Mechanismus drehte."
                            }
                        },
                        {
                            "text": "The wind managed to <w>ajar</w> the window, letting in a draft of cold air.",
                            "target_lang_translations": {
                                "de": "Dem Wind gelang es, das Fenster <w>leicht zu öffnen</w>, wodurch ein kalter Luftzug hereinströmte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich leicht drehen oder öffnen; leicht geöffnet werden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich leicht öffnen",
                                "target_lang_sense_clarification": "einen Spalt weit aufgehen"
                            },
                            {
                                "target_lang_word": "anlehnen",
                                "target_lang_sense_clarification": "leicht öffnen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1044cd10-ac13-3c28-8eef-c97381723c59",
                    "sense_definition": "To show variance or contradiction; to be or cause to be askew or out of harmony.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discord_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud explosion set all the crockery ware <w>ajarring</w> in the kitchen.",
                            "target_lang_translations": {
                                "de": "Die laute Explosion brachte das gesamte Geschirr in der Küche <w>zum Klirren</w>."
                            }
                        },
                        {
                            "text": "His radical ideas began to <w>ajar</w> with the traditional values of the community.",
                            "target_lang_translations": {
                                "de": "Seine radikalen Ideen begannen, mit den traditionellen Werten der Gemeinschaft <w>zu kollidieren</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Abweichung oder Widerspruch zeigen; in Missklang bringen oder geraten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "im Widerspruch stehen",
                                "target_lang_sense_clarification": "nicht harmonieren"
                            },
                            {
                                "target_lang_word": "erschüttern",
                                "target_lang_sense_clarification": "aus dem Gleichgewicht bringen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}