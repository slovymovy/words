                "senses": [
                    {
                        "sense_id": "df968720-50e1-3797-b8ab-f0db16299351",
                        "entry_id": "2b634ca9-eb62-3ed2-a2b0-d4cd1ab6661d",
                        "glosses": [
                            "Substanzen dauerhaft aufnehmend, durch welche sich der optische Eindruck verändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "810ab2cb-8a86-41b8-ac74-2bf37ab2ea18",
                                "sense_id": "df968720-50e1-3797-b8ab-f0db16299351",
                                "text": "„Normalerweise sind sie anfärbbar und mikroskopisch zu erkennen.“"
                            },
                            {
                                "example_id": "cd5fdff9-f591-476c-ac5b-c5773726acbd",
                                "sense_id": "df968720-50e1-3797-b8ab-f0db16299351",
                                "text": "„Mit Fluorescein sind diese Stellen nicht anfärbbar.“"
                            },
                            {
                                "example_id": "2561989f-5401-4bc8-8f36-dd12e0188c1b",
                                "sense_id": "df968720-50e1-3797-b8ab-f0db16299351",
                                "text": "„Durch Staphylotoxin erzeugte Entzündungsherde waren bis zu 13 Std, durch Pferdeserum erzeugte Herde bis zu 24 Std mit Trypanblau anfärbbar. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
