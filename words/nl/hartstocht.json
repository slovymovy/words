    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8bf7053-ac08-32d9-9eea-2dbcd55ea525",
                    "sense_definition": "Een zeer sterke belangstelling of enthousiasme voor iets waar het hart naar uitgaat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn grote <w>hartstocht</w> voor klassieke muziek begon al op jonge leeftijd.",
                            "target_lang_translations": {
                                "en": "His great <w>passion</w> for classical music already started at a young age."
                            }
                        },
                        {
                            "text": "Zij spreekt altijd met veel <w>hartstocht</w> over haar werk in de tuin.",
                            "target_lang_translations": {
                                "en": "She always speaks with much <w>passion</w> about her work in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "passie"
                    ],
                    "antonyms": [
                        "onverschilligheid"
                    ],
                    "common_phrases": [
                        "met grote hartstocht",
                        "een levenslange hartstocht"
                    ],
                    "target_lang_definitions": {
                        "en": "A very strong interest or enthusiasm for something that one is deeply devoted to."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passion",
                                "target_lang_sense_clarification": "strong interest or enthusiasm"
                            },
                            {
                                "target_lang_word": "fervor",
                                "target_lang_sense_clarification": "intense and passionate feeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a045e3e8-82dd-31ac-a190-aa9f8c58bb78",
                    "sense_definition": "Een heftig en onstuimig gevoel van liefde of seksuele aantrekkingskracht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De roman beschrijft de alles verzengende <w>hartstocht</w> tussen de twee geliefden.",
                            "target_lang_translations": {
                                "en": "The novel describes the all-consuming <w>passion</w> between the two lovers."
                            }
                        },
                        {
                            "text": "In een vlaag van blinde <w>hartstocht</w> vergat hij al zijn goede voornemens.",
                            "target_lang_translations": {
                                "en": "In a fit of blind <w>passion</w>, he forgot all his good intentions."
                            }
                        }
                    ],
                    "synonyms": [
                        "lust",
                        "passie"
                    ],
                    "common_phrases": [
                        "blinde hartstocht",
                        "verzengende hartstocht"
                    ],
                    "target_lang_definitions": {
                        "en": "A violent and stormy feeling of love or sexual attraction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passion",
                                "target_lang_sense_clarification": "intense romantic or sexual desire"
                            },
                            {
                                "target_lang_word": "lust",
                                "target_lang_sense_clarification": "strong sexual desire"
                            },
                            {
                                "target_lang_word": "ardor",
                                "target_lang_sense_clarification": "enthusiasm or passion in a romantic context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9685a06-f79b-3315-8543-18f047e8a81e",
                    "sense_definition": "Een sterke, vaak ongecontroleerde drang van de zinnelijke of instinctieve natuur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is moeilijk om je menselijke <w>hartstochten</w> altijd onder controle te houden.",
                            "target_lang_translations": {
                                "en": "It is difficult to always keep your human <w>passions</w> under control."
                            }
                        },
                        {
                            "text": "De filosoof schreef over het temmen van de lagere <w>hartstocht</w> van de mens.",
                            "target_lang_translations": {
                                "en": "The philosopher wrote about taming the lower <w>passions</w> of man."
                            }
                        }
                    ],
                    "synonyms": [
                        "lust"
                    ],
                    "common_phrases": [
                        "menselijke hartstochten",
                        "zijn hartstochten bedwingen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in het meervoud gebruikt"
