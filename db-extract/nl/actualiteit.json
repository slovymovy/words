                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5505b11-652b-484c-aa9a-e27244f94055",
                        "source_entry_id": "dc5558ef-392d-31df-9283-5580abc29284",
                        "source_sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                        "target_lang_word": "topicality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topicality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3908f8ba-f0a0-369a-baaa-81143dc4d6b8",
                                        "entry_id": "b638ef93-58a4-3268-afb9-705d8a2d8be8",
                                        "glosses": [
                                            "The condition of being topical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3cb50bb-5b7d-4d92-9d92-20224ca515ef",
                                                "sense_id": "3908f8ba-f0a0-369a-baaa-81143dc4d6b8",
                                                "text": "With the return to monthly publication it is our intention to extend the variety of subjects dealt with, and it will also be possible to attain greater topicality."
                                            },
                                            {
                                                "example_id": "cb35f17d-4f68-49e6-a3ec-2ae73a7768b9",
                                                "sense_id": "3908f8ba-f0a0-369a-baaa-81143dc4d6b8",
                                                "text": "A documentary about gun violence that has its premiere on HBO on Monday has been given extra topicality by the massacre in Charleston, S.C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f57fdd28-43c4-45e8-963d-ae607ce64f9b",
                        "source_entry_id": "dc5558ef-392d-31df-9283-5580abc29284",
                        "source_sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                        "target_lang_word": "actualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d6433d8-857c-3578-af6a-40c6adb2308e",
                                        "entry_id": "de88e478-4cfb-3032-b19d-458321bd1745",
                                        "glosses": [
                                            "État de ce qui est actuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a28c6ef-db36-49f1-9c15-8b2f9d7ffc70",
                                                "sense_id": "6d6433d8-857c-3578-af6a-40c6adb2308e",
                                                "text": "[…] ; or, après trois décennies d’hégémonie idéologique néolibérale et de pari sur la main invisible du marché, les retombées délétères du capitalisme de casino et l’effilochage du lien social qu’il entraine semble redonner,[…], une nouvelle actualité à ce souci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31ec35b-c79e-349e-a097-9a7a61a4f35a",
                                        "entry_id": "de88e478-4cfb-3032-b19d-458321bd1745",
                                        "glosses": [
                                            "Faits qui se produisent dans le temps présent, dans quelque ordre que ce soit, ou les faits très nouveaux, très récents, politiques, littéraires, artistiques, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9028558b-2ad7-4741-83bd-65acce6d0d1f",
                                                "sense_id": "d31ec35b-c79e-349e-a097-9a7a61a4f35a",
                                                "text": "Le souci de l’actualité est l’essence du journalisme."
                                            },
                                            {
                                                "example_id": "eaff6c20-65ad-4dcf-bba2-75a0f30a589b",
                                                "sense_id": "d31ec35b-c79e-349e-a097-9a7a61a4f35a",
                                                "text": "Un bon journaliste est à l’affût des actualités. — Les actualités de la mode, du théâtre, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2193d38-7193-3f0d-b740-059403e85f7b",
                                        "entry_id": "de88e478-4cfb-3032-b19d-458321bd1745",
                                        "glosses": [
                                            "Journal télévisé d’informations."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa54e73d-c07d-49dc-81b9-dd90d1f468ee",
                                                "sense_id": "f2193d38-7193-3f0d-b740-059403e85f7b",
                                                "text": "Tous les soirs je regarde les actualités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b087503-baf0-3f6f-9c62-52c64f373669",
                                        "entry_id": "de88e478-4cfb-3032-b19d-458321bd1745",
                                        "glosses": [
                                            "Promotion médiatique, lors de la sortie d’un livre, du lancement d’un film ou d’un spectacle, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbc7599-3b33-4ab3-a6e9-b6fb9f776072",
                                                "sense_id": "5b087503-baf0-3f6f-9c62-52c64f373669",
                                                "text": "Il (le comédien Alex Lutz) est l’invité samedi de Nikos Aliagas dans l’émission Sortez du cadre pour parler de son actualité."
                                            },
                                            {
                                                "example_id": "d7d21126-993c-4628-8c53-bcd125ebda1e",
                                                "sense_id": "5b087503-baf0-3f6f-9c62-52c64f373669",
                                                "text": "Parfois en regardant son CV … on lui demandait quelle était son actualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e986b5-fb76-3060-8bfa-72b05986d502",
                                        "entry_id": "de88e478-4cfb-3032-b19d-458321bd1745",
                                        "glosses": [
                                            "Le présent, l’instant même."
                                        ],
                                        "tags": [
                                            "Vallée d’Aoste"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "actualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ced663ee-8710-3e62-b9c7-eae1a24ccc67",
                                        "entry_id": "597ca0f8-d3e0-328d-94ff-6a625bf9f6b0",
                                        "glosses": [
                                            "Caractère de ce qui s’est déjà accompli par opposition à ce qui est potentiel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3f70503-8fb8-4310-9b4b-076c4cb099cb",
                                                "sense_id": "ced663ee-8710-3e62-b9c7-eae1a24ccc67",
                                                "text": "Lorsque les scolastiques pensent à ce que nous appelons un processus temporel, ils ont dans l’esprit la transformation continue de la potentialité à l’actualité, comme celle qui conduit le gland au chêne et le chêne à la planche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
