            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7b462bf-e27b-3aa1-80d1-0ddbc9c1e7e8",
                    "sense_definition": "zonder enig nut of voordeel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nutteloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>nutteloos</w> om te proberen een kapotte paraplu in de storm te gebruiken.",
                            "target_lang_translations": {
                                "en": "It is <w>useless</w> to try to use a broken umbrella in the storm."
                            }
                        },
                        {
                            "text": "Zonder de juiste batterijen is dit elektronische speelgoed een <w>nutteloos</w> voorwerp.",
                            "target_lang_translations": {
                                "en": "Without the right batteries, this electronic toy is a <w>useless</w> object."
                            }
                        }
                    ],
                    "synonyms": [
                        "nutteloos",
                        "onbruikbaar",
                        "vergeefs"
                    ],
                    "antonyms": [
                        "nuttig",
                        "bruikbaar",
                        "zinvol"
                    ],
                    "common_phrases": [
                        "nutteloos voorwerp",
                        "totaal nutteloos"
                    ],
                    "target_lang_definitions": {
                        "en": "without any use or benefit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "useless",
                                "target_lang_sense_clarification": "without use or possibility to be used"
                            },
                            {
                                "target_lang_word": "unusable",
                                "target_lang_sense_clarification": "not fit to be used"
                            },
                            {
                                "target_lang_word": "pointless",
                                "target_lang_sense_clarification": "having no purpose or use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41cbfb24-33f6-39a9-a2a4-931866f9cda9",
                    "sense_definition": "zonder betekenis of doel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zinloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel mensen vinden het een <w>nutteloze</w> discussie omdat er toch niets zal veranderen.",
                            "target_lang_translations": {
                                "en": "Many people find it a <w>pointless</w> discussion because nothing will change anyway."
                            }
                        },
                        {
                            "text": "Hij voelde zich <w>nutteloos</w> toen hij zijn baan verloor en de hele dag thuis zat.",
                            "target_lang_translations": {
                                "en": "He felt <w>useless</w> when he lost his job and sat at home all day."
                            }
                        }
                    ],
                    "synonyms": [
                        "zinloos",
                        "betekenisloos",
                        "doelloos"
                    ],
                    "antonyms": [
                        "zinvol",
                        "waardevol"
                    ],
                    "common_phrases": [
                        "nutteloze discussie",
                        "nutteloze poging"
                    ],
                    "target_lang_definitions": {
                        "en": "without meaning or purpose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pointless",
                                "target_lang_sense_clarification": "of an action or discussion"
                            },
                            {
                                "target_lang_word": "useless",
                                "target_lang_sense_clarification": "feeling unhelpful or good-for-nothing"
                            },
                            {
                                "target_lang_word": "futile",
                                "target_lang_sense_clarification": "incapable of producing any useful result"
                            },
                            {
                                "target_lang_word": "meaningless",
                                "target_lang_sense_clarification": "having no meaning or significance"
                            }
                        ]
