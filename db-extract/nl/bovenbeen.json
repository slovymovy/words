                "translations": [
                    {
                        "translation_id": "950c5b9e-9db3-452c-a0af-84ed3e4f0356",
                        "source_entry_id": "5b828b91-8e3f-36fd-8337-56d43f4a42fa",
                        "source_sense_id": "a93f5607-d63d-39eb-b4e1-607ce2a030be",
                        "source_sense_description": "bovenbeen",
                        "target_lang_word": "Oberschenkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberschenkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81dc24da-7782-33b5-9244-e99b63efc80e",
                                        "entry_id": "fdccf0e8-afe9-32c3-aab8-10067e3d9bc4",
                                        "glosses": [
                                            "oberer Teil des Beines zwischen Knie und Becken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9f6598-61d7-4c76-abcb-34c022513107",
                                                "sense_id": "81dc24da-7782-33b5-9244-e99b63efc80e",
                                                "text": "Eine Verletzung am Oberschenkel verhindert eine weitere sportliche Karriere."
                                            },
                                            {
                                                "example_id": "1e8f600e-89e4-4c19-8aa9-6ae5808273ed",
                                                "sense_id": "81dc24da-7782-33b5-9244-e99b63efc80e",
                                                "text": "„Seine Oberschenkel waren verkrampft, aber er fühlte die Muskeln schlottern.“"
                                            },
                                            {
                                                "example_id": "63c80d8b-a1d0-47da-878d-ae846bf08f6c",
                                                "sense_id": "81dc24da-7782-33b5-9244-e99b63efc80e",
                                                "text": "„Sie ließ ihre Hand auf seinem Oberschenkel ruhen.“"
                                            },
                                            {
                                                "example_id": "c0b2bf16-6f55-4899-874b-98be189727b4",
                                                "sense_id": "81dc24da-7782-33b5-9244-e99b63efc80e",
                                                "text": "„Ihr ausladender Hintern und die breiten Oberschenkel sprachen zu mir von allem Weiblichen, das sich in ihr vereinte.“"
                                            },
                                            {
                                                "example_id": "f484d04c-8d41-4ac3-b5a9-985d7b273d52",
                                                "sense_id": "81dc24da-7782-33b5-9244-e99b63efc80e",
                                                "text": "„Die brennende Zigarette fiel ihm aber wieder aus dem Mund und blieb auf dem Oberschenkel liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1e2a6c1-c131-3ba8-992a-0b902734085c",
                                        "entry_id": "fdccf0e8-afe9-32c3-aab8-10067e3d9bc4",
                                        "glosses": [
                                            "Oberschenkelknochen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85d2263d-2824-468c-ac71-08802926d21c",
                                                "sense_id": "c1e2a6c1-c131-3ba8-992a-0b902734085c",
                                                "text": "Ich habe mir den Oberschenkel gebrochen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30586c31-abec-4469-9614-4e92125f7738",
                        "source_entry_id": "5b828b91-8e3f-36fd-8337-56d43f4a42fa",
                        "source_sense_id": "a93f5607-d63d-39eb-b4e1-607ce2a030be",
