                                        "glosses": [
                                            "The liquid enclosed inside the vacuole of a plant cell."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b3f262-6bee-4892-8fb6-3ba13a9b9bc9",
                                                "sense_id": "2120466d-2340-3041-924b-92ca89a9aaac",
                                                "text": "This region, which includes a transparent, or rarely colored, watery substance known as the cell sap, is called the vacuole, a term that comes from the Latin word for “empty.”"
                                            }
                                        ]
