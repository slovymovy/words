                        "sense_id": "8d5ff919-9d55-38cc-b7d0-af55bb965ad7",
                        "entry_id": "99f38289-8efb-3a46-a488-4ac59e8eff4c",
                        "glosses": [
                            "Juger soi-même (sa propre personne ou ce qu’on a fait)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0308fac5-1155-4434-be1c-35e909c0efb9",
                                "sense_id": "8d5ff919-9d55-38cc-b7d0-af55bb965ad7",
                                "text": "Dans son article « Ombre di romanzi manzoniani [Ombres des romans manzoniens] », Manzoni devient le paradigme pour « auto-juger » le roman effectivement écrit par Crispolti, Il duello, et un autre roman, Pie X, jamais écrit."
                            },
                            {
                                "example_id": "cbd6c082-7158-4537-a3e1-b54798555a5f",
                                "sense_id": "8d5ff919-9d55-38cc-b7d0-af55bb965ad7",
                                "text": "L'histoire est régie par une pensée qui a compris qu'elle a dans ses mains la capacité de s'auto-juger et de se connaître."
                            }
                        ]
                    }
