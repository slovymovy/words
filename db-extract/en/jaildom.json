                "entry_id": "fb92ab72-342f-3b53-b3a9-bad3a247cba1",
                "word": "jaildom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                        "entry_id": "fb92ab72-342f-3b53-b3a9-bad3a247cba1",
                        "glosses": [
                            "The state or condition of being jailed; imprisonment"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "841c9926-c368-4f48-9483-c988eebc0943",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "In the high society of jaildom his official standing would be several degrees below zero."
                            },
                            {
                                "example_id": "33111f58-0236-4a2d-b7cf-c132271edddd",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "The development of Borstal institutions means that young persons between the ages of sixteen and twenty-one seldom have to endure the taint of jaildom, and the new system of placing every possible accused adult on probation helps to reserve prisons almost entirely for habitual criminals."
                            },
                            {
                                "example_id": "8393853c-1f91-4f38-b216-0044eb53bafa",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "The feeling of jaildom deepened around them. Neither had ever seen the inside of a prison, but each felt that this surely was what a prison must be like."
                            },
                            {
                                "example_id": "64311e90-bb8a-46ff-b3e2-fa33ef36ff4e",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "[...] when you cannot control your followers and do not wish to lead them, get picked up by the police, you are in jail and you are not responsible for your responsibilities of leadership because you have embraced jaildom."
                            },
                            {
                                "example_id": "a8d4afbd-a55e-4d11-a285-1d659c61544e",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "He clanged our way to the far end where the \"better element\" of jaildom, the high-swindlers and bootleggers were kept."
                            },
                            {
                                "example_id": "b85f4fde-5b1c-4b22-9888-337b2fa6727f",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "I tucked Marie in and let Vinnie out of his kitty jaildom."
                            },
                            {
                                "example_id": "46c4e281-c32e-4a99-baa5-3c6db40773b1",
                                "sense_id": "1d236829-a160-368e-ae74-c879f3fba224",
                                "text": "It'll be almost two years of jaildom soon. Unbelievable!"
                            }
                        ]
                    }
                ],
