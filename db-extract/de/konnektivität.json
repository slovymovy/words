                "senses": [
                    {
                        "sense_id": "b2ae2085-5506-37c3-8edd-2b1b5aa54089",
                        "entry_id": "39d1525b-acf0-3c5d-bc72-133f5f5183d4",
                        "glosses": [
                            "Eigenschaft als Programm/System, Verbindungen zu anderen Systemen herstellen (konnektieren) zu können"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "a2ded53d-d9f3-41d6-b090-12343813b07b",
                                "sense_id": "b2ae2085-5506-37c3-8edd-2b1b5aa54089",
                                "text": "„Allerdings ist eine Besonderheit des Cloud Computing die zur Nutzung der betreffenden Dienste erforderliche Konnektivität: ohne Konnektivität keine Cloud. Konnektivität wiederum erfordert einen Telekommunikationsdienst.“"
                            },
                            {
                                "example_id": "2d7deefa-de56-4287-af8f-6d7abdfbff0a",
                                "sense_id": "b2ae2085-5506-37c3-8edd-2b1b5aa54089",
                                "text": "„Wir entdeckten, dass die Netzwerke – die Welt der Konnektivität – fantastisch geeignet sind für unser mit Arbeit und Terminen vollgestopftes, durch die Netzwerke erst möglich gewordenes Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
