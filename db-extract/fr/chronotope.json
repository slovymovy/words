                        "entry_id": "65b7620a-4c58-330b-a2fe-1597ed28bf78",
                        "glosses": [
                            "Matrice spatio-temporelle où se développe l’action d’un récit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "365cf5d5-d7e2-4f29-8db5-02b4d0d3525c",
                                "sense_id": "8030c727-4a50-3780-b55a-ee83f8e6f416",
                                "text": "Le chronotope concerne donc au fond l’appréhension, sur un plan existentiel, du monde extérieur suivant la configuration et la fonction de l’espace-temps du récit."
                            }
                        ]
                    }
                ],
