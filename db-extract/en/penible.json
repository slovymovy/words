                        "examples": [
                            {
                                "example_id": "4bf4a0e4-9277-4032-a3cd-524a62a21a1a",
                                "sense_id": "4ecefb1d-254b-3740-abba-4c5c002fe446",
                                "text": "The encroachments of these men, who are aware of their power, often has rendered the residence of a European among the tribes, the most penible state of existence."
                            },
                            {
                                "example_id": "2821fa80-9da9-4b2f-8753-50cb911b7b92",
                                "sense_id": "4ecefb1d-254b-3740-abba-4c5c002fe446",
                                "text": "This was the most \"penible\" portion of the walk, for although not very steep, the loose and slippery boulders, which covered the surface, made it so insecure that great care was necessary."
                            }
                        ]
                    }
