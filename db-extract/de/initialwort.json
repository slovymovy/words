                                    {
                                        "sense_id": "6633daba-02ba-3efa-8f11-3709002d274c",
                                        "entry_id": "e05650be-e242-3ea2-8431-9c19e2db63e0",
                                        "glosses": [
                                            "A term formed from the initial letters of several words or parts of words, which is itself pronounced letter by letter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c6abb9-8a3a-4b84-b2f5-d2f9c82f54ac",
                                                "sense_id": "6633daba-02ba-3efa-8f11-3709002d274c",
                                                "text": "The BBC is an initialism for the British Broadcasting Corporation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15976ca0-1c0a-3b4d-a503-3dac8a27ca5c",
                                        "entry_id": "e05650be-e242-3ea2-8431-9c19e2db63e0",
                                        "glosses": [
                                            "The process of forming words or terms using initial letters of other words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f9dc746-e46e-4945-85dd-bdae2f9f72d1",
                                                "sense_id": "15976ca0-1c0a-3b4d-a503-3dac8a27ca5c",
                                                "text": "The next most frequent source language was English, with neologistic compounds accounting for 15 etymologies, with 9 other English-based terms from a variety of word formation processes such as initialism and semantic extension."
                                            }
