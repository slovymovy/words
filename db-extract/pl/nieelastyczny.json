                                        "sense_id": "75885b43-a302-305e-a1ca-10ce4d3445f0",
                                        "entry_id": "95eed094-f773-375a-be99-76d0aed519fc",
                                        "glosses": [
                                            "Lacking elasticity; inflexible, unyielding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c8fb3fb-3fe8-4668-b5e5-fb3794d06bfe",
                                                "sense_id": "75885b43-a302-305e-a1ca-10ce4d3445f0",
                                                "text": "He spoke languidly, and only those few words, like a watch with an inelastic spring, that just ticks a moment or two and stops again."
                                            },
                                            {
                                                "example_id": "3d9d670a-c356-439b-a279-d6ac70e89a04",
                                                "sense_id": "75885b43-a302-305e-a1ca-10ce4d3445f0",
                                                "text": "I cannot believe that Christ himself intended that his religion should be so inelastic, so hard and fast, so cruel as you imply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c73d3c8-e1be-3d65-9e3b-363512db3b62",
                                        "entry_id": "95eed094-f773-375a-be99-76d0aed519fc",
                                        "glosses": [
                                            "Insensitive to changes in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546b7534-993f-4d17-925e-047fb4142c1d",
                                                "sense_id": "7c73d3c8-e1be-3d65-9e3b-363512db3b62",
                                                "text": "perfectly inelastic supply"
                                            },
                                            {
                                                "example_id": "8c22650d-536a-46f3-ae5b-7bbd6c2e80d2",
                                                "sense_id": "7c73d3c8-e1be-3d65-9e3b-363512db3b62",
                                                "text": "A different approach is needed now, as there is more discretionary travel which, unlike the use of season tickets, does not have inelastic demand characteristics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b3ffdd-1d26-318e-b674-d8c6af826e37",
