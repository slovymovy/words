                                            {
                                                "example_id": "2dddcb9d-1239-44f2-9638-7a0d094772fd",
                                                "sense_id": "52256f7f-18ef-32db-9d78-877a91027634",
                                                "text": "Pełen goryczy list napisał do Baracka Obamy Amerykanin Alan Gross, który siedzi w więzieniu za szpiegostwo"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7ebf5bde-0675-39db-a42a-811e1ce867ed",
                                        "entry_id": "1f6f848d-99bc-33a2-bec0-fa46e49ce022",
                                        "glosses": [
                                            "członek plemienia Alanów (przodek Osetyńca)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b1270f-4c23-4c99-b337-9c0eb6d6232e",
                                                "sense_id": "7ebf5bde-0675-39db-a42a-811e1ce867ed",
                                                "text": "W 463 roku z rozkazu Egidiusza Alanowie najechali na Italię. Zostali pobici w bitwie pod Bergamo i musieli się wycofać"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63be0073-ec58-43d0-8484-f786889c1aeb",
