                        "entry_id": "84e687c9-b07a-3a8e-b604-78f5d2a3fa38",
                        "glosses": [
                            "Qualifie un monstre formé de deux individus réunis par le sommet de la tête, par opposition aux monstres métopages, où les têtes se font face ou se côtoient, et aux monstres céphalopages, où les têtes sont jointes en directions opposées (le front de l’une se joignant à l’occiput de l’autre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c634a98a-7adb-46a3-bfcc-3cbd835f10f7",
                                "sense_id": "d26df1af-da5d-3ef9-8b84-ff18a9567dca",
                                "text": "Les jumeaux thoracopages (unis par le thorax) sont les plus fréquents et les craniopages (unis par la tête) semblent les plus rares."
                            },
                            {
                                "example_id": "0187fac7-883b-4b82-b370-22c7b7be9fb6",
                                "sense_id": "d26df1af-da5d-3ef9-8b84-ff18a9567dca",
                                "text": "Un monstre craniopage."
                            }
                        ]
                    }
                ],
