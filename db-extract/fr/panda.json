        "fr-extract.jsonl": [
            {
                "entry_id": "a154fdcc-5fe4-3bf8-b033-b8e5fec40095",
                "word": "panda",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71826bf6-757e-404c-bb1e-5dbce84a0006",
                        "entry_id": "a154fdcc-5fe4-3bf8-b033-b8e5fec40095",
                        "tags": [
                            "plural"
                        ],
                        "form": "pandas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c79f3a89-34fe-3b67-8fbb-6193667b2e6a",
                        "entry_id": "a154fdcc-5fe4-3bf8-b033-b8e5fec40095",
                        "glosses": [
                            "Nom partagé par deux espèces de mammifères :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b2f77ac-8d85-463f-9067-f75758edcea7",
                                "sense_id": "c79f3a89-34fe-3b67-8fbb-6193667b2e6a",
                                "text": "Les pandas sont deux espèces très menacées."
                            },
                            {
                                "example_id": "7bcce5f8-6787-40b6-81d1-1e75e76e83c8",
                                "sense_id": "c79f3a89-34fe-3b67-8fbb-6193667b2e6a",
                                "text": "Choko Lablanc, le petit panda, n’a jamais reçu de fessée ! Incroyable ! Tous ses copains ont fait cette expérience et lui pas. Qu'est-ce qu’il rêve de recevoir une sacrée bonne fessée ! Encore faut-il la mériter…"
                            },
                            {
                                "example_id": "efc020af-47b6-4b4f-b026-769e7bb4797a",
                                "sense_id": "c79f3a89-34fe-3b67-8fbb-6193667b2e6a",
                                "text": "Le Sichuan, très montagneux et connu dans le monde entier pour ses réserves de pandas, est généralement frappé plusieurs fois par mois par des séismes d’intensités variables."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee252ff4-1f92-3e58-8840-eeb25921a907",
                        "entry_id": "a154fdcc-5fe4-3bf8-b033-b8e5fec40095",
                        "glosses": [
                            "Nom partagé par deux espèces de mammifères :",
                            "le panda géant, ursidé blanc et noir vivant principalement en Chine et se nourrissant exclusivement de bambous. (Ailuropoda melanoleuca sur Wikispecies .)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "35c3bf16-bf81-3b3a-95d0-31de12f2910c",
                        "entry_id": "a154fdcc-5fe4-3bf8-b033-b8e5fec40095",
                        "glosses": [
                            "Nom partagé par deux espèces de mammifères :",
                            "le panda roux, qui ressemble au raton laveur. (Ailurus fulgens sur Wikispecies .)"
                        ],
                        "tags": [],
                        "examples": []
                    }
