                        "glosses": [
                            "Femme qui assure une réanimation ; femme médecin ou infirmière qui travaille dans les réanimations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053b2284-92fd-49e9-8097-563da97b1df8",
                                "sense_id": "7d112374-2572-3967-8d40-ceedd2ae6805",
                                "text": "« Tu es notre disque d’or » lui avait dit Marie, une infirmière réanimatrice du service dans lequel Pone venait de passer deux mois."
                            },
                            {
                                "example_id": "f65000dd-e8a3-4a50-8f87-46e2ed199aa7",
                                "sense_id": "7d112374-2572-3967-8d40-ceedd2ae6805",
                                "text": "« Ce ne sont pas des manipulations syndicales mais des revendications qui remontent de la base , explique Nicole Smolski, médecin réanimatrice à l’hôpital de la Croix Rousse et membre du Syndicat national des praticiens hospitaliers. … »"
                            }
                        ]
