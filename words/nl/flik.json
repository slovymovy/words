                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>flik</w> dat klusje wel even voor je.",
                            "target_lang_translations": {
                                "ru": "Я <w>сделаю</w> это дельце для тебя."
                            }
                        },
                        {
                            "text": "Ik <w>flik</w> het hem om op tijd te komen.",
                            "target_lang_translations": {
                                "ru": "Я <w>ухитряюсь</w> прийти вовремя."
                            }
                        }
                    ],
                    "traits": [
