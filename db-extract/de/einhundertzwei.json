            {
                "entry_id": "f9cd6182-ef61-3157-ade5-54c5e4b23d19",
                "word": "einhundertzwei",
                "pos": "num",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a1245e2b-92f6-3786-94d8-25025d093551",
                        "entry_id": "f9cd6182-ef61-3157-ade5-54c5e4b23d19",
                        "glosses": [
                            "die Kardinalzahl zwischen 101 und 103; hundert und zwei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce237e3f-cb6d-45e1-b53f-d988da686fad",
                                "sense_id": "a1245e2b-92f6-3786-94d8-25025d093551",
                                "text": "„Und mit seinem an Unsterblichkeit grenzenden Alter von einhundertzwei Jahren blickte er auf ein unzählbares Heer von Nachkömmlingen, die namentlich in die Fußstapfen ihrer großen Vorfahren traten.“"
                            },
                            {
                                "example_id": "9debbb92-6ea2-4516-8bad-e73cd4e665ff",
                                "sense_id": "a1245e2b-92f6-3786-94d8-25025d093551",
                                "text": "„Er wurde beschuldigt, so die Anklageschrift, den Tod von einhundertzwei »orientalischen menschlichen Wesen« verursacht zu haben.“"
                            },
                            {
                                "example_id": "5670763e-2e1e-43e8-bf7b-751140da0d2b",
                                "sense_id": "a1245e2b-92f6-3786-94d8-25025d093551",
                                "text": "„In fünfzehn Jahren hatte er, soweit bekannt, einhundertzwei Namen und achtundneunzig Markierungen genutzt[.]“"
                            },
                            {
                                "example_id": "ddb77446-b8e1-4b5f-b746-344d256a551d",
                                "sense_id": "a1245e2b-92f6-3786-94d8-25025d093551",
                                "text": "„Von hier aus kann man den Gaskessel schon sehen, dreihundertausend Kubikmeter Inhalt bei einhundertzwei Metern Höhe.“"
                            },
                            {
                                "example_id": "736caefa-6a62-4422-aca0-79a0b4ec8ac8",
                                "sense_id": "a1245e2b-92f6-3786-94d8-25025d093551",
                                "text": "„Die Wahl der einhundertzwei Stadtverordneten fand nach langwierigen Vorbereitungen vom 18. bis 22. April 1809 in zweiundzwanzig Berliner Kirchen statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
