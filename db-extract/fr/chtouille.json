        "fr-extract.jsonl": [
            {
                "entry_id": "4246e076-2646-33bb-bef3-c9d09c4e6d72",
                "word": "chtouille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b062073-4412-43a8-a119-00931edb7919",
                        "entry_id": "4246e076-2646-33bb-bef3-c9d09c4e6d72",
                        "tags": [
                            "plural"
                        ],
                        "form": "chtouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b49eadbb-71a8-328a-85ba-084e0e2d7452",
                        "entry_id": "4246e076-2646-33bb-bef3-c9d09c4e6d72",
                        "glosses": [
                            "Maladie sexuellement transmissible appelée aussi familièrement chaude-pisse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "113b1cbb-92f8-4635-bc3d-70ef9e541890",
                                "sense_id": "b49eadbb-71a8-328a-85ba-084e0e2d7452",
                                "text": "Il ne sait même pas qui lui a refilé la chtouille, il ne prend aucune précaution."
                            },
                            {
                                "example_id": "c7567f8d-2731-43f7-bcb2-8cb15cb5da44",
                                "sense_id": "b49eadbb-71a8-328a-85ba-084e0e2d7452",
                                "text": "Garnéro, dit Chaude-Pisse, parce qu'il l'avait, — et une chtouille carabinée ! — un barbeau de la Fourche, où il tenait ses assises dans le grand bar-tabac du coin, avenues de Clichy et de Saint-Ouen, était le plus dégourdi de l'escouade et n'avait pas froid aux yeux."
                            },
                            {
                                "example_id": "6a91c93d-2c12-48bc-9fd4-20fc5e307b4b",
                                "sense_id": "b49eadbb-71a8-328a-85ba-084e0e2d7452",
                                "text": "— Ah ! c’est vous, l’amoureux ! Bravo ! Vaut mieux ça que d’attraper la chtouille, encore que ce soit pas incompatible. Des fois, ça marche ensemble mais je vous le souhaite pas."
                            },
                            {
                                "example_id": "7d78360b-aaac-4706-8c30-fb8f43d3d8bd",
                                "sense_id": "b49eadbb-71a8-328a-85ba-084e0e2d7452",
                                "text": "[…]. Frank est pas con au point d'épouser un paillasson pareil.\n— T'es jaloux, gros porc, de n'avoir jamais pu me sauter.\n— J'aurais eu trop peur d’attraper la chtouille !"
                            },
                            {
                                "example_id": "f53c162b-7ef2-496f-8aa2-fc998b36abb0",
                                "sense_id": "b49eadbb-71a8-328a-85ba-084e0e2d7452",
                                "text": "Ou alors... c’est une femme qui t’a refilé une chtouille ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "39ce6ea0-1a4f-3d17-a40d-8c822f2c14bb",
                        "entry_id": "4246e076-2646-33bb-bef3-c9d09c4e6d72",
                        "glosses": [
                            "Décharge électrique."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6d8cd935-9eba-496c-a22f-bea9ed43277f",
                                "sense_id": "39ce6ea0-1a4f-3d17-a40d-8c822f2c14bb",
                                "text": "J’ai pris une chtouille terrible en touchant l’interrupteur."
                            }
                        ]
                    }
                ],
