            {
                "entry_id": "05d57a92-129a-3b8f-8b59-50126a4b599e",
                "word": "Saint-Laurent",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "feaf1b8d-14d2-35fa-a758-fe37d611649a",
                        "entry_id": "05d57a92-129a-3b8f-8b59-50126a4b599e",
                        "glosses": [
                            "Fleuve du Canada, coulant du lac Ontario, le plus oriental des Grands Lacs, jusqu’à l’Atlantique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92be5e3f-2789-4d29-88cc-abb9e5141643",
                                "sense_id": "feaf1b8d-14d2-35fa-a758-fe37d611649a",
                                "text": "Cartier appelait le fleuve Saint-Laurent du nom de « rivière du Canada », nom qui a été utilisé par tous les navigateurs jusqu'au début du XVllᵉ siècle."
                            },
                            {
                                "example_id": "5116210a-3640-4f5e-885a-2aef72db5df5",
                                "sense_id": "feaf1b8d-14d2-35fa-a758-fe37d611649a",
                                "text": "Des hommes-araignées s’affairent depuis quelques semaines à inspecter la structure du pont Laviolette, qui enjambe le fleuve Saint-Laurent."
                            },
                            {
                                "example_id": "b5dcf8ef-2d77-4fdc-839b-46c13ffae1ea",
                                "sense_id": "feaf1b8d-14d2-35fa-a758-fe37d611649a",
                                "text": "Note : Au Québec, on utilise fréquemment l’apocope le fleuve.",
                                "translation": "La répétition de ces images est une autre façon de s'approprier le territoire, car dans l'imaginaire poétique de Perreault, le fleuve a une importance capitale. Il est essentiel pour définir l'identité collective des Québécois. — (Mathieu Bureau Meunier, Wake up mes bons amis!, Québec, Septentrion, 2019, page 124)"
                            }
                        ]
                    },
                    {
                        "sense_id": "e82cb574-281d-31f8-9c39-74308feb3e01",
                        "entry_id": "05d57a92-129a-3b8f-8b59-50126a4b599e",
                        "glosses": [
                            "Arrondissement de la ville de Montréal au Québec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7903c6-d93e-4fc3-9711-893e18107a09",
                                "sense_id": "e82cb574-281d-31f8-9c39-74308feb3e01",
                                "text": "«Moi j’ai 30 ans et j’ai grandi à Ville Saint-Laurent. Les jeunes qui ont 10 ans aujourd’hui vivent la même chose que j’ai vécue moi à 10 ans. (...)."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b9c16f8-3003-3b0f-9de9-eae55cedffe9",
                        "entry_id": "05d57a92-129a-3b8f-8b59-50126a4b599e",
                        "glosses": [
                            "Village de l’île d’Orléans au Québec."
                        ],
                        "tags": [],
                        "examples": []
                    }
