                "senses": [
                    {
                        "sense_id": "254a7f79-5508-3170-b542-9508777be129",
                        "entry_id": "d50eae23-b4d6-3f8e-86d4-eb6abc8851b4",
                        "glosses": [
                            "Kalkulator zur Berechnung eines Tilgungsplans für die Immobilienfinanzierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017c5e2c-84f6-4d0d-94f7-bdc03957779d",
                                "sense_id": "254a7f79-5508-3170-b542-9508777be129",
                                "text": "Ein Finanzierungsrechner ermittelt für Sie die über die jeweilige Laufzeit anfallenden Ratenzahlungen, Zinsen und Tilgungsbeträge."
                            },
                            {
                                "example_id": "0375e480-afc6-4bd2-a494-cacebb65a4f5",
                                "sense_id": "254a7f79-5508-3170-b542-9508777be129",
                                "text": "„Bei der Raiffeisen Bausparkasse lassen sich mittels \"Finanzierungsrechner\" die optimalen Finanzierungsvarianten berechnen.“"
                            },
                            {
                                "example_id": "8d69652a-94d6-4948-ac81-fef4f3fe3c7d",
                                "sense_id": "254a7f79-5508-3170-b542-9508777be129",
                                "text": "„Wir vom Stern wollen Ihnen mit unserem praktischen Finanzierungsrechner und diesem Ratgeber tatkräftig helfen, sich den Traum von der eigenen Wohnung endlich zu erfüllen.“"
                            },
                            {
                                "example_id": "d3f9d12b-0dd6-4536-b9d1-ad5b81c698b9",
                                "sense_id": "254a7f79-5508-3170-b542-9508777be129",
                                "text": "„Die AK kritisiert dabei auch die oft versteckten Informationen rund um die Ratenzahlungen. Zehn von 17 Anbietern geben demnach auf ihrer Website den effektiven Jahreszins an, einen Finanzierungsrechner haben nur vier von 17.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
