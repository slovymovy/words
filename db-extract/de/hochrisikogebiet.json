                "senses": [
                    {
                        "sense_id": "72adc1f1-e926-3cc4-a2c3-ab51568f917d",
                        "entry_id": "8f33dd26-c55a-3296-9166-f059a0e1f997",
                        "glosses": [
                            "Region (Gebiet) in der die Wahrscheinlichkeit von einem negativen Ereignis betroffen zu werden (Risiko) sehr groß ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75baf3d0-067e-470a-af5c-f7240b0a2f2b",
                                "sense_id": "72adc1f1-e926-3cc4-a2c3-ab51568f917d",
                                "text": "Coronapandemie: „Der Kreis hat nach der Mecklenburgischen Seenplatte ebenfalls den entscheidenden Grenzwert überschritten und gilt nun als Hochrisikogebiet.“"
                            },
                            {
                                "example_id": "ae8bf7b7-cf26-462c-8d70-4046c9d90e79",
                                "sense_id": "72adc1f1-e926-3cc4-a2c3-ab51568f917d",
                                "text": "Piraterie: „Nicht nur die Schifffahrtsindustrie sondern auch Strafverfolgungsbehörden weltweit nutzen das Datenmaterial des IMB Piracy Reporting Centers. Auf der Basis der Daten des IMBs intensivieren nationale Polizei- und Marinebehörden oftmals ihre Einsatzkräfte in Hochrisikogebieten.“"
                            },
                            {
                                "example_id": "7cb2f612-3d49-4502-a0e1-b422101e77ee",
                                "sense_id": "72adc1f1-e926-3cc4-a2c3-ab51568f917d",
                                "text": "Somalia ist für Besucher aus dem Ausland ein einziges Hochrisikogebiet, überall drohen Entführungen, Schießereien, Morde oder Attentate."
                            }
                        ],
                        "sense_index_json": "\"1\""
