                                        "entry_id": "6faba436-da60-31ea-89dc-c495f7363ee3",
                                        "glosses": [
                                            "eine westgermanische Sprache, die in Schottland gesprochen wird; wird auch als Dialekt des Englischen angesehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7a9311-25ae-4b39-82d9-6a033462acd9",
                                                "sense_id": "5a4e3143-789d-3389-ad1f-8dd19a95a7f5",
                                                "text": "„Durch die Reformation verlor Scots an Bedeutung, blieb aber Alltagssprache und Gegenstand wiederholter Bemühungen, es als Literatursprache zu erhalten.“"
                                            },
                                            {
                                                "example_id": "b10a2a7e-37ae-43ac-bcfe-48216c61097f",
                                                "sense_id": "5a4e3143-789d-3389-ad1f-8dd19a95a7f5",
                                                "text": "„Vom Scots zu trennen ist jedoch das ›Highland and Island English‹, ein vom Gälischen beeinflusstes (schottisches) Standardenglisch[…]“"
                                            },
                                            {
                                                "example_id": "a750d4a0-dc64-4288-8b4d-d556b2d46ca7",
                                                "sense_id": "5a4e3143-789d-3389-ad1f-8dd19a95a7f5",
                                                "text": "„In den Städten sprach man Scots, eine angelsächsische Sprache durchsetzt mit skandinavischen Elementen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
