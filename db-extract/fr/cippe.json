                                    {
                                        "sense_id": "27154d44-cf45-3c3c-b589-6599ca0fbf73",
                                        "entry_id": "fde8f1ea-4733-38b2-9466-75bf4caa8ea8",
                                        "glosses": [
                                            "A small, low pillar, square or round, commonly having an inscription, used by the ancients for various purposes, as for indicating the distances of places, for a landmark, for sepulchral inscriptions, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dff3ff9-49c8-409b-99bd-806777765768",
                                                "sense_id": "27154d44-cf45-3c3c-b589-6599ca0fbf73",
                                                "text": "[…]lodged on the top of an ancient sepulchral cippus"
                                            },
                                            {
                                                "example_id": "10307183-433b-4144-84d9-3f9b7b7e31a5",
                                                "sense_id": "27154d44-cf45-3c3c-b589-6599ca0fbf73",
                                                "text": "[A] cippus, found at Valencia in Spain, has on one of its sides Fatus Q. Fabius ex voto, and on the other, three female figures, with the attributes of the Mœræ or Parcæ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17be3154-786e-3a36-a449-0a1aebb3beb7",
