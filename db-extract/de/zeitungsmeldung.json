                "senses": [
                    {
                        "sense_id": "d4e8a447-1dbe-33a8-9d58-c1d3dfb155c4",
                        "entry_id": "e6177641-085a-39fe-b469-4b5adb420c6e",
                        "glosses": [
                            "eine Meldung oder Nachricht, die in einer Zeitung abgedruckt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b969e86-041f-4038-90b7-75532b88f50e",
                                "sense_id": "d4e8a447-1dbe-33a8-9d58-c1d3dfb155c4",
                                "text": "Eine Zeitungsmeldung ist eine journalistische Textsorte, die überwiegend Faktenwissen über Ereignisse vermittelt."
                            },
                            {
                                "example_id": "cc47627e-ecaf-4c39-bdbc-c7d239ef5618",
                                "sense_id": "d4e8a447-1dbe-33a8-9d58-c1d3dfb155c4",
                                "text": "„Dass diese persönliche Rivalität bis heute schwelt und mitunter bizarre Züge annimmt, zeigt eine Zeitungsmeldung vom August 2012.“"
                            },
                            {
                                "example_id": "4f76145e-341d-4656-8702-8e7768e11d8e",
                                "sense_id": "d4e8a447-1dbe-33a8-9d58-c1d3dfb155c4",
                                "text": "„In Gedanken gehen alle die Zeitungsmeldungen der letzten Wochen durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
