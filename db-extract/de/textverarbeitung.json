                        "target_lang_word": "traitement de texte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traitement de texte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec1f3ae-1ecb-37c9-83e4-8c10a8417b70",
                                        "entry_id": "b294d69a-c39e-315e-b3e3-302753708f73",
                                        "glosses": [
                                            "Logiciel de traitement de texte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0523b8c-035e-465a-8306-11b15f38bd27",
                                                "sense_id": "6ec1f3ae-1ecb-37c9-83e4-8c10a8417b70",
                                                "text": "Ma fille tient à me moderniser et me convainc de me mettre à l'ordinateur. Je reconnais rapidement les vertus du clavier électronique et découvre les avantages du système Windows, même si j'ai soutenu pendant cinq ans que je n'avais aucun besoin de traitement de texte. J'entends Miron : « Mes textes ne sont pas malades ! »"
                                            },
                                            {
                                                "example_id": "a8472b10-e746-4520-b602-167d176542d1",
                                                "sense_id": "6ec1f3ae-1ecb-37c9-83e4-8c10a8417b70",
                                                "text": "Il n’y avait pas alors de traitement de texte et les machines à écrire cliquetaient avec entrain."
                                            },
                                            {
                                                "example_id": "2c0f5846-4bf7-4107-a41e-8f4826183921",
                                                "sense_id": "6ec1f3ae-1ecb-37c9-83e4-8c10a8417b70",
                                                "text": "C’est le signal pour entrer le code qui permet d’accéder au traitement de texte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
