                            {
                                "example_id": "937e0331-474e-4270-aef8-9b0991fd5c82",
                                "sense_id": "e02cbf7b-2c17-363e-a3c3-35ccc1100f0c",
                                "text": "Tenslotte mag men van wetenschap en techniek niet het (menselijk) geluk verwachten; zij dragen daar onrechtstreeks wel krachtig toe bij door het scheppen van betere materiële bestaansvoorwaarden, door het bestrijden van fysiek lijden (geneeskunde), door het verschaffen van beter inzicht in de zo gecompliceerde menselijke gedragingen (biologie, psychologie, sociologie)."
                            }
                        ]
