                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apatyt",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b2801552-835f-30a9-8595-cb701bef22da",
                                        "entry_id": "c620292b-e42c-3dbb-95af-8f28b3bb0b0d",
                                        "glosses": [
                                            "minerał z gromady fosforanów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
