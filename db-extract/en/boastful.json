                                                "sense_id": "386ed7f2-0320-3ffa-9dce-115541e69e45",
                                                "text": "Der Eiffelturm ist ein stolzes Gebäude."
                                            },
                                            {
                                                "example_id": "6817aa11-00d0-437e-bbc9-294f13df419c",
                                                "sense_id": "386ed7f2-0320-3ffa-9dce-115541e69e45",
                                                "text": "Die „Queen Mary II“ ist ein stolzes Schiff."
                                            }
                                        ],
