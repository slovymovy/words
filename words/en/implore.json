{
    "word_family": [
        "imploration",
        "imploringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "650d9c65-4fae-3d9b-8015-d9bcf1b646a9",
                    "sense_definition": "To beg or plead for something earnestly or urgently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "begging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees <w>implored</w> the government for immediate humanitarian aid and protection.",
                            "target_lang_translations": {
                                "ru": "Беженцы <w>умоляли</w> правительство о немедленной гуманитарной помощи и защите."
                            }
                        },
                        {
                            "text": "She <w>implored</w> his forgiveness after realizing the gravity of her mistake.",
                            "target_lang_translations": {
                                "ru": "Она <w>молила</w> его о прощении, осознав всю тяжесть своей ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "beseech",
                        "entreat",
                        "beg"
                    ],
                    "common_phrases": [
                        "implore for mercy",
                        "implore for help"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горячо, с мольбой или настойчиво просить о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "страстно просить о чем-либо, молить о помощи или пощаде"
                            },
                            {
                                "target_lang_word": "молить",
                                "target_lang_sense_clarification": "возносить горячие мольбы о чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29ace572-e464-311e-a19c-5b143997c536",
                    "sense_definition": "To beg or plead that someone earnestly or urgently do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "begging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>implore</w> you to reconsider your decision before it is too late.",
                            "target_lang_translations": {
                                "ru": "Я <w>умоляю</w> вас пересмотреть свое решение, пока не стало слишком поздно."
                            }
                        },
                        {
                            "text": "The doctor <w>implored</w> the patient to follow the treatment plan strictly.",
                            "target_lang_translations": {
                                "ru": "Врач <w>убедительно просил</w> пациента строго следовать плану лечения."
                            }
                        }
                    ],
                    "synonyms": [
                        "beseech",
                        "entreat",
                        "urge"
                    ],
                    "common_phrases": [
                        "implore someone to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчиво или слезно просить кого-либо сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "просить кого-либо совершить действие"
                            },
                            {
                                "target_lang_word": "заклинать",
                                "target_lang_sense_clarification": "настоятельно и эмоционально призывать к действию"
                            },
                            {
                                "target_lang_word": "упрашивать",
                                "target_lang_sense_clarification": "настойчиво склонять к согласию что-то сделать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6dd9a0a-4f6a-3cf7-8ec2-4a135382c73e",
                    "sense_definition": "To express an earnest or urgent plea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "begging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop, she <w>implored</w> with tears in her eyes.",
                            "target_lang_translations": {
                                "ru": "«Пожалуйста, прекрати», — со слезами на глазах <w>умоляла</w> она."
                            }
                        },
                        {
                            "text": "Do not leave me here alone, he <w>implored</w> desperately.",
                            "target_lang_translations": {
                                "ru": "«Не оставляй меня здесь одного», — отчаянно <w>молил</w> он."
                            }
                        }
                    ],
                    "synonyms": [
                        "plead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться с отчаянной или слезной просьбой; молить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "выражать горячую мольбу"
                            },
                            {
                                "target_lang_word": "молить",
                                "target_lang_sense_clarification": "обращаться со слезной просьбой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52b27185-8232-316d-8bc9-280d7280ad05",
                    "sense_definition": "An act of begging or pleading earnestly or urgently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "begging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His desperate <w>implore</w> for a second chance went completely ignored by the board.",
                            "target_lang_translations": {
                                "ru": "Его отчаянная <w>мольба</w> о втором шансе была полностью проигнорирована советом директоров."
                            }
                        },
                        {
                            "text": "She could not resist his heartfelt <w>implore</w> to stay just a little longer.",
                            "target_lang_translations": {
                                "ru": "Она не смогла устоять перед его искренней <w>мольбой</w> остаться еще хоть немного."
                            }
                        }
                    ],
                    "synonyms": [
                        "entreaty",
                        "plea"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Горячая, отчаянная просьба или мольба (устаревшее или книжное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "страстная просьба"
                            },
                            {
                                "target_lang_word": "просьба",
                                "target_lang_sense_clarification": "настойчивое обращение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}