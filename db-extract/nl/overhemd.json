                "senses": [
                    {
                        "sense_id": "8182615c-34a6-3e88-8c1b-2db6fe26bb29",
                        "entry_id": "755d8ecc-c171-3ad5-821d-094a14f21083",
                        "glosses": [
                            "een kledingstuk voor het bovenlichaam van fijne stof met voorsluiting en kraag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdc5a3e-a404-46cb-b92f-2402ba730947",
                                "sense_id": "8182615c-34a6-3e88-8c1b-2db6fe26bb29",
                                "text": "Je moet wel netjes een overhemd aandoen."
                            },
                            {
                                "example_id": "45c16b94-d6f4-42b1-a7b2-8fdf44c7895e",
                                "sense_id": "8182615c-34a6-3e88-8c1b-2db6fe26bb29",
                                "text": "Barbara had een stelletje hippe types bij elkaar verzameld, meisjes met lang haar en korte jurkjes, jongens met hun overhemd half open, die eruitzagen alsof ze wel een scheerbeurt konden gebruiken."
                            },
                            {
                                "example_id": "43462790-ea43-42b9-85a1-7f6f5135fa5a",
                                "sense_id": "8182615c-34a6-3e88-8c1b-2db6fe26bb29",
                                "text": "Nog voordat ik mijn pakken en overhemden ging uithangen in de kleerkast in de achterkamer, voerde ik het ritueel uit waarmee ik het bureau als mijn territorium markeerde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ee842a4-f959-4c58-b3fe-de28854193cd",
                        "source_entry_id": "755d8ecc-c171-3ad5-821d-094a14f21083",
                        "source_sense_id": "8182615c-34a6-3e88-8c1b-2db6fe26bb29",
                        "target_lang_word": "Oberhemd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberhemd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a83a8d4c-1b71-31a1-b5f6-c30096bc818a",
                                        "entry_id": "77a32713-2c19-368a-9ecf-3762f98be32c",
                                        "glosses": [
                                            "Teil der Oberbekleidung für den Oberkörper, vor allem für Männer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca69581c-8e5e-48c6-94a3-e6c51408cc1c",
                                                "sense_id": "a83a8d4c-1b71-31a1-b5f6-c30096bc818a",
                                                "text": "„Dann antwortet sie mit einer Gegenfrage: \"Wer will seinen Kindern denn so was antun? Mit der Autorität einer Wissenschaftlerin erklärt mir Frau Schwarz, dass man ein Kind nur dann dazu bekommt, sagen wir, karierte Oberhemden zu mögen, wenn man es in einem karierten Oberhemd in einen Käfig sperrt. Sie erwähnt eine Studie aus Kamerun, in der das Nachahmungsverhalten von Kindern erforscht wurde: In der dortigen Kultur gibt es keine Spielsachen, allenfalls Gebrauchsgegenstände.‟"
                                            },
                                            {
                                                "example_id": "8e2e1cb7-1732-4101-a5b4-8c1fe7f47758",
                                                "sense_id": "a83a8d4c-1b71-31a1-b5f6-c30096bc818a",
                                                "text": "„Wie soll das gehen, wenn jetzt die Piloten geländegängiger Dreitonner in die City gelockt werden, um dort Brötchen (Zigarillos, ein neues Oberhemd...) zu kaufen, vor jedem Laden aufs Neue ein Gratis-Viertelstündchen parkend?‟"
                                            },
                                            {
                                                "example_id": "8bbf234b-470b-4288-895c-707f5652db93",
                                                "sense_id": "a83a8d4c-1b71-31a1-b5f6-c30096bc818a",
                                                "text": "„Achim muß jeden Tag Oberhemden tragen.“"
                                            },
                                            {
                                                "example_id": "0d48490c-7796-4383-82bc-58f119abac79",
                                                "sense_id": "a83a8d4c-1b71-31a1-b5f6-c30096bc818a",
                                                "text": "„Man verzeihe mir, wenn ich noch einmal auf Oberhemden zu sprechen komme, aber es geht um den Hals, und irgendwo muss der Spaß ja aufhören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e581cbee-bf0e-416b-a561-f41d898ab8e3",
