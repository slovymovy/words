                                        "glosses": [
                                            "Enredo, confusión, maraña."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d15ede-dfbe-4f34-ba9c-a16defca79a6",
                                                "sense_id": "da56b09c-8e2f-3bb4-ace2-59e3fcc84082",
                                                "text": "«Independientemente de todos los datos anteriores, recientemente se ha conocido una serie de nuevos descubrimientos que aportan una intensa luz al tema de la hipertensión y afecciones colaterales. Ello se debe al estudio de las Prostaglandinas, que durante muchos años parecía un contradictorio embrollo de datos»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "742180d3-1627-3674-841c-fd06517a3945",
                                        "entry_id": "5643b481-42ac-30e7-9a05-cfa7ba354840",
                                        "glosses": [
