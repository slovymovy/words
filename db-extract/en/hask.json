                        "examples": [
                            {
                                "example_id": "d6a1cc32-6fda-49b3-b3a6-6a5bc90e7ec6",
                                "sense_id": "0df9063c-d0e1-388f-82b1-a470e884b94c",
                                "text": "But nowe ſadde Winter welked hath the day, / And Phœbus weary of his yerely taſ-ke: / Yſtabled hath his ſteedes in lowlye laye / And taken vp his ynne in Fiſhes haſ-ke."
                            },
                            {
                                "example_id": "763168cf-a763-460d-ae2f-9016dce5bc30",
                                "sense_id": "0df9063c-d0e1-388f-82b1-a470e884b94c",
                                "text": "The ioyfull Sunne, whom cloudy winters ſpight,/ Had ſhut from vs in watry fiſhes haske, / Returnes againe to lend the world his light"
                            },
                            {
                                "example_id": "b77e1dc4-6664-4a03-a717-27ec010bb651",
                                "sense_id": "0df9063c-d0e1-388f-82b1-a470e884b94c",
                                "text": "Then till the ſun, which yet in fiſhes haſks, / Or watry urn, impounds his fainting head"
                            }
                        ]
                    }
                ],
