                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85cfaefe-a0e8-4486-bd07-becb8c2764e9",
                                "sense_id": "c498fa09-76f2-3555-94ca-cc338c4ac7bc",
                                "text": "L’enceinte, située à la ZAC Gare des Mines-Fillettes – « au cœur d’un quartier en devenir », précise-t-on à la Mairie de Paris – figure sur la carte des sites des Jeux olympiques et paralympiques de 2024 et accueillera les épreuves de badminton et de gymnastique rythmique durant les JO (du 26 juillet au 11 août 2024) puis de parabadminton et parahaltérophilie lors des jeux paralympiques (du 28 août au 8 septembre 2024)."
                            },
                            {
                                "example_id": "61f25a39-df0e-4dc2-9a80-d4116ea59722",
                                "sense_id": "c498fa09-76f2-3555-94ca-cc338c4ac7bc",
                                "text": "Le parabadminton est un sport ludique et accessible pour la majorité des personnes en situation de handicap."
                            },
                            {
                                "example_id": "a014cc96-219a-4739-b727-789c9a40feef",
                                "sense_id": "c498fa09-76f2-3555-94ca-cc338c4ac7bc",
                                "text": "En 2020, le parabadminton fera une entrée historique aux Jeux paralympiques."
                            }
                        ]
