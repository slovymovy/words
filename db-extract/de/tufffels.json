                "senses": [
                    {
                        "sense_id": "9bf66d41-50d6-3005-84c8-d7247256f60d",
                        "entry_id": "bc3add85-4c2d-3917-8565-530cac6ccc22",
                        "glosses": [
                            "Gesteinsformation, ein Fels, der aus vulkanischem Gestein (Tuff) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00824c5-74d5-449c-a511-f4024a00f480",
                                "sense_id": "9bf66d41-50d6-3005-84c8-d7247256f60d",
                                "text": "„Der Rundgang führt durch einen tief in den Tufffels gegrabenen Hohlweg ins Tal - unterwegs Ausblicke auf den jüdischen Friedhof auf der anderen Talseite.“"
                            },
                            {
                                "example_id": "855b7553-12ce-4d14-8e66-3e752ef61fd6",
                                "sense_id": "9bf66d41-50d6-3005-84c8-d7247256f60d",
                                "text": "„Das Gestein besteht hier überall aus schwarzer Augitlava und Tufffels, während der Boden grossentheils mit vulkanischem Sande und Lehm bedeckt ist.“ (1877)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
