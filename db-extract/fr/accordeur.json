                        "entry_id": "97cf10a1-31d1-3c60-8c22-d984991c088f",
                        "glosses": [
                            "Celui qui fait métier d’accorder certains instruments de musique."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "8e603686-770b-42ee-91d7-04932deb213d",
                                "sense_id": "c76647a4-ea42-3809-9c9e-3bd0106f25fb",
                                "text": "Accordeur d’orgues, de pianos."
                            },
                            {
                                "example_id": "467a0a74-f549-4081-9990-4ab33f041641",
                                "sense_id": "c76647a4-ea42-3809-9c9e-3bd0106f25fb",
                                "text": "Un accordeur qui accorde quatre pianos par jour, cinq jours par semaine, cinquante semaines par année s’occupe d'environ 1000 pianos en un an."
                            },
                            {
                                "example_id": "5aa8808c-67fb-4f6b-82ca-dc5c47e812fe",
                                "sense_id": "c76647a4-ea42-3809-9c9e-3bd0106f25fb",
                                "text": "On retrouve, en ce moment, 200 accordeurs de piano au Québec."
                            }
