                "senses": [
                    {
                        "sense_id": "c4474352-df7a-3535-ac3f-c21e7f9d3b53",
                        "entry_id": "d2144500-5229-3998-bb1a-a5c599db8ca1",
                        "glosses": [
                            "Erfahrung, die ein Mensch macht, der schon klinisch tot war, aber wiederbelebt werden konnte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca167c4e-5199-4c4e-9a77-216ad8175464",
                                "sense_id": "c4474352-df7a-3535-ac3f-c21e7f9d3b53",
                                "text": "Manche Menschen, die eine Nahtoderfahrung gemacht haben, berichten von einem Tunnel, den sie gesehen haben wollen."
                            },
                            {
                                "example_id": "18d95819-3ee0-4e6c-ba87-5853f48cc76d",
                                "sense_id": "c4474352-df7a-3535-ac3f-c21e7f9d3b53",
                                "text": "„Von den 55 Patienten, die in ihrem Gedächtnis Eindrücke an ihre Zeit als Herztote vorzufinden glaubten, berichteten wiederum 46 von Erlebnissen, die so gar nicht in das Strickmuster der ‚typischen‘ Nahtoderfahrungen nach Art des Eingangsbeipiels passten.“"
                            },
                            {
                                "example_id": "14ec8fc5-aba6-4b98-8abe-08c83fc478cb",
                                "sense_id": "c4474352-df7a-3535-ac3f-c21e7f9d3b53",
                                "text": "„Selbst die oft zitierten Nahtoderfahrungen haben keinerlei magische Ursachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94dfeb81-4968-49bb-bcba-c1a6083aad87",
                        "source_entry_id": "d2144500-5229-3998-bb1a-a5c599db8ca1",
                        "source_sense_id": "c4474352-df7a-3535-ac3f-c21e7f9d3b53",
                        "source_sense_description": "Erfahrung, die ein Mensch macht, der schon klinisch tot war, aber wiederbelebt werden konnte",
                        "target_lang_word": "near-death experience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "near-death experience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3fc83ee-1aee-3973-b801-3dadc71da31f",
                                        "entry_id": "edb7ff06-ef32-38fa-84f2-1440da36e4fd",
                                        "glosses": [
                                            "A sensation of detachment from one's body, the presence of a tunnel of light, the apparent viewing of one's own body from on high, and similar manifestations, experienced by people whose heart and brain have temporarily ceased to function."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d650c9aa-2091-4115-9414-164ef462d82e",
                                                "sense_id": "c3fc83ee-1aee-3973-b801-3dadc71da31f",
                                                "text": "Everybody has the same story of the near-death experience—my entire life flashed in front of me, the white light and all that—but no one really knows it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
