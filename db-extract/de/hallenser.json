                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1122ad6-3e18-4628-8787-2c4b43bb0d1a",
                                "sense_id": "1213ed4d-1cce-3332-b4d7-e53ac1ac4343",
                                "text": "Er ist ein Hallenser, ist schwarzhaarig und hat breite Schultern."
                            },
                            {
                                "example_id": "8fb71462-8c83-4d8c-acdf-777fe5574e30",
                                "sense_id": "1213ed4d-1cce-3332-b4d7-e53ac1ac4343",
                                "text": "„Folgen Sie den Hallensern zum Hallmarkt, Händel zu seinem historischen Denkmal und in die Marktkirche sowie den Hallensern auf ihrem Marktplatz mit dem Wahrzeichen der Stadt, den fünf Türmen.“"
                            }
