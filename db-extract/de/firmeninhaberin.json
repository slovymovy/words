                "senses": [
                    {
                        "sense_id": "9d3c104a-f3e1-331d-916e-1ca2b89a236e",
                        "entry_id": "f514f256-5e37-3ffe-96a3-0caac8a9ee34",
                        "glosses": [
                            "weibliche Person, die eine Firma besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02ce727-cdd2-4f90-9fd7-5d0192495913",
                                "sense_id": "9d3c104a-f3e1-331d-916e-1ca2b89a236e",
                                "text": "„Darin stand, dass Lily Chairat die einzige Firmeninhaberin – und Teilhaberin – des Cafés war.“"
                            },
                            {
                                "example_id": "592d0d09-9239-434b-9cb7-cafc2f1cdafa",
                                "sense_id": "9d3c104a-f3e1-331d-916e-1ca2b89a236e",
                                "text": "„Dass ihr als Firmeninhaberin alle Produkte ihres Betriebes gehörten, war wohl nicht von der Hand zu weisen.“"
                            },
                            {
                                "example_id": "c0f3ba75-e293-4e19-b3fc-068a749677ac",
                                "sense_id": "9d3c104a-f3e1-331d-916e-1ca2b89a236e",
                                "text": "„Nach dem Tode des Erwerbers übernahm indessen die ursprüngliche Firmeninhaberin, die bei der Übertragung jene Beschränkung ausbedungen hatte, das Geschäft mit der Firma aufs neue, um beides später an einen Dritten zu veräußern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
