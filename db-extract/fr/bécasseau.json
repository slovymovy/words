                                        "sense_id": "d4ba0ad0-0c36-3421-9334-dbc08a90e603",
                                        "entry_id": "36a89644-4d4c-32f4-b1c5-4b14fe804d8a",
                                        "glosses": [
                                            "To stop (an action); cease, desist."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e361f67-3af8-4451-ad30-d063346d656c",
                                                "sense_id": "d4ba0ad0-0c36-3421-9334-dbc08a90e603",
                                                "text": "We mon haue payne that neuer shall stynt",
                                                "translation": "We deamons have pain that shall never cease",
                                                "english": "We deamons have pain that shall never cease"
                                            },
                                            {
                                                "example_id": "08b61f9e-2aa6-46f5-8702-d1990248c11e",
                                                "sense_id": "d4ba0ad0-0c36-3421-9334-dbc08a90e603",
                                                "text": "O do thy cruell wrath and spightfull wrong / At length allay, and stint thy stormy strife […]"
                                            },
                                            {
                                                "example_id": "a898da81-846e-47e9-a80c-107d20322d32",
                                                "sense_id": "d4ba0ad0-0c36-3421-9334-dbc08a90e603",
                                                "text": "And stint thou too, I pray thee."
                                            },
                                            {
                                                "example_id": "338152d1-f6e6-4fb2-b1e5-51717b2af248",
                                                "sense_id": "d4ba0ad0-0c36-3421-9334-dbc08a90e603",
                                                "text": "The damsel stinted in her song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b27aaf-679a-3db9-a959-02a0a11b5a31",
                                        "entry_id": "36a89644-4d4c-32f4-b1c5-4b14fe804d8a",
                                        "glosses": [
                                            "To stop speaking or talking (of a subject)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72c1f0e3-04a3-3989-8d90-3e793aa80a4b",
                                        "entry_id": "36a89644-4d4c-32f4-b1c5-4b14fe804d8a",
                                        "glosses": [
                                            "To be sparing or mean."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faca2b49-4b68-47e9-a249-eb71dd3b7a44",
                                                "sense_id": "72c1f0e3-04a3-3989-8d90-3e793aa80a4b",
                                                "text": "The next party you throw, don't stint on the beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa8f97e8-1f06-3c17-81df-0ef278950b7d",
                                        "entry_id": "36a89644-4d4c-32f4-b1c5-4b14fe804d8a",
                                        "glosses": [
                                            "To restrain within certain limits; to bound; to restrict to a scant allowance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d61cf65-4fcb-491c-ac27-e92679d21932",
                                                "sense_id": "aa8f97e8-1f06-3c17-81df-0ef278950b7d",
                                                "text": "I shall not in the least go about to extenuate the Latitude of it: or to stint it only to the Produćtion of Weeds, of Thorns, Thisiles, and other the less useful Kinds of Plants"
                                            },
                                            {
                                                "example_id": "4b65a965-5c4a-497b-8572-f22233159418",
                                                "sense_id": "aa8f97e8-1f06-3c17-81df-0ef278950b7d",
                                                "text": "She stints them in their meals."
                                            },
                                            {
                                                "example_id": "b80abd95-59ce-4435-a997-5ea1b614b0e8",
                                                "sense_id": "aa8f97e8-1f06-3c17-81df-0ef278950b7d",
                                                "text": "Schepisi makes it clear that the outlandish rules, the strict self-discipline, the body hatred, and erotophobia is destructive; it is doing no one any good. But since he is also presenting a (somewhat) loving evocation of his own past, this measure gets soft peddled. Worse, it stints the film's analysis, and by not being totally honest, causes and plays upon some dangerous misunderstanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6faa20f-01fc-3287-b619-59ebc65c11e9",
                                        "entry_id": "36a89644-4d4c-32f4-b1c5-4b14fe804d8a",
                                        "glosses": [
                                            "To assign a certain task to (a person), upon the performance of which he/she is excused from further labour for that day or period; to stent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4944bfe8-c987-32e3-8a42-97ad0965c79f",
                                        "entry_id": "36a89644-4d4c-32f4-b1c5-4b14fe804d8a",
                                        "glosses": [
                                            "To impregnate successfully; to get with foal."
                                        ],
                                        "tags": [
                                            "of mares"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb79720b-33cf-4793-b7ed-7c091a877a46",
                                                "sense_id": "4944bfe8-c987-32e3-8a42-97ad0965c79f",
                                                "text": "The majority of maiden mares will become stinted while at work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stint",
