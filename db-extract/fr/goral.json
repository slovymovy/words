                "senses": [
                    {
                        "sense_id": "8a9b548e-f408-306a-a3b4-101269b5e746",
                        "entry_id": "a885dbf1-9ad4-38e6-8416-c21f2f04fd2b",
                        "glosses": [
                            "Nom vernaculaire de Nemorhaedus goral, caprin des montagnes asiatiques vivant entre la Birmanie et le sud de la Sibérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916df33b-8f7f-4502-9e45-77a29da6e2c4",
                                "sense_id": "8a9b548e-f408-306a-a3b4-101269b5e746",
                                "text": "J’appris ainsi pour la première fois ce que c’est de tirer un goral qui vous passe à bout portant […]"
                            },
                            {
                                "example_id": "233988b1-c546-4cc3-9af6-a9f92f631a2d",
                                "sense_id": "8a9b548e-f408-306a-a3b4-101269b5e746",
                                "text": "C’était un goral qui dégringolait le passage à une quarantaine de mètres de nous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b56b5458-a0a6-4d2f-9972-bbaeb5efaaa2",
                        "source_entry_id": "a885dbf1-9ad4-38e6-8416-c21f2f04fd2b",
                        "source_sense_id": "8a9b548e-f408-306a-a3b4-101269b5e746",
                        "target_lang_word": "goral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df8e9013-75c6-360a-8a3f-f1d23ee7f056",
                                        "entry_id": "2fef4e80-826f-310f-a0c0-1c94be74aadc",
                                        "glosses": [
                                            "A type of Asian ungulate ruminant, now defined as any of the four species of the genus Naemorhedus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1a752e-dcf1-43e3-a3b9-7030c9473258",
                                                "sense_id": "df8e9013-75c6-360a-8a3f-f1d23ee7f056",
                                                "text": "The goral has a wide distribution, from the Indus Kohistan region in the western Himalaya in Pakistan, across the eastern Himalaya, Myanmar, Thailand, China and in a few scattered areas in South Korea, North Korea, eastern Russia and the adjoining regions of China."
                                            },
                                            {
                                                "example_id": "368d3670-38c0-479a-b279-bc54bcdccfa8",
                                                "sense_id": "df8e9013-75c6-360a-8a3f-f1d23ee7f056",
                                                "text": "The gorals of Shanxi, sometimes separated as a taxon vidianus, fall into the range of N. griseus."
                                            },
                                            {
                                                "example_id": "4f7064dd-a4d8-4f57-8e21-5bf7cbe1afa1",
                                                "sense_id": "df8e9013-75c6-360a-8a3f-f1d23ee7f056",
                                                "text": "The goral is a ruminant (cud chewer) closely related to the serow, but it is distinguished from the serow by peculiarities in its skull form as well as by its smaller size, shorter horns, and absence of conspicuous preorbital glands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
