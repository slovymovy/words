                        "entry_id": "ccc0dd98-b96d-30e2-a826-5cc1a5bae20c",
                        "glosses": [
                            "A translucent gemstone, an orthoclase feldspar, that has a pearly lustre."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5fc9dc3-be99-4a73-8c7c-3c958e3ccbb5",
                                "sense_id": "0d8658eb-20df-3e6c-8173-208ecbc459c0",
                                "text": "To give light to the presence chamber were seven escarbuncles, great as pumpkins, hung in order down the length of it, and nine fair moonstones standing in order on silver pedestals between the pillars on the dais."
                            }
                        ]
                    }
                ],
