                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a4baa75-e18b-3cd1-9810-7c4bc9c0779a",
                        "entry_id": "9a38e001-d2e4-32b5-a419-ad22a5e79470",
                        "glosses": [
                            "Sport, Rennen: nicht regelkonformer (meist vorzeitiger) Start"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b1f833-bf44-4dbc-a01f-8e7a5a5c6fd1",
                                "sense_id": "2a4baa75-e18b-3cd1-9810-7c4bc9c0779a",
                                "text": "Nach dem dritten Fehlstart wurde die Läuferin disqualifiziert."
                            },
                            {
                                "example_id": "d25cd99d-905a-4ffd-8006-d23ec9edbfe7",
                                "sense_id": "2a4baa75-e18b-3cd1-9810-7c4bc9c0779a",
                                "text": "„Zu häufig wurden Fehlstarts provoziert, um die Gegner zu verunsichern, zu oft verzögerte sich der Ablauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d80017f6-9561-3910-b642-b06cbb439b7f",
                        "entry_id": "9a38e001-d2e4-32b5-a419-ad22a5e79470",
                        "glosses": [
                            "missglückter Anfang"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c3d69cab-f7b5-43a4-a58c-9350194d12dc",
                                "sense_id": "d80017f6-9561-3910-b642-b06cbb439b7f",
                                "text": "Der Fehlstart des Projektes hatten nur wenige an einen zweiten Anlauf geglaubt."
                            },
                            {
                                "example_id": "6ecb2fda-1ac7-4e6c-91c7-61e8c30f9b33",
                                "sense_id": "d80017f6-9561-3910-b642-b06cbb439b7f",
                                "text": "„Schon vor den ersten Olympia-Tagen hat die Spitze der deutschen Mannschaft um Nachsicht im Falle eines Fehlstarts geworben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65698041-fdcb-43ec-8970-e58ed3671325",
                        "source_entry_id": "9a38e001-d2e4-32b5-a419-ad22a5e79470",
                        "source_sense_id": "2a4baa75-e18b-3cd1-9810-7c4bc9c0779a",
                        "source_sense_description": "Sport, Rennen: nicht regelkonformer (meist vorzeitiger) Start",
                        "target_lang_word": "false start",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "false start",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be4bf05e-7205-3bee-9a2b-bb6ffd2ae781",
                                        "entry_id": "a88306bc-a9ad-32a7-ac37-c2bfd7c2f1cd",
                                        "glosses": [
                                            "The act of an athlete starting a race before being signaled to do so."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2960493-eaf3-3a98-b5fc-d94c6e71677c",
                                        "entry_id": "a88306bc-a9ad-32a7-ac37-c2bfd7c2f1cd",
                                        "glosses": [
                                            "The act of an offensive player moving across the line of scrimmage prior to the snap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1e68d0c-d6c5-3fb7-97ac-53966faea564",
                                        "entry_id": "a88306bc-a9ad-32a7-ac37-c2bfd7c2f1cd",
                                        "glosses": [
                                            "An attempt at something that does not work, requiring one to start over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8caa054e-9779-4c5e-a3d8-c77bff32234c",
                                                "sense_id": "f1e68d0c-d6c5-3fb7-97ac-53966faea564",
                                                "text": "After a \"false start\" that was too vigorous, overloading the motors, No. D171 made a very successful unassisted run from Tyne Dock to Consett."
                                            },
                                            {
                                                "example_id": "dbc8fe24-bcb1-477c-8ed7-12ca5477fa13",
                                                "sense_id": "f1e68d0c-d6c5-3fb7-97ac-53966faea564",
                                                "text": "He spent nearly 20 years developing the movie, keeping at it through false starts and heartbreaking dead ends. And when he got the chance to make it, he went all in, devising entire societies full of baroquely souped-up death machines and screaming war-cults."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08461c36-42ca-40eb-8303-e8a60c770050",
                        "source_entry_id": "9a38e001-d2e4-32b5-a419-ad22a5e79470",
                        "source_sense_id": "2a4baa75-e18b-3cd1-9810-7c4bc9c0779a",
                        "source_sense_description": "Sport, Rennen: nicht regelkonformer (meist vorzeitiger) Start",
                        "target_lang_word": "faux départ",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faux départ",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46362ef5-3e9f-3378-b13a-7ac814e00f9c",
                                        "entry_id": "2a90b556-bf82-3049-a0d6-058e1bf41a64",
                                        "glosses": [
                                            "Départ d’un coureur qui part avant le signal de départ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60babcb2-d45e-4449-97f6-98f133b70382",
                                                "sense_id": "46362ef5-3e9f-3378-b13a-7ac814e00f9c",
                                                "text": "Les règles du sprint en athlétisme stipulent depuis 2002 que, si un athlète quitte les starting blocks en moins de 100 ms (0,1 s) après le coup de feu, il sera sanctionné d'un faux départ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e623dbb0-a37b-31be-ba91-253714fcc31e",
                                        "entry_id": "2a90b556-bf82-3049-a0d6-058e1bf41a64",
                                        "glosses": [
                                            "Départ avant que celui-ci soit autorisé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c62abb83-dce8-3592-a0a2-b285b7392e0e",
                                        "entry_id": "2a90b556-bf82-3049-a0d6-058e1bf41a64",
                                        "glosses": [
                                            "Essai manqué, qu’il faut recommencer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb40f2d3-0728-4271-870f-6326dd897213",
                                                "sense_id": "c62abb83-dce8-3592-a0a2-b285b7392e0e",
                                                "text": "Après deux ou trois faux départs qui avaient avorté dans des retours de tendresse et de pitié, elle parvint a s’enfuir."
                                            },
                                            {
                                                "example_id": "ff60417c-a07c-4296-9983-2bcbd37bbcad",
                                                "sense_id": "c62abb83-dce8-3592-a0a2-b285b7392e0e",
                                                "text": "Il avait aussi supprimé un second chapitre : « Place Blanche », écrit dans la foulée de « Retour à Saint-Leu-la-Forêt ». Ainsi avait-il tout repris depuis le début avec la sensation pénible de corriger un faux départ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
