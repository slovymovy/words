                                                "sense_id": "bad7717f-6b72-3bd6-844d-e713dd824667",
                                                "text": "Urkunde und Brief sind jeweils Schriftstück und somit inkomparabel mit dem Wort »Akte«, das eine Sammlung von Urkunden und/oder Briefen bezeichnet."
                                            },
                                            {
                                                "example_id": "0d2db349-b7f7-4ace-9638-b57c034c2dfb",
                                                "sense_id": "bad7717f-6b72-3bd6-844d-e713dd824667",
                                                "text": "Äpfel und Birnen nimmt man gerne als Beispiel, wenn man erläutern möchte, das zwei Dinge inkomparabel sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8bb1256-ad6c-30fb-aa41-514fa5051b48",
                                        "entry_id": "3584db1b-7bce-30ea-91b5-0a29a5169a1b",
                                        "glosses": [
                                            "als Adjektiv nicht steigerungsfähig"
                                        ],
