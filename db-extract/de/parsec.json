                "senses": [
                    {
                        "sense_id": "66bab06b-ed0e-3451-87c2-1681dda8cc00",
                        "entry_id": "ac4e41d2-2071-3edb-a272-c6185c4aa42f",
                        "glosses": [
                            "Parallaxensekunde oder parallaktische Sekunde, eine astronomische Längeneinheit, die etwa 3,26 Lichtjahren entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4848acfe-47be-4869-b4c7-8cb2f615566a",
                                "sense_id": "66bab06b-ed0e-3451-87c2-1681dda8cc00",
                                "text": "Proxima Centauri, der unserem Sonnensystem nächstgelegene Stern, ist etwa 1,3 Parsec (4,2 Lichtjahre) entfernt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87332b65-e53a-41d9-8ea0-8e935d0cf520",
                        "source_entry_id": "ac4e41d2-2071-3edb-a272-c6185c4aa42f",
                        "source_sense_id": "66bab06b-ed0e-3451-87c2-1681dda8cc00",
                        "target_lang_word": "parsec",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parsec",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d41dcf7-3be7-3d77-89a7-947b08dd49b9",
                                        "entry_id": "d7351811-b327-3da6-a77b-fbec49cdfa06",
                                        "glosses": [
                                            "Syllabic abbreviation of parallax second."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1493a8e3-a196-408e-b707-ac479441a8d0",
                                                "sense_id": "2d41dcf7-3be7-3d77-89a7-947b08dd49b9",
                                                "text": "Han Solo: Fast ship? You've never heard of the Millennium Falcon?\nObi-Wan \"Ben\" Kenobi: Should I have?\nHan Solo: It's the ship that made the Kessel Run in less than twelve parsecs. I've outrun Imperial starships. Not the local bulk cruisers mind you, I'm talking about the big Corellian ships now. She's fast enough for you old man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "404ace17-e133-4b5d-858f-4d7c12171628",
                        "source_entry_id": "ac4e41d2-2071-3edb-a272-c6185c4aa42f",
                        "source_sense_id": "66bab06b-ed0e-3451-87c2-1681dda8cc00",
                        "target_lang_word": "парсек",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "парсек",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "72c6c9f5-9b81-371c-b560-ff32ed19451a",
                                        "entry_id": "0c0d8641-acd6-3826-aa04-eab1c780c3f6",
                                        "glosses": [
                                            "астрон. единица измерения расстояний, равная расстоянию, для которого годичный параллакс равен одной секунде (1 пк ≈ 206 265 а. е. ≈ 3,0857·10¹⁶ м)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703ada0e-7ad7-4697-8508-8662fbc310d5",
                                                "sense_id": "72c6c9f5-9b81-371c-b560-ff32ed19451a",
                                                "text": "Ныне как единица расстояния в астрономии применяется парсек, равный 3,26 светового года."
                                            },
                                            {
                                                "example_id": "6bc2a5a9-fc12-405c-82c9-44adc74b0bca",
                                                "sense_id": "72c6c9f5-9b81-371c-b560-ff32ed19451a",
                                                "text": "Представим себе воображаемого наблюдателя, отдалённого от Солнца на расстояние 10 парсек (немного больше 30 световых лет) и находящегося в плоскости орбиты Юпитера."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63bf129a-90d2-4825-83b2-279ac55dfa4f",
                        "source_entry_id": "ac4e41d2-2071-3edb-a272-c6185c4aa42f",
                        "source_sense_id": "66bab06b-ed0e-3451-87c2-1681dda8cc00",
                        "target_lang_word": "pársec",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pársec",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "212d8612-9010-3ad8-9ed8-21acbe78aa9a",
                                        "entry_id": "5c097676-bf3d-3bed-aaa1-749f09aa0c6c",
                                        "glosses": [
                                            "Unidad de longitud, definida como la distancia a la que una unidad astronómica (ua) subtiende un ángulo de un segundo de arco (1″), 1 pársec = 206.265 ua = 3,2616 años luz = 30,857 × 10¹⁶ m."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4fd366e-5e9d-4603-93e1-5131dfd3b290",
                                                "sense_id": "212d8612-9010-3ad8-9ed8-21acbe78aa9a",
                                                "text": "Debido al movimiento de traslación de la Tierra podemos ver un movimiento en las estrellas más cercanas. A ese movimiento se le llama paralaje. A una distancia de un pársec el ángulo que formaría la estrella respecto a los meses de enero y julio es de 2 segundos de arco"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
