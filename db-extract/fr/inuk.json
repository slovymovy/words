                        "glosses": [
                            "Se dit de l’Inuk, de l’être humain en inuktitut."
                        ],
                        "tags": [
                            "Spécialisé"
                        ],
                        "examples": [
                            {
                                "example_id": "62c86d5b-7838-4bb9-b9a1-d7a54639a83f",
                                "sense_id": "9c6f597c-b506-353a-aebc-178f9680a936",
                                "text": "Le Prix Sobey pour les arts, reconnu comme l'une des plus généreuses récompenses pour les artistes visuels contemporains au Canada, a été décerné à l’artiste inuk Laakkuluk Williamson Bathory, qui figurait sur une liste de cinq finalistes présélectionnés."
                            }
                        ]
                    }
