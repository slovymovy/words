                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3787ea4e-c51c-484e-b7f8-0fdd93ebff29",
                                                "sense_id": "715f2979-73a4-3528-98c1-4205a51b4073",
                                                "text": "per la fisica quantistica tempo e spazio formano un continuo indissolubile"
                                            },
                                            {
                                                "example_id": "0a73e6a9-1afa-433f-ad8c-251aa58384fb",
                                                "sense_id": "715f2979-73a4-3528-98c1-4205a51b4073",
                                                "text": "alcuni filosofi considerano il tempo come un continuo in perenne mutamento"
                                            }
                                        ]
                                    },
