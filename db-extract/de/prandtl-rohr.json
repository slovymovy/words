                ],
                "senses": [
                    {
                        "sense_id": "546a87d2-e3ab-3261-b744-8b743ecab207",
                        "entry_id": "a5d557b8-0d2a-3a46-9683-d4f2a5eb0724",
                        "glosses": [
                            "Messgerät zum Messen des dynamischen Druckes in einer Strömung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a5b819c7-6f19-419f-bda0-4b1774d63a53",
                                "sense_id": "546a87d2-e3ab-3261-b744-8b743ecab207",
                                "text": "Das Prandtl-Rohr wird zur Bestimmung des dynamischen Drucks in Lüftungskanälen verwendet."
                            },
                            {
                                "example_id": "d4fc2145-19e7-4fe7-8a7b-4906f1727c35",
                                "sense_id": "546a87d2-e3ab-3261-b744-8b743ecab207",
                                "text": "„Das Prandtl-Rohr ist ein sehr einfaches und trotzdem genaues Messgerät, mit dem die lokale Strömungsgeschwindigkeit in Flüssigkeits- und Gasströmungen nach Betrag und Richtung gemessen werden kann.“"
                            },
                            {
                                "example_id": "216c9232-a005-4a0c-8a7c-a29d8bfd0054",
                                "sense_id": "546a87d2-e3ab-3261-b744-8b743ecab207",
                                "text": "„Dadurch hat das Prandtl-Rohr zwei Anschlüsse, einen für den Gesamtdruck und einen für den statischen Druck. Wird das Prandtl-Rohr an ein Manometer angeschlossen, das Differenzdrücke messen kann, ist der dynamische Druck direkt ablesbar.“"
                            },
                            {
                                "example_id": "595b99cb-4e8f-43aa-ab2b-ae111d92677c",
                                "sense_id": "546a87d2-e3ab-3261-b744-8b743ecab207",
                                "text": "„Ferner ist für diesen Volumenstrom der Differenzdruck am PRANDTL-Rohr zu messen und daraus der Pitot-Beiwert Ap zu ermitteln.“"
                            },
                            {
                                "example_id": "adfbc26e-3875-4ea3-af01-e93e6b885745",
                                "sense_id": "546a87d2-e3ab-3261-b744-8b743ecab207",
                                "text": "„Beim Prandtl-Rohr handelt es sich um eine pneumatische Sonde, die innerhalb einer Strömung sowohl den statischen als auch den Gesamtdruck misst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
