                    {
                        "sense_id": "fe07d5a9-c99e-3bb8-9729-de97ad0ee215",
                        "entry_id": "bf1e193d-f23d-3ea1-98d2-17d0ca7ab34b",
                        "glosses": [
                            "A fold or ridge on the cerebral cortex of the brain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ef20c3-a692-4c3a-b466-4c6de520c98b",
                                "sense_id": "fe07d5a9-c99e-3bb8-9729-de97ad0ee215",
                                "text": "The sulci and gyri are the grooves and ridges, respectively."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d957524-1898-4a5a-a7ff-fff7c057c5c9",
