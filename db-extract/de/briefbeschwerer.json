                    {
                        "translation_id": "f1fa0975-dd12-47ed-a9ef-500f75dbcfc2",
                        "source_entry_id": "62a5cebb-cbe6-324e-abd9-14ea15053b88",
                        "source_sense_id": "05f40c4e-840f-36d5-afa3-38838717422a",
                        "source_sense_description": "Gegenstand, der verhindert, dass Papier verweht wird",
                        "target_lang_word": "presse-papier",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presse-papier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b6c700-0429-3a34-9e16-346d7558ed32",
                                        "entry_id": "81fbe2b8-c3a0-369e-b390-8f20bbc5e6f6",
                                        "glosses": [
                                            "vaak fraai gevormd, zwaar voorwerp dat men boven op een stapel losse papieren kan leggen zodat de papieren niet kunnen wegwaaien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fdeaf0-680d-47df-8e57-a8c2475092d9",
                                                "sense_id": "b6b6c700-0429-3a34-9e16-346d7558ed32",
                                                "text": "Gelukkig lag er een presse-papier op de stapel bankbiljetten, anders waren ze zo uit het raam weggewaaid toen de deur plotseling openging."
                                            },
                                            {
                                                "example_id": "8112004f-46a9-4160-9aba-41819c2a7d5d",
                                                "sense_id": "b6b6c700-0429-3a34-9e16-346d7558ed32",
                                                "text": "‘Het aanbod notitieblokken, magneetjes, postkaarten, affiches en presse-papiers is redelijk constant. Redelijk nieuw zijn de licenties die we verkopen. Zo beheren we Magrittelicenties voor chocoladeproducten, koekjes, maatpakken en koffers. In Knokke en in het Atomium bedachten we concepten voor events. Met een 3D-beleving bereik je families met kinderen. Voor hen creëerden we kinderboekjes en doe-boekjes.’"
                                            },
                                            {
                                                "example_id": "ca97935f-efe4-4234-b48a-bc41076bbcc5",
                                                "sense_id": "b6b6c700-0429-3a34-9e16-346d7558ed32",
                                                "text": "Bruikbaar is de geperste geldklomp in ieder geval niet. ,,Je kunt het als presse-papier gebruiken.\" Toch heeft de klomp in deze vorm wel waarde. ,,Er heeft iemand honderd euro voor geboden. Ik denk dat het een verzamelaar is. Daar doen we het wel voor weg. Tot dat het geld binnen is zetten we het hier in een vitrine.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e63d5358-b238-4e54-a2b0-f7320eddfb3e",
                        "source_entry_id": "62a5cebb-cbe6-324e-abd9-14ea15053b88",
