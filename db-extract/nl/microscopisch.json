                ],
                "translations": [
                    {
                        "translation_id": "702115a4-e267-40e4-8021-97b2a537bbc9",
                        "source_entry_id": "f172ef36-56c6-323f-a54f-2e14d1727d84",
                        "source_sense_id": "af57b524-df56-329b-a6d6-d5fbc1f332ce",
                        "source_sense_description": "zeer klein, voor het blote oog onzichtbaar",
                        "target_lang_word": "microscopic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscopic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62c011a-1b3d-3875-8e06-682abd8a4b70",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Of, or relating to microscopes or microscopy; microscopal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdbe038-ca09-4757-8fc1-5e75e1f8adef",
                                                "sense_id": "e62c011a-1b3d-3875-8e06-682abd8a4b70",
                                                "text": "We supply all microscopic stains and other materials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce7aeda-d8f9-3d78-bd2e-bb1d27ce2ac0",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "So small that it can only be seen with the aid of a microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b90017d6-39bc-46b9-b68d-1cc362b36218",
                                                "sense_id": "bce7aeda-d8f9-3d78-bd2e-bb1d27ce2ac0",
                                                "text": "The water was full of microscopic organisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Very small; minute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c68045-f407-4b1f-959b-41a80e3c0319",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "Compared to the galaxy, we are microscopic in scale."
                                            },
                                            {
                                                "example_id": "d8d8bb97-ef8c-4f46-ab3e-447b8eb42cbd",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "By wholesale omission of connections and by the use of a microscopic scale of photographic reproduction which makes some of the most important tables difficult to read, the size has been cut down from last winter's 580 to 520 pages only."
                                            },
                                            {
                                                "example_id": "8f8a6644-9b19-44cf-a3c4-a6e8a2358018",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "... the notion of the microscopic was often used in the foundations of quantum theory right from the start, to indicate the realm in which quantum theory is required in order to explain phenomena when classical theory cannot do so; quantum theory was generally considered in those years to apply only to situations involving atoms and smaller “microscopic” entities..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bd560e-a397-3614-b092-791470fb698a",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Carried out with great attention to detail."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d51ad7-0eb7-4a4b-935b-7ecc3bb795b4",
                                                "sense_id": "85bd560e-a397-3614-b092-791470fb698a",
                                                "text": "The police carried out a microscopic search of the crime scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb347896-863e-350a-bca9-6d3b29467593",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Able to see extremely minute objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3565db4-64fc-4788-83aa-3ec9bcde9d73",
                                                "sense_id": "bb347896-863e-350a-bca9-6d3b29467593",
                                                "text": "Why has not man a microscopic eye?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17c0504d-e7ad-4bcf-b9e9-b7bfbd0a4053",
                        "source_entry_id": "f172ef36-56c6-323f-a54f-2e14d1727d84",
                        "source_sense_id": "af57b524-df56-329b-a6d6-d5fbc1f332ce",
                        "source_sense_description": "zeer klein, voor het blote oog onzichtbaar",
                        "target_lang_word": "microscopique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscopique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d155acce-3a9a-3bc6-9924-2e419d12bbef",
                                        "entry_id": "642f75b9-eb1d-3c83-9aea-2ad0ba95cd9c",
                                        "glosses": [
                                            "Qui se fait avec le secours du microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5beb7d0f-52d7-4d4b-8309-2a51b22bafe7",
                                                "sense_id": "d155acce-3a9a-3bc6-9924-2e419d12bbef",
                                                "text": "[…]: il se trouve que certains grains de pollen se sont bien conservés dans les tourbières ; or, l’étude microscopique des grains de pollen permet très souvent de reconnaître à quelle plante ils appartiennent."
                                            },
                                            {
                                                "example_id": "a713f85a-e900-4fc2-b4ea-e4f71b9d94fa",
                                                "sense_id": "d155acce-3a9a-3bc6-9924-2e419d12bbef",
                                                "text": "Le diagnostic d’otacariose est confirmé par la mise en évidence d’otodectes dans le cérumen grâce aux examens otoscopique et microscopique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c787e22d-347f-3a7e-8a27-8657334ee9f4",
                                        "entry_id": "642f75b9-eb1d-3c83-9aea-2ad0ba95cd9c",
                                        "glosses": [
                                            "Qui ne peut être vu qu’avec le microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2032a970-c825-42da-bb24-b269b5b39da9",
                                                "sense_id": "c787e22d-347f-3a7e-8a27-8657334ee9f4",
                                                "text": "L'argent natif est présent sous forme microscopique dans certains cuivres gris et dans certaines galènes : il semble bien y être hypogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                        "entry_id": "642f75b9-eb1d-3c83-9aea-2ad0ba95cd9c",
                                        "glosses": [
                                            "Extrêmement petit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09628ed7-8962-4fe9-ab9e-f6f9778a361c",
                                                "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                                "text": "Je pardonne au « moustique à collier blanc », qui provoque un jet de sang à chaque piqûre. Je subis avec patience les coups du « frappe d'abord », les impressions cautérisantes du microscopique « brûlot »; mais le culex, je le hais, […]."
                                            },
                                            {
                                                "example_id": "d58583ff-0ef0-4d36-b36c-01278f62505f",
                                                "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                                "text": "Il nous fit monter par un escalier fort roide à une toute petite chambre éclairée par une microscopique fenêtre sur le bord de laquelle végétaient de pauvres plantes."
                                            },
                                            {
                                                "example_id": "f71f9ad9-dd44-4c24-9324-35a688a8437a",
                                                "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                                "text": "En effet, en ce qui concerne les industries des biens de production, les Québécois francophones ne sont en bonne position que dans les scieries et dans les industries du bois d'oeuvre et de la pierre. Leur place est nulle ou microscopique partout ailleurs …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2234f105-e580-4244-b0ac-a991ef49958f",
                        "source_entry_id": "f172ef36-56c6-323f-a54f-2e14d1727d84",
