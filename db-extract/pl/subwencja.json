                                        "entry_id": "ff2b35ba-739b-3e71-a39d-b102e1b754fe",
                                        "glosses": [
                                            "Ayuda económica para un fin determinado que recibe una persona o entidad, a menudo dada por un organismo público."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4787dfdf-5436-4220-aa60-b488b61223de",
                                                "sense_id": "33c20d49-60f2-3243-b4d8-33c3a8f6d23c",
                                                "text": "La subvención es obligatoria, porque el teatro es un sector en crisis que necesita de una intervención del Estado."
                                            }
