                            }
                        ]
                    },
                    {
                        "translation_id": "8d1f4033-4bc2-47d9-ab7a-a42a8f907c32",
                        "source_entry_id": "2301c9f9-ae6f-3031-a2a7-36ccfde8c68d",
                        "source_sense_id": "b38d68b2-5a78-3e0e-a101-13f189b52fd9",
                        "target_lang_word": "Krume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krume",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "868a2df9-751a-314a-a6c2-be0c3f1d185b",
                                        "entry_id": "9b27c624-ff05-3bda-a5ed-e1f0c9d7036e",
                                        "glosses": [
                                            "das weiche Innere von Brot, das von einer härteren Kruste umgeben ist"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9319b784-dd4d-416a-b613-4bae8bea6bca",
                                                "sense_id": "868a2df9-751a-314a-a6c2-be0c3f1d185b",
                                                "text": "Viele Kinder spielen gern mit dem Essen, zum Beispiel drehen sie Brotkügelchen aus der Krume."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5eb9f66d-e65a-3767-904a-490ddced889a",
                                        "entry_id": "9b27c624-ff05-3bda-a5ed-e1f0c9d7036e",
                                        "glosses": [
                                            "kleines, abgebröseltes Stück; insbesondere von Gebackenem wie Brot, Kuchen, Keksen, Chips, aber auch von festen Stoffen wie Putz, Gips etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9e5ca7-8b10-45b7-8335-b887aa214870",
                                                "sense_id": "5eb9f66d-e65a-3767-904a-490ddced889a",
                                                "text": "„Die Speiserationen wurden ihr zugemessen, und die Hausherrin, die alle Sparsamkeitsrezepte aus ihrem Hausfrauenjournal befolgte und sie in der Ausführung noch zu überbieten versuchte, sammelte die Krumen, um sie im Brotschrank zu verschließen.“"
                                            },
                                            {
                                                "example_id": "fab4c7d9-4c68-4851-91f4-aa5e53ea1d4f",
                                                "sense_id": "5eb9f66d-e65a-3767-904a-490ddced889a",
                                                "text": "„Lillian zerbröckelte eine Krume Brot auf ihrem Teller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f680bc2-f0d3-38cb-b46c-af06128788d0",
                                        "entry_id": "9b27c624-ff05-3bda-a5ed-e1f0c9d7036e",
                                        "glosses": [
                                            "kleine Menge"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7289a5-21fa-4092-8d5e-5502f981f5e9",
                                                "sense_id": "2f680bc2-f0d3-38cb-b46c-af06128788d0",
                                                "text": "Unser Chef sonnt sich immer in der öffentlichen Anerkennung und gönnt uns nicht mal ein paar Krumen des Lobes."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3209ecfd-0ab8-3964-ab16-e964ff710d7a",
                                        "entry_id": "9b27c624-ff05-3bda-a5ed-e1f0c9d7036e",
                                        "glosses": [
                                            "kurz für Ackerkrume, die oberste, lockere Bodenschicht des Ackers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f774200-fcbb-4076-a856-a8c84b067bf6",
                                                "sense_id": "3209ecfd-0ab8-3964-ab16-e964ff710d7a",
                                                "text": "„Die in trockener Zeit lose und staubige Krume fließt bei Regen breiartig zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7a48d9c-c9c9-45d2-93ab-729edcf7e73c",
                        "source_entry_id": "2301c9f9-ae6f-3031-a2a7-36ccfde8c68d",
                        "source_sense_id": "b38d68b2-5a78-3e0e-a101-13f189b52fd9",
                        "target_lang_word": "Krümel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krümel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                        "entry_id": "9fa2af38-2a8b-3b6f-8dff-b2652dc1a4f9",
                                        "glosses": [
                                            "kleines, abgebröseltes Stück; insbesondere von Gebackenem wie Brot, Kuchen, Keksen, Chips, aber auch von festen Stoffen wie Putz, Gips und dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df18ef4c-6148-425a-b8f9-ff0a332ee92d",
                                                "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                                "text": "Der Nachteil beim Frühstück im Bett ist bekanntlich, dass es danach nicht mehr sehr gemütlich ist, da die vielen Krümel pieksen."
                                            },
                                            {
                                                "example_id": "030bff03-9ce0-4268-b61b-eab804959da7",
                                                "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                                "text": "„Die Tassen standen noch auf dem Tisch, an dem ich mit Wolf gesessen hatte, und auf meinem Teller lagen noch Krümel von den Brötchen.“"
                                            },
                                            {
                                                "example_id": "2dedf116-3a49-451d-81e0-95d82cdae612",
                                                "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                                "text": "„Er nahm die Zigarette aus dem Munde, besah sie und spuckte ein paar Krümel Tabak aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fb7e458-309a-3397-abc3-7666cf888e99",
                                        "entry_id": "9fa2af38-2a8b-3b6f-8dff-b2652dc1a4f9",
                                        "glosses": [
                                            "ein winziges Stück von etwas"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b87762f-8361-4f00-b141-dd809acc1b3d",
                                                "sense_id": "9fb7e458-309a-3397-abc3-7666cf888e99",
                                                "text": "Das Essen muss unseren Gästen wirklich gut geschmeckt haben: Es ist kein Krümel übrig geblieben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aa4d1a69-68cd-3936-884e-f6338c0430f8",
                                        "entry_id": "9fa2af38-2a8b-3b6f-8dff-b2652dc1a4f9",
                                        "glosses": [
                                            "Kosename für ein kleines Kind"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66faec59-d45c-4dc3-959b-04d422aedb0f",
                                                "sense_id": "aa4d1a69-68cd-3936-884e-f6338c0430f8",
                                                "text": "Was, der Krümel spielt schon Golf?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
