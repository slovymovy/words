    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                    "sense_definition": "Enjoying spending time with other people and making friends easily.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very <w>sociable</w> person who loves going to parties and meeting new people.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>общительный</w> человек, который любит ходить на вечеринки и знакомиться с новыми людьми."
                            }
                        },
                        {
                            "text": "He is usually quite shy, but he becomes much more <w>sociable</w> when he is around his close friends.",
                            "target_lang_translations": {
                                "ru": "Обычно он довольно застенчив, но становится гораздо более <w>общительным</w>, когда находится в кругу близких друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "friendly",
                        "outgoing",
                        "gregarious",
                        "social",
                        "companionable"
                    ],
                    "antonyms": [
                        "unsociable",
                        "introverted",
                        "shy",
                        "unsocial"
                    ],
                    "common_phrases": [
                        "sociable person",
                        "sociable nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любящий проводить время с другими людьми и легко заводящий друзей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общи́тельный",
                                "target_lang_sense_clarification": "склонный к общению, легко вступающий в контакт"
                            },
                            {
                                "target_lang_word": "коммуника́бельный",
                                "target_lang_sense_clarification": "легко находящий общий язык с людьми"
                            },
                            {
                                "target_lang_word": "компане́йский",
                                "target_lang_sense_clarification": "дружелюбный, приятный в компании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a46a9aa1-601c-3731-8781-de7cb241a8b2",
                    "sense_definition": "Providing a pleasant atmosphere for conversation and social interaction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent a <w>sociable</w> evening chatting with our neighbours in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы провели <w>приятный</w> вечер, болтая с соседями в саду."
                            }
                        },
                        {
                            "text": "They organized a <w>sociable</w> gathering to welcome the new members of the team.",
                            "target_lang_translations": {
                                "ru": "Они организовали <w>дружескую</w> встречу, чтобы поприветствовать новых членов команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "inviting",
                        "congenial"
                    ],
                    "common_phrases": [
                        "sociable evening",
                        "sociable gathering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создающий приятную атмосферу для общения и взаимодействия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дружелюбный",
                                "target_lang_sense_clarification": "располагающий к общению"
