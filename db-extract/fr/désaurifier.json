                        "glosses": [
                            "Enlever l’or de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1817d9f2-efed-4c88-9652-96600bb5c488",
                                "sense_id": "bd75471b-f694-3cf4-b4c5-1c22b0246642",
                                "text": "La quantité totale du zinc employé à la désargentation s’éleva à 1,42 p. 100 du poids du plomb d’œuvre, dont 0,29 p. 100 de zinc sans aluminium servirent pour désaurifier et décuivrer le plomb, tandis que le reste de 1,13 p. 100 allié avec 0,5 p. 100 d’aluminium était employé à la désargentation proprement dite."
                            },
                            {
                                "example_id": "02cc2d6c-d29b-4149-bedb-5ba72d4c74e5",
                                "sense_id": "bd75471b-f694-3cf4-b4c5-1c22b0246642",
                                "text": "Pour résoudre complètement la question du traitement, cet ingénieur fit de nombreuses expériences dans le but de déterminer le temps pendant lequel les solutions doivent être soumises à l’action du courant pour se désaurifier."
                            }
                        ]
                    }
