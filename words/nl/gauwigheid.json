                            "target_lang_translations": {
                                "en": "In the <w>rush</w>, he forgot to take his keys from the kitchen table."
                            }
                        },
                        {
                            "text": "Ik zag in de <w>gauwigheid</w> niet dat het verkeerslicht al op rood was gesprongen.",
                            "target_lang_translations": {
                                "en": "In my <w>haste</w>, I didn't see that the traffic light had already turned red."
                            }
                        }
                    ],
