                    },
                    {
                        "translation_id": "dcda9aa9-6e92-4558-9e04-949d7d1f63be",
                        "source_entry_id": "79cdf07a-ce41-3715-98d3-40e097e54ffc",
                        "source_sense_description": "pushing or goading toward action",
                        "target_lang_word": "Stimulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stimulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "756e5730-de0f-381b-98a3-4b6ee441e341",
                                        "entry_id": "b84e155a-e64c-322b-a096-e589e9cc645b",
                                        "glosses": [
                                            "das Stimulieren, die Stimulierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7872cba-594a-4774-a3bb-f232212370fc",
                                                "sense_id": "756e5730-de0f-381b-98a3-4b6ee441e341",
                                                "text": "Es sei nicht auszuschließen, dass hier und da finanzielle Notlagen junger Frauen ausgenutzt werden, um durch zu starke hormonelle Stimulation die Ausbeute an vermarktbaren Eizellen zu erhöhen."
                                            },
                                            {
                                                "example_id": "5f139ca0-f978-440b-a77c-00b680a3ebe9",
                                                "sense_id": "756e5730-de0f-381b-98a3-4b6ee441e341",
                                                "text": "Die Kalte Fusion ist nahezu serienreif. Nur dieses eine Problem konnte nicht und nicht gelöst werden: Führt die Stimulation von Brüsten und Nippeln zu sexueller Erregung?"
                                            },
                                            {
                                                "example_id": "7548ab49-fd3b-4e5c-8dfe-873633a9b678",
                                                "sense_id": "756e5730-de0f-381b-98a3-4b6ee441e341",
                                                "text": "Deltawellen im Tiefschlaf können wir mit Medikamenten oder durch elektrische Stimulation beeinflussen."
                                            },
                                            {
                                                "example_id": "7150122a-242a-4302-9005-d3d2f9383f23",
                                                "sense_id": "756e5730-de0f-381b-98a3-4b6ee441e341",
                                                "text": "Laxman-Entwickler Markus Klose sagt: \"Wer solch audiovisuelle Stimulation noch nicht ausprobiert hat, kann die Wirkung mit der beruhigenden Kraft eines Lagerfeuers vergleichen, in das man schaut.\""
                                            },
                                            {
                                                "example_id": "16f8677d-7b8b-4fbb-be42-370674d7de9f",
                                                "sense_id": "756e5730-de0f-381b-98a3-4b6ee441e341",
                                                "text": "Das Angebot für Schweinezüchter umfasst unter anderem \"besamungsfreundliche\" Selbstfang-Kästen mit \"Ebertreibtür zur gezielten Stimulation der Sauen\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aab02f5b-e684-4840-b92c-caeb7b2e47f8",
                        "source_entry_id": "79cdf07a-ce41-3715-98d3-40e097e54ffc",
                        "source_sense_description": "pushing or goading toward action",
                        "target_lang_word": "Anregung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anregung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                        "entry_id": "9a91f156-d744-33ed-b486-d17e2f280bf1",
                                        "glosses": [
                                            "Vorschlag, etwas zu tun oder zu unterlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b14258-d054-4fb7-9fd5-a0fc018cdea3",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "„Der Leser findet Anregungen für Wandern, Bergsteigen, Radtouren, Malen, Reiten, Golf, Motorfliegen, Segeln, Wasserski, Paddeln, Angeln, Sprachkurse, Kochen und Photographieren.“"
                                            },
                                            {
                                                "example_id": "f0c13424-bfe5-478d-9509-0de704e169fa",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "Die Anregung zu diesem Museumsbesuch erhielten wir durch Zeitungslektüre."
                                            },
                                            {
                                                "example_id": "311f2a19-6227-498c-888c-d7a4166beb58",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "„Schlichter und einleuchtender kann eine Anregung nicht sein.“"
                                            },
                                            {
                                                "example_id": "f76ff626-ff48-48f3-9ada-91fa94a3ee51",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "„Wilhelm Busch hatte von früh auf gelernt, mit einem für uns Heutige unvorstellbaren Mindestmaß an äußerer Anregung auszukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1c7fa10-70cf-3076-826c-687debfc72bd",
                                        "entry_id": "9a91f156-d744-33ed-b486-d17e2f280bf1",
                                        "glosses": [
                                            "Maßnahme, um eine Aktivität in Gang zu setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef21f56c-6bc0-4746-838f-7dba19b7a5aa",
                                                "sense_id": "a1c7fa10-70cf-3076-826c-687debfc72bd",
                                                "text": "Das Medikament dient der Anregung der Darmtätigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd2a1db3-e99b-3753-b847-012198277a54",
                                        "entry_id": "9a91f156-d744-33ed-b486-d17e2f280bf1",
                                        "glosses": [
                                            "Energiezufuhr an ein Elektron auf einer Atomumlaufbahn (in einem bestimmten Energieniveau)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
