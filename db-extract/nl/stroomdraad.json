                                    {
                                        "sense_id": "0195db3f-1ea6-3867-9a52-e476aab454c6",
                                        "entry_id": "d90de9f7-a7fb-3410-ba17-60aa15c2db13",
                                        "glosses": [
                                            "Kabel mit dessen Hilfe elektrischer Strom geleitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeeb45bd-fe23-4141-a082-ada450c1d2e3",
                                                "sense_id": "0195db3f-1ea6-3867-9a52-e476aab454c6",
                                                "text": "„Weil die Wohnungstüre klemmte, versuchte sich ein 26-Jähriger an einem Stromkabel aus einem Fenster im dritten Stock abzuseilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "718e6eb5-acd0-4554-b088-7dd6260ed6ae",
                        "source_entry_id": "9ec69810-2d4a-3975-91a0-2d8587f98267",
                        "source_sense_id": "42581927-f4b8-3c0b-8076-6d8e26df215d",
                        "source_sense_description": "elekriciteitsdraad",
                        "target_lang_word": "live wire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "live wire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b09282fd-04d5-38f1-96eb-8340fb3c218c",
                                        "entry_id": "05a73765-b6e4-37bf-8b12-e094cc7bd39c",
                                        "glosses": [
                                            "An electrical wire through which there is a flow of electrical current."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1525051b-c37f-42fc-8b0e-ef11ab8bfe73",
                                                "sense_id": "b09282fd-04d5-38f1-96eb-8340fb3c218c",
                                                "text": "Two boys got electrocuted when a live wire fell on the auto-rickshaw in which they were sitting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                        "entry_id": "05a73765-b6e4-37bf-8b12-e094cc7bd39c",
                                        "glosses": [
                                            "An especially energetic, alert, or vivacious person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed169ef-4b83-4a47-b32c-25e9aa03c5d8",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "With his thin, eager face and darting hands he was more than a live wire - he was a whole bundle of live wires."
                                            },
                                            {
                                                "example_id": "546e2f80-84d5-47a4-b722-8924f6f2f7bb",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "Mr. Black is a kindly, gentle, fine individual, but as a leader, an up-to-date fellow, a go-getter—why he just doesn't know the first thing about it. . . . In a growing community like Douglaston we need a live wire."
                                            },
                                            {
                                                "example_id": "bd2b8a6e-75e9-4e26-94cb-b2333dfdeb3a",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "I can't sleep 'cause my bed's on fire / Don't touch me, I'm a real live wire"
                                            },
                                            {
                                                "example_id": "898150b8-77f9-446a-897f-dfa932960bdb",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "She was irresistible—a laughing, chattering live wire, never at a loss for a word."
                                            },
                                            {
                                                "example_id": "bccc6533-4231-4493-b1b3-c03b84302a77",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "Ellen Page gives a star-making performance as a 16-year-old live wire who decides to go through with her pregnancy and seeks acceptably well-adjusted, wealthy, punk-rock loving parents for the unborn baby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e287331a-e1f0-4d7a-9c0d-0aa4bed34e81",
                        "source_entry_id": "9ec69810-2d4a-3975-91a0-2d8587f98267",
                        "source_sense_id": "42581927-f4b8-3c0b-8076-6d8e26df215d",
                        "source_sense_description": "elekriciteitsdraad",
                        "target_lang_word": "fil conducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fil conducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84619631-b0a1-3944-9198-46aef81eea56",
                                        "entry_id": "8d8e0947-563e-3da4-bd00-019ad38124e5",
                                        "glosses": [
                                            "Fil permettant de conduire l'impulsion électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                        "entry_id": "8d8e0947-563e-3da4-bd00-019ad38124e5",
                                        "glosses": [
                                            "Axe principal d'un scénario, d'une histoire ou d'un raisonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ee210e-a966-4243-b00a-4faa87d4ddcb",
                                                "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                                "text": "Le fil conducteur de toutes les interventions était le rôle joué par les jeunes comme vecteurs potentiels du changement."
                                            },
                                            {
                                                "example_id": "fd4ff521-5676-4734-a304-6465c28342ff",
                                                "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                                "text": "Quel fil conducteur permettrait de relier ces thèmes?"
                                            },
                                            {
                                                "example_id": "81c57151-f89c-4959-8fe0-c97ca055f9a3",
                                                "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                                "text": "Elle n’avait pas marché sûrement de déduction en déduction ; mais s’égarant tantôt d’un côté, tantôt de l’autre, elle s’était souvent perdue dans des profondeurs pour elle insondables, et elle avait eu grande peine à retrouver un fil conducteur au milieu de ces détours de conscience qui se révélaient à elle pour la première fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cdd2967-2127-3790-94ba-6ebb8b5e55b3",
                                        "entry_id": "8d8e0947-563e-3da4-bd00-019ad38124e5",
                                        "glosses": [
                                            "Idée, thème principal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1285aa7f-af72-4de9-8fb8-533bacccd298",
                                                "sense_id": "9cdd2967-2127-3790-94ba-6ebb8b5e55b3",
                                                "text": "A posteriori, en vue des entretiens, j’ai reconstruit un fil conducteur dans mon orientation, pour garder la face devant les recruteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
