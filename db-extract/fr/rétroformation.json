                ],
                "senses": [
                    {
                        "sense_id": "adabac64-186a-3800-82e6-6fe3ccf17c49",
                        "entry_id": "97f8acf9-5c68-38f7-948c-19567d1a0565",
                        "glosses": [
                            "Processus permettant de former un mot nouveau par suppression d’un affixe existant ou présumé (par exemple, le verbe agresser, qui apparaît au XIVᵉ siècle par suppression du suffixe -ion du mot agression)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173345b1-b28b-4465-97db-9d89037c49f4",
                                "sense_id": "adabac64-186a-3800-82e6-6fe3ccf17c49",
                                "text": "Le mot anglais burger provient de la rétroformation de hamburger interprété comme burger + ham (« jambon »), alors que le mot hamburger provient à la base de la ville de Hambourg."
                            },
                            {
                                "example_id": "36c5d130-26ed-45ed-ac2f-631681c165af",
                                "sense_id": "adabac64-186a-3800-82e6-6fe3ccf17c49",
                                "text": "Il y a des phénomènes pour lesquels l’analogie offre une bonne base de description, comme le rétroformation, mais il existe d’autres phénomènes où ni l’un ni l’autre mécanisme ne nous aident beaucoup."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61adc22-afd8-4521-aa25-6a0e4abab3c1",
                        "source_entry_id": "97f8acf9-5c68-38f7-948c-19567d1a0565",
                        "source_sense_id": "adabac64-186a-3800-82e6-6fe3ccf17c49",
                        "target_lang_word": "back-formation",
