    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "949a424a-f52f-39a0-ad7d-21116b9dea90",
                    "sense_definition": "Of or relating to chemistry or the interactions of substances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "science_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chemical</w> reaction caused the liquid to change color immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Химическая</w> реакция заставила жидкость мгновенно изменить цвет.",
                                "zh": "<w>化学</w>反应导致液体立即变色。"
                            }
                        },
                        {
                            "text": "Scientists analyze the <w>chemical</w> properties of new materials in the lab.",
                            "target_lang_translations": {
                                "ru": "Ученые анализируют <w>химические</w> свойства новых материалов в лаборатории.",
                                "zh": "科学家们在实验室里分析新材料的<w>化学</w>性质。"
                            }
                        }
                    ],
                    "antonyms": [
                        "physical"
                    ],
                    "common_phrases": [
                        "chemical reaction",
                        "chemical bond",
                        "chemical property",
                        "chemical change",
                        "chemical engineering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к химии или взаимодействию веществ.",
                        "zh": "与化学或物质相互作用有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "химический",
                                "target_lang_sense_clarification": "относящийся к науке химии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化学",
                                "target_lang_sense_clarification": "用于修饰与化学相关的名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b7cea12-a2c5-3f12-9b6b-feafc99a9aab",
                    "sense_definition": "Relating to materials or processes that are artificial rather than natural.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "artificial_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many consumers are concerned about the <w>chemical</w> additives found in processed foods.",
                            "target_lang_translations": {
                                "ru": "Многие потребители обеспокоены <w>химическими</w> добавками, содержащимися в обработанных продуктах.",
                                "zh": "许多消费者担心加工食品中含有的<w>化学</w>添加剂。"
                            }
                        },
                        {
                            "text": "The fruit had a strange, <w>chemical</w> taste that was not pleasant.",
                            "target_lang_translations": {
                                "ru": "У фрукта был странный <w>химический</w> привкус, который был неприятен.",
                                "zh": "这种水果有一种奇怪的、令人不悦的<w>化学</w>味道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "synthetic",
                        "artificial",
                        "man-made"
                    ],
                    "antonyms": [
                        "natural",
                        "organic"
                    ],
                    "common_phrases": [
                        "chemical fertilizer",
                        "chemical weapon",
                        "chemical taste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к искусственным материалам или процессам; ненатуральный.",
                        "zh": "指人工合成而非天然的材料或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "химический",
                                "target_lang_sense_clarification": "ненатуральный, искусственный"
                            },
                            {
                                "target_lang_word": "синтетический",
                                "target_lang_sense_clarification": "созданный искусственным путем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化学",
                                "target_lang_sense_clarification": "指非天然的、人工合成的"
                            },
                            {
                                "target_lang_word": "合成",
                                "target_lang_sense_clarification": "人工制造的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "019d7009-20a0-3f4b-9779-9beedb4cc207",
                    "sense_definition": "Of or relating to alchemy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alchemy_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript described various <w>chemical</w> processes for transmuting metals.",
                            "target_lang_translations": {
                                "ru": "Древний манускрипт описывал различные <w>алхимические</w> процессы трансмутации металлов.",
                                "zh": "那份古老的手稿描述了各种用于金属转换的<w>炼金</w>过程。"
                            }
                        },
                        {
                            "text": "He spent his life studying <w>chemical</w> arts in search of the philosopher's stone.",
                            "target_lang_translations": {
                                "ru": "Он провел всю жизнь, изучая <w>алхимические</w> искусства в поисках философского камня.",
                                "zh": "他一生都在研究<w>炼金</w>术，以寻找贤者之石。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alchemical"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the historical practice of alchemy."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к алхимии (устаревшее значение).",
                        "zh": "与炼金术有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алхимический",
                                "target_lang_sense_clarification": "связанный с алхимией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炼金",
                                "target_lang_sense_clarification": "指古代炼金术的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e0fe3b4-c0f2-3ae7-82ff-7851688910f9",
                    "sense_definition": "Any specific element or compound, especially one prepared or purified for use.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must wear protective gloves when handling dangerous <w>chemicals</w>.",
                            "target_lang_translations": {
                                "ru": "Вы должны надевать защитные перчатки при работе с опасными <w>химикатами</w>.",
                                "zh": "处理危险<w>化学品</w>时必须戴上防护手套。"
                            }
                        },
                        {
                            "text": "The factory was fined for dumping toxic <w>chemicals</w> into the river.",
                            "target_lang_translations": {
                                "ru": "Завод оштрафовали за сброс токсичных <w>химикатов</w> в реку.",
                                "zh": "该工厂因向河中倾倒有毒<w>化学物质</w>而被罚款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compound",
                        "substance"
                    ],
                    "common_phrases": [
                        "toxic chemicals",
                        "household chemicals",
                        "industrial chemicals",
                        "hazardous chemicals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое конкретное вещество или соединение, особенно подготовленное для использования.",
                        "zh": "特定的元素或化合物，尤指为特定用途而制备或提纯的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "химикат",
                                "target_lang_sense_clarification": "химический продукт или препарат"
                            },
                            {
                                "target_lang_word": "химическое вещество",
                                "target_lang_sense_clarification": "научный термин"
                            },
                            {
                                "target_lang_word": "реактив",
                                "target_lang_sense_clarification": "вещество для лабораторных реакций"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化学品",
                                "target_lang_sense_clarification": "工业或实验室用的化学物质"
                            },
                            {
                                "target_lang_word": "化学物质",
                                "target_lang_sense_clarification": "科学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                    "sense_definition": "An artificial substance, often contrasted with natural ingredients.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers to use natural oils on her hair instead of harsh <w>chemicals</w>.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает использовать для волос натуральные масла вместо едкой <w>химии</w>.",
                                "zh": "她更喜欢用天然油护理头发，而不是使用刺激性的<w>化学</w>产品。"
                            }
                        },
                        {
                            "text": "I try to avoid eating food that is loaded with preservatives and <w>chemicals</w>.",
                            "target_lang_translations": {
                                "ru": "Я стараюсь избегать еды, напичканной консервантами и <w>химией</w>.",
                                "zh": "我尽量避免食用含有大量防腐剂和<w>化学</w>添加剂的食物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "synthetic"
                    ],
                    "common_phrases": [
                        "harsh chemicals",
                        "full of chemicals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственное вещество, часто противопоставляемое натуральным ингредиентам.",
                        "zh": "人工合成的物质，常与天然成分相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "химия",
                                "target_lang_sense_clarification": "разг. собирательное название для ненатуральных веществ"
                            },
                            {
                                "target_lang_word": "химикат",
                                "target_lang_sense_clarification": "вредное вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化学添加剂",
                                "target_lang_sense_clarification": "指食品或产品中非天然的成分"
                            },
                            {
                                "target_lang_word": "化学成分",
                                "target_lang_sense_clarification": "指产品中含有的化学物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deca466b-7293-3fff-8f1a-cf4b83202176",
                    "sense_definition": "An addictive drug.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled for years to overcome his dependency on illegal <w>chemicals</w>.",
                            "target_lang_translations": {
                                "ru": "Он годами боролся с зависимостью от нелегальных <w>препаратов</w>.",
                                "zh": "他多年来一直努力克服对非法<w>毒品</w>的依赖。"
                            }
                        },
                        {
                            "text": "The police are cracking down on the sale of dangerous <w>chemicals</w> on the street.",
                            "target_lang_translations": {
                                "ru": "Полиция принимает жесткие меры против продажи опасных <w>веществ</w> на улицах.",
                                "zh": "警方正在严厉打击街头贩卖危险<w>违禁药物</w>的行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drug",
                        "narcotic"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наркотическое вещество.",
                        "zh": "成瘾性药物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наркотик",
                                "target_lang_sense_clarification": "наркотическое средство"
                            },
                            {
                                "target_lang_word": "химия",
                                "target_lang_sense_clarification": "сленг. синтетический наркотик"
                            },
                            {
                                "target_lang_word": "препарат",
                                "target_lang_sense_clarification": "лекарственное или наркотическое средство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒品",
                                "target_lang_sense_clarification": "非法成瘾性药物"
