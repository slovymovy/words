                "senses": [
                    {
                        "sense_id": "e70de987-4281-3f0b-8a1f-525385b18fab",
                        "entry_id": "751ff858-5f78-3e17-88e1-945bf5f15a78",
                        "glosses": [
                            "anrüchige Ausdrucksweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7683572f-5faa-4c13-b1ce-1339341fe43c",
                                "sense_id": "e70de987-4281-3f0b-8a1f-525385b18fab",
                                "text": "„Die vulgäre und obszöne Rede, die im Französischen ebenfalls mit dem Terminus Argot bezeichnet wird, wird im Deutschen meist Gossensprache genannt.“"
                            },
                            {
                                "example_id": "5baa5dd3-78fb-4044-91fa-08a6a2f4423d",
                                "sense_id": "e70de987-4281-3f0b-8a1f-525385b18fab",
                                "text": "„Allerdings macht Brehm eine Einschränkung seiner Wertschätzung und weist auf die haltlose Gossensprache hin, auf das Fluchen, die vulgären Ausdrücke, die der Papagei ausstoßen konnte und die das böse Herz der meisten Papageienwitze werden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
