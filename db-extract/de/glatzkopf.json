                        "form": "den Glatzkopf"
                    },
                    {
                        "form_id": "0b023116-8014-4a07-806c-8172c75ba49e",
                        "entry_id": "926d7228-fe9b-339e-8ae0-297e14661689",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Glatzköpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68058bca-7355-3188-a548-f045c3b79986",
                        "entry_id": "926d7228-fe9b-339e-8ae0-297e14661689",
                        "glosses": [
                            "Kopf mit Glatze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e2f79e-dcf5-4aa9-8aea-61baf479904c",
                                "sense_id": "68058bca-7355-3188-a548-f045c3b79986",
                                "text": "An seinem Glatzkopf verdient der Friseur nichts."
                            },
                            {
                                "example_id": "3c41f33b-6b5d-4120-b210-3b500540779f",
                                "sense_id": "68058bca-7355-3188-a548-f045c3b79986",
                                "text": "„Der Mann mit dem Glatzkopf starrte beide an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e307dca2-6923-354c-8765-87353bbdd5d2",
                        "entry_id": "926d7228-fe9b-339e-8ae0-297e14661689",
                        "glosses": [
                            "ein Mensch, der keine Haare hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbcd5c4-2ef0-4293-9562-d14cb78c56c5",
                                "sense_id": "e307dca2-6923-354c-8765-87353bbdd5d2",
                                "text": "„Am nächsten Tag kauft sich der Glatzkopf zwei Flaschen Asbach Uralt, tritt eine Geschäftsreise an und will nach Helgoland fahren, um sich besoffen zu ertränken.“"
                            },
                            {
                                "example_id": "eec322f5-121c-4bb2-8dea-600055c8956a",
                                "sense_id": "e307dca2-6923-354c-8765-87353bbdd5d2",
                                "text": "„Mir würden keine sieben Glatzköpfe einfallen.“"
                            },
                            {
                                "example_id": "3397bab8-4d52-4fa5-a22a-d77b92d8d0fa",
                                "sense_id": "e307dca2-6923-354c-8765-87353bbdd5d2",
                                "text": "„Ein Monokel tragender Glatzkopf vom Nebentisch setzte ein empörtes Gesicht auf, als hätte man ihm in die Kaffeetasse gespuckt.“"
                            },
                            {
                                "example_id": "3d6b0ebb-a6c8-476f-aefc-27432ce27b8a",
                                "sense_id": "e307dca2-6923-354c-8765-87353bbdd5d2",
                                "text": "„Ein Glatzkopf und ein Stotterer begegnen sich auf der Straße."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e09c407-5436-4c53-9e72-1c632f1bca41",
                        "source_entry_id": "926d7228-fe9b-339e-8ae0-297e14661689",
                        "source_sense_id": "68058bca-7355-3188-a548-f045c3b79986",
                        "source_sense_description": "Kopf mit Glatze",
                        "target_lang_word": "chauve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ef2267-ad86-310f-a25c-466b913d696a",
                                        "entry_id": "56a15c44-d872-3cec-b3f9-cfac5ecfdfa4",
                                        "glosses": [
                                            "Qui n’a plus de cheveux, ou n’en a guère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46309e16-228e-4078-881d-47f2d788ae1b",
                                                "sense_id": "c2ef2267-ad86-310f-a25c-466b913d696a",
                                                "text": "Il releva ses lunettes d’acier sur son front totalement chauve et ses yeux papillotèrent."
                                            },
                                            {
                                                "example_id": "19f0d4f2-35f2-450e-a105-cbea2fec47d3",
                                                "sense_id": "c2ef2267-ad86-310f-a25c-466b913d696a",
                                                "text": "À l'encontre de ce qui se voit en Europe, les hommes sont rarement chauves, et les femmes le sont fréquemment."
                                            },
                                            {
                                                "example_id": "b1a520f1-88e8-49e3-9968-b7dbccaae75d",
                                                "sense_id": "c2ef2267-ad86-310f-a25c-466b913d696a",
                                                "text": "– Vous êtes laid. Vous êtes gras. Vous êtes ridicule et bête. Vous avez le regard faux. Et même, vous ne vous refusez rien : vous vous offrez d’être chauve !"
                                            },
                                            {
                                                "example_id": "597515cc-73a2-491d-8890-2f7c886cbdbd",
                                                "sense_id": "c2ef2267-ad86-310f-a25c-466b913d696a",
                                                "text": "Monsieur, replet, chauve, qui tondait le gazon, suivi d’un yorkshire qui jappait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chauve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8075ec8-36a6-3952-b35e-8f98b350b90d",
                                        "entry_id": "8b2382d2-cc63-3c3b-a9fe-6e7aacbba64a",
                                        "glosses": [
                                            "Personne qui n’a plus de cheveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d2acc4-5111-4073-9c53-cf2415979c59",
                                                "sense_id": "b8075ec8-36a6-3952-b35e-8f98b350b90d",
                                                "text": "Phèdre dit que deux chauves se battirent pour un peigne qu'ils avaient trouvé."
                                            },
                                            {
                                                "example_id": "00f1f43a-7b66-4c9c-92a5-3bbc83e59ef7",
                                                "sense_id": "b8075ec8-36a6-3952-b35e-8f98b350b90d",
                                                "text": "Comme il était fort bien chevelu, par exemple, il morigénait les chauves, surtout quand ils avaient l’impudeur – le mot est de mon père – de ne pas mettre leur chapeau. « Allons, couvrez-vous, monsieur ! Est-ce que je montre mes genoux ? »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chauve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d68b607-bdb3-3464-ac6e-c7e7d959f90a",
                                        "entry_id": "0357fa10-e7b1-323e-b84f-f6f6faaa3069",
                                        "glosses": [
                                            "(Ardoisières) Veine de pierre de couleur claire dans une ardoisière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
