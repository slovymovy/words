                "senses": [
                    {
                        "sense_id": "add72343-cbdd-3375-b1a0-1a344e5a4077",
                        "entry_id": "a935b643-0cc4-323e-a572-24911910d6c1",
                        "glosses": [
                            "Playing at courtship; coquetry."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ffe4c28-cb45-4b81-8881-2f6da500140b",
                                "sense_id": "add72343-cbdd-3375-b1a0-1a344e5a4077",
                                "text": "The inquest on keeper Davidson was duly held, and at the commencement seemed likely to cause Tony Palliser less anxiety than he had expected. Northrop knew all about Tony's flirtation with Lucy Davidson, but it also knew a good deal more about that lady than Tony did, and exculpated him."
                            }
                        ]
                    },
                    {
                        "sense_id": "12684fbd-24ee-3749-b78d-7166ac79d2fe",
                        "entry_id": "a935b643-0cc4-323e-a572-24911910d6c1",
                        "glosses": [
                            "An instance of flirting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "66c01379-2a8e-4fcc-b2e3-3b14d99a6c82",
                                "sense_id": "12684fbd-24ee-3749-b78d-7166ac79d2fe",
                                "text": "Courtenaye augured well from the profound silence; suddenly a burst of applause shook the house, the curtain had fallen, and Booth sprang to Walter's side, who was still engaged in an animated flirtation with an actress who was to play in the afterpiece."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0eae276-c74f-3997-b992-558be462dba0",
                        "entry_id": "a935b643-0cc4-323e-a572-24911910d6c1",
                        "glosses": [
                            "A period of experimentation with or interest in a particular idea or activity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4e3ffe6e-6466-4b0a-9096-9c47bedee195",
                                "sense_id": "e0eae276-c74f-3997-b992-558be462dba0",
                                "text": "The elimination of vacuum-braked wagons would be slowed down, and the Western Region's flirtation with diesel-hydraulic locomotives was questioned."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fd9483f-1bf0-4df1-909f-6cc0d5a9aa20",
                        "source_entry_id": "a935b643-0cc4-323e-a572-24911910d6c1",
                        "source_sense_description": "playing at courtship",
                        "target_lang_word": "флирт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "флирт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1f650dab-b6af-3091-8673-5755895c508d",
                                        "entry_id": "1b11de8d-b97f-3061-98e9-fe7b2caf471b",
                                        "glosses": [
                                            "любовная игра, кокетливое заигрывание с потенциальным любовным партнёром"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b06308-5388-4e94-a200-389ec8dd117a",
                                                "sense_id": "1f650dab-b6af-3091-8673-5755895c508d",
                                                "text": "Годов с шестнадцати ознакомилась с флиртом и имела огромный успех у мужчин."
                                            },
                                            {
                                                "example_id": "70216609-155f-43f4-9f66-8fc3e71cb0c4",
                                                "sense_id": "1f650dab-b6af-3091-8673-5755895c508d",
                                                "text": "Лёгкий флирт, поверхностный романчик для него не имели цены и ничего, кроме брезгливости, в нём не вызывали."
                                            },
                                            {
                                                "example_id": "d2d5f237-8cb4-478c-a355-c8534b777c7d",
                                                "sense_id": "1f650dab-b6af-3091-8673-5755895c508d",
                                                "text": "Обыкновенно Марьяна Сергеевна не слишком обращала внимание на лёгкие флирты мужа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
