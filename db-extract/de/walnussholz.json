                "senses": [
                    {
                        "sense_id": "5e5313af-eea4-3147-8405-7d011e68c2c3",
                        "entry_id": "779f3c8a-1c14-3e2d-91bb-643572efa8c2",
                        "glosses": [
                            "Holz der Walnuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d6ef0a9-ec3f-4dfc-94b3-df0532ff946b",
                                "sense_id": "5e5313af-eea4-3147-8405-7d011e68c2c3",
                                "text": "„Die an einem Riemen aus Geschirrleder über seine Schulter hängende Büchse war eine .270 mit schwerem Lauf, dem Schloss einer 98er Mauser und einem laminierten Schaft aus Ahorn- und Walnussholz.“"
                            },
                            {
                                "example_id": "e93c6165-9291-43c4-a080-d73a868f44fe",
                                "sense_id": "5e5313af-eea4-3147-8405-7d011e68c2c3",
                                "text": "„Der Kamin hat eine Umrahmung aus geschnitztem Walnussholz und einen Feuerrost aus poliertem Messing.“"
                            },
                            {
                                "example_id": "271f80ef-8530-4ce0-9f00-f51b9df9bf42",
                                "sense_id": "5e5313af-eea4-3147-8405-7d011e68c2c3",
                                "text": "„Deutlicher erinnerte er sich an den großen, dämmrigen Salon und das mit dunkelrotem Samt bezogene Sofa, auf dem er an Sommernachmittagen gelegen hatte, an der Wange der schwere Flor, während sein Blick dem verschlungenen, ins Walnussholz der Lehne geschnitzten Blumenmuster folgte, bis die Augen müde wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
