                            {
                                "example_id": "562b978f-f1a0-4893-9d99-f123908f8e1d",
                                "sense_id": "ce4c8ac7-ada3-33c0-87c1-e1ebce80d659",
                                "text": "Ten polski purpurat nie cenił sobie swojego biskupstwa."
