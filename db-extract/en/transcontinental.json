                                                "example_id": "bd312e32-577a-4918-b08d-95b28aa1fc72",
                                                "sense_id": "5e9c8c8e-7564-373c-8b61-678b007f67dd",
                                                "text": "Par l’estafette transcontinentale New-York vient de recevoir des nouvelles de la Californie."
                                            },
                                            {
                                                "example_id": "89b7b452-0869-4445-9723-33710a6701ba",
