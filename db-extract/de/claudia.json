                "translations": [
                    {
                        "translation_id": "461a0163-1279-4dc9-bc39-e1f24619429e",
                        "source_entry_id": "fe600fff-dea1-341d-911c-676cb0c84d98",
                        "source_sense_id": "90018ec2-1627-3b22-b386-ff9f51e40b60",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Claudia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Claudia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                        "entry_id": "b7aa2f8f-03ec-3633-a299-7431ae3c042f",
                                        "glosses": [
                                            "A female given name from Latin, masculine equivalent Claudius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9c5566-ffd9-4517-8346-4ffbf152e6df",
                                                "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                                "text": "Make ſpede to come befoꝛe winter. Eubolus gretith the / and Pudes / and Linus / and Claudia / and all the bꝛethꝛen."
                                            },
                                            {
                                                "example_id": "9b463e3d-5d73-42a1-92c9-85bb09624275",
                                                "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                                "text": "Claudia is really Mummy, but she does not like being Mummy so you have to say Claudia. […] Lisa is a better name. Claudia bangs, like the gong in the hall at Sotleigh. Bang – whoom! Lisa makes a nice silky noise, like streams or rain."
                                            },
                                            {
                                                "example_id": "50018fe4-8452-4335-9d7a-9852876ffbe8",
                                                "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                                "text": "Mexico’s presidential campaign is well underway and if the polls are to be believed, Claudia Sheinbaum, a physicist and candidate of the left-leaning ruling Morena party, could be the country’s next president."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0390908d-3258-46e5-9609-a4070accf9c5",
                        "source_entry_id": "fe600fff-dea1-341d-911c-676cb0c84d98",
                        "source_sense_id": "90018ec2-1627-3b22-b386-ff9f51e40b60",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Claude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Claude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9dd2ef5-00b0-348b-a0a3-e5565191e0eb",
                                        "entry_id": "fbcbc7a4-0414-3313-9ff7-d1fcee5cfad0",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eefabe-e99a-47b2-ab36-24f8f1c0cd01",
                                                "sense_id": "b9dd2ef5-00b0-348b-a0a3-e5565191e0eb",
                                                "text": "Le meilleur tricolore, Fabien Claude, a pris la 9ᵉ place, tandis que Quentin Fillon Maillet (photo), le champion du monde en titre, s’est classé 15ᵉ."
                                            },
                                            {
                                                "example_id": "0cbbe8cb-70f8-4ae1-9843-f94ce810321a",
                                                "sense_id": "b9dd2ef5-00b0-348b-a0a3-e5565191e0eb",
                                                "text": "Chez les hommes, Émilien Claude a accédé à son premier top 10 en carrière, mais le reste de l’équipe a déçu, à l’image de Quentin Fillon Maillet (42ᵉ."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Claude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f7840a-3fd1-3da3-8711-70b63561a5a8",
                                        "entry_id": "62c87427-dcd4-349b-a35d-3abc89f42160",
                                        "glosses": [
                                            "Prénom masculin ou féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8dcce7-442d-4f70-9fa9-3dc02ac68fc4",
                                                "sense_id": "d4f7840a-3fd1-3da3-8711-70b63561a5a8",
                                                "text": "Claude il le voit bien\n Demain\n Il va retomber\n Dans le quotidien\n À se lever de bonne heure\n À arriver à l'heure\n À pas s'en faire\n On veut son bien."
                                            },
                                            {
                                                "example_id": "1e98303c-8258-448d-9b3c-06f59b0c3eb5",
                                                "sense_id": "d4f7840a-3fd1-3da3-8711-70b63561a5a8",
                                                "text": "Cette série de fêtes et de dates du début du mois de février s’intègre pleinement dans l’ensemble héortologique qu’étudia magistralement Claude Gaignebet dans son petit livre sur le Carnaval."
                                            },
                                            {
                                                "example_id": "315b91ff-3b6f-4901-839d-8277f88b48a5",
                                                "sense_id": "d4f7840a-3fd1-3da3-8711-70b63561a5a8",
                                                "text": "Claude adore l’argent, les affaires, elle se voit déjà à la tête d’un trust de l’emballage et de la cosméto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
