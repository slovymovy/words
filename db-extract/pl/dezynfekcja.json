                            {
                                "example_id": "52317e30-918f-4246-8e6f-0fe0f1c3191f",
                                "sense_id": "278ab0f0-4094-361c-9614-ba4788956311",
                                "text": "To pomieszczenie trzeba poddać dezynfekcji."
