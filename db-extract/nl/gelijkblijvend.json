                "senses": [
                    {
                        "sense_id": "41dec2a5-9fcd-35ff-8207-b8106453a8fe",
                        "entry_id": "24902973-5a0f-3745-bf9c-2aeff3a4a2be",
                        "glosses": [
                            "zonder verandering; zonder verschil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bc7751-fca7-4020-8283-3fbd410af1e5",
                                "sense_id": "41dec2a5-9fcd-35ff-8207-b8106453a8fe",
                                "text": "De totaalomzet voor Essential Pharmaceuticals zal bij gelijkblijvend gebruik stijgen van 275.000 euro tot 1,9 miljoen euro per jaar, verwachten de koepel van apothekers (KNMP) en SFK. Ruim 1,5 miljoen euro daarvan komt via de eigen bijdrage voor rekening van de gebruikers."
                            },
                            {
                                "example_id": "e855ed16-ba21-4398-97de-e08d2465fea7",
                                "sense_id": "41dec2a5-9fcd-35ff-8207-b8106453a8fe",
                                "text": "Een inflatie van 2,6 procent betekent dat bij een gelijkblijvend inkomen de koopkracht van huishoudens met hetzelfde percentage afneemt. Dat wil zeggen dat de 100 euro van vorig jaar nu nog ongeveer 97,40 euro waard is."
                            }
                        ]
                    }
