                                "target_senses": [
                                    {
                                        "sense_id": "1ce7739a-6894-350b-a77e-e2bb2e69913c",
                                        "entry_id": "ea43a49a-66c9-3d30-8d78-6205a8bda8cb",
                                        "glosses": [
                                            "Fähigkeit, Undeutliches etwas klarer zu erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df5829f0-95ce-4300-9230-3245c1b797e5",
                                                "sense_id": "1ce7739a-6894-350b-a77e-e2bb2e69913c",
                                                "text": "„Das Motorfliegen erfordert ein beträchtliches navigatorisches Wissen und Können bzw. […] vestibuläre Belastbarkeit, Raumorientierungsvermögen und ein feinmotorisches Gespür für den Umgang mit der Maschine.“"
                                            },
                                            {
                                                "example_id": "f9c653af-b7eb-4157-a5a6-07c268b78a74",
                                                "sense_id": "1ce7739a-6894-350b-a77e-e2bb2e69913c",
                                                "text": "Sein Gespür hat ihn nicht betrogen."
                                            },
                                            {
                                                "example_id": "d465ec29-f607-447d-9913-b2dc6c482deb",
                                                "sense_id": "1ce7739a-6894-350b-a77e-e2bb2e69913c",
                                                "text": "„In diesen Fällen ist der Therapeut auf sein professionelles Wissen, seine Erfahrungen und sein Gespür angewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6369e73-80b9-48a8-a691-5ebf05634887",
                        "source_entry_id": "eff36098-f303-3be8-971a-058bbb68ba30",
                        "target_lang_word": "Witterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Witterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "302b428d-3f9d-3109-a611-c016e7f6ada6",
                                        "entry_id": "72724872-d03a-3e24-9978-965926c88006",
                                        "glosses": [
                                            "Wetterablauf über einen bestimmten Zeitraum hinweg in einem begrenzten Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae8422c-5750-4abe-a256-2bbf8eac292e",
                                                "sense_id": "302b428d-3f9d-3109-a611-c016e7f6ada6",
                                                "text": "Aufgrund der Witterung müssen wir unseren Ausflug absagen."
                                            },
                                            {
                                                "example_id": "8c95c5b5-2cd7-4860-a3cd-d902b5278980",
                                                "sense_id": "302b428d-3f9d-3109-a611-c016e7f6ada6",
                                                "text": "„Seine Holzfassade ist mit einem schwarzen Teeranstrich vor der Witterung geschützt und die Fensterrahmen leuchten in einem intensiven Rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc1cca0a-95f4-3c9f-a5e7-9dc1646097e3",
                                        "entry_id": "72724872-d03a-3e24-9978-965926c88006",
                                        "glosses": [
                                            "Geruchssinn eines Tieres"
                                        ],
                                        "tags": [],
