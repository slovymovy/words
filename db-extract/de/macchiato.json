                "senses": [
                    {
                        "sense_id": "fe7bc83d-de54-399d-9d1f-fadcf8fd6647",
                        "entry_id": "eb929b16-bd8c-3fe3-aaaf-b4d8c2255187",
                        "glosses": [
                            "Latte macchiato, also heiße, aufgeschäumte Milch mit einem Anteil Espresso"
                        ],
                        "tags": [
                            "colloquial",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "43dcc58d-9639-42f1-883a-d97161448331",
                                "sense_id": "fe7bc83d-de54-399d-9d1f-fadcf8fd6647",
                                "text": "„Die Sonne bescheint die Altbaufassaden, vor den Cafés schlürfen entspannte Menschen ihren Macchiato, auf dem Wochenmarkt längt sich die Schlange am Bio-Bäcker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fc40b44-352c-4111-8a00-6b9ff72c260f",
                        "source_entry_id": "eb929b16-bd8c-3fe3-aaaf-b4d8c2255187",
                        "source_sense_id": "fe7bc83d-de54-399d-9d1f-fadcf8fd6647",
                        "source_sense_description": "kurz für: Latte macchiato",
                        "target_lang_word": "macchiato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macchiato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                        "entry_id": "ddfb8dbb-7ef6-3c0e-9c65-350e67df7f60",
                                        "glosses": [
                                            "Espresso topped with steamed milk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aadf71fa-71e9-4aef-a111-f3cbe2c0b2c5",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "Formerly used only in Italy and Seattle, it includes such tongue activators as latte, lungo, cappuccino, ristretto, macchiato, mochaccino and Americano."
                                            },
                                            {
                                                "example_id": "fd617b38-024d-416e-ae50-d72fb144f77a",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "Kadar Al-Jahani glanced around at the rich Romans and the American tourists sipping their macchiati and cappuccini, and smiled."
                                            },
                                            {
                                                "example_id": "17c1d20b-4b1c-44e7-991d-7a656f960ace",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "This is a city obsessed by coffee. Sydneysiders can tell their arabica from their robusta, their macchiati from their ristretti, and have been known to follow their favourite barista from café to café."
                                            },
                                            {
                                                "example_id": "a1b2dcdf-3792-4fe8-bb1d-b26baa346d3b",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "Janie and I are having a couple of macchiati in Carluccio’s and discussing Judith Levine’s best-seller Not Buying It – A Year Without Shopping."
                                            },
                                            {
                                                "example_id": "e11d83df-21f7-4224-a20e-47c83a42656a",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "The book’s contents are for the most part the result of scribbling on napkins over numerous macchiati and espressos away from the office at different posts over the years."
                                            },
                                            {
                                                "example_id": "bd61e13d-0514-4bf3-b3fa-78d31a5587ed",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "Yellow cabs whizzed past, horns blared and people didn’t stop moving as they walked briskly down the sidewalks with their steaming cups of macchiato, mobile phones and iPods."
                                            },
                                            {
                                                "example_id": "c328c929-78a3-4853-845c-22399ec1cf78",
                                                "sense_id": "c2640c38-3d82-3fac-9efa-b8389021445a",
                                                "text": "Senior Grits will splutter into their macchiati at the very idea that political bias is at play, pointing out that the latest list includes a former female head of the Canadian Association of Police Chiefs (Gwen Boniface) and the ex-head of the Ontario Securities Commission (Howard Wetston)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bf56930-c4b8-3058-ad9a-8139002ba067",
                                        "entry_id": "ddfb8dbb-7ef6-3c0e-9c65-350e67df7f60",
                                        "glosses": [
                                            "Ellipsis of latte macchiato."
                                        ],
