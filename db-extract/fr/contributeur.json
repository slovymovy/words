                                        "glosses": [
                                            "A person who backs, supports or champions a cause, activity or institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aab076a4-1cbe-451d-856d-5b6bae3e2e08",
                                                "sense_id": "b620ecd9-9ed6-3322-80c8-aa408a0acfe0",
                                                "text": "He was a regular contributor to Greenpeace protests."
                                            },
                                            {
                                                "example_id": "9b99d2a3-2996-4a43-8a12-8167d3cd469a",
                                                "sense_id": "b620ecd9-9ed6-3322-80c8-aa408a0acfe0",
                                                "text": "The nation lost two major contributors to the cause of human rights in the murders of Mayor George Moscone and Supervisor Harvey Milk on Nov. 27."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "849b607a-9d68-35b2-a4d7-6a483bd2a223",
                                        "entry_id": "7235d3bc-1a5a-384a-9baf-fa11707cb1c3",
                                        "glosses": [
                                            "A person (or thing) instrumental in the creation or growth of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b19e056-98cf-476b-8c46-a15bf53616db",
                                                "sense_id": "849b607a-9d68-35b2-a4d7-6a483bd2a223",
                                                "text": "Methane is a major contributor to global warming"
