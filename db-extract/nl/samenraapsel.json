                        "source_entry_id": "0a6bbeec-d4b1-3bc5-8a69-7cb9cc84b7a9",
                        "source_sense_id": "6325a4a5-a374-32c2-8415-076652fb18db",
                        "source_sense_description": "(pejoratief) een verzameling van zaken die weinig of niets met elkaar te maken hebben",
                        "target_lang_word": "mishmash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
