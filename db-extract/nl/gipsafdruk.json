                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51722edc-b884-4411-8355-965b1e6b4ee6",
                                                "sense_id": "98d71e11-e34d-3e5c-83cb-63ee410a8781",
                                                "text": "Le moulage du blé."
                                            },
                                            {
                                                "example_id": "5c1247c0-a428-465b-82ff-4aa85c315805",
                                                "sense_id": "98d71e11-e34d-3e5c-83cb-63ee410a8781",
                                                "text": "Je ne puis pas comprendre que ce moulin, qui est à une grande demi-lieue de La Fère, n'ait pas l'eau nécessaire pour son moulage."
                                            },
                                            {
                                                "example_id": "abb4e418-87c8-40b1-b838-ad8acf4afc9b",
                                                "sense_id": "98d71e11-e34d-3e5c-83cb-63ee410a8781",
                                                "text": "Droit de moulage, redevance que les vassaux payaient au seigneur pour faire moudre leur grain au moulin banal."
                                            }
                                        ]
                                    }
                                ]
