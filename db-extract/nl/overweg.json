                "senses": [
                    {
                        "sense_id": "a973ca13-0f90-383f-bc96-21d102bbdb02",
                        "entry_id": "267c3e85-a78b-3b72-bf55-d9e6cce4c8d6",
                        "glosses": [
                            "een kruising van een weg met een spoorbaan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eecca316-e658-4004-abb1-52c5e0fa2c10",
                                "sense_id": "a973ca13-0f90-383f-bc96-21d102bbdb02",
                                "text": "De overweg was gesloten omdat er een lange goederentrein aankwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8902a5a4-4805-4d05-8350-3f5229bb716b",
                        "source_entry_id": "267c3e85-a78b-3b72-bf55-d9e6cce4c8d6",
                        "source_sense_id": "a973ca13-0f90-383f-bc96-21d102bbdb02",
                        "source_sense_description": "een kruising van een weg met een spoorbaan",
                        "target_lang_word": "Bahnübergang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bahnübergang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                        "entry_id": "393d55c8-08ee-3d3c-a4f1-0fcc3c338f59",
                                        "glosses": [
                                            "eine besonders gekennzeichnete und gesicherte Stelle, die das Überqueren einer Bahnstrecke ermöglicht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b316c68c-f66d-4161-8b7f-0289529fa640",
                                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                                "text": "An Bahnübergängen geschehen viele Unfälle."
                                            },
                                            {
                                                "example_id": "92d7857e-523e-428e-91f1-d93026b5572e",
                                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                                "text": "„Die Störungen der Bahnübergänge sind offensichtlich beseitigt.“"
                                            },
                                            {
                                                "example_id": "a68f69f4-d8b4-4334-9727-c3e84337ba3e",
                                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                                "text": "„Also: Ich stehe an einer dunklen Landstraße, die aber gleichzeitig zu einem Gewirr von Gleisen und Bahnübergängen führt.“"
                                            },
                                            {
                                                "example_id": "e213f00f-318d-438f-a1e2-ac756e9e5946",
                                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                                "text": "„Ich hatte das Wort irgendwo gelesen, an einen Bahnübergang auf die Schranke geschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01257509-4535-4166-bd26-913f953d1741",
                        "source_entry_id": "267c3e85-a78b-3b72-bf55-d9e6cce4c8d6",
