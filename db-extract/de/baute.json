                                "sense_id": "0597b049-ea4f-338f-96ae-638fbb3e5fc7",
                                "text": "„Es wird eine Baute angelegt am jetzigen Waſſerſpiegel.“"
                            },
                            {
                                "example_id": "fc1b3bc5-7687-4b51-af96-f2f704f4dfcb",
                                "sense_id": "0597b049-ea4f-338f-96ae-638fbb3e5fc7",
                                "text": "„Die Anschlussgebühr ist das einmalige Entgelt für den Anschluss einer Baute oder Anlage an das öffentliche Leitungsnetz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bffe79f5-bc92-39b3-a331-cf5fe5c260ab",
