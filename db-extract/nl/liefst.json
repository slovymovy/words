                "senses": [
                    {
                        "sense_id": "55656e52-7b78-30a9-9e54-2c6ebfd8c253",
                        "entry_id": "4ebaa3c9-8ee1-3810-8f4e-402adbd4d191",
                        "glosses": [
                            "onverbogen vorm van de overtreffende trap van lief"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "62c45e23-703a-4639-a8ee-a53d1ea7ef86",
                                "sense_id": "55656e52-7b78-30a9-9e54-2c6ebfd8c253",
                                "text": "\"Wie van deze kinderen was het liefst en wie het stoutst?\" vroeg Sinterklaas."
                            },
                            {
                                "example_id": "07a58974-1787-4bb8-abfc-571603699f9c",
                                "sense_id": "55656e52-7b78-30a9-9e54-2c6ebfd8c253",
                                "text": "Genie luisterde meer dan ze sprak, had iets ongrijpbaars, was moeilijk te doorgronden en liep het liefst helemaal alleen onder haar zilveren paraplu om de felle zon te vermijden."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "87d49092-2bee-3d1b-990b-c2a8e7126fa0",
                "word": "liefst",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                        "entry_id": "87d49092-2bee-3d1b-990b-c2a8e7126fa0",
                        "glosses": [
                            "benadrukkend, verbazing uitdrukkend (over een groot getal)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb30dc2-adaa-4a25-bbb3-616d70d79f39",
                                "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                                "text": "Hij ging liefst driemaal in de week naar het zwembad."
                            },
                            {
                                "example_id": "7783a183-6775-49c5-b29b-538445ba8736",
                                "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                                "text": "Het huis heeft maar liefst vier badkamers."
                            },
                            {
                                "example_id": "e24fc7d9-0347-4d20-a3df-03001cf9bfea",
                                "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                                "text": "Ons elftal won met liefst 8-1."
                            },
                            {
                                "example_id": "f753a2ed-8cae-4ebf-880c-f84696c03758",
                                "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                                "text": "Na de eeuwwisseling waren er liefst drieduizend clubs in het huidige Tsjechië alleen al."
                            },
                            {
                                "example_id": "a71f4eb5-0488-48e5-92b5-46a885859022",
                                "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                                "text": "Tot aan het uitbreken van de Eerste Wereldoorlog bestreden beide ploegen elkaar liefst 24 maal, waarvan de troostfinale op de Olympische Spelen van 1912 de enige niet- vriendschappelijke ontmoeting was."
                            },
                            {
                                "example_id": "a53110b7-021c-40d3-83a4-ad484a8a05db",
                                "sense_id": "abf005b1-7d9e-3591-b4d6-79a438346238",
                                "text": "Na de eeuwwisseling trok de hoogste divisie liefst vijf miljoen toeschouwers naar de stadions."
                            }
                        ]
                    }
                ],
