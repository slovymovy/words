                    {
                        "sense_id": "5aeac924-aef9-3d60-8332-abbc2855ef3d",
                        "entry_id": "911618fa-827a-3ad2-9efc-5bf3eebe6e1f",
                        "glosses": [
                            "een versnellingsbak in een auto die door de bestuurder zelf handmatig moet worden bediend; handgeschakelde versnellingsbak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79738be-e46a-448b-a521-6004f3a7e5a8",
                                "sense_id": "5aeac924-aef9-3d60-8332-abbc2855ef3d",
                                "text": "Volgens Gemballa-baas Steffen Korbach krijgt de auto meer dan 800 pk. Kopers kunnen volgens hem uitkijken naar een ‘compromisloos voertuig dat tegelijkertijd radicaal, puur en luxueus is. De auto wordt aangedreven door een benzinemotor en krijgt als optie een handbak."
                            },
                            {
                                "example_id": "7af38b09-9c99-4095-8066-655baf30f965",
                                "sense_id": "5aeac924-aef9-3d60-8332-abbc2855ef3d",
                                "text": "De diesel is een 1.7 CDTI turbo motor met 93 kW (130 pk) en een 300 Nm sterk koppel. De twee laatstgenoemde motoren zijn te combineren met een handbak of een automaat, beide met zes versnellingen. Voor de zuinigheid zijn ze allemaal uitgerust met een start-stopsysteem."
                            }
                        ]
