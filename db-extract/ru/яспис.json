                                                "sense_id": "45d37716-6432-34cc-8c17-d1dc91cd32ac",
                                                "text": "Jaspis ist nur sehr selten in reiner Form zu finden."
                                            },
                                            {
                                                "example_id": "49db41aa-1320-4c59-b700-5162838789f4",
                                                "sense_id": "45d37716-6432-34cc-8c17-d1dc91cd32ac",
                                                "text": "Ich besitze einen sehr kostbaren Jaspis."
                                            }
                                        ],
