                "senses": [
                    {
                        "sense_id": "2cf1da34-db76-3381-a70a-14bb220e0ba9",
                        "entry_id": "52b5ffb2-3cce-3b31-95a7-e26469dc2e35",
                        "glosses": [
                            "Faire perdre son caractère adverbial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c66246-dad8-436f-a573-c8d2a7c2e324",
                                "sense_id": "2cf1da34-db76-3381-a70a-14bb220e0ba9",
                                "text": "Direct et sans complaisance, il lui reproche parfois son « écriture close » mais sait aussi à l’occasion encourager son jeune ami et le complimenter par exemple lorsqu’il « désadverbialise » son écriture."
                            },
                            {
                                "example_id": "0f2f9271-f1e7-46a6-b00c-3c6a00d79e8d",
                                "sense_id": "2cf1da34-db76-3381-a70a-14bb220e0ba9",
                                "text": "« Après » se désadverbialise et se transfigure, d’un coup de baguette enjambante, en locution conjonctive : nouveau rebond de la clôture annoncée, cet « après que » ouvre sur un au-delà."
                            }
                        ]
                    }
                ],
