                                        "examples": [
                                            {
                                                "example_id": "350936ab-43bb-40bf-b3a3-2c898966d62b",
                                                "sense_id": "3e947f34-e9bc-3ef2-86b6-6cfd2725774c",
                                                "text": "Die Wehr ist bis an die Elbe gestreift."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                        "entry_id": "75873c86-68f3-3db0-b619-af5f5a914876",
                                        "glosses": [
                                            "Waffe"
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "539e20ff-7d03-4fcf-9f0e-3bc497cbdac5",
                                                "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                                "text": "„Wer jetzt die Wehr ergreift, ergreift sie, mich (die Religion) zu schützen.“"
                                            },
                                            {
                                                "example_id": "9fd54f01-171d-4332-ab4d-ddbcdba0d542",
                                                "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                                "text": "„Zum Gefecht wird die Wehr erhoben oder geschwungen.“"
                                            },
                                            {
                                                "example_id": "efa0f50e-ff81-4b56-9069-0036d0abb39b",
                                                "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                                "text": "„Der Männer alle, so kühn sie sich mühten, / die Wehr sich keiner gewann; / Gäste kamen und Gäste gingen, / die stärksten zogen am Stahl – / keinen Zoll entwich er dem Stamm: / dort haftet schweigend das Schwert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8d07abd-1453-4d38-bb3e-dc9fa3b76e2e",
                        "source_entry_id": "6147587e-aa87-39fb-a457-ef6d2879e3a8",
                        "source_sense_id": "3568958f-e944-386a-b955-8da5ea812ef1",
                        "source_sense_description": "stuw",
                        "target_lang_word": "weir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd0f008-1684-32d7-9a62-856d5c0aa3b5",
                                        "entry_id": "b2bd2ac5-7b3b-3fed-97e8-c15f4baa2a1d",
                                        "glosses": [
                                            "An adjustable dam placed across a river to regulate the flow of water downstream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e412233-87b8-4303-8227-684f2014c816",
                                                "sense_id": "7bd0f008-1684-32d7-9a62-856d5c0aa3b5",
                                                "text": "Though Hambleden's parish register records the death, in 1753, of a bargeman 'Kill'd by accident, shooting ye lock', the turbulent waters of Mill End weir on the River Thames, about a mile from the village, still attract canoeists."
                                            },
                                            {
                                                "example_id": "cf7b2e5b-024f-4597-ad6f-1bbc09964a29",
                                                "sense_id": "7bd0f008-1684-32d7-9a62-856d5c0aa3b5",
                                                "text": "The weir must not represent a physical barrier to fish migration, both locally and throughout the whole river system. If necessary, a fishway is included in the weir."
                                            },
                                            {
                                                "example_id": "11328c07-edf6-48c7-b152-35245e1bf874",
                                                "sense_id": "7bd0f008-1684-32d7-9a62-856d5c0aa3b5",
                                                "text": "A walkway over the weir is likely to be useful for the removal of floating debris trapped by the weir, or for working staunches and sluices on it as the rate of flow changes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dade5f29-ae30-3eb4-825b-b23340127182",
                                        "entry_id": "b2bd2ac5-7b3b-3fed-97e8-c15f4baa2a1d",
                                        "glosses": [
                                            "A fence placed across a river to catch fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb9b8460-732c-45d0-9f88-78cabb791327",
                                                "sense_id": "dade5f29-ae30-3eb4-825b-b23340127182",
                                                "text": "The Taff is naturally a good salmon river, the Ely a sea trout river, but what with weirs and pollusions the fish have been pretty well exterminated."
                                            },
                                            {
                                                "example_id": "15cf9424-5b3a-4bf0-a18b-1881d0112d3a",
                                                "sense_id": "dade5f29-ae30-3eb4-825b-b23340127182",
                                                "text": "The weir catch of mackerel at Monomoy and along Cape Cod has been a failure."
                                            },
                                            {
                                                "example_id": "59bc1fb5-4851-4b21-ade4-de004596b11b",
                                                "sense_id": "dade5f29-ae30-3eb4-825b-b23340127182",
                                                "text": "For a spell we done pretty well. Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c03710f-98cc-3c3a-b939-9b34d0178355",
                                        "entry_id": "b2bd2ac5-7b3b-3fed-97e8-c15f4baa2a1d",
                                        "glosses": [
                                            "Seaweed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9ae299d-9375-4445-9815-9ac64a438a78",
                        "source_entry_id": "6147587e-aa87-39fb-a457-ef6d2879e3a8",
                        "source_sense_id": "3568958f-e944-386a-b955-8da5ea812ef1",
