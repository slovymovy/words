                "senses": [
                    {
                        "sense_id": "d5a2cd65-4861-35f0-ab79-1e26ba869622",
                        "entry_id": "abe5f075-64cc-3af5-8ca4-c9cdfa67ff16",
                        "glosses": [
                            "L'un des véhicules automobiles de la marque Bellanger Frères."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "056286ee-fcfc-4de4-b7f6-997f4ce4c373",
                                "sense_id": "d5a2cd65-4861-35f0-ab79-1e26ba869622",
                                "text": "[…] du groupe d'auto-canons belges entièrement constitué à sa formation de 22 véhicules français : Peugeot (automitrailleuse, auto-caisson, auto-atelier, auto-vivre, auto-chef, auto-pneu, sanitaire), Mors (automitrailleuse) et une Bellanger pour la voiture d'état-major."
                            },
                            {
                                "example_id": "2ad355ef-fea0-40ea-a786-5f6f9ef63b78",
                                "sense_id": "d5a2cd65-4861-35f0-ab79-1e26ba869622",
                                "text": "Revenant aux huit-cylindres, on peut noter deux autres françaises, la Bellanger et la Talbot-Darracq. Ce sont toutefois des huit-cylindres en V, \"formule sans avenir\" (sic), si l'on en croit Henri Petit, comme nous le voyons par ailleurs."
                            },
                            {
                                "example_id": "c86b3ce0-c13c-48e3-a798-97e8eede82dd",
                                "sense_id": "d5a2cd65-4861-35f0-ab79-1e26ba869622",
                                "text": "On rencontre le système Delco sur la 9/12 H D. F. P., la P. G., la Bellanger et la Talbot."
                            },
                            {
                                "example_id": "93a18491-8b0e-453c-abca-e07e8608b71e",
                                "sense_id": "d5a2cd65-4861-35f0-ab79-1e26ba869622",
                                "text": "L'appareil Sparton ? Vous l'avez peut-être déjà vu sur des voitures américaines circulant en France, ou sur les Bellanger, les Fiat qui l'ont déjà adopté pour leur équipement de série."
                            }
                        ]
                    }
