                    },
                    {
                        "translation_id": "2aa99be4-33cd-4699-8424-f15787a1a760",
                        "source_entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
                        "source_sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                        "source_sense_description": "een laagte tussen bergen",
                        "target_lang_word": "Senke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33afafbc-54db-35f9-a8f7-1397e64fd6ce",
                                        "entry_id": "2110b071-2df3-362c-9159-4c9ee923c45e",
                                        "glosses": [
                                            "flache Vertiefung im Boden"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e37648-18a4-42d1-9004-7043183a31d4",
                                                "sense_id": "33afafbc-54db-35f9-a8f7-1397e64fd6ce",
                                                "text": "Ebenen und Flachböden, die von Erhebungen, und seien diese noch so flach, umgeben sind, nennt man Senken."
                                            },
                                            {
                                                "example_id": "7ddc7320-ba20-4e6a-8a11-feb26604ee61",
                                                "sense_id": "33afafbc-54db-35f9-a8f7-1397e64fd6ce",
                                                "text": "„Er füllt eine Senke an der Nordwest-Grenze des Dorchester-Sumpfs aus.“"
                                            },
                                            {
                                                "example_id": "701fcc39-07a5-45b9-b999-4967a7694217",
                                                "sense_id": "33afafbc-54db-35f9-a8f7-1397e64fd6ce",
                                                "text": "„Ganz zum Schluss zogen sie einen Graben um den Hügel, damit dieser in einer Senke stand und dadurch noch größer wirkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2711e73-a021-3d4a-aa74-2b62d369a778",
                                        "entry_id": "2110b071-2df3-362c-9159-4c9ee923c45e",
                                        "glosses": [
                                            "feinmaschiges, quadratisches Netz mit zwei sich rechtwinklig überkreuzenden Draht- oder Kunststoffbügeln, an deren Mitte eine Schnur befestigt ist zum Zwecke des Fangs kleiner Köderfische"
                                        ],
                                        "tags": [
                                            "Angelfischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39ee603-3547-4c28-8c06-fd2796355a92",
                                                "sense_id": "f2711e73-a021-3d4a-aa74-2b62d369a778",
                                                "text": "Mit der Senke fing sie viele Köderfische."
                                            },
                                            {
                                                "example_id": "91b03dbf-bf63-4316-bb56-a10d684c08f3",
                                                "sense_id": "f2711e73-a021-3d4a-aa74-2b62d369a778",
                                                "text": "Er hob die mit Fischen gefüllte Senke aus dem Wasser."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6a14082e-de84-3b11-b5d2-8d51d76d51c0",
                                        "entry_id": "2110b071-2df3-362c-9159-4c9ee923c45e",
                                        "glosses": [
                                            "Empfänger einer Nachricht"
                                        ],
                                        "tags": [
                                            "Informationstheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f932feeb-1b08-4257-a199-c9a57b36e431",
                                                "sense_id": "6a14082e-de84-3b11-b5d2-8d51d76d51c0",
                                                "text": "„Im Idealfall entnimmt die Senke dem einfallenden Nachrichtensignal die Information vollständig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7950a20f-ff7a-3f49-8958-1088e19f9d09",
                                        "entry_id": "2110b071-2df3-362c-9159-4c9ee923c45e",
                                        "glosses": [
                                            "Endpunkt einer Strömung bei Vektorfeldern mit negativer Divergenz (das Gegenteil einer )"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69db4e1-fc7d-49a2-957e-704c377e81a0",
                                                "sense_id": "7950a20f-ff7a-3f49-8958-1088e19f9d09",
                                                "text": "„Ist die Divergenz negativ, so handelt es sich bei dem betrachteten Punkt um eine Senke.“"
                                            },
                                            {
                                                "example_id": "1cad13cc-b99e-46a1-a60f-731663299309",
                                                "sense_id": "7950a20f-ff7a-3f49-8958-1088e19f9d09",
                                                "text": "„Die Divergenz eines Vektorfeldes ist also ein Maß für die Existenz von Quellen oder Senken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c2787cf-9a7d-4f1d-a909-38d35878157d",
                        "source_entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
                        "source_sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                        "source_sense_description": "een laagte tussen bergen",
                        "target_lang_word": "Tal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d6fbfe-7489-3748-84f5-38bba6b9655d",
                                        "entry_id": "2d95234d-2cb0-3346-9139-77c139d6f75c",
                                        "glosses": [
                                            "tiefergelegenes Gelände zwischen Erhebungen, Geländeeinschnitt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8ff849-3ad0-42d1-9e7c-23c83062787e",
                                                "sense_id": "f6d6fbfe-7489-3748-84f5-38bba6b9655d",
                                                "text": "Wir marschieren durch dieses Tal."
                                            },
                                            {
                                                "example_id": "53bb4eb3-21c6-4ed8-81a9-0fe18a38d3a7",
                                                "sense_id": "f6d6fbfe-7489-3748-84f5-38bba6b9655d",
                                                "text": "„Die Marillenbäume verwandeln das Tal jedes Jahr im April in ein rosa-weißes Blütenmeer.“"
                                            },
                                            {
                                                "example_id": "ff1f86ee-0de4-413d-ad38-5e4645d00555",
                                                "sense_id": "f6d6fbfe-7489-3748-84f5-38bba6b9655d",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cb1f126-0411-4e96-9e5b-ee1bafb1d912",
                        "source_entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
                        "source_sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                        "source_sense_description": "een laagte tussen bergen",
                        "target_lang_word": "valley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57c92048-fa5d-3deb-8be1-d142616ab787",
                                        "entry_id": "88ae41ec-3ac4-362f-8bf9-35aecd26b606",
                                        "glosses": [
                                            "An elongated depression cast between hills or mountains, often with a river flowing through it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba5498a8-7c58-48d6-9ec6-d7f2f30fe4ba",
                                                "sense_id": "57c92048-fa5d-3deb-8be1-d142616ab787",
                                                "text": "The Indus River valley was the site of an ancient civilization."
                                            },
                                            {
                                                "example_id": "36311bce-732a-4f09-987d-e0744e958459",
                                                "sense_id": "57c92048-fa5d-3deb-8be1-d142616ab787",
                                                "text": "[I]t sank down through the air and poured over the ground in a manner rather liquid than gaseous, abandoning the hills, and streaming into the valleys and ditches and water-courses even as I have heard the carbonic acid gas that pours from volcanic clefts is wont to do."
                                            },
                                            {
                                                "example_id": "60ddd753-8e92-448b-9d0d-dcec0d9e4d55",
                                                "sense_id": "57c92048-fa5d-3deb-8be1-d142616ab787",
                                                "text": "The El Dorado-Searchlight area is geologically a north-south trending orogenous zone, paralleled on the east by the valley of the Colorado, and by an alluvial valley on the west."
                                            },
                                            {
                                                "example_id": "4c3be8dd-91b2-4a82-8716-d2cecc6f4f1a",
                                                "sense_id": "57c92048-fa5d-3deb-8be1-d142616ab787",
                                                "text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness them as they cut through some of the world's deepest valleys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b187139-5dde-3bbe-b711-c9a0d849fe12",
                                        "entry_id": "88ae41ec-3ac4-362f-8bf9-35aecd26b606",
                                        "glosses": [
                                            "An area which drains itself into a river."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58b76710-9128-3ac8-91c3-254a98386098",
                                        "entry_id": "88ae41ec-3ac4-362f-8bf9-35aecd26b606",
                                        "glosses": [
                                            "Any structure resembling one, e.g. the interior angle formed by the intersection of two sloping roof planes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "valley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c27678e-b0a8-3c7d-a876-e36367080916",
                                        "entry_id": "7d1ddb11-0780-35d7-aed2-d2046e9e8d6d",
                                        "glosses": [
                                            "To form the shape of a valley."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "poetic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352e7a16-d02b-471d-abe2-3efca58e274b",
                                                "sense_id": "4c27678e-b0a8-3c7d-a876-e36367080916",
                                                "text": "These hues of red rose and green and pale green, ruffled and pouted in the billowy white of the dress ballooning and valleying softly, like a yacht before the sail bends low; […]"
                                            },
                                            {
                                                "example_id": "f315798d-d731-4688-8688-a84e64b1ff0b",
                                                "sense_id": "4c27678e-b0a8-3c7d-a876-e36367080916",
                                                "text": "Over Govino Bay, looking up from the water’s edge, the landscape resembles nothing so much as the hills above Genova, valleying into the sea, […]"
                                            },
                                            {
                                                "example_id": "23b784f3-566c-4842-b67e-3d513fdf4316",
                                                "sense_id": "4c27678e-b0a8-3c7d-a876-e36367080916",
                                                "text": "There must be something atavistic in the male blood that makes it rush, relent, rush with the peaks and the valleys, the roundness of Lia's breasts valleying and peaking, the stretch of her neck, the swaying of her hips."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a36bcab8-ea6e-44aa-9bfd-a0762aa0709f",
                        "source_entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
                        "source_sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                        "source_sense_description": "een laagte tussen bergen",
                        "target_lang_word": "vallée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vallée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d72eecd-013c-3996-a839-3aac223116af",
                                        "entry_id": "08c75f87-769b-386d-9a5a-baff9c1494da",
                                        "glosses": [
                                            "Espace resserré entre deux ou plusieurs montagnes."
                                        ],
                                        "tags": [
                                            "Géographie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02d2375-2413-48e1-b94c-2dcc3b599d9f",
                                                "sense_id": "1d72eecd-013c-3996-a839-3aac223116af",
                                                "text": "[…]; et il s’engagea dans une sente qui, par la vallée, mène au bois de Pied-Fontaine."
                                            },
                                            {
                                                "example_id": "975c66dd-1498-458e-9bc3-5cc7c34c698f",
                                                "sense_id": "1d72eecd-013c-3996-a839-3aac223116af",
                                                "text": "Le plateau sur lequel est assise la cité de Carcassonne commande la vallée de l’Aude, qui coule au pied de ce plateau, […]."
                                            },
                                            {
                                                "example_id": "b13fe10c-f786-49e0-aed5-489c8c478e37",
                                                "sense_id": "1d72eecd-013c-3996-a839-3aac223116af",
                                                "text": "Nous reçûmes l’ordre de côtoyer en le remontant le ruisseau de la Tourbe, qui arrose la plus triste vallée du monde, entre des collines basses, sans arbres et sans buissons."
                                            },
                                            {
                                                "example_id": "56015726-208c-4222-bc9b-6e420d359513",
                                                "sense_id": "1d72eecd-013c-3996-a839-3aac223116af",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. Dans sa partie orientale, elle couvre un plateau accidenté coupé de vallées et de ravins profonds."
                                            },
                                            {
                                                "example_id": "f30fff63-0855-456c-8f35-20cc6d7f3773",
                                                "sense_id": "1d72eecd-013c-3996-a839-3aac223116af",
                                                "text": "Une deuxième bande moins importante et discontinue commence un peu à l’W. de Fontaine-les-Luxeuil pour se terminer à la vallée de la Saône, vers Ormoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de45c57-f07a-3022-a9cb-f3a54c4e99a6",
                                        "entry_id": "08c75f87-769b-386d-9a5a-baff9c1494da",
                                        "glosses": [
                                            "Bassin d’un cours d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81594fc4-2b53-4e1e-a0c6-72135aa2bf3b",
                                                "sense_id": "1de45c57-f07a-3022-a9cb-f3a54c4e99a6",
                                                "text": "Les plus belles prairies naturelles du département sont celles de la vallée de l’Aisne ; elles se distinguent par leur magnifique verdure […]."
                                            },
                                            {
                                                "example_id": "8c10affe-f8be-48ac-83b2-1e0aeea0c4b3",
                                                "sense_id": "1de45c57-f07a-3022-a9cb-f3a54c4e99a6",
                                                "text": "C’est ainsi que, dans l’Antiquité, les riches vallées du Nil et de l’Euphrate (Mésopotamie) furent toujours convoitées par des hordes conquérantes."
                                            },
                                            {
                                                "example_id": "026c2c89-c1a2-478b-b247-5a60d5d2d0a6",
                                                "sense_id": "1de45c57-f07a-3022-a9cb-f3a54c4e99a6",
                                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "147d60c7-d114-4bbb-93bd-63bdff508883",
                        "source_entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
