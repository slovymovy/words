                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich muss jetzt leider losgehen, also <w>tschüss</w> und bis morgen!",
                            "target_lang_translations": {
                                "en": "Unfortunately I have to get going now, so <w>bye</w> and see you tomorrow!",
                                "ru": "К сожалению, мне уже пора идти, так что <w>пока</w> и до завтра!",
                                "nl": "Ik moet nu helaas gaan, dus <w>doei</w> en tot morgen!",
                                "pl": "Niestety muszę już iść, więc <w>pa</w> i do jutra!",
                                "fr": "Je dois malheureusement y aller maintenant, alors <w>salut</w> et à demain !",
                                "it": "Purtroppo adesso devo andare, quindi <w>ciao</w> e a domani!",
                                "cs": "Bohužel už musím jít, takže <w>ahoj</w> a zítra!",
                                "tr": "Maalesef artık gitmem gerekiyor, o yüzden <w>hoşça kal</w> ve yarın görüşürüz!",
                                "es": "Lamentablemente me tengo que ir ya, ¡así que <w>chao</w> y hasta mañana!",
                                "zh": "我现在得走了，那就<w>拜拜</w>，明天见！"
                            }
                        },
                        {
                            "text": "Am Ende des Telefonats sagte er kurz „<w>Tschüss</w>!“ und legte auf.",
                            "target_lang_translations": {
                                "en": "At the end of the phone call, he briefly said \"<w>Bye</w>!\" and hung up.",
                                "ru": "В конце телефонного разговора он коротко сказал: «<w>Пока</w>!» — и повесил трубку.",
                                "nl": "Aan het einde van het telefoongesprek zei hij kort „<w>Doei</w>!” en hing op.",
                                "pl": "Na koniec rozmowy telefonicznej powiedział krótko „<w>Cześć</w>!” i się rozłączył.",
                                "fr": "À la fin de l'appel téléphonique, il a dit brièvement « <w>Salut</w> ! » et a raccroché.",
                                "it": "Alla fine della telefonata ha detto brevemente «<w>Ciao</w>!» e ha riattaccato.",
                                "cs": "Na konci telefonátu řekl krátce „<w>Čau</w>!“ a zavěsil.",
                                "tr": "Telefon görüşmesinin sonunda kısaca \"<w>Hoşça kal</w>!\" dedi ve telefonu kapattı.",
                                "es": "Al final de la llamada, dijo brevemente «¡<w>Chao</w>!» y colgó.",
                                "zh": "通话结束时，他简短地说了声“<w>拜拜</w>！”就挂了电话。"
                            }
                        }
