    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59c664aa-e392-38b7-9f5d-78b58085f36d",
                    "sense_definition": "met een krachtige of scheurende beweging iets uit elkaar trekken of vernielen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het dak van de bus werd volledig <w>gereten</w> toen het voertuig de lage spoorbrug raakte.",
                            "target_lang_translations": {
                                "en": "The roof of the bus was completely <w>ripped</w> open when the vehicle hit the low railway bridge."
                            }
                        },
                        {
                            "text": "De sterke wind dreigde het zeil van de boot in tweeën te <w>rijten</w>.",
                            "target_lang_translations": {
                                "en": "The strong wind threatened to <w>tear</w> the boat's sail in two."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheuren",
                        "verscheuren",
                        "openrijten"
                    ],
                    "antonyms": [
                        "maken",
                        "herstellen"
                    ],
                    "common_phrases": [
                        "uit elkaar rijten",
                        "open rijten"
                    ],
                    "target_lang_definitions": {
                        "en": "to pull something apart or destroy it with a powerful or tearing motion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rip",
                                "target_lang_sense_clarification": "to tear apart with force"
                            },
                            {
                                "target_lang_word": "tear",
                                "target_lang_sense_clarification": "to pull apart or rend"
                            },
                            {
                                "target_lang_word": "shred",
                                "target_lang_sense_clarification": "to tear into strips or pieces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ef98c99-ac5b-3a9c-9f37-d03648a38e7c",
                    "sense_definition": "iets met geweld in kleine fragmenten of stukken verdelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten vreesden dat ze door de explosie in stukken <w>gereten</w> zouden worden.",
                            "target_lang_translations": {
                                "en": "The soldiers feared they would be <w>torn</w> to pieces by the explosion."
                            }
                        },
                        {
                            "text": "De woeste honden probeerden de prooi volledig in stukken te <w>rijten</w>.",
                            "target_lang_translations": {
                                "en": "The ferocious dogs tried to <w>rip</w> the prey completely <w>apart</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vernietigen",
                        "aan stukken scheuren"
                    ],
                    "common_phrases": [
                        "in stukken rijten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in de verbinding 'in stukken rijten'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to divide something violently into small fragments or pieces"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tear to pieces",
                                "target_lang_sense_clarification": "to destroy by ripping into fragments"
                            },
                            {
                                "target_lang_word": "rip apart",
                                "target_lang_sense_clarification": "to violently separate into pieces"
                            },
                            {
                                "target_lang_word": "rend",
                                "target_lang_sense_clarification": "to tear into two or more pieces"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c24fd331-dcb2-3ac3-a156-36f166706d69",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>rijt</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit oude landschap zie je nog verschillende <w>rijten</w> die het water afvoeren.",
                            "target_lang_translations": {
                                "en": "In this old landscape, you can still see several <w>gullies</w> that drain the water."
                            }
                        },
                        {
                            "text": "De boer groef extra <w>rijten</w> om zijn land droog te houden tijdens de winter.",
                            "target_lang_translations": {
                                "en": "The farmer dug extra <w>drainage channels</w> to keep his land dry during the winter."
                            }
                        }
                    ],
                    "synonyms": [
