                "senses": [
                    {
                        "sense_id": "dc3f721e-c1c7-31c5-a0c6-e8688cc84010",
                        "entry_id": "b0a9826b-4f07-3cdc-8a8c-b4ee3995052f",
                        "glosses": [
                            "матем., филос. умозаключение, содержащее два исключающих друг друга положения, не допускающих возможности третьего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae95ed2a-128b-4545-8801-6f3d8d4082ec",
                                "sense_id": "dc3f721e-c1c7-31c5-a0c6-e8688cc84010",
                                "text": "Перенесение акцента либо на индерезис, либо на conscientia результировалось в форме дилеммы интуитивизма и эволюционизма в этике."
                            }
                        ]
                    },
                    {
                        "sense_id": "e24cb24d-1d04-30a3-a6b0-09405e267f0f",
                        "entry_id": "b0a9826b-4f07-3cdc-8a8c-b4ee3995052f",
                        "glosses": [
                            "перен. затруднительный выбор между двумя взаимоисключающими решениями, вариантами"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4491dd2-5238-48a6-afa9-19e9d6f154bb",
                        "source_entry_id": "b0a9826b-4f07-3cdc-8a8c-b4ee3995052f",
                        "target_lang_word": "dilemma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilemma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31bb0354-187d-3ff1-a150-5e29445028b7",
                                        "entry_id": "81ac593c-425a-3116-a979-816f7763fbf3",
                                        "glosses": [
                                            "A circumstance in which a choice must be made between two or more alternatives that seem equally undesirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f102aec-4bc7-472a-a2e6-8c2f8a9f8250",
                                                "sense_id": "31bb0354-187d-3ff1-a150-5e29445028b7",
                                                "text": "A strong dilemma in a desperate case! / To act with infamy, or quit the place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b450bb4-99c4-3b41-b213-4ed64c04dbe2",
                                        "entry_id": "81ac593c-425a-3116-a979-816f7763fbf3",
                                        "glosses": [
                                            "Any difficult circumstance or problem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5a1409d-fbe8-3d00-b953-4098be596b1d",
                                        "entry_id": "81ac593c-425a-3116-a979-816f7763fbf3",
                                        "glosses": [
                                            "A type of syllogism of the form \\\"if A is true then B is true; if C is true then D is true; either A or C is true; therefore either B or D is true\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a19a28a-3838-3fc9-85ff-88106f3a7085",
                                        "entry_id": "81ac593c-425a-3116-a979-816f7763fbf3",
                                        "glosses": [
                                            "Offering to an opponent a choice between two (equally unfavorable) alternatives."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b4fa96f-275a-4701-bc36-c4578ec53dfc",
                        "source_entry_id": "b0a9826b-4f07-3cdc-8a8c-b4ee3995052f",
                        "target_lang_word": "dilemme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilemme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c138f0c9-200b-3048-87e2-611acf8671e8",
                                        "entry_id": "fb3cef8c-68fe-3b70-a533-0306d05c7bc9",
                                        "glosses": [
                                            "Sorte d’argument qui contient deux ou plusieurs propositions différentes ou contraires, dont on laisse le choix à l’adversaire, pour le convaincre également, quelle que soit celle qu’il adopte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e697890-55f4-401f-9e96-1c240eaad58a",
                                                "sense_id": "c138f0c9-200b-3048-87e2-611acf8671e8",
                                                "text": "Poser un dilemme."
                                            },
                                            {
                                                "example_id": "46ca4230-87b6-429c-9a5e-58a62dc8f2d9",
                                                "sense_id": "c138f0c9-200b-3048-87e2-611acf8671e8",
                                                "text": "Dilemme sans réplique."
                                            },
                                            {
                                                "example_id": "a3903a32-2d44-40c7-b590-b8f046115fcc",
                                                "sense_id": "c138f0c9-200b-3048-87e2-611acf8671e8",
                                                "text": "« Je suis la Raison froide, glacée, implacable… »\nIl y tient. Il dit cela presque en grinçant des dents, comme s’il écrasait un dilemme et en mâchait les cornes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc92f64e-11be-3408-a3e5-cc8751b899a8",
                                        "entry_id": "fb3cef8c-68fe-3b70-a533-0306d05c7bc9",
                                        "glosses": [
                                            "Choix difficile ou cornélien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4f9a08-efdc-4ab9-ae07-42008728da58",
                                                "sense_id": "cc92f64e-11be-3408-a3e5-cc8751b899a8",
                                                "text": "Je suis devant un dilemme : faire ou ne rien faire ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
