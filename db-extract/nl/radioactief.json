                ],
                "senses": [
                    {
                        "sense_id": "98f84286-16e9-3d7f-a600-6b979c03c341",
                        "entry_id": "fff7807c-a1ba-3710-9fbe-6e3daab55547",
                        "glosses": [
                            "door instabiliteit van de atoomkern materiële deeltjes en/of elektromagnetische straling uitzendend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e3a0259-6f25-4368-8733-6813521e5a62",
                                "sense_id": "98f84286-16e9-3d7f-a600-6b979c03c341",
                                "text": "Bij de door de aardbeving en de erdoor veroorzaakte vloedgolf beschadigde reactoren kwamen\nradioactieve stoffen vrij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8db1fca7-d2ed-4e39-a82d-67fd7d1a344c",
                        "source_entry_id": "fff7807c-a1ba-3710-9fbe-6e3daab55547",
                        "source_sense_id": "98f84286-16e9-3d7f-a600-6b979c03c341",
                        "target_lang_word": "radioactive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radioactive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ada76a-38ac-3291-b96d-95bef75df626",
                                        "entry_id": "6b8c66a9-e9f6-36db-8505-e04a138a8d23",
                                        "glosses": [
                                            "Any radioactive substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed28580-847f-4a7a-a616-cfee9662c927",
                                                "sense_id": "04ada76a-38ac-3291-b96d-95bef75df626",
                                                "text": "Any ship nearby will receive a lethal dose of gamma rays, neutrons, and other radioactives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radioactive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424f51a3-6b0f-38bc-88bc-12fddb1b524b",
                                        "entry_id": "ec32237c-742f-3daa-95a2-1f0bfd4daf37",
                                        "glosses": [
                                            "Exhibiting radioactivity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880635ce-0c34-44b5-ac6a-bc984a6df247",
                                                "sense_id": "424f51a3-6b0f-38bc-88bc-12fddb1b524b",
                                                "text": "As a matter of fact many of our best drinking waters have all sorts of unspecified qualities. Burton water, for example, is radioactive by Beetham's standards up to the ninth degree."
                                            },
                                            {
                                                "example_id": "e85ec921-77ea-4a09-b0b8-1ad4f26a86f8",
                                                "sense_id": "424f51a3-6b0f-38bc-88bc-12fddb1b524b",
                                                "text": "Today, no one would intentionally smear radioactive materials on their face, but in 1933, the dangers of radioactivity were not yet fully understood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                        "entry_id": "ec32237c-742f-3daa-95a2-1f0bfd4daf37",
                                        "glosses": [
                                            "Dangerous and disgusting, particularly of people or ideas."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10b67f2-0971-4e60-a221-9c15165a07e0",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "Even sleazy tactics and his radioactive mouth may not be able to contain this debacle."
                                            },
                                            {
                                                "example_id": "f7f42491-ff87-4cb0-ba29-4bc653574e24",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "It was as though he was possessed of an invisible aura repelling incoming bodies. ‘Look. No one wants to be associated with him now. He’s become radioactive.’"
                                            },
                                            {
                                                "example_id": "4d833111-140d-459c-94c9-64835a0d4bfd",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "And while Biden’s other nominees have done little to provoke Republican backlash thus far, [Neera] Tanden is “radioactive,” as Sen. John Cornyn (R-Texas) put it."
                                            },
                                            {
                                                "example_id": "bd257eb3-dc53-43c6-a1e6-bf9f9d803727",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "If, by some miracle, Democrats hang on to one or both houses of Congress this November, it will be because of Cawthorn, Paul Gosar, Marjorie Taylor Greene, Lauren Boebert and other would-be G.O.P. candidates trying to be just like them — the Radioactive Republicans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41534788-3d4d-4307-91ac-ca97191f8f25",
                        "source_entry_id": "fff7807c-a1ba-3710-9fbe-6e3daab55547",
                        "source_sense_id": "98f84286-16e9-3d7f-a600-6b979c03c341",
                        "target_lang_word": "radioactif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radioactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57a052df-9fdf-3e66-8ab6-833b58b5a7b1",
                                        "entry_id": "f28ab252-ffa4-30fa-9f64-47868718fadb",
                                        "glosses": [
                                            "Qui est doué de radioactivité."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c535573-134e-4e0b-b3c8-b38e8f32ed1c",
                                                "sense_id": "57a052df-9fdf-3e66-8ab6-833b58b5a7b1",
                                                "text": "Au moment même où vous lisez ces lignes, du césium 137, hautement radioactif, est toujours présent, parfois à des concentrations importantes, sur les trois quarts de l’Europe. Y compris en France, notamment dans les régions les plus à l’est."
                                            },
                                            {
                                                "example_id": "72409d96-2052-4ab2-a82e-9e2fbefadace",
                                                "sense_id": "57a052df-9fdf-3e66-8ab6-833b58b5a7b1",
                                                "text": "L'idée est de creuser un trou minuscule dans la corne du rhinocéros pour y glisser un fragment radioactif petit comme un grain de sable."
                                            },
                                            {
                                                "example_id": "a787cce5-0b68-4f40-9243-ed1e87c03907",
                                                "sense_id": "57a052df-9fdf-3e66-8ab6-833b58b5a7b1",
                                                "text": "Ne parler que d’irradiation est intéressant puisque cela renvoie à ce que l’on appelle aujourd’hui « les bombes sales », c’est-à-dire constituées d’explosif chimique dispersant des matières radioactives destinées à contaminer une zone."
                                            },
                                            {
                                                "example_id": "819df0b5-5302-4572-b030-4941864fdc0b",
                                                "sense_id": "57a052df-9fdf-3e66-8ab6-833b58b5a7b1",
                                                "text": "Cependant, au point de vue chimique, un point est définitivement établi ; c'est l'existence d'un élément nouveau follement radioactif, le radium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c38523-d07a-30d8-8c40-ff75cd6ce947",
                                        "entry_id": "f28ab252-ffa4-30fa-9f64-47868718fadb",
                                        "glosses": [
                                            "Néfaste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb78717f-c361-4d68-9efd-bdaef87030cc",
                                                "sense_id": "e4c38523-d07a-30d8-8c40-ff75cd6ce947",
                                                "text": "La patronne du RN sait le nom Le Pen radioactif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f2a8000-aca6-3bc2-bf6a-dd579e9e7ed9",
                                        "entry_id": "f28ab252-ffa4-30fa-9f64-47868718fadb",
                                        "glosses": [
                                            "Qui pénètre tout, à quoi rien ne résiste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae672953-12d7-4eb8-b4f9-df38bbf08bfd",
                                                "sense_id": "2f2a8000-aca6-3bc2-bf6a-dd579e9e7ed9",
                                                "text": "Loin de ces afféteries ou de ces poses d'un académisme suranné, le corps nu de Bardot, d'où émane une sensualité radioactive, fait l'objet de la part de Vadim d'un traitement pictural qui entretient délibérément une relation directe et continue avec la sexualité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7deee56-4317-440a-92db-e651b1a1a7bc",
                        "source_entry_id": "fff7807c-a1ba-3710-9fbe-6e3daab55547",
                        "source_sense_id": "98f84286-16e9-3d7f-a600-6b979c03c341",
                        "target_lang_word": "радиоактивный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "радиоактивный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "addd3cd4-a7b7-3746-a0ee-6a8f476724d0",
                                        "entry_id": "70706449-9815-321f-b074-ffdba87994f1",
                                        "glosses": [
                                            "физ. обладающий радиоактивностью; содержащий элементы, обладающие радиоактивностью, или состоящий из таких веществ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5897305-94ad-4e3e-8f7f-cadd1bd89335",
                                                "sense_id": "addd3cd4-a7b7-3746-a0ee-6a8f476724d0",
                                                "text": "Такой источник был физикам известен — это радиоактивный кобальт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6314a046-80b6-3b14-b588-f2d184ec9784",
                                        "entry_id": "70706449-9815-321f-b074-ffdba87994f1",
                                        "glosses": [
                                            "обусловленный или вызванный радиоактивностью, основанный на ней; сопровождающийся радиоактивным излучением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85228933-b706-4679-974b-3fa34fe76ee3",
                                                "sense_id": "6314a046-80b6-3b14-b588-f2d184ec9784",
                                                "text": "В приложении к исследованию продуктов радиоактивного распада этот новый метод Томсона обещает дать очень интересные результаты."
                                            },
                                            {
                                                "example_id": "5dc7da1e-7cb8-460b-aeda-9dcb4392cefd",
                                                "sense_id": "6314a046-80b6-3b14-b588-f2d184ec9784",
                                                "text": "Я мало понимаю в таких вещах, но наш друг Лео Цандер говорил мне, что когда мы в совершенстве овладеем радиоактивной энергией, то можно будет достигнуть и скорости света."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db950956-cd0d-33c4-8f1f-7b73ab5cb31c",
                                        "entry_id": "70706449-9815-321f-b074-ffdba87994f1",
                                        "glosses": [
                                            "подвергшийся радиоактивному излучению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801c239f-262a-4b7f-8ce4-fc00c9d3f3b1",
                                                "sense_id": "db950956-cd0d-33c4-8f1f-7b73ab5cb31c",
                                                "text": "Американские океанологи поймали в глубоководной впадине у Филиппин… радиоактивных рыб."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eeba7e5-4acb-3929-b8d4-b05b4f28fc86",
                                        "entry_id": "70706449-9815-321f-b074-ffdba87994f1",
                                        "glosses": [
                                            "такой, на котором производятся или обрабатываются радиоактивные материалы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7a8813-d9fb-409a-b49e-f5d1f4e54502",
                                                "sense_id": "4eeba7e5-4acb-3929-b8d4-b05b4f28fc86",
                                                "text": "Прислали на завод очень ценную радиоактивную установку."
                                            }
                                        ]
                                    }
                                ]
                            }
