                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small city of <w>Drain</w> is known for its historic buildings.",
                            "target_lang_translations": {
                                "ru": "Небольшой город <w>Дрейн</w> известен своими историческими зданиями."
