{
    "word_family": [
        "goose"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29cedec2-56fc-3cbb-86fc-a1bbf744849a",
                    "sense_definition": "A young goose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "young_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother goose swam across the pond with each tiny <w>gosling</w> paddling behind her.",
                            "target_lang_translations": {
                                "ru": "Мама-гусыня плыла через пруд, а за ней грёб каждый крошечный <w>гусёнок</w>."
                            }
                        },
                        {
                            "text": "A fluffy yellow <w>gosling</w> hatched from the egg early this morning.",
                            "target_lang_translations": {
                                "ru": "Пушистый жёлтый <w>гусёнок</w> вылупился из яйца сегодня рано утром."
                            }
                        }
                    ],
                    "synonyms": [
                        "gooseling"
                    ],
                    "common_phrases": [
                        "fluffy gosling",
                        "yellow gosling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Птенец гуся; молодой гусь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гусёнок",
                                "target_lang_sense_clarification": "птенец гуся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eba30d9-a812-3801-9e27-fa1d08ee3f0a",
                    "sense_definition": "An inexperienced, immature, or foolish and naive young person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naive_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted like a foolish <w>gosling</w>, believing every word of the salesman's wild pitch.",
                            "target_lang_translations": {
                                "ru": "Он повёл себя как наивный <w>глупыш</w>, поверив каждому слову безумной рекламы продавца."
                            }
                        },
                        {
                            "text": "The manager dismissed the young recruit as a silly <w>gosling</w> who knew nothing about business.",
                            "target_lang_translations": {
                                "ru": "Управляющий отмахнулся от нового сотрудника как от глупого <w>желторотика</w>, который ничего не понимает в бизнесе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "green gosling"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English to describe an inexperienced person."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопытный, наивный или глуповатый молодой человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупыш",
                                "target_lang_sense_clarification": "неопытный, наивный ребёнок или юноша"
                            },
                            {
                                "target_lang_word": "желторотик",
                                "target_lang_sense_clarification": "неопытный, наивный молодой человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "808a787f-a066-39cb-b7fb-f3213883820b",
                    "sense_definition": "A catkin on willows, nut trees, or pines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The branches of the willow tree were covered in soft grey <w>goslings</w> during early spring.",
                            "target_lang_translations": {
                                "ru": "Ранней весной ветви ивы покрылись мягкими серыми <w>серёжками</w>."
                            }
                        },
                        {
                            "text": "Children often walked along the riverbank gathering every downy <w>gosling</w> that had fallen from the trees.",
                            "target_lang_translations": {
                                "ru": "Дети часто гуляли по берегу реки, собирая каждого упавшего с деревьев пушистого <w>котика</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "willow gosling"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used regionally or dialectally for catkins."
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Traditional dialect term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Серёжка (соцветие) ивы, орешника или сосны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серёжка",
                                "target_lang_sense_clarification": "соцветие ивы или орешника"
                            },
                            {
                                "target_lang_word": "котик",
                                "target_lang_sense_clarification": "пушистая серёжка ивы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c6f41d68-d247-38a6-a3c8-32aa76cf2db9",
                    "sense_definition": "A surname transferred from the common noun.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Gosling</w> attended the annual shareholders' meeting yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Гослинг</w> присутствовал на ежегодном собрании акционеров вчера утром."
                            }
                        },
                        {
                            "text": "Several families named <w>Gosling</w> have lived in this county for generations.",
                            "target_lang_translations": {
                                "ru": "Несколько семей по фамилии <w>Гослинг</w> жили в этом округе на протяжении многих поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гослинг",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}