                                "target_senses": [
                                    {
                                        "sense_id": "63b15bc4-1d32-3a2c-b6e2-4739297583fa",
                                        "entry_id": "7b227b8b-bd58-3fc1-b23b-0920c892a798",
                                        "glosses": [
                                            "An act or instance of conveying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0144a620-45bd-4957-b5d5-f7e9dedddd19",
                                                "sense_id": "63b15bc4-1d32-3a2c-b6e2-4739297583fa",
                                                "text": "The times have changed in nothing more (we follow as we were wont the manuscript of Peter Pattieson,) than in the rapid conveyance of intelligence and communication betwixt one part of Scotland and another."
                                            },
                                            {
                                                "example_id": "85fc4891-6ef6-4a6a-ba8b-2c1520f1663a",
                                                "sense_id": "63b15bc4-1d32-3a2c-b6e2-4739297583fa",
                                                "text": "Three in a hansom cab is not, under all circumstances, the most comfortable method of conveyance […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477999d5-cec5-3200-bb17-7bbfb6d9aadd",
                                        "entry_id": "7b227b8b-bd58-3fc1-b23b-0920c892a798",
                                        "glosses": [
                                            "An act or instance of conveying.",
                                            "A manner of conveying one's thoughts, a style of communication."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a12df4-cbc1-4c98-8486-e3db14cf7798",
                                                "sense_id": "477999d5-cec5-3200-bb17-7bbfb6d9aadd",
                                                "text": "She told me, not thinking I had been myself, that I was the prince's jester, that I was duller than a great thaw; huddling jest upon jest with such impossible conveyance upon me, that I stood like a man at a mark, with a whole army shooting at me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ab48887-da49-3163-8ecf-6f1f6ac52abe",
                                        "entry_id": "7b227b8b-bd58-3fc1-b23b-0920c892a798",
                                        "glosses": [
                                            "A means of transporting, especially a vehicle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0239ccb9-4e86-4b85-ac13-85d7399fc5b0",
                                                "sense_id": "8ab48887-da49-3163-8ecf-6f1f6ac52abe",
                                                "text": "Athelstan Arundel walked home all the way, foaming and raging. No omnibus, cab, or conveyance ever built could contain a young man in such a rage. His mother lived at Pembridge Square, which is four good measured miles from Lincoln's Inn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa40e23b-59cc-333a-b8d4-a289c13c6d85",
                                        "entry_id": "7b227b8b-bd58-3fc1-b23b-0920c892a798",
                                        "glosses": [
                                            "An instrument transferring title of an object from one person or group of persons to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
