                "senses": [
                    {
                        "sense_id": "86dd3ad1-d06e-3418-91c7-7191bb16a000",
                        "entry_id": "450e1fc8-4b32-3b99-b3dd-845881634ee1",
                        "glosses": [
                            "To block or withstand the causing of an act or action"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d0527647-6073-4610-974e-8761aea15b95",
                                "sense_id": "86dd3ad1-d06e-3418-91c7-7191bb16a000",
                                "text": "It is conceptually wrong to assert that a person makes a causal contribution to an act and its consequences when it is already being caused by others, simply because she fails to do some other act to uncause what is in progress."
                            }
                        ]
                    }
