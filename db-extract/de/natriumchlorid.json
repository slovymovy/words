                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ebde993-18a9-4acf-9cce-a4bca8fdc5df",
                        "source_entry_id": "fa6d8f28-dfbf-3ea0-a78e-c17abac1228d",
                        "source_sense_id": "271fda2a-7ff7-3a62-9388-ba09b2a42b12",
                        "source_sense_description": "Chemie: Ionenverbindung aus einem Natrium-Kation und einem Chlor-Anion",
                        "target_lang_word": "chlorure de sodium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorure de sodium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47f71d96-1e63-3bca-8192-7502df5e9bd3",
                                        "entry_id": "111a773f-c662-3340-8af9-e7e4e4af1d50",
                                        "glosses": [
                                            "Composé ionique de formule brute NaCl communément utilisé en cuisine comme condiment sous le nom de sel de table ou de sel de cuisine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7072140f-62d4-45ee-8416-793117572270",
                                                "sense_id": "47f71d96-1e63-3bca-8192-7502df5e9bd3",
                                                "text": "Avec sa végétation exubérante de tiges et de feuilles, elle épuise fortement le sol: elle exige de bonnes fumures, et parmi les engrais chimiques réclame surtout l’azotate de soude, le chlorure de sodium et la chaux."
                                            },
                                            {
                                                "example_id": "176c6f7d-a99b-41e0-95df-4be6067b6eeb",
                                                "sense_id": "47f71d96-1e63-3bca-8192-7502df5e9bd3",
                                                "text": "Les globulines sont insolubles dans l'eau, solubles dans une solution de chlorure de sodium à 1 p. 10, précipitée par un excès de chlorure de sodium et par le sulfate de magnésium."
                                            },
                                            {
                                                "example_id": "96b78371-ffcd-4520-acbc-bed09c24c8d4",
                                                "sense_id": "47f71d96-1e63-3bca-8192-7502df5e9bd3",
                                                "text": "L'eau de mer, solidifiée par la congélation, se libère du chlorure de sodium, mais conserve les sulfates ; les embruns peuvent la saupoudrer de sels, et un peu de saumure reste emprisonnée."
                                            },
                                            {
                                                "example_id": "3f8af813-8089-489d-bfab-5f3978c8fb7a",
                                                "sense_id": "47f71d96-1e63-3bca-8192-7502df5e9bd3",
                                                "text": "Ainsi, chaque année, quelque 23 millions de tonnes de chlorure de sodium sont utilisées pour faire fondre la glace et la neige sur le réseau routier nord-américain, précisent les auteurs de cette étude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5174aca6-00b4-4b59-a777-d44f016fcc38",
                        "source_entry_id": "fa6d8f28-dfbf-3ea0-a78e-c17abac1228d",
