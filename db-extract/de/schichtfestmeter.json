                "senses": [
                    {
                        "sense_id": "2a91c6da-3082-3394-b63d-e769a6c0e29d",
                        "entry_id": "c624dde5-bc4f-34bb-81ef-0e007fa5c0b1",
                        "glosses": [
                            "Raummaß für ein Kubikmeter (m³) ordentlich aufgestapeltes, ofenfertig kurz geschnittenes Scheitholz mit möglichen kleinen Zwischenräumen"
                        ],
                        "tags": [
                            "Holzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "f724392d-927e-4af3-8a08-58c9e3377f7e",
                                "sense_id": "2a91c6da-3082-3394-b63d-e769a6c0e29d",
                                "text": "Von einem Gartengrundstück in Tilleda, Ichstedter Weg, stahlen unbekannte Täter vom 03. bis 04.09.11 zwei Schichtfestmeter Brennholz (Buche, Eiche, Pflaume). Der entstandene Schaden beläuft sich auf ca. 170 Euro."
                            },
                            {
                                "example_id": "0b97526e-67e7-4384-a569-81c4ed67d7f6",
                                "sense_id": "2a91c6da-3082-3394-b63d-e769a6c0e29d",
                                "text": "Eine neue Zerhack - Anlage verarbeitet u. a. Schwarten, wodurch jährlich etwa 60 000 Schichtfestmeter Holz eingespart werden können."
                            },
                            {
                                "example_id": "7affada9-263c-4fa1-89a1-351c96ec0428",
                                "sense_id": "2a91c6da-3082-3394-b63d-e769a6c0e29d",
                                "text": "Die Mengenkontrolle kann auch dadurch erfolgen, daß der Greifer des Mobilkranes beim Entladen eine bestimmte Menge Knüppel, z. B. ein Schichtfestmeter (sfm), aus dem Waggon aufnimmt und absetzt."
                            },
                            {
                                "example_id": "aa164143-1734-481d-a4d7-23bda1499630",
                                "sense_id": "2a91c6da-3082-3394-b63d-e769a6c0e29d",
                                "text": "Soll das Schichtholz in „Schichtfestmetern\" aufgesetzt werden, d. h. soll jeder Schichtholzstoß – nach Umrechnung – einen oder mehrere volle Festmeter ergeben, so ist entweder die Länge oder die Breite mit den den Umrechnungszahlen entsprechenden Faktoren zu erweitern (…)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
