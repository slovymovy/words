                "senses": [
                    {
                        "sense_id": "2c105caf-322e-37d8-bfec-9ddf0d64800f",
                        "entry_id": "3b01b46e-a08c-3f28-ba05-599b16d70f25",
                        "glosses": [
                            "A division of the medial surface of the parietal lobe of the cerebrum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce8fd86-fe57-46d2-9764-503b1de4f176",
                                "sense_id": "2c105caf-322e-37d8-bfec-9ddf0d64800f",
                                "text": "The precuneus becomes less active during goal-directed cognitive or perceptual tasks, suggesting it is selectively reducing awareness of potentially distracting environmental factors (Gusnard and Raichle, 2001)."
                            },
                            {
                                "example_id": "a97ba493-c7c6-4316-880b-28071d37b3af",
                                "sense_id": "2c105caf-322e-37d8-bfec-9ddf0d64800f",
                                "text": "The logistic regression model revealed that reduced rCBF^([regional cerebral blood flow]) in the inferior parietal lobule, angular gyrus, and precunei had high predictive values and discriminative ability of converters to nonconverters."
                            },
                            {
                                "example_id": "7505ecc0-ebf0-4dfd-bebc-455d3da01df1",
                                "sense_id": "2c105caf-322e-37d8-bfec-9ddf0d64800f",
                                "text": "Studies using EEG-fMRI have shown that there are bilateral areas of deactivation during generalized spike-wave discharges (GSW) in IGE within the thalamus, precuneus, anterior cingulate cortex and inferior parietal cortex."
                            }
                        ]
                    }
                ],
