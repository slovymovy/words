    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c39e85f6-d1c6-3659-aee4-873c52289a0c",
                    "sense_definition": "Respirer avec force, rapidité et difficulté, généralement après un effort physique intense ou à cause d'une forte chaleur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir couru pour attraper son train, le voyageur <w>haletait</w>, appuyé contre le mur."
                        },
                        {
                            "text": "Écrasé par la chaleur de midi, le vieux chien ne faisait que <w>haleter</w> à l'ombre du grand chêne."
                        }
                    ],
                    "synonyms": [
                        "panteler",
                        "souffler"
                    ],
                    "common_phrases": [
                        "haleter sous l'effort",
                        "haleter de fatigue"
                    ]
                },
                {
                    "sense_id": "a0ec2a40-5bcb-3637-b77e-895b488a3323",
                    "sense_definition": "Avoir le souffle court et saccadé sous l'effet d'une vive émotion, de la terreur ou de l'angoisse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pétrifié par les bruits menaçants dans la nuit, l'enfant terrifié <w>haletait</w> dans son lit."
                        },
                        {
                            "text": "Tout l'auditoire <w>haletait</w> devant les révélations spectaculaires apportées par le témoin."
                        }
                    ],
                    "synonyms": [
                        "suffoquer"
                    ],
                    "common_phrases": [
                        "haleter d'effroi",
                        "haleter d'angoisse"
                    ]
                }
            ]
        }
    ]
