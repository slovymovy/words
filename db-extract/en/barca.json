                        "entry_id": "2c2ef2ad-401c-32f2-b960-e24cb6ff8aec",
                        "glosses": [
                            "Former name of Marj: a city in Libya (in the former Roman province of Libya Superior/Libya Pentapolitana)."
                        ],
