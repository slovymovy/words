                        "entry_id": "60f24e54-6058-3bb2-b063-5916c0627518",
                        "glosses": [
                            "A tricycle having a hooded cab to seat paying passengers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d6d6c0-324d-48c4-afd0-aca5643a42c4",
                                "sense_id": "279de95c-5184-3901-a873-99e8edeaea60",
                                "text": "Southwark: The cause of the fire that seriously disrupted services between London Bridge and Waterloo East on August 17 has been traced to an overheated battery-powered pedicab under the aches [sic: arches] in Union Street."
                            }
                        ]
                    }
                ],
