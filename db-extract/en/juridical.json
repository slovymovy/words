                                                "sense_id": "51e04b85-3f0f-307b-b31d-59115377c818",
                                                "text": "Die juristische Fakultät der Universität ist landesweit angesehen."
                                            },
                                            {
                                                "example_id": "2a705050-ef50-4372-b31a-e18ad55b73e8",
                                                "sense_id": "51e04b85-3f0f-307b-b31d-59115377c818",
                                                "text": "„Die Sache ist juristisch heikel.“"
                                            },
                                            {
                                                "example_id": "b2aba9c0-1ce4-432a-8cb8-e03e2f3bf4f3",
                                                "sense_id": "51e04b85-3f0f-307b-b31d-59115377c818",
                                                "text": "„Ohnehin sei juristische Forschung, wie sie jetzt in Kooperation mit den russischen Strafrechtlern erfolgt […], keine Selbstverständlichkeit, so der Potsdamer Rechtswissenschaftler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
