                "translations": [
                    {
                        "translation_id": "46e02287-3f47-486f-85b8-d7c1833463dd",
                        "source_entry_id": "e00cb498-9bec-3e03-8b2f-c6b058993142",
                        "source_sense_description": "прибираться",
                        "target_lang_word": "set straight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "set straight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca054e15-0db7-3d5c-b106-f50ed0ccd98a",
                                        "entry_id": "19c40f77-4971-3c0d-aa58-c862a0ec0eb3",
                                        "glosses": [
                                            "To correct; to make right or true."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b747b606-aa41-449c-a90c-f120a857cf8e",
                                                "sense_id": "ca054e15-0db7-3d5c-b106-f50ed0ccd98a",
                                                "text": "I'd like to set straight some misconceptions about recent events."
                                            },
                                            {
                                                "example_id": "56a52223-48d6-47e8-ab32-87dedd0b2421",
                                                "sense_id": "ca054e15-0db7-3d5c-b106-f50ed0ccd98a",
                                                "text": "He misspoke, but I quietly set him straight."
                                            },
                                            {
                                                "example_id": "aa227bb4-3de2-41d6-95fe-b93f5972d5b3",
                                                "sense_id": "ca054e15-0db7-3d5c-b106-f50ed0ccd98a",
                                                "text": "Your bedroom is a mess. Set things straight before you go out tonight."
                                            },
                                            {
                                                "example_id": "fd3d2d13-8ca0-4711-86d8-d5773b648eb7",
                                                "sense_id": "ca054e15-0db7-3d5c-b106-f50ed0ccd98a",
                                                "text": "I can't stand it! I know you planned it!\nImma set it straight, this Watergate!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
