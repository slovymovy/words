                            },
                            {
                                "target_word": "pontique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8ac87b-1553-3e3c-a999-b879b2fd1d89",
                                        "entry_id": "161412c8-eb68-3e7f-9ecf-a4f3f3403510",
                                        "glosses": [
                                            "Langue grecque parlée historiquement sur les rives du Pont-Euxin (mer Noire), aujourd’hui surtout en Grèce, issue du grec ancien et considérée comme distincte du grec moderne. Son code ISO 639-3 est pnt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dead9f1a-9642-4e63-b692-bcec0572c7b9",
                                                "sense_id": "7a8ac87b-1553-3e3c-a999-b879b2fd1d89",
                                                "text": "Depuis les années 1920, la plupart des Pontiques vivent donc en Grèce, où beaucoup ont maintenu leur langue, à l’origine un dialecte grec, le pontique (ou \"roum\" ou \"rum\" en turc comme mentionné dans les registres de population de l’Etat Turc), qui a évolué vers une langue distincte, peu compréhensible par les locuteurs du grec moderne, tout comme le cappadocien récemment (juin 2005) redécouvert en Chalcidique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
