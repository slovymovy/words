                ],
                "senses": [
                    {
                        "sense_id": "0bf0bcd6-653e-30bf-906e-9d5ce7f6075f",
                        "entry_id": "d8f304d0-5df5-356d-9660-b378c65131d0",
                        "glosses": [
                            "Nom normalisé donné à dix genres d'oiseaux de la famille des psittaculidés (e.g. perruches, inséparables, etc.) et de la sous-famille des Loriinae comprenant 43 espèces de psittaciformes de petite taille se distinguant des loriquets par leur queue courte et arrondie, leurs couleurs très voyantes où le rouge vif prédomine, et dont la majorité des espèces se rencontrent en Australasie (principaux genres : Chalcopsitta, Charmosyna, Eos, Lorius, Vini, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c8f558-6ac0-43b2-a2a3-e4710bb7ceba",
                                "sense_id": "0bf0bcd6-653e-30bf-906e-9d5ce7f6075f",
                                "text": "On a donné ce nom dans íes Indes orientales à une famille de perroquets, dont le cri exprime assez bien le mot lori. Ils ne sont guère distingués des autres oiseaux de ce genre que par leur plumage, dont ïa couleur dominante est un rouge plus ou moins foncé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0c02b42-8660-4fda-9017-46d003d97a34",
                        "source_entry_id": "d8f304d0-5df5-356d-9660-b378c65131d0",
                        "source_sense_id": "0bf0bcd6-653e-30bf-906e-9d5ce7f6075f",
                        "target_lang_word": "Lori",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lori",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f272c7e-5a9d-3955-a98a-91878e25d6c4",
                                        "entry_id": "fe4ee312-aa3a-3962-87e0-49f96bbaab48",
                                        "glosses": [
                                            "Papagei aus der Unterfamilie Loriinae innerhalb der echten Papageien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ee5a86-d036-4e67-b70b-609d7a341623",
                                                "sense_id": "3f272c7e-5a9d-3955-a98a-91878e25d6c4",
                                                "text": "Loris sind sehr bunt gefärbte Vögel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "276e9bf9-0166-3635-8636-df30de9eafe5",
                                        "entry_id": "fe4ee312-aa3a-3962-87e0-49f96bbaab48",
                                        "glosses": [
                                            "Vertreter einer Familie der Feuchtnasenaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0fdef0-9469-4aef-bda2-fb341810faa5",
                                                "sense_id": "276e9bf9-0166-3635-8636-df30de9eafe5",
                                                "text": "Die großen Augen sind typisch für die nachtaktiven Loris."
                                            },
                                            {
                                                "example_id": "47d9c5ad-9f93-4e07-ab09-cdf5356bfb63",
                                                "sense_id": "276e9bf9-0166-3635-8636-df30de9eafe5",
                                                "text": "„Die neuere Systematik teilt die Primaten in vier Unterordnungen: Lemuroidea oder Lemuren, Galagoidea oder Buschbabys und Loris, Tarsioidea oder Gespenstmakis und Simiae oder Affen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
