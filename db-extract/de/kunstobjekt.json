                "senses": [
                    {
                        "sense_id": "eba28ffd-7521-3d77-8f41-0a56086c814f",
                        "entry_id": "8d8ab2b7-b856-3aa9-ac80-3759efbce86c",
                        "glosses": [
                            "künstlerisch gestaltetes, zu Kunst gemachtes Objekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34de7c74-2cfb-4c59-8b5b-9523ccf96df2",
                                "sense_id": "eba28ffd-7521-3d77-8f41-0a56086c814f",
                                "text": "„Er hat viele Autos gesehen, die bei Unfällen zerstört wurden, er hat Autos mit abgerissenen Dächern gesehen, die unter Laster geraten waren, er hat Autos gesehen, die von Bussen in zwei Teile gerissen wurden, aber noch nie hat er eines gesehen, dass in die Luft gejagt wurde. Es ist ein Haufen zerfetztes und verbogenes Metall, weniger ein Auto als irgendein verrücktes, modernes Kunstobjekt.“"
                            },
                            {
                                "example_id": "47c51730-4427-4c88-ac01-da6c2dbbe04d",
                                "sense_id": "eba28ffd-7521-3d77-8f41-0a56086c814f",
                                "text": "„Doch die Göttinnen waren in Rachel Mathias' Empfangszimmer bestens vertreten, einem Zimmer voll teurer, zum Teil sehr alter Kunstobjekte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
