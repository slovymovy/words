                    {
                        "translation_id": "2b3d5df8-f1be-404f-87ba-697731d9a4a8",
                        "source_entry_id": "4e47bf45-9363-352a-b4f0-c4d463cd5103",
                        "source_sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
