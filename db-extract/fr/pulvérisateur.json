                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7ef04e6d-90a1-4458-afd1-a925b689e867",
                        "entry_id": "620afbd4-1ab4-39fe-a89a-71f52ec6d3a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "pulvérisateurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67c4c30d-0600-351c-8d2a-29402d2385d2",
                        "entry_id": "620afbd4-1ab4-39fe-a89a-71f52ec6d3a3",
                        "glosses": [
                            "Instrument qui sert à pulvériser, à lancer un liquide en gouttelettes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c6a1161e-a08c-334f-9564-a73b8c0a9fcb",
                        "entry_id": "620afbd4-1ab4-39fe-a89a-71f52ec6d3a3",
                        "glosses": [
                            "Matériel posé au bout d'un tuyau permettant la pulvérisation d’un liquide ou d'une poudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76338da2-0d12-4322-b165-ed87d0f841b3",
                                "sense_id": "c6a1161e-a08c-334f-9564-a73b8c0a9fcb",
                                "text": "Un pulvérisateur à peinture."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e4d0f46-71c5-3cb7-8534-03beb549d5b3",
                        "entry_id": "620afbd4-1ab4-39fe-a89a-71f52ec6d3a3",
                        "glosses": [
                            "Appareil permettant de vaporiser sous forme de brouillard un médicament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca146d5-5a61-4c21-a84a-dc4fe0ebfacc",
                                "sense_id": "1e4d0f46-71c5-3cb7-8534-03beb549d5b3",
                                "text": "Un pulvérisateur nasal."
                            }
                        ]
                    },
                    {
                        "sense_id": "288bab1c-fd8f-3b85-8d58-929e780851a0",
                        "entry_id": "620afbd4-1ab4-39fe-a89a-71f52ec6d3a3",
                        "glosses": [
                            "Matériel manuel ou tracté permettant l'épandage de produits phytosanitaires dans les champs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd476a7e-b68d-455f-8c14-54a5b875a714",
                                "sense_id": "288bab1c-fd8f-3b85-8d58-929e780851a0",
                                "text": "La mise en œuvre des méthodes de lutte physique est compliquée par plusieurs facteurs et ces méthodes supportent mal la comparaison aux systèmes de protection entièrement basé sur l'utilisation d'un pulvérisateur agricole pour l'application des pesticides sous forme liquide."
                            },
                            {
                                "example_id": "7497ed21-1561-463d-853c-f90d704fc93a",
                                "sense_id": "288bab1c-fd8f-3b85-8d58-929e780851a0",
                                "text": "Il restait des jardinières envahies de plantes poilues […]. Un pulvérisateur de désherbant pas catholique du tout. Et un escargot qui bavait trop rampait sur un gant perdu au milieu de tout ça."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f4e643d-09d3-3c60-a851-c039b5a72b1b",
                        "entry_id": "620afbd4-1ab4-39fe-a89a-71f52ec6d3a3",
                        "glosses": [
                            "Pulvériseur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f25ff68a-4ae9-4e81-94a2-2a00273cea6a",
                                "sense_id": "3f4e643d-09d3-3c60-a851-c039b5a72b1b",
                                "text": "Depuis la construction des pulvérisateurs à disques, beaucoup de propriétaires de grands vignobles font usage de cet instrument merveilleux, qui convient à tous les sols, […]: il remplace tous les autres outils même la charrue."
                            }
                        ]
                    }
                ],
