                        ],
                        "examples": [
                            {
                                "example_id": "da5db434-1521-4f42-8f96-e7c3820e8698",
                                "sense_id": "7395315c-58d0-30b7-822f-954f98119d48",
                                "text": "Volgende maand gaan we op reis naar Warschau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7558a232-ed46-4533-84c6-3eee3861e91d",
                        "source_entry_id": "fb0bf965-e7b8-3787-af3d-c9a41e5027a3",
                        "source_sense_id": "7395315c-58d0-30b7-822f-954f98119d48",
                        "source_sense_description": "hoofdstad van Polen",
                        "target_lang_word": "华沙",
