                    {
                        "translation_id": "3b6cbcb8-e814-4dca-8ea2-b9b5e9eae455",
                        "source_entry_id": "2a70c887-77cf-3473-abaa-f2ef8ef304a5",
                        "source_sense_id": "dd187de5-affe-3c20-94d0-ea73445a40f8",
                        "target_lang_word": "Stieftochter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stieftochter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "003512b8-98e1-396c-a59d-29106ee13c8c",
                                        "entry_id": "d1f49105-8535-3ee0-8977-1e97097186cf",
                                        "glosses": [
                                            "eine Tochter der Ehefrau oder des Ehemanns aus einer früheren Ehe oder einer außerehelichen Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f3bfc04-c7c1-4ea7-bacf-2e25e5db09d3",
                                                "sense_id": "003512b8-98e1-396c-a59d-29106ee13c8c",
                                                "text": "Die Stieftochter wurde immer als das ungezogene Kind tituliert."
                                            },
                                            {
                                                "example_id": "a2c70abd-750d-46b0-bbe9-ff9ed6ca558e",
                                                "sense_id": "003512b8-98e1-396c-a59d-29106ee13c8c",
                                                "text": "„Meine spätere Stiefmutter hatte ebenfalls keinen Grund, für ihre Stieftochter oder für mich besondere Zuneigung zu entwickeln.“"
                                            },
                                            {
                                                "example_id": "aac201d9-7e09-4ef1-9530-0dd5dbf87598",
                                                "sense_id": "003512b8-98e1-396c-a59d-29106ee13c8c",
                                                "text": "„Mit seiner Frau Elsa, den beiden Stieftöchtern und der bewährten Sekretärin Helene Dukas aus Freiburg bewohnten die Einsteins ein Reihenhaus in Princeton.“"
                                            },
                                            {
                                                "example_id": "c0e890cc-d4ca-4055-a811-d7445e17b2ff",
                                                "sense_id": "003512b8-98e1-396c-a59d-29106ee13c8c",
                                                "text": "„Roth sah und hörte nie wieder etwas von seiner früheren Stieftochter.“"
                                            },
                                            {
                                                "example_id": "26246e00-ee41-4182-bf93-3da957d1ba84",
                                                "sense_id": "003512b8-98e1-396c-a59d-29106ee13c8c",
                                                "text": "„Allerdings hat Wieland sich tatsächlich um die Stieftochter beworben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c12176ad-f322-44a5-a29a-723e1e746ccd",
                        "source_entry_id": "2a70c887-77cf-3473-abaa-f2ef8ef304a5",
                        "source_sense_id": "dd187de5-affe-3c20-94d0-ea73445a40f8",
                        "target_lang_word": "stiefdochter",
