            {
                "entry_id": "f675545b-6171-39b2-bc9e-1cbea502ea41",
                "word": "backcountry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c6e18961-41cb-4a1c-8ef5-92941a5ec9de",
                        "entry_id": "f675545b-6171-39b2-bc9e-1cbea502ea41",
                        "tags": [
                            "plural"
                        ],
                        "form": "backcountries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16218d70-81e2-3af0-b358-471c0233dc37",
                        "entry_id": "f675545b-6171-39b2-bc9e-1cbea502ea41",
                        "glosses": [
                            "A remote region; countryside that is relatively inaccessible."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "705e5d6c-5b01-4a6a-b6f9-b77ccbfdce94",
                                "sense_id": "16218d70-81e2-3af0-b358-471c0233dc37",
                                "text": "Near-synonyms: upcountry, interior, hinterland"
                            },
                            {
                                "example_id": "259ce608-3631-4818-8111-5decd6c3edb8",
                                "sense_id": "16218d70-81e2-3af0-b358-471c0233dc37",
                                "text": "Recreationists use either the frontcountry or the backcountry—or both. The standard definition of “frontcountry” is an area that can be reached in a day. You do not stay out overnight."
                            },
                            {
                                "example_id": "1dea94ee-c8b9-418a-939c-075d85789c3d",
                                "sense_id": "16218d70-81e2-3af0-b358-471c0233dc37",
                                "text": "Even his family didn't know exactly where he was; he'd told them Thorndike, but he hadn't mentioned that he was heading to the backcountry, and he hadn't s[ecofoed how long he'd be away;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85c04a54-fd63-4251-adf7-3044fbcd308a",
                        "source_entry_id": "f675545b-6171-39b2-bc9e-1cbea502ea41",
                        "source_sense_id": "16218d70-81e2-3af0-b358-471c0233dc37",
                        "source_sense_description": "remote region",
                        "target_lang_word": "achterland",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterland",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                                        "glosses": [
                                            "streek die geografisch verder weg ligt, maar economisch verbonden is met een voorliggende streek of stad, meestal aangeduid gezien vanaf zee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1901ae7-cbb6-4c60-96a4-f20a798eab6d",
                                                "sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                                                "text": "De goederen die in de haven kwamen werden vervolgens het achterland in vervoerd."
                                            },
                                            {
                                                "example_id": "6f0aff8b-5451-4ffe-ad70-c9a89019ed63",
                                                "sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                                                "text": "De Rode Zee en het dorre achterland waren prachtig als je er een paar weken verbleef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe886d7b-b6cb-3e96-bf0d-edc7bbf87d2f",
                                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                                        "glosses": [
                                            "achteraf gelegen gebied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0277d99e-740a-4ff9-858e-284ce26bb654",
                                                "sense_id": "fe886d7b-b6cb-3e96-bf0d-edc7bbf87d2f",
                                                "text": "Het achterland lag verder van de dijk en was drassiger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bdd1c52-6cd6-31ab-8e05-b196acaaa97c",
                                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                                        "glosses": [
                                            "volkenrechtelijk nog onbezet gebied dat is gelegen achter een invloedssfeer die meer aan de kust ligt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7592a2c5-27e9-3535-a154-7e3d9f8f8447",
                                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
