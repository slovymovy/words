{
    "word_family": [
        "obalać",
        "obalenie",
        "obalony"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf0f55aa-14cc-3f38-8293-7bf736af409e",
                    "sense_definition": "pozbawić władzy, usunąć rząd lub system polityczny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "polityka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Polacy <w>obalili</w> komunizm bez rozlewu krwi.",
                            "target_lang_translations": {
                                "ru": "Поляки <w>свергли</w> коммунизм без кровопролития."
                            }
                        },
                        {
                            "text": "Opozycja próbowała <w>obalić</w> rząd w drodze pokojowych protestów.",
                            "target_lang_translations": {
                                "ru": "Оппозиция пыталась <w>свергнуть</w> правительство путем мирных протестов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obalić rząd",
                        "obalić system"
                    ],
                    "target_lang_definitions": {
                        "ru": "свергнуть, лишить власти правительство или политический режим"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свергнуть",
                                "target_lang_sense_clarification": "о насильственном или политическом отстранении от власти"
                            },
                            {
                                "target_lang_word": "низложить",
                                "target_lang_sense_clarification": "о лишении власти монарха или правителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb8fea7f-20b5-3071-8901-9c2db435bbd8",
                    "sense_definition": "udowodnić, że coś jest fałszywe lub błędne",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Najnowsze badania <w>obaliły</w> tę hipotezę.",
                            "target_lang_translations": {
                                "ru": "Последние исследования <w>опровергли</w> эту гипотезу."
                            }
                        },
                        {
                            "text": "Naukowiec z łatwością <w>obalił</w> błędne argumenty przeciwnika.",
                            "target_lang_translations": {
                                "ru": "Ученый с легкостью <w>опроверг</w> ошибочные аргументы оппонента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obalić tezę",
                        "obalić argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "доказать ложность или ошибочность чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровергнуть",
                                "target_lang_sense_clarification": "доказать несостоятельность аргументов, теории или гипотезы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05e8bf6-0a4f-3187-9711-357b4c46ceee",
                    "sense_definition": "przewrócić coś stojącego na ziemię",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr <w>obalił</w> stare drzewo w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>повалил</w> старое дерево в саду."
                            }
                        },
                        {
                            "text": "Dziecko przypadkiem <w>obaliło</w> wazon stojący na stole.",
                            "target_lang_translations": {
                                "ru": "Ребенок случайно <w>опрокинул</w> вазу, стоявшую на столе."
                            }
                        }
                    ],
                    "synonyms": [
                        "przewrócić się"
                    ],
                    "common_phrases": [
                        "obalić drzewo",
                        "obalić płot"
                    ],
                    "target_lang_definitions": {
                        "ru": "опрокинуть, повалить что-то стоящее на земле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повалить",
                                "target_lang_sense_clarification": "опрокинуть что-то высокое или стоящее вертикально"
                            },
                            {
                                "target_lang_word": "опрокинуть",
                                "target_lang_sense_clarification": "перевернуть предмет, заставив его упасть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a7780a1-c5c1-3ac5-b027-5f05be00965e",
                    "sense_definition": "szybko wypić dużą ilość alkoholu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alkohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj u Franka <w>obaliliśmy</w> dwa winiacze.",
                            "target_lang_translations": {
                                "ru": "Вчера у Франка мы <w>опрокинули</w> по две бутылки вина."
                            }
                        },
                        {
                            "text": "Po ciężkim dniu pracy <w>obalił</w> piwo jednym haustem.",
                            "target_lang_translations": {
                                "ru": "После тяжелого рабочего дня он <w>опрокинул</w> пиво одним махом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obalić flaszkę",
                        "obalić piwo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро выпить большое количество алкоголя (разговорное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрокинуть",
                                "target_lang_sense_clarification": "разговорное выражение для быстрого употребления спиртного"
                            },
                            {
                                "target_lang_word": "выпить",
                                "target_lang_sense_clarification": "общее значение, в контексте часто используется с уточнением количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3408d2b-c3e6-3197-b4ef-df4b7c04d2e5",
                    "sense_definition": "pozbawić mocy prawnej",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąd <w>obalił</w> wcześniejszy wyrok ze względu na nowe dowody.",
                            "target_lang_translations": {
                                "ru": "Суд <w>отменил</w> предыдущий приговор в связи с новыми доказательствами."
                            }
                        },
                        {
                            "text": "Prawnicy starają się <w>obalić</w> decyzję administracyjną.",
                            "target_lang_translations": {
                                "ru": "Юристы пытаются <w>оспорить</w> административное решение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obalić wyrok",
                        "obalić decyzję"
                    ],
                    "target_lang_definitions": {
                        "ru": "лишить юридической силы, отменить решение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменить",
                                "target_lang_sense_clarification": "аннулировать действие решения или приговора"
                            },
                            {
                                "target_lang_word": "оспорить",
                                "target_lang_sense_clarification": "попытаться добиться отмены через суд"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}