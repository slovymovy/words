                        ]
                    },
                    {
                        "translation_id": "971da585-1faa-462e-98ec-36bbbb267a3f",
                        "source_entry_id": "c7393a5f-498a-3eb5-a47d-5640cd70fd1a",
                        "source_sense_id": "62755313-0b49-3b30-b482-42ada3efbf48",
                        "source_sense_description": "Anatomie: Teil des Gebisses von Menschen und Wirbeltieren",
                        "target_lang_word": "picot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f456e03e-a459-320a-b7d0-9df2abe92374",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Petite pointe qui demeure sur le bois qu’on n’a pas coupé net."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f0bfce-4bec-44ed-a3d5-2af74ec3c697",
                                                "sense_id": "f456e03e-a459-320a-b7d0-9df2abe92374",
                                                "text": "Je me suis écorché la main à un picot."
                                            },
                                            {
                                                "example_id": "a2044691-f562-4025-bed4-cfb173269970",
                                                "sense_id": "f456e03e-a459-320a-b7d0-9df2abe92374",
                                                "text": "Sur ce dernier aspect, Jean-Luc Mélenchon confesse malgré tout avoir eu du mal à se retenir face aux attaques de certains de ses concurrents à gauche : \"La langue me piquait parce que les picots que je recevais étaient acérés. Je pense que ça a fait son travail, ça a convaincu\", continuait-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf81c08-4ffc-3c21-9dd1-5cf2342cab84",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Bourgeon de gourmand situé à la surface d’un tronc ; trace laissée dans la grume par ce bourgeon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ad08c7-eb18-455d-8e71-cb539e923e94",
                                                "sense_id": "cdf81c08-4ffc-3c21-9dd1-5cf2342cab84",
                                                "text": "La présence de gourmands ou de picots entraîne la formation d’un petit nœud dégradant l’esthétisme du bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a228a91-26d2-3b71-8860-2dc891132901",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Petite engrêlure qui se trouve à l’un des bords des dentelles et des passements de fil, d’or, de soie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d073c47b-0dad-44ab-b3a4-6a2f94f0ec45",
                                                "sense_id": "9a228a91-26d2-3b71-8860-2dc891132901",
                                                "text": "Les petites dentelles ordinaires s'appelaient la « bisette ». La « campane » avait en bordure des picots en forme de grelots, ce pourquoi on la nommait du même nom que les campanules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce71ca05-a2f2-329d-b852-8d2e8201ec8b",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Pointe métallique posée sur un vêtement ou intégrée à un bijou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "768b7b21-d36c-4fa4-8008-fbf00ec91aa9",
                                                "sense_id": "ce71ca05-a2f2-329d-b852-8d2e8201ec8b",
                                                "text": "Une collection qui s'ordonne autour d'un motif ayant fait ses preuves en joaillerie : le picot, apparu durant l'entre-deux-guerres, adopté par la sphère punk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d79f60e-b686-3923-b47a-d025840513e4",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Marteau pointu dont se servaient les carriers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1fce3cd-b197-3269-8f6c-16d363aae056",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Voleur de vin dans les barriques des entrepôts."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66de8adf-7313-4f06-badb-0e5eca26a57d",
                                                "sense_id": "d1fce3cd-b197-3269-8f6c-16d363aae056",
                                                "text": "De la Halle aux vins aux entrepôts de Bercy.[…]. Les picots sont des biberons qui vous pompent des barriques et revendent le contenu à des bistros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914807f6-26a8-3d86-94ec-b680c08978b7",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Point ou marque, généralement de forme arrondie, sur le bois, le tissu, un fruit ou un animal."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e19cd0f-fee1-4c97-8153-95342c36409e",
                                                "sense_id": "914807f6-26a8-3d86-94ec-b680c08978b7",
                                                "text": "La varicelle n'est plus contagieuse quand la personne a des picots sur son corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d747e1d-55ec-3c20-9cba-727f27e481bb",
                                        "entry_id": "45dbf0c0-750d-3097-bee5-5a13a3a9f0ba",
                                        "glosses": [
                                            "Nom vernaculaire du sigan (Siganus), poisson du sous-ordre des Acanthuroidei."
                                        ],
                                        "tags": [
                                            "Nouvelle-Calédonie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c768b0-13d2-431e-8e7d-231b26af055d",
                                                "sense_id": "3d747e1d-55ec-3c20-9cba-727f27e481bb",
                                                "text": "Le picot est aux Calédoniens, ce que le paraha peue est aux Polynésiens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "picot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "228f2a81-7d8f-39ab-8051-931da28b1f2c",
                                        "entry_id": "71ad2b66-98e0-30db-96aa-8b92c63ecfd1",
                                        "glosses": [
                                            "Dindon, dinde."
                                        ],
                                        "tags": [
                                            "Normandie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7906339e-01b1-4cc0-9e3b-ceb703d326d3",
                                                "sense_id": "228f2a81-7d8f-39ab-8051-931da28b1f2c",
                                                "text": "Chaque premier dimanche d'août, la ville de Lisieux organise une \"Foire aux Picots\"."
                                            },
                                            {
                                                "example_id": "94cba5ae-7a74-4390-9144-550f7cf61830",
                                                "sense_id": "228f2a81-7d8f-39ab-8051-931da28b1f2c",
                                                "text": "Mais, la prochaine fois, par changement, je vous donnerai un coq, à moins que vous ne teniez de préférence aux picots ; et renvoyez-moi la bourriche, s'il vous plaît, avec les deux anciennes."
                                            }
                                        ]
                                    }
