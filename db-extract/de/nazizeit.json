                ],
                "senses": [
                    {
                        "sense_id": "2339b34a-a040-3c3c-8682-249982271ab9",
                        "entry_id": "d6c85fae-aa45-3276-a96f-285bceb57890",
                        "glosses": [
                            "Zeit der Herrschaft des Nationalsozialismus in Deutschland von 1933–1945"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfdae511-8e4a-4658-9ec4-8b096999453b",
                                "sense_id": "2339b34a-a040-3c3c-8682-249982271ab9",
                                "text": "„Die Nazizeit ließ ihn nicht in Ruhe.“"
                            },
                            {
                                "example_id": "30c4e756-ea5a-45d1-a50e-30379b6f89be",
                                "sense_id": "2339b34a-a040-3c3c-8682-249982271ab9",
                                "text": "„Seinen Erfolg in der Nazizeit verdankt der Haarer-Ratgeber der Tatsache, dass er institutionell gefördert wurde.“"
                            },
                            {
                                "example_id": "07c1f538-52a6-41ec-8b3a-0ca7c5853b97",
                                "sense_id": "2339b34a-a040-3c3c-8682-249982271ab9",
                                "text": "„Zu den Kindern hat sie Kontakt durch die Schule, in der Nazizeit auch durch die gemeinsame Mitgliedschaft im Bund Deutscher Mädel (BDM).“"
                            },
                            {
                                "example_id": "0f00fa9c-4fe9-4d82-a71f-2f676f2b8589",
                                "sense_id": "2339b34a-a040-3c3c-8682-249982271ab9",
                                "text": "„Während der Nazizeit wurde der Friedhof verschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
