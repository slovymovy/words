                },
                {
                    "sense_id": "efdb2df8-a179-3b10-bfba-c90166ec35d0",
                    "sense_definition": "Густой покров шерсти у животных.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К зиме у медведя вырастает густая <w>шуба</w>.",
                            "target_lang_translations": {
                                "en": "By winter, the bear grows a thick <w>coat</w>."
                            }
                        },
                        {
                            "text": "У этой собаки очень теплая и пушистая <w>шуба</w>.",
                            "target_lang_translations": {
                                "en": "This dog has a very warm and fluffy <w>coat</w>."
                            }
