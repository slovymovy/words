                                "target_senses": [
                                    {
                                        "sense_id": "d900e7b8-18de-3f49-89da-d5c841a2d34e",
                                        "entry_id": "6eab1f9f-2f0a-3d4b-946a-44d8c427a7b5",
                                        "glosses": [
                                            "Dosage excessif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74caa0be-7711-450e-9b72-417179c5f07e",
                                                "sense_id": "d900e7b8-18de-3f49-89da-d5c841a2d34e",
                                                "text": "100 mg ! Il y a clairement un surdosage !"
                                            },
                                            {
                                                "example_id": "3299d69e-2994-4321-850f-08b47e671980",
                                                "sense_id": "d900e7b8-18de-3f49-89da-d5c841a2d34e",
                                                "text": "La mort par surdosage délibéré ou accidentel de ce médicament a été rapportée."
                                            },
                                            {
                                                "example_id": "5402fe56-2af0-4b9d-8d46-39b2b28ef744",
                                                "sense_id": "d900e7b8-18de-3f49-89da-d5c841a2d34e",
                                                "text": "L'utilisation de ces cuillères pour l'administration de médicaments aux enfants risque de provoquer des surdosages mais aussi des sous-dosages, selon une étude réalisée auprès de 25 familles grecques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f898ed0-304f-49a7-970a-2c19838641a0",
                        "source_entry_id": "649ea194-e85a-326d-88d3-28b1e56f060b",
                        "source_sense_id": "b999ebc8-7738-3864-b192-e2cff416257d",
                        "target_lang_word": "sobredosis",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4753b36b-a158-4a12-b003-23598fba4dda",
                        "source_entry_id": "649ea194-e85a-326d-88d3-28b1e56f060b",
                        "source_sense_id": "b999ebc8-7738-3864-b192-e2cff416257d",
                        "target_lang_word": "Überdosis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überdosis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                        "entry_id": "32528c15-8276-3c7b-a402-73cdb31e0a4b",
                                        "glosses": [
                                            "Zufuhr einer größeren Menge an Wirkstoff, als zu medizinischen Zwecken notwendig ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ed2f4a0-f9d5-41ec-8c8a-e8fc11324693",
                                                "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                                "text": "Er starb an einer Überdosis."
                                            },
                                            {
                                                "example_id": "6e97e6c3-2e0d-4334-b2b4-e8b4d1f60dd0",
                                                "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                                "text": "„Ein fehlerhaftes Laborgerät und Mangel an Vorsicht bewirkten, daß seine linke Hand eine Überdosis von radioaktiver Strahlung abbekam.“"
                                            },
                                            {
                                                "example_id": "b73ec385-3b9b-41e2-81f5-6f857779b72d",
                                                "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                                "text": "„Es war unglaublich, aber fünf Minuten später schliefen sie ein, schliefen, als hätten sie eine Überdosis Tabletten eingenommen - außer Roman.“"
                                            },
                                            {
                                                "example_id": "a978ab63-ffab-4c24-aaf9-2247e4efe0f3",
                                                "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                                "text": "„Die auf Forderung von Claires Mann durchgeführte, in Zweifelsfällen ohnehin obligatorische Obduktion Claires zeigt in ihrem Blut die Überdosis eines in Europa kaum bekannten namenlosen Geheimmittels, das unter anderem von arabischen Scheichs benutzt wird, um das Hemmungslose ihrer Haremsdamen ins Extreme zu steigern.“"
                                            },
                                            {
                                                "example_id": "229e8f51-8e3a-4b79-bc55-1f8b24a7866f",
                                                "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                                "text": "„Am Abend vorher hat er in seiner gemieteten Villa Nedsjölund in Hindas eine Überdosis Tabletten geschluckt, ob in selbstmörderischer Absicht oder versehentlich, ist umstritten.“"
                                            },
                                            {
                                                "example_id": "be2fc58b-7da2-40c5-986d-fe95b28fdc38",
                                                "sense_id": "b496f877-4a8d-3712-905d-b41597ca4a32",
                                                "text": "„Wie benebelt saßen wir da, wie lahmgelegt von einer Überdosis Schönheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a4d192a-4d85-30b6-8b78-9d6feb29af00",
                                        "entry_id": "32528c15-8276-3c7b-a402-73cdb31e0a4b",
                                        "glosses": [
                                            "insbesondere Zufuhr einer größeren Menge von Rauschgift, als zur Berauschung notwendig ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099198a1-b090-4f0b-b89d-7ccf8d2fd6cc",
                                                "sense_id": "5a4d192a-4d85-30b6-8b78-9d6feb29af00",
                                                "text": "„Wie benebelt saßen wir da, wie lahmgelegt von einer Überdosis Schönheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
