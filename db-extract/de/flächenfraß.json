                        "sense_id": "aae0a6f5-7d10-3628-b34d-88a28dd4a87e",
                        "entry_id": "b267358b-16af-361a-b8d2-2f60a51da8f5",
                        "glosses": [
                            "excessive consumption of land; urban sprawl"
                        ],
                        "tags": [
                            "masculine",
