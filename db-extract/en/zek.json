                        "glosses": [
                            "A prisoner at a Russian prison, especially (historical) at a Soviet labour camp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd3c065-14c3-4df9-9971-58757d346d0a",
                                "sense_id": "a710f333-296f-3b20-a3e3-900be40d05fb",
                                "text": "Every prisoner who recants is a potential influence on other zeks to do likewise."
                            },
                            {
                                "example_id": "b196a1e7-9748-4126-9757-7bda5a294623",
                                "sense_id": "a710f333-296f-3b20-a3e3-900be40d05fb",
                                "text": "There are the zeks, the survivors of the gulags, some honest about their experiences, others still deluded or traumatised decades later."
                            }
                        ]
