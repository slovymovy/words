                "senses": [
                    {
                        "sense_id": "ecd55111-773f-37fb-a5f6-8ce07cc14b82",
                        "entry_id": "f168fe53-6028-3e44-8214-30aed889378b",
                        "glosses": [
                            "eine Gattung der Schimmelpilze mit mehr als 50 bekannten Arten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7207359a-d2d3-4df1-8ec3-5b342411e7ed",
                                "sense_id": "ecd55111-773f-37fb-a5f6-8ce07cc14b82",
                                "text": "„Die Gattung Cladosporium gehört zu einer taxonomisch nicht einheitlichen Gruppe von Pilzen, die wegen der dunklen Pigmentierung ihrer Hyphen als Schwärzepilze bezeichnet werden.“"
                            },
                            {
                                "example_id": "9d65e3ac-36e9-4428-a3a6-d89765a65392",
                                "sense_id": "ecd55111-773f-37fb-a5f6-8ce07cc14b82",
                                "text": "Cladosporien sind auf der ganzen Welt die am weitesten verbreitete Schimmelpilzgattun (HARVEY 1967) und besiedeln vorwiegend abgestorbene Pflanzen und organische Materialien."
                            },
                            {
                                "example_id": "daf50311-518f-41ab-92ab-ee750ab1676c",
                                "sense_id": "ecd55111-773f-37fb-a5f6-8ce07cc14b82",
                                "text": "Allerdings haben wir noch keine der beiden Arten lebend gesehen, und alle unter diesen Namen uns mitgeteilte[n] Pilze waren falsch bestimmt, und verdorbene Cladosporia."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
