{
    "word_family": [
        "последующий",
        "последовать",
        "последователь",
        "последовательность"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "2db7d20f-fbb5-3570-a539-e5562472a1fe",
                    "sense_definition": "указывает на время, следующее за каким-либо событием",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретимся <w>после</w> работы.",
                            "target_lang_translations": {
                                "nl": "We spreken af <w>na</w> het werk.",
                                "en": "We will meet <w>after</w> work."
                            }
                        },
                        {
                            "text": "Он пришёл <w>после</w> обеда.",
                            "target_lang_translations": {
                                "nl": "Hij kwam <w>na</w> de lunch.",
                                "en": "He arrived <w>after</w> lunch."
                            }
                        }
                    ],
                    "antonyms": [
                        "до",
                        "перед"
                    ],
                    "common_phrases": [
                        "после обеда",
                        "после работы"
                    ],
                    "target_lang_definitions": {
                        "nl": "geeft een tijdstip aan dat volgt op een gebeurtenis",
                        "en": "indicates a time following a certain event"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "na",
                                "target_lang_sense_clarification": "geeft aan dat iets in tijd volgt op een gebeurtenis"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "after",
                                "target_lang_sense_clarification": "following an event or point in time"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                    "sense_definition": "в будущем, спустя некоторое время",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я занят сейчас, поговорим <w>после</w>.",
                            "target_lang_translations": {
                                "nl": "Ik ben nu bezig, we praten <w>daarna</w> wel verder.",
                                "en": "I'm busy right now, let's talk <w>later</w>."
                            }
                        },
                        {
                            "text": "Сначала сделай уроки, а <w>после</w> иди гулять.",
                            "target_lang_translations": {
                                "nl": "Maak eerst je huiswerk en ga <w>daarna</w> buiten spelen.",
                                "en": "First do your homework, and <w>afterwards</w> go outside."
                            }
                        }
                    ],
                    "synonyms": [
                        "потом",
                        "позже",
                        "позднее"
                    ],
                    "antonyms": [
                        "раньше",
                        "прежде"
                    ],
                    "target_lang_definitions": {
                        "nl": "in de toekomst, na verloop van tijd",
                        "en": "in the future, after some time has passed"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "daarna",
                                "target_lang_sense_clarification": "verwijst naar een tijdstip in de toekomst"
                            },
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "op een later moment"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "afterwards",
                                "target_lang_sense_clarification": "at a later time"
                            },
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "at a later point in time"
                            },
                            {
                                "target_lang_word": "later on",
                                "target_lang_sense_clarification": "subsequently, in the future"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                    "sense_definition": "по окончании чего-либо, вслед за кем-то или чем-то",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретимся <w>после</w> занятий в университете.",
                            "target_lang_translations": {
                                "nl": "We spreken af <w>na</w> de lessen aan de universiteit.",
                                "en": "We will meet <w>after</w> classes at the university."
                            }
                        },
                        {
                            "text": "Он зашёл в комнату <w>после</w> всех остальных.",
                            "target_lang_translations": {
                                "nl": "Hij kwam de kamer binnen <w>na</w> alle anderen.",
                                "en": "He entered the room <w>after</w> everyone else."
                            }
                        }
                    ],
                    "synonyms": [
                        "вслед за",
                        "по окончании",
                        "по завершении"
                    ],
                    "antonyms": [
                        "до"
                    ],
                    "common_phrases": [
                        "после занятий",
                        "после обеда"
                    ],
                    "target_lang_definitions": {
                        "nl": "bij het beëindigen van iets, of volgend op iemand of iets in een reeks",
                        "en": "upon the end of something, following someone or something in sequence"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "na",
                                "target_lang_sense_clarification": "volgend in tijd of volgorde"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "after",
                                "target_lang_sense_clarification": "following someone or something in sequence or upon completion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af4e1403-ed7a-3477-b759-47503bc2850b",
                    "sense_definition": "после ухода или смерти кого-либо",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>После</w> него осталась большая библиотека.",
                            "target_lang_translations": {
                                "nl": "<w>Na</w> zijn overlijden bleef er een grote boekenbibliotheek achter.",
                                "en": "<w>After</w> him, a large library was left behind."
                            }
                        },
                        {
                            "text": "<w>После</w> деда нам достался старый дом в деревне.",
                            "target_lang_translations": {
                                "nl": "<w>Na</w> de dood van opa hebben we een oud huis op het platteland geërfd.",
                                "en": "<w>After</w> grandfather passed away, we inherited an old house in the village."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "na het vertrek of overlijden van iemand",
                        "en": "after the departure or death of someone"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "na",
                                "target_lang_sense_clarification": "geeft aan wat er overblijft of gebeurt na iemands vertrek of overlijden"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "after",
                                "target_lang_sense_clarification": "left behind following someone's death or departure"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7da2d998-8b36-3b40-84e1-c30214d59ae3",
                    "sense_definition": "форма предложного падежа единственного числа существительного <w>посол</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера в министерстве говорили о <w>после</w>.",
                            "target_lang_translations": {
                                "nl": "Gisteren spraken ze op het ministerie over de ambassadeur.",
                                "en": "Yesterday at the ministry, they spoke about the <w>ambassador</w>."
                            }
                        },
                        {
                            "text": "Многое зависит от <w>после</w> в этой сложной ситуации.",
                            "target_lang_translations": {
                                "nl": "Veel hangt af van de ambassadeur in deze ingewikkelde situatie.",
                                "en": "Much depends on the <w>ambassador</w> in this complex situation."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "deze vorm is niet van toepassing in het Nederlands; het is een grammaticale verbuiging van het woord 'ambassadeur'",
                        "en": "prepositional singular form of the noun посол (ambassador)"
                    },
                    "translations": {
