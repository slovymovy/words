                "translations": [
                    {
                        "translation_id": "e767fc9d-5a94-402c-94fa-269d7bc9dbd2",
                        "source_entry_id": "569180d0-d9b7-30e6-8c96-910557cef5aa",
                        "source_sense_id": "48002c2c-d919-3196-be00-01dff2bedf3a",
                        "target_lang_word": "čeština",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čeština",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a7088f5e-a2ca-30c4-a2cd-666e92287202",
                                        "entry_id": "b4c36d8a-056a-348f-958e-08755d286720",
                                        "glosses": [
                                            "mateřský jazyk Čechů; úřední jazyk v Česku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6bd331d-8aa9-4dd8-a45f-3544b7914cd9",
                                                "sense_id": "a7088f5e-a2ca-30c4-a2cd-666e92287202",
                                                "text": "Spisovná čeština se od hovorové velmi liší, a snad proto jí skoro nikdo nemluví."
                                            },
                                            {
                                                "example_id": "7045fa8d-b74d-4a98-927c-02bbf2a5482d",
                                                "sense_id": "a7088f5e-a2ca-30c4-a2cd-666e92287202",
                                                "text": "Cizinci často považují češtinu za nelibozvučnou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae85764-3d4f-3238-b212-c9a9b982f7f0",
                                        "entry_id": "b4c36d8a-056a-348f-958e-08755d286720",
                                        "glosses": [
                                            "vyučovací předmět na základních a středních školách; nazývaný též \\\"český jazyk a literatura\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f282b08c-e860-47a2-b96c-ced5a77eb8b3",
                                                "sense_id": "8ae85764-3d4f-3238-b212-c9a9b982f7f0",
                                                "text": "Velké štěstí měl ten, kdo na češtinu měl profesora Hoznauera."
                                            },
                                            {
                                                "example_id": "89f799ff-dd5b-43ab-889f-278d9a50052a",
                                                "sense_id": "8ae85764-3d4f-3238-b212-c9a9b982f7f0",
                                                "text": "Stávající praxe na mnoha školách je taková, že češtinu učí nejenom vystudovaní češtináři."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc47ad0-274a-33b2-825b-71438fe459b8",
                                        "entry_id": "b4c36d8a-056a-348f-958e-08755d286720",
                                        "glosses": [
                                            "česká verze, překlad nebo lokalizace do češtiny (1)"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5be547b6-901b-4b22-b660-949d98afd2ce",
                                                "sense_id": "1bc47ad0-274a-33b2-825b-71438fe459b8",
                                                "text": "Prošel jsem celý web, ale češtinu jsem k tomu nikde nenašel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
