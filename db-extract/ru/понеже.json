                                    {
                                        "sense_id": "cfcc271a-4835-38cf-b57f-a371a1d38077",
                                        "entry_id": "dde75d0e-31a7-32ea-b752-7c65c765a90d",
                                        "glosses": [
                                            "in welcher Hinsicht, in welcher Weise, in welchem Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec3b464a-fef8-42c8-8dd7-5edab4adf499",
                                                "sense_id": "cfcc271a-4835-38cf-b57f-a371a1d38077",
                                                "text": "adverbiell: Inwiefern ist das hierfür bedeutsam?"
                                            },
                                            {
                                                "example_id": "247e9a0b-2231-432d-93ae-82fe2d23f93e",
                                                "sense_id": "cfcc271a-4835-38cf-b57f-a371a1d38077",
                                                "text": "konjunktional: Ich weiß immer noch nicht, inwiefern ich hier gebraucht werde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed316bd-f4d6-462a-969f-3edaa5263b57",
                        "source_entry_id": "0f991aeb-c38e-33ea-b0c3-dd8251a1a29e",
                        "source_sense_id": "71b0e78f-7bbd-3e4f-9e86-056e10bdb539",
