        "fr-extract.jsonl": [
            {
                "entry_id": "27338b38-7c26-3ac2-8fad-ac7fcd6f6d26",
                "word": "tarissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "83554d17-b30c-480a-83cf-0c563a051e13",
                        "entry_id": "27338b38-7c26-3ac2-8fad-ac7fcd6f6d26",
                        "tags": [
                            "plural"
                        ],
                        "form": "tarissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d9d9035-6191-3206-86aa-f9ed6b127bc7",
                        "entry_id": "27338b38-7c26-3ac2-8fad-ac7fcd6f6d26",
                        "glosses": [
                            "Dessèchement, état de ce qui est tari."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46da346c-41d4-445b-b857-5bfc025a6449",
                                "sense_id": "0d9d9035-6191-3206-86aa-f9ed6b127bc7",
                                "text": "Le tarissement des puits et des fontaines est un des effets de la grande sècheresse. Le tarissement des eaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "4495605d-a07e-3113-be19-1467f5da2e2e",
                        "entry_id": "27338b38-7c26-3ac2-8fad-ac7fcd6f6d26",
                        "glosses": [
                            "Arrêt spontané ou provoqué de la lactation chez les femelles des mammifères."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "876953bd-df03-49b2-b3a3-1a47c4649d5a",
                                "sense_id": "4495605d-a07e-3113-be19-1467f5da2e2e",
                                "text": "Cette diminution des acides gras longs saturés lorsque le tarissement est raccourci ou supprimé est favorable à une meilleure \"tartinabilité\" du beurre."
                            },
                            {
                                "example_id": "92133531-09c2-4cc7-af7a-ac858475f39d",
                                "sense_id": "4495605d-a07e-3113-be19-1467f5da2e2e",
                                "text": "Le tarissement est une période de repos physiologique, pendant laquelle la vache ne produit plus de lait ; il est obligatoire avant le vêlage : lactation et croissance liminale du fœtus sont concurrentielles. Dans les élevages de type européen, ce tarissement est provoqué à une date choisie par l'éleveur, en fonction de la production laitière et de la date prévue du prochain vêlage. Le schéma classique proposé aux éleveurs est un intervalle entre vêlages de 1 an, avec une lactation de 10 mois et un tarissement de 2 mois."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f621283-c62b-31a1-ab92-0cafc2840b31",
                        "entry_id": "27338b38-7c26-3ac2-8fad-ac7fcd6f6d26",
                        "glosses": [
                            "Période pendant laquelle une femelle laitière n'est pas en lactation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
