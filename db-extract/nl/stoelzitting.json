                        "examples": [
                            {
                                "example_id": "56e34ee2-9db7-4b26-b3db-3663b06d74f6",
                                "sense_id": "287c33c6-0707-3a37-a39c-a346b507967d",
                                "text": "Ze bleven allebei met hun kont boven de stoelzitting hangen, de leuningen omklemmend tot hun knokkels er wit van zagen."
                            },
                            {
                                "example_id": "3beef5b0-09d7-4dba-bba8-0d0701a6a878",
                                "sense_id": "287c33c6-0707-3a37-a39c-a346b507967d",
                                "text": "De vereniging Ambachten van Vrogger en Noew uit Hellendoorn demonstreert oude ambachten in klederdracht. Hans Pronk is bezig met een stoelzitting. 'Ik weef de stoel. Webbing noemen ze het ook wel in het Engels.'"
                            }
                        ]
