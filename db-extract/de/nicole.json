                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c80a4e0-3cfb-4f02-9f6d-793b20266d0e",
                                                "sense_id": "89a48d32-92d8-3e8a-96ab-ac651a71d1fb",
                                                "text": "No one says anything for a while, and the only sound is Nikole sniffling."
                                            },
                                            {
                                                "example_id": "6e72d669-faee-4e09-b2ca-78d80381b9c5",
                                                "sense_id": "89a48d32-92d8-3e8a-96ab-ac651a71d1fb",
                                                "text": "Julie, the family social worker, explained Nikole's complicated living situation and risk factors to the judge at her most recent court date."
                                            },
                                            {
                                                "example_id": "ce7e2796-0900-47aa-8772-5a5e98f6d8e8",
                                                "sense_id": "89a48d32-92d8-3e8a-96ab-ac651a71d1fb",
                                                "text": "So Margaret and Nikole left and were helped into the carriage for the trip to the palace."
                                            }
