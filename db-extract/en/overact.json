                    {
                        "sense_id": "2123bf33-b062-38bc-8b0b-195558d77278",
                        "entry_id": "54a29e85-d26b-3a27-96f5-b0dc3932a9c3",
                        "glosses": [
                            "To act in an exaggerated manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb68355-9abf-4178-8ff2-6c28e55e6512",
                                "sense_id": "2123bf33-b062-38bc-8b0b-195558d77278",
                                "text": "He overacted his part."
                            },
                            {
                                "example_id": "920914e4-2977-48aa-bbe1-fed754a0a570",
                                "sense_id": "2123bf33-b062-38bc-8b0b-195558d77278",
                                "text": "If governments overact and become oppressive, the terrorists will have won, for their theory is that repression will eventually lead to revolution."
                            },
                            {
                                "example_id": "b1dc21df-321e-4759-b165-2217e41100bb",
                                "sense_id": "2123bf33-b062-38bc-8b0b-195558d77278",
                                "text": "The scenework proves unsuccessful when Carmichael recalls not the source of her misandry but another episode of overacting, that of castratively biting off the moustache of an amorous man."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9017469-1245-3725-9291-4012b3c4fb5d",
                        "entry_id": "54a29e85-d26b-3a27-96f5-b0dc3932a9c3",
                        "glosses": [
                            "To act upon, or influence, unduly."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0121c41-6ae3-4cf0-be57-43d0d69329b6",
                                "sense_id": "d9017469-1245-3725-9291-4012b3c4fb5d",
                                "text": "The hope of inheritance overacts them."
                            },
                            {
                                "example_id": "d442418c-25e7-42a7-a84c-d107b0d42f4c",
                                "sense_id": "d9017469-1245-3725-9291-4012b3c4fb5d",
                                "text": "The χαμολνία, Humicubation, lying upon ground, &c. which things have been overacted, and still are in the Greek and Roman Churches."
                            }
                        ]
                    }
                ],
