                        "glosses": [
                            "Action de baragouiner."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5da153e2-3dba-44df-8d4b-d34d7135f4df",
                                "sense_id": "80e75f52-05ec-31bd-88dd-f55b963ac724",
                                "text": "Tout son discours n’était qu’un baragouinage."
                            },
                            {
                                "example_id": "39782997-bc49-4449-991f-5fdc34ecae92",
                                "sense_id": "80e75f52-05ec-31bd-88dd-f55b963ac724",
                                "text": "Personne n’a su dire la raison pour laquelle on donnait un nom aussi illustre à ce baragouinage."
                            },
                            {
                                "example_id": "6b32b693-569d-4ce9-841a-83a101c12c1f",
                                "sense_id": "80e75f52-05ec-31bd-88dd-f55b963ac724",
                                "text": "Comme les autres, ils progressaient à force de baragouinages vers l’usage du français et, en attendant, vivaient surtout entre eux."
                            }
                        ]
                    }
                ],
