                        "cross_references": [
                            {
                                "target_word": "Qinghai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ba7241-4a6b-3745-bdc2-f8bd1bee15f9",
                                        "entry_id": "8b6de308-de98-3d40-b787-8e85160c6b04",
                                        "glosses": [
                                            "A province in northwestern China. Capital: Xining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8f4fc7-dfd0-4ae3-b531-0346f910fabe",
                                                "sense_id": "16ba7241-4a6b-3745-bdc2-f8bd1bee15f9",
                                                "text": "In Qinghai (Chinghai) Province, 300 schools in six xian surrounding the provincial capital, Xi’ning^([sic – meaning Xining]) (Sining), had 10,000 students in 1964. Part-work schools in the province enabled 8 per cent of the age-group to attend school, including some go per cent of those children from poor and lower middle peasant families (SCMP 3350, 1964). Qinghai (Chinghai) also reported 100 ‘tent-schools’, moving with the herdsmen over the grazing grounds."
                                            },
                                            {
                                                "example_id": "14d5b5ac-8c2c-4066-b4c6-8a9b8bc6fb08",
                                                "sense_id": "16ba7241-4a6b-3745-bdc2-f8bd1bee15f9",
                                                "text": "Tibetan is found predominantly in Tibet; Tibetan-speaking communities are also found in Sichuan, Qinghai, Yunnan, and Gansu. In Tibet, all official documents are issued in both Tibetan and Chinese, and also in certain regions of Sichuan and Qinghai. Moreover, the radio stations in Tibet broadcast in Tibetan and Putonghua. Similarly, the Chengdu radio station in Sichuan and the Xining radio station in Qinghai also have regular Tibetan broadcasts."
                                            },
                                            {
                                                "example_id": "169bed63-3c0c-4aa1-9cac-41152d7cc372",
                                                "sense_id": "16ba7241-4a6b-3745-bdc2-f8bd1bee15f9",
                                                "text": "The source of the Yellow River is in the Qinghai Province on the Tibetan Plateau. This area is often called the \"Roof of the World\" because of its high altitude, the height of a place above sea level."
                                            },
                                            {
                                                "example_id": "f9013f60-b3b1-426b-bc92-bfcacdde4253",
                                                "sense_id": "16ba7241-4a6b-3745-bdc2-f8bd1bee15f9",
                                                "text": "The decaying clusters of workshops, bunkers and dormitories are remnants of Plant 221, also known as China’s Los Alamos. Here, on a mountain-high grassland called Jinyintan in Qinghai Province, thousands of Tibetan and Mongolian herders were expelled to create a secret town where a nuclear arsenal was built to defend Mao Zedong’s revolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a101b7e6-2890-3a03-be61-303c69824798",
                                        "entry_id": "8b6de308-de98-3d40-b787-8e85160c6b04",
                                        "glosses": [
                                            "A large lake in Qinghai province, the largest in China."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df42bc05-1a42-4888-bfe4-4281afadf7f4",
                        "source_entry_id": "3324ecb9-fdd5-3ee6-9a55-f8feec021f73",
