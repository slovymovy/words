                    {
                        "translation_id": "f4a40d7f-20e2-4862-9d19-f0d097bb78f0",
                        "source_entry_id": "61e24f19-ff43-3702-97e3-42aac30e0243",
                        "source_sense_id": "da2d7715-faea-3a50-814d-8851844e585f",
