                            {
                                "example_id": "e800cfdf-d630-47b2-a910-68b704ca14d8",
                                "sense_id": "9d9e351e-4963-38bc-9b3a-31d6cf2d1c4d",
                                "text": "La plupart des brasseurs s'approvisionnent auprès des malteries qui transforment l'orge en malt.."
