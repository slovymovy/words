        "nl-extract.jsonl": [
            {
                "entry_id": "171ee654-a9a0-3cda-83d4-3d3103273da3",
                "word": "ruigte",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "0cc222a9-faa1-4a7d-bc20-604afb383cf4",
                        "entry_id": "171ee654-a9a0-3cda-83d4-3d3103273da3",
                        "tags": [
                            "plural"
