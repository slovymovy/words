                                "target_senses": [
                                    {
                                        "sense_id": "ecc357b4-aa05-38f5-84d5-63a323b46f08",
                                        "entry_id": "f0fd2101-80b2-3d4b-a17e-ef942e9e60ab",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного правильный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4288bee8-05a0-4911-aa08-d2560fe87804",
                                                "sense_id": "ecc357b4-aa05-38f5-84d5-63a323b46f08",
                                                "text": "Всем видам кулонометрического метода свойственны высокие метрологические характеристики (малая погрешность анализа, высокая правильность, воспроизводимость, селективность)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
