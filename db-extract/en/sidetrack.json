                "entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                "word": "sidetrack",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9cc2d0e4-4209-4a4c-b6c2-a00ed70c0347",
                        "entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                        "tags": [
                            "plural"
                        ],
                        "form": "sidetracks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27cd28d9-9200-3f7e-8d1f-06ee9770a88c",
                        "entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                        "glosses": [
                            "A second, relatively short length of track just to the side of a railroad track, joined to the main track by switches at one or both ends, used either for unloading freight, or to allow two trains on a same track to meet (opposite directions) or pass (same direction); a railroad siding."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "399e6687-bfc5-3cda-84b2-e5946c2acd30",
                        "entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                        "glosses": [
                            "Any auxiliary railroad track, as differentiated from a siding, that runs adjacent to the main track."
                        ],
                        "tags": [
                            "sometimes"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "328d840f-ab79-31ee-8498-367105b38c72",
                        "entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                        "glosses": [
                            "A smaller tunnel or well drilled as an auxiliary off a main tunnel or well."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d5169383-0a6d-366b-954a-4f3394f88d59",
                        "entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                        "glosses": [
                            "An alternate train of thought, issue, topic, or activity, that is a deviation or distraction from the topic at hand or central activity, and secondary or subordinate in importance or effectiveness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30e67e0-4da6-459d-84dc-d71d4f2f2f7c",
                                "sense_id": "d5169383-0a6d-366b-954a-4f3394f88d59",
                                "text": "Stay focused on the story; you keep getting lost in all of these little sidetracks."
                            },
                            {
                                "example_id": "a93eb397-45eb-474d-9b73-38a86438f039",
                                "sense_id": "d5169383-0a6d-366b-954a-4f3394f88d59",
                                "text": "\"However, I am down a side-track. What I wanted to say to you is that you must not take Bolsover's little spirit circus too seriously.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "2ab28f6e-bbc5-4dcb-a597-9e22728b3089",
                        "source_entry_id": "9463bddd-583b-3af5-a507-f5b603033a25",
                        "source_sense_ids": [],
                        "source_sense_description": "small railroad track for unloading, passing",
                        "linkage_type": "synonyms",
                        "word": "railroad siding"
                    },
