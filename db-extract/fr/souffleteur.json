                        "glosses": [
                            "Celui qui donne un soufflet, une gifle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39b4886c-ed02-4f37-bf0c-5a041e508319",
                                "sense_id": "f80a85c8-414d-3b32-890d-10871bc6b4bc",
                                "text": "Genam meam dedi vapulatori, j’ai donné ma joue au souffleteur, dit le prêtre ; si tu as la force de me faire broncher, mon drôle, je te donnerai pour rien la rançon du juif."
                            },
                            {
                                "example_id": "6b83bff4-8a8d-44af-abdc-733aba2db462",
                                "sense_id": "f80a85c8-414d-3b32-890d-10871bc6b4bc",
                                "text": "Et, parce que le frère du souffleteur s’offre au rabais, le fils du souffleté oublie l’injure, et l’embauche."
                            }
                        ]
                    }
