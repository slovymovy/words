                "senses": [
                    {
                        "sense_id": "ce5a3ea6-d37c-3b07-b3a8-e53f8c9361e0",
                        "entry_id": "2cfd8855-6a1f-316d-9368-6fe8c61dab2c",
                        "glosses": [
                            "Impossible à rassasier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca3e318-0c72-407c-8f7f-e5f89fc9547e",
                                "sense_id": "ce5a3ea6-d37c-3b07-b3a8-e53f8c9361e0",
                                "text": "Et néanmoins cette guenon\nMe dit au nez pis que mon nom,\nEt me menaça de famine,\nL’irrassasiable vermine !"
                            },
                            {
                                "example_id": "4d881e5f-4aa6-4113-aacd-2143f2a3fdb1",
                                "sense_id": "ce5a3ea6-d37c-3b07-b3a8-e53f8c9361e0",
                                "text": "Pour la dame Panthère,\nEn sa rage effroyable,\nElle regrette le bon temps,\nOù sa gueule irrassasiable\nAffamait de ce bois les pauvres habitans."
                            },
                            {
                                "example_id": "ac510124-ae04-4f03-ad2a-0614167457cf",
                                "sense_id": "ce5a3ea6-d37c-3b07-b3a8-e53f8c9361e0",
                                "text": "Céda-t-il à ces expansions d’une haine irrassasiable, ou bien était-ce un raffinement de perfidie ?"
                            },
                            {
                                "example_id": "39cbe400-a57c-4b2d-bf56-79ddfddc2e8f",
                                "sense_id": "ce5a3ea6-d37c-3b07-b3a8-e53f8c9361e0",
                                "text": "[…] ; et mes conjectures l’avaient charitablement rangé parmi ces artistes au petit-pied, joueurs de violon et peintres de portraits, qu’une faim irrassasiable et une soif inextinguible condamnent à courir le monde sur la trace du Juif-errant."
                            }
                        ]
                    }
