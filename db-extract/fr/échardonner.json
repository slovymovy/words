                ],
                "senses": [
                    {
                        "sense_id": "ea04cb9d-e12e-3bf7-b12d-5e97bbdcc8f0",
                        "entry_id": "0c8f3b2b-4045-361b-aba7-405f9d54a883",
                        "glosses": [
                            "Débarrasser un terrain des chardons qui l’ont envahi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2231fb8c-3666-4d75-bc17-ee811e323317",
                                "sense_id": "ea04cb9d-e12e-3bf7-b12d-5e97bbdcc8f0",
                                "text": "Dans la plaine des hommes, des femmes, des chevaux travaillaient çà et là ; près d’elle une escouade d’ouvriers échardonnaient un champ d’avoine."
                            },
                            {
                                "example_id": "f171f3a6-9905-4b91-b999-d3b8fa9ca921",
                                "sense_id": "ea04cb9d-e12e-3bf7-b12d-5e97bbdcc8f0",
                                "text": "Il eût été bien difficile de le rejoindre quand, par-dessus les échaliers, il était passé d’un champ à un autre, échardonnant ici, étaupinant là, coupant les vipères en deux."
                            }
                        ]
                    },
                    {
                        "sense_id": "56e9157b-c3a5-3143-974a-4a9fa7a7698e",
                        "entry_id": "0c8f3b2b-4045-361b-aba7-405f9d54a883",
                        "glosses": [
                            "Débarrasser par des moyens mécaniques, les fibres de la laine, des débris végétaux, chardons, gratterons, etc., qu'elle retient."
                        ],
                        "tags": [
                            "Industrie textile"
                        ],
                        "examples": [
                            {
                                "example_id": "f70b2d7f-6cca-4723-a07d-bd523b70e213",
                                "sense_id": "56e9157b-c3a5-3143-974a-4a9fa7a7698e",
                                "text": "Puis, on a entrepris d'échardonner la laine en lui enlevant les gratterons avec une sorte d'éjecteur ou de brosse après l'avoir étalée convenablement."
                            }
                        ]
                    }
                ],
