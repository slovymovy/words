                "senses": [
                    {
                        "sense_id": "0856faa7-e8b7-397f-800e-0d5bd2e4f834",
                        "entry_id": "4f61a9dd-e59f-3349-917d-be06aaab4208",
                        "glosses": [
                            "einzelne biologische Einheit (Zelle), die im Atmungsorgan Lunge angesiedelt ist und dort besondere Aufgaben wahrnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876c72d2-634a-4634-8020-286fd0712a75",
                                "sense_id": "0856faa7-e8b7-397f-800e-0d5bd2e4f834",
                                "text": "„Diese Zellen teilen sich um alte oder beschädigte Lungenzellen zu ersetzen und halten so die Lunge gesund.“"
                            },
                            {
                                "example_id": "f46b14cf-aefd-4742-85e1-2b89ea411741",
                                "sense_id": "0856faa7-e8b7-397f-800e-0d5bd2e4f834",
                                "text": "„Golding Bird bemerkte, dass das Vorkommen der Lungenzellen im Auswurf tuberkulöser Lungensüchtiger bereits von Buhlmann beobachtet sei.“ (1846)"
                            },
                            {
                                "example_id": "366668a5-53b2-4683-a3fa-51184ba5de1a",
                                "sense_id": "0856faa7-e8b7-397f-800e-0d5bd2e4f834",
                                "text": "„Das SARS-Coronavirus 2 (SARS-CoV-2) infiziert Lungenzellen und ist für die COVID-19-Pandemie verantwortlich.“ (2020)"
                            }
                        ],
                        "sense_index_json": "\"1\""
