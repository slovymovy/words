                                "target_senses": [
                                    {
                                        "sense_id": "065568a1-d337-3741-b95c-8ed8bdb5a4c8",
                                        "entry_id": "9eb9cdc1-b319-3b5b-9a0b-dcb0f2cd7bff",
                                        "glosses": [
                                            "Abscheu gegen jemanden oder etwas empfinden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7feda30c-e3f2-49d7-b53a-efd08867881b",
                                                "sense_id": "065568a1-d337-3741-b95c-8ed8bdb5a4c8",
                                                "text": "Ich verabscheue diesen bestialischen Gestank."
                                            },
                                            {
                                                "example_id": "6ba6eb96-f755-49bc-bb88-65c08cac9562",
                                                "sense_id": "065568a1-d337-3741-b95c-8ed8bdb5a4c8",
                                                "text": "Mörder werden verabscheut."
                                            },
                                            {
                                                "example_id": "e8c958b8-1c9e-41a4-94d2-4d76458b5842",
                                                "sense_id": "065568a1-d337-3741-b95c-8ed8bdb5a4c8",
                                                "text": "„Der Pater verabscheute die afrikanische Kultur und erwartete eine rigorose Assimilation seiner Missionszöglinge an westliche Werte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50164ef7-7486-497a-b1a9-84a97d3694f8",
                        "source_entry_id": "e9ecebe7-ff9b-3119-b5a3-dcdf6221a23f",
                        "source_sense_id": "96315c84-398b-3dcb-89c7-aaee852c3992",
                        "target_lang_word": "en avoir ras le bol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en avoir ras le bol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32b21a9e-f0e1-3f56-ad2d-4903b32bc8bc",
                                        "entry_id": "3bd71c6d-5073-3ac1-a5cd-a2b8b6e5d4ad",
                                        "glosses": [
                                            "En avoir assez, en avoir marre, être dégoûté (de quelque chose)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98221a0-c4f9-4429-bb96-c0e870b723d5",
                                                "sense_id": "32b21a9e-f0e1-3f56-ad2d-4903b32bc8bc",
                                                "text": "– Eh bien moi j’en ai ras le bol de répondre à tes questions !"
                                            },
                                            {
                                                "example_id": "3da7b848-e10a-4447-b8c5-8936ef8f4ea0",
                                                "sense_id": "32b21a9e-f0e1-3f56-ad2d-4903b32bc8bc",
                                                "text": "Ça ne fonctionne toujours pas, j’en ai ras le bol."
                                            },
                                            {
                                                "example_id": "bd2e3edb-fc38-46da-9e34-1d867361c741",
                                                "sense_id": "32b21a9e-f0e1-3f56-ad2d-4903b32bc8bc",
                                                "text": "J’en ai ras le bol de tes conneries."
                                            },
                                            {
                                                "example_id": "bb6cf0b9-ab97-49f0-802b-250770b73231",
                                                "sense_id": "32b21a9e-f0e1-3f56-ad2d-4903b32bc8bc",
                                                "text": "Chaque fois que ch’uis mal garé j’prends une prune, y’en a ras le bol."
                                            },
                                            {
                                                "example_id": "e929421a-2ef9-4693-9dee-577b2910b54e",
                                                "sense_id": "32b21a9e-f0e1-3f56-ad2d-4903b32bc8bc",
                                                "text": "Les patrons y nous comprennent pas, y’en a ras le bol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
