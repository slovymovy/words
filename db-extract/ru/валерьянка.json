                                                "example_id": "664818ae-3cf3-492f-ad9b-3a6a6985538c",
                                                "sense_id": "d0db03db-208b-34fb-9522-5730b53bc637",
                                                "text": "In the event of anyone wishing to invoke the very Prince of Spirits, the following ingredients were prescribed to be burnt - Juice of Hypericon, Saffron, Artemisia, and the root of Valerian."
                                            },
                                            {
                                                "example_id": "54955ce4-15da-44b1-b47b-87cf831d80a4",
                                                "sense_id": "d0db03db-208b-34fb-9522-5730b53bc637",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination."
                                            }
                                        ]
                                    },
