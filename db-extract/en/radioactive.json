                                        "entry_id": "7e18c3c7-9d2e-37c1-a35b-8e247dd3dc18",
                                        "glosses": [
                                            "Radioaktivität aufweisend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ce29522-eab0-466c-b312-838de2fd307b",
                                                "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                                "text": "Radium ist stark radioaktiv."
                                            },
                                            {
                                                "example_id": "8a168986-2fb5-4d28-9358-06c63eb54351",
                                                "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            },
                                            {
                                                "example_id": "72bd18bc-0435-4367-aeb6-43663bad7b79",
                                                "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                                "text": "„Ihr Mann war Lehrer wie sie selbst und unterrichtete außer Mathematik noch Wehrschutz, deshalb kannte er sich ein wenig mit radioaktiven Strahlen aus und besorgte ihnen Jodtabletten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
