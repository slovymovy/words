    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f296d5d4-0cae-3bef-a7a6-2192943a7e8c",
                    "sense_definition": "A financial rescue of a failing business or organization to prevent its collapse.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rescue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government provided a massive <w>bailout</w> to the struggling airline to prevent it from going bankrupt."
                        },
                        {
                            "text": "Many citizens were angry about the bank <w>bailout</w> funded by their tax money."
                        }
                    ],
                    "synonyms": [
                        "rescue",
                        "salvage"
                    ],
                    "common_phrases": [
                        "government bailout",
                        "bank bailout"
                    ]
                },
                {
                    "sense_id": "b535a71c-8e37-3ca7-8f24-ba6f39553918",
                    "sense_definition": "An emergency escape by a firefighter from a dangerous structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rescue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighter performed an emergency <w>bailout</w> through the second-story window as the roof began to collapse."
                        },
                        {
                            "text": "Training for a rapid <w>bailout</w> is essential for every member of the fire department."
                        }
                    ],
                    "synonyms": [
                        "escape"
                    ]
                },
                {
                    "sense_id": "ab22b3cc-7da4-3df2-a311-1cdb930d1291",
                    "sense_definition": "The act of jumping from an aircraft in flight, usually with a parachute.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rescue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot ordered an immediate <w>bailout</w> after the engine caught fire mid-flight."
                        },
                        {
                            "text": "A successful <w>bailout</w> requires the pilot to maintain control until the last possible second."
                        }
                    ],
                    "synonyms": [
                        "ejection"
                    ]
                },
                {
                    "sense_id": "0e6b19c7-69e3-3d6e-b958-efaa8f95a55b",
                    "sense_definition": "A secondary or emergency supply of air used by a scuba diver.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rescue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver switched to his <w>bailout</w> bottle when his primary tank malfunctioned at depth."
                        },
                        {
                            "text": "Technical divers always carry a <w>bailout</w> system in case of equipment failure."
                        }
                    ],
                    "synonyms": [
                        "reserve"
                    ],
                    "common_phrases": [
                        "bailout bottle"
                    ]
                }
            ]
