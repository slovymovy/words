                    "frequency": "Middle",
                    "semantic_group_id": "prison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde a enfermé le prisonnier dans un <w>cachot</w> sombre et froid du château."
                        },
                        {
                            "text": "Le roi ordonna aux soldats de jeter le traître au <w>cachot</w> sans attendre son procès."
                        }
                    ],
