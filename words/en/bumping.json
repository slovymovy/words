            "senses": [
                {
                    "sense_id": "2c481fce-c1df-3e34-9561-8600b341d6b9",
                    "sense_definition": "present participle and gerund of <w>bump</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>bumping</w> into furniture because the lights were completely off.",
                            "target_lang_translations": {
                                "tr": "Işıklar tamamen kapalı olduğu için mobilyalara <w>çarparak ilerliyordu</w>."
                            }
                        },
                        {
                            "text": "She kept <w>bumping</w> her head while trying to fix the low ceiling.",
                            "target_lang_translations": {
                                "tr": "Alçak tavanı tamir etmeye çalışırken kafasını sürekli <w>çarptı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bumping into people",
                        "bumping her head"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"bump\" fiilinin şimdiki zaman ve ulaç biçimi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çarparak",
                                "target_lang_sense_clarification": "bir yere veya şeye çarpmak eylemi"
                            },
                            {
                                "target_lang_word": "toslayarak",
                                "target_lang_sense_clarification": "kafa veya vücutla vurarak"
                            }
                        ]
                    }
                }
