                        "glosses": [
                            "Without fame."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ec7d7104-4765-435f-81db-3a76f0a7d852",
                                "sense_id": "b6ca7ab4-2f28-37b8-aa99-d084252db287",
                                "text": "Sluggish are the spirits and base the lot of the men I am ordained to lead through a dull life to a fameless grave."
                            },
                            {
                                "example_id": "64a0cfc4-96fb-495c-b012-f443a16a55f4",
                                "sense_id": "b6ca7ab4-2f28-37b8-aa99-d084252db287",
                                "text": "And in the midst of better conditions and brighter prospects the shameless, brainless, fameless bipeds pollute the atmosphere, poison hearts and plant discontent."
                            }
                        ]
                    }
                ],
