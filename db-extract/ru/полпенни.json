                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50d7ef8d-532e-3e33-a829-da98788493ec",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "A usually semicircular earmark made in the ear of a livestock animal."
                                        ],
                                        "tags": [
