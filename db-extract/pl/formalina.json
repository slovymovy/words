                        "sense_id": "196da444-4272-35f1-a893-71969c938247",
                        "entry_id": "608edc52-1d00-3b19-861a-e068a5983fd0",
                        "glosses": [
                            "roztwór wodny formaldehydu, stosowany jako środek odkażający i konserwujący"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b836d7db-2524-4fb7-9e02-7be6b295e77d",
                                "sense_id": "196da444-4272-35f1-a893-71969c938247",
                                "text": "(…) 29-latek sam przypadkowo obciął sobie palec u nogi. Przez rok trzymał go w słoiku z formaliną"
                            },
                            {
                                "example_id": "b57ae75d-2377-4a1d-a709-ec8f8a92cb79",
                                "sense_id": "196da444-4272-35f1-a893-71969c938247",
                                "text": "Rühtgard poczuł dławienie w gardle, kiedy przyjrzał się potężnemu akwarium wypełnionemu formaliną, w którym stał dwumetrowy albinos o negroidalnych rysach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
