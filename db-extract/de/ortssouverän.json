                ],
                "senses": [
                    {
                        "sense_id": "0a72cc45-5bb5-339f-a984-9c0f90f64c21",
                        "entry_id": "f2c07b71-3aab-3871-9b60-2d0b28c5685f",
                        "glosses": [
                            "den Aufenthaltsort selbst bestimmen könnend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83b5372-9639-40f3-b5b6-b143c35cbe14",
                                "sense_id": "0a72cc45-5bb5-339f-a984-9c0f90f64c21",
                                "text": "„Auch hier kann der Inhalt nach dem Herunterladen zeit- und ortssouverän rezipiert werden.“"
                            },
                            {
                                "example_id": "6e29cd22-3aa5-4f00-93be-cef3461980be",
                                "sense_id": "0a72cc45-5bb5-339f-a984-9c0f90f64c21",
                                "text": "„Die Inhalte können zeit- und ortssouverän abgerufen werden.“"
                            },
                            {
                                "example_id": "fdc0d67f-5622-4447-a794-1f5217463c7c",
                                "sense_id": "0a72cc45-5bb5-339f-a984-9c0f90f64c21",
                                "text": "„Auch wenn die online Befragten, wie im vorherigen Abschnitt erläutert, nicht demselben Maße örtliche flexibel sind wie die Digicom-ArbeiterInnen [sic], nutzen die sie Digitalen Medien, um zumindest einen Teil ihrer Arbeit ortssouverän zu verrichten.“"
                            },
                            {
