                        "form": "die Gesichtsausdrücke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                        "entry_id": "df5b14b2-440d-3186-affe-a3392cd6fb58",
                        "glosses": [
                            "momentane Mimik in einer bestimmten Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac4c7ad2-0636-4b6f-9138-c43ea06c294d",
                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                "text": "Er sagte mir, dass er sich freue mich zu sehen, aber sein Gesichtsausdruck verriet mir etwas anderes."
                            },
                            {
                                "example_id": "3c9ae0c7-7f97-4dac-92e1-319e2d748b6b",
                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                "text": "„Sein Gesichtsausdruck verriet sofort Vergeblichkeit.“"
                            },
                            {
                                "example_id": "914ae22a-8c80-4beb-a367-8f91a8c58579",
                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                "text": "„Mit einem grimmigen Gesichtsausdruck kehrte mir der Kellner den Rücken zu und verschwand in der Küche.“"
                            },
                            {
                                "example_id": "42e8878f-4a11-46d2-af56-ea2605c069b5",
                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                "text": "„Ihr Gesichtsausdruck wirkt resigniert.“"
                            },
                            {
                                "example_id": "ed7a9436-1608-43f6-98c0-72c4c8764937",
                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                "text": "„Grenfeld war überrascht, wie hart ihr Gesichtsausdruck geworden war.“"
                            },
                            {
                                "example_id": "4ddd1a44-7afc-4cef-af88-c8a924950e28",
                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                "text": "„Maries Gesichtsausdruck hell sich auf. Sie hat eine Idee und zeigt auf das Fenster, hoch über dem Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12917b00-551a-4019-b52c-185be29e7d56",
                        "source_entry_id": "df5b14b2-440d-3186-affe-a3392cd6fb58",
                        "source_sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                        "source_sense_description": "momentane Mimik in einer bestimmten Situation",
                        "target_lang_word": "facial expression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facial expression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6104511e-aad0-3448-9b7f-c483aa6224c4",
                                        "entry_id": "6bf15617-6ff7-3b5c-a527-7c07e6c12106",
                                        "glosses": [
                                            "A particular configuration of the facial muscles that conveys certain emotions or intentions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebce21c5-9355-41fb-83f3-4eabc831e828",
                                                "sense_id": "6104511e-aad0-3448-9b7f-c483aa6224c4",
                                                "text": "But the yokel, being a yokel, was not good at the reading of facial expression, and only knew that a remarkably fine woman had gone by smiling."
                                            },
                                            {
                                                "example_id": "0e1ca057-1c99-4c90-aafc-8f5ce47e3185",
                                                "sense_id": "6104511e-aad0-3448-9b7f-c483aa6224c4",
                                                "text": "The sullen clerk there did not return my greetings or my farewell, did not say a word, and did not show a single facial expression except irritation that I had interrupted his customerless routine."
                                            },
                                            {
                                                "example_id": "07f0b798-0e9d-4ec7-8994-b969d27b88a9",
                                                "sense_id": "6104511e-aad0-3448-9b7f-c483aa6224c4",
                                                "text": "2017, Jennifer S. Holland, For These Monkeys, It’s a Fight for Survival., National Geographic (March 2017)http://www.nationalgeographic.com/magazine/2017/03/macaques-monkeys-indonesia-endangered-pet-trade/\nFacial expressions convey moods: Ritualized yawning—which starts with an oval mouth that breaks into a gaping one as the animal flings its head back—suggests tension."
