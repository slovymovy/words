                "translations": [
                    {
                        "translation_id": "0ec38462-11d2-488f-862e-e4606df5f033",
                        "source_entry_id": "29cd22a9-37ae-3e10-8bf8-6e30f452727b",
                        "source_sense_id": "97d0e503-96fb-3146-9dcc-a496b1af0946",
                        "source_sense_description": "dat deel van een blaasinstrument dat in de mond genomen wordt of aan de lippen gezet",
                        "target_lang_word": "Mundstück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mundstück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "291c065a-ceeb-3f50-b2a4-5557e083d55e",
                                        "entry_id": "2353f423-ee9a-3518-a43a-4c75d181605c",
                                        "glosses": [
                                            "Teil eines Blasinstruments, in das hineingeblasen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e57e8e-1e5a-44a3-b5fe-0cd2a52bf9e4",
                                                "sense_id": "291c065a-ceeb-3f50-b2a4-5557e083d55e",
                                                "text": "Das Mundstück meiner Trompete ist total verdreckt."
                                            },
                                            {
                                                "example_id": "69d9566a-c39d-45d6-aab4-73e96b013ed8",
                                                "sense_id": "291c065a-ceeb-3f50-b2a4-5557e083d55e",
                                                "text": "„Der erste Moment, wenn man die Nadel aufsetzt, ist wie das Luftholen der Sängerin vor dem ersten Ton, wie das Ansetzen der Trompter, bevor sie die Lippen um ihr Mundstück schließen, wie die Ruhe vor dem Sturm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd0930a7-e7c1-3f55-af39-b49625fa96da",
                                        "entry_id": "2353f423-ee9a-3518-a43a-4c75d181605c",
                                        "glosses": [
                                            "Gebissstück des Zaumzeugs für Pferde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f709e27-8771-4163-a20b-bb61f291a5d9",
                                                "sense_id": "bd0930a7-e7c1-3f55-af39-b49625fa96da",
                                                "text": "Es ist wichtig darauf zu achten, dass das Mundstück im Maul des Pferdes nicht verrutschen kann und somit das Pferd verletzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec966a63-772f-3310-bf09-5adf55cae662",
                                        "entry_id": "2353f423-ee9a-3518-a43a-4c75d181605c",
                                        "glosses": [
                                            "Bauteil einer Tabakspfeife, durch den der Rauch aufgenommen wird; mundgerecht geformtes Röhrchen, in das man eine Zigarette stecken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441c725e-8915-44a4-b65f-1620a20680a0",
                                                "sense_id": "ec966a63-772f-3310-bf09-5adf55cae662",
                                                "text": "Mundstücke, mit denen der Raucher die Pfeife mit den Zähnen im Mund halten kann, sind am weitesten verbreitet."
                                            },
                                            {
                                                "example_id": "146118a8-24c2-4a74-9532-2add0ad04062",
                                                "sense_id": "ec966a63-772f-3310-bf09-5adf55cae662",
                                                "text": "„Gleichen sich die Glimmstengel heute in Preis und Zusammensetzung weitgehend, konnte der historische Raucher weitaus mehr Standesbewußtsein und Eleganz demonstrieren: Er wählte allein bei den Mundstücken zwischen solchen aus Pappe, Kork oder Gold.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c7d2738f-f559-3bc4-b599-5626c7e10d9a",
                                        "entry_id": "2353f423-ee9a-3518-a43a-4c75d181605c",
                                        "glosses": [
                                            "Bauteil eines Wasserstrahlrohrs der Feuerwehr, das die Wassermenge reguliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b728279-445e-438e-a54d-89f03eeb3e17",
                                                "sense_id": "c7d2738f-f559-3bc4-b599-5626c7e10d9a",
                                                "text": "Die Wassermenge kann über ein abschraubbares Mundstück geändert werden, dazu muss aber die Wasserabgabe unterbrochen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ea1120b-7d5b-4b4e-9807-9a4a966f8b1b",
                        "source_entry_id": "29cd22a9-37ae-3e10-8bf8-6e30f452727b",
                        "source_sense_id": "97d0e503-96fb-3146-9dcc-a496b1af0946",
                        "source_sense_description": "dat deel van een blaasinstrument dat in de mond genomen wordt of aan de lippen gezet",
                        "target_lang_word": "embouchure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embouchure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df13436e-4ea2-368f-98b5-8ec7520b6e76",
                                        "entry_id": "0afb5e55-986f-3e2e-a20b-0389b2758676",
                                        "glosses": [
                                            "The use of the lips, facial muscles, tongue, and teeth when playing a wind instrument."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5401193-2c99-467e-9c45-9ef70e0b36ec",
                                                "sense_id": "df13436e-4ea2-368f-98b5-8ec7520b6e76",
                                                "text": "you could see the twin lines running down from either side of his lower lip, etched in by the force of his embouchure, looking like extensions of his mustache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4940f275-3eee-31ed-acc3-812e911eee11",
                                        "entry_id": "0afb5e55-986f-3e2e-a20b-0389b2758676",
                                        "glosses": [
                                            "The mouth of a river or valley."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a830f853-d864-4318-8b98-0f6377de199b",
                                                "sense_id": "4940f275-3eee-31ed-acc3-812e911eee11",
                                                "text": "Passing by Conical Rock, an isolated peak which forms a conspicuous landmark, the coast trends to the northward to Cape Dudley Digges and on to Cape Athol. Beyond Cape Athol lies Saunders Island, at the entrance to Wolstenholme Sound, which like most of these inlets, forms the embouchure of a glacier-river."
                                            },
                                            {
                                                "example_id": "400a7f3a-b3f0-4993-abca-1e1791fb4f90",
                                                "sense_id": "4940f275-3eee-31ed-acc3-812e911eee11",
                                                "text": "We approached Piteå at sunset. The view over the broad embouchure of the river, studded with islands, was quite picturesque, and the town itself, scattered along the shore and over the slopes of hills made a fair appearance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
