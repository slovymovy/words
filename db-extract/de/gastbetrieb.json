                "senses": [
                    {
                        "sense_id": "1bee8139-936a-3d87-9d83-31bc9435b6c8",
                        "entry_id": "2de71d60-baae-32d7-bfdf-81d7150a9177",
                        "glosses": [
                            "gewerbliches Unternehmen, das Speisen und Getränke zum Verzehr vor Ort anbietet, sowie dessen Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f419fb1-b39a-4057-9efd-6f8c3b30933c",
                                "sense_id": "1bee8139-936a-3d87-9d83-31bc9435b6c8",
                                "text": "„1907 wurde der Gastbetrieb eingestellt; in das Gebäude zog ein Steinmetzbetrieb ein.“"
                            },
                            {
                                "example_id": "ab87e46b-edcb-48f7-b795-adf4c943c683",
                                "sense_id": "1bee8139-936a-3d87-9d83-31bc9435b6c8",
                                "text": "„Die massenweise ausgefertigten Gästelisten, deren sinngemäße Verwahrung und Vernichtung in den jeweiligen Gastbetrieben schon bisher schleierhaft war und noch immer ist, wurden nun von Ermittlungsbehörden in Einzelfällen quasi zur ‚Rasterfahndung‘, zur Tätersuche bei Ordnungsdelikten genutzt.“"
                            },
                            {
                                "example_id": "82e1ee00-2f88-4e8a-97d7-32d1cf8bb1ba",
                                "sense_id": "1bee8139-936a-3d87-9d83-31bc9435b6c8",
                                "text": "„Lange wird ein Teil der Gastbetriebe den eingeschränkten Betrieb wohl trotzdem nicht durchstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
