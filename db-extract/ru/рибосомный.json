                "senses": [
                    {
                        "sense_id": "4ce1ecb6-000d-352e-ad93-5049efa9f1c4",
                        "entry_id": "1c21ea64-9c06-310d-a324-e4e27833bc18",
                        "glosses": [
                            "генет. связанный, соотносящийся по значению с существительным рибосома"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e3f2a4-4270-4487-8b53-fb4f202e1a49",
                                "sense_id": "4ce1ecb6-000d-352e-ad93-5049efa9f1c4",
                                "text": "В клетке царят железные законы рибосомной монополии."
                            },
                            {
                                "example_id": "78b77f07-47e8-4961-a078-efabdca21367",
                                "sense_id": "4ce1ecb6-000d-352e-ad93-5049efa9f1c4",
                                "text": "Вкратце, в процессе работы рибосомы тРНК проходит по щели между двумя рибосомными субчастицами, последовательно попадая в три тРНК-связывающих «кармана»."
                            }
                        ]
                    }
