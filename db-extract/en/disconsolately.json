                                "example_id": "0232ae75-e480-4e33-ad93-4d11d2f04c3d",
                                "sense_id": "63933275-c06d-3a4b-bd07-7746b0efead5",
                                "text": "From the bank the lamb looked at her, then faced round to the hut, and, baaing disconsolately, trotted a few paces back."
                            },
                            {
                                "example_id": "3fc2fbf1-7ba4-4f24-9620-99bf79e79d89",
                                "sense_id": "63933275-c06d-3a4b-bd07-7746b0efead5",
                                "text": "Disconsolately they shot the water-chute, swung on the swings, ate fairy floss from the booth like nostalgic exiles from fairyland."
                            }
                        ]
                    }
