{
    "word_family": [
        "insulting",
        "insultingly",
        "insulter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d0164fa-ab47-3847-85ad-facc8f70c064",
                    "sense_definition": "A rude action or remark intended to hurt someone's feelings or show disrespect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rude_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took his silence as a personal <w>insult</w> to her intelligence.",
                            "target_lang_translations": {
                                "ru": "Она восприняла его молчание как личное <w>оскорбление</w> её интеллекта.",
                                "zh": "她把他的沉默看作是对她智商的个人<w>侮辱</w>。"
                            }
                        },
                        {
                            "text": "To add <w>insult</w> to injury, the car broke down after we got completely lost.",
                            "target_lang_translations": {
                                "ru": "В довершение <w>обиды</w>, машина сломалась после того, как мы окончательно заблудились.",
                                "zh": "更糟糕的是，我们在彻底迷路后车又坏了。"
                            }
                        },
                        {
                            "text": "He shouted an angry <w>insult</w> at the driver who cut him off in traffic.",
                            "target_lang_translations": {
                                "ru": "Он выкрикнул злое <w>оскорбление</w> водителю, который подрезал его в потоке.",
                                "zh": "他对着那个在交通中强行加塞的司机大声喊出愤怒的<w>侮辱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "offense",
                        "affront",
                        "slight",
                        "slur",
                        "put-down",
                        "disrespect"
                    ],
                    "antonyms": [
                        "compliment"
                    ],
                    "common_phrases": [
                        "add insult to injury",
                        "take as an insult",
                        "personal insult",
                        "shout an insult"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубое действие или замечание, направленное на то, чтобы задеть чьи-то чувства или проявить неуважение.",
                        "zh": "指旨在伤害他人感情或表现出不尊重的粗鲁行为或言语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "унижение чести и достоинства"
                            },
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "несправедливо причинённое огорчение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侮辱",
                                "target_lang_sense_clarification": "言语或行为上的冒犯"
                            },
                            {
                                "target_lang_word": "冒犯",
                                "target_lang_sense_clarification": "言行不当引起他人不快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87b7e8b7-7b41-351f-bb16-2c8f48762b06",
                    "sense_definition": "Something that is of such low quality that it is considered offensive or unacceptable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unacceptable_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The extremely low salary they offered was an <w>insult</w> to his years of experience.",
                            "target_lang_translations": {
                                "ru": "Чрезвычайно низкая зарплата, которую они предложили, была <w>оскорблением</w> для его многолетнего опыта.",
                                "zh": "他们提供的极低薪水是对他多年经验的<w>侮辱</w>。"
                            }
                        },
                        {
                            "text": "That terrible movie was an absolute <w>insult</w> to the original book.",
                            "target_lang_translations": {
                                "ru": "Этот ужасный фильм был настоящим <w>издевательством</w> над оригинальной книгой.",
                                "zh": "那部糟糕的电影简直是对原著的<w>亵渎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "outrage"
                    ],
                    "antonyms": [
                        "compliment"
                    ],
                    "common_phrases": [
                        "insult to intelligence",
                        "insult to the memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то настолько низкого качества, что это считается оскорбительным или неприемлемым.",
                        "zh": "指质量极低，以至于被认为具有冒犯性或不可接受的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "в переносном смысле: что-то недопустимое"
                            },
                            {
                                "target_lang_word": "издевательство",
                                "target_lang_sense_clarification": "насмешка, крайне плохое качество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亵渎",
                                "target_lang_sense_clarification": "指对某种事物极大的不尊重"
                            },
                            {
                                "target_lang_word": "糟蹋",
                                "target_lang_sense_clarification": "指对原作或价值的严重贬低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25d7b6a4-bdd0-3b0c-8ec7-c937aec54f27",
                    "sense_definition": "An injury or trauma to the body, an organ, or a tissue caused by an external factor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the sudden <w>insult</w> to the brain caused the seizure.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что внезапное <w>повреждение</w> мозга вызвало приступ.",
                                "zh": "医生解释说，大脑遭受的突发性<w>损伤</w>导致了癫痫发作。"
                            }
                        },
                        {
                            "text": "The liver can often recover from a toxic <w>insult</w> if the damage is not too severe.",
                            "target_lang_translations": {
                                "ru": "Печень часто может восстановиться после токсического <w>поражения</w>, если ущерб не слишком серьезен.",
                                "zh": "如果损害不是太严重，肝脏通常可以从毒性<w>损伤</w>中恢复。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brain insult",
                        "ischemic insult"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повреждение или травма тела, органа или ткани, вызванная внешним фактором.",
                        "zh": "由外部因素引起的身体、器官或组织的损伤或创伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повреждение",
                                "target_lang_sense_clarification": "нарушение целостности или функции"
                            },
                            {
                                "target_lang_word": "поражение",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损伤",
                                "target_lang_sense_clarification": "医学上指组织或器官的受损"
                            },
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "指功能或结构的破坏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ef428c7-2ddd-3a34-86c0-4edadca941f8",
                    "sense_definition": "To speak to or treat someone with disrespect or rudeness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rude_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not mean to <w>insult</w> you with my comment about the food.",
                            "target_lang_translations": {
                                "ru": "Я не хотел <w>обидеть</w> вас своим комментарием о еде.",
                                "zh": "我关于食物的评论并非有意要<w>冒犯</w>你。"
                            }
                        },
                        {
                            "text": "He felt deeply <w>insulted</w> when they forgot to invite him to the party.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя глубоко <w>оскорблённым</w>, когда они забыли пригласить его на вечеринку.",
                                "zh": "当他们忘记邀请他参加聚会时，他感到深受<w>侮辱</w>。"
                            }
                        },
                        {
                            "text": "Please do not <w>insult</w> my intelligence by lying about where you were.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>оскорбляй</w> мой интеллект ложью о том, где ты был.",
                                "zh": "请不要用关于你行踪的谎言来<w>侮辱</w>我的智商。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disrespect",
                        "affront",
                        "offend"
                    ],
                    "antonyms": [
                        "compliment"
                    ],
                    "common_phrases": [
                        "insult someone's intelligence",
                        "feel insulted",
                        "be insulted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с кем-то или обращаться с кем-то неуважительно или грубо.",
                        "zh": "以不尊重或粗鲁的方式对待某人或与某人交谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "унижать, задевать честь"
                            },
                            {
                                "target_lang_word": "обижать",
                                "target_lang_sense_clarification": "причинять душевную боль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侮辱",
                                "target_lang_sense_clarification": "言语或行为上的冒犯"
                            },
                            {
                                "target_lang_word": "冒犯",
                                "target_lang_sense_clarification": "言行不当引起他人不快"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}