                                "target_senses": [
                                    {
                                        "sense_id": "8dfe8a88-08e6-3c3a-8c20-b45974fa8134",
                                        "entry_id": "8f852ad8-16f9-3cd7-bb55-fddc532fcbc3",
                                        "glosses": [
                                            "aanhanger van het fundamentalisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d40616e5-63cf-47e6-b986-4cdcf39130ab",
                                                "sense_id": "8dfe8a88-08e6-3c3a-8c20-b45974fa8134",
                                                "text": "fundamentalisten hebben er nu eenmaal een hekel aan dat men zelf bepaalt wat men wil geloven of denken"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8974b3ec-c694-4814-9ae6-1ef8409af835",
                        "source_entry_id": "97d1082e-b955-398d-bdce-204b989e5cf8",
                        "source_sense_id": "3f4dc7fc-4315-3f7e-bd37-2895116c1040",
                        "target_lang_word": "fondamentaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondamentaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "305715c2-76eb-3d9a-81da-e691ee4096cc",
                                        "entry_id": "f4e3ccc2-e685-3ec2-a331-c59415b8f5e5",
                                        "glosses": [
                                            "Partisan du fondamentalisme, du retour aux fondements de la religion, d’un principe, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7c3e82-dc6f-4092-8d77-ad9f4130fa9b",
                                                "sense_id": "305715c2-76eb-3d9a-81da-e691ee4096cc",
                                                "text": "Si vous êtes un chrétien fondamentaliste, probablement protesterez-vous que chaque mot de la Bible est littéralement vrai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa002f7f-3624-368d-8d0a-d7685abfb044",
                                        "entry_id": "f4e3ccc2-e685-3ec2-a331-c59415b8f5e5",
                                        "glosses": [
                                            "Partisan d'un retour à une vision originelle de la foi et de la doctrine chez les catholiques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ed40c7-718b-42ee-a299-d0aef0c3d59d",
                                                "sense_id": "fa002f7f-3624-368d-8d0a-d7685abfb044",
                                                "text": "D'une certaine façon, le fondamentaliste nie la médiation d'une autorité religieuse – clergé, Église, docteurs de la loi – qui interpose habituellement une clé d'interprétation entre le croyant et le texte révélé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f613c32e-5e81-3c9a-94b8-002de52106ab",
                                        "entry_id": "f4e3ccc2-e685-3ec2-a331-c59415b8f5e5",
                                        "glosses": [
                                            "Partisan de la vision traditionnelle de la religion chez les musulmans."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c35dd6-5152-4886-850a-57b8a99d88e7",
                                                "sense_id": "f613c32e-5e81-3c9a-94b8-002de52106ab",
                                                "text": "Ces croyants, qui pensent que les traditions d’autrefois sont plus « pures » que celles d’aujourd’hui, sont appelés « ultraorthodoxes » chez les juifs, « intégristes » chez les catholiques et « fondamentalistes » chez les musulmans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fondamentaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                        "entry_id": "3c29a8a7-6b2f-30c1-b346-2c7c2f89a3ce",
                                        "glosses": [
                                            "Relatif au fondamentalisme, au retour aux fondements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "522faf64-7e1b-4e4c-a595-78865c3427bd",
                                                "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                                "text": "Le monde fondamentaliste est un monde polarisé : bien ou mal, vérité ou mensonge, position vaine ou situation authentique, nous ou eux, un de nous ou l’ennemi."
                                            },
                                            {
                                                "example_id": "ddfb07a4-658e-4a0d-b133-74397ac26244",
                                                "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                                "text": "D'une façon intéressante, les néoconservateurs, poursuivant une quête digne de Moby Dick pour trouver un monstre à occire — […] — sont, de par leur tempérament et leur point de vue philosophique, bien plus « fondamentalistes » que ceux qu'ils perçoivent comme leurs ennemis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
