                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65fca28a-75ca-4332-8f2d-c5c31e38c5a0",
                                "sense_id": "a2780965-ef93-345d-b0c9-16a311079c29",
                                "text": "Israël heeft nog niet inhoudelijk gereageerd op het voorstel, dat het Egyptische ministerie van Buitenlandse Zaken gisteravond lanceerde. Vanochtend vergadert het Israëlische veiligheidskabinet erover."
                            },
                            {
                                "example_id": "8a875a07-b579-440b-95eb-00de1e7575b1",
                                "sense_id": "a2780965-ef93-345d-b0c9-16a311079c29",
                                "text": "Gisteravond laat kwam het Israëlische veiligheidskabinet bijeen, nadat eerder op de dag de lichamen van de drie waren gevonden. Na het overleg bleek dat er nog geen overeenstemming is over een Israëlisch antwoord. Vanavond komt het kabinet opnieuw bijeen."
                            }
                        ]
                    }
