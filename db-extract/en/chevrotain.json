                        "entry_id": "95ae9522-18ca-3384-9a3b-a0d6a5de4cb6",
                        "glosses": [
                            "Any of several small hornless ruminants of the family Tragulidae, native to tropical rainforests of South and Southeast Asia, and Central and West Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d4c9fc-a31c-44d3-bf14-d32428bf25c4",
                                "sense_id": "9f247066-6619-3beb-a677-68322b63962e",
                                "text": "To this vve may add the Chevrotin, or little Guinea Deer, vvhich is the leaſt of all cloven-footed quadrupeds, and perhaps the moſt beautiful; its legs, at the ſmalleſt part, are not much thicker than the ſhank of a tobacco-pipe; it is about ſeven inches high, and about tvvelve from the point of the noſe to the inſertion of the tail."
                            }
                        ]
                    }
