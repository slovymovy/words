                                "example_id": "f756f5c9-0054-430d-9087-5493213fa99a",
                                "sense_id": "b321eed5-2564-35af-b62f-3013220653fa",
                                "text": "Vele zeevaarders verkenden onbekende wateren op zoek naar nieuw land.",
                                "translation": "Many seafarers explored unknown waters in search of new land.",
                                "english": "Many seafarers explored unknown waters in search of new land."
