                        "examples": [
                            {
                                "example_id": "0c31afd1-2ebf-47ba-8386-78911e8cb8b0",
                                "sense_id": "64d6f5be-1271-3610-9e21-454dc51402f0",
                                "text": "Als je last hebt van je buren kun je dat het best met de buren zelf bespreken, als dat geen effect heeft kun je een klachtenbrief schrijven."
                            },
                            {
                                "example_id": "34320418-b6ac-4529-aea5-3aef85f88622",
                                "sense_id": "64d6f5be-1271-3610-9e21-454dc51402f0",
                                "text": "Als je niet tevreden bent over de bezorging van de krant en telefoontjes hebben niet geholpen, kun je een klachtenbrief schrijven."
                            }
                        ]
                    }
