                                    {
                                        "sense_id": "a9905780-0ef1-32ed-a83e-bd523848abd2",
                                        "entry_id": "b52e733e-b93d-3db8-b7ad-66548078ec75",
                                        "glosses": [
                                            "Muffled, muted; subdued."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9a6583-0bd6-4fe0-9c39-8a6aceaa8ddd",
                                                "sense_id": "a9905780-0ef1-32ed-a83e-bd523848abd2",
                                                "text": "The streets had been considerably quieter in the sourdine Past."
                                            }
                                        ]
