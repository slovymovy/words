                "senses": [
                    {
                        "sense_id": "c2b61dc9-e777-310e-9563-81ba934f3ca8",
                        "entry_id": "cd5519b5-57a4-3750-8558-cc178845e26d",
                        "glosses": [
                            "Konstruktion aus Stangen und/oder Seilen zum (spielerischen) Klettern (besonders für Kinder auf Spielplätzen, aber auch zum Beispiel für Affen im Zoo oder Kletterpflanzen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a001b5d-7d75-4173-8d2b-7d2524f69ea6",
                                "sense_id": "c2b61dc9-e777-310e-9563-81ba934f3ca8",
                                "text": "Immer mehr Kinder müssen heutzutage eine Art Schutzhelm aufsetzen, bevor sie aufs Klettergerüst dürfen."
                            },
                            {
                                "example_id": "0f711313-065b-4e41-98f8-fa1a3c18815d",
                                "sense_id": "c2b61dc9-e777-310e-9563-81ba934f3ca8",
                                "text": "„Sie fuhren an den Gestellen vorbei, auf denen man früher Fisch getrocknet hatte, die aber mittlerweile vor allem Kindern als Klettergerüste dienten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
