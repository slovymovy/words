                        "entry_id": "d5b7ec68-61ba-335a-9a96-eb06e1ff4827",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "métalloïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2f7d87b-17e3-3af0-bdae-cd139e29fa44",
                        "entry_id": "d5b7ec68-61ba-335a-9a96-eb06e1ff4827",
                        "glosses": [
                            "Qui a certaines des caractéristiques d'un métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83d77b7d-bdd6-4151-b994-3f7a8539f01e",
                                "sense_id": "b2f7d87b-17e3-3af0-bdae-cd139e29fa44",
                                "text": "Des variétés allotropiques du phosphore ou du bismuth présentent des comportements métalloïdes."
                            },
                            {
                                "example_id": "e5b6b521-ced2-4fe2-a7fe-5792efb892a7",
                                "sense_id": "b2f7d87b-17e3-3af0-bdae-cd139e29fa44",
                                "text": "Il est bien clair que le potassium, le zinc, le cuivre sont des métaux pour tout le monde, de même que l’iode, l’oxygène, le soufre sont invariablement qualifiés de métalloïdes. Les propriétés physiques et chimiques des premiers diffèrent à tel point de celles des derniers qu’aucune hésitation n’est possible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a0447b-0980-42ae-a13d-8221d15bddfd",
                        "source_entry_id": "d5b7ec68-61ba-335a-9a96-eb06e1ff4827",
                        "source_sense_id": "b2f7d87b-17e3-3af0-bdae-cd139e29fa44",
