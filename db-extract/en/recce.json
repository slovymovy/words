                        "form": "recces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                        "entry_id": "39560dd0-b81b-374c-9ddc-fbac0f11b183",
                        "glosses": [
                            "Reconnaissance."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fbabb37d-a6d2-4f9e-b0e9-747894f2f673",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "As he climbed into the car, his recce of the space behind the seats was still a little too obvious despite best efforts at subtlety."
                            },
                            {
                                "example_id": "d75defed-8b79-4864-b8b5-4715ecba5e84",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "I'm afraid you two will have to go on a bit of a recce sometime soon."
                            },
                            {
                                "example_id": "53f5755b-2172-4a2b-a60c-be630650ef67",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "1953, J. (Julian) Maclaren-Ross, The Weeping and the Laughter: A Chapter of Autobiography\nVisiting the town on what in the more recent war we called a recce, she arranged a tennis-match with Dolly, guessing that the girl would be a bad loser."
                            },
                            {
                                "example_id": "f80ec881-e54a-40d9-ad7f-3d10ddbd3aeb",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "He'd be over at Christmas to do a proper sort-through of Velerie's things, but in the meantime could Shannon have a quiet recce and make sure everything was secure?"
                            },
                            {
                                "example_id": "b78658af-3dd2-4423-ad59-5131ebf4d1d3",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "Rona disappeared into the little kitchenette and Nicol made a recce of the room."
                            },
                            {
                                "example_id": "ce6f6aa3-a3fe-475a-a5f9-705bdaf99bc1",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "1946, United States. Congress. American Commission for the Protection and Salvage of Artistic and Historic Monuments in War Areas, Hearings Before the Joint Committee on the Investigation of the Pearl Harbor Attack\nThere appears a captured photograph showing cruiser or battleship recovery of an old Jap float recce plane."
                            },
                            {
                                "example_id": "fe1c72f1-3a9a-40d2-898a-ba3f7dabfa73",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "These record imagery from all three recce sensors - IR, EO and SAR."
                            },
                            {
                                "example_id": "78357a67-4c26-4608-9cf2-3ff34196736f",
                                "sense_id": "22e4370e-bc81-303c-9ed6-d20043b3a439",
                                "text": "Reconnaissance (recce) patrols were the most effective solution that the British and Indian Army designed to identify Japanese units and their intentions, as these could move through the jungle without alerting the enemy to their presence."
                            }
                        ]
                    }
                ],
