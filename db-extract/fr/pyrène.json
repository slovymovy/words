                        "entry_id": "ca2447aa-215f-3bfe-8aac-0654bdb09459",
                        "glosses": [
                            "Composé chimique de la famille des hydrocarbures aromatiques polycycliques, de formule C₁₆H₁₀."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018213f2-1845-4216-a87c-030daeb9c64c",
                                "sense_id": "658be09a-d504-3160-a592-19781c53de43",
                                "text": "PYRÈNE (pi-rê-n’) s. m.\nProduit de la distillation du bois ; il se trouve dans l’huile de charbon de terre."
                            },
                            {
                                "example_id": "acc61cf0-ef97-4ab2-b0ee-dceed1618287",
                                "sense_id": "658be09a-d504-3160-a592-19781c53de43",
                                "text": "Certains carbures cycliques et polycycliques sont colorés, tels le pyrène."
                            }
                        ]
                    }
                ],
