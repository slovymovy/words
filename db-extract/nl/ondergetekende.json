                                    {
                                        "sense_id": "f6cd56f6-a768-36e9-9ae9-0b0dc4530e13",
                                        "entry_id": "65ef5f58-c6f6-341c-b931-db0e67b48a3e",
                                        "glosses": [
                                            "Used to close a note or letter."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "074b5075-244b-4978-ab20-b2a108019858",
                                                "sense_id": "f6cd56f6-a768-36e9-9ae9-0b0dc4530e13",
                                                "text": "Please write back soon! Yours truly, Alice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yours truly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15e9c9e8-24e9-3e20-91dc-e2a331d677b5",
                                        "entry_id": "0892c76c-1d4c-3dbd-91c7-61dac83d673a",
                                        "glosses": [
                                            "I, me, or myself."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98114c57-2911-403f-8fc4-d8014d1afed3",
                                                "sense_id": "15e9c9e8-24e9-3e20-91dc-e2a331d677b5",
                                                "text": "This one was created by yours truly."
                                            },
                                            {
                                                "example_id": "7dcb3e6a-c440-4cc5-af55-ac2a2349be6e",
                                                "sense_id": "15e9c9e8-24e9-3e20-91dc-e2a331d677b5",
                                                "text": "Nobody in Africa, but yours truly, can get a good head of steam on the old African Queen."
                                            },
                                            {
                                                "example_id": "58dcd926-4a16-4c2d-882a-7e0e6c056f9a",
                                                "sense_id": "15e9c9e8-24e9-3e20-91dc-e2a331d677b5",
                                                "text": "Vera introduced us, and Boris was interested to hear I was a masseur. He mentioned that he had gotten a massage several times a week when he was in Hollywood—so, before you could say “Bob’s your uncle and Fanny’s your aunt,” yours truly offered the man who had made more people shiver and shake than any man alive a massage on the house."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65892539-e402-4640-82cc-a4c579e3fe1c",
                        "source_entry_id": "5c4f59a7-5d86-30e0-a575-ca07df60a535",
                        "source_sense_id": "de150a51-cc1a-3e81-9cbf-1031c0077069",
                        "source_sense_description": "(schertsend) in verwijzing naar zichzelf",
                        "target_lang_word": "votre humble serviteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "votre humble serviteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddaee68d-7e29-3e79-8bfd-698c7cd5fcde",
                                        "entry_id": "da05e9d3-5c90-349b-a5c3-f00fc0cdc361",
                                        "glosses": [
                                            "Moi ; je. — Note d’usage : Le verbe est conjugué à la troisième personne du singulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ff3256-d14a-4491-8ce1-a0e0322cfc74",
                                                "sense_id": "ddaee68d-7e29-3e79-8bfd-698c7cd5fcde",
                                                "text": "Et votre humble serviteur, qui pourtant passe sa vie en l’air et dans les michelines, a déjà un mal de chien à classer les restaurants du VIe arrondissement de Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3b8eb44-3545-4a73-8592-28f49fc19740",
                        "source_entry_id": "5c4f59a7-5d86-30e0-a575-ca07df60a535",
