                ],
                "senses": [
                    {
                        "sense_id": "87d882bf-57b2-3a64-b11f-6faf863e200c",
                        "entry_id": "39ea87c9-f5a2-373c-8ab8-cd7a70cb64f5",
                        "glosses": [
                            "To form into pearls, or make pearly."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e3bff50-b034-4096-a0a9-912541087b35",
                                "sense_id": "87d882bf-57b2-3a64-b11f-6faf863e200c",
                                "text": "Virgins of equall birth, [...] / Shall draw thy picture, and record thy life; / One ſhall enſphere thine eyes, another ſhall / Impearl thy teeth[,] a third thy white and ſmall / Hand ſhall beſnow, a fourth incarnadine / Thy roſie cheek, [...]"
                            },
                            {
                                "example_id": "90ccbdf0-bddf-4dde-b644-be0867c74744",
                                "sense_id": "87d882bf-57b2-3a64-b11f-6faf863e200c",
                                "text": "Or Starrs of Morning, Dew-Drops, which the Sun / Impearls on every leaf and every flouer."
                            }
                        ]
                    },
                    {
                        "sense_id": "94a7fa09-0d40-3c49-8122-095586257162",
                        "entry_id": "39ea87c9-f5a2-373c-8ab8-cd7a70cb64f5",
                        "glosses": [
                            "To decorate as if with pearls."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee122861-b865-49f6-b83c-556317f6c027",
                                "sense_id": "94a7fa09-0d40-3c49-8122-095586257162",
                                "text": "The Devvs of the Morning impearl every Thorn, and ſcatter Diamonds on the verdant Mantle of the Earth."
                            },
                            {
                                "example_id": "58a7bab2-7440-4e4e-aded-a9fd845d9ed3",
                                "sense_id": "94a7fa09-0d40-3c49-8122-095586257162",
                                "text": "Then I, long tried / By natural ills, received the comfort fast, / While budding at thy sight, my pilgrim's staff / Gave out green leaves with morning dews impearled."
                            },
                            {
                                "example_id": "f56885b5-e994-470f-8d9c-10d82f7b0cca",
                                "sense_id": "94a7fa09-0d40-3c49-8122-095586257162",
                                "text": "On life's long round by chance I found / A dell impearled with dew, / Where hyacinths, gushing from the ground, / Lent to the earth heaven's native hue / Of holy blue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "963c2a17-bd7a-466d-a0a6-9d68971ad225",
                        "source_entry_id": "39ea87c9-f5a2-373c-8ab8-cd7a70cb64f5",
                        "source_sense_description": "to decorate with pearls",
                        "target_lang_word": "emperler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emperler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "652bc433-6b04-301b-a5e8-c13c44af6165",
                                        "entry_id": "1ffb2e1f-95b3-3703-ae08-7d2bff379916",
                                        "glosses": [
                                            "Orner de perles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de06f69-32c5-4cdc-bfaa-f3752bbdbad0",
                                                "sense_id": "652bc433-6b04-301b-a5e8-c13c44af6165",
                                                "text": "Emperler un corsage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba5afc87-349f-3d55-9ad4-5b1ac28005da",
                                        "entry_id": "1ffb2e1f-95b3-3703-ae08-7d2bff379916",
                                        "glosses": [
                                            "Couvrir de gouttelettes qui ressemblent à des perles."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1e16e5c-7844-415b-912c-598179ef4cc8",
                                                "sense_id": "ba5afc87-349f-3d55-9ad4-5b1ac28005da",
                                                "text": "Voici qu’une gemmation imprévue emperla la peau nue de l’idole ; des gouttelettes de sueur brillèrent et une odeur de femme un instant domina les aromes épars volatilisés."
                                            },
                                            {
                                                "example_id": "0edcef66-0fde-47a5-beb0-97ac49f9ad8e",
                                                "sense_id": "ba5afc87-349f-3d55-9ad4-5b1ac28005da",
                                                "text": "Excusez-moi, dit Amédée dont la sueur emperlait le front."
                                            },
                                            {
                                                "example_id": "42e96b39-1693-4eee-8c19-c13e48904d72",
                                                "sense_id": "ba5afc87-349f-3d55-9ad4-5b1ac28005da",
                                                "text": "La poussière que tu vois sur mes jambes, les chanteurs la compareront un jour à la rosée qui emperle les pelouses du Paradis !"
                                            },
                                            {
                                                "example_id": "627bdafa-b8fb-4c97-8ec1-b09b7a48ed81",
                                                "sense_id": "ba5afc87-349f-3d55-9ad4-5b1ac28005da",
                                                "text": "Au bout de trois mètres, il retint son pas, se retourna, vit que la directrice s’était aussi arrêtée, malgré la bruine qui emperlait ses cheveux gris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e6db5a7-9c08-36d0-904f-1dc169a98b1b",
                                        "entry_id": "1ffb2e1f-95b3-3703-ae08-7d2bff379916",
                                        "glosses": [
                                            "Embellir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24803f10-5a99-48b0-a55e-a1b18a13b9d4",
                                                "sense_id": "1e6db5a7-9c08-36d0-904f-1dc169a98b1b",
                                                "text": "Malherbe emperlait trop son style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f73a641-d731-3319-a53e-69b7a4c40049",
                                        "entry_id": "1ffb2e1f-95b3-3703-ae08-7d2bff379916",
                                        "glosses": [
                                            "Se couvrir de gouttelettes."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a22949a-ff4a-4754-8b95-9d6d6d4c0fb8",
                                                "sense_id": "6f73a641-d731-3319-a53e-69b7a4c40049",
                                                "text": "Ganteaume, le plus misérable, ayant perdu amour et trésors, mêlait l’averse de ses pleurs aux gouttes rejaillies dont s’emperlaient les rames."
                                            },
                                            {
                                                "example_id": "8a993c04-f3c8-417b-acfa-c45f1a81240c",
                                                "sense_id": "6f73a641-d731-3319-a53e-69b7a4c40049",
                                                "text": "Elle eut peur. Elle se dit que le verrou la défendait, qu’elle n’avait rien à craindre ; pourtant, son front s’emperla d’une sueur froide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
