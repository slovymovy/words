                ],
                "senses": [
                    {
                        "sense_id": "019eae5c-ba81-3e9f-9a55-aefd86d11331",
                        "entry_id": "714f6954-3d45-304f-b683-c0e3b648385f",
                        "glosses": [
                            "de in de 15de eeuw ontwikkelde kunst om teksten door middel van een drukpers te vermenigvuldigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "618c4e0b-9671-4818-a13e-5dc0a8bdaf86",
                                "sense_id": "019eae5c-ba81-3e9f-9a55-aefd86d11331",
                                "text": "Het is een van de redenen waarom internet, dat piepjonge medium, zo verwarrend kan zijn en waarom we nog decennia nodig zullen hebben om ermee leren om te gaan, zoals we ooit ook hebben moeten wennen aan de uitvinding van het schrift en de boekdrukkunst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2ddb73b-fbc0-4718-97d5-2e0654a67d0e",
                        "source_entry_id": "714f6954-3d45-304f-b683-c0e3b648385f",
                        "source_sense_id": "019eae5c-ba81-3e9f-9a55-aefd86d11331",
                        "source_sense_description": "de in de 15de eeuw ontwikkelde kunst om teksten door middel van een drukpers te vermenigvuldigen",
                        "target_lang_word": "Buchdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38ef43c4-a3ee-3afc-80ce-83a2b7484674",
                                        "entry_id": "be1305bd-c7a4-3dd8-a371-4ef74f69e4f4",
                                        "glosses": [
                                            "Druckverfahren mit beweglichen Lettern zur Vervielfältigung von Schriftwerken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdbce49-099d-4857-b478-ba3880448e99",
                                                "sense_id": "38ef43c4-a3ee-3afc-80ce-83a2b7484674",
                                                "text": "Der Buchdruck ist in Deutschland seit Johannes Gutenberg bekannt."
                                            },
                                            {
                                                "example_id": "39a99aca-cb86-42e4-afd0-7a44b748eca6",
                                                "sense_id": "38ef43c4-a3ee-3afc-80ce-83a2b7484674",
                                                "text": "„Johannes Gutenberg, der Erfinder des Buchdrucks mit beweglichen Lettern, nahm für seinen Bibeldruck (1452-1455) die Textura, die er nach handschriftlichem Vorbild in Lettern goß (…).“"
                                            },
                                            {
                                                "example_id": "6647672e-8de6-4295-a3d7-ff5f7651a0f3",
                                                "sense_id": "38ef43c4-a3ee-3afc-80ce-83a2b7484674",
                                                "text": "„Und als der Buchdruck ihre erschwingliche Herstellung ermöglicht, da erscheinen plötzlich und in überraschend großer Zahl vielerorts »Formulare vnd Tutsch rhetorica«.“"
                                            },
                                            {
                                                "example_id": "38a5e391-4336-49c2-84ca-cee01d8464f4",
                                                "sense_id": "38ef43c4-a3ee-3afc-80ce-83a2b7484674",
                                                "text": "„Erst allmählich entwickelten sich dem Buchdruck angemessene und neue Schriftformen heraus.“"
                                            },
                                            {
                                                "example_id": "2b4e376d-944a-4c63-97ef-85338e85b194",
                                                "sense_id": "38ef43c4-a3ee-3afc-80ce-83a2b7484674",
                                                "text": "„Da ist er und trotzt den Jahreszeiten: Johannes Gutenberg, der 1450 den modernen Buchdruck mit beweglichen Lettern und die Druckerpresse erfand, mit denen es plötzlich möglich war, in größeren Mengen, schneller und preiswerter Schriften zu drucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a5b18d6-f47f-4de7-b356-b4c7b19af563",
                        "source_entry_id": "714f6954-3d45-304f-b683-c0e3b648385f",
                        "source_sense_id": "019eae5c-ba81-3e9f-9a55-aefd86d11331",
                        "source_sense_description": "de in de 15de eeuw ontwikkelde kunst om teksten door middel van een drukpers te vermenigvuldigen",
                        "target_lang_word": "printing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "printing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a62af63-5aba-3a73-b388-3947450f4f62",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "The process or business of producing printed material by means of inked type and a printing press or similar technology."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b84e80-207a-410a-8748-89f3bf4531de",
                                                "sense_id": "6a62af63-5aba-3a73-b388-3947450f4f62",
                                                "text": "In those days, printing was big business in this city. Giant web-fed presses churned out countless tons of printed matter annually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592431f5-dae1-3d73-ae78-9c5832f7d6e8",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "Synonym of printed matter."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "447ef9c6-d7fc-4824-ae6f-19e20b4560b6",
                                                "sense_id": "592431f5-dae1-3d73-ae78-9c5832f7d6e8",
                                                "text": "They delivered a huge batch of printing yesterday, so you can expect an invoice shortly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "751f4a59-0683-3710-9d9e-f866d3d3bb54",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "Synonym of print run (“all the copies of a publication that have been printed in one batch”)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e8c318-2ee5-4e3e-a846-dd8ae7b6a78f",
                                                "sense_id": "751f4a59-0683-3710-9d9e-f866d3d3bb54",
                                                "text": "She owns a copy of the first printing, which is a favorite among book collectors because some of the typos in it seem like Freudian slips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ec0b3ee-9943-3505-b2e3-026e2f288342",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "Handwritten characters that are not joined up."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7c396c-ceec-4179-bc16-352307ae3a2e",
                                                "sense_id": "4ec0b3ee-9943-3505-b2e3-026e2f288342",
                                                "text": "The instructions said, \"Please sign your name and then print your name below your signature,\" so he wrote out his name underneath in the neatest printing that his hand could muster."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "printing",
                                "target_lang_code": "en",
                                "target_senses": [
