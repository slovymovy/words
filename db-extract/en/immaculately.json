                        "glosses": [
                            "In an immaculate manner; in a manner free of stain or blemish; without being defiled."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "119c4587-4041-3f07-b387-a6d3480dbf3c",
                        "entry_id": "d1bbe0a0-8d72-3a8c-b7d3-bfd75e181cf3",
                        "glosses": [
                            "In a manner free of error; in a perfect or flawless manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a910c48e-d13c-48e9-9d6b-27cbd9acf95a",
                                "sense_id": "119c4587-4041-3f07-b387-a6d3480dbf3c",
                                "text": "He spoke immaculately, his enunciation terribly precise."
                            },
                            {
                                "example_id": "6f74f33e-5b54-42c9-8549-67f5eb873b47",
                                "sense_id": "119c4587-4041-3f07-b387-a6d3480dbf3c",
                                "text": "But winter can also be judged by the prominence of another scourge, one that is especially irksome in a city that places a premium on being well-groomed and immaculately coiffed: hat hair."
                            }
                        ]
                    }
                ],
