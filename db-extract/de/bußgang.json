                ],
                "senses": [
                    {
                        "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                        "entry_id": "f5582102-3efe-3941-8e87-058094a19d63",
                        "glosses": [
                            "Gang zu jemandem, den man um Verzeihung bittet für etwas, was man gegen dessen Willen/gegen dessen Interessen gesagt oder gemacht hat und um sich mit ihm zu versöhnen"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "347d53ea-e25d-45a9-a5af-8beadffad51f",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "[König Heinrich II.] „musste sogar einen Bußgang nach Canterbury unternehmen und wurde dabei symbolisch bestraft.“"
                            },
                            {
                                "example_id": "cf34ced3-b786-482f-bdba-2f4222116ce5",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„Verlierer war nun eindeutig Aribo, der 1031 sogar zu einem Bußgang nach Rom reiste, um das aberkannte Pallium zurückzuerhalten.“"
                            },
                            {
                                "example_id": "d68698b3-0d05-47e6-9da0-d61126cb3904",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„Von Philipp verlangte der Papst einen sofortigen Bußgang nach Rom, um die drohende Exkommunikation abzuwenden.“"
                            },
                            {
                                "example_id": "19fa031c-85d3-432c-9bd1-7478063008fb",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„Graf Raimund VII. versöhnte sich am 13. April 1229 in Paris mit einem Bußgang in Notre Dame offiziell mit der Kirche und leistete den ligischen Lehnseid auf die Krone.“"
                            },
                            {
                                "example_id": "1f89b9e4-84df-4afe-a9ab-97a673cca44a",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„1076: König Heinrich IV. bricht von Speyer zum Bußgang nach Canossa auf.“"
                            },
                            {
                                "example_id": "08108195-f781-46e6-8546-710d2bb89775",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„Im Frühjahr 1521 begibt sich Martin Luther auf die Reise nach Worms. Aber schon seine Anreise wird nicht zu dem von der Kirche erhofften Bußgang, hatte man ihn doch bereits zum Ketzer erklärt. Unterwegs predigt Luther in Erfurt, Gotha und Eisenach und er wird umjubelt.“"
                            },
                            {
                                "example_id": "b96c7c53-613a-4d16-b722-0253dcd3a1ca",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "[Schlagzeile:] Kritik am Erzbistum Köln – „Entschuldigungen und Bußgänge bleiben folgenlos“"
                            },
                            {
                                "example_id": "3cceccff-637e-470c-a1da-313305c57fe4",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "[CSU-Vorsitzender Horst Seeghofer:] „»Es ist nicht verkehrt, wenn man in höherem Alter klüger wird.« Für ein politisches Alpha-Tier wie Seehofer ist das wie ein öffentlicher Bußgang.“"
                            },
                            {
                                "example_id": "733583ee-8272-487d-9c2c-253f05a18289",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„Während die Juniorministerin Müntefering in Windhuk mit der äußerst sensiblen Rückführung von Herero- und Nama-Gebeinen für Deutschland einen Bußgang antrat, konnte Minister Müller politisch entspannt mit den Entwicklungsmilliarden winken“ […]."
                            },
                            {
                                "example_id": "9b3cdd6e-2a41-48fd-a006-97d9819039d0",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "[Borussia Dortmund – Eintracht Frankfurt 0–2:] „Die Dortmunder belegen nach der Niederlage erstmals seit sieben Jahren den letzten Tabellenplatz. Auf dem Bußgang in die Fankurve gab es erstmals auch Pfiffe gegen die Krisen-Kicker.“"
                            },
                            {
                                "example_id": "02c5775d-3b70-4b4b-971a-bd9f564ab41a",
                                "sense_id": "39265522-5016-3249-bba0-806ed5d95f31",
                                "text": "„\"Als ich jung war\" ist eine Art Rechenschaftsbericht, vielleicht sogar ein Bußgang des Ich-Erzählers, der seine Schuld offenlegen, der aber auch Schluss machen will mit dem quälenden Selbstmitleid und der sich letzten Endes nach Vergebung sehnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
