                                        "glosses": [
                                            "Wissenschaft, die sich mit den Röntgenstrahlen und der Radioaktivität und insbesondere mit deren Anwendungen in der Medizin beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313e9c75-dd56-461d-b9c1-14388057762a",
                                                "sense_id": "dfed8c75-08ab-3880-916c-e2070074afe5",
                                                "text": "Der Radiologe ist der Facharzt der Radiologie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "417744d6-e86d-31e7-90b5-938ac26cd860",
                                        "entry_id": "993c3106-a71d-3280-9fe9-88d7cf6d677d",
                                        "glosses": [
                                            "Abteilung einer Klinik, die Röntgenaufnahmen herstellt und auswertet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a148ea-690e-4179-ac32-d56319e65020",
                                                "sense_id": "417744d6-e86d-31e7-90b5-938ac26cd860",
                                                "text": "Gleich am zweiten Tag meines Klinikaufenthaltes erhielt ich einen Termin in der Radiologie."
                                            },
                                            {
                                                "example_id": "e399325a-1eab-4a0b-b64e-eb50406ce162",
                                                "sense_id": "417744d6-e86d-31e7-90b5-938ac26cd860",
                                                "text": "„Hinter der Radiologie brannten Männer eine Grasfläche nieder.“"
                                            }
