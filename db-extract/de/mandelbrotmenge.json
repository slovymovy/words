                ],
                "senses": [
                    {
                        "sense_id": "e1000238-ca12-36a0-ae8e-bd408dcc33f1",
                        "entry_id": "35f38c12-1cc7-35b1-b5d5-a75656ed88c7",
                        "glosses": [
                            "Menge in der komplexen Ebene, die auf iterativer Berechnung basiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "884da02e-1345-4ffc-bd79-49bae94e7d68",
                                "sense_id": "e1000238-ca12-36a0-ae8e-bd408dcc33f1",
                                "text": "Das heißt, eine komplexe Zahl c ist Element der Mandelbrotmenge 𝕄, wenn die Beträge der mit diesem c berechneten z_n nicht über jede Grenze wachsen, unabhängig davon, wie groß n wird."
                            },
                            {
                                "example_id": "5a202926-a4fb-4b41-a8ed-24cde83b38a9",
                                "sense_id": "e1000238-ca12-36a0-ae8e-bd408dcc33f1",
                                "text": "Die Bezeichnung „Apfelmännchen“ korrespondiert mit der geometrischen Grobform einer um 90 Grad im Uhrzeigersinn gedrehten Mandelbrotmenge."
                            },
                            {
                                "example_id": "1fc65c54-587b-44e3-8592-6baca1dee419",
                                "sense_id": "e1000238-ca12-36a0-ae8e-bd408dcc33f1",
                                "text": "„Färbt man die Menge aller Anfangswerte, die gegen dieselbe Lösung z konvergieren, mit derselben Farbe ein, so ergibt sich ein Fraktal; wählt man die Farben je nach Zahl von Iterationen, die das Verfahren benötigt, um überhaupt zu konvergieren, so ergibt sich die Mandelbrotmenge, ein nunmehr klassisches Fraktal, das auch als Apfelmännchen bekannt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6c2e469-f558-46c1-a2d8-30bc77a4ce9f",
                        "source_entry_id": "35f38c12-1cc7-35b1-b5d5-a75656ed88c7",
                        "source_sense_id": "e1000238-ca12-36a0-ae8e-bd408dcc33f1",
                        "source_sense_description": "Mathematik: Menge in der komplexen Ebene, die auf iterativer Berechnung basiert",
                        "target_lang_word": "Mandelbrot set",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandelbrot set",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b26e5552-5be1-37fd-a4ea-c7331411aa43",
                                        "entry_id": "73a79565-1ab1-349f-8681-4e378f55e542",
                                        "glosses": [
                                            "the set of complex numbers c for which the orbit of 0 under iteration of the complex quadratic polynomial zₙ₊₁ = zₙ² + c remains bounded. The boundary of this set is a fractal."
                                        ],
