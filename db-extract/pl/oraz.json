                                    {
                                        "sense_id": "2133ae23-159d-337e-9924-f9fe86acf3ed",
                                        "entry_id": "3f1da5e2-3303-32dd-b018-2c5f809ef973",
                                        "glosses": [
                                            "před spojkami označujícími důsledek nemá vlastní význam a může být vynecháno"
                                        ],
                                        "tags": [],
