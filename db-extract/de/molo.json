                            {
                                "target_word": "mole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0fb0612-664b-3aaa-93ad-4bc39d692f36",
                                        "entry_id": "1b6d9f4b-87c1-3460-bdf9-bf3f37fc19c5",
                                        "glosses": [
                                            "A massive structure, usually of stone, used as a pier, breakwater or junction between places separated by water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8067224-b363-4f6f-811d-2cae47e204ac",
                                                "sense_id": "a0fb0612-664b-3aaa-93ad-4bc39d692f36",
                                                "text": "[Alexander the Great] then conceived the stupendous idea of constructing a mole, which should at once connect [Tyre] with the main land; and this was actually accomplished by driving piles and pouring in incalculable quantities of soil and fragments of rock; and it is generally believed, partly on the authority of ancient authors, that the whole ruins of Old Tyre were absorbed in this vast enterprize, and buried in the depths of the sea [...]"
                                            },
                                            {
                                                "example_id": "0c32085c-4e54-4480-9e17-785f62194bb6",
                                                "sense_id": "a0fb0612-664b-3aaa-93ad-4bc39d692f36",
                                                "text": "Its extreme downtown is the battery, where that noble mole is washed by waves, and cooled by breezes, which a few hours previous were out of sight of land."
                                            },
                                            {
                                                "example_id": "6350315b-d25f-44f7-8234-63b6aa04874e",
                                                "sense_id": "a0fb0612-664b-3aaa-93ad-4bc39d692f36",
                                                "text": "Using the countless tons of rock from the cliff-face, supplemented by much more from inland, they threw out a huge breakwater, 2,000 ft. long and 80 ft. high, roughly at right angles to the quay, so forming an almost completely sheltered corner. Fifty years later, this massive mole is still standing up to the worst that the Irish Sea can do."
                                            },
                                            {
                                                "example_id": "d863e9c9-07ef-463d-85e2-8173425536c6",
                                                "sense_id": "a0fb0612-664b-3aaa-93ad-4bc39d692f36",
                                                "text": "[about Saint-Tropez] Yachts and fishing boats fill the little square of water, which is surrounded on two sides by quays, on the third by a small ship-repairing yard and on the fourth by the mole where the fishing boats moor and the nets are spread out to dry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ca001f-8016-3217-af30-3dbf1947efb9",
                                        "entry_id": "1b6d9f4b-87c1-3460-bdf9-bf3f37fc19c5",
                                        "glosses": [
                                            "A haven or harbour, protected with such a breakwater."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d1187ab-d596-38e4-9fb2-732093d131ca",
                                        "entry_id": "1b6d9f4b-87c1-3460-bdf9-bf3f37fc19c5",
                                        "glosses": [
                                            "An Ancient Roman mausoleum."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
