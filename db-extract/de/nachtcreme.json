                "senses": [
                    {
                        "sense_id": "26b998f9-300b-3f15-b5ed-ba39d041d59c",
                        "entry_id": "df1da545-d589-387e-9e32-2b30dfbfb440",
                        "glosses": [
                            "Creme für die Hautpflege während der Nachtzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e95ac57-7ea1-47f4-ada3-ff2a4e09487e",
                                "sense_id": "26b998f9-300b-3f15-b5ed-ba39d041d59c",
                                "text": "„Da der Körper während der Nachtstunden auch besonders empfänglich für Pflegestoffe ist, sollten Sie nie ohne Nachtcreme zu Bett gehen.“"
                            },
                            {
                                "example_id": "0cb231d8-b3df-44f0-976d-f493cb347fc3",
                                "sense_id": "26b998f9-300b-3f15-b5ed-ba39d041d59c",
                                "text": "„Für die Herren der Schöpfung tritt Kosmetik jetzt in Pflegephase zwei - mit Nachtcremes, Peelings und Gesichtsmasken.“"
                            },
                            {
                                "example_id": "7044bf52-7202-490c-af76-3cb6187627d2",
                                "sense_id": "26b998f9-300b-3f15-b5ed-ba39d041d59c",
                                "text": "„Nachtcremen sind fettender als Tagescremen, was unsere Haut zu Nutze macht, denn die Zellteilung ist nachts um 8mal schneller als am Tag, die Talgproduktion wird minimiert und die Durchblutung der Haut steigt, somit können mehr Inhaltsstoffe in der Haut aufgenommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
