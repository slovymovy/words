                        "examples": []
                    },
                    {
                        "sense_id": "a4455630-9af4-3035-8422-bdbc0f6db08b",
                        "entry_id": "24e206ec-aba5-3291-93e6-845403728c05",
                        "glosses": [
                            "Relatif à Henri VIII, roi d'Angleterre et d'Irlande."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7012002e-8fa0-41fd-8174-ca937b41a60d",
                                "sense_id": "a4455630-9af4-3035-8422-bdbc0f6db08b",
                                "text": "Ainsi, dans l’Angleterre henricienne, la prédication devient un enjeu politico-religieux tel que le pouvoir royal prend progressivement un contrôle total sur les prêches."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea094dfb-af2e-3f3e-9e68-dd36dda7581c",
                        "entry_id": "24e206ec-aba5-3291-93e6-845403728c05",
                        "glosses": [
                            "Relatif à Henri IV, roi de France et de Navarre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "39f6a60e-6121-44e1-bd37-50b9436dc6bc",
                                "sense_id": "ea094dfb-af2e-3f3e-9e68-dd36dda7581c",
                                "text": "Véritable relique du culte henricien, le berceau-carapace témoigne avec éclat de la singularité de la figure d'Henri IV dans l'histoire de France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0579da6-d2c2-4dcd-8819-fee2bb6c3cd0",
