                                    {
                                        "sense_id": "56028d9b-1728-3b79-ba77-b10410390dfe",
                                        "entry_id": "da6951d9-d3d1-3349-995f-be91d7c46eba",
                                        "glosses": [
                                            "veraltend: trotz einer widersprechenden Sache; obwohl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5693565-a5ef-410f-8c47-6370ebe3d013",
                                                "sense_id": "56028d9b-1728-3b79-ba77-b10410390dfe",
                                                "text": "„Ungeachtet diese Meynung für unsere Geschichte wichtig genug war, um hier mit allen ihren Zitaten abgeschrieben zu werden, so kann ich ihr, trotz dieser Menge von Zeugnissen, doch schlechthin nicht beistimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "ungeachtet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21ef3abb-dd0d-3718-b432-5f14de29411f",
                                        "entry_id": "556c143d-3563-3002-9453-11c8ec020e8d",
                                        "glosses": [
                                            "(eine widersprechende Sache) außer Acht lassend; ohne Rücksicht"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61930d0-48b5-464c-a62a-54091e0879f7",
                                                "sense_id": "21ef3abb-dd0d-3718-b432-5f14de29411f",
                                                "text": "Ungeachtet der letzten Rückschläge gibt er die Hoffnung auf einem Sieg beim Marathon nicht auf."
                                            },
                                            {
                                                "example_id": "10d3f9e6-f351-4512-bd09-50ea97895330",
                                                "sense_id": "21ef3abb-dd0d-3718-b432-5f14de29411f",
                                                "text": "„Jugoslawen […] bezeichnet zum einen Staatsangehörige Jugoslawiens […] ungeachtet ihrer spezifischen ethnischen Identität und zum anderen die der jugoslawischen Ethnie zugehörigen Personen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32d6d839-bbdc-42dd-a892-8539726984b0",
                        "source_entry_id": "b5dea099-b6de-348c-a53d-335d3803759e",
