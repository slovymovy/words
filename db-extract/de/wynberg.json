                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b162691-a6b9-4c67-a2d4-756cc8875ef4",
                                "sense_id": "18f4db1c-7f65-35d1-9ae5-4ffe79095f3b",
                                "text": "„1913 erhielt Wilhelm Verwoerd, der in Wynberg ein kleines Bauunternehmen betrieb, das Angebot, als zeitweilige Aushilfe in der reformierten Mission im rhodesischen Bulawayo tätig zu werden.“"
                            },
                            {
                                "example_id": "a01367aa-55de-4b29-ac1f-55b7bb25545e",
                                "sense_id": "18f4db1c-7f65-35d1-9ae5-4ffe79095f3b",
                                "text": "„Um halb sieben gaben sie die Fahrgestellnummer durch, und Nyathi, Mbali und Griessel saßen vor den Bildschirmen im Kriminal-Informationsdienst und sahen zu, wie der Name des Halters aus der Zulassungsdatenbank gefiltert wurde. Neville Alistair Webb. 55 Jahre alt, Langleystraat in Wynberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
