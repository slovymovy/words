                            },
                            {
                                "target_word": "pocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04e8ad18-3bb6-3818-b3a1-b82d77427811",
                                        "entry_id": "4344881f-e499-3b34-a39f-a8e2ec9a0cc1",
                                        "glosses": [
                                            "To put (something) into a pocket."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd234444-c89f-4c68-87b1-e5a29183de1f",
                                                "sense_id": "04e8ad18-3bb6-3818-b3a1-b82d77427811",
                                                "text": "[Y]ou / Did pocket vp my Letters: and with taunts / Did gibe my Miſive out of audience."
                                            },
                                            {
                                                "example_id": "4034683a-2dd2-4a44-a7ee-6042b0e96c14",
                                                "sense_id": "04e8ad18-3bb6-3818-b3a1-b82d77427811",
                                                "text": "[…] I ſtopt ſhort, and, pocketting my ducats in a great hurry, took out ſome rials, approached the hat, that was expoſed for the reception of charity extorted from chriſtians by fear, and dropt them into it, one after another, that the beggar might ſee how nobly I uſed him."
                                            },
                                            {
                                                "example_id": "f1e6ff68-0dbc-4030-9fb7-7270840529b6",
                                                "sense_id": "04e8ad18-3bb6-3818-b3a1-b82d77427811",
                                                "text": "[M]y lord said that she did not flatter at any rate; and pocketted his snuff-box, not desirous that Madame Brack’s dubious fingers should plunge too frequently into his Mackabaw."
                                            },
                                            {
                                                "example_id": "ed509fb9-5737-44c3-8cf1-2c1c4edf7c20",
                                                "sense_id": "04e8ad18-3bb6-3818-b3a1-b82d77427811",
                                                "text": "She produced a Gillette blade from her coat pocket. / “Where did you get that?” / “Stole it from Mr Taylor!” she said proudly. / “That’s dangerous! You could cut yourself.” / Jemima looked unmoved and pocketted the blade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a1d398b-0efa-3b20-bb9f-994423b85ccc",
                                        "entry_id": "4344881f-e499-3b34-a39f-a8e2ec9a0cc1",
                                        "glosses": [
                                            "To cause a ball to go into one of the pockets of the table; to complete a shot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d917732c-3b57-3212-ac39-eed53ef5e4a7",
                                        "entry_id": "4344881f-e499-3b34-a39f-a8e2ec9a0cc1",
                                        "glosses": [
                                            "To take and keep (something, especially money, that is not one's own)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42528fe0-71bb-46b4-8cdf-79bdd60a4e7d",
                                                "sense_id": "d917732c-3b57-3212-ac39-eed53ef5e4a7",
                                                "text": "The store manager, a woman in her 50s, saw Sasaki pocket the condoms and detained him at the entrance to the store, while another employee called police."
                                            },
                                            {
                                                "example_id": "59f41946-f452-4345-a448-e2acca4d951a",
                                                "sense_id": "d917732c-3b57-3212-ac39-eed53ef5e4a7",
                                                "text": "Record executives pocketed most of the young singer's earnings."
                                            },
                                            {
                                                "example_id": "47a8a0db-92f0-42dc-84c6-4516eb1a52da",
                                                "sense_id": "d917732c-3b57-3212-ac39-eed53ef5e4a7",
                                                "text": "The thief was caught on camera pocketing the diamond."
                                            },
                                            {
                                                "example_id": "e0872539-b38a-4a30-8add-962e4ce51b46",
                                                "sense_id": "d917732c-3b57-3212-ac39-eed53ef5e4a7",
                                                "text": "But, Tom, thy ſelfe art paſt grace; for ſome of thyne owne faction, envying thy proficiencie and honour to which thou aſpireſt, hath pocketted thy grace."
                                            },
                                            {
                                                "example_id": "d465e7bb-85f4-41e5-90f1-77f9ee98b90b",
                                                "sense_id": "d917732c-3b57-3212-ac39-eed53ef5e4a7",
                                                "text": "Under the Shadow GBR, it will be interesting to see how the government resolves the current mismatch whereby the DfT is responsible for spending money, but HM Treasury pockets the cash from train operators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c6d0a4f-7e5a-3d16-927e-eb638f2d6947",
                                        "entry_id": "4344881f-e499-3b34-a39f-a8e2ec9a0cc1",
                                        "glosses": [
                                            "To put up with; to bear without complaint."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191b36a5-fb45-44ea-a371-a730e5c36301",
                                                "sense_id": "6c6d0a4f-7e5a-3d16-927e-eb638f2d6947",
                                                "text": "As long as the house suffered the practice to prevail, they must submit to pocket the insult of being told that it existed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "185a58ef-f368-3e52-8fd9-02c9106d0a6d",
                                        "entry_id": "c66c2d32-6c8a-3c85-b512-214a18784e13",
                                        "glosses": [
                                            "Of a size suitable for putting into a pocket."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f17e02b3-e788-469c-b773-74c22e194c9f",
                                                "sense_id": "185a58ef-f368-3e52-8fd9-02c9106d0a6d",
                                                "text": "a pocket dictionary"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "389a4a33-617c-34f0-8069-4e956a123b36",
                                        "entry_id": "c66c2d32-6c8a-3c85-b512-214a18784e13",
                                        "glosses": [
                                            "Smaller or more compact than usual."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e96c2d-5a6b-4ae0-b0de-2ae43063d48e",
                                                "sense_id": "389a4a33-617c-34f0-8069-4e956a123b36",
                                                "text": "pocket battleship"
                                            },
                                            {
                                                "example_id": "77aabe29-9535-4e60-9fd5-ef27cc84b67c",
                                                "sense_id": "389a4a33-617c-34f0-8069-4e956a123b36",
                                                "text": "pocket beach"
                                            },
                                            {
                                                "example_id": "ead1e549-8f1a-40ae-99ee-16b74b28f516",
                                                "sense_id": "389a4a33-617c-34f0-8069-4e956a123b36",
                                                "text": "She ate, drank, worked, danced, and made love in exactly the same way: con brio. She came into the apartment like a pocket hurricane."
                                            },
                                            {
                                                "example_id": "fa22f1a7-a3d1-48fc-a0da-2e1114dea53e",
                                                "sense_id": "389a4a33-617c-34f0-8069-4e956a123b36",
                                                "text": "“There is never a shortage of pocket [Neville]^([sic]) Chamberlains willing to sacrifice other people’s land for their own peace of mind,” Sikorski said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1002111a-a1dd-3c38-9c84-6d3af4ff26c0",
                                        "entry_id": "c66c2d32-6c8a-3c85-b512-214a18784e13",
                                        "glosses": [
                                            "Belonging to the two initial hole cards."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca661def-2370-4ea2-92e2-eea9324718a0",
                                                "sense_id": "1002111a-a1dd-3c38-9c84-6d3af4ff26c0",
                                                "text": "a pocket pair of kings"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
