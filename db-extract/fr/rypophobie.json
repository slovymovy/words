                    {
                        "sense_id": "8ef716c1-0442-3898-a4c2-60e8e7a31f15",
                        "entry_id": "a13b7845-df26-3696-b82e-e4f52c7f4454",
                        "glosses": [
                            "Peur obsessionnelle et irraisonnée de la souillure, de la saleté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af341b5c-d31a-4040-bc77-0d0849e31d4d",
                                "sense_id": "8ef716c1-0442-3898-a4c2-60e8e7a31f15",
                                "text": "Chez un autre, ce ne sera pas la pour des espaces ou du vide, ce sera la peur de la station assise; la peur de la saleté, la rypophobie ; la crainte d'une erreur dans un calcul ou dans une manipulation de médicaments dangereux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8467bf4-4140-4238-8e9e-39264225d28d",
                        "source_entry_id": "a13b7845-df26-3696-b82e-e4f52c7f4454",
                        "source_sense_id": "8ef716c1-0442-3898-a4c2-60e8e7a31f15",
                        "target_lang_word": "rupophobia",
                        "target_lang_code": "en",
