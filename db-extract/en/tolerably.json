                                        "glosses": [
                                            "D’une manière tolérable, supportable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b064a2ff-a72b-4d07-9c38-f80936a5d4f1",
                                                "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                                                "text": "Un homme qui avait quelque sens et qui raisonnait tolérablement sur d’autres sujets."
                                            },
                                            {
                                                "example_id": "2094dc42-9c18-4224-b657-93519d7412b8",
                                                "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                                                "text": "Êtes-vous tolérablement ici ? Veuillez vous rappeler que vous êtes chez les barbares. Il ne faut pas être difficile en Samogitie."
                                            },
                                            {
                                                "example_id": "af215707-a0cb-47c5-874e-d3884cc2009f",
                                                "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                                                "text": "S’ils [les architectes] construisent un Musée, pensez qu’ils n’oublieront qu’une chose, c’est d’éclairer tolérablement les tableaux."
                                            }
                                        ]
                                    }
                                ]
                            }
