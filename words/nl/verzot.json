                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zich door die vreemde passie helemaal laten <w>verzot</w> maken.",
                            "target_lang_translations": {
