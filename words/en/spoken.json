                    "sense_definition": "The past participle of <w>speak</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>spoken</w> to the manager about the issue.",
