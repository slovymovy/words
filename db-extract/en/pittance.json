                    {
                        "translation_id": "1dcc2bb4-dad4-4bae-802f-a116a5a4fef3",
                        "source_entry_id": "a637121b-2925-315d-b5f1-d744733c432a",
                        "source_sense_description": "a small amount",
                        "target_lang_word": "Almosen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Almosen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                        "entry_id": "bfcdc966-af6f-3383-9d45-23c7b71c10c3",
                                        "glosses": [
                                            "kleine materielle Unterstützung für eine bedürftige Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf38c9a-ddf2-44ab-b315-dec1e6ca063c",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "Sie gab dem Bettler ein Almosen."
                                            },
                                            {
                                                "example_id": "dac64a99-bd5d-43ac-934d-cd5ca0236bb7",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Das wird mit den auf Almosen zielenden Legenden, von denen die Chroniken Kenntnis geben, nicht anders gewesen sein.“"
                                            },
                                            {
                                                "example_id": "0123573e-a99e-4226-8e88-334d0b2ce7c6",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Der einzige Unterschied besteht darin, dass Lwandle heute kein Lager für überarbeitete Männer mehr ist, sondern arbeitslose Familien beherbergt, die sich mit Almosen und Hilfsarbeiten über Wasser halten.“"
                                            },
                                            {
                                                "example_id": "1b5d34da-0f6d-4f77-bcdd-7515e4157da6",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Im frommen Nandgaon fand Tilak gute Bedingungen für seinen Plan, ein Sannyasin zu werden, welcher der Welt und allen Besitztümern entsagt, meditiert und sich ausschließlich von Almosen ernährt.“"
                                            },
                                            {
                                                "example_id": "5ecfa33b-1b79-4e45-93c7-abfe2eaae833",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Eine Woche später reiste Pierre, nachdem er von den Maurern als seinen neuen Freunden Abschied genommen und ihnen einen grösseren Geldbetrag für Almosen übergeben hatte, auf seine Güter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ae4f192-366d-3dda-b03a-a668b8add6b4",
                                        "entry_id": "bfcdc966-af6f-3383-9d45-23c7b71c10c3",
                                        "glosses": [
                                            "Entgelt für eine Leistung, das als zu niedrig/ungerecht empfunden wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc6fbd6-5351-435e-a3e7-a127f447d2d0",
                                                "sense_id": "6ae4f192-366d-3dda-b03a-a668b8add6b4",
                                                "text": "Die Bezahlung war nicht mehr als ein Almosen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
