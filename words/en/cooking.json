                    "sense_definition": "The present participle and gerund of <w>cook</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>cooking</w> dinner in the kitchen right now.",
                            "target_lang_translations": {
                                "ru": "Она сейчас <w>готовит</w> ужин на кухне."
