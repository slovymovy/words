                "senses": [
                    {
                        "sense_id": "6ba364f0-a6c7-3c8e-af76-68a7b4e7bcc9",
                        "entry_id": "e96ea057-ea1b-34ef-b523-082214bf30cb",
                        "glosses": [
                            "Plat italien à base de riz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f852aedc-6443-4b24-8972-ab4f2b98a115",
                                "sense_id": "6ba364f0-a6c7-3c8e-af76-68a7b4e7bcc9",
                                "text": "Ils mangèrent à l’italienne. Sur le menu, soupe à la Corneille, ravioli, macaroni, rizotto, et poletto."
                            },
                            {
                                "example_id": "52cb93ed-234e-45f9-ae61-97c78df5c84b",
                                "sense_id": "6ba364f0-a6c7-3c8e-af76-68a7b4e7bcc9",
                                "text": "« J’adore cuisiner des pâtes aux rizottos, je n’arrête pas et surtout j’aime recevoir des amis », dit-elle avec un rire enjôleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d52d07e2-c265-4dce-be55-f4dbf49866f3",
                        "source_entry_id": "e96ea057-ea1b-34ef-b523-082214bf30cb",
                        "source_sense_id": "6ba364f0-a6c7-3c8e-af76-68a7b4e7bcc9",
                        "target_lang_word": "Risotto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Risotto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                        "entry_id": "8d24b096-b88a-3b2b-93c4-a8a802c945d9",
                                        "glosses": [
                                            "norditalienisches Gericht mit vielen Variationen, bei dem Rundkornreis zumeist mit Zwiebeln in Fett angedünstet wird und anschließend Brühe hinzugegeben wird, die der Reis aufnimmt; weitere Zutaten sind vielfach Weißwein, Pilze, Tomaten und Parmesan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3967cb0a-91da-4dac-a1c8-d43198c34db7",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Man könnte meinen, mit den Roten Beten, die heute für ein Risotto verarbeitet werden sollen, auf der sicheren Seite zu sein. Aber: Die Roten Bete müssen 90 Minuten oder länger in Wasser köcheln, bis sie gar sind.“"
                                            },
                                            {
                                                "example_id": "08564ef6-0b0a-4556-b0ef-3b732b458ab4",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Ich fuhr kürzlich durch die Po-Ebene, die immerhin den Risotto, den Belcanto und den Grappa hervorgebracht hat, unter anderem durch Seveso, und alles sah aus wie im Rhein-Main-Gebiet.“"
                                            },
                                            {
                                                "example_id": "032e0fb0-aab2-4ffe-af3e-ad371d9c6e24",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Und genau in diesem Spiel der beiden Stärkesorten liegen Segen und Fluch des Risottos, denn das sich absetzende Amylopektin brennt ruckzuck am Topfboden an.“"
                                            },
                                            {
                                                "example_id": "38b6d7bc-37ac-414d-8a92-b0959dea55e3",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Ein richtiger Risotto müsse eben mit Olivenöl durchtränkt sein, stark duften und jede Menge Safran oder Knoblauch vertragen.“"
                                            },
                                            {
                                                "example_id": "96cb5b4c-2033-42e4-af6e-b4a9eb03a272",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Das süße Risotto findet sich überall in Italien auf den Familientischen, meist klassisch mit Milch und frischer Vanille gekocht, schnell und einfach mit gemischten Früchten, Macadamianüssen oder Maronencreme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d32737f-51fd-4c9b-a80d-72606f4d59da",
                        "source_entry_id": "e96ea057-ea1b-34ef-b523-082214bf30cb",
                        "source_sense_id": "6ba364f0-a6c7-3c8e-af76-68a7b4e7bcc9",
                        "target_lang_word": "risotto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "risotto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                        "entry_id": "7e1ca8cb-5d72-3b10-bd6b-53abbffe5319",
                                        "glosses": [
                                            "An Italian savoury dish made with rice and other ingredients."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe0847a-6805-4653-bf8d-273215fba1bf",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "The secret to a creamy risotto is letting the rice absorb one cup of broth at a time."
                                            },
                                            {
                                                "example_id": "032dba73-8de7-40cd-ba36-b25867be0d21",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "Risotti are another Alvaro passion, and there’s a different special each week, as well as a legendary strawberry risotto in season."
                                            },
                                            {
                                                "example_id": "d70eac5c-27aa-4df4-bc75-9daa063c6bfa",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "Risotti are made with fat, short-grain rice; […]"
                                            },
                                            {
                                                "example_id": "ef5838b4-e399-4817-9cd7-480bd10fe4b1",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "This is one of the biggest chapters in this book because there are just so many vegetables that marry well with rice to make fantastic risotti!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e08aff2e-d607-36d1-a63e-5fc0f740b790",
                                        "entry_id": "7e1ca8cb-5d72-3b10-bd6b-53abbffe5319",
                                        "glosses": [
                                            "A similar dish made without rice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb7498d-6639-420d-8f0b-a799ed9f1dd8",
                                                "sense_id": "e08aff2e-d607-36d1-a63e-5fc0f740b790",
                                                "text": "a pearl barley risotto"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
