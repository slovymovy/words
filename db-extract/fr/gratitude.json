                                                "sense_id": "096364ed-54c8-35c2-a8cd-b4a6387ec778",
                                                "text": "She showed deep gratitude for the support she received."
                                            },
                                            {
                                                "example_id": "a9a3917c-a9d0-4953-be89-fc5c5a67a6b5",
                                                "sense_id": "096364ed-54c8-35c2-a8cd-b4a6387ec778",
                                                "text": "He bowed his head in gratitude to the donors."
                                            },
                                            {
                                                "example_id": "561e0858-8fc8-4b3e-86e6-48545babe86c",
                                                "sense_id": "096364ed-54c8-35c2-a8cd-b4a6387ec778",
                                                "text": "Words cannot express my gratitude for your kindness."
                                            },
                                            {
                                                "example_id": "d30955cf-43a3-4855-9a90-d36177490e6a",
                                                "sense_id": "096364ed-54c8-35c2-a8cd-b4a6387ec778",
                                                "text": "She felt overwhelming gratitude towards her parents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
