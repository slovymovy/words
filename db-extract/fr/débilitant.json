                        "entry_id": "e0d24555-5aaf-30d7-be7e-8fd50bf015e6",
                        "glosses": [
                            "Remède propre à débiliter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb20fa6e-f796-4dd0-8657-7bd00e9b2a0f",
                                "sense_id": "bf0e5dae-ec12-3950-94cd-b5ff9442c8e6",
                                "text": "Mais lorsqu’il est porté ou continué au delà de ce point, il diminue l’énergie vitale et devient un débilitant, et il provoque l’action de résistance après que les forces sont diminuées."
                            }
                        ]
                    }
