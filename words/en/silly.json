    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "714b50ad-24db-37ec-9b48-d7b2a81a4256",
                    "sense_definition": "Laughable or amusing through foolishness or a playful appearance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were laughing at a <w>silly</w> joke during the party.",
                            "target_lang_translations": {
                                "ru": "Дети смеялись над <w>глупой</w> шуткой во время праздника.",
                                "tr": "Çocuklar parti sırasında <w>komik</w> bir şakaya gülüyorlardı.",
                                "de": "Die Kinder lachten während der Party über einen <w>albernen</w> Witz."
                            }
                        },
                        {
                            "text": "He had a <w>silly</w> grin on his face after winning the game.",
                            "target_lang_translations": {
                                "ru": "После победы в игре на его лице была <w>дурашливая</w> ухмылка.",
                                "tr": "Oyunu kazandıktan sonra yüzünde <w>şapşal</w> bir sırıtış vardı.",
                                "de": "Nachdem er das Spiel gewonnen hatte, hatte er ein <w>albernes</w> Grinsen im Gesicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "charming"
                    ],
                    "common_phrases": [
                        "silly joke",
                        "silly grin",
                        "silly walk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешной или забавный из-за глупости или игривого вида.",
                        "tr": "Aptalca veya oyuncu bir görünümle komik veya eğlenceli olan.",
                        "de": "Lustig oder amüsant aufgrund von Albernheit oder einem verspielten Auftreten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "в значении забавный или несерьезный"
                            },
                            {
                                "target_lang_word": "дурашливый",
                                "target_lang_sense_clarification": "склонный к шуткам и забавам"
                            },
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "вызывающий смех своим видом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şapşal",
