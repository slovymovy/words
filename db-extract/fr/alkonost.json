                        "examples": [
                            {
                                "example_id": "cf34cdcc-10ce-4581-989f-8be84ec788bc",
                                "sense_id": "45dfa2b0-fccf-3273-a0f0-7d99623c0720",
                                "text": "Les oiseaux paradisiaques aux visages de femmes - le Sirine et l’Alkonost - chantent aux faîtes des clochers."
                            },
                            {
                                "example_id": "21d109db-7f20-4912-a70e-3ceb8af13c70",
                                "sense_id": "45dfa2b0-fccf-3273-a0f0-7d99623c0720",
                                "text": "Tout cela rappelait Vroubel, la Bible, l’oiseau Alkonost."
                            },
                            {
                                "example_id": "6b131a7f-440b-440a-a2c5-12688caec2f9",
                                "sense_id": "45dfa2b0-fccf-3273-a0f0-7d99623c0720",
                                "text": "La figure de la Femme-Oiseau apparaît dans de nombreux mythes, dans diverses cultures. Elle est connue sous le nom de Sirène, Harpie, Phoenix, Gamaïun, Oiseau de Feu, Kimnara, Alkonost."
