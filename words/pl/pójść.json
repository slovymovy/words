    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a0a7668-6e63-31c8-a13d-65fdbd25d588",
                    "sense_definition": "udać się gdzieś pieszo; zacząć iść",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę już <w>pójść</w> do domu, bo robi się bardzo późno.",
                            "target_lang_translations": {
                                "ru": "Мне уже пора <w>пойти</w> домой, потому что становится очень поздно.",
                                "en": "I have to <w>go</w> home now because it is getting very late."
                            }
                        },
                        {
                            "text": "Zdecydowaliśmy <w>pójść</w> pieszo do parku, żeby cieszyć się ładną pogodą.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>пойти</w> пешком в парк, чтобы насладиться хорошей погодой.",
                                "en": "We decided to <w>walk</w> to the park to enjoy the nice weather."
                            }
                        }
                    ],
                    "synonyms": [
                        "podążyć"
                    ],
                    "common_phrases": [
                        "pójść pieszo",
                        "pójść do domu"
                    ],
                    "target_lang_definitions": {
                        "ru": "отправиться куда-либо пешком; начать идти",
                        "en": "to go somewhere on foot; to start walking"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пойти",
                                "target_lang_sense_clarification": "начать движение пешком"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "туда и обратно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to move or travel to a place"
                            },
                            {
                                "target_lang_word": "walk",
                                "target_lang_sense_clarification": "to go on foot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bfffc82-9af0-3c5d-aaf1-b66d51cd455a",
                    "sense_definition": "zacząć uczęszczać do jakiejś szkoły, instytucji lub brać udział w wydarzeniu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uczestnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój syn ma już siedem lat i musi <w>pójść</w> do szkoły.",
                            "target_lang_translations": {
                                "ru": "Моему сыну уже семь лет, и он должен <w>пойти</w> в школу.",
                                "en": "My son is already seven years old and must <w>go</w> to school."
                            }
                        },
                        {
                            "text": "Chętnie zdecydowałbym się <w>pójść</w> na studia medyczne, gdybym miał lepsze oceny.",
                            "target_lang_translations": {
                                "ru": "Я бы с удовольствием решил <w>поступить</w> в медицинский институт, если бы у меня были оценки получше.",
                                "en": "I would gladly choose to <w>go</w> to medical school if I had better grades."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pójść do szkoły",
                        "pójść na studia",
                        "pójść do pracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "начать посещать школу, учебное заведение или принять участие в мероприятии",
                        "en": "to start attending a school, institution, or to participate in an event"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пойти",
                                "target_lang_sense_clarification": "в школу, в университет, на работу"
                            },
                            {
                                "target_lang_word": "поступить",
                                "target_lang_sense_clarification": "в учебное заведение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to attend an institution or school"
                            },
                            {
                                "target_lang_word": "join",
                                "target_lang_sense_clarification": "to become a member of"
                            },
                            {
                                "target_lang_word": "enter",
                                "target_lang_sense_clarification": "to start at a school or university"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56855910-3249-3049-be2a-c9dde45aea13",
                    "sense_definition": "potoczyć się, przebiegać w określony sposób",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "przebieg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszystko <w>poszło</w> zgodnie z planem i bez żadnych problemów.",
                            "target_lang_translations": {
                                "ru": "Всё <w>пошло</w> по плану и без каких-либо проблем.",
                                "en": "Everything <w>went</w> according to plan and without any problems."
                            }
                        },
                        {
                            "text": "Egzaminy <w>poszły</w> bardzo dobrze, więc wszyscy świętowali.",
                            "target_lang_translations": {
                                "ru": "Экзамены <w>прошли</w> очень хорошо, поэтому все праздновали.",
                                "en": "The exams <w>went</w> very well, so everyone celebrated."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pójść dobrze",
                        "pójść źle",
                        "pójść zgodnie z planem"
                    ],
                    "target_lang_definitions": {
                        "ru": "пойти, развиваться определенным образом (о делах, событиях)",
                        "en": "to turn out, proceed, or progress in a certain way"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пойти",
                                "target_lang_sense_clarification": "о делах, процессах"
                            },
                            {
                                "target_lang_word": "пройти",
                                "target_lang_sense_clarification": "совершиться каким-либо образом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to proceed or turn out in a specified manner"
                            },
                            {
                                "target_lang_word": "go off",
                                "target_lang_sense_clarification": "to happen or proceed in a particular way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77de947d-db18-32cf-812d-e554c06dc420",
                    "sense_definition": "opuścić jakieś miejsce, oddalić się skądś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goście już <w>poszli</w>, więc możemy wreszcie posprzątać salon.",
                            "target_lang_translations": {
                                "ru": "Гости уже <w>ушли</w>, так что мы можем наконец прибраться в гостиной.",
                                "en": "The guests have already <w>left</w>, so we can finally clean the living room."
                            }
                        },
                        {
                            "text": "Nagle wstał od stołu i <w>poszedł</w> bez słowa pożegnania.",
                            "target_lang_translations": {
                                "ru": "Вдруг он встал из-за стола и <w>ушёл</w> без единого слова на прощание.",
                                "en": "Suddenly he stood up from the table and <w>went</w> away without a word of goodbye."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyjść"
                    ],
                    "common_phrases": [
                        "pójść sobie"
                    ],
                    "target_lang_definitions": {
                        "ru": "покинуть какое-либо место, удалиться",
                        "en": "to leave a place, to depart"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уйти",
                                "target_lang_sense_clarification": "покинуть место"
                            },
                            {
                                "target_lang_word": "разойтись",
                                "target_lang_sense_clarification": "о гостях, толпе"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to leave or depart"
                            },
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to depart from a place"
                            },
                            {
                                "target_lang_word": "go away",
                                "target_lang_sense_clarification": "to leave a person or place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01d8b713-2444-35f4-aec7-c2438c69bed5",
                    "sense_definition": "o urządzeniach, instalacjach lub przedmiotach: ulec uszkodzeniu, zepsuć się lub pęknąć",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas burzy <w>poszła</w> faza i musieliśmy czekać na elektryka.",
                            "target_lang_translations": {
                                "ru": "Во время грозы <w>выбило</w> фазу, и нам пришлось ждать электрика.",
                                "en": "During the storm, the phase <w>blew</w> and we had to wait for an electrician."
                            }
                        },
                        {
                            "text": "Niestety, w moim starym samochodzie <w>poszła</w> uszczelka pod głowicą.",
                            "target_lang_translations": {
                                "ru": "К сожалению, в моей старой машине <w>полетела</w> прокладка головки блока цилиндров.",
                                "en": "Unfortunately, the head gasket <w>went</w> in my old car."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poszła faza",
                        "poszła bezpiecznik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w odniesieniu do awarii"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "о приборах, деталях: сломаться, выйти из строя, лопнуть",
                        "en": "of devices, installations, or objects: to break down, fail, or burst"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полететь",
                                "target_lang_sense_clarification": "разг., сломаться, перегореть"
                            },
                            {
                                "target_lang_word": "сгореть",
                                "target_lang_sense_clarification": "о предохранителе, фазе"
                            },
                            {
                                "target_lang_word": "лопнуть",
                                "target_lang_sense_clarification": "о прокладке, трубе"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to break down or fail"
                            },
                            {
                                "target_lang_word": "break down",
                                "target_lang_sense_clarification": "to stop functioning"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "of a fuse or electrical component: to fail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fadfa75c-c572-39cb-bf47-697fa449f921",
                    "sense_definition": "zostać szybko sprzedanym lub rozprowadzonym",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sprzedaż",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Te nowe książki <w>poszły</w> jak świeże bułeczki już pierwszego dnia.",
                            "target_lang_translations": {
                                "ru": "Эти новые книги <w>разошлись</w> как горячие пирожки в первый же день.",
                                "en": "These new books <w>went</w> like hot cakes on the very first day."
                            }
                        },
                        {
                            "text": "Wszystkie bilety na koncert <w>poszły</w> w zaledwie kilka minut.",
                            "target_lang_translations": {
                                "ru": "Все билеты на концерт <w>ушли</w> всего за несколько минут.",
                                "en": "All the tickets for the concert <w>were gone</w> in just a few minutes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pójść jak świeże bułeczki"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w kontekście handlowym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро распродаться или разойтись",
                        "en": "to be sold or distributed quickly"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разойтись",
                                "target_lang_sense_clarification": "о товарах, билетах"
                            },
                            {
                                "target_lang_word": "уйти",
                                "target_lang_sense_clarification": "быть проданным"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to be sold"
                            },
                            {
                                "target_lang_word": "sell",
                                "target_lang_sense_clarification": "to be purchased quickly"
                            }
                        ]
                    }
                }
            ]
        }
