                "senses": [
                    {
                        "sense_id": "46c19ab2-cf49-36ef-9334-e6564e03512a",
                        "entry_id": "48f6ad45-8ded-3f71-b85a-4d76db940727",
                        "glosses": [
                            "Enlever d’un carton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13b5625-2446-4af8-9ffd-b7a50933cd1d",
                                "sense_id": "46c19ab2-cf49-36ef-9334-e6564e03512a",
                                "text": "Alors, voilà, aujourd'hui, assise derrière mon bureau fraichement désencartonné (et ça, ça fait du bien) et mon écran enfin branché, je vous livre une recette qui, il y a peu, a fait un carton."
                            },
                            {
                                "example_id": "32761b16-353d-41c6-9e75-89872c771449",
                                "sense_id": "46c19ab2-cf49-36ef-9334-e6564e03512a",
                                "text": "Mais en fait, ce n'est pas fini : à l'arrivée, il faut désencartonner, désensacher, détrier..."
                            },
                            {
                                "example_id": "bac17ddc-f8b2-4556-b0b8-eb271ca7c07c",
                                "sense_id": "46c19ab2-cf49-36ef-9334-e6564e03512a",
                                "text": "#Mardi prochain, va falloir #désencartonner..."
                            }
                        ]
                    }
