                "senses": [
                    {
                        "sense_id": "a74b8490-2c04-3110-805d-e3b306aa1d63",
                        "entry_id": "ceee82e9-0b9e-392c-ab17-3824985be437",
                        "glosses": [
                            "samodzielna grupa pracujących wspólnie robotników, rzemieślników lub myśliwych w Rosji i krajach postrosyjskich"
                        ],
                        "tags": [],
