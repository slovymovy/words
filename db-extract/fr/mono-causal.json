                        "glosses": [
                            "Variante orthographique de monocausal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df610b0-7530-4bab-880a-4af08a2ab216",
                                "sense_id": "1d77e158-6efc-3220-94db-20e23458c440",
                                "text": "Dans cette perspective mono-causale, l’ordre politique suit une seule logique : si les migrants sont tenus pour responsables de tous nos maux, alors quoi de plus logique que de s’en débarrasser ?"
                            },
                            {
                                "example_id": "2b1c2fa9-374d-49b8-959b-07c28dee9e18",
                                "sense_id": "1d77e158-6efc-3220-94db-20e23458c440",
                                "text": "Bien souvent, derrière les déterminants ponctuels et/ou apparents se dissimulent les raisons profondes du déclin de l’exploitation. De ce fait, la défaillance est rarement mono-causale dans un environnement donné."
                            }
                        ]
                    }
