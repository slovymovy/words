                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ef083f-04cd-4b66-8691-fe45b48c9e66",
                                "sense_id": "1ccd051e-dfa9-39e8-9146-008250fc7a14",
                                "text": "Trou, toile, cercueil, hutteau, sont les mots qui reviennent le plus fréquemment en matière d’installations mobiles."
                            },
                            {
                                "example_id": "0de7d0b7-066b-4973-9ac1-58b6dc4a47df",
                                "sense_id": "1ccd051e-dfa9-39e8-9146-008250fc7a14",
                                "text": "Cette amorce perfide [des canards en bois] est souvent compliquée d’un appeleur, et les hutteaux d’affût s’échelonnent sur le rivage."
                            }
                        ]
