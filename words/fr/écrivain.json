                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À bord du bâtiment, l'<w>écrivain</w> consignait scrupuleusement les comptes et l'état des provisions."
