                                    {
                                        "sense_id": "281fb302-5cba-3cdb-80e0-b3bfc0abe081",
                                        "entry_id": "1fd6b860-302b-3a91-bd76-cfaef1280d65",
                                        "glosses": [
                                            "klares bis in allen Farben vorkommendes Mineral, das als Schmuckstein verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0841a42-c288-4d7b-bac2-e7d02e70ed6f",
                                                "sense_id": "281fb302-5cba-3cdb-80e0-b3bfc0abe081",
                                                "text": "„Um den Hals trug sie eine schlichte goldene Gliederkette, am Ringfinger einen großen Topas.“"
                                            }
