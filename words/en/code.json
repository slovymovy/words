    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e2fccef-fc6b-3638-bb04-2d00a100ed40",
                    "sense_definition": "A sequence of numbers, letters, or symbols used to identify something, gain access, or represent a specific item.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please enter your four-digit access <w>code</w> to unlock the door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, введите ваш четырехзначный <w>код</w> доступа, чтобы открыть дверь.",
                                "tr": "Kapının kilidini açmak için lütfen dört haneli erişim <w>kodunuzu</w> girin.",
                                "zh": "请输入四位数的访问<w>密码</w>来开门。"
                            }
                        },
                        {
                            "text": "Do you know the area <w>code</w> for this part of the city?",
                            "target_lang_translations": {
                                "ru": "Вы знаете телефонный <w>код</w> этой части города?",
                                "tr": "Şehrin bu bölgesinin alan <w>kodunu</w> biliyor musunuz?",
                                "zh": "你知道这个城区的电话<w>区号</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "number",
                        "ID"
                    ],
                    "common_phrases": [
                        "zip code",
                        "area code",
                        "bar code",
                        "access code",
                        "country code"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность цифр, букв или символов, используемая для идентификации чего-либо, получения доступа или обозначения конкретного предмета.",
                        "tr": "Bir şeyi tanımlamak, erişim sağlamak veya belirli bir öğeyi temsil etmek için kullanılan sayı, harf veya sembol dizisi.",
                        "zh": "用于识别、获取访问权限或代表特定项目的数字、字母或符号序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "код",
                                "target_lang_sense_clarification": "для доступа или идентификации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kod",
                                "target_lang_sense_clarification": "erişim veya kimlik belirleme için"
                            },
                            {
                                "target_lang_word": "şifre",
                                "target_lang_sense_clarification": "giriş veya erişim için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代码",
                                "target_lang_sense_clarification": "用于识别或访问的序列"
                            },
                            {
                                "target_lang_word": "密码",
                                "target_lang_sense_clarification": "用于获取访问权限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c4cec21-59e2-3600-ab0e-a6bfc15891a7",
                    "sense_definition": "Instructions for a computer written in a programming language.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the whole weekend writing <w>code</w> for her new mobile application.",
                            "target_lang_translations": {
                                "ru": "Она провела все выходные, создавая <w>код</w> для своего нового мобильного приложения.",
                                "tr": "Tüm hafta sonunu yeni mobil uygulaması için <w>kod</w> yazarak geçirdi.",
                                "zh": "她整个周末都在为她的新手机应用写<w>代码</w>。"
                            }
                        },
                        {
                            "text": "The programmer checked the source <w>code</w> to find the error.",
                            "target_lang_translations": {
                                "ru": "Программист проверил исходный <w>код</w>, чтобы найти ошибку.",
                                "tr": "Programcı hatayı bulmak için kaynak <w>kodunu</w> kontrol etti.",
                                "zh": "程序员检查了<w>源代码</w>以查找错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "program",
                        "script"
                    ],
                    "common_phrases": [
                        "source code",
                        "machine code",
                        "write code",
                        "binary code"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструкции для компьютера, написанные на языке программирования.",
                        "tr": "Bir programlama dilinde yazılmış bilgisayar talimatları.",
                        "zh": "用编程语言编写的计算机指令。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "код",
                                "target_lang_sense_clarification": "программа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kod",
                                "target_lang_sense_clarification": "yazılım veya program komutları"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代码",
                                "target_lang_sense_clarification": "计算机程序指令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49da9dc3-eda8-3701-8da6-ced193e20657",
                    "sense_definition": "A set of rules, laws, or principles that govern behavior or a specific subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school has a strict dress <w>code</w> that all students must follow.",
                            "target_lang_translations": {
                                "ru": "В школе действует строгий дресс-<w>код</w>, которому должны следовать все ученики.",
                                "tr": "Okulun tüm öğrencilerin uyması gereken katı bir kılık kıyafet <w>kuralı</w> vardır.",
                                "zh": "学校有严格的着装<w>规定</w>，所有学生都必须遵守。"
                            }
                        },
                        {
                            "text": "Doctors must adhere to a professional <w>code</w> of ethics when treating patients.",
                            "target_lang_translations": {
                                "ru": "Врачи должны придерживаться профессионального <w>кодекса</w> этики при лечении пациентов.",
                                "tr": "Doktorlar hastaları tedavi ederken mesleki etik <w>kurallarına</w> uymalıdır.",
                                "zh": "医生在治疗病人时必须遵守职业道德<w>准则</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rules",
                        "regulations",
                        "laws"
                    ],
                    "common_phrases": [
                        "dress code",
                        "code of conduct",
                        "penal code",
                        "moral code"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свод правил, законов или принципов, регулирующих поведение или определенную область.",
                        "tr": "Davranışları veya belirli bir konuyu düzenleyen kurallar, yasalar veya ilkeler bütünü.",
                        "zh": "规范行为或特定主题的一套规则、法律或原则。"
                    },
                    "translations": {
                        "ru": [
