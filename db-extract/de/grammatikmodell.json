                "senses": [
                    {
                        "sense_id": "c42c0600-8719-3762-a1fa-7d6d19db7651",
                        "entry_id": "bebe4549-4d41-3187-af1f-f86383233786",
                        "glosses": [
                            "durch bestimmte Annahmen/Entscheidungen begründete Form einer Grammatik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d2f1c3-1a90-4b81-8f9f-816126228f43",
                                "sense_id": "c42c0600-8719-3762-a1fa-7d6d19db7651",
                                "text": "„Bei den derzeit konkurrierenden Grammatikmodellen stellt sich die Frage, welches für eine historische Morphologie das geeignetste ist.“"
                            },
                            {
                                "example_id": "691cfe0e-75a6-4a23-b950-dfdeac181a6d",
                                "sense_id": "c42c0600-8719-3762-a1fa-7d6d19db7651",
                                "text": "„Die Anwendung quantitativer Methoden ist nicht an ein bestimmtes Grammatikmodell gekoppelt, sei es die traditionelle Grammatik, der Strukturalismus oder die Generative Grammatik.“"
                            },
                            {
                                "example_id": "32e051ee-7477-448e-882f-297ae13abeb4",
                                "sense_id": "c42c0600-8719-3762-a1fa-7d6d19db7651",
                                "text": "„Einen sehr guten Einstieg in das Studium der Dependenz ermöglicht das Grammatikmodell Lucien Tesnières.“"
                            },
                            {
                                "example_id": "220b048b-d759-4be7-8886-a082d23b5dc6",
                                "sense_id": "c42c0600-8719-3762-a1fa-7d6d19db7651",
                                "text": "„Damit einher geht die Formulierung von verschiedenen Grammatikmodellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
