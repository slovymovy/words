                        "examples": [
                            {
                                "example_id": "4fb71295-1a84-457a-8467-68f0c9b432e9",
                                "sense_id": "1a52bca3-9db7-36be-a2c2-b1daa59b1c27",
                                "text": "Phacelia wordt gebruikt voor groenbemesting. Een voordeel van phacelia boven Italiaans raaigras is, dat er geen emelten in voorkomen, die veel schade aan het volggewas zouden kunnen veroorzaken."
                            },
                            {
                                "example_id": "dba88aef-76de-4108-9f49-4b88295bbb62",
                                "sense_id": "1a52bca3-9db7-36be-a2c2-b1daa59b1c27",
                                "text": "De vaste lupine wordt als groenbemester en voor veevoer gebruikt. Vaste lupine kan met hulp van symbiontische bacteriën (Rhizobium) stikstof uit de lucht binden in stikstofwortelknolletjes. Na onderwerking wordt het stikstofgehalte van de grond verhoogd. Lupinen wortelen bovendien erg diep, waardoor de ondergrond makkelijker toegankelijk wordt voor een volggewas."
                            }
                        ]
