{
    "word_family": [
        "insolent",
        "insolently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04070f9a-df2c-3f77-9e3f-fd08acdfec37",
                    "sense_definition": "Rude, disrespectful, or arrogant behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher would not tolerate such <w>insolence</w> from any student in her classroom.",
                            "target_lang_translations": {
                                "de": "Die Lehrerin würde eine solche <w>Frechheit</w> von keinem Schüler in ihrem Klassenzimmer dulden.",
                                "ru": "Учительница не стала бы терпеть подобную <w>дерзость</w> ни от одного ученика в своём классе."
                            }
                        },
                        {
                            "text": "His <w>insolence</w> toward his superiors eventually led to his dismissal from the company.",
                            "target_lang_translations": {
                                "de": "Seine <w>Unverschämtheit</w> gegenüber seinen Vorgesetzten führte schließlich zu seiner Entlassung aus der Firma.",
                                "ru": "Его <w>наглость</w> по отношению к руководству в итоге привела к увольнению из компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrogance",
                        "impertinence",
                        "rudeness"
                    ],
                    "antonyms": [
                        "politeness",
                        "respect"
                    ],
                    "common_phrases": [
                        "pure insolence",
                        "sheer insolence"
                    ],
                    "target_lang_definitions": {
                        "de": "Unverschämtes, respektloses oder arrogantes Verhalten.",
                        "ru": "Грубое, неуважительное или высокомерное поведение."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Frechheit",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für respektloses oder dreistes Verhalten."
                            },
                            {
                                "target_lang_word": "Unverschämtheit",
                                "target_lang_sense_clarification": "Betont die Ungehörigkeit und den Mangel an Anstand."
                            },
                            {
                                "target_lang_word": "Dreistigkeit",
                                "target_lang_sense_clarification": "Betont die Kühnheit und Rücksichtslosigkeit des Verhaltens."
                            },
                            {
                                "target_lang_word": "Insolenz",
                                "target_lang_sense_clarification": "Gehobener, formeller Begriff für anmaßendes oder unverschämtes Auftreten."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дерзость",
                                "target_lang_sense_clarification": "непочтительное, вызывающее поведение"
                            },
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "бесстыдное, вызывающее поведение"
                            },
                            {
                                "target_lang_word": "нахальство",
                                "target_lang_sense_clarification": "беспардонная грубость и бесцеремонность"
                            },
                            {
                                "target_lang_word": "высокомерие",
                                "target_lang_sense_clarification": "пренебрежительное, надменное отношение к другим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aadb726f-4972-3a4c-a5ac-1103977028db",
                    "sense_definition": "An act of insulting or offensive treatment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffered many <w>insolences</w> while held captive by the enemy soldiers.",
                            "target_lang_translations": {
                                "de": "Er musste viele <w>Beleidigungen</w> ertragen, während er von den feindlichen Soldaten gefangen gehalten wurde.",
                                "ru": "Он снёс немало <w>оскорблений</w>, пока находился в плену у вражеских солдат."
                            }
                        },
                        {
                            "text": "The crowd shouted various <w>insolences</w> at the politician during the protest.",
                            "target_lang_translations": {
                                "de": "Die Menge rief dem Politiker während des Protests verschiedene <w>Beleidigungen</w> zu.",
                                "ru": "Во время протеста толпа выкрикивала политику различные <w>оскорбления</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "affront"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Handlung, die als beleidigend oder kränkend empfunden wird.",
                        "ru": "Оскорбительный поступок или высказывание."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beleidigung",
                                "target_lang_sense_clarification": "Eine direkte verbale oder tätliche Herabsetzung."
                            },
                            {
                                "target_lang_word": "Kränkung",
                                "target_lang_sense_clarification": "Eine Handlung, die das Gefühl oder die Ehre einer Person verletzt."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "действие или слово, унижающее достоинство"
                            },
                            {
                                "target_lang_word": "дерзость",
                                "target_lang_sense_clarification": "дерзкий, непочтительный поступок или выпад"
                            },
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "нанесённое оскорбление или несправедливость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c26f04d1-1961-383e-9449-01a2ad20f00f",
                    "sense_definition": "The quality of being unusual, novel, or deviating from the norm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>insolence</w> of the new style as a challenge to tradition.",
                            "target_lang_translations": {
                                "de": "Der Dichter beschrieb die <w>Unkonventionalität</w> des neuen Stils als eine Herausforderung an die Tradition.",
                                "ru": "Поэт описал <w>смелость</w> нового стиля как вызов традиции."
                            }
                        },
                        {
                            "text": "There was a strange <w>insolence</w> in the way the artist broke all established rules.",
                            "target_lang_translations": {
                                "de": "Es lag eine seltsame <w>Dreistigkeit</w> in der Art und Weise, wie der Künstler alle etablierten Regeln brach.",
                                "ru": "Была странная <w>дерзость</w> в том, как художник нарушал все установленные правила."
                            }
                        }
                    ],
                    "synonyms": [
                        "novelty",
                        "unconventionality"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Eigenschaft, ungewöhnlich oder neuartig zu sein und von der Norm abzuweichen.",
                        "ru": "Необычность, новизна или отклонение от общепринятых норм."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Neuartigkeit",
                                "target_lang_sense_clarification": "Der Zustand, etwas bisher Unbekanntes oder Neues zu sein."
                            },
                            {
                                "target_lang_word": "Unkonventionalität",
                                "target_lang_sense_clarification": "Das bewusste Abweichen von herkömmlichen Regeln oder Normen."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "необычность",
                                "target_lang_sense_clarification": "новизна, нестандартность"
                            },
                            {
                                "target_lang_word": "непривычность",
                                "target_lang_sense_clarification": "отличие от установленных норм или традиций"
                            },
                            {
                                "target_lang_word": "смелость",
                                "target_lang_sense_clarification": "дерзкая новизна или оригинальность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "314f7f72-89b2-3809-97d4-a2b9766dc479",
                    "sense_definition": "To treat someone with rudeness or insult.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters continued to <w>insolence</w> the authorities despite the warnings.",
                            "target_lang_translations": {
                                "de": "Die Demonstranten fuhren fort, die Behörden trotz der Warnungen zu <w>beleidigen</w>.",
                                "ru": "Протестующие продолжали <w>оскорблять</w> власти, несмотря на предупреждения."
                            }
                        },
                        {
                            "text": "It was wrong to <w>insolence</w> the guests who had come to offer their help.",
                            "target_lang_translations": {
                                "de": "Es war falsch, die Gäste, die gekommen waren, um ihre Hilfe anzubieten, <w>frech zu behandeln</w>.",
                                "ru": "Было неправильно <w>грубить</w> гостям, которые пришли предложить свою помощь."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "offend"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is no longer common."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden unverschämt oder beleidigend behandeln.",
                        "ru": "Относиться к кому-либо грубо, непочтительно или оскорбительно."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beleidigen",
                                "target_lang_sense_clarification": "Jemanden durch Worte oder Taten in seiner Ehre verletzen."
                            },
                            {
                                "target_lang_word": "frech behandeln",
                                "target_lang_sense_clarification": "Jemandem gegenüber respektlos oder dreist auftreten."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "задевать чьё-либо достоинство"
                            },
                            {
                                "target_lang_word": "дерзить",
                                "target_lang_sense_clarification": "вести себя грубо и непочтительно"
                            },
                            {
                                "target_lang_word": "грубить",
                                "target_lang_sense_clarification": "отвечать или относиться невежливо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}