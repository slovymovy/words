                ],
                "senses": [
                    {
                        "sense_id": "60fbb492-366b-30a7-8ea9-2b2e92a4c87d",
                        "entry_id": "1f69108b-c322-362c-b379-e693333d1102",
                        "glosses": [
                            "Anhängerin des Transhumanismus, einer philosophischen Denkrichtung, die darauf abzielt, die natürlichen Grenzen des Menschen durch den Einsatz neuer Technologien zu überwinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067f7fd8-357d-4a76-90e0-6de9e450bca9",
                                "sense_id": "60fbb492-366b-30a7-8ea9-2b2e92a4c87d",
                                "text": "„In der Tat verliert manch eine Transhumanistin und manch ein Transhumanist das Gesellschafts- und Menschheitskollektiv vor dem umfassenden individualistischen Anspruch einer Transformation des eigenen menschlichen ›Materials‹ regelrecht aus dem Blick.“"
                            },
                            {
                                "example_id": "ec905202-82ca-4e69-9146-d205172b9cf1",
                                "sense_id": "60fbb492-366b-30a7-8ea9-2b2e92a4c87d",
                                "text": "„Konservative, Neoliberale, Egoisten und Transhumanistinnen teilen die sozialdarwinistische Hypothese, dass die Evolution einzig einen ständigen Kampf ums Überleben (und um die Verbreitung der eigenen Gene) bedeutet.“"
                            },
                            {
                                "example_id": "d803b76d-4940-411f-bf7e-aaf8499d0296",
                                "sense_id": "60fbb492-366b-30a7-8ea9-2b2e92a4c87d",
                                "text": "„Die Rechtsanwältin und Futuristin Martine Rothblatt (2013), neben Vita-More eine der wenigen Transhumanistinnen, sieht das durch Virtualität bedingte Mehr an Möglichkeiten für den gegenwärtig lebenden Menschen in einem Mehr an Gestaltungsfreiheit – insbesondere was die Zuschreibung von Gender und Sex anbelangt.“"
                            },
                            {
                                "example_id": "3e68a369-da4a-4a8e-8733-572e855188a6",
                                "sense_id": "60fbb492-366b-30a7-8ea9-2b2e92a4c87d",
                                "text": "„Felicitas Reddel, eine Transhumanistin, sagt: ‚Wir sind denkende Menschen, die bestimmen können, nach welchen Werten wir leben wollen. […]‘“"
                            },
                            {
                                "example_id": "409ed86a-6dc3-4338-930f-e65149b3ca9e",
                                "sense_id": "60fbb492-366b-30a7-8ea9-2b2e92a4c87d",
                                "text": "„Die überzeugte Transhumanistin ist die Geschäftsführerin des Biotech-Start-ups BioViva, einem Unternehmen, welches sich auf die Fahnen geschrieben hat, unsere derzeitigen medizinischen Paradigmen grundlegend zu verändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
