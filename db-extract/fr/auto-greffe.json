                        "sense_id": "28100100-2a71-33bd-94f3-e450ac6895f1",
                        "entry_id": "59ca00af-24f4-323c-89b6-9491531f3598",
                        "glosses": [
                            "Greffe où donneur et receveur sont la même personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58780b7-5380-4744-966f-ac9939b47a09",
                                "sense_id": "28100100-2a71-33bd-94f3-e450ac6895f1",
                                "text": "La grande majorité des patients traités par auto-greffe de cellules souches hématopoïétiques (CSH) reçoivent des transfusions de concentrés plaquettaires issus d’aphérèse (CPA) irradiés."
                            },
                            {
                                "example_id": "a1d4145b-e25f-4d36-b2f7-d5eaa8fb35af",
                                "sense_id": "28100100-2a71-33bd-94f3-e450ac6895f1",
                                "text": "Pour en revenir à la greffe tympanique elle-même, selon les cas le chirurgien s’adresse aux auto-greffes, soit aux homo-greffes."
                            }
                        ]
                    }
                ],
