{
    "word_family": [
        "entretien"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fefdf530-5daa-3322-adc6-6df08e78f7b0",
                    "sense_definition": "Prendre soin d'un lieu, d'un objet ou d'un équipement afin de le conserver en bon état.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maintenance_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le concierge passe tous les matins pour <w>entretenir</w> les parties communes de l'immeuble."
                        },
                        {
                            "text": "Mon père <w>entretient</w> régulièrement le moteur de sa vieille voiture pour éviter les pannes."
                        }
                    ],
                    "synonyms": [
                        "maintenir",
                        "soigner"
                    ],
                    "antonyms": [
                        "délaisser",
                        "négliger"
                    ],
                    "common_phrases": [
                        "entretenir sa maison",
                        "entretenir un jardin",
                        "entretenir sa voiture"
                    ]
                },
                {
                    "sense_id": "525b8c5c-8185-3df7-a034-ce5b03a90640",
                    "sense_definition": "Faire durer, alimenter ou préserver une relation, un sentiment ou un état d'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "preservation_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré l'éloignement géographique, ils ont toujours su <w>entretenir</w> une amitié sincère et chaleureuse."
                        },
                        {
                            "text": "Le gouvernement souhaite <w>entretenir</w> un dialogue constructif avec l'ensemble des partenaires sociaux."
                        }
                    ],
                    "synonyms": [
                        "alimenter",
                        "cultiver",
                        "nourrir",
                        "préserver"
                    ],
                    "antonyms": [
                        "détruire",
                        "rompre"
                    ],
                    "common_phrases": [
                        "entretenir de bonnes relations",
                        "entretenir une amitié",
                        "entretenir l'espoir"
                    ]
                },
                {
                    "sense_id": "ec803a24-e32a-3aaa-b14d-792dfa2a7650",
                    "sense_definition": "Faire des exercices réguliers pour préserver sa forme physique ou ses capacités.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle pratique la natation deux fois par semaine pour <w>entretenir</w> sa silhouette et son endurance."
                        },
                        {
                            "text": "À plus de soixante-dix ans, mon grand-père marche tous les jours afin de s'<w>entretenir</w>."
                        }
                    ],
                    "synonyms": [
                        "garder la forme"
                    ],
                    "common_phrases": [
                        "entretenir sa forme",
                        "s'entretenir physiquement"
                    ]
                },
                {
                    "sense_id": "ad16fe17-5c2e-39b7-9587-67b0f25eda83",
                    "sense_definition": "Subvenir aux besoins matériels ou financiers d'une personne ou d'une famille.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "subsistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il travaille dur jour et nuit afin d'<w>entretenir</w> dignement toute sa famille nombreuse."
                        },
                        {
                            "text": "Avec son salaire d'apprenti, il ne parvient pas encore à s'<w>entretenir</w> sans l'aide de ses parents."
                        }
                    ],
                    "synonyms": [
                        "nourrir"
                    ],
                    "antonyms": [
                        "abandonner"
                    ],
                    "common_phrases": [
                        "entretenir sa famille",
                        "entretenir ses enfants"
                    ]
                },
                {
                    "sense_id": "273683b3-c8f3-33a9-a129-a391de432a2a",
                    "sense_definition": "Parler longuement à quelqu'un d'un sujet particulier ou lui exposer une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a demandé à m'<w>entretenir</w> de l'organisation future de notre équipe de recherche."
                        },
                        {
                            "text": "Je désire vous <w>entretenir</w> d'un problème financier urgent avant la fin de la semaine."
                        }
                    ],
                    "synonyms": [
                        "parler"
                    ],
                    "common_phrases": [
                        "entretenir quelqu'un d'une affaire"
                    ]
                },
                {
                    "sense_id": "c27f27d2-a079-3143-8bd4-3d1cbc00ed0b",
                    "sense_definition": "Avoir un échange verbal, une entrevue ou une conversation avec quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux ministres se sont <w>entretenus</w> pendant plus d'une heure sur la situation économique."
                        },
                        {
                            "text": "Le candidat s'<w>entretient</w> actuellement avec la responsable du personnel pour son embauche."
                        }
                    ],
                    "synonyms": [
                        "communiquer",
                        "converser",
                        "dialoguer",
                        "discuter"
                    ],
                    "common_phrases": [
                        "s'entretenir avec un collègue"
                    ]
                },
                {
                    "sense_id": "cda983bd-2730-3fe4-a9d1-e66560acbbd1",
                    "sense_definition": "Se conserver, persister ou continuer à durer dans le temps en parlant d'un état.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preservation_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La confiance mutuelle ne s'<w>entretient</w> que si chaque membre du groupe reste parfaitement honnête."
                        },
                        {
                            "text": "Une telle ferveur populaire s'est <w>entretenue</w> grâce aux récits passionnés des premiers explorateurs."
                        }
                    ],
                    "synonyms": [
                        "durer",
                        "persister",
                        "subsister"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'éteindre"
                    ]
                },
                {
                    "sense_id": "bcfad049-3d12-3d9a-ad86-11892e22ad28",
                    "sense_definition": "Prendre en charge tous les frais d'une personne avec qui l'on a une liaison intime.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subsistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce riche aristocrate avait pour habitude d'<w>entretenir</w> des comédiennes célèbres de la capitale."
                        },
                        {
                            "text": "Il consacrait une grande partie de sa rente à <w>entretenir</w> discrètement sa maîtresse."
                        }
                    ],
                    "common_phrases": [
                        "entretenir une maîtresse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens historique ou littéraire, souvent péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "f53410e1-5383-3396-9ae5-3d31457e3f7d",
                    "sense_definition": "Se tenir ou s'assujettir mutuellement en parlant d'éléments d'une structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maintien_mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à des encoches précises, les deux poutres de l'édifice s'<w>entretiennent</w> sans fixations métalliques."
                        },
                        {
                            "text": "Ces madriers anciens s'<w>entretiennent</w> parfaitement depuis des siècles sous la toiture de la grange."
                        }
                    ],
                    "synonyms": [
                        "se caler",
                        "se soutenir"
                    ]
                }
            ]
        }
    ]
}