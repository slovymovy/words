                                "target_senses": [
                                    {
                                        "sense_id": "54b298b2-de13-3670-8d1a-7cb842943722",
                                        "entry_id": "71451815-976c-3576-955a-ca0261274899",
                                        "glosses": [
                                            "濱海邊疆區行政中心；接近北韓／朝鮮和日本海俄羅斯遠東地區的城市、海港和行政中心"
                                        ],
                                        "tags": [],
                                        "examples": []
