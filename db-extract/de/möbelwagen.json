                ],
                "senses": [
                    {
                        "sense_id": "c7fe4b97-ed65-3c95-8f3d-ccadc73c3b8d",
                        "entry_id": "f3d84b12-3817-372b-ab04-bd5004abac81",
                        "glosses": [
                            "ein Lastwagen, mit dem Möbel und Hausrat bei einem Umzug transportiert sowie neu erworbene Möbel geliefert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5a5a24-b7c8-4111-adfa-d6499554ae48",
                                "sense_id": "c7fe4b97-ed65-3c95-8f3d-ccadc73c3b8d",
                                "text": "Der Möbelwagen soll morgen früh kommen."
                            },
                            {
                                "example_id": "921a5451-e98f-4acd-b3a0-5f66b5b2e71d",
                                "sense_id": "c7fe4b97-ed65-3c95-8f3d-ccadc73c3b8d",
                                "text": "„Vor dem Möbelwagen stehen sechs Belgierpferde, sie stehn in zwei Reihen und haben gespaltene Kruppen.“"
                            },
                            {
                                "example_id": "b0109ebb-dafe-4899-b4e5-60d3fc963ffb",
                                "sense_id": "c7fe4b97-ed65-3c95-8f3d-ccadc73c3b8d",
                                "text": "„Ich muss zugeben, dass Mr. Roger Mifflin sein Gefährt, das wie ein Möbelwagen aussah, innen sehr bequem eingerichtet hatte.“"
                            },
                            {
                                "example_id": "76adc600-3734-4fed-855d-7ee36a02a479",
                                "sense_id": "c7fe4b97-ed65-3c95-8f3d-ccadc73c3b8d",
                                "text": "„Sie hatten zusammen einen Möbelwagen gemietet.“"
                            },
                            {
                                "example_id": "44d77367-83a9-4793-aefa-2638cbd88c3c",
                                "sense_id": "c7fe4b97-ed65-3c95-8f3d-ccadc73c3b8d",
                                "text": "„Aber wo konnte der Möbelwagen sein?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
