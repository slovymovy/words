                            {
                                "target_word": "scurvy-grass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b43867dc-83ca-31ee-9e35-a7787c3392ae",
                                        "entry_id": "f42753f2-9a75-3c6c-adf9-87999ae01bd4",
                                        "glosses": [
                                            "Any of several European plants, of the genus Cochlearia, formerly believed useful in treating scurvy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be93658a-9b95-4654-ad73-2faa01fca420",
                                                "sense_id": "b43867dc-83ca-31ee-9e35-a7787c3392ae",
                                                "text": "The seeds of Scurvy-grasse growing in waterpots have been fruitfull in the Land"
                                            },
                                            {
                                                "example_id": "6e8e1a59-0bd0-4088-858b-5c4a04ac8323",
                                                "sense_id": "b43867dc-83ca-31ee-9e35-a7787c3392ae",
                                                "text": "[T]he seed of Scurvy-grass very much resembles the make of a Concha Venerea, a kind of Purcelane Schell […]."
                                            },
                                            {
                                                "example_id": "3a40e9d9-0110-44e3-86c0-c1820558492b",
                                                "sense_id": "b43867dc-83ca-31ee-9e35-a7787c3392ae",
                                                "text": "Knowing that sellery and scurvey grass and other vegetables were to be found in this sound […] , I went myself at day light in the morn in search of some and returned by breakfast with a boat load […] ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
