                "senses": [
                    {
                        "sense_id": "fb26115c-3c1d-35ae-83f6-168812796f98",
                        "entry_id": "17a3cf6c-55d2-3731-a86b-2604cd2d20b0",
                        "glosses": [
                            "niet actief zijn, niks doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef74c0c-2a18-401b-8bc8-9c9c2ae2c053",
                                "sense_id": "fb26115c-3c1d-35ae-83f6-168812796f98",
                                "text": "Niet-politieke criminaliteit onder het mom van verzet kon o.m. opbloeien door de werkeloosheid van de Belgische justitie die weigerde op te treden tegen het politieke terrorisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7150bb6-ff6c-3f7e-b045-2b4bba58460a",
                        "entry_id": "17a3cf6c-55d2-3731-a86b-2604cd2d20b0",
                        "glosses": [
                            "geen baan hebben, betaald werk missen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "6b6f7903-4343-4dc4-b185-302a7dcfc159",
                                "sense_id": "b7150bb6-ff6c-3f7e-b045-2b4bba58460a",
                                "text": "Wat wel zo is, is dat mensen door het arbeidsproces met elkaar verbonden zijn en dat daarom werkeloosheid voor velen een onleefbare toestand is, zelfs in een verzorgingsstaat als Nederland, waar men niet direct grote armoe lijdt."
                            }
                        ]
                    },
                    {
                        "sense_id": "be151b12-b434-36af-9134-0733a007bdbc",
                        "entry_id": "17a3cf6c-55d2-3731-a86b-2604cd2d20b0",
                        "glosses": [
                            "deel van de beroepsbevolking dat geen baan heeft"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "503e3a4e-3816-45c4-865f-c423176a1cd4",
                                "sense_id": "be151b12-b434-36af-9134-0733a007bdbc",
                                "text": "Aan het eind van de jaren twintig gaat het in Nederland steeds slechter, de werkeloosheid stijgt en zal in de jaren dertig een hoogte van ruim 400.000 werkelozen bereiken; Nederland is in een crisis beland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "673df20d-bab4-4051-bd21-d9c2aa327239",
                        "source_entry_id": "17a3cf6c-55d2-3731-a86b-2604cd2d20b0",
                        "source_sense_id": "b7150bb6-ff6c-3f7e-b045-2b4bba58460a",
                        "source_sense_description": "geen baan hebben, betaald werk missen",
                        "target_lang_word": "Arbeitslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                        "entry_id": "4bbbaab7-eec2-3e9a-86a4-7cafda985af3",
                                        "glosses": [
                                            "Zustand einer Person oder einer Gruppe von Personen, die bezahlte Beschäftigung/Arbeit sucht und keine hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6bce52d-bd59-44ca-91f5-f5a7b2f07814",
                                                "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                                "text": "Arbeitslosigkeit ist eine große soziale Ungerechtigkeit."
                                            },
                                            {
                                                "example_id": "b6cbdf12-a383-4c8a-a5a9-21ede10fbe0d",
                                                "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                                "text": "Durch seine Arbeitslosigkeit kann mein Nachbar die Raten seines Kredites nicht mehr bezahlen."
                                            },
                                            {
                                                "example_id": "a665d65d-3b67-448d-a664-d96254efe0fa",
                                                "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            },
                                            {
                                                "example_id": "a7c0fe16-d209-4ce9-96f5-60674a51c096",
                                                "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                                "text": "„Die Arbeitslosigkeit breitete sich aus wie eine schleichende Pest.“"
                                            },
                                            {
                                                "example_id": "2315257e-816b-453b-93a0-faf3bf79dec4",
                                                "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                                "text": "„Zwar gab es tatsächlich einige Beschäftigte aus Großbritannien und Frankreich in Berlin, meist in technischen Berufen oder in den Verwaltungen von Konzernen, doch hatte ihre Tätigkeit mit dem Anstieg der Arbeitslosigkeit nichts zu tun.“"
                                            },
                                            {
                                                "example_id": "da744329-243a-46dd-8f66-520382c675d6",
                                                "sense_id": "5e7c418e-1138-3363-93b2-572f5d352091",
                                                "text": "„In Karditsa war die Arbeitslosigkeit mindestens so hoch wie im ganzen Land, trotzdem gab es auch wegen der Nähmaschinen in jüngster Zeit immer mehr zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
