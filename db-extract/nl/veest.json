                                    {
                                        "sense_id": "b4e1bd76-e9ec-32a9-8d9a-eca85ad12469",
                                        "entry_id": "a32269d1-02a9-35ca-a196-ccdb8c77d6d3",
                                        "glosses": [
                                            "To emit digestive gases from the anus; to flatulate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "173ee93e-e6e7-4fb2-affd-f587a8080874",
                                                "sense_id": "b4e1bd76-e9ec-32a9-8d9a-eca85ad12469",
                                                "text": "I fart with twenty ladies by; / They call me beast; and what care I?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9805976f-034e-3afe-b812-1c087440c675",
                                        "entry_id": "a32269d1-02a9-35ca-a196-ccdb8c77d6d3",
                                        "glosses": [
                                            "To emit (fumes, gases, etc.)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aae834e-4129-4014-9dc7-e0f4b25447b5",
                                                "sense_id": "9805976f-034e-3afe-b812-1c087440c675",
                                                "text": "Above his head the funnel farted black soot into the sky."
                                            },
                                            {
                                                "example_id": "e7ed5b9d-c064-4e7b-96cb-3f30a9a56731",
                                                "sense_id": "9805976f-034e-3afe-b812-1c087440c675",
                                                "text": "We’ve been stuck behind a Ford Escort farting black smoke for ten minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                        "entry_id": "ab8561c7-d3ac-32c2-9e23-7c17c4d0b03c",
                                        "glosses": [
                                            "An emission of digestive gases from the anus; a flatus."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6976440e-608d-4f75-9025-f5ff6d76e89d",
                                                "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                                "text": "I think I heard a fart. Was it you, Nigel?"
                                            },
                                            {
                                                "example_id": "64ef0aef-64fe-4db4-bc87-1fe0cf55afed",
                                                "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                                "text": "Silent farts are often the smelliest."
                                            },
                                            {
                                                "example_id": "3af4a0ab-1e27-480c-84c5-3c06e0e653ee",
                                                "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                                "text": "Metrocles somewhat indiscreetly, as he was disputing in his Schole, in presence of his auditory, let a fart, for shame whereof he afterwards kept his house and could not be drawen abroad[…]."
                                            }
                                        ]
                                    },
