                "senses": [
                    {
                        "sense_id": "19b994ac-1095-3ad0-b215-3af698fd6994",
                        "entry_id": "c097b26b-1753-3246-851b-b4c60011385d",
                        "glosses": [
                            "System der Grapheme einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be758cc-1741-407a-b162-b0e7a674924d",
                                "sense_id": "19b994ac-1095-3ad0-b215-3af698fd6994",
                                "text": "Die Graphematik des Deutschen unterscheidet sich etwas von der der Nachbarsprachen, die z.B. kein <ß> haben."
                            },
                            {
                                "example_id": "279d7778-8d54-47ca-9a99-ef88d50cbe45",
                                "sense_id": "19b994ac-1095-3ad0-b215-3af698fd6994",
                                "text": "„Der Bereich der Graphematik gehört seit Anfang an zu den empirisch gut bearbeiteten Bereichen des Russischen, da gedruckte Buchstaben klar segmentierbare und deshalb relativ unproblematische Einheiten sind, einer Zählung also entgegenkommen.“"
                            },
                            {
                                "example_id": "066d2c33-3270-4b03-8533-c1cf67b0cf0c",
                                "sense_id": "19b994ac-1095-3ad0-b215-3af698fd6994",
                                "text": "„Das zeigen die im vorliegenden Papier dargelegten Fakten ebenso wie weit vorangetriebene Analysen aus den Bereichen Phonologie, Wortprosodie, Graphematik sowie der Verb- und Adjektivflexion oder der Genuszuweisung, verbunden mit der Wahl des Flexionstyps bei den Substantiven.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "918a210f-827b-37ba-82dc-190529c0ba8a",
                        "entry_id": "c097b26b-1753-3246-851b-b4c60011385d",
                        "glosses": [
                            "Wissenschaftsdisziplin, die das System der Grapheme einer Sprache erforscht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a490d7f-4516-4edc-8cca-d97010e74784",
                                "sense_id": "918a210f-827b-37ba-82dc-190529c0ba8a",
                                "text": "Die Graphematik erarbeitet das System der Grapheme einer Sprache."
                            }
                        ],
                        "sense_index_json": "\"2\""
