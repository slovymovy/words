                    "target_lang_definitions": {
                        "ru": "Физическое состояние, здоровье или сила человека, особенно в отношении способности сопротивляться болезням.",
                        "zh": "一个人的身体状况、健康水平或体质，特别是抵抗疾病的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телосложение",
                                "target_lang_sense_clarification": "физическое строение человека"
                            },
                            {
                                "target_lang_word": "конституция",
                                "target_lang_sense_clarification": "особенности организма и здоровья"
                            },
                            {
                                "target_lang_word": "состояние организма",
                                "target_lang_sense_clarification": "общее физическое самочувствие"
                            },
                            {
                                "target_lang_word": "комплекция",
                                "target_lang_sense_clarification": "особенности строения тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体质",
                                "target_lang_sense_clarification": "身体的素质和健康状况"
                            },
                            {
                                "target_lang_word": "身体状况",
                                "target_lang_sense_clarification": "个人的生理状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b10f2f16-4420-3def-a8f6-83565af08820",
                    "sense_definition": "The way in which something is composed or structured; its physical makeup.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the chemical <w>constitution</w> of the soil on Mars.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают химический <w>состав</w> почвы на Марсе.",
                                "zh": "科学家们正在研究火星土壤的化学<w>组成</w>。"
                            }
                        },
                        {
                            "text": "The physical <w>constitution</w> of the atmosphere changes as you move higher up.",
                            "target_lang_translations": {
                                "ru": "Физическое <w>строение</w> атмосферы меняется по мере подъема вверх.",
                                "zh": "大气的物理<w>结构</w>会随着海拔的升高而改变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "composition",
                        "structure",
                        "makeup",
                        "arrangement",
                        "configuration"
                    ],
                    "common_phrases": [
