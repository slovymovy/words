                "senses": [
                    {
                        "sense_id": "bf694c18-b34b-314d-b5ab-79fd0f7e8dd4",
                        "entry_id": "2b6376e1-2ccc-3f50-886c-44e2b776a389",
                        "glosses": [
                            "Rencoquiller des escargots : les préparer culinairement en se livrant à la fraude du rencoquillage."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c92d0ac3-ae2a-3a36-a7ba-f56fa4e4b213",
                        "entry_id": "2b6376e1-2ccc-3f50-886c-44e2b776a389",
                        "glosses": [
                            "Se renfermer dans sa coquille (le plus souvent au sens figuré)."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ba6191c0-19ba-4865-9655-c838f4705c8b",
                                "sense_id": "c92d0ac3-ae2a-3a36-a7ba-f56fa4e4b213",
                                "text": "Il triomphait sournoisement de la défaite qui consistait, pour l’autre, à se retirer, à se désolidariser, à le laisser tout seul dans le malheur, à se rencoquiller dans l’ignoble confort."
                            },
                            {
                                "example_id": "d0df1997-db6f-49ca-ae81-c30d16e66019",
                                "sense_id": "c92d0ac3-ae2a-3a36-a7ba-f56fa4e4b213",
                                "text": "Bien un âge à se rencoquiller frileusement."
                            }
                        ]
                    }
