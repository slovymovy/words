                                        "sense_id": "8e94dc20-96df-39cf-b4c0-b221be560ac6",
                                        "entry_id": "a9153584-fc6d-304b-8452-df7e02bc4608",
                                        "glosses": [
                                            "zabránit tomu, aby se někdo něco (o něčem) dozvěděl, aby se něco k někomu doneslo, aby se na něco přišlo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d90f8f0-bc18-49df-a46d-68dce91b3e0b",
                                                "sense_id": "8e94dc20-96df-39cf-b4c0-b221be560ac6",
                                                "text": "Quinn si došel do důstojnického klubu, prodral se k baru a přerazil generálovi čelist. Celá záležitost byla pochopitelně ututlána."
                                            },
                                            {
                                                "example_id": "ebdf00cf-7dcb-4c98-a6fc-f7514730185c",
                                                "sense_id": "8e94dc20-96df-39cf-b4c0-b221be560ac6",
                                                "text": "Kupodivu žádná z ostatních politických stran se kauzy nechytila a vyjádření jejich zástupců byla nanejvýš opatrná. Celou aféru se podařilo rychle ututlat a SDKÚ jako jediná parlamentní strana ještě nepředložila zprávu o přijatých darech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70414851-7cd9-4288-9ce0-99a61e2953f0",
