                    "target_lang_definitions": {
                        "en": "said of a situation that is purely based on chance and is very annoying",
                        "ru": "о ситуации, которая основана на чистой случайности и очень досадна"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sheer",
                                "target_lang_sense_clarification": "used to emphasize a quality like bad luck"
                            },
                            {
                                "target_lang_word": "rotten",
                                "target_lang_sense_clarification": "used in the phrase 'rotten luck'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "в значении 'полный', об удаче или неудаче"
                            },
                            {
                                "target_lang_word": "сплошной",
                                "target_lang_sense_clarification": "в устойчивых выражениях о невезении"
                            }
                        ]
                    }
                }
            ]
