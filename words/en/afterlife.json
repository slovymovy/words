{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "badf3b60-4371-37c9-bc0f-0f7f04766e74",
                    "sense_definition": "A conscious existence that is believed to follow physical death.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritual_realm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many world religions teach that good deeds are rewarded in the <w>afterlife</w>.",
                            "target_lang_translations": {
                                "zh": "世界上许多宗教都教导说，善行在<w>来世</w>会得到回报。"
                            }
                        },
                        {
                            "text": "She wondered whether her loved ones were watching over her from the <w>afterlife</w>.",
                            "target_lang_translations": {
                                "zh": "她想知道逝去的亲人是否正在<w>来世</w>守护着她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "life after death",
                        "hereafter",
                        "eternal life"
                    ],
                    "common_phrases": [
                        "believe in an afterlife"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人死后意识或灵魂继续存在的状态，即死后的生命或来生。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "来世",
                                "target_lang_sense_clarification": "指死后的下一世生命"
                            },
                            {
                                "target_lang_word": "死后生命",
                                "target_lang_sense_clarification": "指肉体死亡后的继续存在"
                            },
                            {
                                "target_lang_word": "后世",
                                "target_lang_sense_clarification": "指死后的存续状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2050328c-c08e-3b3e-825c-7753f59a0e46",
                    "sense_definition": "The spiritual world or place where souls are believed to go after death.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritual_realm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient Egyptian tombs were filled with treasures meant to be used in the <w>afterlife</w>.",
                            "target_lang_translations": {
                                "zh": "古埃及古墓中装满了打算在<w>冥世</w>使用的珍宝。"
                            }
                        },
                        {
                            "text": "The myth tells of a hero who journeys into the <w>afterlife</w> to rescue his wife.",
                            "target_lang_translations": {
                                "zh": "这个神话讲述了一位英雄前往<w>冥世</w>拯救妻子的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afterworld",
                        "next world",
                        "spirit world",
                        "hereafter"
                    ],
                    "common_phrases": [
                        "journey to the afterlife"
                    ],
                    "target_lang_definitions": {
                        "zh": "指信仰中灵魂在肉体死亡后所去往的精神世界或冥界。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冥世",
                                "target_lang_sense_clarification": "指死者灵魂居住的世界"
                            },
                            {
                                "target_lang_word": "阴间",
                                "target_lang_sense_clarification": "中国传统文化中人死后去的界域"
                            },
                            {
                                "target_lang_word": "来世",
                                "target_lang_sense_clarification": "指死后所处的世界"
                            },
                            {
                                "target_lang_word": "黄泉",
                                "target_lang_sense_clarification": "神话或文学中人死后去的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7261a32-9ac1-3e00-8446-a80c7fcf7c3c",
                    "sense_definition": "The continued influence, popularity, or cultural presence of a work, event, or idea after its original period.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legacy_or_continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classic science fiction series found a surprising <w>afterlife</w> through online streaming platforms.",
                            "target_lang_translations": {
                                "zh": "这部经典科幻剧集通过网络流媒体平台获得了令人惊喜的<w>后延生命力</w>。"
                            }
                        },
                        {
                            "text": "Historians often examine the political <w>afterlife</w> of the revolution in modern society.",
                            "target_lang_translations": {
                                "zh": "历史学家经常审视这场革命在现代社会中的政治<w>后续影响</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aftermath"
                    ],
                    "common_phrases": [
                        "cultural afterlife"
                    ],
                    "target_lang_definitions": {
                        "zh": "比喻某一作品、历史事件或思想在初创期过后持续产生的影响、热度或文化生命力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "后延生命力",
                                "target_lang_sense_clarification": "作品或事件持续的影响力或热度"
                            },
                            {
                                "target_lang_word": "后续影响",
                                "target_lang_sense_clarification": "初创期过后持续显现的效果"
                            },
                            {
                                "target_lang_word": "延续期",
                                "target_lang_sense_clarification": "在初始阶段结束后的持续存在阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a29a0914-3ab8-3e42-b4d4-57aa4857eb42",
                    "sense_definition": "The lasting reputation, memory, or effects of a person's life and deeds after they have died.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legacy_or_continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her generous donations to the hospital secured a lasting <w>afterlife</w> for her legacy.",
                            "target_lang_translations": {
                                "zh": "她对医院的慷慨捐赠为她的遗产赢得了持久的<w>身后名</w>。"
                            }
                        },
                        {
                            "text": "The philosopher enjoyed an intellectual <w>afterlife</w> far greater than his fame while living.",
                            "target_lang_translations": {
                                "zh": "这位哲学家死后享有的学术<w>身后名</w>远超过他生前的声望。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指人死后留下的声誉、回忆或其思想行为在世间产生的持久深远的影响。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "身后名",
                                "target_lang_sense_clarification": "死后留下的声誉与影响"
                            },
                            {
                                "target_lang_word": "死后声誉",
                                "target_lang_sense_clarification": "去世后所享有的声望与评价"
                            },
                            {
                                "target_lang_word": "身后影响",
                                "target_lang_sense_clarification": "死后在世间留存的深远影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4bbda74-be42-3c9c-a440-92ddd3e91807",
                    "sense_definition": "The later period of a person's life, especially following a major milestone or event such as retirement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After retiring from professional sports, he spent his peaceful <w>afterlife</w> gardening in the countryside.",
                            "target_lang_translations": {
                                "zh": "从职业体育界退役后，他在乡村打理花园，度过了平静的<w>后半生</w>。"
                            }
                        },
                        {
                            "text": "She looked forward to an <w>afterlife</w> filled with travel once her children had grown up.",
                            "target_lang_translations": {
                                "zh": "她期待着孩子们长大后，去享受充满旅行的<w>后半生</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aftercareer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used rarely or figuratively in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指人经历重大转折（如退休）后的后半段人生或晚年生活。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "晚年生活",
                                "target_lang_sense_clarification": "重大转折或退休之后的岁月"
                            },
                            {
                                "target_lang_word": "后半生",
                                "target_lang_sense_clarification": "人生后一阶段的岁月"
                            },
                            {
                                "target_lang_word": "余生",
                                "target_lang_sense_clarification": "晚年或之后的人生时光"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}