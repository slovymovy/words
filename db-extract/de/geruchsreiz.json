                "senses": [
                    {
                        "sense_id": "f9ad8c08-ec65-3d7c-931a-4fce2ff04619",
                        "entry_id": "cb16a964-bfc0-33e5-b959-90c4c3daab4f",
                        "glosses": [
                            "äußere Einwirkung auf den Geruchssinn; Wahrnehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f89fe4-39f5-40c0-8ec8-01e95d185ad2",
                                "sense_id": "f9ad8c08-ec65-3d7c-931a-4fce2ff04619",
                                "text": "„Professor Kuner und seine Mitarbeiter haben zum ersten Mal zeigen können, wie sich die neuronale Verarbeitung von Geruchsreizen direkt auf das Verhalten von Versuchstieren auswirkt.“"
                            },
                            {
                                "example_id": "1ffcdf1b-03f0-426d-9110-8f57cffe8bbf",
                                "sense_id": "f9ad8c08-ec65-3d7c-931a-4fce2ff04619",
                                "text": "„Zusätzlich messen die Wissenschaftler die durch die Geruchsreize hervorgerufenen Hirnströme.“"
                            },
                            {
                                "example_id": "60ed3ee6-c1e5-4c18-ae3f-b6d4cd67cd01",
                                "sense_id": "f9ad8c08-ec65-3d7c-931a-4fce2ff04619",
                                "text": "„Dabei wird die Geruchsprobe so stark verdünnt, dass sie bei dem aus vier Prüfern bestehenden Prüfer kollektiv noch keinen Geruchsreiz auslöst.“"
                            },
                            {
                                "example_id": "bcbef56d-39cd-4305-ac9a-834ee405f0b3",
                                "sense_id": "f9ad8c08-ec65-3d7c-931a-4fce2ff04619",
                                "text": "„Dieses Phänomen spiegelt sich auch im Antwortverhalten der Riechsinneszellen auf einen Geruchsreiz wider.“"
                            },
                            {
                                "example_id": "b8032980-07a0-448a-bdb2-400b4c70bc9d",
                                "sense_id": "f9ad8c08-ec65-3d7c-931a-4fce2ff04619",
                                "text": "„Bei der vergleichsweise selten auftretenden Hyperosmie reagieren die Riechsinneszellen des Betroffenen übermäßig stark auf Geruchsreize.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
