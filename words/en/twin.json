    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c57597f1-4e38-3614-9698-449aa543dc15",
                    "sense_definition": "One of two children or animals born at the same birth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biological_pair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My sister is my <w>twin</w>, but we do not look exactly alike.",
                            "target_lang_translations": {
                                "ru": "Моя сестра — моя <w>двойняшка</w>, но мы не совсем похожи.",
                                "zh": "我姐姐是我的<w>双胞胎</w>，但我们长得并不完全一样。"
                            }
                        },
                        {
                            "text": "She gave birth to healthy <w>twins</w> yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Вчера утром она родила здоровых <w>близнецов</w>.",
                                "zh": "她昨天早上生下了一对健康的<w>双胞胎</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "identical twin",
                        "fraternal twin",
                        "twin brother",
                        "twin sister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из двух детей или животных, рожденных при одних родах.",
                        "zh": "指同一胎出生的两个孩子或动物中的一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близнец",
                                "target_lang_sense_clarification": "общий термин, часто подразумевает идентичных близнецов"
                            },
                            {
                                "target_lang_word": "двойняшка",
                                "target_lang_sense_clarification": "разговорный термин для разнояйцевых (непохожих) близнецов"
                            },
                            {
                                "target_lang_word": "близняшка",
                                "target_lang_sense_clarification": "разговорная, уменьшительно-ласкательная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双胞胎",
                                "target_lang_sense_clarification": "指双胞胎中的一人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4449723f-3fc1-32cd-ba24-4e8edf2f3705",
                    "sense_definition": "A hotel room that contains two separate single beds.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We booked a <w>twin</w> because we are just friends traveling together.",
                            "target_lang_translations": {
                                "ru": "Мы забронировали <w>номер с двумя кроватями</w>, потому что мы просто друзья, путешествующие вместе.",
                                "zh": "我们预订了一间<w>双床房</w>，因为我们只是结伴旅行的朋友。"
                            }
                        },
                        {
                            "text": "Does the hotel have a <w>twin</w> available for tonight?",
                            "target_lang_translations": {
                                "ru": "Есть ли в отеле свободный <w>номер с двумя кроватями</w> на сегодня?",
                                "zh": "酒店今晚还有<w>双床房</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "twin room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Номер в отеле с двумя отдельными односпальными кроватями.",
                        "zh": "酒店中配有两张独立单人床的房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номер с двумя кроватями",
                                "target_lang_sense_clarification": "описательный перевод"
                            },
                            {
                                "target_lang_word": "номер твин",
                                "target_lang_sense_clarification": "профессиональный термин в туризме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双床房",
                                "target_lang_sense_clarification": "酒店客房类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04ad139a-dabd-3f76-95ef-8e185b90e6d3",
                    "sense_definition": "A narrow bed intended for one person, or a mattress of this size.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child has outgrown his crib and needs a <w>twin</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок вырос из своей колыбели, и ему нужна <w>односпальная кровать</w>.",
                                "zh": "孩子长大了，婴儿床已经睡不下了，需要一张<w>单人床</w>。"
                            }
                        },
                        {
                            "text": "These sheets are designed to fit a <w>twin</w> perfectly.",
                            "target_lang_translations": {
                                "ru": "Эти простыни идеально подходят для <w>односпальной кровати</w>.",
                                "zh": "这些床单是专门为<w>单人床</w>设计的，尺寸非常合适。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "twin bed",
                        "twin mattress",
                        "twin size"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая кровать, предназначенная для одного человека, или матрас такого размера.",
                        "zh": "供一人使用的窄床或相应尺寸的床垫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "односпальная кровать",
                                "target_lang_sense_clarification": "стандартный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单人床",
                                "target_lang_sense_clarification": "床的尺寸规格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41d3025d-f0fc-3f32-9d32-e528c10c7f91",
                    "sense_definition": "One of two things that are exactly the same or very similar to each other.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matching_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vase is the <w>twin</w> of the one standing in the hallway.",
                            "target_lang_translations": {
                                "ru": "Эта ваза — <w>близнец</w> той, что стоит в коридоре.",
                                "zh": "这个花瓶是走廊里那一个的<w>复制品</w>。"
                            }
                        },
                        {
                            "text": "The city is often called the <w>twin</w> of its neighbor across the river.",
                            "target_lang_translations": {
                                "ru": "Этот город часто называют <w>близнецом</w> его соседа через реку.",
                                "zh": "这座城市常被称为河对岸邻城的<w>姊妹城</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из двух предметов, которые абсолютно одинаковы или очень похожи друг на друга.",
                        "zh": "两个完全相同或非常相似的事物中的一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близнец",
                                "target_lang_sense_clarification": "в переносном значении"
                            },
                            {
                                "target_lang_word": "двойник",
                                "target_lang_sense_clarification": "о предмете или человеке, очень похожем на другой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复制品",
                                "target_lang_sense_clarification": "指外观完全一致的物品"
                            },
                            {
                                "target_lang_word": "对应物",
                                "target_lang_sense_clarification": "指在另一处有相同特征的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae716668-fa13-3c42-88a9-4f5345dc20c8",
                    "sense_definition": "An aircraft that has two engines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot is experienced in flying a light <w>twin</w>.",
                            "target_lang_translations": {
                                "ru": "Пилот имеет опыт управления легким <w>двухмоторным самолетом</w>.",
                                "zh": "这位飞行员有驾驶轻型<w>双引擎飞机</w>的经验。"
                            }
                        },
                        {
                            "text": "They took a small <w>twin</w> to reach the island.",
                            "target_lang_translations": {
                                "ru": "Они сели на небольшой <w>двухмоторный самолет</w>, чтобы добраться до острова.",
                                "zh": "他们乘坐一架小型<w>双引擎飞机</w>到达了岛上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самолет, имеющий два двигателя.",
                        "zh": "拥有两个引擎的飞机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двухмоторный самолет",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双引擎飞机",
                                "target_lang_sense_clarification": "航空术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3789028d-3517-3bb7-9ce0-a5dcb738972b",
                    "sense_definition": "Occurring as one of a matching pair; double or dual.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "matching_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room has <w>twin</w> beds suitable for two people.",
                            "target_lang_translations": {
                                "ru": "В номере отеля есть <w>парные</w> кровати, подходящие для двух человек.",
                                "zh": "酒店房间里有适合两人住的<w>双人</w>床。"
                            }
                        },
                        {
                            "text": "The <w>twin</w> towers were the tallest buildings in the city.",
                            "target_lang_translations": {
                                "ru": "Башни-<w>близнецы</w> были самыми высокими зданиями в городе.",
                                "zh": "那两座<w>双子</w>塔曾是城里最高的建筑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dual",
                        "double",
                        "paired"
                    ],
                    "common_phrases": [
                        "twin beds",
                        "twin brothers",
                        "twin sisters",
                        "twin cities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся одним из пары; двойной или сдвоенный.",
                        "zh": "成对出现的；双重的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парный",
                                "target_lang_sense_clarification": "составляющий пару"
                            },
                            {
                                "target_lang_word": "сдвоенный",
                                "target_lang_sense_clarification": "соединенный по два"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双人的",
                                "target_lang_sense_clarification": "形容词，指成对的"
                            },
                            {
                                "target_lang_word": "双重的",
                                "target_lang_sense_clarification": "形容词，指双倍或成对"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32bbbc97-d16b-3fd7-9961-900ae701be8c",
                    "sense_definition": "Relating to or being a pair of twins.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biological_pair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was pushing <w>twin</w> boys in a large stroller.",
                            "target_lang_translations": {
                                "ru": "Она везла мальчиков-<w>близнецов</w> в большой коляске.",
                                "zh": "她推着一辆大婴儿车，里面坐着一对<w>双胞胎</w>男孩。"
                            }
                        },
                        {
                            "text": "The <w>twin</w> calves were born on the farm last night.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью на ферме родились телята-<w>близнецы</w>.",
                                "zh": "昨晚农场里出生了一对<w>双胞胎</w>小牛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к близнецам или являющийся парой близнецов.",
                        "zh": "与双胞胎有关的，或指双胞胎的一对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близнецовый",
                                "target_lang_sense_clarification": "прилагательное, часто в медицинском контексте"
                            },
                            {
                                "target_lang_word": "из двойни",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双胞胎的",
                                "target_lang_sense_clarification": "形容词，指双胞胎身份"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0213ec4-dadb-3dc9-be9a-0bd766e61ebe",
                    "sense_definition": "To link a town or city with another in a different country for cultural and social exchange.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our town is <w>twinned</w> with a small village in France.",
                            "target_lang_translations": {
                                "ru": "Наш город <w>является побратимом</w> маленькой деревни во Франции.",
                                "zh": "我们镇与法国的一个小村庄<w>结为友好城市</w>。"
                            }
                        },
                        {
                            "text": "Coventry <w>twinned</w> with Dresden to promote peace after the war.",
                            "target_lang_translations": {
                                "ru": "Ковентри <w>стал побратимом</w> Дрездена для укрепления мира после войны.",
                                "zh": "考文垂与德累斯顿<w>结为友好城市</w>，以促进战后和平。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "twinned with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связать город с другим городом в другой стране для культурного и социального обмена.",
                        "zh": "将一个城镇与另一个国家的城镇建立文化和社会交流关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стать побратимами",
                                "target_lang_sense_clarification": "о городах"
                            },
                            {
                                "target_lang_word": "побрататься",
                                "target_lang_sense_clarification": "установить братские связи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结为友好城市",
                                "target_lang_sense_clarification": "指城市间的正式外交关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a20dc6e3-fbe6-3e54-a688-26d0c87170b5",
                    "sense_definition": "To dress or behave in an identical way to someone else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matching_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look at us, we are totally <w>twinning</w> in our blue dresses today!",
                            "target_lang_translations": {
                                "ru": "Посмотри на нас, мы сегодня полные <w>близняшки</w> в наших синих платьях!",
                                "zh": "看我们，今天都穿着蓝色裙子，简直是<w>穿得一模一样</w>！"
                            }
                        },
                        {
                            "text": "I did not plan on <w>twinning</w> with my coworker, but we both wore stripes.",
                            "target_lang_translations": {
                                "ru": "Я не планировала <w>одеваться одинаково</w> с коллегой, но мы обе пришли в полосатом.",
                                "zh": "我没打算和同事<w>穿得一模一样</w>，但我们都穿了条纹衫。"
                            }
                        }
