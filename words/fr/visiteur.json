    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d43ef65-763f-3d51-8447-abc8ad3fb020",
                    "sense_definition": "Personne qui va voir quelqu'un ou qui visite un lieu par curiosité ou intérêt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée accueille des milliers de <w>visiteurs</w> chaque week-end."
                        },
                        {
                            "text": "Nous attendons un <w>visiteur</w> important cet après-midi au bureau."
                        }
                    ],
                    "synonyms": [
                        "hôte",
                        "invité",
                        "touriste"
                    ],
                    "common_phrases": [
                        "livre des visiteurs",
                        "guide des visiteurs",
                        "nombreux visiteurs"
                    ]
                },
                {
                    "sense_id": "458fe90b-a568-3e1e-b794-2dd998bfd866",
                    "sense_definition": "Personne chargée par une autorité ou une entreprise de contrôler ou de présenter des produits.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>visiteur</w> médical présente de nouveaux médicaments aux médecins de la région."
                        },
                        {
                            "text": "Un <w>visiteur</w> des douanes vérifie la conformité des marchandises importées."
                        }
                    ],
                    "synonyms": [
                        "inspecteur",
                        "contrôleur"
                    ],
                    "common_phrases": [
                        "visiteur médical",
                        "visiteur des douanes"
                    ]
                },
                {
                    "sense_id": "489af0d9-fd5a-31b3-8881-29ccfad20d8c",
                    "sense_definition": "Religieux chargé d'inspecter les maisons ou communautés de son ordre dans une circonscription donnée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le père <w>visiteur</w> inspecte chaque couvent pour s'assurer du respect des règles monastiques."
                        },
                        {
                            "text": "La congrégation attend la venue prochaine du <w>visiteur</w> canonique."
                        }
                    ],
                    "common_phrases": [
                        "père visiteur"
                    ]
                },
                {
                    "sense_id": "99ebf3e7-6648-3431-bd7e-91b6d4c45b9b",
                    "sense_definition": "Ouvrier chargé d'examiner et de vérifier la qualité de produits manufacturés, notamment les étoffes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>visiteur</w> examine chaque pièce de tissu pour déceler les moindres défauts."
                        },
                        {
                            "text": "Dans cette manufacture de soie, le rôle du <w>visiteur</w> demeure indispensable."
                        }
                    ],
                    "synonyms": [
                        "vérificateur"
                    ]
                }
            ]
        }
    ]
