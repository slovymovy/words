                "senses": [
                    {
                        "sense_id": "4284fc28-de85-3a7d-9d25-6917775aede1",
                        "entry_id": "d456d309-f9f6-35b2-802e-400989f20426",
                        "glosses": [
                            "Gesamtheit der Hörer/Zuhörer einer Sendung/Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c487c5e1-6a34-4ef5-81b9-db866c4b91f4",
                                "sense_id": "4284fc28-de85-3a7d-9d25-6917775aede1",
                                "text": "„Das ist wörtlich der Satz, mit dem der Vortragende lächelnd allfälliges Grausen seiner Hörerschaft beseitigt.“"
                            },
                            {
                                "example_id": "e1cee38c-13c4-44a5-9695-48098ddd6757",
                                "sense_id": "4284fc28-de85-3a7d-9d25-6917775aede1",
                                "text": "„Eben weil er nicht harmlos ist, ruft der tendenziöse Witz bei einer gewissen Hörerschaft Widerstand hervor, und damit ist ein Punkt erreicht, der Freuds psychoanalytisches Interesse erregt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
