                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po <w>błyskawicy</w> zawsze następuje głośny grzmot.",
                            "target_lang_translations": {
                                "ru": "После <w>молнии</w> всегда следует громкий гром.",
                                "en": "A loud clap of thunder always follows <w>lightning</w>.",
                                "nl": "Na de <w>bliksem</w> volgt altijd een luide donder.",
                                "de": "Auf einen <w>Blitz</w> folgt immer ein lauter Donner.",
                                "fr": "Après un <w>éclair</w>, il y a toujours un coup de tonnerre bruyant.",
                                "it": "Al <w>lampo</w> segue sempre un forte tuono.",
                                "cs": "Po <w>blesku</w> vždy následuje hlasité zahřmění.",
                                "tr": "<w>Şimşekten</w> sonra her zaman yüksek sesli bir gök gürültüsü gelir.",
                                "es": "Después del <w>relámpago</w> siempre sigue un fuerte trueno.",
                                "zh": "<w>闪电</w>过后总会伴随着巨响的雷声。"
                            }
                        },
                        {
                            "text": "Ciemne niebo nagle rozświetliła potężna <w>błyskawica</w>.",
                            "target_lang_translations": {
                                "ru": "Тёмное небо внезапно озарила мощная <w>молния</w>.",
                                "en": "The dark sky was suddenly lit up by a powerful <w>flash of lightning</w>.",
                                "nl": "De donkere lucht werd plotseling verlicht door een krachtige <w>bliksemflits</w>.",
                                "de": "Ein gewaltiger <w>Blitz</w> erhellte plötzlich den dunklen Himmel.",
                                "fr": "Le ciel sombre s'est soudainement illuminé sous un puissant <w>éclair</w>.",
                                "it": "Il cielo scuro è stato improvvisamente illuminato da un potente <w>lampo</w>.",
                                "cs": "Temné nebe náhle ozářil mohutný <w>blesk</w>.",
                                "tr": "Karanlık gökyüzünü aniden güçlü bir <w>şimşek</w> aydınlattı.",
                                "es": "El cielo oscuro fue iluminado repentinamente por un potente <w>relámpago</w>.",
                                "zh": "一道巨大的<w>闪电</w>突然照亮了漆黑的夜空。"
                            }
                        }
