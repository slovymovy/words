                "forms": [
                    {
                        "form_id": "11971429-49cb-4df6-a2e0-cf51965243a3",
                        "entry_id": "84e453a7-fc81-313a-9ea1-5ae01864a2de",
                        "tags": [
                            "plural"
                        ],
                        "form": "scintillateurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                        "entry_id": "84e453a7-fc81-313a-9ea1-5ae01864a2de",
                        "glosses": [
                            "Matériau émettant de la lumière suite à l’absorption d’un rayonnement ionisant (photon ou particule chargée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aedbc95-f46e-42e4-90b0-c20ab3d1e858",
                                "sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                                "text": "Sur la face externe de cette fibre optique est déposé le scintillateur assurant la conversion photons X à photons lumineux, sur la face interne est déposée la couche photosensible."
                            },
                            {
                                "example_id": "a21f5d9c-fe7c-49f1-8ed4-7c30c7ebfa24",
                                "sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                                "text": "Un rayonnement traversant un scintillateur solide ou liquide provoque sur sa trajectoire l’excitation d’un certain nombre de molécules qui restituent l’énergie ainsi absorbée sous forme de photons lumineux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85ca1d6a-a75c-4cff-9457-948ed9659ac0",
                        "source_entry_id": "84e453a7-fc81-313a-9ea1-5ae01864a2de",
                        "source_sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                        "target_lang_word": "Szintillator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Szintillator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4df3d2-94ec-3db8-96a3-afd2e7cff363",
                                        "entry_id": "807dabe0-3159-3617-9c3c-9b564e9adc4f",
                                        "glosses": [
                                            "ein fester, flüssiger oder gasförmiger Leuchtstoff für Strahlungsdetektoren. Die eintreffende Strahlung wird in Lichtquanten umgewandelt, die mit Hilfe eines Fotovervielfachers gemessen werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3f39c1-e899-4b8d-97b0-96b65e770aca",
                                                "sense_id": "5f4df3d2-94ec-3db8-96a3-afd2e7cff363",
                                                "text": "„Die Höhe des Spannungsimpulses ist proportional der Zahl der Lichtquanten, die aus der Fotokatode Elektronen herauslösen und damit bei konstanter Geometrie der Meßanordnung auch proportional der Energie der Teilchen bzw. Quanten, die im Szintillator eintreffen.“"
                                            },
                                            {
                                                "example_id": "b26f20d4-afaf-4be7-836c-d80076db7787",
                                                "sense_id": "5f4df3d2-94ec-3db8-96a3-afd2e7cff363",
                                                "text": "„Das Experiment besteht aus: drei Detektoren, in denen sich je ein Szintillator mit Lichtleitern, Photomultiplier und Hochspannungsversorgung befindet […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
