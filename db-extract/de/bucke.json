                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e2baf9-8896-4b47-99e4-aace21896e84",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Frau Bucke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "213c88f0-055a-43be-bf48-5b7850940238",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Herr Bucke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dd324b4d-e035-4613-8e40-8b733153b270",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Die Buckes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1060b263-04ae-4dc0-a56f-d8b6f8a66aa3",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Der Bucke trägt nie die Schals, die die Bucke ihm strickt."
                            },
                            {
                                "example_id": "423c83cb-851b-4ffb-9784-0d63c28fcc8c",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bucke kommt, geht der Herr Bucke.“"
                            },
                            {
                                "example_id": "ad322b70-c870-475c-8af5-0d59b679ddde",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Bucke kommt und geht."
                            },
                            {
                                "example_id": "b5fa9b88-9553-4123-9be4-e51f1bf90d8f",
                                "sense_id": "c9065bf7-4154-3436-8501-d314742ea7df",
                                "text": "Buckes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
