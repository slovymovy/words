                                    {
                                        "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                        "entry_id": "9d8c54a3-446e-30b4-b9a0-b7d1a9c017fe",
                                        "glosses": [
                                            "To cover or fill with bitumen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a46f0a-376b-4d81-adce-eac8f633eaf3",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "another star reflected itself in the glassy black of the bitumened road"
                                            },
                                            {
                                                "example_id": "f2e94fe1-8d3c-422d-82ac-8b8f786f1a85",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "The Litlata community have now built a mandi set in a pleasant garden, and to ensure the cleanliness of their yardna have bricked and bitumened the pool into which the water flows"
                                            },
                                            {
                                                "example_id": "a78a72c1-e9ac-4632-ba01-fce615ee05c6",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "Work is already under way to complete the bitumening of Western Australia's last unsurfaced stretch of Highway One, between Fitzroy Crossing and Hall's Creek."
                                            },
                                            {
                                                "example_id": "7434ac10-1cba-44b2-87f7-86cdc501ee8a",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "The development of water reticulation occurred in parallel with street work — forming, kerbing, channelling and bitumening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
