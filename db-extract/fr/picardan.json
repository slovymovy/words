                "senses": [
                    {
                        "sense_id": "079ed965-43b8-34ef-91af-0b663c12524c",
                        "entry_id": "53111884-e69e-3e84-ae00-28e9ca548506",
                        "glosses": [
                            "Ce nom est utilisé en tant que synonyme de plusieurs cépages : le bouchalès, le cinsaut (dans le Var), et aussi de l'aragnan et du bourboulenc qui lui donnent du raisin blanc."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "25f9aebb-a083-48fc-b5e7-4c3f0608d3d8",
                                "sense_id": "079ed965-43b8-34ef-91af-0b663c12524c",
                                "text": "Parmi les espèces encore connues sous le nom quʼil donne citons: la clairette, le picardan, le piquepoul, le ribier, le corinthien."
                            },
                            {
                                "example_id": "ea132354-bce5-4a81-9280-2bc5d21ffcd4",
                                "sense_id": "079ed965-43b8-34ef-91af-0b663c12524c",
                                "text": "Leurs petits raisins [coteaux du Rhône], serrés, sont moins décoratifs que le picardan opulent de la Provence, qui traîne sous les ceps des appas de six livres, et tient aux lézards le ventre frais."
                            }
                        ]
                    }
                ],
