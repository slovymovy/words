                    },
                    {
                        "form_id": "aa297bd1-33ff-400e-9294-88e0f7957edd",
                        "entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
                        "tags": [
                            "feminine"
                        ],
                        "form": "armurière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7e8572a-fd65-366f-966f-f300c914bcf7",
                        "entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
                        "glosses": [
                            "Fabricant ou vendeur d’armes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa59a550-0f6b-4efb-bada-584e6bb91f71",
                                "sense_id": "c7e8572a-fd65-366f-966f-f300c914bcf7",
                                "text": "Au-delà de cet espace étaient des tentes avec des vivres et des rafraîchissements de toute espèce, avec des armuriers, des maréchaux-ferrants et autres serviteurs prêts à offrir leurs services partout où l’on en aurait besoin."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1bdae64-e34b-3cb6-b6f2-e51ed90c6989",
                        "entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
                        "glosses": [
                            "Soldat chargé de l’entretien des armes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68d1c7e-dffc-42b0-8586-61af48c0302f",
                                "sense_id": "e1bdae64-e34b-3cb6-b6f2-e51ed90c6989",
                                "text": "À la Jefatura, ancien collège transformé en caserne, Lopez, amical et bourbonien, achevait d'interroger des évadés de l'Alcazar : une femme, otage, enfuie grâce à un faux sauf-conduit délivré par le maître armurier, en fuite aussi : et dix soldats emprisonnés le premier jour, qui avaient pu sauter dans l'un des ravins."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d565f84-5ca4-3faf-a18b-c3ecaba573e7",
                        "entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
                        "glosses": [
                            "Fabricant d’armures."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5d0d52f9-adb2-4c91-94a3-b6e45300340e",
                                "sense_id": "7d565f84-5ca4-3faf-a18b-c3ecaba573e7",
                                "text": "ARMURIER, s. m. celui qui faisoit autrefois les armes défensives dont les gens de guerre se couvroient, telles que le heaume ou le casque, le gorgeron, la cuirasse, les brossards, les cuissarts, le morion, le hausse-col, &c. On confond aujourd’hui l’armurier avec l’arquebusier ; il est cependant évident que l’armurerie & l’arquebuserie sont deux professions fort différentes ; & que l’une subsistoit dans toute sa vigueur, que l’autre n’étoit pas encore établie. Les armuriers s’appelloient aussi heaumiers du heaume ou casque ; leur communauté étoit nombreuse ; leurs premiers statuts sont de 1409, sous le regne de Charles VI. ils furent renouvellés en 1562 sous Charles IX."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9242a4bf-ce71-4351-aa09-b09e8a0b17bf",
                        "source_entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
                        "source_sense_description": "vendeur d’armes",
                        "target_lang_word": "Waffenverkäufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenverkäufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90a07f2b-fd64-390c-9fb1-61b76980f7d1",
                                        "entry_id": "0022c30d-3a65-30b9-9d6d-75210347e0d0",
                                        "glosses": [
                                            "Verkäufer von Waffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bbe75b-9cff-4692-853b-83d5a232b104",
                                                "sense_id": "90a07f2b-fd64-390c-9fb1-61b76980f7d1",
                                                "text": "Der Waffenverkäufer Lüller-Müdenscheid bewegt sich oft in Grauzonen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ca4694e-fd25-49a4-b98c-ee73462b5284",
                        "source_entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
                        "source_sense_description": "fabricant d’armes",
                        "target_lang_word": "Waffenschmied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenschmied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57ce27f7-5780-3701-ba38-bf5c559fa47c",
                                        "entry_id": "c30f80e1-686c-3ce0-9324-2d2f0c23b109",
                                        "glosses": [
                                            "Person, die Klingen, Helme, Panzerhemden, Rüstungen (Harnische), Schilde und Feuerwaffen anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76bc5ecf-f60b-4fd9-831b-a06667ac2fe7",
                                                "sense_id": "57ce27f7-5780-3701-ba38-bf5c559fa47c",
                                                "text": "„Ein Waffenschmied stellt Waffen her, also Dinge, die den höchsten möglichen Belastungen bei minimalem Eigengewicht ausgesetzt sind.“"
                                            },
                                            {
                                                "example_id": "83ed2714-f70b-4b8d-ad40-5c22023dac02",
                                                "sense_id": "57ce27f7-5780-3701-ba38-bf5c559fa47c",
                                                "text": "„Im Dreißigjährigen Krieg haben die Waffenschmiede in Nürnberg Waffen an alle Kriegsparteien geliefert, selbst an die eigenen Feinde, aber immerhin mit Profit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a4c89cb-16e2-43d6-95bc-071833ca6004",
                        "source_entry_id": "618da1f6-f4d1-3366-8057-2e8430a016ea",
