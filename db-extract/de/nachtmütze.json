                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfdd3d56-55dc-4bb5-a199-de918acb6085",
                        "source_entry_id": "b3498118-25b4-3f5b-ba86-7b52056b1b94",
                        "source_sense_id": "d22e5250-33b0-389d-bbe9-6da258fe7e5a",
                        "source_sense_description": "früher: beim Schlafen getragene Mütze",
                        "target_lang_word": "nightcap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nightcap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "965c47bb-81e4-337f-bd47-3c66ecae6741",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A warm cloth cap worn while sleeping, often with pajamas, being common attire in northern Europe before effective home heating became widespread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd1e17a-c81a-47b8-90a9-5308a6de9bf0",
                                                "sense_id": "965c47bb-81e4-337f-bd47-3c66ecae6741",
                                                "text": "Winston wore a nightcap to stave off the cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A beverage drunk before bed that is usually alcoholic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bafc843-2408-4689-8b49-1b4596bd37ba",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "I'll make myself a nightcap of whisky and lemon before heading to bed."
                                            },
                                            {
                                                "example_id": "e9bcf6bd-4701-4823-b514-2ac139963881",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "You know the other night, when I had dinner with Afro-Dite? When Jo was in San Francisco? Well we dropped into the Sinners, right, just for a nightcap."
                                            },
                                            {
                                                "example_id": "19bc62bb-5971-4efc-ae88-4050be821b25",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "This week I took up the relatively simple challenge of buying breakfast, lunch and dinner—and a nightcap—exclusively from konbini, as well as completing a couple of admin tasks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89fe19a-69f5-3f76-bac1-cf0858092a59",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "Something that a person reads or listens to before bed."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605012f3-58de-4d78-9199-4f25785bda87",
                                                "sense_id": "d89fe19a-69f5-3f76-bac1-cf0858092a59",
                                                "text": "\"[…] and as a nightcap I happened to pick the copy of Plato […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb76627-ead5-34dd-851e-aff2131310f3",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "The final match of a sporting contest, especially the second game of a baseball doubleheader."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e313087f-0c54-3097-b8a4-72d18a56cfc0",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A cap drawn over the face of the condemned person before they are hanged."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nightcap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                        "entry_id": "1a1f3175-7a87-30ca-9db9-d99986ba791c",
                                        "glosses": [
                                            "To drink an alcoholic beverage shortly before retiring to bed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5b3b48-ab2b-475f-9918-33645ef3d3a9",
                                                "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                                "text": "Even better than breakfast, though, is nightcapping at the Waffle House . Nightcapping happens after the bars close, but before the southern sunrise: the hours when their jukeboxes play “Freebird” on a continual loop, […]"
                                            },
                                            {
                                                "example_id": "28622363-13cb-4888-8e48-db0ad9c82b2e",
                                                "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                                "text": "We nightcapped at the Four Seasons Hotel George V, on the most extravagant cocktails I'd ever purchased in life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf3ff70a-445c-403d-87c4-c19225f086a5",
                        "source_entry_id": "b3498118-25b4-3f5b-ba86-7b52056b1b94",
                        "source_sense_id": "d22e5250-33b0-389d-bbe9-6da258fe7e5a",
                        "source_sense_description": "früher: beim Schlafen getragene Mütze",
                        "target_lang_word": "bonnet de nuit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonnet de nuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95ad27a4-9a46-391f-a811-93ed3d3f11cb",
                                        "entry_id": "1ba24d36-d3c0-3755-93d1-dacedeeed813",
                                        "glosses": [
                                            "Sorte de bonnet que l’on met pour dormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723e0289-db72-4aef-bb4d-9c08662c0a1f",
                                                "sense_id": "95ad27a4-9a46-391f-a811-93ed3d3f11cb",
                                                "text": "Elle portait cet affreux petit sac en taffetas noir avec lequel les vieilles femmes s’enveloppent l’occiput, et qui dépassait son bonnet de nuit relevé par les mouvements du sommeil."
                                            },
                                            {
                                                "example_id": "74e14bc7-ef1a-46ca-94b9-54250ec9c983",
                                                "sense_id": "95ad27a4-9a46-391f-a811-93ed3d3f11cb",
                                                "text": "Qui ouvrirait les armoires de la belle, ou soulèverait certains rideaux, ne serait pas peu surpris d’y trouver le bonnet de nuit du maître, sa ceinture élastique, son tire-botte et sa cire à favoris."
                                            },
                                            {
                                                "example_id": "94b08e71-1e9c-4842-aaef-95ca10a0eda6",
                                                "sense_id": "95ad27a4-9a46-391f-a811-93ed3d3f11cb",
                                                "text": "Si j’écoutais ma gouvernante, je serais M. Argan tout bonnement, et je me coifferais, pour le reste de mes jours, d’un bonnet de nuit à rubans…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23229ffe-0cd4-357f-9426-14548482a9e3",
                                        "entry_id": "1ba24d36-d3c0-3755-93d1-dacedeeed813",
                                        "glosses": [
                                            "Couche-tôt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "496ba642-6067-34cf-a282-e7f4fb64bb62",
                                        "entry_id": "1ba24d36-d3c0-3755-93d1-dacedeeed813",
                                        "glosses": [
                                            "Se dit d’une personne ennuyeuse, qui n’aime pas s’amuser."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6521f97-a374-43a3-bdb1-2be85ef976a7",
                                                "sense_id": "496ba642-6067-34cf-a282-e7f4fb64bb62",
                                                "text": "Elle restait là, morne, un vrai bonnet de nuit, tout ça parce que, à la composition de géographie, ce matin, elle ne s’est pas rappelé le Cantal. Le beau mallheur, comme s’il n’y avait que les compositions, dans la vie ! Mais, pour elle, on dirait que si."
                                            },
                                            {
                                                "example_id": "097e2b0d-efd4-4bba-89cf-605b5c3cdc08",
                                                "sense_id": "496ba642-6067-34cf-a282-e7f4fb64bb62",
                                                "text": "Une femme à la puissante aura de pouvoir, aussi réservée et aussi imposante qu’on pouvait l’attendre d’une reine, mais également « comme il faut », du moins selon les critères andoriens. Un bonnet de nuit guindé, pour quiconque d’autre…"
                                            },
                                            {
                                                "example_id": "efa1f5f0-a9d3-4d7c-be39-8b86ec5c9ea1",
                                                "sense_id": "496ba642-6067-34cf-a282-e7f4fb64bb62",
                                                "text": "Allons, lui dit-il en la reconduisant, ne sois donc pas bonnet de nuit comme ça… Il faut une philosophie en ce monde…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595accad-009c-30dd-a9a2-c958c9181f26",
                                        "entry_id": "1ba24d36-d3c0-3755-93d1-dacedeeed813",
                                        "glosses": [
                                            "Petit verre de boisson alcoolisée, bu avant de se coucher."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc409c56-0a79-32ac-988c-aaa868e56b28",
                                        "entry_id": "1ba24d36-d3c0-3755-93d1-dacedeeed813",
                                        "glosses": [
                                            "Petit objet de forme conique que l’on pose sur la mèche d’une bougie pour l’éteindre ; appelé aussi éteignoir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
