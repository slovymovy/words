                ],
                "senses": [
                    {
                        "sense_id": "f920fd53-47a3-3d0f-a636-46d665218d0e",
                        "entry_id": "8c86740a-1588-316f-88d3-7132b6367a45",
                        "glosses": [
                            "Avion doté de trois moteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74e77b85-8a18-49be-8d80-e4128be3004f",
                                "sense_id": "f920fd53-47a3-3d0f-a636-46d665218d0e",
                                "text": "Enfin nos lecteurs savent que depuis quelques mois un nouveau type d’avion multimoteur a été mis en service sur la section de nuit Belgrade-Bucarest, c’est le Caudron C-61, trimoteur dont nous avons donné la description dans un numéro précédent de La Nature."
                            },
                            {
                                "example_id": "dbf620a7-8a9f-459c-ace6-8b494c00e2ab",
                                "sense_id": "f920fd53-47a3-3d0f-a636-46d665218d0e",
                                "text": "Toutefois, l’avion multimoteur, le trimoteur plus particulièrement, sera certainement l’appareil de demain."
                            },
                            {
                                "example_id": "b33a8a1e-7048-458f-a1ea-e583ba99e353",
                                "sense_id": "f920fd53-47a3-3d0f-a636-46d665218d0e",
                                "text": "Pilote d’essai, il meurt lors du crash du prototype du Breguet 390, un trimoteur commercial."
                            }
                        ]
                    }
                ],
