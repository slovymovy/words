                "senses": [
                    {
                        "sense_id": "9295055f-87ce-399d-b391-4e4763b8d4f8",
                        "entry_id": "cd8f8c03-d333-380f-966a-63da93d11b0d",
                        "glosses": [
                            "Revenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b7e99d-7e17-454c-a26c-257c5c34e9d2",
                                "sense_id": "9295055f-87ce-399d-b391-4e4763b8d4f8",
                                "text": "Miesel bezieht seine Einkünfte aus Übersetzungen. Aus dem Englischen, dem Russischen und dem Polnischen, der Sprache, in der seine Großmutter während seiner Kindheit zu ihm sprach.",
                                "translation": "Miesel tire ses revenus de traductions. De l’anglais, du russe et du polonais, langue que sa grand-mère lui a parlée durant son enfance."
                            }
                        ]
                    },
                    {
                        "sense_id": "419f56c8-d65b-3cb7-86c8-16860c0a00e9",
                        "entry_id": "cd8f8c03-d333-380f-966a-63da93d11b0d",
                        "glosses": [
                            "Revenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1befff-3543-428a-9d78-4e01f93fd944",
                                "sense_id": "419f56c8-d65b-3cb7-86c8-16860c0a00e9",
                                "text": "Der durchschnittliche Chinese ist (...) darauf angewiesen, einen Großteil seiner Einkünfte für Notlagen oder zur Altersabsicherung beiseitezulegen.",
                                "translation": "Le Chinois moyen (...) est obligé de mettre de côté une grande partie de ses revenus pour faire face aux situations d’urgence ou pour assurer sa retraite."
                            }
                        ]
                    }
                ],
