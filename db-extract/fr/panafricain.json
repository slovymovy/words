                        "entry_id": "099e1c18-f25c-335e-967b-3838a00e3fe7",
                        "glosses": [
                            "Relatif à toute l’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45b45f5-d1f4-4880-9330-e1945e634a44",
                                "sense_id": "dd1a3952-9a3f-3eeb-949a-2953a3a134ef",
                                "text": "L’Agence panafricaine de presse est une agence de presse à vocation panafricaine."
                            },
                            {
                                "example_id": "f4219cd2-f790-4075-8ca2-023b8ae863c6",
                                "sense_id": "dd1a3952-9a3f-3eeb-949a-2953a3a134ef",
                                "text": "Sauf que cette démarche étatique et panafricaine ne séduit guère les boîte françaises travaillant en Afrique […] que « Le Canard » a interrogés."
                            }
                        ]
                    },
                    {
                        "sense_id": "457dfd1b-8b9e-34f2-80a8-add6ef20420a",
                        "entry_id": "099e1c18-f25c-335e-967b-3838a00e3fe7",
                        "glosses": [
                            "Relatif au panafricanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e53f1e-cd25-4472-93ec-cedea2e281dc",
                                "sense_id": "457dfd1b-8b9e-34f2-80a8-add6ef20420a",
                                "text": "Il devait être un nationalisme panafricain et l'idéologie d'une conscience politique parmi les Africains ainsi que leur émancipation devaient se répandre partout sur le continent noir."
                            }
                        ]
                    }
                ],
