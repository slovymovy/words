                        "entry_id": "d11a1a0b-bf92-3181-b28b-8b3b7e0c4c01",
                        "glosses": [
                            "cecha tego, co jest skamieniałe; cecha tych, którzy są skamieniali"
                        ],
                        "tags": [
                            "deadjectival"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a587af99-530c-3fb1-8473-7080c832ca72",
                        "entry_id": "d11a1a0b-bf92-3181-b28b-8b3b7e0c4c01",
                        "glosses": [
                            "zachowane w skale szczątki organizmu zwierzęcego lub roślinnego albo też utrwalony w skale ślad jego działalności życiowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27475158-4c10-415e-81d3-dd48b9e75671",
                                "sense_id": "a587af99-530c-3fb1-8473-7080c832ca72",
                                "text": "Skamieniałości powstają w wyniku procesu fosylizacji."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "859d257a-c17a-4a14-b187-d3fc8862105f",
                        "source_entry_id": "d11a1a0b-bf92-3181-b28b-8b3b7e0c4c01",
                        "source_sense_id": "a587af99-530c-3fb1-8473-7080c832ca72",
                        "target_lang_word": "fossil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fossil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3828994e-1a92-3820-b37b-86d5b07abaf9",
                                        "entry_id": "816c06a9-d979-39a4-b098-9a05ec5d088a",
                                        "glosses": [
                                            "The mineralized remains of an animal or plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f56a32-ff34-40cc-b307-1a27eab20638",
                                                "sense_id": "3828994e-1a92-3820-b37b-86d5b07abaf9",
                                                "text": "With the permission of the Keeper of the fossil collection, therefore, the specimen was subjected to a further careful removal of the matrix in the requisite directions."
                                            },
                                            {
                                                "example_id": "fe7428a3-9c93-46b6-913e-c3951c5c3437",
                                                "sense_id": "3828994e-1a92-3820-b37b-86d5b07abaf9",
                                                "text": "Within the Hepaticae two types of fossils can be distinguished: those with sufficient characters to assign them to an order and those with more obscure characters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064ba6cd-31ca-3648-b8b7-8a5e4a6853d7",
                                        "entry_id": "816c06a9-d979-39a4-b098-9a05ec5d088a",
                                        "glosses": [
                                            "Any preserved evidence of ancient life, including shells, imprints, burrows, coprolites, and organically-produced chemicals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e0e947-ed7a-493d-8c67-aacb08ffaaa5",
                                                "sense_id": "064ba6cd-31ca-3648-b8b7-8a5e4a6853d7",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record."
                                            },
                                            {
                                                "example_id": "4b17c968-011b-4370-b787-2f089406ee47",
                                                "sense_id": "064ba6cd-31ca-3648-b8b7-8a5e4a6853d7",
                                                "text": "You know what, we’ve got a limited number of heartbeats in this world so if you’re only truly happy researching fossils and can make it work for you, you go for it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3b8f3c-1fdf-388e-81f7-21996a5e3707",
                                        "entry_id": "816c06a9-d979-39a4-b098-9a05ec5d088a",
                                        "glosses": [
                                            "A fossil word."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8498848-e757-3c59-94c6-b51b0b20d968",
                                        "entry_id": "816c06a9-d979-39a4-b098-9a05ec5d088a",
                                        "glosses": [
                                            "Anything extremely old, extinct, or outdated."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04bab56a-d0b3-3dbb-a9dd-a305aa346e16",
                                        "entry_id": "816c06a9-d979-39a4-b098-9a05ec5d088a",
                                        "glosses": [
                                            "An extremely old or outdated person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f82b511-8aa4-4a5d-bd28-09b30162d54c",
                                                "sense_id": "04bab56a-d0b3-3dbb-a9dd-a305aa346e16",
                                                "text": "I do not want to convey any disrespectful notion or slight when I call those good and learned men fossils, but my experience is that people are apt to fossilise even at a University if they follow the same paths too persistently."
                                            },
                                            {
                                                "example_id": "d94400c7-3c57-4ed6-8948-ed52722d9c8e",
                                                "sense_id": "04bab56a-d0b3-3dbb-a9dd-a305aa346e16",
                                                "text": "All at once there was a tapping at the window pane. Atherton was staring at us from without. He shouted through the glass, ‘Come out of that, you fossils! — I’ve news for you!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9b404fa-895f-4279-a706-ab94662a55c7",
                        "source_entry_id": "d11a1a0b-bf92-3181-b28b-8b3b7e0c4c01",
                        "source_sense_id": "a587af99-530c-3fb1-8473-7080c832ca72",
                        "target_lang_word": "fósil",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fósil",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "63198a7b-6072-30a1-ad14-9f02757cdf6e",
                                        "entry_id": "87758376-4422-30dc-b6b2-d8d56be9460e",
                                        "glosses": [
                                            "Restos de seres vivos o rastros de su actividad, conservados en los estratos de las rocas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5ee4f05-261d-4f00-a834-64d842d85841",
                        "source_entry_id": "d11a1a0b-bf92-3181-b28b-8b3b7e0c4c01",
                        "source_sense_id": "a587af99-530c-3fb1-8473-7080c832ca72",
                        "target_lang_word": "Fossil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fossil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "959151d5-4101-32d5-8de1-c612dec3316a",
                                        "entry_id": "c3c95a09-113b-3a8d-aff9-e296a24c4421",
                                        "glosses": [
                                            "(oft versteinertes oder ausgegrabenes) Zeugnis vergangenen Lebens aus der Erdgeschichte, das älter als 10.000 Jahre ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f38ee3-eb7b-48a3-9e97-877914535577",
                                                "sense_id": "959151d5-4101-32d5-8de1-c612dec3316a",
                                                "text": "Viele ausgestorbene Pflanzen- und Tierarten kennt man nur als Fossilien."
                                            },
                                            {
                                                "example_id": "5a09b232-d8a0-4ca3-87d9-8468025d8a52",
                                                "sense_id": "959151d5-4101-32d5-8de1-c612dec3316a",
                                                "text": "„Mit dem passenden Verfahren lässt sich aus versteinerten Fossilien tatsächlich weiches Gewebe isolieren und analysieren.“"
                                            },
                                            {
                                                "example_id": "47074b0a-1306-4834-9cb3-4a9c27ac6807",
                                                "sense_id": "959151d5-4101-32d5-8de1-c612dec3316a",
                                                "text": "„Fossilien und die Archäologie erzählten uns ebenfalls nichts darüber.“"
                                            },
                                            {
                                                "example_id": "d2cdf3dc-2eec-4ce5-906e-8e22551420c2",
                                                "sense_id": "959151d5-4101-32d5-8de1-c612dec3316a",
                                                "text": "Somit konnten viele Schädelteile mit denjenigen heutiger Menschen sowie früheren Fossilien diverser Hominiden verglichen werden."
                                            },
                                            {
                                                "example_id": "ba8abc78-a2ae-41ca-9fe9-e64f6e169c93",
                                                "sense_id": "959151d5-4101-32d5-8de1-c612dec3316a",
                                                "text": "„Sie waren höchst erstaunt, als sie lasen, daß es auf Steinen Abdrücke von Libellen, von Vogelfüßen gibt; und nachdem sie in einem Band von Rorets Handbuch geblättert hatten, begannen sie, nach Fossilien zu suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b52da86-e913-3c58-be2d-c17d2ed4db5c",
                                        "entry_id": "c3c95a09-113b-3a8d-aff9-e296a24c4421",
                                        "glosses": [
                                            "etwas, das als alt beziehungsweise rückständig gilt (Person, Fahrzeug und dergleichen)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
