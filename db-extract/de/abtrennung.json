                        "form": "die Abtrennung"
                    },
                    {
                        "form_id": "afc06070-0557-4c53-9745-2229afc5f780",
                        "entry_id": "f2f3c3c1-c189-3555-b9b5-22e71b3c7a9f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Abtrennungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                        "entry_id": "f2f3c3c1-c189-3555-b9b5-22e71b3c7a9f",
                        "glosses": [
                            "Entfernung/Absonderung eines Teils von einem Ganzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9dfdff-3d5a-44e4-aeb4-5a8c3ec29137",
                                "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                "text": "„Techniken zur Abtrennung und Speicherung von CO 2, so genannte Carbon Capture and Storage-Verfahren (CCS) werden zurzeit viel diskutiert.“"
                            },
                            {
                                "example_id": "ecc281db-39a4-4fef-a9c0-f400e86e6b85",
                                "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                "text": "„Die von den Wirten zur Abtrennung errichteten Glastüren stehen meist offen, um die Arbeit des Personals zu erleichtern, und ebenso oft sind Nichtraucher gezwungen, durch den Raucherbereich zu gehen, um etwa zu den Toiletten oder überhaupt erst zum Nichtraucherbereich zu gelangen – was der Verwaltungsgerichtshof bereits 2013 als nicht gesetzeskonform moniert hatte.“"
                            },
                            {
                                "example_id": "2d51f256-c6b7-4ab3-9900-6cb1c893991b",
                                "sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                                "text": "„Seit vielen Jahrzehnten wird deshalb die Abtrennung eines gewaltigen Staatsgebiets – etwa ein Viertel des deutschen Territoriums – und das Los von mehr als zwölf Millionen Flüchtlingen und Vertriebenen, unter ihnen mindestens 600000 Todesopfer, als Randnotiz des deutschen Jahrhundertverbrechens behandelt, als Fußnote der Nationalerzählung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7643ad49-ef01-491e-8c1e-4acf735dcb6a",
                        "source_entry_id": "f2f3c3c1-c189-3555-b9b5-22e71b3c7a9f",
                        "source_sense_id": "1f23519c-b733-33a0-8a3d-79a330f9186a",
                        "source_sense_description": "Entfernung/Absonderung eines Teils von einem Ganzen",
                        "target_lang_word": "séparation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séparation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a057d21-f145-3833-b3a4-c7cdf0948402",
                                        "entry_id": "6c47801f-d535-3989-b44a-210a5a01d096",
                                        "glosses": [
                                            "Action de séparer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf62097-097a-4358-98c1-d1a71a96e690",
                                                "sense_id": "4a057d21-f145-3833-b3a4-c7cdf0948402",
                                                "text": "Celui-ci promettait naturellement à ses électeurs, comme don de joyeux avènement, la séparation de l’Église et de l’État, l'instruction laïque et la suppression du budget des cultes."
                                            },
                                            {
                                                "example_id": "dff406d6-b1ee-43d0-80dc-eff9cdfa3b0a",
                                                "sense_id": "4a057d21-f145-3833-b3a4-c7cdf0948402",
                                                "text": "Bert avait suivi les péripéties de la catastrophe, depuis la séparation des eaux jusqu’à la culée du pont."
                                            },
                                            {
                                                "example_id": "ae38916d-041b-40f8-86db-eb13741945b7",
                                                "sense_id": "4a057d21-f145-3833-b3a4-c7cdf0948402",
                                                "text": "La séparation en deux de l'ancien continent du Gondwana, amorcée dès le Permien par le golfe d’Arabie vers le N. de Madagascar, ne paraît pas avoir été complète, même au Crétacé supérieur."
                                            },
                                            {
                                                "example_id": "b6c13ad2-0177-4ae8-86d8-c78ed42186f2",
                                                "sense_id": "4a057d21-f145-3833-b3a4-c7cdf0948402",
                                                "text": "Leurs familles très nombreuses leur permirent, petit à petit, d'augmenter leur nombre, de telle sorte, que […], ils forment aujourd'hui, 200 ans après leur séparation de la mère patrie, un bloc de six millions de Français groupés principalement dans la province de Québec."
                                            },
                                            {
                                                "example_id": "c65d8b1b-d47a-4cc6-b7e1-e614561b265a",
                                                "sense_id": "4a057d21-f145-3833-b3a4-c7cdf0948402",
                                                "text": "À coup sûr, l'essence de la laïcité, mis à part la séparation de la religion et de l'État, est l'acceptation de la proposition selon laquelle il n'y a pas de finalité des formes, pas de possession exclusive de la vérité absolue et indivisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a56f50-6b9d-3df1-b2cf-4aff1668ede1",
                                        "entry_id": "6c47801f-d535-3989-b44a-210a5a01d096",
                                        "glosses": [
                                            "Limite ; frontière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414e333c-57c0-4fe1-a206-aa9b46b0472d",
                                                "sense_id": "96a56f50-6b9d-3df1-b2cf-4aff1668ede1",
                                                "text": "Ce moulin donne son nom à un ruisseau qui alimente les moulins à blé de Suzy, de Maneux, de Tervannes et de Barthel et se jette dans l’Ailette à Suzy, après avoir fait la séparation des territoires d’Anizy-le-Château, de Lizy et de Wissignicourt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c6469f-ae9d-35ab-b303-67b6db68889c",
                                        "entry_id": "6c47801f-d535-3989-b44a-210a5a01d096",
                                        "glosses": [
                                            "Action ou fait de s’éloigner ou d'être éloigné de quelqu'un."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb54d982-f5e3-42bc-86ed-eec65ec19c27",
                                                "sense_id": "43c6469f-ae9d-35ab-b303-67b6db68889c",
                                                "text": "Sans doute c’étaient là des paroles de sagesse, ou tout au moins d’expérience. Mais il y avait un fait qui en ce moment, criait plus fort que toutes les paroles, — la séparation.\nJe ne verrais plus celle qui m’avait élevé, qui m’avait caressé, celle que j’aimais, — ma mère.\nEt cette pensée me serrait à la gorge, m’étouffait."
                                            },
                                            {
                                                "example_id": "2457f66e-b2dd-480b-a77e-7ff501f46dc8",
                                                "sense_id": "43c6469f-ae9d-35ab-b303-67b6db68889c",
                                                "text": "La difficulté, la longueur des voyages d'autrefois donnaient quelque chose de solennellement triste aux séparations."
                                            },
                                            {
                                                "example_id": "2cc0b9fa-6616-4351-9e29-06504fe33720",
                                                "sense_id": "43c6469f-ae9d-35ab-b303-67b6db68889c",
                                                "text": "Ce jour-là, au moment de la séparation, spontanément, avec un sourire heureux, Yasmina lui donna un baiser, le premier..."
                                            },
                                            {
                                                "example_id": "4433d2f1-1e31-46e6-8e58-ca126fa2a01c",
                                                "sense_id": "43c6469f-ae9d-35ab-b303-67b6db68889c",
                                                "text": "La guerre s’était enfin achevée. Pour avoir été séparés, nous serions ensemble plus heureux que jamais. Pourtant ces séparations que la vie nous ménage ne sont que la préparation de l’adieu définitif, auquel il faut arriver. Je n’étais revenu que pour quitter mes parents, cette fois sans retour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65437d0-e049-3e80-8250-de304c740b16",
                                        "entry_id": "6c47801f-d535-3989-b44a-210a5a01d096",
                                        "glosses": [
                                            "La chose même qui sépare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dccac8-60ef-469f-928f-c1822f38afd6",
                                                "sense_id": "a65437d0-e049-3e80-8250-de304c740b16",
                                                "text": "Il faut ôter cette séparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10fba34-eb22-3191-97e5-e219f23a67f8",
                                        "entry_id": "6c47801f-d535-3989-b44a-210a5a01d096",
                                        "glosses": [
                                            "Séparation des Églises et de l'État suite à la loi de 1905."
                                        ],
                                        "tags": [
                                            "Absolument",
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3493480e-f126-4561-b3db-b6b31e42e523",
                                                "sense_id": "e10fba34-eb22-3191-97e5-e219f23a67f8",
                                                "text": "Mais il a dû avoir des histoires avec le gouvernement au moment de la séparation ou des inventaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e38d5a-008a-3be1-bd22-7751b6804eed",
                                        "entry_id": "6c47801f-d535-3989-b44a-210a5a01d096",
                                        "glosses": [
                                            "Action d’inclure deux parties disjointes dans deux ouverts disjoints. Possibilité de le faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854c02c4-fc1c-451a-a954-dca2d46e25e3",
                                                "sense_id": "85e38d5a-008a-3be1-bd22-7751b6804eed",
                                                "text": "axiomes de séparation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
