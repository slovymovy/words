                        "entry_id": "ea753443-bded-3f3d-b626-a6593e3a8f82",
                        "glosses": [
                            "To show disrespect by denouncing or insulting; to diss."
                        ],
                        "tags": [
                            "Nigeria",
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "db4bfc71-0306-4279-8ca1-f4893c7ebd71",
                                "sense_id": "b0f17d92-7aa9-39b7-92c1-4e8841f37274",
                                "text": "So Abiola invite Fela to his house for a big party, and Fela have to go as they are family—even though Fela had yabbied Abiola in his song \"ITT\" [International Thief Thief]. And it's true, Abiola duped the country for that money—everybody knows it."
                            }
                        ]
                    }
