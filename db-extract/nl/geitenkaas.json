                        "entry_id": "97f59b93-27a2-3750-a226-e99545c93d66",
                        "glosses": [
                            "van geitenmelk gemaakte kaas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "445928a6-669b-4271-b114-bafb61d26f9e",
                                "sense_id": "7b742588-5a0f-388e-bea7-f9cf2fc075fa",
                                "text": "geitenkaas is lichter verteerbaar en gezonder dan koeienkaas"
                            },
                            {
                                "example_id": "219802fc-716e-4f85-bc2e-4ec5a0dab423",
                                "sense_id": "7b742588-5a0f-388e-bea7-f9cf2fc075fa",
                                "text": "Barbie en ik sloten ons uren op in de keuken om het feestmaal voor te bereiden. Hij concentreerde zich op het maken van taco’s en ik stortte me op een spinaziesalade, vol noten, geitenkaas en kip."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaf1a14b-d11e-40d2-a86b-be48eacc8db0",
                        "source_entry_id": "97f59b93-27a2-3750-a226-e99545c93d66",
                        "source_sense_id": "7b742588-5a0f-388e-bea7-f9cf2fc075fa",
                        "target_lang_word": "Ziegenkäse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziegenkäse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                        "entry_id": "817193a6-6a7b-350e-af52-7c2299b8f417",
                                        "glosses": [
                                            "aus Ziegenmilch hergestellter Käse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3437f8-217d-4b2e-b0f0-6cb8004e2eb5",
                                                "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                                "text": "Für den einen ist Ziegenkäse eine Delikatesse, für den anderen etwas Ungenießbares."
                                            },
                                            {
                                                "example_id": "8f45d5af-e24e-4117-bdcc-c14b26ba325c",
                                                "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                                "text": "„Ich war lange vor Skral aus dem Zimmer gegangen, hatte mich auf diese wackeligen Stühle gesetzt, mir einen starken Tee gekocht und aß Feigen und Ziegenkäse dazu.“"
                                            },
                                            {
                                                "example_id": "314d3113-4397-420a-9342-1b5ef80b96bf",
                                                "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                                "text": "„Er setzte sich an einen leeren Tisch an der Avenue George V und bestellte boeuf à la mode, Salat, Ziegenkäse und eine Karaffe Vouvray.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10508def-a1df-4a29-accb-fe2f687f3f26",
                        "source_entry_id": "97f59b93-27a2-3750-a226-e99545c93d66",
