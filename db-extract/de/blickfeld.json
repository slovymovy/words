                ],
                "senses": [
                    {
                        "sense_id": "23cc216a-3c09-3239-9038-05d173c47459",
                        "entry_id": "cf8d9a96-58f1-3841-870e-a55917136863",
                        "glosses": [
                            "Bereich, den man überblicken/mit den Augen erfassen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5da8276-7740-4b39-9cff-f8d59723781e",
                                "sense_id": "23cc216a-3c09-3239-9038-05d173c47459",
                                "text": "„Wir sehen ihr nach, sehen, wie sie ihren Pass auf den Tresen legt, nach der Kontrolle wieder in der Handtasche verstaut und über eine Rolltreppe nach oben aus unserem Blickfeld verschwindet.“"
                            },
                            {
                                "example_id": "07d29e5b-644d-4255-bb7e-970ac2bfff6b",
                                "sense_id": "23cc216a-3c09-3239-9038-05d173c47459",
                                "text": "„Vier Jahre lang starrte das Weltraumteleskop Kepler in den Himmel, rund 150.000 Sterne wanderten seit 2009 durch sein Blickfeld.“"
                            },
                            {
                                "example_id": "278ba3cc-bb89-43c6-9e2a-3558f870f190",
                                "sense_id": "23cc216a-3c09-3239-9038-05d173c47459",
                                "text": "„Sie hob ihre Hände in sein Blickfeld und gebärdete dort.“"
                            },
                            {
                                "example_id": "7e4d9b29-d5e6-4917-a732-8dcff21288f2",
                                "sense_id": "23cc216a-3c09-3239-9038-05d173c47459",
                                "text": "„Er stand vor einem hohen Richtertisch, der so lang war, dass er weit über beide Seiten seines Blickfeldes hinausging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
