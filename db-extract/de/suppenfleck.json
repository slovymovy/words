                "senses": [
                    {
                        "sense_id": "670a0c59-da91-3b9c-a6d7-ba60f2de9ad7",
                        "entry_id": "bc59c1bf-34de-3f7f-a49c-1da24fd8ba5c",
                        "glosses": [
                            "ungewollter, sichtbarer Rückstand/Fleck von Suppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267228fd-9af9-470d-8c17-1522c57a6ae6",
                                "sense_id": "670a0c59-da91-3b9c-a6d7-ba60f2de9ad7",
                                "text": "„Seine Kleidung wirkte wie eine Parodie auf die eines Geistlichen, ein schmutziger, ehemals weißer Kragen, ein angestaubtes Jackett, eine schwarze Weste, die mit Suppenflecken übersät war.“"
                            },
                            {
                                "example_id": "746bb3fb-70ab-4c20-b303-54bc8184d60f",
                                "sense_id": "670a0c59-da91-3b9c-a6d7-ba60f2de9ad7",
                                "text": "„Was ›Mr. Brown‹ anbelangt, der war übergewichtig, das Hemd hing ihm aus der Hose, und er hatte einen Suppenfleck auf der Krawatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
