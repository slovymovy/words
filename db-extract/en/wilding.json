                    {
                        "sense_id": "52a2c24a-bb2c-3d50-9d07-44fa7bfdeff1",
                        "entry_id": "f6828a35-f4fb-3b16-8845-9b1ab64d80b4",
                        "glosses": [
                            "A wild apple or apple tree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08cb4fd-1439-4c8a-a052-7bacd8085255",
                                "sense_id": "52a2c24a-bb2c-3d50-9d07-44fa7bfdeff1",
                                "text": "These were ‘wildings’, wild crab apples (Malus sylvestris), a miniature of today's, native to the British Isles."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a973ad7-bf9a-3b3b-9921-c8aecf6c4e5e",
                        "entry_id": "f6828a35-f4fb-3b16-8845-9b1ab64d80b4",
                        "glosses": [
                            "Any plant that grows wild; a wildflower, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed81011-2108-43cb-9655-2d2e344ab43e",
                                "sense_id": "9a973ad7-bf9a-3b3b-9921-c8aecf6c4e5e",
                                "text": "Oft from the forrest wildings he did bring, / Whose sides empurpled were with smiling red […]"
                            },
                            {
                                "example_id": "fa9503a3-d881-491c-ac4d-51187d0b8e23",
                                "sense_id": "9a973ad7-bf9a-3b3b-9921-c8aecf6c4e5e",
                                "text": "Ten ruddy wildings in the wood I found."
                            },
                            {
                                "example_id": "7bf94649-9b61-48ae-8964-b74371945a48",
                                "sense_id": "9a973ad7-bf9a-3b3b-9921-c8aecf6c4e5e",
                                "text": "The fruit of the tree […] is small, of little juice, and bad quality. I presume it to be a wilding."
                            }
                        ]
                    }
                ],
