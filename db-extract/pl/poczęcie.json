                            {
                                "example_id": "ad67a0ca-7632-46c7-b938-18f65c228bf6",
                                "sense_id": "439f5705-3b58-3e1b-8d09-a42b2091668a",
                                "text": "Od 1983 roku aborcja jest w Turcji legalna do 10. tygodnia od poczęcia."
                            }
