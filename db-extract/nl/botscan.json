                "senses": [
                    {
                        "sense_id": "40544f4a-7209-3c3a-81af-f87c1bf0d226",
                        "entry_id": "9a571f04-f159-3494-9d88-9ecbc91f7ab7",
                        "glosses": [
                            "beeldvormende techniek in de geneeskunde waarbij een afbeelding gemaakt wordt van het skelet door dit eerst 'op te laden' met een radio-actieve isotoop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e1efef-d5e0-487c-ba90-a1ed673c83da",
                                "sense_id": "40544f4a-7209-3c3a-81af-f87c1bf0d226",
                                "text": "Molybdeen wordt bijvoorbeeld gebruikt bij botscans en het herkennen van bepaalde kankervormen en hartfalen."
                            },
                            {
                                "example_id": "3018e662-f282-418a-b475-a8be29126c9a",
                                "sense_id": "40544f4a-7209-3c3a-81af-f87c1bf0d226",
                                "text": "De 61-jarige zangeres brak twee weken geleden haar linkerbeen op drie plaatsen tijdens een VVD-bijeenkomst. Zij zit nog minimaal twee weken in het gips. „Dan botscan en opnieuw de wonden controleren. Nog maar ff geduld hebben dus”, schrijft ze op Facebook."
                            },
                            {
                                "example_id": "57079ec6-629d-4607-910d-b8f5bfe3b1b1",
                                "sense_id": "40544f4a-7209-3c3a-81af-f87c1bf0d226",
                                "text": "Derk Boerrigter kan volledig fit aan de voorbereiding op het nieuwe seizoen beginnen. Dat zei de linksbuiten van Ajax maandag bij terugkeer van vakantie. Hij had zojuist nog in het ziekenhuis een botscan laten maken van zijn rug. 'Mijn rug voelde de afgelopen weken tijdens de vakantie al goed aan en de scan heeft dat vandaag bewezen. Ik ben helemaal fit om aan het nieuwe seizoen te beginnen', liet hij weten op de website van Ajax."
                            },
                            {
                                "example_id": "74ac9f06-cc40-41e7-85a4-a6d5eba0f221",
                                "sense_id": "40544f4a-7209-3c3a-81af-f87c1bf0d226",
                                "text": "Bloedonderzoek is belangrijk om te beoordelen of er sprake is van een infectie. Met een botscan kan worden bekeken of de fixatie van de prothese aan het bot voldoet."
                            }
                        ]
                    }
