                    {
                        "sense_id": "3e74b9e1-3915-3e7c-b9db-86553dfe4f14",
                        "entry_id": "6aee17a6-fefc-37c2-8677-a7ee08a9a554",
                        "glosses": [
                            "siłą rzeczy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d611b5-5f1e-47c7-bb96-967ced67f69a",
                                "sense_id": "3e74b9e1-3915-3e7c-b9db-86553dfe4f14",
                                "text": "Nicht jede Demokratie ist notwendigerweise liberal.",
                                "translation": "Nie każda demokracja jest siłą rzeczy liberalna."
                            },
                            {
                                "example_id": "67cf3bab-fd69-4c88-ae0b-15f8468bce79",
                                "sense_id": "3e74b9e1-3915-3e7c-b9db-86553dfe4f14",
                                "text": "Mit Stevia gesüßte Produkte sind nicht notwendigerweise zuckerfrei.",
                                "translation": "Produkty słodzone stewią są niekoniecznie pozbawione cukru."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
