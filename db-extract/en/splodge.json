                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf6e1c5-13e8-4630-80e3-c701f9ab650e",
                                                "sense_id": "c2cf1f1c-1a34-3650-a5e9-e22e3ffffe9d",
                                                "text": "„Und was tat sie? Sie bereitete sich Tage und Wochen vor, um Kirschblüten zu malen, Zitronen, Mohnblumen, Flaschen. Nein, sie bekleckste einfältig Leinwände!“"
                                            },
                                            {
                                                "example_id": "e0465cbc-f675-4104-af94-3726c5491a1b",
                                                "sense_id": "c2cf1f1c-1a34-3650-a5e9-e22e3ffffe9d",
                                                "text": "„Eines Tages, die Palette in der Hand, riß Lucien plötzlich vollkommen aufgelöst und über und über mit Farbe bekleckst die Tür auf und starrte suchend in den Schatten.“"
                                            },
                                            {
                                                "example_id": "340d2df6-dd5f-4013-bbf8-437109399ffa",
                                                "sense_id": "c2cf1f1c-1a34-3650-a5e9-e22e3ffffe9d",
                                                "text": "„Und so wie Tinte aus einem leckenden Federhalter lassen wir zu, dass die Vergangenheit unsere strahlende Zukunft bekleckst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
