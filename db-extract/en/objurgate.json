                    {
                        "translation_id": "c809dd84-5687-4c4e-8581-c44c8568b2af",
                        "source_entry_id": "dc86fd1e-d56f-3a09-a53a-5aff45ada2bf",
                        "source_sense_id": "11a7c24d-be0b-390e-a843-13aca5a6a37b",
                        "source_sense_description": "jemanden tadeln, schelten",
                        "target_lang_word": "tadeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tadeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                        "entry_id": "d5f9227a-e547-317e-a489-313bffc7fbcd",
                                        "glosses": [
                                            "das Verhalten einer Person bemängeln, kritisieren, etwas nicht gutheißen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0737e63f-105c-401c-9e05-0109b1b5311a",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "Der Lehrer tadelt seine Schüler, weil sie die Vokabeln nicht beherrschen."
                                            },
                                            {
                                                "example_id": "4a279a2f-6334-423e-960c-caefb0683a91",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "Wieso tadelst du mich mit erhobenem Finger? Ich habe überhaupt nichts Verwerfliches getan."
                                            },
                                            {
                                                "example_id": "89ec26fd-b88a-4dc8-b3eb-239500bf37ae",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "„Ihr tadeltet meinen langen Schlummer, Ihr warft mir vor, die Interessen des Vaterlandes meiner Ruhe zu opfern.“ (1828)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d353e57a-f7d0-46f4-aeb6-e0513eeddb49",
                        "source_entry_id": "dc86fd1e-d56f-3a09-a53a-5aff45ada2bf",
                        "source_sense_id": "11a7c24d-be0b-390e-a843-13aca5a6a37b",
                        "source_sense_description": "jemanden tadeln, schelten",
                        "target_lang_word": "schelten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schelten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c5cb24-9cab-3645-a4df-dc87d6cb2266",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "schimpfen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b14d8e-6e13-4d93-a4e5-121877f51b6e",
                                                "sense_id": "f8c5cb24-9cab-3645-a4df-dc87d6cb2266",
                                                "text": "Arnd schalt, weil niemand ihm zu Hilfe eilte, als er in die Baugrube gefallen war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99662879-c861-36c3-aad1-4aae98794215",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "ausschimpfen, schmähen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff492b5-8d81-4010-b7c6-9d9214be7f85",
                                                "sense_id": "99662879-c861-36c3-aad1-4aae98794215",
                                                "text": "Ich schelte ihn nicht, obwohl er meinen Spitzer verloren hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0f3f2aee-4e2f-36eb-83c8-cd7387898980",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "jemanden als etwas bezeichnen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2824307-e7d9-43ac-ac9b-c513d40a2fc1",
                                                "sense_id": "0f3f2aee-4e2f-36eb-83c8-cd7387898980",
                                                "text": "Sie schalt ihn einen Dummkopf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9ab22836-7220-3e36-a054-ac1552b241b7",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "tadeln, Kritik üben"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9469430d-9ead-4214-9ac6-3d53e6008194",
                                                "sense_id": "9ab22836-7220-3e36-a054-ac1552b241b7",
                                                "text": "Du musst nicht immer so vieles schelten."
                                            },
                                            {
                                                "example_id": "a6dfb2f0-fb9f-4621-a46c-d26872d8a0a5",
                                                "sense_id": "9ab22836-7220-3e36-a054-ac1552b241b7",
                                                "text": "Dass wir schelten, heißt nur, dass wir die reine Wahrheit sagen."
                                            },
                                            {
                                                "example_id": "9030c43e-7719-423f-8a35-75db2f2f5fc0",
                                                "sense_id": "9ab22836-7220-3e36-a054-ac1552b241b7",
                                                "text": "„Manchmal klopfte ihr Herz sogar in Erwartung des Postboten. Doch dann schalt sie sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a7e9c02d-9b04-33ec-ba08-15b8e5dd6018",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "fluchen, lästern"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ebbbb04-13b5-499f-b341-c0a8a1a70f28",
                                                "sense_id": "a7e9c02d-9b04-33ec-ba08-15b8e5dd6018",
                                                "text": "Zu schelten und zu sakramentieren wurde nicht allein mit einer hohen Geldstrafe bestraft, sondern an Leib und Gut."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "ef8a8a13-a111-38ad-95c2-136595986344",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "jemanden mit einem Spottnamen belegen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1057421f-38f3-4314-9b5f-02afd2988110",
                                                "sense_id": "ef8a8a13-a111-38ad-95c2-136595986344",
                                                "text": "Wer ein Kind eine Mähre schilt, schlägt seinem Vater aufs Ohr."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "197ee3a1-5133-3199-8c18-9a1378384e27",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "jemandem einen ehrenwerten Titel verleihen, um damit auszudrücken, dass dies eigentlich unverdient ist"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d7feccf-2750-4d8e-a47d-be03d5d3a5ce",
                                                "sense_id": "197ee3a1-5133-3199-8c18-9a1378384e27",
                                                "text": "Man schilt ihn einen „redlichen Mann“."
                                            },
                                            {
                                                "example_id": "d79bbd57-414a-4c20-a04b-21a951278c85",
                                                "sense_id": "197ee3a1-5133-3199-8c18-9a1378384e27",
                                                "text": "Du lässt dich für einen Wohltäter schelten."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "f3ae882a-6c43-36c9-ba9d-281f0fa4fedd",
                                        "entry_id": "0f3f89e9-6c55-367c-a0ad-ccb9532b818a",
                                        "glosses": [
                                            "sich mit jemandem zanken"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b8adde-77de-42c5-8454-688f8702cbf0",
                                                "sense_id": "f3ae882a-6c43-36c9-ba9d-281f0fa4fedd",
                                                "text": "Er schilt sich wieder einmal mit Johann."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "fe47186d-8822-3c4b-a3cd-cb87c4c64495",
