                                    {
                                        "sense_id": "bd3e97dd-3d8c-354a-ab2b-004d4aba0d43",
                                        "entry_id": "913a830f-e054-3418-8cce-629cf254b57f",
                                        "glosses": [
                                            "Unité de mesure de longueur (symbole M ou NM) ayant la valeur d’une minute de latitude à la surface de la Terre, maintenant définie comme 1,852 mètres exactement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814e5d79-d83f-4040-8543-4b5aabf4126f",
                                                "sense_id": "bd3e97dd-3d8c-354a-ab2b-004d4aba0d43",
                                                "text": "Son souffle à peine perceptible soulevait délicatement les draps. Mais c’était assez pour rassurer un homme haletant, à 7.000 milles marins de sa patrie, les pieds nus sur un lourd tapis."
                                            }
                                        ]
                                    }
                                ]
