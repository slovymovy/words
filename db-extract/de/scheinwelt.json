                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd4455f-2927-4b04-9936-f5613e6d1c5d",
                                "sense_id": "51894705-f57c-3a4b-b585-3582084eab10",
                                "text": "„Jeden Tag nahmen mehrere tausend Gehetzte die Rolltreppe, um in die Kulissen einer orientalischen Scheinwelt einzutauchen.“"
                            },
                            {
                                "example_id": "987d21c5-aca2-425d-bb18-0d4cd7877479",
                                "sense_id": "51894705-f57c-3a4b-b585-3582084eab10",
                                "text": "„Ein Roman über die Weimarer Jahre wird es, über die Überlebenden des Krieges in der Scheinwelt des Friedens.“"
                            },
                            {
                                "example_id": "48078368-667a-4301-978b-c2671c9bf476",
                                "sense_id": "51894705-f57c-3a4b-b585-3582084eab10",
                                "text": "„Für mich war es der Tag, an dem die Scheinwelt in meinem Kopf verschwand, und im Spiegel vor mir der Mann erschien, der ich in Wirklichkeit war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
