                                            {
                                                "example_id": "58259d55-1322-4e22-b20e-3d5c51a619c0",
                                                "sense_id": "7b54b4a4-9095-3abd-be1d-87622bc52d7a",
                                                "text": "W przeszłości mieścił się w tym budynku zakon jezuitów."
                                            },
                                            {
                                                "example_id": "39e6c268-e9bb-4417-ab9f-fa72cb6cbb7b",
                                                "sense_id": "7b54b4a4-9095-3abd-be1d-87622bc52d7a",
                                                "text": "Ludmiła zna trzech zakonników: karmelitę, jezuitę i franciszkanina."
                                            }
