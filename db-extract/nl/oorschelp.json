                        "source_sense_id": "cd888ebf-c15b-308b-963c-214c30a28027",
                        "source_sense_description": "het uit het hoofd stekende deel van een oor",
                        "target_lang_word": "Ohrmuschel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrmuschel",
