                                "example_id": "e2f2728c-8e92-4b8a-a6a3-b5a2123315c9",
                                "sense_id": "c88995a5-058e-37bf-8197-1922bd93d102",
                                "text": "To these fourhanded animals of the ancient continent, we may add the fourhanded animals of the new, that use their hands like the former, as well as their tails, and that fill up the chasm between the monkey tribe and the lower orders of the forest."
                            },
                            {
                                "example_id": "38865eaa-e1b2-4d53-a2ee-76a53b16e2e7",
                                "sense_id": "c88995a5-058e-37bf-8197-1922bd93d102",
                                "text": "Here, fourhanded Visnu is seen seated on Garuda who has a human body with curly hair and leaf-like feathers."
                            }
                        ]
                    },
                    {
                        "sense_id": "929a2983-90fb-3cb0-a762-e3c7db2fa765",
                        "entry_id": "cdb05501-c363-3be1-a61b-b0069906d746",
