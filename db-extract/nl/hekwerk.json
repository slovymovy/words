                ],
                "translations": [
                    {
                        "translation_id": "28470829-f03e-4636-9e1a-5f28b250b09f",
                        "source_entry_id": "f2210351-d809-3c7e-bc17-4b09803fb06d",
                        "source_sense_id": "0f699011-7ce1-3a07-9905-aa715b9c8907",
                        "source_sense_description": "het geheel van staven etc. waardoor een hek wordt gevormd, rastering of balustrade",
                        "target_lang_word": "Gitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79186f35-a2d1-3c3b-98e8-1669e26dd65f",
                                        "entry_id": "c88524e0-cb0b-3efa-b6e3-f38f41c51a73",
                                        "glosses": [
                                            "Geflecht, meist aus Draht, Stahl oder Holz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10be868e-bae9-4895-a00b-af078378aade",
                                                "sense_id": "79186f35-a2d1-3c3b-98e8-1669e26dd65f",
                                                "text": "Ein Gitter versperrte den Weg."
                                            },
                                            {
                                                "example_id": "e3644a3c-e87b-4fbb-aafd-7d57124e85b3",
                                                "sense_id": "79186f35-a2d1-3c3b-98e8-1669e26dd65f",
                                                "text": "„Man steht am Zellenfenster und sieht durchs Gitter auf den Hof.“"
                                            },
                                            {
                                                "example_id": "4d4847f9-a9be-4ebf-8040-7d82eb9ea847",
                                                "sense_id": "79186f35-a2d1-3c3b-98e8-1669e26dd65f",
                                                "text": "„Um durch das enge Gitter vor dem Fenster zu kommen, muß man fast ein Zirkusakrobat sein, so Blume.“"
                                            },
                                            {
                                                "example_id": "1761657f-0871-41a4-9604-ed76c49a8b8c",
                                                "sense_id": "79186f35-a2d1-3c3b-98e8-1669e26dd65f",
                                                "text": "„Bei dem als Bodyflying bezeichneten Sport begibt sich der Sportler, mit Helm, Brille, Mundschutz, Handschuhen und vor allem einem speziellen Anzug ausgestattet, in einen Luftstrom, der durch ein Gitter hindurch senkrecht in die Höhe strebt.“"
                                            },
                                            {
                                                "example_id": "9c37fdc5-3d64-44e2-9223-096b913dd9ae",
                                                "sense_id": "79186f35-a2d1-3c3b-98e8-1669e26dd65f",
                                                "text": "„Wir werden vor ein Gitter geführt, hinter dem ein langer und dunkler Gang mehr zu ahnen als zu sehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa210114-fa61-3900-98d9-e86c96940b05",
                                        "entry_id": "c88524e0-cb0b-3efa-b6e3-f38f41c51a73",
                                        "glosses": [
                                            "Elektrode einer Elektronenröhre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051024cb-e223-4b77-bb80-43938842b6d2",
                                                "sense_id": "aa210114-fa61-3900-98d9-e86c96940b05",
                                                "text": "Eine Pentode besitzt drei Gitter: Steuergitter, Schirmgitter und Bremsgitter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf04dee3-c63f-4610-aa8a-72f7e1246c24",
                        "source_entry_id": "f2210351-d809-3c7e-bc17-4b09803fb06d",
                        "source_sense_id": "0f699011-7ce1-3a07-9905-aa715b9c8907",
                        "source_sense_description": "het geheel van staven etc. waardoor een hek wordt gevormd, rastering of balustrade",
                        "target_lang_word": "Geländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                        "entry_id": "2e32cab6-04e2-386b-80b4-47ce3c53865e",
                                        "glosses": [
                                            "Konstruktion zum Festhalten entlang von Wegen oder Treppen sowie um Flächen, um Sicherheit gegen einen Absturz zu bieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6185abb-db1a-4610-9646-70e9762a4e06",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "Halte Dich gut am Geländer fest, wenn Du die steile Treppe hinunter gehst!"
                                            },
                                            {
                                                "example_id": "4efd1a83-06a4-4898-91fa-6bf8d9cdaa27",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "Es ist verboten, über das Geländer zu klettern!"
                                            },
                                            {
                                                "example_id": "49b55b7d-5ce1-4c88-8859-c45c276a7a68",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Jetzt muß sie im ersten Stockwerk innehalten, ihre Hand wird im Dunkel des Flurs nach den Bogen des gewellten Geländers tasten, ihr Fuß die schiefe, ausgetretene Treppe suchen, die zum zweiten Stockwerk führt.“"
                                            },
                                            {
                                                "example_id": "7217f40e-5828-4c2f-9bb6-4415b1026925",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Der rote Jude trat wieder in das Haus, entdeckte den andern am Geländer zuerst nicht.“"
                                            },
                                            {
                                                "example_id": "6b507f3d-9fa7-48a2-b5ca-dcf79461e449",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Mißmutig tritt Eos an das Geländer ihres Balkons und bemerkt plötzlich tief unter sich einen Mann, der in der ersten Etage eines der kleineren Häuser in der Nachbarschaft ein Fenster aufgestoßen hat und hinaussieht.“"
                                            },
                                            {
                                                "example_id": "6ed4f14e-93af-42ea-be82-49707bf30dff",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Er ging zurück ins Wohnzimmer, wankte zum Treppenhaus hinaus, hielt sich am Geländer fest und wühlte in seinen Taschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6ea3332-6cd1-4256-b495-aa8d1da11aaa",
                        "source_entry_id": "f2210351-d809-3c7e-bc17-4b09803fb06d",
                        "source_sense_id": "0f699011-7ce1-3a07-9905-aa715b9c8907",
                        "source_sense_description": "het geheel van staven etc. waardoor een hek wordt gevormd, rastering of balustrade",
                        "target_lang_word": "verja",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verja",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "38c4288a-646c-356f-83e5-eda3b9612e6b",
                                        "entry_id": "b3025882-7c15-3fca-9b5c-0d95d5d946c3",
                                        "glosses": [
                                            "Cerca de hierro con enlazados, balaustres y pilastras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7cd30ad-ee43-4426-8211-5c08b69f4a5f",
                                                "sense_id": "38c4288a-646c-356f-83e5-eda3b9612e6b",
                                                "text": "Tras una verja distingo un jardín abandonado."
                                            },
                                            {
                                                "example_id": "3f07ca31-9bfe-4fe5-a278-714b22eea3b2",
                                                "sense_id": "38c4288a-646c-356f-83e5-eda3b9612e6b",
                                                "text": "Pero cuando empuja la verja y pilastras el jardín de su casa, la lluvia se despeña torrencial."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
