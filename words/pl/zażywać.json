                {
                    "sense_id": "929c333d-bb60-327c-bca5-ea2178bed748",
                    "sense_definition": "przyjmować do organizmu lekarstwo, witaminy lub inną substancję",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "przyjmowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek regularnie <w>zażywa</w> przepisane przez lekarza tabletki na serce.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка регулярно <w>принимает</w> прописанные врачом сердечные таблетки."
                            }
                        },
                        {
                            "text": "Musisz <w>zażywać</w> te krople trzy razy dziennie po posiłku.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>пить</w> эти капли три раза в день после еды."
                            }
                        }
                    ],
                    "synonyms": [
                        "brać",
                        "łykać",
                        "połykać",
                        "przyjmować"
                    ],
                    "common_phrases": [
                        "zażywać leki",
                        "zażywać tabletki",
                        "zażywać witaminy"
                    ],
                    "target_lang_definitions": {
                        "ru": "принимать внутрь лекарство, витамины или другое вещество"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "лекарства, таблетки"
                            },
                            {
                                "target_lang_word": "употреблять",
                                "target_lang_sense_clarification": "вещества, лекарства"
                            },
                            {
                                "target_lang_word": "пить",
                                "target_lang_sense_clarification": "таблетки, капли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29cbd0f5-1a55-3756-9d2e-763a91486faa",
                    "sense_definition": "korzystać z czegoś przyjemnego, doświadczać wypoczynku lub relaksu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doświadczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W słoneczne popołudnia turyści chętnie <w>zażywają</w> kąpieli w czystym jeziorze.",
                            "target_lang_translations": {
                                "ru": "Солнечными днями туристы с удовольствием <w>купаются</w> в чистом озере."
                            }
                        },
                        {
                            "text": "Po wielu godzinach pracy przed komputerem poszedł do parku <w>zażywać</w> świeżego powietrza.",
                            "target_lang_translations": {
                                "ru": "После долгих часов работы за компьютером он пошёл в парк <w>подышать</w> свежим воздухом."
                            }
                        }
                    ],
                    "synonyms": [
                        "doświadczać",
                        "doznawać",
                        "mieć",
                        "zaznawać"
                    ],
                    "common_phrases": [
                        "zażywać kąpieli",
                        "zażywać świeżego powietrza",
                        "zażywać odpoczynku"
                    ],
                    "target_lang_definitions": {
                        "ru": "наслаждаться чем-либо приятным, предаваться отдыху или релаксации"
                    },
                    "translations": {
