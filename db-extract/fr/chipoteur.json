                                        "glosses": [
                                            "One who complains or fusses a great deal, especially about unimportant matters; a fusspot."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d085f01-6575-40ed-9346-6b7e985c63fa",
                                                "sense_id": "8d822697-335f-3bae-a548-54c35381bb65",
                                                "text": "Their three-year-old daughter can be quite a fussbudget, but she's cute."
                                            },
                                            {
                                                "example_id": "73b54480-9b85-4d91-b3d2-d4dab7851b40",
                                                "sense_id": "8d822697-335f-3bae-a548-54c35381bb65",
                                                "text": "The nation's 50 million smokers remain at liberty to vote en bloc for a fussbudget-free Congress. Are the polls ready to accommodate smokers?"
