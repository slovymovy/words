                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "238bea77-ef5f-38ed-b8df-70c2567f7a95",
                                        "entry_id": "8c67028b-f035-3928-b6f0-6f43a366fd37",
                                        "glosses": [
                                            "Empfehlung, sich in einer bestimmten Weise zu verhalten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb698d1e-637b-42ca-8260-7f2985e9f0fe",
                                                "sense_id": "238bea77-ef5f-38ed-b8df-70c2567f7a95",
                                                "text": "Ich weiß nicht, aber dein Rat gefällt mir nicht."
                                            },
                                            {
                                                "example_id": "0a1d00e4-7514-4fc5-9a63-cd15412b3704",
                                                "sense_id": "238bea77-ef5f-38ed-b8df-70c2567f7a95",
                                                "text": "„Häufig suchen auch die Anwälte reicher Anleger seinen Rat, wenn sie Ärger mit der Steuer befürchten.“"
                                            },
                                            {
                                                "example_id": "d5498cb8-7f54-4452-9107-5c640e3488cb",
                                                "sense_id": "238bea77-ef5f-38ed-b8df-70c2567f7a95",
                                                "text": "„Wo nicht weiser Rat ist, da geht das Volk unter; wo aber viele Ratgeber sind, findet sich Hilfe.“"
                                            },
                                            {
                                                "example_id": "03593ae7-34e2-4d5c-87d2-a58627f74ffe",
                                                "sense_id": "238bea77-ef5f-38ed-b8df-70c2567f7a95",
                                                "text": "„Es war der einzige menschliche Rat, an meine Person ergangen, die längst aller Ratgeber ledig war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f611c480-c770-3041-9d43-c35486c1b2d7",
                                        "entry_id": "8c67028b-f035-3928-b6f0-6f43a366fd37",
                                        "glosses": [
                                            "beratendes Gremium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "909ac9ca-1f35-4349-a575-d052b5d7029e",
                                                "sense_id": "f611c480-c770-3041-9d43-c35486c1b2d7",
                                                "text": "Am Samstag fasste der Rat den Beschluss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "66794768-f100-39bc-a878-8ddae257653a",
                                        "entry_id": "8c67028b-f035-3928-b6f0-6f43a366fd37",
                                        "glosses": [
                                            "ein Mitglied eines Gremiums; Amtsbezeichnung für ein solches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cab0a93-0c0e-4d81-941b-ea675992192a",
                                                "sense_id": "66794768-f100-39bc-a878-8ddae257653a",
                                                "text": "Er versah seine Aufgaben als Rat dieser Stadt recht ordentlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7cca99ee-f0cc-35bd-8e87-a4d733d53639",
                                        "entry_id": "8c67028b-f035-3928-b6f0-6f43a366fd37",
                                        "glosses": [
                                            "Amtsbezeichnung im öffentlichen Dienst; Eingangsamt im höheren Dienst der Bundesrepublik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32573749-a625-4772-8596-917290672e83",
                                                "sense_id": "7cca99ee-f0cc-35bd-8e87-a4d733d53639",
                                                "text": "Als Rat verdient man noch nicht so viel."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
