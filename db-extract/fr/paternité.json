                    },
                    {
                        "translation_id": "ba258cc0-6db5-45de-8af5-98662d943be8",
                        "source_entry_id": "017831aa-7ec1-3311-aef0-235bd1df8cac",
                        "source_sense_id": "367351e2-f86f-38b5-a02f-37ea30ac243c",
                        "source_sense_description": "État, qualité de père",
                        "target_lang_word": "ojcostwo",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ojcostwo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "30b0de9b-f45f-358d-9317-5f0ca425a0e7",
