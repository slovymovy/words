                    },
                    {
                        "translation_id": "ff9064e6-26d6-4ee2-89f4-b8a89e3315e3",
                        "source_entry_id": "665f4244-48df-30a2-995d-1d49ce5d3e9f",
                        "source_sense_id": "cb4158ed-3ce4-3cf3-b9ea-9936c8046cfb",
                        "source_sense_description": "Musik, Holzblasinstrumente: eine Flöte, die beim Blasen quer gehalten wird",
                        "target_lang_word": "flûte traversière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flûte traversière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0878ce1c-ee9f-3c5a-af63-ff66b825a5d4",
                                        "entry_id": "4abe39eb-36d0-3a48-b555-b4ec7febf094",
                                        "glosses": [
                                            "Nom générique des flûtes à embouchure libre dont le biseau est situé au milieu du corps de l’instrument et que l’on tient de travers, de manière latérale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc3dab22-7437-3d6e-ac6a-aef1537e35fb",
                                        "entry_id": "4abe39eb-36d0-3a48-b555-b4ec7febf094",
                                        "glosses": [
                                            "Nom courant des flûtes traversières classiques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e7c7c8-7975-4576-bceb-5598e37f2263",
                                                "sense_id": "bc3dab22-7437-3d6e-ac6a-aef1537e35fb",
                                                "text": "Les Gymnopédies de Satie et les valses de Chopin seront pour moi à jamais attachées à elle, tout comme Bach l’est à mon père qui jouait de la flûte traversière."
                                            },
                                            {
                                                "example_id": "47dd9ccb-23d1-4de0-80a0-fd2fa022ba57",
                                                "sense_id": "bc3dab22-7437-3d6e-ac6a-aef1537e35fb",
                                                "text": "Il sera ensuite temps de se détendre autour d’un concert en plein air avec le duo baroque composé de Clémence Schweyer, au clavecin, et de Guillaume Handel, à la flûte traversière."
                                            },
                                            {
