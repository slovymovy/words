                "senses": [
                    {
                        "sense_id": "f65d826f-0407-3a64-a290-232934789646",
                        "entry_id": "047a01e2-ac39-3588-8996-dc129eeafd16",
                        "glosses": [
                            "Frau, die in der Beziehung zu ihrem Kind makellos perfekt auftritt/erscheint und Vorbildfunktion erreicht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f61b95-25b3-4331-ada2-bab263428e1f",
                                "sense_id": "f65d826f-0407-3a64-a290-232934789646",
                                "text": "„So erzählt Under the Skin u.a. die Geschichte von Kindern, die in der Mutter eine Heilige sehen und die durch das plötzliche Nicht-Mehr-Vorhandensein dieser Übermutter in die Promiskuität bzw. in die eigene Geringschätzung abgleiten.“"
                            },
                            {
                                "example_id": "020d5b04-5b79-4862-af8f-3604c9f371c3",
                                "sense_id": "f65d826f-0407-3a64-a290-232934789646",
                                "text": "„Häufig leiden Patienten mit hyperthyreoter Stoffwechsellage unter ungesund erhöhten Selbstansprüchen, sind Workaholics, Übermütter/- väter oder beides. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef279531-b62d-3e25-b322-d4fd389a66c6",
                        "entry_id": "047a01e2-ac39-3588-8996-dc129eeafd16",
                        "glosses": [
                            "Frau, die in der Beziehung zu ihren Schutzbefohlenen makellos perfekt auftritt/erscheint und Vorbildfunktion erreicht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7ed54c3-e38f-494b-a140-c29e7fb6c9fd",
                                "sense_id": "ef279531-b62d-3e25-b322-d4fd389a66c6",
                                "text": "„Ganz anders hingegen Angela Merkel. In verschiedenen Medienberichten über sie findet sich im Vorfeld der Bundestagswahl 2013 die Metapher von der „Mutter“, teilweise auch der „Übermutter der Nation“.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
