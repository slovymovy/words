                                                "sense_id": "f035ca67-7830-3c57-aa5d-e4257664da8d",
                                                "text": "The tides ebbed at noon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4002cd69-6dbb-38c1-bff8-f7baf7cf6cb0",
                                        "entry_id": "d697059b-a602-36af-9949-8128f74ac040",
                                        "glosses": [
                                            "to fall away or decline"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1450e9d-dfab-49b0-ad30-28c008b740e8",
                                                "sense_id": "4002cd69-6dbb-38c1-bff8-f7baf7cf6cb0",
                                                "text": "The dying man's strength ebbed away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b872e3f3-c445-36e5-8159-eb4dcfe70f65",
                                        "entry_id": "d697059b-a602-36af-9949-8128f74ac040",
                                        "glosses": [
                                            "to fish with stakes and nets that serve to prevent the fish from getting back into the sea with the ebb"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2bb3c4a-1b35-3a30-830a-fb251d810891",
                                        "entry_id": "d697059b-a602-36af-9949-8128f74ac040",
                                        "glosses": [
                                            "To cause to flow back."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6922be44-739c-460b-b32c-e8e905d3e512",
                                                "sense_id": "d2bb3c4a-1b35-3a30-830a-fb251d810891",
                                                "text": "Parts of this town do not want a big influx of gay people and are trying to ebb it."
                                            }
                                        ]
                                    }
                                ]
                            }
