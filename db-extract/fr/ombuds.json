                        "glosses": [
                            "Ombundsman, médiateur indépendant."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "55b2fcf0-ab98-4fcd-b65b-f057a3b99c5a",
                                "sense_id": "81c17b12-0e3c-3873-8cd2-aee8d7e9a396",
                                "text": "Elle tisse également un lien entre les capacités organisationnelles de l’ombuds canadien et son rôle de leader en regard de l’équité et du changement dans son travail."
                            },
                            {
                                "example_id": "44086d13-f746-4f1c-b0d4-594057f241c8",
                                "sense_id": "81c17b12-0e3c-3873-8cd2-aee8d7e9a396",
                                "text": "Concernant le travail d’ombuds, comme annoncé dans le précédent rapport, un effort a été consenti dans le sens d’une plus grande réactivité et d’une amélioration de la communication avec les demandeurs."
                            },
                            {
                                "example_id": "ae089600-88bf-4861-a081-f67538996ff3",
                                "sense_id": "81c17b12-0e3c-3873-8cd2-aee8d7e9a396",
                                "text": "Les services d’un Ombuds peuvent aider à résoudre les conflits d’une manière consensuelle et impartiale, et ainsi promouvoir le bon fonctionnement de l’Organisation."
                            }
                        ]
