                            "comment": "clipping of discotheque"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ночной клуб или заведение, где люди танцуют под записанную поп-музыку.",
                        "zh": "人们随着录制的流行音乐跳舞的夜总会或场所。"
                    },
                    "translations": {
