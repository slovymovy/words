                "senses": [
                    {
                        "sense_id": "61c9294e-5ff3-3478-9f7a-93ad8fc44592",
                        "entry_id": "74ae10b8-5303-3cb9-b675-308f1b0c0f48",
                        "glosses": [
                            "organisatie die met een winstoogmerk producten of diensten voortbrengt, bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a582c462-741f-4faa-97a8-e6a0d31ceb4e",
                                "sense_id": "61c9294e-5ff3-3478-9f7a-93ad8fc44592",
                                "text": "Hij wil hier een onderneming gaan starten."
                            },
                            {
                                "example_id": "dd2f4b4b-99da-4066-a20b-aa4afd39463e",
                                "sense_id": "61c9294e-5ff3-3478-9f7a-93ad8fc44592",
                                "text": "Het aantal foodtruckondernemingen is in vijf jaar tijd ruim verdubbeld. In 2017 waren er bij de Kamer van Koophandel (KvK) nog 1189 ondernemingen met een foodtruck ingeschreven, inmiddels zijn dat er 2495. Tijdens de coronacrisis hield de groei van het aantal foodtrucks aan."
                            },
                            {
                                "example_id": "4a7d4c60-964b-4bcb-9e5b-658aff9015c2",
                                "sense_id": "61c9294e-5ff3-3478-9f7a-93ad8fc44592",
                                "text": "Een eigen automaat die je in een bedrijf plaatst en zelf vult met frisdrankblikjes, proteïnerepen of zelfs haarproducten. Steeds meer Nederlanders beginnen een eigen onderneming in verkoopautomaten. Bij de Kamer van Koophandel waren op 1 april meer dan twee keer zoveel verkoopautomaatondernemers ingeschreven als twee jaar geleden."
                            }
                        ]
                    },
                    {
                        "sense_id": "37049e3e-d7c5-3773-970f-255f2963fa96",
                        "entry_id": "74ae10b8-5303-3cb9-b675-308f1b0c0f48",
                        "glosses": [
                            "een gewichtige zaak die men op zich neemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd8114c-83e0-495e-be65-f756d35925aa",
                                "sense_id": "37049e3e-d7c5-3773-970f-255f2963fa96",
                                "text": "Dat is wel een hele onderneming, zeg!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48538ac1-5a66-466c-88b6-bbb30f6e5e10",
                        "source_entry_id": "74ae10b8-5303-3cb9-b675-308f1b0c0f48",
                        "source_sense_id": "61c9294e-5ff3-3478-9f7a-93ad8fc44592",
                        "source_sense_description": "een organisatie",
                        "target_lang_word": "Unternehmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unternehmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                        "entry_id": "d70147cf-5052-3233-a357-96bb8b73e020",
                                        "glosses": [
                                            "Gesellschaft, die in Produktion oder Handel tätig ist oder Dienstleistungen erbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc624767-8678-4d86-ab06-a6546a822ecc",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "Ich leite ein Unternehmen."
                                            },
                                            {
                                                "example_id": "3986c479-a1b1-4d9a-b32b-c714eb5a1243",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "„Nach dem vorgelegten Sanierungskonzept des Raststättenbetreibers könnte das Unternehmen schon bald wieder profitabel werden.“"
                                            },
                                            {
                                                "example_id": "2fa3fa86-6422-474d-8168-8cb7d65d65c1",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "„Entschlossen, ein Haus im ›Enclos du Temple‹ zu mieten, suchte ich den Prinzen von Conti auf, der mein Unternehmen lebhaft begrüßte und mir seinen Schutz sowie alle Freihandelsrechte versprach, die ich wünschen konnte.“"
                                            },
                                            {
                                                "example_id": "fc888d57-d229-485b-9772-9c3ad2ad1f51",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "„Über die folgende Zahl dürfte auf der Bundesfinanzminister zunächst staunen, um sich dann zu ärgern: Unternehmen in Deutschland tragen gerade mal 2,6 Prozent zum gesamten Steueraufkommen bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9143cafc-c851-344f-a697-3911f636fc7c",
                                        "entry_id": "d70147cf-5052-3233-a357-96bb8b73e020",
                                        "glosses": [
                                            "Durchführung eines Gedankens oder Plans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df03400a-3ef2-4a3e-9112-07010a110ac6",
                                                "sense_id": "9143cafc-c851-344f-a697-3911f636fc7c",
                                                "text": "Es handelt sich um ein gewagtes Unternehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cebb969f-7816-40df-bab2-4a103ef6f5bd",
                        "source_entry_id": "74ae10b8-5303-3cb9-b675-308f1b0c0f48",
