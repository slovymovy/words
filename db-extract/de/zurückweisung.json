                    {
                        "form_id": "48fbaf3c-9719-4a05-a412-81897fdc8fa2",
                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zurückweisungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                        "glosses": [
                            "Handlung, etwas, das jemand von einem möchte, abzulehnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47edf15-c934-4f3e-aebe-716fa0a6eef5",
                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                "text": "„Trotz dieser Zurückweisung wollte Janosch weiterhin Maler werden.“"
                            },
                            {
                                "example_id": "c5eebf1c-5de8-4c35-a563-38f200f27fe4",
                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                "text": "„Er bewies dem Kaiser, dass eine solche Zurückweisung nicht durchzuhalten war.“"
                            },
                            {
                                "example_id": "3ec5987f-24b1-4be7-8b10-7c3f29581967",
                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                "text": "Er erklärte ihr seine Liebe, ihre Zurückweisung traf ihn sehr."
                            },
                            {
                                "example_id": "0a65b3e9-2311-453a-ab58-ced7b66e1a81",
                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                "text": "„Tagelang kämpfte sie mit Frieds Zurückweisung und dem Gefühl der Verlassenheit, aber nach und nach war da auch etwas Neues.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ce481bb-c19b-3f34-89c8-1894013d0e07",
                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                        "glosses": [
                            "Handlung, eine Behauptung als falsch/unwahr zu erklären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7f27a3-ab38-4c6c-8d5f-bd15944afab0",
                                "sense_id": "5ce481bb-c19b-3f34-89c8-1894013d0e07",
                                "text": "„So ist etwa in den neueren Ausgaben seines verbreitetsten Werkes „Aufstand der Massen“ (1930) ein „Prolog für Franzosen“ und ein auf der Höhe des Bürgerkrieges geschriebener Epilog für Engländer“ enthalten, der eine Rechtfertigung Spaniens, des ganzen Spanien, gegenüber den leichtfertigen Urteilen unwissender Ausländer und den Greuelgeschichten verbitterter Emigranten darstellt und nebenbei eine leidenschaftliche Zurückweisung der Behauptung, daß er, Ortega, zu irgendeiner Zeit, in Spanien oder im Exil, an seinem Volke irregeworden sei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                        "glosses": [
                            "formale/rechtliche Ablehnung von Anträgen (beispielsweise eines Asylantrages), Klagen (vor Gericht), Verfahren (beispielsweise von einer Ausländerbehörde) oder des Einlass von Personen an einer Grenze"
                        ],
                        "tags": [
                            "Behörden",
                            "Gerichte"
                        ],
                        "examples": [
                            {
                                "example_id": "9c08087f-ba65-464d-b73d-48ef64355a60",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "Die Zurückweisung an der Grenze erfolgte aufgrund fehlender Papiere."
                            },
                            {
                                "example_id": "78d6fa1b-ea2a-4058-a6ef-7a5830e1f8dc",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„Erstmals hat ein Gericht die Zurückweisung von Asylbewerbern an den Grenzen für rechtswidrig erklärt.“"
                            },
                            {
                                "example_id": "24a8126f-bb10-4270-ab7c-fe9998291975",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„Im Koalitionsvertrag heißt es, dass Zurückweisungen […] von Asylbewerbern \"in Abstimmung mit unseren europäischen Nachbarn\" vorgenommen würden.“"
                            },
                            {
                                "example_id": "d51fd593-b275-4c26-9388-5b04c903f758",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„Der Rechtswissenschaftler der Uni Konstanz, Thym, sagte im Deutschlandfunk,die Bundesregierung könne beispielsweise versuchen, die Zurückweisungen durch eine besondere Überlastung bei der Integration zu begründen.“"
                            },
                            {
                                "example_id": "74721899-f150-45d9-9de2-5e0f9d53c904",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„[…] die Zurückweisung von Asylsuchenden an den internen EU-Grenzen, zum Beispiel in Deutschland, [soll] erleichtert werden.“"
                            },
                            {
                                "example_id": "fb8133a7-9f42-4b37-84b8-0b439a93287a",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "Die Zurückweisung der Klage wurde mit Formfehlern begründet."
                            },
                            {
                                "example_id": "bc1e76e8-1882-4559-afa2-3ae791591399",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„Der Prozess endete am 19. Juni 1914 mit der Zurückweisung der Klage.“"
                            },
                            {
                                "example_id": "d1f29f9f-57ee-4553-87bc-e1b66e3a6294",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„Anders als der Generalanwalt Anthony Collins, der im Oktober eine Zurückweisung der Klage gefordert hatte, hält Cox die Vertragsverletzungsklage für begründet, […].“"
                            },
                            {
                                "example_id": "0781a052-f7f0-42ee-8af2-10e57796acb2",
                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                "text": "„Bedient sich der Antragsteller nicht dieser Formblätter, so liegt ein Verfahrensmangel vor, der zur Zurückweisung des Antrags führt (Artikel 11 Abs. 1 Ziff. a) EuMahnVO).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
