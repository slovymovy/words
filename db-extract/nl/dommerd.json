                "senses": [
                    {
                        "sense_id": "6b2f8e0c-7792-3cc5-9f9a-136df10aeed4",
                        "entry_id": "201b6e02-748e-3ad9-8e8b-8117d131d442",
                        "glosses": [
                            "iemand die een beetje dom is (geweest)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ad97ec-f6c4-42a8-86a4-117bfc419a9f",
                                "sense_id": "6b2f8e0c-7792-3cc5-9f9a-136df10aeed4",
                                "text": "'Lieverd, laten we het alsjeblieft, alsjeblieft, alsjeblieft weer goedmaken. Dit... ik bedoel... o, wat ben ik toch een dommerd geweest. Ik was gewoon fout!'"
                            },
                            {
                                "example_id": "567ce780-25fb-49f2-8d14-841d8be79167",
                                "sense_id": "6b2f8e0c-7792-3cc5-9f9a-136df10aeed4",
                                "text": "Ook datingsites worden in toenemende mate misbruikt. „Als je naar de slachtoffers kijkt, die vaak eenzaam en alleen zijn, zit daar misschien wel de meeste pijn. Hebzucht speelt bij die mensen geen rol, en dan is het wel hard om te zeggen: Wat ben je een dommerd dat je erin trapt”, stelt Van Eck."
                            }
                        ]
                    }
                ],
