                            {
                                "example_id": "a65f28e2-2f60-4c4b-82cc-40f56259cfbf",
                                "sense_id": "02b169f5-3ecf-3131-afac-2a889a5ea6a8",
                                "text": "„Gaviria wurde zum 21. kolumbianischen Etappensieger in der Geschichte der Italien-Radrundfahrt.“"
                            },
                            {
                                "example_id": "399b70bf-48ae-4d0a-b12f-7ce52fbc404e",
                                "sense_id": "02b169f5-3ecf-3131-afac-2a889a5ea6a8",
                                "text": "„Die sechs einheimischen Fahrer sollen jene Tradition fortsetzen, wonach die Schweizer in den letzten vier Jahren immer zumindest einen Etappensieger stellten.“"
                            },
                            {
                                "example_id": "88023bb4-eebc-4554-b34d-a6d44e63833e",
                                "sense_id": "02b169f5-3ecf-3131-afac-2a889a5ea6a8",
                                "text": "„Floyd Landis erlebt in den Alpen einen denkwürdigen Einbruch - am Tag darauf nähert er sich als Etappensieger wieder der Spitze.“"
                            }
                        ],
