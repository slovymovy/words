                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                        "entry_id": "286982d5-87c7-33f7-b485-96a303ed8669",
                        "glosses": [
                            "Spécialiste de l’arithmétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac04c63-1b4d-4b20-90bc-16c9f7afe466",
                                "sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                                "text": "Bon arithméticien. Savant arithméticien."
                            },
                            {
                                "example_id": "cc3ccf71-b6df-42d6-b97a-b8ba11768b16",
                                "sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                                "text": "C’est ce qu’a naturellement assimilé et digéré le 14 Mars, qui n’est pas uniquement formé de Mère Teresa droits-de-l’hommistes jusqu’à la moelle et horrifiées par ce qui ressemble fort à un démarrage de génocide sunnite en Syrie, mais qui comporte dans ses rangs quelques arithméticiens et autres géomètres qui ont heureusement oublié d’être sots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5085289-6418-4959-948d-7c3ba979ca52",
                        "source_entry_id": "286982d5-87c7-33f7-b485-96a303ed8669",
                        "source_sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                        "target_lang_word": "Arithmetiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arithmetiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb2630e-ea75-3dd3-822a-d15227b57bf5",
                                        "entry_id": "a053a40b-41d5-37ef-9c90-fa3b3dc961a6",
                                        "glosses": [
                                            "Spezialist auf dem Gebiet der Arithmetik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffcc697-354c-4c9a-9874-d3f5833c9dc0",
                                                "sense_id": "bbb2630e-ea75-3dd3-822a-d15227b57bf5",
                                                "text": "„Anders als Heron von Alexandria und als Archimedes, die bei der Lösung geometrischer Probleme irrationale Zahlen zuließen, die sie zu approximieren versuchten, setzt sich bei Diophant der Arithmetiker und Algebraiker durch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51affcc1-b618-458e-beef-339f3095e780",
                        "source_entry_id": "286982d5-87c7-33f7-b485-96a303ed8669",
                        "source_sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                        "target_lang_word": "arithmetician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arithmetician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d93532-15a1-367f-ba89-f30b10e683b6",
                                        "entry_id": "8e54878f-a963-3211-a217-91693ae9259d",
                                        "glosses": [
                                            "One with expertise in arithmetic; a mathematician."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855f975a-ec18-4f55-a917-785dfb0e8e8e",
                                                "sense_id": "c8d93532-15a1-367f-ba89-f30b10e683b6",
                                                "text": "[F]or certes, ſayes he, / I haue already choſen my officer, and what was he? / Forſooth, a great Arithmeticion, [...]"
                                            },
                                            {
                                                "example_id": "c55411b6-f2d3-4d3b-a3d2-08d546dd89ef",
                                                "sense_id": "c8d93532-15a1-367f-ba89-f30b10e683b6",
                                                "text": "I haue read the truest computer of Times, and the best Arithmetician that euer breathed, and he reduceth thy dayes into a short number: The daies of Man are threescore and ten."
                                            },
                                            {
                                                "example_id": "102dac81-e6e8-462d-87b8-78bfd28ef88a",
                                                "sense_id": "c8d93532-15a1-367f-ba89-f30b10e683b6",
                                                "text": "But I'll tell you one thing; it's a Question that would puzzle an Arithmetician, if you ſhould ask him, whether the Bible ſaves more Souls in Weſtminſter-Abby, or damns more in Weſtminſter-Hall: […]"
                                            },
                                            {
                                                "example_id": "53538370-97ff-4c3f-9f6c-d1ccb1ea54c9",
                                                "sense_id": "c8d93532-15a1-367f-ba89-f30b10e683b6",
                                                "text": "Bonoro. What said he? / Tycho. That he would say but three words and follow me. I heard him say a hundred, and sing a thousand: Lovers are bad arithmeticians."
                                            },
                                            {
                                                "example_id": "87bb967f-82d6-4a06-a8b3-f72071d6ff5e",
                                                "sense_id": "c8d93532-15a1-367f-ba89-f30b10e683b6",
                                                "text": "You talk of figures, now; you have only to say to Stelling, ‘I want my son to be a thorough arithmetician,’ and you may leave the rest to him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
