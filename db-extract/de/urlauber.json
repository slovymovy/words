                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6de6b293-4882-4124-902a-1ef7d64d090b",
                        "source_entry_id": "da7e2838-4fe6-3dd6-9f90-760aa418a216",
                        "source_sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                        "source_sense_description": "jemand, der Urlaub macht; der sich im Urlaub befindet",
                        "target_lang_word": "vacationist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab35e9b-4185-38b7-b828-61e6967e6231",
                                        "entry_id": "55080e07-efdf-3f05-ad27-6fb1b69b9bef",
                                        "glosses": [
                                            "Someone who is on vacation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8fb7613-5f81-449d-af4d-d4dc8fe7770f",
                                                "sense_id": "aab35e9b-4185-38b7-b828-61e6967e6231",
                                                "text": "Anyone was welcome to ride. And as the train rolled along the backwoods section it picked up countless non-paying passengers from among vacationists and boys from camps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ded5b26-4ffa-43f0-ab6a-e7e4a00c0967",
                        "source_entry_id": "da7e2838-4fe6-3dd6-9f90-760aa418a216",
                        "source_sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                        "source_sense_description": "jemand, der Urlaub macht; der sich im Urlaub befindet",
                        "target_lang_word": "vacancier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacancier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c48c1d4a-ca23-3d95-a991-3876fbc8679c",
                                        "entry_id": "e56e7341-820c-35ec-b315-ccfd1f9177cf",
                                        "glosses": [
                                            "Qui concerne les vacances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f09895c-680c-4262-86e2-2b26807fd451",
                                                "sense_id": "c48c1d4a-ca23-3d95-a991-3876fbc8679c",
                                                "text": "Souvenirs vacanciers."
                                            },
                                            {
                                                "example_id": "0857aea5-cfac-4c98-a047-f33948d807e7",
                                                "sense_id": "c48c1d4a-ca23-3d95-a991-3876fbc8679c",
                                                "text": "Les jumelles entrent en fonction. L'étrange plaisir que de voir ainsi sans être vu, de sauter de loin au visage des gens ! Je l'ai fait cent fois en vacances, mais au détriment de personnages de cartes postales, de baigneuses sortant de l'eau, de couples superposés dans l'herbe, bref d'anonymes dont la neutralité vacancière fait oublier que l'homme est un chasseur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vacancier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                        "entry_id": "a525b10d-035f-3600-8f7a-7451a7f0792c",
                                        "glosses": [
                                            "Personne qui est en vacances, qui prend des vacances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6530250f-88f5-4829-96af-cb6088a1ad40",
                                                "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                                "text": "Elle, elle était du côté des « vacanciers », des campeurs, de ceux qui vont et viennent, même les riches qui descendent dans les grands hôtels."
                                            },
                                            {
                                                "example_id": "155104e7-3142-4100-b00a-e61c2c9dfb04",
                                                "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                                "text": "C’est pourquoi il faut bien distinguer vacances et voyages et par voie de conséquence le touriste du vacancier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
