                "senses": [
                    {
                        "sense_id": "e6c62441-27e6-3577-b4f3-cdf2a9812d05",
                        "entry_id": "e72a90b0-dd9f-3456-b221-743bcf91e78a",
                        "glosses": [
                            "Fahrzeug, das auf vereiste Straßen, Wegen und Plätzen Sand, Granulat oder Auftausalz streut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6dec798-ad91-40f7-b9bb-849b6d110a3c",
                                "sense_id": "e6c62441-27e6-3577-b4f3-cdf2a9812d05",
                                "text": "„Ein Räum- und Streufahrzeug ist am späten Freitagabend in Klosterneuburg (Bezirk Wien-Umgebung) aufgrund der winterlichen Bedingungen von einer Straße gerutscht, seitlich umgekippt und auf dem Dach zu liegen gekommen.“"
                            },
                            {
                                "example_id": "e4401cba-3bfa-4b14-acdb-d018033d9673",
                                "sense_id": "e6c62441-27e6-3577-b4f3-cdf2a9812d05",
                                "text": "„Auf der Autobahn A9 ist ein Kleinbus auf ein Streufahrzeug aufgefahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
