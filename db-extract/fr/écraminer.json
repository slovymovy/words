                "senses": [
                    {
                        "sense_id": "d7e057ba-1dc2-3fab-a138-d0a275eeb2e7",
                        "entry_id": "beb4a2fa-d585-3b82-8336-10f3a199cd14",
                        "glosses": [
                            "Enlever la chair qui est restée sur une peau, tout en la distendant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2432c2-5198-4d40-98e4-940c805c56ef",
                                "sense_id": "d7e057ba-1dc2-3fab-a138-d0a275eeb2e7",
                                "text": "Et tout d'abord signalons la présence, dans la plupart des usines, d'appareils à sabrer et à écraminer."
                            },
                            {
                                "example_id": "86d2eee2-7139-4e07-9dac-a8d10afa7e21",
                                "sense_id": "d7e057ba-1dc2-3fab-a138-d0a275eeb2e7",
                                "text": "Les peaux, ayant trempé trente-six heures, sont secouées dans l'eau, puis on les foule aux pieds et on les étire dans tous les sens; enfin on les place sur le chevalet ou on les écramine avec un couteau demi-rond pour assouplir la peau ; la peau est placée le poil en dessous et on presse de haut en bas."
                            }
                        ]
                    }
