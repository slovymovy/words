                        "glosses": [
                            "Clipping of Wakefield: an industrial city and metropolitan borough of West Yorkshire, England; traditionally a centre for the cloth and coal industries."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
