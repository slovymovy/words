                        ],
                        "form": "der Whataboutismus"
                    },
                    {
                        "form_id": "5ad54f16-eb76-4311-b9e2-17d67d70c4cf",
                        "entry_id": "7221fa96-66e7-34c0-8752-c2b3b6a21e78",
