                ],
                "senses": [
                    {
                        "sense_id": "b0568e45-5899-3f85-95e7-c66e6f1c509a",
                        "entry_id": "4a34ea94-de70-32b0-ac8e-c1e05acd62df",
                        "glosses": [
                            "бран., шутл. мошенник, плут, бестия, пройдоха ( в восклицании, выражающем восхищение, удивление и т. п.)"
                        ],
                        "tags": [
                            "также шутл."
                        ],
                        "examples": [
                            {
                                "example_id": "c3f3a7fd-f637-4aee-b1a1-2a1f2d2fa4f8",
                                "sense_id": "b0568e45-5899-3f85-95e7-c66e6f1c509a",
                                "text": "У него расправа была коротка. Он тотчас потребовал каналью француза."
                            },
                            {
                                "example_id": "c9ad106c-7f7c-426f-9e76-bb68a8f7c667",
                                "sense_id": "b0568e45-5899-3f85-95e7-c66e6f1c509a",
                                "text": "Мошенники, канальи, чем они кормят! И челюсти заболят, если съешь один такой кусок."
                            },
                            {
                                "example_id": "c0d9ca8e-41fc-4278-bb0f-10794915c6c7",
                                "sense_id": "b0568e45-5899-3f85-95e7-c66e6f1c509a",
                                "text": "Народите детей, воспитать их не сумеете, все это будут невежды, воры, писаря, канальи!"
                            },
                            {
                                "example_id": "4bce87a2-bd73-4125-944b-b15ec5926308",
                                "sense_id": "b0568e45-5899-3f85-95e7-c66e6f1c509a",
                                "text": "Не забудьте, что им придётся иметь дело с лордом, который сам каналья первой степени, если смотреть просто и называть вещи своими именами."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dae3c8b-8492-3a41-83a6-c077eda86978",
                        "entry_id": "4a34ea94-de70-32b0-ac8e-c1e05acd62df",
                        "glosses": [
                            "собир. простой народ, чернь, сброд"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf7860e3-ed15-4a4a-8917-a8dbc4248dd1",
                        "source_entry_id": "4a34ea94-de70-32b0-ac8e-c1e05acd62df",
                        "source_sense_description": "плут, мошенник",
                        "target_lang_word": "Kanaille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanaille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10b9dafb-84b8-3d0f-882f-dfe1af1fd657",
                                        "entry_id": "bdb841a0-6730-3291-b9dd-d679f1e15fb4",
                                        "glosses": [
                                            "Schimpfwort, einen Menschen als Schurken bezeichnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a00140d-fce8-4414-827d-d5b3763bb55a",
                                                "sense_id": "10b9dafb-84b8-3d0f-882f-dfe1af1fd657",
                                                "text": "Sie will unbedingt, dass er endlich seinen Außenminister Alexander Haig rauswirft, diese Kanaille, die sich erdreistet hatte, zu behaupten: \"Bei mir liegt jetzt alle Verantwortung!\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c2ebdae-0ece-378d-903d-2067d3a6cb0c",
                                        "entry_id": "bdb841a0-6730-3291-b9dd-d679f1e15fb4",
                                        "glosses": [
                                            "Menschenmenge aus heruntergekommenen oder zwielichtigen Personen"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4c984c-ab7d-4dc7-a04f-b7ff5bccc942",
                                                "sense_id": "8c2ebdae-0ece-378d-903d-2067d3a6cb0c",
                                                "text": "Die Kanaille rottete sich am Stadttor zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
