                                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                                        "glosses": [
                                            "Perturbation de l’humeur caractérisée par l’irritabilité et un sentiment déplaisant de tristesse, d’anxiété."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d7e01a7-dbc8-31d9-9eb0-11a19b2b719f",
                                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                                        "glosses": [
                                            "Sentiment désagréable de tristesse, d'inadéquation, de déception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86aa31b-accb-454d-916c-282d973a8f7c",
                                                "sense_id": "9d7e01a7-dbc8-31d9-9eb0-11a19b2b719f",
                                                "text": "Il en est ainsi dans ce que le charabia médical appelle la dysphorie post-coïtale. Il s'agit d'un syndrome caractérisé par de la tristesse, une perte d'énergie voire de la mélancolie juste après l'acte sexuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694926c9-f899-3aec-8f7c-699881bfbf5f",
                                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                                        "glosses": [
                                            "État de malaise social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1b68ed-463e-439c-9e5d-5e9925522ecf",
                                                "sense_id": "694926c9-f899-3aec-8f7c-699881bfbf5f",
                                                "text": "Dysphorie collective (Durkheim)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "032c239c-6457-3c3d-ab2f-6779195be820",
                                        "entry_id": "e0bce9bc-e4d0-3477-8376-b790c7a428e4",
                                        "glosses": [
                                            "Dysphorie de genre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11140cac-e342-410c-91c1-abab90dfd651",
                                                "sense_id": "032c239c-6457-3c3d-ab2f-6779195be820",
                                                "text": "Plus il y aura de familles trans, plus nombreux seront les parents qui détecteront chez leurs enfants des indices de dysphorie."
                                            }
                                        ]
                                    }
                                ]
                            }
