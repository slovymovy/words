                    }
                ],
                "translations": [
                    {
                        "translation_id": "192b2df7-6e88-4507-a3e0-747e367f7014",
                        "source_entry_id": "ecd284cd-45df-3269-a4e6-5beafda6337e",
                        "source_sense_id": "c0b9055f-f24e-327d-8cc5-6f31aa311e8b",
                        "target_lang_word": "syndicate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48077c83-2e6d-31af-a5e8-6ef87944e59b",
                                        "entry_id": "3aae13c0-967e-3b4e-a7a7-7024ce126958",
                                        "glosses": [
                                            "To become a syndicate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593ffa6f-f16e-41b3-8453-18f695b9b590",
                                                "sense_id": "48077c83-2e6d-31af-a5e8-6ef87944e59b",
                                                "text": "[H]e [John Guthrie McCallum] went to Los Angeles and set up a law practice. There, with three partners and a capitalization of $100,000, they syndicated under the name Palm Valley Land and Water Company in 1887."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40eb6e14-f88d-3adf-a8a4-91c27a5c8db5",
                                        "entry_id": "3aae13c0-967e-3b4e-a7a7-7024ce126958",
                                        "glosses": [
                                            "To put under the control of a group acting as a unit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a886edb8-cb47-4925-8676-2d9403efcbc0",
                                                "sense_id": "40eb6e14-f88d-3adf-a8a4-91c27a5c8db5",
                                                "text": "When a potential transaction has been identified by a bank, the first activity is obtaining from the potential borrower a \"mandate,\" which is the customer's exclusive authorization to a bank to act as the syndication manager for that particular transaction and to approach other financial institutions on its behalf to raise a given amount of funds. […] A mandate letter is very similar to a standard bank commitment letter, with the exception that bank managers do not guarantee to provide the credit facility, but rather only to syndicate it on a \"best efforts\" basis, perhaps with a certain firm commitment assumed by them representing a portion of the required syndicated financing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021d7597-7d2c-3a97-824b-e97f65e60dda",
                                        "entry_id": "3aae13c0-967e-3b4e-a7a7-7024ce126958",
                                        "glosses": [
                                            "To release media content through a syndicate to be broadcast or published through multiple outlets."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b8f375d-a496-4012-ad9d-74c10611641b",
                                                "sense_id": "021d7597-7d2c-3a97-824b-e97f65e60dda",
                                                "text": "[I]nternational television format exchanges are providing a customizable alternative to syndicating existing TV series in foreign markets. Sixteen countries around the world have adapted So You Think You Can Dance, a reality dance competition that originated in the United States. Format changes range from using local judges and contestants to incorporating local dance styles into the competition."
                                            },
                                            {
                                                "example_id": "c0ac120d-011a-4be7-a312-bfcd9a655e3c",
                                                "sense_id": "021d7597-7d2c-3a97-824b-e97f65e60dda",
                                                "text": "With the success of The Oprah Winfrey Show and the national attention that Oprah [Winfrey] received from The Color Purple, [Jeffrey] Jacobs advised her that it was time to syndicate her show. Jacobs worked out a deal with the syndication company King World to distribute the show nationally. Two brothers, Roger and Michael King, ran King World. They syndicated the game shows Wheel of Fortune and Jeopardy! and were looking for a new show to add to their list."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "syndicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8577b5a-7104-3a20-839c-1bb764e99918",
                                        "entry_id": "fdafe7fa-dfc5-3e11-a9b6-8d1d5cc63e29",
                                        "glosses": [
                                            "A group of individuals or companies formed to transact some specific business, or to promote a common interest; a self-coordinating group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d0e0bc-66c2-49c5-9f2c-8601b68b7fda",
                                                "sense_id": "a8577b5a-7104-3a20-839c-1bb764e99918",
                                                "text": "a gambling syndicate"
                                            },
                                            {
                                                "example_id": "ab33c307-c417-4f63-9d4d-2460e368e564",
                                                "sense_id": "a8577b5a-7104-3a20-839c-1bb764e99918",
                                                "text": "The worst deed ever alleged against the early sandalwood traders was that a number of natives were suffocated in a cave at Vaté, in the New Hebrides, by the smoke from a fire built at its mouth. But this was done by order of Maafu, who, on behalf of an Australian syndicate of highly-respectable merchants and church-members, was \"bossing\" an expedition in search of sandalwood through the New Hebrides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbfc425-ffc9-34ed-a5b5-b6d2d232dec0",
                                        "entry_id": "fdafe7fa-dfc5-3e11-a9b6-8d1d5cc63e29",
                                        "glosses": [
                                            "A group of individuals or companies formed to transact some specific business, or to promote a common interest; a self-coordinating group.",
                                            "A group of gangsters engaged in organized crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cda4d4f-5c1a-40cb-a746-61098cf1e935",
                                                "sense_id": "efbfc425-ffc9-34ed-a5b5-b6d2d232dec0",
                                                "text": "Held at the estate of Mafia boss Joseph Barbara in Apalachin, NY, the meeting called by [Vito] Genovese in November 1957 brought over 100 mobsters from around the country to cement his power over the national crime syndicate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cf6eb5a-e3a7-34f9-83dc-5c75459187e2",
                                        "entry_id": "fdafe7fa-dfc5-3e11-a9b6-8d1d5cc63e29",
                                        "glosses": [
                                            "A group of individuals or companies formed to transact some specific business, or to promote a common interest; a self-coordinating group.",
                                            "A group of media companies, or an agency, formed to acquire content such as articles, cartoons, etc., and to publish it in multiple outlets; a chain of newspapers or other media outlets managed by such an organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b38545-d4ed-4b93-86ac-b9bac79a6ffb",
                                                "sense_id": "2cf6eb5a-e3a7-34f9-83dc-5c75459187e2",
                                                "text": "In the mid-1880s, Charles W[addell] Chesnutt broke into print inauspiciously as one member of the stable of writers who supplied humorous sketches and mildly sentimental or didactic squibs for S[amuel] S[idney] McClure's newspaper syndicate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdc093f-4d06-3ce3-b160-e179aae942dd",
                                        "entry_id": "fdafe7fa-dfc5-3e11-a9b6-8d1d5cc63e29",
                                        "glosses": [
                                            "The office or jurisdiction of a syndic; a body or council of syndics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f35802-549b-4762-810d-4a367d3cc9c0",
                                                "sense_id": "9bdc093f-4d06-3ce3-b160-e179aae942dd",
                                                "text": "The ſoveraintie lies in the Council of 200, and this Council chuſes out of its number 25, who are the leſſer Council; […] they are choſen by a ſort of ballet, ſo that it is not known for whom they give their votes, which is an effectual method to ſuppreſs factions and reſentments; ſince in a competition no man can know who voted for him or againſt him: yet the election is not ſo carried, but that the whole Town is in an intrigue concerning it: for ſince the being of the little Council leads one to the Sindicat, which is the chieffe honor of the State: this dignitie is courted here, with as active and ſolicitous an ambition as appears elſewhere for greater matters."
                                            },
                                            {
                                                "example_id": "abb0f08e-2a7f-4bd0-bc15-adc9bc0641f4",
                                                "sense_id": "9bdc093f-4d06-3ce3-b160-e179aae942dd",
                                                "text": "The executive government of the University [of Madras] shall be vested in a syndicate, consisting of the Vice-Chancellor and six of the fellows, who shall be elected for one year by the several faculties, at the annual meetng of the senate, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "026bdbc6-bb9b-43a9-b54a-bcbe7ae9085a",
                        "source_entry_id": "ecd284cd-45df-3269-a4e6-5beafda6337e",
                        "source_sense_id": "c0b9055f-f24e-327d-8cc5-6f31aa311e8b",
                        "target_lang_word": "синдикат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "синдикат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe938224-f1ad-38b2-871c-675c3da619bf",
                                        "entry_id": "2a4b2c85-ae9b-3c89-8cca-dd2535ad2956",
                                        "glosses": [
                                            "монополистическое объединение, в составе которого компании теряют коммерческую сбытовую самостоятельность, но сохраняют юридическую и производственную свободу действий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4881fe16-7451-4a78-a31c-5d4ed62a64de",
                                                "sense_id": "fe938224-f1ad-38b2-871c-675c3da619bf",
                                                "text": "От него я узнал, … что завод затруднен в получении оптического стекла, так как лучший завод такого стекла в Вене, ставящий его почти на весь мир, перешел в собственность немецкого синдиката Цейсса и других фабрик оптических стекол; синдикат тотчас поднял цену на стекло и мог сделать ее вовсе недоступной нашему заводу."
                                            },
                                            {
                                                "example_id": "ec190ec8-fdc4-4fd0-9257-223fa73f7429",
                                                "sense_id": "fe938224-f1ad-38b2-871c-675c3da619bf",
                                                "text": "〈…〉 — Между конторой Угольного синдиката и углом набережной, — сказал я, — стоит замечательное парусное судно. 〈…〉Название этого корабля — «Бегущая по волнам»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce383b6-3c9c-31a9-8b7c-6dd4b2c9fc3f",
                                        "entry_id": "2a4b2c85-ae9b-3c89-8cca-dd2535ad2956",
                                        "glosses": [
                                            "в первый период нэпа в советском государстве — объединение трестов какой-либо отрасли промышленности, имевшее целью плановую закупку сырья и сбыт продукции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d44abef5-6547-475f-8198-39287e941fa0",
                                                "sense_id": "1ce383b6-3c9c-31a9-8b7c-6dd4b2c9fc3f",
                                                "text": "Торгсин (в народе это сокращение, на самом деле обозначавшее «Торговый синдикат», истолковывалось как «Торговля с иностранцами») представлял собой сеть магазинов с очень богатым ассортиментом продовольственных товаров и одежды, которыми торговали на валюту, в том числе на золото и серебро …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd66cc1f-268f-36fe-a0a2-e13115c077f0",
                                        "entry_id": "2a4b2c85-ae9b-3c89-8cca-dd2535ad2956",
                                        "glosses": [
                                            "профессиональный союз во Франции и некоторых других странах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37add7c3-807b-44d2-8c08-ff543aed32cf",
                                                "sense_id": "dd66cc1f-268f-36fe-a0a2-e13115c077f0",
                                                "text": "Практические голландцы давно уже нашли способ устроиться иначе, образовав ряд гильдий или синдикатов перевозчиков, ― ряд свободных союзов, создавшихся под влиянием потребностей судоходства."
                                            },
                                            {
                                                "example_id": "e6e11837-09f4-43c0-8cc0-415fd0c9d650",
                                                "sense_id": "dd66cc1f-268f-36fe-a0a2-e13115c077f0",
                                                "text": "〈…〉 синдикат французских артистов написал петицию о том, что летом Францию заполоняют музыканты из Восточной Европы, в то время как многие французские дирижёры и музыканты сидят без работы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
