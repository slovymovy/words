                        "glosses": [
                            "de hoeveelheid geld die een gezin tot zijn beschikking heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31efc0a3-0d43-4198-a153-c6abd2fd7849",
                                "sense_id": "fc1642b6-7f08-3dcc-8575-d6692c9f8d52",
                                "text": "Het kabinet wil kijken of consumenten behoefte hebben aan een loket, waar ze vragen kunnen stellen over geldkwesties. Het gaat dan om vragen over pensioenen, scheidingen, hypotheken, huren en het rondkomen met het gezinsbudget."
                            },
                            {
                                "example_id": "ebf3cf6c-204c-47fc-bb64-2db89486ffba",
                                "sense_id": "fc1642b6-7f08-3dcc-8575-d6692c9f8d52",
                                "text": "Raadslid Jos Harmelink van de PvdA bracht het onderwerp ter sprake. Door de sterk gestegen energiekosten, betalen mensen met een variabel energiecontract soms twee tot drie keer meer dan ze gewend waren. Het zou volgens de PvdA een enorme aanslag om het gezinsbudget zijn van minima."
                            }
                        ]
                    }
