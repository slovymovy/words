                    {
                        "translation_id": "9b26204d-028a-49b4-b7c7-1ea55edbdd4e",
                        "source_entry_id": "a0e6a5fe-a138-30b5-8058-33f422434978",
                        "source_sense_id": "1d740323-85a0-3049-921a-9216e555d005",
                        "source_sense_description": "lacking modesty",
                        "target_lang_word": "onbescheiden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbescheiden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4ab3d57a-fddf-362c-af4e-f88daf74f591",
                                        "entry_id": "71bb99a0-5d09-3724-b777-74c8e1e68c2f",
                                        "glosses": [
                                            "overtuigd zijn van de eigen kunde zonder dat men last heeft van een minderwaardigheidscomplex"
                                        ],
                                        "tags": [
                                            "te"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c1a210-c494-44e4-aba6-a92e9b2623b2",
                                                "sense_id": "4ab3d57a-fddf-362c-af4e-f88daf74f591",
                                                "text": "‘Tja, er komen almaar spelers bij, vooral kleine productiehuizen. Ik maak me weinig zorgen: zo lang je zelf goeie ideeën hebt, kom je wel aan de bak. En ik heb, als ik zo onbescheiden mag zijn, intussen gelukkig een track record dat vertrouwen geeft.’"
                                            },
                                            {
                                                "example_id": "3878c380-a4f4-478f-aa78-13cacf308886",
                                                "sense_id": "4ab3d57a-fddf-362c-af4e-f88daf74f591",
                                                "text": "Daar maakt Tunahan Kuzu van Denk zich geen zorgen over. Hij gaat ‘lekker lang’ naar Turkije. ,,Ik ga even heel onbescheiden doen, ik heb het dit jaar wel verdiend.” Hij bezoekt een week familie in Istanboel en Izmit, daarna zoekt hij drie weken de kust op. ,,En daarna gaan we nog een paar dagen naar de familie van mijn vrouw, in centraal Turkije.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dd588f2-3c99-30c5-a841-6f742c1967a0",
                                        "entry_id": "71bb99a0-5d09-3724-b777-74c8e1e68c2f",
                                        "glosses": [
                                            "brutaal en nieuwsgierig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d50a321-fd3d-4b4d-8bc3-ff42c4ef1ad8",
                                                "sense_id": "8dd588f2-3c99-30c5-a841-6f742c1967a0",
                                                "text": "Het stellen van brutale, onbescheiden vragen is prima, maar dan moet je niet raar opkijken als je geen antwoord krijgt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa104b50-f9af-461f-9fcc-8793300b1958",
                        "source_entry_id": "a0e6a5fe-a138-30b5-8058-33f422434978",
                        "source_sense_id": "1d740323-85a0-3049-921a-9216e555d005",
