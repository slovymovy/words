                    {
                        "translation_id": "a3b3dca4-6004-4eca-935d-a03dac31696d",
                        "source_entry_id": "85d27638-35f4-3897-ba20-60f16b1a58a0",
                        "source_sense_id": "c26359db-a072-3097-ba4a-28f7e1524e80",
                        "target_lang_word": "Odyssee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Odyssee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d5211db-5453-3810-a56c-33bdfad5d1bb",
                                        "entry_id": "25517d8c-a564-323c-88d7-1031179d6d71",
                                        "glosses": [
                                            "die Irrfahrt des Odysseus"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be5a1747-aaef-4ec4-8893-27d9ad569d2b",
                                                "sense_id": "5d5211db-5453-3810-a56c-33bdfad5d1bb",
                                                "text": "Das Epos des Homer beginnt im zehnten Jahr der Odyssee."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d196876e-cf71-3102-b087-6789c2d4ce12",
                                        "entry_id": "25517d8c-a564-323c-88d7-1031179d6d71",
                                        "glosses": [
                                            "generell jede Irrfahrt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46e7072-5fa8-48fd-8905-3e6d6c99ceaf",
                                                "sense_id": "d196876e-cf71-3102-b087-6789c2d4ce12",
                                                "text": "„Tausende Bahnpassagiere haben in den letzten 24 Stunden eine wahre Odyssee hinter sich gebracht.“"
                                            },
                                            {
                                                "example_id": "d8267045-b40b-4104-9093-dd3c02df7751",
                                                "sense_id": "d196876e-cf71-3102-b087-6789c2d4ce12",
                                                "text": "„Die Odyssee des Heiligen endet schließlich im nordostenglischen Durham.“"
                                            },
                                            {
                                                "example_id": "82e00909-e4b3-4594-a162-3354d7d27cc4",
                                                "sense_id": "d196876e-cf71-3102-b087-6789c2d4ce12",
                                                "text": "„Seine Odyssee endet nach Jahren der Wanderschaft in Šiauliai, wo er ab Anfang der Fünfzigerjahre in der Kolchose arbeitet.“"
                                            },
                                            {
                                                "example_id": "d9bc1c8b-7d40-454b-bd3e-1eaf52f1562e",
                                                "sense_id": "d196876e-cf71-3102-b087-6789c2d4ce12",
                                                "text": "„Zugleich wird die Odyssee einer aus ihrem Volk Verstoßenen erzählt.“"
                                            },
                                            {
                                                "example_id": "308b26cf-76a7-4876-99e1-c920276a5390",
                                                "sense_id": "d196876e-cf71-3102-b087-6789c2d4ce12",
                                                "text": "„Wer unsere Odyssee durch die Geschichte des Genussystems nicht mitgemacht hat, strandet zwangsläufig bei Twain.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
