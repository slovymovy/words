                "senses": [
                    {
                        "sense_id": "0a19f245-52d8-3081-9f04-34450c642427",
                        "entry_id": "8e372414-fa48-3ff0-9d99-9eb722b50797",
                        "glosses": [
                            "Rendre kascher, ou rendre propre à une utilisation kascher (quelque chose qui a servi de façon non kascher)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9be833d1-5cf5-4787-9a4f-be999c006c7c",
                                "sense_id": "0a19f245-52d8-3081-9f04-34450c642427",
                                "text": "Lorsque le rabbin responsable s'est rendu compte de l'erreur, il a fallu kaschériser toute la vaisselle de cet établissement."
                            },
                            {
                                "example_id": "a7d2f0b9-1b3d-4e4d-9e1d-3363e338a447",
                                "sense_id": "0a19f245-52d8-3081-9f04-34450c642427",
                                "text": "J'ai aussi appelé certains services à la clientèle de fabricants qui ont entièrement « kaschérisé » leurs lignes de production."
                            },
                            {
                                "example_id": "2279bbfd-755f-41b6-b6f7-91fd15a5c756",
                                "sense_id": "0a19f245-52d8-3081-9f04-34450c642427",
                                "text": "Encore une de ces racailles bonnes à kaschériser à l'eau bénite, grommela l'apôtre !"
                            }
                        ]
                    }
                ],
