                                "example_id": "0ba08411-318a-47a7-b0a8-296f499dd134",
                                "sense_id": "696c837d-d9a0-350b-b827-596e41ba9bb3",
                                "text": "Johannes Lubordus werd eervol ontslagen en kreeg een pension van ƒ230,-, ongeveer 2/3 van zijn laatst verdiende loon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a600077-6500-48f4-95a0-e60f689e2df0",
                        "source_entry_id": "32266e47-fbc5-3ad9-94d7-edb957cb6e5a",
                        "source_sense_id": "492726b6-7448-3ce4-b3b2-af9a76b5af69",
                        "source_sense_description": "een gelegenheid waar men kan overnachten",
                        "target_lang_word": "guesthouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guesthouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "644cd5da-7307-3ce0-8a8f-dfea91bb0550",
                                        "entry_id": "2830ad9a-ab4a-3532-9a05-ce105c5a0ea7",
                                        "glosses": [
                                            "A small house near a main house, for lodging visitors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd02aa64-467d-4c2b-911d-c564ced5de04",
                                                "sense_id": "644cd5da-7307-3ce0-8a8f-dfea91bb0550",
                                                "text": "The wine house and the guest house were hung with curtains shining bright against the wooden walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                        "entry_id": "2830ad9a-ab4a-3532-9a05-ce105c5a0ea7",
                                        "glosses": [
                                            "A private house offering accommodation to paying guests; a boarding house; a bed and breakfast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7fdad0-f264-41d7-8966-26bb16cb74c6",
                                                "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                                "text": "Low-season competition between the several backpackers and many guesthouses in town keeps prices down, but in high season expect steep price hikes (except at the backpackers) and book ahead."
                                            },
                                            {
                                                "example_id": "0e42bece-627c-46ab-81e1-5aee91a0bdaa",
                                                "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                                "text": "For me, in any case, Ladakh seemed a beautifully unfallen place next to the blue-glass shopping malls of modern Lhasa, the global village of pizza joints and guesthouses that is urban Nepal, or long-isolated Bhutan with its chic new hotels."
                                            },
                                            {
                                                "example_id": "cc224131-a2bd-4d70-be29-f4d5e90c4f0f",
                                                "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                                "text": "And Ms. Davies’s 7,000-square-foot guesthouse, the only building from the original estate to survive, is already a favorite among card-playing foursomes and others who want to lounge on the second-story deck and watch dolphins bob in the whitecapped waves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "992f19c4-39da-4c5b-9a27-17703120f3c1",
                        "source_entry_id": "32266e47-fbc5-3ad9-94d7-edb957cb6e5a",
                        "source_sense_id": "492726b6-7448-3ce4-b3b2-af9a76b5af69",
                        "source_sense_description": "een gelegenheid waar men kan overnachten",
                        "target_lang_word": "boarding house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boarding house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf83e02-5116-3e76-a7af-7381d29f032e",
                                        "entry_id": "0aa2fa09-4743-3dfc-bcd7-211c2651df72",
                                        "glosses": [
                                            "A private house in which paying residents are provided with accommodation and meals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c176ba-e53c-47a4-a191-b964d383392e",
                                                "sense_id": "6cf83e02-5116-3e76-a7af-7381d29f032e",
                                                "text": "Yet Clacton, like every other station at a big seaside resort, is bedevilled by the traditional insistence of boarding-house landladies that their clients must arrive on Saturday before lunch and leave on Saturday after breakfast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "974490cd-0e34-382b-8a20-1f65e4f16206",
                                        "entry_id": "0aa2fa09-4743-3dfc-bcd7-211c2651df72",
                                        "glosses": [
                                            "A boarding school building where boarders live during term time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "268c6455-72c8-4624-b3b6-6f562f52b2fd",
                        "source_entry_id": "32266e47-fbc5-3ad9-94d7-edb957cb6e5a",
                        "source_sense_id": "492726b6-7448-3ce4-b3b2-af9a76b5af69",
                        "source_sense_description": "een gelegenheid waar men kan overnachten",
                        "target_lang_word": "pension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00f8cf8f-9c4a-3364-b5c0-6d118a68750f",
                                        "entry_id": "d5e76323-3a79-3397-82f5-9dfc39679104",
                                        "glosses": [
                                            "Somme d’argent que l’on donne pour être logé, nourri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706b6f45-69c9-486b-96a4-54cff5b1b926",
                                                "sense_id": "00f8cf8f-9c4a-3364-b5c0-6d118a68750f",
                                                "text": "Il a payé les deux premiers trimestres de sa pension."
                                            },
                                            {
                                                "example_id": "b3407c57-50dc-44ec-89f8-655085922b7a",
                                                "sense_id": "00f8cf8f-9c4a-3364-b5c0-6d118a68750f",
                                                "text": "« Au regard des inégalités salariales (en défaveur des femmes), si on défiscalise ces pensions pour les mères et que l’on fait payer des impôts aux personnes qui versent ces pensions, dans la majorité des cas le père, cela représenterait d’après nos calculs environ 450 millions en plus pour l’État », explique le député selon des propos rapportés par le quotidien francilien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd373853-3bb6-33e1-af21-d7d060a87756",
                                        "entry_id": "d5e76323-3a79-3397-82f5-9dfc39679104",
                                        "glosses": [
                                            "Lieu où l’on est nourri et logé pour un certain prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a5da1d6-cb24-4a35-b61c-cf694738faf0",
                                                "sense_id": "dd373853-3bb6-33e1-af21-d7d060a87756",
                                                "text": "[…], il ne manqua pas de déserteurs en Lozère comme dans les autres départements. Pour les réduire au devoir, l'autorité employa d'abord les gendarmes, […] ; puis elle eut recourt aux garnisaires : on mettait des soldats en pension forcée chez les parents des conscrits réfractaires jusqu'à reddition de leur fils."
                                            },
                                            {
                                                "example_id": "a16630b0-81b2-4e54-a6b0-f3e65cb691e6",
                                                "sense_id": "dd373853-3bb6-33e1-af21-d7d060a87756",
                                                "text": "M. Hippolyte Brichet était ferronnier à Levrézy avant d'installer une modeste pension pour les ouvriers qui lui laissait le temps de s'adonner à un petit commerce de quincaillerie pour une clientèle strictement locale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb11dcef-1583-3997-880a-6fe0888f8a6e",
                                        "entry_id": "d5e76323-3a79-3397-82f5-9dfc39679104",
                                        "glosses": [
                                            "Pensionnat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90d6057-181d-4a7c-870e-4d84bf5b0195",
                                                "sense_id": "fb11dcef-1583-3997-880a-6fe0888f8a6e",
                                                "text": "J'ai assisté une fois à une représentation donnée à Senlis dans une pension de demoiselles."
                                            },
                                            {
                                                "example_id": "0d06f411-e237-43fc-9ab0-a3265260ab0d",
                                                "sense_id": "fb11dcef-1583-3997-880a-6fe0888f8a6e",
                                                "text": "À cinq ans, j’ai été exporté en pension ; à sept ans, emprisonné au lycée."
                                            },
                                            {
                                                "example_id": "723fe41a-a604-4195-8080-791918b6edec",
                                                "sense_id": "fb11dcef-1583-3997-880a-6fe0888f8a6e",
                                                "text": "Dès qu’elle sait épeler, ses parents la mettent en pension dans un couvent de Dominicaines, situé près de Bruxelles."
                                            },
                                            {
                                                "example_id": "0a93cc20-98b3-4f14-b1d6-a40704d4f3a4",
                                                "sense_id": "fb11dcef-1583-3997-880a-6fe0888f8a6e",
                                                "text": "Cette dernière est facile à résoudre, reprit le capitaine Barbier. Il y a dans le quartier latin, impasse des Feuillantines, la pension Barbet. C'est une école préparatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae83d87-e7c8-3166-bbe3-7632eb63f8a7",
                                        "entry_id": "d5e76323-3a79-3397-82f5-9dfc39679104",
                                        "glosses": [
                                            "Réunion des enfants que renferme une pension."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2362f35b-b327-415e-bc84-2e4fe8db8592",
                                                "sense_id": "6ae83d87-e7c8-3166-bbe3-7632eb63f8a7",
                                                "text": "Toute la pension est en promenade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                        "entry_id": "d5e76323-3a79-3397-82f5-9dfc39679104",
                                        "glosses": [
                                            "Rente qu’un souverain, un État, une institution, un particulier, etc., donne annuellement à quelqu’un, pour récompense de ses services, de ses travaux, ou par munificence, par libéralité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d320b25b-4c89-4a63-9126-2a5ab14524ef",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Il a une pension de douze mille francs."
                                            },
                                            {
                                                "example_id": "26ab6bda-00e2-4a66-91f5-6613f5a6b0f6",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Une pension de retraite."
                                            },
                                            {
                                                "example_id": "73e2500e-2fcd-468a-9c8d-2b9ff7fce525",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Une pension viagère."
                                            },
                                            {
                                                "example_id": "4880f146-0df0-43c7-8012-0a14c5e3b704",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Une pension réversible."
                                            },
                                            {
                                                "example_id": "5f9e4e32-2fd3-4522-b607-06512c7b8403",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Il vient de toucher le premier trimestre de sa pension."
                                            },
                                            {
                                                "example_id": "9cdab61b-f428-4f26-90e1-037574df1b26",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Il a fait une pension à l’ancien précepteur de ses enfants."
                                            },
                                            {
                                                "example_id": "a374f83b-c3cf-4ad5-b02a-69a442521be1",
                                                "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                                                "text": "Il a légué à son ancien domestique une pension alimentaire et insaisissable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9e71a9-fb32-3d64-93f0-e6ea6dfba8dd",
                                        "entry_id": "d5e76323-3a79-3397-82f5-9dfc39679104",
                                        "glosses": [
                                            "Gage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a4c27a-e38f-4262-a572-3a7c79e4cb4b",
                                                "sense_id": "6a9e71a9-fb32-3d64-93f0-e6ea6dfba8dd",
                                                "text": "La mise en pension de titres financiers consiste à fournir des titres au prêteur comme gage, soit en les bloquant sur un compte à son nom, soit en les lui virant en dépôt chez lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
