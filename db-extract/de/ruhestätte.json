                "senses": [
                    {
                        "sense_id": "c9726779-c334-3f42-a7dd-346145ce4a5d",
                        "entry_id": "74656f43-b040-3d4a-88ad-7ba47464e67e",
                        "glosses": [
                            "Platz/Stelle der Bestattung"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "dc4e621d-fa7f-484a-bb0c-20b3a6a14051",
                                "sense_id": "c9726779-c334-3f42-a7dd-346145ce4a5d",
                                "text": "„Ihre letzte Ruhestätte fand sie auf dem Bonner Friedhof, an Roberts Seite, wie sie es gewünscht hatte.“"
                            },
                            {
                                "example_id": "cf5748b8-c455-4161-8b59-4923e5c5a44e",
                                "sense_id": "c9726779-c334-3f42-a7dd-346145ce4a5d",
                                "text": "„Auch diese Ruhestätte, die so überaus sorgfältig geplant war, aber wohl nicht ausreichend gewartet wurde, erlag den Zeiteinflüssen und wurde 1924, zur 200. Wiederkehr seines Geburtstags, durch ein neues Grabmal ersetzt, das Friedrich Lahrs entworfen hatte.“"
                            },
                            {
                                "example_id": "7dd4bed7-9aab-427b-bb99-f8d0a483c2f5",
                                "sense_id": "c9726779-c334-3f42-a7dd-346145ce4a5d",
                                "text": "„Während die Toten üblicherweise außerhalb der Mauern beigesetzt wurden, verblieben die 14 Toten, die im Laufe der Zeit dort ihre letzte Ruhestätte finden sollten, inmitten des quirligen Lebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f3d84d0-ac5f-3130-a226-c8870eb7cbd8",
                        "entry_id": "74656f43-b040-3d4a-88ad-7ba47464e67e",
