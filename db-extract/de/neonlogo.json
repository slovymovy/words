                ],
                "senses": [
                    {
                        "sense_id": "3f86b0c4-ed61-3520-aa8d-02ee11b5c593",
                        "entry_id": "175e3215-a074-300a-bc90-477f25ca44f5",
                        "glosses": [
                            "Logo, in dem Neon zur Lichterzeugung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad4fab8b-bbe8-4948-ba7d-710a169c2ecf",
                                "sense_id": "3f86b0c4-ed61-3520-aa8d-02ee11b5c593",
                                "text": "„Als die Sonne untergeht, weicht ihr Licht dem zahlreicher Neonlogos, die aus dem Firmengetto erstrahlen, welches die natürliche Umwelt dieses U-Stor-It bildet.“"
                            },
                            {
                                "example_id": "878a4f5d-14e5-4b78-8944-03e4d41c0abd",
                                "sense_id": "3f86b0c4-ed61-3520-aa8d-02ee11b5c593",
                                "text": "In Andreas Langes Büro im achten Stock des NDR-Gebäudes in Hamburg-Lokstedt hängt das „extra 3“-Neonlogo, das in den Jahren von 1989 bis 1997 im TV-Studio hing."
                            },
                            {
                                "example_id": "7b7e71a3-f7f7-4d8c-a9d0-a958be9749e6",
                                "sense_id": "3f86b0c4-ed61-3520-aa8d-02ee11b5c593",
                                "text": "Die Box kommt mit AC/DC-Neonlogo, das auf Knopfdruck leuchtet, gleichzeitig ertönt aus integrierten Lautsprechern das Anfangsriff der Single „Shot In The Dark“."
                            },
                            {
                                "example_id": "9ab505c9-c7bb-457f-b357-4255601dfe6f",
                                "sense_id": "3f86b0c4-ed61-3520-aa8d-02ee11b5c593",
                                "text": "Die Plakate sind eh schon aus den Nullerjahren, das Neonlogo ist sicher älter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
