{
    "word_family": [
        "duiding",
        "beduiden",
        "verduidelijken",
        "duidelijk",
        "misduiden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3835c581-7b47-31bd-bbbb-d7b19a46431c",
                    "sense_definition": "iets kenbaar maken door het aan te wijzen of te markeren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indiceren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schaal van Beaufort wordt gebruikt om de snelheid van de wind <w>aan</w> te <w>duiden</w>.",
                            "target_lang_translations": {
                                "en": "The Beaufort scale is used to <w>indicate</w> the speed of the wind."
                            }
                        },
                        {
                            "text": "Je kunt de juiste richting op de kaart met een rode pijl <w>aanduiden</w>.",
                            "target_lang_translations": {
                                "en": "You can <w>mark</w> the correct direction on the map with a red arrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanwijzen"
                    ],
                    "common_phrases": [
                        "de richting aanduiden",
                        "met een symbool aanduiden"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something known by pointing it out, marking it, or indicating it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indicate",
                                "target_lang_sense_clarification": "to point out or show"
                            },
                            {
                                "target_lang_word": "mark",
                                "target_lang_sense_clarification": "to identify with a sign or symbol"
                            },
                            {
                                "target_lang_word": "point out",
                                "target_lang_sense_clarification": "to direct attention to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df91b16d-b556-3c22-aca7-6b7e51b0c209",
                    "sense_definition": "een bepaalde betekenis hebben of naar iets verwijzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betekenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vermoedelijk <w>duidt</w> dit specifieke woord iets heel anders <w>aan</w> in deze context.",
                            "target_lang_translations": {
                                "en": "Presumably, this specific word <w>signifies</w> something completely different in this context."
                            }
                        },
                        {
                            "text": "Deze symptomen kunnen op een ernstige infectie <w>aanduiden</w>.",
                            "target_lang_translations": {
                                "en": "These symptoms may <w>indicate</w> a serious infection."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een betekenis aanduiden"
                    ],
                    "target_lang_definitions": {
                        "en": "To have a certain meaning, signify something, or refer to something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indicate",
                                "target_lang_sense_clarification": "to be a sign or symptom of"
                            },
                            {
                                "target_lang_word": "signify",
                                "target_lang_sense_clarification": "to mean or represent"
                            },
                            {
                                "target_lang_word": "denote",
                                "target_lang_sense_clarification": "to be a name or symbol for"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e488cbe2-d215-33bd-a174-c7b81df7d837",
                    "sense_definition": "iets of iemand een bepaalde naam of kwalificatie geven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "benoemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>duidden</w> het water altijd <w>aan</w> als een kanaal in plaats van een rivier.",
                            "target_lang_translations": {
                                "en": "They always <w>referred to</w> the water as a canal instead of a river."
                            }
                        },
                        {
                            "text": "De voorzitter wilde de situatie als een crisis <w>aanduiden</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "The chairman wanted to <w>label</w> the situation as a crisis during the meeting."
                            }
                        }
                    ],
                    "common_phrases": [
                        "als zodanig aanduiden"
                    ],
                    "target_lang_definitions": {
                        "en": "To give something or someone a specific name, label, or qualification."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "designate",
                                "target_lang_sense_clarification": "to officially name or specify"
                            },
                            {
                                "target_lang_word": "refer to",
                                "target_lang_sense_clarification": "to call by a certain name"
                            },
                            {
                                "target_lang_word": "label",
                                "target_lang_sense_clarification": "to describe as"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a63a8280-2e73-3fb0-bfb6-5b6704539eda",
                    "sense_definition": "gedachten of gevoelens onder woorden brengen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uitdrukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is soms lastig om complexe emoties precies <w>aan</w> te <w>duiden</w>.",
                            "target_lang_translations": {
                                "en": "It is sometimes difficult to precisely <w>articulate</w> complex emotions."
                            }
                        },
                        {
                            "text": "De dichter probeert de sfeer van de avond in zijn verzen <w>aan</w> te <w>duiden</w>.",
                            "target_lang_translations": {
                                "en": "The poet tries to <w>convey</w> the atmosphere of the evening in his verses."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdrukken",
                        "verwoorden"
                    ],
                    "common_phrases": [
                        "gevoelens aanduiden"
                    ],
                    "target_lang_definitions": {
                        "en": "To put thoughts, feelings, or atmospheres into words; to articulate."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "articulate",
                                "target_lang_sense_clarification": "to express clearly in words"
                            },
                            {
                                "target_lang_word": "express",
                                "target_lang_sense_clarification": "to convey a thought or feeling"
                            },
                            {
                                "target_lang_word": "define",
                                "target_lang_sense_clarification": "to state precisely"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}