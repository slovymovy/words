    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bbefc429-154d-3303-8ac8-dcdc916c9fe1",
                "word": "pother",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b1400cc1-20b2-42ad-aa47-582d38f6c797",
                        "entry_id": "bbefc429-154d-3303-8ac8-dcdc916c9fe1",
                        "tags": [
                            "plural"
                        ],
                        "form": "pothers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6945bc83-26c7-36ab-998a-0e7d59b297bc",
                        "entry_id": "bbefc429-154d-3303-8ac8-dcdc916c9fe1",
                        "glosses": [
                            "A commotion, a tempest."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6b6315-c80a-4eaf-8ca5-49bc4b27ed6b",
                                "sense_id": "6945bc83-26c7-36ab-998a-0e7d59b297bc",
                                "text": "Let the great gods, / That keep this dreadful pother o’er our heads, / Find out their enemies now."
                            },
                            {
                                "example_id": "718484fe-3dad-43c3-a733-044443d782f5",
                                "sense_id": "6945bc83-26c7-36ab-998a-0e7d59b297bc",
                                "text": "(name of the article) Flight Of Hess Causes Pother Among Germans"
                            },
                            {
                                "example_id": "417f9e00-2618-427c-aeac-a848e01bb817",
                                "sense_id": "6945bc83-26c7-36ab-998a-0e7d59b297bc",
                                "text": "After some years there came a time when the Queen seemed to be ill and there was a great deal of bustle and pother about her in the castle and doctors came and the courtiers whispered."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c33086f2-f035-49fd-b6fc-17bf44fff67f",
                        "source_entry_id": "bbefc429-154d-3303-8ac8-dcdc916c9fe1",
                        "source_sense_id": "6945bc83-26c7-36ab-998a-0e7d59b297bc",
                        "source_sense_description": "a commotion, a tempest",
                        "target_lang_word": "rwetes",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rwetes",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f6be3e-3e6d-3c0b-9645-c6a320405f92",
                                        "entry_id": "7def3155-3257-32a7-9008-49f9d72616fd",
                                        "glosses": [
                                            "hałas w połączeniu z bieganiną"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f81d5d0-7206-46a1-b864-512f3359d6f7",
                                                "sense_id": "e9f6be3e-3e6d-3c0b-9645-c6a320405f92",
                                                "text": "Wtem ze świecą wchodzi mama… / Co za rwetes? Co za krzyki? A do łóżka!"
                                            },
                                            {
                                                "example_id": "5bb98381-c70d-4a25-a4b3-b9bdd095daa0",
                                                "sense_id": "e9f6be3e-3e6d-3c0b-9645-c6a320405f92",
                                                "text": "Przez całą noc panował wielki rwetes, gdyż wszystko ustawiano na swojem miejscu, a nadto wciąż nadjeżdżały łodzie z przyjaciółmi dziedzica"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5783fa84-cce3-4d0c-88c4-7e9aa14404c9",
                        "source_entry_id": "bbefc429-154d-3303-8ac8-dcdc916c9fe1",
                        "source_sense_id": "6945bc83-26c7-36ab-998a-0e7d59b297bc",
                        "source_sense_description": "a commotion, a tempest",
                        "target_lang_word": "шу́м",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шу́м",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b85543bd-9888-3f00-8a96-9381d89a2966",
                                        "entry_id": "127a6871-538d-3f89-954a-a1c5adb39671",
                                        "glosses": [
                                            "громкие звуки, сливающиеся в нечто неясное и нестройное или воспринимаемые как помеха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55b7a24-d5a9-443e-ab0f-30718d6a9e9a",
                                                "sense_id": "b85543bd-9888-3f00-8a96-9381d89a2966",
                                                "text": "Тут я препроводил праздники столь весело, сколько в шуму и чаду веселиться можно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7351a911-8f3d-3117-803e-e43f5cc5115d",
                                        "entry_id": "127a6871-538d-3f89-954a-a1c5adb39671",
                                        "glosses": [
                                            "перен. оживлённое обсуждение чего-либо в обществе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb6f76a-1fb3-48c7-bae3-906bb7600079",
                                                "sense_id": "7351a911-8f3d-3117-803e-e43f5cc5115d",
                                                "text": "Его поступок наделал шуму."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b8876a-8b5d-382d-acf8-d31687b9d096",
                                        "entry_id": "127a6871-538d-3f89-954a-a1c5adb39671",
                                        "glosses": [
                                            "перен. громкая ссора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c2f7fd-ede7-4563-9311-95efa4e946c5",
                                                "sense_id": "12b8876a-8b5d-382d-acf8-d31687b9d096",
                                                "text": "Сначала всё шло мирно, но потом поднялся шум."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "шу́м",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efe8b540-b903-3967-86e0-a185c6d0c407",
                                        "entry_id": "40085c96-7abd-381d-84e6-8fa09070e4d8",
                                        "glosses": [
                                            "мед. неясно выраженная тональность при прослушивании организма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7f4c0a-2708-4717-b596-8f96ffdaffcb",
                                                "sense_id": "efe8b540-b903-3967-86e0-a185c6d0c407",
                                                "text": "Шумы в сердце."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0cba85b-373b-3268-95c2-66fe24170bdc",
                                        "entry_id": "40085c96-7abd-381d-84e6-8fa09070e4d8",
                                        "glosses": [
                                            "физ. помехи, затрудняющие восприятие информационного сигнала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8111ee83-89a9-4634-8c6d-f56d563de040",
                                                "sense_id": "e0cba85b-373b-3268-95c2-66fe24170bdc",
                                                "text": "Соотношение сигнал — шум было очень высоким."
                                            },
                                            {
                                                "example_id": "6bbb6343-9a32-4b10-9f9a-f87637161f97",
                                                "sense_id": "e0cba85b-373b-3268-95c2-66fe24170bdc",
                                                "text": "Шумы забивают передачу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "шу́м",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e147e905-4821-3fe7-a70e-3c8f65fd50a3",
                                        "entry_id": "472cfa64-fb36-30ff-9e71-0339da5e6c32",
                                        "glosses": [
                                            "кулин. пена, возникающая при варке супа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e947bfc-1275-4b6c-b821-48077c3f6fcf",
                                                "sense_id": "e147e905-4821-3fe7-a70e-3c8f65fd50a3",
                                                "text": "Когда закипит не забудь снять ложкой шум (это серая пена) и выбросить"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
