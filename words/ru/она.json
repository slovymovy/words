    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "b682bb43-b542-343a-ba36-c3584f1b4ed1",
                    "sense_definition": "Личное местоимение 3-го лица единственного числа женского рода. Указывает на лицо женского пола или предмет, названный существительным женского рода.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "personal_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Она</w> работает учителем в школе.",
                            "target_lang_translations": {
                                "en": "<w>She</w> works as a teacher at school.",
                                "zh": "<w>她</w>在学校当老师。"
                            }
                        },
                        {
                            "text": "Где твоя книга? — <w>Она</w> лежит на столе.",
                            "target_lang_translations": {
                                "en": "Where is your book? — <w>It</w> is lying on the table.",
                                "zh": "你的书在哪儿？— <w>它</w>在桌子上。"
                            }
                        },
                        {
                            "text": "Я давно не видел <w>её</w>.",
                            "target_lang_translations": {
                                "en": "I haven't seen <w>her</w> for a long time.",
                                "zh": "我很久没见到<w>她</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "он"
                    ],
                    "common_phrases": [
                        "она сама",
                        "вот она",
                        "где она"
                    ],
                    "target_lang_definitions": {
                        "en": "Third-person singular feminine personal pronoun. Refers to a female person or an object denoted by a feminine noun.",
                        "zh": "第三人称单数阴性代词。指代女性或阴性名词所指的事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "she",
                                "target_lang_sense_clarification": "refers to a female person or animal"
                            },
                            {
                                "target_lang_word": "it",
                                "target_lang_sense_clarification": "refers to an inanimate object that is feminine in Russian"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "她",
                                "target_lang_sense_clarification": "指代女性"
                            },
                            {
                                "target_lang_word": "它",
                                "target_lang_sense_clarification": "指代无生命的事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4f76b9c9-d6e0-31f9-a705-f3af9831c1e7",
                    "sense_definition": "Река в России (протекает в Хакасии или Бурятии).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geo_name",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Туристы отправились на сплав по реке <w>Она</w>.",
                            "target_lang_translations": {
                                "en": "Tourists went rafting on the <w>Ona</w> river.",
                                "zh": "游客们去<w>奥纳河</w>漂流了。"
                            }
                        },
                        {
                            "text": "Река <w>Она</w> славится своей чистой водой.",
                            "target_lang_translations": {
                                "en": "The <w>Ona</w> river is famous for its clean water.",
                                "zh": "<w>奥纳河</w>以其清澈的河水而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A river in Russia (flows in Khakassia or Buryatia).",
                        "zh": "俄罗斯的一条河流（流经哈卡斯共和国或布里亚特共和国）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Ona",
                                "target_lang_sense_clarification": "geographical name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奥纳河",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
