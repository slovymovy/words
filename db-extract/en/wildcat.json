                                            {
                                                "example_id": "70d3c139-5953-4962-a14c-9d0962ee7e91",
                                                "sense_id": "22b75d2d-48c9-3d1e-9118-26a4c9ef13d8",
                                                "text": "Szerokie usta mięsiste otworzył, białe zęby świeciły jak u żbika"
                                            },
                                            {
                                                "example_id": "b4b0f336-32ac-44db-9c04-dca9c16adf4a",
                                                "sense_id": "22b75d2d-48c9-3d1e-9118-26a4c9ef13d8",
                                                "text": "Parobczak nie widząc i nie słysząc, aby się coś ruszało, ośmielił się wreszcie rękę do dziupli wpuścić i z okrzykiem radości dobył z niej żbika, którego oko głęboko było strzałą przeszyte"
                                            },
                                            {
                                                "example_id": "9438a74a-debf-42a0-befc-62047a70d109",
                                                "sense_id": "22b75d2d-48c9-3d1e-9118-26a4c9ef13d8",
                                                "text": "Raz tylko puścił się ku nim jeden, widocznie śmielszej natury, z kosą w ręku; ale pan Michał skoczył jak żbik ku niemu on ukąsił go na śmierć"
                                            }
