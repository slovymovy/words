                },
                {
                    "sense_id": "7682a423-256b-3a8d-9048-cbd2f8ca0a78",
                    "sense_definition": "Fait de remplacer quelqu'un dans un emploi, une fonction, une charge ou un titre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune directeur se prépare activement à prendre la <w>succession</w> du fondateur de l'entreprise.",
                            "target_lang_translations": {
                                "en": "The young director is actively preparing to <w>take over</w> from the company's founder.",
                                "ru": "Молодой директор активно готовится <w>сменить</w> основателя компании на этом посту.",
                                "de": "Der junge Direktor bereitet sich aktiv darauf vor, die Nachfolge des Gründers des Unternehmens <w>anzutreten</w>.",
                                "es": "El joven director se prepara activamente para tomar el <w>relevo</w> del fundador de la empresa.",
                                "zh": "这位年轻的总监正在积极为公司创始人的<w>继任</w>做准备。"
                            }
                        },
                        {
                            "text": "La question de sa <w>succession</w> à la tête du parti politique divise profondément les membres.",
                            "target_lang_translations": {
                                "en": "The question of his <w>succession</w> as leader of the political party deeply divides its members.",
                                "ru": "Вопрос о его <w>смене</w> во главе политической партии глубоко разделяет её членов.",
                                "de": "Die Frage seiner <w>Nachfolge</w> an der Spitze der politischen Partei spaltet die Mitglieder tief.",
                                "es": "La cuestión de su <w>sucesión</w> a la cabeza del partido político divide profundamente a sus miembros.",
                                "zh": "关于他在该政党领导职位上的<w>继任</w>问题，党员之间存在深刻分歧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "remplacement",
                        "relais"
                    ],
                    "common_phrases": [
                        "prendre la succession",
                        "assurer la succession",
                        "guerre de succession"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of replacing someone in a job, office, role, or title.",
                        "ru": "Замена кого-либо в должности, на посту, в звании или титуле.",
                        "de": "Das Ersetzen einer Person in einer Stelle, einem Amt, einer Funktion oder einem Titel.",
                        "es": "Hecho de reemplazar a alguien en un empleo, función, cargo o título.",
                        "zh": "接替他人担任职位、职务、职称或头衔的行为。"
                    },
