                    {
                        "translation_id": "5f1f7129-c6ff-46ca-8871-54efa1e2bdff",
                        "source_entry_id": "1633cbb7-8f31-3275-add4-bf9bcb905c73",
                        "source_sense_id": "14fea1f9-9050-3114-beda-2e152f6849fc",
                        "target_lang_word": "Nebenniere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebenniere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e6e4bdc-011b-3e4d-809a-5cca03a20c72",
                                        "entry_id": "3890e4b4-04f2-3d81-9ae4-0faae1da6030",
                                        "glosses": [
                                            "eine paarige Hormondrüse der Säugetiere, Vögel, Reptilien und Amphibien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c394ab13-5b67-4c6f-8125-af8211158e4b",
                                                "sense_id": "6e6e4bdc-011b-3e4d-809a-5cca03a20c72",
                                                "text": "„Dieses Testosteron stammt nach Ausschalten der Hoden aus der Nebenniere.“"
                                            },
                                            {
                                                "example_id": "d7028339-810c-4edf-a38c-76fd5282b23c",
                                                "sense_id": "6e6e4bdc-011b-3e4d-809a-5cca03a20c72",
                                                "text": "„Die Bauchspeicheldrüse produziert während der Liebkosung verstärkt Insulin und die Nebenniere Adrenalin.“"
                                            },
                                            {
                                                "example_id": "1f9be88f-f362-48b7-86b5-a07865a9d74a",
                                                "sense_id": "6e6e4bdc-011b-3e4d-809a-5cca03a20c72",
                                                "text": "„Die Nebennieren produzieren mehr Adrenalin und die Bauchspeicheldrüse mehr Insulin.“"
                                            },
                                            {
                                                "example_id": "079b0657-55ac-44de-bcea-d1455aaff818",
                                                "sense_id": "6e6e4bdc-011b-3e4d-809a-5cca03a20c72",
                                                "text": "„Sensationsgier, der Begleiter jeder Gefahr, bei der man selbst nicht in Gefahr ist, schoß aus tausend Nebennieren Adrenalin in das Blut der Zuschauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4301c0c6-8e5e-4945-af08-21951fe2b822",
