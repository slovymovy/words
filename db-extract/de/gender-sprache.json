                "senses": [
                    {
                        "sense_id": "ddd31878-20c3-3f46-9ba0-7b472e2e5166",
                        "entry_id": "b90ec3e8-675d-33c1-8fb6-ee22392be923",
                        "glosses": [
                            "Sprachform, die von Menschen benutzt wird, um ihrer Meinung nach in Wort und Schrift geschlechtergerecht zu formulieren, wobei das generische Maskulinum abgelehnt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8a3ec9-326c-4782-833b-f61920fc7bd3",
                                "sense_id": "ddd31878-20c3-3f46-9ba0-7b472e2e5166",
                                "text": "„Die sogenannte Gender-Sprache gehört nach Senatsangaben nicht als akzeptierte Schreibweise in den Unterricht an Berliner Schulen.“"
                            },
                            {
                                "example_id": "ffe747f3-1d0f-4f5f-a3a7-b722a089e53a",
                                "sense_id": "ddd31878-20c3-3f46-9ba0-7b472e2e5166",
                                "text": "„Die Gender-Sprache und ihre Tücken: Sternchen in Wörtern können weiterhin als Fehler angestrichen werden, das ist die Konsequenz aus einer Entscheidung des Rats für deutsche Rechtschreibung.“"
                            },
                            {
                                "example_id": "bd421312-a338-42ad-b0b6-27e20f78a0ea",
                                "sense_id": "ddd31878-20c3-3f46-9ba0-7b472e2e5166",
                                "text": "„Wie soll es mit einer Gender-Sprache jemals wieder ein Gedicht geben, in dem Menschen vorkommen? Sollen Romane künftig wie mit Sonderzeichen-Passwörtern durchsetzt aussehen? Schlaflieder und Gedichte vorgetragen mit Genderpausen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
