                "senses": [
                    {
                        "sense_id": "3de8db31-d7db-36fa-86dd-4605eef921b4",
                        "entry_id": "b8698914-bb98-3b03-8265-a02386b4cfc4",
                        "glosses": [
                            "kostspieliger Urlaub, der bei der Auswahl der Transportmittel und der Unterkunft deutlich über das Übliche und Notwendige hinausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4448150b-e7bd-46c9-87d6-8e6c7e091cac",
                                "sense_id": "3de8db31-d7db-36fa-86dd-4605eef921b4",
                                "text": "„Lange Zeit stand die spanische Costa Blanca nicht für kulinarische Höhepunkte, schon gar nicht für Luxusurlaub.“"
                            },
                            {
                                "example_id": "3045aa17-a5ed-47df-ae8e-6db650161bb2",
                                "sense_id": "3de8db31-d7db-36fa-86dd-4605eef921b4",
                                "text": "„Denn, dass ich mir dieses Jahr keinen Luxusurlaub leisten kann, macht mir eigentlich nichts aus.“"
                            },
                            {
                                "example_id": "b77debbc-8f51-415f-8db3-87b4358cb479",
                                "sense_id": "3de8db31-d7db-36fa-86dd-4605eef921b4",
                                "text": "„Einer deutschen Familie vermiesten zu hohe Wellen und zu starker Wind ihren Luxusurlaub auf den Seychellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
