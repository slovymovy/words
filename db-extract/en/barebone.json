                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d7af33b-8904-47e1-bb2a-70a254c41163",
                                                "sense_id": "3e1d93a6-5d7e-33f0-9b5a-25e42cff34e4",
                                                "text": "Das Mensch geht mir auf die Nerven."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0adbb07-4c75-3f69-bb58-246a9d07bd88",
                                        "entry_id": "c7cac5ed-13b8-3b24-8f00-84d279071fa9",
                                        "glosses": [
                                            "Ausdruck der Verwunderung, Verärgerung, des Schreckes; Aufforderung an einen Mitmenschen, menschlich zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027de31e-7a19-49c5-ae48-d8d1dec25baa",
                                                "sense_id": "b0adbb07-4c75-3f69-bb58-246a9d07bd88",
                                                "text": "Mensch! Wo kommst du denn her?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb0fae2e-f534-4302-a638-14aafe48ed7f",
                        "source_entry_id": "7d260213-6d86-355b-907b-3a8d18f62390",
                        "source_sense_id": "7618318f-deb5-3e0c-8f5a-6ed491ef755d",
                        "source_sense_description": "sehr magerer Mensch",
                        "target_lang_word": "Gerippe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6df7a9-0feb-39b7-9639-96650a819018",
                                        "entry_id": "9edddfd5-2ef9-3a18-9006-d1b3ff5724b4",
                                        "glosses": [
                                            "Skelett, Knochengerüst, aus den festen, tragenden Teilen eines Körpers bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26da204e-608d-4e52-a61d-5e2dadece459",
                                                "sense_id": "fc6df7a9-0feb-39b7-9639-96650a819018",
                                                "text": "Er war zu einem Gerippe abgemagert."
                                            },
                                            {
                                                "example_id": "35947865-d56c-4b38-98d4-00864dc7f688",
                                                "sense_id": "fc6df7a9-0feb-39b7-9639-96650a819018",
                                                "text": "„Auf der einen Seite des Fjordes lagern zwei Boote in einer Lagerhalle aus Wellblech, eingezwängt zwischen den Felsen, in der Bucht gegenüber liegt das hellgelbe Gerippe eines Zwergwals, an dem blaues Ölzeug zum Trocknen hängt.“"
                                            },
                                            {
                                                "example_id": "7e8e2e0c-a7f1-4618-9f5d-76b3e0be3f05",
                                                "sense_id": "fc6df7a9-0feb-39b7-9639-96650a819018",
                                                "text": "„Sie bemerkten an diesen Zäunen häufig die Gerippe von Tieren, die dem Mexikaner fremd zu sein schienen; lange, fürchterliche Gerippe mit ungeheuern Rachen und Zähnen, die einen noch immer grinsend anbleckten, als wollten sie die Wanderer verschlingen.“"
                                            },
                                            {
                                                "example_id": "604352cf-8bb4-46a1-9f6f-d606c9c0693e",
                                                "sense_id": "fc6df7a9-0feb-39b7-9639-96650a819018",
                                                "text": "„Mir kam es vor, sein ganzes Gerippe knirschte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8398d367-2932-30de-8cca-829182c99172",
                                        "entry_id": "9edddfd5-2ef9-3a18-9006-d1b3ff5724b4",
                                        "glosses": [
                                            "Gesamtheit der zentralen Bauteile einer technischen Konstruktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eecb69f6-d6a6-47d4-8add-caf984c09776",
                                                "sense_id": "8398d367-2932-30de-8cca-829182c99172",
                                                "text": "Vom ganzen Schiffskörper fand man in tiefer See nur noch ein Gerippe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e406676-5ea3-3a6e-b30a-4cc54f7b4e1b",
                                        "entry_id": "9edddfd5-2ef9-3a18-9006-d1b3ff5724b4",
                                        "glosses": [
                                            "Grundstruktur eines sprachlichen oder künstlerischen Produkts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc53e64-55d6-4519-8af4-98934f65f2c3",
                                                "sense_id": "6e406676-5ea3-3a6e-b30a-4cc54f7b4e1b",
                                                "text": "Das Gerippe der Diplomarbeit steht schon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af0f1201-4ed0-3cc2-8c08-c9e9b828c012",
                                        "entry_id": "9edddfd5-2ef9-3a18-9006-d1b3ff5724b4",
                                        "glosses": [
                                            "sehr dürre, abgemagerte Person (die einem Skelett ähnelt)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e82a9d2-196d-4278-8d39-7c311c95e235",
                                                "sense_id": "af0f1201-4ed0-3cc2-8c08-c9e9b828c012",
                                                "text": "„Sobald wir allein sind, streckt das geschminkte Gerippe seine Arme aus, ehe ich Zeit hatte mich zu besinnen, und preßt seine feuchten Lippen auf meine Wange, daß mich ein Schauder durchläuft; eine ihrer Hände verirrt sich in der unanständigsten Weise, und sie sagt: »Laß doch mal sehen, mein Hühnchen – hast du denn auch einen schönen ....?«“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
