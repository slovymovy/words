                "senses": [
                    {
                        "sense_id": "d28c7a18-6454-3a62-9b53-76277c22f26f",
                        "entry_id": "028eb511-34f4-3bd0-a374-5d61c3f7942b",
                        "glosses": [
                            "Gruppe von inhaltlich miteinander verknüpften Themen (die sich häufig auf ein gemeinsames übergeordnetes Thema beziehen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ee1153-8743-4f73-b3e7-403bf2af3d36",
                                "sense_id": "d28c7a18-6454-3a62-9b53-76277c22f26f",
                                "text": "„In den fünf Seminartagen befassen sich die Teilnehmer mit einer Vielzahl von Fragen zu diesem Themenkomplex.“"
                            },
                            {
                                "example_id": "5eef8253-3f57-4651-a7e9-fc32e15946eb",
                                "sense_id": "d28c7a18-6454-3a62-9b53-76277c22f26f",
                                "text": "„Zum Themenkomplex Nachwuchsarbeit zählt auch die Umsetzung der bundesweit verbindlichen Einführung der Kinderspielformen.“"
                            },
                            {
                                "example_id": "08729db2-600c-4ddc-8d52-095e0f79d56b",
                                "sense_id": "d28c7a18-6454-3a62-9b53-76277c22f26f",
                                "text": "„Über knapp 260 Seiten entwickeln die Autorinnen in gut lesbarer Weise den Themenkomplex pragmatischen Sprachhandelns.“"
                            },
                            {
                                "example_id": "70f660a9-211f-4166-b09e-4eae050e89a1",
                                "sense_id": "d28c7a18-6454-3a62-9b53-76277c22f26f",
                                "text": "„In diesem umfangreichen Artikel zum Themenkomplex Darlehen mit Teilzeit, haben wir Ihnen verschiedene Kreditvermittler vorgestellt, die Sie statt gewöhnliche Banken nutzen können und die teilweise auch einen praktischen Kreditrechner auf Ihrer Webseite präsentieren.“"
                            },
                            {
                                "example_id": "3e2bc32a-2619-45f0-a02b-4dc2c2f6bdb9",
                                "sense_id": "d28c7a18-6454-3a62-9b53-76277c22f26f",
                                "text": "„Es wird für Unternehmen eine beratende Tätigkeit im gesamten Themenkomplex der Digitalisierung angeboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
