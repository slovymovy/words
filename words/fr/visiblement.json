                {
                    "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                    "sense_definition": "D'une manière appréciable à la vue ; de façon perceptible à l'œil nu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le niveau de la rivière montait <w>visiblement</w> au fil des heures.",
                            "target_lang_translations": {
                                "en": "The river level was rising <w>visibly</w> as the hours passed.",
                                "ru": "Уровень реки с каждым часом <w>заметно</w> поднимался.",
                                "de": "Der Wasserstand des Flusses stieg im Laufe der Stunden <w>sichtlich</w>.",
                                "es": "El nivel del río subía <w>visiblemente</w> con el paso de las horas.",
                                "zh": "河水的水位随着时间推移<w>明显地</w>上涨。"
                            }
                        },
                        {
                            "text": "En apprenant la mauvaise nouvelle, ses mains tremblaient <w>visiblement</w>.",
                            "target_lang_translations": {
                                "en": "On hearing the bad news, their hands were shaking <w>visibly</w>.",
                                "ru": "Когда он узнал плохую новость, его руки <w>заметно</w> дрожали.",
                                "de": "Beim Erfahren der schlechten Nachricht zitterten ihre Hände <w>sichtlich</w>.",
                                "es": "Al enterarse de la mala noticia, sus manos temblaban <w>visiblemente</w>.",
                                "zh": "听到这个坏消息时，他的双手<w>明显地</w>发抖。"
                            }
                        }
                    ],
                    "antonyms": [
                        "invisiblement"
                    ],
                    "common_phrases": [
                        "diminuer visiblement",
                        "grossir visiblement"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is noticeable to the eye; perceptibly so.",
                        "ru": "Так, что это заметно глазу; ощутимо для восприятия.",
                        "de": "So, dass es mit bloßem Auge wahrnehmbar ist; deutlich erkennbar.",
                        "es": "De forma que resulta perceptible a simple vista.",
                        "zh": "以肉眼可以察觉的方式表现出来，清晰可辨。"
                    },
