                    {
                        "translation_id": "e38ad8d7-50b3-478d-88a8-519e70c6ce8a",
                        "source_entry_id": "a3fc18aa-51b6-3264-ae1a-f1e85e944ad4",
                        "source_sense_id": "2485709a-7f23-38f8-b79b-b3549d0694e0",
                        "target_lang_word": "Ewe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ewe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                                        "entry_id": "f3b3c397-ff9e-331a-973f-5e3cf22f86b4",
                                        "glosses": [
                                            "eine Niger-Kongo-Sprache (genauer: Kwa-Sprache), die in Ghana und Togo vom gleichnamigen Volk gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "345594a1-0a97-43e9-8742-a8bbcd9e3a02",
                                                "sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                                                "text": "„Für die Herausbildung einer Literatursprache des Ewe war das Gebiet von Keta und Waya von Bedeutung.“"
                                            },
                                            {
                                                "example_id": "5141671b-c8ef-4798-9238-868e88254f76",
                                                "sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                                                "text": "„Der Begriff \"Voodoo\" kommt aus der westafrikanischen Sprache Ewe und bedeutet ursprünglich \"Schutzgeist\"“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ewe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c2689d2-8cbc-334f-b862-e6ec049b31d8",
                                        "entry_id": "afafe7f2-7ff1-32e8-a80e-a8275d1519ab",
                                        "glosses": [
                                            "Angehöriger einer Ethnie, die in Westafrika (in Ghana und Togo) lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3abf2cd2-7e24-4bcb-af08-1735a7af290d",
                                                "sense_id": "5c2689d2-8cbc-334f-b862-e6ec049b31d8",
                                                "text": "„Früher musste sich ein Ewe in jeder Akan-Stadt vor seiner Niederlassung beim Chief melden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ewe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                        "entry_id": "f4ba2c83-fea4-3a15-8dcf-9cc9b787af4a",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70deb8dd-62f9-49cf-ac93-e09d61ff841c",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Frau Ewe ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "4eed1354-5d48-4e36-a896-974a305502c0",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Herr Ewe wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "ca9b2bd1-9cbe-4824-95ea-3e9bab94f44a",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Die Ewes kommen heute aus der Lüneburger Heide."
                                            },
                                            {
                                                "example_id": "564cdcbe-7894-41dd-b620-9fe5155c37d6",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Der Ewe trägt nie die Schals, die die Ewe ihm strickt."
                                            },
                                            {
                                                "example_id": "1606037a-6a50-4e5b-aaf5-74e38dd6436e",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ewe kommt, geht der Herr Ewe.“"
                                            },
                                            {
                                                "example_id": "d1a4a875-d8ee-43fc-a4fa-6f28dfad78d3",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Ewe kommt und geht."
                                            },
                                            {
                                                "example_id": "d2975d44-054c-4527-bd16-b54aa032208b",
                                                "sense_id": "1ee92a0c-86af-3d6f-ab6e-7d654bb55818",
                                                "text": "Ewes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a57221e-19df-4d82-806f-bfb279a5fe8c",
                        "source_entry_id": "a3fc18aa-51b6-3264-ae1a-f1e85e944ad4",
                        "source_sense_id": "2485709a-7f23-38f8-b79b-b3549d0694e0",
