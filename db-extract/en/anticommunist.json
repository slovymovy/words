                    {
                        "translation_id": "54797340-bbca-4d82-9c85-1d02bd19f8a5",
                        "source_entry_id": "62f094a2-3d37-31da-94b1-8c1a71c91870",
                        "source_sense_id": "ccfead02-ff73-330b-b51e-8645ab95a070",
