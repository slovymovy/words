                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c964cb4e-c972-47fd-b765-7ff821c96244",
                                                "sense_id": "3eff793a-b54b-3085-a8db-afe2896959ef",
                                                "text": "‘The best kümmel comes in those bear-shaped bottles. It comes from Russia.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3da3b68f-0229-4122-b810-b6019fb864ea",
                        "source_entry_id": "1fe0aa7c-ea5a-3fa2-bc6f-92ae79328b88",
