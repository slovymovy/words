                "senses": [
                    {
                        "sense_id": "28dc3575-8f78-32ed-ab97-18b0ea68ec03",
                        "entry_id": "6a31a6be-1978-3580-8a6b-bdfd9b1f8382",
                        "glosses": [
                            "to await, to wait (un)till, to (manage to) wait for a long time"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebf5302b-a1cf-48e2-9f6b-d389bc33d021",
                                "sense_id": "28dc3575-8f78-32ed-ab97-18b0ea68ec03",
                                "text": "дожида́ться конца́ спекта́кля",
                                "translation": "to wait until the end of the show",
                                "english": "to wait until the end of the show"
                            },
                            {
                                "example_id": "cc91d01e-1a2a-4564-9a66-8be2fd0e89e1",
                                "sense_id": "28dc3575-8f78-32ed-ab97-18b0ea68ec03",
                                "text": "дожида́ться врача́",
                                "translation": "to wait till the doctor comes",
                                "english": "to wait till the doctor comes"
                            },
                            {
                                "example_id": "40cbddf1-35da-475d-be7c-da3d9c46a4a8",
                                "sense_id": "28dc3575-8f78-32ed-ab97-18b0ea68ec03",
                                "text": "Я дожида́юсь его́ прие́зда.",
                                "translation": "I'm waiting for his arrival (impatiently).",
                                "english": "I'm waiting for his arrival (impatiently)."
                            },
                            {
                                "example_id": "b42a1dec-2b37-4648-a611-1f43ca8e786f",
                                "sense_id": "28dc3575-8f78-32ed-ab97-18b0ea68ec03",
                                "text": "Все дожида́лись о́череди и оди́н за други́м бы́ли вводи́мы краси́вым белоку́рым ю́ношей-адъюта́нтом в кабине́т кня́зя.",
                                "translation": "They all waited their turn and were one by one shown into the prince's cabinet and out again by the aide-de-camp, a handsome, fair-haired youth.",
                                "english": "They all waited their turn and were one by one shown into the prince's cabinet and out again by the aide-de-camp, a handsome, fair-haired youth."
                            }
                        ]
                    }
                ],
