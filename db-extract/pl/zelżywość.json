                "senses": [
                    {
                        "sense_id": "e9d68a5c-99e1-37bf-ae30-b3757089d918",
                        "entry_id": "37fc4d23-ac64-3404-b1f1-12669d323573",
                        "glosses": [
                            "hańba, dyshonor"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "964c9589-c0c3-49b2-b200-dee2e3e6ff39",
                                "sense_id": "e9d68a5c-99e1-37bf-ae30-b3757089d918",
                                "text": "Hardy kmieć wchodząc nawet się nie pokłonił, czym wobec innych z miejsca uczynił księciu zelżywość wielką."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "78c53cd0-8ecb-3099-9cb6-386697f19355",
                        "entry_id": "37fc4d23-ac64-3404-b1f1-12669d323573",
                        "glosses": [
                            "charakterystyka tego, co zelżywe"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "033c85ec-866c-3d3b-8a19-aad87e5bcc2d",
                        "entry_id": "37fc4d23-ac64-3404-b1f1-12669d323573",
                        "glosses": [
                            "obelga, zniewaga"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8f60f4b5-19e7-457e-b855-a14bd04c47d8",
                                "sense_id": "033c85ec-866c-3d3b-8a19-aad87e5bcc2d",
                                "text": "Serce Jezusa, zelżywością napełnione, zmiłuj się nad nami!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfba3c81-8c58-47e3-8cb8-5245005fb807",
                        "source_entry_id": "37fc4d23-ac64-3404-b1f1-12669d323573",
                        "source_sense_id": "e9d68a5c-99e1-37bf-ae30-b3757089d918",
                        "target_lang_word": "opprobrium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opprobrium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e93c50d-d76d-3416-829f-3773d499c28b",
                                        "entry_id": "b92db8e4-3e31-3429-82e7-29baaabdd8e4",
                                        "glosses": [
                                            "A cause, object, or situation of disgrace or shame."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7eab017-1ebe-4b71-9218-6f1ff58ea490",
                                                "sense_id": "2e93c50d-d76d-3416-829f-3773d499c28b",
                                                "text": "As there are certain malignant diseases which have been denominated the opprobria of medicine, so there are particular maladies of our social condition, which may be considered the opprobria of legislation. Amongst the most inveterate of these are the poor laws."
                                            },
                                            {
                                                "example_id": "13f77846-464e-4f8b-952e-a3f55a6357d1",
                                                "sense_id": "2e93c50d-d76d-3416-829f-3773d499c28b",
                                                "text": "It was not that he was in danger of legal punishment or of beggary: he was in danger only of seeing disclosed to the judgment of his neighbours and the mournful perception of his wife certain facts of his past life which would render him an object of scorn and an opprobrium of the religion with which he had diligently associated himself."
                                            },
                                            {
                                                "example_id": "daecf32f-4e70-4705-ad6f-9955a64451aa",
                                                "sense_id": "2e93c50d-d76d-3416-829f-3773d499c28b",
                                                "text": "Twelve years have now elapsed since the first assassinations which proved the existence of a criminal organization in our midst. From that day these outrages have never ceased, until now they have reached a pitch which makes us the opprobrium of the civilized world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96484d50-38b1-33a9-9fc2-aa08e4a39133",
                                        "entry_id": "b92db8e4-3e31-3429-82e7-29baaabdd8e4",
                                        "glosses": [
                                            "Disgrace or bad reputation arising from exceedingly shameful behaviour; ignominy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c26fd91-6443-4263-aea4-d0a7774deb40",
                                                "sense_id": "96484d50-38b1-33a9-9fc2-aa08e4a39133",
                                                "text": "Let me add that it is the great deſideratum, by which alone this form of government can be reſcued from the opprobrium under which it has ſo long labored, and be recommended to the eſteem and adoption of mankind."
                                            },
                                            {
                                                "example_id": "d1405951-2eed-4154-ae03-4a626206139f",
                                                "sense_id": "96484d50-38b1-33a9-9fc2-aa08e4a39133",
                                                "text": "I am content to suffer alone, while my sufferings shall endure: when I die, I am well satisfied that abhorrence and opprobrium should load my memory."
                                            },
                                            {
                                                "example_id": "0d285e77-67af-4046-8193-93689f6ace6c",
                                                "sense_id": "96484d50-38b1-33a9-9fc2-aa08e4a39133",
                                                "text": "Virgin [Atlantic] won't pay a penny in fines and actually emerges as a winner, since all the opprobrium of the rule-breach has been heaped on BA [British Airways]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc2ee76-89aa-3896-a5b2-d1daafdc8b4a",
                                        "entry_id": "b92db8e4-3e31-3429-82e7-29baaabdd8e4",
                                        "glosses": [
                                            "Scornful contempt or reproach; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f524f2ba-c79b-4ddf-9c7e-3ddd9c86a8ac",
                                                "sense_id": "8cc2ee76-89aa-3896-a5b2-d1daafdc8b4a",
                                                "text": "[…]from that strict rectitude in which I have been accustomed to walk and to view my actions, and which, notwithstanding the unjust opprobrium cast upon me, I find to be an invincible support and shield."
                                            },
                                            {
                                                "example_id": "3d763971-d9fc-47b5-9586-d43291bc84fb",
                                                "sense_id": "8cc2ee76-89aa-3896-a5b2-d1daafdc8b4a",
                                                "text": "Some Johnny with brains produces a hypothesis. Everybody calls him a rotter at first. But he remains calm in the face of opprobrium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f845a276-30f8-36ab-ae7d-224dd91cfb51",
                                        "entry_id": "b92db8e4-3e31-3429-82e7-29baaabdd8e4",
                                        "glosses": [
                                            "Behaviour which is disgraceful or shameful."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
