                            {
                                "example_id": "a83d6fb8-a812-44d0-bd00-7ac3ad7ea9b3",
                                "sense_id": "56c4ded0-fafd-3ad0-bc15-af3a3f873d70",
                                "text": "Moja najlepsza przyjaciółka ma na imię Michalina."
                            },
                            {
                                "example_id": "8ffe4b4c-9346-463e-9893-b47e7bf08291",
                                "sense_id": "56c4ded0-fafd-3ad0-bc15-af3a3f873d70",
                                "text": "W Kościele katolickim na 19 czerwca przypada wspomnienie bł. Michaliny z Pesaro."
                            },
                            {
                                "example_id": "dd4abc31-1e00-4a37-9305-913b4cde216d",
                                "sense_id": "56c4ded0-fafd-3ad0-bc15-af3a3f873d70",
                                "text": "Michaliny dzień swej patronki, czyli imieniny, obchodzą 19 czerwca, a także 29 września."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
