                        "examples": [
                            {
                                "example_id": "06037d10-49ae-4214-9989-c6f6d3ca3b06",
                                "sense_id": "b0a0515b-8ba4-38f0-8fae-09287e5ce6c2",
                                "text": "Huit ans après qu’elle a créé la glamourissime Ulrika, il y a encore des gens pour penser que Marianne James est un homme."
                            },
                            {
                                "example_id": "eba1996e-76f6-414a-9c8d-149023041610",
                                "sense_id": "b0a0515b-8ba4-38f0-8fae-09287e5ce6c2",
                                "text": "Le grand architecte ami qui me raconte ce projet autour de la table d’un restaurant parisien glamourissime en a le regard illuminé de tendresse."
                            },
                            {
                                "example_id": "00164b07-d623-4b54-9035-6d62290d9a8f",
                                "sense_id": "b0a0515b-8ba4-38f0-8fae-09287e5ce6c2",
                                "text": "Quoique propagées en haut débit sur le Web, les blagues de blondes ne datent pas d’aujourd'hui ; la glamourissime Marilyn (qui était loin d’être une truffe) avait joliment entériné ce cliché en racontant un jour qu’elle envisageait d’inscrire en épitaphe sur sa pierre tombale ce seul qualificatif : « Marilyn Monroe, blonde »."
                            }
                        ]
