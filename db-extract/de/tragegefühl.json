                "senses": [
                    {
                        "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                        "entry_id": "fef1bd5f-a98b-3243-b145-a2f519d38625",
                        "glosses": [
                            "subjektive Wahrnehmung des Komforts, der Passform und des allgemeinen Wohlbefindens beim Tragen von Kleidung, Schuhen oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24531eb-1a38-4590-8308-45cc4fb47775",
                                "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                                "text": "„Hergestellt aus 95 % Viskose und 5 % Elastan, bietet dieser Stoff ein unglaublich weiches und bequemes Tragegefühl.“"
                            },
                            {
                                "example_id": "824652c1-6e4d-47ce-b4dd-22984fb589d6",
                                "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                                "text": "„Die strukturierte Couletto Freizeithose ist eine gerade geschnittene Hose, die bestes Tragegefühl und angenehme Bewegungsfreiheit bietet.“"
                            },
                            {
                                "example_id": "7ece69a1-0ff2-47a0-8efd-a71a8a568cd5",
                                "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                                "text": "„Es besteht aus unglaublich leichtem, offenem Mesh-Gewebe und bietet somit optimales Feuchtigkeitsmanagement und ein angenehm trockenes Tragegefühl.“"
                            },
                            {
                                "example_id": "4d090852-1ad6-432b-88cc-4eb7114744fb",
                                "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                                "text": "„Das Organizer Case ist aus dem für Rains typischen wasserdichten PU-Gewebe gefertigt, das sich durch seine Robustheit, Langlebigkeit und ein angenehmes Tragegefühl auszeichnet.“"
                            },
                            {
                                "example_id": "9f3cf9d4-9429-4a83-9704-d61bbd946b67",
                                "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                                "text": "„Sein anschmiegsames und atmungsaktives Material verspricht ein behagliches Tragegefühl und sorgt für ein angenehmes Körperklima.“"
                            },
                            {
                                "example_id": "33e4961b-1deb-4735-b5f1-216c79195593",
                                "sense_id": "edee17f2-a30f-3f8f-8c6e-81e2c353a252",
                                "text": "„Zudem sorgt das atmungsaktive Obermaterial für ein angenehmes Tragegefühl, auch an warmen Tagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
