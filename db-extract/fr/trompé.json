                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b45ff5de-e26a-3bd8-93e9-b2ac1f28d119",
                        "entry_id": "e23d8898-0b9d-39a9-ba34-66a4f817a510",
                        "glosses": [
                            "Forme traditionnelle de la forme conjuguée trompe, du verbe tromper, lorsqu’il y a inversion (postposition) du sujet je et nécessité d’accentuer le « e » caduc. → voir trompe"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "560fcaf3-4146-45ef-94dc-55a723e61bed",
                                "sense_id": "b45ff5de-e26a-3bd8-93e9-b2ac1f28d119",
                                "text": "Pour combien de vies en un jour vécues ? — autant que de malheureux consolés ! Me trompé-je, Daniel, mon fils, me trompé-je ?"
                            }
                        ]
                    }
