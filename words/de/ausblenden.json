    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6c5dd43-d3e6-3263-8c71-c9e4bef86f4b",
                    "sense_definition": "Ein Element auf einer Benutzeroberfläche oder einem Bildschirm vorübergehend verbergen oder unsichtbar machen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anzeige",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du kannst dieses Fenster ganz einfach <w>ausblenden</w>, wenn du mehr Platz auf dem Bildschirm brauchst."
                        },
                        {
                            "text": "Er <w>blendet</w> die Menüleiste <w>aus</w>, um das Dokument ungestört im Vollbildmodus lesen zu können."
                        }
                    ],
                    "synonyms": [
                        "verbergen",
                        "verstecken"
                    ],
                    "antonyms": [
                        "einblenden"
                    ],
                    "common_phrases": [
                        "ein Fenster ausblenden",
                        "die Menüleiste ausblenden",
                        "Symbolleiste ausblenden"
                    ]
                },
                {
                    "sense_id": "f409cd86-b17d-3002-a79c-ec8277562b5c",
                    "sense_definition": "Etwas wie Probleme, Fakten oder störende Reize bewusst ignorieren, verdrängen oder nicht beachten",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "gedanken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie versuchte, während der Prüfung alle störenden Geräusche um sich herum völlig <w>auszublenden</w>."
                        },
                        {
                            "text": "Der Politiker <w>blendet</w> die Realität der Krise in seinen öffentlichen Reden vollkommen <w>aus</w>."
                        }
                    ],
                    "synonyms": [
                        "ignorieren",
                        "übergehen",
                        "verdrängen"
                    ],
                    "common_phrases": [
                        "die Realität ausblenden",
                        "Probleme ausblenden",
                        "den Lärm ausblenden"
                    ]
                },
                {
                    "sense_id": "56285eed-7209-3b9e-9c21-2c5bc40657eb",
                    "sense_definition": "Ein Bild oder einen Ton bei einer Film-, Fernseh- oder Tonübertragung schrittweise schwächer werden lassen und schließlich ganz beenden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am Ende des emotionalen Films <w>blendet</w> die Regie das Bild langsam <w>aus</w>."
                        },
                        {
                            "text": "Der Moderator bat den Tontechniker, das Lied vor den Nachrichten sanft <w>auszublenden</w>."
                        }
                    ],
                    "synonyms": [
                        "abdunkeln"
                    ],
                    "antonyms": [
                        "einblenden"
                    ],
                    "common_phrases": [
                        "das Bild ausblenden",
                        "die Musik ausblenden"
                    ]
                }
            ]
        }
    ]
}