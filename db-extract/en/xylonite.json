                                "sense_id": "37a0b8ca-21e2-364e-8527-b3b488ff55e1",
                                "text": "The youngest of the industries of Suffolk is the manufacture of xylonite."
                            },
                            {
                                "example_id": "fddb0b84-196a-4864-9f21-9382ec65ab5a",
                                "sense_id": "37a0b8ca-21e2-364e-8527-b3b488ff55e1",
                                "text": "A simple, effective shelf label-holder is made from strips of transparent xylonite bent in a rectangular form..."
                            },
                            {
                                "example_id": "79fa10d9-bd2c-47bf-ae11-e3bb40ae4bdc",
                                "sense_id": "37a0b8ca-21e2-364e-8527-b3b488ff55e1",
                                "text": "[…] the perfumes and flavouring-substances, the explosives, the viscoses, celluloids, xylonites, bakelites, &c., […]"
                            }
                        ]
                    }
