                        "sense_id": "9e14c73d-5204-3c46-9421-25d296147844",
                        "entry_id": "aca32dc3-ed55-3dc5-8aad-582b7f95ae0b",
                        "glosses": [
                            "Qui ne peut être extirper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efb2ab2-b473-4a9f-92fc-03917c27dc14",
                                "sense_id": "9e14c73d-5204-3c46-9421-25d296147844",
                                "text": "La propension des Italiens à la désunion politique parait être inextirpable."
                            },
                            {
                                "example_id": "a3db42d1-6a3b-4940-94a2-7b08c6650f8f",
                                "sense_id": "9e14c73d-5204-3c46-9421-25d296147844",
                                "text": "Le brigandage, dans ce cas, est d’autant plus inextirpable qu’il est soutenu par les autorités, qui, dans les autres temps, ont mission de l’empêcher."
                            },
                            {
                                "example_id": "c067fde3-458f-4cbe-b213-5d6ec9820f4b",
                                "sense_id": "9e14c73d-5204-3c46-9421-25d296147844",
                                "text": "Elle n’est pas indiquée en première intention sauf si la tumeur est inextirpable ou récidivant."
                            }
                        ]
                    }
                ],
