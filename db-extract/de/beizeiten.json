                "senses": [
                    {
                        "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                        "entry_id": "de31f9df-4883-3d63-ad30-8c8979c1b65f",
                        "glosses": [
                            "zur rechten Zeit; bevor es für ein bestimmtes Vorhaben zu spät ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be53167-7ce7-4f33-ae33-366b12b32d57",
                                "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                "text": "Wir sollten uns beizeiten auf den Weg machen, um nicht in das angekündigte Gewitter zu geraten."
                            },
                            {
                                "example_id": "3fc8173b-8443-4c8e-b52a-a0b0b36e02a7",
                                "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                "text": "Wenn du morgen pünktlich sein willst, musst du beizeiten aufstehen, sonst wird alles so hektisch."
                            },
                            {
                                "example_id": "a2bbc0ac-4514-470d-ab34-69cb1ef9f4eb",
                                "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                "text": "Kümmere dich beizeiten um einen Ausbildungsplatz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7b9fe62-9552-45b4-abf8-ffce8b17c37c",
                        "source_entry_id": "de31f9df-4883-3d63-ad30-8c8979c1b65f",
                        "source_sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                        "source_sense_description": "zur rechten Zeit; bevor es für ein bestimmtes Vorhaben zu spät ist",
                        "target_lang_word": "à temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55d896c3-5883-3730-9100-4e57996a6976",
                                        "entry_id": "b1ad616c-293e-3611-9a73-f31466d4dac5",
                                        "glosses": [
                                            "Assez tôt, dans le temps voulu, au moment nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50f3df2-6b8c-45df-944e-24912c21d1f7",
                                                "sense_id": "55d896c3-5883-3730-9100-4e57996a6976",
                                                "text": "Vous arrivez à temps."
                                            },
                                            {
                                                "example_id": "85b222a1-140c-4919-abcd-f5464a6127f7",
                                                "sense_id": "55d896c3-5883-3730-9100-4e57996a6976",
                                                "text": "Vous y serez à temps."
                                            },
                                            {
                                                "example_id": "d2b6d06f-8be2-42f7-9c3e-9198f8592841",
                                                "sense_id": "55d896c3-5883-3730-9100-4e57996a6976",
                                                "text": "Vous n’arriverez pas à temps pour le voir."
                                            },
                                            {
                                                "example_id": "524cb9fe-c19a-404f-bcef-53dcebbc6227",
                                                "sense_id": "55d896c3-5883-3730-9100-4e57996a6976",
                                                "text": "Cette chose n’a point été faite à temps — Elle a été faite trop tôt ou trop tard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7fb90ba-5ce1-3d04-bc64-17370a6d6955",
                                        "entry_id": "b1ad616c-293e-3611-9a73-f31466d4dac5",
                                        "glosses": [
                                            "Pour un temps fixé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da34f7a3-1e95-4a4f-8328-5b5291292aa4",
                                                "sense_id": "b7fb90ba-5ce1-3d04-bc64-17370a6d6955",
                                                "text": "Travaux forcés à temps."
                                            },
                                            {
                                                "example_id": "d64ed668-a103-41b5-83ee-3d1adac240bc",
                                                "sense_id": "b7fb90ba-5ce1-3d04-bc64-17370a6d6955",
                                                "text": "Bannissement à temps."
                                            },
                                            {
                                                "example_id": "69ba2632-8107-435b-9606-fb3c593e1c6f",
                                                "sense_id": "b7fb90ba-5ce1-3d04-bc64-17370a6d6955",
                                                "text": "Le préfet qui avait longtemps hésité à utiliser les condamnés, à temps ou à vie, pour ce genre de travail, put éviter d’en arriver à cette extrémité ; aussi longtemps qu’il y aurait des chômeurs, il était d’avis qu’on pouvait attendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
