                "senses": [
                    {
                        "sense_id": "f5133186-c248-3608-bf90-2a738387b66d",
                        "entry_id": "05da1736-5730-3955-b0f0-46957aea5061",
                        "glosses": [
                            "die Lehre von den angeborenen Ideen"
                        ],
                        "tags": [
                            "Erkenntnistheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "63d9ae20-52ea-4376-946b-4c6b7519ffa3",
                                "sense_id": "f5133186-c248-3608-bf90-2a738387b66d",
                                "text": "„Anstatt den Rationalismus als ganzen anzugreifen, richtete Locke im ersten Buch des „Essay\" seine Kritik gegen den rationalistischen Innatismus, offenbar weil er überzeugt war, daß der Rationalismus mit der Annahme eingeborener Ideen stehe und falle.“"
                            },
                            {
                                "example_id": "d3a8484d-f2b1-47b7-8814-96d0fe5a00b2",
                                "sense_id": "f5133186-c248-3608-bf90-2a738387b66d",
                                "text": "„Im Gegensatz zu den rationalistischen Entwürfen des Innatismus sind die Antizipationen nach den Vorstellungen der Romantik allerdings nicht Vernunft- oder Verstandesstrukturen, sondern beruhen vielmehr auf der emotionalen Basis (Lieb, Sympathie) als Ausdruck einer allgemeinen Lebensgemeinschaft.“"
                            },
                            {
                                "example_id": "e4ade1c5-9212-42fb-822a-191573805e92",
                                "sense_id": "f5133186-c248-3608-bf90-2a738387b66d",
                                "text": "Platon postuliert in seinem Innatismus die Schau fertiger Ideen bereits vor unserer Geburt, die der Mensch dann im Leben wiedererinnert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
