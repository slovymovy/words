            {
                "entry_id": "cda1cc29-1ce8-35b3-b5b5-407de88d570f",
                "word": "aanwezige",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d10833f7-52cb-38c1-83b1-6fa7029c8206",
                        "entry_id": "cda1cc29-1ce8-35b3-b5b5-407de88d570f",
                        "glosses": [
                            "iemand die iets bijwoont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517e9ffa-56b4-4688-b34a-7956e9787753",
                                "sense_id": "d10833f7-52cb-38c1-83b1-6fa7029c8206",
                                "text": "Er was slechts een handvol aanwezigen."
                            },
                            {
                                "example_id": "53c2e0c5-3f37-4e8c-9658-5eb9ea24cccd",
                                "sense_id": "d10833f7-52cb-38c1-83b1-6fa7029c8206",
                                "text": "Onder de aanwezigen was ook de koningin."
                            },
                            {
                                "example_id": "77841df6-5701-4c81-a8d2-5efb7ed083ce",
                                "sense_id": "d10833f7-52cb-38c1-83b1-6fa7029c8206",
                                "text": "Achter hen stonden Max en Dennis met grote ogen te kijken naar de achterkant van een klein fototoestel dat Sander vasthield. Alsof het zo was afgesproken, stapte Denise de kamer binnen op het moment dat zij alle aanwezigen kort had bekeken."
                            },
                            {
                                "example_id": "1a4a8057-938b-4d97-8c40-5146ba4c3904",
                                "sense_id": "d10833f7-52cb-38c1-83b1-6fa7029c8206",
                                "text": "Niet één aanwezige kon een andere indruk krijgen dan dat de zaken fantastisch gingen, misschien op de grens van het wonderbaarlijke."
                            }
                        ]
                    }
