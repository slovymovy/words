                                                "sense_id": "842d7c82-0163-3a63-bad3-4022c1320489",
                                                "text": "„Heute stand eine Barkeeperin hinter dem Tresen, in einer bunten Weste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
