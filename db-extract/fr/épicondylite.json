                        "entry_id": "b906f240-41d8-31a7-b906-c01fa3742e38",
                        "glosses": [
                            "Inflammation des tendons (tendinite) des muscles des extenseurs des doigts à leur insertion au niveau du coude (condyle externe)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825dba78-b926-49ae-8324-721204e5073c",
                                "sense_id": "c00d8177-595a-38b0-8cdb-0da0977577ee",
                                "text": "L’épicondylite est surtout connue sous le terme de \"tennis elbow\"."
                            },
                            {
                                "example_id": "693bd176-f37a-4c9a-b4cc-d14741b4c902",
                                "sense_id": "c00d8177-595a-38b0-8cdb-0da0977577ee",
                                "text": "Également appelée « Tennis-elbow », l’épicondylite est une tendinite du coude."
                            },
                            {
                                "example_id": "22b46a70-623e-406f-a816-782985889bd3",
                                "sense_id": "c00d8177-595a-38b0-8cdb-0da0977577ee",
                                "text": "Lombalgies, cervicalgies, douleurs aux épaules, syndromes du canal carpien et épicondylites sont les principaux maux retrouvés chez les personnes restant assises devant leur ordinateur, en particulier à domicile."
                            }
                        ]
                    }
