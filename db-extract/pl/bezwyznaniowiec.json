                            {
                                "example_id": "419f8461-40f9-45c9-9563-7412f45a5443",
                                "sense_id": "d08a6556-c0fe-3be0-b5c0-d2dfaf0bdddd",
                                "text": "Bolesław dziś uważa się za bezwyznaniowca."
