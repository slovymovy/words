                                "target_senses": [
                                    {
                                        "sense_id": "f5317adc-c4c4-35ea-bfb1-bcefa83e9298",
                                        "entry_id": "c24effbd-b842-33ed-8ecf-377f77ddf76a",
                                        "glosses": [
                                            "das Wechseln des Gefieders beziehungsweise der Federn bei Vögeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5234096b-1966-4cab-96a2-b8243e4a246a",
                                                "sense_id": "f5317adc-c4c4-35ea-bfb1-bcefa83e9298",
                                                "text": "Die Mauser des Vogels war bereits weit fortgeschritten."
                                            },
                                            {
                                                "example_id": "b6f1d182-a57a-4004-9054-dc08011d16d2",
                                                "sense_id": "f5317adc-c4c4-35ea-bfb1-bcefa83e9298",
                                                "text": "Unser Wellensittich ist gerade in der Mauser."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mauser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "414ce7c2-245d-34c9-be0d-37e2fa8b501b",
                                        "entry_id": "638850ac-8311-3eb2-8756-37a983823827",
                                        "glosses": [
                                            "deutschsprachiger Familienname, der vor allem in Süddeutschland verbreitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3caa724-1c5f-4b1d-8f20-fa9f57c3a243",
                                                "sense_id": "414ce7c2-245d-34c9-be0d-37e2fa8b501b",
                                                "text": "Herr Mauser kann zur Zeit telefonisch nicht kontaktiert werden."
                                            },
                                            {
                                                "example_id": "d9014208-ca77-4eb8-b3a2-5bd5d4a184c2",
                                                "sense_id": "414ce7c2-245d-34c9-be0d-37e2fa8b501b",
                                                "text": "Frau Mauser hat dem Scheidungsantrag zugestimmt."
                                            },
                                            {
                                                "example_id": "836ca4cb-c0e2-41e0-a299-f8e13d0f5c47",
                                                "sense_id": "414ce7c2-245d-34c9-be0d-37e2fa8b501b",
                                                "text": "Bei den Mausers wurde die Haustür bunt gestrichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
