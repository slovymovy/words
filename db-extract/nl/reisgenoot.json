                                "sense_id": "85de5d60-023a-3cb2-9f2c-0a634488d582",
                                "text": "Ik ben op zoek naar een reisgenoot voor mijn vakantie naar Zuid-Amerika.",
                                "translation": "I am looking for a travel companion for my vacation to South America.",
                                "english": "I am looking for a travel companion for my vacation to South America."
                            },
                            {
