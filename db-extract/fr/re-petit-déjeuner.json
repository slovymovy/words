                "senses": [
                    {
                        "sense_id": "586de697-21ef-3319-9397-f08d50ad03f1",
                        "entry_id": "f9f49572-556a-3f6f-a761-f6ae58eef98f",
                        "glosses": [
                            "Petit-déjeuner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967ca984-782b-4118-8074-ad3a503d1378",
                                "sense_id": "586de697-21ef-3319-9397-f08d50ad03f1",
                                "text": "A 8H09, il re-petit-déjeune à Djalalabad avec le commandant en chef des forces spéciales françaises en Afghanistan, histoire de bien signifier qui est le véritable patron de la Défense."
                            },
                            {
                                "example_id": "110023d6-0d14-46f8-9ed3-cfe9b359360b",
                                "sense_id": "586de697-21ef-3319-9397-f08d50ad03f1",
                                "text": "Bah, parce que ça mange bien, le hobbit, ça festoie, ça petit-déjeune, ça re-petit-déjeune, tout ça, tout ça."
                            },
                            {
                                "example_id": "c2cad833-32d6-4918-a7d0-ffad075009f2",
                                "sense_id": "586de697-21ef-3319-9397-f08d50ad03f1",
                                "text": "Alors on est rentré et on a fait un bon gros goûter (une brioche au beurre trop hummmmm) et on s'est traîné jusqu'au dîner (où on a re-petit-déjeuné) et - enfin ! - on s'est couché."
                            }
                        ]
                    }
