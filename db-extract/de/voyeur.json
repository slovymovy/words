                "senses": [
                    {
                        "sense_id": "ecfe84e0-8388-395d-a329-8d7ddc0a4b7e",
                        "entry_id": "c403648a-b516-37d6-b2d5-cf52fb76c839",
                        "glosses": [
                            "Person, die zur sexuellen Erregung gelangt, wenn sie anderen bei sexuellen Handlungen heimlich zusieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccbf4717-6f57-47c6-b483-72605e118812",
                                "sense_id": "ecfe84e0-8388-395d-a329-8d7ddc0a4b7e",
                                "text": "Als sie mit ihrem Freund schlief, bemerkte Klara vor dem Fenster plötzlich einen Voyeur."
                            },
                            {
                                "example_id": "ab74c5a1-ba18-4e31-93fc-47d735fabedf",
                                "sense_id": "ecfe84e0-8388-395d-a329-8d7ddc0a4b7e",
                                "text": "Er ist schon mehrmals als Voyeur aufgefallen."
                            },
                            {
                                "example_id": "e475ea68-6fad-4ad7-b921-a9e3def9b457",
                                "sense_id": "ecfe84e0-8388-395d-a329-8d7ddc0a4b7e",
                                "text": "„Der Horcher oder Voyeur an der Tür des neuvermählten Paares wird Zeuge ungewöhnlicher Praktiken oder er mißversteht das, was er hört oder sieht.“"
                            },
                            {
                                "example_id": "4a4f020b-6d02-412c-9dc8-8fdbcd20d2ff",
                                "sense_id": "ecfe84e0-8388-395d-a329-8d7ddc0a4b7e",
                                "text": "„Wenn ich Menschen beim Beten beobachte, fühle ich mich wie ein Voyeur, wie jemand, der etwas Verbotenes tut.“"
                            },
                            {
                                "example_id": "40bba667-ae0d-4af8-8388-2d04cc0b7203",
                                "sense_id": "ecfe84e0-8388-395d-a329-8d7ddc0a4b7e",
                                "text": "„Er verkam, fand Gefallen daran, in Bordellen den Voyeur zu spielen, den beobachteten Paaren die Kleider zu stehlen und sie durch Mäuse zu erschrecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
