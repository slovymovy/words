                "senses": [
                    {
                        "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                        "entry_id": "5f2cf157-f3ab-337a-bb3e-98dc49dd130f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ff29da-86bf-4f9e-86a7-6ff8081c33fc",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Frau Beckerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "70c14e10-be14-4827-9af1-8f05485b9c88",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Herr Beckerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ca539eff-41a2-4f9a-9a3e-e33427b27211",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Die Beckerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "874155cd-8b7e-4962-889c-6d0ccf6b185b",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Der Beckerle trägt nie die Pullover, die die Beckerle ihm strickt."
                            },
                            {
                                "example_id": "bec20d98-eb4c-42b5-8cad-19f2a54deaa8",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Beckerle kommt, geht der Herr Beckerle.“"
                            },
                            {
                                "example_id": "b52e3640-44d9-4a0f-8533-a0566680793c",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Beckerle kommt und geht."
                            },
                            {
                                "example_id": "7be1a67b-59ba-4d21-9f92-a9239aaac701",
                                "sense_id": "b73a666f-f2db-3e31-8846-9f2a13603afc",
                                "text": "Beckerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
