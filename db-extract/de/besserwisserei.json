                "senses": [
                    {
                        "sense_id": "1233ba25-1c56-35ed-bebf-204ba2ffc12b",
                        "entry_id": "3f8585ab-7008-3f5b-98b7-41357cfd30a0",
                        "glosses": [
                            "rechthaberisches Verhalten, kritische Äußerung aus der Überzeugung heraus, alles besser zu wissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2591e293-6e25-49af-b16f-9d7ab4236980",
                                "sense_id": "1233ba25-1c56-35ed-bebf-204ba2ffc12b",
                                "text": "Dann fahr doch du! Deine Besserwisserei als Beifahrer geht mir auf den Geist!"
                            },
                            {
                                "example_id": "96991cde-ea7f-4ea3-92c1-16eb483180db",
                                "sense_id": "1233ba25-1c56-35ed-bebf-204ba2ffc12b",
                                "text": "„Die Grenze zwischen Faktensicherheit und Besserwisserei ist schmal, und die Menschen widert es an, wenn Politik von oben herab kommt.“"
                            },
                            {
                                "example_id": "40ae2894-510b-42b1-8366-3fe31d39d992",
                                "sense_id": "1233ba25-1c56-35ed-bebf-204ba2ffc12b",
                                "text": "„In Johannesburg beispielsweise, wo die Wunden der Apartheid immer noch offenliegen und wo man sehr sensibel auf die Besserwissereien des weißen Mannes reagiert, muss sich das Goethe-Institut wieder und wieder in die aktuellen Debatten einfädeln […]“"
                            },
                            {
                                "example_id": "17fea48b-61e6-4ae1-bed5-706d01baa42d",
                                "sense_id": "1233ba25-1c56-35ed-bebf-204ba2ffc12b",
                                "text": "„Es geht dabei ja nicht um Besserwisserei, sondern um die Geschichten, die dahinterstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
