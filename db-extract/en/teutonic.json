                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b0cf117-b168-357a-9c51-8e3a68b3a9c2",
                                        "entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
                                        "glosses": [
                                            "Qualifiait un ordre religieux militaire fondé par des seigneurs allemands à l’époque des croisades."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "705f8e6f-3932-3931-b783-5024b5b1090c",
                                        "entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
