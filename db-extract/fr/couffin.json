                    }
                ],
                "senses": [
                    {
                        "sense_id": "14eae22d-362e-357a-aed1-48bf4bc370af",
                        "entry_id": "6c5f6bc1-f33f-339d-93c3-d769de0db61d",
                        "glosses": [
                            "Berceau de petite dimension facilement transportable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d71a4d-daa6-4c24-b1e1-135718fe9f65",
                                "sense_id": "14eae22d-362e-357a-aed1-48bf4bc370af",
                                "text": "Trois hommes et un couffin."
                            }
                        ]
                    },
                    {
                        "sense_id": "738d3474-9e50-3805-9a24-588d29a8cf6f",
                        "entry_id": "6c5f6bc1-f33f-339d-93c3-d769de0db61d",
                        "glosses": [
                            "Cabas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35897e6-8c8b-436f-bfd6-67ebe3678e3c",
                                "sense_id": "738d3474-9e50-3805-9a24-588d29a8cf6f",
                                "text": "Elle marchait sur les genoux, arrachant activement l’ivraie qu’elle jetait dans un couffin."
                            },
                            {
                                "example_id": "2b99b254-8f98-4817-aa0d-69cd1df63bb1",
                                "sense_id": "738d3474-9e50-3805-9a24-588d29a8cf6f",
                                "text": "Entre Yari et Sissy, dans une savane immense de gamba, nous avons croisé, ce matin, quatre Manga menant à Kano dix ânes chargés de pains de sel et de couffins de natron — une production de ce pays très particulier où abondent les mares salines."
                            },
                            {
                                "example_id": "8965d603-ec47-4835-81fe-a49cd5d5556e",
                                "sense_id": "738d3474-9e50-3805-9a24-588d29a8cf6f",
                                "text": "Il passa en faisant claquer ses petits pas d'âne léger sur les dalles du pont. Les couffins, qui bringuebalaient sur son dos, étaient pleins jusqu'aux bords de branches d'argélas en fleur."
                            },
                            {
                                "example_id": "22af45d2-1894-448d-b281-b56944c44a8d",
                                "sense_id": "738d3474-9e50-3805-9a24-588d29a8cf6f",
                                "text": "« – Ce matin, ma mère veut que nous ramassions un petit couffin d’olives vertes, pour les mettre à la potasse ! »"
                            },
                            {
                                "example_id": "aadf96df-0720-49ac-9bcc-c73bf42a2e90",
                                "sense_id": "738d3474-9e50-3805-9a24-588d29a8cf6f",
                                "text": "L'outillage d'extraction comprend : deux couffins en alfa tressé, d'une contenance de deux ouïbas chacun; une pioche du genre pic, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a8134d7-fbd4-4786-9044-a449e424699b",
                        "source_entry_id": "6c5f6bc1-f33f-339d-93c3-d769de0db61d",
                        "target_lang_word": "bassinet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bassinet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f8a3111-be1c-3ef0-9c6a-974917ee4d50",
                                        "entry_id": "efc489d1-d301-3096-8096-0ecae493d07d",
                                        "glosses": [
                                            "A newborn baby's bed, traditionally woven with reeds or straw; a (wicker) cradle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1134d6af-9f65-497a-a243-b0dcbaabe01e",
                                                "sense_id": "3f8a3111-be1c-3ef0-9c6a-974917ee4d50",
                                                "text": "The next day, the baby sleeps in a bassinet near my bed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bassinet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8aade3-703d-3afa-a498-09d715b3566e",
                                        "entry_id": "a0bb5037-5a73-3e6f-bc71-bb634c0932c2",
                                        "glosses": [
                                            "Alternative form of bascinet."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840a6aab-143c-401c-908f-cee66f856907",
                                                "sense_id": "cb8aade3-703d-3afa-a498-09d715b3566e",
                                                "text": "Bassinets were worn in the reigns of Edward II. and III. and Richard II. by most of the English Infantry, as may be repeatedly seen in the Rolls of Parliament, and other public records."
                                            },
                                            {
                                                "example_id": "0cda9f31-72b1-462d-ac8b-f878e7a0e31b",
                                                "sense_id": "cb8aade3-703d-3afa-a498-09d715b3566e",
                                                "text": "Alleyne stood by the tiller, looking backwards, the fresh wind full in his teeth, the crisp winter air tingling on his face and blowing his yellow curls from under his bassinet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
