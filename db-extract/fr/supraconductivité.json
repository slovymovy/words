                                        "entry_id": "0e04c8f3-5666-3e0b-9ec0-2aa7064eb355",
                                        "glosses": [
                                            "The property of a material whereby it has no resistance to the flow of an electric current."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
