{
    "word_family": [
        "titre",
        "titrer",
        "titulaire",
        "titulariser",
        "intitulation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eec67c08-8568-3d22-8657-fd92e817ffcc",
                    "sense_definition": "Donner un titre à un livre, un article, un film ou un ouvrage de l'esprit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "titre_oeuvre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a choisi d'<w>intituler</w> son nouveau roman d'après un vers de poésie classique."
                        },
                        {
                            "text": "Le jeune réalisateur préfère <w>intituler</w> son premier film avec un mot court et percutant."
                        }
                    ],
                    "synonyms": [
                        "titrer"
                    ],
                    "common_phrases": [
                        "intituler un livre",
                        "intituler un chapitre",
                        "intituler un article"
                    ]
                },
                {
                    "sense_id": "62530586-d2db-3766-bd33-9316d39c79a0",
                    "sense_definition": "Avoir pour titre, en parlant d'un livre, d'une œuvre ou d'un document.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "titre_oeuvre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le premier chapitre de cette thèse s'<w>intitule</w> Introduction aux systèmes complexes."
                        },
                        {
                            "text": "Son dernier recueil de nouvelles s'<w>intitule</w> Les Ombres du soir."
                        }
                    ],
                    "common_phrases": [
                        "s'intituler ainsi"
                    ]
                },
                {
                    "sense_id": "15a09fb8-0c88-3296-ac2b-c687bc60bb51",
                    "sense_definition": "Inscrire un titre officiel en tête d'un acte juridique, d'une loi ou d'un jugement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le greffier doit <w>intituler</w> le jugement conformément aux dispositions légales en vigueur."
                        },
                        {
                            "text": "L'administration a décidé d'<w>intituler</w> ce décret en rappelant les textes fondateurs de la République."
                        }
                    ],
                    "common_phrases": [
                        "intituler un acte",
                        "intituler une loi"
                    ]
                },
                {
                    "sense_id": "23712529-f7ce-31cb-bec7-b44dd4d24666",
                    "sense_definition": "S'attribuer indûment ou abusivement un titre, une fonction ou une qualité honorifique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "usurpation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans posséder aucun diplôme médical, cet individu s'<w>intitule</w> docteur auprès de ses clients."
                        },
                        {
                            "text": "L'accusé s'<w>intitule</w> baron pour impressionner ses interlocuteurs dans les salons parisiens."
                        }
                    ],
                    "synonyms": [
                        "s'arroger",
                        "s'attribuer"
                    ],
                    "common_phrases": [
                        "s'intituler comte",
                        "s'intituler président"
                    ]
                }
            ]
        }
    ]
}