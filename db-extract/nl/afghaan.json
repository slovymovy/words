                    }
                ],
                "senses": [
                    {
                        "sense_id": "4809a853-53d8-31f9-8ca1-1532a3aca1be",
                        "entry_id": "41a5d973-d347-3679-be06-de3610912da4",
                        "glosses": [
                            "verkorting van Afghaanse windhond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b27dd961-8be2-477e-b6bf-317d9184656d",
                                "sense_id": "4809a853-53d8-31f9-8ca1-1532a3aca1be",
                                "text": "Mijn buurman loopt iedere ochtend een rondje met zijn afghaan."
                            },
                            {
                                "example_id": "a1e72b51-1a20-43ed-b288-286826467b9b",
                                "sense_id": "4809a853-53d8-31f9-8ca1-1532a3aca1be",
                                "text": "Hij stond op de steiger toen ik wegvoer,\nmijn enorme afghaan, vast geplant, niet gelovend\ndat ik wegging, niet écht gelovend."
                            }
                        ]
                    },
                    {
                        "sense_id": "93f32ba3-a8cb-309a-9183-d74fde5742ab",
                        "entry_id": "41a5d973-d347-3679-be06-de3610912da4",
                        "glosses": [
                            "verkorting van Afghaans tapijt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6afc0d6e-0861-4f89-b38f-28c5ad8a7c52",
                                "sense_id": "93f32ba3-a8cb-309a-9183-d74fde5742ab",
                                "text": "ik verlangde naar de koesterende warmte van een Nederlands binnenhuis, een flakkerend vuur in de haard, een rode Afghaan onder de voeten, een gouden cognac in de glazen, een man die mij liefheeft naast mij romantisch en sentimenteel, gewoon vrouwelijk dromen over niets, over helemaal niets, maar warm zijn, geborgen zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "4671349a-4150-3786-96ff-b5e776893400",
                        "entry_id": "41a5d973-d347-3679-be06-de3610912da4",
                        "glosses": [
                            "hasj"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "58009e54-b15d-4a86-bfc5-2f37fe4564e1",
                                "sense_id": "4671349a-4150-3786-96ff-b5e776893400",
                                "text": "De truck is leeg, elke wagen die Polen binnen komt rijden is leeg, op de sigaretten achter de dubbele wanden na, echte nep-Marlboro's, en nu en dan een lading Afghaan of beter. Van Egbert hoeft dat allemaal niet zo, hij loopt al genoeg risico op de heenweg. Paprika's en tomaten, je houdt het niet voor mogelijk, maar er is al eens iemand voor doodgeschoten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87decd41-b1b3-4f36-81f0-8e4f6e9c0234",
                        "source_entry_id": "41a5d973-d347-3679-be06-de3610912da4",
                        "source_sense_id": "4809a853-53d8-31f9-8ca1-1532a3aca1be",
                        "source_sense_description": "Afghaanse windhond",
                        "target_lang_word": "Afghane",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afghane",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b8fb5b-f054-3f5f-a591-6d78ae054a68",
                                        "entry_id": "92cc03f2-a93c-33b3-abd9-315901a12973",
                                        "glosses": [
                                            "Staatsbürger, Bewohner von Afghanistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90546eb5-f5f1-4f5e-a55f-dd9738c0370f",
                                                "sense_id": "33b8fb5b-f054-3f5f-a591-6d78ae054a68",
                                                "text": "Der Afghane wurde 1910 geboren und verstarb 1999."
                                            },
                                            {
                                                "example_id": "4843f4ef-403b-4cb2-aa8d-3a395b6a9428",
                                                "sense_id": "33b8fb5b-f054-3f5f-a591-6d78ae054a68",
                                                "text": "„Kurz nach dem Tod von drei deutschen Soldaten im Norden Afghanistans haben Bundeswehrsoldaten aus Versehen mehrere afghanische Soldaten erschossen. Nach Angaben der Bundeswehr starben dabei gestern Abend fünf Afghanen, ein Provinzgouverneur sprach sogar von sechs Toten.“"
                                            },
                                            {
                                                "example_id": "6a012976-b0ae-43cf-ba18-2fadd9c2e636",
                                                "sense_id": "33b8fb5b-f054-3f5f-a591-6d78ae054a68",
                                                "text": "„Der Raubüberfall und die Ermordung von acht ausländischen Helfern und zwei Afghanen erfüllte die Allianz mit großer Betroffenheit und tiefer Trauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "437c873c-5ee8-3cd9-872e-958a6a38ae0d",
                                        "entry_id": "92cc03f2-a93c-33b3-abd9-315901a12973",
                                        "glosses": [
                                            "eine Hunderasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "655bb15f-dbcb-413a-ab04-e5f8d9974144",
                                                "sense_id": "437c873c-5ee8-3cd9-872e-958a6a38ae0d",
                                                "text": "Wir mussten mit unserem Afghanen letzte Woche zum Tierarzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
