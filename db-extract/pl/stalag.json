                                "target_senses": [
                                    {
                                        "sense_id": "391d5d51-5584-3990-ad2c-4a7a8e16e0ac",
                                        "entry_id": "50f97259-8b8c-3932-9913-c030ead15ccb",
                                        "glosses": [
                                            "A German prisoner-of-war camp, especially in World War II."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a67a7dd-e6b8-3fc1-8f92-6124141e6db9",
                                        "entry_id": "50f97259-8b8c-3932-9913-c030ead15ccb",
                                        "glosses": [
                                            "A genre of Nazi exploitation Holocaust pornography in Israel that flourished in the 1950s and early 1960; a work in that genre."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b31252d1-1296-4c53-8bd6-13a06b40e3b7",
                                                "sense_id": "6a67a7dd-e6b8-3fc1-8f92-6124141e6db9",
                                                "text": "stalag fiction; a stalag novel"
                                            },
                                            {
                                                "example_id": "77fa087f-7711-4390-9f26-36bb47cabe22",
                                                "sense_id": "6a67a7dd-e6b8-3fc1-8f92-6124141e6db9",
                                                "text": "After decades in dusty back rooms and closets, the Stalags, a peculiar Hebrew concoction of Nazism, sex and violence, are re-emerging in the public eye. And with them comes a rekindled debate on the cultural representation here of Nazism and the Holocaust, and whether they have been unduly mixed in with a kind of sexual perversion and voyeurism that has permeated even the school curriculum. […] The Stalags were practically the only pornography available in the Israeli society of the early 1960s, which was almost puritanical. […] More provocatively, the movie contends that Stalag pornography was but a popular extension of the writings of K. Tzetnik, the first author to tell the story of Auschwitz in Hebrew and a hero of the mainstream Holocaust literary canon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e97202b-6acc-4f39-b9ff-f18e5d357223",
                        "source_entry_id": "ac542bd6-17ee-3933-b99e-1ce43740a39a",
                        "source_sense_id": "1b41bb08-fbcc-3f6a-a6c7-b6dcbe440ee3",
