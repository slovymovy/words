                        "entry_id": "873351c4-bd4f-399f-8821-8375f39b1c0f",
                        "glosses": [
                            "een ezel of paard met de ondeugd om aan de voerbak of staldeur te knagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc205aa-984c-4a20-962d-55a5e3ca4106",
                                "sense_id": "d84a9228-16c2-3905-956c-1212a6419094",
                                "text": "Geef het paard geen suikerklontjes, anders wordt het een kribbebijter."
                            }
                        ]
                    },
                    {
                        "sense_id": "527d14d5-22e8-33c8-ba2f-e74dae3abaa1",
                        "entry_id": "873351c4-bd4f-399f-8821-8375f39b1c0f",
                        "glosses": [
                            "een chagrijnig persoon die met iedereen overhoop ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ccf37d-793a-4104-9fae-2a01c8b7694d",
                                "sense_id": "527d14d5-22e8-33c8-ba2f-e74dae3abaa1",
                                "text": "Is er nu alweer heibel met die vent, wat is het toch een kribbebijter."
                            }
                        ]
                    }
