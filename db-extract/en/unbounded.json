                        "entry_id": "12ecf6e1-90ed-3401-ae93-cc88f3d48a7b",
                        "glosses": [
                            "Having no boundaries or limits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf82e006-01df-428d-8dff-905aab2271f8",
                                "sense_id": "7ccad9c1-591b-3bb9-945c-eb3d36c481ee",
                                "text": "The universe is finite but unbounded."
                            },
                            {
                                "example_id": "ba78d748-5e62-4ff1-9adc-ef7d29b973b8",
                                "sense_id": "7ccad9c1-591b-3bb9-945c-eb3d36c481ee",
                                "text": "our everlasting, unbounded love"
                            },
                            {
                                "example_id": "e3b54ef4-67f2-440f-8b25-bac177a2a53b",
                                "sense_id": "7ccad9c1-591b-3bb9-945c-eb3d36c481ee",
                                "text": "I still retain an unbounded admiration for G. J. Churchward and all his works, so wisely carried on by his successors."
                            }
                        ]
                    }
                ],
