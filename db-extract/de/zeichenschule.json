                        "glosses": [
                            "Einrichtung, in der man zeichnen lernen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bfd4be5-cd84-4944-a71d-a79a918376a3",
                                "sense_id": "731312f1-e56f-37e6-ab84-6109d13ae1ed",
                                "text": "„Unter vier Augen kündigte mir Mariuccia an, daß zum Essen eine noch unverheiratete Frau namens Signora Veronica kommen werde, die eine Zeichenschule leite und Giacomina mit erstaunlichem Erfolg unterrichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a263ebc-5093-3a86-afde-414b071dc236",
                        "entry_id": "d5b76bf8-58ae-3e53-94fc-a321177f1205",
                        "glosses": [
                            "Unterricht, in dem man zeichnen lernen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b82a585-2843-4c7e-a06b-9082c5da8bf5",
                                "sense_id": "7a263ebc-5093-3a86-afde-414b071dc236",
                                "text": "„Von acht bis elf Uhr arbeiten wir in der Zeichenschule, dann bis eins Modellieren, nachmittags noch zwei Stunden zeichnen und dann der Abendakt. Außerdem skizzieren, soviel es geht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
