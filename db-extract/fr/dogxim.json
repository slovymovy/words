                        "glosses": [
                            "Animal métissé de renard des pampas et de chien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb8aab4-feda-48ae-861c-68228bb8d969",
                                "sense_id": "baaf8c63-7232-3fc4-aa7d-abd456b7c376",
                                "text": "Une étude a confirmé l’existence du tout premier «dogxim», un animal hybride qui serait né de l’accouplement entre une femelle renard et un chien domestique, tandis que l’animal aurait été découvert après avoir été heurté par un véhicule au Brésil."
                            },
                            {
                                "example_id": "76c7633b-bda6-4b2f-bab4-ec9172d783dd",
                                "sense_id": "baaf8c63-7232-3fc4-aa7d-abd456b7c376",
                                "text": "Le spécimen, baptisé « dogxim » (dog pour chien en anglais et xim pour graxaim-do-campo en portugais), ressemble physiquement à un chien."
                            }
                        ]
                    }
