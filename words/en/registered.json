{
    "word_family": [
        "register",
        "registration",
        "registry",
        "registrar"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed8d8d6f-4434-3e82-9e33-bb3e0d6d009b",
                    "sense_definition": "Having had one's name or details added to an official list or record.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>registered</w> nurse working at the local hospital.",
                            "target_lang_translations": {
                                "zh": "她是一名在当地医院工作的<w>注册</w>护士。"
                            }
                        },
                        {
                            "text": "Only <w>registered</w> voters are allowed to participate in the election.",
                            "target_lang_translations": {
                                "zh": "只有已<w>登记的</w>选民才可以参加选举。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enrolled",
                        "recorded",
                        "official"
                    ],
                    "antonyms": [
                        "unregistered"
                    ],
                    "common_phrases": [
                        "registered nurse",
                        "registered voter"
                    ],
                    "target_lang_definitions": {
                        "zh": "已在官方名册或记录中登记的，注册的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "注册的",
                                "target_lang_sense_clarification": "经正式登记或获得资格认证的"
                            },
                            {
                                "target_lang_word": "登记的",
                                "target_lang_sense_clarification": "已列入官方名单或记录的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e730fc4-e845-39e5-b13b-180ec638678c",
                    "sense_definition": "Describing mail that is tracked by the postal service to ensure secure delivery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sent the important documents by <w>registered</w> mail to ensure they arrived safely.",
                            "target_lang_translations": {
                                "zh": "为了确保安全送达，我用<w>挂号</w>邮件寄出了这些重要文件。"
                            }
                        },
                        {
                            "text": "The package was sent as <w>registered</w> mail so we could track its progress online.",
                            "target_lang_translations": {
                                "zh": "这个包裹是以<w>挂号</w>邮件寄出的，所以我们可以在网上追踪运送进度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tracked",
                        "certified"
                    ],
                    "common_phrases": [
                        "registered mail"
                    ],
                    "target_lang_definitions": {
                        "zh": "（邮件）挂号的，由邮政部门追踪记录以确保安全送达的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挂号的",
                                "target_lang_sense_clarification": "指信件或包裹办理了挂号手续的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fae3d3de-d7a8-32df-8a37-fb7e102b8160",
                    "sense_definition": "Past tense and past participle of <w>register</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>registered</w> for the conference online last week.",
                            "target_lang_translations": {
                                "zh": "他上周在网上<w>报名</w>参加了会议。"
                            }
                        },
                        {
                            "text": "They have already <w>registered</w> their new car with the state.",
                            "target_lang_translations": {
                                "zh": "他们已经向州政府为新车办理了<w>登记</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 register 的过去式及过去分词形式，意为“登记；注册；挂号”"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "注册",
                                "target_lang_sense_clarification": "动词 register 的过去式/过去分词"
                            },
                            {
                                "target_lang_word": "登记",
                                "target_lang_sense_clarification": "动词 register 的过去式/过去分词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}