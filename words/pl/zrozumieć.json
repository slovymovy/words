            "pos": "verb",
            "senses": [
                {
                    "sense_id": "729b4ecb-eb54-3afc-a4ca-6f67cdf4906a",
                    "sense_definition": "pojąć sens, treść lub znaczenie czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pojmowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel wyjaśnił zadanie jeszcze raz, żebym dokładnie wszystko <w>zrozumiał</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил задание ещё раз, чтобы я точно всё <w>понял</w>."
                            }
                        },
                        {
                            "text": "Dopiero po przeczytaniu całej instrukcji wreszcie <w>zrozumiałem</w> ten problem.",
                            "target_lang_translations": {
                                "ru": "Только после прочтения всей инструкции я наконец <w>разобрался в</w> этой проблеме."
                            }
                        }
                    ],
                    "synonyms": [
                        "pojąć",
                        "skapować",
                        "skumać"
                    ],
                    "common_phrases": [
                        "zrozumieć problem",
                        "zrozumieć pytanie",
                        "łatwo zrozumieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "уяснить смысл, содержание или значение чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "смысл, содержание"
                            },
                            {
                                "target_lang_word": "разобраться",
                                "target_lang_sense_clarification": "в сложной теме, в инструкции"
                            },
                            {
                                "target_lang_word": "уяснить",
                                "target_lang_sense_clarification": "значение, суть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09104c0d-f622-3382-82e1-22fdbe1419f9",
                    "sense_definition": "okazać empatię, pojąć czyjeś motywy, uczucia lub sytuację",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "empatia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bardzo mi przykro z powodu twoich kłopotów, doskonale <w>rozumiem</w> twoją sytuację.",
                            "target_lang_translations": {
                                "ru": "Мне очень жаль из-за твоих неприятностей, я прекрасно <w>понимаю</w> твою ситуацию."
                            }
                        },
                        {
                            "text": "Chociaż nie pochwalał jej decyzji, potrafił <w>zrozumieć</w> jej motywację.",
                            "target_lang_translations": {
                                "ru": "Хотя он и не одобрял её решения, он смог <w>понять</w> её мотивацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "wczuć się"
                    ],
                    "common_phrases": [
                        "zrozumieć czyjeś motywy",
                        "zrozumieć sytuację"
                    ],
                    "target_lang_definitions": {
                        "ru": "проявить эмпатию, войти в чьё-либо положение, осознать чьи-либо мотивы или чувства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "человека, чувства, положение"
                            },
                            {
                                "target_lang_word": "войти в положение",
                                "target_lang_sense_clarification": "проявить сочувствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "363f5c83-553d-315a-a3c0-e5cc362ef4ac",
                    "sense_definition": "zdać sobie sprawę z jakiegoś faktu lub prawdy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uswiadomienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy zobaczył pusty peron, od razu <w>zrozumiał</w> swój błąd.",
                            "target_lang_translations": {
                                "ru": "Когда он увидел пустой перрон, он сразу же <w>понял</w> свою ошибку."
                            }
                        },
                        {
                            "text": "Z czasem <w>zrozumiała</w>, że tamta decyzja zmieniła całe jej życie.",
                            "target_lang_translations": {
                                "ru": "Со временем она <w>осознала</w>, что то решение изменило всю её жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "pojąć"
                    ],
                    "common_phrases": [
                        "zrozumieć swój błąd",
                        "zrozumieć powagę sytuacji"
                    ],
                    "target_lang_definitions": {
                        "ru": "осознать какой-либо факт, истину или ошибку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "осознать ошибку, факт"
                            },
                            {
                                "target_lang_word": "осознать",
                                "target_lang_sense_clarification": "глубоко осмыслить реальность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "756a0364-19e6-3dc8-9930-1d81b8e764e6",
                    "sense_definition": "zinterpretować coś w określony sposób, nadać czemuś dane znaczenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interpretacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Obawiam się, że zupełnie źle <w>zrozumiałeś</w> moją wczorajszą wypowiedź.",
                            "target_lang_translations": {
                                "ru": "Боюсь, что ты совершенно неправильно <w>понял</w> мои вчерашние слова."
                            }
                        },
                        {
                            "text": "Jego milczenie można było <w>zrozumieć</w> jako cichą zgodę na wyjazd.",
                            "target_lang_translations": {
                                "ru": "Его молчание можно было <w>расценить</w> как молчаливое согласие на отъезд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "źle zrozumieć",
                        "opatrznie zrozumieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "истолковать что-либо определенным образом, придать значение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "воспринять, истолковать"
                            },
                            {
                                "target_lang_word": "истолковать",
                                "target_lang_sense_clarification": "придать значение"
                            },
                            {
                                "target_lang_word": "расценить",
                                "target_lang_sense_clarification": "воспринять как нечто"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cd82047-1a5a-3002-83da-9eac4adfb8b4",
                    "sense_definition": "zrozumieć się wzajemnie, znaleźć wspólny język z drugą osobą",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "porozumienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo różnicy wieku szybko się <w>zrozumieli</w> i zaczęli współpracować.",
                            "target_lang_translations": {
                                "ru": "Несмотря на разницу в возрасте, они быстро <w>поняли друг друга</w> и начали сотрудничать."
                            }
                        },
                        {
                            "text": "Po długiej rozmowie wreszcie dobrze się <w>zrozumieliśmy</w> w tej sprawie.",
                            "target_lang_translations": {
                                "ru": "После долгого разговора мы наконец-то отлично <w>нашли общий язык</w> по этому вопросу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dobrze się zrozumieć",
                        "zrozumieć się bez słów"
                    ],
                    "target_lang_definitions": {
                        "ru": "понять друг друга, найти общий язык"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понять друг друга",
                                "target_lang_sense_clarification": "взаимно"
                            },
                            {
                                "target_lang_word": "найти общий язык",
                                "target_lang_sense_clarification": "достичь согласия"
                            },
                            {
                                "target_lang_word": "договориться",
                                "target_lang_sense_clarification": "прийти к взаимопониманию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
