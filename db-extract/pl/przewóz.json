                                "target_senses": [
                                    {
                                        "sense_id": "616417f6-4a05-36f8-8232-46a7f5a997a5",
                                        "entry_id": "ee220271-411e-3bb2-b15f-72ed3b45ad41",
                                        "glosses": [
                                            "To carry or bear from one place to another; to remove; to convey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5471262f-5357-4ef7-a9bd-2c3d179984b2",
                                                "sense_id": "616417f6-4a05-36f8-8232-46a7f5a997a5",
                                                "text": "to transport goods; to transport troops"
                                            },
                                            {
                                                "example_id": "8fd1eace-4eca-4d4e-806f-2364a82ed31e",
                                                "sense_id": "616417f6-4a05-36f8-8232-46a7f5a997a5",
                                                "text": "But the village's growth was curbed by the cliffs that restricted onward exploration for visitors, while goods such as coal and lime, which had arrived by water, were being transported up the severe incline to the town of Lynton by horse and cart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d58bb22-30fb-30c8-a34e-a30506a98a0d",
                                        "entry_id": "ee220271-411e-3bb2-b15f-72ed3b45ad41",
                                        "glosses": [
                                            "To deport to a penal colony."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                        "entry_id": "ee220271-411e-3bb2-b15f-72ed3b45ad41",
                                        "glosses": [
                                            "To move (someone) to strong emotion; to carry away."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "962335c6-1e56-4415-8faf-d4ecec32ba21",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "Music transports the soul."
                                            },
                                            {
                                                "example_id": "2a8da080-5390-4ccb-9c19-3438cf65641f",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "Thes. Pray you kneele not,\nI was transported with your Speech, and suffer'd\nYour knees to wrong themselves; I have heard the fortunes\nOf your dead Lords, which gives me such lamenting\nAs wakes my vengeance, and revenge for 'em."
                                            },
                                            {
                                                "example_id": "d8ddb434-2bcc-40c5-8bf6-cd9dd61a69a0",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "[They] laugh as if transported with some fit / Of passion."
                                            },
                                            {
                                                "example_id": "2482cb92-68fa-46e3-8eb1-152caa3d96c8",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "We shall then be transported with a nobler […] wonder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30f2363e-be7d-3838-9398-2eb3be604a4f",
                                        "entry_id": "b3766fc1-0e19-381e-801e-8e2be8f34e99",
                                        "glosses": [
                                            "An act of transporting; conveyance."
                                        ],
                                        "tags": [
