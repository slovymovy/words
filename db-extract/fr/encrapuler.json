                    {
                        "sense_id": "811c050c-87e3-3aeb-9afb-e98714722a71",
                        "entry_id": "6c023aa2-4536-3a0c-adfa-fa23d3b8e535",
                        "glosses": [
                            "Devenir crapule ; fréquenter la crapule."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a0f856-6642-4682-8b8c-80ab0bd63e22",
                                "sense_id": "811c050c-87e3-3aeb-9afb-e98714722a71",
                                "text": "Maintenant, je m'encrapule le plus possible. Pourquoi ? Je veux être poète, et je travaille à me rendre voyant : […]. — (Lettre de Arthur Rimbaud à Georges Izambard du 13 mai 1871)"
                            },
                            {
                                "example_id": "bab3f93c-5303-4ded-b603-06d540328824",
                                "sense_id": "811c050c-87e3-3aeb-9afb-e98714722a71",
                                "text": "Nostalgique de l'Afrique du Nord, il s'encrapule avec de jeunes Arabes."
                            }
                        ]
                    }
