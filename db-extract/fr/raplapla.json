                "forms": [
                    {
                        "form_id": "28601e9f-5696-465a-a151-3e42473b44ab",
                        "entry_id": "7eb00a09-fb7b-35a7-88ab-3aecbf193ac4",
                        "tags": [
                            "plural",
                            "masculine",
