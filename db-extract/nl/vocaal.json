                                "sense_id": "7c35c324-d561-389e-aef1-4ae472c4e143",
                                "text": "In de fonetiek bestuderen we de verschillende klanken, waaronder de vocalen en medeklinkers.",
                                "translation": "In phonetics, we study the different sounds, including the vowels and consonants.",
                                "english": "In phonetics, we study the different sounds, including the vowels and consonants."
                            },
                            {
                                "example_id": "61d24961-f8bb-492e-9f54-113d35bb50fa",
                                "sense_id": "7c35c324-d561-389e-aef1-4ae472c4e143",
                                "text": "Het Nederlands heeft twaalf vocalen, verdeeld over vijf klinkers en zeven tweeklanken.",
                                "translation": "Dutch has twelve vowels, divided into five monophthongs and seven diphthongs.",
                                "english": "Dutch has twelve vowels, divided into five monophthongs and seven diphthongs."
                            },
                            {
                                "example_id": "c8d6ebc1-eabe-4ab8-a968-34b9b395d406",
                                "sense_id": "7c35c324-d561-389e-aef1-4ae472c4e143",
                                "text": "Bij het zingen is het belangrijk om de vocalen helder en zuiver uit te spreken.",
                                "translation": "When singing, it's important to pronounce the vowels clearly and accurately.",
                                "english": "When singing, it's important to pronounce the vowels clearly and accurately."
                            }
                        ]
                    }
