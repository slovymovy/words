                ],
                "senses": [
                    {
                        "sense_id": "11852aa4-cb39-3186-ab51-83d5979d2728",
                        "entry_id": "b004fa40-1ee8-38be-99e9-24e7d278f3fa",
                        "glosses": [
                            "Qui concerne le négativisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8fbd98-15a8-46d6-8f7f-d808f8b3f80f",
                                "sense_id": "11852aa4-cb39-3186-ab51-83d5979d2728",
                                "text": "Il garde un air de contentement sans souci, qui tranche avec l'irritabilité des patients souffrant d'une catatonie négativiste. Les excitations sont rares dans ce type de catatonie."
                            },
                            {
                                "example_id": "3b275348-7909-4399-ad4e-46b18394627d",
                                "sense_id": "11852aa4-cb39-3186-ab51-83d5979d2728",
                                "text": "Je ne ferai que l'illustrer ici d'un trait tiré de l'histoire de la maladie du patient dont je viens de décrire l'attitude autoérotique négativiste. À l'âge de vingt-sept ans, il fut, du fait de son refus alimentaire, nourri à la sonde par un médecin."
                            }
                        ]
                    },
                    {
                        "sense_id": "2afb8b32-7853-34ba-b70b-ea4cf35149a9",
                        "entry_id": "b004fa40-1ee8-38be-99e9-24e7d278f3fa",
                        "glosses": [
                            "Relatif au négativisme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d1935c-233b-48e7-88a8-8384e3f2978a",
                                "sense_id": "2afb8b32-7853-34ba-b70b-ea4cf35149a9",
                                "text": "Pour le contexte de la « modernité » africaine, les fondements de ce discours social, foncièrement négativiste et pathologiste, car misérabilisant, remontent aux propres catégories normatives et axiologiques de l'idéologie coloniale."
                            },
                            {
                                "example_id": "3be2b58b-fd79-43d6-aa9c-26ecb3add6bb",
                                "sense_id": "2afb8b32-7853-34ba-b70b-ea4cf35149a9",
                                "text": "Mais il n'est jamais trop tard pour bien faire. […]. Avec le plaintif négativiste, faire face consiste à l'amener à prendre ses responsabilités plutôt que de se plaindre."
                            }
                        ]
                    }
                ],
