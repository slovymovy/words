                        "form": "dem Kalzium"
                    },
                    {
                        "form_id": "167d3303-669f-4814-af07-fc3804cc39ca",
                        "entry_id": "73cafe7c-d1cf-30c1-a9a6-45254011354c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Kalzium"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbbfdf57-0e70-3e92-a549-b933a8b800cb",
                        "entry_id": "73cafe7c-d1cf-30c1-a9a6-45254011354c",
                        "glosses": [
                            "chemisches Element mit der Ordnungszahl 20, das zur Gruppe der Erdalkalimetalle gehört"
                        ],
                        "tags": [
                            "standardsprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "2de91b8a-de21-4eb7-ba05-e66b8f8af0a3",
                                "sense_id": "dbbfdf57-0e70-3e92-a549-b933a8b800cb",
                                "text": "„Für ein gesundes Wachstum und stabile Knochen brauchen Kinder Vitamin D und Kalzium.“"
                            },
                            {
                                "example_id": "30dd0f5c-ee5d-4bcd-bfd0-a46525b79364",
                                "sense_id": "dbbfdf57-0e70-3e92-a549-b933a8b800cb",
                                "text": "„Magnesium ist zudem neben Kalzium ein wesentlicher Bestandteil der Knochen und dient zum Aufbau von Knochensubstanz.“"
                            },
                            {
                                "example_id": "8dad9151-2a9b-42fa-9f70-b4b89b90016a",
                                "sense_id": "dbbfdf57-0e70-3e92-a549-b933a8b800cb",
                                "text": "„Kalzium ist der Mineralstoff, der im Körper mengenmäßig am stärksten vertreten und in gesunder Haut reichlich vorzufinden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
