                        "examples": [
                            {
                                "example_id": "d77ea7dc-7a0c-46f9-970c-e9ae5337b689",
                                "sense_id": "00aa2f7a-61b3-35d1-8c82-019ef9118e58",
                                "text": "„Die Übung gleicht insofern von ihrer medizinischen Wirkung dem Wirbeltanz der Sufis, die durch beständiges Drehen im Derwisch-Tanz zum Teil ihr Bewusstsein verändern.“"
                            },
                            {
                                "example_id": "0f46213a-e660-429d-ad60-31b9975e039f",
                                "sense_id": "00aa2f7a-61b3-35d1-8c82-019ef9118e58",
                                "text": "„Wenn nach dem heft’gen Wirbeltanz\nDie Nächte schmausend man vertrinket“."
                            }
                        ],
