                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1a6ed407-78f5-47a1-8bd6-ab76b09cf036",
                        "entry_id": "a0e47ee0-52de-3c2d-a7b0-eba9ae0828d1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more arrhythmic"
                    },
                    {
                        "form_id": "8f0965f2-0964-4243-9128-da80d9a07b01",
                        "entry_id": "a0e47ee0-52de-3c2d-a7b0-eba9ae0828d1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most arrhythmic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cb75c73-6a5d-3417-a264-845ca32c9d89",
                        "entry_id": "a0e47ee0-52de-3c2d-a7b0-eba9ae0828d1",
                        "glosses": [
                            "Without rhythm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877f004c-8fe8-4b08-b36c-20b556004918",
                                "sense_id": "3cb75c73-6a5d-3417-a264-845ca32c9d89",
                                "text": "Could there have been a more fatuous and arrhythmic and unmemorable conclusion to what had been, after all, my analysis, my only analysis?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8c628408-0f73-34b1-8fdd-80e215cd31c5",
                        "entry_id": "a0e47ee0-52de-3c2d-a7b0-eba9ae0828d1",
                        "glosses": [
                            "Suffering from cardiac arrhythmia."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b178428-926e-421b-8b09-97b25f390182",
                        "source_entry_id": "a0e47ee0-52de-3c2d-a7b0-eba9ae0828d1",
                        "source_sense_description": "without rhythm",
                        "target_lang_word": "arythmique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arythmique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0aaa741a-b7ca-3349-98c0-3aec1841855a",
                                        "entry_id": "6a65e7cd-421d-3c12-b9bb-63d19c203e63",
                                        "glosses": [
                                            "Qui n’est pas rythmique, qui n’observe pas le rythme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517213f8-6ab8-4bac-a52e-9dea55568ae0",
                                                "sense_id": "0aaa741a-b7ca-3349-98c0-3aec1841855a",
                                                "text": "Pour ne pas décourager un élève arythmique ni exaspérer le professeur, on essaie généralement d’étudier des pièces « carrées »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80d2e80d-1384-3b9f-9a16-ace24a481468",
                                        "entry_id": "6a65e7cd-421d-3c12-b9bb-63d19c203e63",
                                        "glosses": [
                                            "Relatif à l’arythmie, au battement irrégulier du cœur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7a2a225-1bab-333e-8920-2fd18499e39b",
                                        "entry_id": "6a65e7cd-421d-3c12-b9bb-63d19c203e63",
                                        "glosses": [
                                            "Relatif à un système de transmission dans lequel les messages ne sont pas émis de façon synchronisée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arythmique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04fad0e6-7b94-3886-9997-fc3b22b29992",
                                        "entry_id": "7363936d-369e-3e4d-ae24-ea0d95b51fb2",
                                        "glosses": [
                                            "Personne qui n’observe pas le rythme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb55334c-42cd-4c31-a22f-256351a873b7",
                                                "sense_id": "04fad0e6-7b94-3886-9997-fc3b22b29992",
                                                "text": "Dans le cas inverse (qui rétablit l’équilibre), conscient de son handicap, l’arythmique s’efforce de ne pas se presser. Il se retient. Il prend son temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98e08fc-76f1-3c9f-921e-698aafe79f1e",
                                        "entry_id": "7363936d-369e-3e4d-ae24-ea0d95b51fb2",
                                        "glosses": [
                                            "Personne atteinte d’arythmie du cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d772e028-8a32-490a-a074-3f0884ebcc9a",
                                                "sense_id": "a98e08fc-76f1-3c9f-921e-698aafe79f1e",
                                                "text": "Dans les hôpitaux, la plupart des décès ont lieu la nuit et la dérégulation neuronale et neurovégétative qui a lieu pendant le sommeil paradoxal peut expliquer le décès d’un organisme malade (trouble de la tension chez un hypertendu ou trouble du rythme cardiaque chez un arythmique, etc.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb8e673-d3ec-35a8-b899-054c054cf0c5",
                                        "entry_id": "7363936d-369e-3e4d-ae24-ea0d95b51fb2",
                                        "glosses": [
                                            "Médicament modifiant le rythme du cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4f0f7c-4839-49b7-9b37-531ccc5fe32d",
                                                "sense_id": "adb8e673-d3ec-35a8-b899-054c054cf0c5",
                                                "text": "La prévention des récidives est assurée par l’amiodarone ou un arythmique de class Ia ou Ic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
