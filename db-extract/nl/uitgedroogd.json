                        "glosses": [
                            "droog geworden, alle vocht verloren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bddce089-d3a5-40a9-9fc8-e2a43c09b1de",
                                "sense_id": "a005533c-d4d4-3023-94f6-459b4ec0d865",
                                "text": "Omdat er al drie maanden geen regen is gevallen is de grond helemaal uitgedroogd."
                            },
                            {
                                "example_id": "1aaa0aeb-95d3-4678-90d0-7a7cebc5748f",
                                "sense_id": "a005533c-d4d4-3023-94f6-459b4ec0d865",
                                "text": "Deze informatie was nog betrouwbaarder dan de soms wat verouderde opmerkingen in Guthook en gezamenlijk gaven ze voldoende informatie om met enigszins gerust hart de uitgedroogde woestijn in te trekken."
                            }
                        ]
                    }
