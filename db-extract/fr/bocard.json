                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4ba235a8-c007-4ec6-85cd-5eec3e0588ff",
                                "sense_id": "7151eb7a-9d29-3283-a12d-278cf5812400",
                                "text": "— Sais-tu où ça perche, toi, les rues Lipscani, Serindar, Bulandra ?…\nConan m’interrompit :\n— Ça doit sûrement être les rues des bocards ! Comment que tu dis ?…"
                            },
                            {
                                "example_id": "235a8549-0e76-4f3e-92c5-3dc13d3b1407",
                                "sense_id": "7151eb7a-9d29-3283-a12d-278cf5812400",
                                "text": "La petite prostituée nous avait dit qu’elle était internée dans son bocard depuis quatorze mois"
                            }
                        ]
                    }
