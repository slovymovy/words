                        "glosses": [
                            "Of, like, or characteristic of an aunt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f8b3cc-739c-43cb-b5bf-49dfd7f39a76",
                                "sense_id": "884d3fdf-9bf9-30fa-bb24-4d804cb1a137",
                                "text": "It was late, very late, when finally she climbed into the great bed after having received an auntly kiss."
                            },
                            {
                                "example_id": "a52eaa1d-1fba-43fe-a81e-f91387bc9bd9",
                                "sense_id": "884d3fdf-9bf9-30fa-bb24-4d804cb1a137",
                                "text": "The legacy Martineau offers to Eliot is auntly in the terms of my definition, because it is simultaneously gratuitous and enabling."
                            },
                            {
                                "example_id": "d11b1c18-c51a-48a6-a340-310e9c097ec8",
                                "sense_id": "884d3fdf-9bf9-30fa-bb24-4d804cb1a137",
                                "text": "He watched the auntly lady twist the ends of the diaper so that the whole assemblage seemed to wrap itself around his boy like magic."
                            }
                        ]
