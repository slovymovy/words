                                        "glosses": [
                                            "Of, relating to, or enacted by a parliament."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7abaaf61-8992-4a9d-bc77-92cb9b7379d4",
                                                "sense_id": "f1ca2f7e-bc6f-37fd-ad85-f753ea61eea4",
                                                "text": "Parliamentary procedures are sometimes slow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5644b1f9-726e-327e-9acf-7f6cb23bc8c6",
                                        "entry_id": "46600d8f-8f95-3e93-a214-5517711536a0",
                                        "glosses": [
                                            "Having the supreme executive and legislative power resting with a cabinet of ministers chosen from, and responsible to a parliament."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f39599-5db1-4dc0-b5ae-2f0c43351c76",
                                                "sense_id": "5644b1f9-726e-327e-9acf-7f6cb23bc8c6",
                                                "text": "The UK is a parliamentary democracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9369783-77bf-3bd0-9af7-f657c4569632",
                                        "entry_id": "46600d8f-8f95-3e93-a214-5517711536a0",
                                        "glosses": [
                                            "Of a class of train which, by an act of parliament, ran both ways along a line, at least once each day, at the rate of one penny per mile."
                                        ],
                                        "tags": [
                                            "British",
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2f0227-a69d-4a78-acce-a911f703ec6f",
                                                "sense_id": "b9369783-77bf-3bd0-9af7-f657c4569632",
                                                "text": "The train was moving less fast through the summer night. The swift express had changed into something almost a parliamentary, had stopped three times since Norwich, and now, at long last, was approaching Banton."
                                            }
