                    "sense_id": "2638d690-d4af-3d03-8fa4-2904dcf230d3",
                    "sense_definition": "de bovenste laag van iets dat uit verschillende lagen bestaat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke laag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder brengt een beschermende <w>toplaag</w> aan op het houten kozijn.",
                            "target_lang_translations": {
                                "en": "The painter applies a protective <w>topcoat</w> to the wooden window frame."
                            }
                        },
                        {
                            "text": "Het wegdek wordt geheel vervangen en de vloer krijgt een nieuwe <w>toplaag</w>.",
                            "target_lang_translations": {
                                "en": "The road surface is being completely replaced and the floor is getting a new <w>top layer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppervlakte",
                        "bovenlaag"
                    ],
                    "antonyms": [
