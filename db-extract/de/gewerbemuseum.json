                "senses": [
                    {
                        "sense_id": "3013ac6f-dd2e-3d81-acfb-e71604824c02",
                        "entry_id": "39fac553-c022-3f00-a490-7f6c994c66ab",
                        "glosses": [
                            "Museum, das Werke der Gewerbe ausstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7549fbcb-81e6-4f39-8c1e-32a55fa057e2",
                                "sense_id": "3013ac6f-dd2e-3d81-acfb-e71604824c02",
                                "text": "Das einzige Gewerbemuseum der Stadt hat montags geschlossen."
                            },
                            {
                                "example_id": "180a529b-1b2c-43df-ad9c-038c4565c36f",
                                "sense_id": "3013ac6f-dd2e-3d81-acfb-e71604824c02",
                                "text": "„Bereits im Jahr 1903 schrieb das Bayerische Gewerbemuseum in Nürnberg, der Vorläufer der Landesgewerbeanstalt, einen Wettbewerb ‚zur Erlangung von Entwürfen zu charakteristischen Holzspielsachen‘ aus.“"
                            },
                            {
                                "example_id": "6bc8a257-bfa4-4cb4-ac1e-26962b072ec0",
                                "sense_id": "3013ac6f-dd2e-3d81-acfb-e71604824c02",
                                "text": "„Das Technologische Gewerbemuseum wurde 1905 verstaatlicht (Direktor wurde Professor Lauböck) und 1908 dem Handelsministerium unterstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
