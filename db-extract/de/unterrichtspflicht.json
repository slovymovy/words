                ],
                "senses": [
                    {
                        "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                        "entry_id": "3dac34fc-2c21-3bc3-91d8-de57bdba2a5c",
                        "glosses": [
                            "staatlich auferlegte oder vertraglich vereinbarte Notwendigkeit, an einer strukturierten Situation teilzunehmen, bei der Wissen weitergegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11994c5f-8aba-4a7c-bccb-44fabe0e13a9",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Allerdings wird es dann möglich sein, dass Schüler/innen in unterschiedlichen Anforderungsebenen ihre Unterrichtspflicht erfüllen.“"
                            },
                            {
                                "example_id": "0ac55ceb-a7e2-4ab9-829d-f14ac831354e",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Während das Herzogtum Pfalz-Zweibrücken sich schon 1592 für die Schulpflicht entschied und Sachsen-Gotha, Braunschweig-Wolfenbüttel und Württemberg im 17. Jahrhundert folgten, versuchte Preußen seit 1717 lediglich, die Unterrichtspflicht durchzusetzen, was erst gegen Ende des 19. Jahrhunderts gelang.“"
                            },
                            {
                                "example_id": "7c9a7ac0-b001-4082-8d09-25846fefe6c4",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Die vier Lehrer wollen vor allem aufzeigen, dass die Schüler nicht von der längeren Unterrichtspflicht profitieren.“"
                            },
                            {
                                "example_id": "404b49d7-aff0-46b3-9165-ee120b592b62",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Meine Lateinlehrerin und Wahlamtsleiterin war für den Tag von ihren Unterrichtspflichten befreit.“"
                            },
                            {
                                "example_id": "9934e266-72e5-4456-b4d3-fd9c57189718",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Und dann fiel ihm noch der Pelikanmann ein, und seine Unterrichtspflicht als Lehrer.“"
                            },
                            {
                                "example_id": "9ea6ba01-ddb8-46df-a7de-080d705e74ca",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Das Gesetz sieht neben der Regelung des § 125 in besonderen Fällen eine Reihe zusätzlicher Unterrichtspflichten vor, die die Gesellschaft vor einer Hauptversammlung zu erfüllen hat […].“"
                            },
                            {
                                "example_id": "0e6576dd-6cec-4d3f-9adf-676dcf5164d5",
                                "sense_id": "7a6ff09d-03c4-3ed1-99f6-8708e408b251",
                                "text": "„Eine entsprechende Unterrichtspflicht gilt für den Formwechsel einer Partnerschaftsgesellschaft für die von der Geschäftsführung ausgeschlossenen Partner (§ 225b S 2 UmwG).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
