{
    "word_family": [
        "jaillissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "376ff201-02bc-3cfb-a966-3cd01fbc3be4",
                    "sense_definition": "Sortir impétueusement et avec force, en parlant d'un liquide ou d'un fluide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De l'eau fraîche <w>jaillit</w> soudainement du tuyau percé au milieu du jardin."
                        },
                        {
                            "text": "Les randonneurs observent une source claire qui <w>jaillit</w> entre deux gros rochers."
                        }
                    ],
                    "synonyms": [
                        "gicler",
                        "sourdre"
                    ],
                    "antonyms": [
                        "tarir",
                        "stagner"
                    ],
                    "common_phrases": [
                        "faire jaillir de l'eau"
                    ]
                },
                {
                    "sense_id": "853188c4-73be-3965-8af8-538bb8ff3f84",
                    "sense_definition": "Apparaître soudainement ou se manifester avec éclat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition_soudaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une idée brillante a soudainement <w>jailli</w> dans son esprit pendant la réunion."
                        },
                        {
                            "text": "Dans l'obscurité totale de la pièce, une étincelle <w>jaillit</w> et éclaire brièvement les visages."
                        }
                    ],
                    "synonyms": [
                        "surgir",
                        "émerger",
                        "fuser"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'éteindre"
                    ],
                    "common_phrases": [
                        "jaillir de nulle part",
                        "faire jaillir la lumière"
                    ]
                },
                {
                    "sense_id": "179e64cb-63a1-3212-9fe9-42ab4f094e93",
                    "sense_definition": "S'élever d'un seul élan vers le haut, en parlant d'un édifice ou d'un relief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elevation_verticale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les flèches gothiques de la vieille cathédrale <w>jaillissent</w> fièrement vers le ciel."
                        },
                        {
                            "text": "Au milieu de cette plaine aride, des falaises abruptes <w>jaillissent</w> au-dessus des collines."
                        }
                    ],
                    "synonyms": [
                        "s'élancer",
                        "s'élever"
                    ],
                    "antonyms": [
                        "s'affaisser"
                    ],
                    "common_phrases": [
                        "jaillir vers le ciel"
                    ]
                }
            ]
        }
    ]
