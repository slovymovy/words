    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fe77e0a-539c-3174-ae0a-bee8c69c54e7",
                    "sense_definition": "Lever légèrement les épaules pour exprimer l'indifférence, l'ignorance ou le doute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_corporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand je lui ai demandé son avis, il s'est contenté de <w>hausser</w> les épaules."
                        },
                        {
                            "text": "Ne <w>hausse</w> pas les épaules et réponds poliment à ma question."
                        }
                    ],
                    "common_phrases": [
                        "hausser les épaules"
                    ]
                },
                {
                    "sense_id": "713d70e1-3c90-36c8-9a58-570c253f5806",
                    "sense_definition": "Augmenter l'intensité ou le volume de la voix, parler plus fort ou avec plus d'autorité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voix_son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a dû <w>hausser</w> le ton pour calmer les élèves bruyants."
                        },
                        {
                            "text": "Il est inutile de <w>hausser</w> la voix car tout le monde vous écoute."
                        }
                    ],
                    "synonyms": [
                        "élever"
                    ],
                    "antonyms": [
                        "baisser"
                    ],
                    "common_phrases": [
                        "hausser la voix",
                        "hausser le ton"
                    ]
                },
                {
                    "sense_id": "814a4bd3-84f3-3259-ba62-ffb798d68687",
                    "sense_definition": "Rendre plus élevé en quantité, en valeur ou en montant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite_valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à l'inflation, plusieurs magasins ont décidé de <w>hausser</w> leurs prix."
                        },
                        {
                            "text": "L'entreprise refuse de <w>hausser</w> les salaires malgré les demandes des employés."
                        }
                    ],
                    "synonyms": [
                        "augmenter",
                        "élever",
                        "accroître"
                    ],
                    "antonyms": [
                        "baisser",
                        "diminuer",
                        "réduire"
                    ],
                    "common_phrases": [
                        "hausser les prix"
                    ]
                },
                {
                    "sense_id": "368a8493-21e5-36fe-90b8-252e1da7ff4f",
                    "sense_definition": "Placer à une hauteur supérieure, surélever ou porter vers le haut.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire souhaite <w>hausser</w> le mur afin de protéger son jardin du vent."
                        },
                        {
                            "text": "Le petit garçon se <w>haussait</w> sur la pointe des pieds pour voir le spectacle."
                        }
                    ],
                    "synonyms": [
                        "élever",
                        "surélever",
                        "lever"
                    ],
                    "antonyms": [
                        "abaisser",
                        "baisser"
                    ],
                    "common_phrases": [
                        "hausser un mur"
                    ]
                }
            ]
        }
    ]
}