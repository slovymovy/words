                                        "entry_id": "6e37e163-59e6-384f-bb11-1aec9b25b3e2",
                                        "glosses": [
                                            "η συνύπαρξη δυο παθολογικών καταστάσεων ή νόσων στον ίδιο ασθενή"
                                        ],
                                        "tags": [
                                            "ιατρική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1536386e-b8e7-4d04-b28e-45e75a26b1e4",
                                                "sense_id": "1b4ec8a9-c96a-323d-83d4-3eb6ca7191ef",
                                                "text": "※ Η γρίπη μπορεί να επιδεινώσει ήδη υπάρχουσες συννοσηρότητες, όπως η χρόνια αποφρακτική πνευμονοπάθεια, το άσθμα, η καρδιακή ανεπάρκεια και ο σακχαρώδης διαβήτης. (εφ. Το Βήμα, 04.11.2020)"
                                            }
                                        ]
                                    }
                                ]
                            }
