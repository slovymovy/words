                        ],
                        "form": "catogans"
                    },
                    {
                        "form_id": "210033cd-e4be-44d6-b2b0-d148c878bd2c",
                        "entry_id": "e99dc563-9ce9-3eb0-be38-4f12e5b0bf64",
                        "tags": [],
                        "form": "cadogan"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a88f9ed-cd3b-3356-81f9-95dc568ceedb",
                        "entry_id": "e99dc563-9ce9-3eb0-be38-4f12e5b0bf64",
                        "glosses": [
                            "Ruban utilisé pour rassembler les cheveux longs sur la nuque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb748404-f5f0-4393-a72c-a8612385968e",
                                "sense_id": "1a88f9ed-cd3b-3356-81f9-95dc568ceedb",
                                "text": "Parvenu en haut de l’escalier le long duquel l’avait suivi un domestique à face blême, avec une petite queue de cheveux noués d’un catogan derrière la tête, comme un sacristain de Goya ou un tabellion du répertoire, Swann passa devant un bureau où des valets, assis comme des notaires devant de grands registres, se levèrent et inscrivirent son nom."
                            },
                            {
                                "example_id": "b715d23a-537b-4bb1-9c8d-b63f9dddb006",
                                "sense_id": "1a88f9ed-cd3b-3356-81f9-95dc568ceedb",
                                "text": "Casquette prolétarienne pour beaucoup, catogan ou fichu pour les femmes, parfois légèrement maquillées, non sans un brin de coquetterie pour certaines …"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a452495-005f-3db4-8401-277a84ee624e",
                        "entry_id": "e99dc563-9ce9-3eb0-be38-4f12e5b0bf64",
                        "glosses": [
                            "La chevelure ainsi rassemblée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b73814-7e38-4b85-99f4-4d780de6f38f",
                                "sense_id": "5a452495-005f-3db4-8401-277a84ee624e",
                                "text": "Sur le sommet de la tête reposait une imperceptible casquette empanachée et enrubannée, laissant échapper jusque sur le milieu du dos des cascades de cheveux réunis en un immense catogan."
                            },
                            {
                                "example_id": "051715ea-14fe-47c8-8daf-c026095bf401",
                                "sense_id": "5a452495-005f-3db4-8401-277a84ee624e",
                                "text": "La jeune personne de quinze ans […] portait des cheveux très noirs noués en catogan, une chemisette agitée, une jupe de son âge, une ceinture de cuir."
                            },
                            {
                                "example_id": "72f4ff7e-ac90-47b6-aede-13f63e76b8cd",
                                "sense_id": "5a452495-005f-3db4-8401-277a84ee624e",
                                "text": "Blonde, les cheveux tressés en catogan, le nœud papillon en faille noire posé sur la nuque, Hannah me vint prendre par la main."
                            },
                            {
                                "example_id": "d466f443-4cf7-45ae-8855-a278eacdb16a",
                                "sense_id": "5a452495-005f-3db4-8401-277a84ee624e",
                                "text": "Un gros nœud de ruban s’épanouissait sur ses cheveux relevés en « catogan » et qu’Yves comparait à un marteau de porte."
                            },
                            {
                                "example_id": "83cececc-b58f-4499-800b-e6ab2bf1a279",
                                "sense_id": "5a452495-005f-3db4-8401-277a84ee624e",
                                "text": "La porte se referma sur le catogan."
                            }
                        ]
                    },
                    {
                        "sense_id": "a40d45eb-57c6-3c7e-9dec-30085d1fbe05",
                        "entry_id": "e99dc563-9ce9-3eb0-be38-4f12e5b0bf64",
                        "glosses": [
                            "Sorte d'arrangement de la queue du cheval, de l'âne ou du mulet."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c164f7b9-b5c1-44f1-8d17-6a1fb84caca0",
                                "sense_id": "a40d45eb-57c6-3c7e-9dec-30085d1fbe05",
                                "text": "Le marchand de mules […] coupe les poils garnissant l’origine de la queue, et fait le catogan pour élargir l’arrière train des bêtes dégingandées ; les brosse à contre-poil pour donner plus d’ampleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b50c8af-f274-4f2b-b2b9-23fd36118ebc",
                        "source_entry_id": "e99dc563-9ce9-3eb0-be38-4f12e5b0bf64",
                        "target_lang_word": "ponytail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponytail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "116280f2-ec15-3095-a53d-d94ef000557b",
                                        "entry_id": "43ab85fd-b8c3-302f-80dd-a4cea8046d3e",
                                        "glosses": [
                                            "A hairstyle where the hair is pulled back and tied into a single \\\"tail\\\" which hangs down behind the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9d36c4-0462-4fbc-a7e6-599003dc440e",
                                                "sense_id": "116280f2-ec15-3095-a53d-d94ef000557b",
                                                "text": "The physician should evaluate for a history of tight ponytails, buns, chignons, braids, twists, weaves, cornrows, dreadlocks, sisterlocks, and hair wefts in addition to the usage of religious hair coverings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ponytail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71853b08-7f0a-3f16-96a4-eea9a833deca",
                                        "entry_id": "f5aa39d2-61ed-37db-9fa1-d6438859d5ed",
                                        "glosses": [
                                            "To form (the hair) into a ponytail."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb73220-dddb-4a6d-92f8-4f5ce71d372b",
                                                "sense_id": "71853b08-7f0a-3f16-96a4-eea9a833deca",
                                                "text": "“Don't mention it,” she said, ponytailing her hair and then sockbunning it with amazing speed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
