                },
                {
                    "sense_id": "c8a3f5cc-1a1d-3e1a-b9a1-5abcd5f935c0",
                    "sense_definition": "Possessing the ability to think logically and use reason.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Humans are often defined as <w>reasonable</w> beings capable of complex thought.",
                            "target_lang_translations": {
                                "ru": "Людей часто определяют как <w>разумных</w> существ, способных к сложному мышлению.",
                                "pl": "Ludzie są często definiowani jako istoty <w>rozumne</w>, zdolne do złożonego myślenia."
                            }
                        },
                        {
                            "text": "Any <w>reasonable</w> creature would avoid such a dangerous situation.",
                            "target_lang_translations": {
                                "ru": "Любое <w>разумное</w> существо избегало бы такой опасной ситуации.",
                                "pl": "Każda <w>rozumna</w> istota unikałaby tak niebezpiecznej sytuacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "rational"
                    ],
                    "antonyms": [
                        "irrational",
                        "non-rational",
                        "unreasonable"
                    ],
                    "common_phrases": [
                        "reasonable creature",
                        "reasonable being"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью мыслить логически.",
                        "pl": "Posiadający zdolność logicznego myślenia i posługiwania się rozumem."
                    },
                    "translations": {
                        "ru": [
