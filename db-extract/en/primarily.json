                    {
                        "sense_id": "99bd5b34-17fe-33c1-a5fa-653f15aecc6f",
                        "entry_id": "07269453-1f8e-3a57-88c6-8147b7809d49",
                        "glosses": [
                            "Of a primary or central nature, first and foremost."
                        ],
                        "tags": [
                            "focus",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ae8ac2f-4862-446d-b012-48c9f848e673",
                                "sense_id": "99bd5b34-17fe-33c1-a5fa-653f15aecc6f",
                                "text": "The idea of fitting a crane to an engine for shunting duties, primarily in works yards, appears to have originated with the North London Railway engine in 1872."
                            },
                            {
                                "example_id": "ab557365-f5c7-4116-8074-73dab3365d66",
                                "sense_id": "99bd5b34-17fe-33c1-a5fa-653f15aecc6f",
                                "text": "But now a study has shown that most cancers are primarily caused by bad luck rather than poor lifestyle choices or defective DNA."
                            },
                            {
                                "example_id": "9073a513-b475-447e-8903-68e3595c5b86",
                                "sense_id": "99bd5b34-17fe-33c1-a5fa-653f15aecc6f",
                                "text": "Zika virus disease is caused by a virus transmitted primarily by Aedes mosquitoes, which bite during the day."
                            },
                            {
                                "example_id": "49360926-73cd-4d35-96e9-53c4a54d217c",
                                "sense_id": "99bd5b34-17fe-33c1-a5fa-653f15aecc6f",
                                "text": "Some Gold Cups are won primarily with class, others with stamina."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cae34adc-f397-4cdb-b296-20cf75d3f688",
                        "source_entry_id": "07269453-1f8e-3a57-88c6-8147b7809d49",
                        "source_sense_id": "99bd5b34-17fe-33c1-a5fa-653f15aecc6f",
                        "source_sense_description": "of a primary or central nature",
                        "target_lang_word": "principalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "principalement",
