                                                "example_id": "ac0ece47-0d74-4ace-adcd-a574255b92ce",
                                                "sense_id": "a59a42ca-1cc2-3309-8ec6-232658a167c9",
                                                "text": "2015 (November 20) \"Zombie Broheims\", episode 14 of Pig Goat Banana Cricket\nCricket: \"Don't pinata me!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
