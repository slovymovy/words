                                                "example_id": "934fb5c5-a3b8-4288-9f46-782decb7d950",
                                                "sense_id": "751c7038-7bbb-3e85-9a73-ec745b5a50da",
                                                "text": "Maar tegelijk voelt de mens zich ook bezorgd, woedend en angstig."
                                            },
                                            {
                                                "example_id": "478119b5-d150-483e-8f98-dae2def92fdc",
                                                "sense_id": "751c7038-7bbb-3e85-9a73-ec745b5a50da",
                                                "text": "Hij begon steeds bezorgder te kijken."
                                            },
                                            {
