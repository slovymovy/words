        "fr-extract.jsonl": [
            {
                "entry_id": "385ec964-cf03-3f13-9579-6e888a73fa82",
                "word": "sonnet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57005f8f-f113-4d37-9155-e5c1bcb79f47",
                        "entry_id": "385ec964-cf03-3f13-9579-6e888a73fa82",
                        "tags": [
                            "plural"
                        ],
                        "form": "sonnets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c7b7fa1-e98b-3de4-bef7-afee620361fd",
                        "entry_id": "385ec964-cf03-3f13-9579-6e888a73fa82",
                        "glosses": [
                            "Ouvrage de poésie, composé de quatorze vers distribués en deux quatrains sur deux rimes seulement et en deux tercets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90b0d0e7-f19e-45d6-9982-c206f39761da",
                                "sense_id": "1c7b7fa1-e98b-3de4-bef7-afee620361fd",
                                "text": "Oronte : Voilà qui va fort bien, et je crois vous entendre.\nMais ne puis-je savoir ce que dans mon sonnet…\nAlceste : Franchement, il est bon à mettre au cabinet ;\nVous vous êtes réglé sur de méchants modèles,\nEt vos expressions ne sont point naturelles."
                            },
                            {
                                "example_id": "2be65dfc-b508-41b3-b8ab-a44797d36a9e",
                                "sense_id": "1c7b7fa1-e98b-3de4-bef7-afee620361fd",
                                "text": "Il lui offrit son volume des Orfraies, recueil de sonnets, comme nous en avons tous fait et tous lu, dans le temps où nous avions le jugement si court et les cheveux si longs."
                            },
                            {
                                "example_id": "f96e07fb-c102-4d51-9214-e166f6186399",
                                "sense_id": "1c7b7fa1-e98b-3de4-bef7-afee620361fd",
                                "text": "Plus d’un jeune instituteur stagiaire a retrouvé dans le siècle celle pour qui s’échafaudaient ses odes et ses sonnets."
                            },
                            {
                                "example_id": "b6783939-7228-47d0-8a73-d58b549cb687",
                                "sense_id": "1c7b7fa1-e98b-3de4-bef7-afee620361fd",
                                "text": "En effet, grâce à des rimes isosexuelles dont la morphologie nominale ou adjectivale est exclusivement féminine, elle s'affranchit de la règle séculaire d'alternance du sexe des rimes et consacre ainsi le sonnet à la féminité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65779406-f08c-44b4-bd58-5be2dbe71f61",
                        "source_entry_id": "385ec964-cf03-3f13-9579-6e888a73fa82",
                        "source_sense_id": "1c7b7fa1-e98b-3de4-bef7-afee620361fd",
                        "target_lang_word": "Sonett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afc012b7-e003-31be-967d-763e6f4eb9fc",
                                        "entry_id": "f46dc484-8451-37ae-9edf-4ce81dfbf5ed",
                                        "glosses": [
                                            "eine Gedichtform bestehend aus 14 Verszeilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f60b03-a062-41d4-83ea-f544dabc6aaa",
                                                "sense_id": "afc012b7-e003-31be-967d-763e6f4eb9fc",
                                                "text": "„Wenn ich Sonette lese, bekomme ich auch immer gleich Schluckauf.“"
                                            },
                                            {
                                                "example_id": "5f4d787a-be53-4df4-92b5-258cfda3f3f8",
                                                "sense_id": "afc012b7-e003-31be-967d-763e6f4eb9fc",
                                                "text": "William Shakespeare schrieb auch einen Zyklus von 154 Sonetten, der 1609 erschien."
                                            },
                                            {
                                                "example_id": "5113269f-3d94-4249-8760-4a598b01de51",
                                                "sense_id": "afc012b7-e003-31be-967d-763e6f4eb9fc",
                                                "text": "„Während er schrieb, verfaßte ich ein Sonett über das gleiche Thema.“"
                                            },
                                            {
                                                "example_id": "d7c943bd-6db0-406d-8e4f-5c78a4120fdf",
                                                "sense_id": "afc012b7-e003-31be-967d-763e6f4eb9fc",
                                                "text": "„Es war nämlich einer der Vorfahren des Marquis, der Graf Hugues de Sade, der am Anfang des 14. Jahrhunderts jene unsterblich gewordene Laura zur Frau nahm, die Petrarca zu seinen schmerzlich-sehnsüchtigen Sonetten inspiriert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
