                                "sense_id": "f3a201a6-b441-34e2-91d2-fd6a255e4715",
                                "text": "He killed hisself.",
                                "translation": "Er hat sich selbst getötet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5127e7be-e784-4177-b533-d40414d7b1fd",
                        "source_entry_id": "4becb325-4bf5-38d2-8da6-6c260fd02fae",
                        "source_sense_id": "f3a201a6-b441-34e2-91d2-fd6a255e4715",
