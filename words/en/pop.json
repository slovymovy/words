                                "target_lang_word": "流行音乐",
                                "target_lang_sense_clarification": "音乐流派"
                            },
                            {
                                "target_lang_word": "流行歌曲",
                                "target_lang_sense_clarification": "具体作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c90d456-7ab4-3246-a468-6c5c51f88ce8",
                    "sense_definition": "One's father.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>pop</w> took me to the baseball game last weekend.",
                            "target_lang_translations": {
                                "ru": "Мой <w>папа</w> водил меня на бейсбол в прошлые выходные.",
                                "zh": "上周末我<w>老爸</w>带我去看棒球比赛了。"
                            }
                        },
                        {
                            "text": "I need to ask my <w>pop</w> if I can borrow the car.",
                            "target_lang_translations": {
                                "ru": "Мне нужно спросить у <w>папы</w>, можно ли одолжить машину.",
                                "zh": "我得问问我<w>老爸</w>能不能借用一下车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dad",
                        "papa",
                        "father"
                    ],
                    "traits": [
