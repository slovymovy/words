                "senses": [
                    {
                        "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                        "entry_id": "34e7010e-19ed-350c-926b-bc049dff399b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586bc7db-efb2-4f91-b766-3d660a063cb9",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Frau Erthle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6bb83ebd-2281-4ad9-a241-635a17986073",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Herr Erthle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d496d7f6-7a4f-4dd6-8698-01a3a11d5d64",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Die Erthles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "e1242329-c368-475d-a0fe-efcd20a35ad0",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Der Erthle trägt nie die Pullover, die die Erthle ihm strickt."
                            },
                            {
                                "example_id": "494a5aff-9211-4e21-9128-3aa426fa13e2",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Erthle kommt, geht der Herr Erthle.“"
                            },
                            {
                                "example_id": "9b216601-1042-4e69-b107-b0955f5254c5",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Erthle kommt und geht."
                            },
                            {
                                "example_id": "9821ea82-9c40-4b72-afc8-b2b8ae529d63",
                                "sense_id": "e77fe5ee-ce2c-3901-80ee-9b72494a4a48",
                                "text": "Erthles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
