                        "entry_id": "9b6c225c-c760-3825-a7c8-959255329495",
                        "glosses": [
                            "Animal appartenant aux Mustelidae, famille de mammifères carnivores regroupant 55 espèces telles que blaireaux, belettes, fouines, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16bbbd8a-534a-455d-8b06-330c765072f9",
                                "sense_id": "187defa2-b492-3231-b90c-ece4714e90c6",
                                "text": "Les mustélidés sont protégés dans plusieurs pays d'Europe."
                            },
                            {
                                "example_id": "d172fc9c-b1f6-440d-b4aa-73e6b43f91a7",
                                "sense_id": "187defa2-b492-3231-b90c-ece4714e90c6",
                                "text": "Malgré les campagnes choc des militants anti-fourrure, le mustélidé est encore à l’honneur dans les défilés de mode."
                            }
                        ]
                    }
                ],
