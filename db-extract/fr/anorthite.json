                "word": "anorthite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b96ce396-50f0-4fb6-b792-3201af6bddc5",
                        "entry_id": "9c29c4f4-ed34-307e-b468-11ab0e6ac9ac",
                        "tags": [
                            "plural"
                        ],
