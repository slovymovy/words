{
    "word_family": [
        "look",
        "lookout",
        "overlooker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f4174c8-3b3d-3934-b33d-01697781cf61",
                    "sense_definition": "To fail to notice or to miss something by looking over and beyond it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "neglect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is very easy to <w>overlook</w> a small typo when you are reading a long document.",
                            "target_lang_translations": {
                                "ru": "Очень легко <w>просмотреть</w> маленькую опечатку при чтении длинного документа."
                            }
                        },
                        {
                            "text": "The detective did not want to <w>overlook</w> any detail, no matter how small it seemed.",
                            "target_lang_translations": {
                                "ru": "Детектив не хотел <w>упустить из виду</w> ни одной детали, какой бы незначительной она ни казалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "miss",
                        "neglect",
                        "pass over"
                    ],
                    "antonyms": [
                        "notice",
                        "spot",
                        "observe"
                    ],
                    "common_phrases": [
                        "overlook a detail",
                        "easy to overlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не заметить или пропустить что-либо по невнимательности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просмотреть",
                                "target_lang_sense_clarification": "упустить из виду"
                            },
                            {
                                "target_lang_word": "не заметить",
                                "target_lang_sense_clarification": "пропустить"
                            },
                            {
                                "target_lang_word": "упустить из виду",
                                "target_lang_sense_clarification": "не обратить внимания"
                            },
                            {
                                "target_lang_word": "пропустить",
                                "target_lang_sense_clarification": "не заметить деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "652f25ee-16a5-3364-b83e-835dd5837031",
                    "sense_definition": "To deliberately ignore or forgive a mistake, flaw, or bad behavior.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "forgive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher decided to <w>overlook</w> his lateness just this once because of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Учитель решил <w>закрыть глаза</w> на его опоздание только в этот раз из-за сильного дождя."
                            }
                        },
                        {
                            "text": "If you want to maintain a long friendship, you sometimes have to <w>overlook</w> minor faults.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите сохранить долгую дружбу, иногда приходится <w>прощать</w> мелкие недостатки."
                            }
                        }
                    ],
                    "synonyms": [
                        "disregard",
                        "ignore",
                        "condone"
                    ],
                    "antonyms": [
                        "punish",
                        "criticize",
                        "condemn"
                    ],
                    "common_phrases": [
                        "overlook a mistake",
                        "willing to overlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно игнорировать или прощать ошибку, недостаток или плохое поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотреть сквозь пальцы",
                                "target_lang_sense_clarification": "сознательно не замечать"
                            },
                            {
                                "target_lang_word": "прощать",
                                "target_lang_sense_clarification": "не наказывать за ошибку"
                            },
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "не обращать внимания"
                            },
                            {
                                "target_lang_word": "закрывать глаза",
                                "target_lang_sense_clarification": "на что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "149d8ae4-b652-3a16-8608-500281f76f99",
                    "sense_definition": "To have a view of something from a higher position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our balcony <w>overlooks</w> the ocean, providing a beautiful view every morning.",
                            "target_lang_translations": {
                                "ru": "Наш балкон <w>выходит на</w> океан, открывая прекрасный вид каждое утро."
                            }
                        },
                        {
                            "text": "The castle <w>overlooks</w> the valley from its position high on the cliff.",
                            "target_lang_translations": {
                                "ru": "Замок <w>возвышается над</w> долиной со своего места на высокой скале."
                            }
                        }
                    ],
                    "synonyms": [
                        "command a view of",
                        "look out on"
                    ],
                    "common_phrases": [
                        "overlooks the sea",
                        "overlooks the garden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь вид на что-либо с более высокой точки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить на",
                                "target_lang_sense_clarification": "об окнах или балконе"
                            },
                            {
                                "target_lang_word": "возвышаться над",
                                "target_lang_sense_clarification": "о здании или горе"
                            },
                            {
                                "target_lang_word": "иметь вид на",
                                "target_lang_sense_clarification": "открывать панораму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "691c4e4b-f9b0-3ce7-9017-b7742bf86f91",
                    "sense_definition": "To supervise or watch over a process or a group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supervise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was hired to <w>overlook</w> the daily operations of the factory.",
                            "target_lang_translations": {
                                "ru": "Менеджер был нанят, чтобы <w>надзирать</w> за повседневной деятельностью завода."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>overlooking</w> the workers to ensure the project stayed on schedule.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, <w>присматривая</w> за рабочими, чтобы проект шел по графику."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversee",
                        "supervise",
                        "monitor"
                    ],
                    "common_phrases": [
                        "overlook the work",
                        "overlook the staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контролировать или наблюдать за процессом или группой людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надзирать",
                                "target_lang_sense_clarification": "осуществлять надзор"
                            },
                            {
                                "target_lang_word": "присматривать",
                                "target_lang_sense_clarification": "следить за порядком"
                            },
                            {
                                "target_lang_word": "курировать",
                                "target_lang_sense_clarification": "контролировать работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca132bf0-8fd6-3d9e-8a3e-4aa515a23122",
                    "sense_definition": "To inspect or examine something carefully.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before signing the contract, he asked his lawyer to <w>overlook</w> the document one last time.",
                            "target_lang_translations": {
                                "ru": "Перед подписанием контракта он попросил своего адвоката еще раз <w>проверить</w> документ."
                            }
                        },
                        {
                            "text": "The general went out to <w>overlook</w> the troops before the parade began.",
                            "target_lang_translations": {
                                "ru": "Генерал вышел, чтобы <w>осмотреть</w> войска перед началом парада."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspect",
                        "examine",
                        "scrutinize",
                        "survey"
                    ],
                    "common_phrases": [
                        "overlook the accounts",
                        "overlook the land"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is less common in modern English compared to 'oversee' or 'inspect'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно осматривать или проверять что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "инспектировать"
                            },
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "изучать документ"
                            },
                            {
                                "target_lang_word": "обозревать",
                                "target_lang_sense_clarification": "проводить осмотр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16b754f7-9bbc-32ae-bdb3-33cca4f6112a",
                    "sense_definition": "To bewitch or cast a spell on someone by looking at them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old legends, the witch was said to <w>overlook</w> children and cause them to fall ill.",
                            "target_lang_translations": {
                                "ru": "В старых легендах говорили, что ведьма могла <w>сглазить</w> детей, отчего те заболевали."
                            }
                        },
                        {
                            "text": "The villagers feared she might <w>overlook</w> their cattle with her dark gaze.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители боялись, что она может <w>сглазить</w> их скот своим мрачным взглядом."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewitch",
                        "hex",
                        "fascinate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the context of folklore or historical literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Околдовать или наложить заклятие взглядом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сглазить",
                                "target_lang_sense_clarification": "навести порчу взглядом"
                            },
                            {
                                "target_lang_word": "околдовать",
                                "target_lang_sense_clarification": "зачаровать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c436b6e-9147-3704-b2b4-0cb97a23db03",
                    "sense_definition": "A high place or structure that provides a wide view of the area below.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "viewpoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped at a scenic <w>overlook</w> to take pictures of the mountains.",
                            "target_lang_translations": {
                                "ru": "Мы остановились на живописной <w>смотровой площадке</w>, чтобы сфотографировать горы."
                            }
                        },
                        {
                            "text": "The hiking trail leads to a beautiful <w>overlook</w> where you can see the entire city.",
                            "target_lang_translations": {
                                "ru": "Тропа ведет к красивому <w>панорамному пункту</w>, откуда виден весь город."
                            }
                        }
                    ],
                    "synonyms": [
                        "viewpoint",
                        "vantage point",
                        "vista"
                    ],
                    "common_phrases": [
                        "scenic overlook",
                        "mountain overlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое место или сооружение, с которого открывается широкий вид на окрестности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотровая площадка",
                                "target_lang_sense_clarification": "место для обзора"
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "панорама"
                            },
                            {
                                "target_lang_word": "обзор",
                                "target_lang_sense_clarification": "возможность видеть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}