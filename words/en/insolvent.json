{
    "word_family": [
        "insolvency",
        "solvent",
        "solvency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8967b8bd-da2d-3f17-b817-2a11e51a8ca3",
                    "sense_definition": "Unable to pay debts or financial obligations as they fall due.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_incapacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company became <w>insolvent</w> after losing its largest corporate client."
                        },
                        {
                            "text": "Without emergency funding, the airline could be declared <w>insolvent</w> within days."
                        }
                    ],
                    "synonyms": [
                        "bankrupt",
                        "ruined"
                    ],
                    "antonyms": [
                        "solvent"
                    ],
                    "common_phrases": [
                        "become insolvent",
                        "declared insolvent"
                    ]
                },
                {
                    "sense_id": "5939ee60-cf01-3469-81de-0a3e78e10b7d",
                    "sense_definition": "Having liabilities that exceed the total value of all assets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_incapacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auditor warned that the firm was technically <w>insolvent</w> on a balance sheet basis."
                        },
                        {
                            "text": "Falling property values left many investors functionally <w>insolvent</w>."
                        }
                    ],
                    "antonyms": [
                        "solvent"
                    ],
                    "common_phrases": [
                        "technically insolvent"
                    ]
                },
                {
                    "sense_id": "9e3580da-43e5-3ddf-ba4c-2b583f399b8a",
                    "sense_definition": "Pertaining to an estate or fund that is insufficient to pay off its debts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_incapacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Administrators were appointed to manage the affairs of the <w>insolvent</w> estate."
                        },
                        {
                            "text": "Creditors are unlikely to recover their full losses from an <w>insolvent</w> fund."
                        }
                    ],
                    "common_phrases": [
                        "insolvent estate"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06604e16-80af-33e1-a9ad-febc72c5117d",
                    "sense_definition": "A person or entity that is unable to pay their debts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new legal code provides more protections for registered <w>insolvents</w>."
                        },
                        {
                            "text": "Assets belonging to the <w>insolvent</w> were seized to settle outstanding claims."
                        }
                    ],
                    "synonyms": [
                        "bankrupt",
                        "debtor"
                    ]
                }
            ]
        }
    ]
