                "senses": [
                    {
                        "sense_id": "db763993-b74f-3f9e-80e3-1989d89e96c2",
                        "entry_id": "c60967a5-5d4c-3467-b1b4-2c3f4dec5567",
                        "glosses": [
                            "Enfant parvenu à la période de la vie qui précède immédiatement l’adolescence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65aae143-274b-4a5e-9688-e4f442945b6c",
                                "sense_id": "db763993-b74f-3f9e-80e3-1989d89e96c2",
                                "text": "Le préadolescent comprend de plus en plus les notions abstraites, dont celle selon laquelle la mort est définitive, ne peut arriver sans raison et est inévitable."
                            },
                            {
                                "example_id": "19a04746-bc83-4f2d-8afe-20e07baaaa4d",
                                "sense_id": "db763993-b74f-3f9e-80e3-1989d89e96c2",
                                "text": "Les préadolescents, eux, renâclent à la perspective de vivre au quotidien avec des vieux bien gentils mais incompréhensibles et « incomprenants ». Le sirop de groseille de grand-mère ne vaut pas le soda au cola; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
