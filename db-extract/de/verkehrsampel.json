                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca72fd6-7747-444f-8c10-14e7aba215e6",
                                "sense_id": "f46f3d14-27af-3538-a767-912a1ca6ac78",
                                "text": "„Die Verkehrsampel brennt rot, sie müssen einen Augenblick warten.“"
                            },
                            {
                                "example_id": "3d2450f7-2163-4f6e-8b14-d72f46ac5c5d",
                                "sense_id": "f46f3d14-27af-3538-a767-912a1ca6ac78",
                                "text": "„Wir bogen in eine Straße ein, die von roten, gelben und grünen Verkehrsampeln durchfunkelt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
