                                    {
                                        "sense_id": "fcc30b28-b907-3381-904e-e1d2ce35ed5b",
                                        "entry_id": "26bdb849-c5cc-3311-8c65-62bc4df386bd",
                                        "glosses": [
                                            "Having to do with hermeneutics; that explains, interprets, illustrates or elucidates texts, especially holy texts."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hermeneutic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a453f4ec-ddb8-332e-978b-0ca5aa2ab5bb",
                                        "entry_id": "1a580c63-8d4f-3adf-806e-7f0a36974b64",
                                        "glosses": [
                                            "A particular theory of hermeneutics; a particular method of interpretation of text, especially holy texts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059daf95-826e-49e6-a4da-8da835c553dc",
                                                "sense_id": "a453f4ec-ddb8-332e-978b-0ca5aa2ab5bb",
                                                "text": "The hermeneutics of suspicion needs to be balanced by a hermeneutic that is grounded in the recognition that written texts represent valid expressions of their author's intent, and that principles may be established that would guide the reader to that intent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
