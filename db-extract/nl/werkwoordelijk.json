                                    },
                                    {
                                        "sense_id": "3fc644bf-470f-3a2d-8064-7c5d6a417e5a",
                                        "entry_id": "38af6c4b-f501-34ae-95fe-381d7099cbbd",
                                        "glosses": [
                                            "Capable of speech."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15ca26a-28ac-4385-897a-7f665a1e15c1",
                                                "sense_id": "3fc644bf-470f-3a2d-8064-7c5d6a417e5a",
                                                "text": "How do these language problems affect the behaviour of verbal children?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38213b4a-ee2f-3fef-81b6-003b1632dd25",
                                        "entry_id": "38af6c4b-f501-34ae-95fe-381d7099cbbd",
                                        "glosses": [
                                            "Word for word."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c72e36-3126-482e-a02c-0acabea1cf67",
                                                "sense_id": "38213b4a-ee2f-3fef-81b6-003b1632dd25",
                                                "text": "a verbal translation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df6bbe66-9b06-3e34-82dc-fc405a1c3672",
                                        "entry_id": "38af6c4b-f501-34ae-95fe-381d7099cbbd",
                                        "glosses": [
                                            "Abounding with words; verbose."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3429bb3-c79f-45a0-85b2-e8041e2d536b",
                                                "sense_id": "df6bbe66-9b06-3e34-82dc-fc405a1c3672",
                                                "text": "You put me to forget a lady’s manners\nBy being so verbal; and learn now, for all,\nThat I, which know my heart, do here pronounce\nBy th’ very truth of it, I care not for you"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verbal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec04b60b-724c-3dd5-af89-47c43685f1a2",
                                        "entry_id": "e3603791-691b-36af-b4e7-e8f09c65872d",
                                        "glosses": [
                                            "A verb form which does not function as a predicate, or a word derived from a verb. In English, infinitives, participles and gerunds are verbals."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f992a477-a5c0-3c0a-afce-136cb3816e92",
                                        "entry_id": "e3603791-691b-36af-b4e7-e8f09c65872d",
                                        "glosses": [
                                            "A spoken confession given to police."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ffd470e-ea9d-4161-a412-ea37fbb7088f",
                                                "sense_id": "f992a477-a5c0-3c0a-afce-136cb3816e92",
                                                "text": "They were convicted on the evidence of an agent provocateur named Richard Seary, backed up by police verbals from three police officers who gave evidence of six verbals in which the three accused were supposed to have admitted their guilt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b9dbc4a-adf4-3eec-bc5c-0084d4f76a58",
                                        "entry_id": "e3603791-691b-36af-b4e7-e8f09c65872d",
                                        "glosses": [
                                            "Talk; speech, especially banter or scolding."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96166736-2d04-4926-85d1-ec22cecee90b",
                                                "sense_id": "6b9dbc4a-adf4-3eec-bc5c-0084d4f76a58",
                                                "text": "We'd give him a bit of verbal, out would come the bouncers, chucking their weight about, and it would all end in a right tear-up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verbal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
                                        "entry_id": "21eee8e6-df2e-3580-9332-fa43129edc78",
                                        "glosses": [
                                            "To allege (usually falsely) that someone has made an oral admission."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a30e42-86d6-462d-bf62-47d597ed6776",
                                                "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
                                                "text": "The problem of 'verballing' is unlikely to disappear, whatever the legal status of the person detained."
                                            },
                                            {
                                                "example_id": "bc8ba54f-f7c2-4d62-a931-435cd9711d08",
                                                "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
                                                "text": "Condren had always claimed that he was assaulted and verballed by police over the murder he had supposedly confessed to committing. Specifically, Condren claimed that he had been subjected to assault and intimidation prior to making a police record of interview, that the record of interview was largely fabricated by police, and that the oral admissions which police claimed he had made prior to the record of interview were also fabricated."
                                            },
                                            {
                                                "example_id": "16340901-8d3a-4578-91bb-cef163926c88",
                                                "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
                                                "text": "\"Moreover, given the risk of verballing, it is by no means apparent that it is in the interests of justice that the prosecution have the benefit of admissions that are made on occasions when recordings are impracticable.\""
                                            },
                                            {
                                                "example_id": "0c14cf99-a5fb-4689-8a70-7a3e13590fa9",
                                                "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
                                                "text": "Kelvin Condren maintained his innocence, claiming that he was 'verballed' in his police record of interview (so they were someone else's words not his)."
                                            },
                                            {
                                                "example_id": "c4212731-b460-4cce-96a4-7102ab8448d4",
                                                "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
                                                "text": "As the necessary ingredient of an intention to commit an offence usually came from the mouth of the suspect himself, it was not difficult to make an arrest if the suspect was 'verballed'. A 'verbal' consisted of an unequivocal oral admission of guilt made to a police officer on the street, which, later on, the police officer transcribed into his notebook. It is called a 'verbal' if the suspect later denies making the incriminating remark."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
