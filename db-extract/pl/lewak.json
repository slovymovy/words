                ],
                "translations": [
                    {
                        "translation_id": "55375749-9119-49c3-9f73-70f703bc5182",
                        "source_entry_id": "45d3bbfb-7d70-341d-b49f-56d602c1cb09",
                        "source_sense_id": "72a12515-1ca1-36f8-8ea5-214fc0b290a4",
                        "target_lang_word": "leftist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leftist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7cc90d-0a60-3bd7-9114-4a3cf9f15b4b",
                                        "entry_id": "9f88bf77-b1f6-30f2-b3cb-cb789ba0c09b",
                                        "glosses": [
                                            "A person who holds views associated with the political left."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61146a7-d3a9-4f1e-83d5-0ff666664ab6",
                                                "sense_id": "4e7cc90d-0a60-3bd7-9114-4a3cf9f15b4b",
                                                "text": "The first major clash between the two groups occurred in Shih-ho-tzu on January 26, 1967, with the leftists admitting they had suffered a bloody defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b89b1164-2c5c-3485-acac-9f3557c70850",
                                        "entry_id": "9f88bf77-b1f6-30f2-b3cb-cb789ba0c09b",
                                        "glosses": [
                                            "Someone who holds socialist or communist-leaning economic views, usually alongside progressive social views; an anticapitalist."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "leftist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "626cb5e4-f3b8-396d-a1d5-cd0a4de217a8",
                                        "entry_id": "29293ffc-41bd-3623-950d-81e88d457118",
                                        "glosses": [
                                            "Of or pertaining to the political left."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d19df1-02aa-443c-bed0-5b7554196dfa",
                                                "sense_id": "626cb5e4-f3b8-396d-a1d5-cd0a4de217a8",
                                                "text": "In law school, when we students thought the outcome of a case was determined by a rule we had studied, leftist professors admonished us, “Tools not rules!” In other words, rules control nothing; they’re merely tools you manipulate for the results you want. The fancy word for this kind of amorality is “instrumentalism,” and it subverts the rule of law."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d025b86-7f2b-488a-adbb-4ebaf58a72b3",
                        "source_entry_id": "45d3bbfb-7d70-341d-b49f-56d602c1cb09",
                        "source_sense_id": "72a12515-1ca1-36f8-8ea5-214fc0b290a4",
                        "target_lang_word": "leftard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leftard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "614a08d6-e481-3e6e-a0e0-d96dd33faa93",
                                        "entry_id": "fe809c29-1966-3b9a-8e03-de81b2480db7",
                                        "glosses": [
                                            "A person of left-wing political views."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d7e0e24-fa5c-4489-9e06-381ba6602040",
                        "source_entry_id": "45d3bbfb-7d70-341d-b49f-56d602c1cb09",
                        "source_sense_id": "72a12515-1ca1-36f8-8ea5-214fc0b290a4",
                        "target_lang_word": "moonbat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moonbat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba04b6ce-dd84-346c-a026-841b9663c9fd",
                                        "entry_id": "bf1f7a30-0097-3807-a127-5f5a40d06855",
                                        "glosses": [
                                            "A liberal (someone with a left-wing ideology)."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cf6dde-91ed-4faf-8061-b0eb45c9ab08",
                                                "sense_id": "ba04b6ce-dd84-346c-a026-841b9663c9fd",
                                                "text": "So, what do moonbat professors do when they're not attacking military recruiters, the Bush administration, cameramen, and College Republicans?"
                                            },
                                            {
                                                "example_id": "e6de441e-ed66-460c-9347-d2edc79fffe1",
                                                "sense_id": "ba04b6ce-dd84-346c-a026-841b9663c9fd",
                                                "text": "As nervous Bush supporters watched the president's approval rating slide, they unleashed their wrath on Sheehan, labeling the mourning mom a “crazy,” “anti-Semite,” “left-wing moonbat,” “crackpot” whose behavior bordered on “treasonous” and who was nothing more than a “hysterical noncombatant.”"
                                            },
                                            {
                                                "example_id": "d327ede0-b726-44fb-aca4-f5e739afda72",
                                                "sense_id": "ba04b6ce-dd84-346c-a026-841b9663c9fd",
                                                "text": "Your job is to separate the media from the moonbats before some industrious cub reporter starts looking into our land deal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moonbat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93f7ec48-1729-3995-9fcc-9b52f1873761",
                                        "entry_id": "bda8dd79-fd9f-3e80-8371-d929b1a6d290",
                                        "glosses": [
                                            "(of ideas) Absurd or obviously untruthful."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48f5d19-6db5-4622-84f7-8c1dd6d3c3ea",
                                                "sense_id": "93f7ec48-1729-3995-9fcc-9b52f1873761",
                                                "text": "20204: The Bulwark\nTrump, who said last month at the Republican National Convention that he would never again retell the story of the attempt on his life “because it’s too painful to tell,” told that story with relish. He expounded at length on his usual moonbat fables about how countries around the world are emptying their prisons and mental institutions to send their convicts and lunatics to the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "973509bc-d37f-4c41-8224-32124bf6b86f",
                        "source_entry_id": "45d3bbfb-7d70-341d-b49f-56d602c1cb09",
                        "source_sense_id": "72a12515-1ca1-36f8-8ea5-214fc0b290a4",
                        "target_lang_word": "левак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "левак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8a784d7d-64ba-3f76-a120-a258f7d53848",
                                        "entry_id": "fb571efd-6dee-3539-a662-d82aa9560443",
                                        "glosses": [
                                            "полит. жарг. приверженец крайне левых взглядов, сторонник леворадикализма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e34114-d25a-43cf-a323-efbb74cedda2",
                                                "sense_id": "8a784d7d-64ba-3f76-a120-a258f7d53848",
                                                "text": "Здесь большая победа передовой педагогической мысли над леваками-педологами, которые с тупым усердием изгоняли наш мудрый и поэтичный фольклор из системы воспитания советских детей. ❬…❭ С великим удовольствием я вспоминаю, как яростно встретили леваки-педагоги мои игровые стишки о лягухах, впервые увидавших черепаху .."
                                            },
                                            {
                                                "example_id": "44049312-cb1f-4e6d-9010-8ef23dcffbf2",
                                                "sense_id": "8a784d7d-64ba-3f76-a120-a258f7d53848",
                                                "text": "Много леваков, которые ругают всё и вся, не предлагая никакой положительной программы."
                                            },
                                            {
                                                "example_id": "94c70092-f7a0-49d7-91d7-dd919de2dcd4",
                                                "sense_id": "8a784d7d-64ba-3f76-a120-a258f7d53848",
                                                "text": "Заинтересовалась Павлом Филоновым. Ещё один левак."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d9a946-7090-3ceb-aca7-0e1c78b8c77e",
                                        "entry_id": "fb571efd-6dee-3539-a662-d82aa9560443",
                                        "glosses": [
                                            "истор., полит. и разг., пренебр. или уничиж. оппортунист, прикрывающий революционными (левыми) фразами мелкобуржуазную сущность своих взглядов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d036f9-8ecb-4766-ba7c-a32ae5c84fa3",
                                                "sense_id": "49d9a946-7090-3ceb-aca7-0e1c78b8c77e",
                                                "text": "Таковы были не только троцкисты, но и все эти правые, леваки, зиновьевцы, бухаринцы и другие антиленинские группки."
                                            }
