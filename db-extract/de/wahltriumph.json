                        "sense_id": "3122f68c-f04c-3726-bf4e-8079517db770",
                        "entry_id": "ba03cc2c-2169-3393-acda-ab1ad5d0581b",
                        "glosses": [
                            "besonders großer Erfolg bei einer Wahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d577bb-0c37-4858-9e68-217469fd56a4",
                                "sense_id": "3122f68c-f04c-3726-bf4e-8079517db770",
                                "text": "„Dass Viktor Orbán vor seinem 55. Geburtstag (am 31. Mai) die Wahltriumphe von 2010 und 2014 wiederholen und eine neuerliche Zweidrittelmehrheit erreichen würde, hatte kaum jemand erwartet.“"
                            },
                            {
                                "example_id": "d0ed41ad-6e55-4548-9523-00c1faf49564",
                                "sense_id": "3122f68c-f04c-3726-bf4e-8079517db770",
                                "text": "„So hatte sich das Netanjahu sicher nicht vorgestellt, als er noch den Wahltriumph genoss.“"
                            },
                            {
                                "example_id": "9abf0bf8-30d0-47e1-a5cd-1b2d0cabf49b",
                                "sense_id": "3122f68c-f04c-3726-bf4e-8079517db770",
                                "text": "„Nach seinem Wahltriumph muss die Europäische Union mehr denn je mit dem ungarischen Ministerpräsidenten rechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
