                        "glosses": [
                            "gebouw in Den Haag waarin het Permanent Hof van Arbitrage en het Internationaal Gerechtshof van de Verenigde Naties gevestigd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649067a5-656b-4d78-957f-26c3a5961c11",
                                "sense_id": "410893a4-28cf-35f7-a90d-15b530fe66e9",
                                "text": "Aung San Suu Kyi verdedigde de Tatmadaw eind vorig jaar nog voor een andere Haagse rechtbank, het Internationaal Gerechtshof in het Vredespaleis."
                            },
                            {
                                "example_id": "5868814e-0379-45e7-8e27-addf8b02cce6",
                                "sense_id": "410893a4-28cf-35f7-a90d-15b530fe66e9",
                                "text": "Twee Italiaanse mariniers die beschuldigd worden van het doodschieten van twee vissers voor de kust van India in 2012, hebben het internationaal recht geschonden. India heeft daarom recht op compensatie van Italië, maar heeft niet het recht om de mariniers te vervolgen. Dat heeft het Permanente Hof van Arbitrage, dat is gevestigd in het Vredespaleis in Den Haag, donderdag bepaald na een jarenlange diplomatieke rel tussen de twee landen."
                            },
                            {
                                "example_id": "66774f98-ad08-4da3-9822-a84fe4b8236f",
                                "sense_id": "410893a4-28cf-35f7-a90d-15b530fe66e9",
                                "text": "In Den Haag staat al ruim een eeuw het Vredespaleis dat werd betaald door de Amerikaanse staalmagnaat Andrew Carnegie en nog steeds wordt beheerd door de stichting die zijn naam draagt."
                            }
                        ]
                    }
