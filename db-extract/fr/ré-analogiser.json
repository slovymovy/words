                ],
                "senses": [
                    {
                        "sense_id": "d20df562-45f7-3082-a363-bdd23c796950",
                        "entry_id": "303f2d74-1adb-3a70-8e35-7fc3d705e8f0",
                        "glosses": [
                            "Redonner un caractère analogique (au sens opposé à celui de numérique) à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67a7e07-80cd-400d-be71-b0dfa7d4f403",
                                "sense_id": "d20df562-45f7-3082-a363-bdd23c796950",
                                "text": "Alors, fabriquer des DVD audio « top » est intéressant en soi, de toutes façons, ça ne revient pas à « ré-analogiser » ce qu’on enregistre, mais la piste du support « qui tourne pas » me paraît être de plus d’avenir."
                            },
                            {
                                "example_id": "906ffdf2-ec5a-4c45-93ca-956ec394ffee",
                                "sense_id": "d20df562-45f7-3082-a363-bdd23c796950",
                                "text": "Ma question est de savoir si j’arrive à « ré-analogiser » un fichier…"
                            },
                            {
                                "example_id": "b4587775-7743-4a57-b658-d7e9d44e5fb9",
                                "sense_id": "d20df562-45f7-3082-a363-bdd23c796950",
                                "text": "Je récapitule : le signal analogique est donc numérisé pour être ensuite « ré-analogisé » ?"
                            }
                        ]
                    }
                ],
