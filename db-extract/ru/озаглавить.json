                    }
                ],
                "senses": [
                    {
                        "sense_id": "45295bbe-646b-3cea-a73b-764608bd3f37",
                        "entry_id": "a5e3b2c1-0dd3-3c15-9dc4-387cd12ec391",
                        "glosses": [
                            "дать название произведению, тексту или его части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea52c47c-c384-4fbb-98da-3688266bbc5c",
                                "sense_id": "45295bbe-646b-3cea-a73b-764608bd3f37",
                                "text": "Он так и озаглавил свою записку: \"Размышления о происшествиях…\"."
                            },
                            {
                                "example_id": "c8bfbd0e-bee5-4645-95ee-5598882c91c4",
                                "sense_id": "45295bbe-646b-3cea-a73b-764608bd3f37",
                                "text": "Но в разделе мы находим только одну статью, и становится понятным, что нужно было его как-то озаглавить, хотя бы по аналогии с предыдущим."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83246240-63af-4af0-8ab9-2c1937da366d",
                        "source_entry_id": "a5e3b2c1-0dd3-3c15-9dc4-387cd12ec391",
                        "source_sense_id": "45295bbe-646b-3cea-a73b-764608bd3f37",
                        "target_lang_word": "headline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "The heading or title of a magazine or newspaper article."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083c33e6-8671-48f3-aa40-83d3e4e4f8a8",
                                                "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                                "text": "The headline on today's newspaper reads \"John Doe Wins Wood-Splitting Competition.\""
                                            },
                                            {
                                                "example_id": "999c7082-d6b1-4b95-9f22-01f50dc6fc5c",
                                                "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                                "text": "Say that you'll never, never, never, never need it\nOne headline, why believe it?\nEverybody wants to rule the world"
                                            },
                                            {
                                                "example_id": "c4678da1-5b47-479f-937f-0963e0dfc7d7",
                                                "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins. For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73776773-4c2f-3b9e-b38c-69882a921e4e",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "The line at the top of a page containing the folio or number of the page."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86c7cf2b-7545-3e93-93dd-0bcdfdc23efe",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "The top-billed attraction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "749ae4e9-9f04-37cd-9d6e-781cc9c2d0b6",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "A headrope."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "headline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcecb5ff-6904-3ad8-a38f-5ca3e646902c",
                                        "entry_id": "cbad8c13-b14c-3676-a308-0ea35b869223",
                                        "glosses": [
                                            "To give a headline to a page or section of a text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56127759-10bb-4caa-bddd-fb17e62e874a",
                                                "sense_id": "bcecb5ff-6904-3ad8-a38f-5ca3e646902c",
                                                "text": "Once again I take typewriter in hand to express my opinion on two very different issues. Good luck in deciding what to headline this letter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518af7e0-b892-3aec-9093-f4b969a2253e",
                                        "entry_id": "cbad8c13-b14c-3676-a308-0ea35b869223",
                                        "glosses": [
                                            "To present as the main attraction; to have top billing, to be the main attraction."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d572e1be-d5b1-4c90-a7d5-27716d368942",
                        "source_entry_id": "a5e3b2c1-0dd3-3c15-9dc4-387cd12ec391",
                        "source_sense_id": "45295bbe-646b-3cea-a73b-764608bd3f37",
                        "target_lang_word": "intituler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intituler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eec67c08-8568-3d22-8657-fd92e817ffcc",
                                        "entry_id": "dd1e5b27-4ca4-39a1-ad47-ffd00bb96384",
                                        "glosses": [
                                            "Désigner par un titre le sujet d’un livre, d’une comédie, de quelque ouvrage de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9016d5-2ffa-40dd-b5f2-c85ae8eb8b7f",
                                                "sense_id": "eec67c08-8568-3d22-8657-fd92e817ffcc",
                                                "text": "Il a intitulé sa pièce… Il a donné au public un ouvrage qu’il a intitulé ainsi…"
                                            },
                                            {
                                                "example_id": "8076b086-85b0-479b-8c23-9bcde0fb560c",
                                                "sense_id": "eec67c08-8568-3d22-8657-fd92e817ffcc",
                                                "text": "L’épisode de ce soir s’intitule : …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a09fb8-0c88-3296-ac2b-c687bc60bb51",
                                        "entry_id": "dd1e5b27-4ca4-39a1-ad47-ffd00bb96384",
                                        "glosses": [
                                            "Mettre un titre en tête d’une loi, d’une ordonnance, d’un jugement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2356ad-43c5-4c80-a438-f2010f500b75",
                                                "sense_id": "15a09fb8-0c88-3296-ac2b-c687bc60bb51",
                                                "text": "Les expéditions des jugements doivent être intitulées comme les lois, doivent être intitulées au nom du peuple français."
                                            },
                                            {
                                                "example_id": "6d9beab2-2b17-498e-889b-6e467161d4d7",
                                                "sense_id": "15a09fb8-0c88-3296-ac2b-c687bc60bb51",
                                                "text": "Intituler un acte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23712529-f7ce-31cb-bec7-b44dd4d24666",
                                        "entry_id": "dd1e5b27-4ca4-39a1-ad47-ffd00bb96384",
                                        "glosses": [
                                            "Se donner abusivement un titre."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8dc44e-0ac8-4289-9e06-0f16b2855651",
                                                "sense_id": "23712529-f7ce-31cb-bec7-b44dd4d24666",
                                                "text": "Près du commissariat […] un magasin de nouveauté s'intitulait, en lettres énormes également : A la Belle Polonaise."
                                            },
                                            {
                                                "example_id": "d1a79ed3-7a81-4e82-a497-8ad581d87b00",
                                                "sense_id": "23712529-f7ce-31cb-bec7-b44dd4d24666",
                                                "text": "Il s’intitule comte de…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8c26568-8a90-4065-be46-95a56566a0f5",
                        "source_entry_id": "a5e3b2c1-0dd3-3c15-9dc4-387cd12ec391",
                        "source_sense_id": "45295bbe-646b-3cea-a73b-764608bd3f37",
                        "target_lang_word": "nommer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nommer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a05779a-e6c6-3541-b201-fec7468b4fe3",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Attribuer, imposer un nom à une personne, une chose ou une collectivité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e82eaa4-36be-4fb6-9a59-1f65a01e580f",
                                                "sense_id": "8a05779a-e6c6-3541-b201-fec7468b4fe3",
                                                "text": "Il fut le premier qui découvrit cette île et il la nomma de son nom."
                                            },
                                            {
                                                "example_id": "b2925e21-cedb-47d5-9335-3251177d58e4",
                                                "sense_id": "8a05779a-e6c6-3541-b201-fec7468b4fe3",
                                                "text": "Nommer une maladie est la plus sûre façon de la faire apparaître."
                                            },
                                            {
                                                "example_id": "9ed7e62a-7071-4fb2-8ee5-9609ab0b24f1",
                                                "sense_id": "8a05779a-e6c6-3541-b201-fec7468b4fe3",
                                                "text": "Christophe Colomb, on le sait, lorsqu'il aborda en Amérique, crut avoir atteint les Indes par une nouvelle route maritime et nomma en conséquence « Indiens » les premiers habitants qu'il rencontra."
                                            },
                                            {
                                                "example_id": "e9b05190-910b-468c-a0fa-7e705cfac24e",
                                                "sense_id": "8a05779a-e6c6-3541-b201-fec7468b4fe3",
                                                "text": "« Que ces choses ne soient même pas nommées parmi nous », fit une voix ironique.\nJoseph recula d’un pas et s’assit sur son lit, le cœur battant. De tout ce qu’il venait d’entendre et ne comprenait qu’à moitié, ce verset biblique l’atteignait seul, flamboyait dans sa tête. Il y avait en effet des mots qu’on ne prononçait pas, comme si l’on eût craint d’attirer la colère de Dieu."
                                            },
                                            {
                                                "example_id": "2e87f74b-4ac2-4f6e-87e0-42ae6f2637bf",
                                                "sense_id": "8a05779a-e6c6-3541-b201-fec7468b4fe3",
                                                "text": "On peut généralement reconnaître qu'il y a identité collective lorsque les membres d'un groupe humain se nomment, qu'ils s'attribuent un nom qui les désigne comme appartenant à ce groupe. Ce pouvoir de nommer n'est jamais utilisé en vain. C'est bien parce que le besoin est là, parce que le concept existe, qu'il appelle une dénomination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb53ec21-a7f2-3a08-a615-7913d95a5b3f",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Qualifier, décerner une épithète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f81c9a-5354-41ab-ab58-501380192b1a",
                                                "sense_id": "eb53ec21-a7f2-3a08-a615-7913d95a5b3f",
                                                "text": "Louis XII a été nommé le Père du peuple."
                                            },
                                            {
                                                "example_id": "78fa47a7-ccbd-4273-ab78-4c27768adcca",
                                                "sense_id": "eb53ec21-a7f2-3a08-a615-7913d95a5b3f",
                                                "text": "Nommer quelqu’un son protecteur, son maître, son bienfaiteur, le reconnaître comme son protecteur, son maître, son bienfaiteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8984c366-f62d-3deb-9f5f-4714448c7a1c",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Dire le nom d’une personne, d’une chose ; dire comment une personne, une chose s’appelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7b4cb47-2b00-4051-b27b-510ca16f67d2",
                                                "sense_id": "8984c366-f62d-3deb-9f5f-4714448c7a1c",
                                                "text": "Si vous voulez, je vous nommerai mon auteur."
                                            },
                                            {
                                                "example_id": "46d6eeff-8ea0-4027-869a-2c7db2a8588b",
                                                "sense_id": "8984c366-f62d-3deb-9f5f-4714448c7a1c",
                                                "text": "Je vous nommerai plusieurs personnes."
                                            },
                                            {
                                                "example_id": "e5549260-ef3d-429a-93bc-062d431ca05d",
                                                "sense_id": "8984c366-f62d-3deb-9f5f-4714448c7a1c",
                                                "text": "Il y a des choses qu’on ne saurait nommer par leur nom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f846b01-d79d-317f-a03c-d7e7b0f3bbc1",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Désigner, énumérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b6c21e-5999-4d83-8668-22596bc57089",
                                                "sense_id": "4f846b01-d79d-317f-a03c-d7e7b0f3bbc1",
                                                "text": "Dans son intervention, il a nommé les personnes responsables des fautes."
                                            },
                                            {
                                                "example_id": "8ce54a9b-ef77-4fb3-a235-c0a92c8a0ea7",
                                                "sense_id": "4f846b01-d79d-317f-a03c-d7e7b0f3bbc1",
                                                "text": "Nommer ses complices, les déclarer, les faire connaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf533c7-c6dd-3bf3-8c4e-66ae7b448d60",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Désigner, choisir ou instituer pour une fonction ou un poste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91c5d50-6274-432f-955c-b051e14c97f4",
                                                "sense_id": "2bf533c7-c6dd-3bf3-8c4e-66ae7b448d60",
                                                "text": "A son retour d'Espagne, le général Beurnonville épousa Mˡˡᵉ de Durfort. Le 5 février 1805, il fut nommé sénateur, et bientôt titulaire de la sénatorerie de Limoges."
                                            },
                                            {
                                                "example_id": "48491294-b33a-4fd4-9b5e-add03bb1dc18",
                                                "sense_id": "2bf533c7-c6dd-3bf3-8c4e-66ae7b448d60",
                                                "text": "On a nommé des experts, des arbitres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22e09faf-4ec2-381d-8410-0f0b3daf283c",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Élire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f7a1610-82e7-4827-a632-71aaf33a4987",
                                                "sense_id": "22e09faf-4ec2-381d-8410-0f0b3daf283c",
                                                "text": "Les magistrats de cette république étaient nommés tous les ans par le peuple."
                                            },
                                            {
                                                "example_id": "04c36322-7fc8-46b5-9c5b-8a298efa572b",
                                                "sense_id": "22e09faf-4ec2-381d-8410-0f0b3daf283c",
                                                "text": "À Rome, on nomma des décemvirs pour composer les lois, et des questeurs pour faire juger les crimes publics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11d6058-0de4-3724-8ed6-cd255b4b30a8",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Appeler, avoir pour nom."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19afdb8-826d-4e0e-841a-0792e08973a4",
                                                "sense_id": "e11d6058-0de4-3724-8ed6-cd255b4b30a8",
                                                "text": "Je suis né dans un village près de Reims et je me nomme Cupidonnet. Dès mon enfance, j’aimais les jolies filles."
                                            },
                                            {
                                                "example_id": "dea3ca1e-6d81-4d10-b324-fbd3a227b508",
                                                "sense_id": "e11d6058-0de4-3724-8ed6-cd255b4b30a8",
                                                "text": "Je me nomme Marie."
                                            },
                                            {
                                                "example_id": "a5d5b297-48e4-4576-b9e5-a53a6a7cbe6c",
                                                "sense_id": "e11d6058-0de4-3724-8ed6-cd255b4b30a8",
                                                "text": "Comment se nomme celle place, cette rue ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eb3a79a-dc22-3096-b588-e078f5c13d3c",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Déclarer son nom."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f974fb4-51cc-492e-bc25-27abf51d0ee3",
                                                "sense_id": "1eb3a79a-dc22-3096-b588-e078f5c13d3c",
                                                "text": "Vous êtes obligé de vous nommer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b05d6bc-04ee-3131-b47d-cb5ca5462507",
                                        "entry_id": "626e3e2a-edb1-3262-92df-50973976753f",
                                        "glosses": [
                                            "Indiquer, mentionner."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "797dff06-d753-4f6f-b95a-aa5d7c90cdfe",
                                                "sense_id": "3b05d6bc-04ee-3131-b47d-cb5ca5462507",
                                                "text": "Je lui nomme que je ne suis plus capable de rejoindre ses parents depuis quelques semaines."
                                            },
                                            {
                                                "example_id": "e5526910-9e3a-4b10-9943-d6168ea3c2e0",
                                                "sense_id": "3b05d6bc-04ee-3131-b47d-cb5ca5462507",
                                                "text": "Elle nomme être excédée par ses comportements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
