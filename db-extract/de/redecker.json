                ],
                "senses": [
                    {
                        "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                        "entry_id": "41bc70ae-f06d-3481-ad85-9b903accb500",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff15c003-b47c-4263-a4c5-b51962b5c814",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Die Redeckers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "80b42eeb-ce5a-44ae-9720-a48218a97d8f",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Der Redecker trägt nie die Schals, die die Redecker ihm strickt."
                            },
                            {
                                "example_id": "ad626360-45fa-4c08-bf73-eb15d1447a25",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Redecker kommt, geht der Herr Redecker.“"
                            },
                            {
                                "example_id": "b35c78d4-e346-484e-bdb7-43d8f5fad89f",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Redecker kommt und geht."
                            },
                            {
                                "example_id": "2236ad8f-ac89-4f6e-93ab-525b98fcfa20",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Redeckers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b850d825-c06a-457e-bbf6-a3bb37b11bfb",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Frau Redecker ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "21393641-bd14-482d-8a86-6453d3639c15",
                                "sense_id": "1243a2b1-0f76-363b-a13a-c37baeebb26c",
                                "text": "Herr Redecker wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
