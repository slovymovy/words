                "senses": [
                    {
                        "sense_id": "14f22604-30f0-31c0-87b2-9860b0a63f1a",
                        "entry_id": "ca4ef92b-5de3-33d8-bcfc-d18fa51ce8f5",
                        "glosses": [
                            "That has gone out of use; disused, obsolete."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8f245128-6058-4880-9b30-4c83636a2d36",
                                "sense_id": "14f22604-30f0-31c0-87b2-9860b0a63f1a",
                                "text": "A Greeke inscription which I could not understand by reason of the antiquity of those exolete letters."
                            },
                            {
                                "example_id": "8286adcc-8b0e-47e5-a130-b06b9fbc27d5",
                                "sense_id": "14f22604-30f0-31c0-87b2-9860b0a63f1a",
                                "text": "In which [apothecaries’ shops] many…exolete, things out of date are to be had."
                            },
                            {
                                "example_id": "85d217d9-402b-499d-b3b8-3cba3594eb2a",
                                "sense_id": "14f22604-30f0-31c0-87b2-9860b0a63f1a",
                                "text": "Paganism is ridiculous, Judaism exolete."
                            },
                            {
                                "example_id": "7e225c07-418f-4290-b7e3-25745cc27a32",
                                "sense_id": "14f22604-30f0-31c0-87b2-9860b0a63f1a",
                                "text": "Plautus exolet phrases have been [exploded] from the eloquent orations of Cicero."
                            },
                            {
                                "example_id": "6eea5b41-001c-4da7-a5be-4c37dae7adec",
                                "sense_id": "14f22604-30f0-31c0-87b2-9860b0a63f1a",
                                "text": "I declaimed…against the use of exolete and interpolated repetitions of old fables."
                            }
                        ]
                    },
                    {
                        "sense_id": "65db987b-9357-3ea8-953a-eff8803d3dc6",
                        "entry_id": "ca4ef92b-5de3-33d8-bcfc-d18fa51ce8f5",
                        "glosses": [
                            "That has lost its virtue; effete, insipid."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a3d0b615-7dd5-4d00-8d6a-3f1a5b2399e0",
                                "sense_id": "65db987b-9357-3ea8-953a-eff8803d3dc6",
                                "text": "The vulgar Carpobalſame…being…faint, rancid, exolet."
                            },
                            {
                                "example_id": "c37255c0-5244-422c-abd2-37c3bf862a4f",
                                "sense_id": "65db987b-9357-3ea8-953a-eff8803d3dc6",
                                "text": "How exolete Blood falls asunder."
                            },
                            {
                                "example_id": "00714281-eba6-45ec-8197-e830132dcb97",
                                "sense_id": "65db987b-9357-3ea8-953a-eff8803d3dc6",
                                "text": "These Exoticks…are now and then deprived partly of their virtues and exolete."
                            }
                        ]
                    },
                    {
                        "sense_id": "3891ad6f-572f-38a2-812e-75334c877b0c",
                        "entry_id": "ca4ef92b-5de3-33d8-bcfc-d18fa51ce8f5",
                        "glosses": [
                            "(of flowers) Faded."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a3462dc6-af69-4cd9-a658-984bbd4b556e",
                                "sense_id": "3891ad6f-572f-38a2-812e-75334c877b0c",
                                "text": "Exolete, faded, or withered, as flowers."
                            }
                        ]
                    }
