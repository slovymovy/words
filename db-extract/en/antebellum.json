                    {
                        "translation_id": "3251d0ca-fa0c-46d8-91ea-8205b6b21aa6",
                        "source_entry_id": "55e32f14-108f-3c3f-8927-756a0e8e7a7e",
                        "source_sense_description": "of a period of time prior to a war",
                        "target_lang_word": "Vorkriegszeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorkriegszeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eecda08b-1006-3ac3-83a7-9cfb766aa8bc",
                                        "entry_id": "3c842d65-2667-34c9-8c99-76886f0a4475",
                                        "glosses": [
                                            "Zeit, unmittelbar vor dem Ausbruch eines Krieges (meistens ist damit die Zeit vor dem Ersten oder Zweiten Weltkrieg gemeint)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f2d770-3063-402a-a46e-d11b5ba296d5",
                                                "sense_id": "eecda08b-1006-3ac3-83a7-9cfb766aa8bc",
                                                "text": "„Solche familiären Rituale, die noch aus der Vorkriegszeit stammten, hatten jetzt eine lebenswichtige Bedeutung, ebenso bestimmte religiöse Traditionen.“"
                                            },
                                            {
                                                "example_id": "7d7bfb29-2ec4-4209-a5aa-682d24e9fa32",
                                                "sense_id": "eecda08b-1006-3ac3-83a7-9cfb766aa8bc",
                                                "text": "„Leider waren auch die Verkehrsverhältnisse an der Mosel in der Vorkriegszeit und überhaupt die ganze Einstellung der Bevölkerung garnicht dazu angetan, die Fremden länger und öfter an die Mosel zu fesseln.“"
                                            },
                                            {
                                                "example_id": "96aae1de-de9a-426d-9a6e-3a8199780a98",
                                                "sense_id": "eecda08b-1006-3ac3-83a7-9cfb766aa8bc",
                                                "text": "„Nachmittags allerdings, wenn viele Menschen neugierig aus den Vororten in die Innenstadt kamen, sei der Unterschied zum geschäftigen Leben der Vorkriegszeit geringer, befand der Chefredakteur.“"
                                            },
                                            {
                                                "example_id": "74c49aec-ea27-495b-9b3e-6533e80a7ef7",
                                                "sense_id": "eecda08b-1006-3ac3-83a7-9cfb766aa8bc",
                                                "text": "„Im geruhsam ländlichen Hinterpommern der Vorkriegszeit war der Winter die Zeit der verlockenden Düfte: vom Bratapfel in der Ofenröhre, von Würsten, Schinken, Gänsebrüsten, die in der Räucherkammer reiften, vom selbstgerösteten Kaffee, vom Pfefferkuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aff8eafd-c0eb-4ae9-ac10-c8f37d07dd4b",
