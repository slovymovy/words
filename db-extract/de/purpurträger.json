                "senses": [
                    {
                        "sense_id": "eb4f986e-7c86-3e38-ba48-cf01d963754f",
                        "entry_id": "2052d6cc-59ef-35cf-ad9b-cd4d6e1fa6d1",
                        "glosses": [
                            "hochrangiger, vom Papst ernannter Geistlicher; Kardinal"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "b77be68b-4852-4d80-8816-9b42ca3fe410",
                                "sense_id": "eb4f986e-7c86-3e38-ba48-cf01d963754f",
                                "text": "„Die mehr als 200 Purpurträger waren nach dem Rücktritt von Papst Benedikt XVI. aufgefordert worden, sich in dem neuen Synodensaal des Vatikans zu Sitzungen am Morgen und dann nochmals am Nachmittag zu versammeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cecc28a-1596-46a8-a681-63559be2fedd",
                        "source_entry_id": "2052d6cc-59ef-35cf-ad9b-cd4d6e1fa6d1",
                        "source_sense_id": "eb4f986e-7c86-3e38-ba48-cf01d963754f",
                        "source_sense_description": "Kardinal",
                        "target_lang_word": "cardinal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardinal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b03e6a6-9446-311d-bc9d-07a2880223fd",
                                        "entry_id": "9379adb0-3ca9-33f3-b9bc-9e5e05db7212",
                                        "glosses": [
                                            "Of fundamental importance; crucial, pivotal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d52840-ebb9-445f-b822-d35860eba98f",
                                                "sense_id": "0b03e6a6-9446-311d-bc9d-07a2880223fd",
                                                "text": "a cardinal rule"
                                            },
                                            {
                                                "example_id": "817026d2-0ec2-44fa-bc41-44870ad6211f",
                                                "sense_id": "0b03e6a6-9446-311d-bc9d-07a2880223fd",
                                                "text": "But cardinal sins, and hollow hearts, I fear ye."
                                            },
                                            {
                                                "example_id": "f413c496-327c-4089-873e-62459ecd3973",
                                                "sense_id": "0b03e6a6-9446-311d-bc9d-07a2880223fd",
                                                "text": "the cardinal intersections of the zodiack"
                                            },
                                            {
                                                "example_id": "b340ad92-485a-4da4-944b-ac4da8b5b178",
                                                "sense_id": "0b03e6a6-9446-311d-bc9d-07a2880223fd",
                                                "text": "Impudence is now a cardinal virtue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edee992e-0564-38a2-9b2f-2c6984c63afa",
                                        "entry_id": "9379adb0-3ca9-33f3-b9bc-9e5e05db7212",
                                        "glosses": [
                                            "Of or relating to the cardinal directions (north, south, east and west)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68e38e6-c488-4884-b2bc-935031f468f1",
                                                "sense_id": "edee992e-0564-38a2-9b2f-2c6984c63afa",
                                                "text": "a cardinal mark"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb857dd-2a9b-354f-80f6-766cd1a4ad95",
                                        "entry_id": "9379adb0-3ca9-33f3-b9bc-9e5e05db7212",
                                        "glosses": [
                                            "Describing a “natural” number used to indicate quantity (e.g., zero, one, two, three), as opposed to an ordinal number indicating relative position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44a7dd44-2502-311d-8d70-381ce4c23489",
                                        "entry_id": "9379adb0-3ca9-33f3-b9bc-9e5e05db7212",
                                        "glosses": [
                                            "Having a bright red color (from the color of a Catholic cardinal’s cassock)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13350f90-ec69-3c55-a605-99f98e638259",
                                        "entry_id": "9379adb0-3ca9-33f3-b9bc-9e5e05db7212",
                                        "glosses": [
                                            "Being one of the signs Aries, Cancer, Libra and Capricorn, associated with initiation, creation, and force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cardinal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77c768bb-37a7-30eb-8006-a292fc8e23da",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "One of the officials appointed by the pope in the Roman Catholic Church, ranking only below the pope, equal to the patriarchs, constituting the special college which elects the pope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22da481c-37cb-4dc8-875e-53342d47ba32",
                                                "sense_id": "77c768bb-37a7-30eb-8006-a292fc8e23da",
                                                "text": "His uncle, a Cardinal, engages a Spanish youth of Moorish descent called Diego, an expert singer and player on the virginal, to unlock the secrets of the heart,[…]and cure him by the spell of his music."
                                            },
                                            {
                                                "example_id": "78d43546-40f9-4375-a86a-3ecf88a5f542",
                                                "sense_id": "77c768bb-37a7-30eb-8006-a292fc8e23da",
                                                "text": "Francis riled conservative cardinals with his compassion for migrants and refugees, openness towards LGBTQ+ Catholics and demands for action on the climate crisis.\nAmong the frontrunners before the conclave began were Pietro Parolin, the Vatican’s secretary of state; Luis Antonio Tagle, a reformer from the Philippines; Péter Erdő, a traditionalist from Hungary; Robert Sarah, a cardinal from Guinea who criticised Francis’s papacy; and the moderate US cardinal Robert Prevost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aef91039-760c-3d0d-b9ab-cd2f782198df",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "Any of various species of New-World passerine songbird in the genus Cardinalis, or in the family Cardinalidae more generally, or of similar appearance and once considered to be related to the former; so called because of their red plumage. (See Wikipedia article for taxonomical information.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d942dbad-f4e5-4dd7-99a4-4b09d6acad68",
                                                "sense_id": "aef91039-760c-3d0d-b9ab-cd2f782198df",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32d7079-71c7-338c-96e2-8c45c298ceb4",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "A deep red color, somewhat less vivid than scarlet, the traditional colour of a Catholic cardinal's cassock. (same as cardinal red)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49622d54-2f6c-4d61-b453-64c60a64cf62",
                                                "sense_id": "b32d7079-71c7-338c-96e2-8c45c298ceb4",
                                                "text": "Dark navy-blue, cardinal, golden-brown, old blue, olive, slate-gray, and telegraph-blue are the favorite solid colors seen in heavy beaver cloths […]"
                                            },
                                            {
                                                "example_id": "1daf0d27-4e7b-4799-8ad6-e0c1f5d1c143",
                                                "sense_id": "b32d7079-71c7-338c-96e2-8c45c298ceb4",
                                                "text": "The cardinal red and silver grey colors were worn with great enthusiasm. In the spring-time, when the entire student body bought their new straw hats, the bands were of cardinal and grey ribbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8429465-6903-3b82-b0fa-87ffe369a5d8",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "Ellipsis of cardinal number, a number indicating quantity, or the size of a set (e.g., 0, 1, 2, 3). (See Cardinal_number.)"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cc32f1-f2c5-4e86-a7a1-cb3b1755d2cd",
                                                "sense_id": "d8429465-6903-3b82-b0fa-87ffe369a5d8",
                                                "text": "This cardinal number is the smallest of the infinite cardinal numbers; it is the one to which Cantor has appropriated the Hebrew aleph with the suffix 0, to distinguish it from larger infinite cardinals. Thus the name of the smallest of infinite cardinals is ₀א."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1919dd6-47de-3e21-90b0-4b659d10e58a",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "Ellipsis of cardinal numeral, a word used to represent a cardinal number."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbaeade1-90c9-4bee-bd3d-82e730c620b8",
                                                "sense_id": "b1919dd6-47de-3e21-90b0-4b659d10e58a",
                                                "text": "The commonest numerals in Latin, as in English, are the \"cardinals\" […] and the \"ordinals\" […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb09e1d-98ba-38e3-a645-d0f90f203d57",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "Ellipsis of cardinal flower (Lobelia cardinalis), a flowering plant."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "146f1d62-4c07-4bda-990c-cb20efe5ab06",
                                                "sense_id": "acb09e1d-98ba-38e3-a645-d0f90f203d57",
                                                "text": "The sweet-briar rose with perfume good, / And the violet grows in the Milton wood, / The cardinal red—a queen is she, / But the sweetest flower is Mary Lee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55986e66-c6c6-3771-922e-70ca0cc0450f",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "Ellipsis of cardinal tetra (Paracheirodon axelrodi), a freshwater fish."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "A woman's short cloak with a hood, originally made of scarlet cloth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39ced27-d2b7-4081-a16b-4c200ae8cea7",
                                                "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                                                "text": "[…]; and whilst she was looking over several pieces of each, she took an opportunity of concealing under her cardinal a piece of cotton, and several handkerchiefs, with which she went off undiscovered;[…]."
                                            },
                                            {
                                                "example_id": "c24ef1b8-c62d-4687-a08f-ea3e3db8b7b0",
                                                "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                                                "text": "She has valuables of mine; besides, my cardinal and veil are in her room."
                                            },
                                            {
                                                "example_id": "37942de8-648a-479c-b88e-dba7d98fa900",
                                                "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                                                "text": "Where's your cardinal! Make haste."
                                            },
                                            {
                                                "example_id": "3a1dc3bb-2e2a-44b8-a4b3-640fccf8f759",
                                                "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                                                "text": "I have made no objection to their wearing the cardinal, though it be a habit of popish etymology, and was, I am afraid, first invented to hide the sluttishness of French dishabille."
                                            },
                                            {
                                                "example_id": "1074bf6b-b65e-496b-b8e7-f4bf60a8d845",
                                                "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                                                "text": "Closely drawing her cardinal round her, she descended into the park, at whose extremity was the little chapel where she intended to make her offering. She soon arrived there, and found the aged priest in attendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6882d93-22db-3a96-b691-4a4a6b380033",
                                        "entry_id": "3316c15e-5da6-3c09-a487-809ee11dc3bf",
                                        "glosses": [
                                            "Mulled red wine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d19d398-a51e-44fe-b764-339b5af46fb8",
                                                "sense_id": "c6882d93-22db-3a96-b691-4a4a6b380033",
                                                "text": "He goes up, and finds the remains of the supper, Tankards full of egg-flip and cardinal, and a party playing at vingt-un."
                                            },
                                            {
                                                "example_id": "6a421262-ca2f-4d3a-8bf9-9e879bc6a927",
                                                "sense_id": "c6882d93-22db-3a96-b691-4a4a6b380033",
                                                "text": "A Recipe to make Cardinal, which I attribute to the German governess, raises a problem."
                                            },
                                            {
                                                "example_id": "8ca22162-5b14-4fc8-a0c4-13ec9a85e833",
                                                "sense_id": "c6882d93-22db-3a96-b691-4a4a6b380033",
                                                "text": "It was de Rosenberg's practice to separate young bloods from their inheritance, and to facilitate this he served them a vicious drink called 'cardinal', a mulled wine of which the ascertainable ingredients were a pineapple and several mixed vintages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
