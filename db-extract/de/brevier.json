                                        "glosses": [
                                            "A book containing prayers, hymns, and so on for everyday use at the canonical hours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e93a6e1-1366-4b07-ae04-55927cb4efbb",
