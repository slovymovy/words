                    {
                        "form_id": "d014b63f-7f20-458d-9f6d-1ebafc9870ba",
                        "entry_id": "75ba1a02-d85d-38de-a3b6-e270074946c9",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "sikhes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4648cdb-d5b4-336c-8e62-1bd0b124c188",
                        "entry_id": "75ba1a02-d85d-38de-a3b6-e270074946c9",
                        "glosses": [
                            "Relatif au sikhisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa8ee98-5690-4c7b-ac20-fd508eea1347",
                                "sense_id": "e4648cdb-d5b4-336c-8e62-1bd0b124c188",
                                "text": "Selon un membre de la communauté sikhe cité par le journal, un homme blanc d’une trentaine d’années serait l’auteur de la fusillade, survenue vers 10 heures."
                            },
                            {
                                "example_id": "1e9a0047-cc60-453c-8d05-82ac47e628e7",
                                "sense_id": "e4648cdb-d5b4-336c-8e62-1bd0b124c188",
                                "text": "Ancien premier ministre de la Colombie-Britannique, M. Dosanjh est de religion sikhe et a toujours dénoncé les extrémistes au sein de sa communauté."
                            },
                            {
                                "example_id": "24f8a701-926f-4bf8-b3ca-c449807b2787",
                                "sense_id": "e4648cdb-d5b4-336c-8e62-1bd0b124c188",
                                "text": "Et c’est ici, sur les flancs de l’Himalaya, au début de l’équinoxe de printemps, que la communauté sikh se rassemble à l’occasion du festival du Hola Mohalla, hommage rendu au dixième gourou et à son armée sainte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b99867-136e-4d73-b272-4c36712ca5f4",
                        "source_entry_id": "75ba1a02-d85d-38de-a3b6-e270074946c9",
                        "source_sense_id": "e4648cdb-d5b4-336c-8e62-1bd0b124c188",
                        "target_lang_word": "Sikh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sikh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf36688-cdbc-345b-a700-e9f9fb40be0c",
                                        "entry_id": "e7ff0b45-4e91-3d35-b4c6-57311833b12f",
                                        "glosses": [
                                            "An adherent of Sikhism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c4edca-713a-4788-b816-34291c21fc7d",
                                                "sense_id": "1bf36688-cdbc-345b-a700-e9f9fb40be0c",
                                                "text": "Last year, Canadian Prime Minister Justin Trudeau said he had credible information linking the Indian government to the assassination of Hardeep Singh Nijjar, an Indian-born Canadian national and Sikh dissident who was an outspoken supporter of Khalistan, a proposed autonomous homeland for Sikhs in northern India."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sikh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32816ad5-c23a-3db4-bd43-396d771d4f62",
                                        "entry_id": "cdf04a84-8781-3984-bd13-39b16dbc6523",
                                        "glosses": [
                                            "of, or relating to the Sikhs or to Sikhism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a25622-9212-4de0-a6c4-573dc0468b2f",
                                                "sense_id": "32816ad5-c23a-3db4-bd43-396d771d4f62",
                                                "text": "A year earlier, the Canadian leader was seen at a Sikh event in Toronto where separatist flags and posters depicting an extremist Sikh leader killed in a 1984 Indian Army operation were displayed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
