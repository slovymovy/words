            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4f85171-09a2-3bfe-8294-779a8988212d",
                    "sense_definition": "Ensemble des traits et des expressions du visage qui révèlent le caractère, les émotions ou l'état d'esprit d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>physionomie</w> reflétait une profonde tristesse après l'annonce de cette mauvaise nouvelle."
                        },
                        {
                            "text": "On pouvait lire toute la surprise du voyageur sur sa <w>physionomie</w> particulièrement expressive."
                        }
                    ],
                    "synonyms": [
                        "visage",
                        "figure",
                        "mine"
                    ],
                    "common_phrases": [
                        "changer de physionomie",
                        "douce physionomie"
                    ]
                },
                {
                    "sense_id": "97272cfb-db83-3be7-9c21-73e6c49166f6",
                    "sense_definition": "Aspect général, allure ou caractère distinctif d'une chose, d'une situation ou d'un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce but inattendu a complètement transformé la <w>physionomie</w> de la rencontre sportive."
                        },
                        {
                            "text": "Le vieux quartier a conservé sa <w>physionomie</w> médiévale malgré les rénovations récentes."
                        }
                    ],
                    "synonyms": [
                        "aspect",
                        "allure",
                        "tournure"
                    ],
                    "common_phrases": [
                        "physionomie du match",
                        "changer la physionomie"
                    ]
                },
                {
                    "sense_id": "856690ab-dd3a-39ae-916a-125a52456663",
                    "sense_definition": "Aspect extérieur ou configuration globale d'un paysage, d'une forêt ou d'un groupement végétal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La sécheresse persistante a profondément altéré la <w>physionomie</w> du paysage forestier."
                        },
                        {
                            "text": "La <w>physionomie</w> de la végétation change nettement à mesure que l'on monte en altitude."
