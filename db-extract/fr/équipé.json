                        "sense_id": "b6e76617-e687-3061-84ed-5394ca6e710c",
                        "entry_id": "e9c4d75f-fc9b-3234-a8a4-102db1d6dc8e",
                        "glosses": [
                            "Vaisseau qui a ses voiles et ses cordages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e19ba8-3495-4837-b466-9ede80e3a208",
                                "sense_id": "b6e76617-e687-3061-84ed-5394ca6e710c",
                                "text": "De gueules à la nef équipée d’argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c9b2e55-e2e2-3f29-84b8-203aeaa5a80d",
                        "entry_id": "e9c4d75f-fc9b-3234-a8a4-102db1d6dc8e",
                        "glosses": [
                            "Muni d’équipement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f28306-c483-436f-85a3-be73155561db",
                                "sense_id": "6c9b2e55-e2e2-3f29-84b8-203aeaa5a80d",
                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                            },
                            {
                                "example_id": "0a243cb2-d149-4df2-8c9b-54ab0a5a4559",
                                "sense_id": "6c9b2e55-e2e2-3f29-84b8-203aeaa5a80d",
                                "text": "Parallèlement à la rivière, afin de régulariser le cours de l’eau, les paysans ont d’abord creusé puis cimenté un canal de dérivation équipé de batardeaux, ouvrages permettant de régler le débit de l’eau."
                            }
                        ]
                    }
