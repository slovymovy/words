                        "examples": []
                    },
                    {
                        "sense_id": "32960e95-1d8d-3afc-9888-baee3c038768",
                        "entry_id": "e5a1056a-7aa0-3fb9-9c11-6211895faa9a",
                        "glosses": [
                            "A thing which represents something else; a sign, a symbol."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca91838b-934e-41ea-9153-38aa6b6c61d5",
                                "sense_id": "32960e95-1d8d-3afc-9888-baee3c038768",
                                "text": "[H]e emerged onto a garden terrace where on the soft red sand one could make out the sigla of a summer day: the imprints of a dog's paws, the beaded tracks of a wagtail, the Dunlop stripe left by Tanya's bicycle, […]"
                            }
                        ]
                    }
