            "senses": [
                {
                    "sense_id": "1d9bae53-0320-3961-99a7-8ac384450cec",
                    "sense_definition": "A helicopter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aircraft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team arrived in a <w>chopper</w> to evacuate the injured hikers from the mountain.",
