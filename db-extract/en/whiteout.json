                    {
                        "translation_id": "ad323acc-606f-49fe-8dc1-d471c9262e7a",
                        "source_entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                        "source_sense_description": "heavy snowstorm",
                        "target_lang_word": "пурга́",
