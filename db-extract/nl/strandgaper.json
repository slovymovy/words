                        "cross_references": [
                            {
                                "target_word": "mye commune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1888c23-3d43-309f-84aa-6df17b97d9b0",
                                        "entry_id": "8c9bf560-5536-3137-ae5a-7e00e5d6d3e2",
                                        "glosses": [
                                            "Grand bivalve des côtes d’Europe et d’Amérique du Nord, où il vit profondément enfoui dans les sables vaseux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5524941c-82b5-46be-b6fc-06317ba90f1c",
                                                "sense_id": "c1888c23-3d43-309f-84aa-6df17b97d9b0",
                                                "text": "La mye commune (Mya arenaria) est un mollusque que nous trouvons à grande échelle dans le fjord du Saguenay et dans le fleuve Saint-Laurent. Son espérance de vie (15 ans) et son mode de vie sédentaire permettent d’étudier précisément la dynamique des populations sur un site donné."
                                            },
                                            {
                                                "example_id": "5a74087b-a955-4164-8b8f-183173d3d8cd",
                                                "sense_id": "c1888c23-3d43-309f-84aa-6df17b97d9b0",
                                                "text": "Ces jours-ci sur la Côte-Nord, plusieurs personnes s’activent sur les berges du Saint-Laurent, affublées de grosses bottes en caoutchouc. Leur quête? La mye commune."
                                            },
                                            {
                                                "example_id": "c88ce1a0-e88d-4911-a6e4-4a23a620ec9a",
                                                "sense_id": "c1888c23-3d43-309f-84aa-6df17b97d9b0",
                                                "text": "La mye commune est présente tout le long du littoral québécois, principalement dans les estuaires de rivières et les baies. Elle vit enfouie dans les sédiments meubles de vase et de sable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6557367b-379f-482f-944c-eebd9bf94ba7",
                        "source_entry_id": "213f0dde-2079-36fd-b9c1-2cce143f6710",
                        "source_sense_id": "e7c954bc-814f-3e6a-a6fb-330bd5a623a8",
                        "source_sense_description": "Mya arenaria",
                        "target_lang_word": "mye des sables",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mye des sables",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54e3ccba-2bd8-32db-b082-638d912099e9",
                                        "entry_id": "991972e9-0a46-327c-9baa-c08358644085",
                                        "glosses": [
                                            "Grand bivalve des côtes d’Europe et d’Amérique du Nord, où il vit profondément enfoui dans les sables vaseux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338c454c-0740-45fa-b71f-122bbfe35731",
                                                "sense_id": "54e3ccba-2bd8-32db-b082-638d912099e9",
                                                "text": "Et nous butinant de l’une à l’autre pour savourer chaudrée de palourdes, palourdes frites, palourdes vapeur, guédille de palourdes. Et pas n’importe laquelle des palourdes, la reine d’entre elles : la mye des sables."
                                            },
                                            {
                                                "example_id": "299d82b0-dfce-4aca-a53d-50646ca0c308",
                                                "sense_id": "54e3ccba-2bd8-32db-b082-638d912099e9",
                                                "text": "La « mye des sables » (nom scientifique Mya arenaria) est un mollusque bivalve qui vit enfoui dans le sable vaseux. On en trouve dans les eaux de l’Arctique, dans la Manche, la mer du Nord et l’Atlantique."
                                            },
                                            {
                                                "example_id": "3bc2eb66-8c65-4420-aac7-caf7b41aba98",
                                                "sense_id": "54e3ccba-2bd8-32db-b082-638d912099e9",
                                                "text": "La mye des sables est la proie de nombreux poissons comme la raie, le turbot, l’esturgeon, le flet ou les gobies ainsi que quelques oiseaux aquatiques comme les goélands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
