    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1226e07-22c3-3bc9-996e-a01e9441c1af",
                    "sense_definition": "Довериться кому-либо или чему-либо, рассчитывать на чью-то помощь или надежность.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я могу <w>положиться</w> на своего лучшего друга в любой сложной ситуации.",
                            "target_lang_translations": {
                                "de": "Ich kann mich in jeder schwierigen Situation auf meinen besten Freund <w>verlassen</w>."
                            }
                        },
                        {
                            "text": "В этом вопросе нельзя <w>положиться</w> на случай, нужно всё тщательно проверить.",
                            "target_lang_translations": {
                                "de": "In dieser Angelegenheit darf man sich nicht auf den Zufall <w>verlassen</w>, man muss alles gründlich prüfen."
                            }
                        }
                    ],
                    "synonyms": [
                        "довериться",
                        "понадеяться"
                    ],
                    "common_phrases": [
                        "положиться на друга",
                        "положиться на случай"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem oder etwas vertrauen, sich auf jemandes Hilfe oder Zuverlässigkeit verlassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich verlassen auf",
                                "target_lang_sense_clarification": "jemandem vertrauen oder auf jemandes Hilfe zählen"
                            },
                            {
                                "target_lang_word": "bauen auf",
                                "target_lang_sense_clarification": "auf jemanden oder etwas vertrauen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "120bfc35-74c1-3fe2-a9b3-2689d4e8db85",
                    "sense_definition": "Страдательный залог от глагола <w>положить</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всё было <w>положиться</w> на стол перед началом важного совещания.",
                            "target_lang_translations": {
                                "de": "Alles wurde vor Beginn der wichtigen Besprechung auf den Tisch <w>gelegt</w>."
                            }
                        },
                        {
                            "text": "Предмет должен был <w>положиться</w> в коробку согласно инструкции.",
                            "target_lang_translations": {
                                "de": "Der Gegenstand sollte laut Anleitung in die Schachtel <w>gelegt</w> werden."
                            }
                        }
                    ],
