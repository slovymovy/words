                "senses": [
                    {
                        "sense_id": "1cbac583-282c-3bf8-a9ca-0faba02bcc0b",
                        "entry_id": "ae453f52-8845-3d7a-aee0-e641a2a3299b",
                        "glosses": [
                            "Personne qui cueille des fruits, des fleurs, des champignons, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94f6b14-0fa3-48b9-bf5e-a4411335f42d",
                                "sense_id": "1cbac583-282c-3bf8-a9ca-0faba02bcc0b",
                                "text": "L’association mycologique de la Ville rose, qui forme les étudiants en pharmacie en les emmenant dans les bois, a dû « aller jusqu’au col de Port [en Ariège], explique Marie-France Massari, sa secrétaire. En plaine, il n’y a rien, c’est une catastrophe pour les cueilleurs ! »"
                            },
                            {
                                "example_id": "39b973c1-d5a9-48b3-9f8a-65cf17e999da",
                                "sense_id": "1cbac583-282c-3bf8-a9ca-0faba02bcc0b",
                                "text": "Dans les exploitations de la Vallée Centrale, les cueilleurs d’agrumes et leurs enfants souffrent à cause des taux dangereux de chlorpyriphos-éthyl, produit neurotoxique dont l’interdiction a été annulée par l’administration Trump."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbe7579f-78ea-30b1-8cb4-0cb9e6180396",
                        "entry_id": "ae453f52-8845-3d7a-aee0-e641a2a3299b",
                        "glosses": [
                            "Ouvrier qui prend la goutte de verre au bout de la canne de souffleur."
                        ],
                        "tags": [
                            "Verrerie"
                        ],
                        "examples": [
                            {
                                "example_id": "8c438132-f746-4879-836f-82624c7069fd",
                                "sense_id": "fbe7579f-78ea-30b1-8cb4-0cb9e6180396",
                                "text": "L’atelier noble d’une verrerie en activité, se composait, dès le commencement d’une réveillée, de huit gentilshommes, savoir: deux cueilleurs, trois bossiers et trois ouvriers."
                            }
                        ]
                    }
                ],
