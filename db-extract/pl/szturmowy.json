                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bcc65e8-1d20-497d-8e00-b9454b1a5dd5",
                        "source_entry_id": "bd67f949-fc8d-361e-a929-6542cd71a283",
                        "source_sense_id": "e31ee730-7f0a-3525-9359-b476ae0a3034",
                        "target_lang_word": "ударный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ударный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "77d0eae5-a238-307f-832e-daf55ad1654d",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "соотносящийся по значению с существительным: удар, связанный с ним"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81460b3e-62f7-4743-ab0b-f307bb198364",
                                                "sense_id": "77d0eae5-a238-307f-832e-daf55ad1654d",
                                                "text": "Собрали нас в ту пору сорок семь полковников, положили перед нами два пистолета: один кремневый, другой ударный ― который лучше, господа?"
                                            },
                                            {
                                                "example_id": "08a0200f-66f2-4ad4-983a-52f1776e72e2",
                                                "sense_id": "77d0eae5-a238-307f-832e-daf55ad1654d",
                                                "text": "Кимвал ― ударный музыкальный инструмент, похожий на современные тарелки."
                                            },
                                            {
                                                "example_id": "40d4f2b4-2b53-4221-a106-4534efb83991",
                                                "sense_id": "77d0eae5-a238-307f-832e-daf55ad1654d",
                                                "text": "За столом были государь, императрица, три старшие дочери и мы двое; под конец завтрака пришли младшая (пятилетняя) Анастасия Николаевна и двухлетний наследник, которого государь взял на колени, причем «маленький» стал приставать: «дай, дай», ― чтобы ему дали позвонить в ударный колокольчик, стоявший около государя."
                                            },
                                            {
                                                "example_id": "bfdd1003-e99c-4584-82ce-0bab6189fe95",
                                                "sense_id": "77d0eae5-a238-307f-832e-daf55ad1654d",
                                                "text": "Были случаи, когда ударная от взрыва волна, проникая в казематы, выбивала двери и калечила людей; так, при попадании 30,5-см бомбы в убежище на «Дровяном шоссе»…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a0dc0ba-420b-368a-a73e-ddf0aaf568e5",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "связанный с нанесением или с получением удара"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d792f7b2-b310-4951-9cb3-e7f71f2e8d82",
                                                "sense_id": "2a0dc0ba-420b-368a-a73e-ddf0aaf568e5",
                                                "text": "Что касается эжекторов или выбрасывателей стреляной гильзы, то это удорожает, усложняет и утяжеляет ружье, а за все это заставляет терять гильзу после первого же выстрела. 8. Ударные механизмы или замки Воспламенение пистона производится или ударом части, скользящей взад и вперед (ударниковый замок) или же ударом части, вращающейся или качающейся на оси (курковый замок)."
                                            },
                                            {
                                                "example_id": "bf33b623-cf23-49a1-a6e2-322c208b186c",
                                                "sense_id": "2a0dc0ba-420b-368a-a73e-ddf0aaf568e5",
                                                "text": "Капсюлем (пистоном) называют металлический колпачок с ударным взрывчатым составом, служащим для воспламенения заряда пороха."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de00c6d0-71a9-39d2-85c2-559d4d598e09",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "способный наносить удары"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32758a1a-6b35-44c2-b8dc-cc8af9008391",
                                                "sense_id": "de00c6d0-71a9-39d2-85c2-559d4d598e09",
                                                "text": "Тут мы находим множество разнообразных машин и аппаратов: дробильных, разрывных, ударных, строгальных, точильных, машин для наматывания, расчесывания, распиливания, выскабливания, долбления, бурения и т. д."
                                            },
                                            {
                                                "example_id": "468e8af3-034a-43be-af72-0be2fde8edbe",
                                                "sense_id": "de00c6d0-71a9-39d2-85c2-559d4d598e09",
                                                "text": "Самый «ударный» во всех смыслах инструмент — это перфоратор (ударная дрель). Без преувеличения, это … Ударная дрель — это нечто среднее между универсальной дрелью и, частично, перфоратором."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "322b1b42-de45-3542-99c1-7946fd5a9a29",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "перен. быстро, внезапно, решительно действующий, способный к такому действию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9ce9fa-cdff-4b89-ac64-8e14d2f1db55",
                                                "sense_id": "322b1b42-de45-3542-99c1-7946fd5a9a29",
                                                "text": "― Вряд ли: тут нужен ударный состав, а его не достанешь в Персии…"
                                            },
                                            {
                                                "example_id": "549cffca-c461-4f4e-9c20-3cfc2f41334e",
                                                "sense_id": "322b1b42-de45-3542-99c1-7946fd5a9a29",
                                                "text": "Может, там, в районе Пржевальска и Токмака (куда доезжал ведь и сам Джиназаков!), собирается ударный кулак? ― Нет, нет."
                                            },
                                            {
                                                "example_id": "4fcbd762-8f82-466c-a62d-200daf8e20f6",
                                                "sense_id": "322b1b42-de45-3542-99c1-7946fd5a9a29",
                                                "text": "На станции, как и всегда, толпились офицеры, много было солдат ударных батальонов с голубыми щитами, нашитыми на левом рукаве рубахи, с изображением белой краской черепа и мертвых костей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a15f5de8-17d1-31c0-a967-2db138cb0c7c",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "связанный с внезапным действием, способностью к такому действию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2999a2e0-cfc7-4b51-bedb-f38aeb6cb221",
                                                "sense_id": "a15f5de8-17d1-31c0-a967-2db138cb0c7c",
                                                "text": "Они в ударный момент всегда на вышке, на открытом, опасном посту."
                                            },
                                            {
                                                "example_id": "451e07b2-3c9b-4bec-b69b-d2ffe2718d09",
                                                "sense_id": "a15f5de8-17d1-31c0-a967-2db138cb0c7c",
                                                "text": "Вы с честью держали дисциплину пролетариата… держите кр-репко! .. Призываю на митинг… ударная задача! .. помочь нашим героям Донбасса! .."
                                            },
                                            {
                                                "example_id": "bad856dd-6daa-4eeb-ba54-92a38942a6f7",
                                                "sense_id": "a15f5de8-17d1-31c0-a967-2db138cb0c7c",
                                                "text": "Он пускается на хитрость; он хочет привлечь внимание соседа ударным местом своего рассказа, а поэтому начинает без предварительной подготовки прямо с середины:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da79fc8e-03d5-387d-81d0-b3e93a1f10f4",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "неотложный, требующий решительных действий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8030badc-45dc-4c9e-a2d2-1655f7779dba",
                                                "sense_id": "da79fc8e-03d5-387d-81d0-b3e93a1f10f4",
                                                "text": "С Неменовым становится вместе жить просто жутко ― того гляди ни с того ни с сего натравит чеку, хотя его интриги у Кристи очевидно повели, в связи с ревизией, к его посрамлению. Сейчас у меня ударных дел три: 1 ― Дрова на зиму."
                                            },
                                            {
                                                "example_id": "408c9a09-c373-4001-b22d-820e17a30a1b",
                                                "sense_id": "da79fc8e-03d5-387d-81d0-b3e93a1f10f4",
                                                "text": "Былое формальное равенство в оценке труда, по признаку затраченного времени давно уже сменилось расценкой по качеству и результату труда; различением видов труда, и специальных видов квалифицированного труда; сдельной оплатой и доплатами «добавочных», «ударных», «премий» за успешность, ответственность и т. д."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b6fb21-c352-3b26-a097-bc08e2fff1b1",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "соотносящийся по значению с существительным: ударник, связанный с ним"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f18fe9a6-96af-4b63-aef2-4bc45d6fc6ca",
                                                "sense_id": "b5b6fb21-c352-3b26-a097-bc08e2fff1b1",
                                                "text": "При выполнении 110 % нормы давался ударный паек, за 100 % и ниже ― производственный ― восемьсот граммов хлеба, меньшее количество блюд."
                                            },
                                            {
                                                "example_id": "99ddb17e-cd2f-45d4-aded-afb68650dd68",
                                                "sense_id": "b5b6fb21-c352-3b26-a097-bc08e2fff1b1",
                                                "text": "― Наша бригада выполнила норму на 40 % ― штрафной паек! Есть еще производственный, ударный, стахановский. А двое из нашей бригады получили высшую оценку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9908bd-5e59-3ddc-8ebd-1040d10c1901",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "передовой по выполнению плана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c71eac-774e-4933-8000-d3fc27b70ad6",
                                                "sense_id": "7c9908bd-5e59-3ddc-8ebd-1040d10c1901",
                                                "text": "Около кузни висел на плетне возглас, нарисованный по флагу: «За партию, за верность ей, за ударный труд, пробивающий пролетариату двери в будущее»."
                                            },
                                            {
                                                "example_id": "25f1249a-32fe-4422-b9f0-b124f55ce060",
                                                "sense_id": "7c9908bd-5e59-3ddc-8ebd-1040d10c1901",
                                                "text": "Для нефти, для сырца, для чугуна ― все песни, каждое движенье. Ударный год. И мы свои сердца Объявим на военном положеньи!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22a6c68-fb01-37e5-8896-1385e678ce49",
                                        "entry_id": "5977614e-59b5-38d1-a75c-723e5b564816",
                                        "glosses": [
                                            "лингв. находящийся под ударением, произносимый с ударением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d5c378-71a7-4400-81d2-37fcf0baf677",
                                                "sense_id": "d22a6c68-fb01-37e5-8896-1385e678ce49",
                                                "text": "Когда ж расстояние будет пред тоном и состоять оно имеет одним же складом, то стопа сделается ямб, коего знак есть противный первому U ―, а слово, например: гремит, потому что в нем второй слог ударен силою, а первый без ударения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
