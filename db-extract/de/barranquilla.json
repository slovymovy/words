                                "example_id": "7ea3446d-ce2d-49cc-804f-63d4362fad86",
                                "sense_id": "7ff3001e-a8c5-358d-87fd-cf8aba11871b",
                                "text": "„Auf einem Flug von der kolumbianischen Stadt Barranquilla nach der Insel San Andres im Karibischen Meer wird eine Passagiermaschine von vier Piraten gezwungen, nach Havanna auf Kuba zu fliegen.“"
                            },
                            {
                                "example_id": "aa0a9861-b652-4602-bedb-245bc539c5f9",
                                "sense_id": "7ff3001e-a8c5-358d-87fd-cf8aba11871b",
                                "text": "„Große Bevölkerungskonzentrationen (30 % der Landesbevölkerung) findet man in den vier größten Städten Bogotá, Medellín, Cali und Barranquilla.“"
                            }
                        ],
