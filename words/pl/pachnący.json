            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9f73d02-5f3c-3e29-93ef-240f3651ef71",
                    "sense_definition": "Wydzielający przyjemny, miły lub intensywny zapach.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zapach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W wazonie na stole stoją piękne i bardzo <w>pachnące</w> róże.",
                            "target_lang_translations": {
                                "ru": "В вазе на столе стоят красивые и очень <w>ароматные</w> розы."
                            }
                        },
                        {
                            "text": "Kupiłem w piekarni świeży, <w>pachnący</w> chleb na śniadanie.",
                            "target_lang_translations": {
                                "ru": "Я купил в пекарне свежий, <w>душистый</w> хлеб на завтрак."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonny"
                    ],
                    "antonyms": [
                        "śmierdzący"
                    ],
                    "common_phrases": [
                        "pachnące kwiaty",
                        "pachnąca kąpiel",
                        "pachnące mydło"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издающий приятный, хороший или насыщенный запах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ароматный",
                                "target_lang_sense_clarification": "с приятным запахом"
                            },
                            {
                                "target_lang_word": "душистый",
                                "target_lang_sense_clarification": "пахучий, приятный"
                            },
                            {
                                "target_lang_word": "благоухающий",
                                "target_lang_sense_clarification": "книжное, изысканно пахнущий"
                            },
                            {
                                "target_lang_word": "пахучий",
                                "target_lang_sense_clarification": "с сильным запахом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27927821-42bd-3285-961a-5af1d7b3f809",
                    "sense_definition": "Będący członem gatunkowych nazw roślin o wyraźnym, silnym zapachu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ogrodzie posadziliśmy groszek <w>pachnący</w>, który pięknie kwitnie latem.",
                            "target_lang_translations": {
                                "ru": "В саду мы посадили <w>душистый</w> горошек, который красиво цветёт летом."
                            }
                        },
                        {
                            "text": "Rezeda <w>pachnąca</w> jest często uprawiana ze względu na swój aromat.",
                            "target_lang_translations": {
                                "ru": "Резеда <w>душистая</w> часто выращивается ради своего аромата."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groszek pachnący"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся частью видовых названий растений с выраженным приятным запахом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душистый",
                                "target_lang_sense_clarification": "в ботанических названиях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10337b23-cd26-389e-88cd-5ce4c3a6ee2a",
                    "sense_definition": "Imiesłów przymiotnikowy czynny od czasownika <w>pachnieć</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyzna <w>pachnący</w> drogimi perfumami wszedł do eleganckiej restauracji.",
                            "target_lang_translations": {
                                "ru": "Мужчина, <w>пахнущий</w> дорогими духами, вошёл в элегантный ресторан."
                            }
                        },
                        {
                            "text": "Weszliśmy do lasu silnie <w>pachnącego</w> sosnową żywicą po ulewnym deszczu.",
                            "target_lang_translations": {
                                "ru": "Мы вошли в лес, сильно <w>пахнущий</w> сосновой смолой после проливного дождя."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imiesłów przymiotnikowy czynny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действительное причастие настоящего времени от глагола pachnieć (пахнуть)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пахнущий",
                                "target_lang_sense_clarification": "издающий запах чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
