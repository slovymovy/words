                        "cross_references": [
                            {
                                "target_word": "make-believe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d554ab4d-802a-3d52-89d6-7207f4582ff0",
                                        "entry_id": "cf96860f-c7ef-339a-8cb6-a0673e7896cb",
                                        "glosses": [
                                            "The quality or act of pretending; acting as if something is true when in fact one knows it is not."
                                        ],
                                        "tags": [
                                            "childish",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "563b24db-4985-424e-9c31-a40a686aec96",
                                                "sense_id": "d554ab4d-802a-3d52-89d6-7207f4582ff0",
                                                "text": "Come on, come on, I go up and down / I like this curious feeling / I know, I see, it's like make believe / Cover your ears so you can hear what I'm saying"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "922ca9ea-c932-3f3b-bd9a-2fd56ead0a78",
                                        "entry_id": "cf96860f-c7ef-339a-8cb6-a0673e7896cb",
                                        "glosses": [
                                            "The condition of pretending or imagining that things are better than they really are."
                                        ],
                                        "tags": [
                                            "childish",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fc78d41-9369-364b-a0f8-44e22e0d09f7",
                                        "entry_id": "cf96860f-c7ef-339a-8cb6-a0673e7896cb",
                                        "glosses": [
                                            "Something imaginary."
                                        ],
                                        "tags": [
                                            "childish",
                                            "countable",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f20c02b4-b9cf-44f0-b90d-9a1c8c440893",
                                                "sense_id": "3fc78d41-9369-364b-a0f8-44e22e0d09f7",
                                                "text": "‘You ought to be ashamed of yourself, Marjorie Lindon, to even think such nonsense. Are you all nerves and morbid imaginings,—you who have prided yourself on being so strong-minded! A pretty sort you are to do battle for anyone.—Why, they’re only make-believes!’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "make-believe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5a7010-dc0b-39bf-b866-cd540e5e5e41",
                                        "entry_id": "4793887f-3c12-3a5d-85ef-9fcc8397011c",
                                        "glosses": [
                                            "Imaginary; not real; pretend."
                                        ],
                                        "tags": [
                                            "childish",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f402c286-d41e-46a1-a734-c78be9600cf4",
                                                "sense_id": "5b5a7010-dc0b-39bf-b866-cd540e5e5e41",
                                                "text": "He called himself Lord So-and-So, even had his family crest on the wall, but it was all totally make-believe."
                                            }
                                        ]
