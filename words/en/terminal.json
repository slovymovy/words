    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "785c9163-71c1-39e1-96f7-624aec446525",
                    "sense_definition": "A building at an airport where passengers arrive and depart.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transportation_hub",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please meet me at the arrivals gate in <w>terminal</w> two.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, встреть меня у выхода для прибывающих во втором <w>терминале</w>."
                            }
                        },
                        {
                            "text": "The airport <w>terminal</w> was crowded with travelers during the holiday season.",
                            "target_lang_translations": {
                                "ru": "В праздничный сезон здание <w>аэровокзала</w> было переполнено путешественниками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "airport terminal",
                        "international terminal",
                        "passenger terminal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание в аэропорту, где пассажиры прибывают и откуда отправляются."
