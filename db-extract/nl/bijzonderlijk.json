                            {
                                "example_id": "5874a416-e7b6-45e5-9988-48c280c3f0f9",
                                "sense_id": "38c67cd8-9844-37f9-9eef-98c477c5dfc4",
                                "text": "Bij zijn inkomen bezag hij als een wantrouwende vos, de personen die in de kamer waren, en wel bijzonderlijk Meester Rogaert; want hij bemerkte in hem meer listigheid dan in de anderen."
                            },
                            {
                                "example_id": "bb91e1f9-1d73-4853-9ca9-a197229fc9f4",
                                "sense_id": "38c67cd8-9844-37f9-9eef-98c477c5dfc4",
                                "text": "Dewijl er in sommige huizen meer Fransen dan men er in zo korte tijd kon doodslaan geherbergd waren, hadden velen de tijd gehad om zich te kleden en om de wapens in de hand te nemen; en dit wel bijzonderlijk in het kwartier waar De Chatillon met zijn talrijke wachten gehuisd was."
                            }
                        ]
                    }
