                ],
                "senses": [
                    {
                        "sense_id": "545f02df-b2cd-3375-95d3-4eab02db6676",
                        "entry_id": "5a28d278-15c8-308e-bf8b-f5e104b1598e",
                        "glosses": [
                            "Faire perdre son caractère symbolique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed77d50-8c38-4c7a-b6c2-439da7df514a",
                                "sense_id": "545f02df-b2cd-3375-95d3-4eab02db6676",
                                "text": "Asymboliser (pour le signe de scène), normer (pour la partition musicale), directionnaliser (pour l’espace architectural), ont la même signification."
                            },
                            {
                                "example_id": "c275019d-0907-43c0-92a0-c2f831014062",
                                "sense_id": "545f02df-b2cd-3375-95d3-4eab02db6676",
                                "text": "Dans les cas où le travail de l'hypnose ne suffirait pas, un travail d'auto-hypnose s'avère extrêmement efficace pour asymboliser ces douleurs (cette souffrance en simple sensation très différente.)"
                            },
                            {
                                "example_id": "308349c7-bd10-4c14-b1d7-80e9fc08dd2a",
                                "sense_id": "545f02df-b2cd-3375-95d3-4eab02db6676",
                                "text": "Le clivage lui, n'est pas l'expulsion dans l'inconscient d'un contenu symbolisé, puisqu'il traite avec des contenus asymbolisés, des contenus informes."
                            }
                        ]
                    }
                ],
