                        "source_entry_id": "5048b06d-c993-3402-90e0-b0082b030275",
                        "source_sense_description": "application of computer technology, operational research, and statistics to solve problems",
                        "target_lang_word": "анали́тика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анали́тика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c7230fb8-9c42-3614-96f1-1837c54eb883",
                                        "entry_id": "de0c7775-f418-318c-b80d-4f8c97cfd1db",
                                        "glosses": [
                                            "что-либо связанное с анализом при исследовании и решении вопросов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6969562-b8f7-45cb-99e9-aaf99d78ed7b",
                                                "sense_id": "c7230fb8-9c42-3614-96f1-1837c54eb883",
                                                "text": "— Разумеется, в узком плане криминалистической аналитики."
                                            },
                                            {
                                                "example_id": "b90f153e-1397-4dfe-b28b-c8b279e6f0a7",
                                                "sense_id": "c7230fb8-9c42-3614-96f1-1837c54eb883",
                                                "text": "На индийской почве, считает он, оно выражалось в критико-контравертивном исследовании суждений (диалектика) и системно-классификационном исследовании понятий (аналитика)."
                                            },
                                            {
                                                "example_id": "434d2765-ae4e-45b0-b8bc-379a4005fb8e",
                                                "sense_id": "c7230fb8-9c42-3614-96f1-1837c54eb883",
                                                "text": "Вообще, новая версия предлагает банкам очень богатую аналитику по итогам аттестации, в том числе в динамике, сопровождая профессиональную карьеру сотрудника в банке по горизонтали и вертикали."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "774b6b49-7c8a-38a1-b63f-46b0e4cf15d7",
                                        "entry_id": "de0c7775-f418-318c-b80d-4f8c97cfd1db",
                                        "glosses": [
                                            "спец. аналитическая геометрия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b8ab7b8-1f74-40be-8fb8-9ae88e0a808b",
                                                "sense_id": "774b6b49-7c8a-38a1-b63f-46b0e4cf15d7",
                                                "text": "Применение новой теории к аналитике находится также в статьях под названием «О началах Геометрии», помещённых в Казанском Вестнике за 1829 и 1830 годы."
                                            },
                                            {
                                                "example_id": "1d2e8d92-6cb5-4ce1-9202-42124747219a",
                                                "sense_id": "774b6b49-7c8a-38a1-b63f-46b0e4cf15d7",
                                                "text": "Кажется мне, что изложенное здесь новое Геометрическое учение ни в каком отношении не противно понятию о телах, и, переходя в аналитику, может обещать подобную пользу той, какую в применении оказывает употребительная Геометрия."
                                            }
                                        ]
                                    }
                                ]
