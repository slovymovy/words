                ],
                "senses": [
                    {
                        "sense_id": "eaf695e7-40a9-308f-bf00-3cc0145eda1b",
                        "entry_id": "5c112142-957d-3a93-bd7c-366de6159f27",
                        "glosses": [
                            "Partie saillante de la frise dorique, qui représente l’extrémité des solives posée sur l’architrave et qui a ordinairement des rainures profondes et verticales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7027a5-2375-41a7-964e-2bd3c638e31e",
                                "sense_id": "eaf695e7-40a9-308f-bf00-3cc0145eda1b",
                                "text": "Les triglyphes de l’ordre dorique marquaient la frise du péristyle."
                            },
                            {
                                "example_id": "52651d5b-37b8-4786-bc9a-a06073011e0f",
                                "sense_id": "eaf695e7-40a9-308f-bf00-3cc0145eda1b",
                                "text": "Cette porte, assez souvent répétée dans les petites églises du moyen âge que le hasard a préservées des ravages du calvinisme, est couronnée par un triglyphe au-dessus duquel s’élève une Vierge sculptée tenant l’Enfant Jésus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86d34c92-0237-4003-8ae2-c9200b9c816a",
                        "source_entry_id": "5c112142-957d-3a93-bd7c-366de6159f27",
                        "source_sense_id": "eaf695e7-40a9-308f-bf00-3cc0145eda1b",
                        "target_lang_word": "triglyph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triglyph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cee05337-3a56-3eec-a21e-567ae10b5a87",
                                        "entry_id": "34c7d15e-230d-3fa5-9680-4d5a85ee0ffa",
                                        "glosses": [
                                            "A vertically channeled tablet of the Doric frieze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca8fa2e-d8be-4319-ba89-37d53fac854b",
                                                "sense_id": "cee05337-3a56-3eec-a21e-567ae10b5a87",
                                                "text": "An interesting architectural point is raised by some stone carvings, with a vertical triple-grooved design. So often is this design found that Mr. Fyfe, when discussing its occurrence on a miniature fresco at Knossos, calls it the most distinctive architectural ornament of the age. There is every probability that we may see in it the prototype of the \"Triglyphs\" that alternate with Metopes on the entablature of the Doric Temple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
