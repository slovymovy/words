                "senses": [
                    {
                        "sense_id": "efce30ef-4b39-3012-ad94-837aa1ce84ee",
                        "entry_id": "fa09b44b-d189-3d36-b8e5-08b5a1f918c9",
                        "glosses": [
                            "геол. пластообразное интрузивное тело с секущими контактами, длина которого во много раз превышает ширину, а ограничивающие по сторонам плоскости практически параллельны; трещина, заполненная магматическим расплавом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3551c102-c73b-4d88-aed3-9e418b451120",
                                "sense_id": "efce30ef-4b39-3012-ad94-837aa1ce84ee",
                                "text": "Среди даек докембрийского возраста можно выделить асхистовые и диасхистовые."
                            }
                        ]
                    }
                ],
                "translations": [
