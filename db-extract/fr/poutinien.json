                    {
                        "sense_id": "7a97b7f4-fd2b-3f85-bc64-57fcb922c140",
                        "entry_id": "d1af51c2-5f7f-36ed-8b4f-b9b9af60cee0",
                        "glosses": [
                            "Relatif, propre à ou à la façon de Vladimir Poutine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84413126-a0e1-4544-b31d-78c3963e8536",
                                "sense_id": "7a97b7f4-fd2b-3f85-bc64-57fcb922c140",
                                "text": "Il évoque les mythes du régime poutinien, analyse ses éléments de langage, qui au fil des ans, ont façonné la manière de penser d'une partie de la population russe."
                            },
                            {
                                "example_id": "e4530eeb-28be-4f12-a0e7-3979f6f4758f",
                                "sense_id": "7a97b7f4-fd2b-3f85-bc64-57fcb922c140",
                                "text": "Les détracteurs du Premier ministre lui reprochent un exercice « poutinien » du pouvoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "23febf8f-fad6-3c84-93ac-6c266a8c4eab",
                        "entry_id": "d1af51c2-5f7f-36ed-8b4f-b9b9af60cee0",
                        "glosses": [
                            "Partisan de Vladimir Poutine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0991d715-7ad2-49ca-8b5b-7023718dcf2e",
                                "sense_id": "23febf8f-fad6-3c84-93ac-6c266a8c4eab",
                                "text": "Le chef Insoumis n’est pas poutinien."
                            }
                        ]
                    }
                ],
