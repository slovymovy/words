                "translations": [
                    {
                        "translation_id": "276d49f5-b9cb-4297-8cd3-a3271f751247",
                        "source_entry_id": "7009ac47-c2cd-35b1-938a-ceb98dc423aa",
                        "source_sense_id": "ba0f5327-933c-38a5-8f20-6465e4e45618",
                        "source_sense_description": "een kunstwerk vervaardigd door het houwen van steen",
                        "target_lang_word": "Bildhauerwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e2d26906-4025-49d7-ba2a-c89d560d1cf3",
                        "source_entry_id": "7009ac47-c2cd-35b1-938a-ceb98dc423aa",
                        "source_sense_id": "ba0f5327-933c-38a5-8f20-6465e4e45618",
                        "source_sense_description": "een kunstwerk vervaardigd door het houwen van steen",
                        "target_lang_word": "Plastik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plastik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb86629-6965-3ee5-9e26-32b6bee4a02b",
                                        "entry_id": "c2353bed-fcfb-3ad2-9846-f93bbe5af8ce",
                                        "glosses": [
                                            "Gattung der Bildhauerei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d688bfc5-4497-4e59-a51b-d2afa4b28312",
                                                "sense_id": "4eb86629-6965-3ee5-9e26-32b6bee4a02b",
                                                "text": "Das Hauptthema der Plastik ist die Darstellung des Menschen in Wachs, Gips, Ton oder anderen geeigneten Materialien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3dd8675f-64dc-3b3c-b680-f2bdbad90576",
                                        "entry_id": "c2353bed-fcfb-3ad2-9846-f93bbe5af8ce",
                                        "glosses": [
                                            "dreidimensionales Kunstwerk, das durch ein additives Verfahren geschaffen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281b54f4-901f-4cd3-8876-e921450af1fc",
                                                "sense_id": "3dd8675f-64dc-3b3c-b680-f2bdbad90576",
                                                "text": "Die neue Plastik auf dem Rathausbrunnen erregt allgemeines Aufsehen."
                                            },
                                            {
                                                "example_id": "279baa56-f0d5-429e-a709-987d41b23c28",
                                                "sense_id": "3dd8675f-64dc-3b3c-b680-f2bdbad90576",
                                                "text": "„Statisch gehalten wird die Skulptur von einem Stahlblock, dessen Gewicht exakt dem der Plastik entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "06a17641-f044-35d0-8e62-c561378a3d0d",
                                        "entry_id": "c2353bed-fcfb-3ad2-9846-f93bbe5af8ce",
                                        "glosses": [
                                            "chirurgische Nachbildung oder Umformung eines Körperteils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7b5fa8-2e56-450a-b1f8-f93ed4686870",
                                                "sense_id": "06a17641-f044-35d0-8e62-c561378a3d0d",
                                                "text": "Die amputierte Brust wird durch eine Plastik ersetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Plastik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                        "entry_id": "aa0d53e2-01ce-304d-98d0-cfc179710a9b",
                                        "glosses": [
                                            "künstlich und chemisch hergestelltes Material, organisches Polymer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5b64be-9d04-46e8-a39e-e85597b67035",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "Viele Gegenstände bestehen aus Plastik, wie zum Beispiel Taschen, Behälter oder Bauteile."
                                            },
                                            {
                                                "example_id": "f37667ad-f5c4-4935-89e7-50db6327f8dd",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Die Einsatzmöglichkeiten für Plastik sind genauso groß, wie die Liste der Probleme und Risiken dieses Materials lang ist.“"
                                            },
                                            {
                                                "example_id": "1f861a85-4226-4cf1-9efa-135c593c5ed6",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Das Plastik hält sich selbst im Wasser über Jahrzehnte und treibt lange Zeit an der Wasseroberfläche. Unter dem Einfluss von UV-Strahlung und der Belastung von Wasser, Wind und Wellen werden die Teile zwar mit der Zeit immer kleiner, aber sie lösen sich nicht auf.“"
                                            },
                                            {
                                                "example_id": "06f9deb7-1597-417a-a2eb-00ca1207021e",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„In den vergangenen Jahren sind zahlreiche Projekte lanciert worden, um den Plastik wieder herauszufischen.“"
                                            },
                                            {
                                                "example_id": "f19006af-d669-4c29-92e8-15beca48f829",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Wenn uns das gelingt, dann wird das dazu führen, dass immer mehr Hersteller und auch Händler vermehrt Reciclate für ihre Verpackungen verwenden werden und wir es somit irgendwann schaffen, die Wertstoffe, den Plastik als Wertstoff im Kreislauf zu führen.“"
                                            },
                                            {
                                                "example_id": "21bcf620-eb0b-48c1-a52f-30331ac6b84f",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Durch die Hitze schmilzt der Plastik und der Kern taucht immer tiefer in die Form ein.“"
                                            },
                                            {
                                                "example_id": "2523ff8a-d8d6-4680-880f-ca5a7729eef4",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Dass er den Plastik gleich wieder ins Wasser wirft, ärgert mich, ist aber für ihn die normalste Sache der Welt.“"
                                            },
                                            {
                                                "example_id": "165a8451-9f15-4efe-9a4e-e6855fdf667b",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Wenn du dich darüber aufregst, dann beginne, den Plastik auf der Straße, im Wald, der vor deinen Füßen oder am Rand liegt, aufzuheben und in den nächsten Mülleimer zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c4de453-d187-4875-9d9f-7dc89acf99d2",
                        "source_entry_id": "7009ac47-c2cd-35b1-938a-ceb98dc423aa",
                        "source_sense_id": "ba0f5327-933c-38a5-8f20-6465e4e45618",
                        "source_sense_description": "een kunstwerk vervaardigd door het houwen van steen",
                        "target_lang_word": "Skulptur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skulptur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d89cf02d-0a2c-3001-bac4-f9909db7df8c",
                                        "entry_id": "9067c845-9b59-3071-b544-681975145da0",
                                        "glosses": [
                                            "Gattung der Bildhauerei, die sich mit dreidimensionalen Werken befasst, die aus festem Material mittels eines subtraktiven Verfahrens (Abtragen, Ausstechen, Aushöhlen) geschaffen wurden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8686b57-cff1-478c-b557-46f38b941972",
                                                "sense_id": "d89cf02d-0a2c-3001-bac4-f9909db7df8c",
                                                "text": "„Ihre vielfältige Volkskunst enthält Lieder, Tanz, Poesie, antike griechischen Elemente in Skulptur und ihren traditionellen Trachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                        "entry_id": "9067c845-9b59-3071-b544-681975145da0",
                                        "glosses": [
                                            "dreidimensionales Kunstwerk, das aus festem Material (Stein oder Ähnlichem) besteht und das durch Abtragen, Ausstechen oder Aushöhlen geschaffen wurde"
                                        ],
                                        "tags": [
                                            "Bildhauerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae56c1c9-fe25-41e5-8314-a4aac03be940",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Nach den Anfängen im 15. Jahrhundert wurden immer mehr Skulpturen geschaffen, die unabhängig von einem Bauwerk im Raum standen und den oft nackten Körper von Menschen detailgetreu abbildeten.“"
                                            },
                                            {
                                                "example_id": "86833feb-62bb-4adb-a175-2f6757709d5f",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Figurinen findet man an solchen Orten und in solchen kulturellen Kontexten, die auf den Charakter der Skulpturen als Kultobjekte hinweisen.“"
                                            },
                                            {
                                                "example_id": "94196e04-08fb-4699-9b23-d96ca55fc5c9",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Die Oberfläche der Pyramide war mit Steinplatten bedeckt, die 70 steinerne Skulpturen trugen.“"
                                            },
                                            {
                                                "example_id": "4f869634-1bdb-4aa5-bde0-8c14404d03b8",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Zurück im Zimmer, lag Scott immer noch wie auf seinem Grab, wie eine Skulptur, ein Denkmal seiner selbst, hielt die Augen geschlossen und atmete mit beispielhafter Würde.“"
                                            },
                                            {
                                                "example_id": "d687c9ed-95d3-4616-b341-b51df8d31028",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "In Vorgärten findet man Skulpturen aller Art."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                        "entry_id": "9067c845-9b59-3071-b544-681975145da0",
                                        "glosses": [
                                            "jede Art von dreidimensionalem Kunstwerk, dass bildhauerisch geschaffen wurde (Plastik oder Skulptur)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78869f31-59df-4d20-8120-e6547573a03f",
                                                "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                                "text": "In Vorgärten findet man Skulpturen aller Art."
                                            },
                                            {
                                                "example_id": "3431cd31-a316-4b07-a194-79cbdd6647f0",
                                                "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                                "text": "„Es gibt auch Skulpturen politischen Inhalts.“"
                                            },
                                            {
                                                "example_id": "97570415-f314-48c6-b08c-d2df97532921",
                                                "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                                "text": "„Heute steht dort eine sowjetische Skulptur aus Beton, die den Gedenkstein des Briten ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0968586-3720-42bb-abef-66485cad4211",
                        "source_entry_id": "7009ac47-c2cd-35b1-938a-ceb98dc423aa",
                        "source_sense_id": "ba0f5327-933c-38a5-8f20-6465e4e45618",
                        "source_sense_description": "een kunstwerk vervaardigd door het houwen van steen",
                        "target_lang_word": "sculpture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculpture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0157d0-79c8-396b-8ff4-7748edc38d05",
                                        "entry_id": "69e1b5fa-77d6-3797-9719-b62c1ce0eee5",
                                        "glosses": [
                                            "A three-dimensional work of art created by shaping malleable objects and letting them harden or by chipping away pieces from a rock (sculpting)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c273b82f-5d1f-430c-8da5-ea41bdb50fc6",
                                                "sense_id": "7d0157d0-79c8-396b-8ff4-7748edc38d05",
                                                "text": "There, too, in living sculpture, might be seen / The mad affection of the Cretan queen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "436c7af8-fa4d-3886-8dde-8f4ab598f920",
                                        "entry_id": "69e1b5fa-77d6-3797-9719-b62c1ce0eee5",
                                        "glosses": [
                                            "More generally (since modernism), a three-dimensional work of art of any material or of mixed materials, whether sculpted, assembled, found, constructed or created using multiple techniques."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a104c5a-1f5d-3b93-95d9-5c6d8d06db3a",
                                        "entry_id": "69e1b5fa-77d6-3797-9719-b62c1ce0eee5",
                                        "glosses": [
                                            "Works of art created by sculpting, as a group."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c02be4d5-9723-3399-9fb2-dff98932adb2",
                                        "entry_id": "69e1b5fa-77d6-3797-9719-b62c1ce0eee5",
                                        "glosses": [
                                            "The three-dimensional ornamentation on the outer surface of a shell."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ee86eb0-6d3d-3be6-b6cf-e4b388452dae",
                                        "entry_id": "69e1b5fa-77d6-3797-9719-b62c1ce0eee5",
                                        "glosses": [
                                            "A printed picture, such as an engraving."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84d418b8-4746-4c1b-8837-0dd0cde50557",
                                                "sense_id": "2ee86eb0-6d3d-3be6-b6cf-e4b388452dae",
                                                "text": "Whereas upon the humble Requeſt of Our Truſty and Wel-beloved Servant, JOHN OGILBY, Eſquire, We were Graciouſly pleaſed by Our Warrant of the 25. of May, in the ſeventeenth Year of Our Reign, to grant him the ſole Privilege and Immunity of Printing in fair Volumes, Adorned with Sculptures, Virgil Tranſlated, Homer's Iliads, Æſop Paraphraſed, and Our Entertainment in Paſſing through Our City of London, and Coronation, together with Homer's Odyſſes, and his fore-mentioned Æſop with his Additions and Annotations in Folio, with a Prohibition, that none ſhould Print or Re-print the ſame in any Volumes, without the Conſent and Approbation of him, the ſaid John Ogilby, his Heirs, Executors, or Aſſigns, within the term of Fifteen Years next enſuing the Date of Our ſaid Warrant;[…]"
                                            },
                                            {
                                                "example_id": "e24452a4-bc0b-4e46-aeb6-ca8cbf1c6f48",
                                                "sense_id": "2ee86eb0-6d3d-3be6-b6cf-e4b388452dae",
                                                "text": "Both are Tranſlated into Engliſh, Illuſtrated with Sculptures, and Printed about two Years ago."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sculpture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd0a067-94e3-3c99-842b-843c6b73b156",
                                        "entry_id": "14dc4335-721e-3340-8ae2-10cfadb07587",
                                        "glosses": [
                                            "To fashion something into a three-dimensional figure."
                                        ],
