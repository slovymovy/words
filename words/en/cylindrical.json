{
    "word_family": [
        "cylinder",
        "cylindric",
        "cylindrically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "139ef17d-800d-354b-8cf5-679cb626679f",
                    "sense_definition": "Having the shape of a cylinder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geometric_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient temple was supported by tall, <w>cylindrical</w> stone columns.",
                            "target_lang_translations": {
                                "zh": "这座古老的神庙由高大的<w>圆柱形</w>石柱支撑。"
                            }
                        },
                        {
                            "text": "The company stores chemical liquids in large <w>cylindrical</w> tanks.",
                            "target_lang_translations": {
                                "zh": "该公司将化学液体储存在大型<w>圆柱形</w>储罐中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cylindric"
                    ],
                    "common_phrases": [
                        "cylindrical shape",
                        "cylindrical container",
                        "cylindrical tube"
                    ],
                    "target_lang_definitions": {
                        "zh": "圆柱形的，圆筒状的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "圆柱形的",
                                "target_lang_sense_clarification": "形状呈圆柱体"
                            },
                            {
                                "target_lang_word": "圆筒状的",
                                "target_lang_sense_clarification": "形状呈圆筒或管道状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "925f97f3-7fc1-33f4-89bb-9b7fa2ff6a6a",
                    "sense_definition": "Relating to a map projection where meridians appear as vertical lines and parallels of latitude as horizontal lines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cartography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Mercator map is the most famous example of a <w>cylindrical</w> projection.",
                            "target_lang_translations": {
                                "zh": "墨卡托地图是<w>圆柱</w>投影最著名的范例。"
                            }
                        },
                        {
                            "text": "Standard <w>cylindrical</w> charts distort the true size of land masses near the poles.",
                            "target_lang_translations": {
                                "zh": "标准的<w>圆柱投影</w>海图会扭曲两极附近陆地的实际大小。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cylindrical projection"
                    ],
                    "target_lang_definitions": {
                        "zh": "（地图投影）圆柱投影的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "圆柱",
                                "target_lang_sense_clarification": "用于地图投影术语，经线为垂直线、纬线为水平线"
                            },
                            {
                                "target_lang_word": "圆柱投影的",
                                "target_lang_sense_clarification": "指采用圆柱投影法的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}