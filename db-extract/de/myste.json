                    {
                        "translation_id": "9bc04c9e-d05a-4f4f-84d0-9c55b134f2bd",
                        "source_entry_id": "e59922a6-8954-3655-ae5a-5b4e415648c2",
                        "source_sense_id": "0bd1fdc4-2fba-3a37-962a-b319f5f986fb",
                        "source_sense_description": "Religion: Person, die in die Mysterien eingeweiht ist",
                        "target_lang_word": "myste",
                        "target_lang_code": "fr",
