                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5e0164-218b-4e22-890f-923fcfc6c3fa",
                                "sense_id": "c5b9502c-569e-395a-a05a-9a523648b304",
                                "text": "Her 40-year-old Vespa was waiting in the yard under a custom-made cover."
                            },
                            {
                                "example_id": "42bea883-594c-4efc-bc5f-c180f9224f24",
                                "sense_id": "c5b9502c-569e-395a-a05a-9a523648b304",
                                "text": "In 1967, members of the traffic unit provide a funeral escort riding Vespa police model motor scooters. The Vespa scooter had the ability to cruise at speeds from 2 miles per hour to 65 miles per hour."
                            },
                            {
                                "example_id": "10def1f6-f707-4ffc-8dec-dbcf457fa4f0",
                                "sense_id": "c5b9502c-569e-395a-a05a-9a523648b304",
                                "text": "2011, Terry A. Burgess, Smell the Devil's Breath, Uncommon Senses, Number 4, page 85,\nHe grabbed the handlebars of the smallest Vespa near the end of the row and pulled the machine free of its slot."
                            }
                        ]
