                        "examples": [
                            {
                                "example_id": "3f39bc63-df47-4d91-887c-1c867715db0b",
                                "sense_id": "3208fac7-4bfb-35c2-9ea2-e938b9250548",
                                "text": "Lorsqu’une marée noire atteint le littoral, la souillure des hydrocarbures et l’engluement des plages provoquent une atteinte aux écosystèmes fragiles."
                            },
                            {
                                "example_id": "fade245d-43d4-481c-b818-508761b1af3c",
                                "sense_id": "3208fac7-4bfb-35c2-9ea2-e938b9250548",
                                "text": "Pour en faire un engluement, il faut donc la saturer d’eau de façon à former une pâte liante qu’on appliquera ensuite sur les plaies."
                            },
                            {
                                "example_id": "2ad2d1b6-eca2-4a31-b913-9cb964f63a76",
                                "sense_id": "3208fac7-4bfb-35c2-9ea2-e938b9250548",
                                "text": "Avec cette image, je voulais suggérer la sensation d’étirement du temps et d’engluement de l’acte sexuel."
                            }
                        ]
                    }
