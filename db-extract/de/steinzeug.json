                                    {
                                        "sense_id": "45eee38f-2895-3f9c-9cfc-65ac679ed6cb",
                                        "entry_id": "9fa9ce24-63e8-35ad-ae3c-950dcf2cd54b",
                                        "glosses": [
                                            "A type of pottery that is fired at a high temperature and is dense, opaque and nonporous."
                                        ],
                                        "tags": [
                                            "countable",
