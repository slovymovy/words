                "translations": [
                    {
                        "translation_id": "d192274b-aa16-497e-8231-efea02545fb7",
                        "source_entry_id": "44127262-6e34-3e04-b487-fa165135c97c",
                        "source_sense_id": "47143188-935a-33f2-86d4-efaca0d27b8c",
