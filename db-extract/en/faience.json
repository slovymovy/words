                    {
                        "translation_id": "5e61167a-ec78-4efb-8880-a6397b56907f",
                        "source_entry_id": "8f9fb562-8a23-345a-8645-910c55f68129",
                        "source_sense_description": "type of tin-glazed earthenware ceramic",
                        "target_lang_word": "faïence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faïence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                                        "glosses": [
                                            "Poterie de terre ordinairement vernissée ou émaillée de bleu sur fond blanc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b969fbe8-6511-44a9-a5e6-0cfc1779a97c",
                                                "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                                "text": "Elle y plaça deux chandeliers dont elle alluma les chandelles, et une jatte de faïence où trempait dans l’eau bénite une branche de buis."
                                            },
                                            {
                                                "example_id": "1be64a4b-bca8-46af-8076-e9f7a8b00224",
                                                "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                                "text": "Où, avec génie, du reste, avez-vous caché le bouquetier de faïence qui sera pour votre chambre ? Je le cherche depuis quelques heures, dans la commode, le petit placard, l'office, en vain : et le plateau à thé ?"
                                            },
                                            {
                                                "example_id": "84dc8590-a859-4d2b-946a-fb35cf447a7b",
                                                "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                                "text": "La porte s'ouvrit sur un corridor qui sentait le linoléum, avec un portemanteau en bambou à droite, des plantes vertes, dans des cache-pot de faïence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544bb0f1-e68a-35b7-a723-47b478aebf18",
                                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                                        "glosses": [
                                            "Objet, vaisselle de faïence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5c95cc-de38-4fd2-97ba-5bfdc36e3942",
                                                "sense_id": "544bb0f1-e68a-35b7-a723-47b478aebf18",
                                                "text": "Cependant les murs de Montreuil et la faïence du déjeuner me rappelèrent tout à fait l'Angleterre."
                                            },
                                            {
                                                "example_id": "51555af4-704a-4ad5-8ab1-f926825f6c65",
                                                "sense_id": "544bb0f1-e68a-35b7-a723-47b478aebf18",
                                                "text": "Après leur soupe, ils vidèrent un verre de vin dans leur assiette et firent chabrot, levant la lourde faïence brune jusqu'à leurs lèvres qu'ils essuyèrent ensuite d'un rapide coup de poignet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bce9f6f-020a-3fee-a397-d7f7ff492e32",
                                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                                        "glosses": [
                                            "Bleu, en parlant de l’iris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7666fc22-7962-4511-a09d-e341e227265e",
                                                "sense_id": "5bce9f6f-020a-3fee-a397-d7f7ff492e32",
                                                "text": "Des femmes couleur de café brûlé (…) ouvrant tout ébahis leurs grands yeux de faïence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "faïence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d46915-9066-3bc9-89a1-a264b0c67100",
                                        "entry_id": "09352f81-d405-3b10-9692-eeb82180a53c",
                                        "glosses": [
