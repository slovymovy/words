                                        "sense_id": "caf16517-3d30-36e7-8439-de36ea9919c5",
                                        "entry_id": "7d386c77-b4d3-3135-b8da-962671f688a3",
                                        "glosses": [
                                            "knöchellanges, weißes Gewand, das insbesondere katholische Geistliche unter dem Messgewand tragen, aber auch andere, die im Gottesdienst eine besondere Aufgabe erfüllen"
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cda389c1-c339-41eb-8e01-9945db1aa45e",
                                                "sense_id": "caf16517-3d30-36e7-8439-de36ea9919c5",
                                                "text": "Bei der heutigen Messe trug der Priester nur eine Albe."
                                            },
                                            {
                                                "example_id": "e1fa1a24-2e97-4239-a7bf-93b353f7d4a8",
                                                "sense_id": "caf16517-3d30-36e7-8439-de36ea9919c5",
                                                "text": "„Da in der Pfarrei der Pfarrer nur einmal im Monat für die Eucharistiefeier kam, war die Hauptansprechperson die Seelsorgerin. Wenn sie Gottesdienst feierte, trug sie eine weiße Albe – die Kinder gingen daher automatisch davon aus, dass sie die Pfarrerin sei.“"
                                            }
                                        ],
