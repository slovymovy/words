                                "target_senses": [
                                    {
                                        "sense_id": "0a65e9b3-caef-383c-be79-cb2a73a295e4",
                                        "entry_id": "d66d10b9-4b27-3255-a13b-d6494e50e13b",
                                        "glosses": [
                                            "Qui blesse la pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f3c41a-d7a5-46ff-9a19-92bd7b471f6a",
                                                "sense_id": "0a65e9b3-caef-383c-be79-cb2a73a295e4",
                                                "text": "Paroles indécentes."
                                            },
                                            {
                                                "example_id": "df316496-3e6b-434e-9fb7-350fdef76ed7",
                                                "sense_id": "0a65e9b3-caef-383c-be79-cb2a73a295e4",
                                                "text": "Vous êtes indécent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6347309-8381-34d6-bfce-2cc5fba91b3a",
                                        "entry_id": "d66d10b9-4b27-3255-a13b-d6494e50e13b",
                                        "glosses": [
                                            "Qui est contraire aux bienséances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f556a372-546d-4459-a5c1-3bf660ecea43",
                                                "sense_id": "b6347309-8381-34d6-bfce-2cc5fba91b3a",
                                                "text": "Il est indécent de s’endormir pendant une conférence."
                                            },
                                            {
                                                "example_id": "2e001b1f-bb4d-4fd7-b0fe-fa3903901966",
                                                "sense_id": "b6347309-8381-34d6-bfce-2cc5fba91b3a",
                                                "text": "« Je me suis fait plaisir », entend-on. Un tel aveu, autrefois, aurait été indécent. Maintenant, il donne le ton."
                                            },
                                            {
                                                "example_id": "324cccf5-082a-4797-ac76-5dc1f4d4b75d",
                                                "sense_id": "b6347309-8381-34d6-bfce-2cc5fba91b3a",
                                                "text": "« Descendez, ça, c'est défendu!\nOh, c'est indécent! »\nElle crie mais bien entendu\nPersonne ne descend."
                                            }
                                        ]
                                    }
                                ]
                            }
