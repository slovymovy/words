                                        "sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                                        "entry_id": "ee5602a8-8f7e-3c4e-958e-09a6d2f95a63",
                                        "glosses": [
                                            "junge, unerfahrene Person"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5299d8f9-e0cb-4d6d-bc81-3ca4b120d59f",
                                                "sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                                                "text": "Unser Nachbarsjunge ist ein richtiger Jungspund."
                                            },
                                            {
                                                "example_id": "1bf3035e-fcfe-4470-a4c0-e56ed44a6b63",
                                                "sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                                                "text": "Wer hier als Jungspund in die Tasten greift, atmet den Hauch der Romantik gratis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "170f99ba-ede2-4aad-ac88-e8a760446a53",
                        "source_entry_id": "eae13369-1888-3f37-90b1-d2af9f1cc744",
                        "source_sense_id": "31d7815e-03ed-3cc3-ac5d-253c8823aa97",
                        "source_sense_description": "young, cheeky person",
                        "target_lang_word": "Bengel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bengel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd4410e8-8667-38ae-a415-51a95fc8c709",
                                        "entry_id": "4ca095a6-545f-391c-ab3b-79c4f81dc618",
                                        "glosses": [
                                            "frecher, ungehobelter Junge"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffb04b5a-d963-4323-8129-24d02f8ab8e7",
                                                "sense_id": "bd4410e8-8667-38ae-a415-51a95fc8c709",
                                                "text": "Der Bengel wagte es doch tatsächlich, sich wieder sehen zu lassen."
                                            },
                                            {
                                                "example_id": "cd39417c-eadf-4ac1-8fb9-f82cbe914a00",
                                                "sense_id": "bd4410e8-8667-38ae-a415-51a95fc8c709",
                                                "text": "Jetzt, in dieser Zeit – was denkt sich so ein Bengel eigentlich…?"
                                            },
                                            {
                                                "example_id": "30b37b7f-ee24-4414-820f-81cda8cfcf9c",
                                                "sense_id": "bd4410e8-8667-38ae-a415-51a95fc8c709",
                                                "text": "„Und wenn der Tanz zu Ende war, ließen die Bengels ihre Mädels stehen, wo es gerade war, und gingen von ihnen fort, zu den andern Bengels.“"
                                            },
                                            {
                                                "example_id": "5b29c431-e95a-4089-a2c6-6a2cf9790772",
                                                "sense_id": "bd4410e8-8667-38ae-a415-51a95fc8c709",
                                                "text": "„Ein kleiner Bengel namens Evert oder Zahnarzt-Evert war der Schlimmste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aba37bad-4f73-4883-bbf2-ce44e1168fdd",
                        "source_entry_id": "eae13369-1888-3f37-90b1-d2af9f1cc744",
                        "source_sense_id": "31d7815e-03ed-3cc3-ac5d-253c8823aa97",
                        "source_sense_description": "young, cheeky person",
                        "target_lang_word": "Lümmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
